{
  "name": "du-dust",
  "version": "0.1.0",
  "description": "du-dust (dust) \u2014 a more intuitive version of du in Rust.",
  "source": "https://github.com/bootandy/dust",
  "checks": [
    {
      "type": "binary",
      "name": "dust"
    }
  ],
  "install_guidance": {
    "plugin": "du-dust",
    "binary": "dust",
    "check": "which dust",
    "install_steps": [
      "cargo install du-dust",
      "brew install dust",
      "sudo apt-get install dust",
      "supercli plugins install ./plugins/du-dust --on-conflict replace --json"
    ],
    "note": "Rust. Intuitive disk usage analyzer. Binary: dust."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "du-dust",
      "resource": "disk",
      "action": "usage",
      "description": "Show disk usage for directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "dust",
        "missingDependencyHelp": "Install dust",
        "positionalArgs": [
          "directory"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "directory path"
        }
      ]
    },
    {
      "namespace": "du-dust",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dust",
        "missingDependencyHelp": "Install dust",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
