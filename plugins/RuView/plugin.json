{
  "name": "RuView",
  "version": "0.1.0",
  "description": "\u03c0 RuView turns commodity WiFi signals into real-time spatial intelligence, vital sign monitoring, an",
  "source": "https://github.com/RuView/RuView",
  "checks": [
    {
      "type": "binary",
      "name": "ruview"
    }
  ],
  "install_guidance": {
    "plugin": "RuView",
    "binary": "ruview",
    "check": "which ruview",
    "install_steps": [
      "pip install ruview",
      "Verify: ruview --version",
      "supercli plugins install ./plugins/RuView --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RuView",
      "resource": "self",
      "action": "version",
      "description": "Print RuView version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruview",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RuView: pip install ruview"
      },
      "args": []
    },
    {
      "namespace": "RuView",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ruview CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruview",
        "passthrough": true,
        "missingDependencyHelp": "Install RuView: pip install ruview"
      },
      "args": []
    }
  ]
}