{
  "name": "candle",
  "version": "0.1.0",
  "description": "Minimalist ML framework for Rust",
  "source": "https://github.com/candle/candle",
  "checks": [
    {
      "type": "binary",
      "name": "candle"
    }
  ],
  "install_guidance": {
    "plugin": "candle",
    "binary": "candle",
    "check": "which candle",
    "install_steps": [
      "pip install candle",
      "Verify: candle --version",
      "supercli plugins install ./plugins/candle --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "candle",
      "resource": "self",
      "action": "version",
      "description": "Print candle version",
      "adapter": "process",
      "adapterConfig": {
        "command": "candle",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install candle: pip install candle"
      },
      "args": []
    },
    {
      "namespace": "candle",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to candle CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "candle",
        "passthrough": true,
        "missingDependencyHelp": "Install candle: pip install candle"
      },
      "args": []
    }
  ]
}