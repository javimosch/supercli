{
  "name": "osm-cli",
  "version": "0.1.0",
  "description": "Interact with the OpenStreetMap API for nodes ways and relations",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "osm-cli" }],
  "install_guidance": {
    "plugin": "osm-cli",
    "binary": "osm-cli",
    "check": "which osm-cli",
    "install_steps": ["cargo install osm-cli", "Verify: osm-cli --version", "supercli plugins install ./plugins/osm-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "osm-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to osm-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "osm-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install osm-cli: cargo install osm-cli"
    },
    "args": []
  }]
}
