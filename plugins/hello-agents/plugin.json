{
  "name": "hello-agents",
  "version": "0.1.0",
  "description": "\ud83d\udcda \u300a\u4ece\u96f6\u5f00\u59cb\u6784\u5efa\u667a\u80fd\u4f53\u300b\u2014\u2014\u4ece\u96f6\u5f00\u59cb\u7684\u667a\u80fd\u4f53\u539f\u7406\u4e0e\u5b9e\u8df5\u6559\u7a0b",
  "source": "https://github.com/hello-agents/hello-agents",
  "checks": [
    {
      "type": "binary",
      "name": "hello-agents"
    }
  ],
  "install_guidance": {
    "plugin": "hello-agents",
    "binary": "hello-agents",
    "check": "which hello-agents",
    "install_steps": [
      "pip install hello-agents",
      "Verify: hello-agents --version",
      "supercli plugins install ./plugins/hello-agents --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hello-agents",
      "resource": "self",
      "action": "version",
      "description": "Print hello-agents version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hello-agents",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hello-agents: pip install hello-agents"
      },
      "args": []
    },
    {
      "namespace": "hello-agents",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hello-agents CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hello-agents",
        "passthrough": true,
        "missingDependencyHelp": "Install hello-agents: pip install hello-agents"
      },
      "args": []
    }
  ]
}