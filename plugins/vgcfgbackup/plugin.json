{
  "name": "vgcfgbackup",
  "version": "0.1.0",
  "description": "CLI tool: vgcfgbackup",
  "source": "https://manpages.debian.org/vgcfgbackup",
  "checks": [
    {
      "type": "binary",
      "name": "vgcfgbackup"
    }
  ],
  "install_guidance": {
    "plugin": "vgcfgbackup",
    "binary": "vgcfgbackup",
    "check": "which vgcfgbackup",
    "install_steps": [
      "apt-get install vgcfgbackup 2>/dev/null || which vgcfgbackup",
      "Verify: vgcfgbackup --version",
      "supercli plugins install ./plugins/vgcfgbackup --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vgcfgbackup",
      "resource": "self",
      "action": "version",
      "description": "Print vgcfgbackup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgcfgbackup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vgcfgbackup: apt-get install vgcfgbackup 2>/dev/null || which vgcfgbackup"
      },
      "args": []
    },
    {
      "namespace": "vgcfgbackup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vgcfgbackup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgcfgbackup",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vgcfgbackup: apt-get install vgcfgbackup 2>/dev/null || which vgcfgbackup"
      },
      "args": []
    }
  ]
}