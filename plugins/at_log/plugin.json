{
  "name": "at_log",
  "version": "0.1.0",
  "description": "CLI tool: at_log",
  "source": "https://packages.debian.org/at_log",
  "checks": [{ "type": "binary", "name": "at_log" }],
  "install_guidance": {
    "plugin": "at_log", "binary": "at_log", "check": "which at_log",
    "install_steps": ["apt-get install at_log 2>/dev/null || which at_log", "Verify: at_log --version", "supercli plugins install ./plugins/at_log --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_log", "resource": "_", "action": "_",
    "description": "Passthrough to at_log CLI",
    "adapter": "process", "adapterConfig": { "command": "at_log", "passthrough": true, "missingDependencyHelp": "Install at_log: apt-get install at_log" }, "args": []
  }]
}
