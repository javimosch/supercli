{
  "name": "kalign",
  "version": "0.1.0",
  "description": "Fast multiple sequence alignment program for biological sequences",
  "source": "https://github.com/TimoLassmann/kalign",
  "checks": [
    {
      "type": "binary",
      "name": "kalign"
    }
  ],
  "install_guidance": {
    "plugin": "kalign",
    "binary": "kalign",
    "check": "which kalign",
    "install_steps": [
      "brew install kalign",
      "Verify: kalign --version",
      "supercli plugins install ./plugins/kalign --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kalign",
      "resource": "self",
      "action": "version",
      "description": "Print kalign version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kalign",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kalign: brew install kalign"
      },
      "args": []
    },
    {
      "namespace": "kalign",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kalign CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kalign",
        "passthrough": true,
        "missingDependencyHelp": "Install kalign"
      },
      "args": []
    }
  ]
}