{
  "name": "Thaw",
  "version": "0.1.0",
  "description": "Menu bar manager for macOS 26",
  "source": "https://github.com/Thaw/Thaw",
  "checks": [
    {
      "type": "binary",
      "name": "thaw"
    }
  ],
  "install_guidance": {
    "plugin": "Thaw",
    "binary": "thaw",
    "check": "which thaw",
    "install_steps": [
      "pip install thaw",
      "Verify: thaw --version",
      "supercli plugins install ./plugins/Thaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Thaw",
      "resource": "self",
      "action": "version",
      "description": "Print Thaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "thaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Thaw: pip install thaw"
      },
      "args": []
    },
    {
      "namespace": "Thaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to thaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "thaw",
        "passthrough": true,
        "missingDependencyHelp": "Install Thaw: pip install thaw"
      },
      "args": []
    }
  ]
}