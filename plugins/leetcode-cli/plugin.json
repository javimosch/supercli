{
  "name": "leetcode-cli",
  "version": "0.1.0",
  "description": "May the code be with you",
  "source": "https://github.com/clearloop/leetcode-cli",
  "checks": [
    {
      "type": "binary",
      "name": "leetcode-cli"
    }
  ],
  "install_guidance": {
    "plugin": "leetcode-cli",
    "binary": "leetcode-cli",
    "check": "which leetcode-cli",
    "install_steps": [
      "brew install leetcode-cli",
      "Verify: leetcode-cli --version",
      "supercli plugins install ./plugins/leetcode-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "leetcode-cli",
      "resource": "self",
      "action": "version",
      "description": "Print leetcode-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetcode-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install leetcode-cli: brew install leetcode-cli"
      },
      "args": []
    },
    {
      "namespace": "leetcode-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leetcode-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetcode-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install leetcode-cli"
      },
      "args": []
    }
  ]
}