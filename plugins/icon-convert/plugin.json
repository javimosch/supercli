{
  "name": "icon-convert",
  "version": "0.1.0",
  "description": "Convert images to ICO and other icon formats",
  "source": "https://github.com/johndoe/icon-convert",
  "checks": [{ "type": "binary", "name": "icon-convert" }],
  "install_guidance": {
    "plugin": "icon-convert",
    "binary": "icon-convert",
    "check": "which icon-convert",
    "install_steps": ["npm install -g icon-convert", "Verify: icon-convert --version", "supercli plugins install ./plugins/icon-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "icon-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to icon-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "icon-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install icon-convert: npm install -g icon-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
