{
  "name": "ctags-lsp",
  "version": "0.1.0",
  "description": "LSP implementation using universal-ctags as backend",
  "source": "https://github.com/netmute/ctags-lsp",
  "checks": [
    {
      "type": "binary",
      "name": "ctags-lsp"
    }
  ],
  "install_guidance": {
    "plugin": "ctags-lsp",
    "binary": "ctags-lsp",
    "check": "which ctags-lsp",
    "install_steps": [
      "brew install ctags-lsp",
      "Verify: ctags-lsp --version",
      "supercli plugins install ./plugins/ctags-lsp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ctags-lsp",
      "resource": "self",
      "action": "version",
      "description": "Print ctags-lsp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ctags-lsp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ctags-lsp: brew install ctags-lsp"
      },
      "args": []
    },
    {
      "namespace": "ctags-lsp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ctags-lsp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ctags-lsp",
        "passthrough": true,
        "missingDependencyHelp": "Install ctags-lsp"
      },
      "args": []
    }
  ]
}