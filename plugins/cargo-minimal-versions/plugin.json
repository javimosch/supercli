{
  "name": "cargo-minimal-versions",
  "version": "0.1.0",
  "description": "Test Rust crates with minimum dependency versions",
  "source": "https://github.com/taiki-e/cargo-minimal-versions",
  "checks": [{ "type": "binary", "name": "cargo-minimal-versions" }],
  "install_guidance": {
    "plugin": "cargo-minimal-versions",
    "binary": "cargo-minimal-versions",
    "check": "which cargo-minimal-versions",
    "install_steps": ["cargo install cargo-minimal-versions", "Verify: cargo-minimal-versions --version", "supercli plugins install ./plugins/cargo-minimal-versions --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-minimal-versions",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-minimal-versions CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-minimal-versions",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-minimal-versions: cargo install cargo-minimal-versions", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
