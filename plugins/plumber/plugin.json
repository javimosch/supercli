{
  "name": "plumber",
  "version": "0.1.0",
  "description": "plumber - Check GitLab CI/CD pipeline compliance",
  "source": "github.com/nicholasgasior/plumber",
  "checks": [
    {
      "type": "binary",
      "name": "plumber"
    }
  ],
  "install_guidance": {
    "plugin": "plumber",
    "binary": "plumber",
    "check": "which plumber",
    "install_steps": [
      "go install github.com/nicholasgasior/plumber@latest"
    ]
  },
  "commands": [
    {
      "namespace": "plumber",
      "resource": "pipeline",
      "action": "check",
      "description": "Check GitLab CI/CD pipeline compliance",
      "adapter": "process",
      "adapterConfig": {
        "command": "plumber",
        "passthrough": true,
        "invoke_cwd": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install plumber from github.com/nicholasgasior/plumber"
      },
      "args": []
    }
  ]
}