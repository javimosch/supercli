{
  "name": "claude-red",
  "version": "0.1.0",
  "description": "58 offensive security skills for AI agents — SQLi, XSS, AD, wireless, cloud, exploit dev, fuzzing, OSINT, AI security, and more",
  "source": "https://github.com/SnailSploit/Claude-Red",
  "checks": [
    { "type": "binary", "name": "git" }
  ],
  "install_guidance": {
    "plugin": "claude-red",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/SnailSploit/Claude-Red.git",
      "supercli plugins install ./plugins/claude-red --on-conflict replace --json",
      "sc skills teach claude-red:quickstart"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-red",
      "resource": "self",
      "action": "version",
      "description": "Print claude-red info",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": ["claude-red v0.1.0 — 58 offensive security skills. Use sc skills teach claude-red:quickstart"],
        "missingDependencyHelp": "Clone repo: git clone https://github.com/SnailSploit/Claude-Red.git"
      },
      "args": []
    },
    {
      "namespace": "claude-red",
      "resource": "_",
      "action": "_",
      "description": "Passthrough — clone and teach the skills",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": ["claude-red is a collection of 58 SKILL.md files. Clone https://github.com/SnailSploit/Claude-Red.git then: sc skills teach claude-red:quickstart"],
        "passthrough": true,
        "missingDependencyHelp": "Install: git clone https://github.com/SnailSploit/Claude-Red.git"
      },
      "args": []
    }
  ]
}
