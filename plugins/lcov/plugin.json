{
  "name": "lcov",
  "version": "0.1.0",
  "description": "Graphical front-end for GCC's coverage testing tool (gcov)",
  "source": "https://github.com/linux-test-project/lcov",
  "checks": [
    {
      "type": "binary",
      "name": "lcov"
    }
  ],
  "install_guidance": {
    "plugin": "lcov",
    "binary": "lcov",
    "check": "which lcov",
    "install_steps": [
      "brew install lcov",
      "Verify: lcov --version",
      "supercli plugins install ./plugins/lcov --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lcov",
      "resource": "self",
      "action": "version",
      "description": "Print lcov version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lcov",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lcov: brew install lcov"
      },
      "args": []
    },
    {
      "namespace": "lcov",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lcov CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lcov",
        "passthrough": true,
        "missingDependencyHelp": "Install lcov"
      },
      "args": []
    }
  ]
}