{
  "name": "dhcp-lease-list",
  "version": "0.1.0",
  "description": "CLI tool: dhcp-lease-list",
  "source": "https://packages.debian.org/dhcp-lease-list",
  "checks": [{ "type": "binary", "name": "dhcp-lease-list" }],
  "install_guidance": {
    "plugin": "dhcp-lease-list", "binary": "dhcp-lease-list", "check": "which dhcp-lease-list",
    "install_steps": ["apt-get install dhcp-lease-list 2>/dev/null || which dhcp-lease-list", "Verify: dhcp-lease-list --version", "supercli plugins install ./plugins/dhcp-lease-list --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhcp-lease-list", "resource": "_", "action": "_",
    "description": "Passthrough to dhcp-lease-list CLI",
    "adapter": "process", "adapterConfig": { "command": "dhcp-lease-list", "passthrough": true, "missingDependencyHelp": "Install dhcp-lease-list: apt-get install dhcp-lease-list" }, "args": []
  }]
}
