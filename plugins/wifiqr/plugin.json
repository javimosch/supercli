{
  "name": "wifiqr",
  "version": "0.1.0",
  "description": "wifiqr \u2014 create a QR code with your Wi-Fi login details.",
  "source": "https://github.com/reclaimingmytime/wifiqr",
  "checks": [
    {
      "type": "binary",
      "name": "wifiqr"
    }
  ],
  "install_guidance": {
    "plugin": "wifiqr",
    "binary": "wifiqr",
    "check": "which wifiqr",
    "install_steps": [
      "go install github.com/reclaimingmytime/wifiqr@latest",
      "supercli plugins install ./plugins/wifiqr --on-conflict replace --json"
    ],
    "note": "Go. WiFi QR code generator."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wifiqr",
      "resource": "wifi",
      "action": "generate",
      "description": "Generate WiFi QR code",
      "adapter": "process",
      "adapterConfig": {
        "command": "wifiqr",
        "missingDependencyHelp": "Install wifiqr",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "wifiqr",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wifiqr",
        "missingDependencyHelp": "Install wifiqr",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
