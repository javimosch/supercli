{
  "name": "voxtral.c",
  "version": "0.1.0",
  "description": "Pure C inference of Mistral Voxtral Realtime 4B speech to text model",
  "source": "https://github.com/voxtral.c/voxtral.c",
  "checks": [
    {
      "type": "binary",
      "name": "voxtral.c"
    }
  ],
  "install_guidance": {
    "plugin": "voxtral.c",
    "binary": "voxtral.c",
    "check": "which voxtral.c",
    "install_steps": [
      "pip install voxtral.c",
      "Verify: voxtral.c --version",
      "supercli plugins install ./plugins/voxtral.c --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "voxtral.c",
      "resource": "self",
      "action": "version",
      "description": "Print voxtral.c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "voxtral.c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install voxtral.c: pip install voxtral.c"
      },
      "args": []
    },
    {
      "namespace": "voxtral.c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to voxtral.c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "voxtral.c",
        "passthrough": true,
        "missingDependencyHelp": "Install voxtral.c: pip install voxtral.c"
      },
      "args": []
    }
  ]
}