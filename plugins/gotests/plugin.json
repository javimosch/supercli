{
  "name": "gotests",
  "version": "0.1.0",
  "description": "Automatically generate Go test boilerplate from your source code",
  "source": "https://github.com/cweill/gotests",
  "checks": [
    {
      "type": "binary",
      "name": "gotests"
    }
  ],
  "install_guidance": {
    "plugin": "gotests",
    "binary": "gotests",
    "check": "which gotests",
    "install_steps": [
      "brew install gotests",
      "Verify: gotests --version",
      "supercli plugins install ./plugins/gotests --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gotests",
      "resource": "self",
      "action": "version",
      "description": "Print gotests version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotests",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gotests: brew install gotests"
      },
      "args": []
    },
    {
      "namespace": "gotests",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gotests CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotests",
        "passthrough": true,
        "missingDependencyHelp": "Install gotests"
      },
      "args": []
    }
  ]
}