{
  "name": "gitnr",
  "version": "0.1.0",
  "description": "Create `.gitignore` using templates from TopTal, GitHub or your own collection",
  "source": "https://github.com/reemus-dev/gitnr",
  "checks": [
    {
      "type": "binary",
      "name": "gitnr"
    }
  ],
  "install_guidance": {
    "plugin": "gitnr",
    "binary": "gitnr",
    "check": "which gitnr",
    "install_steps": [
      "brew install gitnr",
      "Verify: gitnr --version",
      "supercli plugins install ./plugins/gitnr --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitnr",
      "resource": "self",
      "action": "version",
      "description": "Print gitnr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitnr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitnr: brew install gitnr"
      },
      "args": []
    },
    {
      "namespace": "gitnr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitnr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitnr",
        "passthrough": true,
        "missingDependencyHelp": "Install gitnr"
      },
      "args": []
    }
  ]
}