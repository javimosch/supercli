{
  "name": "certifi",
  "version": "0.1.0",
  "description": "Mozilla CA bundle for Python",
  "source": "https://github.com/certifi/python-certifi",
  "checks": [
    {
      "type": "binary",
      "name": "certifi"
    }
  ],
  "install_guidance": {
    "plugin": "certifi",
    "binary": "certifi",
    "check": "which certifi",
    "install_steps": [
      "brew install certifi",
      "Verify: certifi --version",
      "supercli plugins install ./plugins/certifi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "certifi",
      "resource": "self",
      "action": "version",
      "description": "Print certifi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "certifi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install certifi: brew install certifi"
      },
      "args": []
    },
    {
      "namespace": "certifi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to certifi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "certifi",
        "passthrough": true,
        "missingDependencyHelp": "Install certifi"
      },
      "args": []
    }
  ]
}