{
  "name": "bssh",
  "version": "0.1.0",
  "description": "A parallel SSH command execution tool. Runs commands across multiple remote hosts simultaneously with structured output for server management.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "bssh"
    }
  ],
  "install_guidance": {
    "plugin": "bssh",
    "binary": "bssh",
    "check": "which bssh",
    "install_steps": [
      "cargo install bssh",
      "Verify: bssh --version",
      "supercli plugins install ./plugins/bssh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bssh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bssh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bssh",
        "passthrough": true,
        "missingDependencyHelp": "Install bssh: cargo install bssh"
      },
      "args": []
    }
  ]
}
