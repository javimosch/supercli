{
  "name": "FineTune",
  "version": "0.1.0",
  "description": "FineTune, a macOS menu bar app for per-app volume control, multi-device output, audio routing, and 1",
  "source": "https://github.com/FineTune/FineTune",
  "checks": [
    {
      "type": "binary",
      "name": "finetune"
    }
  ],
  "install_guidance": {
    "plugin": "FineTune",
    "binary": "finetune",
    "check": "which finetune",
    "install_steps": [
      "pip install finetune",
      "Verify: finetune --version",
      "supercli plugins install ./plugins/FineTune --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FineTune",
      "resource": "self",
      "action": "version",
      "description": "Print FineTune version",
      "adapter": "process",
      "adapterConfig": {
        "command": "finetune",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FineTune: pip install finetune"
      },
      "args": []
    },
    {
      "namespace": "FineTune",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to finetune CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "finetune",
        "passthrough": true,
        "missingDependencyHelp": "Install FineTune: pip install finetune"
      },
      "args": []
    }
  ]
}