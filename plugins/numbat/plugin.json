{
  "name": "numbat",
  "version": "0.1.0",
  "description": "Scientific calculator with physical unit conversions",
  "source": "https://github.com/sharkdp/numbat",
  "checks": [{ "type": "binary", "name": "numbat" }],
  "install_guidance": {
    "plugin": "numbat",
    "binary": "numbat",
    "check": "which numbat",
    "install_steps": ["cargo install numbat-cli", "Verify: numbat --version", "supercli plugins install ./plugins/numbat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "numbat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to numbat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "numbat",
      "passthrough": true,
      "missingDependencyHelp": "Install numbat: cargo install numbat-cli"
    },
    "args": []
  }]
}
