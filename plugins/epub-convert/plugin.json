{
  "name": "epub-convert",
  "version": "0.1.0",
  "description": "Convert documents between EPUB and other ebook formats",
  "source": "https://github.com/johndoe/epub-convert",
  "checks": [{ "type": "binary", "name": "epub-convert" }],
  "install_guidance": {
    "plugin": "epub-convert",
    "binary": "epub-convert",
    "check": "which epub-convert",
    "install_steps": ["pip install epub-convert", "Verify: epub-convert --version", "supercli plugins install ./plugins/epub-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epub-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epub-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epub-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install epub-convert: pip install epub-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
