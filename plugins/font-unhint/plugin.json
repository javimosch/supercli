{
  "name": "font-unhint",
  "version": "0.1.0",
  "description": "Strip hinting information from font files to reduce size",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "font-unhint" }],
  "install_guidance": {
    "plugin": "font-unhint",
    "binary": "font-unhint",
    "check": "which font-unhint",
    "install_steps": ["pip install font-unhint", "Verify: font-unhint --version", "supercli plugins install ./plugins/font-unhint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "font-unhint",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to font-unhint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "font-unhint",
      "passthrough": true,
      "missingDependencyHelp": "Install font-unhint: pip install font-unhint"
    },
    "args": []
  }]
}
