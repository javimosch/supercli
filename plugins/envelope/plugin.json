{
  "name": "envelope",
  "version": "0.1.0",
  "description": "Environment variables CLI tool",
  "source": "https://github.com/mattrighetti/envelope",
  "checks": [
    {
      "type": "binary",
      "name": "envelope"
    }
  ],
  "install_guidance": {
    "plugin": "envelope",
    "binary": "envelope",
    "check": "which envelope",
    "install_steps": [
      "brew install envelope",
      "Verify: envelope --version",
      "supercli plugins install ./plugins/envelope --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "envelope",
      "resource": "self",
      "action": "version",
      "description": "Print envelope version",
      "adapter": "process",
      "adapterConfig": {
        "command": "envelope",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install envelope: brew install envelope"
      },
      "args": []
    },
    {
      "namespace": "envelope",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to envelope CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "envelope",
        "passthrough": true,
        "missingDependencyHelp": "Install envelope"
      },
      "args": []
    }
  ]
}