{
  "name": "gitmoji",
  "version": "1.0.0",
  "description": "A gitmoji interactive cli tool for using emojis on commits",
  "source": "https://github.com/carloscuesta/gitmoji-cli",
  "checks": [
    {
      "type": "binary",
      "name": "gitmoji"
    }
  ],
  "install_guidance": {
    "plugin": "gitmoji",
    "binary": "gitmoji",
    "check": "gitmoji --version",
    "install_steps": [
      "npm install -g gitmoji-cli"
    ],
    "note": "Requires Node.js and npm. Installs globally as 'gitmoji'."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gitmoji",
      "resource": "cli",
      "action": "run",
      "description": "Launch gitmoji interactive CLI for emoji commits",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitmoji",
        "missingDependencyHelp": "Install gitmoji: npm install -g gitmoji-cli"
      },
      "args": []
    },
    {
      "namespace": "gitmoji",
      "resource": "self",
      "action": "version",
      "description": "Print gitmoji version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitmoji",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitmoji: npm install -g gitmoji-cli"
      },
      "args": []
    },
    {
      "namespace": "gitmoji",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitmoji CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitmoji",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gitmoji: npm install -g gitmoji-cli"
      },
      "args": []
    }
  ]
}
