{
  "name": "luaver",
  "version": "0.1.0",
  "description": "Manage and switch between versions of Lua, LuaJIT, and Luarocks",
  "source": "https://github.com/DhavalKapil/luaver",
  "checks": [
    {
      "type": "binary",
      "name": "luaver"
    }
  ],
  "install_guidance": {
    "plugin": "luaver",
    "binary": "luaver",
    "check": "which luaver",
    "install_steps": [
      "brew install luaver",
      "Verify: luaver --version",
      "supercli plugins install ./plugins/luaver --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "luaver",
      "resource": "self",
      "action": "version",
      "description": "Print luaver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "luaver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install luaver: brew install luaver"
      },
      "args": []
    },
    {
      "namespace": "luaver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to luaver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "luaver",
        "passthrough": true,
        "missingDependencyHelp": "Install luaver"
      },
      "args": []
    }
  ]
}