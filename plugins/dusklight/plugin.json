{
  "name": "dusklight",
  "version": "0.1.0",
  "description": "Dusklight brings a classic adventure to PC and mobile platforms with a variety of fixes and improvem",
  "source": "https://github.com/dusklight/dusklight",
  "checks": [
    {
      "type": "binary",
      "name": "dusklight"
    }
  ],
  "install_guidance": {
    "plugin": "dusklight",
    "binary": "dusklight",
    "check": "which dusklight",
    "install_steps": [
      "pip install dusklight",
      "Verify: dusklight --version",
      "supercli plugins install ./plugins/dusklight --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dusklight",
      "resource": "self",
      "action": "version",
      "description": "Print dusklight version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dusklight",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dusklight: pip install dusklight"
      },
      "args": []
    },
    {
      "namespace": "dusklight",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dusklight CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dusklight",
        "passthrough": true,
        "missingDependencyHelp": "Install dusklight: pip install dusklight"
      },
      "args": []
    }
  ]
}