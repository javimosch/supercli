{
  "name": "glib-gettextize",
  "version": "0.1.0",
  "description": "CLI tool: glib-gettextize",
  "source": "https://manpages.debian.org/glib-gettextize",
  "checks": [
    {
      "type": "binary",
      "name": "glib-gettextize"
    }
  ],
  "install_guidance": {
    "plugin": "glib-gettextize",
    "binary": "glib-gettextize",
    "check": "which glib-gettextize",
    "install_steps": [
      "apt-get install glib-gettextize 2>/dev/null || which glib-gettextize",
      "Verify: glib-gettextize --version",
      "supercli plugins install ./plugins/glib-gettextize --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "glib-gettextize",
      "resource": "self",
      "action": "version",
      "description": "Print glib-gettextize version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-gettextize",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install glib-gettextize: apt-get install glib-gettextize 2>/dev/null || which glib-gettextize"
      },
      "args": []
    },
    {
      "namespace": "glib-gettextize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glib-gettextize CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-gettextize",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install glib-gettextize: apt-get install glib-gettextize 2>/dev/null || which glib-gettextize"
      },
      "args": []
    }
  ]
}