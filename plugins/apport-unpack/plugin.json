{
  "name": "apport-unpack",
  "version": "0.1.0",
  "description": "CLI tool: apport-unpack",
  "source": "https://packages.debian.org/apport-unpack",
  "checks": [{ "type": "binary", "name": "apport-unpack" }],
  "install_guidance": {
    "plugin": "apport-unpack", "binary": "apport-unpack", "check": "which apport-unpack",
    "install_steps": ["apt-get install apport-unpack 2>/dev/null || which apport-unpack", "Verify: apport-unpack --version", "supercli plugins install ./plugins/apport-unpack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apport-unpack", "resource": "_", "action": "_",
    "description": "Passthrough to apport-unpack CLI",
    "adapter": "process", "adapterConfig": { "command": "apport-unpack", "passthrough": true, "missingDependencyHelp": "Install apport-unpack: apt-get install apport-unpack" }, "args": []
  }]
}
