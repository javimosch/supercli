{
  "name": "tclsh8.6",
  "version": "0.1.0",
  "description": "CLI tool: tclsh8.6",
  "source": "https://manpages.debian.org/tclsh8.6",
  "checks": [
    {
      "type": "binary",
      "name": "tclsh8.6"
    }
  ],
  "install_guidance": {
    "plugin": "tclsh8.6",
    "binary": "tclsh8.6",
    "check": "which tclsh8.6",
    "install_steps": [
      "apt-get install tclsh8.6 2>/dev/null || which tclsh8.6",
      "Verify: tclsh8.6 --version",
      "supercli plugins install ./plugins/tclsh8.6 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tclsh8.6",
      "resource": "self",
      "action": "version",
      "description": "Print tclsh8.6 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tclsh8.6",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tclsh8.6: apt-get install tclsh8.6 2>/dev/null || which tclsh8.6"
      },
      "args": []
    },
    {
      "namespace": "tclsh8.6",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tclsh8.6 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tclsh8.6",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tclsh8.6: apt-get install tclsh8.6 2>/dev/null || which tclsh8.6"
      },
      "args": []
    }
  ]
}