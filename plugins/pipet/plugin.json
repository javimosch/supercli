{
  "name": "pipet",
  "version": "0.1.0",
  "description": "Swiss-army tool for scraping and extracting data from online assets, made for hackers ",
  "source": "https://github.com/pipet/pipet",
  "checks": [
    {
      "type": "binary",
      "name": "pipet"
    }
  ],
  "install_guidance": {
    "plugin": "pipet",
    "binary": "pipet",
    "check": "which pipet",
    "install_steps": [
      "pip install pipet",
      "Verify: pipet --version",
      "supercli plugins install ./plugins/pipet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pipet",
      "resource": "self",
      "action": "version",
      "description": "Print pipet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pipet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pipet: pip install pipet"
      },
      "args": []
    },
    {
      "namespace": "pipet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pipet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pipet",
        "passthrough": true,
        "missingDependencyHelp": "Install pipet: pip install pipet"
      },
      "args": []
    }
  ]
}