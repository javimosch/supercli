{
  "name": "anew",
  "version": "0.1.0",
  "description": "Tool for adding new lines to files, skipping duplicates.",
  "source": "https://github.com/tomnomnom/anew",
  "checks": [
    {
      "type": "binary",
      "name": "anew"
    }
  ],
  "install_guidance": {
    "plugin": "anew",
    "binary": "anew",
    "check": "which anew",
    "install_steps": [
      "See https://github.com/tomnomnom/anew",
      "Verify: anew --version",
      "supercli plugins install ./plugins/anew --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "anew",
      "resource": "self",
      "action": "version",
      "description": "Print anew version",
      "adapter": "process",
      "adapterConfig": {
        "command": "anew",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install anew: See https://github.com/tomnomnom/anew"
      },
      "args": []
    },
    {
      "namespace": "anew",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to anew CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "anew",
        "passthrough": true,
        "missingDependencyHelp": "Install anew"
      },
      "args": []
    }
  ]
}