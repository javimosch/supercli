{
  "name": "share",
  "version": "0.1.0",
  "description": "Share and receive files effortlessly over HTTP",
  "source": "https://github.com/beavailable/share",
  "checks": [
    {
      "type": "binary",
      "name": "share"
    }
  ],
  "install_guidance": {
    "plugin": "share",
    "binary": "share",
    "check": "which share",
    "install_steps": [
      "See https://github.com/beavailable/share",
      "Verify: share --version",
      "supercli plugins install ./plugins/share --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "share",
      "resource": "self",
      "action": "version",
      "description": "Print share version",
      "adapter": "process",
      "adapterConfig": {
        "command": "share",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install share: See https://github.com/beavailable/share"
      },
      "args": []
    },
    {
      "namespace": "share",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to share CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "share",
        "passthrough": true,
        "missingDependencyHelp": "Install share"
      },
      "args": []
    }
  ]
}