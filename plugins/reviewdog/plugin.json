{
  "name": "reviewdog",
  "version": "0.1.0",
  "description": "Code review automation tool with CI integration",
  "source": "https://github.com/reviewdog/reviewdog",
  "checks": [
    {
      "type": "binary",
      "name": "reviewdog"
    }
  ],
  "install_guidance": {
    "plugin": "reviewdog",
    "binary": "reviewdog",
    "check": "which reviewdog",
    "install_steps": [
      "brew install reviewdog",
      "Verify: reviewdog --version",
      "supercli plugins install ./plugins/reviewdog --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "reviewdog",
      "resource": "self",
      "action": "version",
      "description": "Print reviewdog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "reviewdog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install reviewdog: brew install reviewdog"
      },
      "args": []
    },
    {
      "namespace": "reviewdog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to reviewdog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "reviewdog",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install reviewdog: brew install reviewdog"
      },
      "args": []
    }
  ]
}
