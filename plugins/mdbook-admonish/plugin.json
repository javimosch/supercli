{
  "name": "mdbook-admonish",
  "version": "0.1.0",
  "description": "Callout and admonition support for mdBook documentation",
  "source": "https://github.com/tommilligan/mdbook-admonish",
  "checks": [{ "type": "binary", "name": "mdbook-admonish" }],
  "install_guidance": {
    "plugin": "mdbook-admonish",
    "binary": "mdbook-admonish",
    "check": "which mdbook-admonish",
    "install_steps": ["cargo install mdbook-admonish", "Verify: mdbook-admonish --version", "supercli plugins install ./plugins/mdbook-admonish --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdbook-admonish",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdbook-admonish CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdbook-admonish",
      "passthrough": true,
      "missingDependencyHelp": "Install mdbook-admonish: cargo install mdbook-admonish", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
