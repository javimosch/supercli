{
  "name": "yawn",
  "version": "0.1.0",
  "description": "Sleep until a specific time or date from the command line",
  "source": "https://github.com/woutervanhees/yawn",
  "checks": [{ "type": "binary", "name": "yawn" }],
  "install_guidance": {
    "plugin": "yawn",
    "binary": "yawn",
    "check": "which yawn",
    "install_steps": ["cargo install yawn", "Verify: yawn --version", "supercli plugins install ./plugins/yawn --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yawn",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yawn CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yawn",
      "passthrough": true,
      "missingDependencyHelp": "Install yawn: cargo install yawn", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
