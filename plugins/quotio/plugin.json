{
  "name": "quotio",
  "version": "0.1.0",
  "description": "Stop juggling AI accounts. Quotio is a beautiful native macOS menu bar app that unifies your Claude,",
  "source": "https://github.com/quotio/quotio",
  "checks": [
    {
      "type": "binary",
      "name": "quotio"
    }
  ],
  "install_guidance": {
    "plugin": "quotio",
    "binary": "quotio",
    "check": "which quotio",
    "install_steps": [
      "pip install quotio",
      "Verify: quotio --version",
      "supercli plugins install ./plugins/quotio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "quotio",
      "resource": "self",
      "action": "version",
      "description": "Print quotio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quotio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install quotio: pip install quotio"
      },
      "args": []
    },
    {
      "namespace": "quotio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to quotio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "quotio",
        "passthrough": true,
        "missingDependencyHelp": "Install quotio: pip install quotio"
      },
      "args": []
    }
  ]
}