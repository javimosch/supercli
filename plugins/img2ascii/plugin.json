{
  "name": "img2ascii",
  "version": "0.1.0",
  "description": "Convert images to ASCII art",
  "source": "https://github.com/JosefVesely/Image-to-ASCII",
  "checks": [
    {
      "type": "binary",
      "name": "img2ascii"
    }
  ],
  "install_guidance": {
    "plugin": "img2ascii",
    "binary": "img2ascii",
    "check": "which img2ascii",
    "install_steps": [
      "See https://github.com/JosefVesely/Image-to-ASCII",
      "Verify: img2ascii --version",
      "supercli plugins install ./plugins/img2ascii --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "img2ascii",
      "resource": "self",
      "action": "version",
      "description": "Print img2ascii version",
      "adapter": "process",
      "adapterConfig": {
        "command": "img2ascii",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install img2ascii: See https://github.com/JosefVesely/Image-to-ASCII"
      },
      "args": []
    },
    {
      "namespace": "img2ascii",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to img2ascii CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "img2ascii",
        "passthrough": true,
        "missingDependencyHelp": "Install img2ascii"
      },
      "args": []
    }
  ]
}