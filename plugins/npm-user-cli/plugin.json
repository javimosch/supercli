{
  "name": "npm-user-cli",
  "version": "0.1.0",
  "description": "Get user info of a npm user",
  "source": "https://github.com/sindresorhus/npm-user-cli",
  "checks": [
    {
      "type": "binary",
      "name": "npm-user-cli"
    }
  ],
  "install_guidance": {
    "plugin": "npm-user-cli",
    "binary": "npm-user-cli",
    "check": "which npm-user-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/npm-user-cli",
      "Verify: npm-user-cli --version",
      "supercli plugins install ./plugins/npm-user-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "npm-user-cli",
      "resource": "self",
      "action": "version",
      "description": "Print npm-user-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-user-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install npm-user-cli: See https://github.com/sindresorhus/npm-user-cli"
      },
      "args": []
    },
    {
      "namespace": "npm-user-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to npm-user-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-user-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install npm-user-cli"
      },
      "args": []
    }
  ]
}