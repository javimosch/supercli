{
  "name": "HiClaw",
  "version": "0.1.0",
  "description": "An open-source Collaborative Multi-Agent OS for transparent, human-in-the-loop task coordination via",
  "source": "https://github.com/HiClaw/HiClaw",
  "checks": [
    {
      "type": "binary",
      "name": "hiclaw"
    }
  ],
  "install_guidance": {
    "plugin": "HiClaw",
    "binary": "hiclaw",
    "check": "which hiclaw",
    "install_steps": [
      "pip install hiclaw",
      "Verify: hiclaw --version",
      "supercli plugins install ./plugins/HiClaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "HiClaw",
      "resource": "self",
      "action": "version",
      "description": "Print HiClaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hiclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install HiClaw: pip install hiclaw"
      },
      "args": []
    },
    {
      "namespace": "HiClaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hiclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hiclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install HiClaw: pip install hiclaw"
      },
      "args": []
    }
  ]
}