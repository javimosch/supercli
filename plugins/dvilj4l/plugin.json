{
  "name": "dvilj4l",
  "version": "0.1.0",
  "description": "CLI tool: dvilj4l",
  "source": "https://manpages.debian.org/dvilj4l",
  "checks": [
    {
      "type": "binary",
      "name": "dvilj4l"
    }
  ],
  "install_guidance": {
    "plugin": "dvilj4l",
    "binary": "dvilj4l",
    "check": "which dvilj4l",
    "install_steps": [
      "apt-get install dvilj4l 2>/dev/null || which dvilj4l",
      "Verify: dvilj4l --version",
      "supercli plugins install ./plugins/dvilj4l --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvilj4l",
      "resource": "self",
      "action": "version",
      "description": "Print dvilj4l version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj4l",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvilj4l: apt-get install dvilj4l 2>/dev/null || which dvilj4l"
      },
      "args": []
    },
    {
      "namespace": "dvilj4l",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvilj4l CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj4l",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvilj4l: apt-get install dvilj4l 2>/dev/null || which dvilj4l"
      },
      "args": []
    }
  ]
}