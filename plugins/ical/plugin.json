{
  "name": "ical",
  "version": "0.1.0",
  "description": "Manage macOS Calendar",
  "source": "https://github.com/BRO3886/ical",
  "checks": [
    {
      "type": "binary",
      "name": "ical"
    }
  ],
  "install_guidance": {
    "plugin": "ical",
    "binary": "ical",
    "check": "which ical",
    "install_steps": [
      "See https://github.com/BRO3886/ical",
      "Verify: ical --version",
      "supercli plugins install ./plugins/ical --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ical",
      "resource": "self",
      "action": "version",
      "description": "Print ical version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ical",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ical: See https://github.com/BRO3886/ical"
      },
      "args": []
    },
    {
      "namespace": "ical",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ical CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ical",
        "passthrough": true,
        "missingDependencyHelp": "Install ical"
      },
      "args": []
    }
  ]
}