{
  "name": "uz",
  "version": "0.1.0",
  "description": "CLI tool: uz",
  "source": "https://manpages.debian.org/uz",
  "checks": [
    {
      "type": "binary",
      "name": "uz"
    }
  ],
  "install_guidance": {
    "plugin": "uz",
    "binary": "uz",
    "check": "which uz",
    "install_steps": [
      "apt-get install uz 2>/dev/null || which uz",
      "Verify: uz --version",
      "supercli plugins install ./plugins/uz --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uz",
      "resource": "self",
      "action": "version",
      "description": "Print uz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uz: apt-get install uz 2>/dev/null || which uz"
      },
      "args": []
    },
    {
      "namespace": "uz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uz",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uz: apt-get install uz 2>/dev/null || which uz"
      },
      "args": []
    }
  ]
}