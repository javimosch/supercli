{
  "name": "tinypicker",
  "version": "0.1.0",
  "description": "Simple color picker for CLI in Rust",
  "source": "https://github.com/nicholasgasior/tinypicker",
  "checks": [{"type": "binary", "name": "tinypicker"}],
  "install_guidance": {
    "plugin": "tinypicker",
    "binary": "tinypicker",
    "check": "which tinypicker",
    "install_steps": [
      "cargo install tinypicker",
      "Verify: tinypicker --version",
      "supercli plugins install ./tinypicker --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "tinypicker",
      "resource": "self",
      "action": "version",
      "description": "Print tinypicker version",
      "adapter": "process",
      "adapterConfig": {"command": "tinypicker", "baseArgs": ["--version"], "missingDependencyHelp": "Install tinypicker: cargo install tinypicker"},
      "args": []
    },
    {
      "namespace": "tinypicker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tinypicker CLI",
      "adapter": "process",
      "adapterConfig": {"command": "tinypicker", "passthrough": true, "missingDependencyHelp": "Install tinypicker: cargo install tinypicker"},
      "args": []
    }
  ]
}
