{
  "name": "julius",
  "version": "0.1.0",
  "description": "Two-pass large vocabulary continuous speech recognition engine",
  "source": "https://github.com/julius-speech/julius",
  "checks": [
    {
      "type": "binary",
      "name": "julius"
    }
  ],
  "install_guidance": {
    "plugin": "julius",
    "binary": "julius",
    "check": "which julius",
    "install_steps": [
      "brew install julius",
      "Verify: julius --version",
      "supercli plugins install ./plugins/julius --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "julius",
      "resource": "self",
      "action": "version",
      "description": "Print julius version",
      "adapter": "process",
      "adapterConfig": {
        "command": "julius",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install julius: brew install julius"
      },
      "args": []
    },
    {
      "namespace": "julius",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to julius CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "julius",
        "passthrough": true,
        "missingDependencyHelp": "Install julius"
      },
      "args": []
    }
  ]
}