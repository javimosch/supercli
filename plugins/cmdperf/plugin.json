{
  "name": "cmdperf",
  "version": "0.1.0",
  "description": "Benchmark and compare command performance metrics",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "cmdperf" }],
  "install_guidance": {
    "plugin": "cmdperf",
    "binary": "cmdperf",
    "check": "which cmdperf",
    "install_steps": ["cargo install cmdperf", "Verify: cmdperf --version", "supercli plugins install ./plugins/cmdperf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cmdperf",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cmdperf CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cmdperf",
      "passthrough": true,
      "missingDependencyHelp": "Install cmdperf: cargo install cmdperf"
    },
    "args": []
  }]
}
