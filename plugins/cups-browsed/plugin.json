{
  "name": "cups-browsed",
  "version": "0.1.0",
  "description": "CLI tool: cups-browsed",
  "source": "https://packages.debian.org/cups-browsed",
  "checks": [{ "type": "binary", "name": "cups-browsed" }],
  "install_guidance": {
    "plugin": "cups-browsed", "binary": "cups-browsed", "check": "which cups-browsed",
    "install_steps": ["apt-get install cups-browsed 2>/dev/null || which cups-browsed", "Verify: cups-browsed --version", "supercli plugins install ./plugins/cups-browsed --on-conflict replace --json"]
