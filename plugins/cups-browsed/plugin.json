  "commands": [{
    "namespace": "cups-browsed", "resource": "_", "action": "_",
    "description": "Passthrough to cups-browsed CLI",
    "adapter": "process", "adapterConfig": { "command": "cups-browsed", "passthrough": true, "missingDependencyHelp": "Install cups-browsed: apt-get install cups-browsed" }, "args": []
  }]
}
