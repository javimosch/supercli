{
  "name": "tiptop",
  "version": "0.1.0",
  "description": "System monitor",
  "source": "https://github.com/nschloe/tiptop",
  "checks": [
    {
      "type": "binary",
      "name": "tiptop"
    }
  ],
  "install_guidance": {
    "plugin": "tiptop",
    "binary": "tiptop",
    "check": "which tiptop",
    "install_steps": [
      "See https://github.com/nschloe/tiptop",
      "Verify: tiptop --version",
      "supercli plugins install ./plugins/tiptop --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "tiptop",
      "resource": "self",
      "action": "version",
      "description": "Print tiptop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tiptop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tiptop: See https://github.com/nschloe/tiptop"
      },
      "args": []
    },
    {
      "namespace": "tiptop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tiptop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tiptop",
        "passthrough": true,
        "missingDependencyHelp": "Install tiptop"
      },
      "args": []
    }
  ]
}