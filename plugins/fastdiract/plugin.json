{
  "name": "fastdiract",
  "version": "0.1.0",
  "description": "Lightning-fast cd and command execution.",
  "source": "https://github.com/dp12/fastdiract",
  "checks": [
    {
      "type": "binary",
      "name": "fastdiract"
    }
  ],
  "install_guidance": {
    "plugin": "fastdiract",
    "binary": "fastdiract",
    "check": "which fastdiract",
    "install_steps": [
      "See https://github.com/dp12/fastdiract",
      "Verify: fastdiract --version",
      "supercli plugins install ./plugins/fastdiract --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "fastdiract",
      "resource": "self",
      "action": "version",
      "description": "Print fastdiract version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastdiract",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastdiract: See https://github.com/dp12/fastdiract"
      },
      "args": []
    },
    {
      "namespace": "fastdiract",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastdiract CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastdiract",
        "passthrough": true,
        "missingDependencyHelp": "Install fastdiract"
      },
      "args": []
    }
  ]
}