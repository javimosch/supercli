{
  "name": "p-scan",
  "version": "0.1.0",
  "description": "Simple asynchronous port scanner for network discovery",
  "source": "https://github.com/p-scan/p-scan",
  "checks": [{ "type": "binary", "name": "p-scan" }],
  "install_guidance": {
    "plugin": "p-scan",
    "binary": "p-scan",
    "check": "which p-scan",
    "install_steps": ["go install github.com/p-scan/cli@latest", "Verify: p-scan --version", "supercli plugins install ./plugins/p-scan --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "p-scan",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to p-scan CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "p-scan",
      "passthrough": true,
      "missingDependencyHelp": "Install p-scan: go install github.com/p-scan/cli@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
