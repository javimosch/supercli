{
  "name": "plow",
  "version": "0.1.0",
  "description": "High-performance HTTP benchmarking tool with real-time UI",
  "source": "https://github.com/six-ddc/plow",
  "checks": [{ "type": "binary", "name": "plow" }],
  "install_guidance": {
    "plugin": "plow",
    "binary": "plow",
    "check": "which plow",
    "install_steps": ["go install github.com/six-ddc/plow@latest", "Verify: plow --version", "supercli plugins install ./plugins/plow --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "plow",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to plow CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "plow",
      "passthrough": true,
      "missingDependencyHelp": "Install plow: go install github.com/six-ddc/plow@latest"
    },
    "args": []
  }]
}
