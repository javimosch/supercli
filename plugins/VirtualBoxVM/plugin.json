{
  "name": "VirtualBoxVM",
  "version": "0.1.0",
  "description": "CLI tool: VirtualBoxVM",
  "source": "https://manpages.debian.org/VirtualBoxVM",
  "checks": [
    {
      "type": "binary",
      "name": "VirtualBoxVM"
    }
  ],
  "install_guidance": {
    "plugin": "VirtualBoxVM",
    "binary": "VirtualBoxVM",
    "check": "which VirtualBoxVM",
    "install_steps": [
      "apt-get install VirtualBoxVM 2>/dev/null || which VirtualBoxVM",
      "Verify: VirtualBoxVM --version",
      "supercli plugins install ./plugins/VirtualBoxVM --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VirtualBoxVM",
      "resource": "self",
      "action": "version",
      "description": "Print VirtualBoxVM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "VirtualBoxVM",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VirtualBoxVM: apt-get install VirtualBoxVM 2>/dev/null || which VirtualBoxVM"
      },
      "args": []
    },
    {
      "namespace": "VirtualBoxVM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to VirtualBoxVM CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "VirtualBoxVM",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install VirtualBoxVM: apt-get install VirtualBoxVM 2>/dev/null || which VirtualBoxVM"
      },
      "args": []
    }
  ]
}