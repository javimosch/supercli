{
  "name": "frizbee",
  "version": "0.1.0",
  "description": "Throw a tag at and it comes back with a checksum",
  "source": "https://github.com/stacklok/frizbee",
  "checks": [
    {
      "type": "binary",
      "name": "frizbee"
    }
  ],
  "install_guidance": {
    "plugin": "frizbee",
    "binary": "frizbee",
    "check": "which frizbee",
    "install_steps": [
      "brew install frizbee",
      "Verify: frizbee --version",
      "supercli plugins install ./plugins/frizbee --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "frizbee",
      "resource": "self",
      "action": "version",
      "description": "Print frizbee version",
      "adapter": "process",
      "adapterConfig": {
        "command": "frizbee",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install frizbee: brew install frizbee"
      },
      "args": []
    },
    {
      "namespace": "frizbee",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to frizbee CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "frizbee",
        "passthrough": true,
        "missingDependencyHelp": "Install frizbee"
      },
      "args": []
    }
  ]
}