{
  "name": "linux-use",
  "version": "0.7.1",
  "description": "Agent-first GUI control for Linux desktops: AT-SPI2 perception and widget-level actuation plus a ~60ms CDP DOM fast path. Single 229 KB static binary, zero runtime deps. The Linux answer to Windows-Use.",
  "source": "https://github.com/javimosch/linux-use",
  "checks": [
    {
      "type": "binary",
      "name": "linux-use"
    }
  ],
  "install_guidance": {
    "plugin": "linux-use",
    "binary": "linux-use",
    "check": "which linux-use",
    "install_steps": [
      "Download the latest binary from https://github.com/javimosch/linux-use/releases/latest or build from source: git clone https://github.com/javimosch/linux-use && cd linux-use && ./build.sh",
      "System deps for building: sudo apt install libatspi2.0-dev libxtst-dev libx11-dev libglib2.0-dev",
      "Enable the accessibility bus: gsettings set org.gnome.desktop.interface toolkit-accessibility true",
      "Verify: linux-use doctor",
      "supercli plugins install ./plugins/linux-use --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linux-use",
      "resource": "self",
      "action": "version",
      "description": "Print linux-use version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux-use",
        "baseArgs": [
          "version"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install linux-use from https://github.com/javimosch/linux-use/releases/latest"
      },
      "args": []
    },
    {
      "namespace": "linux-use",
      "resource": "app",
      "action": "list",
      "description": "List applications exposing accessibility, with pid, toolkit and window count",
