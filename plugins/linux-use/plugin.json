      "args": [
        {
          "name": "app",
          "type": "string",
          "required": false,
          "description": "Limit to one application name"
        }
      ]
    },
    {
      "namespace": "linux-use",
      "resource": "element",
      "action": "state",
      "description": "Dump interactive elements of an app with actable refs; --expand sweeps below the fold, --via cdp reads the whole DOM in ~60ms (debug-port browsers), --format lines is compact",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux-use",
        "baseArgs": [
          "state"
        ],
        "cwd": "invoke_cwd",
        "parseJson": true,
        "missingDependencyHelp": "Install linux-use from https://github.com/javimosch/linux-use/releases/latest"
      },
      "args": [
        {
          "name": "app",
          "type": "string",
          "required": true,
          "description": "Application name, e.g. gnome-calculator or 'Microsoft Edge#pid123'"
        },
        {
          "name": "pid",
          "type": "integer",
          "required": false
        },
        {
          "name": "role",
          "type": "string",
          "required": false,
          "description": "Filter by AT-SPI role (see linux-use roles)"
        },
        {
          "name": "depth",
          "type": "integer",
          "required": false
        },
        {
          "name": "all",
          "type": "boolean",
          "required": false,
          "description": "Include non-interactive nodes"
        },
        {
          "name": "expand",
          "type": "boolean",
          "required": false,
          "description": "Scroll-sweep to realize below-fold widgets"
        },
        {
          "name": "via",
          "type": "string",
          "required": false,
          "description": "cdp = one DOM query on a debug-port browser"
        },
        {
          "name": "format",
          "type": "string",
          "required": false,
          "description": "json (default) or lines"
        }
      ]
    },
    {
      "namespace": "linux-use",
      "resource": "element",
      "action": "find",
      "description": "Search elements by name substring; --expand sweeps below the fold (requires --app)",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux-use",
        "baseArgs": [
          "find"
        ],
        "cwd": "invoke_cwd",
        "parseJson": true,
