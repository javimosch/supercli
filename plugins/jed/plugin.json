{
  "name": "jed",
  "version": "0.1.0",
  "description": "A text editor with a drop-down menu facility that make it especially user-friendly.",
  "source": "https://github.com/jedsoft/jed",
  "checks": [
    {
      "type": "binary",
      "name": "jed"
    }
  ],
  "install_guidance": {
    "plugin": "jed",
    "binary": "jed",
    "check": "which jed",
    "install_steps": [
      "brew install jed",
      "Verify: jed --version",
      "supercli plugins install ./plugins/jed --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jed",
      "resource": "self",
      "action": "version",
      "description": "Print jed version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jed",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jed: brew install jed"
      },
      "args": []
    },
    {
      "namespace": "jed",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jed CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jed",
        "passthrough": true,
        "missingDependencyHelp": "Install jed"
      },
      "args": []
    }
  ]
}