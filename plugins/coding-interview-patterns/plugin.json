{
  "name": "coding-interview-patterns",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/coding-interview-patterns/coding-interview-patterns",
  "checks": [
    {
      "type": "binary",
      "name": "coding-interview-patterns"
    }
  ],
  "install_guidance": {
    "plugin": "coding-interview-patterns",
    "binary": "coding-interview-patterns",
    "check": "which coding-interview-patterns",
    "install_steps": [
      "pip install coding-interview-patterns",
      "Verify: coding-interview-patterns --version",
      "supercli plugins install ./plugins/coding-interview-patterns --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "coding-interview-patterns",
      "resource": "self",
      "action": "version",
      "description": "Print coding-interview-patterns version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coding-interview-patterns",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coding-interview-patterns: pip install coding-interview-patterns"
      },
      "args": []
    },
    {
      "namespace": "coding-interview-patterns",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coding-interview-patterns CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coding-interview-patterns",
        "passthrough": true,
        "missingDependencyHelp": "Install coding-interview-patterns: pip install coding-interview-patterns"
      },
      "args": []
    }
  ]
}