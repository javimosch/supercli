{
  "name": "iptables-legacy-restore",
  "version": "0.1.0",
  "description": "CLI tool: iptables-legacy-restore",
  "source": "https://manpages.debian.org/iptables-legacy-restore",
  "checks": [
    {
      "type": "binary",
      "name": "iptables-legacy-restore"
    }
  ],
  "install_guidance": {
    "plugin": "iptables-legacy-restore",
    "binary": "iptables-legacy-restore",
    "check": "which iptables-legacy-restore",
    "install_steps": [
      "apt-get install iptables-legacy-restore 2>/dev/null || which iptables-legacy-restore",
      "Verify: iptables-legacy-restore --version",
      "supercli plugins install ./plugins/iptables-legacy-restore --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iptables-legacy-restore",
      "resource": "self",
      "action": "version",
      "description": "Print iptables-legacy-restore version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iptables-legacy-restore",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iptables-legacy-restore: apt-get install iptables-legacy-restore 2>/dev/null || which iptables-legacy-restore"
      },
      "args": []
    },
    {
      "namespace": "iptables-legacy-restore",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iptables-legacy-restore CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iptables-legacy-restore",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install iptables-legacy-restore: apt-get install iptables-legacy-restore 2>/dev/null || which iptables-legacy-restore"
      },
      "args": []
    }
  ]
}