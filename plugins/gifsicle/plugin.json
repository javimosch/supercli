{
  "name": "gifsicle",
  "version": "1.0.0",
  "description": "gifsicle \u2014 GIF manipulation tool",
  "source": "www.lcdf.org/gifsicle",
  "checks": [
    {
      "type": "binary",
      "name": "gifsicle"
    }
  ],
  "install_guidance": {
    "plugin": "gifsicle",
    "binary": "gifsicle",
    "check": "which gifsicle",
    "install_steps": [
      "# Install gifsicle:",
      "# apt: sudo apt-get install gifsicle",
      "# brew: brew install gifsicle",
      "# cargo: cargo install gifsicle",
      "# npm: npm install -g gifsicle",
      "# pip: pip install gifsicle",
      "# or download from www.lcdf.org/gifsicle"
    ]
  },
  "commands": [
    {
      "namespace": "gifsicle",
      "resource": "gifsicle",
      "action": "run",
      "description": "Run gifsicle",
      "adapter": "process",
      "adapterConfig": {
        "command": "gifsicle",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gifsicle from www.lcdf.org/gifsicle"
      },
      "args": []
    }
  ]
}