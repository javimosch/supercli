{
  "name": "a2enconf",
  "version": "0.1.0",
  "description": "CLI tool: a2enconf",
  "source": "https://packages.debian.org/a2enconf",
  "checks": [{ "type": "binary", "name": "a2enconf" }],
  "install_guidance": {
    "plugin": "a2enconf", "binary": "a2enconf", "check": "which a2enconf",
    "install_steps": ["apt-get install a2enconf 2>/dev/null || which a2enconf", "Verify: a2enconf --version", "supercli plugins install ./plugins/a2enconf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "a2enconf", "resource": "_", "action": "_",
    "description": "Passthrough to a2enconf CLI",
    "adapter": "process", "adapterConfig": { "command": "a2enconf", "passthrough": true, "missingDependencyHelp": "Install a2enconf: apt-get install a2enconf" }, "args": []
  }]
}
