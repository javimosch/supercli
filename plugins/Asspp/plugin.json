{
  "name": "Asspp",
  "version": "0.1.0",
  "description": "The App Store for your multi-account eco system.",
  "source": "https://github.com/Asspp/Asspp",
  "checks": [
    {
      "type": "binary",
      "name": "asspp"
    }
  ],
  "install_guidance": {
    "plugin": "Asspp",
    "binary": "asspp",
    "check": "which asspp",
    "install_steps": [
      "pip install asspp",
      "Verify: asspp --version",
      "supercli plugins install ./plugins/Asspp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Asspp",
      "resource": "self",
      "action": "version",
      "description": "Print Asspp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "asspp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Asspp: pip install asspp"
      },
      "args": []
    },
    {
      "namespace": "Asspp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to asspp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "asspp",
        "passthrough": true,
        "missingDependencyHelp": "Install Asspp: pip install asspp"
      },
      "args": []
    }
  ]
}