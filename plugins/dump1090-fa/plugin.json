{
  "name": "dump1090-fa",
  "version": "0.1.0",
  "description": "FlightAware ADS-B Ground Station System for SDRs",
  "source": "https://github.com/flightaware/dump1090",
  "checks": [
    {
      "type": "binary",
      "name": "dump1090-fa"
    }
  ],
  "install_guidance": {
    "plugin": "dump1090-fa",
    "binary": "dump1090-fa",
    "check": "which dump1090-fa",
    "install_steps": [
      "brew install dump1090-fa",
      "Verify: dump1090-fa --version",
      "supercli plugins install ./plugins/dump1090-fa --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dump1090-fa",
      "resource": "self",
      "action": "version",
      "description": "Print dump1090-fa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dump1090-fa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dump1090-fa: brew install dump1090-fa"
      },
      "args": []
    },
    {
      "namespace": "dump1090-fa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dump1090-fa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dump1090-fa",
        "passthrough": true,
        "missingDependencyHelp": "Install dump1090-fa"
      },
      "args": []
    }
  ]
}