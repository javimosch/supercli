{
  "name": "rekor",
  "version": "0.1.0",
  "description": "Rekor transparency log CLI",
  "source": "https://packages.debian.org/rekor",
  "checks": [{ "type": "binary", "name": "rekor" }],
  "install_guidance": {
    "plugin": "rekor", "binary": "rekor", "check": "which rekor",
    "install_steps": ["apt-get install rekor", "Verify: rekor --version", "supercli plugins install ./plugins/rekor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rekor", "resource": "_", "action": "_",
    "description": "Passthrough to rekor CLI",
    "adapter": "process", "adapterConfig": { "command": "rekor", "passthrough": true, "missingDependencyHelp": "Install rekor: apt-get install rekor" }, "args": []
  }]
}
