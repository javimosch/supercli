{
  "name": "composer",
  "version": "1.0.0",
  "description": "composer \u2014 PHP dependency manager",
  "source": "getcomposer.org",
  "checks": [
    {
      "type": "binary",
      "name": "composer"
    }
  ],
  "install_guidance": {
    "plugin": "composer",
    "binary": "composer",
    "check": "which composer",
    "install_steps": [
      "# Install composer",
      "# See getcomposer.org",
      "# apt: sudo apt-get install composer",
      "# brew: brew install composer",
      "# cargo: cargo install composer",
      "# npm: npm install -g composer",
      "# pip: pip install composer"
    ]
  },
  "commands": [
    {
      "namespace": "composer",
      "resource": "composer",
      "action": "run",
      "description": "Run composer",
      "adapter": "process",
      "adapterConfig": {
        "command": "composer",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install composer from getcomposer.org"
      },
      "args": []
    }
  ]
}