{
  "name": "tensorzero",
  "version": "0.1.0",
  "description": "TensorZero is an open-source LLMOps platform that unifies an LLM gateway, observability, evaluation,",
  "source": "https://github.com/tensorzero/tensorzero",
  "checks": [
    {
      "type": "binary",
      "name": "tensorzero"
    }
  ],
  "install_guidance": {
    "plugin": "tensorzero",
    "binary": "tensorzero",
    "check": "which tensorzero",
    "install_steps": [
      "pip install tensorzero",
      "Verify: tensorzero --version",
      "supercli plugins install ./plugins/tensorzero --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tensorzero",
      "resource": "self",
      "action": "version",
      "description": "Print tensorzero version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tensorzero",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tensorzero: pip install tensorzero"
      },
      "args": []
    },
    {
      "namespace": "tensorzero",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tensorzero CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tensorzero",
        "passthrough": true,
        "missingDependencyHelp": "Install tensorzero: pip install tensorzero"
      },
      "args": []
    }
  ]
}