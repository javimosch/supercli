{
  "name": "uptftopl",
  "version": "0.1.0",
  "description": "CLI tool: uptftopl",
  "source": "https://manpages.debian.org/uptftopl",
  "checks": [
    {
      "type": "binary",
      "name": "uptftopl"
    }
  ],
  "install_guidance": {
    "plugin": "uptftopl",
    "binary": "uptftopl",
    "check": "which uptftopl",
    "install_steps": [
      "apt-get install uptftopl 2>/dev/null || which uptftopl",
      "Verify: uptftopl --version",
      "supercli plugins install ./plugins/uptftopl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uptftopl",
      "resource": "self",
      "action": "version",
      "description": "Print uptftopl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uptftopl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uptftopl: apt-get install uptftopl 2>/dev/null || which uptftopl"
      },
      "args": []
    },
    {
      "namespace": "uptftopl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uptftopl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uptftopl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uptftopl: apt-get install uptftopl 2>/dev/null || which uptftopl"
      },
      "args": []
    }
  ]
}