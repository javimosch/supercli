{
  "name": "semver",
  "version": "1.0.0",
  "description": "semver \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=semver+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "semver"
    }
  ],
  "install_guidance": {
    "plugin": "semver",
    "binary": "semver",
    "check": "which semver",
    "install_steps": [
      "Install semver via package manager: apt install semver or brew install semver"
    ]
  },
  "commands": [
    {
      "namespace": "semver",
      "resource": "run",
      "action": "exec",
      "description": "semver \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "semver",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install semver via your package manager"
      },
      "args": []
    }
  ]
}