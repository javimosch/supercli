{
  "name": "zed-edit",
  "version": "0.1.0",
  "description": "High-performance code editor CLI from the Zed team",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "zed-edit" }],
  "install_guidance": {
    "plugin": "zed-edit",
    "binary": "zed-edit",
    "check": "which zed-edit",
    "install_steps": ["brew install zed", "Verify: zed-edit --version", "supercli plugins install ./plugins/zed-edit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zed-edit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zed-edit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zed-edit",
      "passthrough": true,
      "missingDependencyHelp": "Install zed-edit: brew install zed"
    },
    "args": []
  }]
}
