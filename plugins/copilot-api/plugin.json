{
  "name": "copilot-api",
  "version": "0.1.0",
  "description": "CLI tool: copilot-api",
  "source": "https://packages.debian.org/copilot-api",
  "checks": [{ "type": "binary", "name": "copilot-api" }],
  "install_guidance": {
    "plugin": "copilot-api", "binary": "copilot-api", "check": "which copilot-api",
    "install_steps": ["apt-get install copilot-api 2>/dev/null || which copilot-api", "Verify: copilot-api --version", "supercli plugins install ./plugins/copilot-api --on-conflict replace --json"]
