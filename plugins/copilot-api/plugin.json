  "commands": [{
    "namespace": "copilot-api", "resource": "_", "action": "_",
    "description": "Passthrough to copilot-api CLI",
    "adapter": "process", "adapterConfig": { "command": "copilot-api", "passthrough": true, "missingDependencyHelp": "Install copilot-api: apt-get install copilot-api" }, "args": []
  }]
}
