{
  "name": "microsoft365",
  "version": "0.1.0",
  "description": "CLI tool: microsoft365",
  "source": "https://manpages.debian.org/microsoft365",
  "checks": [
    {
      "type": "binary",
      "name": "microsoft365"
    }
  ],
  "install_guidance": {
    "plugin": "microsoft365",
    "binary": "microsoft365",
    "check": "which microsoft365",
    "install_steps": [
      "apt-get install microsoft365 2>/dev/null || which microsoft365",
      "Verify: microsoft365 --version",
      "supercli plugins install ./plugins/microsoft365 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "microsoft365",
      "resource": "self",
      "action": "version",
      "description": "Print microsoft365 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsoft365",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install microsoft365: apt-get install microsoft365 2>/dev/null || which microsoft365"
      },
      "args": []
    },
    {
      "namespace": "microsoft365",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to microsoft365 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsoft365",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install microsoft365: apt-get install microsoft365 2>/dev/null || which microsoft365"
      },
      "args": []
    }
  ]
}