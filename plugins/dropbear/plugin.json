{
  "name": "dropbear",
  "version": "0.1.0",
  "description": "dropbear \u2014 lightweight SSH2 server and client - startup scripts",
  "source": "https://packages.debian.org/dropbear",
  "checks": [{ "type": "binary", "name": "dropbear" }],
  "install_guidance": {
    "plugin": "dropbear", "binary": "dropbear", "check": "which dropbear",
    "install_steps": ["apt-get install dropbear", "Verify: dropbear --version", "supercli plugins install ./plugins/dropbear --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dropbear", "resource": "_", "action": "_",
    "description": "Passthrough to dropbear CLI",
    "adapter": "process", "adapterConfig": { "command": "dropbear", "passthrough": true, "missingDependencyHelp": "Install dropbear: apt-get install dropbear" }, "args": []
  }]
}
