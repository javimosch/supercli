{
  "name": "ltc-tools",
  "version": "0.1.0",
  "description": "Tools to deal with linear-timecode (LTC)",
  "source": "https://github.com/x42/ltc-tools",
  "checks": [
    {
      "type": "binary",
      "name": "ltc-tools"
    }
  ],
  "install_guidance": {
    "plugin": "ltc-tools",
    "binary": "ltc-tools",
    "check": "which ltc-tools",
    "install_steps": [
      "brew install ltc-tools",
      "Verify: ltc-tools --version",
      "supercli plugins install ./plugins/ltc-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ltc-tools",
      "resource": "self",
      "action": "version",
      "description": "Print ltc-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ltc-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ltc-tools: brew install ltc-tools"
      },
      "args": []
    },
    {
      "namespace": "ltc-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ltc-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ltc-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install ltc-tools"
      },
      "args": []
    }
  ]
}