{
  "name": "ipcmk",
  "version": "1.0.0",
  "description": "ipcmk \u2014 ipcmk \u2014 CLI utility",
  "source": "/usr/bin/ipcmk",
  "checks": [
    {
      "type": "binary",
      "name": "ipcmk"
    }
  ],
  "install_guidance": {
    "plugin": "ipcmk",
    "binary": "ipcmk",
    "check": "which ipcmk",
    "install_steps": [
      "# Install ipcmk:",
      "# apt: sudo apt-get install ipcmk",
      "# brew: brew install ipcmk",
      "# cargo: cargo install ipcmk",
      "# npm: npm install -g ipcmk",
      "# pip: pip install ipcmk",
      "# or download from /usr/bin/ipcmk"
    ]
  },
  "commands": [
    {
      "namespace": "ipcmk",
      "resource": "ipcmk",
      "action": "run",
      "description": "Run ipcmk",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipcmk",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ipcmk from /usr/bin/ipcmk"
      },
      "args": []
    }
  ]
}