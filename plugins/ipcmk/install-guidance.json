{
  "plugin": "ipcmk",
  "binary": "ipcmk",
  "check": "which ipcmk",
  "install_steps": [
    "# Install ipcmk",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ipcmk-linux-amd64 -o /usr/local/bin/ipcmk",
    "chmod +x /usr/local/bin/ipcmk",
    "# Or via package manager, see /usr/bin/ipcmk"
  ]
}