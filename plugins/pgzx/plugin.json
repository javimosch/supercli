{
  "name": "pgzx",
  "version": "0.1.0",
  "description": "Create PostgreSQL extensions using Zig.",
  "source": "https://github.com/pgzx/pgzx",
  "checks": [
    {
      "type": "binary",
      "name": "pgzx"
    }
  ],
  "install_guidance": {
    "plugin": "pgzx",
    "binary": "pgzx",
    "check": "which pgzx",
    "install_steps": [
      "pip install pgzx",
      "Verify: pgzx --version",
      "supercli plugins install ./plugins/pgzx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgzx",
      "resource": "self",
      "action": "version",
      "description": "Print pgzx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgzx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgzx: pip install pgzx"
      },
      "args": []
    },
    {
      "namespace": "pgzx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgzx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgzx",
        "passthrough": true,
        "missingDependencyHelp": "Install pgzx: pip install pgzx"
      },
      "args": []
    }
  ]
}