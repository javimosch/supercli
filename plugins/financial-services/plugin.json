{
  "name": "financial-services",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/financial-services/financial-services",
  "checks": [
    {
      "type": "binary",
      "name": "financial-services"
    }
  ],
  "install_guidance": {
    "plugin": "financial-services",
    "binary": "financial-services",
    "check": "which financial-services",
    "install_steps": [
      "pip install financial-services",
      "Verify: financial-services --version",
      "supercli plugins install ./plugins/financial-services --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "financial-services",
      "resource": "self",
      "action": "version",
      "description": "Print financial-services version",
      "adapter": "process",
      "adapterConfig": {
        "command": "financial-services",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install financial-services: pip install financial-services"
      },
      "args": []
    },
    {
      "namespace": "financial-services",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to financial-services CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "financial-services",
        "passthrough": true,
        "missingDependencyHelp": "Install financial-services: pip install financial-services"
      },
      "args": []
    }
  ]
}