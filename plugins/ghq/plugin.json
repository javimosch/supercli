{
  "name": "ghq",
  "version": "1.0.0",
  "description": "ghq \u2014 Git repository manager",
  "source": "github.com/x-motemen/ghq",
  "checks": [
    {
      "type": "binary",
      "name": "ghq"
    }
  ],
  "install_guidance": {
    "plugin": "ghq",
    "binary": "ghq",
    "check": "which ghq",
    "install_steps": [
      "# Install ghq:",
      "# apt: sudo apt-get install ghq",
      "# brew: brew install ghq",
      "# cargo: cargo install ghq",
      "# npm: npm install -g ghq",
      "# pip: pip install ghq",
      "# or download from github.com/x-motemen/ghq"
    ]
  },
  "commands": [
    {
      "namespace": "ghq",
      "resource": "ghq",
      "action": "run",
      "description": "Run ghq",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghq",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ghq from github.com/x-motemen/ghq"
      },
      "args": []
    }
  ]
}