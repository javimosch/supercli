{
  "name": "cmctl",
  "version": "0.1.0",
  "description": "Command-line tool to manage cert-manager",
  "checks": [
    {
      "type": "binary",
      "name": "cmctl"
    }
  ],
  "install_guidance": {
    "plugin": "cmctl",
    "binary": "cmctl",
    "check": "which cmctl",
    "install_steps": [
      "brew install cmctl",
      "Verify: cmctl --version",
      "supercli plugins install ./plugins/cmctl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cmctl",
      "resource": "self",
      "action": "version",
      "description": "Print cmctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmctl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmctl: brew install cmctl"
      },
      "args": []
    },
    {
      "namespace": "cmctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmctl",
        "passthrough": true,
        "missingDependencyHelp": "Install cmctl"
      },
      "args": []
    }
  ]
}