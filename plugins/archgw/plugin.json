{
  "name": "archgw",
  "version": "0.1.0",
  "description": "CLI for Arch Gateway",
  "source": "https://github.com/katanemo/archgw/tree/main/arch/tools",
  "checks": [
    {
      "type": "binary",
      "name": "archgw"
    }
  ],
  "install_guidance": {
    "plugin": "archgw",
    "binary": "archgw",
    "check": "which archgw",
    "install_steps": [
      "brew install archgw",
      "Verify: archgw --version",
      "supercli plugins install ./plugins/archgw --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "archgw",
      "resource": "self",
      "action": "version",
      "description": "Print archgw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "archgw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install archgw: brew install archgw"
      },
      "args": []
    },
    {
      "namespace": "archgw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to archgw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "archgw",
        "passthrough": true,
        "missingDependencyHelp": "Install archgw"
      },
      "args": []
    }
  ]
}