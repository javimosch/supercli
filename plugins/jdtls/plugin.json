{
  "name": "jdtls",
  "version": "0.1.0",
  "description": "Java language specific implementation of the Language Server Protocol",
  "source": "https://github.com/eclipse-jdtls/eclipse.jdt.ls",
  "checks": [
    {
      "type": "binary",
      "name": "jdtls"
    }
  ],
  "install_guidance": {
    "plugin": "jdtls",
    "binary": "jdtls",
    "check": "which jdtls",
    "install_steps": [
      "brew install jdtls",
      "Verify: jdtls --version",
      "supercli plugins install ./plugins/jdtls --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jdtls",
      "resource": "self",
      "action": "version",
      "description": "Print jdtls version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jdtls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jdtls: brew install jdtls"
      },
      "args": []
    },
    {
      "namespace": "jdtls",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jdtls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jdtls",
        "passthrough": true,
        "missingDependencyHelp": "Install jdtls"
      },
      "args": []
    }
  ]
}