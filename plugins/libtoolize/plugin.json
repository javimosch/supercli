{
  "name": "libtoolize",
  "version": "0.1.0",
  "description": "CLI tool: libtoolize",
  "source": "https://manpages.debian.org/libtoolize",
  "checks": [
    {
      "type": "binary",
      "name": "libtoolize"
    }
  ],
  "install_guidance": {
    "plugin": "libtoolize",
    "binary": "libtoolize",
    "check": "which libtoolize",
    "install_steps": [
      "apt-get install libtoolize 2>/dev/null || which libtoolize",
      "Verify: libtoolize --version",
      "supercli plugins install ./plugins/libtoolize --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "libtoolize",
      "resource": "self",
      "action": "version",
      "description": "Print libtoolize version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libtoolize",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libtoolize: apt-get install libtoolize 2>/dev/null || which libtoolize"
      },
      "args": []
    },
    {
      "namespace": "libtoolize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libtoolize CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libtoolize",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install libtoolize: apt-get install libtoolize 2>/dev/null || which libtoolize"
      },
      "args": []
    }
  ]
}