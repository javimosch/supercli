{
  "name": "sogen",
  "version": "0.1.0",
  "description": "\ud83e\ude85 Windows & Linux userspace emulator ",
  "source": "https://github.com/sogen/sogen",
  "checks": [
    {
      "type": "binary",
      "name": "sogen"
    }
  ],
  "install_guidance": {
    "plugin": "sogen",
    "binary": "sogen",
    "check": "which sogen",
    "install_steps": [
      "pip install sogen",
      "Verify: sogen --version",
      "supercli plugins install ./plugins/sogen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sogen",
      "resource": "self",
      "action": "version",
      "description": "Print sogen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sogen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sogen: pip install sogen"
      },
      "args": []
    },
    {
      "namespace": "sogen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sogen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sogen",
        "passthrough": true,
        "missingDependencyHelp": "Install sogen: pip install sogen"
      },
      "args": []
    }
  ]
}