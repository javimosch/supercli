{
  "name": "go-md2man",
  "version": "0.1.0",
  "description": "Converts markdown into roff (man pages)",
  "source": "https://github.com/cpuguy83/go-md2man",
  "checks": [
    {
      "type": "binary",
      "name": "go-md2man"
    }
  ],
  "install_guidance": {
    "plugin": "go-md2man",
    "binary": "go-md2man",
    "check": "which go-md2man",
    "install_steps": [
      "brew install go-md2man",
      "Verify: go-md2man --version",
      "supercli plugins install ./plugins/go-md2man --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "go-md2man",
      "resource": "self",
      "action": "version",
      "description": "Print go-md2man version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-md2man",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-md2man: brew install go-md2man"
      },
      "args": []
    },
    {
      "namespace": "go-md2man",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-md2man CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-md2man",
        "passthrough": true,
        "missingDependencyHelp": "Install go-md2man"
      },
      "args": []
    }
  ]
}