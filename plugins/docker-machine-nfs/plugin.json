{
  "name": "docker-machine-nfs",
  "version": "0.1.0",
  "description": "Activates NFS on docker-machine",
  "source": "https://github.com/adlogix/docker-machine-nfs",
  "checks": [
    {
      "type": "binary",
      "name": "docker-machine-nfs"
    }
  ],
  "install_guidance": {
    "plugin": "docker-machine-nfs",
    "binary": "docker-machine-nfs",
    "check": "which docker-machine-nfs",
    "install_steps": [
      "brew install docker-machine-nfs",
      "Verify: docker-machine-nfs --version",
      "supercli plugins install ./plugins/docker-machine-nfs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "docker-machine-nfs",
      "resource": "self",
      "action": "version",
      "description": "Print docker-machine-nfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-machine-nfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-machine-nfs: brew install docker-machine-nfs"
      },
      "args": []
    },
    {
      "namespace": "docker-machine-nfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-machine-nfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-machine-nfs",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-machine-nfs"
      },
      "args": []
    }
  ]
}