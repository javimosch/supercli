{
  "name": "clitest",
  "version": "0.1.0",
  "description": "Command-Line Tester",
  "source": "https://github.com/aureliojargas/clitest",
  "checks": [
    {
      "type": "binary",
      "name": "clitest"
    }
  ],
  "install_guidance": {
    "plugin": "clitest",
    "binary": "clitest",
    "check": "which clitest",
    "install_steps": [
      "brew install clitest",
      "Verify: clitest --version",
      "supercli plugins install ./plugins/clitest --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clitest",
      "resource": "self",
      "action": "version",
      "description": "Print clitest version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clitest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clitest: brew install clitest"
      },
      "args": []
    },
    {
      "namespace": "clitest",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clitest CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clitest",
        "passthrough": true,
        "missingDependencyHelp": "Install clitest"
      },
      "args": []
    }
  ]
}