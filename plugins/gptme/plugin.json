{
  "name": "gptme",
  "version": "0.1.0",
  "description": "Interactive AI assistant in the terminal",
  "source": "https://github.com/janhq/gptme",
  "checks": [{ "type": "binary", "name": "gptme" }],
  "install_guidance": {
    "plugin": "gptme",
    "binary": "gptme",
    "check": "which gptme",
    "install_steps": ["pip install gptme", "Verify: gptme --version", "supercli plugins install ./plugins/gptme --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gptme",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gptme CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gptme",
      "passthrough": true,
      "missingDependencyHelp": "Install gptme: pip install gptme", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
