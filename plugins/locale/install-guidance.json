{
  "plugin": "locale",
  "binary": "locale",
  "check": "which locale",
  "install_steps": [
    "# Install locale",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/locale-linux-amd64 -o /usr/local/bin/locale",
    "chmod +x /usr/local/bin/locale",
    "# Or via package manager, see /usr/bin/locale"
  ]
}