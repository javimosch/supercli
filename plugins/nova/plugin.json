{
  "name": "nova",
  "version": "0.1.0",
  "description": "Find outdated Helm charts running in your cluster",
  "source": "https://github.com/FairwindsOps/nova",
  "checks": [{ "type": "binary", "name": "nova" }],
  "install_guidance": {
    "plugin": "nova",
    "binary": "nova",
    "check": "which nova",
    "install_steps": ["brew install nova", "Verify: nova --version", "supercli plugins install ./plugins/nova --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nova",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nova CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nova",
      "passthrough": true,
      "missingDependencyHelp": "Install nova: brew install nova"
    },
    "args": []
  }]
}
