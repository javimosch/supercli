{
  "name": "vuln-scanner",
  "version": "0.1.0",
  "description": "Generic CLI vulnerability scanner for dependencies",
  "source": "go",
  "checks": [{ "type": "binary", "name": "vuln-scanner" }],
  "install_guidance": {
    "plugin": "vuln-scanner",
    "binary": "vuln-scanner",
    "check": "which vuln-scanner",
    "install_steps": ["go install github.com/vuln-scanner@latest", "Verify: vuln-scanner --version", "supercli plugins install ./plugins/vuln-scanner --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vuln-scanner",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vuln-scanner CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vuln-scanner",
      "passthrough": true,
      "missingDependencyHelp": "Install vuln-scanner: go install github.com/vuln-scanner@latest"
    },
    "args": []
  }]
}
