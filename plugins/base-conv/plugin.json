{
  "name": "base-conv",
  "version": "0.1.0",
  "description": "Convert numbers between different numeric bases",
  "source": "https://github.com/doy/base-conv",
  "checks": [{ "type": "binary", "name": "base-conv" }],
  "install_guidance": {
    "plugin": "base-conv",
    "binary": "base-conv",
    "check": "which base-conv",
    "install_steps": ["cargo install base-conv", "Verify: base-conv --version", "supercli plugins install ./plugins/base-conv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "base-conv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to base-conv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "base-conv",
      "passthrough": true,
      "missingDependencyHelp": "Install base-conv: cargo install base-conv", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
