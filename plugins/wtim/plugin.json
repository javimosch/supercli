{
  "name": "wtim",
  "version": "0.1.0",
  "description": "Simple local-only terminal-based task timer",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "wtim" }],
  "install_guidance": {
    "plugin": "wtim",
    "binary": "wtim",
    "check": "which wtim",
    "install_steps": ["cargo install wtim", "Verify: wtim --version", "supercli plugins install ./plugins/wtim --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wtim",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wtim CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wtim",
      "passthrough": true,
      "missingDependencyHelp": "Install wtim: cargo install wtim"
    },
    "args": []
  }]
}
