{
  "name": "text2pcap",
  "version": "0.1.0",
  "description": "Convert hex dumps to packet captures",
  "source": "https://packages.debian.org/text2pcap",
  "checks": [{ "type": "binary", "name": "text2pcap" }],
  "install_guidance": {
    "plugin": "text2pcap", "binary": "text2pcap", "check": "which text2pcap",
    "install_steps": ["apt-get install wireshark-common", "Verify: text2pcap --version", "supercli plugins install ./plugins/text2pcap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "text2pcap", "resource": "_", "action": "_",
    "description": "Passthrough to text2pcap CLI",
    "adapter": "process", "adapterConfig": { "command": "text2pcap", "passthrough": true, "missingDependencyHelp": "Install text2pcap: apt-get install wireshark-common" }, "args": []
  }]
}
