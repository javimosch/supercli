{
  "name": "V3SP3R",
  "version": "0.1.0",
  "description": "AI Flipper control",
  "source": "https://github.com/V3SP3R/V3SP3R",
  "checks": [
    {
      "type": "binary",
      "name": "v3sp3r"
    }
  ],
  "install_guidance": {
    "plugin": "V3SP3R",
    "binary": "v3sp3r",
    "check": "which v3sp3r",
    "install_steps": [
      "pip install v3sp3r",
      "Verify: v3sp3r --version",
      "supercli plugins install ./plugins/V3SP3R --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "V3SP3R",
      "resource": "self",
      "action": "version",
      "description": "Print V3SP3R version",
      "adapter": "process",
      "adapterConfig": {
        "command": "v3sp3r",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install V3SP3R: pip install v3sp3r"
      },
      "args": []
    },
    {
      "namespace": "V3SP3R",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to v3sp3r CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "v3sp3r",
        "passthrough": true,
        "missingDependencyHelp": "Install V3SP3R: pip install v3sp3r"
      },
      "args": []
    }
  ]
}