{
  "name": "pbmtoxbm",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoxbm",
  "source": "https://manpages.debian.org/pbmtoxbm",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoxbm"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoxbm",
    "binary": "pbmtoxbm",
    "check": "which pbmtoxbm",
    "install_steps": [
      "apt-get install pbmtoxbm 2>/dev/null || which pbmtoxbm",
      "Verify: pbmtoxbm --version",
      "supercli plugins install ./plugins/pbmtoxbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoxbm",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoxbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoxbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoxbm: apt-get install pbmtoxbm 2>/dev/null || which pbmtoxbm"
      },
      "args": []
    },
    {
      "namespace": "pbmtoxbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoxbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoxbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoxbm: apt-get install pbmtoxbm 2>/dev/null || which pbmtoxbm"
      },
      "args": []
    }
  ]
}