{
  "name": "homebrew",
  "version": "1.0.0",
  "description": "homebrew \u2014 macOS package manager",
  "source": "brew.sh",
  "checks": [
    {
      "type": "binary",
      "name": "brew"
    }
  ],
  "install_guidance": {
    "plugin": "homebrew",
    "binary": "brew",
    "check": "which brew",
    "install_steps": [
      "# Install homebrew",
      "# See brew.sh",
      "# apt: sudo apt-get install homebrew",
      "# brew: brew install homebrew",
      "# cargo: cargo install homebrew",
      "# npm: npm install -g homebrew",
      "# pip: pip install homebrew"
    ]
  },
  "commands": [
    {
      "namespace": "homebrew",
      "resource": "homebrew",
      "action": "run",
      "description": "Run homebrew",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install homebrew from brew.sh"
      },
      "args": []
    }
  ]
}