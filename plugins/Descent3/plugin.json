{
  "name": "Descent3",
  "version": "0.1.0",
  "description": "Descent 3 by Outrage Entertainment",
  "source": "https://github.com/Descent3/Descent3",
  "checks": [
    {
      "type": "binary",
      "name": "descent3"
    }
  ],
  "install_guidance": {
    "plugin": "Descent3",
    "binary": "descent3",
    "check": "which descent3",
    "install_steps": [
      "pip install descent3",
      "Verify: descent3 --version",
      "supercli plugins install ./plugins/Descent3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Descent3",
      "resource": "self",
      "action": "version",
      "description": "Print Descent3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "descent3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Descent3: pip install descent3"
      },
      "args": []
    },
    {
      "namespace": "Descent3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to descent3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "descent3",
        "passthrough": true,
        "missingDependencyHelp": "Install Descent3: pip install descent3"
      },
      "args": []
    }
  ]
}