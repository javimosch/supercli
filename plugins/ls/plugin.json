{
  "name": "ls",
  "version": "0.1.0",
  "description": "ls \u2014 list directory contents",
  "source": "https://www.gnu.org/software/coreutils/",
  "checks": [
    {
      "type": "binary",
      "name": "ls"
    }
  ],
  "install_guidance": {
    "plugin": "ls",
    "binary": "ls",
    "check": "which ls",
    "install_steps": [
      "base system",
      "supercli plugins install ./plugins/ls --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ls",
      "resource": "self",
      "action": "version",
      "description": "Print ls version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ls: base system"
      },
      "args": []
    },
    {
      "namespace": "ls",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ls",
        "passthrough": true,
        "missingDependencyHelp": "Install ls: base system"
      },
      "args": []
    }
  ]
}
