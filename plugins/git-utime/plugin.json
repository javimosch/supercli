{
  "name": "git-utime",
  "version": "0.1.0",
  "description": "Change file modification times to git commit time",
  "source": "https://github.com/bluebrother/git-utime",
  "checks": [
    {
      "type": "binary",
      "name": "git-utime"
    }
  ],
  "install_guidance": {
    "plugin": "git-utime",
    "binary": "git-utime",
    "check": "which git-utime",
    "install_steps": [
      "npm install -g git-utime",
      "Verify: git-utime --version",
      "supercli plugins install ./plugins/git-utime --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "git-utime",
      "resource": "self",
      "action": "version",
      "description": "Print git-utime version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-utime",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-utime: npm install -g git-utime"
      },
      "args": []
    },
    {
      "namespace": "git-utime",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-utime CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-utime",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install git-utime: npm install -g git-utime"
      },
      "args": []
    }
  ]
}
