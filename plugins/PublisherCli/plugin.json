{
  "name": "PublisherCli",
  "version": "0.1.0",
  "description": "PublisherPhp is the component that allows publish events or stats using a console command.",
  "source": "https://github.com/PublisherCli/PublisherCli",
  "checks": [
    {
      "type": "binary",
      "name": "PublisherCli"
    }
  ],
  "install_guidance": {
    "plugin": "PublisherCli",
    "binary": "PublisherCli",
    "check": "which PublisherCli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: PublisherCli --version",
      "supercli plugins install ./plugins/PublisherCli --on-conflict replace --json"
    ],
    "note": "PHP language CLI tool"
  },
  "commands": [
    {
      "namespace": "PublisherCli",
      "resource": "self",
      "action": "version",
      "description": "Print PublisherCli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "PublisherCli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PublisherCli from project repository"
      },
      "args": []
    },
    {
      "namespace": "PublisherCli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to PublisherCli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "PublisherCli",
        "passthrough": true,
        "missingDependencyHelp": "Install PublisherCli from project repository"
      },
      "args": []
    }
  ]
}