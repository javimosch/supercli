{
  "name": "oh-my-openagent",
  "version": "0.1.0",
  "description": "omo; the one and only agent harness for complex codebases. the pickaxe for complex software engineer",
  "source": "https://github.com/oh-my-openagent/oh-my-openagent",
  "checks": [
    {
      "type": "binary",
      "name": "oh-my-openagent"
    }
  ],
  "install_guidance": {
    "plugin": "oh-my-openagent",
    "binary": "oh-my-openagent",
    "check": "which oh-my-openagent",
    "install_steps": [
      "pip install oh-my-openagent",
      "Verify: oh-my-openagent --version",
      "supercli plugins install ./plugins/oh-my-openagent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oh-my-openagent",
      "resource": "self",
      "action": "version",
      "description": "Print oh-my-openagent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oh-my-openagent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oh-my-openagent: pip install oh-my-openagent"
      },
      "args": []
    },
    {
      "namespace": "oh-my-openagent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oh-my-openagent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oh-my-openagent",
        "passthrough": true,
        "missingDependencyHelp": "Install oh-my-openagent: pip install oh-my-openagent"
      },
      "args": []
    }
  ]
}