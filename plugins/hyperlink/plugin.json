{
  "name": "hyperlink",
  "version": "0.1.0",
  "description": "Fast link checker for documentation and markdown files",
  "source": "https://github.com/lycheeverse/lychee",
  "checks": [{ "type": "binary", "name": "lychee" }],
  "install_guidance": {
    "plugin": "hyperlink",
    "binary": "lychee",
    "check": "which lychee",
    "install_steps": ["cargo install lychee", "Verify: lychee --version", "supercli plugins install ./plugins/hyperlink --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hyperlink",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lychee CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lychee",
      "passthrough": true,
      "missingDependencyHelp": "Install hyperlink: cargo install lychee"
    },
    "args": []
  }]
}
