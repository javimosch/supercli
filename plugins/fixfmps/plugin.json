{
  "name": "fixfmps",
  "version": "0.1.0",
  "description": "CLI tool: fixfmps",
  "source": "https://manpages.debian.org/fixfmps",
  "checks": [
    {
      "type": "binary",
      "name": "fixfmps"
    }
  ],
  "install_guidance": {
    "plugin": "fixfmps",
    "binary": "fixfmps",
    "check": "which fixfmps",
    "install_steps": [
      "apt-get install fixfmps 2>/dev/null || which fixfmps",
      "Verify: fixfmps --version",
      "supercli plugins install ./plugins/fixfmps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixfmps",
      "resource": "self",
      "action": "version",
      "description": "Print fixfmps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixfmps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixfmps: apt-get install fixfmps 2>/dev/null || which fixfmps"
      },
      "args": []
    },
    {
      "namespace": "fixfmps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixfmps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixfmps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixfmps: apt-get install fixfmps 2>/dev/null || which fixfmps"
      },
      "args": []
    }
  ]
}