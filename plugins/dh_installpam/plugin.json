{
  "name": "dh_installpam",
  "version": "0.1.0",
  "description": "CLI tool: dh_installpam",
  "source": "https://packages.debian.org/dh_installpam",
  "checks": [{ "type": "binary", "name": "dh_installpam" }],
  "install_guidance": {
    "plugin": "dh_installpam", "binary": "dh_installpam", "check": "which dh_installpam",
    "install_steps": ["apt-get install dh_installpam 2>/dev/null || which dh_installpam", "Verify: dh_installpam --version", "supercli plugins install ./plugins/dh_installpam --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_installpam", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installpam CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installpam", "passthrough": true, "missingDependencyHelp": "Install dh_installpam: apt-get install dh_installpam" }, "args": []
  }]
}
