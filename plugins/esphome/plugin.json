{
  "name": "esphome",
  "version": "0.1.0",
  "description": "Make creating custom firmwares for ESP32/ESP8266 super easy",
  "checks": [
    {
      "type": "binary",
      "name": "esphome"
    }
  ],
  "install_guidance": {
    "plugin": "esphome",
    "binary": "esphome",
    "check": "which esphome",
    "install_steps": [
      "brew install esphome",
      "Verify: esphome --version",
      "supercli plugins install ./plugins/esphome --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "esphome",
      "resource": "self",
      "action": "version",
      "description": "Print esphome version",
      "adapter": "process",
      "adapterConfig": {
        "command": "esphome",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install esphome: brew install esphome"
      },
      "args": []
    },
    {
      "namespace": "esphome",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to esphome CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "esphome",
        "passthrough": true,
        "missingDependencyHelp": "Install esphome"
      },
      "args": []
    }
  ]
}