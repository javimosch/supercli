{
  "plugin": "nb",
  "binary": "nb",
  "check": "nb --version",
  "install_steps": [
    "npm install -g nb.sh",
    "Verify: nb --version",
    "supercli plugins install ./plugins/nb --on-conflict replace --json"
  ],
  "note": "Requires npm and Node.js. Also available via Homebrew: brew install xwmx/taps/nb"
}
