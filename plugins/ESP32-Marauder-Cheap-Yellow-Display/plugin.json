{
  "name": "ESP32-Marauder-Cheap-Yellow-Display",
  "version": "0.1.0",
  "description": "ESP32Marauder Cheap Yellow Display",
  "source": "https://github.com/ESP32-Marauder-Cheap-Yellow-Display/ESP32-Marauder-Cheap-Yellow-Display",
  "checks": [
    {
      "type": "binary",
      "name": "esp32-marauder-cheap-yellow-display"
    }
  ],
  "install_guidance": {
    "plugin": "ESP32-Marauder-Cheap-Yellow-Display",
    "binary": "esp32-marauder-cheap-yellow-display",
    "check": "which esp32-marauder-cheap-yellow-display",
    "install_steps": [
      "pip install esp32-marauder-cheap-yellow-display",
      "Verify: esp32-marauder-cheap-yellow-display --version",
      "supercli plugins install ./plugins/ESP32-Marauder-Cheap-Yellow-Display --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ESP32-Marauder-Cheap-Yellow-Display",
      "resource": "self",
      "action": "version",
      "description": "Print ESP32-Marauder-Cheap-Yellow-Display version",
      "adapter": "process",
      "adapterConfig": {
        "command": "esp32-marauder-cheap-yellow-display",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ESP32-Marauder-Cheap-Yellow-Display: pip install esp32-marauder-cheap-yellow-display"
      },
      "args": []
    },
    {
      "namespace": "ESP32-Marauder-Cheap-Yellow-Display",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to esp32-marauder-cheap-yellow-display CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "esp32-marauder-cheap-yellow-display",
        "passthrough": true,
        "missingDependencyHelp": "Install ESP32-Marauder-Cheap-Yellow-Display: pip install esp32-marauder-cheap-yellow-display"
      },
      "args": []
    }
  ]
}