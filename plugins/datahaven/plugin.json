{
  "name": "datahaven",
  "version": "0.1.0",
  "description": "An EVM compatible Substrate chain, powered by StorageHub and secured by EigenLayer",
  "source": "https://github.com/datahaven/datahaven",
  "checks": [
    {
      "type": "binary",
      "name": "datahaven"
    }
  ],
  "install_guidance": {
    "plugin": "datahaven",
    "binary": "datahaven",
    "check": "which datahaven",
    "install_steps": [
      "pip install datahaven",
      "Verify: datahaven --version",
      "supercli plugins install ./plugins/datahaven --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "datahaven",
      "resource": "self",
      "action": "version",
      "description": "Print datahaven version",
      "adapter": "process",
      "adapterConfig": {
        "command": "datahaven",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install datahaven: pip install datahaven"
      },
      "args": []
    },
    {
      "namespace": "datahaven",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to datahaven CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "datahaven",
        "passthrough": true,
        "missingDependencyHelp": "Install datahaven: pip install datahaven"
      },
      "args": []
    }
  ]
}