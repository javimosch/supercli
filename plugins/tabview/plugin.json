{
  "name": "tabview",
  "version": "0.1.0",
  "description": "Python curses command line CSV and tabular data viewer.",
  "source": "https://github.com/TabViewer/tabview",
  "checks": [
    {
      "type": "binary",
      "name": "tabview"
    }
  ],
  "install_guidance": {
    "plugin": "tabview",
    "binary": "tabview",
    "check": "which tabview",
    "install_steps": [
      "See https://github.com/TabViewer/tabview",
      "Verify: tabview --version",
      "supercli plugins install ./plugins/tabview --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "tabview",
      "resource": "self",
      "action": "version",
      "description": "Print tabview version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tabview",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tabview: See https://github.com/TabViewer/tabview"
      },
      "args": []
    },
    {
      "namespace": "tabview",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tabview CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tabview",
        "passthrough": true,
        "missingDependencyHelp": "Install tabview"
      },
      "args": []
    }
  ]
}