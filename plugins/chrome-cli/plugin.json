{
  "name": "chrome-cli",
  "version": "0.1.0",
  "description": "Control Google Chrome from the command-line",
  "source": "https://github.com/prasmussen/chrome-cli",
  "checks": [
    {
      "type": "binary",
      "name": "chrome-cli"
    }
  ],
  "install_guidance": {
    "plugin": "chrome-cli",
    "binary": "chrome-cli",
    "check": "which chrome-cli",
    "install_steps": [
      "brew install chrome-cli",
      "Verify: chrome-cli --version",
      "supercli plugins install ./plugins/chrome-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chrome-cli",
      "resource": "self",
      "action": "version",
      "description": "Print chrome-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chrome-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chrome-cli: brew install chrome-cli"
      },
      "args": []
    },
    {
      "namespace": "chrome-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chrome-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chrome-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install chrome-cli"
      },
      "args": []
    }
  ]
}