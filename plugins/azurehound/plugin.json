{
  "name": "azurehound",
  "version": "0.1.0",
  "description": "Azure Data Exporter for BloodHound",
  "source": "https://github.com/SpecterOps/AzureHound",
  "checks": [
    {
      "type": "binary",
      "name": "azurehound"
    }
  ],
  "install_guidance": {
    "plugin": "azurehound",
    "binary": "azurehound",
    "check": "which azurehound",
    "install_steps": [
      "brew install azurehound",
      "Verify: azurehound --version",
      "supercli plugins install ./plugins/azurehound --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "azurehound",
      "resource": "self",
      "action": "version",
      "description": "Print azurehound version",
      "adapter": "process",
      "adapterConfig": {
        "command": "azurehound",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install azurehound: brew install azurehound"
      },
      "args": []
    },
    {
      "namespace": "azurehound",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to azurehound CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "azurehound",
        "passthrough": true,
        "missingDependencyHelp": "Install azurehound"
      },
      "args": []
    }
  ]
}