{
  "name": "sha384sum",
  "version": "0.1.0",
  "description": "Compute and check SHA-384 message digest",
  "source": "https://packages.debian.org/sha384sum",
  "checks": [
    { "type": "binary", "name": "sha384sum" }
  ],
  "install_guidance": {
    "plugin": "sha384sum",
    "binary": "sha384sum",
    "check": "which sha384sum",
    "install_steps": [
      "which sha384sum",
      "Verify: sha384sum --version",
      "supercli plugins install ./plugins/sha384sum --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "sha384sum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sha384sum CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sha384sum",
        "passthrough": true,
        "missingDependencyHelp": "Install sha384sum: which sha384sum"
      },
      "args": []
    }
  ]
}
