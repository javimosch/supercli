{
  "name": "res-downloader",
  "version": "0.1.0",
  "description": "\u89c6\u9891\u53f7\u3001\u5c0f\u7a0b\u5e8f\u3001\u6296\u97f3\u3001\u5feb\u624b\u3001\u5c0f\u7ea2\u4e66\u3001\u76f4\u64ad\u6d41\u3001m3u8\u3001\u9177\u72d7\u3001QQ\u97f3\u4e50\u7b49\u5e38\u89c1\u7f51\u7edc\u8d44\u6e90\u4e0b\u8f7d!",
  "source": "https://github.com/res-downloader/res-downloader",
  "checks": [
    {
      "type": "binary",
      "name": "res-downloader"
    }
  ],
  "install_guidance": {
    "plugin": "res-downloader",
    "binary": "res-downloader",
    "check": "which res-downloader",
    "install_steps": [
      "pip install res-downloader",
      "Verify: res-downloader --version",
      "supercli plugins install ./plugins/res-downloader --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "res-downloader",
      "resource": "self",
      "action": "version",
      "description": "Print res-downloader version",
      "adapter": "process",
      "adapterConfig": {
        "command": "res-downloader",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install res-downloader: pip install res-downloader"
      },
      "args": []
    },
    {
      "namespace": "res-downloader",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to res-downloader CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "res-downloader",
        "passthrough": true,
        "missingDependencyHelp": "Install res-downloader: pip install res-downloader"
      },
      "args": []
    }
  ]
}