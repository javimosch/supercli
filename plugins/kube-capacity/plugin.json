{
  "name": "kube-capacity",
  "version": "0.1.0",
  "description": "CLI for Kubernetes resource requests and limits capacity analysis",
  "source": "go",
  "checks": [{ "type": "binary", "name": "kube-capacity" }],
  "install_guidance": {
    "plugin": "kube-capacity",
    "binary": "kube-capacity",
    "check": "which kube-capacity",
    "install_steps": ["go install github.com/kube-capacity@latest", "Verify: kube-capacity --version", "supercli plugins install ./plugins/kube-capacity --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kube-capacity",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kube-capacity CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kube-capacity",
      "passthrough": true,
      "missingDependencyHelp": "Install kube-capacity: go install github.com/kube-capacity@latest"
    },
    "args": []
  }]
}
