{
  "name": "acli",
  "version": "0.1.0",
  "description": "CLI tool: acli",
  "source": "https://packages.debian.org/acli",
  "checks": [{ "type": "binary", "name": "acli" }],
  "install_guidance": {
    "plugin": "acli", "binary": "acli", "check": "which acli",
    "install_steps": ["apt-get install acli 2>/dev/null || which acli", "Verify: acli --version", "supercli plugins install ./plugins/acli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "acli", "resource": "_", "action": "_",
    "description": "Passthrough to acli CLI",
    "adapter": "process", "adapterConfig": { "command": "acli", "passthrough": true, "missingDependencyHelp": "Install acli: apt-get install acli" }, "args": []
  }]
}
