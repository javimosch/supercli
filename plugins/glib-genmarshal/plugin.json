{
  "name": "glib-genmarshal",
  "version": "0.1.0",
  "description": "CLI tool: glib-genmarshal",
  "source": "https://manpages.debian.org/glib-genmarshal",
  "checks": [
    {
      "type": "binary",
      "name": "glib-genmarshal"
    }
  ],
  "install_guidance": {
    "plugin": "glib-genmarshal",
    "binary": "glib-genmarshal",
    "check": "which glib-genmarshal",
    "install_steps": [
      "apt-get install glib-genmarshal 2>/dev/null || which glib-genmarshal",
      "Verify: glib-genmarshal --version",
      "supercli plugins install ./plugins/glib-genmarshal --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "glib-genmarshal",
      "resource": "self",
      "action": "version",
      "description": "Print glib-genmarshal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-genmarshal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install glib-genmarshal: apt-get install glib-genmarshal 2>/dev/null || which glib-genmarshal"
      },
      "args": []
    },
    {
      "namespace": "glib-genmarshal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glib-genmarshal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-genmarshal",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install glib-genmarshal: apt-get install glib-genmarshal 2>/dev/null || which glib-genmarshal"
      },
      "args": []
    }
  ]
}