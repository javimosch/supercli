{
  "name": "logpipe",
  "version": "0.1.0",
  "description": "Real-time log streaming, filtering and pattern alerting CLI tool written in Go",
  "source": "https://github.com/logpipe/logpipe",
  "checks": [
    {
      "type": "binary",
      "name": "logpipe"
    }
  ],
  "install_guidance": {
    "plugin": "logpipe",
    "binary": "logpipe",
    "check": "which logpipe",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: logpipe --version",
      "supercli plugins install ./plugins/logpipe --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "logpipe",
      "resource": "self",
      "action": "version",
      "description": "Print logpipe version",
      "adapter": "process",
      "adapterConfig": {
        "command": "logpipe",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install logpipe from project repository"
      },
      "args": []
    },
    {
      "namespace": "logpipe",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to logpipe CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "logpipe",
        "passthrough": true,
        "missingDependencyHelp": "Install logpipe from project repository"
      },
      "args": []
    }
  ]
}