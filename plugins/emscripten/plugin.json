{
  "name": "emscripten",
  "version": "1.0.0",
  "description": "emscripten \u2014 WASM compiler",
  "source": "emscripten.org",
  "checks": [
    {
      "type": "binary",
      "name": "emscripten"
    }
  ],
  "install_guidance": {
    "plugin": "emscripten",
    "binary": "emscripten",
    "check": "which emscripten",
    "install_steps": [
      "# Install emscripten",
      "# See emscripten.org",
      "# apt: sudo apt-get install emscripten",
      "# brew: brew install emscripten",
      "# cargo: cargo install emscripten",
      "# npm: npm install -g emscripten",
      "# pip: pip install emscripten"
    ]
  },
  "commands": [
    {
      "namespace": "emscripten",
      "resource": "emscripten",
      "action": "run",
      "description": "Run emscripten",
      "adapter": "process",
      "adapterConfig": {
        "command": "emscripten",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install emscripten from emscripten.org"
      },
      "args": []
    }
  ]
}