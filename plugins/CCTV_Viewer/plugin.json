{
  "name": "CCTV_Viewer",
  "version": "0.1.0",
  "description": "\u7535\u89c6\u6d4f\u89c8\u5668\uff0c\u4e00\u6b3e\u7b80\u6613\u7535\u89c6\u89c6\u9891\u6536\u770b\u8f6f\u4ef6\uff0c\u7528\u4e8e\u65b9\u4fbf\u7684\u5728\u673a\u9876\u76d2\u4e0a\u6536\u770b\u7f51\u9875\u89c6\u9891",
  "source": "https://github.com/CCTV_Viewer/CCTV_Viewer",
  "checks": [
    {
      "type": "binary",
      "name": "cctv-viewer"
    }
  ],
  "install_guidance": {
    "plugin": "CCTV_Viewer",
    "binary": "cctv-viewer",
    "check": "which cctv-viewer",
    "install_steps": [
      "pip install cctv-viewer",
      "Verify: cctv-viewer --version",
      "supercli plugins install ./plugins/CCTV_Viewer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CCTV_Viewer",
      "resource": "self",
      "action": "version",
      "description": "Print CCTV_Viewer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cctv-viewer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CCTV_Viewer: pip install cctv-viewer"
      },
      "args": []
    },
    {
      "namespace": "CCTV_Viewer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cctv-viewer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cctv-viewer",
        "passthrough": true,
        "missingDependencyHelp": "Install CCTV_Viewer: pip install cctv-viewer"
      },
      "args": []
    }
  ]
}