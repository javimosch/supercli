{
  "name": "lage",
  "version": "0.1.0",
  "description": "Task runner for JavaScript monorepos",
  "source": "https://github.com/microsoft/lage",
  "checks": [{ "type": "binary", "name": "lage" }],
  "install_guidance": {
    "plugin": "lage",
    "binary": "lage",
    "check": "which lage",
    "install_steps": ["npm install -g lage", "Verify: lage --version", "supercli plugins install ./plugins/lage --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lage",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lage CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lage",
      "passthrough": true,
      "missingDependencyHelp": "Install lage: npm install -g lage", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
