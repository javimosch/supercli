{
  "name": "containerization",
  "version": "0.1.0",
  "description": "Containerization is a Swift package for running Linux containers on macOS.",
  "source": "https://github.com/containerization/containerization",
  "checks": [
    {
      "type": "binary",
      "name": "containerization"
    }
  ],
  "install_guidance": {
    "plugin": "containerization",
    "binary": "containerization",
    "check": "which containerization",
    "install_steps": [
      "pip install containerization",
      "Verify: containerization --version",
      "supercli plugins install ./plugins/containerization --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "containerization",
      "resource": "self",
      "action": "version",
      "description": "Print containerization version",
      "adapter": "process",
      "adapterConfig": {
        "command": "containerization",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install containerization: pip install containerization"
      },
      "args": []
    },
    {
      "namespace": "containerization",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to containerization CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "containerization",
        "passthrough": true,
        "missingDependencyHelp": "Install containerization: pip install containerization"
      },
      "args": []
    }
  ]
}