{
  "name": "lxc-autostart",
  "version": "0.1.0",
  "description": "CLI tool: lxc-autostart",
  "source": "https://manpages.debian.org/lxc-autostart",
  "checks": [
    {
      "type": "binary",
      "name": "lxc-autostart"
    }
  ],
  "install_guidance": {
    "plugin": "lxc-autostart",
    "binary": "lxc-autostart",
    "check": "which lxc-autostart",
    "install_steps": [
      "apt-get install lxc-autostart 2>/dev/null || which lxc-autostart",
      "Verify: lxc-autostart --version",
      "supercli plugins install ./plugins/lxc-autostart --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lxc-autostart",
      "resource": "self",
      "action": "version",
      "description": "Print lxc-autostart version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lxc-autostart",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lxc-autostart: apt-get install lxc-autostart 2>/dev/null || which lxc-autostart"
      },
      "args": []
    },
    {
      "namespace": "lxc-autostart",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lxc-autostart CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lxc-autostart",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lxc-autostart: apt-get install lxc-autostart 2>/dev/null || which lxc-autostart"
      },
      "args": []
    }
  ]
}