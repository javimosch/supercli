{
  "name": "helm-controller",
  "version": "0.1.0",
  "description": "Helm chart reconciliation for Flux CD",
  "source": "https://github.com/fluxcd/helm-controller",
  "checks": [{ "type": "binary", "name": "helm-controller" }],
  "install_guidance": {
    "plugin": "helm-controller",
    "binary": "helm-controller",
    "check": "which helm-controller",
    "install_steps": ["brew install helm-controller", "Verify: helm-controller --version", "supercli plugins install ./plugins/helm-controller --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "helm-controller",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to helm-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "helm-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install helm-controller: brew install helm-controller"
    },
    "args": []
  }]
}
