      "namespace": "xkbprint",
      "resource": "self",
      "action": "version",
      "description": "Print xkbprint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkbprint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xkbprint: apt-get install xkbprint 2>/dev/null || which xkbprint"
      },
      "args": []
    },
    {
      "namespace": "xkbprint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xkbprint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkbprint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xkbprint: apt-get install xkbprint 2>/dev/null || which xkbprint"
      },
      "args": []
    }
  ]
