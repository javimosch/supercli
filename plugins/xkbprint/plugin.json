{
  "name": "xkbprint",
  "version": "0.1.0",
  "description": "CLI tool: xkbprint",
  "source": "https://manpages.debian.org/xkbprint",
  "checks": [
    {
      "type": "binary",
      "name": "xkbprint"
    }
  ],
  "install_guidance": {
    "plugin": "xkbprint",
    "binary": "xkbprint",
    "check": "which xkbprint",
    "install_steps": [
      "apt-get install xkbprint 2>/dev/null || which xkbprint",
      "Verify: xkbprint --version",
      "supercli plugins install ./plugins/xkbprint --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
