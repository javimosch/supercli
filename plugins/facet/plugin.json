{
  "name": "facet",
  "version": "0.1.0",
  "description": "Rust reflection and runtime serialization framework",
  "source": "https://github.com/facet-rs/facet",
  "checks": [
    {
      "type": "binary",
      "name": "facet"
    }
  ],
  "install_guidance": {
    "plugin": "facet",
    "binary": "facet",
    "check": "which facet",
    "install_steps": [
      "cargo install facet",
      "Verify: facet --version",
      "supercli plugins install ./plugins/facet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "facet",
      "resource": "self",
      "action": "version",
      "description": "Print facet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "facet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install facet: cargo install facet"
      },
      "args": []
    },
    {
      "namespace": "facet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to facet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "facet",
        "passthrough": true,
        "missingDependencyHelp": "Install facet: cargo install facet"
      },
      "args": []
    }
  ]
}
