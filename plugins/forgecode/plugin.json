{
  "name": "forgecode",
  "version": "0.1.0",
  "description": "AI enabled pair programmer for Claude, GPT, O Series, Grok, Deepseek, Gemini and 300+ models",
  "source": "https://github.com/forgecode/forgecode",
  "checks": [
    {
      "type": "binary",
      "name": "forgecode"
    }
  ],
  "install_guidance": {
    "plugin": "forgecode",
    "binary": "forgecode",
    "check": "which forgecode",
    "install_steps": [
      "pip install forgecode",
      "Verify: forgecode --version",
      "supercli plugins install ./plugins/forgecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "forgecode",
      "resource": "self",
      "action": "version",
      "description": "Print forgecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "forgecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install forgecode: pip install forgecode"
      },
      "args": []
    },
    {
      "namespace": "forgecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to forgecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "forgecode",
        "passthrough": true,
        "missingDependencyHelp": "Install forgecode: pip install forgecode"
      },
      "args": []
    }
  ]
}