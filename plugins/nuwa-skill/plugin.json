{
  "name": "nuwa-skill",
  "version": "0.1.0",
  "description": "\u4f60\u60f3\u84b8\u998f\u7684\u4e0b\u4e00\u4e2a\u5458\u5de5\uff0c\u4f55\u5fc5\u662f\u540c\u4e8b\u3002\u84b8\u998f\u4efb\u4f55\u4eba\u7684\u601d\u7ef4\u65b9\u5f0f\u2014\u2014\u5fc3\u667a\u6a21\u578b\u3001\u51b3\u7b56\u542f\u53d1\u5f0f\u3001\u8868\u8fbeDNA\u3002Distill how anyone thinks.",
  "source": "https://github.com/nuwa-skill/nuwa-skill",
  "checks": [
    {
      "type": "binary",
      "name": "nuwa-skill"
    }
  ],
  "install_guidance": {
    "plugin": "nuwa-skill",
    "binary": "nuwa-skill",
    "check": "which nuwa-skill",
    "install_steps": [
      "pip install nuwa-skill",
      "Verify: nuwa-skill --version",
      "supercli plugins install ./plugins/nuwa-skill --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nuwa-skill",
      "resource": "self",
      "action": "version",
      "description": "Print nuwa-skill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nuwa-skill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nuwa-skill: pip install nuwa-skill"
      },
      "args": []
    },
    {
      "namespace": "nuwa-skill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nuwa-skill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nuwa-skill",
        "passthrough": true,
        "missingDependencyHelp": "Install nuwa-skill: pip install nuwa-skill"
      },
      "args": []
    }
  ]
}