{
  "name": "CLI-Anything",
  "version": "0.1.0",
  "description": "\"CLI-Anything: Making ALL Software Agent-Native\" -- CLI-Hub: https://clianything.cc/",
  "source": "https://github.com/CLI-Anything/CLI-Anything",
  "checks": [
    {
      "type": "binary",
      "name": "cli-anything"
    }
  ],
  "install_guidance": {
    "plugin": "CLI-Anything",
    "binary": "cli-anything",
    "check": "which cli-anything",
    "install_steps": [
      "pip install cli-anything",
      "Verify: cli-anything --version",
      "supercli plugins install ./plugins/CLI-Anything --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CLI-Anything",
      "resource": "self",
      "action": "version",
      "description": "Print CLI-Anything version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-anything",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CLI-Anything: pip install cli-anything"
      },
      "args": []
    },
    {
      "namespace": "CLI-Anything",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-anything CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-anything",
        "passthrough": true,
        "missingDependencyHelp": "Install CLI-Anything: pip install cli-anything"
      },
      "args": []
    }
  ]
}