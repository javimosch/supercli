{
  "name": "firewall-cmd",
  "version": "1.0.0",
  "description": "firewall-cmd \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=firewall-cmd+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "firewall-cmd"
    }
  ],
  "install_guidance": {
    "plugin": "firewall-cmd",
    "binary": "firewall-cmd",
    "check": "which firewall-cmd",
    "install_steps": [
      "Install firewall-cmd via package manager: apt install firewall-cmd or brew install firewall-cmd"
    ]
  },
  "commands": [
    {
      "namespace": "firewallcmd",
      "resource": "run",
      "action": "exec",
      "description": "firewall-cmd \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "firewall-cmd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install firewall-cmd via your package manager"
      },
      "args": []
    }
  ]
}