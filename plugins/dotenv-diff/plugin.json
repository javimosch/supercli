{
  "name": "dotenv-diff",
  "version": "0.1.0",
  "description": "Validate environment variable usage in a codebase",
  "source": "https://github.com/Chrilleweb/dotenv-diff",
  "checks": [
    {
      "type": "binary",
      "name": "dotenv-diff"
    }
  ],
  "install_guidance": {
    "plugin": "dotenv-diff",
    "binary": "dotenv-diff",
    "check": "which dotenv-diff",
    "install_steps": [
      "npm install -g dotenv-diff",
      "Verify: dotenv-diff --version",
      "supercli plugins install ./plugins/dotenv-diff --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dotenv-diff",
      "resource": "self",
      "action": "version",
      "description": "Print dotenv-diff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dotenv-diff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dotenv-diff: npm install -g dotenv-diff"
      },
      "args": []
    },
    {
      "namespace": "dotenv-diff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dotenv-diff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dotenv-diff",
        "passthrough": true,
        "missingDependencyHelp": "Install dotenv-diff"
      },
      "args": []
    }
  ]
}