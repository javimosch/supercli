{
  "name": "ipod-read-sysinfo-extended",
  "version": "0.1.0",
  "description": "CLI tool: ipod-read-sysinfo-extended",
  "source": "https://manpages.debian.org/ipod-read-sysinfo-extended",
  "checks": [
    {
      "type": "binary",
      "name": "ipod-read-sysinfo-extended"
    }
  ],
  "install_guidance": {
    "plugin": "ipod-read-sysinfo-extended",
    "binary": "ipod-read-sysinfo-extended",
    "check": "which ipod-read-sysinfo-extended",
    "install_steps": [
      "apt-get install ipod-read-sysinfo-extended 2>/dev/null || which ipod-read-sysinfo-extended",
      "Verify: ipod-read-sysinfo-extended --version",
      "supercli plugins install ./plugins/ipod-read-sysinfo-extended --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ipod-read-sysinfo-extended",
      "resource": "self",
      "action": "version",
      "description": "Print ipod-read-sysinfo-extended version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipod-read-sysinfo-extended",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipod-read-sysinfo-extended: apt-get install ipod-read-sysinfo-extended 2>/dev/null || which ipod-read-sysinfo-extended"
      },
      "args": []
    },
    {
      "namespace": "ipod-read-sysinfo-extended",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipod-read-sysinfo-extended CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipod-read-sysinfo-extended",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ipod-read-sysinfo-extended: apt-get install ipod-read-sysinfo-extended 2>/dev/null || which ipod-read-sysinfo-extended"
      },
      "args": []
    }
  ]
}