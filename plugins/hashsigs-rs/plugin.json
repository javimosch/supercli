{
  "name": "hashsigs-rs",
  "version": "0.1.0",
  "description": "Hash-based post quantum signatures in Rust",
  "source": "https://github.com/hashsigs-rs/hashsigs-rs",
  "checks": [
    {
      "type": "binary",
      "name": "hashsigs-rs"
    }
  ],
  "install_guidance": {
    "plugin": "hashsigs-rs",
    "binary": "hashsigs-rs",
    "check": "which hashsigs-rs",
    "install_steps": [
      "pip install hashsigs-rs",
      "Verify: hashsigs-rs --version",
      "supercli plugins install ./plugins/hashsigs-rs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hashsigs-rs",
      "resource": "self",
      "action": "version",
      "description": "Print hashsigs-rs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hashsigs-rs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hashsigs-rs: pip install hashsigs-rs"
      },
      "args": []
    },
    {
      "namespace": "hashsigs-rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hashsigs-rs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hashsigs-rs",
        "passthrough": true,
        "missingDependencyHelp": "Install hashsigs-rs: pip install hashsigs-rs"
      },
      "args": []
    }
  ]
}