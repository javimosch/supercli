{
  "name": "terratest",
  "version": "0.1.0",
  "description": "Go library for writing automated tests for infrastructure",
  "source": "https://github.com/gruntwork-io/terratest",
  "checks": [{ "type": "binary", "name": "terratest" }],
  "install_guidance": {
    "plugin": "terratest",
    "binary": "terratest",
    "check": "which terratest",
    "install_steps": ["go install github.com/gruntwork-io/terratest@latest", "Verify: terratest --version", "supercli plugins install ./plugins/terratest --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terratest",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terratest CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terratest",
      "passthrough": true,
      "missingDependencyHelp": "Install terratest: go install github.com/gruntwork-io/terratest@latest"
    },
    "args": []
  }]
}
