{
  "name": "dupseek",
  "version": "1.0.0",
  "description": "dupseek \u2014 Duplicate file finder",
  "source": "github.com/jaalto/dupseek",
  "checks": [
    {
      "type": "binary",
      "name": "dupseek"
    }
  ],
  "install_guidance": {
    "plugin": "dupseek",
    "binary": "dupseek",
    "check": "which dupseek",
    "install_steps": [
      "# Install dupseek",
      "# See github.com/jaalto/dupseek",
      "# apt: sudo apt-get install dupseek",
      "# brew: brew install dupseek",
      "# cargo: cargo install dupseek",
      "# npm: npm install -g dupseek",
      "# pip: pip install dupseek"
    ]
  },
  "commands": [
    {
      "namespace": "dupseek",
      "resource": "dupseek",
      "action": "run",
      "description": "Run dupseek",
      "adapter": "process",
      "adapterConfig": {
        "command": "dupseek",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dupseek from github.com/jaalto/dupseek"
      },
      "args": []
    }
  ]
}