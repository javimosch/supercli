{
  "name": "dcadec",
  "version": "0.1.0",
  "description": "DTS Coherent Acoustics decoder with support for HD extensions",
  "source": "https://github.com/foo86/dcadec",
  "checks": [
    {
      "type": "binary",
      "name": "dcadec"
    }
  ],
  "install_guidance": {
    "plugin": "dcadec",
    "binary": "dcadec",
    "check": "which dcadec",
    "install_steps": [
      "brew install dcadec",
      "Verify: dcadec --version",
      "supercli plugins install ./plugins/dcadec --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dcadec",
      "resource": "self",
      "action": "version",
      "description": "Print dcadec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dcadec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dcadec: brew install dcadec"
      },
      "args": []
    },
    {
      "namespace": "dcadec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dcadec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dcadec",
        "passthrough": true,
        "missingDependencyHelp": "Install dcadec"
      },
      "args": []
    }
  ]
}