{
  "name": "chatgpt-scraper",
  "version": "0.1.0",
  "description": "Easily collect responses from ChatGPT scraper by providing a prompt along with valid Web Scraper API",
  "source": "https://github.com/chatgpt-scraper/chatgpt-scraper",
  "checks": [
    {
      "type": "binary",
      "name": "chatgpt-scraper"
    }
  ],
  "install_guidance": {
    "plugin": "chatgpt-scraper",
    "binary": "chatgpt-scraper",
    "check": "which chatgpt-scraper",
    "install_steps": [
      "pip install chatgpt-scraper",
      "Verify: chatgpt-scraper --version",
      "supercli plugins install ./plugins/chatgpt-scraper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "chatgpt-scraper",
      "resource": "self",
      "action": "version",
      "description": "Print chatgpt-scraper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chatgpt-scraper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chatgpt-scraper: pip install chatgpt-scraper"
      },
      "args": []
    },
    {
      "namespace": "chatgpt-scraper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chatgpt-scraper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chatgpt-scraper",
        "passthrough": true,
        "missingDependencyHelp": "Install chatgpt-scraper: pip install chatgpt-scraper"
      },
      "args": []
    }
  ]
}