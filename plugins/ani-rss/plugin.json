{
  "name": "ani-rss",
  "version": "0.1.0",
  "description": "\u57fa\u4e8eRSS\u81ea\u52a8\u8ffd\u756a\u3001\u8ba2\u9605\u3001\u4e0b\u8f7d\u3001\u522e\u524a\u3001\u6d17\u7248",
  "source": "https://github.com/ani-rss/ani-rss",
  "checks": [
    {
      "type": "binary",
      "name": "ani-rss"
    }
  ],
  "install_guidance": {
    "plugin": "ani-rss",
    "binary": "ani-rss",
    "check": "which ani-rss",
    "install_steps": [
      "pip install ani-rss",
      "Verify: ani-rss --version",
      "supercli plugins install ./plugins/ani-rss --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ani-rss",
      "resource": "self",
      "action": "version",
      "description": "Print ani-rss version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ani-rss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ani-rss: pip install ani-rss"
      },
      "args": []
    },
    {
      "namespace": "ani-rss",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ani-rss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ani-rss",
        "passthrough": true,
        "missingDependencyHelp": "Install ani-rss: pip install ani-rss"
      },
      "args": []
    }
  ]
}