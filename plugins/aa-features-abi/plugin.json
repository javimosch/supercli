{
  "name": "aa-features-abi",
  "version": "0.1.0",
  "description": "CLI tool: aa-features-abi",
  "source": "https://manpages.debian.org/aa-features-abi",
  "checks": [
    {
      "type": "binary",
      "name": "aa-features-abi"
    }
  ],
  "install_guidance": {
    "plugin": "aa-features-abi",
    "binary": "aa-features-abi",
    "check": "which aa-features-abi",
    "install_steps": [
      "apt-get install aa-features-abi 2>/dev/null || which aa-features-abi",
      "Verify: aa-features-abi --version",
      "supercli plugins install ./plugins/aa-features-abi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aa-features-abi",
      "resource": "self",
      "action": "version",
      "description": "Print aa-features-abi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aa-features-abi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aa-features-abi: apt-get install aa-features-abi 2>/dev/null || which aa-features-abi"
      },
      "args": []
    },
    {
      "namespace": "aa-features-abi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aa-features-abi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aa-features-abi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install aa-features-abi: apt-get install aa-features-abi 2>/dev/null || which aa-features-abi"
      },
      "args": []
    }
  ]
}