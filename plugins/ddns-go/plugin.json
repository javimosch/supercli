{
  "name": "ddns-go",
  "version": "0.1.0",
  "description": "Simple and easy-to-use DDNS",
  "source": "https://github.com/jeessy2/ddns-go",
  "checks": [
    {
      "type": "binary",
      "name": "ddns-go"
    }
  ],
  "install_guidance": {
    "plugin": "ddns-go",
    "binary": "ddns-go",
    "check": "which ddns-go",
    "install_steps": [
      "brew install ddns-go",
      "Verify: ddns-go --version",
      "supercli plugins install ./plugins/ddns-go --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ddns-go",
      "resource": "self",
      "action": "version",
      "description": "Print ddns-go version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ddns-go",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ddns-go: brew install ddns-go"
      },
      "args": []
    },
    {
      "namespace": "ddns-go",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ddns-go CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ddns-go",
        "passthrough": true,
        "missingDependencyHelp": "Install ddns-go"
      },
      "args": []
    }
  ]
}