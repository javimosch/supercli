{
  "name": "xbrnetwork-ui",
  "version": "0.1.0",
  "description": "CLI tool: xbrnetwork-ui",
  "source": "https://manpages.debian.org/xbrnetwork-ui",
  "checks": [
    {
      "type": "binary",
      "name": "xbrnetwork-ui"
    }
  ],
  "install_guidance": {
    "plugin": "xbrnetwork-ui",
    "binary": "xbrnetwork-ui",
    "check": "which xbrnetwork-ui",
    "install_steps": [
      "apt-get install xbrnetwork-ui 2>/dev/null || which xbrnetwork-ui",
      "Verify: xbrnetwork-ui --version",
      "supercli plugins install ./plugins/xbrnetwork-ui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xbrnetwork-ui",
      "resource": "self",
      "action": "version",
      "description": "Print xbrnetwork-ui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbrnetwork-ui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xbrnetwork-ui: apt-get install xbrnetwork-ui 2>/dev/null || which xbrnetwork-ui"
      },
      "args": []
    },
    {
      "namespace": "xbrnetwork-ui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xbrnetwork-ui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbrnetwork-ui",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xbrnetwork-ui: apt-get install xbrnetwork-ui 2>/dev/null || which xbrnetwork-ui"
      },
      "args": []
    }
  ]
}