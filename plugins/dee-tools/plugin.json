{
  "name": "dee-tools",
  "version": "0.1.0",
  "description": "Meta utility for the dee-ink suite with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-tools" }],
  "install_guidance": {
    "plugin": "dee-tools",
    "binary": "dee-tools",
    "check": "which dee-tools",
    "install_steps": ["cargo install dee-tools", "Verify: dee-tools --version", "supercli plugins install ./plugins/dee-tools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-tools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-tools CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-tools",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-tools: cargo install dee-tools"
    },
    "args": []
  }]
}
