{
  "name": "git-worktree-runner",
  "version": "0.1.0",
  "description": "Bash-based Git worktree manager with editor and AI tool integration. Automates per-branch worktree c",
  "source": "https://github.com/git-worktree-runner/git-worktree-runner",
  "checks": [
    {
      "type": "binary",
      "name": "git-worktree-runner"
    }
  ],
  "install_guidance": {
    "plugin": "git-worktree-runner",
    "binary": "git-worktree-runner",
    "check": "which git-worktree-runner",
    "install_steps": [
      "pip install git-worktree-runner",
      "Verify: git-worktree-runner --version",
      "supercli plugins install ./plugins/git-worktree-runner --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "git-worktree-runner",
      "resource": "self",
      "action": "version",
      "description": "Print git-worktree-runner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-worktree-runner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-worktree-runner: pip install git-worktree-runner"
      },
      "args": []
    },
    {
      "namespace": "git-worktree-runner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-worktree-runner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-worktree-runner",
        "passthrough": true,
        "missingDependencyHelp": "Install git-worktree-runner: pip install git-worktree-runner"
      },
      "args": []
    }
  ]
}