{
  "name": "gotags",
  "version": "0.1.0",
  "description": "Tag generator for Go, compatible with ctags",
  "source": "https://github.com/jstemmer/gotags",
  "checks": [
    {
      "type": "binary",
      "name": "gotags"
    }
  ],
  "install_guidance": {
    "plugin": "gotags",
    "binary": "gotags",
    "check": "which gotags",
    "install_steps": [
      "brew install gotags",
      "Verify: gotags --version",
      "supercli plugins install ./plugins/gotags --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gotags",
      "resource": "self",
      "action": "version",
      "description": "Print gotags version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotags",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gotags: brew install gotags"
      },
      "args": []
    },
    {
      "namespace": "gotags",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gotags CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotags",
        "passthrough": true,
        "missingDependencyHelp": "Install gotags"
      },
      "args": []
    }
  ]
}