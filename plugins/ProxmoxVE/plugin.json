{
  "name": "ProxmoxVE",
  "version": "0.1.0",
  "description": "Proxmox VE Helper-Scripts (Community Edition) ",
  "source": "https://github.com/ProxmoxVE/ProxmoxVE",
  "checks": [
    {
      "type": "binary",
      "name": "proxmoxve"
    }
  ],
  "install_guidance": {
    "plugin": "ProxmoxVE",
    "binary": "proxmoxve",
    "check": "which proxmoxve",
    "install_steps": [
      "pip install proxmoxve",
      "Verify: proxmoxve --version",
      "supercli plugins install ./plugins/ProxmoxVE --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ProxmoxVE",
      "resource": "self",
      "action": "version",
      "description": "Print ProxmoxVE version",
      "adapter": "process",
      "adapterConfig": {
        "command": "proxmoxve",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ProxmoxVE: pip install proxmoxve"
      },
      "args": []
    },
    {
      "namespace": "ProxmoxVE",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to proxmoxve CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "proxmoxve",
        "passthrough": true,
        "missingDependencyHelp": "Install ProxmoxVE: pip install proxmoxve"
      },
      "args": []
    }
  ]
}