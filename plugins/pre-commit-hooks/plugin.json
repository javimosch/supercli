{
  "name": "pre-commit-hooks",
  "version": "0.1.0",
  "description": "Collection of pre-commit hooks for various tools",
  "source": "https://github.com/pre-commit/pre-commit-hooks",
  "checks": [{ "type": "binary", "name": "pre-commit-hooks" }],
  "install_guidance": {
    "plugin": "pre-commit-hooks",
    "binary": "pre-commit-hooks",
    "check": "which pre-commit-hooks",
    "install_steps": ["pip install pre-commit-hooks", "Verify: pre-commit-hooks --version", "supercli plugins install ./plugins/pre-commit-hooks --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pre-commit-hooks",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pre-commit-hooks CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pre-commit-hooks",
      "passthrough": true,
      "missingDependencyHelp": "Install pre-commit-hooks: pip install pre-commit-hooks", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
