  "commands": [{
    "namespace": "depotdir2", "resource": "_", "action": "_",
    "description": "Passthrough to depotdir2 CLI",
    "adapter": "process", "adapterConfig": { "command": "depotdir2", "passthrough": true, "missingDependencyHelp": "Install depotdir2: apt-get install depotdir2" }, "args": []
  }]
}
