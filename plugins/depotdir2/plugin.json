{
  "name": "depotdir2",
  "version": "0.1.0",
  "description": "CLI tool: depotdir2",
  "source": "https://packages.debian.org/depotdir2",
  "checks": [{ "type": "binary", "name": "depotdir2" }],
  "install_guidance": {
    "plugin": "depotdir2", "binary": "depotdir2", "check": "which depotdir2",
    "install_steps": ["apt-get install depotdir2 2>/dev/null || which depotdir2", "Verify: depotdir2 --version", "supercli plugins install ./plugins/depotdir2 --on-conflict replace --json"]
