{
  "plugin": "qshape",
  "binary": "qshape",
  "check": "which qshape",
  "install_steps": [
    "# Install qshape",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/qshape-linux-amd64 -o /usr/local/bin/qshape",
