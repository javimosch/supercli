{
  "name": "terminalizer",
  "version": "0.1.0",
  "description": "Record your terminal and generate animated GIFs",
  "source": "https://github.com/faressoft/terminalizer",
  "checks": [{ "type": "binary", "name": "terminalizer" }],
  "install_guidance": {
    "plugin": "terminalizer",
    "binary": "terminalizer",
    "check": "which terminalizer",
    "install_steps": ["npm install -g terminalizer", "Verify: terminalizer --version", "supercli plugins install ./plugins/terminalizer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terminalizer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terminalizer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terminalizer",
      "passthrough": true,
      "missingDependencyHelp": "Install terminalizer: npm install -g terminalizer", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
