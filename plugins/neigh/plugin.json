{
  "name": "neigh",
  "version": "0.1.0",
  "description": "Neighbor cache management",
  "source": "https://packages.debian.org/neigh",
  "checks": [{ "type": "binary", "name": "neigh" }],
  "install_guidance": {
    "plugin": "neigh", "binary": "neigh", "check": "which neigh",
    "install_steps": ["apt-get install iproute2", "Verify: neigh --version", "supercli plugins install ./plugins/neigh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "neigh", "resource": "_", "action": "_",
    "description": "Passthrough to neigh CLI",
    "adapter": "process", "adapterConfig": { "command": "neigh", "passthrough": true, "missingDependencyHelp": "Install neigh: apt-get install iproute2" }, "args": []
  }]
}
