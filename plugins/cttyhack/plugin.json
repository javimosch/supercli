{
  "name": "cttyhack",
  "version": "0.1.0",
  "description": "CLI tool: cttyhack",
  "source": "https://packages.debian.org/cttyhack",
  "checks": [{ "type": "binary", "name": "cttyhack" }],
  "install_guidance": {
    "plugin": "cttyhack", "binary": "cttyhack", "check": "which cttyhack",
    "install_steps": ["apt-get install cttyhack 2>/dev/null || which cttyhack", "Verify: cttyhack --version", "supercli plugins install ./plugins/cttyhack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cttyhack", "resource": "_", "action": "_",
    "description": "Passthrough to cttyhack CLI",
    "adapter": "process", "adapterConfig": { "command": "cttyhack", "passthrough": true, "missingDependencyHelp": "Install cttyhack: apt-get install cttyhack" }, "args": []
  }]
}
