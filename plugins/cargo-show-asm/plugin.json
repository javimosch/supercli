{
  "name": "cargo-show-asm",
  "version": "0.1.0",
  "description": "Inspect Rust generated assembly and LLVM IR from the CLI",
  "source": "https://github.com/pacak/cargo-show-asm",
  "checks": [{ "type": "binary", "name": "cargo-show-asm" }],
  "install_guidance": {
    "plugin": "cargo-show-asm",
    "binary": "cargo-show-asm",
    "check": "which cargo-show-asm",
    "install_steps": ["cargo install cargo-show-asm", "Verify: cargo-show-asm --version", "supercli plugins install ./plugins/cargo-show-asm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-show-asm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-show-asm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-show-asm",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-show-asm: cargo install cargo-show-asm"
    },
    "args": []
  }]
}
