{
  "name": "gfxutil",
  "version": "0.1.0",
  "description": "Device Properties conversion tool",
  "source": "https://github.com/acidanthera/gfxutil",
  "checks": [
    {
      "type": "binary",
      "name": "gfxutil"
    }
  ],
  "install_guidance": {
    "plugin": "gfxutil",
    "binary": "gfxutil",
    "check": "which gfxutil",
    "install_steps": [
      "brew install gfxutil",
      "Verify: gfxutil --version",
      "supercli plugins install ./plugins/gfxutil --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gfxutil",
      "resource": "self",
      "action": "version",
      "description": "Print gfxutil version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gfxutil",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gfxutil: brew install gfxutil"
      },
      "args": []
    },
    {
      "namespace": "gfxutil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gfxutil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gfxutil",
        "passthrough": true,
        "missingDependencyHelp": "Install gfxutil"
      },
      "args": []
    }
  ]
}