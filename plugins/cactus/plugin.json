{
  "name": "cactus",
  "version": "0.1.0",
  "description": "Low-latency AI engine for mobile devices & wearables",
  "source": "https://github.com/cactus/cactus",
  "checks": [
    {
      "type": "binary",
      "name": "cactus"
    }
  ],
  "install_guidance": {
    "plugin": "cactus",
    "binary": "cactus",
    "check": "which cactus",
    "install_steps": [
      "pip install cactus",
      "Verify: cactus --version",
      "supercli plugins install ./plugins/cactus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cactus",
      "resource": "self",
      "action": "version",
      "description": "Print cactus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cactus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cactus: pip install cactus"
      },
      "args": []
    },
    {
      "namespace": "cactus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cactus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cactus",
        "passthrough": true,
        "missingDependencyHelp": "Install cactus: pip install cactus"
      },
      "args": []
    }
  ]
}