{
  "name": "organize-rt",
  "version": "0.1.0",
  "description": "organize-cli in Rust with more customization",
  "checks": [
    {
      "type": "binary",
      "name": "organize-rt"
    }
  ],
  "install_guidance": {
    "plugin": "organize-rt",
    "binary": "organize-rt",
    "check": "which organize-rt",
    "install_steps": [
      "See undefined",
      "Verify: organize-rt --version",
      "supercli plugins install ./plugins/organize-rt --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "organize-rt",
      "resource": "self",
      "action": "version",
      "description": "Print organize-rt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "organize-rt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install organize-rt: See undefined"
      },
      "args": []
    },
    {
      "namespace": "organize-rt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to organize-rt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "organize-rt",
        "passthrough": true,
        "missingDependencyHelp": "Install organize-rt"
      },
      "args": []
    }
  ]
}