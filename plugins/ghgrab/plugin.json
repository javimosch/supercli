{
  "name": "ghgrab",
  "version": "1.0.0",
  "description": "Search and download files from GitHub directly from your terminal",
  "source": "https://github.com/abhixdd/ghgrab",
  "checks": [
    {
      "type": "binary",
      "name": "ghgrab",
      "args": [
        "version"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "ghgrab",
    "binary": "ghgrab",
    "check": "ghgrab version",
    "install_steps": [
      "go install github.com/abhixdd/ghgrab@latest"
    ],
    "note": "Requires Go to be installed"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ghgrab",
      "resource": "files",
      "action": "search",
      "description": "Search for files on GitHub",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghgrab",
        "baseArgs": [
          "search"
        ],
        "positionalArgs": [
          "query"
        ],
        "missingDependencyHelp": "Install ghgrab: go install github.com/abhixdd/ghgrab@latest"
      },
      "args": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Search query",
          "positional": true
        }
      ]
    },
    {
      "namespace": "ghgrab",
      "resource": "files",
      "action": "download",
      "description": "Download a file from GitHub",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghgrab",
        "baseArgs": [
          "download"
        ],
        "positionalArgs": [
          "owner",
          "repo",
          "path"
        ],
        "missingDependencyHelp": "Install ghgrab: go install github.com/abhixdd/ghgrab@latest"
      },
      "args": [
        {
          "name": "owner",
          "type": "string",
          "required": true,
          "description": "Repository owner",
          "positional": true
        },
        {
          "name": "repo",
          "type": "string",
          "required": true,
          "description": "Repository name",
          "positional": true
        },
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "File path in repo",
          "positional": true
        }
      ]
    },
    {
      "namespace": "ghgrab",
      "resource": "self",
      "action": "version",
      "description": "Print ghgrab version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghgrab",
        "baseArgs": [
          "version"
        ],
        "missingDependencyHelp": "Install ghgrab: go install github.com/abhixdd/ghgrab@latest"
      },
      "args": []
    },
    {
      "namespace": "ghgrab",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghgrab CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghgrab",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ghgrab: go install github.com/abhixdd/ghgrab@latest"
      },
      "args": []
    }
  ]
}
