{
  "name": "turboAPI",
  "version": "0.1.0",
  "description": "FastAPI-compatible Python framework with Zig HTTP core; 7x faster, free-threading native",
  "source": "https://github.com/turboAPI/turboAPI",
  "checks": [
    {
      "type": "binary",
      "name": "turboapi"
    }
  ],
  "install_guidance": {
    "plugin": "turboAPI",
    "binary": "turboapi",
    "check": "which turboapi",
    "install_steps": [
      "pip install turboapi",
      "Verify: turboapi --version",
      "supercli plugins install ./plugins/turboAPI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "turboAPI",
      "resource": "self",
      "action": "version",
      "description": "Print turboAPI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "turboapi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install turboAPI: pip install turboapi"
      },
      "args": []
    },
    {
      "namespace": "turboAPI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to turboapi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "turboapi",
        "passthrough": true,
        "missingDependencyHelp": "Install turboAPI: pip install turboapi"
      },
      "args": []
    }
  ]
}