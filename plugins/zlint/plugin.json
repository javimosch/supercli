{
  "name": "zlint",
  "version": "0.1.0",
  "description": "A linter for the Zig programming language",
  "source": "https://github.com/zlint/zlint",
  "checks": [
    {
      "type": "binary",
      "name": "zlint"
    }
  ],
  "install_guidance": {
    "plugin": "zlint",
    "binary": "zlint",
    "check": "which zlint",
    "install_steps": [
      "pip install zlint",
      "Verify: zlint --version",
      "supercli plugins install ./plugins/zlint --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zlint",
      "resource": "self",
      "action": "version",
      "description": "Print zlint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zlint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zlint: pip install zlint"
      },
      "args": []
    },
    {
      "namespace": "zlint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zlint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zlint",
        "passthrough": true,
        "missingDependencyHelp": "Install zlint: pip install zlint"
      },
      "args": []
    }
  ]
}