{
  "name": "cmdcache",
  "version": "0.1.0",
  "description": "Cache CLI script standard output in a minimally invasive way.",
  "source": "https://github.com/cmdcache/cmdcache",
  "checks": [
    {
      "type": "binary",
      "name": "cmdcache"
    }
  ],
  "install_guidance": {
    "plugin": "cmdcache",
    "binary": "cmdcache",
    "check": "which cmdcache",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cmdcache --version",
      "supercli plugins install ./plugins/cmdcache --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "cmdcache",
      "resource": "self",
      "action": "version",
      "description": "Print cmdcache version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmdcache",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmdcache from project repository"
      },
      "args": []
    },
    {
      "namespace": "cmdcache",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmdcache CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmdcache",
        "passthrough": true,
        "missingDependencyHelp": "Install cmdcache from project repository"
      },
      "args": []
    }
  ]
}