{
  "plugin": "grub-set-default",
  "binary": "grub-set-default",
  "check": "which grub-set-default",
  "install_steps": [
    "apt-get install grub-set-default 2>/dev/null || which grub-set-default",
    "Verify: grub-set-default --version",
    "supercli plugins install ./plugins/grub-set-default --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}