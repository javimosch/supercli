{
  "name": "cli-scripts",
  "version": "0.1.0",
  "description": "Various single file cli scripts for Linux",
  "source": "https://github.com/cli-scripts/cli-scripts",
  "checks": [
    {
      "type": "binary",
      "name": "cli-scripts"
    }
  ],
  "install_guidance": {
    "plugin": "cli-scripts",
    "binary": "cli-scripts",
    "check": "which cli-scripts",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cli-scripts --version",
      "supercli plugins install ./plugins/cli-scripts --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "cli-scripts",
      "resource": "self",
      "action": "version",
      "description": "Print cli-scripts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-scripts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-scripts from project repository"
      },
      "args": []
    },
    {
      "namespace": "cli-scripts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-scripts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-scripts",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-scripts from project repository"
      },
      "args": []
    }
  ]
}