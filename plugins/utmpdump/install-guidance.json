{
  "plugin": "utmpdump",
  "binary": "utmpdump",
  "check": "which utmpdump",
  "install_steps": [
    "apt-get install utmpdump 2>/dev/null || which utmpdump",
    "Verify: utmpdump --version",
    "supercli plugins install ./plugins/utmpdump --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}