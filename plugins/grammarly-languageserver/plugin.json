{
  "name": "grammarly-languageserver",
  "version": "0.1.0",
  "description": "Grammarly language server for IDEs",
  "source": "https://github.com/emacs-grammarly/grammarly-languageserver",
  "checks": [{ "type": "binary", "name": "grammarly-languageserver" }],
  "install_guidance": {
    "plugin": "grammarly-languageserver",
    "binary": "grammarly-languageserver",
    "check": "which grammarly-languageserver",
    "install_steps": ["npm install -g @emacs-grammarly/grammarly-languageserver", "Verify: grammarly-languageserver --version", "supercli plugins install ./plugins/grammarly-languageserver --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "grammarly-languageserver",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to grammarly-languageserver CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "grammarly-languageserver",
      "passthrough": true,
      "missingDependencyHelp": "Install grammarly-languageserver: npm install -g @emacs-grammarly/grammarly-languageserver", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
