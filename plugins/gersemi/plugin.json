{
  "name": "gersemi",
  "version": "0.1.0",
  "description": "Formatter to make your CMake code the real treasure",
  "source": "https://github.com/BlankSpruce/gersemi",
  "checks": [
    {
      "type": "binary",
      "name": "gersemi"
    }
  ],
  "install_guidance": {
    "plugin": "gersemi",
    "binary": "gersemi",
    "check": "which gersemi",
    "install_steps": [
      "brew install gersemi",
      "Verify: gersemi --version",
      "supercli plugins install ./plugins/gersemi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gersemi",
      "resource": "self",
      "action": "version",
      "description": "Print gersemi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gersemi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gersemi: brew install gersemi"
      },
      "args": []
    },
    {
      "namespace": "gersemi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gersemi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gersemi",
        "passthrough": true,
        "missingDependencyHelp": "Install gersemi"
      },
      "args": []
    }
  ]
}