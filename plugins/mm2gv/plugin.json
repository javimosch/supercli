{
  "name": "mm2gv",
  "version": "0.1.0",
  "description": "CLI tool: mm2gv",
  "source": "https://manpages.debian.org/mm2gv",
  "checks": [
    {
      "type": "binary",
      "name": "mm2gv"
    }
  ],
  "install_guidance": {
    "plugin": "mm2gv",
    "binary": "mm2gv",
    "check": "which mm2gv",
    "install_steps": [
      "apt-get install mm2gv 2>/dev/null || which mm2gv",
      "Verify: mm2gv --version",
      "supercli plugins install ./plugins/mm2gv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mm2gv",
      "resource": "self",
      "action": "version",
      "description": "Print mm2gv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mm2gv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mm2gv: apt-get install mm2gv 2>/dev/null || which mm2gv"
      },
      "args": []
    },
    {
      "namespace": "mm2gv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mm2gv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mm2gv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mm2gv: apt-get install mm2gv 2>/dev/null || which mm2gv"
      },
      "args": []
    }
  ]
}