{
  "name": "TagTinker",
  "version": "0.1.0",
  "description": "Flipper Zero app for ESL research using IR. All based on https://www.furrtek.org/?a=esl",
  "source": "https://github.com/TagTinker/TagTinker",
  "checks": [
    {
      "type": "binary",
      "name": "tagtinker"
    }
  ],
  "install_guidance": {
    "plugin": "TagTinker",
    "binary": "tagtinker",
    "check": "which tagtinker",
    "install_steps": [
      "pip install tagtinker",
      "Verify: tagtinker --version",
      "supercli plugins install ./plugins/TagTinker --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TagTinker",
      "resource": "self",
      "action": "version",
      "description": "Print TagTinker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tagtinker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TagTinker: pip install tagtinker"
      },
      "args": []
    },
    {
      "namespace": "TagTinker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tagtinker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tagtinker",
        "passthrough": true,
        "missingDependencyHelp": "Install TagTinker: pip install tagtinker"
      },
      "args": []
    }
  ]
}