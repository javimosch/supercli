{
  "name": "tinyauth",
  "version": "0.1.0",
  "description": "The tiniest authentication and authorization server you have ever seen.",
  "source": "https://github.com/tinyauth/tinyauth",
  "checks": [
    {
      "type": "binary",
      "name": "tinyauth"
    }
  ],
  "install_guidance": {
    "plugin": "tinyauth",
    "binary": "tinyauth",
    "check": "which tinyauth",
    "install_steps": [
      "pip install tinyauth",
      "Verify: tinyauth --version",
      "supercli plugins install ./plugins/tinyauth --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tinyauth",
      "resource": "self",
      "action": "version",
      "description": "Print tinyauth version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tinyauth",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tinyauth: pip install tinyauth"
      },
      "args": []
    },
    {
      "namespace": "tinyauth",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tinyauth CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tinyauth",
        "passthrough": true,
        "missingDependencyHelp": "Install tinyauth: pip install tinyauth"
      },
      "args": []
    }
  ]
}