{
  "name": "xmlpatterns",
  "version": "0.1.0",
  "description": "CLI tool: xmlpatterns",
  "source": "https://manpages.debian.org/xmlpatterns",
  "checks": [
    {
      "type": "binary",
      "name": "xmlpatterns"
    }
  ],
  "install_guidance": {
    "plugin": "xmlpatterns",
    "binary": "xmlpatterns",
    "check": "which xmlpatterns",
    "install_steps": [
      "apt-get install xmlpatterns 2>/dev/null || which xmlpatterns",
      "Verify: xmlpatterns --version",
      "supercli plugins install ./plugins/xmlpatterns --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xmlpatterns",
      "resource": "self",
      "action": "version",
      "description": "Print xmlpatterns version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlpatterns",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xmlpatterns: apt-get install xmlpatterns 2>/dev/null || which xmlpatterns"
      },
      "args": []
    },
    {
      "namespace": "xmlpatterns",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xmlpatterns CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlpatterns",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xmlpatterns: apt-get install xmlpatterns 2>/dev/null || which xmlpatterns"
      },
      "args": []
    }
  ]
}