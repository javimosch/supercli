{
  "name": "git-annex-remote-rclone",
  "version": "0.1.0",
  "description": "Use rclone supported cloud storage with git-annex",
  "source": "https://github.com/git-annex-remote-rclone/git-annex-remote-rclone",
  "checks": [
    {
      "type": "binary",
      "name": "git-annex-remote-rclone"
    }
  ],
  "install_guidance": {
    "plugin": "git-annex-remote-rclone",
    "binary": "git-annex-remote-rclone",
    "check": "which git-annex-remote-rclone",
    "install_steps": [
      "brew install git-annex-remote-rclone",
      "Verify: git-annex-remote-rclone --version",
      "supercli plugins install ./plugins/git-annex-remote-rclone --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-annex-remote-rclone",
      "resource": "self",
      "action": "version",
      "description": "Print git-annex-remote-rclone version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-annex-remote-rclone",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-annex-remote-rclone: brew install git-annex-remote-rclone"
      },
      "args": []
    },
    {
      "namespace": "git-annex-remote-rclone",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-annex-remote-rclone CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-annex-remote-rclone",
        "passthrough": true,
        "missingDependencyHelp": "Install git-annex-remote-rclone"
      },
      "args": []
    }
  ]
}