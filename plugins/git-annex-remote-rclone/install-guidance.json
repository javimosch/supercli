{
  "plugin": "git-annex-remote-rclone",
  "binary": "git-annex-remote-rclone",
  "check": "which git-annex-remote-rclone",
  "install_steps": [
    "brew install git-annex-remote-rclone",
    "Verify: git-annex-remote-rclone --version",
    "supercli plugins install ./plugins/git-annex-remote-rclone --on-conflict replace --json"
  ],
  "note": "Install from package manager"
}