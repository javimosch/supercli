{
  "name": "postsuper",
  "version": "1.0.0",
  "description": "postsuper \u2014 postsuper \u2014 CLI utility",
  "source": "/usr/sbin/postsuper",
  "checks": [
    {
      "type": "binary",
      "name": "postsuper"
    }
  ],
  "install_guidance": {
    "plugin": "postsuper",
    "binary": "postsuper",
    "check": "which postsuper",
    "install_steps": [
      "# Install postsuper:",
      "# apt: sudo apt-get install postsuper",
      "# brew: brew install postsuper",
      "# cargo: cargo install postsuper",
      "# npm: npm install -g postsuper",
      "# pip: pip install postsuper",
      "# or download from /usr/sbin/postsuper"
    ]
  },
  "commands": [
    {
      "namespace": "postsuper",
      "resource": "postsuper",
      "action": "run",
      "description": "Run postsuper",
      "adapter": "process",
      "adapterConfig": {
        "command": "postsuper",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postsuper from /usr/sbin/postsuper"
      },
      "args": []
    }
  ]
}