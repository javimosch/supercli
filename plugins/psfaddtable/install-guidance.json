{
  "plugin": "psfaddtable",
  "binary": "psfaddtable",
  "check": "which psfaddtable",
  "install_steps": [
    "# Install psfaddtable",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/psfaddtable-linux-amd64 -o /usr/local/bin/psfaddtable",
    "chmod +x /usr/local/bin/psfaddtable",
    "# Or via package manager, see /usr/bin/psfaddtable"
  ]
}