{
  "name": "psfaddtable",
  "version": "0.1.0",
  "description": "CLI tool: psfaddtable",
  "source": "https://manpages.debian.org/psfaddtable",
  "checks": [
    {
      "type": "binary",
      "name": "psfaddtable"
    }
  ],
  "install_guidance": {
    "plugin": "psfaddtable",
    "binary": "psfaddtable",
    "check": "which psfaddtable",
    "install_steps": [
      "apt-get install psfaddtable 2>/dev/null || which psfaddtable",
      "Verify: psfaddtable --version",
      "supercli plugins install ./plugins/psfaddtable --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "psfaddtable",
      "resource": "self",
      "action": "version",
      "description": "Print psfaddtable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfaddtable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install psfaddtable: apt-get install psfaddtable 2>/dev/null || which psfaddtable"
      },
      "args": []
    },
    {
      "namespace": "psfaddtable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to psfaddtable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfaddtable",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install psfaddtable: apt-get install psfaddtable 2>/dev/null || which psfaddtable"
      },
      "args": []
    }
  ]
}