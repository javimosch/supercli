{
  "plugin": "gnome-extensions-app",
  "binary": "gnome-extensions-app",
  "check": "which gnome-extensions-app",
  "install_steps": [
    "apt-get install gnome-extensions-app 2>/dev/null || which gnome-extensions-app",
    "Verify: gnome-extensions-app --version",
    "supercli plugins install ./plugins/gnome-extensions-app --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}