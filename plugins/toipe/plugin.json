{
  "name": "toipe",
  "version": "0.1.0",
  "description": "Yet another typing test, but crab flavored.",
  "source": "https://github.com/Samyak2/toipe",
  "checks": [
    {
      "type": "binary",
      "name": "toipe"
    }
  ],
  "install_guidance": {
    "plugin": "toipe",
    "binary": "toipe",
    "check": "which toipe",
    "install_steps": [
      "cargo install toipe",
      "Verify: toipe --version",
      "supercli plugins install ./plugins/toipe --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "toipe",
      "resource": "self",
      "action": "version",
      "description": "Print toipe version",
      "adapter": "process",
      "adapterConfig": {
        "command": "toipe",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install toipe: cargo install toipe"
      },
      "args": []
    },
    {
      "namespace": "toipe",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to toipe CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "toipe",
        "passthrough": true,
        "missingDependencyHelp": "Install toipe"
      },
      "args": []
    }
  ]
}