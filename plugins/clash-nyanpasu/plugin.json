{
  "name": "clash-nyanpasu",
  "version": "0.1.0",
  "description": "Clash Nyanpasu\uff5e(\u2220\u30fb\u03c9< )\u2312\u2606\u200b",
  "source": "https://github.com/clash-nyanpasu/clash-nyanpasu",
  "checks": [
    {
      "type": "binary",
      "name": "clash-nyanpasu"
    }
  ],
  "install_guidance": {
    "plugin": "clash-nyanpasu",
    "binary": "clash-nyanpasu",
    "check": "which clash-nyanpasu",
    "install_steps": [
      "pip install clash-nyanpasu",
      "Verify: clash-nyanpasu --version",
      "supercli plugins install ./plugins/clash-nyanpasu --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clash-nyanpasu",
      "resource": "self",
      "action": "version",
      "description": "Print clash-nyanpasu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clash-nyanpasu",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clash-nyanpasu: pip install clash-nyanpasu"
      },
      "args": []
    },
    {
      "namespace": "clash-nyanpasu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clash-nyanpasu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clash-nyanpasu",
        "passthrough": true,
        "missingDependencyHelp": "Install clash-nyanpasu: pip install clash-nyanpasu"
      },
      "args": []
    }
  ]
}