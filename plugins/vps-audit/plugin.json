{
  "name": "vps-audit",
  "version": "0.1.0",
  "description": "lightweight, dependency-free bash script for security, performance auditing and infrastructure monit",
  "source": "https://github.com/vps-audit/vps-audit",
  "checks": [
    {
      "type": "binary",
      "name": "vps-audit"
    }
  ],
  "install_guidance": {
    "plugin": "vps-audit",
    "binary": "vps-audit",
    "check": "which vps-audit",
    "install_steps": [
      "pip install vps-audit",
      "Verify: vps-audit --version",
      "supercli plugins install ./plugins/vps-audit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vps-audit",
      "resource": "self",
      "action": "version",
      "description": "Print vps-audit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vps-audit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vps-audit: pip install vps-audit"
      },
      "args": []
    },
    {
      "namespace": "vps-audit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vps-audit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vps-audit",
        "passthrough": true,
        "missingDependencyHelp": "Install vps-audit: pip install vps-audit"
      },
      "args": []
    }
  ]
}