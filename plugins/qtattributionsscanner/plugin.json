{
  "name": "qtattributionsscanner",
  "version": "0.1.0",
  "description": "CLI tool: qtattributionsscanner",
  "source": "https://manpages.debian.org/qtattributionsscanner",
  "checks": [
    {
      "type": "binary",
      "name": "qtattributionsscanner"
    }
  ],
  "install_guidance": {
    "plugin": "qtattributionsscanner",
    "binary": "qtattributionsscanner",
    "check": "which qtattributionsscanner",
    "install_steps": [
      "apt-get install qtattributionsscanner 2>/dev/null || which qtattributionsscanner",
      "Verify: qtattributionsscanner --version",
      "supercli plugins install ./plugins/qtattributionsscanner --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qtattributionsscanner",
      "resource": "self",
      "action": "version",
      "description": "Print qtattributionsscanner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qtattributionsscanner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qtattributionsscanner: apt-get install qtattributionsscanner 2>/dev/null || which qtattributionsscanner"
      },
      "args": []
    },
    {
      "namespace": "qtattributionsscanner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qtattributionsscanner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qtattributionsscanner",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qtattributionsscanner: apt-get install qtattributionsscanner 2>/dev/null || which qtattributionsscanner"
      },
      "args": []
    }
  ]
}