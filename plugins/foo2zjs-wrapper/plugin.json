{
  "name": "foo2zjs-wrapper",
  "version": "0.1.0",
  "description": "CLI tool: foo2zjs-wrapper",
  "source": "https://manpages.debian.org/foo2zjs-wrapper",
  "checks": [
    {
      "type": "binary",
      "name": "foo2zjs-wrapper"
    }
  ],
  "install_guidance": {
    "plugin": "foo2zjs-wrapper",
    "binary": "foo2zjs-wrapper",
    "check": "which foo2zjs-wrapper",
    "install_steps": [
      "apt-get install foo2zjs-wrapper 2>/dev/null || which foo2zjs-wrapper",
      "Verify: foo2zjs-wrapper --version",
      "supercli plugins install ./plugins/foo2zjs-wrapper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "foo2zjs-wrapper",
      "resource": "self",
      "action": "version",
      "description": "Print foo2zjs-wrapper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "foo2zjs-wrapper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install foo2zjs-wrapper: apt-get install foo2zjs-wrapper 2>/dev/null || which foo2zjs-wrapper"
      },
      "args": []
    },
    {
      "namespace": "foo2zjs-wrapper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to foo2zjs-wrapper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "foo2zjs-wrapper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install foo2zjs-wrapper: apt-get install foo2zjs-wrapper 2>/dev/null || which foo2zjs-wrapper"
      },
      "args": []
    }
  ]
}