{
  "name": "pv-migrate",
  "version": "0.1.0",
  "description": "Postgres version migration tool for seamless upgrades",
  "source": "https://github.com/search/pv-migrate",
  "checks": [{ "type": "binary", "name": "pv-migrate" }],
  "install_guidance": {
    "plugin": "pv-migrate",
    "binary": "pv-migrate",
    "check": "which pv-migrate",
    "install_steps": ["go install github.com/ric-v/pv-migrate@latest", "Verify: pv-migrate --version", "supercli plugins install ./plugins/pv-migrate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pv-migrate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pv-migrate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pv-migrate",
      "passthrough": true,
      "missingDependencyHelp": "Install pv-migrate: go install github.com/ric-v/pv-migrate@latest"
    },
    "args": []
  }]
}
