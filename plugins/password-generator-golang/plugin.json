{
  "name": "password-generator-golang",
  "version": "0.1.0",
  "description": "Simple Go-based random password string generator",
  "source": "https://pkg.go.dev/github.com/sahay-shashank/password-generator-golang",
  "checks": [{ "type": "binary", "name": "password-generator-golang" }],
  "install_guidance": {
    "plugin": "password-generator-golang",
    "binary": "password-generator-golang",
    "check": "which password-generator-golang",
    "install_steps": ["go install github.com/sahay-shashank/password-generator-golang@latest", "Verify: password-generator-golang --version", "supercli plugins install ./plugins/password-generator-golang --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "password-generator-golang",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to password-generator-golang CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "password-generator-golang",
      "passthrough": true,
      "missingDependencyHelp": "Install password-generator-golang: go install github.com/sahay-shashank/password-generator-golang@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
