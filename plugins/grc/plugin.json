    {"namespace": "grc", "resource": "_", "action": "_", "description": "Passthrough to grc CLI", "adapter": "process", "adapterConfig": {"command": "grc", "passthrough": true, "missingDependencyHelp": "Install grc: brew install grc"}, "args": []}
  ]
