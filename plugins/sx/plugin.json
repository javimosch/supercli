{
  "name": "sx",
  "version": "0.1.0",
  "description": "Fast and modern network scanner for discovery",
  "source": "https://github.com/v-byte-cpu/sx",
  "checks": [{ "type": "binary", "name": "sx" }],
  "install_guidance": {
    "plugin": "sx",
    "binary": "sx",
    "check": "which sx",
    "install_steps": ["go install github.com/v-byte-cpu/sx@latest", "Verify: sx --version", "supercli plugins install ./plugins/sx --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sx",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sx CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sx",
      "passthrough": true,
      "missingDependencyHelp": "Install sx: go install github.com/v-byte-cpu/sx@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
