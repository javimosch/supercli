{
  "name": "autoresearch",
  "version": "0.1.0",
  "description": "AI agents running research on single-GPU nanochat training automatically",
  "source": "https://github.com/autoresearch/autoresearch",
  "checks": [
    {
      "type": "binary",
      "name": "autoresearch"
    }
  ],
  "install_guidance": {
    "plugin": "autoresearch",
    "binary": "autoresearch",
    "check": "which autoresearch",
    "install_steps": [
      "pip install autoresearch",
      "Verify: autoresearch --version",
      "supercli plugins install ./plugins/autoresearch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "autoresearch",
      "resource": "self",
      "action": "version",
      "description": "Print autoresearch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "autoresearch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install autoresearch: pip install autoresearch"
      },
      "args": []
    },
    {
      "namespace": "autoresearch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to autoresearch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "autoresearch",
        "passthrough": true,
        "missingDependencyHelp": "Install autoresearch: pip install autoresearch"
      },
      "args": []
    }
  ]
}