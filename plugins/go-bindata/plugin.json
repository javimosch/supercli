{
  "name": "go-bindata",
  "version": "0.1.0",
  "description": "Embed binary assets into Go programs",
  "source": "https://github.com/go-bindata/go-bindata",
  "checks": [{ "type": "binary", "name": "go-bindata" }],
  "install_guidance": {
    "plugin": "go-bindata",
    "binary": "go-bindata",
    "check": "which go-bindata",
    "install_steps": ["go install github.com/go-bindata/go-bindata/...@latest", "Verify: go-bindata --version", "supercli plugins install ./plugins/go-bindata --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "go-bindata",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to go-bindata CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-bindata",
      "passthrough": true,
      "missingDependencyHelp": "Install go-bindata: go install github.com/go-bindata/go-bindata/...@latest"
    },
    "args": []
  }]
}
