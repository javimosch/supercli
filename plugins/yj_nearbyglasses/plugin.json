{
  "name": "yj_nearbyglasses",
  "version": "0.1.0",
  "description": "attempting to detect smart glasses nearby and warn you",
  "source": "https://github.com/yj_nearbyglasses/yj_nearbyglasses",
  "checks": [
    {
      "type": "binary",
      "name": "yj-nearbyglasses"
    }
  ],
  "install_guidance": {
    "plugin": "yj_nearbyglasses",
    "binary": "yj-nearbyglasses",
    "check": "which yj-nearbyglasses",
    "install_steps": [
      "pip install yj-nearbyglasses",
      "Verify: yj-nearbyglasses --version",
      "supercli plugins install ./plugins/yj_nearbyglasses --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yj_nearbyglasses",
      "resource": "self",
      "action": "version",
      "description": "Print yj_nearbyglasses version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yj-nearbyglasses",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yj_nearbyglasses: pip install yj-nearbyglasses"
      },
      "args": []
    },
    {
      "namespace": "yj_nearbyglasses",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yj-nearbyglasses CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yj-nearbyglasses",
        "passthrough": true,
        "missingDependencyHelp": "Install yj_nearbyglasses: pip install yj-nearbyglasses"
      },
      "args": []
    }
  ]
}