{
  "name": "gofr",
  "version": "0.1.0",
  "description": "An opinionated GoLang framework for accelerated microservice development. Built in support for datab",
  "source": "https://github.com/gofr/gofr",
  "checks": [
    {
      "type": "binary",
      "name": "gofr"
    }
  ],
  "install_guidance": {
    "plugin": "gofr",
    "binary": "gofr",
    "check": "which gofr",
    "install_steps": [
      "pip install gofr",
      "Verify: gofr --version",
      "supercli plugins install ./plugins/gofr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gofr",
      "resource": "self",
      "action": "version",
      "description": "Print gofr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gofr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gofr: pip install gofr"
      },
      "args": []
    },
    {
      "namespace": "gofr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gofr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gofr",
        "passthrough": true,
        "missingDependencyHelp": "Install gofr: pip install gofr"
      },
      "args": []
    }
  ]
}