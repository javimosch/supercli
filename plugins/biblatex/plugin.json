{
  "name": "biblatex",
  "version": "0.1.0",
  "description": "Bibliography formatting for LaTeX",
  "source": "https://github.com/plk/biblatex",
  "checks": [
    {
      "type": "binary",
      "name": "biblatex"
    }
  ],
  "install_guidance": {
    "plugin": "biblatex",
    "binary": "biblatex",
    "check": "which biblatex",
    "install_steps": [
      "brew install biblatex",
      "Verify: biblatex --version",
      "supercli plugins install ./plugins/biblatex --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "biblatex",
      "resource": "self",
      "action": "version",
      "description": "Print biblatex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "biblatex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install biblatex: brew install biblatex"
      },
      "args": []
    },
    {
      "namespace": "biblatex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to biblatex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "biblatex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install biblatex: brew install biblatex"
      },
      "args": []
    }
  ]
}
