{
  "name": "Ignite",
  "version": "0.1.0",
  "description": "A static site generator for Swift developers.",
  "source": "https://github.com/Ignite/Ignite",
  "checks": [
    {
      "type": "binary",
      "name": "ignite"
    }
  ],
  "install_guidance": {
    "plugin": "Ignite",
    "binary": "ignite",
    "check": "which ignite",
    "install_steps": [
      "pip install ignite",
      "Verify: ignite --version",
      "supercli plugins install ./plugins/Ignite --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Ignite",
      "resource": "self",
      "action": "version",
      "description": "Print Ignite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ignite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Ignite: pip install ignite"
      },
      "args": []
    },
    {
      "namespace": "Ignite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ignite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ignite",
        "passthrough": true,
        "missingDependencyHelp": "Install Ignite: pip install ignite"
      },
      "args": []
    }
  ]
}