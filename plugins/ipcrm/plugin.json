{
  "name": "ipcrm",
  "version": "1.0.0",
  "description": "ipcrm \u2014 ipcrm \u2014 CLI utility",
  "source": "/usr/bin/ipcrm",
  "checks": [
    {
      "type": "binary",
      "name": "ipcrm"
    }
  ],
  "install_guidance": {
    "plugin": "ipcrm",
    "binary": "ipcrm",
    "check": "which ipcrm",
    "install_steps": [
      "# Install ipcrm:",
      "# apt: sudo apt-get install ipcrm",
      "# brew: brew install ipcrm",
      "# cargo: cargo install ipcrm",
      "# npm: npm install -g ipcrm",
      "# pip: pip install ipcrm",
      "# or download from /usr/bin/ipcrm"
    ]
  },
  "commands": [
    {
      "namespace": "ipcrm",
      "resource": "ipcrm",
      "action": "run",
      "description": "Run ipcrm",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipcrm",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ipcrm from /usr/bin/ipcrm"
      },
      "args": []
    }
  ]
}