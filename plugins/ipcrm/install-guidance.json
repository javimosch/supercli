{
  "plugin": "ipcrm",
  "binary": "ipcrm",
  "check": "which ipcrm",
  "install_steps": [
    "# Install ipcrm",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ipcrm-linux-amd64 -o /usr/local/bin/ipcrm",
    "chmod +x /usr/local/bin/ipcrm",
    "# Or via package manager, see /usr/bin/ipcrm"
  ]
}