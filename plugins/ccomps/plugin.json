{
  "name": "ccomps",
  "version": "0.1.0",
  "description": "ccomps \u2014 connected components filter for graphs",
  "source": "https://packages.debian.org/ccomps",
  "checks": [{ "type": "binary", "name": "ccomps" }],
  "install_guidance": {
    "plugin": "ccomps", "binary": "ccomps", "check": "which ccomps",
    "install_steps": ["apt-get install ccomps 2>/dev/null || which ccomps", "Verify: ccomps --version", "supercli plugins install ./plugins/ccomps --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ccomps", "resource": "_", "action": "_",
    "description": "Passthrough to ccomps CLI",
    "adapter": "process", "adapterConfig": { "command": "ccomps", "passthrough": true, "missingDependencyHelp": "Install ccomps: apt-get install ccomps" }, "args": []
  }]
}
