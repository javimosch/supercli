{
  "name": "ompi-clean",
  "version": "0.1.0",
  "description": "CLI tool: ompi-clean",
  "source": "https://manpages.debian.org/ompi-clean",
  "checks": [
    {
      "type": "binary",
      "name": "ompi-clean"
    }
  ],
  "install_guidance": {
    "plugin": "ompi-clean",
    "binary": "ompi-clean",
    "check": "which ompi-clean",
    "install_steps": [
      "apt-get install ompi-clean 2>/dev/null || which ompi-clean",
      "Verify: ompi-clean --version",
      "supercli plugins install ./plugins/ompi-clean --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ompi-clean",
      "resource": "self",
      "action": "version",
      "description": "Print ompi-clean version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ompi-clean",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ompi-clean: apt-get install ompi-clean 2>/dev/null || which ompi-clean"
      },
      "args": []
    },
    {
      "namespace": "ompi-clean",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ompi-clean CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ompi-clean",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ompi-clean: apt-get install ompi-clean 2>/dev/null || which ompi-clean"
      },
      "args": []
    }
  ]
}