{
  "name": "prot-calc",
  "version": "0.1.0",
  "description": "Calculate molecular weight and isoelectric point of protein sequences",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "prot-calc" }],
  "install_guidance": {
    "plugin": "prot-calc",
    "binary": "prot-calc",
    "check": "which prot-calc",
    "install_steps": ["pip install prot-calc", "Verify: prot-calc --version", "supercli plugins install ./plugins/prot-calc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "prot-calc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to prot-calc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "prot-calc",
      "passthrough": true,
      "missingDependencyHelp": "Install prot-calc: pip install prot-calc"
    },
    "args": []
  }]
}
