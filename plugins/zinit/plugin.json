{
  "name": "zinit",
  "version": "0.1.0",
  "description": "Flexible Zsh plugin manager CLI — install, update, and list plugins with JSON output",
  "source": "https://github.com/zdharma-continuum/zinit",
  "checks": [
    {
      "type": "binary",
      "name": "zinit"
    }
  ],
  "install_guidance": {
    "plugin": "zinit",
    "binary": "zinit",
    "check": "which zinit",
    "install_steps": [
      "bash -c \"$(curl -fsSL https://raw.githubusercontent.com/zdharma-continuum/zinit/main/scripts/install.sh)\"",
      "Verify: zinit --version",
      "supercli plugins install ./plugins/zinit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zinit",
      "resource": "self",
      "action": "version",
      "description": "Print zinit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zinit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zinit: bash -c \"$(curl -fsSL https://raw.githubusercontent.com/zdharma-continuum/zinit/main/scripts/install.sh)\""
      },
      "args": []
    },
    {
      "namespace": "zinit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zinit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zinit",
        "passthrough": true,
        "missingDependencyHelp": "Install zinit: bash -c \"$(curl -fsSL https://raw.githubusercontent.com/zdharma-continuum/zinit/main/scripts/install.sh)\""
      },
      "args": []
    }
  ]
}
