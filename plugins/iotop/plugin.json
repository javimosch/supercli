{
  "name": "iotop",
  "version": "0.1.0",
  "description": "I/O monitoring tool for disk activity",
  "source": "https",
  "checks": [{"type": "binary", "name": "iotop"}],
  "install_guidance": {
    "plugin": "iotop",
    "binary": "iotop",
    "check": "which iotop",
    "install_steps": [
      "brew install iotop",
      "Verify: iotop --version",
      "supercli plugins install ./plugins/iotop --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "iotop",
      "resource": "self",
      "action": "version",
      "description": "Print iotop version",
      "adapter": "process",
      "adapterConfig": {"command": "iotop", "baseArgs": ["--version"], "missingDependencyHelp": "Install iotop: brew install iotop"},
      "args": []
    },
    {
      "namespace": "iotop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iotop CLI",
      "adapter": "process",
      "adapterConfig": {"command": "iotop", "passthrough": true, "missingDependencyHelp": "Install iotop: brew install iotop"},
      "args": []
    }
  ]
}
