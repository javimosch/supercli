{
  "name": "pk12util",
  "version": "0.1.0",
  "description": "CLI tool: pk12util",
  "source": "https://manpages.debian.org/pk12util",
  "checks": [
    {
      "type": "binary",
      "name": "pk12util"
    }
  ],
  "install_guidance": {
    "plugin": "pk12util",
    "binary": "pk12util",
    "check": "which pk12util",
    "install_steps": [
      "apt-get install pk12util 2>/dev/null || which pk12util",
      "Verify: pk12util --version",
      "supercli plugins install ./plugins/pk12util --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pk12util",
      "resource": "self",
      "action": "version",
      "description": "Print pk12util version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pk12util",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pk12util: apt-get install pk12util 2>/dev/null || which pk12util"
      },
      "args": []
    },
    {
      "namespace": "pk12util",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pk12util CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pk12util",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pk12util: apt-get install pk12util 2>/dev/null || which pk12util"
      },
      "args": []
    }
  ]
}