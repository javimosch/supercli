{
  "name": "libkiwix",
  "version": "0.1.0",
  "description": "Common code base for all Kiwix ports",
  "source": "https://github.com/kiwix/libkiwix",
  "checks": [
    {
      "type": "binary",
      "name": "libkiwix"
    }
  ],
  "install_guidance": {
    "plugin": "libkiwix",
    "binary": "libkiwix",
    "check": "which libkiwix",
    "install_steps": [
      "brew install libkiwix",
      "Verify: libkiwix --version",
      "supercli plugins install ./plugins/libkiwix --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libkiwix",
      "resource": "self",
      "action": "version",
      "description": "Print libkiwix version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libkiwix",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libkiwix: brew install libkiwix"
      },
      "args": []
    },
    {
      "namespace": "libkiwix",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libkiwix CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libkiwix",
        "passthrough": true,
        "missingDependencyHelp": "Install libkiwix"
      },
      "args": []
    }
  ]
}