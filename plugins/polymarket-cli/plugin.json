{
  "name": "polymarket-cli",
  "version": "0.1.0",
  "description": "CLI client for Polymarket prediction markets",
  "source": "https://github.com/nicholasgasior/polymarket-cli",
  "checks": [
    {
      "type": "binary",
      "name": "polymarket-cli"
    }
  ],
  "install_guidance": {
    "plugin": "polymarket-cli",
    "binary": "polymarket-cli",
    "check": "which polymarket-cli",
    "install_steps": [
      "cargo install polymarket-cli",
      "Verify: polymarket-cli --version",
      "supercli plugins install ./plugins/polymarket-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "polymarket-cli",
      "resource": "self",
      "action": "version",
      "description": "Print polymarket-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "polymarket-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install polymarket-cli: cargo install polymarket-cli"
      },
      "args": []
    },
    {
      "namespace": "polymarket-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to polymarket-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "polymarket-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install polymarket-cli: cargo install polymarket-cli"
      },
      "args": []
    }
  ]
}
