{
  "name": "asm-lsp",
  "version": "0.1.0",
  "description": "Language server for NASM/GAS/GO Assembly",
  "source": "https://github.com/bergercookie/asm-lsp",
  "checks": [
    {
      "type": "binary",
      "name": "asm-lsp"
    }
  ],
  "install_guidance": {
    "plugin": "asm-lsp",
    "binary": "asm-lsp",
    "check": "which asm-lsp",
    "install_steps": [
      "brew install asm-lsp",
      "Verify: asm-lsp --version",
      "supercli plugins install ./plugins/asm-lsp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "asm-lsp",
      "resource": "self",
      "action": "version",
      "description": "Print asm-lsp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "asm-lsp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install asm-lsp: brew install asm-lsp"
      },
      "args": []
    },
    {
      "namespace": "asm-lsp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to asm-lsp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "asm-lsp",
        "passthrough": true,
        "missingDependencyHelp": "Install asm-lsp"
      },
      "args": []
    }
  ]
}