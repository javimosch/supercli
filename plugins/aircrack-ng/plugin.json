{
  "name": "aircrack-ng",
  "version": "0.1.0",
  "description": "Wireless security audit suite",
  "source": "https://github.com/aircrack-ng/aircrack-ng",
  "checks": [
    {
      "type": "binary",
      "name": "aircrack-ng"
    }
  ],
  "install_guidance": {
    "plugin": "aircrack-ng",
    "binary": "aircrack-ng",
    "check": "which aircrack-ng",
    "install_steps": [
      "brew install aircrack-ng",
      "Verify: aircrack-ng --version",
      "supercli plugins install ./plugins/aircrack-ng --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "aircrack-ng",
      "resource": "self",
      "action": "version",
      "description": "Print aircrack-ng version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aircrack-ng",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aircrack-ng: brew install aircrack-ng"
      },
      "args": []
    },
    {
      "namespace": "aircrack-ng",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aircrack-ng CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aircrack-ng",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install aircrack-ng: brew install aircrack-ng"
      },
      "args": []
    }
  ]
}
