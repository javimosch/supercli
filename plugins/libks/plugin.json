{
  "name": "libks",
  "version": "0.1.0",
  "description": "Foundational support for signalwire C products",
  "source": "https://github.com/signalwire/libks",
  "checks": [
    {
      "type": "binary",
      "name": "libks"
    }
  ],
  "install_guidance": {
    "plugin": "libks",
    "binary": "libks",
    "check": "which libks",
    "install_steps": [
      "brew install libks",
      "Verify: libks --version",
      "supercli plugins install ./plugins/libks --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libks",
      "resource": "self",
      "action": "version",
      "description": "Print libks version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libks",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libks: brew install libks"
      },
      "args": []
    },
    {
      "namespace": "libks",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libks CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libks",
        "passthrough": true,
        "missingDependencyHelp": "Install libks"
      },
      "args": []
    }
  ]
}