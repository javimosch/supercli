{
  "name": "bettercap",
  "version": "1.0.0",
  "description": "bettercap \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=bettercap+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "bettercap"
    }
  ],
  "install_guidance": {
    "plugin": "bettercap",
    "binary": "bettercap",
    "check": "which bettercap",
    "install_steps": [
      "Install bettercap via package manager: apt install bettercap or brew install bettercap"
    ]
  },
  "commands": [
    {
      "namespace": "bettercap",
      "resource": "run",
      "action": "exec",
      "description": "bettercap \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "bettercap",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install bettercap via your package manager"
      },
      "args": []
    }
  ]
}