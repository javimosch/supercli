{
  "name": "mtproto.zig",
  "version": "0.1.0",
  "description": "High-performance Telegram proxy with DPI evasion",
  "source": "https://github.com/mtproto.zig/mtproto.zig",
  "checks": [
    {
      "type": "binary",
      "name": "mtproto.zig"
    }
  ],
  "install_guidance": {
    "plugin": "mtproto.zig",
    "binary": "mtproto.zig",
    "check": "which mtproto.zig",
    "install_steps": [
      "pip install mtproto.zig",
      "Verify: mtproto.zig --version",
      "supercli plugins install ./plugins/mtproto.zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mtproto.zig",
      "resource": "self",
      "action": "version",
      "description": "Print mtproto.zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtproto.zig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mtproto.zig: pip install mtproto.zig"
      },
      "args": []
    },
    {
      "namespace": "mtproto.zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mtproto.zig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtproto.zig",
        "passthrough": true,
        "missingDependencyHelp": "Install mtproto.zig: pip install mtproto.zig"
      },
      "args": []
    }
  ]
}