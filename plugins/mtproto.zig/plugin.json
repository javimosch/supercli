{
  "name": "mtproto.zig",
  "version": "0.1.0",
  "description": "High-performance Telegram proxy",
  "source": "https://github.com/nickelc/mtproto.zig",
  "checks": [
    {
      "type": "binary",
      "name": "mtproto"
    }
  ],
  "install_guidance": {
    "plugin": "mtproto.zig",
    "binary": "mtproto",
    "check": "which mtproto",
    "install_steps": [
      "cargo install mtproto-zig",
      "Verify: mtproto --version",
      "supercli plugins install ./plugins/mtproto.zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mtproto.zig",
      "resource": "self",
      "action": "version",
      "description": "Print mtproto.zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtproto",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mtproto.zig: cargo install mtproto-zig"
      },
      "args": []
    },
    {
      "namespace": "mtproto.zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mtproto",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtproto",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mtproto.zig: cargo install mtproto-zig"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
