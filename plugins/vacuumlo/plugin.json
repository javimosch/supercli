{
  "name": "vacuumlo",
  "version": "0.1.0",
  "description": "CLI tool: vacuumlo",
  "source": "https://manpages.debian.org/vacuumlo",
  "checks": [
    {
      "type": "binary",
      "name": "vacuumlo"
    }
  ],
  "install_guidance": {
    "plugin": "vacuumlo",
    "binary": "vacuumlo",
    "check": "which vacuumlo",
    "install_steps": [
      "apt-get install vacuumlo 2>/dev/null || which vacuumlo",
      "Verify: vacuumlo --version",
      "supercli plugins install ./plugins/vacuumlo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vacuumlo",
      "resource": "self",
      "action": "version",
      "description": "Print vacuumlo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vacuumlo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vacuumlo: apt-get install vacuumlo 2>/dev/null || which vacuumlo"
      },
      "args": []
    },
    {
      "namespace": "vacuumlo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vacuumlo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vacuumlo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vacuumlo: apt-get install vacuumlo 2>/dev/null || which vacuumlo"
      },
      "args": []
    }
  ]
}