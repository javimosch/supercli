{
  "name": "solana-cli",
  "version": "0.1.0",
  "description": "Solana blockchain CLI for validators and tokens",
  "source": "https://github.com/solana-labs/solana",
  "checks": [{"type": "binary", "name": "solana"}],
  "install_guidance": {
    "plugin": "solana-cli",
    "binary": "solana",
    "check": "which solana",
    "install_steps": [
      "sh -c \"$(curl -sSfL https://release.solana.com/stable/solana-install-init-x86_64-unknown-linux-gnu)\"",
      "Verify: solana --version",
      "supercli plugins install ./plugins/solana-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "solana-cli",
      "resource": "self",
      "action": "version",
      "description": "Print solana-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "solana", "baseArgs": ["--version"], "missingDependencyHelp": "Install solana-cli: sh -c \"$(curl -sSfL https://release.solana.com/stable/solana-install-init-x86_64-unknown-linux-gnu)\""},
      "args": []
    },
    {
      "namespace": "solana-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to solana CLI",
      "adapter": "process",
      "adapterConfig": {"command": "solana", "passthrough": true, "missingDependencyHelp": "Install solana-cli: sh -c \"$(curl -sSfL https://release.solana.com/stable/solana-install-init-x86_64-unknown-linux-gnu)\""},
      "args": []
    }
  ]
}
