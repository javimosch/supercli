{
  "plugin": "solana-cli",
  "binary": "solana",
  "check": "which solana",
  "install_steps": [
    "sh -c \"$(curl -sSfL https://release.solana.com/stable/solana-install-init-x86_64-unknown-linux-gnu)\"",
    "Verify: solana --version",
    "supercli plugins install ./plugins/solana-cli --on-conflict replace --json"
  ]
}
