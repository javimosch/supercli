{
  "name": "rasttopnm",
  "version": "0.1.0",
  "description": "CLI tool: rasttopnm",
  "source": "https://manpages.debian.org/rasttopnm",
  "checks": [
    {
      "type": "binary",
      "name": "rasttopnm"
    }
  ],
  "install_guidance": {
    "plugin": "rasttopnm",
    "binary": "rasttopnm",
    "check": "which rasttopnm",
    "install_steps": [
      "apt-get install rasttopnm 2>/dev/null || which rasttopnm",
      "Verify: rasttopnm --version",
      "supercli plugins install ./plugins/rasttopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rasttopnm",
      "resource": "self",
      "action": "version",
      "description": "Print rasttopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rasttopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rasttopnm: apt-get install rasttopnm 2>/dev/null || which rasttopnm"
      },
      "args": []
    },
    {
      "namespace": "rasttopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rasttopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rasttopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rasttopnm: apt-get install rasttopnm 2>/dev/null || which rasttopnm"
      },
      "args": []
    }
  ]
}