{
  "name": "SkinToneClassifier",
  "version": "0.1.0",
  "description": "Specialized CLI for skin tone identification and palette generation",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "SkinToneClassifier" }],
  "install_guidance": {
    "plugin": "SkinToneClassifier",
    "binary": "SkinToneClassifier",
    "check": "which SkinToneClassifier",
    "install_steps": ["pip install skin-tone-classifier", "Verify: SkinToneClassifier --version", "supercli plugins install ./plugins/SkinToneClassifier --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "SkinToneClassifier",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to SkinToneClassifier CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "SkinToneClassifier",
      "passthrough": true,
      "missingDependencyHelp": "Install SkinToneClassifier: pip install skin-tone-classifier"
    },
    "args": []
  }]
}
