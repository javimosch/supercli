{
  "name": "tuckr",
  "version": "0.1.0",
  "description": "Simple dotfile manager focusing on symlink management",
  "source": "https://github.com/RaphGL/Tuckr",
  "checks": [{ "type": "binary", "name": "tuckr" }],
  "install_guidance": {
    "plugin": "tuckr",
    "binary": "tuckr",
    "check": "which tuckr",
    "install_steps": ["cargo install tuckr", "Verify: tuckr --version", "supercli plugins install ./plugins/tuckr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tuckr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tuckr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tuckr",
      "passthrough": true,
      "missingDependencyHelp": "Install tuckr: cargo install tuckr", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
