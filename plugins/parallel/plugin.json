{
  "name": "parallel",
  "version": "0.1.0",
  "description": "GNU parallel — build and execute shell commands in parallel",
  "source": "https://www.gnu.org/software/parallel/",
  "checks": [
    {
      "type": "binary",
      "name": "parallel"
    }
  ],
  "install_guidance": {
    "plugin": "parallel",
    "binary": "parallel",
    "check": "which parallel",
    "install_steps": [
      "brew install parallel",
      "Verify: parallel --version",
      "supercli plugins install ./plugins/parallel --on-conflict replace --json"
    ],
    "note": "Also available via apt: sudo apt-get install parallel. Allows running commands on multiple files, multiple machines, or multiple arguments in parallel."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "parallel",
      "resource": "self",
      "action": "version",
      "description": "Print GNU parallel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "parallel",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install parallel: brew install parallel"
      },
      "args": []
    },
    {
      "namespace": "parallel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to GNU parallel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "parallel",
        "passthrough": true,
        "missingDependencyHelp": "Install parallel: brew install parallel"
      },
      "args": []
    }
  ]
}
