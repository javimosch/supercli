{
  "name": "gulp-cli",
  "version": "0.1.0",
  "description": "Command-line utility for Gulp",
  "source": "https://github.com/gulpjs/gulp-cli",
  "checks": [
    {
      "type": "binary",
      "name": "gulp-cli"
    }
  ],
  "install_guidance": {
    "plugin": "gulp-cli",
    "binary": "gulp-cli",
    "check": "which gulp-cli",
    "install_steps": [
      "brew install gulp-cli",
      "Verify: gulp-cli --version",
      "supercli plugins install ./plugins/gulp-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gulp-cli",
      "resource": "self",
      "action": "version",
      "description": "Print gulp-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gulp-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gulp-cli: brew install gulp-cli"
      },
      "args": []
    },
    {
      "namespace": "gulp-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gulp-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gulp-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install gulp-cli"
      },
      "args": []
    }
  ]
}