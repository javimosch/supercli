{
  "name": "maeparser",
  "version": "0.1.0",
  "description": "Maestro file parser",
  "source": "https://github.com/schrodinger/maeparser",
  "checks": [
    {
      "type": "binary",
      "name": "maeparser"
    }
  ],
  "install_guidance": {
    "plugin": "maeparser",
    "binary": "maeparser",
    "check": "which maeparser",
    "install_steps": [
      "brew install maeparser",
      "Verify: maeparser --version",
      "supercli plugins install ./plugins/maeparser --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "maeparser",
      "resource": "self",
      "action": "version",
      "description": "Print maeparser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "maeparser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install maeparser: brew install maeparser"
      },
      "args": []
    },
    {
      "namespace": "maeparser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to maeparser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "maeparser",
        "passthrough": true,
        "missingDependencyHelp": "Install maeparser"
      },
      "args": []
    }
  ]
}