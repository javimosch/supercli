{
  "name": "yokai",
  "version": "0.1.0",
  "description": "Free and open source manga reader for Android",
  "source": "https://github.com/yokai/yokai",
  "checks": [
    {
      "type": "binary",
      "name": "yokai"
    }
  ],
  "install_guidance": {
    "plugin": "yokai",
    "binary": "yokai",
    "check": "which yokai",
    "install_steps": [
      "pip install yokai",
      "Verify: yokai --version",
      "supercli plugins install ./plugins/yokai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yokai",
      "resource": "self",
      "action": "version",
      "description": "Print yokai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yokai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yokai: pip install yokai"
      },
      "args": []
    },
    {
      "namespace": "yokai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yokai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yokai",
        "passthrough": true,
        "missingDependencyHelp": "Install yokai: pip install yokai"
      },
      "args": []
    }
  ]
}