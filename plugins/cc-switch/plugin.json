{
  "name": "cc-switch",
  "version": "0.1.0",
  "description": "A cross-platform desktop All-in-One assistant for Claude Code, Codex, OpenCode, OpenClaw, Gemini CLI",
  "source": "https://github.com/cc-switch/cc-switch",
  "checks": [
    {
      "type": "binary",
      "name": "cc-switch"
    }
  ],
  "install_guidance": {
    "plugin": "cc-switch",
    "binary": "cc-switch",
    "check": "which cc-switch",
    "install_steps": [
      "pip install cc-switch",
      "Verify: cc-switch --version",
      "supercli plugins install ./plugins/cc-switch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cc-switch",
      "resource": "self",
      "action": "version",
      "description": "Print cc-switch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cc-switch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cc-switch: pip install cc-switch"
      },
      "args": []
    },
    {
      "namespace": "cc-switch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cc-switch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cc-switch",
        "passthrough": true,
        "missingDependencyHelp": "Install cc-switch: pip install cc-switch"
      },
      "args": []
    }
  ]
}