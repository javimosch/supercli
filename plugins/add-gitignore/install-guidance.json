{
  "plugin": "add-gitignore",
  "binary": "add-gitignore",
  "check": "which add-gitignore",
  "install_steps": [
    "npm install -g add-gitignore",
    "Verify: add-gitignore --version",
    "supercli plugins install ./plugins/add-gitignore --on-conflict replace --json"
