{
  "name": "add-gitignore",
  "version": "0.1.0",
  "description": "Interactively generate a .gitignore for your project based on your needs",
  "source": "https://github.com/TejasQ/add-gitignore",
  "checks": [
    {
      "type": "binary",
      "name": "add-gitignore"
    }
  ],
  "install_guidance": {
    "plugin": "add-gitignore",
    "binary": "add-gitignore",
    "check": "which add-gitignore",
    "install_steps": [
      "npm install -g add-gitignore",
      "Verify: add-gitignore --version",
      "supercli plugins install ./plugins/add-gitignore --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "add-gitignore",
      "resource": "self",
      "action": "version",
      "description": "Print add-gitignore version",
      "adapter": "process",
      "adapterConfig": {
        "command": "add-gitignore",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install add-gitignore: npm install -g add-gitignore"
      },
      "args": []
    },
    {
      "namespace": "add-gitignore",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to add-gitignore CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "add-gitignore",
        "passthrough": true,
        "missingDependencyHelp": "Install add-gitignore"
      },
      "args": []
    }
  ]
}