{
  "name": "dcp",
  "version": "0.1.0",
  "description": "Docker cp made easy",
  "source": "https://github.com/exdx/dcp",
  "checks": [
    {
      "type": "binary",
      "name": "dcp"
    }
  ],
  "install_guidance": {
    "plugin": "dcp",
    "binary": "dcp",
    "check": "which dcp",
    "install_steps": [
      "brew install dcp",
      "Verify: dcp --version",
      "supercli plugins install ./plugins/dcp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dcp",
      "resource": "self",
      "action": "version",
      "description": "Print dcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dcp: brew install dcp"
      },
      "args": []
    },
    {
      "namespace": "dcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dcp",
        "passthrough": true,
        "missingDependencyHelp": "Install dcp"
      },
      "args": []
    }
  ]
}