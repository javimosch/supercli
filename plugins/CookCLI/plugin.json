{
  "name": "CookCLI",
  "version": "0.1.0",
  "description": "Full-featured recipe manager",
  "source": "https://github.com/cooklang/CookCLI",
  "checks": [
    {
      "type": "binary",
      "name": "CookCLI"
    }
  ],
  "install_guidance": {
    "plugin": "CookCLI",
    "binary": "CookCLI",
    "check": "which CookCLI",
    "install_steps": [
      "cargo install CookCLI",
      "Verify: CookCLI --version",
      "supercli plugins install ./plugins/CookCLI --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "CookCLI",
      "resource": "self",
      "action": "version",
      "description": "Print CookCLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "CookCLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CookCLI: cargo install CookCLI"
      },
      "args": []
    },
    {
      "namespace": "CookCLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to CookCLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "CookCLI",
        "passthrough": true,
        "missingDependencyHelp": "Install CookCLI"
      },
      "args": []
    }
  ]
}