{
  "name": "lakshmi",
  "version": "0.1.0",
  "description": "Bogleheads inspired tool for managing your investing portfolio",
  "source": "https://github.com/sarvjeets/lakshmi",
  "checks": [
    {
      "type": "binary",
      "name": "lakshmi"
    }
  ],
  "install_guidance": {
    "plugin": "lakshmi",
    "binary": "lakshmi",
    "check": "which lakshmi",
    "install_steps": [
      "See https://github.com/sarvjeets/lakshmi",
      "Verify: lakshmi --version",
      "supercli plugins install ./plugins/lakshmi --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "lakshmi",
      "resource": "self",
      "action": "version",
      "description": "Print lakshmi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lakshmi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lakshmi: See https://github.com/sarvjeets/lakshmi"
      },
      "args": []
    },
    {
      "namespace": "lakshmi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lakshmi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lakshmi",
        "passthrough": true,
        "missingDependencyHelp": "Install lakshmi"
      },
      "args": []
    }
  ]
}