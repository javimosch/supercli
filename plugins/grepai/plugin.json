{
  "name": "grepai",
  "version": "0.1.0",
  "description": "Semantic Search & Call Graphs for AI Agents (100% Local)",
  "source": "https://github.com/grepai/grepai",
  "checks": [
    {
      "type": "binary",
      "name": "grepai"
    }
  ],
  "install_guidance": {
    "plugin": "grepai",
    "binary": "grepai",
    "check": "which grepai",
    "install_steps": [
      "pip install grepai",
      "Verify: grepai --version",
      "supercli plugins install ./plugins/grepai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grepai",
      "resource": "self",
      "action": "version",
      "description": "Print grepai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grepai: pip install grepai"
      },
      "args": []
    },
    {
      "namespace": "grepai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grepai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepai",
        "passthrough": true,
        "missingDependencyHelp": "Install grepai: pip install grepai"
      },
      "args": []
    }
  ]
}