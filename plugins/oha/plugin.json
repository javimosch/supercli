{
  "name": "oha",
  "version": "0.1.0",
  "description": "Tiny program that sends load to web apps and outputs results",
  "source": "https://github.com/hatoo/oha",
  "checks": [{ "type": "binary", "name": "oha" }],
  "install_guidance": {
    "plugin": "oha",
    "binary": "oha",
    "check": "which oha",
    "install_steps": ["cargo install oha", "Verify: oha --version", "supercli plugins install ./plugins/oha --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "oha",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to oha CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "oha",
      "passthrough": true,
      "missingDependencyHelp": "Install oha: cargo install oha"
    },
    "args": []
  }]
}
