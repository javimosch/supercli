{
  "name": "base16384",
  "version": "0.1.0",
  "description": "Encode binary files to printable utf16be",
  "source": "https://github.com/fumiama/base16384",
  "checks": [
    {
      "type": "binary",
      "name": "base16384"
    }
  ],
  "install_guidance": {
    "plugin": "base16384",
    "binary": "base16384",
    "check": "which base16384",
    "install_steps": [
      "brew install base16384",
      "Verify: base16384 --version",
      "supercli plugins install ./plugins/base16384 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "base16384",
      "resource": "self",
      "action": "version",
      "description": "Print base16384 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "base16384",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install base16384: brew install base16384"
      },
      "args": []
    },
    {
      "namespace": "base16384",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to base16384 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "base16384",
        "passthrough": true,
        "missingDependencyHelp": "Install base16384"
      },
      "args": []
    }
  ]
}