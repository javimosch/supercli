{
  "name": "cracklib-check",
  "version": "0.1.0",
  "description": "Check passwords using libcrack2 (cracklib-runtime)",
  "source": "https://packages.debian.org/cracklib-check",
  "checks": [{ "type": "binary", "name": "cracklib-check" }],
  "install_guidance": {
    "plugin": "cracklib-check", "binary": "cracklib-check", "check": "which cracklib-check",
    "install_steps": ["apt-get install cracklib-check 2>/dev/null || which cracklib-check", "Verify: cracklib-check --version", "supercli plugins install ./plugins/cracklib-check --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cracklib-check", "resource": "_", "action": "_",
    "description": "Passthrough to cracklib-check CLI",
    "adapter": "process", "adapterConfig": { "command": "cracklib-check", "passthrough": true, "missingDependencyHelp": "Install cracklib-check: apt-get install cracklib-check" }, "args": []
  }]
}
