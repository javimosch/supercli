{
  "name": "dynet",
  "version": "0.1.0",
  "description": "Dynamic Neural Network Toolkit",
  "source": "https://github.com/clab/dynet",
  "checks": [
    {
      "type": "binary",
      "name": "dynet"
    }
  ],
  "install_guidance": {
    "plugin": "dynet",
    "binary": "dynet",
    "check": "which dynet",
    "install_steps": [
      "brew install dynet",
      "Verify: dynet --version",
      "supercli plugins install ./plugins/dynet --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dynet",
      "resource": "self",
      "action": "version",
      "description": "Print dynet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dynet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dynet: brew install dynet"
      },
      "args": []
    },
    {
      "namespace": "dynet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dynet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dynet",
        "passthrough": true,
        "missingDependencyHelp": "Install dynet"
      },
      "args": []
    }
  ]
}