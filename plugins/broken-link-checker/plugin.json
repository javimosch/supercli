{
  "name": "broken-link-checker",
  "version": "0.1.0",
  "description": "Find broken links in websites and HTML files",
  "source": "https://github.com/stevenvachon/broken-link-checker",
  "checks": [{ "type": "binary", "name": "broken-link-checker" }],
  "install_guidance": {
    "plugin": "broken-link-checker",
    "binary": "broken-link-checker",
    "check": "which broken-link-checker",
    "install_steps": ["npm install -g broken-link-checker", "Verify: broken-link-checker --version", "supercli plugins install ./plugins/broken-link-checker --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "broken-link-checker",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to broken-link-checker CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "broken-link-checker",
      "passthrough": true,
      "missingDependencyHelp": "Install broken-link-checker: npm install -g broken-link-checker", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
