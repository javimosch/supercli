{
  "name": "autoconf",
  "version": "0.1.0",
  "description": "CLI tool: autoconf",
  "source": "https://packages.debian.org/autoconf",
  "checks": [{ "type": "binary", "name": "autoconf" }],
  "install_guidance": {
    "plugin": "autoconf", "binary": "autoconf", "check": "which autoconf",
    "install_steps": ["apt-get install autoconf 2>/dev/null || which autoconf", "Verify: autoconf --version", "supercli plugins install ./plugins/autoconf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "autoconf", "resource": "_", "action": "_",
    "description": "Passthrough to autoconf CLI",
    "adapter": "process", "adapterConfig": { "command": "autoconf", "passthrough": true, "missingDependencyHelp": "Install autoconf: apt-get install autoconf" }, "args": []
  }]
}
