{
  "name": "gojg",
  "version": "0.1.0",
  "description": "Json Generator CLI using golang",
  "source": "https://github.com/gojg/gojg",
  "checks": [
    {
      "type": "binary",
      "name": "gojg"
    }
  ],
  "install_guidance": {
    "plugin": "gojg",
    "binary": "gojg",
    "check": "which gojg",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: gojg --version",
      "supercli plugins install ./plugins/gojg --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "gojg",
      "resource": "self",
      "action": "version",
      "description": "Print gojg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gojg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gojg from project repository"
      },
      "args": []
    },
    {
      "namespace": "gojg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gojg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gojg",
        "passthrough": true,
        "missingDependencyHelp": "Install gojg from project repository"
      },
      "args": []
    }
  ]
}