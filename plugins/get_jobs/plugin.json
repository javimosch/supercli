{
  "name": "get_jobs",
  "version": "0.1.0",
  "description": "\ud83d\udcbc\u3010AI\u627e\u5de5\u4f5c\u52a9\u624b\u3011\u5168\u5e73\u53f0\u81ea\u52a8\u6295\u7b80\u5386\u811a\u672c\uff1a(boss\u3001\u524d\u7a0b\u65e0\u5fe7\u3001\u730e\u8058\u3001\u667a\u8054\u62db\u8058)",
  "source": "https://github.com/get_jobs/get_jobs",
  "checks": [
    {
      "type": "binary",
      "name": "get-jobs"
    }
  ],
  "install_guidance": {
    "plugin": "get_jobs",
    "binary": "get-jobs",
    "check": "which get-jobs",
    "install_steps": [
      "pip install get-jobs",
      "Verify: get-jobs --version",
      "supercli plugins install ./plugins/get_jobs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "get_jobs",
      "resource": "self",
      "action": "version",
      "description": "Print get_jobs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-jobs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install get_jobs: pip install get-jobs"
      },
      "args": []
    },
    {
      "namespace": "get_jobs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to get-jobs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-jobs",
        "passthrough": true,
        "missingDependencyHelp": "Install get_jobs: pip install get-jobs"
      },
      "args": []
    }
  ]
}