{
  "name": "posce",
  "version": "0.1.0",
  "description": "A note-taking toolkit for your command line.",
  "source": "https://github.com/vdt/posce",
  "checks": [
    {
      "type": "binary",
      "name": "posce"
    }
  ],
  "install_guidance": {
    "plugin": "posce",
    "binary": "posce",
    "check": "which posce",
    "install_steps": [
      "See https://github.com/vdt/posce",
      "Verify: posce --version",
      "supercli plugins install ./plugins/posce --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "posce",
      "resource": "self",
      "action": "version",
      "description": "Print posce version",
      "adapter": "process",
      "adapterConfig": {
        "command": "posce",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install posce: See https://github.com/vdt/posce"
      },
      "args": []
    },
    {
      "namespace": "posce",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to posce CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "posce",
        "passthrough": true,
        "missingDependencyHelp": "Install posce"
      },
      "args": []
    }
  ]
}