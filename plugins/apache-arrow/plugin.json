{
  "name": "apache-arrow",
  "version": "0.1.0",
  "description": "Columnar in-memory analytics layer designed to accelerate big data",
  "checks": [
    {
      "type": "binary",
      "name": "apache-arrow"
    }
  ],
  "install_guidance": {
    "plugin": "apache-arrow",
    "binary": "apache-arrow",
    "check": "which apache-arrow",
    "install_steps": [
      "brew install apache-arrow",
      "Verify: apache-arrow --version",
      "supercli plugins install ./plugins/apache-arrow --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "apache-arrow",
      "resource": "self",
      "action": "version",
      "description": "Print apache-arrow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "apache-arrow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install apache-arrow: brew install apache-arrow"
      },
      "args": []
    },
    {
      "namespace": "apache-arrow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to apache-arrow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "apache-arrow",
        "passthrough": true,
        "missingDependencyHelp": "Install apache-arrow"
      },
      "args": []
    }
  ]
}