{
  "name": "fakesteak",
  "version": "0.1.0",
  "description": "ASCII Matrix-like steak demo",
  "source": "https://github.com/domsson/fakesteak",
  "checks": [
    {
      "type": "binary",
      "name": "fakesteak"
    }
  ],
  "install_guidance": {
    "plugin": "fakesteak",
    "binary": "fakesteak",
    "check": "which fakesteak",
    "install_steps": [
      "brew install fakesteak",
      "Verify: fakesteak --version",
      "supercli plugins install ./plugins/fakesteak --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fakesteak",
      "resource": "self",
      "action": "version",
      "description": "Print fakesteak version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fakesteak",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fakesteak: brew install fakesteak"
      },
      "args": []
    },
    {
      "namespace": "fakesteak",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fakesteak CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fakesteak",
        "passthrough": true,
        "missingDependencyHelp": "Install fakesteak"
      },
      "args": []
    }
  ]
}