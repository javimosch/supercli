{
  "name": "a2ensite",
  "version": "0.1.0",
  "description": "CLI tool: a2ensite",
  "source": "https://packages.debian.org/a2ensite",
  "checks": [{ "type": "binary", "name": "a2ensite" }],
  "install_guidance": {
    "plugin": "a2ensite", "binary": "a2ensite", "check": "which a2ensite",
    "install_steps": ["apt-get install a2ensite 2>/dev/null || which a2ensite", "Verify: a2ensite --version", "supercli plugins install ./plugins/a2ensite --on-conflict replace --json"]
