  "commands": [{
    "namespace": "a2ensite", "resource": "_", "action": "_",
    "description": "Passthrough to a2ensite CLI",
    "adapter": "process", "adapterConfig": { "command": "a2ensite", "passthrough": true, "missingDependencyHelp": "Install a2ensite: apt-get install a2ensite" }, "args": []
  }]
}
