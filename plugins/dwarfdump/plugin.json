{
  "name": "dwarfdump",
  "version": "1.0.0",
  "description": "dwarfdump \u2014 DWARF info dumper",
  "source": "github.com/dwarfdump/dwarfdump",
  "checks": [
    {
      "type": "binary",
      "name": "dwarfdump"
    }
  ],
  "install_guidance": {
    "plugin": "dwarfdump",
    "binary": "dwarfdump",
    "check": "which dwarfdump",
    "install_steps": [
      "# Install dwarfdump",
      "# See github.com/dwarfdump/dwarfdump",
      "# apt: sudo apt-get install dwarfdump",
      "# brew: brew install dwarfdump",
      "# cargo: cargo install dwarfdump",
      "# npm: npm install -g dwarfdump",
      "# pip: pip install dwarfdump"
    ]
  },
  "commands": [
    {
      "namespace": "dwarfdump",
      "resource": "dwarfdump",
      "action": "run",
      "description": "Run dwarfdump",
      "adapter": "process",
      "adapterConfig": {
        "command": "dwarfdump",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dwarfdump from github.com/dwarfdump/dwarfdump"
      },
      "args": []
    }
  ]
}