{
  "name": "beyla",
  "version": "0.1.0",
  "description": "eBPF-based auto-instrumentation for application observability",
  "source": "https://github.com/grafana/beyla",
  "checks": [{ "type": "binary", "name": "beyla" }],
  "install_guidance": {
    "plugin": "beyla",
    "binary": "beyla",
    "check": "which beyla",
    "install_steps": ["brew install beyla", "Verify: beyla --version", "supercli plugins install ./plugins/beyla --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "beyla",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to beyla CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "beyla",
      "passthrough": true,
      "missingDependencyHelp": "Install beyla: brew install beyla"
    },
    "args": []
  }]
}
