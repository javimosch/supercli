{
  "name": "case",
  "version": "0.1.0",
  "description": "CLI tool: case",
  "source": "https://packages.debian.org/case",
  "checks": [{ "type": "binary", "name": "case" }],
  "install_guidance": {
    "plugin": "case", "binary": "case", "check": "which case",
    "install_steps": ["apt-get install case 2>/dev/null || which case", "Verify: case --version", "supercli plugins install ./plugins/case --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "case", "resource": "_", "action": "_",
    "description": "Passthrough to case CLI",
    "adapter": "process", "adapterConfig": { "command": "case", "passthrough": true, "missingDependencyHelp": "Install case: apt-get install case" }, "args": []
  }]
}
