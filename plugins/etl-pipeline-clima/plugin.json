{
  "name": "etl-pipeline-clima",
  "version": "0.1.0",
  "description": "Pipeline ETL para extraer, transformar y cargar datos meteorológicos usando Python, Docker, Airflow y PostgreSQL",
  "source": "https://github.com/etl-pipeline-clima/etl-pipeline-clima",
  "checks": [
    {
      "type": "binary",
      "name": "etl-pipeline-clima"
    }
  ],
  "install_guidance": {
    "plugin": "etl-pipeline-clima",
    "binary": "etl-pipeline-clima",
    "check": "which etl-pipeline-clima",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: etl-pipeline-clima --version",
      "supercli plugins install ./plugins/etl-pipeline-clima --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "etl-pipeline-clima",
      "resource": "self",
      "action": "version",
      "description": "Print etl-pipeline-clima version",
      "adapter": "process",
      "adapterConfig": {
        "command": "etl-pipeline-clima",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install etl-pipeline-clima from project repository"
      },
      "args": []
    },
    {
      "namespace": "etl-pipeline-clima",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to etl-pipeline-clima CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "etl-pipeline-clima",
        "passthrough": true,
        "missingDependencyHelp": "Install etl-pipeline-clima from project repository"
      },
      "args": []
    }
  ]
}