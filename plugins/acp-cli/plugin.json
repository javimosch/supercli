{
  "name": "acp-cli",
  "version": "0.1.0",
  "description": "acp-cli — consume ACP coding agents via JSON-RPC. Create sessions, send prompts, stream completions from 35+ ACP agents (Claude, Gemini, Cursor, Copilot, Cline, Goose, Codex, etc.)",
  "source": "https://github.com/agentclientprotocol/agent-client-protocol",
  "checks": [
    { "type": "binary", "name": "node" }
  ],
  "install_guidance": {
    "plugin": "acp-cli",
    "binary": "acp-cli.js",
    "check": "which node",
    "install_steps": [
      "Install Node.js from nodejs.org",
      "acp-cli.js is bundled with the plugin",
      "Verify: node plugins/acp-cli/acp-cli.js help",
      "supercli plugins install ./plugins/acp-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "acp-cli",
      "resource": "registry",
      "action": "list",
      "description": "List all 35+ ACP agents from registry",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": ["acp-cli.js", "registry"],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install Node.js"
      },
      "args": []
    },
    {
      "namespace": "acp-cli",
      "resource": "registry",
      "action": "info",
      "description": "Show details for a specific ACP agent",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": ["acp-cli.js", "registry:info"],
        "positionalArgs": ["agent_id"],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install Node.js"
      },
      "args": [
        { "name": "agent_id", "type": "string", "required": true, "description": "ACP agent ID (e.g., claude-acp, gemini, cursor)" }
      ]
    },
    {
      "namespace": "acp-cli",
      "resource": "session",
      "action": "create",
      "description": "Create a new session with an ACP agent and optionally send a prompt. Set --model to override the AI model via ACP protocol (sends session/set_config_option).",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": ["acp-cli.js", "session:create"],
        "positionalArgs": ["agent_id"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install Node.js"
      },
      "args": [
        { "name": "agent_id", "type": "string", "required": true, "description": "ACP agent npx package or binary path (e.g., @google/gemini-cli, @agentclientprotocol/claude-agent-acp)" },
        { "name": "prompt", "type": "string", "required": false, "description": "Prompt text to send after session creation (--prompt)" },
        { "name": "model", "type": "string", "required": false, "description": "Override model via ACP protocol (--model provider/model, e.g. nvidia-minimax/zai-org/GLM-5.1-FP8)" },
        { "name": "mode", "type": "string", "required": false, "description": "Set session mode (--mode ask|code|architect)" },
        { "name": "cwd", "type": "string", "required": false, "description": "Working directory (--cwd)" }
      ]
    },
    {
      "namespace": "acp-cli",
      "resource": "server",
      "action": "start",
      "description": "Launch an ACP server via npx (initialize handshake only)",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": ["acp-cli.js", "server:start"],
        "positionalArgs": ["package"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install Node.js"
      },
      "args": [
        { "name": "package", "type": "string", "required": true, "description": "npx package name (e.g., @google/gemini-cli)" },
        { "name": "cwd", "type": "string", "required": false, "description": "Working directory (--cwd)" }
      ]
    },
    {
      "namespace": "acp-cli",
      "resource": "_",
      "action": "help",
      "description": "Show acp-cli help",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": ["acp-cli.js", "help"],
        "missingDependencyHelp": "Install Node.js"
      },
      "args": []
    },
    {
      "namespace": "acp-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to acp-cli.js",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": ["acp-cli.js"],
        "passthrough": true,
        "missingDependencyHelp": "Install Node.js"
      },
      "args": []
    }
  ]
}
