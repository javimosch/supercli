{
  "name": "ham-beacon",
  "version": "0.1.0",
  "description": "Decoder for amateur radio beacon signals",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "ham-beacon" }],
  "install_guidance": {
    "plugin": "ham-beacon",
    "binary": "ham-beacon",
    "check": "which ham-beacon",
    "install_steps": ["make && sudo make install", "Verify: ham-beacon --version", "supercli plugins install ./plugins/ham-beacon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ham-beacon",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ham-beacon CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ham-beacon",
      "passthrough": true,
      "missingDependencyHelp": "Install ham-beacon: make && sudo make install"
    },
    "args": []
  }]
}
