{
  "name": "DocToc",
  "version": "0.1.0",
  "description": "Generates table of contents for markdown files",
  "source": "https://github.com/thlorenz/doctoc",
  "checks": [
    {
      "type": "binary",
      "name": "DocToc"
    }
  ],
  "install_guidance": {
    "plugin": "DocToc",
    "binary": "DocToc",
    "check": "which DocToc",
    "install_steps": [
      "npm install -g DocToc",
      "Verify: DocToc --version",
      "supercli plugins install ./plugins/DocToc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "DocToc",
      "resource": "self",
      "action": "version",
      "description": "Print DocToc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "DocToc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DocToc: npm install -g DocToc"
      },
      "args": []
    },
    {
      "namespace": "DocToc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to DocToc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "DocToc",
        "passthrough": true,
        "missingDependencyHelp": "Install DocToc"
      },
      "args": []
    }
  ]
}