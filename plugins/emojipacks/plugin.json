{
  "name": "emojipacks",
  "version": "0.1.0",
  "description": "Bulk upload emojis to Slack in JavaScript",
  "source": "https://github.com/littledivy/emojipacks",
  "checks": [
    {
      "type": "binary",
      "name": "emojipacks"
    }
  ],
  "install_guidance": {
    "plugin": "emojipacks",
    "binary": "emojipacks",
    "check": "which emojipacks",
    "install_steps": [
      "npm install -g emojipacks",
      "Verify: emojipacks --version",
      "supercli plugins install ./plugins/emojipacks --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "emojipacks",
      "resource": "self",
      "action": "version",
      "description": "Print emojipacks version",
      "adapter": "process",
      "adapterConfig": {
        "command": "emojipacks",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install emojipacks: npm install -g emojipacks"
      },
      "args": []
    },
    {
      "namespace": "emojipacks",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to emojipacks CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "emojipacks",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install emojipacks: npm install -g emojipacks"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
