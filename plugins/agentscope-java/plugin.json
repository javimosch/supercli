{
  "name": "agentscope-java",
  "version": "0.1.0",
  "description": "AgentScope Java: Agent-Oriented Programming for Building LLM Applications",
  "source": "https://github.com/agentscope-java/agentscope-java",
  "checks": [
    {
      "type": "binary",
      "name": "agentscope-java"
    }
  ],
  "install_guidance": {
    "plugin": "agentscope-java",
    "binary": "agentscope-java",
    "check": "which agentscope-java",
    "install_steps": [
      "pip install agentscope-java",
      "Verify: agentscope-java --version",
      "supercli plugins install ./plugins/agentscope-java --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agentscope-java",
      "resource": "self",
      "action": "version",
      "description": "Print agentscope-java version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentscope-java",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agentscope-java: pip install agentscope-java"
      },
      "args": []
    },
    {
      "namespace": "agentscope-java",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agentscope-java CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentscope-java",
        "passthrough": true,
        "missingDependencyHelp": "Install agentscope-java: pip install agentscope-java"
      },
      "args": []
    }
  ]
}