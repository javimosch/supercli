{
  "name": "kor",
  "version": "0.1.0",
  "description": "CLI tool to discover unused Kubernetes resources",
  "source": "https://github.com/yonahd/kor",
  "checks": [
    {
      "type": "binary",
      "name": "kor"
    }
  ],
  "install_guidance": {
    "plugin": "kor",
    "binary": "kor",
    "check": "which kor",
    "install_steps": [
      "brew install kor",
      "Verify: kor --version",
      "supercli plugins install ./plugins/kor --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kor",
      "resource": "self",
      "action": "version",
      "description": "Print kor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kor: brew install kor"
      },
      "args": []
    },
    {
      "namespace": "kor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kor",
        "passthrough": true,
        "missingDependencyHelp": "Install kor"
      },
      "args": []
    }
  ]
}