{
  "name": "yuvsplittoppm",
  "version": "0.1.0",
  "description": "CLI tool: yuvsplittoppm",
  "source": "https://manpages.debian.org/yuvsplittoppm",
  "checks": [
    {
      "type": "binary",
      "name": "yuvsplittoppm"
    }
  ],
  "install_guidance": {
    "plugin": "yuvsplittoppm",
    "binary": "yuvsplittoppm",
    "check": "which yuvsplittoppm",
    "install_steps": [
      "apt-get install yuvsplittoppm 2>/dev/null || which yuvsplittoppm",
      "Verify: yuvsplittoppm --version",
      "supercli plugins install ./plugins/yuvsplittoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yuvsplittoppm",
      "resource": "self",
      "action": "version",
      "description": "Print yuvsplittoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuvsplittoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yuvsplittoppm: apt-get install yuvsplittoppm 2>/dev/null || which yuvsplittoppm"
      },
      "args": []
    },
    {
      "namespace": "yuvsplittoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yuvsplittoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuvsplittoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install yuvsplittoppm: apt-get install yuvsplittoppm 2>/dev/null || which yuvsplittoppm"
      },
      "args": []
    }
  ]
}