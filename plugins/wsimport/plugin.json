{
  "name": "wsimport",
  "version": "0.1.0",
  "description": "CLI tool: wsimport",
  "source": "https://manpages.debian.org/wsimport",
  "checks": [
    {
      "type": "binary",
      "name": "wsimport"
    }
  ],
  "install_guidance": {
    "plugin": "wsimport",
    "binary": "wsimport",
    "check": "which wsimport",
    "install_steps": [
      "apt-get install wsimport 2>/dev/null || which wsimport",
      "Verify: wsimport --version",
      "supercli plugins install ./plugins/wsimport --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wsimport",
      "resource": "self",
      "action": "version",
      "description": "Print wsimport version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wsimport",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wsimport: apt-get install wsimport 2>/dev/null || which wsimport"
      },
      "args": []
    },
    {
      "namespace": "wsimport",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wsimport CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wsimport",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wsimport: apt-get install wsimport 2>/dev/null || which wsimport"
      },
      "args": []
    }
  ]
}