{
  "name": "mercurial",
  "version": "0.1.0",
  "description": "Mercurial distributed version control system",
  "source": "https",
  "checks": [{"type": "binary", "name": "hg"}],
  "install_guidance": {
    "plugin": "mercurial",
    "binary": "hg",
    "check": "which hg",
    "install_steps": [
      "brew install mercurial",
      "Verify: hg --version",
      "supercli plugins install ./plugins/mercurial --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "mercurial",
      "resource": "self",
      "action": "version",
      "description": "Print mercurial version",
      "adapter": "process",
      "adapterConfig": {"command": "hg", "baseArgs": ["--version"], "missingDependencyHelp": "Install mercurial: brew install mercurial"},
      "args": []
    },
    {
      "namespace": "mercurial",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hg CLI",
      "adapter": "process",
      "adapterConfig": {"command": "hg", "passthrough": true, "missingDependencyHelp": "Install mercurial: brew install mercurial"},
      "args": []
    }
  ]
}
