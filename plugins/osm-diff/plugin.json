{
  "name": "osm-diff",
  "version": "0.1.0",
  "description": "Download and process OpenStreetMap replication diff files",
  "source": "go",
  "checks": [{ "type": "binary", "name": "osm-diff" }],
  "install_guidance": {
    "plugin": "osm-diff",
    "binary": "osm-diff",
    "check": "which osm-diff",
    "install_steps": ["go install github.com/osm-tools/osm-diff@latest", "Verify: osm-diff --version", "supercli plugins install ./plugins/osm-diff --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "osm-diff",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to osm-diff CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "osm-diff",
      "passthrough": true,
      "missingDependencyHelp": "Install osm-diff: go install github.com/osm-tools/osm-diff@latest"
    },
    "args": []
  }]
}
