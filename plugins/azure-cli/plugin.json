{
  "name": "azure-cli",
  "version": "0.1.0",
  "description": "Azure CLI — command-line interface for Microsoft Azure services",
  "source": "https://github.com/Azure/azure-cli",
  "checks": [
    {
      "type": "binary",
      "name": "az"
    }
  ],
  "install_guidance": {
    "plugin": "azure-cli",
    "binary": "az",
    "check": "which az",
    "install_steps": [
      "brew install azure-cli",
      "Verify: az --version",
      "supercli plugins install ./plugins/azure-cli --on-conflict replace --json"
    ],
    "note": "The Azure CLI binary is `az`."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "azure-cli",
      "resource": "self",
      "action": "version",
      "description": "Print azure-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "az",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install azure-cli: brew install azure-cli"
      },
      "args": []
    },
    {
      "namespace": "azure-cli",
      "resource": "cli",
      "action": "run",
      "description": "Azure CLI — command-line interface for Microsoft Azure services",
      "adapter": "process",
      "adapterConfig": {
        "command": "az",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install azure-cli: brew install azure-cli"
      },
      "args": []
    }
  ]
}
