{
  "name": "pdb2.7",
  "version": "0.1.0",
  "description": "CLI tool: pdb2.7",
  "source": "https://manpages.debian.org/pdb2.7",
  "checks": [
    {
      "type": "binary",
      "name": "pdb2.7"
    }
  ],
  "install_guidance": {
    "plugin": "pdb2.7",
    "binary": "pdb2.7",
    "check": "which pdb2.7",
    "install_steps": [
      "apt-get install pdb2.7 2>/dev/null || which pdb2.7",
      "Verify: pdb2.7 --version",
      "supercli plugins install ./plugins/pdb2.7 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdb2.7",
      "resource": "self",
      "action": "version",
      "description": "Print pdb2.7 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdb2.7",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdb2.7: apt-get install pdb2.7 2>/dev/null || which pdb2.7"
      },
      "args": []
    },
    {
      "namespace": "pdb2.7",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdb2.7 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdb2.7",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdb2.7: apt-get install pdb2.7 2>/dev/null || which pdb2.7"
      },
      "args": []
    }
  ]
}