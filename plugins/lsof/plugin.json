{
  "name": "lsof",
  "version": "0.1.0",
  "description": "List open files and network connections",
  "source": "https",
  "checks": [{"type": "binary", "name": "lsof"}],
  "install_guidance": {
    "plugin": "lsof",
    "binary": "lsof",
    "check": "which lsof",
    "install_steps": [
      "brew install lsof",
      "Verify: lsof --version",
      "supercli plugins install ./plugins/lsof --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "lsof",
      "resource": "self",
      "action": "version",
      "description": "Print lsof version",
      "adapter": "process",
      "adapterConfig": {"command": "lsof", "baseArgs": ["--version"], "missingDependencyHelp": "Install lsof: brew install lsof"},
      "args": []
    },
    {
      "namespace": "lsof",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lsof CLI",
      "adapter": "process",
      "adapterConfig": {"command": "lsof", "passthrough": true, "missingDependencyHelp": "Install lsof: brew install lsof"},
      "args": []
    }
  ]
}
