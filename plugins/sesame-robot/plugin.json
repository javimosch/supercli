{
  "name": "sesame-robot",
  "version": "0.1.0",
  "description": "An open and affordable mini quadruped robot based on ESP32.",
  "source": "https://github.com/sesame-robot/sesame-robot",
  "checks": [
    {
      "type": "binary",
      "name": "sesame-robot"
    }
  ],
  "install_guidance": {
    "plugin": "sesame-robot",
    "binary": "sesame-robot",
    "check": "which sesame-robot",
    "install_steps": [
      "pip install sesame-robot",
      "Verify: sesame-robot --version",
      "supercli plugins install ./plugins/sesame-robot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sesame-robot",
      "resource": "self",
      "action": "version",
      "description": "Print sesame-robot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sesame-robot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sesame-robot: pip install sesame-robot"
      },
      "args": []
    },
    {
      "namespace": "sesame-robot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sesame-robot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sesame-robot",
        "passthrough": true,
        "missingDependencyHelp": "Install sesame-robot: pip install sesame-robot"
      },
      "args": []
    }
  ]
}