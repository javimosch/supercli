{
  "name": "adr-tools",
  "version": "0.1.0",
  "description": "CLI tool for working with Architecture Decision Records",
  "source": "https://github.com/npryce/adr-tools",
  "checks": [
    {
      "type": "binary",
      "name": "adr-tools"
    }
  ],
  "install_guidance": {
    "plugin": "adr-tools",
    "binary": "adr-tools",
    "check": "which adr-tools",
    "install_steps": [
      "brew install adr-tools",
      "Verify: adr-tools --version",
      "supercli plugins install ./plugins/adr-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "adr-tools",
      "resource": "self",
      "action": "version",
      "description": "Print adr-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "adr-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install adr-tools: brew install adr-tools"
      },
      "args": []
    },
    {
      "namespace": "adr-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to adr-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "adr-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install adr-tools"
      },
      "args": []
    }
  ]
}