{
  "name": "gnome-session-remmina",
  "version": "0.1.0",
  "description": "CLI tool: gnome-session-remmina",
  "source": "https://manpages.debian.org/gnome-session-remmina",
  "checks": [
    {
      "type": "binary",
      "name": "gnome-session-remmina"
    }
  ],
  "install_guidance": {
    "plugin": "gnome-session-remmina",
    "binary": "gnome-session-remmina",
    "check": "which gnome-session-remmina",
    "install_steps": [
      "apt-get install gnome-session-remmina 2>/dev/null || which gnome-session-remmina",
      "Verify: gnome-session-remmina --version",
      "supercli plugins install ./plugins/gnome-session-remmina --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gnome-session-remmina",
      "resource": "self",
      "action": "version",
      "description": "Print gnome-session-remmina version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-session-remmina",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gnome-session-remmina: apt-get install gnome-session-remmina 2>/dev/null || which gnome-session-remmina"
      },
      "args": []
    },
    {
      "namespace": "gnome-session-remmina",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gnome-session-remmina CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-session-remmina",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gnome-session-remmina: apt-get install gnome-session-remmina 2>/dev/null || which gnome-session-remmina"
      },
      "args": []
    }
  ]
}