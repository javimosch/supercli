{
  "name": "mkfontdir",
  "version": "0.1.0",
  "description": "CLI tool: mkfontdir",
  "source": "https://manpages.debian.org/mkfontdir",
  "checks": [
    {
      "type": "binary",
      "name": "mkfontdir"
    }
  ],
  "install_guidance": {
    "plugin": "mkfontdir",
    "binary": "mkfontdir",
    "check": "which mkfontdir",
    "install_steps": [
      "apt-get install mkfontdir 2>/dev/null || which mkfontdir",
      "Verify: mkfontdir --version",
      "supercli plugins install ./plugins/mkfontdir --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mkfontdir",
      "resource": "self",
      "action": "version",
      "description": "Print mkfontdir version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mkfontdir",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mkfontdir: apt-get install mkfontdir 2>/dev/null || which mkfontdir"
      },
      "args": []
    },
    {
      "namespace": "mkfontdir",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mkfontdir CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mkfontdir",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mkfontdir: apt-get install mkfontdir 2>/dev/null || which mkfontdir"
      },
      "args": []
    }
  ]
}