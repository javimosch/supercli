{
  "name": "treepp",
  "version": "0.1.0",
  "description": "Better tree command with Unicode box-drawing and filtering",
  "source": "https://github.com/rolandgreim/treepp",
  "checks": [
    {
      "type": "binary",
      "name": "treepp"
    }
  ],
  "install_guidance": {
    "plugin": "treepp",
    "binary": "treepp",
    "check": "which treepp",
    "install_steps": [
      "cargo install treepp",
      "Verify: treepp --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "treepp",
      "resource": "self",
      "action": "version",
      "description": "Print treepp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "treepp",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install treepp: cargo install treepp"
      },
      "args": []
    },
    {
      "namespace": "treepp",
      "resource": "dir",
      "action": "list",
      "description": "List directory tree with better formatting and filtering",
      "adapter": "process",
      "adapterConfig": {
        "command": "treepp",
        "baseArgs": ["--cwd", "invoke_cwd"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install treepp: cargo install treepp"
      },
      "args": []
    },
    {
      "namespace": "treepp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to treepp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "treepp",
        "passthrough": true,
        "missingDependencyHelp": "Install treepp: cargo install treepp"
      },
      "args": []
    }
  ]
}