{
  "name": "twarc2",
  "version": "0.1.0",
  "description": "CLI tool: twarc2",
  "source": "https://manpages.debian.org/twarc2",
  "checks": [
    {
      "type": "binary",
      "name": "twarc2"
    }
  ],
  "install_guidance": {
    "plugin": "twarc2",
    "binary": "twarc2",
    "check": "which twarc2",
    "install_steps": [
      "apt-get install twarc2 2>/dev/null || which twarc2",
      "Verify: twarc2 --version",
      "supercli plugins install ./plugins/twarc2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "twarc2",
      "resource": "self",
      "action": "version",
      "description": "Print twarc2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "twarc2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install twarc2: apt-get install twarc2 2>/dev/null || which twarc2"
      },
      "args": []
    },
    {
      "namespace": "twarc2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to twarc2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "twarc2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install twarc2: apt-get install twarc2 2>/dev/null || which twarc2"
      },
      "args": []
    }
  ]
}