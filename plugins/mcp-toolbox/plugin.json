{
  "name": "mcp-toolbox",
  "version": "0.1.0",
  "description": "MCP Toolbox for Databases is an open source MCP server for databases.",
  "source": "https://github.com/mcp-toolbox/mcp-toolbox",
  "checks": [
    {
      "type": "binary",
      "name": "mcp-toolbox"
    }
  ],
  "install_guidance": {
    "plugin": "mcp-toolbox",
    "binary": "mcp-toolbox",
    "check": "which mcp-toolbox",
    "install_steps": [
      "pip install mcp-toolbox",
      "Verify: mcp-toolbox --version",
      "supercli plugins install ./plugins/mcp-toolbox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mcp-toolbox",
      "resource": "self",
      "action": "version",
      "description": "Print mcp-toolbox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcp-toolbox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mcp-toolbox: pip install mcp-toolbox"
      },
      "args": []
    },
    {
      "namespace": "mcp-toolbox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mcp-toolbox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcp-toolbox",
        "passthrough": true,
        "missingDependencyHelp": "Install mcp-toolbox: pip install mcp-toolbox"
      },
      "args": []
    }
  ]
}