{
  "name": "cli-anything-freecad",
  "version": "0.1.0",
  "description": "Headless CAD automation harness for FreeCAD with 250+ commands",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "cli-anything-freecad" }],
  "install_guidance": {
    "plugin": "cli-anything-freecad",
    "binary": "cli-anything-freecad",
    "check": "which cli-anything-freecad",
    "install_steps": ["pip install cli-anything-freecad", "Verify: cli-anything-freecad --version", "supercli plugins install ./plugins/cli-anything-freecad --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cli-anything-freecad",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cli-anything-freecad CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cli-anything-freecad",
      "passthrough": true,
      "missingDependencyHelp": "Install cli-anything-freecad: pip install cli-anything-freecad"
    },
    "args": []
  }]
}
