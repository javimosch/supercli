{
  "name": "Tomato",
  "version": "0.1.0",
  "description": "Minimalist, data-oriented pomodoro timer for Android and Desktop based on Material 3 Expressive",
  "source": "https://github.com/Tomato/Tomato",
  "checks": [
    {
      "type": "binary",
      "name": "tomato"
    }
  ],
  "install_guidance": {
    "plugin": "Tomato",
    "binary": "tomato",
    "check": "which tomato",
    "install_steps": [
      "pip install tomato",
      "Verify: tomato --version",
      "supercli plugins install ./plugins/Tomato --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Tomato",
      "resource": "self",
      "action": "version",
      "description": "Print Tomato version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tomato",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Tomato: pip install tomato"
      },
      "args": []
    },
    {
      "namespace": "Tomato",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tomato CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tomato",
        "passthrough": true,
        "missingDependencyHelp": "Install Tomato: pip install tomato"
      },
      "args": []
    }
  ]
}