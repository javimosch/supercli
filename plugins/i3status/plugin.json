{
  "name": "i3status",
  "version": "1.0.0",
  "description": "i3status \u2014 i3 status bar",
  "source": "i3wm.org",
  "checks": [
    {
      "type": "binary",
      "name": "i3status"
    }
  ],
  "install_guidance": {
    "plugin": "i3status",
    "binary": "i3status",
    "check": "which i3status",
    "install_steps": [
      "# Install i3status",
      "# See i3wm.org",
      "# apt: sudo apt-get install i3status",
      "# brew: brew install i3status",
      "# cargo: cargo install i3status",
      "# npm: npm install -g i3status",
      "# pip: pip install i3status"
    ]
  },
  "commands": [
    {
      "namespace": "i3status",
      "resource": "i3status",
      "action": "run",
      "description": "Run i3status",
      "adapter": "process",
      "adapterConfig": {
        "command": "i3status",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install i3status from i3wm.org"
      },
      "args": []
    }
  ]
}