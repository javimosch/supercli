{
  "name": "git-lfs",
  "version": "1.0.0",
  "description": "git-lfs \u2014 Large file storage for git",
  "source": "git-lfs.com",
  "checks": [
    {
      "type": "binary",
      "name": "git-lfs"
    }
  ],
  "install_guidance": {
    "plugin": "git-lfs",
    "binary": "git-lfs",
    "check": "which git-lfs",
    "install_steps": [
      "# Install git-lfs:",
      "# apt: sudo apt-get install git-lfs",
      "# brew: brew install git-lfs",
      "# cargo: cargo install git-lfs",
      "# npm: npm install -g git-lfs",
      "# pip: pip install git-lfs",
      "# or download from git-lfs.com"
    ]
  },
  "commands": [
    {
      "namespace": "git",
      "resource": "lfs",
      "action": "run",
      "description": "Run git-lfs",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-lfs",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install git-lfs from git-lfs.com"
      },
      "args": []
    }
  ]
}