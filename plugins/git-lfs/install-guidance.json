{
  "plugin": "git-lfs",
  "binary": "git-lfs",
  "check": "which git-lfs",
  "install_steps": [
    "# Install git-lfs",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/git-lfs-linux-amd64 -o /usr/local/bin/git-lfs",
    "chmod +x /usr/local/bin/git-lfs",
    "# Or via package manager, see git-lfs.com"
  ]
}