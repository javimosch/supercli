{
  "name": "zeit",
  "version": "0.1.0",
  "description": "a date and time library written in zig. Timezone, DST, and leap second aware",
  "source": "https://github.com/zeit/zeit",
  "checks": [
    {
      "type": "binary",
      "name": "zeit"
    }
  ],
  "install_guidance": {
    "plugin": "zeit",
    "binary": "zeit",
    "check": "which zeit",
    "install_steps": [
      "pip install zeit",
      "Verify: zeit --version",
      "supercli plugins install ./plugins/zeit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zeit",
      "resource": "self",
      "action": "version",
      "description": "Print zeit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zeit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zeit: pip install zeit"
      },
      "args": []
    },
    {
      "namespace": "zeit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zeit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zeit",
        "passthrough": true,
        "missingDependencyHelp": "Install zeit: pip install zeit"
      },
      "args": []
    }
  ]
}