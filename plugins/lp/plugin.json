{
  "name": "lp",
  "version": "0.1.0",
  "description": "Print files to configured printers",
  "source": "https://packages.debian.org/lp",
  "checks": [{ "type": "binary", "name": "lp" }],
  "install_guidance": {
    "plugin": "lp", "binary": "lp", "check": "which lp",
    "install_steps": ["apt-get install cups", "Verify: lp --version", "supercli plugins install ./plugins/lp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lp", "resource": "_", "action": "_",
    "description": "Passthrough to lp CLI",
    "adapter": "process", "adapterConfig": { "command": "lp", "passthrough": true, "missingDependencyHelp": "Install lp: apt-get install cups" }, "args": []
  }]
}
