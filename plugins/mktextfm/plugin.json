{
  "name": "mktextfm",
  "version": "0.1.0",
  "description": "CLI tool: mktextfm",
  "source": "https://manpages.debian.org/mktextfm",
  "checks": [
    {
      "type": "binary",
      "name": "mktextfm"
    }
  ],
  "install_guidance": {
    "plugin": "mktextfm",
    "binary": "mktextfm",
    "check": "which mktextfm",
    "install_steps": [
      "apt-get install mktextfm 2>/dev/null || which mktextfm",
      "Verify: mktextfm --version",
      "supercli plugins install ./plugins/mktextfm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mktextfm",
      "resource": "self",
      "action": "version",
      "description": "Print mktextfm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mktextfm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mktextfm: apt-get install mktextfm 2>/dev/null || which mktextfm"
      },
      "args": []
    },
    {
      "namespace": "mktextfm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mktextfm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mktextfm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mktextfm: apt-get install mktextfm 2>/dev/null || which mktextfm"
      },
      "args": []
    }
  ]
}