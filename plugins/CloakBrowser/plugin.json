{
  "name": "CloakBrowser",
  "version": "0.1.0",
  "description": "Stealth Chromium that passes every bot detection test. Drop-in Playwright replacement with source-le",
  "source": "https://github.com/CloakBrowser/CloakBrowser",
  "checks": [
    {
      "type": "binary",
      "name": "cloakbrowser"
    }
  ],
  "install_guidance": {
    "plugin": "CloakBrowser",
    "binary": "cloakbrowser",
    "check": "which cloakbrowser",
    "install_steps": [
      "pip install cloakbrowser",
      "Verify: cloakbrowser --version",
      "supercli plugins install ./plugins/CloakBrowser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CloakBrowser",
      "resource": "self",
      "action": "version",
      "description": "Print CloakBrowser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloakbrowser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CloakBrowser: pip install cloakbrowser"
      },
      "args": []
    },
    {
      "namespace": "CloakBrowser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cloakbrowser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloakbrowser",
        "passthrough": true,
        "missingDependencyHelp": "Install CloakBrowser: pip install cloakbrowser"
      },
      "args": []
    }
  ]
}