{
  "name": "docker-compose-v2",
  "version": "1.0.0",
  "description": "docker-compose-v2 \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=docker-compose-v2+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "docker-compose-v2"
    }
  ],
  "install_guidance": {
    "plugin": "docker-compose-v2",
    "binary": "docker-compose-v2",
    "check": "which docker-compose-v2",
    "install_steps": [
      "Install docker-compose-v2 via package manager: apt install docker-compose-v2 or brew install docker-compose-v2"
    ]
  },
  "commands": [
    {
      "namespace": "dockercomposev2",
      "resource": "run",
      "action": "exec",
      "description": "docker-compose-v2 \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-compose-v2",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install docker-compose-v2 via your package manager"
      },
      "args": []
    }
  ]
}