{
  "name": "kftray",
  "version": "0.1.0",
  "description": "Kubernetes port forwarding manager with system tray support",
  "source": "https://github.com/search/kftray",
  "checks": [{ "type": "binary", "name": "kftray" }],
  "install_guidance": {
    "plugin": "kftray",
    "binary": "kftray",
    "check": "which kftray",
    "install_steps": ["brew install kftray", "Verify: kftray --version", "supercli plugins install ./plugins/kftray --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kftray",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kftray CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kftray",
      "passthrough": true,
      "missingDependencyHelp": "Install kftray: brew install kftray"
    },
    "args": []
  }]
}
