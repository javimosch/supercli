{
  "name": "rich-cli",
  "version": "1.0.0",
  "description": "rich-cli \u2014 Rich text in terminal",
  "source": "github.com/willmcgugan/rich-cli",
  "checks": [
    {
      "type": "binary",
      "name": "rich-cli"
    }
  ],
  "install_guidance": {
    "plugin": "rich-cli",
    "binary": "rich-cli",
    "check": "which rich-cli",
    "install_steps": [
      "# Install rich-cli:",
      "# apt: sudo apt-get install rich-cli",
      "# brew: brew install rich-cli",
      "# cargo: cargo install rich-cli",
      "# npm: npm install -g rich-cli",
      "# pip: pip install rich-cli",
      "# or download from github.com/willmcgugan/rich-cli"
    ]
  },
  "commands": [
    {
      "namespace": "rich",
      "resource": "cli",
      "action": "run",
      "description": "Run rich-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "rich-cli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rich-cli from github.com/willmcgugan/rich-cli"
      },
      "args": []
    }
  ]
}