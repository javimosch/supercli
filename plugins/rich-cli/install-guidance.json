{
  "plugin": "rich-cli",
  "binary": "rich-cli",
  "check": "which rich-cli",
  "install_steps": [
    "# Install rich-cli",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rich-cli-linux-amd64 -o /usr/local/bin/rich-cli",
    "chmod +x /usr/local/bin/rich-cli",
    "# Or via package manager, see github.com/willmcgugan/rich-cli"
  ]
}