{
  "name": "librepods",
  "version": "0.1.0",
  "description": "AirPods liberated from Apple's ecosystem.",
  "source": "https://github.com/librepods/librepods",
  "checks": [
    {
      "type": "binary",
      "name": "librepods"
    }
  ],
  "install_guidance": {
    "plugin": "librepods",
    "binary": "librepods",
    "check": "which librepods",
    "install_steps": [
      "pip install librepods",
      "Verify: librepods --version",
      "supercli plugins install ./plugins/librepods --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "librepods",
      "resource": "self",
      "action": "version",
      "description": "Print librepods version",
      "adapter": "process",
      "adapterConfig": {
        "command": "librepods",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install librepods: pip install librepods"
      },
      "args": []
    },
    {
      "namespace": "librepods",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to librepods CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "librepods",
        "passthrough": true,
        "missingDependencyHelp": "Install librepods: pip install librepods"
      },
      "args": []
    }
  ]
}