{
  "name": "teller",
  "version": "0.1.0",
  "description": "Universal secret manager for developers",
  "source": "https://github.com/tellerops/teller",
  "checks": [{ "type": "binary", "name": "teller" }],
  "install_guidance": {
    "plugin": "teller",
    "binary": "teller",
    "check": "which teller",
    "install_steps": ["brew install teller", "Verify: teller --version", "supercli plugins install ./plugins/teller --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "teller",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to teller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "teller",
      "passthrough": true,
      "missingDependencyHelp": "Install teller: brew install teller", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
