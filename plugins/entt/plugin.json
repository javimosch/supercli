{
  "name": "entt",
  "version": "0.1.0",
  "description": "Fast and reliable entity-component system for C++",
  "source": "https://github.com/skypjack/entt/wiki",
  "checks": [
    {
      "type": "binary",
      "name": "entt"
    }
  ],
  "install_guidance": {
    "plugin": "entt",
    "binary": "entt",
    "check": "which entt",
    "install_steps": [
      "brew install entt",
      "Verify: entt --version",
      "supercli plugins install ./plugins/entt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "entt",
      "resource": "self",
      "action": "version",
      "description": "Print entt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "entt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install entt: brew install entt"
      },
      "args": []
    },
    {
      "namespace": "entt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to entt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "entt",
        "passthrough": true,
        "missingDependencyHelp": "Install entt"
      },
      "args": []
    }
  ]
}