{
  "name": "doct",
  "version": "1.0.0",
  "description": "doct \u2014 Documentation test",
  "source": "github.com/doct/doct",
  "checks": [
    {
      "type": "binary",
      "name": "doct"
    }
  ],
  "install_guidance": {
    "plugin": "doct",
    "binary": "doct",
    "check": "which doct",
    "install_steps": [
      "# Install doct",
      "# See github.com/doct/doct",
      "# apt: sudo apt-get install doct",
      "# brew: brew install doct",
      "# cargo: cargo install doct",
      "# npm: npm install -g doct",
      "# pip: pip install doct"
    ]
  },
  "commands": [
    {
      "namespace": "doct",
      "resource": "doct",
      "action": "run",
      "description": "Run doct",
      "adapter": "process",
      "adapterConfig": {
        "command": "doct",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doct from github.com/doct/doct"
      },
      "args": []
    }
  ]
}