{
  "name": "ZigStrike",
  "version": "0.1.0",
  "description": "ZigStrike, a powerful Payload Delivery Pipeline developed in Zig, offering a variety of injection te",
  "source": "https://github.com/ZigStrike/ZigStrike",
  "checks": [
    {
      "type": "binary",
      "name": "zigstrike"
    }
  ],
  "install_guidance": {
    "plugin": "ZigStrike",
    "binary": "zigstrike",
    "check": "which zigstrike",
    "install_steps": [
      "pip install zigstrike",
      "Verify: zigstrike --version",
      "supercli plugins install ./plugins/ZigStrike --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ZigStrike",
      "resource": "self",
      "action": "version",
      "description": "Print ZigStrike version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zigstrike",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ZigStrike: pip install zigstrike"
      },
      "args": []
    },
    {
      "namespace": "ZigStrike",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zigstrike CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zigstrike",
        "passthrough": true,
        "missingDependencyHelp": "Install ZigStrike: pip install zigstrike"
      },
      "args": []
    }
  ]
}