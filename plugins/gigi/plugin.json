{
  "name": "gigi",
  "version": "0.1.0",
  "description": "A framework for rapid prototyping and development of real-time rendering techniques.",
  "source": "https://github.com/gigi/gigi",
  "checks": [
    {
      "type": "binary",
      "name": "gigi"
    }
  ],
  "install_guidance": {
    "plugin": "gigi",
    "binary": "gigi",
    "check": "which gigi",
    "install_steps": [
      "pip install gigi",
      "Verify: gigi --version",
      "supercli plugins install ./plugins/gigi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gigi",
      "resource": "self",
      "action": "version",
      "description": "Print gigi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gigi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gigi: pip install gigi"
      },
      "args": []
    },
    {
      "namespace": "gigi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gigi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gigi",
        "passthrough": true,
        "missingDependencyHelp": "Install gigi: pip install gigi"
      },
      "args": []
    }
  ]
}