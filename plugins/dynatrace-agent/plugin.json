{
  "name": "dynatrace-agent",
  "version": "1.0.0",
  "description": "dynatrace-agent \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=dynatrace-agent+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "dynatrace-agent"
    }
  ],
  "install_guidance": {
    "plugin": "dynatrace-agent",
    "binary": "dynatrace-agent",
    "check": "which dynatrace-agent",
    "install_steps": [
      "Install dynatrace-agent via package manager: apt install dynatrace-agent or brew install dynatrace-agent"
    ]
  },
  "commands": [
    {
      "namespace": "dynatraceagent",
      "resource": "run",
      "action": "exec",
      "description": "dynatrace-agent \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "dynatrace-agent",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dynatrace-agent via your package manager"
      },
      "args": []
    }
  ]
}