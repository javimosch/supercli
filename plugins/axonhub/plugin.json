{
  "name": "axonhub",
  "version": "0.1.0",
  "description": "\u26a1\ufe0f Open-source AI Gateway \u2014 Use any SDK to call 100+ LLMs. Built-in failover, load balancing, cost c",
  "source": "https://github.com/axonhub/axonhub",
  "checks": [
    {
      "type": "binary",
      "name": "axonhub"
    }
  ],
  "install_guidance": {
    "plugin": "axonhub",
    "binary": "axonhub",
    "check": "which axonhub",
    "install_steps": [
      "pip install axonhub",
      "Verify: axonhub --version",
      "supercli plugins install ./plugins/axonhub --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "axonhub",
      "resource": "self",
      "action": "version",
      "description": "Print axonhub version",
      "adapter": "process",
      "adapterConfig": {
        "command": "axonhub",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install axonhub: pip install axonhub"
      },
      "args": []
    },
    {
      "namespace": "axonhub",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to axonhub CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "axonhub",
        "passthrough": true,
        "missingDependencyHelp": "Install axonhub: pip install axonhub"
      },
      "args": []
    }
  ]
}