{
  "name": "mydoro",
  "version": "0.1.0",
  "description": "Modern Pomodoro timer for the terminal in Rust",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "mydoro" }],
  "install_guidance": {
    "plugin": "mydoro",
    "binary": "mydoro",
    "check": "which mydoro",
    "install_steps": ["cargo install mydoro", "Verify: mydoro --version", "supercli plugins install ./plugins/mydoro --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mydoro",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mydoro CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mydoro",
      "passthrough": true,
      "missingDependencyHelp": "Install mydoro: cargo install mydoro"
    },
    "args": []
  }]
}
