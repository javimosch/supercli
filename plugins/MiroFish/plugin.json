{
  "name": "MiroFish",
  "version": "0.1.0",
  "description": "A Simple and Universal Swarm Intelligence Engine, Predicting Anything. \u7b80\u6d01\u901a\u7528\u7684\u7fa4\u4f53\u667a\u80fd\u5f15\u64ce\uff0c\u9884\u6d4b\u4e07\u7269",
  "source": "https://github.com/MiroFish/MiroFish",
  "checks": [
    {
      "type": "binary",
      "name": "mirofish"
    }
  ],
  "install_guidance": {
    "plugin": "MiroFish",
    "binary": "mirofish",
    "check": "which mirofish",
    "install_steps": [
      "pip install mirofish",
      "Verify: mirofish --version",
      "supercli plugins install ./plugins/MiroFish --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MiroFish",
      "resource": "self",
      "action": "version",
      "description": "Print MiroFish version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mirofish",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MiroFish: pip install mirofish"
      },
      "args": []
    },
    {
      "namespace": "MiroFish",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mirofish CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mirofish",
        "passthrough": true,
        "missingDependencyHelp": "Install MiroFish: pip install mirofish"
      },
      "args": []
    }
  ]
}