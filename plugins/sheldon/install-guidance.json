{
  "plugin": "sheldon",
  "binary": "sheldon",
  "check": "which sheldon",
  "install_steps": [
    "brew install sheldon",
    "cargo install sheldon",
    "cargo binstall sheldon",
    "curl --proto '=https' -fLsS https://rossmacarthur.github.io/install/crate.sh | bash -s -- --repo rossmacarthur/sheldon --to ~/.local/bin",
    "nix profile install \"github:rossmacarthur/sheldon\"",
    "Verify: sheldon --version",
    "supercli plugins install ./plugins/sheldon --on-conflict replace --json"
  ],
  "note": "After installing, run 'sheldon init --shell zsh' (or bash) to create plugins.toml, then add 'eval \"$(sheldon source)\"' to your ~/.zshrc. Official docs: https://sheldon.cli.rs/"
}
