{
  "name": "ron",
  "version": "0.1.0",
  "description": "RON — Rusty Object Notation serialization format",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "ron"
    }
  ],
  "install_guidance": {
    "plugin": "ron",
    "binary": "ron",
    "check": "which ron",
    "install_steps": [
      "cargo install ron",
      "Verify: ron --version",
      "supercli plugins install ./plugins/ron --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ron",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ron",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ron"
      },
      "args": []
    }
  ]
}
