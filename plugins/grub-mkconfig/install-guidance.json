{
  "plugin": "grub-mkconfig",
  "binary": "grub-mkconfig",
  "check": "which grub-mkconfig",
  "install_steps": [
    "apt-get install grub-mkconfig 2>/dev/null || which grub-mkconfig",
    "Verify: grub-mkconfig --version",
    "supercli plugins install ./plugins/grub-mkconfig --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}