{
  "name": "leaftoppm",
  "version": "0.1.0",
  "description": "CLI tool: leaftoppm",
  "source": "https://manpages.debian.org/leaftoppm",
  "checks": [
    {
      "type": "binary",
      "name": "leaftoppm"
    }
  ],
  "install_guidance": {
    "plugin": "leaftoppm",
    "binary": "leaftoppm",
    "check": "which leaftoppm",
    "install_steps": [
      "apt-get install leaftoppm 2>/dev/null || which leaftoppm",
      "Verify: leaftoppm --version",
      "supercli plugins install ./plugins/leaftoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "leaftoppm",
      "resource": "self",
      "action": "version",
      "description": "Print leaftoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leaftoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install leaftoppm: apt-get install leaftoppm 2>/dev/null || which leaftoppm"
      },
      "args": []
    },
    {
      "namespace": "leaftoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leaftoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leaftoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install leaftoppm: apt-get install leaftoppm 2>/dev/null || which leaftoppm"
      },
      "args": []
    }
  ]
}