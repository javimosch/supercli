{
  "name": "cconv",
  "version": "0.1.0",
  "description": "Iconv based simplified-traditional Chinese conversion tool",
  "source": "https://github.com/xiaoyjy/cconv",
  "checks": [
    {
      "type": "binary",
      "name": "cconv"
    }
  ],
  "install_guidance": {
    "plugin": "cconv",
    "binary": "cconv",
    "check": "which cconv",
    "install_steps": [
      "brew install cconv",
      "Verify: cconv --version",
      "supercli plugins install ./plugins/cconv --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cconv",
      "resource": "self",
      "action": "version",
      "description": "Print cconv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cconv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cconv: brew install cconv"
      },
      "args": []
    },
    {
      "namespace": "cconv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cconv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cconv",
        "passthrough": true,
        "missingDependencyHelp": "Install cconv"
      },
      "args": []
    }
  ]
}