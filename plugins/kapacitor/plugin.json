{
  "name": "kapacitor",
  "version": "0.1.0",
  "description": "Open source time series data processor",
  "source": "https://github.com/influxdata/kapacitor",
  "checks": [
    {
      "type": "binary",
      "name": "kapacitor"
    }
  ],
  "install_guidance": {
    "plugin": "kapacitor",
    "binary": "kapacitor",
    "check": "which kapacitor",
    "install_steps": [
      "brew install kapacitor",
      "Verify: kapacitor --version",
      "supercli plugins install ./plugins/kapacitor --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kapacitor",
      "resource": "self",
      "action": "version",
      "description": "Print kapacitor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kapacitor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kapacitor: brew install kapacitor"
      },
      "args": []
    },
    {
      "namespace": "kapacitor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kapacitor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kapacitor",
        "passthrough": true,
        "missingDependencyHelp": "Install kapacitor"
      },
      "args": []
    }
  ]
}