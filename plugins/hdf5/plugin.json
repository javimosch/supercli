{
  "name": "hdf5",
  "version": "0.1.0",
  "description": "File format designed to store large amounts of data",
  "checks": [
    {
      "type": "binary",
      "name": "hdf5"
    }
  ],
  "install_guidance": {
    "plugin": "hdf5",
    "binary": "hdf5",
    "check": "which hdf5",
    "install_steps": [
      "brew install hdf5",
      "Verify: hdf5 --version",
      "supercli plugins install ./plugins/hdf5 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hdf5",
      "resource": "self",
      "action": "version",
      "description": "Print hdf5 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdf5",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hdf5: brew install hdf5"
      },
      "args": []
    },
    {
      "namespace": "hdf5",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hdf5 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdf5",
        "passthrough": true,
        "missingDependencyHelp": "Install hdf5"
      },
      "args": []
    }
  ]
}