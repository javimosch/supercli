{
  "name": "dvilj4",
  "version": "0.1.0",
  "description": "CLI tool: dvilj4",
  "source": "https://manpages.debian.org/dvilj4",
  "checks": [
    {
      "type": "binary",
      "name": "dvilj4"
    }
  ],
  "install_guidance": {
    "plugin": "dvilj4",
    "binary": "dvilj4",
    "check": "which dvilj4",
    "install_steps": [
      "apt-get install dvilj4 2>/dev/null || which dvilj4",
      "Verify: dvilj4 --version",
      "supercli plugins install ./plugins/dvilj4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvilj4",
      "resource": "self",
      "action": "version",
      "description": "Print dvilj4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvilj4: apt-get install dvilj4 2>/dev/null || which dvilj4"
      },
      "args": []
    },
    {
      "namespace": "dvilj4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvilj4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvilj4: apt-get install dvilj4 2>/dev/null || which dvilj4"
      },
      "args": []
    }
  ]
}