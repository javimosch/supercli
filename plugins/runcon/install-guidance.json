{
  "plugin": "runcon",
  "binary": "runcon",
  "check": "which runcon",
  "install_steps": [
    "# Install runcon",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/runcon-linux-amd64 -o /usr/local/bin/runcon",
    "chmod +x /usr/local/bin/runcon",
    "# Or via package manager, see /usr/bin/runcon"
  ]
}