{
  "name": "runcon",
  "version": "1.0.0",
  "description": "runcon \u2014 runcon \u2014 CLI utility",
  "source": "/usr/bin/runcon",
  "checks": [
    {
      "type": "binary",
      "name": "runcon"
    }
  ],
  "install_guidance": {
    "plugin": "runcon",
    "binary": "runcon",
    "check": "which runcon",
    "install_steps": [
      "# Install runcon:",
      "# apt: sudo apt-get install runcon",
      "# brew: brew install runcon",
      "# cargo: cargo install runcon",
      "# npm: npm install -g runcon",
      "# pip: pip install runcon",
      "# or download from /usr/bin/runcon"
    ]
  },
  "commands": [
    {
      "namespace": "runcon",
      "resource": "runcon",
      "action": "run",
      "description": "Run runcon",
      "adapter": "process",
      "adapterConfig": {
        "command": "runcon",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install runcon from /usr/bin/runcon"
      },
      "args": []
    }
  ]
}