{
  "name": "betty",
  "version": "0.1.0",
  "description": "English-like interface for the command-line",
  "source": "https://github.com/pickhardt/betty",
  "checks": [
    {
      "type": "binary",
      "name": "betty"
    }
  ],
  "install_guidance": {
    "plugin": "betty",
    "binary": "betty",
    "check": "which betty",
    "install_steps": [
      "brew install betty",
      "Verify: betty --version",
      "supercli plugins install ./plugins/betty --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "betty",
      "resource": "self",
      "action": "version",
      "description": "Print betty version",
      "adapter": "process",
      "adapterConfig": {
        "command": "betty",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install betty: brew install betty"
      },
      "args": []
    },
    {
      "namespace": "betty",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to betty CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "betty",
        "passthrough": true,
        "missingDependencyHelp": "Install betty"
      },
      "args": []
    }
  ]
}