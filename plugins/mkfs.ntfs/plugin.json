{
  "name": "mkfs.ntfs",
  "version": "0.1.0",
  "description": "CLI tool: mkfs.ntfs",
  "source": "https://manpages.debian.org/mkfs.ntfs",
  "checks": [
    {
      "type": "binary",
      "name": "mkfs.ntfs"
    }
  ],
  "install_guidance": {
    "plugin": "mkfs.ntfs",
    "binary": "mkfs.ntfs",
    "check": "which mkfs.ntfs",
    "install_steps": [
      "apt-get install mkfs.ntfs 2>/dev/null || which mkfs.ntfs",
      "Verify: mkfs.ntfs --version",
      "supercli plugins install ./plugins/mkfs.ntfs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mkfs.ntfs",
      "resource": "self",
      "action": "version",
      "description": "Print mkfs.ntfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mkfs.ntfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mkfs.ntfs: apt-get install mkfs.ntfs 2>/dev/null || which mkfs.ntfs"
      },
      "args": []
    },
    {
      "namespace": "mkfs.ntfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mkfs.ntfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mkfs.ntfs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mkfs.ntfs: apt-get install mkfs.ntfs 2>/dev/null || which mkfs.ntfs"
      },
      "args": []
    }
  ]
}