{
  "name": "TrickyStoreOSS",
  "version": "0.1.0",
  "description": "Open source alternative to proprietary Tricky Store module",
  "source": "https://github.com/TrickyStoreOSS/TrickyStoreOSS",
  "checks": [
    {
      "type": "binary",
      "name": "trickystoreoss"
    }
  ],
  "install_guidance": {
    "plugin": "TrickyStoreOSS",
    "binary": "trickystoreoss",
    "check": "which trickystoreoss",
    "install_steps": [
      "pip install trickystoreoss",
      "Verify: trickystoreoss --version",
      "supercli plugins install ./plugins/TrickyStoreOSS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TrickyStoreOSS",
      "resource": "self",
      "action": "version",
      "description": "Print TrickyStoreOSS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trickystoreoss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TrickyStoreOSS: pip install trickystoreoss"
      },
      "args": []
    },
    {
      "namespace": "TrickyStoreOSS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trickystoreoss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trickystoreoss",
        "passthrough": true,
        "missingDependencyHelp": "Install TrickyStoreOSS: pip install trickystoreoss"
      },
      "args": []
    }
  ]
}