{
  "name": "digitalocean-cli",
  "version": "0.1.0",
  "description": "DigitalOcean CLI — cloud infrastructure management command-line tool",
  "source": "https://github.com/digitalocean/doctl",
  "checks": [
    {
      "type": "binary",
      "name": "doctl"
    }
  ],
  "install_guidance": {
    "plugin": "digitalocean-cli",
    "binary": "doctl",
    "check": "which doctl",
    "install_steps": [
      "brew install doctl",
      "Verify: doctl --version",
      "supercli plugins install ./plugins/digitalocean-cli --on-conflict replace --json"
    ],
    "note": "DigitalOcean's official CLI binary is `doctl`."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "digitalocean-cli",
      "resource": "self",
      "action": "version",
      "description": "Print digitalocean-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doctl",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install digitalocean-cli: brew install doctl"
      },
      "args": []
    },
    {
      "namespace": "digitalocean-cli",
      "resource": "cli",
      "action": "run",
      "description": "DigitalOcean CLI — cloud infrastructure management command-line tool",
      "adapter": "process",
      "adapterConfig": {
        "command": "doctl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install digitalocean-cli: brew install doctl"
      },
      "args": []
    }
  ]
}
