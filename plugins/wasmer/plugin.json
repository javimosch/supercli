{
  "name": "wasmer",
  "version": "0.1.0",
  "description": "Universal WebAssembly runtime supporting WASI and Emscripten — run WASM modules anywhere",
  "source": "https://github.com/wasmerio/wasmer",
  "checks": [
    {
      "type": "binary",
      "name": "wasmer"
    }
  ],
  "install_guidance": {
    "plugin": "wasmer",
    "binary": "wasmer",
    "check": "which wasmer",
    "install_steps": [
      "curl -fsSL https://get.wasmer.io | sh"
    ],
    "note": "Runtime tool for WebAssembly execution."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wasmer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wasmer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wasmer",
        "passthrough": true,
        "missingDependencyHelp": "Install wasmer: curl -fsSL https://get.wasmer.io | sh"
      },
      "args": []
    }
  ]
}
