{
  "name": "ifacemaker",
  "version": "0.1.0",
  "description": "Generate interfaces from structure methods",
  "source": "https://github.com/vburenin/ifacemaker",
  "checks": [
    {
      "type": "binary",
      "name": "ifacemaker"
    }
  ],
  "install_guidance": {
    "plugin": "ifacemaker",
    "binary": "ifacemaker",
    "check": "which ifacemaker",
    "install_steps": [
      "brew install ifacemaker",
      "Verify: ifacemaker --version",
      "supercli plugins install ./plugins/ifacemaker --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ifacemaker",
      "resource": "self",
      "action": "version",
      "description": "Print ifacemaker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ifacemaker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ifacemaker: brew install ifacemaker"
      },
      "args": []
    },
    {
      "namespace": "ifacemaker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ifacemaker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ifacemaker",
        "passthrough": true,
        "missingDependencyHelp": "Install ifacemaker"
      },
      "args": []
    }
  ]
}