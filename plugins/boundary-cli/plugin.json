{
  "name": "boundary-cli",
  "version": "0.1.0",
  "description": "Identity-based access management for dynamic infrastructure",
  "source": "https://github.com/hashicorp/boundary",
  "checks": [{ "type": "binary", "name": "boundary" }],
  "install_guidance": {
    "plugin": "boundary-cli",
    "binary": "boundary",
    "check": "which boundary",
    "install_steps": ["brew install boundary", "Verify: boundary --version", "supercli plugins install ./plugins/boundary-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "boundary-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to boundary CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "boundary",
      "passthrough": true,
      "missingDependencyHelp": "Install boundary-cli: brew install boundary"
    },
    "args": []
  }]
}
