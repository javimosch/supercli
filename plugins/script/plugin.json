{
  "name": "script",
  "version": "0.1.0",
  "description": "script — make typescript of terminal session",
  "source": "https://github.com/util-linux/util-linux",
  "checks": [
    {
      "type": "binary",
      "name": "script"
    }
  ],
  "install_guidance": {
    "plugin": "script",
    "binary": "script",
    "check": "which script",
    "install_steps": [
      "Pre-installed on most Linux systems (util-linux package)",
      "macOS: built-in (BSD version)",
      "Verify: script --version",
      "supercli plugins install ./plugins/script --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "script",
      "resource": "session",
      "action": "record",
      "description": "Record a terminal session",
      "adapter": "process",
      "adapterConfig": {
        "command": "script",
        "passthrough": true,
        "missingDependencyHelp": "script is part of util-linux: apt install util-linux"
      },
      "args": [
        { "name": "--quiet", "type": "boolean", "description": "Suppress startup/exit messages" },
        { "name": "--append", "type": "boolean", "description": "Append to existing typescript" },
        { "name": "--flush", "type": "boolean", "description": "Flush output after each write" },
        { "name": "--timing", "type": "string", "description": "Write timing data to file" },
        { "name": "--command", "type": "string", "description": "Run a specific command instead of interactive shell" },
        { "name": "--return", "type": "boolean", "description": "Return exit code of child process" },
        { "name": "--help", "type": "boolean", "description": "Display help and exit" },
        { "name": "output_file", "type": "string", "description": "File to write session output to (default: typescript)" }
      ]
    },
    {
      "namespace": "script",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to script CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "script",
        "passthrough": true,
        "missingDependencyHelp": "script is part of util-linux: apt install util-linux"
      },
      "args": []
    }
  ]
}
