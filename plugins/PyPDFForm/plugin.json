{
  "name": "PyPDFForm",
  "version": "0.1.0",
  "description": "PDF form filling and generation library with CLI",
  "source": "https://github.com/PyPPDForm/PyPDFForm",
  "checks": [
    {
      "type": "binary",
      "name": "pypdfform"
    }
  ],
  "install_guidance": {
    "plugin": "PyPDFForm",
    "binary": "pypdfform",
    "check": "which pypdfform",
    "install_steps": [
      "pip install PyPDFForm",
      "Verify: pypdfform --version",
      "supercli plugins install ./plugins/PyPDFForm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PyPDFForm",
      "resource": "self",
      "action": "version",
      "description": "Print PyPDFForm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pypdfform",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PyPDFForm: pip install PyPDFForm"
      },
      "args": []
    },
    {
      "namespace": "PyPDFForm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pypdfform CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pypdfform",
        "passthrough": true,
        "missingDependencyHelp": "Install PyPDFForm: pip install PyPDFForm"
      },
      "args": []
    }
  ]
}
