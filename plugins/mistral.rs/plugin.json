{
  "name": "mistral.rs",
  "version": "0.1.0",
  "description": "Fast, flexible LLM inference",
  "source": "https://github.com/mistral.rs/mistral.rs",
  "checks": [
    {
      "type": "binary",
      "name": "mistral.rs"
    }
  ],
  "install_guidance": {
    "plugin": "mistral.rs",
    "binary": "mistral.rs",
    "check": "which mistral.rs",
    "install_steps": [
      "pip install mistral.rs",
      "Verify: mistral.rs --version",
      "supercli plugins install ./plugins/mistral.rs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mistral.rs",
      "resource": "self",
      "action": "version",
      "description": "Print mistral.rs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mistral.rs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mistral.rs: pip install mistral.rs"
      },
      "args": []
    },
    {
      "namespace": "mistral.rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mistral.rs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mistral.rs",
        "passthrough": true,
        "missingDependencyHelp": "Install mistral.rs: pip install mistral.rs"
      },
      "args": []
    }
  ]
}