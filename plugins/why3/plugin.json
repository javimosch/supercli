{
  "name": "why3",
  "version": "0.1.0",
  "description": "Deductive program verification platform",
  "source": "https://github.com/why3/why3",
  "checks": [
    {
      "type": "binary",
      "name": "why3"
    }
  ],
  "install_guidance": {
    "plugin": "why3",
    "binary": "why3",
    "check": "which why3",
    "install_steps": [
      "brew install why3",
      "Verify: why3 --version",
      "supercli plugins install ./plugins/why3 --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "why3",
      "resource": "self",
      "action": "version",
      "description": "Print why3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "why3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install why3: brew install why3"
      },
      "args": []
    },
    {
      "namespace": "why3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to why3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "why3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install why3: brew install why3"
      },
      "args": []
    }
  ]
}
