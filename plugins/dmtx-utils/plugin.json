{
  "name": "dmtx-utils",
  "version": "0.1.0",
  "description": "Read and write data matrix barcodes",
  "source": "https://github.com/dmtx/dmtx-utils",
  "checks": [
    {
      "type": "binary",
      "name": "dmtx-utils"
    }
  ],
  "install_guidance": {
    "plugin": "dmtx-utils",
    "binary": "dmtx-utils",
    "check": "which dmtx-utils",
    "install_steps": [
      "brew install dmtx-utils",
      "Verify: dmtx-utils --version",
      "supercli plugins install ./plugins/dmtx-utils --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dmtx-utils",
      "resource": "self",
      "action": "version",
      "description": "Print dmtx-utils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dmtx-utils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dmtx-utils: brew install dmtx-utils"
      },
      "args": []
    },
    {
      "namespace": "dmtx-utils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dmtx-utils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dmtx-utils",
        "passthrough": true,
        "missingDependencyHelp": "Install dmtx-utils"
      },
      "args": []
    }
  ]
}