{
  "name": "YuyanIme",
  "version": "0.1.0",
  "description": "\u8bed\u71d5\u8f93\u5165\u6cd5-\u4e00\u6b3e\u57fa\u4e8eRime\u5b9a\u5236\u5f00\u53d1\u7684\u4e5d\u952e\u3001\u5168\u62fc\u3001\u53cc\u62fc\u3001\u624b\u5199\u3001\u706b\u661f\u6587\u7b49\u65b9\u6848\u3001\u652f\u6301\u60ac\u6d6e\u3001\u5355\u624b\u3001\u6570\u5b57\u884c\u7b49\u952e\u76d8\u6a21\u5f0f\u7684\u4e2d\u6587\u8f93\u5165\u6cd5",
  "source": "https://github.com/YuyanIme/YuyanIme",
  "checks": [
    {
      "type": "binary",
      "name": "yuyanime"
    }
  ],
  "install_guidance": {
    "plugin": "YuyanIme",
    "binary": "yuyanime",
    "check": "which yuyanime",
    "install_steps": [
      "pip install yuyanime",
      "Verify: yuyanime --version",
      "supercli plugins install ./plugins/YuyanIme --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "YuyanIme",
      "resource": "self",
      "action": "version",
      "description": "Print YuyanIme version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuyanime",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install YuyanIme: pip install yuyanime"
      },
      "args": []
    },
    {
      "namespace": "YuyanIme",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yuyanime CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuyanime",
        "passthrough": true,
        "missingDependencyHelp": "Install YuyanIme: pip install yuyanime"
      },
      "args": []
    }
  ]
}