{
  "name": "crc32",
  "version": "0.1.0",
  "description": "CLI tool: crc32",
  "source": "https://packages.debian.org/crc32",
  "checks": [{ "type": "binary", "name": "crc32" }],
  "install_guidance": {
    "plugin": "crc32", "binary": "crc32", "check": "which crc32",
    "install_steps": ["apt-get install crc32 2>/dev/null || which crc32", "Verify: crc32 --version", "supercli plugins install ./plugins/crc32 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "crc32", "resource": "_", "action": "_",
    "description": "Passthrough to crc32 CLI",
    "adapter": "process", "adapterConfig": { "command": "crc32", "passthrough": true, "missingDependencyHelp": "Install crc32: apt-get install crc32" }, "args": []
  }]
}
