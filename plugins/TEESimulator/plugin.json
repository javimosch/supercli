{
  "name": "TEESimulator",
  "version": "0.1.0",
  "description": "Software simulation for Android hardware-backed key pairs with key attestation",
  "source": "https://github.com/TEESimulator/TEESimulator",
  "checks": [
    {
      "type": "binary",
      "name": "teesimulator"
    }
  ],
  "install_guidance": {
    "plugin": "TEESimulator",
    "binary": "teesimulator",
    "check": "which teesimulator",
    "install_steps": [
      "pip install teesimulator",
      "Verify: teesimulator --version",
      "supercli plugins install ./plugins/TEESimulator --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TEESimulator",
      "resource": "self",
      "action": "version",
      "description": "Print TEESimulator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "teesimulator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TEESimulator: pip install teesimulator"
      },
      "args": []
    },
    {
      "namespace": "TEESimulator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to teesimulator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "teesimulator",
        "passthrough": true,
        "missingDependencyHelp": "Install TEESimulator: pip install teesimulator"
      },
      "args": []
    }
  ]
}