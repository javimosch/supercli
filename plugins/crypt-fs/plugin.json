{
  "name": "crypt-fs",
  "version": "0.1.0",
  "description": "Simple encrypted filesystem layer for directories",
  "source": "https://github.com/srossross/crypt_fs",
  "checks": [{ "type": "binary", "name": "crypt-fs" }],
  "install_guidance": {
    "plugin": "crypt-fs",
    "binary": "crypt-fs",
    "check": "which crypt-fs",
    "install_steps": ["pip install crypt-fs", "Verify: crypt-fs --version", "supercli plugins install ./plugins/crypt-fs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "crypt-fs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to crypt-fs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "crypt-fs",
      "passthrough": true,
      "missingDependencyHelp": "Install crypt-fs: pip install crypt-fs", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
