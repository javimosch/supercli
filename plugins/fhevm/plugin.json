{
  "name": "fhevm",
  "version": "0.1.0",
  "description": "FHEVM, a full-stack framework for integrating Fully Homomorphic Encryption (FHE) with blockchain app",
  "source": "https://github.com/fhevm/fhevm",
  "checks": [
    {
      "type": "binary",
      "name": "fhevm"
    }
  ],
  "install_guidance": {
    "plugin": "fhevm",
    "binary": "fhevm",
    "check": "which fhevm",
    "install_steps": [
      "pip install fhevm",
      "Verify: fhevm --version",
      "supercli plugins install ./plugins/fhevm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fhevm",
      "resource": "self",
      "action": "version",
      "description": "Print fhevm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fhevm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fhevm: pip install fhevm"
      },
      "args": []
    },
    {
      "namespace": "fhevm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fhevm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fhevm",
        "passthrough": true,
        "missingDependencyHelp": "Install fhevm: pip install fhevm"
      },
      "args": []
    }
  ]
}