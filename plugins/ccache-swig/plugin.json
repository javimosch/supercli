{
  "name": "ccache-swig",
  "version": "0.1.0",
  "description": "ccache-swig — Generate scripting interfaces to C/C++ code",
  "source": "http://www.swig.org/",
  "checks": [{ "type": "binary", "name": "ccache-swig" }],
  "install_guidance": {
    "plugin": "ccache-swig", "binary": "ccache-swig", "check": "which ccache-swig",
    "install_steps": ["apt-get install swig 2>/dev/null || which ccache-swig", "Verify: ccache-swig --version", "supercli plugins install ./plugins/ccache-swig --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ccache-swig", "resource": "_", "action": "_",
    "description": "Passthrough to ccache-swig CLI",
    "adapter": "process", "adapterConfig": { "command": "ccache-swig", "passthrough": true, "missingDependencyHelp": "Install ccache-swig: apt-get install swig" }, "args": []
  }]
}
