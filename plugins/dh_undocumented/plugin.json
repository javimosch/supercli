{
  "name": "dh_undocumented",
  "version": "0.1.0",
  "description": "CLI tool: dh_undocumented",
  "source": "https://packages.debian.org/dh_undocumented",
  "checks": [{ "type": "binary", "name": "dh_undocumented" }],
  "install_guidance": {
    "plugin": "dh_undocumented", "binary": "dh_undocumented", "check": "which dh_undocumented",
    "install_steps": ["apt-get install dh_undocumented 2>/dev/null || which dh_undocumented", "Verify: dh_undocumented --version", "supercli plugins install ./plugins/dh_undocumented --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_undocumented", "resource": "_", "action": "_",
    "description": "Passthrough to dh_undocumented CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_undocumented", "passthrough": true, "missingDependencyHelp": "Install dh_undocumented: apt-get install dh_undocumented" }, "args": []
  }]
}
