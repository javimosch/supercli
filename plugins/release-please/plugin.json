{
  "name": "release-please",
  "version": "1.0.0",
  "description": "release-please \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=release-please+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "release-please"
    }
  ],
  "install_guidance": {
    "plugin": "release-please",
    "binary": "release-please",
    "check": "which release-please",
    "install_steps": [
      "Install release-please via package manager: apt install release-please or brew install release-please"
    ]
  },
  "commands": [
    {
      "namespace": "releaseplease",
      "resource": "run",
      "action": "exec",
      "description": "release-please \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "release-please",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install release-please via your package manager"
      },
      "args": []
    }
  ]
}