{
  "name": "zjsdecode",
  "version": "0.1.0",
  "description": "CLI tool: zjsdecode",
  "source": "https://manpages.debian.org/zjsdecode",
  "checks": [
    {
      "type": "binary",
      "name": "zjsdecode"
    }
  ],
  "install_guidance": {
    "plugin": "zjsdecode",
    "binary": "zjsdecode",
    "check": "which zjsdecode",
    "install_steps": [
      "apt-get install zjsdecode 2>/dev/null || which zjsdecode",
      "Verify: zjsdecode --version",
      "supercli plugins install ./plugins/zjsdecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zjsdecode",
      "resource": "self",
      "action": "version",
      "description": "Print zjsdecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zjsdecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zjsdecode: apt-get install zjsdecode 2>/dev/null || which zjsdecode"
      },
      "args": []
    },
    {
      "namespace": "zjsdecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zjsdecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zjsdecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install zjsdecode: apt-get install zjsdecode 2>/dev/null || which zjsdecode"
      },
      "args": []
    }
  ]
}