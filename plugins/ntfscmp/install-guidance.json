{
  "plugin": "ntfscmp",
  "binary": "ntfscmp",
  "check": "which ntfscmp",
  "install_steps": [
    "# Install ntfscmp",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ntfscmp-linux-amd64 -o /usr/local/bin/ntfscmp",
    "chmod +x /usr/local/bin/ntfscmp",
    "# Or via package manager, see /usr/bin/ntfscmp"
  ]
}