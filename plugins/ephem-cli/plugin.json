{
  "name": "ephem-cli",
  "version": "0.1.0",
  "description": "Calculate planetary positions and rise/set times",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "ephem-cli" }],
  "install_guidance": {
    "plugin": "ephem-cli",
    "binary": "ephem-cli",
    "check": "which ephem-cli",
    "install_steps": ["pip install ephem-cli", "Verify: ephem-cli --version", "supercli plugins install ./plugins/ephem-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ephem-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ephem-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ephem-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install ephem-cli: pip install ephem-cli"
    },
    "args": []
  }]
}
