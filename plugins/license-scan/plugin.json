{
  "name": "license-scan",
  "version": "0.1.0",
  "description": "Simple utility for identifying file licenses in projects",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "license-scan" }],
  "install_guidance": {
    "plugin": "license-scan",
    "binary": "license-scan",
    "check": "which license-scan",
    "install_steps": ["npm install -g license-scan", "Verify: license-scan --version", "supercli plugins install ./plugins/license-scan --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "license-scan",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to license-scan CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "license-scan",
      "passthrough": true,
      "missingDependencyHelp": "Install license-scan: npm install -g license-scan"
    },
    "args": []
  }]
}
