{
  "name": "sensors",
  "version": "0.1.0",
  "description": "Hardware sensor monitoring",
  "source": "https://packages.debian.org/sensors",
  "checks": [{ "type": "binary", "name": "sensors" }],
  "install_guidance": {
    "plugin": "sensors", "binary": "sensors", "check": "which sensors",
    "install_steps": ["apt-get install lm-sensors", "Verify: sensors --version", "supercli plugins install ./plugins/sensors --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sensors", "resource": "_", "action": "_",
    "description": "Passthrough to sensors CLI",
    "adapter": "process", "adapterConfig": { "command": "sensors", "passthrough": true, "missingDependencyHelp": "Install sensors: apt-get install lm-sensors" }, "args": []
  }]
}
