{
  "name": "qhelpconverter",
  "version": "0.1.0",
  "description": "CLI tool: qhelpconverter",
  "source": "https://manpages.debian.org/qhelpconverter",
  "checks": [
    {
      "type": "binary",
      "name": "qhelpconverter"
    }
  ],
  "install_guidance": {
    "plugin": "qhelpconverter",
    "binary": "qhelpconverter",
    "check": "which qhelpconverter",
    "install_steps": [
      "apt-get install qhelpconverter 2>/dev/null || which qhelpconverter",
      "Verify: qhelpconverter --version",
      "supercli plugins install ./plugins/qhelpconverter --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qhelpconverter",
      "resource": "self",
      "action": "version",
      "description": "Print qhelpconverter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qhelpconverter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qhelpconverter: apt-get install qhelpconverter 2>/dev/null || which qhelpconverter"
      },
      "args": []
    },
    {
      "namespace": "qhelpconverter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qhelpconverter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qhelpconverter",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qhelpconverter: apt-get install qhelpconverter 2>/dev/null || which qhelpconverter"
      },
      "args": []
    }
  ]
}