{
  "name": "Lynxe",
  "version": "0.1.0",
  "description": "A high-determinism, code-free 'Prompt Programing'  studio built with Java \u4e00\u4e2a\u9ad8\u786e\u5b9a\u6027\u7684 \u65e0\u4ee3\u7801 'Prompt\u7f16\u7a0b'\u5de5\u4f5c\u7ad9\uff0c",
  "source": "https://github.com/Lynxe/Lynxe",
  "checks": [
    {
      "type": "binary",
      "name": "lynxe"
    }
  ],
  "install_guidance": {
    "plugin": "Lynxe",
    "binary": "lynxe",
    "check": "which lynxe",
    "install_steps": [
      "pip install lynxe",
      "Verify: lynxe --version",
      "supercli plugins install ./plugins/Lynxe --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Lynxe",
      "resource": "self",
      "action": "version",
      "description": "Print Lynxe version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lynxe",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Lynxe: pip install lynxe"
      },
      "args": []
    },
    {
      "namespace": "Lynxe",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lynxe CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lynxe",
        "passthrough": true,
        "missingDependencyHelp": "Install Lynxe: pip install lynxe"
      },
      "args": []
    }
  ]
}