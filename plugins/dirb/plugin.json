{
  "name": "dirb",
  "version": "0.1.0",
  "description": "dirb — web directory scanner and brute-forcing tool. Discovers hidden directories and files on web servers using dictionary-based attack. Supports recursive scanning, custom wordlists, cookie authentication, proxy support, and various HTTP status code filtering.",
  "source": "https://github.com/dirb-fork/dirb",
  "checks": [
    {
      "type": "binary",
      "name": "dirb"
    }
  ],
  "install_guidance": {
    "plugin": "dirb",
    "binary": "dirb",
    "check": "which dirb",
    "install_steps": [
      "brew install dirb",
      "Verify: dirb --version",
      "supercli plugins install ./plugins/dirb --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "dirb",
      "resource": "self",
      "action": "version",
      "description": "Print dirb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dirb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dirb: brew install dirb"
      },
      "args": []
    },
    {
      "namespace": "dirb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dirb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dirb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dirb: brew install dirb"
      },
      "args": []
    }
  ]
}
