{
  "name": "clay-zig-bindings",
  "version": "0.1.0",
  "description": "Zig bindings for the library clay: A high performance UI layout library in C.",
  "source": "https://github.com/clay-zig-bindings/clay-zig-bindings",
  "checks": [
    {
      "type": "binary",
      "name": "clay-zig-bindings"
    }
  ],
  "install_guidance": {
    "plugin": "clay-zig-bindings",
    "binary": "clay-zig-bindings",
    "check": "which clay-zig-bindings",
    "install_steps": [
      "pip install clay-zig-bindings",
      "Verify: clay-zig-bindings --version",
      "supercli plugins install ./plugins/clay-zig-bindings --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clay-zig-bindings",
      "resource": "self",
      "action": "version",
      "description": "Print clay-zig-bindings version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clay-zig-bindings",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clay-zig-bindings: pip install clay-zig-bindings"
      },
      "args": []
    },
    {
      "namespace": "clay-zig-bindings",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clay-zig-bindings CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clay-zig-bindings",
        "passthrough": true,
        "missingDependencyHelp": "Install clay-zig-bindings: pip install clay-zig-bindings"
      },
      "args": []
    }
  ]
}