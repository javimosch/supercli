{
  "name": "Pandoc",
  "version": "0.1.0",
  "description": "Universal document file converter; handles input output from/to a number of formats: HTML, PDF, LaTeX, DOCX, ODT, AsciiDoc, Markdown, Textile, just to mention a few; the quality of conversion strongly depends on the combination of input/output formats.",
  "source": "https://github.com/jgm/pandoc",
  "checks": [
    {
      "type": "binary",
      "name": "Pandoc"
    }
  ],
  "install_guidance": {
    "plugin": "Pandoc",
    "binary": "Pandoc",
    "check": "which Pandoc",
    "install_steps": [
      "brew install Pandoc",
      "Verify: Pandoc --version",
      "supercli plugins install ./plugins/Pandoc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Pandoc",
      "resource": "self",
      "action": "version",
      "description": "Print Pandoc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Pandoc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Pandoc: brew install Pandoc"
      },
      "args": []
    },
    {
      "namespace": "Pandoc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Pandoc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Pandoc",
        "passthrough": true,
        "missingDependencyHelp": "Install Pandoc"
      },
      "args": []
    }
  ]
}