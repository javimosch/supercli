{
  "name": "depotdir8",
  "version": "0.1.0",
  "description": "CLI tool: depotdir8",
  "source": "https://packages.debian.org/depotdir8",
  "checks": [{ "type": "binary", "name": "depotdir8" }],
  "install_guidance": {
    "plugin": "depotdir8", "binary": "depotdir8", "check": "which depotdir8",
