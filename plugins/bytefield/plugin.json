{
  "name": "bytefield",
  "version": "0.1.0",
  "description": "CLI tool for generating protocol definition diagrams",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "bytefield" }],
  "install_guidance": {
    "plugin": "bytefield",
    "binary": "bytefield",
    "check": "which bytefield",
    "install_steps": ["cargo install bytefield", "Verify: bytefield --version", "supercli plugins install ./plugins/bytefield --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bytefield",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bytefield CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bytefield",
      "passthrough": true,
      "missingDependencyHelp": "Install bytefield: cargo install bytefield"
    },
    "args": []
  }]
}
