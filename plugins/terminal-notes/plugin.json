{
  "name": "terminal-notes",
  "version": "0.1.0",
  "description": "Lightweight terminal-based note management",
  "source": "https://github.com/busypeoples/terminal-notes",
  "checks": [{ "type": "binary", "name": "terminal-notes" }],
  "install_guidance": {
    "plugin": "terminal-notes",
    "binary": "terminal-notes",
    "check": "which terminal-notes",
    "install_steps": ["npm install -g terminal-notes", "Verify: terminal-notes --version", "supercli plugins install ./plugins/terminal-notes --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terminal-notes",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terminal-notes CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terminal-notes",
      "passthrough": true,
      "missingDependencyHelp": "Install terminal-notes: npm install -g terminal-notes", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
