{
  "name": "radio-log-cli",
  "version": "0.1.0",
  "description": "Simple logging tool for paperless ham radio station records",
  "source": "go",
  "checks": [{ "type": "binary", "name": "radio-log-cli" }],
  "install_guidance": {
    "plugin": "radio-log-cli",
    "binary": "radio-log-cli",
    "check": "which radio-log-cli",
    "install_steps": ["go install github.com/radio-log-cli@latest", "Verify: radio-log-cli --version", "supercli plugins install ./plugins/radio-log-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "radio-log-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to radio-log-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "radio-log-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install radio-log-cli: go install github.com/radio-log-cli@latest"
    },
    "args": []
  }]
}
