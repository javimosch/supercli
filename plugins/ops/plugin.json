{
  "name": "ops",
  "version": "0.1.0",
  "description": "Unikernel compilation and orchestration tool",
  "source": "https://github.com/nanovms/ops",
  "checks": [
    {
      "type": "binary",
      "name": "ops"
    }
  ],
  "install_guidance": {
    "plugin": "ops",
    "binary": "ops",
    "check": "which ops",
    "install_steps": [
      "See https://github.com/nanovms/ops",
      "Verify: ops --version",
      "supercli plugins install ./plugins/ops --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ops",
      "resource": "self",
      "action": "version",
      "description": "Print ops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ops: See https://github.com/nanovms/ops"
      },
      "args": []
    },
    {
      "namespace": "ops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ops",
        "passthrough": true,
        "missingDependencyHelp": "Install ops"
      },
      "args": []
    }
  ]
}