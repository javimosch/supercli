{
  "name": "text2srt_tts",
  "version": "0.1.0",
  "description": "Convert text to speech and generate SRT subtitles",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "text2srt_tts" }],
  "install_guidance": {
    "plugin": "text2srt_tts",
    "binary": "text2srt_tts",
    "check": "which text2srt_tts",
    "install_steps": ["pip install text2srt-tts", "Verify: text2srt_tts --version", "supercli plugins install ./plugins/text2srt_tts --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "text2srt_tts",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to text2srt_tts CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "text2srt_tts",
      "passthrough": true,
      "missingDependencyHelp": "Install text2srt_tts: pip install text2srt-tts"
    },
    "args": []
  }]
}
