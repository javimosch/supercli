{
  "name": "Z-Ant",
  "version": "0.1.0",
  "description": "Zant simplifies the deployment and optimization of neural networks on microprocessors",
  "source": "https://github.com/Z-Ant/Z-Ant",
  "checks": [
    {
      "type": "binary",
      "name": "z-ant"
    }
  ],
  "install_guidance": {
    "plugin": "Z-Ant",
    "binary": "z-ant",
    "check": "which z-ant",
    "install_steps": [
      "pip install z-ant",
      "Verify: z-ant --version",
      "supercli plugins install ./plugins/Z-Ant --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Z-Ant",
      "resource": "self",
      "action": "version",
      "description": "Print Z-Ant version",
      "adapter": "process",
      "adapterConfig": {
        "command": "z-ant",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Z-Ant: pip install z-ant"
      },
      "args": []
    },
    {
      "namespace": "Z-Ant",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to z-ant CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "z-ant",
        "passthrough": true,
        "missingDependencyHelp": "Install Z-Ant: pip install z-ant"
      },
      "args": []
    }
  ]
}