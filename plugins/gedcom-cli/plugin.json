{
  "name": "gedcom-cli",
  "version": "0.1.0",
  "description": "Search and display GEDCOM genealogy file contents",
  "source": "https://github.com/dperry/gedcom-cli",
  "checks": [{ "type": "binary", "name": "gedcom-cli" }],
  "install_guidance": {
    "plugin": "gedcom-cli",
    "binary": "gedcom-cli",
    "check": "which gedcom-cli",
    "install_steps": ["npm install -g gedcom-cli", "Verify: gedcom-cli --version", "supercli plugins install ./plugins/gedcom-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gedcom-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gedcom-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gedcom-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install gedcom-cli: npm install -g gedcom-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
