{
  "name": "write.ul",
  "version": "0.1.0",
  "description": "CLI tool: write.ul",
  "source": "https://manpages.debian.org/write.ul",
  "checks": [
    {
      "type": "binary",
      "name": "write.ul"
    }
  ],
  "install_guidance": {
    "plugin": "write.ul",
    "binary": "write.ul",
    "check": "which write.ul",
    "install_steps": [
      "apt-get install write.ul 2>/dev/null || which write.ul",
      "Verify: write.ul --version",
      "supercli plugins install ./plugins/write.ul --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "write.ul",
      "resource": "self",
      "action": "version",
      "description": "Print write.ul version",
      "adapter": "process",
      "adapterConfig": {
        "command": "write.ul",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install write.ul: apt-get install write.ul 2>/dev/null || which write.ul"
      },
      "args": []
    },
    {
      "namespace": "write.ul",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to write.ul CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "write.ul",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install write.ul: apt-get install write.ul 2>/dev/null || which write.ul"
      },
      "args": []
    }
  ]
}