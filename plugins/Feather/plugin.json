{
  "name": "Feather",
  "version": "0.1.0",
  "description": "Free on-device iOS/iPadOS application manager/installer, using certificates part of the Apple Develo",
  "source": "https://github.com/Feather/Feather",
  "checks": [
    {
      "type": "binary",
      "name": "feather"
    }
  ],
  "install_guidance": {
    "plugin": "Feather",
    "binary": "feather",
    "check": "which feather",
    "install_steps": [
      "pip install feather",
      "Verify: feather --version",
      "supercli plugins install ./plugins/Feather --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Feather",
      "resource": "self",
      "action": "version",
      "description": "Print Feather version",
      "adapter": "process",
      "adapterConfig": {
        "command": "feather",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Feather: pip install feather"
      },
      "args": []
    },
    {
      "namespace": "Feather",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to feather CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "feather",
        "passthrough": true,
        "missingDependencyHelp": "Install Feather: pip install feather"
      },
      "args": []
    }
  ]
}