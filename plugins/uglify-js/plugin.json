{
  "name": "uglify-js",
  "version": "0.1.0",
  "description": "UglifyJS — JavaScript minifier, mangler, and compressor. Reduces file size by removing whitespace, renaming variables, optimizing statements, and dead code elimination. Supports source maps and CLI batch processing.",
  "source": "https://github.com/mishoo/UglifyJS",
  "checks": [
    {
      "type": "binary",
      "name": "uglifyjs"
    }
  ],
  "install_guidance": {
    "plugin": "uglify-js",
    "binary": "uglifyjs",
    "check": "which uglifyjs",
    "install_steps": [
      "npm install -g uglify-js",
      "Verify: uglifyjs --version",
      "supercli plugins install ./plugins/uglify-js --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "uglify-js",
      "resource": "self",
      "action": "version",
      "description": "Print uglify-js version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uglifyjs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uglify-js: npm install -g uglify-js"
      },
      "args": []
    },
    {
      "namespace": "uglify-js",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uglifyjs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uglifyjs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uglify-js: npm install -g uglify-js"
      },
      "args": []
    }
  ]
}
