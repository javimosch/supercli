{
  "name": "feroxbuster",
  "version": "0.1.0",
  "description": "A recursive content discovery tool for web servers. Performs forced browsing and directory enumeration with high concurrency for penetration testing.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "feroxbuster"
    }
  ],
  "install_guidance": {
    "plugin": "feroxbuster",
    "binary": "feroxbuster",
    "check": "which feroxbuster",
    "install_steps": [
      "cargo install feroxbuster",
      "Verify: feroxbuster --version",
      "supercli plugins install ./plugins/feroxbuster --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "feroxbuster",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to feroxbuster CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "feroxbuster",
        "passthrough": true,
        "missingDependencyHelp": "Install feroxbuster: cargo install feroxbuster"
      },
      "args": []
    }
  ]
}
