{
  "name": "dm",
  "version": "0.1.0",
  "description": "Discord Messenger is a free Discord-compatible messaging client that works on 30 years of Windows ve",
  "source": "https://github.com/dm/dm",
  "checks": [
    {
      "type": "binary",
      "name": "dm"
    }
  ],
  "install_guidance": {
    "plugin": "dm",
    "binary": "dm",
    "check": "which dm",
    "install_steps": [
      "pip install dm",
      "Verify: dm --version",
      "supercli plugins install ./plugins/dm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dm",
      "resource": "self",
      "action": "version",
      "description": "Print dm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dm: pip install dm"
      },
      "args": []
    },
    {
      "namespace": "dm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dm",
        "passthrough": true,
        "missingDependencyHelp": "Install dm: pip install dm"
      },
      "args": []
    }
  ]
}