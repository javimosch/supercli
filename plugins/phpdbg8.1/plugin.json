{
  "name": "phpdbg8.1",
  "version": "0.1.0",
  "description": "CLI tool: phpdbg8.1",
  "source": "https://manpages.debian.org/phpdbg8.1",
  "checks": [
    {
      "type": "binary",
      "name": "phpdbg8.1"
    }
  ],
  "install_guidance": {
    "plugin": "phpdbg8.1",
    "binary": "phpdbg8.1",
    "check": "which phpdbg8.1",
    "install_steps": [
      "apt-get install phpdbg8.1 2>/dev/null || which phpdbg8.1",
      "Verify: phpdbg8.1 --version",
      "supercli plugins install ./plugins/phpdbg8.1 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "phpdbg8.1",
      "resource": "self",
      "action": "version",
      "description": "Print phpdbg8.1 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "phpdbg8.1",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install phpdbg8.1: apt-get install phpdbg8.1 2>/dev/null || which phpdbg8.1"
      },
      "args": []
    },
    {
      "namespace": "phpdbg8.1",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to phpdbg8.1 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "phpdbg8.1",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install phpdbg8.1: apt-get install phpdbg8.1 2>/dev/null || which phpdbg8.1"
      },
      "args": []
    }
  ]
}