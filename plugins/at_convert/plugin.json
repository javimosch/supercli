{
  "name": "at_convert",
  "version": "0.1.0",
  "description": "CLI tool: at_convert",
  "source": "https://packages.debian.org/at_convert",
  "checks": [{ "type": "binary", "name": "at_convert" }],
  "install_guidance": {
    "plugin": "at_convert", "binary": "at_convert", "check": "which at_convert",
    "install_steps": ["apt-get install at_convert 2>/dev/null || which at_convert", "Verify: at_convert --version", "supercli plugins install ./plugins/at_convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_convert", "resource": "_", "action": "_",
    "description": "Passthrough to at_convert CLI",
    "adapter": "process", "adapterConfig": { "command": "at_convert", "passthrough": true, "missingDependencyHelp": "Install at_convert: apt-get install at_convert" }, "args": []
  }]
}
