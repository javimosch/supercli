{
  "name": "liburing",
  "version": "0.1.0",
  "description": "Helpers to setup and teardown io_uring instances",
  "source": "https://github.com/axboe/liburing",
  "checks": [
    {
      "type": "binary",
      "name": "liburing"
    }
  ],
  "install_guidance": {
    "plugin": "liburing",
    "binary": "liburing",
    "check": "which liburing",
    "install_steps": [
      "brew install liburing",
      "Verify: liburing --version",
      "supercli plugins install ./plugins/liburing --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "liburing",
      "resource": "self",
      "action": "version",
      "description": "Print liburing version",
      "adapter": "process",
      "adapterConfig": {
        "command": "liburing",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install liburing: brew install liburing"
      },
      "args": []
    },
    {
      "namespace": "liburing",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to liburing CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "liburing",
        "passthrough": true,
        "missingDependencyHelp": "Install liburing"
      },
      "args": []
    }
  ]
}