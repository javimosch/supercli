{
  "name": "ictree",
  "version": "0.1.0",
  "description": "Like tree but interactive.",
  "source": "https://github.com/NikitaIvanovV/ictree",
  "checks": [
    {
      "type": "binary",
      "name": "ictree"
    }
  ],
  "install_guidance": {
    "plugin": "ictree",
    "binary": "ictree",
    "check": "which ictree",
    "install_steps": [
      "See https://github.com/NikitaIvanovV/ictree",
      "Verify: ictree --version",
      "supercli plugins install ./plugins/ictree --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ictree",
      "resource": "self",
      "action": "version",
      "description": "Print ictree version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ictree",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ictree: See https://github.com/NikitaIvanovV/ictree"
      },
      "args": []
    },
    {
      "namespace": "ictree",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ictree CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ictree",
        "passthrough": true,
        "missingDependencyHelp": "Install ictree"
      },
      "args": []
    }
  ]
}