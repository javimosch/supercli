{
  "name": "chruby",
  "version": "0.1.0",
  "description": "Ruby environment tool",
  "source": "https://github.com/postmodern/chruby",
  "checks": [
    {
      "type": "binary",
      "name": "chruby"
    }
  ],
  "install_guidance": {
    "plugin": "chruby",
    "binary": "chruby",
    "check": "which chruby",
    "install_steps": [
      "brew install chruby",
      "Verify: chruby --version",
      "supercli plugins install ./plugins/chruby --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chruby",
      "resource": "self",
      "action": "version",
      "description": "Print chruby version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chruby",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chruby: brew install chruby"
      },
      "args": []
    },
    {
      "namespace": "chruby",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chruby CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chruby",
        "passthrough": true,
        "missingDependencyHelp": "Install chruby"
      },
      "args": []
    }
  ]
}