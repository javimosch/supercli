{
  "name": "pid1",
  "version": "0.1.0",
  "description": "A lightweight PID 1 process manager for containers. Handles signal forwarding and zombie process reaping for proper container initialization.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "pid1"
    }
  ],
  "install_guidance": {
    "plugin": "pid1",
    "binary": "pid1",
    "check": "which pid1",
    "install_steps": [
      "cargo install pid1",
      "Verify: pid1 --version",
      "supercli plugins install ./plugins/pid1 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pid1",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pid1 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pid1",
        "passthrough": true,
        "missingDependencyHelp": "Install pid1: cargo install pid1"
      },
      "args": []
    }
  ]
}
