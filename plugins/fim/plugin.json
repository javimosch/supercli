{
  "name": "fim",
  "version": "0.1.0",
  "description": "Highly configurable framebuffer image viewer for the terminal",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "fim" }],
  "install_guidance": {
    "plugin": "fim",
    "binary": "fim",
    "check": "which fim",
    "install_steps": ["sudo apt install fim", "Verify: fim --version", "supercli plugins install ./plugins/fim --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fim",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fim CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fim",
      "passthrough": true,
      "missingDependencyHelp": "Install fim: sudo apt install fim"
    },
    "args": []
  }]
}
