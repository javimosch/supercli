{
  "name": "cookie-clicker-rollup",
  "version": "0.1.0",
  "description": "This rollup will only let you click the cookie",
  "source": "https://github.com/cookie-clicker-rollup/cookie-clicker-rollup",
  "checks": [
    {
      "type": "binary",
      "name": "cookie-clicker-rollup"
    }
  ],
  "install_guidance": {
    "plugin": "cookie-clicker-rollup",
    "binary": "cookie-clicker-rollup",
    "check": "which cookie-clicker-rollup",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cookie-clicker-rollup --version",
      "supercli plugins install ./plugins/cookie-clicker-rollup --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "cookie-clicker-rollup",
      "resource": "self",
      "action": "version",
      "description": "Print cookie-clicker-rollup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cookie-clicker-rollup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cookie-clicker-rollup from project repository"
      },
      "args": []
    },
    {
      "namespace": "cookie-clicker-rollup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cookie-clicker-rollup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cookie-clicker-rollup",
        "passthrough": true,
        "missingDependencyHelp": "Install cookie-clicker-rollup from project repository"
      },
      "args": []
    }
  ]
}