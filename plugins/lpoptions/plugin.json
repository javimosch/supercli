{
  "name": "lpoptions",
  "version": "0.1.0",
  "description": "CLI tool: lpoptions",
  "source": "https://manpages.debian.org/lpoptions",
  "checks": [
    {
      "type": "binary",
      "name": "lpoptions"
    }
  ],
  "install_guidance": {
    "plugin": "lpoptions",
    "binary": "lpoptions",
    "check": "which lpoptions",
    "install_steps": [
      "apt-get install lpoptions 2>/dev/null || which lpoptions",
      "Verify: lpoptions --version",
      "supercli plugins install ./plugins/lpoptions --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lpoptions",
      "resource": "self",
      "action": "version",
      "description": "Print lpoptions version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lpoptions",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lpoptions: apt-get install lpoptions 2>/dev/null || which lpoptions"
      },
      "args": []
    },
    {
      "namespace": "lpoptions",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lpoptions CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lpoptions",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lpoptions: apt-get install lpoptions 2>/dev/null || which lpoptions"
      },
      "args": []
    }
  ]
}