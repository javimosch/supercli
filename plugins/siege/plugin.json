{
  "name": "siege",
  "version": "0.1.0",
  "description": "HTTP load testing and benchmarking utility",
  "source": "https://github.com/JoeDog/siege",
  "checks": [{ "type": "binary", "name": "siege" }],
  "install_guidance": {
    "plugin": "siege",
    "binary": "siege",
    "check": "which siege",
    "install_steps": ["brew install siege", "Verify: siege --version", "supercli plugins install ./plugins/siege --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "siege",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to siege CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "siege",
      "passthrough": true,
      "missingDependencyHelp": "Install siege: brew install siege"
    },
    "args": []
  }]
}
