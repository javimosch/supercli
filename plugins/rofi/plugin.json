{
  "name": "rofi",
  "version": "1.0.0",
  "description": "rofi \u2014 Window switcher/launcher",
  "source": "github.com/davatorium/rofi",
  "checks": [
    {
      "type": "binary",
      "name": "rofi"
    }
  ],
  "install_guidance": {
    "plugin": "rofi",
    "binary": "rofi",
    "check": "which rofi",
    "install_steps": [
      "# Install rofi:",
      "# apt: sudo apt-get install rofi",
      "# brew: brew install rofi",
      "# cargo: cargo install rofi",
      "# npm: npm install -g rofi",
      "# pip: pip install rofi",
      "# or download from github.com/davatorium/rofi"
    ]
  },
  "commands": [
    {
      "namespace": "rofi",
      "resource": "rofi",
      "action": "run",
      "description": "Run rofi",
      "adapter": "process",
      "adapterConfig": {
        "command": "rofi",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rofi from github.com/davatorium/rofi"
      },
      "args": []
    }
  ]
}