{
  "name": "kyanos",
  "version": "0.1.0",
  "description": "Kyanos is a networking analysis tool using eBPF. It can visualize the time packets spend in the kern",
  "source": "https://github.com/kyanos/kyanos",
  "checks": [
    {
      "type": "binary",
      "name": "kyanos"
    }
  ],
  "install_guidance": {
    "plugin": "kyanos",
    "binary": "kyanos",
    "check": "which kyanos",
    "install_steps": [
      "pip install kyanos",
      "Verify: kyanos --version",
      "supercli plugins install ./plugins/kyanos --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kyanos",
      "resource": "self",
      "action": "version",
      "description": "Print kyanos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kyanos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kyanos: pip install kyanos"
      },
      "args": []
    },
    {
      "namespace": "kyanos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kyanos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kyanos",
        "passthrough": true,
        "missingDependencyHelp": "Install kyanos: pip install kyanos"
      },
      "args": []
    }
  ]
}