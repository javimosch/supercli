{
  "name": "twf",
  "version": "0.1.0",
  "description": "Standalone tree view file explorer.",
  "source": "https://github.com/wvanlint/twf",
  "checks": [
    {
      "type": "binary",
      "name": "twf"
    }
  ],
  "install_guidance": {
    "plugin": "twf",
    "binary": "twf",
    "check": "which twf",
    "install_steps": [
      "See https://github.com/wvanlint/twf",
      "Verify: twf --version",
      "supercli plugins install ./plugins/twf --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "twf",
      "resource": "self",
      "action": "version",
      "description": "Print twf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "twf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install twf: See https://github.com/wvanlint/twf"
      },
      "args": []
    },
    {
      "namespace": "twf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to twf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "twf",
        "passthrough": true,
        "missingDependencyHelp": "Install twf"
      },
      "args": []
    }
  ]
}