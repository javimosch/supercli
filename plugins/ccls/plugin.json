{
  "name": "ccls",
  "version": "0.1.0",
  "description": "C/C++/ObjC language server",
  "source": "https://github.com/MaskRay/ccls",
  "checks": [
    {
      "type": "binary",
      "name": "ccls"
    }
  ],
  "install_guidance": {
    "plugin": "ccls",
    "binary": "ccls",
    "check": "which ccls",
    "install_steps": [
      "brew install ccls",
      "Verify: ccls --version",
      "supercli plugins install ./plugins/ccls --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ccls",
      "resource": "self",
      "action": "version",
      "description": "Print ccls version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ccls: brew install ccls"
      },
      "args": []
    },
    {
      "namespace": "ccls",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ccls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccls",
        "passthrough": true,
        "missingDependencyHelp": "Install ccls"
      },
      "args": []
    }
  ]
}