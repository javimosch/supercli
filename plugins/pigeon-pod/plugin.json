{
  "name": "pigeon-pod",
  "version": "0.1.0",
  "description": "Listen to YouTube & Bilibili. Anywhere.",
  "source": "https://github.com/pigeon-pod/pigeon-pod",
  "checks": [
    {
      "type": "binary",
      "name": "pigeon-pod"
    }
  ],
  "install_guidance": {
    "plugin": "pigeon-pod",
    "binary": "pigeon-pod",
    "check": "which pigeon-pod",
    "install_steps": [
      "pip install pigeon-pod",
      "Verify: pigeon-pod --version",
      "supercli plugins install ./plugins/pigeon-pod --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pigeon-pod",
      "resource": "self",
      "action": "version",
      "description": "Print pigeon-pod version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pigeon-pod",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pigeon-pod: pip install pigeon-pod"
      },
      "args": []
    },
    {
      "namespace": "pigeon-pod",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pigeon-pod CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pigeon-pod",
        "passthrough": true,
        "missingDependencyHelp": "Install pigeon-pod: pip install pigeon-pod"
      },
      "args": []
    }
  ]
}