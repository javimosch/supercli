{
  "name": "git-sizer",
  "version": "1.0.0",
  "description": "git-sizer \u2014 Git repository size analysis",
  "source": "github.com/github/git-sizer",
  "checks": [
    {
      "type": "binary",
      "name": "git-sizer"
    }
  ],
  "install_guidance": {
    "plugin": "git-sizer",
    "binary": "git-sizer",
    "check": "which git-sizer",
    "install_steps": [
      "# Install git-sizer:",
      "# apt: sudo apt-get install git-sizer",
      "# brew: brew install git-sizer",
      "# cargo: cargo install git-sizer",
      "# npm: npm install -g git-sizer",
      "# pip: pip install git-sizer",
      "# or download from github.com/github/git-sizer"
    ]
  },
  "commands": [
    {
      "namespace": "git",
      "resource": "sizer",
      "action": "run",
      "description": "Run git-sizer",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-sizer",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install git-sizer from github.com/github/git-sizer"
      },
      "args": []
    }
  ]
}