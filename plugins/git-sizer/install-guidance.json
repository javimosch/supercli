{
  "plugin": "git-sizer",
  "binary": "git-sizer",
  "check": "which git-sizer",
  "install_steps": [
    "# Install git-sizer",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/git-sizer-linux-amd64 -o /usr/local/bin/git-sizer",
    "chmod +x /usr/local/bin/git-sizer",
    "# Or via package manager, see github.com/github/git-sizer"
  ]
}