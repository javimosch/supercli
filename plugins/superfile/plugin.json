{
  "name": "superfile",
  "version": "1.0.0",
  "description": "Pretty fancy and modern terminal file manager",
  "source": "https://github.com/yorukot/superfile",
  "checks": [
    {
      "type": "binary",
      "name": "spf"
    }
  ],
  "install_guidance": {
    "plugin": "superfile",
    "binary": "spf",
    "check": "spf --version",
    "install_steps": [
      "Install via Homebrew: brew install superfile",
      "Or download binary from GitHub releases: https://github.com/yorukot/superfile/releases",
      "Or install via Go: go install github.com/yorukot/superfile@latest"
    ],
    "note": "Binary is named 'spf'. Make sure your PATH includes the Go bin directory if installing via go install."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "superfile",
      "resource": "files",
      "action": "open",
      "description": "Open superfile file manager in current directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "spf",
        "missingDependencyHelp": "Install spf: Install via Homebrew: brew install superfile"
      },
      "args": []
    },
    {
      "namespace": "superfile",
      "resource": "files",
      "action": "open-path",
      "description": "Open superfile at specific path",
      "adapter": "process",
      "adapterConfig": {
        "command": "spf",
        "positionalArgs": [
          "path"
        ],
        "missingDependencyHelp": "Install spf: Install via Homebrew: brew install superfile"
      },
      "args": [
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "Directory path to open",
          "positional": true
        }
      ]
    },
    {
      "namespace": "superfile",
      "resource": "self",
      "action": "version",
      "description": "Print spf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spf: Install via Homebrew: brew install superfile"
      },
      "args": []
    },
    {
      "namespace": "superfile",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install spf: Install via Homebrew: brew install superfile"
      },
      "args": []
    }
  ]
}
