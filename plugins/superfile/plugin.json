{
  "name": "superfile",
  "description": "Pretty fancy and modern terminal file manager",
  "version": "1.0.0",
  "binary": "spf",
  "check": "spf --version",
  "install": {
    "method": "brew",
    "command": "brew install superfile"
  },
  "commands": {
    "open": {
      "command": "spf",
      "description": "Open superfile file manager in current directory"
    },
    "open-path": {
      "command": "spf {path}",
      "description": "Open superfile at specific path",
      "args": ["path"]
    }
  }
}
