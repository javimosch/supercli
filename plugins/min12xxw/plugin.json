{
  "name": "min12xxw",
  "version": "0.1.0",
  "description": "CLI tool: min12xxw",
  "source": "https://manpages.debian.org/min12xxw",
  "checks": [
    {
      "type": "binary",
      "name": "min12xxw"
    }
  ],
  "install_guidance": {
    "plugin": "min12xxw",
    "binary": "min12xxw",
    "check": "which min12xxw",
    "install_steps": [
      "apt-get install min12xxw 2>/dev/null || which min12xxw",
      "Verify: min12xxw --version",
      "supercli plugins install ./plugins/min12xxw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "min12xxw",
      "resource": "self",
      "action": "version",
      "description": "Print min12xxw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "min12xxw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install min12xxw: apt-get install min12xxw 2>/dev/null || which min12xxw"
      },
      "args": []
    },
    {
      "namespace": "min12xxw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to min12xxw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "min12xxw",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install min12xxw: apt-get install min12xxw 2>/dev/null || which min12xxw"
      },
      "args": []
    }
  ]
}