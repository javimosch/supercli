{
  "name": "dijitso",
  "version": "0.1.0",
  "description": "CLI tool: dijitso",
  "source": "https://packages.debian.org/dijitso",
  "checks": [{ "type": "binary", "name": "dijitso" }],
  "install_guidance": {
    "plugin": "dijitso", "binary": "dijitso", "check": "which dijitso",
    "install_steps": ["apt-get install dijitso 2>/dev/null || which dijitso", "Verify: dijitso --version", "supercli plugins install ./plugins/dijitso --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dijitso", "resource": "_", "action": "_",
    "description": "Passthrough to dijitso CLI",
    "adapter": "process", "adapterConfig": { "command": "dijitso", "passthrough": true, "missingDependencyHelp": "Install dijitso: apt-get install dijitso" }, "args": []
  }]
}
