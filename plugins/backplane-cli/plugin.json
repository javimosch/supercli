{
  "name": "backplane-cli",
  "version": "0.1.0",
  "description": "CLI for interacting with the OpenShift Backplane API",
  "source": "https://github.com/openshift/backplane-cli",
  "checks": [
    {
      "type": "binary",
      "name": "backplane-cli"
    }
  ],
  "install_guidance": {
    "plugin": "backplane-cli",
    "binary": "backplane-cli",
    "check": "which backplane-cli",
    "install_steps": [
      "brew install backplane-cli",
      "Verify: backplane-cli --version",
      "supercli plugins install ./plugins/backplane-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "backplane-cli",
      "resource": "self",
      "action": "version",
      "description": "Print backplane-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "backplane-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install backplane-cli: brew install backplane-cli"
      },
      "args": []
    },
    {
      "namespace": "backplane-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to backplane-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "backplane-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install backplane-cli"
      },
      "args": []
    }
  ]
}