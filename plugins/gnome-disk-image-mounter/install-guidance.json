{
  "plugin": "gnome-disk-image-mounter",
  "binary": "gnome-disk-image-mounter",
  "check": "which gnome-disk-image-mounter",
  "install_steps": [
    "apt-get install gnome-disk-image-mounter 2>/dev/null || which gnome-disk-image-mounter",
    "Verify: gnome-disk-image-mounter --version",
    "supercli plugins install ./plugins/gnome-disk-image-mounter --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}