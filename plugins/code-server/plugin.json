{
  "name": "code-server",
  "version": "0.1.0",
  "description": "CLI tool: code-server",
  "source": "https://packages.debian.org/code-server",
  "checks": [{ "type": "binary", "name": "code-server" }],
  "install_guidance": {
    "plugin": "code-server", "binary": "code-server", "check": "which code-server",
    "install_steps": ["apt-get install code-server 2>/dev/null || which code-server", "Verify: code-server --version", "supercli plugins install ./plugins/code-server --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "code-server", "resource": "_", "action": "_",
    "description": "Passthrough to code-server CLI",
    "adapter": "process", "adapterConfig": { "command": "code-server", "passthrough": true, "missingDependencyHelp": "Install code-server: apt-get install code-server" }, "args": []
  }]
}
