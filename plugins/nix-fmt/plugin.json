{
  "name": "nix-fmt",
  "version": "0.1.0",
  "description": "Experimental formatter for Nix expression language files",
  "source": "https://github.com/nix-community/nix-fmt",
  "checks": [{ "type": "binary", "name": "nix-fmt" }],
  "install_guidance": {
    "plugin": "nix-fmt",
    "binary": "nix-fmt",
    "check": "which nix-fmt",
    "install_steps": ["git clone and install", "Verify: nix-fmt --version", "supercli plugins install ./plugins/nix-fmt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nix-fmt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nix-fmt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nix-fmt",
      "passthrough": true,
      "missingDependencyHelp": "Install nix-fmt: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
