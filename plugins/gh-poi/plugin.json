{
  "name": "gh-poi",
  "version": "0.1.0",
  "description": "Delete merged GitHub branches with CLI — JSON output supported",
  "source": "https://github.com/seachicken/gh-poi",
  "checks": [
    {
      "type": "binary",
      "name": "gh-poi"
    }
  ],
  "install_guidance": {
    "plugin": "gh-poi",
    "binary": "gh-poi",
    "check": "which gh-poi",
    "install_steps": [
      "go install github.com/seachicken/gh-poi@latest",
      "Verify: gh-poi --version",
      "supercli plugins install ./plugins/gh-poi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gh-poi",
      "resource": "self",
      "action": "version",
      "description": "Print gh-poi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-poi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gh-poi: go install github.com/seachicken/gh-poi@latest"
      },
      "args": []
    },
    {
      "namespace": "gh-poi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gh-poi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-poi",
        "passthrough": true,
        "missingDependencyHelp": "Install gh-poi: go install github.com/seachicken/gh-poi@latest"
      },
      "args": []
    }
  ]
}
