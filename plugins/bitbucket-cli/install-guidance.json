{
  "plugin": "bitbucket-cli",
  "binary": "bitbucket-cli",
  "check": "which bitbucket-cli",
  "install_steps": [
    "go install github.com/bitbucket-cli/bitbucket-cli@latest",
    "Verify: bitbucket-cli --version",
    "supercli plugins install ./plugins/bitbucket-cli --on-conflict replace --json"
  ],
  "note": "Requires Go toolchain"
}
