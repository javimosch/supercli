{
  "name": "bitbucket-cli",
  "version": "0.1.0",
  "description": "Bitbucket CLI with gh-like ergonomics",
  "source": "https://github.com/bitbucket-cli/bitbucket-cli",
  "checks": [
    {
      "type": "binary",
      "name": "bitbucket-cli"
    }
  ],
  "install_guidance": {
    "plugin": "bitbucket-cli",
    "binary": "bitbucket-cli",
    "check": "which bitbucket-cli",
    "install_steps": [
      "go install github.com/bitbucket-cli/bitbucket-cli@latest",
      "Verify: bitbucket-cli --version",
      "supercli plugins install ./plugins/bitbucket-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bitbucket-cli",
      "resource": "self",
      "action": "version",
      "description": "Print bitbucket-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitbucket-cli",
        "missingDependencyHelp": "Install bitbucket-cli: go install github.com/bitbucket-cli/bitbucket-cli@latest",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "bitbucket-cli",
      "resource": "repo",
      "action": "list",
      "description": "List Bitbucket repositories",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitbucket-cli",
        "missingDependencyHelp": "Install bitbucket-cli: go install github.com/bitbucket-cli/bitbucket-cli@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "bitbucket-cli",
      "resource": "repo",
      "action": "create",
      "description": "Create a Bitbucket repository",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitbucket-cli",
        "missingDependencyHelp": "Install bitbucket-cli: go install github.com/bitbucket-cli/bitbucket-cli@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "bitbucket-cli",
      "resource": "pr",
      "action": "list",
      "description": "List pull requests",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitbucket-cli",
        "missingDependencyHelp": "Install bitbucket-cli: go install github.com/bitbucket-cli/bitbucket-cli@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "bitbucket-cli",
      "resource": "pr",
      "action": "create",
      "description": "Create a pull request",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitbucket-cli",
        "missingDependencyHelp": "Install bitbucket-cli: go install github.com/bitbucket-cli/bitbucket-cli@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "bitbucket-cli",
      "resource": "_",
      "action": "_",
      "description": "_ _ via bitbucket-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitbucket-cli",
        "missingDependencyHelp": "Install bitbucket-cli: go install github.com/bitbucket-cli/bitbucket-cli@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
