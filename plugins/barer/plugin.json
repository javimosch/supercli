{
  "name": "barer",
  "version": "0.1.0",
  "description": "Display progress bars for piped input streams",
  "source": "https://github.com/dalance/barer",
  "checks": [{ "type": "binary", "name": "barer" }],
  "install_guidance": {
    "plugin": "barer",
    "binary": "barer",
    "check": "which barer",
    "install_steps": ["cargo install barer", "Verify: barer --version", "supercli plugins install ./plugins/barer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "barer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to barer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "barer",
      "passthrough": true,
      "missingDependencyHelp": "Install barer: cargo install barer", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
