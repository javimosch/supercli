{
  "name": "cloudtool",
  "version": "0.1.0",
  "description": "3D point cloud processing utility based on PCL and Qt",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "cloudtool" }],
  "install_guidance": {
    "plugin": "cloudtool",
    "binary": "cloudtool",
    "check": "which cloudtool",
    "install_steps": ["cmake .. && make", "Verify: cloudtool --version", "supercli plugins install ./plugins/cloudtool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cloudtool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cloudtool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cloudtool",
      "passthrough": true,
      "missingDependencyHelp": "Install cloudtool: cmake .. && make"
    },
    "args": []
  }]
}
