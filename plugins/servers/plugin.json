{
  "name": "servers",
  "version": "0.1.0",
  "description": "Model Context Protocol Servers",
  "source": "https://github.com/servers/servers",
  "checks": [
    {
      "type": "binary",
      "name": "servers"
    }
  ],
  "install_guidance": {
    "plugin": "servers",
    "binary": "servers",
    "check": "which servers",
    "install_steps": [
      "pip install servers",
      "Verify: servers --version",
      "supercli plugins install ./plugins/servers --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "servers",
      "resource": "self",
      "action": "version",
      "description": "Print servers version",
      "adapter": "process",
      "adapterConfig": {
        "command": "servers",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install servers: pip install servers"
      },
      "args": []
    },
    {
      "namespace": "servers",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to servers CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "servers",
        "passthrough": true,
        "missingDependencyHelp": "Install servers: pip install servers"
      },
      "args": []
    }
  ]
}