{
  "plugin": "rrsync",
  "binary": "rrsync",
  "check": "which rrsync",
  "install_steps": [
    "# Install rrsync",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rrsync-linux-amd64 -o /usr/local/bin/rrsync",
    "chmod +x /usr/local/bin/rrsync",
    "# Or via package manager, see /usr/bin/rrsync"
  ]
}