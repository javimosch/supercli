{
  "name": "rrsync",
  "version": "1.0.0",
  "description": "rrsync — rrsync — CLI utility",
  "source": "https://rsync.samba.org/",
  "checks": [
    {
      "type": "binary",
      "name": "rrsync"
    }
  ],
  "install_guidance": {
    "plugin": "rrsync",
    "binary": "rrsync",
    "check": "which rrsync",
    "install_steps": [
      "# Install rrsync:",
      "# apt: sudo apt-get install rrsync",
      "# brew: brew install rrsync",
      "# cargo: cargo install rrsync",
      "# npm: npm install -g rrsync",
      "# pip: pip install rrsync",
      "# or download from /usr/bin/rrsync"
    ]
  },
  "commands": [
    {
      "namespace": "rrsync",
      "resource": "rrsync",
      "action": "run",
      "description": "Run rrsync",
      "adapter": "process",
      "adapterConfig": {
        "command": "rrsync",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rrsync from /usr/bin/rrsync"
      },
      "args": []
    }
  ]
}
