{
  "name": "gpg-error-config",
  "version": "0.1.0",
  "description": "CLI tool: gpg-error-config",
  "source": "https://manpages.debian.org/gpg-error-config",
  "checks": [
    {
      "type": "binary",
      "name": "gpg-error-config"
    }
  ],
  "install_guidance": {
    "plugin": "gpg-error-config",
    "binary": "gpg-error-config",
    "check": "which gpg-error-config",
    "install_steps": [
      "apt-get install gpg-error-config 2>/dev/null || which gpg-error-config",
      "Verify: gpg-error-config --version",
      "supercli plugins install ./plugins/gpg-error-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gpg-error-config",
      "resource": "self",
      "action": "version",
      "description": "Print gpg-error-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpg-error-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gpg-error-config: apt-get install gpg-error-config 2>/dev/null || which gpg-error-config"
      },
      "args": []
    },
    {
      "namespace": "gpg-error-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpg-error-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpg-error-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gpg-error-config: apt-get install gpg-error-config 2>/dev/null || which gpg-error-config"
      },
      "args": []
    }
  ]
}