{
  "plugin": "iptables-restore-translate",
  "binary": "iptables-restore-translate",
  "check": "which iptables-restore-translate",
  "install_steps": [
    "apt-get install iptables-restore-translate 2>/dev/null || which iptables-restore-translate",
    "Verify: iptables-restore-translate --version",
    "supercli plugins install ./plugins/iptables-restore-translate --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}