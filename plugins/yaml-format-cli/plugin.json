{
  "name": "yaml-format-cli",
  "version": "0.1.0",
  "description": "A YAML formatting and linting CLI tool. Pretty-prints, validates, and standardizes YAML documents with configurable indentation and style options.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "yaml-format-cli"
    }
  ],
  "install_guidance": {
    "plugin": "yaml-format-cli",
    "binary": "yaml-format-cli",
    "check": "which yaml-format-cli",
    "install_steps": [
      "cargo install yaml-format-cli",
      "Verify: yaml-format-cli --version",
      "supercli plugins install ./plugins/yaml-format-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yaml-format-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yaml-format-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yaml-format-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install yaml-format-cli: cargo install yaml-format-cli"
      },
      "args": []
    }
  ]
}
