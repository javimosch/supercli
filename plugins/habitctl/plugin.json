{
  "name": "habitctl",
  "version": "0.1.0",
  "description": "Minimalist command line tool you can use to track and examine your habits.",
  "source": "https://github.com/blinry/habitctl",
  "checks": [
    {
      "type": "binary",
      "name": "habitctl"
    }
  ],
  "install_guidance": {
    "plugin": "habitctl",
    "binary": "habitctl",
    "check": "which habitctl",
    "install_steps": [
      "See https://github.com/blinry/habitctl",
      "Verify: habitctl --version",
      "supercli plugins install ./plugins/habitctl --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "habitctl",
      "resource": "self",
      "action": "version",
      "description": "Print habitctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "habitctl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install habitctl: See https://github.com/blinry/habitctl"
      },
      "args": []
    },
    {
      "namespace": "habitctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to habitctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "habitctl",
        "passthrough": true,
        "missingDependencyHelp": "Install habitctl"
      },
      "args": []
    }
  ]
}