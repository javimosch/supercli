{
  "name": "gnutls-cli",
  "version": "1.0.0",
  "description": "gnutls-cli \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=gnutls-cli+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "gnutls-cli"
    }
  ],
  "install_guidance": {
    "plugin": "gnutls-cli",
    "binary": "gnutls-cli",
    "check": "which gnutls-cli",
    "install_steps": [
      "Install gnutls-cli via package manager: apt install gnutls-cli or brew install gnutls-cli"
    ]
  },
  "commands": [
    {
      "namespace": "gnutlscli",
      "resource": "run",
      "action": "exec",
      "description": "gnutls-cli \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnutls-cli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gnutls-cli via your package manager"
      },
      "args": []
    }
  ]
}