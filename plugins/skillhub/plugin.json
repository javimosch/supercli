{
  "name": "skillhub",
  "version": "0.1.0",
  "description": "Self-hosted, open-source agent skill registry for enterprises. Publish & version skill packages, gov",
  "source": "https://github.com/skillhub/skillhub",
  "checks": [
    {
      "type": "binary",
      "name": "skillhub"
    }
  ],
  "install_guidance": {
    "plugin": "skillhub",
    "binary": "skillhub",
    "check": "which skillhub",
    "install_steps": [
      "pip install skillhub",
      "Verify: skillhub --version",
      "supercli plugins install ./plugins/skillhub --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "skillhub",
      "resource": "self",
      "action": "version",
      "description": "Print skillhub version",
      "adapter": "process",
      "adapterConfig": {
        "command": "skillhub",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install skillhub: pip install skillhub"
      },
      "args": []
    },
    {
      "namespace": "skillhub",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to skillhub CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "skillhub",
        "passthrough": true,
        "missingDependencyHelp": "Install skillhub: pip install skillhub"
      },
      "args": []
    }
  ]
}