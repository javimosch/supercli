{
  "name": "dfconf",
  "version": "0.1.0",
  "description": "CLI tool: dfconf",
  "source": "https://packages.debian.org/dfconf",
  "checks": [{ "type": "binary", "name": "dfconf" }],
  "install_guidance": {
    "plugin": "dfconf", "binary": "dfconf", "check": "which dfconf",
    "install_steps": ["apt-get install dfconf 2>/dev/null || which dfconf", "Verify: dfconf --version", "supercli plugins install ./plugins/dfconf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dfconf", "resource": "_", "action": "_",
    "description": "Passthrough to dfconf CLI",
    "adapter": "process", "adapterConfig": { "command": "dfconf", "passthrough": true, "missingDependencyHelp": "Install dfconf: apt-get install dfconf" }, "args": []
  }]
}
