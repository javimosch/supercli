{
  "name": "ciphers",
  "version": "0.1.0",
  "description": "CLI tool: ciphers",
  "source": "https://packages.debian.org/ciphers",
  "checks": [{ "type": "binary", "name": "ciphers" }],
  "install_guidance": {
    "plugin": "ciphers", "binary": "ciphers", "check": "which ciphers",
    "install_steps": ["apt-get install ciphers 2>/dev/null || which ciphers", "Verify: ciphers --version", "supercli plugins install ./plugins/ciphers --on-conflict replace --json"]
