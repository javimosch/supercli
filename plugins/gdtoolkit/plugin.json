{
  "name": "gdtoolkit",
  "version": "0.1.0",
  "description": "Independent set of GDScript tools - parser, linter, formatter, and more",
  "source": "https://github.com/Scony/godot-gdscript-toolkit",
  "checks": [
    {
      "type": "binary",
      "name": "gdtoolkit"
    }
  ],
  "install_guidance": {
    "plugin": "gdtoolkit",
    "binary": "gdtoolkit",
    "check": "which gdtoolkit",
    "install_steps": [
      "brew install gdtoolkit",
      "Verify: gdtoolkit --version",
      "supercli plugins install ./plugins/gdtoolkit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gdtoolkit",
      "resource": "self",
      "action": "version",
      "description": "Print gdtoolkit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdtoolkit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdtoolkit: brew install gdtoolkit"
      },
      "args": []
    },
    {
      "namespace": "gdtoolkit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdtoolkit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdtoolkit",
        "passthrough": true,
        "missingDependencyHelp": "Install gdtoolkit"
      },
      "args": []
    }
  ]
}