{
  "name": "diffstat",
  "version": "0.1.0",
  "description": "diffstat — generate histogram statistics from diff output. Reads patch/diff data and produces a bar chart showing number of changed lines per file, additions, deletions, and modified line counts. Useful for understanding diff impact at a glance.",
  "source": "https://github.com/ThomasDickey/diffstat-snapshots",
  "checks": [
    {
      "type": "binary",
      "name": "diffstat"
    }
  ],
  "install_guidance": {
    "plugin": "diffstat",
    "binary": "diffstat",
    "check": "which diffstat",
    "install_steps": [
      "brew install diffstat",
      "Verify: diffstat --version",
      "supercli plugins install ./plugins/diffstat --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "diffstat",
      "resource": "self",
      "action": "version",
      "description": "Print diffstat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffstat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install diffstat: brew install diffstat"
      },
      "args": []
    },
    {
      "namespace": "diffstat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to diffstat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffstat",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install diffstat: brew install diffstat"
      },
      "args": []
    }
  ]
}
