{
  "name": "tshark",
  "version": "0.1.0",
  "description": "tshark — terminal-based network packet analyzer (Wireshark CLI). Capture, filter, and analyze network traffic with JSON output via -T json.",
  "source": "https://www.wireshark.org/docs/man-pages/tshark.html",
  "checks": [{"type": "binary", "name": "tshark"}],
  "install_guidance": {
    "plugin": "tshark",
    "binary": "tshark",
    "check": "which tshark",
    "install_steps": [
      "brew install wireshark",
      "Verify: tshark --version",
      "supercli plugins install ./plugins/tshark --on-conflict replace --json"
    ],
    "note": "tshark comes with Wireshark. Use -T json for structured output."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "tshark",
      "resource": "capture",
      "action": "list-interfaces",
      "description": "List available network interfaces for capture",
      "adapter": "process",
      "adapterConfig": {
        "command": "tshark",
        "baseArgs": ["-D"],
        "timeout_ms": 10000,
        "missingDependencyHelp": "Install tshark: brew install wireshark"
      },
      "args": []
    },
    {
      "namespace": "tshark",
      "resource": "capture",
      "action": "live",
      "description": "Capture live packets (use timeout or count to limit)",
      "adapter": "process",
      "adapterConfig": {
        "command": "tshark",
        "baseArgs": ["-T", "json"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tshark: brew install wireshark"
      },
      "args": [
        {"name": "-i", "type": "string", "required": false, "description": "Network interface to capture"},
        {"name": "-c", "type": "number", "required": false, "description": "Stop after capturing N packets"},
        {"name": "-a", "type": "string", "required": false, "description": "Autostop condition (e.g., duration:10)"}
      ]
    },
    {
      "namespace": "tshark",
      "resource": "read",
      "action": "file",
      "description": "Read and analyze a packet capture file with JSON output",
      "adapter": "process",
      "adapterConfig": {
        "command": "tshark",
        "baseArgs": ["-T", "json", "-r"],
        "positionalArgs": ["file"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install tshark: brew install wireshark"
      },
      "args": [
        {"name": "file", "type": "string", "required": true, "description": "Path to pcap/pcapng file"},
        {"name": "-Y", "type": "string", "required": false, "description": "Display filter expression"}
      ]
    },
    {
      "namespace": "tshark",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tshark CLI for any command",
      "adapter": "process",
      "adapterConfig": {
        "command": "tshark",
        "passthrough": true,
        "missingDependencyHelp": "Install tshark: brew install wireshark"
      },
      "args": []
    }
  ]
}
