{
  "name": "toip",
  "version": "0.1.0",
  "description": "Text over IP — send text messages via network protocols with JSON logging",
  "source": "https://github.com/toip/toip",
  "checks": [
    {
      "type": "binary",
      "name": "toip"
    }
  ],
  "install_guidance": {
    "plugin": "toip",
    "binary": "toip",
    "check": "which toip",
    "install_steps": [
      "cargo install toip",
      "Verify: toip --version",
      "supercli plugins install ./plugins/toip --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "toip",
      "resource": "self",
      "action": "version",
      "description": "Print toip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "toip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install toip: cargo install toip"
      },
      "args": []
    },
    {
      "namespace": "toip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to toip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "toip",
        "passthrough": true,
        "missingDependencyHelp": "Install toip: cargo install toip"
      },
      "args": []
    }
  ]
}
