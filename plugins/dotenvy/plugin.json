{
  "name": "dotenvy",
  "version": "0.1.0",
  "description": "Fast dotenv file parser and validator",
  "source": "https://github.com/allan2/dotenvy",
  "checks": [{ "type": "binary", "name": "dotenvy" }],
  "install_guidance": {
    "plugin": "dotenvy",
    "binary": "dotenvy",
    "check": "which dotenvy",
    "install_steps": ["cargo install dotenvy", "Verify: dotenvy --version", "supercli plugins install ./plugins/dotenvy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dotenvy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dotenvy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dotenvy",
      "passthrough": true,
      "missingDependencyHelp": "Install dotenvy: cargo install dotenvy", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
