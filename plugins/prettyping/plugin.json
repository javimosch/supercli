{
  "name": "prettyping",
  "version": "1.0.0",
  "description": "prettyping \u2014 ping with colors",
  "source": "github.com/denilsonsa/prettyping",
  "checks": [
    {
      "type": "binary",
      "name": "prettyping"
    }
  ],
  "install_guidance": {
    "plugin": "prettyping",
    "binary": "prettyping",
    "check": "which prettyping",
    "install_steps": [
      "# Install prettyping:",
      "# apt: sudo apt-get install prettyping",
      "# brew: brew install prettyping",
      "# cargo: cargo install prettyping",
      "# npm: npm install -g prettyping",
      "# pip: pip install prettyping",
      "# or download from github.com/denilsonsa/prettyping"
    ]
  },
  "commands": [
    {
      "namespace": "prettyping",
      "resource": "prettyping",
      "action": "run",
      "description": "Run prettyping",
      "adapter": "process",
      "adapterConfig": {
        "command": "prettyping",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install prettyping from github.com/denilsonsa/prettyping"
      },
      "args": []
    }
  ]
}