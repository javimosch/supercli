{
  "name": "gts2dxf",
  "version": "0.1.0",
  "description": "CLI tool: gts2dxf",
  "source": "https://manpages.debian.org/gts2dxf",
  "checks": [
    {
      "type": "binary",
      "name": "gts2dxf"
    }
  ],
  "install_guidance": {
    "plugin": "gts2dxf",
    "binary": "gts2dxf",
    "check": "which gts2dxf",
    "install_steps": [
      "apt-get install gts2dxf 2>/dev/null || which gts2dxf",
      "Verify: gts2dxf --version",
      "supercli plugins install ./plugins/gts2dxf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gts2dxf",
      "resource": "self",
      "action": "version",
      "description": "Print gts2dxf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gts2dxf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gts2dxf: apt-get install gts2dxf 2>/dev/null || which gts2dxf"
      },
      "args": []
    },
    {
      "namespace": "gts2dxf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gts2dxf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gts2dxf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gts2dxf: apt-get install gts2dxf 2>/dev/null || which gts2dxf"
      },
      "args": []
    }
  ]
}