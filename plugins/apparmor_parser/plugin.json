{
  "name": "apparmor_parser",
  "version": "0.1.0",
  "description": "CLI tool: apparmor_parser",
  "source": "https://packages.debian.org/apparmor_parser",
  "checks": [{ "type": "binary", "name": "apparmor_parser" }],
  "install_guidance": {
    "plugin": "apparmor_parser", "binary": "apparmor_parser", "check": "which apparmor_parser",
    "install_steps": ["apt-get install apparmor_parser 2>/dev/null || which apparmor_parser", "Verify: apparmor_parser --version", "supercli plugins install ./plugins/apparmor_parser --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apparmor_parser", "resource": "_", "action": "_",
    "description": "Passthrough to apparmor_parser CLI",
    "adapter": "process", "adapterConfig": { "command": "apparmor_parser", "passthrough": true, "missingDependencyHelp": "Install apparmor_parser: apt-get install apparmor_parser" }, "args": []
  }]
}
