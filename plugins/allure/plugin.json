{
  "name": "allure",
  "version": "0.1.0",
  "description": "Flexible lightweight test report tool",
  "checks": [
    {
      "type": "binary",
      "name": "allure"
    }
  ],
  "install_guidance": {
    "plugin": "allure",
    "binary": "allure",
    "check": "which allure",
    "install_steps": [
      "brew install allure",
      "Verify: allure --version",
      "supercli plugins install ./plugins/allure --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "allure",
      "resource": "self",
      "action": "version",
      "description": "Print allure version",
      "adapter": "process",
      "adapterConfig": {
        "command": "allure",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install allure: brew install allure"
      },
      "args": []
    },
    {
      "namespace": "allure",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to allure CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "allure",
        "passthrough": true,
        "missingDependencyHelp": "Install allure"
      },
      "args": []
    }
  ]
}