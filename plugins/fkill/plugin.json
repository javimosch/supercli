{
  "name": "fkill",
  "description": "Fabulously kill processes. Cross-platform process killer with interactive UI.",
  "version": "1.0.0",
  "binary": "fkill",
  "check": "fkill --version",
  "install": {
    "method": "npm",
    "command": "npm install --global fkill-cli"
  },
  "commands": {
    "kill": {
      "command": "fkill {{process}}",
      "description": "Kill process by name, PID, or port",
      "args": ["process"]
    },
    "interactive": {
      "command": "fkill",
      "description": "Launch interactive process killer UI",
      "args": []
    },
    "force": {
      "command": "fkill --force {{process}}",
      "description": "Force kill a process",
      "args": ["process"]
    },
    "port": {
      "command": "fkill :{{port}}",
      "description": "Kill process by port number",
      "args": ["port"]
    }
  }
}
