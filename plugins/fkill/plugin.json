{
  "name": "fkill",
  "version": "1.0.0",
  "description": "Fabulously kill processes. Cross-platform process killer with interactive UI.",
  "source": "https://github.com/sindresorhus/fkill-cli",
  "checks": [
    {
      "type": "binary",
      "name": "fkill"
    }
  ],
  "install_guidance": {
    "plugin": "fkill",
    "binary": "fkill",
    "check": "fkill --version",
    "install_steps": [
      "npm install --global fkill-cli"
    ],
    "note": "Requires Node.js. Works on macOS, Linux, and Windows."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fkill",
      "resource": "process",
      "action": "kill",
      "description": "Kill process by name, PID, or port",
      "adapter": "process",
      "adapterConfig": {
        "command": "fkill",
        "positionalArgs": [
          "process"
        ],
        "missingDependencyHelp": "Install fkill: npm install --global fkill-cli"
      },
      "args": [
        {
          "name": "process",
          "type": "string",
          "required": true,
          "description": "Process name, PID, or :port",
          "positional": true
        }
      ]
    },
    {
      "namespace": "fkill",
      "resource": "process",
      "action": "interactive",
      "description": "Launch interactive process killer UI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fkill",
        "missingDependencyHelp": "Install fkill: npm install --global fkill-cli"
      },
      "args": []
    },
    {
      "namespace": "fkill",
      "resource": "process",
      "action": "kill-force",
      "description": "Force kill a process",
      "adapter": "process",
      "adapterConfig": {
        "command": "fkill",
        "baseArgs": [
          "--force"
        ],
        "positionalArgs": [
          "process"
        ],
        "missingDependencyHelp": "Install fkill: npm install --global fkill-cli"
      },
      "args": [
        {
          "name": "process",
          "type": "string",
          "required": true,
          "description": "Process name or PID",
          "positional": true
        }
      ]
    },
    {
      "namespace": "fkill",
      "resource": "process",
      "action": "kill-port",
      "description": "Kill process by port number",
      "adapter": "shell",
      "adapterConfig": {
        "script": "fkill \":{{port}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "port",
          "type": "string",
          "required": true,
          "description": "Port number (e.g. 8080)"
        }
      ]
    },
    {
      "namespace": "fkill",
      "resource": "self",
      "action": "version",
      "description": "Print fkill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fkill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fkill: npm install --global fkill-cli"
      },
      "args": []
    },
    {
      "namespace": "fkill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fkill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fkill",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fkill: npm install --global fkill-cli"
      },
      "args": []
    }
  ]
}
