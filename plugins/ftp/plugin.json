{
  "name": "ftp",
  "version": "1.0.0",
  "description": "ftp \u2014 ftp \u2014 CLI utility",
  "source": "/usr/bin/ftp",
  "checks": [
    {
      "type": "binary",
      "name": "ftp"
    }
  ],
  "install_guidance": {
    "plugin": "ftp",
    "binary": "ftp",
    "check": "which ftp",
    "install_steps": [
      "# Install ftp:",
      "# apt: sudo apt-get install ftp",
      "# brew: brew install ftp",
      "# cargo: cargo install ftp",
      "# npm: npm install -g ftp",
      "# pip: pip install ftp",
      "# or download from /usr/bin/ftp"
    ]
  },
  "commands": [
    {
      "namespace": "ftp",
      "resource": "ftp",
      "action": "run",
      "description": "Run ftp",
      "adapter": "process",
      "adapterConfig": {
        "command": "ftp",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ftp from /usr/bin/ftp"
      },
      "args": []
    }
  ]
}