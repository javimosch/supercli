{
  "name": "file-type-cli",
  "version": "0.1.0",
  "description": "Detect the file type of a file or stdin",
  "source": "https://github.com/sindresorhus/file-type-cli",
  "checks": [
    {
      "type": "binary",
      "name": "file-type-cli"
    }
  ],
  "install_guidance": {
    "plugin": "file-type-cli",
    "binary": "file-type-cli",
    "check": "which file-type-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/file-type-cli",
      "Verify: file-type-cli --version",
      "supercli plugins install ./plugins/file-type-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "file-type-cli",
      "resource": "self",
      "action": "version",
      "description": "Print file-type-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "file-type-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install file-type-cli: See https://github.com/sindresorhus/file-type-cli"
      },
      "args": []
    },
    {
      "namespace": "file-type-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to file-type-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "file-type-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install file-type-cli"
      },
      "args": []
    }
  ]
}