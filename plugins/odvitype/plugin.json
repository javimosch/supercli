{
  "name": "odvitype",
  "version": "0.1.0",
  "description": "CLI tool: odvitype",
  "source": "https://manpages.debian.org/odvitype",
  "checks": [
    {
      "type": "binary",
      "name": "odvitype"
    }
  ],
  "install_guidance": {
    "plugin": "odvitype",
    "binary": "odvitype",
    "check": "which odvitype",
    "install_steps": [
      "apt-get install odvitype 2>/dev/null || which odvitype",
      "Verify: odvitype --version",
      "supercli plugins install ./plugins/odvitype --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "odvitype",
      "resource": "self",
      "action": "version",
      "description": "Print odvitype version",
      "adapter": "process",
      "adapterConfig": {
        "command": "odvitype",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install odvitype: apt-get install odvitype 2>/dev/null || which odvitype"
      },
      "args": []
    },
    {
      "namespace": "odvitype",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to odvitype CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "odvitype",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install odvitype: apt-get install odvitype 2>/dev/null || which odvitype"
      },
      "args": []
    }
  ]
}