{
  "name": "djview",
  "version": "0.1.0",
  "description": "Transition package, djview3 to djview4",
  "source": "https://packages.debian.org/djview",
  "checks": [{ "type": "binary", "name": "djview" }],
  "install_guidance": {
    "plugin": "djview", "binary": "djview", "check": "which djview",
    "install_steps": ["apt-get install djview 2>/dev/null || which djview", "Verify: djview --version", "supercli plugins install ./plugins/djview --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "djview", "resource": "_", "action": "_",
    "description": "Passthrough to djview CLI",
    "adapter": "process", "adapterConfig": { "command": "djview", "passthrough": true, "missingDependencyHelp": "Install djview: apt-get install djview" }, "args": []
  }]
}
