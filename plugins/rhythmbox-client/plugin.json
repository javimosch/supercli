{
  "name": "rhythmbox-client",
  "version": "0.1.0",
  "description": "CLI tool: rhythmbox-client",
  "source": "https://manpages.debian.org/rhythmbox-client",
  "checks": [
    {
      "type": "binary",
      "name": "rhythmbox-client"
    }
  ],
  "install_guidance": {
    "plugin": "rhythmbox-client",
    "binary": "rhythmbox-client",
    "check": "which rhythmbox-client",
    "install_steps": [
      "apt-get install rhythmbox-client 2>/dev/null || which rhythmbox-client",
      "Verify: rhythmbox-client --version",
      "supercli plugins install ./plugins/rhythmbox-client --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rhythmbox-client",
      "resource": "self",
      "action": "version",
      "description": "Print rhythmbox-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rhythmbox-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rhythmbox-client: apt-get install rhythmbox-client 2>/dev/null || which rhythmbox-client"
      },
      "args": []
    },
    {
      "namespace": "rhythmbox-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rhythmbox-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rhythmbox-client",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rhythmbox-client: apt-get install rhythmbox-client 2>/dev/null || which rhythmbox-client"
      },
      "args": []
    }
  ]
}