{
  "name": "td-cli",
  "version": "0.1.0",
  "description": "A TODO manager to organize and manage your TODO's across multiple projects",
  "source": "https://github.com/darrikonn/td-cli",
  "checks": [
    {
      "type": "binary",
      "name": "td-cli"
    }
  ],
  "install_guidance": {
    "plugin": "td-cli",
    "binary": "td-cli",
    "check": "which td-cli",
    "install_steps": [
      "See https://github.com/darrikonn/td-cli",
      "Verify: td-cli --version",
      "supercli plugins install ./plugins/td-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "td-cli",
      "resource": "self",
      "action": "version",
      "description": "Print td-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "td-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install td-cli: See https://github.com/darrikonn/td-cli"
      },
      "args": []
    },
    {
      "namespace": "td-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to td-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "td-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install td-cli"
      },
      "args": []
    }
  ]
}