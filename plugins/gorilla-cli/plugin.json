{
  "name": "gorilla-cli",
  "version": "0.1.0",
  "description": "LLM-powered CLI for generating commands",
  "source": "https://github.com/gorilla-llm/gorilla-cli",
  "checks": [{ "type": "binary", "name": "gorilla-cli" }],
  "install_guidance": {
    "plugin": "gorilla-cli",
    "binary": "gorilla-cli",
    "check": "which gorilla-cli",
    "install_steps": ["pip install gorilla-cli", "Verify: gorilla-cli --version", "supercli plugins install ./plugins/gorilla-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gorilla-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gorilla-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gorilla-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install gorilla-cli: pip install gorilla-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
