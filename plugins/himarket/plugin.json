{
  "name": "himarket",
  "version": "0.1.0",
  "description": "HiMarket is an enterprise-level \"AI Capability Marketplace and Developer Ecosystem Hub.\" It is not m",
  "source": "https://github.com/himarket/himarket",
  "checks": [
    {
      "type": "binary",
      "name": "himarket"
    }
  ],
  "install_guidance": {
    "plugin": "himarket",
    "binary": "himarket",
    "check": "which himarket",
    "install_steps": [
      "pip install himarket",
      "Verify: himarket --version",
      "supercli plugins install ./plugins/himarket --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "himarket",
      "resource": "self",
      "action": "version",
      "description": "Print himarket version",
      "adapter": "process",
      "adapterConfig": {
        "command": "himarket",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install himarket: pip install himarket"
      },
      "args": []
    },
    {
      "namespace": "himarket",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to himarket CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "himarket",
        "passthrough": true,
        "missingDependencyHelp": "Install himarket: pip install himarket"
      },
      "args": []
    }
  ]
}