{
  "name": "comic-tools",
  "version": "0.1.0",
  "description": "Suite for CBR-to-CBZ conversion format validation and JPEG upscaling",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "comic-tools" }],
  "install_guidance": {
    "plugin": "comic-tools",
    "binary": "comic-tools",
    "check": "which comic-tools",
    "install_steps": ["git clone && bash comic-tools.sh", "Verify: comic-tools --version", "supercli plugins install ./plugins/comic-tools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "comic-tools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to comic-tools CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "comic-tools",
      "passthrough": true,
      "missingDependencyHelp": "Install comic-tools: git clone && bash comic-tools.sh"
    },
    "args": []
  }]
}
