{
  "name": "mdtable",
  "version": "0.1.0",
  "description": "Generate and format Markdown tables from CLI input",
  "source": "https://github.com/v1h/mdtable",
  "checks": [{ "type": "binary", "name": "mdtable" }],
  "install_guidance": {
    "plugin": "mdtable",
    "binary": "mdtable",
    "check": "which mdtable",
    "install_steps": ["pip install mdtable", "Verify: mdtable --version", "supercli plugins install ./plugins/mdtable --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdtable",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdtable CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdtable",
      "passthrough": true,
      "missingDependencyHelp": "Install mdtable: pip install mdtable", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
