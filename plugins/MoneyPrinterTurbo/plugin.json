{
  "name": "MoneyPrinterTurbo",
  "version": "0.1.0",
  "description": "\u5229\u7528AI\u5927\u6a21\u578b\uff0c\u4e00\u952e\u751f\u6210\u9ad8\u6e05\u77ed\u89c6\u9891 Generate short videos with one click using AI LLM.",
  "source": "https://github.com/MoneyPrinterTurbo/MoneyPrinterTurbo",
  "checks": [
    {
      "type": "binary",
      "name": "moneyprinterturbo"
    }
  ],
  "install_guidance": {
    "plugin": "MoneyPrinterTurbo",
    "binary": "moneyprinterturbo",
    "check": "which moneyprinterturbo",
    "install_steps": [
      "pip install moneyprinterturbo",
      "Verify: moneyprinterturbo --version",
      "supercli plugins install ./plugins/MoneyPrinterTurbo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MoneyPrinterTurbo",
      "resource": "self",
      "action": "version",
      "description": "Print MoneyPrinterTurbo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "moneyprinterturbo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MoneyPrinterTurbo: pip install moneyprinterturbo"
      },
      "args": []
    },
    {
      "namespace": "MoneyPrinterTurbo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to moneyprinterturbo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "moneyprinterturbo",
        "passthrough": true,
        "missingDependencyHelp": "Install MoneyPrinterTurbo: pip install moneyprinterturbo"
      },
      "args": []
    }
  ]
}