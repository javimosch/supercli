{
  "name": "gitlab-cli",
  "version": "0.1.0",
  "description": "Create GitLab merge requests",
  "source": "https://github.com/vishwanatharondekar/gitlab-cli",
  "checks": [
    {
      "type": "binary",
      "name": "gitlab-cli"
    }
  ],
  "install_guidance": {
    "plugin": "gitlab-cli",
    "binary": "gitlab-cli",
    "check": "which gitlab-cli",
    "install_steps": [
      "See https://github.com/vishwanatharondekar/gitlab-cli",
      "Verify: gitlab-cli --version",
      "supercli plugins install ./plugins/gitlab-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gitlab-cli",
      "resource": "self",
      "action": "version",
      "description": "Print gitlab-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitlab-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitlab-cli: See https://github.com/vishwanatharondekar/gitlab-cli"
      },
      "args": []
    },
    {
      "namespace": "gitlab-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitlab-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitlab-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install gitlab-cli"
      },
      "args": []
    }
  ]
}