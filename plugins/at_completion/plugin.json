{
  "name": "at_completion",
  "version": "0.1.0",
  "description": "CLI tool: at_completion",
  "source": "https://packages.debian.org/at_completion",
  "checks": [{ "type": "binary", "name": "at_completion" }],
  "install_guidance": {
    "plugin": "at_completion", "binary": "at_completion", "check": "which at_completion",
    "install_steps": ["apt-get install at_completion 2>/dev/null || which at_completion", "Verify: at_completion --version", "supercli plugins install ./plugins/at_completion --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_completion", "resource": "_", "action": "_",
    "description": "Passthrough to at_completion CLI",
    "adapter": "process", "adapterConfig": { "command": "at_completion", "passthrough": true, "missingDependencyHelp": "Install at_completion: apt-get install at_completion" }, "args": []
  }]
}
