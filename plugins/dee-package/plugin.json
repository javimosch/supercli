{
  "name": "dee-package",
  "version": "0.1.0",
  "description": "Look up package metadata from registries with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-package" }],
  "install_guidance": {
    "plugin": "dee-package",
    "binary": "dee-package",
    "check": "which dee-package",
    "install_steps": ["cargo install dee-package", "Verify: dee-package --version", "supercli plugins install ./plugins/dee-package --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-package",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-package CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-package",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-package: cargo install dee-package"
    },
    "args": []
  }]
}
