{
  "name": "NCDu",
  "version": "0.1.0",
  "description": "A disk usage analyzer with an ncurses interface",
  "checks": [
    {
      "type": "binary",
      "name": "NCDu"
    }
  ],
  "install_guidance": {
    "plugin": "NCDu",
    "binary": "NCDu",
    "check": "which NCDu",
    "install_steps": [
      "brew install NCDu",
      "Verify: NCDu --version",
      "supercli plugins install ./plugins/NCDu --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "NCDu",
      "resource": "self",
      "action": "version",
      "description": "Print NCDu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "NCDu",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NCDu: brew install NCDu"
      },
      "args": []
    },
    {
      "namespace": "NCDu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to NCDu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "NCDu",
        "passthrough": true,
        "missingDependencyHelp": "Install NCDu"
      },
      "args": []
    }
  ]
}