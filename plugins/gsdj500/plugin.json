{
  "name": "gsdj500",
  "version": "0.1.0",
  "description": "CLI tool: gsdj500",
  "source": "https://manpages.debian.org/gsdj500",
  "checks": [
    {
      "type": "binary",
      "name": "gsdj500"
    }
  ],
  "install_guidance": {
    "plugin": "gsdj500",
    "binary": "gsdj500",
    "check": "which gsdj500",
    "install_steps": [
      "apt-get install gsdj500 2>/dev/null || which gsdj500",
      "Verify: gsdj500 --version",
      "supercli plugins install ./plugins/gsdj500 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gsdj500",
      "resource": "self",
      "action": "version",
      "description": "Print gsdj500 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gsdj500",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gsdj500: apt-get install gsdj500 2>/dev/null || which gsdj500"
      },
      "args": []
    },
    {
      "namespace": "gsdj500",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gsdj500 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gsdj500",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gsdj500: apt-get install gsdj500 2>/dev/null || which gsdj500"
      },
      "args": []
    }
  ]
}