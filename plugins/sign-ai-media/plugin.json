{
  "name": "sign-ai-media",
  "version": "0.1.0",
  "description": "Sign and verify C2PA AI metadata on media files",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "sign-ai-media" }],
  "install_guidance": {
