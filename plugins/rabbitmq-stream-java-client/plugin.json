{
  "name": "rabbitmq-stream-java-client",
  "version": "0.1.0",
  "description": "RabbitMQ Stream Java Client",
  "source": "https://rabbitmq.github.io/rabbitmq-stream-java-client/stable/htmlsingle/",
  "checks": [
    {
      "type": "binary",
      "name": "rabbitmq-stream-java-client"
    }
  ],
  "install_guidance": {
    "plugin": "rabbitmq-stream-java-client",
    "binary": "rabbitmq-stream-java-client",
    "check": "which rabbitmq-stream-java-client",
    "install_steps": [
      "Check https://rabbitmq.github.io/rabbitmq-stream-java-client/stable/htmlsingle/ for installation instructions",
      "Verify: rabbitmq-stream-java-client --version",
      "supercli plugins install ./plugins/rabbitmq-stream-java-client --on-conflict replace --json"
    ],
    "note": "Java language CLI tool"
  },
  "commands": [
    {
      "namespace": "rabbitmq-stream-java-client",
      "resource": "self",
      "action": "version",
      "description": "Print rabbitmq-stream-java-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rabbitmq-stream-java-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rabbitmq-stream-java-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "rabbitmq-stream-java-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rabbitmq-stream-java-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rabbitmq-stream-java-client",
        "passthrough": true,
        "missingDependencyHelp": "Install rabbitmq-stream-java-client from project repository"
      },
      "args": []
    }
  ]
}