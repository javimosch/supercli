{
  "name": "turborepo",
  "version": "0.1.0",
  "description": "High-performance build system for monorepos",
  "source": "https://github.com/vercel/turborepo",
  "checks": [{ "type": "binary", "name": "turborepo" }],
  "install_guidance": {
    "plugin": "turborepo",
    "binary": "turborepo",
    "check": "which turborepo",
    "install_steps": ["npm install -g turbo", "Verify: turborepo --version", "supercli plugins install ./plugins/turborepo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "turborepo",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to turborepo CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "turborepo",
      "passthrough": true,
      "missingDependencyHelp": "Install turborepo: npm install -g turbo", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
