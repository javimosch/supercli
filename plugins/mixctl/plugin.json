{
  "name": "mixctl",
  "version": "0.1.0",
  "description": "Fine-grained mixer channel control from the command line",
  "source": "https://github.com/stefan/mixctl",
  "checks": [{ "type": "binary", "name": "mixctl" }],
  "install_guidance": {
    "plugin": "mixctl",
    "binary": "mixctl",
    "check": "which mixctl",
    "install_steps": ["git clone and install", "Verify: mixctl --version", "supercli plugins install ./plugins/mixctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mixctl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mixctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mixctl",
      "passthrough": true,
      "missingDependencyHelp": "Install mixctl: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
