{
  "name": "desed",
  "version": "0.1.0",
  "description": "Debugger for sed scripts with step-by-step execution and visualization",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "desed" }],
  "install_guidance": {
    "plugin": "desed",
    "binary": "desed",
    "check": "which desed",
    "install_steps": ["cargo install desed", "Verify: desed --version", "supercli plugins install ./plugins/desed --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "desed",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to desed CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "desed",
      "passthrough": true,
      "missingDependencyHelp": "Install desed: cargo install desed"
    },
    "args": []
  }]
}
