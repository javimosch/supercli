{
  "name": "curlylint",
  "version": "0.1.0",
  "description": "Experimental HTML templates linting for Jinja/Nunjucks",
  "source": "https://github.com/thibaudcolas/curlylint",
  "checks": [{ "type": "binary", "name": "curlylint" }],
  "install_guidance": {
    "plugin": "curlylint",
    "binary": "curlylint",
    "check": "which curlylint",
    "install_steps": ["pip install curlylint", "Verify: curlylint --version", "supercli plugins install ./plugins/curlylint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "curlylint",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to curlylint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "curlylint",
      "passthrough": true,
      "missingDependencyHelp": "Install curlylint: pip install curlylint", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
