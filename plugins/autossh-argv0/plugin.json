{
  "name": "autossh-argv0",
  "version": "0.1.0",
  "description": "CLI tool: autossh-argv0",
  "source": "https://packages.debian.org/autossh-argv0",
  "checks": [{ "type": "binary", "name": "autossh-argv0" }],
  "install_guidance": {
    "plugin": "autossh-argv0", "binary": "autossh-argv0", "check": "which autossh-argv0",
    "install_steps": ["apt-get install autossh-argv0 2>/dev/null || which autossh-argv0", "Verify: autossh-argv0 --version", "supercli plugins install ./plugins/autossh-argv0 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "autossh-argv0", "resource": "_", "action": "_",
    "description": "Passthrough to autossh-argv0 CLI",
    "adapter": "process", "adapterConfig": { "command": "autossh-argv0", "passthrough": true, "missingDependencyHelp": "Install autossh-argv0: apt-get install autossh-argv0" }, "args": []
  }]
}
