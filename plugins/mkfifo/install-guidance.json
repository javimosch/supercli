{
  "plugin": "mkfifo",
  "binary": "mkfifo",
  "check": "which mkfifo",
  "install_steps": [
    "# Install mkfifo",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/mkfifo-linux-amd64 -o /usr/local/bin/mkfifo",
    "chmod +x /usr/local/bin/mkfifo",
    "# Or via package manager, see /usr/bin/mkfifo"
  ]
}