{
  "name": "ship-cli",
  "version": "0.1.0",
  "description": "Manage and update third-party Kubernetes applications",
  "source": "https://github.com/replicatedhq/ship",
  "checks": [{ "type": "binary", "name": "ship" }],
  "install_guidance": {
    "plugin": "ship-cli",
    "binary": "ship",
    "check": "which ship",
    "install_steps": ["brew install ship", "Verify: ship --version", "supercli plugins install ./plugins/ship-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ship-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ship CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ship",
      "passthrough": true,
      "missingDependencyHelp": "Install ship-cli: brew install ship"
    },
    "args": []
  }]
}
