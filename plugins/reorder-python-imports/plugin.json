{
  "name": "reorder-python-imports",
  "version": "0.1.0",
  "description": "Reformat and reorder Python imports",
  "source": "https://github.com/asottile/reorder-python-imports",
  "checks": [{ "type": "binary", "name": "reorder-python-imports" }],
  "install_guidance": {
    "plugin": "reorder-python-imports",
    "binary": "reorder-python-imports",
    "check": "which reorder-python-imports",
    "install_steps": ["pip install reorder-python-imports", "Verify: reorder-python-imports --version", "supercli plugins install ./plugins/reorder-python-imports --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "reorder-python-imports",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to reorder-python-imports CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "reorder-python-imports",
      "passthrough": true,
      "missingDependencyHelp": "Install reorder-python-imports: pip install reorder-python-imports", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
