{
  "name": "pipe-exec",
  "version": "0.1.0",
  "description": "Execute stream data without temporary files",
  "source": "https://github.com/klauspost/pipe_exec",
  "checks": [{ "type": "binary", "name": "pipe-exec" }],
  "install_guidance": {
    "plugin": "pipe-exec",
    "binary": "pipe-exec",
    "check": "which pipe-exec",
    "install_steps": ["go install github.com/klauspost/pipe_exec@latest", "Verify: pipe-exec --version", "supercli plugins install ./plugins/pipe-exec --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipe-exec",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipe-exec CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipe-exec",
      "passthrough": true,
      "missingDependencyHelp": "Install pipe-exec: go install github.com/klauspost/pipe_exec@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
