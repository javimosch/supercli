{
  "name": "cron-manager",
  "version": "0.1.0",
  "description": "Centralized cron job management using JSON configuration",
  "source": "https://github.com/fly-apps/cron-manager",
  "checks": [{ "type": "binary", "name": "cron-manager" }],
  "install_guidance": {
    "plugin": "cron-manager",
    "binary": "cron-manager",
    "check": "which cron-manager",
    "install_steps": ["git clone and build", "Verify: cron-manager --version", "supercli plugins install ./plugins/cron-manager --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cron-manager",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cron-manager CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cron-manager",
      "passthrough": true,
      "missingDependencyHelp": "Install cron-manager: git clone and build", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
