{
  "plugin": "gnome-shell-extension-prefs",
  "binary": "gnome-shell-extension-prefs",
  "check": "which gnome-shell-extension-prefs",
  "install_steps": [
    "apt-get install gnome-shell-extension-prefs 2>/dev/null || which gnome-shell-extension-prefs",
    "Verify: gnome-shell-extension-prefs --version",
    "supercli plugins install ./plugins/gnome-shell-extension-prefs --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}