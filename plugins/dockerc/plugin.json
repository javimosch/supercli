{
  "name": "dockerc",
  "version": "0.1.0",
  "description": "container image to single executable compiler",
  "source": "https://github.com/dockerc/dockerc",
  "checks": [
    {
      "type": "binary",
      "name": "dockerc"
    }
  ],
  "install_guidance": {
    "plugin": "dockerc",
    "binary": "dockerc",
    "check": "which dockerc",
    "install_steps": [
      "pip install dockerc",
      "Verify: dockerc --version",
      "supercli plugins install ./plugins/dockerc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dockerc",
      "resource": "self",
      "action": "version",
      "description": "Print dockerc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockerc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dockerc: pip install dockerc"
      },
      "args": []
    },
    {
      "namespace": "dockerc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dockerc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockerc",
        "passthrough": true,
        "missingDependencyHelp": "Install dockerc: pip install dockerc"
      },
      "args": []
    }
  ]
}