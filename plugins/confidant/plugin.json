{
  "name": "confidant",
  "version": "0.1.0",
  "description": "Secret management service with KMS encryption",
  "source": "https://github.com/lyft/confidant",
  "checks": [{ "type": "binary", "name": "confidant" }],
  "install_guidance": {
    "plugin": "confidant",
    "binary": "confidant",
    "check": "which confidant",
    "install_steps": ["pip install confidant-cli", "Verify: confidant --version", "supercli plugins install ./plugins/confidant --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "confidant",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to confidant CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "confidant",
      "passthrough": true,
      "missingDependencyHelp": "Install confidant: pip install confidant-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
