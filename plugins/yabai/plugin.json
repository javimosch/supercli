{
  "name": "yabai",
  "version": "0.1.0",
  "description": "Tiling window manager for macOS with CLI control",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "yabai" }],
  "install_guidance": {
    "plugin": "yabai",
    "binary": "yabai",
    "check": "which yabai",
    "install_steps": ["brew install koekeishiya/formulae/yabai", "Verify: yabai --version", "supercli plugins install ./plugins/yabai --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yabai",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yabai CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yabai",
      "passthrough": true,
      "missingDependencyHelp": "Install yabai: brew install koekeishiya/formulae/yabai"
    },
    "args": []
  }]
}
