{
  "name": "xiaozhi-esp32-server-java",
  "version": "0.1.0",
  "description": "\u5c0f\u667aESP32\u7684Java\u4f01\u4e1a\u7ea7\u7ba1\u7406\u5e73\u53f0\uff0c\u63d0\u4f9b\u8bbe\u5907\u76d1\u63a7\u3001\u97f3\u8272\u5b9a\u5236\u3001\u89d2\u8272\u5207\u6362\u548c\u5bf9\u8bdd\u8bb0\u5f55\u7ba1\u7406\u7684\u524d\u540e\u7aef\u53ca\u670d\u52a1\u7aef\u4e00\u4f53\u5316\u89e3\u51b3\u65b9\u6848",
  "source": "https://github.com/xiaozhi-esp32-server-java/xiaozhi-esp32-server-java",
  "checks": [
    {
      "type": "binary",
      "name": "xiaozhi-esp32-server-java"
    }
  ],
  "install_guidance": {
    "plugin": "xiaozhi-esp32-server-java",
    "binary": "xiaozhi-esp32-server-java",
    "check": "which xiaozhi-esp32-server-java",
    "install_steps": [
      "pip install xiaozhi-esp32-server-java",
      "Verify: xiaozhi-esp32-server-java --version",
      "supercli plugins install ./plugins/xiaozhi-esp32-server-java --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xiaozhi-esp32-server-java",
      "resource": "self",
      "action": "version",
      "description": "Print xiaozhi-esp32-server-java version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaozhi-esp32-server-java",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xiaozhi-esp32-server-java: pip install xiaozhi-esp32-server-java"
      },
      "args": []
    },
    {
      "namespace": "xiaozhi-esp32-server-java",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xiaozhi-esp32-server-java CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaozhi-esp32-server-java",
        "passthrough": true,
        "missingDependencyHelp": "Install xiaozhi-esp32-server-java: pip install xiaozhi-esp32-server-java"
      },
      "args": []
    }
  ]
}