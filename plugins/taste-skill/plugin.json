{
  "name": "taste-skill",
  "version": "0.1.0",
  "description": "Taste-Skill - gives your AI good taste. stops the AI from generating boring, generic slop ",
  "source": "https://github.com/taste-skill/taste-skill",
  "checks": [
    {
      "type": "binary",
      "name": "taste-skill"
    }
  ],
  "install_guidance": {
    "plugin": "taste-skill",
    "binary": "taste-skill",
    "check": "which taste-skill",
    "install_steps": [
      "pip install taste-skill",
      "Verify: taste-skill --version",
      "supercli plugins install ./plugins/taste-skill --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "taste-skill",
      "resource": "self",
      "action": "version",
      "description": "Print taste-skill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "taste-skill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install taste-skill: pip install taste-skill"
      },
      "args": []
    },
    {
      "namespace": "taste-skill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to taste-skill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "taste-skill",
        "passthrough": true,
        "missingDependencyHelp": "Install taste-skill: pip install taste-skill"
      },
      "args": []
    }
  ]
}