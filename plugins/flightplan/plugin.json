{
  "name": "flightplan",
  "version": "0.1.0",
  "description": "Deploy small-scale applications via SSH with flight plans",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "flightplan" }],
  "install_guidance": {
    "plugin": "flightplan",
    "binary": "flightplan",
    "check": "which flightplan",
    "install_steps": ["npm install -g flightplan", "Verify: flightplan --version", "supercli plugins install ./plugins/flightplan --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "flightplan",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to flightplan CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flightplan",
      "passthrough": true,
      "missingDependencyHelp": "Install flightplan: npm install -g flightplan"
    },
    "args": []
  }]
}
