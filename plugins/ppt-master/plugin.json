{
  "name": "ppt-master",
  "version": "0.1.0",
  "description": "AI generates a real, editable PowerPoint from any document \u2014 native shapes & animations, speaker not",
  "source": "https://github.com/ppt-master/ppt-master",
  "checks": [
    {
      "type": "binary",
      "name": "ppt-master"
    }
  ],
  "install_guidance": {
    "plugin": "ppt-master",
    "binary": "ppt-master",
    "check": "which ppt-master",
    "install_steps": [
      "pip install ppt-master",
      "Verify: ppt-master --version",
      "supercli plugins install ./plugins/ppt-master --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppt-master",
      "resource": "self",
      "action": "version",
      "description": "Print ppt-master version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppt-master",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppt-master: pip install ppt-master"
      },
      "args": []
    },
    {
      "namespace": "ppt-master",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppt-master CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppt-master",
        "passthrough": true,
        "missingDependencyHelp": "Install ppt-master: pip install ppt-master"
      },
      "args": []
    }
  ]
}