{
  "name": "falcoctl",
  "version": "0.1.0",
  "description": "CLI for managing Falco runtime security deployments",
  "source": "https://github.com/falcosecurity/falcoctl",
  "checks": [{ "type": "binary", "name": "falcoctl" }],
  "install_guidance": {
    "plugin": "falcoctl",
    "binary": "falcoctl",
    "check": "which falcoctl",
    "install_steps": ["brew install falcoctl", "Verify: falcoctl --version", "supercli plugins install ./plugins/falcoctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "falcoctl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to falcoctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "falcoctl",
      "passthrough": true,
      "missingDependencyHelp": "Install falcoctl: brew install falcoctl"
    },
    "args": []
  }]
}
