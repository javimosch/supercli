{
  "name": "cntb",
  "version": "0.1.0",
  "description": "Contabo Command-Line Interface (CLI)",
  "source": "https://github.com/contabo/cntb",
  "checks": [
    {
      "type": "binary",
      "name": "cntb"
    }
  ],
  "install_guidance": {
    "plugin": "cntb",
    "binary": "cntb",
    "check": "which cntb",
    "install_steps": [
      "brew install cntb",
      "Verify: cntb --version",
      "supercli plugins install ./plugins/cntb --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cntb",
      "resource": "self",
      "action": "version",
      "description": "Print cntb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cntb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cntb: brew install cntb"
      },
      "args": []
    },
    {
      "namespace": "cntb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cntb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cntb",
        "passthrough": true,
        "missingDependencyHelp": "Install cntb"
      },
      "args": []
    }
  ]
}