{
  "name": "eth",
  "version": "0.1.0",
  "description": "eth \u2014 official Go implementation of the Ethereum protocol",
  "source": "https://formulae.brew.sh/formula/ethereum",
  "checks": [
    {
      "type": "binary",
      "name": "geth"
    }
  ],
  "install_guidance": {
    "plugin": "eth",
    "binary": "geth",
    "check": "which geth",
    "install_steps": [
      "brew install ethereum"
    ],
    "note": "Utility tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
