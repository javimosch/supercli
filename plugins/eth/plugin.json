    {
      "namespace": "eth",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to geth",
      "adapter": "process",
      "adapterConfig": {
        "command": "geth",
        "passthrough": true,
        "missingDependencyHelp": "Install eth: brew install ethereum"
      },
      "args": []
    }
  ]
}
