{
  "name": "url-short-cli",
  "version": "0.1.0",
  "description": "Minimalist URL shortener utility for the command line",
  "source": "https://github.com/arvindk/url-short-cli",
  "checks": [{ "type": "binary", "name": "url-short-cli" }],
  "install_guidance": {
    "plugin": "url-short-cli",
    "binary": "url-short-cli",
    "check": "which url-short-cli",
    "install_steps": ["npm install -g url-short-cli", "Verify: url-short-cli --version", "supercli plugins install ./plugins/url-short-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "url-short-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to url-short-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "url-short-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install url-short-cli: npm install -g url-short-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
