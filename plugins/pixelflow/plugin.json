{
  "name": "pixelflow",
  "version": "0.1.0",
  "description": "Image processing CLI - resize, crop, convert with batch support",
  "source": "https://github.com/pixelflow/pixelflow",
  "checks": [
    {
      "type": "binary",
      "name": "pixelflow"
    }
  ],
  "install_guidance": {
    "plugin": "pixelflow",
    "binary": "pixelflow",
    "check": "which pixelflow",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: pixelflow --version",
      "supercli plugins install ./plugins/pixelflow --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "pixelflow",
      "resource": "self",
      "action": "version",
      "description": "Print pixelflow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pixelflow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pixelflow from project repository"
      },
      "args": []
    },
    {
      "namespace": "pixelflow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pixelflow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pixelflow",
        "passthrough": true,
        "missingDependencyHelp": "Install pixelflow from project repository"
      },
      "args": []
    }
  ]
}