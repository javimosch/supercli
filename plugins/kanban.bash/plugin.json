{
  "name": "kanban.bash",
  "version": "0.1.0",
  "description": "Kanban todo manager with a CSV backend",
  "source": "https://github.com/coderofsalvation/kanban.bash",
  "checks": [
    {
      "type": "binary",
      "name": "kanban.bash"
    }
  ],
  "install_guidance": {
    "plugin": "kanban.bash",
    "binary": "kanban.bash",
    "check": "which kanban.bash",
    "install_steps": [
      "See https://github.com/coderofsalvation/kanban.bash",
      "Verify: kanban.bash --version",
      "supercli plugins install ./plugins/kanban.bash --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "kanban.bash",
      "resource": "self",
      "action": "version",
      "description": "Print kanban.bash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kanban.bash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kanban.bash: See https://github.com/coderofsalvation/kanban.bash"
      },
      "args": []
    },
    {
      "namespace": "kanban.bash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kanban.bash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kanban.bash",
        "passthrough": true,
        "missingDependencyHelp": "Install kanban.bash"
      },
      "args": []
    }
  ]
}