{
  "name": "Aule-Attention",
  "version": "0.1.0",
  "description": "High-performance FlashAttention-2 for AMD, Intel, and Apple GPUs. Drop-in replacement for PyTorch SD",
  "source": "https://github.com/Aule-Attention/Aule-Attention",
  "checks": [
    {
      "type": "binary",
      "name": "aule-attention"
    }
  ],
  "install_guidance": {
    "plugin": "Aule-Attention",
    "binary": "aule-attention",
    "check": "which aule-attention",
    "install_steps": [
      "pip install aule-attention",
      "Verify: aule-attention --version",
      "supercli plugins install ./plugins/Aule-Attention --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Aule-Attention",
      "resource": "self",
      "action": "version",
      "description": "Print Aule-Attention version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aule-attention",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Aule-Attention: pip install aule-attention"
      },
      "args": []
    },
    {
      "namespace": "Aule-Attention",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aule-attention CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aule-attention",
        "passthrough": true,
        "missingDependencyHelp": "Install Aule-Attention: pip install aule-attention"
      },
      "args": []
    }
  ]
}