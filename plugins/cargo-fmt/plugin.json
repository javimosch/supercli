{
  "name": "cargo-fmt",
  "version": "0.1.0",
  "description": "CLI tool: cargo-fmt",
  "source": "https://packages.debian.org/cargo-fmt",
  "checks": [{ "type": "binary", "name": "cargo-fmt" }],
  "install_guidance": {
    "plugin": "cargo-fmt", "binary": "cargo-fmt", "check": "which cargo-fmt",
    "install_steps": ["apt-get install cargo-fmt 2>/dev/null || which cargo-fmt", "Verify: cargo-fmt --version", "supercli plugins install ./plugins/cargo-fmt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-fmt", "resource": "_", "action": "_",
    "description": "Passthrough to cargo-fmt CLI",
    "adapter": "process", "adapterConfig": { "command": "cargo-fmt", "passthrough": true, "missingDependencyHelp": "Install cargo-fmt: apt-get install cargo-fmt" }, "args": []
  }]
}
