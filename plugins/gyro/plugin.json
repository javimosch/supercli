{
  "name": "gyro",
  "version": "0.1.0",
  "description": "Zig package manager with declarative deps",
  "source": "https://github.com/mattnite/gyro",
  "checks": [{ "type": "binary", "name": "gyro" }],
  "install_guidance": {
    "plugin": "gyro",
    "binary": "gyro",
    "check": "which gyro",
    "install_steps": ["zig build", "Verify: gyro --version", "supercli plugins install ./plugins/gyro --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gyro",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gyro CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gyro",
      "passthrough": true,
      "missingDependencyHelp": "Install gyro: zig build", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
