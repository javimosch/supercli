{
  "name": "Protokolle",
  "version": "0.1.0",
  "description": "The iOS/iPadOS equivalent to macOS's Console.app, for stock devices.",
  "source": "https://apps.apple.com/us/app/protokolle/id6746388316",
  "checks": [
    {
      "type": "binary",
      "name": "Protokolle"
    }
  ],
  "install_guidance": {
    "plugin": "Protokolle",
    "binary": "Protokolle",
    "check": "which Protokolle",
    "install_steps": [
      "Check https://apps.apple.com/us/app/protokolle/id6746388316 for installation instructions",
      "Verify: Protokolle --version",
      "supercli plugins install ./plugins/Protokolle --on-conflict replace --json"
    ],
    "note": "Swift language CLI tool"
  },
  "commands": [
    {
      "namespace": "Protokolle",
      "resource": "self",
      "action": "version",
      "description": "Print Protokolle version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Protokolle",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Protokolle from project repository"
      },
      "args": []
    },
    {
      "namespace": "Protokolle",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Protokolle CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Protokolle",
        "passthrough": true,
        "missingDependencyHelp": "Install Protokolle from project repository"
      },
      "args": []
    }
  ]
}