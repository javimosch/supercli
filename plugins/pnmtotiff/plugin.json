{
  "name": "pnmtotiff",
  "version": "0.1.0",
  "description": "CLI tool: pnmtotiff",
  "source": "https://manpages.debian.org/pnmtotiff",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtotiff"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtotiff",
    "binary": "pnmtotiff",
    "check": "which pnmtotiff",
    "install_steps": [
      "apt-get install pnmtotiff 2>/dev/null || which pnmtotiff",
      "Verify: pnmtotiff --version",
      "supercli plugins install ./plugins/pnmtotiff --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtotiff",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtotiff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtotiff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtotiff: apt-get install pnmtotiff 2>/dev/null || which pnmtotiff"
      },
      "args": []
    },
    {
      "namespace": "pnmtotiff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtotiff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtotiff",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtotiff: apt-get install pnmtotiff 2>/dev/null || which pnmtotiff"
      },
      "args": []
    }
  ]
}