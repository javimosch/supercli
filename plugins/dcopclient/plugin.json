{
  "name": "dcopclient",
  "version": "0.1.0",
  "description": "CLI tool: dcopclient",
  "source": "https://packages.debian.org/dcopclient",
  "checks": [{ "type": "binary", "name": "dcopclient" }],
  "install_guidance": {
    "plugin": "dcopclient", "binary": "dcopclient", "check": "which dcopclient",
    "install_steps": ["apt-get install dcopclient 2>/dev/null || which dcopclient", "Verify: dcopclient --version", "supercli plugins install ./plugins/dcopclient --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dcopclient", "resource": "_", "action": "_",
    "description": "Passthrough to dcopclient CLI",
    "adapter": "process", "adapterConfig": { "command": "dcopclient", "passthrough": true, "missingDependencyHelp": "Install dcopclient: apt-get install dcopclient" }, "args": []
  }]
}
