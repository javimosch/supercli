{
  "name": "qcollectiongenerator",
  "version": "0.1.0",
  "description": "CLI tool: qcollectiongenerator",
  "source": "https://manpages.debian.org/qcollectiongenerator",
  "checks": [
    {
      "type": "binary",
      "name": "qcollectiongenerator"
    }
  ],
  "install_guidance": {
    "plugin": "qcollectiongenerator",
    "binary": "qcollectiongenerator",
    "check": "which qcollectiongenerator",
    "install_steps": [
      "apt-get install qcollectiongenerator 2>/dev/null || which qcollectiongenerator",
      "Verify: qcollectiongenerator --version",
      "supercli plugins install ./plugins/qcollectiongenerator --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qcollectiongenerator",
      "resource": "self",
      "action": "version",
      "description": "Print qcollectiongenerator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qcollectiongenerator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qcollectiongenerator: apt-get install qcollectiongenerator 2>/dev/null || which qcollectiongenerator"
      },
      "args": []
    },
    {
      "namespace": "qcollectiongenerator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qcollectiongenerator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qcollectiongenerator",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qcollectiongenerator: apt-get install qcollectiongenerator 2>/dev/null || which qcollectiongenerator"
      },
      "args": []
    }
  ]
}