{
  "name": "linkhut",
  "version": "0.1.0",
  "description": "Share and discover links via CLI",
  "source": "https://github.com/angristan/linkhut",
  "checks": [{ "type": "binary", "name": "linkhut" }],
  "install_guidance": {
    "plugin": "linkhut",
    "binary": "linkhut",
    "check": "which linkhut",
    "install_steps": ["cargo install linkhut", "Verify: linkhut --version", "supercli plugins install ./plugins/linkhut --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "linkhut",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to linkhut CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "linkhut",
      "passthrough": true,
      "missingDependencyHelp": "Install linkhut: cargo install linkhut", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
