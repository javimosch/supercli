{
  "name": "f95",
  "version": "0.1.0",
  "description": "CLI tool: f95",
  "source": "https://manpages.debian.org/f95",
  "checks": [
    {
      "type": "binary",
      "name": "f95"
    }
  ],
  "install_guidance": {
    "plugin": "f95",
    "binary": "f95",
    "check": "which f95",
    "install_steps": [
      "apt-get install f95 2>/dev/null || which f95",
      "Verify: f95 --version",
      "supercli plugins install ./plugins/f95 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "f95",
      "resource": "self",
      "action": "version",
      "description": "Print f95 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "f95",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install f95: apt-get install f95 2>/dev/null || which f95"
      },
      "args": []
    },
    {
      "namespace": "f95",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to f95 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "f95",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install f95: apt-get install f95 2>/dev/null || which f95"
      },
      "args": []
    }
  ]
}