{
  "name": "HelloWorld",
  "version": "0.1.0",
  "description": "A simple HelloWorld CLI tool for demonstration purposes",
  "source": "https://github.com/HelloWorld/HelloWorld",
  "checks": [
    {
      "type": "binary",
      "name": "helloworld"
    }
  ],
  "install_guidance": {
    "plugin": "HelloWorld",
    "binary": "helloworld",
    "check": "which helloworld",
    "install_steps": [
      "pip install helloworld",
      "Verify: helloworld --version",
      "supercli plugins install ./plugins/HelloWorld --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "HelloWorld",
      "resource": "self",
      "action": "version",
      "description": "Print HelloWorld version",
      "adapter": "process",
      "adapterConfig": {
        "command": "helloworld",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install HelloWorld: pip install helloworld"
      },
      "args": []
    },
    {
      "namespace": "HelloWorld",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to helloworld CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "helloworld",
        "passthrough": true,
        "missingDependencyHelp": "Install HelloWorld: pip install helloworld"
      },
      "args": []
    }
  ]
}