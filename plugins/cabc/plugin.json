{
  "name": "cabc",
  "version": "0.1.0",
  "description": "CLI tool: cabc",
  "source": "https://packages.debian.org/cabc",
  "checks": [{ "type": "binary", "name": "cabc" }],
  "install_guidance": {
    "plugin": "cabc", "binary": "cabc", "check": "which cabc",
    "install_steps": ["apt-get install cabc 2>/dev/null || which cabc", "Verify: cabc --version", "supercli plugins install ./plugins/cabc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cabc", "resource": "_", "action": "_",
    "description": "Passthrough to cabc CLI",
    "adapter": "process", "adapterConfig": { "command": "cabc", "passthrough": true, "missingDependencyHelp": "Install cabc: apt-get install cabc" }, "args": []
  }]
}
