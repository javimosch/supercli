{
  "name": "tree",
  "version": "0.1.0",
  "description": "Display directory structure as a tree",
  "source": "https",
  "checks": [{"type": "binary", "name": "tree"}],
  "install_guidance": {
    "plugin": "tree",
    "binary": "tree",
    "check": "which tree",
    "install_steps": [
      "brew install tree",
      "Verify: tree --version",
      "supercli plugins install ./plugins/tree --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "tree",
      "resource": "self",
      "action": "version",
      "description": "Print tree version",
      "adapter": "process",
      "adapterConfig": {"command": "tree", "baseArgs": ["--version"], "missingDependencyHelp": "Install tree: brew install tree"},
      "args": []
    },
    {
      "namespace": "tree",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tree CLI",
      "adapter": "process",
      "adapterConfig": {"command": "tree", "passthrough": true, "missingDependencyHelp": "Install tree: brew install tree"},
      "args": []
    }
  ]
}
