{
  "name": "volsync",
  "version": "0.1.0",
  "description": "Asynchronous volume replication for Kubernetes",
  "source": "https://github.com/backube/volsync",
  "checks": [{ "type": "binary", "name": "volsync" }],
  "install_guidance": {
    "plugin": "volsync",
    "binary": "volsync",
    "check": "which volsync",
    "install_steps": ["brew install volsync", "Verify: volsync --version", "supercli plugins install ./plugins/volsync --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "volsync",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to volsync CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "volsync",
      "passthrough": true,
      "missingDependencyHelp": "Install volsync: brew install volsync"
    },
    "args": []
  }]
}
