{
  "name": "osaurus",
  "version": "0.1.0",
  "description": "Own your AI. The native macOS harness for AI agents -- any model, persistent memory, autonomous exec",
  "source": "https://github.com/osaurus/osaurus",
  "checks": [
    {
      "type": "binary",
      "name": "osaurus"
    }
  ],
  "install_guidance": {
    "plugin": "osaurus",
    "binary": "osaurus",
    "check": "which osaurus",
    "install_steps": [
      "pip install osaurus",
      "Verify: osaurus --version",
      "supercli plugins install ./plugins/osaurus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "osaurus",
      "resource": "self",
      "action": "version",
      "description": "Print osaurus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "osaurus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install osaurus: pip install osaurus"
      },
      "args": []
    },
    {
      "namespace": "osaurus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to osaurus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "osaurus",
        "passthrough": true,
        "missingDependencyHelp": "Install osaurus: pip install osaurus"
      },
      "args": []
    }
  ]
}