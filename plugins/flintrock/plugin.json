{
  "name": "flintrock",
  "version": "0.1.0",
  "description": "Tool for launching Apache Spark clusters",
  "source": "https://github.com/nchammas/flintrock",
  "checks": [
    {
      "type": "binary",
      "name": "flintrock"
    }
  ],
  "install_guidance": {
    "plugin": "flintrock",
    "binary": "flintrock",
    "check": "which flintrock",
    "install_steps": [
      "brew install flintrock",
      "Verify: flintrock --version",
      "supercli plugins install ./plugins/flintrock --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "flintrock",
      "resource": "self",
      "action": "version",
      "description": "Print flintrock version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flintrock",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flintrock: brew install flintrock"
      },
      "args": []
    },
    {
      "namespace": "flintrock",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flintrock CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flintrock",
        "passthrough": true,
        "missingDependencyHelp": "Install flintrock"
      },
      "args": []
    }
  ]
}