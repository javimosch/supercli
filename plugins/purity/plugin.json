{
  "name": "purity",
  "version": "0.1.0",
  "description": "Minimalist static site generator using ERB templates in Ruby",
  "source": "gem",
  "checks": [{ "type": "binary", "name": "purity" }],
  "install_guidance": {
    "plugin": "purity",
    "binary": "purity",
    "check": "which purity",
    "install_steps": ["gem install purity", "Verify: purity --version", "supercli plugins install ./plugins/purity --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "purity",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to purity CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "purity",
      "passthrough": true,
      "missingDependencyHelp": "Install purity: gem install purity"
    },
    "args": []
  }]
}
