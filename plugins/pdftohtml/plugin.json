{
  "name": "pdftohtml",
  "version": "0.1.0",
  "description": "CLI tool: pdftohtml",
  "source": "https://manpages.debian.org/pdftohtml",
  "checks": [
    {
      "type": "binary",
      "name": "pdftohtml"
    }
  ],
  "install_guidance": {
    "plugin": "pdftohtml",
    "binary": "pdftohtml",
    "check": "which pdftohtml",
    "install_steps": [
      "apt-get install pdftohtml 2>/dev/null || which pdftohtml",
      "Verify: pdftohtml --version",
      "supercli plugins install ./plugins/pdftohtml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdftohtml",
      "resource": "self",
      "action": "version",
      "description": "Print pdftohtml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdftohtml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdftohtml: apt-get install pdftohtml 2>/dev/null || which pdftohtml"
      },
      "args": []
    },
    {
      "namespace": "pdftohtml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdftohtml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdftohtml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdftohtml: apt-get install pdftohtml 2>/dev/null || which pdftohtml"
      },
      "args": []
    }
  ]
}