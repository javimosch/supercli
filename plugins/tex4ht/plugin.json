{
  "name": "tex4ht",
  "version": "0.1.0",
  "description": "CLI tool: tex4ht",
  "source": "https://manpages.debian.org/tex4ht",
  "checks": [
    {
      "type": "binary",
      "name": "tex4ht"
    }
  ],
  "install_guidance": {
    "plugin": "tex4ht",
    "binary": "tex4ht",
    "check": "which tex4ht",
    "install_steps": [
      "apt-get install tex4ht 2>/dev/null || which tex4ht",
      "Verify: tex4ht --version",
      "supercli plugins install ./plugins/tex4ht --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tex4ht",
      "resource": "self",
      "action": "version",
      "description": "Print tex4ht version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tex4ht",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tex4ht: apt-get install tex4ht 2>/dev/null || which tex4ht"
      },
      "args": []
    },
    {
      "namespace": "tex4ht",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tex4ht CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tex4ht",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tex4ht: apt-get install tex4ht 2>/dev/null || which tex4ht"
      },
      "args": []
    }
  ]
}