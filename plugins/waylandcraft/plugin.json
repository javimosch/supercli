{
  "name": "waylandcraft",
  "version": "0.1.0",
  "description": "Wayland Compositor in Minecraft",
  "source": "https://github.com/waylandcraft/waylandcraft",
  "checks": [
    {
      "type": "binary",
      "name": "waylandcraft"
    }
  ],
  "install_guidance": {
    "plugin": "waylandcraft",
    "binary": "waylandcraft",
    "check": "which waylandcraft",
    "install_steps": [
      "pip install waylandcraft",
      "Verify: waylandcraft --version",
      "supercli plugins install ./plugins/waylandcraft --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "waylandcraft",
      "resource": "self",
      "action": "version",
      "description": "Print waylandcraft version",
      "adapter": "process",
      "adapterConfig": {
        "command": "waylandcraft",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install waylandcraft: pip install waylandcraft"
      },
      "args": []
    },
    {
      "namespace": "waylandcraft",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to waylandcraft CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "waylandcraft",
        "passthrough": true,
        "missingDependencyHelp": "Install waylandcraft: pip install waylandcraft"
      },
      "args": []
    }
  ]
}