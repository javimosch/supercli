{
  "name": "yamlresume",
  "version": "0.1.0",
  "description": "Resumes as code",
  "source": "https://github.com/yamlresume/yamlresume",
  "checks": [
    {
      "type": "binary",
      "name": "yamlresume"
    }
  ],
  "install_guidance": {
    "plugin": "yamlresume",
    "binary": "yamlresume",
    "check": "which yamlresume",
    "install_steps": [
      "brew install yamlresume",
      "Verify: yamlresume --version",
      "supercli plugins install ./plugins/yamlresume --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "yamlresume",
      "resource": "self",
      "action": "version",
      "description": "Print yamlresume version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yamlresume",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yamlresume: brew install yamlresume"
      },
      "args": []
    },
    {
      "namespace": "yamlresume",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yamlresume CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yamlresume",
        "passthrough": true,
        "missingDependencyHelp": "Install yamlresume"
      },
      "args": []
    }
  ]
}