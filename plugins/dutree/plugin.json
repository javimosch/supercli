{
  "name": "dutree",
  "version": "0.1.0",
  "description": "A tool to analyze file system usage written in Rust",
  "source": "https://github.com/nachoparker/dutree",
  "checks": [
    {
      "type": "binary",
      "name": "dutree"
    }
  ],
  "install_guidance": {
    "plugin": "dutree",
    "binary": "dutree",
    "check": "which dutree",
    "install_steps": [
      "cargo install dutree",
      "Verify: dutree --version",
      "supercli plugins install ./plugins/dutree --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dutree",
      "resource": "self",
      "action": "version",
      "description": "Print dutree version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dutree",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dutree: cargo install dutree"
      },
      "args": []
    },
    {
      "namespace": "dutree",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dutree CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dutree",
        "passthrough": true,
        "missingDependencyHelp": "Install dutree"
      },
      "args": []
    }
  ]
}