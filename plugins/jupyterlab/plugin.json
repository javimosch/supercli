{
  "name": "jupyterlab",
  "version": "0.1.0",
  "description": "Interactive environments for writing and running code",
  "checks": [
    {
      "type": "binary",
      "name": "jupyterlab"
    }
  ],
  "install_guidance": {
    "plugin": "jupyterlab",
    "binary": "jupyterlab",
    "check": "which jupyterlab",
    "install_steps": [
      "brew install jupyterlab",
      "Verify: jupyterlab --version",
      "supercli plugins install ./plugins/jupyterlab --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jupyterlab",
      "resource": "self",
      "action": "version",
      "description": "Print jupyterlab version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jupyterlab",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jupyterlab: brew install jupyterlab"
      },
      "args": []
    },
    {
      "namespace": "jupyterlab",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jupyterlab CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jupyterlab",
        "passthrough": true,
        "missingDependencyHelp": "Install jupyterlab"
      },
      "args": []
    }
  ]
}