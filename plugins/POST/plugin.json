{
  "name": "POST",
  "version": "0.1.0",
  "description": "CLI tool: POST",
  "source": "https://manpages.debian.org/POST",
  "checks": [
    {
      "type": "binary",
      "name": "POST"
    }
  ],
  "install_guidance": {
    "plugin": "POST",
    "binary": "POST",
    "check": "which POST",
    "install_steps": [
      "apt-get install POST 2>/dev/null || which POST",
      "Verify: POST --version",
      "supercli plugins install ./plugins/POST --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "POST",
      "resource": "self",
      "action": "version",
      "description": "Print POST version",
      "adapter": "process",
      "adapterConfig": {
        "command": "POST",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install POST: apt-get install POST 2>/dev/null || which POST"
      },
      "args": []
    },
    {
      "namespace": "POST",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to POST CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "POST",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install POST: apt-get install POST 2>/dev/null || which POST"
      },
      "args": []
    }
  ]
}