{
  "name": "dh_installxfonts",
  "version": "0.1.0",
  "description": "CLI tool: dh_installxfonts",
  "source": "https://packages.debian.org/dh_installxfonts",
  "checks": [{ "type": "binary", "name": "dh_installxfonts" }],
  "install_guidance": {
    "plugin": "dh_installxfonts", "binary": "dh_installxfonts", "check": "which dh_installxfonts",
    "install_steps": ["apt-get install dh_installxfonts 2>/dev/null || which dh_installxfonts", "Verify: dh_installxfonts --version", "supercli plugins install ./plugins/dh_installxfonts --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_installxfonts", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installxfonts CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installxfonts", "passthrough": true, "missingDependencyHelp": "Install dh_installxfonts: apt-get install dh_installxfonts" }, "args": []
  }]
}
