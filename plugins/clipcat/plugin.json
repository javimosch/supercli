{
  "name": "clipcat",
  "version": "0.1.0",
  "description": "Linux clipboard manager with daemon and CLI access",
  "source": "https://github.com/xrelkd/clipcat",
  "checks": [{ "type": "binary", "name": "clipcat" }],
  "install_guidance": {
    "plugin": "clipcat",
    "binary": "clipcat",
    "check": "which clipcat",
    "install_steps": ["cargo install clipcat", "Verify: clipcat --version", "supercli plugins install ./plugins/clipcat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clipcat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clipcat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clipcat",
      "passthrough": true,
      "missingDependencyHelp": "Install clipcat: cargo install clipcat", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
