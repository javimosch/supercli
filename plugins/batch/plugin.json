{
  "name": "batch",
  "version": "0.1.0",
  "description": "Schedule commands for later execution",
  "source": "https://packages.debian.org/batch",
  "checks": [{ "type": "binary", "name": "batch" }],
  "install_guidance": {
    "plugin": "batch", "binary": "batch", "check": "which batch",
    "install_steps": ["apt-get install at", "Verify: batch --version", "supercli plugins install ./plugins/batch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "batch", "resource": "_", "action": "_",
    "description": "Passthrough to batch CLI",
    "adapter": "process", "adapterConfig": { "command": "batch", "passthrough": true, "missingDependencyHelp": "Install batch: apt-get install at" }, "args": []
  }]
}
