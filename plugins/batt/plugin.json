{
  "name": "batt",
  "version": "0.1.0",
  "description": "Batteries for the terminal",
  "source": "https://github.com/owl4ce/batt",
  "checks": [
    {
      "type": "binary",
      "name": "batt"
    }
  ],
  "install_guidance": {
    "plugin": "batt",
    "binary": "batt",
    "check": "which batt",
    "install_steps": [
      "See GitHub releases",
      "Verify: batt --version",
      "supercli plugins install ./plugins/batt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "batt",
      "resource": "self",
      "action": "version",
      "description": "Print batt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "batt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install batt: See GitHub releases"
      },
      "args": []
    },
    {
      "namespace": "batt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to batt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "batt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install batt: See GitHub releases"
      },
      "args": []
    }
  ]
}