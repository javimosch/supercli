{
  "name": "vgimport",
  "version": "0.1.0",
  "description": "CLI tool: vgimport",
  "source": "https://manpages.debian.org/vgimport",
  "checks": [
    {
      "type": "binary",
      "name": "vgimport"
    }
  ],
  "install_guidance": {
    "plugin": "vgimport",
    "binary": "vgimport",
    "check": "which vgimport",
    "install_steps": [
      "apt-get install vgimport 2>/dev/null || which vgimport",
      "Verify: vgimport --version",
      "supercli plugins install ./plugins/vgimport --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vgimport",
      "resource": "self",
      "action": "version",
      "description": "Print vgimport version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgimport",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vgimport: apt-get install vgimport 2>/dev/null || which vgimport"
      },
      "args": []
    },
    {
      "namespace": "vgimport",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vgimport CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgimport",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vgimport: apt-get install vgimport 2>/dev/null || which vgimport"
      },
      "args": []
    }
  ]
}