{
  "name": "msguniq",
  "version": "0.1.0",
  "description": "CLI tool: msguniq",
  "source": "https://manpages.debian.org/msguniq",
  "checks": [
    {
      "type": "binary",
      "name": "msguniq"
    }
  ],
  "install_guidance": {
    "plugin": "msguniq",
    "binary": "msguniq",
    "check": "which msguniq",
    "install_steps": [
      "apt-get install msguniq 2>/dev/null || which msguniq",
      "Verify: msguniq --version",
      "supercli plugins install ./plugins/msguniq --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "msguniq",
      "resource": "self",
      "action": "version",
      "description": "Print msguniq version",
      "adapter": "process",
      "adapterConfig": {
        "command": "msguniq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install msguniq: apt-get install msguniq 2>/dev/null || which msguniq"
      },
      "args": []
    },
    {
      "namespace": "msguniq",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to msguniq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "msguniq",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install msguniq: apt-get install msguniq 2>/dev/null || which msguniq"
      },
      "args": []
    }
  ]
}