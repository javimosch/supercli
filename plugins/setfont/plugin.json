{
  "name": "setfont",
  "version": "0.1.0",
  "description": "CLI tool: setfont",
  "source": "https://manpages.debian.org/setfont",
  "checks": [
    {
      "type": "binary",
      "name": "setfont"
    }
  ],
  "install_guidance": {
    "plugin": "setfont",
    "binary": "setfont",
    "check": "which setfont",
    "install_steps": [
      "apt-get install setfont 2>/dev/null || which setfont",
      "Verify: setfont --version",
      "supercli plugins install ./plugins/setfont --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "setfont",
      "resource": "self",
      "action": "version",
      "description": "Print setfont version",
      "adapter": "process",
      "adapterConfig": {
        "command": "setfont",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install setfont: apt-get install setfont 2>/dev/null || which setfont"
      },
      "args": []
    },
    {
      "namespace": "setfont",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to setfont CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "setfont",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install setfont: apt-get install setfont 2>/dev/null || which setfont"
      },
      "args": []
    }
  ]
}