{
  "name": "banner",
  "version": "0.1.0",
  "description": "Print large ASCII text banners in the terminal",
  "source": "https",
  "checks": [{"type": "binary", "name": "banner"}],
  "install_guidance": {
    "plugin": "banner",
    "binary": "banner",
    "check": "which banner",
    "install_steps": [
      "brew install banner",
      "Verify: banner --version",
      "supercli plugins install ./plugins/banner --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "banner",
      "resource": "self",
      "action": "version",
      "description": "Print banner version",
      "adapter": "process",
      "adapterConfig": {"command": "banner", "baseArgs": ["--version"], "missingDependencyHelp": "Install banner: brew install banner"},
      "args": []
    },
    {
      "namespace": "banner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to banner CLI",
      "adapter": "process",
      "adapterConfig": {"command": "banner", "passthrough": true, "missingDependencyHelp": "Install banner: brew install banner"},
      "args": []
    }
  ]
}
