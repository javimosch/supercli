{
  "name": "PairPods",
  "version": "0.1.0",
  "description": "Share and manage audio pairing between Bluetooth devices",
  "source": "https://github.com/wozniakpawel/PairPods",
  "checks": [{ "type": "binary", "name": "PairPods" }],
  "install_guidance": {
    "plugin": "PairPods",
    "binary": "PairPods",
    "check": "which PairPods",
    "install_steps": ["git clone and build", "Verify: PairPods --version", "supercli plugins install ./plugins/PairPods --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "PairPods",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to PairPods CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "PairPods",
      "passthrough": true,
      "missingDependencyHelp": "Install PairPods: git clone and build", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
