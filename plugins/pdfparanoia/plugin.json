{
  "name": "pdfparanoia",
  "version": "0.1.0",
  "description": "Remove watermarks from academic PDF papers",
  "source": "https://github.com/kanzure/pdfparanoia",
  "checks": [{ "type": "binary", "name": "pdfparanoia" }],
  "install_guidance": {
    "plugin": "pdfparanoia",
    "binary": "pdfparanoia",
    "check": "which pdfparanoia",
    "install_steps": ["pip install pdfparanoia", "Verify: pdfparanoia --version", "supercli plugins install ./plugins/pdfparanoia --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdfparanoia",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdfparanoia CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdfparanoia",
      "passthrough": true,
      "missingDependencyHelp": "Install pdfparanoia: pip install pdfparanoia", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
