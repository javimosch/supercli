{
  "name": "hmac256",
  "version": "0.1.0",
  "description": "CLI tool: hmac256",
  "source": "https://manpages.debian.org/hmac256",
  "checks": [
    {
      "type": "binary",
      "name": "hmac256"
    }
  ],
  "install_guidance": {
    "plugin": "hmac256",
    "binary": "hmac256",
    "check": "which hmac256",
    "install_steps": [
      "apt-get install hmac256 2>/dev/null || which hmac256",
      "Verify: hmac256 --version",
      "supercli plugins install ./plugins/hmac256 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hmac256",
      "resource": "self",
      "action": "version",
      "description": "Print hmac256 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hmac256",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hmac256: apt-get install hmac256 2>/dev/null || which hmac256"
      },
      "args": []
    },
    {
      "namespace": "hmac256",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hmac256 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hmac256",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hmac256: apt-get install hmac256 2>/dev/null || which hmac256"
      },
      "args": []
    }
  ]
}