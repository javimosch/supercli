{
  "name": "fuzzy-find",
  "version": "0.1.0",
  "description": "Fuzzy filename finder matching across directories as well as files",
  "source": "https://github.com/silentbicycle/ff",
  "checks": [
    {
      "type": "binary",
      "name": "fuzzy-find"
    }
  ],
  "install_guidance": {
    "plugin": "fuzzy-find",
    "binary": "fuzzy-find",
    "check": "which fuzzy-find",
    "install_steps": [
      "brew install fuzzy-find",
      "Verify: fuzzy-find --version",
      "supercli plugins install ./plugins/fuzzy-find --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fuzzy-find",
      "resource": "self",
      "action": "version",
      "description": "Print fuzzy-find version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fuzzy-find",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fuzzy-find: brew install fuzzy-find"
      },
      "args": []
    },
    {
      "namespace": "fuzzy-find",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fuzzy-find CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fuzzy-find",
        "passthrough": true,
        "missingDependencyHelp": "Install fuzzy-find"
      },
      "args": []
    }
  ]
}