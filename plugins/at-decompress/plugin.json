{
  "name": "at-decompress",
  "version": "0.1.0",
  "description": "CLI tool: at-decompress",
  "source": "https://packages.debian.org/at-decompress",
  "checks": [{ "type": "binary", "name": "at-decompress" }],
  "install_guidance": {
    "plugin": "at-decompress", "binary": "at-decompress", "check": "which at-decompress",
    "install_steps": ["apt-get install at-decompress 2>/dev/null || which at-decompress", "Verify: at-decompress --version", "supercli plugins install ./plugins/at-decompress --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-decompress", "resource": "_", "action": "_",
    "description": "Passthrough to at-decompress CLI",
    "adapter": "process", "adapterConfig": { "command": "at-decompress", "passthrough": true, "missingDependencyHelp": "Install at-decompress: apt-get install at-decompress" }, "args": []
  }]
}
