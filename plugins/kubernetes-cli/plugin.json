{
  "name": "kubernetes-cli",
  "version": "0.1.0",
  "description": "Kubernetes command-line interface",
  "checks": [
    {
      "type": "binary",
      "name": "kubernetes-cli"
    }
  ],
  "install_guidance": {
    "plugin": "kubernetes-cli",
    "binary": "kubernetes-cli",
    "check": "which kubernetes-cli",
    "install_steps": [
      "brew install kubernetes-cli",
      "Verify: kubernetes-cli --version",
      "supercli plugins install ./plugins/kubernetes-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kubernetes-cli",
      "resource": "self",
      "action": "version",
      "description": "Print kubernetes-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubernetes-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kubernetes-cli: brew install kubernetes-cli"
      },
      "args": []
    },
    {
      "namespace": "kubernetes-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kubernetes-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubernetes-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install kubernetes-cli"
      },
      "args": []
    }
  ]
}