{
  "name": "gpartedbin",
  "version": "0.1.0",
  "description": "CLI tool: gpartedbin",
  "source": "https://manpages.debian.org/gpartedbin",
  "checks": [
    {
      "type": "binary",
      "name": "gpartedbin"
    }
  ],
  "install_guidance": {
    "plugin": "gpartedbin",
    "binary": "gpartedbin",
    "check": "which gpartedbin",
    "install_steps": [
      "apt-get install gpartedbin 2>/dev/null || which gpartedbin",
      "Verify: gpartedbin --version",
      "supercli plugins install ./plugins/gpartedbin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gpartedbin",
      "resource": "self",
      "action": "version",
      "description": "Print gpartedbin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpartedbin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gpartedbin: apt-get install gpartedbin 2>/dev/null || which gpartedbin"
      },
      "args": []
    },
    {
      "namespace": "gpartedbin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpartedbin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpartedbin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gpartedbin: apt-get install gpartedbin 2>/dev/null || which gpartedbin"
      },
      "args": []
    }
  ]
}