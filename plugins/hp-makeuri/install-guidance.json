{
  "plugin": "hp-makeuri",
  "binary": "hp-makeuri",
  "check": "which hp-makeuri",
  "install_steps": [
    "apt-get install hp-makeuri 2>/dev/null || which hp-makeuri",
    "Verify: hp-makeuri --version",
    "supercli plugins install ./plugins/hp-makeuri --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}