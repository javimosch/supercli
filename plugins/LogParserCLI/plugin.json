{
  "name": "LogParserCLI",
  "version": "0.1.0",
  "description": "LogParserCLI is a command-line tool for automatically parsing logs generated by stealer malware. It supports multiple log formats, allowing users to extract and analyze data from different sources. This tool streamlines the log parsing process, assisting security professionals in identifying threats and enhancing incident response efficiency.",
  "source": "https://github.com/LogParserCLI/LogParserCLI",
  "checks": [
    {
      "type": "binary",
      "name": "LogParserCLI"
    }
  ],
  "install_guidance": {
    "plugin": "LogParserCLI",
    "binary": "LogParserCLI",
    "check": "which LogParserCLI",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: LogParserCLI --version",
      "supercli plugins install ./plugins/LogParserCLI --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "LogParserCLI",
      "resource": "self",
      "action": "version",
      "description": "Print LogParserCLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "LogParserCLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LogParserCLI from project repository"
      },
      "args": []
    },
    {
      "namespace": "LogParserCLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to LogParserCLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "LogParserCLI",
        "passthrough": true,
        "missingDependencyHelp": "Install LogParserCLI from project repository"
      },
      "args": []
    }
  ]
}