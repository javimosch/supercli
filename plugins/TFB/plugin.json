{
  "name": "TFB",
  "version": "0.1.0",
  "description": "[PVLDB 2024 Best Paper Nomination] TFB: Towards Comprehensive and Fair Benchmarking of Time Series F",
  "source": "https://github.com/TFB/TFB",
  "checks": [
    {
      "type": "binary",
      "name": "tfb"
    }
  ],
  "install_guidance": {
    "plugin": "TFB",
    "binary": "tfb",
    "check": "which tfb",
    "install_steps": [
      "pip install tfb",
      "Verify: tfb --version",
      "supercli plugins install ./plugins/TFB --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TFB",
      "resource": "self",
      "action": "version",
      "description": "Print TFB version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tfb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TFB: pip install tfb"
      },
      "args": []
    },
    {
      "namespace": "TFB",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tfb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tfb",
        "passthrough": true,
        "missingDependencyHelp": "Install TFB: pip install tfb"
      },
      "args": []
    }
  ]
}