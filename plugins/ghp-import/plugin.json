{
  "name": "ghp-import",
  "version": "0.1.0",
  "description": "CLI tool: ghp-import",
  "source": "https://manpages.debian.org/ghp-import",
  "checks": [
    {
      "type": "binary",
      "name": "ghp-import"
    }
  ],
  "install_guidance": {
    "plugin": "ghp-import",
    "binary": "ghp-import",
    "check": "which ghp-import",
    "install_steps": [
      "apt-get install ghp-import 2>/dev/null || which ghp-import",
      "Verify: ghp-import --version",
      "supercli plugins install ./plugins/ghp-import --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ghp-import",
      "resource": "self",
      "action": "version",
      "description": "Print ghp-import version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghp-import",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ghp-import: apt-get install ghp-import 2>/dev/null || which ghp-import"
      },
      "args": []
    },
    {
      "namespace": "ghp-import",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghp-import CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghp-import",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ghp-import: apt-get install ghp-import 2>/dev/null || which ghp-import"
      },
      "args": []
    }
  ]
}