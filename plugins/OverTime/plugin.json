{
  "name": "OverTime",
  "version": "0.1.0",
  "description": "Time-overlap tables for remote teams",
  "source": "https://github.com/diit/overtime-cli",
  "checks": [
    {
      "type": "binary",
      "name": "OverTime"
    }
  ],
  "install_guidance": {
    "plugin": "OverTime",
    "binary": "OverTime",
    "check": "which OverTime",
    "install_steps": [
      "See https://github.com/diit/overtime-cli",
      "Verify: OverTime --version",
      "supercli plugins install ./plugins/OverTime --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "OverTime",
      "resource": "self",
      "action": "version",
      "description": "Print OverTime version",
      "adapter": "process",
      "adapterConfig": {
        "command": "OverTime",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OverTime: See https://github.com/diit/overtime-cli"
      },
      "args": []
    },
    {
      "namespace": "OverTime",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to OverTime CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "OverTime",
        "passthrough": true,
        "missingDependencyHelp": "Install OverTime"
      },
      "args": []
    }
  ]
}