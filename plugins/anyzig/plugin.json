{
  "name": "anyzig",
  "version": "0.1.0",
  "description": "One zig to rule them all.",
  "source": "https://github.com/anyzig/anyzig",
  "checks": [
    {
      "type": "binary",
      "name": "anyzig"
    }
  ],
  "install_guidance": {
    "plugin": "anyzig",
    "binary": "anyzig",
    "check": "which anyzig",
    "install_steps": [
      "pip install anyzig",
      "Verify: anyzig --version",
      "supercli plugins install ./plugins/anyzig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "anyzig",
      "resource": "self",
      "action": "version",
      "description": "Print anyzig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "anyzig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install anyzig: pip install anyzig"
      },
      "args": []
    },
    {
      "namespace": "anyzig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to anyzig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "anyzig",
        "passthrough": true,
        "missingDependencyHelp": "Install anyzig: pip install anyzig"
      },
      "args": []
    }
  ]
}