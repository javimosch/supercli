{
  "name": "anyzig",
  "version": "0.1.0",
  "description": "One zig to rule them all",
  "source": "https://github.com/nickelc/anyzig",
  "checks": [
    {
      "type": "binary",
      "name": "anyzig"
    }
  ],
  "install_guidance": {
    "plugin": "anyzig",
    "binary": "anyzig",
    "check": "which anyzig",
    "install_steps": [
      "cargo install anyzig",
      "Verify: anyzig --version",
      "supercli plugins install ./plugins/anyzig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "anyzig",
      "resource": "self",
      "action": "version",
      "description": "Print anyzig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "anyzig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install anyzig: cargo install anyzig"
      },
      "args": []
    },
    {
      "namespace": "anyzig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to anyzig",
      "adapter": "process",
      "adapterConfig": {
        "command": "anyzig",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install anyzig: cargo install anyzig"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
