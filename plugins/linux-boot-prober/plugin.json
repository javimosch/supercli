{
  "name": "linux-boot-prober",
  "version": "0.1.0",
  "description": "CLI tool: linux-boot-prober",
  "source": "https://manpages.debian.org/linux-boot-prober",
  "checks": [
    {
      "type": "binary",
      "name": "linux-boot-prober"
    }
  ],
  "install_guidance": {
    "plugin": "linux-boot-prober",
    "binary": "linux-boot-prober",
    "check": "which linux-boot-prober",
    "install_steps": [
      "apt-get install linux-boot-prober 2>/dev/null || which linux-boot-prober",
      "Verify: linux-boot-prober --version",
      "supercli plugins install ./plugins/linux-boot-prober --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linux-boot-prober",
      "resource": "self",
      "action": "version",
      "description": "Print linux-boot-prober version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux-boot-prober",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install linux-boot-prober: apt-get install linux-boot-prober 2>/dev/null || which linux-boot-prober"
      },
      "args": []
    },
    {
      "namespace": "linux-boot-prober",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to linux-boot-prober CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux-boot-prober",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install linux-boot-prober: apt-get install linux-boot-prober 2>/dev/null || which linux-boot-prober"
      },
      "args": []
    }
  ]
}