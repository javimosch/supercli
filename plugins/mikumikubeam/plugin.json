{
  "name": "mikumikubeam",
  "version": "0.1.0",
  "description": "Open-source network stress testing tool with anime aesthetics",
  "source": "https://github.com/sammwyy/MikuMikuBeam",
  "checks": [
    {
      "type": "binary",
      "name": "miku"
    }
  ],
  "install_guidance": {
    "plugin": "mikumikubeam",
    "binary": "miku",
    "check": "which miku",
    "install_steps": [
      "go install github.com/sammwyy/MikuMikuBeam@latest",
      "Verify: miku --version",
      "supercli plugins install ./plugins/mikumikubeam --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "mikumikubeam",
    "resource": "self",
    "action": "version",
    "description": "Print mikumikubeam version",
    "adapter": "process",
    "adapterConfig": {
      "command": "miku",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install mikumikubeam: go install github.com/sammwyy/MikuMikuBeam@latest"
    },
    "args": []
  },
  {
    "namespace": "mikumikubeam",
    "resource": "test",
    "action": "run",
    "description": "Run a network stress test",
    "adapter": "process",
    "adapterConfig": {
      "command": "miku",
      "passthrough": true,
      "missingDependencyHelp": "Install MikuMikuBeam: go install github.com/sammwyy/MikuMikuBeam@latest"
    },
    "args": []
  },
  {
    "namespace": "mikumikubeam",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to miku CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "miku",
      "passthrough": true,
      "missingDependencyHelp": "Install mikumikubeam"
    },
    "args": []
  }
]
}