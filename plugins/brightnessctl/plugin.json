{
  "name": "brightnessctl",
  "version": "0.1.0",
  "description": "Display brightness control tool",
  "source": "https://github.com/Hummer12007/brightnessctl",
  "checks": [
    {
      "type": "binary",
      "name": "brightnessctl"
    }
  ],
  "install_guidance": {
    "plugin": "brightnessctl",
    "binary": "brightnessctl",
    "check": "which brightnessctl",
    "install_steps": [
      "brew install brightnessctl",
      "Verify: brightnessctl --version",
      "supercli plugins install ./plugins/brightnessctl --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "brightnessctl",
      "resource": "self",
      "action": "version",
      "description": "Print brightnessctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "brightnessctl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install brightnessctl: brew install brightnessctl"
      },
      "args": []
    },
    {
      "namespace": "brightnessctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to brightnessctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "brightnessctl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install brightnessctl: brew install brightnessctl"
      },
      "args": []
    }
  ]
}
