{
  "name": "wx-cli",
  "version": "0.1.0",
  "description": "WeChat local data CLI with daemon architecture",
  "source": "https://github.com/jackwener/wx-cli",
  "checks": [
    {
      "type": "binary",
      "name": "wx-cli"
    }
  ],
  "install_guidance": {
    "plugin": "wx-cli",
    "binary": "wx-cli",
    "check": "which wx-cli",
    "install_steps": [
      "cargo install wx-cli",
      "Verify: wx-cli --version",
      "supercli plugins install ./plugins/wx-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "wx-cli",
    "resource": "self",
    "action": "version",
    "description": "Print wx-cli version",
    "adapter": "process",
    "adapterConfig": {
      "command": "wx-cli",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install wx-cli: cargo install wx-cli"
    },
    "args": []
  },
  {
    "namespace": "wx-cli",
    "resource": "data",
    "action": "read",
    "description": "Read local WeChat data",
    "adapter": "process",
    "adapterConfig": {
      "command": "wx-cli",
      "baseArgs": [
        "data",
        "read"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install wx-cli: cargo install wx-cli"
    },
    "args": []
  },
  {
    "namespace": "wx-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wx-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wx-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install wx-cli"
    },
    "args": []
  }
]
}