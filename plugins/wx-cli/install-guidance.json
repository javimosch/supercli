{
  "plugin": "wx-cli",
  "binary": "wx-cli",
  "check": "which wx-cli",
  "install_steps": [
    "cargo install wx-cli",
    "Verify: wx-cli --version",
    "supercli plugins install ./plugins/wx-cli --on-conflict replace --json"
  ],
  "note": "WeChat local data CLI with daemon architecture. Reads local WeChat data files."
}