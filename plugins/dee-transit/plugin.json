{
  "name": "dee-transit",
  "version": "0.1.0",
  "description": "Get route directions and transit info via CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-transit" }],
  "install_guidance": {
    "plugin": "dee-transit",
    "binary": "dee-transit",
    "check": "which dee-transit",
    "install_steps": ["cargo install dee-transit", "Verify: dee-transit --version", "supercli plugins install ./plugins/dee-transit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-transit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-transit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-transit",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-transit: cargo install dee-transit"
    },
    "args": []
  }]
}
