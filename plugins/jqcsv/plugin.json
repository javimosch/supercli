{
  "name": "jqcsv",
  "version": "0.1.0",
  "description": "Process CSV files with jq-like queries — JSON output for pipeline integration",
  "source": "https://github.com/jqcsv/jqcsv",
  "checks": [
    {
      "type": "binary",
      "name": "jqcsv"
    }
  ],
  "install_guidance": {
    "plugin": "jqcsv",
    "binary": "jqcsv",
    "check": "which jqcsv",
    "install_steps": [
      "npm install -g jqcsv",
      "Verify: jqcsv --version",
      "supercli plugins install ./plugins/jqcsv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jqcsv",
      "resource": "self",
      "action": "version",
      "description": "Print jqcsv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jqcsv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jqcsv: npm install -g jqcsv"
      },
      "args": []
    },
    {
      "namespace": "jqcsv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jqcsv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jqcsv",
        "passthrough": true,
        "missingDependencyHelp": "Install jqcsv: npm install -g jqcsv"
      },
      "args": []
    }
  ]
}
