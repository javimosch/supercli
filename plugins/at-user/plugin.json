{
  "name": "at-user",
  "version": "0.1.0",
  "description": "CLI tool: at-user",
  "source": "https://packages.debian.org/at-user",
  "checks": [{ "type": "binary", "name": "at-user" }],
  "install_guidance": {
    "plugin": "at-user", "binary": "at-user", "check": "which at-user",
    "install_steps": ["apt-get install at-user 2>/dev/null || which at-user", "Verify: at-user --version", "supercli plugins install ./plugins/at-user --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-user", "resource": "_", "action": "_",
    "description": "Passthrough to at-user CLI",
    "adapter": "process", "adapterConfig": { "command": "at-user", "passthrough": true, "missingDependencyHelp": "Install at-user: apt-get install at-user" }, "args": []
  }]
}
