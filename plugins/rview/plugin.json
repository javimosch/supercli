{
  "name": "rview",
  "version": "1.0.0",
  "description": "rview \u2014 rview \u2014 CLI utility",
  "source": "/usr/bin/rview",
  "checks": [
    {
      "type": "binary",
      "name": "rview"
    }
  ],
  "install_guidance": {
    "plugin": "rview",
    "binary": "rview",
    "check": "which rview",
    "install_steps": [
      "# Install rview:",
      "# apt: sudo apt-get install rview",
      "# brew: brew install rview",
      "# cargo: cargo install rview",
      "# npm: npm install -g rview",
      "# pip: pip install rview",
      "# or download from /usr/bin/rview"
    ]
  },
  "commands": [
    {
      "namespace": "rview",
      "resource": "rview",
      "action": "run",
      "description": "Run rview",
      "adapter": "process",
      "adapterConfig": {
        "command": "rview",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rview from /usr/bin/rview"
      },
      "args": []
    }
  ]
}