{
  "plugin": "rview",
  "binary": "rview",
  "check": "which rview",
  "install_steps": [
    "# Install rview",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rview-linux-amd64 -o /usr/local/bin/rview",
    "chmod +x /usr/local/bin/rview",
    "# Or via package manager, see /usr/bin/rview"
  ]
}