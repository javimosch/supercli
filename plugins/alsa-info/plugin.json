{
  "name": "alsa-info",
  "version": "0.1.0",
  "description": "CLI tool: alsa-info",
  "source": "https://packages.debian.org/alsa-info",
  "checks": [{ "type": "binary", "name": "alsa-info" }],
  "install_guidance": {
    "plugin": "alsa-info", "binary": "alsa-info", "check": "which alsa-info",
    "install_steps": ["apt-get install alsa-info 2>/dev/null || which alsa-info", "Verify: alsa-info --version", "supercli plugins install ./plugins/alsa-info --on-conflict replace --json"]
