  "commands": [{
    "namespace": "alsa-info", "resource": "_", "action": "_",
    "description": "Passthrough to alsa-info CLI",
    "adapter": "process", "adapterConfig": { "command": "alsa-info", "passthrough": true, "missingDependencyHelp": "Install alsa-info: apt-get install alsa-info" }, "args": []
  }]
}
