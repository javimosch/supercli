{
  "name": "databasus",
  "version": "0.1.0",
  "description": "PostgreSQL backup and point-in-time recovery tool",
  "source": "https://github.com/nicholasgasior/databasus",
  "checks": [
    {
      "type": "binary",
      "name": "databasus"
    }
  ],
  "install_guidance": {
    "plugin": "databasus",
    "binary": "databasus",
    "check": "which databasus",
    "install_steps": [
      "go install github.com/nicholasgasior/databasus@latest",
      "Verify: databasus --version",
      "supercli plugins install ./plugins/databasus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "databasus",
      "resource": "self",
      "action": "version",
      "description": "Print databasus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "databasus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install databasus: go install github.com/nicholasgasior/databasus@latest"
      },
      "args": []
    },
    {
      "namespace": "databasus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to databasus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "databasus",
        "passthrough": true,
        "missingDependencyHelp": "Install databasus: go install github.com/nicholasgasior/databasus@latest"
      },
      "args": []
    }
  ]
}
