{
  "name": "semtools",
  "version": "0.1.0",
  "description": "Semantic Search CLI",
  "source": "https://github.com/run-llama/semtools",
  "checks": [
    { "type": "binary", "name": "semtools" }
  ],
  "install_guidance": {
    "plugin": "semtools",
    "binary": "semtools",
    "check": "which semtools",
    "install_steps": [
      "cargo install semtools",
      "Verify: semtools --version",
      "supercli plugins install ./plugins/semtools --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "semtools",
      "resource": "self",
      "action": "version",
      "description": "Print semtools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "semtools",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install semtools: cargo install semtools"
      },
      "args": []
    },
    {
      "namespace": "semtools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to semtools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "semtools",
        "passthrough": true,
        "missingDependencyHelp": "Install semtools"
      },
      "args": []
    }
  ]
}
