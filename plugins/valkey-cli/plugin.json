{
  "name": "valkey-cli",
  "version": "1.0.0",
  "description": "valkey-cli \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=valkey-cli+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "valkey-cli"
    }
  ],
  "install_guidance": {
    "plugin": "valkey-cli",
    "binary": "valkey-cli",
    "check": "which valkey-cli",
    "install_steps": [
      "Install valkey-cli via package manager: apt install valkey-cli or brew install valkey-cli"
    ]
  },
  "commands": [
    {
      "namespace": "valkeycli",
      "resource": "run",
      "action": "exec",
      "description": "valkey-cli \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "valkey-cli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install valkey-cli via your package manager"
      },
      "args": []
    }
  ]
}