{
  "name": "dum",
  "version": "0.1.0",
  "description": "Npm scripts runner written in Rust",
  "source": "https://github.com/egoist/dum",
  "checks": [
    {
      "type": "binary",
      "name": "dum"
    }
  ],
  "install_guidance": {
    "plugin": "dum",
    "binary": "dum",
    "check": "which dum",
    "install_steps": [
      "brew install dum",
      "Verify: dum --version",
      "supercli plugins install ./plugins/dum --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dum",
      "resource": "self",
      "action": "version",
      "description": "Print dum version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dum",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dum: brew install dum"
      },
      "args": []
    },
    {
      "namespace": "dum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dum CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dum",
        "passthrough": true,
        "missingDependencyHelp": "Install dum"
      },
      "args": []
    }
  ]
}