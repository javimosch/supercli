{
  "name": "wunderground-cli",
  "version": "0.1.0",
  "description": "Weather data CLI utilizing the Wunderground API",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "wunderground-cli" }],
  "install_guidance": {
    "plugin": "wunderground-cli",
    "binary": "wunderground-cli",
    "check": "which wunderground-cli",
    "install_steps": ["npm install -g wunderground-cli", "Verify: wunderground-cli --version", "supercli plugins install ./plugins/wunderground-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wunderground-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wunderground-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wunderground-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install wunderground-cli: npm install -g wunderground-cli"
    },
    "args": []
  }]
}
