{
  "name": "runiq",
  "version": "0.1.0",
  "description": "Deduplicate lines efficiently (Rust) — faster uniq replacement",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "runiq" }],
  "install_guidance": {
    "plugin": "runiq",
    "binary": "runiq",
    "check": "which runiq",
    "install_steps": ["cargo install runiq", "which runiq", "Verify: runiq --version", "supercli plugins install ./plugins/runiq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "runiq",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to runiq CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "runiq",
      "passthrough": true,
      "missingDependencyHelp": "Install runiq: cargo install runiq"
    },
    "args": []
  }]
}
