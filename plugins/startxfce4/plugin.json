{
  "name": "startxfce4",
  "version": "0.1.0",
  "description": "CLI tool: startxfce4",
  "source": "https://manpages.debian.org/startxfce4",
  "checks": [
    {
      "type": "binary",
      "name": "startxfce4"
    }
  ],
  "install_guidance": {
    "plugin": "startxfce4",
    "binary": "startxfce4",
    "check": "which startxfce4",
    "install_steps": [
      "apt-get install startxfce4 2>/dev/null || which startxfce4",
      "Verify: startxfce4 --version",
      "supercli plugins install ./plugins/startxfce4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "startxfce4",
      "resource": "self",
      "action": "version",
      "description": "Print startxfce4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "startxfce4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install startxfce4: apt-get install startxfce4 2>/dev/null || which startxfce4"
      },
      "args": []
    },
    {
      "namespace": "startxfce4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to startxfce4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "startxfce4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install startxfce4: apt-get install startxfce4 2>/dev/null || which startxfce4"
      },
      "args": []
    }
  ]
}