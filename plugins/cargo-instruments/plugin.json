{
  "name": "cargo-instruments",
  "version": "0.1.0",
  "description": "Easily generate Instruments traces for your rust crate",
  "source": "https://github.com/cmyr/cargo-instruments",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-instruments"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-instruments",
    "binary": "cargo-instruments",
    "check": "which cargo-instruments",
    "install_steps": [
      "brew install cargo-instruments",
      "Verify: cargo-instruments --version",
      "supercli plugins install ./plugins/cargo-instruments --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cargo-instruments",
      "resource": "self",
      "action": "version",
      "description": "Print cargo-instruments version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-instruments",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-instruments: brew install cargo-instruments"
      },
      "args": []
    },
    {
      "namespace": "cargo-instruments",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-instruments CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-instruments",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-instruments"
      },
      "args": []
    }
  ]
}