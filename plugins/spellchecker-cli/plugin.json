{
  "name": "spellchecker-cli",
  "version": "0.1.0",
  "description": "Fast spellchecker CLI using SymSpell algorithm",
  "source": "https://github.com/tbroadley/spellchecker-cli",
  "checks": [{ "type": "binary", "name": "spellchecker-cli" }],
  "install_guidance": {
    "plugin": "spellchecker-cli",
    "binary": "spellchecker-cli",
    "check": "which spellchecker-cli",
    "install_steps": ["npm install -g spellchecker-cli", "Verify: spellchecker-cli --version", "supercli plugins install ./plugins/spellchecker-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "spellchecker-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to spellchecker-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "spellchecker-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install spellchecker-cli: npm install -g spellchecker-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
