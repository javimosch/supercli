{
  "name": "firmware",
  "version": "0.1.0",
  "description": "Predatory ESP32 Firmware",
  "source": "https://github.com/firmware/firmware",
  "checks": [
    {
      "type": "binary",
      "name": "firmware"
    }
  ],
  "install_guidance": {
    "plugin": "firmware",
    "binary": "firmware",
    "check": "which firmware",
    "install_steps": [
      "pip install firmware",
      "Verify: firmware --version",
      "supercli plugins install ./plugins/firmware --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "firmware",
      "resource": "self",
      "action": "version",
      "description": "Print firmware version",
      "adapter": "process",
      "adapterConfig": {
        "command": "firmware",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install firmware: pip install firmware"
      },
      "args": []
    },
    {
      "namespace": "firmware",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to firmware CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "firmware",
        "passthrough": true,
        "missingDependencyHelp": "Install firmware: pip install firmware"
      },
      "args": []
    }
  ]
}