{
  "name": "pnmenlarge",
  "version": "0.1.0",
  "description": "CLI tool: pnmenlarge",
  "source": "https://manpages.debian.org/pnmenlarge",
  "checks": [
    {
      "type": "binary",
      "name": "pnmenlarge"
    }
  ],
  "install_guidance": {
    "plugin": "pnmenlarge",
    "binary": "pnmenlarge",
    "check": "which pnmenlarge",
    "install_steps": [
      "apt-get install pnmenlarge 2>/dev/null || which pnmenlarge",
      "Verify: pnmenlarge --version",
      "supercli plugins install ./plugins/pnmenlarge --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmenlarge",
      "resource": "self",
      "action": "version",
      "description": "Print pnmenlarge version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmenlarge",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmenlarge: apt-get install pnmenlarge 2>/dev/null || which pnmenlarge"
      },
      "args": []
    },
    {
      "namespace": "pnmenlarge",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmenlarge CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmenlarge",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmenlarge: apt-get install pnmenlarge 2>/dev/null || which pnmenlarge"
      },
      "args": []
    }
  ]
}