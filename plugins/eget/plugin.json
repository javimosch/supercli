{
  "name": "eget",
  "version": "1.0.0",
  "description": "eget \u2014 Install prebuilt binaries",
  "source": "github.com/zyedidia/eget",
  "checks": [
    {
      "type": "binary",
      "name": "eget"
    }
  ],
  "install_guidance": {
    "plugin": "eget",
    "binary": "eget",
    "check": "which eget",
    "install_steps": [
      "# Install eget:",
      "# apt: sudo apt-get install eget",
      "# brew: brew install eget",
      "# cargo: cargo install eget",
      "# npm: npm install -g eget",
      "# pip: pip install eget",
      "# or download from github.com/zyedidia/eget"
    ]
  },
  "commands": [
    {
      "namespace": "eget",
      "resource": "eget",
      "action": "run",
      "description": "Run eget",
      "adapter": "process",
      "adapterConfig": {
        "command": "eget",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install eget from github.com/zyedidia/eget"
      },
      "args": []
    }
  ]
}