{
  "name": "obscura",
  "version": "0.1.0",
  "description": "The headless browser for AI agents and web scraping",
  "source": "https://github.com/obscura/obscura",
  "checks": [
    {
      "type": "binary",
      "name": "obscura"
    }
  ],
  "install_guidance": {
    "plugin": "obscura",
    "binary": "obscura",
    "check": "which obscura",
    "install_steps": [
      "pip install obscura",
      "Verify: obscura --version",
      "supercli plugins install ./plugins/obscura --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "obscura",
      "resource": "self",
      "action": "version",
      "description": "Print obscura version",
      "adapter": "process",
      "adapterConfig": {
        "command": "obscura",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install obscura: pip install obscura"
      },
      "args": []
    },
    {
      "namespace": "obscura",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to obscura CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "obscura",
        "passthrough": true,
        "missingDependencyHelp": "Install obscura: pip install obscura"
      },
      "args": []
    }
  ]
}