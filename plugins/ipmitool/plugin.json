{
  "name": "ipmitool",
  "version": "1.0.0",
  "description": "ipmitool \u2014 IPMI management",
  "source": "github.com/ipmitool/ipmitool",
  "checks": [
    {
      "type": "binary",
      "name": "ipmitool"
    }
  ],
  "install_guidance": {
    "plugin": "ipmitool",
    "binary": "ipmitool",
    "check": "which ipmitool",
    "install_steps": [
      "# Install ipmitool",
      "# See github.com/ipmitool/ipmitool",
      "# apt: sudo apt-get install ipmitool",
      "# brew: brew install ipmitool",
      "# cargo: cargo install ipmitool",
      "# npm: npm install -g ipmitool",
      "# pip: pip install ipmitool"
    ]
  },
  "commands": [
    {
      "namespace": "ipmitool",
      "resource": "ipmitool",
      "action": "run",
      "description": "Run ipmitool",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipmitool",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ipmitool from github.com/ipmitool/ipmitool"
      },
      "args": []
    }
  ]
}