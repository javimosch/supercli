{
  "name": "TrackWeight",
  "version": "0.1.0",
  "description": "Use your Mac trackpad as a weighing scale",
  "source": "https://github.com/TrackWeight/TrackWeight",
  "checks": [
    {
      "type": "binary",
      "name": "trackweight"
    }
  ],
  "install_guidance": {
    "plugin": "TrackWeight",
    "binary": "trackweight",
    "check": "which trackweight",
    "install_steps": [
      "pip install trackweight",
      "Verify: trackweight --version",
      "supercli plugins install ./plugins/TrackWeight --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TrackWeight",
      "resource": "self",
      "action": "version",
      "description": "Print TrackWeight version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trackweight",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TrackWeight: pip install trackweight"
      },
      "args": []
    },
    {
      "namespace": "TrackWeight",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trackweight CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trackweight",
        "passthrough": true,
        "missingDependencyHelp": "Install TrackWeight: pip install trackweight"
      },
      "args": []
    }
  ]
}