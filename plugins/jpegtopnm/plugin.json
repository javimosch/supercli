{
  "name": "jpegtopnm",
  "version": "0.1.0",
  "description": "CLI tool: jpegtopnm",
  "source": "https://manpages.debian.org/jpegtopnm",
  "checks": [
    {
      "type": "binary",
      "name": "jpegtopnm"
    }
  ],
  "install_guidance": {
    "plugin": "jpegtopnm",
    "binary": "jpegtopnm",
    "check": "which jpegtopnm",
    "install_steps": [
      "apt-get install jpegtopnm 2>/dev/null || which jpegtopnm",
      "Verify: jpegtopnm --version",
      "supercli plugins install ./plugins/jpegtopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jpegtopnm",
      "resource": "self",
      "action": "version",
      "description": "Print jpegtopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpegtopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jpegtopnm: apt-get install jpegtopnm 2>/dev/null || which jpegtopnm"
      },
      "args": []
    },
    {
      "namespace": "jpegtopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jpegtopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpegtopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jpegtopnm: apt-get install jpegtopnm 2>/dev/null || which jpegtopnm"
      },
      "args": []
    }
  ]
}