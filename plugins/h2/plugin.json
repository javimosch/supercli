{
  "name": "h2",
  "version": "1.0.0",
  "description": "h2 \u2014 HTTP/2 CLI",
  "source": "github.com/h2/h2",
  "checks": [
    {
      "type": "binary",
      "name": "h2"
    }
  ],
  "install_guidance": {
    "plugin": "h2",
    "binary": "h2",
    "check": "which h2",
    "install_steps": [
      "# Install h2",
      "# See github.com/h2/h2",
      "# apt: sudo apt-get install h2",
      "# brew: brew install h2",
      "# cargo: cargo install h2",
      "# npm: npm install -g h2",
      "# pip: pip install h2"
    ]
  },
  "commands": [
    {
      "namespace": "h2",
      "resource": "h2",
      "action": "run",
      "description": "Run h2",
      "adapter": "process",
      "adapterConfig": {
        "command": "h2",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install h2 from github.com/h2/h2"
      },
      "args": []
    }
  ]
}