{
  "name": "montage",
  "version": "0.1.0",
  "description": "Create image montages from multiple sources",
  "source": "https://packages.debian.org/montage",
  "checks": [{ "type": "binary", "name": "montage" }],
  "install_guidance": {
    "plugin": "montage", "binary": "montage", "check": "which montage",
    "install_steps": ["apt-get install imagemagick", "Verify: montage --version", "supercli plugins install ./plugins/montage --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "montage", "resource": "_", "action": "_",
    "description": "Passthrough to montage CLI",
    "adapter": "process", "adapterConfig": { "command": "montage", "passthrough": true, "missingDependencyHelp": "Install montage: apt-get install imagemagick" }, "args": []
  }]
}
