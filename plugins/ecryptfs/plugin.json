{
  "name": "ecryptfs",
  "version": "1.0.0",
  "description": "ecryptfs \u2014 Encrypted filesystem",
  "source": "ecryptfs.org",
  "checks": [
    {
      "type": "binary",
      "name": "ecryptfs"
    }
  ],
  "install_guidance": {
    "plugin": "ecryptfs",
    "binary": "ecryptfs",
    "check": "which ecryptfs",
    "install_steps": [
      "# Install ecryptfs",
      "# See ecryptfs.org",
      "# apt: sudo apt-get install ecryptfs",
      "# brew: brew install ecryptfs",
      "# cargo: cargo install ecryptfs",
      "# npm: npm install -g ecryptfs",
      "# pip: pip install ecryptfs"
    ]
  },
  "commands": [
    {
      "namespace": "ecryptfs",
      "resource": "ecryptfs",
      "action": "run",
      "description": "Run ecryptfs",
      "adapter": "process",
      "adapterConfig": {
        "command": "ecryptfs",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ecryptfs from ecryptfs.org"
      },
      "args": []
    }
  ]
