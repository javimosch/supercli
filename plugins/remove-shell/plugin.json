{
  "name": "remove-shell",
  "version": "1.0.0",
  "description": "remove-shell \u2014 remove-shell \u2014 CLI utility",
  "source": "/usr/sbin/remove-shell",
  "checks": [
    {
      "type": "binary",
      "name": "remove-shell"
    }
  ],
  "install_guidance": {
    "plugin": "remove-shell",
    "binary": "remove-shell",
    "check": "which remove-shell",
    "install_steps": [
      "# Install remove-shell:",
      "# apt: sudo apt-get install remove-shell",
      "# brew: brew install remove-shell",
      "# cargo: cargo install remove-shell",
      "# npm: npm install -g remove-shell",
      "# pip: pip install remove-shell",
      "# or download from /usr/sbin/remove-shell"
    ]
  },
  "commands": [
    {
      "namespace": "remove",
      "resource": "shell",
      "action": "run",
      "description": "Run remove-shell",
      "adapter": "process",
      "adapterConfig": {
        "command": "remove-shell",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install remove-shell from /usr/sbin/remove-shell"
      },
      "args": []
    }
  ]
