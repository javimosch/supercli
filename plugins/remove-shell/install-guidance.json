{
  "plugin": "remove-shell",
  "binary": "remove-shell",
  "check": "which remove-shell",
  "install_steps": [
    "# Install remove-shell",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/remove-shell-linux-amd64 -o /usr/local/bin/remove-shell",
    "chmod +x /usr/local/bin/remove-shell",
    "# Or via package manager, see /usr/sbin/remove-shell"
  ]
}