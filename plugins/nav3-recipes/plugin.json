{
  "name": "nav3-recipes",
  "version": "0.1.0",
  "description": "Implement common use cases with Jetpack Navigation 3",
  "source": "https://github.com/nav3-recipes/nav3-recipes",
  "checks": [
    {
      "type": "binary",
      "name": "nav3-recipes"
    }
  ],
  "install_guidance": {
    "plugin": "nav3-recipes",
    "binary": "nav3-recipes",
    "check": "which nav3-recipes",
    "install_steps": [
      "pip install nav3-recipes",
      "Verify: nav3-recipes --version",
      "supercli plugins install ./plugins/nav3-recipes --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nav3-recipes",
      "resource": "self",
      "action": "version",
      "description": "Print nav3-recipes version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nav3-recipes",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nav3-recipes: pip install nav3-recipes"
      },
      "args": []
    },
    {
      "namespace": "nav3-recipes",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nav3-recipes CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nav3-recipes",
        "passthrough": true,
        "missingDependencyHelp": "Install nav3-recipes: pip install nav3-recipes"
      },
      "args": []
    }
  ]
}