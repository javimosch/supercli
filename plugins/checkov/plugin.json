{
  "name": "checkov",
  "version": "0.1.0",
  "description": "Static code analysis for IaC misconfigurations and security",
  "source": "https://github.com/bridgecrewio/checkov",
  "checks": [{ "type": "binary", "name": "checkov" }],
  "install_guidance": {
    "plugin": "checkov",
    "binary": "checkov",
    "check": "which checkov",
    "install_steps": ["pip install checkov", "Verify: checkov --version", "supercli plugins install ./plugins/checkov --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "checkov",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to checkov CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "checkov",
      "passthrough": true,
      "missingDependencyHelp": "Install checkov: pip install checkov"
    },
    "args": []
  }]
}
