{
  "name": "summon",
  "version": "0.1.0",
  "description": "CLI that provides on-demand secrets",
  "source": "https://github.com/cyberark/summon",
  "checks": [{ "type": "binary", "name": "summon" }],
  "install_guidance": {
    "plugin": "summon",
    "binary": "summon",
    "check": "which summon",
    "install_steps": ["brew install summon", "Verify: summon --version", "supercli plugins install ./plugins/summon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "summon",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to summon CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "summon",
      "passthrough": true,
      "missingDependencyHelp": "Install summon: brew install summon", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
