{
  "name": "mpv-remote",
  "version": "0.1.0",
  "description": "CLI remote control for MPV media player",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "mpv-remote" }],
  "install_guidance": {
    "plugin": "mpv-remote",
    "binary": "mpv-remote",
    "check": "which mpv-remote",
    "install_steps": ["git clone && pip install .", "Verify: mpv-remote --version", "supercli plugins install ./plugins/mpv-remote --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mpv-remote",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mpv-remote CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mpv-remote",
      "passthrough": true,
      "missingDependencyHelp": "Install mpv-remote: git clone && pip install ."
    },
    "args": []
  }]
}
