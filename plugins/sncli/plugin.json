{
  "name": "sncli",
  "version": "0.1.0",
  "description": "Simplenote command-line client with sync",
  "source": "https://github.com/insanum/sncli",
  "checks": [{ "type": "binary", "name": "sncli" }],
  "install_guidance": {
    "plugin": "sncli",
    "binary": "sncli",
    "check": "which sncli",
    "install_steps": ["pip install sncli", "Verify: sncli --version", "supercli plugins install ./plugins/sncli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sncli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sncli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sncli",
      "passthrough": true,
      "missingDependencyHelp": "Install sncli: pip install sncli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
