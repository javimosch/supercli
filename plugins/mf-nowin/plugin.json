{
  "name": "mf-nowin",
  "version": "0.1.0",
  "description": "CLI tool: mf-nowin",
  "source": "https://manpages.debian.org/mf-nowin",
  "checks": [
    {
      "type": "binary",
      "name": "mf-nowin"
    }
  ],
  "install_guidance": {
    "plugin": "mf-nowin",
    "binary": "mf-nowin",
    "check": "which mf-nowin",
    "install_steps": [
      "apt-get install mf-nowin 2>/dev/null || which mf-nowin",
      "Verify: mf-nowin --version",
      "supercli plugins install ./plugins/mf-nowin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mf-nowin",
      "resource": "self",
      "action": "version",
      "description": "Print mf-nowin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mf-nowin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mf-nowin: apt-get install mf-nowin 2>/dev/null || which mf-nowin"
      },
      "args": []
    },
    {
      "namespace": "mf-nowin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mf-nowin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mf-nowin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mf-nowin: apt-get install mf-nowin 2>/dev/null || which mf-nowin"
      },
      "args": []
    }
  ]
}