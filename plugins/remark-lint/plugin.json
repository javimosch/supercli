{
  "name": "remark-lint",
  "version": "0.1.0",
  "description": "Lint markdown files with pluggable rules",
  "source": "https://github.com/remarkjs/remark-lint",
  "checks": [{ "type": "binary", "name": "remark-lint" }],
  "install_guidance": {
    "plugin": "remark-lint",
    "binary": "remark-lint",
    "check": "which remark-lint",
    "install_steps": ["npm install -g remark-lint", "Verify: remark-lint --version", "supercli plugins install ./plugins/remark-lint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "remark-lint",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to remark-lint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "remark-lint",
      "passthrough": true,
      "missingDependencyHelp": "Install remark-lint: npm install -g remark-lint", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
