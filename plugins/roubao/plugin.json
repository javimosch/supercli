{
  "name": "roubao",
  "version": "0.1.0",
  "description": "Android Automation Tool Based on Vision-Language Models",
  "source": "https://github.com/roubao/roubao",
  "checks": [
    {
      "type": "binary",
      "name": "roubao"
    }
  ],
  "install_guidance": {
    "plugin": "roubao",
    "binary": "roubao",
    "check": "which roubao",
    "install_steps": [
      "pip install roubao",
      "Verify: roubao --version",
      "supercli plugins install ./plugins/roubao --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "roubao",
      "resource": "self",
      "action": "version",
      "description": "Print roubao version",
      "adapter": "process",
      "adapterConfig": {
        "command": "roubao",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install roubao: pip install roubao"
      },
      "args": []
    },
    {
      "namespace": "roubao",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to roubao CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "roubao",
        "passthrough": true,
        "missingDependencyHelp": "Install roubao: pip install roubao"
      },
      "args": []
    }
  ]
}