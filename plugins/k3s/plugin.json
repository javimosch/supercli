{
  "name": "k3s",
  "version": "0.1.0",
  "description": "Lightweight Kubernetes distribution",
  "source": "https://github.com/k3s-io/k3s",
  "checks": [{"type": "binary", "name": "k3s"}],
  "install_guidance": {
    "plugin": "k3s",
    "binary": "k3s",
    "check": "which k3s",
    "install_steps": [
      "curl -sfL https",
      "Verify: k3s --version",
      "supercli plugins install ./plugins/k3s --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "k3s",
      "resource": "self",
      "action": "version",
      "description": "Print k3s version",
      "adapter": "process",
      "adapterConfig": {"command": "k3s", "baseArgs": ["--version"], "missingDependencyHelp": "Install k3s: curl -sfL https"},
      "args": []
    },
    {
      "namespace": "k3s",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to k3s CLI",
      "adapter": "process",
      "adapterConfig": {"command": "k3s", "passthrough": true, "missingDependencyHelp": "Install k3s: curl -sfL https"},
      "args": []
    }
  ]
}
