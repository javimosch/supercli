{
  "name": "syslinux-legacy",
  "version": "0.1.0",
  "description": "CLI tool: syslinux-legacy",
  "source": "https://manpages.debian.org/syslinux-legacy",
  "checks": [
    {
      "type": "binary",
      "name": "syslinux-legacy"
    }
  ],
  "install_guidance": {
    "plugin": "syslinux-legacy",
    "binary": "syslinux-legacy",
    "check": "which syslinux-legacy",
    "install_steps": [
      "apt-get install syslinux-legacy 2>/dev/null || which syslinux-legacy",
      "Verify: syslinux-legacy --version",
      "supercli plugins install ./plugins/syslinux-legacy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "syslinux-legacy",
      "resource": "self",
      "action": "version",
      "description": "Print syslinux-legacy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "syslinux-legacy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install syslinux-legacy: apt-get install syslinux-legacy 2>/dev/null || which syslinux-legacy"
      },
      "args": []
    },
    {
      "namespace": "syslinux-legacy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to syslinux-legacy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "syslinux-legacy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install syslinux-legacy: apt-get install syslinux-legacy 2>/dev/null || which syslinux-legacy"
      },
      "args": []
    }
  ]
}