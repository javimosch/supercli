{
  "name": "colorpick-cli",
  "version": "0.1.0",
  "description": "Colorpicker which prints the colorcode to stdout.",
  "source": "https://github.com/colorpick-cli/colorpick-cli",
  "checks": [
    {
      "type": "binary",
      "name": "colorpick-cli"
    }
  ],
  "install_guidance": {
    "plugin": "colorpick-cli",
    "binary": "colorpick-cli",
    "check": "which colorpick-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: colorpick-cli --version",
      "supercli plugins install ./plugins/colorpick-cli --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "colorpick-cli",
      "resource": "self",
      "action": "version",
      "description": "Print colorpick-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "colorpick-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install colorpick-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "colorpick-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to colorpick-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "colorpick-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install colorpick-cli from project repository"
      },
      "args": []
    }
  ]
}