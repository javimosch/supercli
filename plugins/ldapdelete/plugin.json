{
  "name": "ldapdelete",
  "version": "0.1.0",
  "description": "ldapdelete \u2014 LDAP delete entry tool",
  "source": "https://manpages.debian.org/ldapdelete",
  "checks": [
    {
      "type": "binary",
      "name": "ldapdelete"
    }
  ],
  "install_guidance": {
    "plugin": "ldapdelete",
    "binary": "ldapdelete",
    "check": "which ldapdelete",
    "install_steps": [
      "apt-get install ldapdelete 2>/dev/null || which ldapdelete",
      "Verify: ldapdelete --version",
      "supercli plugins install ./plugins/ldapdelete --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ldapdelete",
      "resource": "self",
      "action": "version",
      "description": "Print ldapdelete version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapdelete",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ldapdelete: apt-get install ldapdelete 2>/dev/null || which ldapdelete"
      },
      "args": []
    },
    {
      "namespace": "ldapdelete",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ldapdelete CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapdelete",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ldapdelete: apt-get install ldapdelete 2>/dev/null || which ldapdelete"
      },
      "args": []
    }
  ]
}