{
  "name": "cli-piping",
  "version": "0.1.0",
  "description": "Testing CLI piping techniques",
  "source": "https://github.com/cli-piping/cli-piping",
  "checks": [
    {
      "type": "binary",
      "name": "cli-piping"
    }
  ],
  "install_guidance": {
    "plugin": "cli-piping",
    "binary": "cli-piping",
    "check": "which cli-piping",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cli-piping --version",
      "supercli plugins install ./plugins/cli-piping --on-conflict replace --json"
    ],
    "note": "Shell language CLI tool"
  },
  "commands": [
    {
      "namespace": "cli-piping",
      "resource": "self",
      "action": "version",
      "description": "Print cli-piping version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-piping",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-piping from project repository"
      },
      "args": []
    },
    {
      "namespace": "cli-piping",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-piping CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-piping",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-piping from project repository"
      },
      "args": []
    }
  ]
}