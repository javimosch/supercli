{
  "name": "mastra",
  "version": "0.1.0",
  "description": "From the team behind Gatsby, Mastra is a framework for building AI-powered applications and agents w",
  "source": "https://github.com/mastra/mastra",
  "checks": [
    {
      "type": "binary",
      "name": "mastra"
    }
  ],
  "install_guidance": {
    "plugin": "mastra",
    "binary": "mastra",
    "check": "which mastra",
    "install_steps": [
      "pip install mastra",
      "Verify: mastra --version",
      "supercli plugins install ./plugins/mastra --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mastra",
      "resource": "self",
      "action": "version",
      "description": "Print mastra version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mastra",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mastra: pip install mastra"
      },
      "args": []
    },
    {
      "namespace": "mastra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mastra CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mastra",
        "passthrough": true,
        "missingDependencyHelp": "Install mastra: pip install mastra"
      },
      "args": []
    }
  ]
}