{
  "name": "ppmtoeyuv",
  "version": "0.1.0",
  "description": "CLI tool: ppmtoeyuv",
  "source": "https://manpages.debian.org/ppmtoeyuv",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtoeyuv"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtoeyuv",
    "binary": "ppmtoeyuv",
    "check": "which ppmtoeyuv",
    "install_steps": [
      "apt-get install ppmtoeyuv 2>/dev/null || which ppmtoeyuv",
      "Verify: ppmtoeyuv --version",
      "supercli plugins install ./plugins/ppmtoeyuv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtoeyuv",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtoeyuv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoeyuv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtoeyuv: apt-get install ppmtoeyuv 2>/dev/null || which ppmtoeyuv"
      },
      "args": []
    },
    {
      "namespace": "ppmtoeyuv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtoeyuv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoeyuv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtoeyuv: apt-get install ppmtoeyuv 2>/dev/null || which ppmtoeyuv"
      },
      "args": []
    }
  ]
}