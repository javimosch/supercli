{
  "name": "pbmtoascii",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoascii",
  "source": "https://manpages.debian.org/pbmtoascii",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoascii"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoascii",
    "binary": "pbmtoascii",
    "check": "which pbmtoascii",
    "install_steps": [
      "apt-get install pbmtoascii 2>/dev/null || which pbmtoascii",
      "Verify: pbmtoascii --version",
      "supercli plugins install ./plugins/pbmtoascii --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoascii",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoascii version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoascii",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoascii: apt-get install pbmtoascii 2>/dev/null || which pbmtoascii"
      },
      "args": []
    },
    {
      "namespace": "pbmtoascii",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoascii CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoascii",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoascii: apt-get install pbmtoascii 2>/dev/null || which pbmtoascii"
      },
      "args": []
    }
  ]
}