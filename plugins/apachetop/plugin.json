{
  "name": "apachetop",
  "version": "0.1.0",
  "description": "Top-like display of Apache log",
  "source": "https://github.com/tessus/apachetop",
  "checks": [
    {
      "type": "binary",
      "name": "apachetop"
    }
  ],
  "install_guidance": {
    "plugin": "apachetop",
    "binary": "apachetop",
    "check": "which apachetop",
    "install_steps": [
      "brew install apachetop",
      "Verify: apachetop --version",
      "supercli plugins install ./plugins/apachetop --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "apachetop",
      "resource": "self",
      "action": "version",
      "description": "Print apachetop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "apachetop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install apachetop: brew install apachetop"
      },
      "args": []
    },
    {
      "namespace": "apachetop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to apachetop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "apachetop",
        "passthrough": true,
        "missingDependencyHelp": "Install apachetop"
      },
      "args": []
    }
  ]
}