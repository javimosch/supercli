{
  "name": "translate-c",
  "version": "0.1.0",
  "description": "A Zig package for translating C code into Zig code.",
  "source": "https://github.com/translate-c/translate-c",
  "checks": [
    {
      "type": "binary",
      "name": "translate-c"
    }
  ],
  "install_guidance": {
    "plugin": "translate-c",
    "binary": "translate-c",
    "check": "which translate-c",
    "install_steps": [
      "pip install translate-c",
      "Verify: translate-c --version",
      "supercli plugins install ./plugins/translate-c --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "translate-c",
      "resource": "self",
      "action": "version",
      "description": "Print translate-c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "translate-c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install translate-c: pip install translate-c"
      },
      "args": []
    },
    {
      "namespace": "translate-c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to translate-c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "translate-c",
        "passthrough": true,
        "missingDependencyHelp": "Install translate-c: pip install translate-c"
      },
      "args": []
    }
  ]
}