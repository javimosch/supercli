{
  "name": "foy",
  "version": "0.1.0",
  "description": "Lightweight general purpose task runner/build tool",
  "source": "https://github.com/zaaack/foy",
  "checks": [
    {
      "type": "binary",
      "name": "foy"
    }
  ],
  "install_guidance": {
    "plugin": "foy",
    "binary": "foy",
    "check": "which foy",
    "install_steps": [
      "See https://github.com/zaaack/foy",
      "Verify: foy --version",
      "supercli plugins install ./plugins/foy --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "foy",
      "resource": "self",
      "action": "version",
      "description": "Print foy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "foy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install foy: See https://github.com/zaaack/foy"
      },
      "args": []
    },
    {
      "namespace": "foy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to foy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "foy",
        "passthrough": true,
        "missingDependencyHelp": "Install foy"
      },
      "args": []
    }
  ]
}