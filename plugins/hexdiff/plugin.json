{
  "name": "hexdiff",
  "version": "0.1.0",
  "description": "CLI tool: hexdiff",
  "source": "https://packages.debian.org/hexdiff",
  "checks": [{ "type": "binary", "name": "hexdiff" }],
  "install_guidance": {
    "plugin": "hexdiff", "binary": "hexdiff", "check": "which hexdiff",
    "install_steps": ["which hexdiff", "Verify: hexdiff --version", "supercli plugins install ./plugins/hexdiff --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hexdiff", "resource": "_", "action": "_",
    "description": "Passthrough to hexdiff CLI",
    "adapter": "process",
    "adapterConfig": { "command": "hexdiff", "passthrough": true,
    "missingDependencyHelp": "Install hexdiff: which hexdiff" }, "args": []
  }]
}
