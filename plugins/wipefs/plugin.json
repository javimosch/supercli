{
  "name": "wipefs",
  "version": "0.1.0",
  "description": "Wipe filesystem signatures from devices",
  "source": "https://packages.debian.org/wipefs",
  "checks": [
    { "type": "binary", "name": "wipefs" }
  ],
  "install_guidance": {
    "plugin": "wipefs",
    "binary": "wipefs",
    "check": "which wipefs",
    "install_steps": [
      "apt-get install util-linux",
      "Verify: wipefs --version",
      "supercli plugins install ./plugins/wipefs --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "wipefs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wipefs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wipefs",
        "passthrough": true,
        "missingDependencyHelp": "Install wipefs: apt-get install util-linux"
      },
      "args": []
    }
  ]
}
