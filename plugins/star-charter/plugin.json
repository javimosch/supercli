{
  "name": "star-charter",
  "version": "0.1.0",
  "description": "Generate vector-graphics charts of the night sky in SVG/PDF/PNG",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "star-charter" }],
  "install_guidance": {
    "plugin": "star-charter",
    "binary": "star-charter",
    "check": "which star-charter",
    "install_steps": ["git clone && ./setup.sh", "Verify: star-charter --version", "supercli plugins install ./plugins/star-charter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "star-charter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to star-charter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "star-charter",
      "passthrough": true,
      "missingDependencyHelp": "Install star-charter: git clone && ./setup.sh"
    },
    "args": []
  }]
}
