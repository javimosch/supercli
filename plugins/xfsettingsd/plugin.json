{
  "name": "xfsettingsd",
  "version": "0.1.0",
  "description": "CLI tool: xfsettingsd",
  "source": "https://manpages.debian.org/xfsettingsd",
  "checks": [
    {
      "type": "binary",
      "name": "xfsettingsd"
    }
  ],
  "install_guidance": {
    "plugin": "xfsettingsd",
    "binary": "xfsettingsd",
    "check": "which xfsettingsd",
    "install_steps": [
      "apt-get install xfsettingsd 2>/dev/null || which xfsettingsd",
      "Verify: xfsettingsd --version",
      "supercli plugins install ./plugins/xfsettingsd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfsettingsd",
      "resource": "self",
      "action": "version",
      "description": "Print xfsettingsd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfsettingsd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfsettingsd: apt-get install xfsettingsd 2>/dev/null || which xfsettingsd"
      },
      "args": []
    },
    {
      "namespace": "xfsettingsd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfsettingsd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfsettingsd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfsettingsd: apt-get install xfsettingsd 2>/dev/null || which xfsettingsd"
      },
      "args": []
    }
  ]
}