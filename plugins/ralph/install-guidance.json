{
  "plugin": "ralph",
  "binary": "ralph",
  "check": "ralph --help",
  "install_steps": [
    "curl -LO https://github.com/javimosch/ralph-cli/releases/latest/download/ralph-linux-amd64",
    "chmod +x ralph-linux-amd64",
    "sudo mv ralph-linux-amd64 /usr/local/bin/ralph",
    "ralph --help",
    "supercli plugins install ./plugins/ralph --on-conflict replace --json"
  ],
  "note": "Go binary from javimosch/ralph-cli (MIT). Requires an agent CLI (opencode, claude, codex) installed and available in PATH for story execution."
}
