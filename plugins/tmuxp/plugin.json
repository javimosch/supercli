{
  "name": "tmuxp",
  "version": "0.1.0",
  "description": "tmuxp \u2014 tmux session manager. Create, manage, and attach to tmux sessions via YAML/JSON configs.",
  "source": "https://github.com/tmux-python/tmuxp",
  "checks": [
    {
      "type": "binary",
      "name": "tmuxp"
    }
  ],
  "install_guidance": {
    "plugin": "tmuxp",
    "binary": "tmuxp",
    "check": "which tmuxp",
    "install_steps": [
      "pip install tmuxp",
      "brew install tmuxp",
      "supercli plugins install ./plugins/tmuxp --on-conflict replace --json"
    ],
    "note": "Python. Tmux session manager."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tmuxp",
      "resource": "session",
      "action": "load",
      "description": "Load a tmux session from config file",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxp",
        "missingDependencyHelp": "Install tmuxp",
        "baseArgs": [
          "load"
        ],
        "positionalArgs": [
          "file"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "file",
          "type": "string",
          "required": true,
          "description": "file path"
        }
      ]
    },
    {
      "namespace": "tmuxp",
      "resource": "session",
      "action": "list",
      "description": "List tmux sessions",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxp",
        "missingDependencyHelp": "Install tmuxp",
        "baseArgs": [
          "ls"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "tmuxp",
      "resource": "session",
      "action": "freeze",
      "description": "Freeze a tmux session to config",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxp",
        "missingDependencyHelp": "Install tmuxp",
        "baseArgs": [
          "freeze"
        ],
        "positionalArgs": [
          "name"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "name path"
        }
      ]
    },
    {
      "namespace": "tmuxp",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxp",
        "missingDependencyHelp": "Install tmuxp",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
