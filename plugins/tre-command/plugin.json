{
  "name": "tre-command",
  "version": "0.1.0",
  "description": "Tree directory listing with limit support",
  "source": "https://github.com/dduan/tre",
  "checks": [
    {
      "type": "binary",
      "name": "tre"
    }
  ],
  "install_guidance": {
    "plugin": "tre-command",
    "binary": "tre",
    "check": "which tre",
    "install_steps": [
      "cargo install tre-command",
      "Verify: tre --version",
      "supercli plugins install ./plugins/tre-command --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "tre-command",
      "resource": "self",
      "action": "version",
      "description": "Print tre-command version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tre",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tre-command: cargo install tre-command"
      },
      "args": []
    },
    {
      "namespace": "tre-command",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tre CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tre",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tre-command: cargo install tre-command"
      },
      "args": []
    }
  ]
}
