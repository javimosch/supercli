{
  "name": "dusky",
  "version": "0.1.0",
  "description": "Arch-Hyprland dotfiles/distro. A true labor of Passion, Consider rewarding with a star. ",
  "source": "https://github.com/dusky/dusky",
  "checks": [
    {
      "type": "binary",
      "name": "dusky"
    }
  ],
  "install_guidance": {
    "plugin": "dusky",
    "binary": "dusky",
    "check": "which dusky",
    "install_steps": [
      "pip install dusky",
      "Verify: dusky --version",
      "supercli plugins install ./plugins/dusky --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dusky",
      "resource": "self",
      "action": "version",
      "description": "Print dusky version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dusky",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dusky: pip install dusky"
      },
      "args": []
    },
    {
      "namespace": "dusky",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dusky CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dusky",
        "passthrough": true,
        "missingDependencyHelp": "Install dusky: pip install dusky"
      },
      "args": []
    }
  ]
}