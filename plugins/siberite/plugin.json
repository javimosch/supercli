{
  "name": "siberite",
  "version": "0.1.0",
  "description": "Lightweight leveldb-backed message queue server",
  "source": "go",
  "checks": [{ "type": "binary", "name": "siberite" }],
  "install_guidance": {
    "plugin": "siberite",
    "binary": "siberite",
    "check": "which siberite",
    "install_steps": ["go install github.com/siberite@latest", "Verify: siberite --version", "supercli plugins install ./plugins/siberite --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "siberite",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to siberite CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "siberite",
      "passthrough": true,
      "missingDependencyHelp": "Install siberite: go install github.com/siberite@latest"
    },
    "args": []
  }]
}
