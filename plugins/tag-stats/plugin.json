{
  "name": "tag-stats",
  "version": "0.1.0",
  "description": "Calculate frequency of OpenStreetMap tags in pbf files",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "tag-stats" }],
  "install_guidance": {
    "plugin": "tag-stats",
    "binary": "tag-stats",
    "check": "which tag-stats",
    "install_steps": ["cargo install tag-stats", "Verify: tag-stats --version", "supercli plugins install ./plugins/tag-stats --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tag-stats",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tag-stats CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tag-stats",
      "passthrough": true,
      "missingDependencyHelp": "Install tag-stats: cargo install tag-stats"
    },
    "args": []
  }]
}
