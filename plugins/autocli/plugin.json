{
  "name": "autocli",
  "version": "0.1.0",
  "description": "Fetch information from any website with a single command, covering 55+ sites",
  "source": "https://github.com/nashsu/AutoCLI",
  "checks": [
    {
      "type": "binary",
      "name": "autocli"
    }
  ],
  "install_guidance": {
    "plugin": "autocli",
    "binary": "autocli",
    "check": "which autocli",
    "install_steps": [
      "cargo install autocli",
      "Verify: autocli --version",
      "supercli plugins install ./plugins/autocli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "autocli",
    "resource": "self",
    "action": "version",
    "description": "Print autocli version",
    "adapter": "process",
    "adapterConfig": {
      "command": "autocli",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install autocli: cargo install autocli"
    },
    "args": []
  },
  {
    "namespace": "autocli",
    "resource": "web",
    "action": "fetch",
    "description": "Fetch information from a website",
    "adapter": "process",
    "adapterConfig": {
      "command": "autocli",
      "baseArgs": [
        "fetch"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install autocli: cargo install autocli"
    },
    "args": []
  },
  {
    "namespace": "autocli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to autocli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "autocli",
      "passthrough": true,
      "missingDependencyHelp": "Install autocli"
    },
    "args": []
  }
]
}