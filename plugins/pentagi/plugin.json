{
  "name": "pentagi",
  "version": "0.1.0",
  "description": "Fully autonomous AI Agents system capable of performing complex penetration testing tasks",
  "source": "https://github.com/pentagi/pentagi",
  "checks": [
    {
      "type": "binary",
      "name": "pentagi"
    }
  ],
  "install_guidance": {
    "plugin": "pentagi",
    "binary": "pentagi",
    "check": "which pentagi",
    "install_steps": [
      "pip install pentagi",
      "Verify: pentagi --version",
      "supercli plugins install ./plugins/pentagi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pentagi",
      "resource": "self",
      "action": "version",
      "description": "Print pentagi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pentagi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pentagi: pip install pentagi"
      },
      "args": []
    },
    {
      "namespace": "pentagi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pentagi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pentagi",
        "passthrough": true,
        "missingDependencyHelp": "Install pentagi: pip install pentagi"
      },
      "args": []
    }
  ]
}