{
  "plugin": "runuser",
  "binary": "runuser",
  "check": "which runuser",
  "install_steps": [
    "# Install runuser",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/runuser-linux-amd64 -o /usr/local/bin/runuser",
    "chmod +x /usr/local/bin/runuser",
    "# Or via package manager, see /usr/sbin/runuser"
  ]
}