{
  "name": "runuser",
  "version": "1.0.0",
  "description": "runuser — runuser — CLI utility",
  "source": "https://github.com/util-linux/util-linux",
  "checks": [
    {
      "type": "binary",
      "name": "runuser"
    }
  ],
  "install_guidance": {
    "plugin": "runuser",
    "binary": "runuser",
    "check": "which runuser",
    "install_steps": [
      "# Install runuser:",
      "# apt: sudo apt-get install runuser",
      "# brew: brew install runuser",
      "# cargo: cargo install runuser",
      "# npm: npm install -g runuser",
      "# pip: pip install runuser",
      "# or download from /usr/sbin/runuser"
    ]
  },
  "commands": [
    {
      "namespace": "runuser",
      "resource": "runuser",
      "action": "run",
      "description": "Run runuser",
      "adapter": "process",
      "adapterConfig": {
        "command": "runuser",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install runuser from /usr/sbin/runuser"
      },
      "args": []
    }
  ]
}
