{
  "name": "gtop",
  "version": "0.1.0",
  "description": "Graphical system monitoring dashboard for the terminal",
  "source": "https://github.com/aksakalli/gtop",
  "checks": [{ "type": "binary", "name": "gtop" }],
  "install_guidance": {
    "plugin": "gtop",
    "binary": "gtop",
    "check": "which gtop",
    "install_steps": ["npm install -g gtop", "Verify: gtop --version", "supercli plugins install ./plugins/gtop --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gtop",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gtop CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gtop",
      "passthrough": true,
      "missingDependencyHelp": "Install gtop: npm install -g gtop", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
