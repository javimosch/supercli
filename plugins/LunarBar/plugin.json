{
  "name": "LunarBar",
  "version": "0.1.0",
  "description": "A compact lunar calendar for your macOS menu bar.",
  "source": "https://github.com/LunarBar/LunarBar",
  "checks": [
    {
      "type": "binary",
      "name": "lunarbar"
    }
  ],
  "install_guidance": {
    "plugin": "LunarBar",
    "binary": "lunarbar",
    "check": "which lunarbar",
    "install_steps": [
      "pip install lunarbar",
      "Verify: lunarbar --version",
      "supercli plugins install ./plugins/LunarBar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LunarBar",
      "resource": "self",
      "action": "version",
      "description": "Print LunarBar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lunarbar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LunarBar: pip install lunarbar"
      },
      "args": []
    },
    {
      "namespace": "LunarBar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lunarbar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lunarbar",
        "passthrough": true,
        "missingDependencyHelp": "Install LunarBar: pip install lunarbar"
      },
      "args": []
    }
  ]
}