{
  "name": "cuetools",
  "version": "0.1.0",
  "description": "Utilities for .cue and .toc files",
  "source": "https://github.com/svend/cuetools",
  "checks": [
    {
      "type": "binary",
      "name": "cuetools"
    }
  ],
  "install_guidance": {
    "plugin": "cuetools",
    "binary": "cuetools",
    "check": "which cuetools",
    "install_steps": [
      "brew install cuetools",
      "Verify: cuetools --version",
      "supercli plugins install ./plugins/cuetools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cuetools",
      "resource": "self",
      "action": "version",
      "description": "Print cuetools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuetools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cuetools: brew install cuetools"
      },
      "args": []
    },
    {
      "namespace": "cuetools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cuetools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuetools",
        "passthrough": true,
        "missingDependencyHelp": "Install cuetools"
      },
      "args": []
    }
  ]
}