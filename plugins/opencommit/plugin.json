{
  "name": "opencommit",
  "version": "0.1.0",
  "description": "OpenCommit CLI plugin — auto-generate conventional commit messages from staged changes using AI. Works with any git repo.",
  "source": "https://github.com/di-sukharev/opencommit",
  "checks": [
    { "type": "binary", "name": "oco" }
  ],
  "install_guidance": {
    "plugin": "opencommit",
    "binary": "oco",
    "check": "which oco",
    "install_steps": [
      "npm install -g opencommit",
      "Verify: oco --version",
      "supercli plugins install ./plugins/opencommit --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "oco",
      "resource": "commit",
      "action": "generate",
      "description": "Generate a conventional commit message from staged changes and auto-commit",
      "adapter": "process",
      "adapterConfig": {
        "command": "oco",
        "baseArgs": ["--yes"],
        "missingDependencyHelp": "Install opencommit: npm install -g opencommit"
      },
      "args": []
    },
    {
      "namespace": "oco",
      "resource": "commit",
      "action": "message",
      "description": "Generate a commit message only (no commit), printed to stdout. Also runs in markdown mode.",
      "adapter": "process",
      "adapterConfig": {
        "command": "oco",
        "baseArgs": ["--yes", "--message"],
        "missingDependencyHelp": "Install opencommit: npm install -g opencommit"
      },
      "args": []
    },
    {
      "namespace": "oco",
      "resource": "config",
      "action": "show",
      "description": "Describe all OpenCommit configuration parameters and their current values",
      "adapter": "process",
      "adapterConfig": {
        "command": "oco",
        "baseArgs": ["config", "describe"],
        "missingDependencyHelp": "Install opencommit: npm install -g opencommit"
      },
      "args": []
    },
    {
      "namespace": "oco",
      "resource": "config",
      "action": "get",
      "description": "Get a specific OpenCommit config value by key",
      "adapter": "process",
      "adapterConfig": {
        "command": "oco",
        "baseArgs": ["config", "get"],
        "positionalArgs": ["key"],
        "missingDependencyHelp": "Install opencommit: npm install -g opencommit"
      },
      "args": [
        { "name": "key", "type": "string", "required": true, "description": "Config key e.g. OCO_MODEL, OCO_PROVIDER" }
      ]
    },
    {
      "namespace": "oco",
      "resource": "config",
      "action": "set",
      "description": "Set a config key-value pair",
      "adapter": "process",
      "adapterConfig": {
        "command": "oco",
        "baseArgs": ["config", "set"],
        "positionalArgs": ["keyValue"],
        "missingDependencyHelp": "Install opencommit: npm install -g opencommit"
      },
      "args": [
        { "name": "keyValue", "type": "string", "required": true, "description": "Key=value pair, e.g. OCO_OPENAI_MODEL=gpt-4o or OCO_PROVIDER=openai" }
      ]
    },
    {
      "namespace": "oco",
      "resource": "self",
      "action": "version",
      "description": "Show OpenCommit CLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oco",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install opencommit: npm install -g opencommit"
      },
      "args": []
    },
    {
      "namespace": "oco",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oco CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oco",
        "passthrough": true,
        "missingDependencyHelp": "Install opencommit: npm install -g opencommit"
      },
      "args": []
    }
  ]
}
