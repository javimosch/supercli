{
  "name": "two_percent",
  "version": "0.1.0",
  "description": "Simple Rust-based fuzzy finder focused on speed",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "two_percent" }],
  "install_guidance": {
    "plugin": "two_percent",
    "binary": "two_percent",
    "check": "which two_percent",
    "install_steps": ["cargo install two_percent", "Verify: two_percent --version", "supercli plugins install ./plugins/two_percent --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "two_percent",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to two_percent CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "two_percent",
      "passthrough": true,
      "missingDependencyHelp": "Install two_percent: cargo install two_percent"
    },
    "args": []
  }]
}
