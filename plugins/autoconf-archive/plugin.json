{
  "name": "autoconf-archive",
  "version": "0.1.0",
  "description": "Collection of over 500 reusable autoconf macros",
  "checks": [
    {
      "type": "binary",
      "name": "autoconf-archive"
    }
  ],
  "install_guidance": {
    "plugin": "autoconf-archive",
    "binary": "autoconf-archive",
    "check": "which autoconf-archive",
    "install_steps": [
      "brew install autoconf-archive",
      "Verify: autoconf-archive --version",
      "supercli plugins install ./plugins/autoconf-archive --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "autoconf-archive",
      "resource": "self",
      "action": "version",
      "description": "Print autoconf-archive version",
      "adapter": "process",
      "adapterConfig": {
        "command": "autoconf-archive",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install autoconf-archive: brew install autoconf-archive"
      },
      "args": []
    },
    {
      "namespace": "autoconf-archive",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to autoconf-archive CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "autoconf-archive",
        "passthrough": true,
        "missingDependencyHelp": "Install autoconf-archive"
      },
      "args": []
    }
  ]
}