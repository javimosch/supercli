{
  "name": "tera-cli",
  "version": "0.1.0",
  "description": "CLI for the Tera templating engine (Jinja2-like syntax for Rust)",
  "source": "https://github.com/pando85/tera-cli",
  "checks": [
    {
      "type": "binary",
      "name": "tera"
    }
  ],
  "install_guidance": {
    "plugin": "tera-cli",
    "binary": "tera",
    "check": "which tera",
    "install_steps": [
      "cargo install tera-cli",
      "Verify: tera --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tera-cli",
      "resource": "self",
      "action": "version",
      "description": "Print tera-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tera",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install tera-cli: cargo install tera-cli"
      },
      "args": []
    },
    {
      "namespace": "tera-cli",
      "resource": "template",
      "action": "render",
      "description": "Render a Tera template with optional context data",
      "adapter": "process",
      "adapterConfig": {
        "command": "tera",
        "baseArgs": ["--cwd", "invoke_cwd"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tera-cli: cargo install tera-cli"
      },
      "args": []
    },
    {
      "namespace": "tera-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tera CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tera",
        "passthrough": true,
        "missingDependencyHelp": "Install tera-cli: cargo install tera-cli"
      },
      "args": []
    }
  ]
}