{
  "name": "snowfs",
  "version": "0.1.0",
  "description": "A fast, scalable version control system for binaries",
  "source": "https://github.com/snowtrack/snowfs",
  "checks": [
    {
      "type": "binary",
      "name": "snowfs"
    }
  ],
  "install_guidance": {
    "plugin": "snowfs",
    "binary": "snowfs",
    "check": "which snowfs",
    "install_steps": [
      "See https://github.com/snowtrack/snowfs",
      "Verify: snowfs --version",
      "supercli plugins install ./plugins/snowfs --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "snowfs",
      "resource": "self",
      "action": "version",
      "description": "Print snowfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "snowfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install snowfs: See https://github.com/snowtrack/snowfs"
      },
      "args": []
    },
    {
      "namespace": "snowfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to snowfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "snowfs",
        "passthrough": true,
        "missingDependencyHelp": "Install snowfs"
      },
      "args": []
    }
  ]
}