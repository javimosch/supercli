{
  "name": "kimi-cc",
  "version": "0.1.0",
  "description": "Use Kimi latest model(kimi-k2-0711-preview) to drive your Claude Code.",
  "source": "https://github.com/kimi-cc/kimi-cc",
  "checks": [
    {
      "type": "binary",
      "name": "kimi-cc"
    }
  ],
  "install_guidance": {
    "plugin": "kimi-cc",
    "binary": "kimi-cc",
    "check": "which kimi-cc",
    "install_steps": [
      "pip install kimi-cc",
      "Verify: kimi-cc --version",
      "supercli plugins install ./plugins/kimi-cc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kimi-cc",
      "resource": "self",
      "action": "version",
      "description": "Print kimi-cc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kimi-cc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kimi-cc: pip install kimi-cc"
      },
      "args": []
    },
    {
      "namespace": "kimi-cc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kimi-cc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kimi-cc",
        "passthrough": true,
        "missingDependencyHelp": "Install kimi-cc: pip install kimi-cc"
      },
      "args": []
    }
  ]
}