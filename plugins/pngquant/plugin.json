{
  "name": "pngquant",
  "version": "0.1.0",
  "description": "PNG compressor with quality and speed settings",
  "source": "https://github.com/kornelski/pngquant",
  "checks": [
    {
      "type": "binary",
      "name": "pngquant"
    }
  ],
  "install_guidance": {
    "plugin": "pngquant",
    "binary": "pngquant",
    "check": "which pngquant",
    "install_steps": [
      "brew install pngquant",
      "Verify: pngquant --version",
      "supercli plugins install ./plugins/pngquant --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "pngquant",
      "resource": "self",
      "action": "version",
      "description": "Print pngquant version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pngquant",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pngquant: brew install pngquant"
      },
      "args": []
    },
    {
      "namespace": "pngquant",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pngquant CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pngquant",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pngquant: brew install pngquant"
      },
      "args": []
    }
  ]
}
