{
  "name": "luajittex",
  "version": "0.1.0",
  "description": "CLI tool: luajittex",
  "source": "https://manpages.debian.org/luajittex",
  "checks": [
    {
      "type": "binary",
      "name": "luajittex"
    }
  ],
  "install_guidance": {
    "plugin": "luajittex",
    "binary": "luajittex",
    "check": "which luajittex",
    "install_steps": [
      "apt-get install luajittex 2>/dev/null || which luajittex",
      "Verify: luajittex --version",
      "supercli plugins install ./plugins/luajittex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "luajittex",
      "resource": "self",
      "action": "version",
      "description": "Print luajittex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "luajittex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install luajittex: apt-get install luajittex 2>/dev/null || which luajittex"
      },
      "args": []
    },
    {
      "namespace": "luajittex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to luajittex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "luajittex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install luajittex: apt-get install luajittex 2>/dev/null || which luajittex"
      },
      "args": []
    }
  ]
}