{
  "name": "examples",
  "version": "0.1.0",
  "description": "Examples demonstrating usage of Spring AI & Spring AI Alibaba \ud83d\udcdc",
  "source": "https://github.com/examples/examples",
  "checks": [
    {
      "type": "binary",
      "name": "examples"
    }
  ],
  "install_guidance": {
    "plugin": "examples",
    "binary": "examples",
    "check": "which examples",
    "install_steps": [
      "pip install examples",
      "Verify: examples --version",
      "supercli plugins install ./plugins/examples --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "examples",
      "resource": "self",
      "action": "version",
      "description": "Print examples version",
      "adapter": "process",
      "adapterConfig": {
        "command": "examples",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install examples: pip install examples"
      },
      "args": []
    },
    {
      "namespace": "examples",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to examples CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "examples",
        "passthrough": true,
        "missingDependencyHelp": "Install examples: pip install examples"
      },
      "args": []
    }
  ]
}