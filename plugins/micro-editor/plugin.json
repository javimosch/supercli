{
  "name": "micro-editor",
  "version": "0.1.0",
  "description": "Modern and intuitive terminal-based text editor",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "micro-editor" }],
  "install_guidance": {
    "plugin": "micro-editor",
    "binary": "micro-editor",
    "check": "which micro-editor",
    "install_steps": ["brew install micro", "Verify: micro-editor --version", "supercli plugins install ./plugins/micro-editor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "micro-editor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to micro-editor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "micro-editor",
      "passthrough": true,
      "missingDependencyHelp": "Install micro-editor: brew install micro"
    },
    "args": []
  }]
}
