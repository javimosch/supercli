{
  "name": "shirokhorshid-android",
  "version": "0.1.0",
  "description": "Independently maintained, community fork of Psiphon Android client",
  "source": "https://github.com/shirokhorshid-android/shirokhorshid-android",
  "checks": [
    {
      "type": "binary",
      "name": "shirokhorshid-android"
    }
  ],
  "install_guidance": {
    "plugin": "shirokhorshid-android",
    "binary": "shirokhorshid-android",
    "check": "which shirokhorshid-android",
    "install_steps": [
      "pip install shirokhorshid-android",
      "Verify: shirokhorshid-android --version",
      "supercli plugins install ./plugins/shirokhorshid-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "shirokhorshid-android",
      "resource": "self",
      "action": "version",
      "description": "Print shirokhorshid-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shirokhorshid-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shirokhorshid-android: pip install shirokhorshid-android"
      },
      "args": []
    },
    {
      "namespace": "shirokhorshid-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shirokhorshid-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shirokhorshid-android",
        "passthrough": true,
        "missingDependencyHelp": "Install shirokhorshid-android: pip install shirokhorshid-android"
      },
      "args": []
    }
  ]
}