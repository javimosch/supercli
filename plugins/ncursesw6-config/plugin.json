{
  "name": "ncursesw6-config",
  "version": "0.1.0",
  "description": "CLI tool: ncursesw6-config",
  "source": "https://manpages.debian.org/ncursesw6-config",
  "checks": [
    {
      "type": "binary",
      "name": "ncursesw6-config"
    }
  ],
  "install_guidance": {
    "plugin": "ncursesw6-config",
    "binary": "ncursesw6-config",
    "check": "which ncursesw6-config",
    "install_steps": [
      "apt-get install ncursesw6-config 2>/dev/null || which ncursesw6-config",
      "Verify: ncursesw6-config --version",
      "supercli plugins install ./plugins/ncursesw6-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ncursesw6-config",
      "resource": "self",
      "action": "version",
      "description": "Print ncursesw6-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncursesw6-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ncursesw6-config: apt-get install ncursesw6-config 2>/dev/null || which ncursesw6-config"
      },
      "args": []
    },
    {
      "namespace": "ncursesw6-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ncursesw6-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncursesw6-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ncursesw6-config: apt-get install ncursesw6-config 2>/dev/null || which ncursesw6-config"
      },
      "args": []
    }
  ]
}