{
  "name": "defguard-client",
  "version": "0.1.0",
  "description": "WireGuard client supporting multi-factor authentication",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "defguard-client" }],
  "install_guidance": {
    "plugin": "defguard-client",
    "binary": "defguard-client",
    "check": "which defguard-client",
    "install_steps": ["brew install --cask defguard-client", "Verify: defguard-client --version", "supercli plugins install ./plugins/defguard-client --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "defguard-client",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to defguard-client CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "defguard-client",
      "passthrough": true,
      "missingDependencyHelp": "Install defguard-client: brew install --cask defguard-client"
    },
    "args": []
  }]
}
