{
  "name": "seahorse",
  "version": "0.1.0",
  "description": "CLI tool: seahorse",
  "source": "https://manpages.debian.org/seahorse",
  "checks": [
    {
      "type": "binary",
      "name": "seahorse"
    }
  ],
  "install_guidance": {
    "plugin": "seahorse",
    "binary": "seahorse",
    "check": "which seahorse",
    "install_steps": [
      "apt-get install seahorse 2>/dev/null || which seahorse",
      "Verify: seahorse --version",
      "supercli plugins install ./plugins/seahorse --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "seahorse",
      "resource": "self",
      "action": "version",
      "description": "Print seahorse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "seahorse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install seahorse: apt-get install seahorse 2>/dev/null || which seahorse"
      },
      "args": []
    },
    {
      "namespace": "seahorse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to seahorse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "seahorse",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install seahorse: apt-get install seahorse 2>/dev/null || which seahorse"
      },
      "args": []
    }
  ]
}