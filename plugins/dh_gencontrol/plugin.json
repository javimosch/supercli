{
  "name": "dh_gencontrol",
  "version": "0.1.0",
  "description": "CLI tool: dh_gencontrol",
  "source": "https://packages.debian.org/dh_gencontrol",
  "checks": [{ "type": "binary", "name": "dh_gencontrol" }],
  "install_guidance": {
    "plugin": "dh_gencontrol", "binary": "dh_gencontrol", "check": "which dh_gencontrol",
    "install_steps": ["apt-get install dh_gencontrol 2>/dev/null || which dh_gencontrol", "Verify: dh_gencontrol --version", "supercli plugins install ./plugins/dh_gencontrol --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_gencontrol", "resource": "_", "action": "_",
    "description": "Passthrough to dh_gencontrol CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_gencontrol", "passthrough": true, "missingDependencyHelp": "Install dh_gencontrol: apt-get install dh_gencontrol" }, "args": []
  }]
}
