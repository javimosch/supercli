{
  "name": "htmlmin",
  "version": "0.1.0",
  "description": "Minify HTML files removing whitespace and comments",
  "source": "https://github.com/mankyd/htmlmin",
  "checks": [{ "type": "binary", "name": "htmlmin" }],
  "install_guidance": {
    "plugin": "htmlmin",
    "binary": "htmlmin",
    "check": "which htmlmin",
    "install_steps": ["pip install htmlmin", "Verify: htmlmin --version", "supercli plugins install ./plugins/htmlmin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "htmlmin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to htmlmin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "htmlmin",
      "passthrough": true,
      "missingDependencyHelp": "Install htmlmin: pip install htmlmin", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
