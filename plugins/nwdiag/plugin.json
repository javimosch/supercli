{
  "name": "nwdiag",
  "version": "0.1.0",
  "description": "Generate network topology diagrams from text descriptions",
  "source": "https://github.com/blockdiag/nwdiag",
  "checks": [{ "type": "binary", "name": "nwdiag" }],
  "install_guidance": {
    "plugin": "nwdiag",
    "binary": "nwdiag",
    "check": "which nwdiag",
    "install_steps": ["pip install nwdiag", "Verify: nwdiag --version", "supercli plugins install ./plugins/nwdiag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nwdiag",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nwdiag CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nwdiag",
      "passthrough": true,
      "missingDependencyHelp": "Install nwdiag: pip install nwdiag", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
