{
  "name": "compare",
  "version": "0.1.0",
  "description": "Compare images and highlight differences",
  "source": "https://packages.debian.org/compare",
  "checks": [{ "type": "binary", "name": "compare" }],
  "install_guidance": {
    "plugin": "compare", "binary": "compare", "check": "which compare",
    "install_steps": ["apt-get install imagemagick", "Verify: compare --version", "supercli plugins install ./plugins/compare --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "compare", "resource": "_", "action": "_",
    "description": "Passthrough to compare CLI",
    "adapter": "process", "adapterConfig": { "command": "compare", "passthrough": true, "missingDependencyHelp": "Install compare: apt-get install imagemagick" }, "args": []
  }]
}
