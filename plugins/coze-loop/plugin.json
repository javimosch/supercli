{
  "name": "coze-loop",
  "version": "0.1.0",
  "description": "Next-generation AI Agent Optimization Platform: Cozeloop addresses challenges in AI agent developmen",
  "source": "https://github.com/coze-loop/coze-loop",
  "checks": [
    {
      "type": "binary",
      "name": "coze-loop"
    }
  ],
  "install_guidance": {
    "plugin": "coze-loop",
    "binary": "coze-loop",
    "check": "which coze-loop",
    "install_steps": [
      "pip install coze-loop",
      "Verify: coze-loop --version",
      "supercli plugins install ./plugins/coze-loop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "coze-loop",
      "resource": "self",
      "action": "version",
      "description": "Print coze-loop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coze-loop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coze-loop: pip install coze-loop"
      },
      "args": []
    },
    {
      "namespace": "coze-loop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coze-loop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coze-loop",
        "passthrough": true,
        "missingDependencyHelp": "Install coze-loop: pip install coze-loop"
      },
      "args": []
    }
  ]
}