{
  "name": "slurp",
  "version": "0.1.0",
  "description": "Select a region in Wayland compositor in C",
  "source": "https://github.com/nicedoc/slurp",
  "checks": [
    {
      "type": "binary",
      "name": "slurp"
    }
  ],
  "install_guidance": {
    "plugin": "slurp",
    "binary": "slurp",
    "check": "which slurp",
    "install_steps": [
      "brew install slurp",
      "Verify: slurp --version",
      "supercli plugins install ./plugins/slurp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "slurp",
      "resource": "self",
      "action": "version",
      "description": "Print slurp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "slurp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install slurp: brew install slurp"
      },
      "args": []
    },
    {
      "namespace": "slurp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to slurp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "slurp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install slurp: brew install slurp"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
