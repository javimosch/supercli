{
  "name": "rtx",
  "version": "0.1.0",
  "description": "Polyglot runtime manager",
  "source": "https://github.com/jdx/rtx",
  "checks": [
    {
      "type": "binary",
      "name": "rtx"
    }
  ],
  "install_guidance": {
    "plugin": "rtx",
    "binary": "rtx",
    "check": "which rtx",
    "install_steps": [
      "brew install rtx",
      "Verify: rtx --version",
      "supercli plugins install ./plugins/rtx --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "rtx",
      "resource": "self",
      "action": "version",
      "description": "Print rtx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rtx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rtx: brew install rtx"
      },
      "args": []
    },
    {
      "namespace": "rtx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rtx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rtx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rtx: brew install rtx"
      },
      "args": []
    }
  ]
}
