{
  "name": "fesod",
  "version": "0.1.0",
  "description": "Fast. Easy. Done. Processing spreadsheets without worrying about large files causing OOM.",
  "source": "https://github.com/fesod/fesod",
  "checks": [
    {
      "type": "binary",
      "name": "fesod"
    }
  ],
  "install_guidance": {
    "plugin": "fesod",
    "binary": "fesod",
    "check": "which fesod",
    "install_steps": [
      "pip install fesod",
      "Verify: fesod --version",
      "supercli plugins install ./plugins/fesod --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fesod",
      "resource": "self",
      "action": "version",
      "description": "Print fesod version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fesod",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fesod: pip install fesod"
      },
      "args": []
    },
    {
      "namespace": "fesod",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fesod CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fesod",
        "passthrough": true,
        "missingDependencyHelp": "Install fesod: pip install fesod"
      },
      "args": []
    }
  ]
}