{
  "name": "AionUi",
  "version": "0.1.0",
  "description": "Free, local, open-source 24/7 Cowork app for OpenClaw, Hermes Agent, Claude Code, Codex, OpenCode, G",
  "source": "https://github.com/AionUi/AionUi",
  "checks": [
    {
      "type": "binary",
      "name": "aionui"
    }
  ],
  "install_guidance": {
    "plugin": "AionUi",
    "binary": "aionui",
    "check": "which aionui",
    "install_steps": [
      "pip install aionui",
      "Verify: aionui --version",
      "supercli plugins install ./plugins/AionUi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AionUi",
      "resource": "self",
      "action": "version",
      "description": "Print AionUi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aionui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AionUi: pip install aionui"
      },
      "args": []
    },
    {
      "namespace": "AionUi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aionui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aionui",
        "passthrough": true,
        "missingDependencyHelp": "Install AionUi: pip install aionui"
      },
      "args": []
    }
  ]
}