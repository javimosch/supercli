{
  "name": "subsync",
  "version": "0.1.0",
  "description": "CLI tool to synchronize srt/ssa subtitles with audio",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "subsync" }],
  "install_guidance": {
    "plugin": "subsync",
    "binary": "subsync",
    "check": "which subsync",
    "install_steps": ["pip install subsync", "Verify: subsync --version", "supercli plugins install ./plugins/subsync --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "subsync",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to subsync CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "subsync",
      "passthrough": true,
      "missingDependencyHelp": "Install subsync: pip install subsync"
    },
    "args": []
  }]
}
