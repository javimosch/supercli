{
  "name": "paperclip",
  "version": "0.1.0",
  "description": "The open-source app everyone uses to manage agents at work",
  "source": "https://github.com/paperclip/paperclip",
  "checks": [
    {
      "type": "binary",
      "name": "paperclip"
    }
  ],
  "install_guidance": {
    "plugin": "paperclip",
    "binary": "paperclip",
    "check": "which paperclip",
    "install_steps": [
      "pip install paperclip",
      "Verify: paperclip --version",
      "supercli plugins install ./plugins/paperclip --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "paperclip",
      "resource": "self",
      "action": "version",
      "description": "Print paperclip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "paperclip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install paperclip: pip install paperclip"
      },
      "args": []
    },
    {
      "namespace": "paperclip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to paperclip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "paperclip",
        "passthrough": true,
        "missingDependencyHelp": "Install paperclip: pip install paperclip"
      },
      "args": []
    }
  ]
}