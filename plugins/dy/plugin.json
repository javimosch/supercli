{
  "name": "dy",
  "version": "0.1.0",
  "description": "Construct YAML files from directory structures automatically",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "dy" }],
  "install_guidance": {
    "plugin": "dy",
    "binary": "dy",
    "check": "which dy",
    "install_steps": ["cargo install dy-yaml", "Verify: dy --version", "supercli plugins install ./plugins/dy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dy",
      "passthrough": true,
      "missingDependencyHelp": "Install dy: cargo install dy-yaml"
    },
    "args": []
  }]
}
