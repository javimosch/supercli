{
  "name": "git-remote-codecommit",
  "version": "0.1.0",
  "description": "Git Remote Helper to interact with AWS CodeCommit",
  "source": "https://github.com/aws/git-remote-codecommit",
  "checks": [
    {
      "type": "binary",
      "name": "git-remote-codecommit"
    }
  ],
  "install_guidance": {
    "plugin": "git-remote-codecommit",
    "binary": "git-remote-codecommit",
    "check": "which git-remote-codecommit",
    "install_steps": [
      "brew install git-remote-codecommit",
      "Verify: git-remote-codecommit --version",
      "supercli plugins install ./plugins/git-remote-codecommit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-remote-codecommit",
      "resource": "self",
      "action": "version",
      "description": "Print git-remote-codecommit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-remote-codecommit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-remote-codecommit: brew install git-remote-codecommit"
      },
      "args": []
    },
    {
      "namespace": "git-remote-codecommit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-remote-codecommit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-remote-codecommit",
        "passthrough": true,
        "missingDependencyHelp": "Install git-remote-codecommit"
      },
      "args": []
    }
  ]
}