{
  "plugin": "git-remote-codecommit",
  "binary": "git-remote-codecommit",
  "check": "which git-remote-codecommit",
  "install_steps": [
    "brew install git-remote-codecommit",
    "Verify: git-remote-codecommit --version",
    "supercli plugins install ./plugins/git-remote-codecommit --on-conflict replace --json"
  ],
  "note": "Install from package manager"
}