{
  "name": "at-jobs",
  "version": "0.1.0",
  "description": "CLI tool: at-jobs",
  "source": "https://packages.debian.org/at-jobs",
  "checks": [{ "type": "binary", "name": "at-jobs" }],
  "install_guidance": {
    "plugin": "at-jobs", "binary": "at-jobs", "check": "which at-jobs",
    "install_steps": ["apt-get install at-jobs 2>/dev/null || which at-jobs", "Verify: at-jobs --version", "supercli plugins install ./plugins/at-jobs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-jobs", "resource": "_", "action": "_",
    "description": "Passthrough to at-jobs CLI",
    "adapter": "process", "adapterConfig": { "command": "at-jobs", "passthrough": true, "missingDependencyHelp": "Install at-jobs: apt-get install at-jobs" }, "args": []
  }]
}
