{
  "name": "libdvdcss",
  "version": "0.1.0",
  "description": "Access DVDs as block devices without the decryption",
  "checks": [
    {
      "type": "binary",
      "name": "libdvdcss"
    }
  ],
  "install_guidance": {
    "plugin": "libdvdcss",
    "binary": "libdvdcss",
    "check": "which libdvdcss",
    "install_steps": [
      "brew install libdvdcss",
      "Verify: libdvdcss --version",
      "supercli plugins install ./plugins/libdvdcss --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libdvdcss",
      "resource": "self",
      "action": "version",
      "description": "Print libdvdcss version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libdvdcss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libdvdcss: brew install libdvdcss"
      },
      "args": []
    },
    {
      "namespace": "libdvdcss",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libdvdcss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libdvdcss",
        "passthrough": true,
        "missingDependencyHelp": "Install libdvdcss"
      },
      "args": []
    }
  ]
}