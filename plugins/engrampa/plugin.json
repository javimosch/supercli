{
  "name": "engrampa",
  "version": "0.1.0",
  "description": "MATE desktop archive manager CLI",
  "source": "https://github.com/mate-desktop/engrampa",
  "checks": [
    {
      "type": "binary",
      "name": "engrampa"
    }
  ],
  "install_guidance": {
    "plugin": "engrampa",
    "binary": "engrampa",
    "check": "which engrampa",
    "install_steps": [
      "brew install engrampa",
      "Verify: engrampa --version",
      "supercli plugins install ./plugins/engrampa --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "engrampa",
      "resource": "self",
      "action": "version",
      "description": "Print engrampa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "engrampa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install engrampa: brew install engrampa"
      },
      "args": []
    },
    {
      "namespace": "engrampa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to engrampa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "engrampa",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install engrampa: brew install engrampa"
      },
      "args": []
    }
  ]
}
