{
  "name": "omakub",
  "version": "0.1.0",
  "description": "Opinionated Ubuntu Setup",
  "source": "https://github.com/omakub/omakub",
  "checks": [
    {
      "type": "binary",
      "name": "omakub"
    }
  ],
  "install_guidance": {
    "plugin": "omakub",
    "binary": "omakub",
    "check": "which omakub",
    "install_steps": [
      "pip install omakub",
      "Verify: omakub --version",
      "supercli plugins install ./plugins/omakub --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "omakub",
      "resource": "self",
      "action": "version",
      "description": "Print omakub version",
      "adapter": "process",
      "adapterConfig": {
        "command": "omakub",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install omakub: pip install omakub"
      },
      "args": []
    },
    {
      "namespace": "omakub",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to omakub CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "omakub",
        "passthrough": true,
        "missingDependencyHelp": "Install omakub: pip install omakub"
      },
      "args": []
    }
  ]
}