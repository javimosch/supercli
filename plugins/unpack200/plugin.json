{
  "name": "unpack200",
  "version": "0.1.0",
  "description": "CLI tool: unpack200",
  "source": "https://manpages.debian.org/unpack200",
  "checks": [
    {
      "type": "binary",
      "name": "unpack200"
    }
  ],
  "install_guidance": {
    "plugin": "unpack200",
    "binary": "unpack200",
    "check": "which unpack200",
    "install_steps": [
      "apt-get install unpack200 2>/dev/null || which unpack200",
      "Verify: unpack200 --version",
      "supercli plugins install ./plugins/unpack200 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unpack200",
      "resource": "self",
      "action": "version",
      "description": "Print unpack200 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unpack200",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unpack200: apt-get install unpack200 2>/dev/null || which unpack200"
      },
      "args": []
    },
    {
      "namespace": "unpack200",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unpack200 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unpack200",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unpack200: apt-get install unpack200 2>/dev/null || which unpack200"
      },
      "args": []
    }
  ]
}