{
  "name": "pomodorotimer",
  "version": "0.1.0",
  "description": "Console Pomodoro timer in Python",
  "source": "https://github.com/nicedoc/pomodorotimer",
  "checks": [
    {
      "type": "binary",
      "name": "pomodorotimer"
    }
  ],
  "install_guidance": {
    "plugin": "pomodorotimer",
    "binary": "pomodorotimer",
    "check": "which pomodorotimer",
    "install_steps": [
      "pip install pomodorotimer",
      "Verify: pomodorotimer --version",
      "supercli plugins install ./plugins/pomodorotimer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pomodorotimer",
      "resource": "self",
      "action": "version",
      "description": "Print pomodorotimer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pomodorotimer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pomodorotimer: pip install pomodorotimer"
      },
      "args": []
    },
    {
      "namespace": "pomodorotimer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pomodorotimer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pomodorotimer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pomodorotimer: pip install pomodorotimer"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
