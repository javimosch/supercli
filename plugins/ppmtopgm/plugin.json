{
  "name": "ppmtopgm",
  "version": "0.1.0",
  "description": "CLI tool: ppmtopgm",
  "source": "https://manpages.debian.org/ppmtopgm",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtopgm"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtopgm",
    "binary": "ppmtopgm",
    "check": "which ppmtopgm",
    "install_steps": [
      "apt-get install ppmtopgm 2>/dev/null || which ppmtopgm",
      "Verify: ppmtopgm --version",
      "supercli plugins install ./plugins/ppmtopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtopgm",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtopgm: apt-get install ppmtopgm 2>/dev/null || which ppmtopgm"
      },
      "args": []
    },
    {
      "namespace": "ppmtopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtopgm: apt-get install ppmtopgm 2>/dev/null || which ppmtopgm"
      },
      "args": []
    }
  ]
}