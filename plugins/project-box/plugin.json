{
  "name": "project-box",
  "version": "0.1.0",
  "description": "C projects: algorithms, games, and networking",
  "source": "https://github.com/project-box/project-box",
  "checks": [
    {
      "type": "binary",
      "name": "project-box"
    }
  ],
  "install_guidance": {
    "plugin": "project-box",
    "binary": "project-box",
    "check": "which project-box",
    "install_steps": [
      "pip install project-box",
      "Verify: project-box --version",
      "supercli plugins install ./plugins/project-box --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "project-box",
      "resource": "self",
      "action": "version",
      "description": "Print project-box version",
      "adapter": "process",
      "adapterConfig": {
        "command": "project-box",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install project-box: pip install project-box"
      },
      "args": []
    },
    {
      "namespace": "project-box",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to project-box CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "project-box",
        "passthrough": true,
        "missingDependencyHelp": "Install project-box: pip install project-box"
      },
      "args": []
    }
  ]
}