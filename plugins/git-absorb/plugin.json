{
  "name": "git-absorb",
  "version": "0.1.0",
  "description": "git commit --fixup, but automatic — auto-create fixup commits for staged changes",
  "source": "https://github.com/tummychow/git-absorb",
  "checks": [
    { "type": "binary", "name": "git-absorb" }
  ],
  "install_guidance": {
    "plugin": "git-absorb",
    "binary": "git-absorb",
    "check": "which git-absorb",
    "install_steps": [
      "cargo install git-absorb",
      "Verify: git-absorb --version",
      "supercli plugins install ./plugins/git-absorb --on-conflict replace --json"
    ],
    "note": "Requires Rust/Cargo. Also available via Homebrew: brew install git-absorb"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "git-absorb",
      "resource": "self",
      "action": "version",
      "description": "Print git-absorb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-absorb",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install git-absorb: cargo install git-absorb"
      },
      "args": []
    },
    {
      "namespace": "git-absorb",
      "resource": "commit",
      "action": "absorb",
      "description": "Auto-create fixup commits for staged changes in the working copy",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-absorb",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install git-absorb: cargo install git-absorb"
      },
      "args": [
        { "name": "base", "type": "string", "required": false, "description": "Base ref to absorb into (e.g., origin/main)" },
        { "name": "dry-run", "type": "boolean", "required": false, "description": "Show what would be absorbed without making changes" },
        { "name": "and-rebase", "type": "boolean", "required": false, "description": "Auto-absorb and rebase" },
        { "name": "force", "type": "boolean", "required": false, "description": "Apply fixups even when conflicts might occur" }
      ]
    },
    {
      "namespace": "git-absorb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-absorb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-absorb",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "missingDependencyHelp": "Install git-absorb: cargo install git-absorb"
      },
      "args": []
    }
  ]
}
