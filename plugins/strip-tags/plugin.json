{
  "name": "strip-tags",
  "version": "0.1.0",
  "description": "Strip HTML tags from text for LLM processing",
  "source": "https://github.com/simonw/strip-tags",
  "checks": [{ "type": "binary", "name": "strip-tags" }],
  "install_guidance": {
    "plugin": "strip-tags",
    "binary": "strip-tags",
    "check": "which strip-tags",
    "install_steps": ["pip install strip-tags", "Verify: strip-tags --version", "supercli plugins install ./plugins/strip-tags --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "strip-tags",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to strip-tags CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "strip-tags",
      "passthrough": true,
      "missingDependencyHelp": "Install strip-tags: pip install strip-tags", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
