{
  "name": "sea-orm-cli",
  "version": "0.1.0",
  "description": "CLI for the SeaORM Rust asynchronous ORM framework",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "sea-orm-cli" }],
  "install_guidance": {
    "plugin": "sea-orm-cli",
    "binary": "sea-orm-cli",
    "check": "which sea-orm-cli",
    "install_steps": ["cargo install sea-orm-cli", "Verify: sea-orm-cli --version", "supercli plugins install ./plugins/sea-orm-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sea-orm-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sea-orm-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sea-orm-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install sea-orm-cli: cargo install sea-orm-cli"
    },
    "args": []
  }]
}
