{
  "name": "locate",
  "version": "0.1.0",
  "description": "locate — find files by name using a prebuilt database",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "locate"
    }
  ],
  "install_guidance": {
    "plugin": "locate",
    "binary": "locate",
    "check": "which locate",
    "install_steps": [
      "base system",
      "supercli plugins install ./plugins/locate --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "locate",
      "resource": "self",
      "action": "version",
      "description": "Print locate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "locate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install locate: base system"
      },
      "args": []
    },
    {
      "namespace": "locate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to locate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "locate",
        "passthrough": true,
        "missingDependencyHelp": "Install locate: base system"
      },
      "args": []
    }
  ]
}
