{
  "name": "Understand-Anything",
  "version": "0.1.0",
  "description": "Graphs that teach > graphs that impress. Turn any code into an interactive knowledge graph you can e",
  "source": "https://github.com/Understand-Anything/Understand-Anything",
  "checks": [
    {
      "type": "binary",
      "name": "understand-anything"
    }
  ],
  "install_guidance": {
    "plugin": "Understand-Anything",
    "binary": "understand-anything",
    "check": "which understand-anything",
    "install_steps": [
      "pip install understand-anything",
      "Verify: understand-anything --version",
      "supercli plugins install ./plugins/Understand-Anything --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Understand-Anything",
      "resource": "self",
      "action": "version",
      "description": "Print Understand-Anything version",
      "adapter": "process",
      "adapterConfig": {
        "command": "understand-anything",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Understand-Anything: pip install understand-anything"
      },
      "args": []
    },
    {
      "namespace": "Understand-Anything",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to understand-anything CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "understand-anything",
        "passthrough": true,
        "missingDependencyHelp": "Install Understand-Anything: pip install understand-anything"
      },
      "args": []
    }
  ]
}