{
  "name": "delta-git",
  "version": "0.1.0",
  "description": "Syntax-highlighting pager for git and diff output — JSON mode for structured diff data",
  "source": "https://github.com/dandavison/delta",
  "checks": [
    {
      "type": "binary",
      "name": "delta"
    }
  ],
  "install_guidance": {
    "plugin": "delta-git",
    "binary": "delta",
    "check": "which delta",
    "install_steps": [
      "cargo install git-delta",
      "Verify: delta --version",
      "supercli plugins install ./plugins/delta-git --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "delta-git",
      "resource": "self",
      "action": "version",
      "description": "Print delta-git version",
      "adapter": "process",
      "adapterConfig": {
        "command": "delta",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install delta-git: cargo install git-delta"
      },
      "args": []
    },
    {
      "namespace": "delta-git",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to delta CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "delta",
        "passthrough": true,
        "missingDependencyHelp": "Install delta-git: cargo install git-delta"
      },
      "args": []
    }
  ]
}
