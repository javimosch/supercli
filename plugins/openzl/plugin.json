{
  "name": "openzl",
  "version": "0.1.0",
  "description": "A novel data compression framework",
  "source": "https://github.com/openzl/openzl",
  "checks": [
    {
      "type": "binary",
      "name": "openzl"
    }
  ],
  "install_guidance": {
    "plugin": "openzl",
    "binary": "openzl",
    "check": "which openzl",
    "install_steps": [
      "pip install openzl",
      "Verify: openzl --version",
      "supercli plugins install ./plugins/openzl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openzl",
      "resource": "self",
      "action": "version",
      "description": "Print openzl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openzl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openzl: pip install openzl"
      },
      "args": []
    },
    {
      "namespace": "openzl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openzl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openzl",
        "passthrough": true,
        "missingDependencyHelp": "Install openzl: pip install openzl"
      },
      "args": []
    }
  ]
}