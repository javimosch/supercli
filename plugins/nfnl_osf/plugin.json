{
  "name": "nfnl_osf",
  "version": "0.1.0",
  "description": "CLI tool: nfnl_osf",
  "source": "https://manpages.debian.org/nfnl_osf",
  "checks": [
    {
      "type": "binary",
      "name": "nfnl_osf"
    }
  ],
  "install_guidance": {
    "plugin": "nfnl_osf",
    "binary": "nfnl_osf",
    "check": "which nfnl_osf",
    "install_steps": [
      "apt-get install nfnl_osf 2>/dev/null || which nfnl_osf",
      "Verify: nfnl_osf --version",
      "supercli plugins install ./plugins/nfnl_osf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nfnl_osf",
      "resource": "self",
      "action": "version",
      "description": "Print nfnl_osf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nfnl_osf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nfnl_osf: apt-get install nfnl_osf 2>/dev/null || which nfnl_osf"
      },
      "args": []
    },
    {
      "namespace": "nfnl_osf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nfnl_osf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nfnl_osf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nfnl_osf: apt-get install nfnl_osf 2>/dev/null || which nfnl_osf"
      },
      "args": []
    }
  ]
}