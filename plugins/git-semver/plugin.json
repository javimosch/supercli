{
  "name": "git-semver",
  "version": "0.1.0",
  "description": "Git semantic versioning CLI — calculate next version from git tags and commits",
  "source": "https://github.com/git-semver/git-semver",
  "checks": [
    {
      "type": "binary",
      "name": "git-semver"
    }
  ],
  "install_guidance": {
    "plugin": "git-semver",
    "binary": "git-semver",
    "check": "which git-semver",
    "install_steps": [
      "go install github.com/git-semver/git-semver@latest",
      "Verify: git-semver --version",
      "supercli plugins install ./plugins/git-semver --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "git-semver",
      "resource": "self",
      "action": "version",
      "description": "Print git-semver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-semver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-semver: go install github.com/git-semver/git-semver@latest"
      },
      "args": []
    },
    {
      "namespace": "git-semver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-semver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-semver",
        "passthrough": true,
        "missingDependencyHelp": "Install git-semver: go install github.com/git-semver/git-semver@latest"
      },
      "args": []
    }
  ]
}
