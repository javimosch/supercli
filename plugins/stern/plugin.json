{
  "name": "stern",
  "version": "0.1.0",
  "description": "Multi-pod and container log tailing for Kubernetes",
  "source": "https://github.com/stern/stern",
  "checks": [{ "type": "binary", "name": "stern" }],
  "install_guidance": {
    "plugin": "stern",
    "binary": "stern",
    "check": "which stern",
    "install_steps": ["brew install stern", "Verify: stern --version", "supercli plugins install ./plugins/stern --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "stern",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to stern CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "stern",
      "passthrough": true,
      "missingDependencyHelp": "Install stern: brew install stern"
    },
    "args": []
  }]
}
