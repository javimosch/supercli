{
  "name": "lconvert",
  "version": "0.1.0",
  "description": "CLI tool: lconvert",
  "source": "https://manpages.debian.org/lconvert",
  "checks": [
    {
      "type": "binary",
      "name": "lconvert"
    }
  ],
  "install_guidance": {
    "plugin": "lconvert",
    "binary": "lconvert",
    "check": "which lconvert",
    "install_steps": [
      "apt-get install lconvert 2>/dev/null || which lconvert",
      "Verify: lconvert --version",
      "supercli plugins install ./plugins/lconvert --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lconvert",
      "resource": "self",
      "action": "version",
      "description": "Print lconvert version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lconvert",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lconvert: apt-get install lconvert 2>/dev/null || which lconvert"
      },
      "args": []
    },
    {
      "namespace": "lconvert",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lconvert CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lconvert",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lconvert: apt-get install lconvert 2>/dev/null || which lconvert"
      },
      "args": []
    }
  ]
}