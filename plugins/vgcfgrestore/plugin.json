{
  "name": "vgcfgrestore",
  "version": "0.1.0",
  "description": "CLI tool: vgcfgrestore",
  "source": "https://manpages.debian.org/vgcfgrestore",
  "checks": [
    {
      "type": "binary",
      "name": "vgcfgrestore"
    }
  ],
  "install_guidance": {
    "plugin": "vgcfgrestore",
    "binary": "vgcfgrestore",
    "check": "which vgcfgrestore",
    "install_steps": [
      "apt-get install vgcfgrestore 2>/dev/null || which vgcfgrestore",
      "Verify: vgcfgrestore --version",
      "supercli plugins install ./plugins/vgcfgrestore --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vgcfgrestore",
      "resource": "self",
      "action": "version",
      "description": "Print vgcfgrestore version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgcfgrestore",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vgcfgrestore: apt-get install vgcfgrestore 2>/dev/null || which vgcfgrestore"
      },
      "args": []
    },
    {
      "namespace": "vgcfgrestore",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vgcfgrestore CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgcfgrestore",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vgcfgrestore: apt-get install vgcfgrestore 2>/dev/null || which vgcfgrestore"
      },
      "args": []
    }
  ]
}