{
  "name": "midi2audio-cli",
  "version": "0.1.0",
  "description": "CLI wrapper for converting MIDI files to audio formats",
  "source": "https://github.com/bzamecnik/midi2audio",
  "checks": [{ "type": "binary", "name": "midi2audio-cli" }],
  "install_guidance": {
    "plugin": "midi2audio-cli",
    "binary": "midi2audio-cli",
    "check": "which midi2audio-cli",
    "install_steps": ["pip install midi2audio", "Verify: midi2audio-cli --version", "supercli plugins install ./plugins/midi2audio-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "midi2audio-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to midi2audio-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "midi2audio-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install midi2audio-cli: pip install midi2audio", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
