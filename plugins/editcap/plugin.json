{
  "name": "editcap",
  "version": "0.1.0",
  "description": "Edit/transform packet capture files",
  "source": "https://packages.debian.org/editcap",
  "checks": [{ "type": "binary", "name": "editcap" }],
  "install_guidance": {
    "plugin": "editcap", "binary": "editcap", "check": "which editcap",
    "install_steps": ["apt-get install wireshark-common", "Verify: editcap --version", "supercli plugins install ./plugins/editcap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "editcap", "resource": "_", "action": "_",
    "description": "Passthrough to editcap CLI",
    "adapter": "process", "adapterConfig": { "command": "editcap", "passthrough": true, "missingDependencyHelp": "Install editcap: apt-get install wireshark-common" }, "args": []
  }]
}
