{
  "name": "auto",
  "version": "0.1.0",
  "description": "Automated releases with semantic versioning",
  "source": "https://github.com/intuit/auto",
  "checks": [{ "type": "binary", "name": "auto" }],
  "install_guidance": {
    "plugin": "auto",
    "binary": "auto",
    "check": "which auto",
    "install_steps": ["npm install -g auto", "Verify: auto --version", "supercli plugins install ./plugins/auto --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "auto",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to auto CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "auto",
      "passthrough": true,
      "missingDependencyHelp": "Install auto: npm install -g auto", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
