{
  "plugin": "grub-mklayout",
  "binary": "grub-mklayout",
  "check": "which grub-mklayout",
  "install_steps": [
    "apt-get install grub-mklayout 2>/dev/null || which grub-mklayout",
    "Verify: grub-mklayout --version",
    "supercli plugins install ./plugins/grub-mklayout --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}