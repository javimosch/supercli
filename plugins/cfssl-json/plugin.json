{
  "name": "cfssl-json",
  "version": "0.1.0",
  "description": "CloudFlare SSL toolkit with JSON output support",
  "source": "https://github.com/cloudflare/cfssl",
  "checks": [{ "type": "binary", "name": "cfssl-json" }],
  "install_guidance": {
    "plugin": "cfssl-json",
    "binary": "cfssl-json",
    "check": "which cfssl-json",
    "install_steps": ["go install github.com/cloudflare/cfssl/cmd/cfssl@latest", "Verify: cfssl-json --version", "supercli plugins install ./plugins/cfssl-json --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cfssl-json",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cfssl-json CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cfssl-json",
      "passthrough": true,
      "missingDependencyHelp": "Install cfssl-json: go install github.com/cloudflare/cfssl/cmd/cfssl@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
