{
  "name": "ktmpl",
  "version": "0.1.0",
  "description": "Parameterized templates for Kubernetes manifests",
  "source": "https://github.com/jimmycuadra/ktmpl",
  "checks": [
    {
      "type": "binary",
      "name": "ktmpl"
    }
  ],
  "install_guidance": {
    "plugin": "ktmpl",
    "binary": "ktmpl",
    "check": "which ktmpl",
    "install_steps": [
      "brew install ktmpl",
      "Verify: ktmpl --version",
      "supercli plugins install ./plugins/ktmpl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ktmpl",
      "resource": "self",
      "action": "version",
      "description": "Print ktmpl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ktmpl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ktmpl: brew install ktmpl"
      },
      "args": []
    },
    {
      "namespace": "ktmpl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ktmpl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ktmpl",
        "passthrough": true,
        "missingDependencyHelp": "Install ktmpl"
      },
      "args": []
    }
  ]
}