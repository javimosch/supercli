{
  "name": "claws",
  "version": "0.1.0",
  "description": "Interactive WebSocket client for debugging and testing servers",
  "source": "go",
  "checks": [{ "type": "binary", "name": "claws" }],
  "install_guidance": {
    "plugin": "claws",
    "binary": "claws",
    "check": "which claws",
    "install_steps": ["go get github.com/claws", "Verify: claws --version", "supercli plugins install ./plugins/claws --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "claws",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to claws CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "claws",
      "passthrough": true,
      "missingDependencyHelp": "Install claws: go get github.com/claws"
    },
    "args": []
  }]
}
