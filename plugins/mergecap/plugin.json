{
  "name": "mergecap",
  "version": "0.1.0",
  "description": "Merge multiple packet captures",
  "source": "https://packages.debian.org/mergecap",
  "checks": [{ "type": "binary", "name": "mergecap" }],
  "install_guidance": {
    "plugin": "mergecap", "binary": "mergecap", "check": "which mergecap",
    "install_steps": ["apt-get install wireshark-common", "Verify: mergecap --version", "supercli plugins install ./plugins/mergecap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mergecap", "resource": "_", "action": "_",
    "description": "Passthrough to mergecap CLI",
    "adapter": "process", "adapterConfig": { "command": "mergecap", "passthrough": true, "missingDependencyHelp": "Install mergecap: apt-get install wireshark-common" }, "args": []
  }]
}
