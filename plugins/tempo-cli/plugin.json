{
  "name": "tempo-cli",
  "version": "0.1.0",
  "description": "Command line tool for Tempo distributed tracing backend",
  "source": "https://github.com/grafana/tempo",
  "checks": [{ "type": "binary", "name": "tempo-cli" }],
  "install_guidance": {
    "plugin": "tempo-cli",
    "binary": "tempo-cli",
    "check": "which tempo-cli",
    "install_steps": ["brew install tempo-cli", "Verify: tempo-cli --version", "supercli plugins install ./plugins/tempo-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tempo-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tempo-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tempo-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install tempo-cli: brew install tempo-cli"
    },
    "args": []
  }]
}
