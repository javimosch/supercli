{
  "name": "xi-editor",
  "version": "0.1.0",
  "description": "Editor backend with native UI frontends",
  "source": "https://github.com/xi-editor/xi-editor",
  "checks": [{ "type": "binary", "name": "xi-editor" }],
  "install_guidance": {
    "plugin": "xi-editor",
    "binary": "xi-editor",
    "check": "which xi-editor",
    "install_steps": ["cargo install xi-editor", "Verify: xi-editor --version", "supercli plugins install ./plugins/xi-editor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "xi-editor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to xi-editor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "xi-editor",
      "passthrough": true,
      "missingDependencyHelp": "Install xi-editor: cargo install xi-editor", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
