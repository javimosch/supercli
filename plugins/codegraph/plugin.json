{
  "name": "codegraph",
  "version": "0.1.0",
  "description": "Pre-indexed code knowledge graph for Claude Code, Codex, Gemini, Cursor, OpenCode, AntiGravity, Kiro",
  "source": "https://github.com/codegraph/codegraph",
  "checks": [
    {
      "type": "binary",
      "name": "codegraph"
    }
  ],
  "install_guidance": {
    "plugin": "codegraph",
    "binary": "codegraph",
    "check": "which codegraph",
    "install_steps": [
      "pip install codegraph",
      "Verify: codegraph --version",
      "supercli plugins install ./plugins/codegraph --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "codegraph",
      "resource": "self",
      "action": "version",
      "description": "Print codegraph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codegraph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install codegraph: pip install codegraph"
      },
      "args": []
    },
    {
      "namespace": "codegraph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codegraph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codegraph",
        "passthrough": true,
        "missingDependencyHelp": "Install codegraph: pip install codegraph"
      },
      "args": []
    }
  ]
}