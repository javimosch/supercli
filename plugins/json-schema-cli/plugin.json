{
  "name": "json-schema-cli",
  "version": "0.1.0",
  "description": "Validate JSON files against a JSON Schema definition",
  "source": "https://github.com/gajus/json-schema-cli",
  "checks": [{ "type": "binary", "name": "json-schema-cli" }],
  "install_guidance": {
    "plugin": "json-schema-cli",
    "binary": "json-schema-cli",
    "check": "which json-schema-cli",
    "install_steps": ["npm install -g json-schema-cli", "Verify: json-schema-cli --version", "supercli plugins install ./plugins/json-schema-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "json-schema-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to json-schema-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "json-schema-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install json-schema-cli: npm install -g json-schema-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
