{
  "name": "pnmtile",
  "version": "0.1.0",
  "description": "CLI tool: pnmtile",
  "source": "https://manpages.debian.org/pnmtile",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtile"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtile",
    "binary": "pnmtile",
    "check": "which pnmtile",
    "install_steps": [
      "apt-get install pnmtile 2>/dev/null || which pnmtile",
      "Verify: pnmtile --version",
      "supercli plugins install ./plugins/pnmtile --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtile",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtile version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtile",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtile: apt-get install pnmtile 2>/dev/null || which pnmtile"
      },
      "args": []
    },
    {
      "namespace": "pnmtile",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtile CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtile",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtile: apt-get install pnmtile 2>/dev/null || which pnmtile"
      },
      "args": []
    }
  ]
}