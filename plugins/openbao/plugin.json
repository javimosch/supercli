{
  "name": "openbao",
  "version": "0.1.0",
  "description": "OpenBao is a software solution to manage, store, and distribute sensitive data including secrets, ce",
  "source": "https://github.com/openbao/openbao",
  "checks": [
    {
      "type": "binary",
      "name": "openbao"
    }
  ],
  "install_guidance": {
    "plugin": "openbao",
    "binary": "openbao",
    "check": "which openbao",
    "install_steps": [
      "pip install openbao",
      "Verify: openbao --version",
      "supercli plugins install ./plugins/openbao --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openbao",
      "resource": "self",
      "action": "version",
      "description": "Print openbao version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openbao",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openbao: pip install openbao"
      },
      "args": []
    },
    {
      "namespace": "openbao",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openbao CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openbao",
        "passthrough": true,
        "missingDependencyHelp": "Install openbao: pip install openbao"
      },
      "args": []
    }
  ]
}