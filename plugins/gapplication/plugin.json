{
  "name": "gapplication",
  "version": "0.1.0",
  "description": "CLI tool: gapplication",
  "source": "https://manpages.debian.org/gapplication",
  "checks": [
    {
      "type": "binary",
      "name": "gapplication"
    }
  ],
  "install_guidance": {
    "plugin": "gapplication",
    "binary": "gapplication",
    "check": "which gapplication",
    "install_steps": [
      "apt-get install gapplication 2>/dev/null || which gapplication",
      "Verify: gapplication --version",
      "supercli plugins install ./plugins/gapplication --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gapplication",
      "resource": "self",
      "action": "version",
      "description": "Print gapplication version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gapplication",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gapplication: apt-get install gapplication 2>/dev/null || which gapplication"
      },
      "args": []
    },
    {
      "namespace": "gapplication",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gapplication CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gapplication",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gapplication: apt-get install gapplication 2>/dev/null || which gapplication"
      },
      "args": []
    }
  ]
}