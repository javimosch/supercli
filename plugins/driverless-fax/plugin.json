{
  "name": "driverless-fax",
  "version": "0.1.0",
  "description": "CLI tool: driverless-fax",
  "source": "https://manpages.debian.org/driverless-fax",
  "checks": [
    {
      "type": "binary",
      "name": "driverless-fax"
    }
  ],
  "install_guidance": {
    "plugin": "driverless-fax",
    "binary": "driverless-fax",
    "check": "which driverless-fax",
    "install_steps": [
      "apt-get install driverless-fax 2>/dev/null || which driverless-fax",
      "Verify: driverless-fax --version",
      "supercli plugins install ./plugins/driverless-fax --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "driverless-fax",
      "resource": "self",
      "action": "version",
      "description": "Print driverless-fax version",
      "adapter": "process",
      "adapterConfig": {
        "command": "driverless-fax",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install driverless-fax: apt-get install driverless-fax 2>/dev/null || which driverless-fax"
      },
      "args": []
    },
    {
      "namespace": "driverless-fax",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to driverless-fax CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "driverless-fax",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install driverless-fax: apt-get install driverless-fax 2>/dev/null || which driverless-fax"
      },
      "args": []
    }
  ]
}