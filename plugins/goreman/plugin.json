{
  "name": "goreman",
  "version": "0.1.0",
  "description": "Foreman clone written in Go",
  "source": "https://github.com/mattn/goreman",
  "checks": [
    {
      "type": "binary",
      "name": "goreman"
    }
  ],
  "install_guidance": {
    "plugin": "goreman",
    "binary": "goreman",
    "check": "which goreman",
    "install_steps": [
      "brew install goreman",
      "Verify: goreman --version",
      "supercli plugins install ./plugins/goreman --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "goreman",
      "resource": "self",
      "action": "version",
      "description": "Print goreman version",
      "adapter": "process",
      "adapterConfig": {
        "command": "goreman",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install goreman: brew install goreman"
      },
      "args": []
    },
    {
      "namespace": "goreman",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to goreman CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "goreman",
        "passthrough": true,
        "missingDependencyHelp": "Install goreman"
      },
      "args": []
    }
  ]
}