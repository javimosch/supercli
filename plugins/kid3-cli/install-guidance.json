{
  "plugin": "kid3-cli",
  "binary": "kid3-cli",
  "check": "which kid3-cli",
  "install_steps": [
    "sudo apt-get install -y kid3-cli",
    "Verify: kid3-cli --version",
    "supercli plugins install ./plugins/kid3-cli --on-conflict replace --json"
  ],
  "note": "Debian/Ubuntu ship it as the kid3-cli package (no GUI deps beyond Qt core). macOS: brew install kid3."
}
