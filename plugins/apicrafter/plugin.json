{
  "name": "apicrafter",
  "version": "0.1.0",
  "description": "Generate API clients and documentation from OpenAPI specs",
  "source": "https://github.com/Devimal/apicrafter",
  "checks": [{ "type": "binary", "name": "apicrafter" }],
  "install_guidance": {
    "plugin": "apicrafter",
    "binary": "apicrafter",
    "check": "which apicrafter",
    "install_steps": ["npm install -g apicrafter", "Verify: apicrafter --version", "supercli plugins install ./plugins/apicrafter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apicrafter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to apicrafter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "apicrafter",
      "passthrough": true,
      "missingDependencyHelp": "Install apicrafter: npm install -g apicrafter"
    },
    "args": []
  }]
}
