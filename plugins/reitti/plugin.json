{
  "name": "reitti",
  "version": "0.1.0",
  "description": "Reitti is a comprehensive personal location tracking and analysis application that helps you underst",
  "source": "https://github.com/reitti/reitti",
  "checks": [
    {
      "type": "binary",
      "name": "reitti"
    }
  ],
  "install_guidance": {
    "plugin": "reitti",
    "binary": "reitti",
    "check": "which reitti",
    "install_steps": [
      "pip install reitti",
      "Verify: reitti --version",
      "supercli plugins install ./plugins/reitti --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "reitti",
      "resource": "self",
      "action": "version",
      "description": "Print reitti version",
      "adapter": "process",
      "adapterConfig": {
        "command": "reitti",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install reitti: pip install reitti"
      },
      "args": []
    },
    {
      "namespace": "reitti",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to reitti CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "reitti",
        "passthrough": true,
        "missingDependencyHelp": "Install reitti: pip install reitti"
      },
      "args": []
    }
  ]
}