{
  "name": "luajit",
  "version": "0.1.0",
  "description": "Just-in-time compiler for Lua",
  "source": "https://packages.debian.org/luajit",
  "checks": [{ "type": "binary", "name": "luajit" }],
  "install_guidance": {
    "plugin": "luajit", "binary": "luajit", "check": "which luajit",
    "install_steps": ["apt-get install luajit", "Verify: luajit --version", "supercli plugins install ./plugins/luajit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "luajit", "resource": "_", "action": "_",
    "description": "Passthrough to luajit CLI",
    "adapter": "process", "adapterConfig": { "command": "luajit", "passthrough": true, "missingDependencyHelp": "Install luajit: apt-get install luajit" }, "args": []
  }]
}
