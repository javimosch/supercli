{
  "plugin": "pwunconv",
  "binary": "pwunconv",
  "check": "which pwunconv",
  "install_steps": [
    "# Install pwunconv",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pwunconv-linux-amd64 -o /usr/local/bin/pwunconv",
    "chmod +x /usr/local/bin/pwunconv",
    "# Or via package manager, see /usr/sbin/pwunconv"
  ]
}