{
  "name": "libsass",
  "version": "0.1.0",
  "description": "C implementation of a Sass compiler",
  "source": "https://github.com/sass/libsass",
  "checks": [
    {
      "type": "binary",
      "name": "libsass"
    }
  ],
  "install_guidance": {
    "plugin": "libsass",
    "binary": "libsass",
    "check": "which libsass",
    "install_steps": [
      "brew install libsass",
      "Verify: libsass --version",
      "supercli plugins install ./plugins/libsass --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libsass",
      "resource": "self",
      "action": "version",
      "description": "Print libsass version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libsass",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libsass: brew install libsass"
      },
      "args": []
    },
    {
      "namespace": "libsass",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libsass CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libsass",
        "passthrough": true,
        "missingDependencyHelp": "Install libsass"
      },
      "args": []
    }
  ]
}