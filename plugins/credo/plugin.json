{
  "name": "credo",
  "version": "0.1.0",
  "description": "Static code analysis tool for the Elixir",
  "source": "https://github.com/rrrene/credo",
  "checks": [
    {
      "type": "binary",
      "name": "credo"
    }
  ],
  "install_guidance": {
    "plugin": "credo",
    "binary": "credo",
    "check": "which credo",
    "install_steps": [
      "brew install credo",
      "Verify: credo --version",
      "supercli plugins install ./plugins/credo --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "credo",
      "resource": "self",
      "action": "version",
      "description": "Print credo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "credo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install credo: brew install credo"
      },
      "args": []
    },
    {
      "namespace": "credo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to credo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "credo",
        "passthrough": true,
        "missingDependencyHelp": "Install credo"
      },
      "args": []
    }
  ]
}