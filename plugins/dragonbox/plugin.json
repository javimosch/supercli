{
  "name": "dragonbox",
  "version": "0.1.0",
  "description": "Reference implementation of Dragonbox in C++",
  "source": "https://github.com/jk-jeon/dragonbox",
  "checks": [
    {
      "type": "binary",
      "name": "dragonbox"
    }
  ],
  "install_guidance": {
    "plugin": "dragonbox",
    "binary": "dragonbox",
    "check": "which dragonbox",
    "install_steps": [
      "brew install dragonbox",
      "Verify: dragonbox --version",
      "supercli plugins install ./plugins/dragonbox --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dragonbox",
      "resource": "self",
      "action": "version",
      "description": "Print dragonbox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dragonbox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dragonbox: brew install dragonbox"
      },
      "args": []
    },
    {
      "namespace": "dragonbox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dragonbox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dragonbox",
        "passthrough": true,
        "missingDependencyHelp": "Install dragonbox"
      },
      "args": []
    }
  ]
}