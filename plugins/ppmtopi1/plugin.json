{
  "name": "ppmtopi1",
  "version": "0.1.0",
  "description": "CLI tool: ppmtopi1",
  "source": "https://manpages.debian.org/ppmtopi1",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtopi1"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtopi1",
    "binary": "ppmtopi1",
    "check": "which ppmtopi1",
    "install_steps": [
      "apt-get install ppmtopi1 2>/dev/null || which ppmtopi1",
      "Verify: ppmtopi1 --version",
      "supercli plugins install ./plugins/ppmtopi1 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtopi1",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtopi1 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopi1",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtopi1: apt-get install ppmtopi1 2>/dev/null || which ppmtopi1"
      },
      "args": []
    },
    {
      "namespace": "ppmtopi1",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtopi1 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopi1",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtopi1: apt-get install ppmtopi1 2>/dev/null || which ppmtopi1"
      },
      "args": []
    }
  ]
}