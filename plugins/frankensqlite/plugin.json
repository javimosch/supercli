{
  "name": "frankensqlite",
  "version": "0.1.0",
  "description": "Experimental SQLite reimplementation in pure Rust",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "frankensqlite" }],
  "install_guidance": {
    "plugin": "frankensqlite",
    "binary": "frankensqlite",
    "check": "which frankensqlite",
    "install_steps": ["cargo install frankensqlite", "Verify: frankensqlite --version", "supercli plugins install ./plugins/frankensqlite --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "frankensqlite",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to frankensqlite CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "frankensqlite",
      "passthrough": true,
      "missingDependencyHelp": "Install frankensqlite: cargo install frankensqlite"
    },
    "args": []
  }]
}
