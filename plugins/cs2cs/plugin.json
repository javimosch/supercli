{
  "name": "cs2cs",
  "version": "0.1.0",
  "description": "CLI tool: cs2cs",
  "source": "https://packages.debian.org/cs2cs",
  "checks": [{ "type": "binary", "name": "cs2cs" }],
  "install_guidance": {
    "plugin": "cs2cs", "binary": "cs2cs", "check": "which cs2cs",
    "install_steps": ["apt-get install cs2cs 2>/dev/null || which cs2cs", "Verify: cs2cs --version", "supercli plugins install ./plugins/cs2cs --on-conflict replace --json"]
