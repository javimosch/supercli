{
  "name": "libomemo-c",
  "version": "0.1.0",
  "description": "Implementation of Signal's ratcheting forward secrecy protocol",
  "source": "https://github.com/dino/libomemo-c",
  "checks": [
    {
      "type": "binary",
      "name": "libomemo-c"
    }
  ],
  "install_guidance": {
    "plugin": "libomemo-c",
    "binary": "libomemo-c",
    "check": "which libomemo-c",
    "install_steps": [
      "brew install libomemo-c",
      "Verify: libomemo-c --version",
      "supercli plugins install ./plugins/libomemo-c --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libomemo-c",
      "resource": "self",
      "action": "version",
      "description": "Print libomemo-c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libomemo-c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libomemo-c: brew install libomemo-c"
      },
      "args": []
    },
    {
      "namespace": "libomemo-c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libomemo-c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libomemo-c",
        "passthrough": true,
        "missingDependencyHelp": "Install libomemo-c"
      },
      "args": []
    }
  ]
}