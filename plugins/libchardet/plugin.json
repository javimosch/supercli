{
  "name": "libchardet",
  "version": "0.1.0",
  "description": "Mozilla's Universal Charset Detector C/C++ API",
  "source": "https://github.com/Joungkyun/libchardet",
  "checks": [
    {
      "type": "binary",
      "name": "libchardet"
    }
  ],
  "install_guidance": {
    "plugin": "libchardet",
    "binary": "libchardet",
    "check": "which libchardet",
    "install_steps": [
      "brew install libchardet",
      "Verify: libchardet --version",
      "supercli plugins install ./plugins/libchardet --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libchardet",
      "resource": "self",
      "action": "version",
      "description": "Print libchardet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libchardet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libchardet: brew install libchardet"
      },
      "args": []
    },
    {
      "namespace": "libchardet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libchardet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libchardet",
        "passthrough": true,
        "missingDependencyHelp": "Install libchardet"
      },
      "args": []
    }
  ]
}