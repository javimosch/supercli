{
  "name": "cc",
  "version": "0.1.0",
  "description": "CLI tool: cc",
  "source": "https://packages.debian.org/cc",
  "checks": [{ "type": "binary", "name": "cc" }],
  "install_guidance": {
    "plugin": "cc", "binary": "cc", "check": "which cc",
    "install_steps": ["apt-get install cc 2>/dev/null || which cc", "Verify: cc --version", "supercli plugins install ./plugins/cc --on-conflict replace --json"]
