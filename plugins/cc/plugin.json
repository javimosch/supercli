  "commands": [{
    "namespace": "cc", "resource": "_", "action": "_",
    "description": "Passthrough to cc CLI",
    "adapter": "process", "adapterConfig": { "command": "cc", "passthrough": true, "missingDependencyHelp": "Install cc: apt-get install cc" }, "args": []
  }]
}
