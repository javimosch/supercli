{
  "name": "foundrytools-cli",
  "version": "0.1.0",
  "description": "Manipulate font metadata and convert font formats",
  "source": "https://github.com/ftCLI/FoundryTools-CLI",
  "checks": [{ "type": "binary", "name": "foundrytools-cli" }],
  "install_guidance": {
    "plugin": "foundrytools-cli",
    "binary": "foundrytools-cli",
    "check": "which foundrytools-cli",
    "install_steps": ["pip install foundrytools-cli", "Verify: foundrytools-cli --version", "supercli plugins install ./plugins/foundrytools-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "foundrytools-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to foundrytools-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "foundrytools-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install foundrytools-cli: pip install foundrytools-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
