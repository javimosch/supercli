{
  "name": "wishlist",
  "version": "0.1.0",
  "description": "SSH directory that lists and connects to your servers",
  "source": "https://github.com/charmbracelet/wishlist",
  "checks": [{ "type": "binary", "name": "wishlist" }],
  "install_guidance": {
    "plugin": "wishlist",
    "binary": "wishlist",
    "check": "which wishlist",
    "install_steps": ["brew install wishlist", "Verify: wishlist --version", "supercli plugins install ./plugins/wishlist --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wishlist",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wishlist CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wishlist",
      "passthrough": true,
      "missingDependencyHelp": "Install wishlist: brew install wishlist"
    },
    "args": []
  }]
}
