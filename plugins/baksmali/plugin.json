{
  "name": "baksmali",
  "version": "0.1.0",
  "description": "Dex assembler/disassembler tool",
  "source": "https://github.com/JesusFreke/smali",
  "checks": [
    {
      "type": "binary",
      "name": "baksmali"
    }
  ],
  "install_guidance": {
    "plugin": "baksmali",
    "binary": "baksmali",
    "check": "which baksmali",
    "install_steps": [
      "brew install baksmali",
      "Verify: baksmali --version",
      "supercli plugins install ./plugins/baksmali --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "baksmali",
      "resource": "self",
      "action": "version",
      "description": "Print baksmali version",
      "adapter": "process",
      "adapterConfig": {
        "command": "baksmali",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install baksmali: brew install baksmali"
      },
      "args": []
    },
    {
      "namespace": "baksmali",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to baksmali CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "baksmali",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install baksmali: brew install baksmali"
      },
      "args": []
    }
  ]
}
