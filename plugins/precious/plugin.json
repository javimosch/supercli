{
  "name": "precious",
  "version": "0.1.0",
  "description": "One code formatter to rule them all",
  "source": "https://github.com/houseabsolute/precious",
  "checks": [{ "type": "binary", "name": "precious" }],
  "install_guidance": {
    "plugin": "precious",
    "binary": "precious",
    "check": "which precious",
    "install_steps": ["cargo install precious", "Verify: precious --version", "supercli plugins install ./plugins/precious --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "precious",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to precious CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "precious",
      "passthrough": true,
      "missingDependencyHelp": "Install precious: cargo install precious", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
