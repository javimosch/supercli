{
  "name": "vultr-cli",
  "version": "0.1.0",
  "description": "Vultr CLI — command-line interface for Vultr cloud",
  "source": "https://github.com/vultr/vultr-cli",
  "checks": [
    {
      "type": "binary",
      "name": "vultr-cli"
    }
  ],
  "install_guidance": {
    "plugin": "vultr-cli",
    "binary": "vultr-cli",
    "check": "which vultr-cli",
    "install_steps": [
      "brew install vultr-cli",
      "Verify: vultr-cli --version",
      "supercli plugins install ./plugins/vultr-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vultr-cli",
      "resource": "self",
      "action": "version",
      "description": "Print vultr-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vultr-cli",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install vultr-cli: brew install vultr-cli"
      },
      "args": []
    },
    {
      "namespace": "vultr-cli",
      "resource": "cli",
      "action": "run",
      "description": "Vultr CLI — command-line interface for Vultr cloud",
      "adapter": "process",
      "adapterConfig": {
        "command": "vultr-cli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install vultr-cli: brew install vultr-cli"
      },
      "args": []
    }
  ]
}
