{
  "name": "cppman",
  "version": "0.1.0",
  "description": "C++ 98/11/14/17/20 manual pages from cplusplus.com and cppreference.com",
  "source": "https://github.com/aitjcize/cppman",
  "checks": [
    {
      "type": "binary",
      "name": "cppman"
    }
  ],
  "install_guidance": {
    "plugin": "cppman",
    "binary": "cppman",
    "check": "which cppman",
    "install_steps": [
      "brew install cppman",
      "Verify: cppman --version",
      "supercli plugins install ./plugins/cppman --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cppman",
      "resource": "self",
      "action": "version",
      "description": "Print cppman version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cppman",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cppman: brew install cppman"
      },
      "args": []
    },
    {
      "namespace": "cppman",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cppman CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cppman",
        "passthrough": true,
        "missingDependencyHelp": "Install cppman"
      },
      "args": []
    }
  ]
}