{
  "name": "XMSLEEP",
  "version": "0.1.0",
  "description": "\u4e00\u6b3e\u767d\u566a\u97f3\u5e94\u7528\u9001\u7ed9\u4f60\uff0c\u795d\u60a8\u725b\u63b0\uff0c\u6709\u7684\u662f\u94b1",
  "source": "https://github.com/XMSLEEP/XMSLEEP",
  "checks": [
    {
      "type": "binary",
      "name": "xmsleep"
    }
  ],
  "install_guidance": {
    "plugin": "XMSLEEP",
    "binary": "xmsleep",
    "check": "which xmsleep",
    "install_steps": [
      "pip install xmsleep",
      "Verify: xmsleep --version",
      "supercli plugins install ./plugins/XMSLEEP --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "XMSLEEP",
      "resource": "self",
      "action": "version",
      "description": "Print XMSLEEP version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmsleep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install XMSLEEP: pip install xmsleep"
      },
      "args": []
    },
    {
      "namespace": "XMSLEEP",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xmsleep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmsleep",
        "passthrough": true,
        "missingDependencyHelp": "Install XMSLEEP: pip install xmsleep"
      },
      "args": []
    }
  ]
}