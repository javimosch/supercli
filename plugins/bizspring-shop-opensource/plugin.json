{
  "name": "bizspring-shop-opensource",
  "version": "0.1.0",
  "description": "BizSpring Java\u5546\u57ce\u9996\u9009,\u53ef\u5546\u7528\uff1bVue3,Element UI Plus,Uniapp,\u5fae\u670d\u52a1,SpringCloud,\u8de8\u5883\u7535\u5546,\u8de8\u5883\u5546\u57ce,\u7535\u5546\u56fd\u9645\u5316,\u5916\u8d38,\u72ec\u7acb\u7ad9,\u591a\u56fd\u8bed\u8a00,\u79fb\u52a8\u5546\u57ce,",
  "source": "https://github.com/bizspring-shop-opensource/bizspring-shop-opensource",
  "checks": [
    {
      "type": "binary",
      "name": "bizspring-shop-opensource"
    }
  ],
  "install_guidance": {
    "plugin": "bizspring-shop-opensource",
    "binary": "bizspring-shop-opensource",
    "check": "which bizspring-shop-opensource",
    "install_steps": [
      "pip install bizspring-shop-opensource",
      "Verify: bizspring-shop-opensource --version",
      "supercli plugins install ./plugins/bizspring-shop-opensource --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bizspring-shop-opensource",
      "resource": "self",
      "action": "version",
      "description": "Print bizspring-shop-opensource version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bizspring-shop-opensource",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bizspring-shop-opensource: pip install bizspring-shop-opensource"
      },
      "args": []
    },
    {
      "namespace": "bizspring-shop-opensource",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bizspring-shop-opensource CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bizspring-shop-opensource",
        "passthrough": true,
        "missingDependencyHelp": "Install bizspring-shop-opensource: pip install bizspring-shop-opensource"
      },
      "args": []
    }
  ]
}