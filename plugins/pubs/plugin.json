{
  "name": "pubs",
  "version": "0.1.0",
  "description": "Scientific bibliography manager",
  "source": "https://github.com/pubs/pubs",
  "checks": [
    {
      "type": "binary",
      "name": "pubs"
    }
  ],
  "install_guidance": {
    "plugin": "pubs",
    "binary": "pubs",
    "check": "which pubs",
    "install_steps": [
      "See https://github.com/pubs/pubs",
      "Verify: pubs --version",
      "supercli plugins install ./plugins/pubs --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "pubs",
      "resource": "self",
      "action": "version",
      "description": "Print pubs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pubs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pubs: See https://github.com/pubs/pubs"
      },
      "args": []
    },
    {
      "namespace": "pubs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pubs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pubs",
        "passthrough": true,
        "missingDependencyHelp": "Install pubs"
      },
      "args": []
    }
  ]
}