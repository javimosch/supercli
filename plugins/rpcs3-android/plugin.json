{
  "name": "rpcs3-android",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/rpcs3-android/rpcs3-android",
  "checks": [
    {
      "type": "binary",
      "name": "rpcs3-android"
    }
  ],
  "install_guidance": {
    "plugin": "rpcs3-android",
    "binary": "rpcs3-android",
    "check": "which rpcs3-android",
    "install_steps": [
      "pip install rpcs3-android",
      "Verify: rpcs3-android --version",
      "supercli plugins install ./plugins/rpcs3-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rpcs3-android",
      "resource": "self",
      "action": "version",
      "description": "Print rpcs3-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rpcs3-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rpcs3-android: pip install rpcs3-android"
      },
      "args": []
    },
    {
      "namespace": "rpcs3-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rpcs3-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rpcs3-android",
        "passthrough": true,
        "missingDependencyHelp": "Install rpcs3-android: pip install rpcs3-android"
      },
      "args": []
    }
  ]
}