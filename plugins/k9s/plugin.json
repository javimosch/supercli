{
  "name": "k9s",
  "description": "Kubernetes CLI to manage your clusters in style",
  "version": "1.0.0",
  "binary": "k9s",
  "check": "k9s version",
  "install": {
    "method": "brew",
    "command": "brew install k9s"
  },
  "commands": {
    "start": {
      "command": "k9s",
      "description": "Launch k9s TUI for Kubernetes cluster management"
    },
    "pods": {
      "command": "k9s -c pod",
      "description": "Open k9s with pods view"
    },
    "deployments": {
      "command": "k9s -c deployment",
      "description": "Open k9s with deployments view"
    },
    "logs": {
      "command": "k9s -c logs",
      "description": "Open k9s with logs view"
    },
    "namespace": {
      "command": "k9s -n {namespace}",
      "description": "Open k9s in specific namespace",
      "args": ["namespace"]
    }
  }
}
