{
  "name": "splash-cli",
  "version": "0.1.0",
  "description": "Beautiful wallpapers from Unsplash",
  "source": "https://github.com/splash-cli/splash-cli",
  "checks": [
    {
      "type": "binary",
      "name": "splash-cli"
    }
  ],
  "install_guidance": {
    "plugin": "splash-cli",
    "binary": "splash-cli",
    "check": "which splash-cli",
    "install_steps": [
      "See https://github.com/splash-cli/splash-cli",
      "Verify: splash-cli --version",
      "supercli plugins install ./plugins/splash-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "splash-cli",
      "resource": "self",
      "action": "version",
      "description": "Print splash-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "splash-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install splash-cli: See https://github.com/splash-cli/splash-cli"
      },
      "args": []
    },
    {
      "namespace": "splash-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to splash-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "splash-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install splash-cli"
      },
      "args": []
    }
  ]
}