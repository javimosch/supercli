{
  "name": "perplexity-scraper",
  "version": "0.1.0",
  "description": "Perplexity Scraper Track brand mentions, analyze rankings, and gain competitor intelligence from Per",
  "source": "https://github.com/perplexity-scraper/perplexity-scraper",
  "checks": [
    {
      "type": "binary",
      "name": "perplexity-scraper"
    }
  ],
  "install_guidance": {
    "plugin": "perplexity-scraper",
    "binary": "perplexity-scraper",
    "check": "which perplexity-scraper",
    "install_steps": [
      "pip install perplexity-scraper",
      "Verify: perplexity-scraper --version",
      "supercli plugins install ./plugins/perplexity-scraper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "perplexity-scraper",
      "resource": "self",
      "action": "version",
      "description": "Print perplexity-scraper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "perplexity-scraper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install perplexity-scraper: pip install perplexity-scraper"
      },
      "args": []
    },
    {
      "namespace": "perplexity-scraper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to perplexity-scraper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "perplexity-scraper",
        "passthrough": true,
        "missingDependencyHelp": "Install perplexity-scraper: pip install perplexity-scraper"
      },
      "args": []
    }
  ]
}