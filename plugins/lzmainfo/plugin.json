{
  "name": "lzmainfo",
  "version": "0.1.0",
  "description": "CLI tool: lzmainfo",
  "source": "https://manpages.debian.org/lzmainfo",
  "checks": [
    {
      "type": "binary",
      "name": "lzmainfo"
    }
  ],
  "install_guidance": {
    "plugin": "lzmainfo",
    "binary": "lzmainfo",
    "check": "which lzmainfo",
    "install_steps": [
      "apt-get install lzmainfo 2>/dev/null || which lzmainfo",
      "Verify: lzmainfo --version",
      "supercli plugins install ./plugins/lzmainfo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lzmainfo",
      "resource": "self",
      "action": "version",
      "description": "Print lzmainfo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lzmainfo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lzmainfo: apt-get install lzmainfo 2>/dev/null || which lzmainfo"
      },
      "args": []
    },
    {
      "namespace": "lzmainfo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lzmainfo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lzmainfo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lzmainfo: apt-get install lzmainfo 2>/dev/null || which lzmainfo"
      },
      "args": []
    }
  ]
}