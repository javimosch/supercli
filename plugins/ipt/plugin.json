{
  "name": "ipt",
  "version": "0.1.0",
  "description": "Pivotal Tracker client",
  "source": "https://github.com/drselump14/ipt",
  "checks": [
    {
      "type": "binary",
      "name": "ipt"
    }
  ],
  "install_guidance": {
    "plugin": "ipt",
    "binary": "ipt",
    "check": "which ipt",
    "install_steps": [
      "See https://github.com/drselump14/ipt",
      "Verify: ipt --version",
      "supercli plugins install ./plugins/ipt --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ipt",
      "resource": "self",
      "action": "version",
      "description": "Print ipt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipt: See https://github.com/drselump14/ipt"
      },
      "args": []
    },
    {
      "namespace": "ipt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipt",
        "passthrough": true,
        "missingDependencyHelp": "Install ipt"
      },
      "args": []
    }
  ]
}