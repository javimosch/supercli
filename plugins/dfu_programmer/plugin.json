{
  "name": "dfu_programmer",
  "version": "0.1.0",
  "description": "CLI tool: dfu_programmer",
  "source": "https://packages.debian.org/dfu_programmer",
  "checks": [{ "type": "binary", "name": "dfu_programmer" }],
  "install_guidance": {
    "plugin": "dfu_programmer", "binary": "dfu_programmer", "check": "which dfu_programmer",
    "install_steps": ["apt-get install dfu_programmer 2>/dev/null || which dfu_programmer", "Verify: dfu_programmer --version", "supercli plugins install ./plugins/dfu_programmer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dfu_programmer", "resource": "_", "action": "_",
    "description": "Passthrough to dfu_programmer CLI",
    "adapter": "process", "adapterConfig": { "command": "dfu_programmer", "passthrough": true, "missingDependencyHelp": "Install dfu_programmer: apt-get install dfu_programmer" }, "args": []
  }]
}
