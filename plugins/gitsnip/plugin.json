{
  "name": "gitsnip",
  "version": "0.1.0",
  "description": "Text and folder downloader tool for git repositories",
  "source": "go",
  "checks": [{ "type": "binary", "name": "gitsnip" }],
  "install_guidance": {
    "plugin": "gitsnip",
    "binary": "gitsnip",
    "check": "which gitsnip",
    "install_steps": ["go install github.com/gitsnip@latest", "Verify: gitsnip --version", "supercli plugins install ./plugins/gitsnip --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gitsnip",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gitsnip CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gitsnip",
      "passthrough": true,
      "missingDependencyHelp": "Install gitsnip: go install github.com/gitsnip@latest"
    },
    "args": []
  }]
}
