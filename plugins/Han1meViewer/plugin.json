{
  "name": "Han1meViewer",
  "version": "0.1.0",
  "description": "hanime1\u7684\u4e09\u65b9\u5ba2\u6237\u7aef\uff0c\u63d0\u9ad8\u4e86\u4e00\u4e9b\u64ad\u653e\u4f53\u9a8c",
  "source": "https://github.com/Han1meViewer/Han1meViewer",
  "checks": [
    {
      "type": "binary",
      "name": "han1meviewer"
    }
  ],
  "install_guidance": {
    "plugin": "Han1meViewer",
    "binary": "han1meviewer",
    "check": "which han1meviewer",
    "install_steps": [
      "pip install han1meviewer",
      "Verify: han1meviewer --version",
      "supercli plugins install ./plugins/Han1meViewer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Han1meViewer",
      "resource": "self",
      "action": "version",
      "description": "Print Han1meViewer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "han1meviewer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Han1meViewer: pip install han1meviewer"
      },
      "args": []
    },
    {
      "namespace": "Han1meViewer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to han1meviewer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "han1meviewer",
        "passthrough": true,
        "missingDependencyHelp": "Install Han1meViewer: pip install han1meviewer"
      },
      "args": []
    }
  ]
}