{
  "name": "fcitx-remote-for-osx",
  "version": "0.1.0",
  "description": "Handle input method in command-line",
  "source": "https://github.com/xcodebuild/fcitx-remote-for-osx",
  "checks": [
    {
      "type": "binary",
      "name": "fcitx-remote-for-osx"
    }
  ],
  "install_guidance": {
    "plugin": "fcitx-remote-for-osx",
    "binary": "fcitx-remote-for-osx",
    "check": "which fcitx-remote-for-osx",
    "install_steps": [
      "brew install fcitx-remote-for-osx",
      "Verify: fcitx-remote-for-osx --version",
      "supercli plugins install ./plugins/fcitx-remote-for-osx --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fcitx-remote-for-osx",
      "resource": "self",
      "action": "version",
      "description": "Print fcitx-remote-for-osx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fcitx-remote-for-osx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fcitx-remote-for-osx: brew install fcitx-remote-for-osx"
      },
      "args": []
    },
    {
      "namespace": "fcitx-remote-for-osx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fcitx-remote-for-osx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fcitx-remote-for-osx",
        "passthrough": true,
        "missingDependencyHelp": "Install fcitx-remote-for-osx"
      },
      "args": []
    }
  ]
}