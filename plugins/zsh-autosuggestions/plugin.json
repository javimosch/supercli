{
  "name": "zsh-autosuggestions",
  "version": "0.1.0",
  "description": "Fish-like autosuggestions for zsh — CLI configuration tool with JSON output",
  "source": "https://github.com/zsh-users/zsh-autosuggestions",
  "checks": [
    {
      "type": "binary",
      "name": "zsh-autosuggestions"
    }
  ],
  "install_guidance": {
    "plugin": "zsh-autosuggestions",
    "binary": "zsh-autosuggestions",
    "check": "which zsh-autosuggestions",
    "install_steps": [
      "brew install zsh-autosuggestions",
      "Verify: zsh-autosuggestions --version",
      "supercli plugins install ./plugins/zsh-autosuggestions --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zsh-autosuggestions",
      "resource": "self",
      "action": "version",
      "description": "Print zsh-autosuggestions version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zsh-autosuggestions",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zsh-autosuggestions: brew install zsh-autosuggestions"
      },
      "args": []
    },
    {
      "namespace": "zsh-autosuggestions",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zsh-autosuggestions CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zsh-autosuggestions",
        "passthrough": true,
        "missingDependencyHelp": "Install zsh-autosuggestions: brew install zsh-autosuggestions"
      },
      "args": []
    }
  ]
}
