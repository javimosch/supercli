{
  "name": "enkits",
  "version": "0.1.0",
  "description": "C and C++ Task Scheduler for creating parallel programs",
  "source": "https://github.com/dougbinks/enkiTS",
  "checks": [
    {
      "type": "binary",
      "name": "enkits"
    }
  ],
  "install_guidance": {
    "plugin": "enkits",
    "binary": "enkits",
    "check": "which enkits",
    "install_steps": [
      "brew install enkits",
      "Verify: enkits --version",
      "supercli plugins install ./plugins/enkits --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "enkits",
      "resource": "self",
      "action": "version",
      "description": "Print enkits version",
      "adapter": "process",
      "adapterConfig": {
        "command": "enkits",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install enkits: brew install enkits"
      },
      "args": []
    },
    {
      "namespace": "enkits",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enkits CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enkits",
        "passthrough": true,
        "missingDependencyHelp": "Install enkits"
      },
      "args": []
    }
  ]
}