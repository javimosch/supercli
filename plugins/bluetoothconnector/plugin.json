{
  "name": "bluetoothconnector",
  "version": "0.1.0",
  "description": "Connect and disconnect Bluetooth devices",
  "source": "https://github.com/lapfelix/BluetoothConnector",
  "checks": [
    {
      "type": "binary",
      "name": "bluetoothconnector"
    }
  ],
  "install_guidance": {
    "plugin": "bluetoothconnector",
    "binary": "bluetoothconnector",
    "check": "which bluetoothconnector",
    "install_steps": [
      "brew install bluetoothconnector",
      "Verify: bluetoothconnector --version",
      "supercli plugins install ./plugins/bluetoothconnector --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bluetoothconnector",
      "resource": "self",
      "action": "version",
      "description": "Print bluetoothconnector version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bluetoothconnector",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bluetoothconnector: brew install bluetoothconnector"
      },
      "args": []
    },
    {
      "namespace": "bluetoothconnector",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bluetoothconnector CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bluetoothconnector",
        "passthrough": true,
        "missingDependencyHelp": "Install bluetoothconnector"
      },
      "args": []
    }
  ]
}