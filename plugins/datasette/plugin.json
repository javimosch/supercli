{
  "name": "datasette",
  "version": "0.1.0",
  "description": "Explore and publish tabular data as an API",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "datasette" }],
  "install_guidance": {
    "plugin": "datasette",
    "binary": "datasette",
    "check": "which datasette",
    "install_steps": ["pip install datasette", "which datasette", "Verify: datasette --version", "supercli plugins install ./plugins/datasette --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "datasette",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to datasette CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "datasette",
      "passthrough": true,
      "missingDependencyHelp": "Install datasette: pip install datasette"
    },
    "args": []
  }]
}
