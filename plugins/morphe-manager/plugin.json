{
  "name": "morphe-manager",
  "version": "0.1.0",
  "description": "Morphe app patcher for Android",
  "source": "https://github.com/morphe-manager/morphe-manager",
  "checks": [
    {
      "type": "binary",
      "name": "morphe-manager"
    }
  ],
  "install_guidance": {
    "plugin": "morphe-manager",
    "binary": "morphe-manager",
    "check": "which morphe-manager",
    "install_steps": [
      "pip install morphe-manager",
      "Verify: morphe-manager --version",
      "supercli plugins install ./plugins/morphe-manager --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "morphe-manager",
      "resource": "self",
      "action": "version",
      "description": "Print morphe-manager version",
      "adapter": "process",
      "adapterConfig": {
        "command": "morphe-manager",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install morphe-manager: pip install morphe-manager"
      },
      "args": []
    },
    {
      "namespace": "morphe-manager",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to morphe-manager CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "morphe-manager",
        "passthrough": true,
        "missingDependencyHelp": "Install morphe-manager: pip install morphe-manager"
      },
      "args": []
    }
  ]
}