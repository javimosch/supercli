{
  "name": "base64-cli",
  "version": "0.1.0",
  "description": "Dedicated CLI for base64 encoding and decoding operations",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "base64-cli" }],
  "install_guidance": {
    "plugin": "base64-cli",
    "binary": "base64-cli",
    "check": "which base64-cli",
    "install_steps": ["npm install -g base64-cli", "Verify: base64-cli --version", "supercli plugins install ./plugins/base64-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "base64-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to base64-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "base64-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install base64-cli: npm install -g base64-cli"
    },
    "args": []
  }]
}
