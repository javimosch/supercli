{
  "name": "jupyter-converter",
  "version": "0.1.0",
  "description": "Specialized converter for Jupyter notebook formats",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "jupyter-converter" }],
  "install_guidance": {
    "plugin": "jupyter-converter",
    "binary": "jupyter-converter",
    "check": "which jupyter-converter",
    "install_steps": ["pip install jupyter-converter", "Verify: jupyter-converter --version", "supercli plugins install ./plugins/jupyter-converter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jupyter-converter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jupyter-converter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jupyter-converter",
      "passthrough": true,
      "missingDependencyHelp": "Install jupyter-converter: pip install jupyter-converter"
    },
    "args": []
  }]
}
