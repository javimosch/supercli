{
  "name": "dcop",
  "version": "0.1.0",
  "description": "CLI tool: dcop",
  "source": "https://packages.debian.org/dcop",
  "checks": [{ "type": "binary", "name": "dcop" }],
  "install_guidance": {
    "plugin": "dcop", "binary": "dcop", "check": "which dcop",
    "install_steps": ["apt-get install dcop 2>/dev/null || which dcop", "Verify: dcop --version", "supercli plugins install ./plugins/dcop --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dcop", "resource": "_", "action": "_",
    "description": "Passthrough to dcop CLI",
    "adapter": "process", "adapterConfig": { "command": "dcop", "passthrough": true, "missingDependencyHelp": "Install dcop: apt-get install dcop" }, "args": []
  }]
}
