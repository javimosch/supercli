{
  "name": "gnome-www-browser",
  "version": "0.1.0",
  "description": "CLI tool: gnome-www-browser",
  "source": "https://manpages.debian.org/gnome-www-browser",
  "checks": [
    {
      "type": "binary",
      "name": "gnome-www-browser"
    }
  ],
  "install_guidance": {
    "plugin": "gnome-www-browser",
    "binary": "gnome-www-browser",
    "check": "which gnome-www-browser",
    "install_steps": [
      "apt-get install gnome-www-browser 2>/dev/null || which gnome-www-browser",
      "Verify: gnome-www-browser --version",
      "supercli plugins install ./plugins/gnome-www-browser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gnome-www-browser",
      "resource": "self",
      "action": "version",
      "description": "Print gnome-www-browser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-www-browser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gnome-www-browser: apt-get install gnome-www-browser 2>/dev/null || which gnome-www-browser"
      },
      "args": []
    },
    {
      "namespace": "gnome-www-browser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gnome-www-browser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-www-browser",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gnome-www-browser: apt-get install gnome-www-browser 2>/dev/null || which gnome-www-browser"
      },
      "args": []
    }
  ]
}