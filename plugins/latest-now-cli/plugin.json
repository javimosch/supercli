{
  "name": "latest-now-cli",
  "version": "0.1.0",
  "description": "Download bleeding edge now-cli binary from CircleCI's artifacts service.",
  "source": "https://latest-now-cli.now.sh",
  "checks": [
    {
      "type": "binary",
      "name": "latest-now-cli"
    }
  ],
  "install_guidance": {
    "plugin": "latest-now-cli",
    "binary": "latest-now-cli",
    "check": "which latest-now-cli",
    "install_steps": [
      "Check https://latest-now-cli.now.sh for installation instructions",
      "Verify: latest-now-cli --version",
      "supercli plugins install ./plugins/latest-now-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "latest-now-cli",
      "resource": "self",
      "action": "version",
      "description": "Print latest-now-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "latest-now-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install latest-now-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "latest-now-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to latest-now-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "latest-now-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install latest-now-cli from project repository"
      },
      "args": []
    }
  ]
}