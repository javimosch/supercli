{
  "name": "semantic-search-cli",
  "version": "0.1.0",
  "description": "Simple CLI for embedding-based semantic document search",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "semantic-search-cli" }],
  "install_guidance": {
    "plugin": "semantic-search-cli",
    "binary": "semantic-search-cli",
    "check": "which semantic-search-cli",
    "install_steps": ["pip install semantic-search-cli", "Verify: semantic-search-cli --version", "supercli plugins install ./plugins/semantic-search-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "semantic-search-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to semantic-search-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "semantic-search-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install semantic-search-cli: pip install semantic-search-cli"
    },
    "args": []
  }]
}
