{
  "name": "iDescriptor",
  "version": "0.1.0",
  "description": "A free, open-source, and cross-platform iDevice management tool",
  "source": "https://github.com/iDescriptor/iDescriptor",
  "checks": [
    {
      "type": "binary",
      "name": "idescriptor"
    }
  ],
  "install_guidance": {
    "plugin": "iDescriptor",
    "binary": "idescriptor",
    "check": "which idescriptor",
    "install_steps": [
      "pip install idescriptor",
      "Verify: idescriptor --version",
      "supercli plugins install ./plugins/iDescriptor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iDescriptor",
      "resource": "self",
      "action": "version",
      "description": "Print iDescriptor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "idescriptor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iDescriptor: pip install idescriptor"
      },
      "args": []
    },
    {
      "namespace": "iDescriptor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to idescriptor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "idescriptor",
        "passthrough": true,
        "missingDependencyHelp": "Install iDescriptor: pip install idescriptor"
      },
      "args": []
    }
  ]
}