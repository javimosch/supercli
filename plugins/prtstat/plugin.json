{
  "name": "prtstat",
  "version": "1.0.0",
  "description": "prtstat \u2014 prtstat \u2014 CLI utility",
  "source": "/usr/bin/prtstat",
  "checks": [
    {
      "type": "binary",
      "name": "prtstat"
    }
  ],
  "install_guidance": {
    "plugin": "prtstat",
    "binary": "prtstat",
    "check": "which prtstat",
    "install_steps": [
      "# Install prtstat:",
      "# apt: sudo apt-get install prtstat",
      "# brew: brew install prtstat",
      "# cargo: cargo install prtstat",
      "# npm: npm install -g prtstat",
      "# pip: pip install prtstat",
      "# or download from /usr/bin/prtstat"
    ]
  },
  "commands": [
    {
      "namespace": "prtstat",
      "resource": "prtstat",
      "action": "run",
      "description": "Run prtstat",
      "adapter": "process",
      "adapterConfig": {
        "command": "prtstat",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install prtstat from /usr/bin/prtstat"
      },
      "args": []
    }
  ]
}