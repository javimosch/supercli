{
  "plugin": "prtstat",
  "binary": "prtstat",
  "check": "which prtstat",
  "install_steps": [
    "# Install prtstat",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/prtstat-linux-amd64 -o /usr/local/bin/prtstat",
    "chmod +x /usr/local/bin/prtstat",
    "# Or via package manager, see /usr/bin/prtstat"
  ]
}