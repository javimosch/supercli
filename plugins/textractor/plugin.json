{
  "name": "textractor",
  "version": "0.1.0",
  "description": "Extract text from images using cloud OCR APIs",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "textractor" }],
  "install_guidance": {
    "plugin": "textractor",
    "binary": "textractor",
    "check": "which textractor",
    "install_steps": ["npm install textractor", "Verify: textractor --version", "supercli plugins install ./plugins/textractor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "textractor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to textractor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "textractor",
      "passthrough": true,
      "missingDependencyHelp": "Install textractor: npm install textractor"
    },
    "args": []
  }]
}
