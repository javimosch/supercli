{
  "name": "gvp",
  "version": "0.1.0",
  "description": "Go versioning packager",
  "source": "https://github.com/pote/gvp",
  "checks": [
    {
      "type": "binary",
      "name": "gvp"
    }
  ],
  "install_guidance": {
    "plugin": "gvp",
    "binary": "gvp",
    "check": "which gvp",
    "install_steps": [
      "brew install gvp",
      "Verify: gvp --version",
      "supercli plugins install ./plugins/gvp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gvp",
      "resource": "self",
      "action": "version",
      "description": "Print gvp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gvp: brew install gvp"
      },
      "args": []
    },
    {
      "namespace": "gvp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gvp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvp",
        "passthrough": true,
        "missingDependencyHelp": "Install gvp"
      },
      "args": []
    }
  ]
}