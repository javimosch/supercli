{
  "name": "insomnium",
  "version": "0.1.0",
  "description": "API client for REST and GraphQL with CLI export",
  "source": "https://github.com/ArchGPT/insomnium",
  "checks": [{ "type": "binary", "name": "insomnium" }],
  "install_guidance": {
    "plugin": "insomnium",
    "binary": "insomnium",
    "check": "which insomnium",
    "install_steps": ["brew install insomnium", "Verify: insomnium --version", "supercli plugins install ./plugins/insomnium --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "insomnium",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to insomnium CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "insomnium",
      "passthrough": true,
      "missingDependencyHelp": "Install insomnium: brew install insomnium"
    },
    "args": []
  }]
}
