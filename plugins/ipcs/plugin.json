{
  "name": "ipcs",
  "version": "1.0.0",
  "description": "ipcs \u2014 ipcs \u2014 CLI utility",
  "source": "/usr/bin/ipcs",
  "checks": [
    {
      "type": "binary",
      "name": "ipcs"
    }
  ],
  "install_guidance": {
    "plugin": "ipcs",
    "binary": "ipcs",
    "check": "which ipcs",
    "install_steps": [
      "# Install ipcs:",
      "# apt: sudo apt-get install ipcs",
      "# brew: brew install ipcs",
      "# cargo: cargo install ipcs",
      "# npm: npm install -g ipcs",
      "# pip: pip install ipcs",
      "# or download from /usr/bin/ipcs"
    ]
  },
  "commands": [
    {
      "namespace": "ipcs",
      "resource": "ipcs",
      "action": "run",
      "description": "Run ipcs",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipcs",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ipcs from /usr/bin/ipcs"
      },
      "args": []
    }
  ]
}