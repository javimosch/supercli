{
  "name": "darner",
  "version": "0.1.0",
  "description": "Simple lightweight persistent message queue daemon",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "darner" }],
  "install_guidance": {
    "plugin": "darner",
    "binary": "darner",
    "check": "which darner",
    "install_steps": ["cmake . && make", "Verify: darner --version", "supercli plugins install ./plugins/darner --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "darner",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to darner CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "darner",
      "passthrough": true,
      "missingDependencyHelp": "Install darner: cmake . && make"
    },
    "args": []
  }]
}
