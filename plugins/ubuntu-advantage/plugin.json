{
  "name": "ubuntu-advantage",
  "version": "0.1.0",
  "description": "CLI tool: ubuntu-advantage",
  "source": "https://manpages.debian.org/ubuntu-advantage",
  "checks": [
    {
      "type": "binary",
      "name": "ubuntu-advantage"
    }
  ],
  "install_guidance": {
    "plugin": "ubuntu-advantage",
    "binary": "ubuntu-advantage",
    "check": "which ubuntu-advantage",
    "install_steps": [
      "apt-get install ubuntu-advantage 2>/dev/null || which ubuntu-advantage",
      "Verify: ubuntu-advantage --version",
      "supercli plugins install ./plugins/ubuntu-advantage --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ubuntu-advantage",
      "resource": "self",
      "action": "version",
      "description": "Print ubuntu-advantage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ubuntu-advantage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ubuntu-advantage: apt-get install ubuntu-advantage 2>/dev/null || which ubuntu-advantage"
      },
      "args": []
    },
    {
      "namespace": "ubuntu-advantage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ubuntu-advantage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ubuntu-advantage",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ubuntu-advantage: apt-get install ubuntu-advantage 2>/dev/null || which ubuntu-advantage"
      },
      "args": []
    }
  ]
}