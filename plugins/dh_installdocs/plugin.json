{
  "name": "dh_installdocs",
  "version": "0.1.0",
  "description": "CLI tool: dh_installdocs",
  "source": "https://packages.debian.org/dh_installdocs",
  "checks": [{ "type": "binary", "name": "dh_installdocs" }],
  "install_guidance": {
    "plugin": "dh_installdocs", "binary": "dh_installdocs", "check": "which dh_installdocs",
    "install_steps": ["apt-get install dh_installdocs 2>/dev/null || which dh_installdocs", "Verify: dh_installdocs --version", "supercli plugins install ./plugins/dh_installdocs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_installdocs", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installdocs CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installdocs", "passthrough": true, "missingDependencyHelp": "Install dh_installdocs: apt-get install dh_installdocs" }, "args": []
  }]
}
