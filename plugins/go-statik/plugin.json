{
  "name": "go-statik",
  "version": "0.1.0",
  "description": "Embed files into a Go executable",
  "source": "https://github.com/rakyll/statik",
  "checks": [
    {
      "type": "binary",
      "name": "go-statik"
    }
  ],
  "install_guidance": {
    "plugin": "go-statik",
    "binary": "go-statik",
    "check": "which go-statik",
    "install_steps": [
      "brew install go-statik",
      "Verify: go-statik --version",
      "supercli plugins install ./plugins/go-statik --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "go-statik",
      "resource": "self",
      "action": "version",
      "description": "Print go-statik version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-statik",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-statik: brew install go-statik"
      },
      "args": []
    },
    {
      "namespace": "go-statik",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-statik CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-statik",
        "passthrough": true,
        "missingDependencyHelp": "Install go-statik"
      },
      "args": []
    }
  ]
}