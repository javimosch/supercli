{
  "name": "IPQuality",
  "version": "0.1.0",
  "description": "IP\u8d28\u91cf\u68c0\u6d4b\u811a\u672c - IP Quality Check Script",
  "source": "https://github.com/IPQuality/IPQuality",
  "checks": [
    {
      "type": "binary",
      "name": "ipquality"
    }
  ],
  "install_guidance": {
    "plugin": "IPQuality",
    "binary": "ipquality",
    "check": "which ipquality",
    "install_steps": [
      "pip install ipquality",
      "Verify: ipquality --version",
      "supercli plugins install ./plugins/IPQuality --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "IPQuality",
      "resource": "self",
      "action": "version",
      "description": "Print IPQuality version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipquality",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install IPQuality: pip install ipquality"
      },
      "args": []
    },
    {
      "namespace": "IPQuality",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipquality CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipquality",
        "passthrough": true,
        "missingDependencyHelp": "Install IPQuality: pip install ipquality"
      },
      "args": []
    }
  ]
}