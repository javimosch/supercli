{
  "name": "chisel-tunnel",
  "version": "0.1.0",
  "description": "Fast TCP/UDP tunnel over HTTP",
  "source": "https://github.com/jpillora/chisel",
  "checks": [
    {
      "type": "binary",
      "name": "chisel-tunnel"
    }
  ],
  "install_guidance": {
    "plugin": "chisel-tunnel",
    "binary": "chisel-tunnel",
    "check": "which chisel-tunnel",
    "install_steps": [
      "brew install chisel-tunnel",
      "Verify: chisel-tunnel --version",
      "supercli plugins install ./plugins/chisel-tunnel --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chisel-tunnel",
      "resource": "self",
      "action": "version",
      "description": "Print chisel-tunnel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chisel-tunnel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chisel-tunnel: brew install chisel-tunnel"
      },
      "args": []
    },
    {
      "namespace": "chisel-tunnel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chisel-tunnel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chisel-tunnel",
        "passthrough": true,
        "missingDependencyHelp": "Install chisel-tunnel"
      },
      "args": []
    }
  ]
}