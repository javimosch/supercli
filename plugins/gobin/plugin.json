{
  "name": "gobin",
  "version": "0.1.0",
  "description": "Self-hosted hastebin-compatible pastebin server with CLI client",
  "source": "https://github.com/topi314/gobin",
  "checks": [{ "type": "binary", "name": "gobin" }],
  "install_guidance": {
    "plugin": "gobin",
    "binary": "gobin",
    "check": "which gobin",
    "install_steps": ["go install github.com/topi314/gobin@latest", "Verify: gobin --version", "supercli plugins install ./plugins/gobin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gobin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gobin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gobin",
      "passthrough": true,
      "missingDependencyHelp": "Install gobin: go install github.com/topi314/gobin@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
