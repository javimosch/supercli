{
  "name": "flamebearer",
  "version": "0.1.0",
  "description": "Blazing fast flame graph tool for V8 and Node",
  "source": "https://github.com/mapbox/flamebearer",
  "checks": [
    {
      "type": "binary",
      "name": "flamebearer"
    }
  ],
  "install_guidance": {
    "plugin": "flamebearer",
    "binary": "flamebearer",
    "check": "which flamebearer",
    "install_steps": [
      "brew install flamebearer",
      "Verify: flamebearer --version",
      "supercli plugins install ./plugins/flamebearer --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "flamebearer",
      "resource": "self",
      "action": "version",
      "description": "Print flamebearer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flamebearer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flamebearer: brew install flamebearer"
      },
      "args": []
    },
    {
      "namespace": "flamebearer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flamebearer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flamebearer",
        "passthrough": true,
        "missingDependencyHelp": "Install flamebearer"
      },
      "args": []
    }
  ]
}