{
  "name": "raddebugger",
  "version": "0.1.0",
  "description": "A native, user-mode, multi-process, graphical debugger.",
  "source": "https://github.com/raddebugger/raddebugger",
  "checks": [
    {
      "type": "binary",
      "name": "raddebugger"
    }
  ],
  "install_guidance": {
    "plugin": "raddebugger",
    "binary": "raddebugger",
    "check": "which raddebugger",
    "install_steps": [
      "pip install raddebugger",
      "Verify: raddebugger --version",
      "supercli plugins install ./plugins/raddebugger --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "raddebugger",
      "resource": "self",
      "action": "version",
      "description": "Print raddebugger version",
      "adapter": "process",
      "adapterConfig": {
        "command": "raddebugger",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install raddebugger: pip install raddebugger"
      },
      "args": []
    },
    {
      "namespace": "raddebugger",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to raddebugger CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "raddebugger",
        "passthrough": true,
        "missingDependencyHelp": "Install raddebugger: pip install raddebugger"
      },
      "args": []
    }
  ]
}