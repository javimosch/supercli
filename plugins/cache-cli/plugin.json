{
  "name": "cache-cli",
  "version": "0.1.0",
  "description": "Generic caching wrapper for CLI command outputs",
  "source": "go",
  "checks": [{ "type": "binary", "name": "cache-cli" }],
  "install_guidance": {
    "plugin": "cache-cli",
    "binary": "cache-cli",
    "check": "which cache-cli",
    "install_steps": ["go install github.com/cache-cli@latest", "Verify: cache-cli --version", "supercli plugins install ./plugins/cache-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cache-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cache-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cache-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install cache-cli: go install github.com/cache-cli@latest"
    },
    "args": []
  }]
}
