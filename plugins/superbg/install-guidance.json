{
  "plugin": "superbg",
  "binary": "superbg",
  "check": "which superbg",
  "install_steps": [
    "go install github.com/javimosch/superbg@latest",
    "Verify: superbg help",
    "supercli plugins install ./plugins/superbg --on-conflict replace --json"
  ],
  "note": "Requires Go 1.22+ and Linux (uses setsid syscall). State is persisted to ~/.superbg/state.json."
}
