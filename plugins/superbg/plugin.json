{
  "name": "superbg",
  "version": "0.1.0",
  "description": "Super Background Process Manager",
  "source": "https://github.com/javimosch/superbg",
  "checks": [
    {
      "type": "binary",
      "name": "superbg"
    }
  ],
  "install_guidance": {
    "plugin": "superbg",
    "binary": "superbg",
    "check": "which superbg",
    "install_steps": [
      "go install github.com/javimosch/superbg@latest",
      "Verify: superbg help",
      "supercli plugins install ./plugins/superbg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "superbg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to superbg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": []
    },
    {
      "namespace": "superbg",
      "resource": "self",
      "action": "version",
      "description": "Print superbg help",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["help"],
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": []
    },
    {
      "namespace": "superbg",
      "resource": "run",
      "action": "start",
      "description": "Run a command in the background, optionally with auto-restart, env-file, custom name, or custom working directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["run"],
        "positionalArgs": ["args"],
        "cwd": "invoke_cwd",
        "flagsBeforePositionals": true,
        "noTimeout": true,
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Command and arguments to run in background"
        },
        {
          "name": "watch",
          "type": "boolean",
          "required": false,
          "description": "Auto-restart the process when it exits"
        },
        {
          "name": "max-restarts",
          "type": "number",
          "required": false,
          "description": "Max restarts before giving up (default 10, requires --watch)"
        },
        {
          "name": "env-file",
          "type": "string",
          "required": false,
          "description": "Load environment variables from FILE"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Custom process name"
        },
        {
          "name": "cwd",
          "type": "string",
          "required": false,
          "description": "Working directory for the process"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "list",
      "action": "show",
      "description": "List all tracked background processes",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["list"],
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "Output in JSON format"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "process",
      "action": "stop",
      "description": "Stop a process (SIGTERM then SIGKILL after timeout)",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["stop"],
        "positionalArgs": ["id"],
        "cwd": "invoke_cwd",
        "flagsBeforePositionals": true,
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Process ID or PID to stop"
        },
        {
          "name": "timeout",
          "type": "number",
          "required": false,
          "description": "Seconds to wait before SIGKILL (default 5)"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "process",
      "action": "kill",
      "description": "Kill a process immediately (SIGKILL)",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["kill"],
        "positionalArgs": ["id"],
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Process ID or PID to kill"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "process",
      "action": "status",
      "description": "Show detailed info about a process, optionally as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["status"],
        "positionalArgs": ["id"],
        "cwd": "invoke_cwd",
        "flagsBeforePositionals": true,
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Process ID or PID to check"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "Output in JSON format"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "logs",
      "action": "show",
      "description": "Show process logs, optionally as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["logs"],
        "positionalArgs": ["id"],
        "cwd": "invoke_cwd",
        "flagsBeforePositionals": true,
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Process ID or PID"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "Output in JSON format"
        },
        {
          "name": "follow",
          "type": "boolean",
          "required": false,
          "description": "Follow log output in real-time"
        },
        {
          "name": "f",
          "type": "boolean",
          "required": false,
          "description": "Short flag for --follow"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "logs",
      "action": "follow",
      "description": "Follow process logs in real-time",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["attach"],
        "positionalArgs": ["id"],
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Process ID or PID to follow"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "clean",
      "action": "run",
      "description": "Remove all completed processes from tracking",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["clean"],
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": []
    },
    {
      "namespace": "superbg",
      "resource": "process",
      "action": "rm",
      "description": "Remove a single process from tracking",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["rm"],
        "positionalArgs": ["id"],
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Process ID or PID to remove"
        }
      ]
    },
    {
      "namespace": "superbg",
      "resource": "completion",
      "action": "generate",
      "description": "Generate shell completion script for bash, zsh, or fish",
      "adapter": "process",
      "adapterConfig": {
        "command": "superbg",
        "baseArgs": ["completion"],
        "positionalArgs": ["shell"],
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install superbg: go install github.com/javimosch/superbg@latest"
      },
      "args": [
        {
          "name": "shell",
          "type": "string",
          "required": true,
          "description": "Shell type: bash, zsh, or fish"
        }
      ]
    }
  ]
}
