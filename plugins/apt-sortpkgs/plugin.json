{
  "name": "apt-sortpkgs",
  "version": "0.1.0",
  "description": "CLI tool: apt-sortpkgs",
  "source": "https://packages.debian.org/apt-sortpkgs",
  "checks": [{ "type": "binary", "name": "apt-sortpkgs" }],
  "install_guidance": {
    "plugin": "apt-sortpkgs", "binary": "apt-sortpkgs", "check": "which apt-sortpkgs",
    "install_steps": ["apt-get install apt-sortpkgs 2>/dev/null || which apt-sortpkgs", "Verify: apt-sortpkgs --version", "supercli plugins install ./plugins/apt-sortpkgs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apt-sortpkgs", "resource": "_", "action": "_",
    "description": "Passthrough to apt-sortpkgs CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-sortpkgs", "passthrough": true, "missingDependencyHelp": "Install apt-sortpkgs: apt-get install apt-sortpkgs" }, "args": []
  }]
}
