{
  "name": "jpeg-archive",
  "version": "0.1.0",
  "description": "Utilities for archiving JPEGs for long term storage",
  "source": "https://github.com/danielgtaylor/jpeg-archive",
  "checks": [
    {
      "type": "binary",
      "name": "jpeg-archive"
    }
  ],
  "install_guidance": {
    "plugin": "jpeg-archive",
    "binary": "jpeg-archive",
    "check": "which jpeg-archive",
    "install_steps": [
      "brew install jpeg-archive",
      "Verify: jpeg-archive --version",
      "supercli plugins install ./plugins/jpeg-archive --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jpeg-archive",
      "resource": "self",
      "action": "version",
      "description": "Print jpeg-archive version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpeg-archive",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jpeg-archive: brew install jpeg-archive"
      },
      "args": []
    },
    {
      "namespace": "jpeg-archive",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jpeg-archive CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpeg-archive",
        "passthrough": true,
        "missingDependencyHelp": "Install jpeg-archive"
      },
      "args": []
    }
  ]
}