{
  "name": "dee-todo",
  "version": "0.1.0",
  "description": "Local task list manager from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-todo" }],
  "install_guidance": {
    "plugin": "dee-todo",
    "binary": "dee-todo",
    "check": "which dee-todo",
    "install_steps": ["cargo install dee-todo", "Verify: dee-todo --version", "supercli plugins install ./plugins/dee-todo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-todo",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-todo CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-todo",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-todo: cargo install dee-todo"
    },
    "args": []
  }]
}
