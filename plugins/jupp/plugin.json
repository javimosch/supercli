{
  "name": "jupp",
  "version": "0.1.0",
  "description": "Configurable editor and fork of JOE with improvements",
  "source": "https://github.com/schilytools/jupp",
  "checks": [{ "type": "binary", "name": "jupp" }],
  "install_guidance": {
    "plugin": "jupp",
    "binary": "jupp",
    "check": "which jupp",
    "install_steps": ["brew install jupp", "Verify: jupp --version", "supercli plugins install ./plugins/jupp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jupp",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jupp CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jupp",
      "passthrough": true,
      "missingDependencyHelp": "Install jupp: brew install jupp", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
