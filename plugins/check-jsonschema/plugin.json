{
  "name": "check-jsonschema",
  "version": "0.1.0",
  "description": "JSON Schema CLI",
  "source": "https://github.com/python-jsonschema/check-jsonschema",
  "checks": [
    {
      "type": "binary",
      "name": "check-jsonschema"
    }
  ],
  "install_guidance": {
    "plugin": "check-jsonschema",
    "binary": "check-jsonschema",
    "check": "which check-jsonschema",
    "install_steps": [
      "brew install check-jsonschema",
      "Verify: check-jsonschema --version",
      "supercli plugins install ./plugins/check-jsonschema --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "check-jsonschema",
      "resource": "self",
      "action": "version",
      "description": "Print check-jsonschema version",
      "adapter": "process",
      "adapterConfig": {
        "command": "check-jsonschema",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install check-jsonschema: brew install check-jsonschema"
      },
      "args": []
    },
    {
      "namespace": "check-jsonschema",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to check-jsonschema CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "check-jsonschema",
        "passthrough": true,
        "missingDependencyHelp": "Install check-jsonschema"
      },
      "args": []
    }
  ]
}