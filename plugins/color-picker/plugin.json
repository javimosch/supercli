{
  "name": "color-picker",
  "version": "0.1.0",
  "description": "Color picker from command line",
  "source": "https://github.com/radnerus/color-picker",
  "checks": [
    {
      "type": "binary",
      "name": "color-picker"
    }
  ],
  "install_guidance": {
    "plugin": "color-picker",
    "binary": "color-picker",
    "check": "which color-picker",
    "install_steps": [
      "npm install -g color-picker",
      "Verify: color-picker --version",
      "supercli plugins install ./plugins/color-picker --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "color-picker",
      "resource": "self",
      "action": "version",
      "description": "Print color-picker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "color-picker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install color-picker: npm install -g color-picker"
      },
      "args": []
    },
    {
      "namespace": "color-picker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to color-picker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "color-picker",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install color-picker: npm install -g color-picker"
      },
      "args": []
    }
  ]
}
