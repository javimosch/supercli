{
  "name": "dash-licenses",
  "version": "0.1.0",
  "description": "Eclipse tool for automated license identification and clearance",
  "source": "maven",
  "checks": [{ "type": "binary", "name": "dash-licenses" }],
  "install_guidance": {
    "plugin": "dash-licenses",
    "binary": "dash-licenses",
    "check": "which dash-licenses",
    "install_steps": ["mvn clean package", "Verify: dash-licenses --version", "supercli plugins install ./plugins/dash-licenses --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dash-licenses",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dash-licenses CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dash-licenses",
      "passthrough": true,
      "missingDependencyHelp": "Install dash-licenses: mvn clean package"
    },
    "args": []
  }]
}
