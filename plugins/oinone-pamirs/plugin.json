{
  "name": "oinone-pamirs",
  "version": "0.1.0",
  "description": "Oinone is an AI\u2011Powered low\u2011code framework that unifies AI and developers around a shared metadata m",
  "source": "https://github.com/oinone-pamirs/oinone-pamirs",
  "checks": [
    {
      "type": "binary",
      "name": "oinone-pamirs"
    }
  ],
  "install_guidance": {
    "plugin": "oinone-pamirs",
    "binary": "oinone-pamirs",
    "check": "which oinone-pamirs",
    "install_steps": [
      "pip install oinone-pamirs",
      "Verify: oinone-pamirs --version",
      "supercli plugins install ./plugins/oinone-pamirs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oinone-pamirs",
      "resource": "self",
      "action": "version",
      "description": "Print oinone-pamirs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oinone-pamirs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oinone-pamirs: pip install oinone-pamirs"
      },
      "args": []
    },
    {
      "namespace": "oinone-pamirs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oinone-pamirs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oinone-pamirs",
        "passthrough": true,
        "missingDependencyHelp": "Install oinone-pamirs: pip install oinone-pamirs"
      },
      "args": []
    }
  ]
}