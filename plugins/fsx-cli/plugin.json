{
  "name": "fsx-cli",
  "version": "0.1.0",
  "description": "A high-performance streaming text processing CLI written in x86-64 assembly (no libc, syscall-only).",
  "source": "https://github.com/fsx-cli/fsx-cli",
  "checks": [
    {
      "type": "binary",
      "name": "fsx-cli"
    }
  ],
  "install_guidance": {
    "plugin": "fsx-cli",
    "binary": "fsx-cli",
    "check": "which fsx-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: fsx-cli --version",
      "supercli plugins install ./plugins/fsx-cli --on-conflict replace --json"
    ],
    "note": "Assembly language CLI tool"
  },
  "commands": [
    {
      "namespace": "fsx-cli",
      "resource": "self",
      "action": "version",
      "description": "Print fsx-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsx-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fsx-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "fsx-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fsx-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsx-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install fsx-cli from project repository"
      },
      "args": []
    }
  ]
}