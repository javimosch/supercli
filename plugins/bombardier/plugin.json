{
  "name": "bombardier",
  "version": "0.1.0",
  "description": "Fast cross-platform HTTP benchmarking tool",
  "source": "https://github.com/codesenberg/bombardier",
  "checks": [{ "type": "binary", "name": "bombardier" }],
  "install_guidance": {
    "plugin": "bombardier",
    "binary": "bombardier",
    "check": "which bombardier",
    "install_steps": ["go install github.com/codesenberg/bombardier@latest", "Verify: bombardier --version", "supercli plugins install ./plugins/bombardier --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bombardier",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bombardier CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bombardier",
      "passthrough": true,
      "missingDependencyHelp": "Install bombardier: go install github.com/codesenberg/bombardier@latest"
    },
    "args": []
  }]
}
