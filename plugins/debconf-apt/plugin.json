{
  "name": "debconf-apt",
  "version": "0.1.0",
  "description": "CLI tool: debconf-apt",
  "source": "https://packages.debian.org/debconf-apt",
  "checks": [{ "type": "binary", "name": "debconf-apt" }],
  "install_guidance": {
    "plugin": "debconf-apt", "binary": "debconf-apt", "check": "which debconf-apt",
    "install_steps": ["apt-get install debconf-apt 2>/dev/null || which debconf-apt", "Verify: debconf-apt --version", "supercli plugins install ./plugins/debconf-apt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "debconf-apt", "resource": "_", "action": "_",
    "description": "Passthrough to debconf-apt CLI",
    "adapter": "process", "adapterConfig": { "command": "debconf-apt", "passthrough": true, "missingDependencyHelp": "Install debconf-apt: apt-get install debconf-apt" }, "args": []
  }]
}
