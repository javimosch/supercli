{
  "plugin": "isdv4-serial-debugger",
  "binary": "isdv4-serial-debugger",
  "check": "which isdv4-serial-debugger",
  "install_steps": [
    "apt-get install isdv4-serial-debugger 2>/dev/null || which isdv4-serial-debugger",
    "Verify: isdv4-serial-debugger --version",
    "supercli plugins install ./plugins/isdv4-serial-debugger --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}