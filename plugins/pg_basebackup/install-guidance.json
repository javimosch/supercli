{
  "plugin": "pg_basebackup",
  "binary": "pg_basebackup",
  "check": "which pg_basebackup",
  "install_steps": [
    "apt-get install pg_basebackup 2>/dev/null || which pg_basebackup",
    "Verify: pg_basebackup --version",
    "supercli plugins install ./plugins/pg_basebackup --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}