{
  "name": "edge-tts-gen",
  "version": "0.1.0",
  "description": "Generate speech audio using Microsoft Edge TTS API",
  "source": "https://github.com/node-util/edge-tts-generator",
  "checks": [{ "type": "binary", "name": "edge-tts-gen" }],
  "install_guidance": {
    "plugin": "edge-tts-gen",
    "binary": "edge-tts-gen",
    "check": "which edge-tts-gen",
    "install_steps": ["npm install -g edge-tts-generator", "Verify: edge-tts-gen --version", "supercli plugins install ./plugins/edge-tts-gen --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "edge-tts-gen",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to edge-tts-gen CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "edge-tts-gen",
      "passthrough": true,
      "missingDependencyHelp": "Install edge-tts-gen: npm install -g edge-tts-generator", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
