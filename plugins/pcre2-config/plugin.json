{
  "name": "pcre2-config",
  "version": "0.1.0",
  "description": "CLI tool: pcre2-config",
  "source": "https://manpages.debian.org/pcre2-config",
  "checks": [
    {
      "type": "binary",
      "name": "pcre2-config"
    }
  ],
  "install_guidance": {
    "plugin": "pcre2-config",
    "binary": "pcre2-config",
    "check": "which pcre2-config",
    "install_steps": [
      "apt-get install pcre2-config 2>/dev/null || which pcre2-config",
      "Verify: pcre2-config --version",
      "supercli plugins install ./plugins/pcre2-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pcre2-config",
      "resource": "self",
      "action": "version",
      "description": "Print pcre2-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pcre2-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pcre2-config: apt-get install pcre2-config 2>/dev/null || which pcre2-config"
      },
      "args": []
    },
    {
      "namespace": "pcre2-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pcre2-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pcre2-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pcre2-config: apt-get install pcre2-config 2>/dev/null || which pcre2-config"
      },
      "args": []
    }
  ]
}