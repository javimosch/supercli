{
  "name": "agentmemory-cli",
  "version": "0.1.0",
  "description": "Persistent memory for AI coding agents \u2014 save, search, and recall context across sessions",
  "source": "https://github.com/javimosch/agentmemory-cli",
  "checks": [
    {
      "type": "binary",
      "name": "agentmemory-cli"
    }
  ],
  "install_guidance": {
    "plugin": "agentmemory-cli",
    "binary": "agentmemory-cli",
    "check": "which agentmemory-cli",
    "install_steps": [
      "curl -LO https://github.com/javimosch/agentmemory-cli/releases/latest/download/agentmemory-cli-linux-amd64",
      "chmod +x agentmemory-cli-linux-amd64 && mv agentmemory-cli-linux-amd64 ~/.local/bin/agentmemory-cli",
      "Verify: agentmemory-cli --version",
      "supercli plugins install ./plugins/agentmemory-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agentmemory-cli",
      "resource": "memory",
      "action": "save",
      "description": "Save a memory. Usage: sc agentmemory-cli memory save --text <text> [--project <p>] [--tags <a,b>] [--json]",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory-cli",
        "baseArgs": ["save"],
        "cwd": "invoke_cwd",
        "timeout_ms": 10000,
        "missingDependencyHelp": "curl -LO https://github.com/javimosch/agentmemory-cli/releases/latest/download/agentmemory-cli-linux-amd64 && chmod +x agentmemory-cli-linux-amd64 && mv agentmemory-cli-linux-amd64 ~/.local/bin/agentmemory-cli"
      },
      "args": [
        {
          "name": "text",
          "type": "string",
          "required": true,
          "positional": false,
          "description": "Memory text content (--text <text>). Named flag, not positional."
        },
        {
          "name": "project",
          "type": "string",
          "required": false,
          "description": "Project name (--project <name>)"
        },
        {
          "name": "tags",
          "type": "string",
          "required": false,
          "description": "Comma-separated tags (--tags <a,b,c>)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "JSON output (--json)"
        }
      ]
    },
    {
      "namespace": "agentmemory-cli",
      "resource": "memory",
      "action": "search",
      "description": "Search memories by keyword. Usage: sc agentmemory-cli memory search --query <term> [--project <p>] [--json]",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory-cli",
        "baseArgs": ["search"],
        "cwd": "invoke_cwd",
        "timeout_ms": 10000,
        "missingDependencyHelp": "curl -LO https://github.com/javimosch/agentmemory-cli/releases/latest/download/agentmemory-cli-linux-amd64 && chmod +x agentmemory-cli-linux-amd64 && mv agentmemory-cli-linux-amd64 ~/.local/bin/agentmemory-cli"
      },
      "args": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "positional": true,
          "description": "Search query — passed as positional arg (not --query): agentmemory-cli search <term>"
        },
        {
          "name": "project",
          "type": "string",
          "required": false,
          "description": "Filter by project (--project <name>)"
        },
        {
          "name": "limit",
          "type": "string",
          "required": false,
          "description": "Max results (--limit <n>)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "JSON output (--json)"
        }
      ]
    },
    {
      "namespace": "agentmemory-cli",
      "resource": "memory",
      "action": "list",
      "description": "List recent memories. Usage: sc agentmemory-cli memory list [--project <p>] [--limit <n>] [--json]",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory-cli",
        "baseArgs": ["list"],
        "cwd": "invoke_cwd",
        "timeout_ms": 10000,
        "missingDependencyHelp": "curl -LO https://github.com/javimosch/agentmemory-cli/releases/latest/download/agentmemory-cli-linux-amd64 && chmod +x agentmemory-cli-linux-amd64 && mv agentmemory-cli-linux-amd64 ~/.local/bin/agentmemory-cli"
      },
      "args": [
        {
          "name": "project",
          "type": "string",
          "required": false,
          "description": "Filter by project (--project <name>)"
        },
        {
          "name": "limit",
          "type": "string",
          "required": false,
          "description": "Max results (--limit <n>)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "JSON output (--json)"
        }
      ]
    },
    {
      "namespace": "agentmemory-cli",
      "resource": "memory",
      "action": "forget",
      "description": "Delete a memory by ID. Usage: sc agentmemory-cli memory forget --id <id>",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory-cli",
        "baseArgs": ["forget"],
        "cwd": "invoke_cwd",
        "timeout_ms": 10000,
        "missingDependencyHelp": "curl -LO https://github.com/javimosch/agentmemory-cli/releases/latest/download/agentmemory-cli-linux-amd64 && chmod +x agentmemory-cli-linux-amd64 && mv agentmemory-cli-linux-amd64 ~/.local/bin/agentmemory-cli"
      },
      "args": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "positional": true,
          "description": "Memory ID — positional arg: agentmemory-cli forget <id>"
        }
      ]
    },
    {
      "namespace": "agentmemory-cli",
      "resource": "memory",
      "action": "stats",
      "description": "Show memory statistics. Usage: sc agentmemory-cli memory stats [--project <p>] [--json]",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory-cli",
        "baseArgs": ["profile"],
        "cwd": "invoke_cwd",
        "timeout_ms": 10000,
        "missingDependencyHelp": "curl -LO https://github.com/javimosch/agentmemory-cli/releases/latest/download/agentmemory-cli-linux-amd64 && chmod +x agentmemory-cli-linux-amd64 && mv agentmemory-cli-linux-amd64 ~/.local/bin/agentmemory-cli"
      },
      "args": [
        {
          "name": "project",
          "type": "string",
          "required": false,
          "description": "Filter by project (--project <name>)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "JSON output (--json)"
        }
      ]
    },
    {
      "namespace": "agentmemory-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough: sc agentmemory-cli _ _ <subcmd> [args]",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory-cli",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "curl -LO https://github.com/javimosch/agentmemory-cli/releases/latest/download/agentmemory-cli-linux-amd64 && chmod +x agentmemory-cli-linux-amd64 && mv agentmemory-cli-linux-amd64 ~/.local/bin/agentmemory-cli"
      },
      "args": []
    }
  ]
}
