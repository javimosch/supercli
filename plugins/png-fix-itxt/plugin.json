{
  "name": "png-fix-itxt",
  "version": "0.1.0",
  "description": "CLI tool: png-fix-itxt",
  "source": "https://manpages.debian.org/png-fix-itxt",
  "checks": [
    {
      "type": "binary",
      "name": "png-fix-itxt"
    }
  ],
  "install_guidance": {
    "plugin": "png-fix-itxt",
    "binary": "png-fix-itxt",
    "check": "which png-fix-itxt",
    "install_steps": [
      "apt-get install png-fix-itxt 2>/dev/null || which png-fix-itxt",
      "Verify: png-fix-itxt --version",
      "supercli plugins install ./plugins/png-fix-itxt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "png-fix-itxt",
      "resource": "self",
      "action": "version",
      "description": "Print png-fix-itxt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "png-fix-itxt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install png-fix-itxt: apt-get install png-fix-itxt 2>/dev/null || which png-fix-itxt"
      },
      "args": []
    },
    {
      "namespace": "png-fix-itxt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to png-fix-itxt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "png-fix-itxt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install png-fix-itxt: apt-get install png-fix-itxt 2>/dev/null || which png-fix-itxt"
      },
      "args": []
    }
  ]
}