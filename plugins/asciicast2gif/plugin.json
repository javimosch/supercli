{
  "name": "asciicast2gif",
  "version": "0.1.0",
  "description": "Convert asciicast v2 files to animated GIFs",
  "source": "https://github.com/asciinema/asciicast2gif",
  "checks": [{ "type": "binary", "name": "asciicast2gif" }],
  "install_guidance": {
    "plugin": "asciicast2gif",
    "binary": "asciicast2gif",
    "check": "which asciicast2gif",
    "install_steps": ["npm install -g asciicast2gif", "Verify: asciicast2gif --version", "supercli plugins install ./plugins/asciicast2gif --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "asciicast2gif",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to asciicast2gif CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "asciicast2gif",
      "passthrough": true,
      "missingDependencyHelp": "Install asciicast2gif: npm install -g asciicast2gif", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
