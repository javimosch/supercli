{
  "name": "prek",
  "version": "0.1.0",
  "description": "\u26a1 A fast Git hook manager written in Rust, designed as a drop-in alternative to pre-commit, reimagin",
  "source": "https://github.com/prek/prek",
  "checks": [
    {
      "type": "binary",
      "name": "prek"
    }
  ],
  "install_guidance": {
    "plugin": "prek",
    "binary": "prek",
    "check": "which prek",
    "install_steps": [
      "pip install prek",
      "Verify: prek --version",
      "supercli plugins install ./plugins/prek --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "prek",
      "resource": "self",
      "action": "version",
      "description": "Print prek version",
      "adapter": "process",
      "adapterConfig": {
        "command": "prek",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install prek: pip install prek"
      },
      "args": []
    },
    {
      "namespace": "prek",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to prek CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "prek",
        "passthrough": true,
        "missingDependencyHelp": "Install prek: pip install prek"
      },
      "args": []
    }
  ]
}