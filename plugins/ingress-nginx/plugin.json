{
  "name": "ingress-nginx",
  "version": "0.1.0",
  "description": "Kubernetes Ingress NGINX controller",
  "source": "https://github.com/kubernetes/ingress-nginx",
  "checks": [{ "type": "binary", "name": "ingress-nginx" }],
  "install_guidance": {
    "plugin": "ingress-nginx",
    "binary": "ingress-nginx",
    "check": "which ingress-nginx",
    "install_steps": ["brew install ingress-nginx", "Verify: ingress-nginx --version", "supercli plugins install ./plugins/ingress-nginx --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ingress-nginx",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ingress-nginx CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ingress-nginx",
      "passthrough": true,
      "missingDependencyHelp": "Install ingress-nginx: brew install ingress-nginx"
    },
    "args": []
  }]
}
