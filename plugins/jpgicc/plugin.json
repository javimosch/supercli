{
  "name": "jpgicc",
  "version": "0.1.0",
  "description": "CLI tool: jpgicc",
  "source": "https://manpages.debian.org/jpgicc",
  "checks": [
    {
      "type": "binary",
      "name": "jpgicc"
    }
  ],
  "install_guidance": {
    "plugin": "jpgicc",
    "binary": "jpgicc",
    "check": "which jpgicc",
    "install_steps": [
      "apt-get install jpgicc 2>/dev/null || which jpgicc",
      "Verify: jpgicc --version",
      "supercli plugins install ./plugins/jpgicc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jpgicc",
      "resource": "self",
      "action": "version",
      "description": "Print jpgicc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpgicc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jpgicc: apt-get install jpgicc 2>/dev/null || which jpgicc"
      },
      "args": []
    },
    {
      "namespace": "jpgicc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jpgicc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpgicc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jpgicc: apt-get install jpgicc 2>/dev/null || which jpgicc"
      },
      "args": []
    }
  ]
}