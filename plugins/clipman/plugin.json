{
  "name": "clipman",
  "version": "0.1.0",
  "description": "Simple Wayland clipboard manager daemon and CLI",
  "source": "https://github.com/yethal/clipman",
  "checks": [{ "type": "binary", "name": "clipman" }],
  "install_guidance": {
    "plugin": "clipman",
    "binary": "clipman",
    "check": "which clipman",
    "install_steps": ["go install github.com/yethal/clipman@latest", "Verify: clipman --version", "supercli plugins install ./plugins/clipman --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clipman",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clipman CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clipman",
      "passthrough": true,
      "missingDependencyHelp": "Install clipman: go install github.com/yethal/clipman@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
