{
  "name": "spellcaster",
  "version": "0.1.0",
  "description": "AI-powered grammar and spelling checker for documents",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "spellcaster" }],
  "install_guidance": {
    "plugin": "spellcaster",
    "binary": "spellcaster",
    "check": "which spellcaster",
    "install_steps": ["pip install spellcaster", "Verify: spellcaster --version", "supercli plugins install ./plugins/spellcaster --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "spellcaster",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to spellcaster CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "spellcaster",
      "passthrough": true,
      "missingDependencyHelp": "Install spellcaster: pip install spellcaster"
    },
    "args": []
  }]
}
