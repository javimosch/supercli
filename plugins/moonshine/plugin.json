{
  "name": "moonshine",
  "version": "0.1.0",
  "description": "Very low latency speech to text, intent recognition, and text to speech, for building voice agents a",
  "source": "https://github.com/moonshine/moonshine",
  "checks": [
    {
      "type": "binary",
      "name": "moonshine"
    }
  ],
  "install_guidance": {
    "plugin": "moonshine",
    "binary": "moonshine",
    "check": "which moonshine",
    "install_steps": [
      "pip install moonshine",
      "Verify: moonshine --version",
      "supercli plugins install ./plugins/moonshine --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "moonshine",
      "resource": "self",
      "action": "version",
      "description": "Print moonshine version",
      "adapter": "process",
      "adapterConfig": {
        "command": "moonshine",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install moonshine: pip install moonshine"
      },
      "args": []
    },
    {
      "namespace": "moonshine",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to moonshine CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "moonshine",
        "passthrough": true,
        "missingDependencyHelp": "Install moonshine: pip install moonshine"
      },
      "args": []
    }
  ]
}