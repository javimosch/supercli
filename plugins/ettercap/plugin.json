{
  "name": "ettercap",
  "version": "1.0.0",
  "description": "ettercap \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=ettercap+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "ettercap"
    }
  ],
  "install_guidance": {
    "plugin": "ettercap",
    "binary": "ettercap",
    "check": "which ettercap",
    "install_steps": [
      "Install ettercap via package manager: apt install ettercap or brew install ettercap"
    ]
  },
  "commands": [
    {
      "namespace": "ettercap",
      "resource": "run",
      "action": "exec",
      "description": "ettercap \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "ettercap",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ettercap via your package manager"
      },
      "args": []
    }
  ]
}