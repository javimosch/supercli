{
  "name": "typescript-go",
  "version": "0.1.0",
  "description": "Staging repo for development of native port of TypeScript",
  "source": "https://github.com/typescript-go/typescript-go",
  "checks": [
    {
      "type": "binary",
      "name": "typescript-go"
    }
  ],
  "install_guidance": {
    "plugin": "typescript-go",
    "binary": "typescript-go",
    "check": "which typescript-go",
    "install_steps": [
      "pip install typescript-go",
      "Verify: typescript-go --version",
      "supercli plugins install ./plugins/typescript-go --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "typescript-go",
      "resource": "self",
      "action": "version",
      "description": "Print typescript-go version",
      "adapter": "process",
      "adapterConfig": {
        "command": "typescript-go",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install typescript-go: pip install typescript-go"
      },
      "args": []
    },
    {
      "namespace": "typescript-go",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to typescript-go CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "typescript-go",
        "passthrough": true,
        "missingDependencyHelp": "Install typescript-go: pip install typescript-go"
      },
      "args": []
    }
  ]
}