        "command": "pgmramp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgmramp: apt-get install pgmramp 2>/dev/null || which pgmramp"
      },
      "args": []
    },
    {
      "namespace": "pgmramp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgmramp CLI",
