{
  "name": "Pensieve",
  "version": "0.1.0",
  "description": "tore your decisions and principles. Claude reads them to make better choices.",
  "source": "https://github.com/Pensieve/Pensieve",
  "checks": [
    {
      "type": "binary",
      "name": "pensieve"
    }
  ],
  "install_guidance": {
    "plugin": "Pensieve",
    "binary": "pensieve",
    "check": "which pensieve",
    "install_steps": [
      "pip install pensieve",
      "Verify: pensieve --version",
      "supercli plugins install ./plugins/Pensieve --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Pensieve",
      "resource": "self",
      "action": "version",
      "description": "Print Pensieve version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pensieve",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Pensieve: pip install pensieve"
      },
      "args": []
    },
    {
      "namespace": "Pensieve",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pensieve CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pensieve",
        "passthrough": true,
        "missingDependencyHelp": "Install Pensieve: pip install pensieve"
      },
      "args": []
    }
  ]
}