{
  "name": "terraform-controller",
  "version": "0.1.0",
  "description": "Terraform controller for Flux CD",
  "source": "https://github.com/weaveworks/tf-controller",
  "checks": [{ "type": "binary", "name": "tf-controller" }],
  "install_guidance": {
    "plugin": "terraform-controller",
    "binary": "tf-controller",
    "check": "which tf-controller",
    "install_steps": ["brew install tf-controller", "Verify: tf-controller --version", "supercli plugins install ./plugins/terraform-controller --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terraform-controller",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tf-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tf-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install terraform-controller: brew install tf-controller"
    },
    "args": []
  }]
}
