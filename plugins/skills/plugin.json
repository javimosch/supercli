{
  "name": "skills",
  "version": "0.1.0",
  "description": "The open agent skills tool - npx skills",
  "source": "https://github.com/skills/skills",
  "checks": [
    {
      "type": "binary",
      "name": "skills"
    }
  ],
  "install_guidance": {
    "plugin": "skills",
    "binary": "skills",
    "check": "which skills",
    "install_steps": [
      "pip install skills",
      "Verify: skills --version",
      "supercli plugins install ./plugins/skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "skills",
      "resource": "self",
      "action": "version",
      "description": "Print skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install skills: pip install skills"
      },
      "args": []
    },
    {
      "namespace": "skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "skills",
        "passthrough": true,
        "missingDependencyHelp": "Install skills: pip install skills"
      },
      "args": []
    }
  ]
}