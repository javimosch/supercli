{
  "name": "lazyjj",
  "version": "0.1.0",
  "description": "TUI for the jujutsu (jj) version control system — browse revsets, diff changes, and manage the operation log",
  "source": "https://github.com/Cretezy/lazyjj",
  "checks": [
    { "type": "binary", "name": "lazyjj" }
  ],
  "install_guidance": {
    "plugin": "lazyjj",
    "binary": "lazyjj",
    "check": "which lazyjj",
    "install_steps": [
      "cargo install lazyjj",
      "Verify: lazyjj --version",
      "supercli plugins install ./plugins/lazyjj --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lazyjj",
      "resource": "self",
      "action": "version",
      "description": "Print lazyjj version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lazyjj",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install lazyjj: cargo install lazyjj"
      },
      "args": []
    },
    {
      "namespace": "lazyjj",
      "resource": "tui",
      "action": "open",
      "description": "Launch the lazyjj TUI in the current jj repository (interactive)",
      "adapter": "process",
      "adapterConfig": {
        "command": "lazyjj",
        "passthrough": true,
        "timeout_ms": 300000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lazyjj: cargo install lazyjj"
      },
      "args": []
    },
    {
      "namespace": "lazyjj",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lazyjj CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lazyjj",
        "passthrough": true,
        "timeout_ms": 300000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lazyjj: cargo install lazyjj"
      },
      "args": []
    }
  ]
}
