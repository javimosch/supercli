{
  "name": "compound-engineering-plugin",
  "version": "0.1.0",
  "description": "Official Compound Engineering plugin for Claude Code, Codex, Cursor, and more",
  "source": "https://github.com/compound-engineering-plugin/compound-engineering-plugin",
  "checks": [
    {
      "type": "binary",
      "name": "compound-engineering-plugin"
    }
  ],
  "install_guidance": {
    "plugin": "compound-engineering-plugin",
    "binary": "compound-engineering-plugin",
    "check": "which compound-engineering-plugin",
    "install_steps": [
      "pip install compound-engineering-plugin",
      "Verify: compound-engineering-plugin --version",
      "supercli plugins install ./plugins/compound-engineering-plugin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "compound-engineering-plugin",
      "resource": "self",
      "action": "version",
      "description": "Print compound-engineering-plugin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "compound-engineering-plugin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install compound-engineering-plugin: pip install compound-engineering-plugin"
      },
      "args": []
    },
    {
      "namespace": "compound-engineering-plugin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to compound-engineering-plugin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "compound-engineering-plugin",
        "passthrough": true,
        "missingDependencyHelp": "Install compound-engineering-plugin: pip install compound-engineering-plugin"
      },
      "args": []
    }
  ]
}