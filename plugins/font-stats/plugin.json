{
  "name": "font-stats",
  "version": "0.1.0",
  "description": "Analyze font file metrics and glyph counts",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "font-stats" }],
  "install_guidance": {
    "plugin": "font-stats",
    "binary": "font-stats",
    "check": "which font-stats",
    "install_steps": ["pip install font-stats", "Verify: font-stats --version", "supercli plugins install ./plugins/font-stats --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "font-stats",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to font-stats CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "font-stats",
      "passthrough": true,
      "missingDependencyHelp": "Install font-stats: pip install font-stats"
    },
    "args": []
  }]
}
