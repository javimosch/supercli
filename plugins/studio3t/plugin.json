{
  "name": "studio3t",
  "version": "0.1.0",
  "description": "CLI tool: studio3t",
  "source": "https://manpages.debian.org/studio3t",
  "checks": [
    {
      "type": "binary",
      "name": "studio3t"
    }
  ],
  "install_guidance": {
    "plugin": "studio3t",
    "binary": "studio3t",
    "check": "which studio3t",
    "install_steps": [
      "apt-get install studio3t 2>/dev/null || which studio3t",
      "Verify: studio3t --version",
      "supercli plugins install ./plugins/studio3t --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "studio3t",
      "resource": "self",
      "action": "version",
      "description": "Print studio3t version",
      "adapter": "process",
      "adapterConfig": {
        "command": "studio3t",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install studio3t: apt-get install studio3t 2>/dev/null || which studio3t"
      },
      "args": []
    },
    {
      "namespace": "studio3t",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to studio3t CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "studio3t",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install studio3t: apt-get install studio3t 2>/dev/null || which studio3t"
      },
      "args": []
    }
  ]
}