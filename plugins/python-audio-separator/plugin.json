{
  "name": "python-audio-separator",
  "version": "0.1.0",
  "description": "Stem separation for audio files in Python",
  "source": "https://github.com/nicedoc/python-audio-separator",
  "checks": [
    {
      "type": "binary",
      "name": "audio-separator"
    }
  ],
  "install_guidance": {
    "plugin": "python-audio-separator",
    "binary": "audio-separator",
    "check": "which audio-separator",
    "install_steps": [
      "pip install audio-separator",
      "Verify: audio-separator --version",
      "supercli plugins install ./plugins/python-audio-separator --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "python-audio-separator",
      "resource": "self",
      "action": "version",
      "description": "Print python-audio-separator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "audio-separator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install python-audio-separator: pip install audio-separator"
      },
      "args": []
    },
    {
      "namespace": "python-audio-separator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to python-audio-separator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "audio-separator",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install python-audio-separator: pip install audio-separator"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
