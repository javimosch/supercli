{
  "name": "aibrix",
  "version": "0.1.0",
  "description": "Cost-efficient and pluggable Infrastructure components for GenAI inference",
  "source": "https://github.com/aibrix/aibrix",
  "checks": [
    {
      "type": "binary",
      "name": "aibrix"
    }
  ],
  "install_guidance": {
    "plugin": "aibrix",
    "binary": "aibrix",
    "check": "which aibrix",
    "install_steps": [
      "pip install aibrix",
      "Verify: aibrix --version",
      "supercli plugins install ./plugins/aibrix --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aibrix",
      "resource": "self",
      "action": "version",
      "description": "Print aibrix version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aibrix",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aibrix: pip install aibrix"
      },
      "args": []
    },
    {
      "namespace": "aibrix",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aibrix CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aibrix",
        "passthrough": true,
        "missingDependencyHelp": "Install aibrix: pip install aibrix"
      },
      "args": []
    }
  ]
}