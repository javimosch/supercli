{
  "name": "grimmory",
  "version": "0.1.0",
  "description": "Grimmory is an independent community fork of Booklore.",
  "source": "https://github.com/grimmory/grimmory",
  "checks": [
    {
      "type": "binary",
      "name": "grimmory"
    }
  ],
  "install_guidance": {
    "plugin": "grimmory",
    "binary": "grimmory",
    "check": "which grimmory",
    "install_steps": [
      "pip install grimmory",
      "Verify: grimmory --version",
      "supercli plugins install ./plugins/grimmory --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grimmory",
      "resource": "self",
      "action": "version",
      "description": "Print grimmory version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grimmory",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grimmory: pip install grimmory"
      },
      "args": []
    },
    {
      "namespace": "grimmory",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grimmory CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grimmory",
        "passthrough": true,
        "missingDependencyHelp": "Install grimmory: pip install grimmory"
      },
      "args": []
    }
  ]
}