{
  "name": "Rustcat",
  "version": "0.1.0",
  "description": "Netcat Alternative in Rust.",
  "source": "https://github.com/robiot/rustcat",
  "checks": [
    {
      "type": "binary",
      "name": "Rustcat"
    }
  ],
  "install_guidance": {
    "plugin": "Rustcat",
    "binary": "Rustcat",
    "check": "which Rustcat",
    "install_steps": [
      "cargo install Rustcat",
      "Verify: Rustcat --version",
      "supercli plugins install ./plugins/Rustcat --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Rustcat",
      "resource": "self",
      "action": "version",
      "description": "Print Rustcat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Rustcat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Rustcat: cargo install Rustcat"
      },
      "args": []
    },
    {
      "namespace": "Rustcat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Rustcat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Rustcat",
        "passthrough": true,
        "missingDependencyHelp": "Install Rustcat"
      },
      "args": []
    }
  ]
}