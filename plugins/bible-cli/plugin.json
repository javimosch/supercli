{
  "name": "bible-cli",
  "version": "0.1.0",
  "description": "Minimalist Bible verse reader for the terminal",
  "source": "https://github.com/khalid-j/bible-cli",
  "checks": [{ "type": "binary", "name": "bible-cli" }],
  "install_guidance": {
    "plugin": "bible-cli",
    "binary": "bible-cli",
    "check": "which bible-cli",
    "install_steps": ["npm install -g bible-cli", "Verify: bible-cli --version", "supercli plugins install ./plugins/bible-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bible-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bible-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bible-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install bible-cli: npm install -g bible-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
