{
  "name": "amuFormat.sh",
  "version": "0.1.0",
  "description": "CLI tool: amuFormat.sh",
  "source": "https://manpages.debian.org/amuFormat.sh",
  "checks": [
    {
      "type": "binary",
      "name": "amuFormat.sh"
    }
  ],
  "install_guidance": {
    "plugin": "amuFormat.sh",
    "binary": "amuFormat.sh",
    "check": "which amuFormat.sh",
    "install_steps": [
      "apt-get install amuFormat.sh 2>/dev/null || which amuFormat.sh",
      "Verify: amuFormat.sh --version",
      "supercli plugins install ./plugins/amuFormat.sh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "amuFormat.sh",
      "resource": "self",
      "action": "version",
      "description": "Print amuFormat.sh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "amuFormat.sh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install amuFormat.sh: apt-get install amuFormat.sh 2>/dev/null || which amuFormat.sh"
      },
      "args": []
    },
    {
      "namespace": "amuFormat.sh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to amuFormat.sh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "amuFormat.sh",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install amuFormat.sh: apt-get install amuFormat.sh 2>/dev/null || which amuFormat.sh"
      },
      "args": []
    }
  ]
}