{
  "name": "pkger",
  "version": "0.1.0",
  "description": "Embed static files into Go binaries",
  "source": "https://github.com/markbates/pkger",
  "checks": [{ "type": "binary", "name": "pkger" }],
  "install_guidance": {
    "plugin": "pkger",
    "binary": "pkger",
    "check": "which pkger",
    "install_steps": ["go install github.com/markbates/pkger/cmd/pkger@latest", "Verify: pkger --version", "supercli plugins install ./plugins/pkger --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pkger",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pkger CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pkger",
      "passthrough": true,
      "missingDependencyHelp": "Install pkger: go install github.com/markbates/pkger/cmd/pkger@latest"
    },
    "args": []
  }]
}
