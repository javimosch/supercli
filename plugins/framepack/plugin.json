{
  "name": "framepack",
  "version": "0.1.0",
  "description": "Make video diffusion practical with frame packing technique",
  "source": "https://github.com/lllyasviel/FramePack",
  "checks": [
    {
      "type": "binary",
      "name": "framepack"
    }
  ],
  "install_guidance": {
    "plugin": "framepack",
    "binary": "framepack",
    "check": "which framepack",
    "install_steps": [
      "pip install framepack",
      "Verify: framepack --version",
      "supercli plugins install ./plugins/framepack --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "framepack",
    "resource": "self",
    "action": "version",
    "description": "Print framepack version",
    "adapter": "process",
    "adapterConfig": {
      "command": "framepack",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install framepack: pip install framepack"
    },
    "args": []
  },
  {
    "namespace": "framepack",
    "resource": "video",
    "action": "generate",
    "description": "Generate video from prompts",
    "adapter": "process",
    "adapterConfig": {
      "command": "framepack",
      "passthrough": true,
      "missingDependencyHelp": "Install framepack: pip install framepack"
    },
    "args": []
  },
  {
    "namespace": "framepack",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to framepack CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "framepack",
      "passthrough": true,
      "missingDependencyHelp": "Install framepack"
    },
    "args": []
  }
]
}