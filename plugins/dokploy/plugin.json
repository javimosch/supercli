{
  "name": "dokploy",
  "version": "0.1.0",
  "description": "Open Source Alternative to Vercel, Netlify and Heroku.",
  "source": "https://github.com/dokploy/dokploy",
  "checks": [
    {
      "type": "binary",
      "name": "dokploy"
    }
  ],
  "install_guidance": {
    "plugin": "dokploy",
    "binary": "dokploy",
    "check": "which dokploy",
    "install_steps": [
      "pip install dokploy",
      "Verify: dokploy --version",
      "supercli plugins install ./plugins/dokploy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dokploy",
      "resource": "self",
      "action": "version",
      "description": "Print dokploy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dokploy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dokploy: pip install dokploy"
      },
      "args": []
    },
    {
      "namespace": "dokploy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dokploy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dokploy",
        "passthrough": true,
        "missingDependencyHelp": "Install dokploy: pip install dokploy"
      },
      "args": []
    }
  ]
}