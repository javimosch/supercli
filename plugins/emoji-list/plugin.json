{
  "name": "emoji-list",
  "version": "0.1.0",
  "description": "List directory contents using folder and file emojis",
  "source": "https://github.com/scriptingosx/emoji-list",
  "checks": [{ "type": "binary", "name": "emoji-list" }],
  "install_guidance": {
    "plugin": "emoji-list",
    "binary": "emoji-list",
    "check": "which emoji-list",
    "install_steps": ["script/binary", "Verify: emoji-list --version", "supercli plugins install ./plugins/emoji-list --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "emoji-list",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to emoji-list CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "emoji-list",
      "passthrough": true,
      "missingDependencyHelp": "Install emoji-list: script/binary", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
