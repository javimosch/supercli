{
  "name": "languagetool",
  "version": "0.1.0",
  "description": "Style and grammar checker for 25+ languages",
  "source": "https://github.com/languagetool-org/languagetool",
  "checks": [{ "type": "binary", "name": "languagetool" }],
  "install_guidance": {
    "plugin": "languagetool",
    "binary": "languagetool",
    "check": "which languagetool",
    "install_steps": ["brew install languagetool", "Verify: languagetool --version", "supercli plugins install ./plugins/languagetool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "languagetool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to languagetool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "languagetool",
      "passthrough": true,
      "missingDependencyHelp": "Install languagetool: brew install languagetool", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
