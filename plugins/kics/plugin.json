{
  "name": "kics",
  "version": "0.1.0",
  "description": "Find security vulnerabilities and compliance issues in IaC",
  "source": "https://github.com/Checkmarx/kics",
  "checks": [{ "type": "binary", "name": "kics" }],
  "install_guidance": {
    "plugin": "kics",
    "binary": "kics",
    "check": "which kics",
    "install_steps": ["brew install kics", "Verify: kics --version", "supercli plugins install ./plugins/kics --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kics",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kics CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kics",
      "passthrough": true,
      "missingDependencyHelp": "Install kics: brew install kics"
    },
    "args": []
  }]
}
