{
  "name": "ignoreit",
  "version": "0.1.0",
  "description": "Create .gitignore files with curated templates",
  "source": "https://github.com/dvcs/ignoreit",
  "checks": [{ "type": "binary", "name": "ignoreit" }],
  "install_guidance": {
    "plugin": "ignoreit",
    "binary": "ignoreit",
    "check": "which ignoreit",
    "install_steps": ["npm install -g ignoreit", "Verify: ignoreit --version", "supercli plugins install ./plugins/ignoreit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ignoreit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ignoreit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ignoreit",
      "passthrough": true,
      "missingDependencyHelp": "Install ignoreit: npm install -g ignoreit", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
