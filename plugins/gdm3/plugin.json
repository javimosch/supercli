{
  "name": "gdm3",
  "version": "0.1.0",
  "description": "CLI tool: gdm3",
  "source": "https://manpages.debian.org/gdm3",
  "checks": [
    {
      "type": "binary",
      "name": "gdm3"
    }
  ],
  "install_guidance": {
    "plugin": "gdm3",
    "binary": "gdm3",
    "check": "which gdm3",
    "install_steps": [
      "apt-get install gdm3 2>/dev/null || which gdm3",
      "Verify: gdm3 --version",
      "supercli plugins install ./plugins/gdm3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdm3",
      "resource": "self",
      "action": "version",
      "description": "Print gdm3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdm3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdm3: apt-get install gdm3 2>/dev/null || which gdm3"
      },
      "args": []
    },
    {
      "namespace": "gdm3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdm3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdm3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gdm3: apt-get install gdm3 2>/dev/null || which gdm3"
      },
      "args": []
    }
  ]
}