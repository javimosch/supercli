{
  "name": "fcct",
  "version": "1.0.0",
  "description": "fcct \u2014 Fedora CoreOS config",
  "source": "github.com/coreos/fcct",
  "checks": [
    {
      "type": "binary",
      "name": "fcct"
    }
  ],
  "install_guidance": {
    "plugin": "fcct",
    "binary": "fcct",
    "check": "which fcct",
    "install_steps": [
      "# Install fcct",
      "# See github.com/coreos/fcct",
      "# apt: sudo apt-get install fcct",
      "# brew: brew install fcct",
      "# cargo: cargo install fcct",
      "# npm: npm install -g fcct",
      "# pip: pip install fcct"
    ]
  },
  "commands": [
    {
      "namespace": "fcct",
      "resource": "fcct",
      "action": "run",
      "description": "Run fcct",
      "adapter": "process",
      "adapterConfig": {
        "command": "fcct",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fcct from github.com/coreos/fcct"
      },
      "args": []
    }
  ]
}