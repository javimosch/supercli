{
  "name": "zsh5",
  "version": "0.1.0",
  "description": "CLI tool: zsh5",
  "source": "https://manpages.debian.org/zsh5",
  "checks": [
    {
      "type": "binary",
      "name": "zsh5"
    }
  ],
  "install_guidance": {
    "plugin": "zsh5",
    "binary": "zsh5",
    "check": "which zsh5",
    "install_steps": [
      "apt-get install zsh5 2>/dev/null || which zsh5",
      "Verify: zsh5 --version",
      "supercli plugins install ./plugins/zsh5 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zsh5",
      "resource": "self",
      "action": "version",
      "description": "Print zsh5 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zsh5",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zsh5: apt-get install zsh5 2>/dev/null || which zsh5"
      },
      "args": []
    },
    {
      "namespace": "zsh5",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zsh5 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zsh5",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install zsh5: apt-get install zsh5 2>/dev/null || which zsh5"
      },
      "args": []
    }
  ]
}