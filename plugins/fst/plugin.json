{
  "name": "fst",
  "version": "0.1.0",
  "description": "Represent large sets and maps compactly with finite state transducers",
  "source": "https://github.com/BurntSushi/fst",
  "checks": [
    {
      "type": "binary",
      "name": "fst"
    }
  ],
  "install_guidance": {
    "plugin": "fst",
    "binary": "fst",
    "check": "which fst",
    "install_steps": [
      "brew install fst",
      "Verify: fst --version",
      "supercli plugins install ./plugins/fst --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fst",
      "resource": "self",
      "action": "version",
      "description": "Print fst version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fst",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fst: brew install fst"
      },
      "args": []
    },
    {
      "namespace": "fst",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fst CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fst",
        "passthrough": true,
        "missingDependencyHelp": "Install fst"
      },
      "args": []
    }
  ]
}