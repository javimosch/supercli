{
  "name": "weather-cli",
  "version": "0.1.0",
  "description": "Minimalist Go-based weather data fetcher",
  "source": "https://github.com/Rayrsn/Weather-Cli",
  "checks": [{ "type": "binary", "name": "weather-cli" }],
  "install_guidance": {
    "plugin": "weather-cli",
    "binary": "weather-cli",
    "check": "which weather-cli",
    "install_steps": ["go install github.com/Rayrsn/Weather-Cli@latest", "Verify: weather-cli --version", "supercli plugins install ./plugins/weather-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "weather-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to weather-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "weather-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install weather-cli: go install github.com/Rayrsn/Weather-Cli@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
