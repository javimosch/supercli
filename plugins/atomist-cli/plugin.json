{
  "name": "atomist-cli",
  "version": "0.1.0",
  "description": "Unified command-line tool for interacting with Atomist services",
  "source": "https://github.com/atomist/cli",
  "checks": [
    {
      "type": "binary",
      "name": "atomist-cli"
    }
  ],
  "install_guidance": {
    "plugin": "atomist-cli",
    "binary": "atomist-cli",
    "check": "which atomist-cli",
    "install_steps": [
      "brew install atomist-cli",
      "Verify: atomist-cli --version",
      "supercli plugins install ./plugins/atomist-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "atomist-cli",
      "resource": "self",
      "action": "version",
      "description": "Print atomist-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "atomist-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install atomist-cli: brew install atomist-cli"
      },
      "args": []
    },
    {
      "namespace": "atomist-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to atomist-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "atomist-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install atomist-cli"
      },
      "args": []
    }
  ]
}