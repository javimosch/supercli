{
  "name": "hwinfo",
  "version": "0.1.0",
  "description": "openSUSE hardware probing tool: detailed system information for CPU, disks, memory, network cards, GPUs, and every other bus",
  "source": "https://github.com/openSUSE/hwinfo",
  "checks": [
    { "type": "binary", "name": "hwinfo" }
  ],
  "install_guidance": {
    "plugin": "hwinfo",
    "binary": "hwinfo",
    "check": "which hwinfo",
    "install_steps": [
      "sudo apt install hwinfo  # Debian/Ubuntu/openSUSE",
      "Verify: hwinfo --version",
      "supercli plugins install ./plugins/hwinfo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hwinfo",
      "resource": "self",
      "action": "version",
      "description": "Print hwinfo/libhd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "system",
      "action": "short",
      "description": "Compact hardware overview of the whole machine (hwinfo --short)",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--short"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "system",
      "action": "all",
      "description": "Full verbose hardware probe for every detected device",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--all"],
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "cpu",
      "action": "info",
      "description": "Show CPU details (hwinfo --short --cpu)",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--short", "--cpu"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "disk",
      "action": "info",
      "description": "Show storage devices (hwinfo --short --disk; add --cdrom, --partition)",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--short", "--disk"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "memory",
      "action": "info",
      "description": "Show memory/DIMM details (hwinfo --short --memory)",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--short", "--memory"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "network",
      "action": "info",
      "description": "Show network interfaces and controllers (hwinfo --short --netcard)",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--short", "--netcard"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "gpu",
      "action": "info",
      "description": "Show graphics cards and monitors (hwinfo --short --gfxcard; add --monitor)",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "baseArgs": ["--short", "--gfxcard"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    },
    {
      "namespace": "hwinfo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hwinfo CLI (hwinfo --usb, --bluetooth, --log FILE, --listmd, etc.)",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwinfo",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install hwinfo: sudo apt install hwinfo"
      },
      "args": []
    }
  ]
}
