{
  "name": "netkit-ftp",
  "version": "0.1.0",
  "description": "CLI tool: netkit-ftp",
  "source": "https://manpages.debian.org/netkit-ftp",
  "checks": [
    {
      "type": "binary",
      "name": "netkit-ftp"
    }
  ],
  "install_guidance": {
    "plugin": "netkit-ftp",
    "binary": "netkit-ftp",
    "check": "which netkit-ftp",
    "install_steps": [
      "apt-get install netkit-ftp 2>/dev/null || which netkit-ftp",
      "Verify: netkit-ftp --version",
      "supercli plugins install ./plugins/netkit-ftp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "netkit-ftp",
      "resource": "self",
      "action": "version",
      "description": "Print netkit-ftp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "netkit-ftp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install netkit-ftp: apt-get install netkit-ftp 2>/dev/null || which netkit-ftp"
      },
      "args": []
    },
    {
      "namespace": "netkit-ftp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to netkit-ftp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "netkit-ftp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install netkit-ftp: apt-get install netkit-ftp 2>/dev/null || which netkit-ftp"
      },
      "args": []
    }
  ]
}