{
  "name": "tomlq",
  "version": "0.1.0",
  "description": "Process TOML files with jq-like query syntax",
  "source": "https://github.com/jmhodges/tomlq",
  "checks": [{ "type": "binary", "name": "tomlq" }],
  "install_guidance": {
    "plugin": "tomlq",
    "binary": "tomlq",
    "check": "which tomlq",
    "install_steps": ["pip install tomlq", "Verify: tomlq --version", "supercli plugins install ./plugins/tomlq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tomlq",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tomlq CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tomlq",
      "passthrough": true,
      "missingDependencyHelp": "Install tomlq: pip install tomlq", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
