{
  "name": "sload.f2fs",
  "version": "0.1.0",
  "description": "CLI tool: sload.f2fs",
  "source": "https://manpages.debian.org/sload.f2fs",
  "checks": [
    {
      "type": "binary",
      "name": "sload.f2fs"
    }
  ],
  "install_guidance": {
    "plugin": "sload.f2fs",
    "binary": "sload.f2fs",
    "check": "which sload.f2fs",
    "install_steps": [
      "apt-get install sload.f2fs 2>/dev/null || which sload.f2fs",
      "Verify: sload.f2fs --version",
      "supercli plugins install ./plugins/sload.f2fs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sload.f2fs",
      "resource": "self",
      "action": "version",
      "description": "Print sload.f2fs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sload.f2fs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sload.f2fs: apt-get install sload.f2fs 2>/dev/null || which sload.f2fs"
      },
      "args": []
    },
    {
      "namespace": "sload.f2fs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sload.f2fs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sload.f2fs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sload.f2fs: apt-get install sload.f2fs 2>/dev/null || which sload.f2fs"
      },
      "args": []
    }
  ]
}