{
  "name": "vaultwarden",
  "version": "0.1.0",
  "description": "Lightweight Bitwarden-compatible password manager server",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "vaultwarden" }],
  "install_guidance": {
    "plugin": "vaultwarden",
    "binary": "vaultwarden",
    "check": "which vaultwarden",
    "install_steps": ["cargo install vaultwarden", "which vaultwarden", "Verify: vaultwarden --version", "supercli plugins install ./plugins/vaultwarden --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vaultwarden",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vaultwarden CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vaultwarden",
      "passthrough": true,
      "missingDependencyHelp": "Install vaultwarden: cargo install vaultwarden"
    },
    "args": []
  }]
}
