{
  "name": "go-rice",
  "version": "0.1.0",
  "description": "Easily embed resources like HTML, JS, CSS, images, and templates in Go",
  "source": "https://github.com/GeertJohan/go.rice",
  "checks": [
    {
      "type": "binary",
      "name": "go-rice"
    }
  ],
  "install_guidance": {
    "plugin": "go-rice",
    "binary": "go-rice",
    "check": "which go-rice",
    "install_steps": [
      "brew install go-rice",
      "Verify: go-rice --version",
      "supercli plugins install ./plugins/go-rice --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "go-rice",
      "resource": "self",
      "action": "version",
      "description": "Print go-rice version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-rice",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-rice: brew install go-rice"
      },
      "args": []
    },
    {
      "namespace": "go-rice",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-rice CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-rice",
        "passthrough": true,
        "missingDependencyHelp": "Install go-rice"
      },
      "args": []
    }
  ]
}