{
  "plugin": "grub-mkrelpath",
  "binary": "grub-mkrelpath",
  "check": "which grub-mkrelpath",
  "install_steps": [
    "apt-get install grub-mkrelpath 2>/dev/null || which grub-mkrelpath",
    "Verify: grub-mkrelpath --version",
    "supercli plugins install ./plugins/grub-mkrelpath --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}