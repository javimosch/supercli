{
  "plugin": "webi",
  "binary": "webi",
  "check": "which webi",
  "install_steps": [
    "curl -sS https://webi.sh/webi | sh",
    "Verify: webi --version",
    "supercli plugins install ./plugins/webi --on-conflict replace --json"
  ],
  "note": "After install, use 'webi <tool>' to install other tools (e.g., 'webi go', 'webi node')."
}
