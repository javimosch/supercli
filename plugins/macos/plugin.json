{
  "name": "macos",
  "version": "0.1.0",
  "description": "MacOS inside a Docker container.",
  "source": "https://github.com/macos/macos",
  "checks": [
    {
      "type": "binary",
      "name": "macos"
    }
  ],
  "install_guidance": {
    "plugin": "macos",
    "binary": "macos",
    "check": "which macos",
    "install_steps": [
      "pip install macos",
      "Verify: macos --version",
      "supercli plugins install ./plugins/macos --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "macos",
      "resource": "self",
      "action": "version",
      "description": "Print macos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "macos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install macos: pip install macos"
      },
      "args": []
    },
    {
      "namespace": "macos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to macos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "macos",
        "passthrough": true,
        "missingDependencyHelp": "Install macos: pip install macos"
      },
      "args": []
    }
  ]
}