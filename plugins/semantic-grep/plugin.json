{
  "name": "semantic-grep",
  "version": "0.1.0",
  "description": "A tool for semantic search using word embeddings (e.g. search for \"death\" and find \"dead\", \"killing\", \"murder\".)",
  "source": "https://github.com/arunsupe/semantic-grep",
  "checks": [
    {
      "type": "binary",
      "name": "semantic-grep"
    }
  ],
  "install_guidance": {
    "plugin": "semantic-grep",
    "binary": "semantic-grep",
    "check": "which semantic-grep",
    "install_steps": [
      "See https://github.com/arunsupe/semantic-grep",
      "Verify: semantic-grep --version",
      "supercli plugins install ./plugins/semantic-grep --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "semantic-grep",
      "resource": "self",
      "action": "version",
      "description": "Print semantic-grep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "semantic-grep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install semantic-grep: See https://github.com/arunsupe/semantic-grep"
      },
      "args": []
    },
    {
      "namespace": "semantic-grep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to semantic-grep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "semantic-grep",
        "passthrough": true,
        "missingDependencyHelp": "Install semantic-grep"
      },
      "args": []
    }
  ]
}