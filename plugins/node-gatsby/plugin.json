{
  "name": "node-gatsby",
  "version": "0.1.0",
  "description": "Node Dockerfile with gatsby-cli and extras for pipelines",
  "source": "https://github.com/node-gatsby/node-gatsby",
  "checks": [
    {
      "type": "binary",
      "name": "node-gatsby"
    }
  ],
  "install_guidance": {
    "plugin": "node-gatsby",
    "binary": "node-gatsby",
    "check": "which node-gatsby",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: node-gatsby --version",
      "supercli plugins install ./plugins/node-gatsby --on-conflict replace --json"
    ],
    "note": "Dockerfile language CLI tool"
  },
  "commands": [
    {
      "namespace": "node-gatsby",
      "resource": "self",
      "action": "version",
      "description": "Print node-gatsby version",
      "adapter": "process",
      "adapterConfig": {
        "command": "node-gatsby",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install node-gatsby from project repository"
      },
      "args": []
    },
    {
      "namespace": "node-gatsby",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to node-gatsby CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "node-gatsby",
        "passthrough": true,
        "missingDependencyHelp": "Install node-gatsby from project repository"
      },
      "args": []
    }
  ]
}