{
  "name": "redka",
  "version": "0.1.0",
  "description": "Redis re-implemented with SQL",
  "source": "https://github.com/redka/redka",
  "checks": [
    {
      "type": "binary",
      "name": "redka"
    }
  ],
  "install_guidance": {
    "plugin": "redka",
    "binary": "redka",
    "check": "which redka",
    "install_steps": [
      "pip install redka",
      "Verify: redka --version",
      "supercli plugins install ./plugins/redka --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "redka",
      "resource": "self",
      "action": "version",
      "description": "Print redka version",
      "adapter": "process",
      "adapterConfig": {
        "command": "redka",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install redka: pip install redka"
      },
      "args": []
    },
    {
      "namespace": "redka",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to redka CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "redka",
        "passthrough": true,
        "missingDependencyHelp": "Install redka: pip install redka"
      },
      "args": []
    }
  ]
}