{
  "name": "bingrep",
  "version": "0.1.0",
  "description": "Cross-platform binary grep",
  "source": "https://github.com/m4b/bingrep",
  "checks": [
    {
      "type": "binary",
      "name": "bingrep"
    }
  ],
  "install_guidance": {
    "plugin": "bingrep",
    "binary": "bingrep",
    "check": "which bingrep",
    "install_steps": [
      "cargo install bingrep",
      "Verify: bingrep --version",
      "supercli plugins install ./plugins/bingrep --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bingrep",
      "resource": "self",
      "action": "version",
      "description": "Print bingrep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bingrep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bingrep: cargo install bingrep"
      },
      "args": []
    },
    {
      "namespace": "bingrep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bingrep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bingrep",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install bingrep: cargo install bingrep"
      },
      "args": []
    }
  ]
}