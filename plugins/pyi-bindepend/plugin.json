{
  "name": "pyi-bindepend",
  "version": "0.1.0",
  "description": "CLI tool: pyi-bindepend",
  "source": "https://manpages.debian.org/pyi-bindepend",
  "checks": [
    {
      "type": "binary",
      "name": "pyi-bindepend"
    }
  ],
  "install_guidance": {
    "plugin": "pyi-bindepend",
    "binary": "pyi-bindepend",
    "check": "which pyi-bindepend",
    "install_steps": [
      "apt-get install pyi-bindepend 2>/dev/null || which pyi-bindepend",
      "Verify: pyi-bindepend --version",
      "supercli plugins install ./plugins/pyi-bindepend --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyi-bindepend",
      "resource": "self",
      "action": "version",
      "description": "Print pyi-bindepend version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-bindepend",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyi-bindepend: apt-get install pyi-bindepend 2>/dev/null || which pyi-bindepend"
      },
      "args": []
    },
    {
      "namespace": "pyi-bindepend",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyi-bindepend CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-bindepend",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyi-bindepend: apt-get install pyi-bindepend 2>/dev/null || which pyi-bindepend"
      },
      "args": []
    }
  ]
}