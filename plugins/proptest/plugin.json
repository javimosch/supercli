{
  "name": "proptest",
  "version": "0.1.0",
  "description": "proptest — property-based testing framework for Rust",
  "source": "https://crates.io/crates/proptest",
  "checks": [
    {
      "type": "binary",
      "name": "proptest"
    }
  ],
  "install_guidance": {
    "plugin": "proptest",
    "binary": "proptest",
    "check": "which proptest",
    "install_steps": [
      "cargo install proptest",
      "Verify: proptest --version",
      "supercli plugins install ./plugins/proptest --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "proptest",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "proptest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install proptest"
      },
      "args": []
    }
  ]
}
