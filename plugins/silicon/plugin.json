{
  "name": "silicon",
  "version": "0.1.0",
  "description": "silicon \u2014 create beautiful images of your source code.",
  "source": "https://github.com/Aloxaf/silicon",
  "checks": [
    {
      "type": "binary",
      "name": "silicon"
    }
  ],
  "install_guidance": {
    "plugin": "silicon",
    "binary": "silicon",
    "check": "which silicon",
    "install_steps": [
      "cargo install silicon",
      "brew install silicon",
      "supercli plugins install ./plugins/silicon --on-conflict replace --json"
    ],
    "note": "Rust. Code screenshot generator."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "silicon",
      "resource": "code",
      "action": "render",
      "description": "Render source code to image",
      "adapter": "process",
      "adapterConfig": {
        "command": "silicon",
        "missingDependencyHelp": "Install silicon",
        "positionalArgs": [
          "file"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "file",
          "type": "string",
          "required": true,
          "description": "file path"
        }
      ]
    },
    {
      "namespace": "silicon",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "silicon",
        "missingDependencyHelp": "Install silicon",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
