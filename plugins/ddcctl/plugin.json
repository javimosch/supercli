{
  "name": "ddcctl",
  "version": "0.1.0",
  "description": "DDC monitor controls (brightness) for Mac OSX command-line",
  "source": "https://github.com/kfix/ddcctl",
  "checks": [
    {
      "type": "binary",
      "name": "ddcctl"
    }
  ],
  "install_guidance": {
    "plugin": "ddcctl",
    "binary": "ddcctl",
    "check": "which ddcctl",
    "install_steps": [
      "brew install ddcctl",
      "Verify: ddcctl --version",
      "supercli plugins install ./plugins/ddcctl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ddcctl",
      "resource": "self",
      "action": "version",
      "description": "Print ddcctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ddcctl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ddcctl: brew install ddcctl"
      },
      "args": []
    },
    {
      "namespace": "ddcctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ddcctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ddcctl",
        "passthrough": true,
        "missingDependencyHelp": "Install ddcctl"
      },
      "args": []
    }
  ]
}