{
  "name": "libnetcfg",
  "version": "0.1.0",
  "description": "CLI tool: libnetcfg",
  "source": "https://manpages.debian.org/libnetcfg",
  "checks": [
    {
      "type": "binary",
      "name": "libnetcfg"
    }
  ],
  "install_guidance": {
    "plugin": "libnetcfg",
    "binary": "libnetcfg",
    "check": "which libnetcfg",
    "install_steps": [
      "apt-get install libnetcfg 2>/dev/null || which libnetcfg",
      "Verify: libnetcfg --version",
      "supercli plugins install ./plugins/libnetcfg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "libnetcfg",
      "resource": "self",
      "action": "version",
      "description": "Print libnetcfg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libnetcfg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libnetcfg: apt-get install libnetcfg 2>/dev/null || which libnetcfg"
      },
      "args": []
    },
    {
      "namespace": "libnetcfg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libnetcfg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libnetcfg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install libnetcfg: apt-get install libnetcfg 2>/dev/null || which libnetcfg"
      },
      "args": []
    }
  ]
}