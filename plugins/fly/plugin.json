{
  "name": "fly",
  "version": "1.0.0",
  "description": "fly \u2014 Concourse CI CLI",
  "source": "concourse-ci.org",
  "checks": [
    {
      "type": "binary",
      "name": "fly"
    }
  ],
  "install_guidance": {
    "plugin": "fly",
    "binary": "fly",
    "check": "which fly",
    "install_steps": [
      "# Install fly",
      "# See concourse-ci.org",
      "# apt: sudo apt-get install fly",
      "# brew: brew install fly",
      "# cargo: cargo install fly",
      "# npm: npm install -g fly",
      "# pip: pip install fly"
    ]
  },
  "commands": [
    {
      "namespace": "fly",
      "resource": "fly",
      "action": "run",
      "description": "Run fly",
      "adapter": "process",
      "adapterConfig": {
        "command": "fly",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fly from concourse-ci.org"
      },
      "args": []
    }
  ]
}