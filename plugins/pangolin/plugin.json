{
  "name": "pangolin",
  "version": "0.1.0",
  "description": "Identity-aware VPN and tunneled reverse proxy for remote access based on WireGuard\u00ae.",
  "source": "https://github.com/pangolin/pangolin",
  "checks": [
    {
      "type": "binary",
      "name": "pangolin"
    }
  ],
  "install_guidance": {
    "plugin": "pangolin",
    "binary": "pangolin",
    "check": "which pangolin",
    "install_steps": [
      "pip install pangolin",
      "Verify: pangolin --version",
      "supercli plugins install ./plugins/pangolin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pangolin",
      "resource": "self",
      "action": "version",
      "description": "Print pangolin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pangolin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pangolin: pip install pangolin"
      },
      "args": []
    },
    {
      "namespace": "pangolin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pangolin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pangolin",
        "passthrough": true,
        "missingDependencyHelp": "Install pangolin: pip install pangolin"
      },
      "args": []
    }
  ]
}