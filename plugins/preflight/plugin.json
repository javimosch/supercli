{
  "name": "preflight",
  "version": "0.1.0",
  "description": "Scan codebases for deployment readiness with text parsing",
  "source": "go",
  "checks": [{ "type": "binary", "name": "preflight" }],
  "install_guidance": {
    "plugin": "preflight",
    "binary": "preflight",
    "check": "which preflight",
    "install_steps": ["go install github.com/preflight@latest", "Verify: preflight --version", "supercli plugins install ./plugins/preflight --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "preflight",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to preflight CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "preflight",
      "passthrough": true,
      "missingDependencyHelp": "Install preflight: go install github.com/preflight@latest"
    },
    "args": []
  }]
}
