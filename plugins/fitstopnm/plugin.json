{
  "name": "fitstopnm",
  "version": "0.1.0",
  "description": "CLI tool: fitstopnm",
  "source": "https://manpages.debian.org/fitstopnm",
  "checks": [
    {
      "type": "binary",
      "name": "fitstopnm"
    }
  ],
  "install_guidance": {
    "plugin": "fitstopnm",
    "binary": "fitstopnm",
    "check": "which fitstopnm",
    "install_steps": [
      "apt-get install fitstopnm 2>/dev/null || which fitstopnm",
      "Verify: fitstopnm --version",
      "supercli plugins install ./plugins/fitstopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fitstopnm",
      "resource": "self",
      "action": "version",
      "description": "Print fitstopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fitstopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fitstopnm: apt-get install fitstopnm 2>/dev/null || which fitstopnm"
      },
      "args": []
    },
    {
      "namespace": "fitstopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fitstopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fitstopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fitstopnm: apt-get install fitstopnm 2>/dev/null || which fitstopnm"
      },
      "args": []
    }
  ]
}