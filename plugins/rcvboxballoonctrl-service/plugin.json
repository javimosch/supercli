{
  "name": "rcvboxballoonctrl-service",
  "version": "0.1.0",
  "description": "CLI tool: rcvboxballoonctrl-service",
  "source": "https://manpages.debian.org/rcvboxballoonctrl-service",
  "checks": [
    {
      "type": "binary",
      "name": "rcvboxballoonctrl-service"
    }
  ],
  "install_guidance": {
    "plugin": "rcvboxballoonctrl-service",
    "binary": "rcvboxballoonctrl-service",
    "check": "which rcvboxballoonctrl-service",
    "install_steps": [
      "apt-get install rcvboxballoonctrl-service 2>/dev/null || which rcvboxballoonctrl-service",
      "Verify: rcvboxballoonctrl-service --version",
      "supercli plugins install ./plugins/rcvboxballoonctrl-service --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rcvboxballoonctrl-service",
      "resource": "self",
      "action": "version",
      "description": "Print rcvboxballoonctrl-service version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcvboxballoonctrl-service",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rcvboxballoonctrl-service: apt-get install rcvboxballoonctrl-service 2>/dev/null || which rcvboxballoonctrl-service"
      },
      "args": []
    },
    {
      "namespace": "rcvboxballoonctrl-service",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rcvboxballoonctrl-service CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcvboxballoonctrl-service",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rcvboxballoonctrl-service: apt-get install rcvboxballoonctrl-service 2>/dev/null || which rcvboxballoonctrl-service"
      },
      "args": []
    }
  ]
}