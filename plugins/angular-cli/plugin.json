{
  "name": "angular-cli",
  "version": "0.1.0",
  "description": "CLI tool for Angular",
  "checks": [
    {
      "type": "binary",
      "name": "angular-cli"
    }
  ],
  "install_guidance": {
    "plugin": "angular-cli",
    "binary": "angular-cli",
    "check": "which angular-cli",
    "install_steps": [
      "brew install angular-cli",
      "Verify: angular-cli --version",
      "supercli plugins install ./plugins/angular-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "angular-cli",
      "resource": "self",
      "action": "version",
      "description": "Print angular-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "angular-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install angular-cli: brew install angular-cli"
      },
      "args": []
    },
    {
      "namespace": "angular-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to angular-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "angular-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install angular-cli"
      },
      "args": []
    }
  ]
}