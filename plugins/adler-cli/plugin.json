{
  "name": "adler-cli",
  "version": "0.1.0",
  "description": "An OSINT username reconnaissance tool for the command line. Searches across multiple platforms to discover online profiles and digital footprints.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "adler-cli"
    }
  ],
  "install_guidance": {
    "plugin": "adler-cli",
    "binary": "adler-cli",
    "check": "which adler-cli",
    "install_steps": [
      "cargo install adler-cli",
      "Verify: adler-cli --version",
      "supercli plugins install ./plugins/adler-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "adler-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to adler-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "adler-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install adler-cli: cargo install adler-cli"
      },
      "args": []
    }
  ]
}
