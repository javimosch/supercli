{
  "name": "pnmcolormap",
  "version": "0.1.0",
  "description": "CLI tool: pnmcolormap",
  "source": "https://manpages.debian.org/pnmcolormap",
  "checks": [
    {
      "type": "binary",
      "name": "pnmcolormap"
    }
  ],
  "install_guidance": {
    "plugin": "pnmcolormap",
    "binary": "pnmcolormap",
    "check": "which pnmcolormap",
    "install_steps": [
      "apt-get install pnmcolormap 2>/dev/null || which pnmcolormap",
      "Verify: pnmcolormap --version",
      "supercli plugins install ./plugins/pnmcolormap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmcolormap",
      "resource": "self",
      "action": "version",
      "description": "Print pnmcolormap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmcolormap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmcolormap: apt-get install pnmcolormap 2>/dev/null || which pnmcolormap"
      },
      "args": []
    },
    {
      "namespace": "pnmcolormap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmcolormap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmcolormap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmcolormap: apt-get install pnmcolormap 2>/dev/null || which pnmcolormap"
      },
      "args": []
    }
  ]
}