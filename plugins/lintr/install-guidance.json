{
  "plugin": "lintr",
  "binary": "lintr",
  "check": "which lintr",
  "install_steps": [
    "# Install lintr",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/lintr-linux-amd64 -o /usr/local/bin/lintr",
    "chmod +x /usr/local/bin/lintr",
    "# Or via package manager, see github.com/r-lib/lintr"
  ]
}