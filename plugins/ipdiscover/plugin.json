{
  "name": "ipdiscover",
  "version": "0.1.0",
  "description": "CLI tool: ipdiscover",
  "source": "https://manpages.debian.org/ipdiscover",
  "checks": [
    {
      "type": "binary",
      "name": "ipdiscover"
    }
  ],
  "install_guidance": {
    "plugin": "ipdiscover",
    "binary": "ipdiscover",
    "check": "which ipdiscover",
    "install_steps": [
      "apt-get install ipdiscover 2>/dev/null || which ipdiscover",
      "Verify: ipdiscover --version",
      "supercli plugins install ./plugins/ipdiscover --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ipdiscover",
      "resource": "self",
      "action": "version",
      "description": "Print ipdiscover version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipdiscover",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipdiscover: apt-get install ipdiscover 2>/dev/null || which ipdiscover"
      },
      "args": []
    },
    {
      "namespace": "ipdiscover",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipdiscover CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipdiscover",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ipdiscover: apt-get install ipdiscover 2>/dev/null || which ipdiscover"
      },
      "args": []
    }
  ]
}