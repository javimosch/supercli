{
  "name": "enchive",
  "version": "0.1.0",
  "description": "Encrypted personal archives",
  "source": "https://github.com/skeeto/enchive",
  "checks": [
    {
      "type": "binary",
      "name": "enchive"
    }
  ],
  "install_guidance": {
    "plugin": "enchive",
    "binary": "enchive",
    "check": "which enchive",
    "install_steps": [
      "brew install enchive",
      "Verify: enchive --version",
      "supercli plugins install ./plugins/enchive --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "enchive",
      "resource": "self",
      "action": "version",
      "description": "Print enchive version",
      "adapter": "process",
      "adapterConfig": {
        "command": "enchive",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install enchive: brew install enchive"
      },
      "args": []
    },
    {
      "namespace": "enchive",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enchive CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enchive",
        "passthrough": true,
        "missingDependencyHelp": "Install enchive"
      },
      "args": []
    }
  ]
}