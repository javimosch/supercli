{
  "name": "icarus-verilog",
  "version": "0.1.0",
  "description": "Verilog simulation and synthesis tool",
  "checks": [
    {
      "type": "binary",
      "name": "icarus-verilog"
    }
  ],
  "install_guidance": {
    "plugin": "icarus-verilog",
    "binary": "icarus-verilog",
    "check": "which icarus-verilog",
    "install_steps": [
      "brew install icarus-verilog",
      "Verify: icarus-verilog --version",
      "supercli plugins install ./plugins/icarus-verilog --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "icarus-verilog",
      "resource": "self",
      "action": "version",
      "description": "Print icarus-verilog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "icarus-verilog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install icarus-verilog: brew install icarus-verilog"
      },
      "args": []
    },
    {
      "namespace": "icarus-verilog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to icarus-verilog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "icarus-verilog",
        "passthrough": true,
        "missingDependencyHelp": "Install icarus-verilog"
      },
      "args": []
    }
  ]
}