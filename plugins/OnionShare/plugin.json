{
  "name": "OnionShare",
  "version": "0.1.0",
  "description": "\"An open source tool that lets you securely and anonymously share a file of any size.\"",
  "source": "https://github.com/onionshare/onionshare",
  "checks": [
    {
      "type": "binary",
      "name": "OnionShare"
    }
  ],
  "install_guidance": {
    "plugin": "OnionShare",
    "binary": "OnionShare",
    "check": "which OnionShare",
    "install_steps": [
      "See https://github.com/onionshare/onionshare",
      "Verify: OnionShare --version",
      "supercli plugins install ./plugins/OnionShare --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "OnionShare",
      "resource": "self",
      "action": "version",
      "description": "Print OnionShare version",
      "adapter": "process",
      "adapterConfig": {
        "command": "OnionShare",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OnionShare: See https://github.com/onionshare/onionshare"
      },
      "args": []
    },
    {
      "namespace": "OnionShare",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to OnionShare CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "OnionShare",
        "passthrough": true,
        "missingDependencyHelp": "Install OnionShare"
      },
      "args": []
    }
  ]
}