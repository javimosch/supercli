{
  "name": "GET",
  "version": "0.1.0",
  "description": "CLI tool: GET",
  "source": "https://manpages.debian.org/GET",
  "checks": [
    {
      "type": "binary",
      "name": "GET"
    }
  ],
  "install_guidance": {
    "plugin": "GET",
    "binary": "GET",
    "check": "which GET",
    "install_steps": [
      "apt-get install GET 2>/dev/null || which GET",
      "Verify: GET --version",
      "supercli plugins install ./plugins/GET --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GET",
      "resource": "self",
      "action": "version",
      "description": "Print GET version",
      "adapter": "process",
      "adapterConfig": {
        "command": "GET",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GET: apt-get install GET 2>/dev/null || which GET"
      },
      "args": []
    },
    {
      "namespace": "GET",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to GET CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "GET",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install GET: apt-get install GET 2>/dev/null || which GET"
      },
      "args": []
    }
  ]
}