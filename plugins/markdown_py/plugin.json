{
  "name": "markdown_py",
  "version": "0.1.0",
  "description": "CLI tool: markdown_py",
  "source": "https://manpages.debian.org/markdown_py",
  "checks": [
    {
      "type": "binary",
      "name": "markdown_py"
    }
  ],
  "install_guidance": {
    "plugin": "markdown_py",
    "binary": "markdown_py",
    "check": "which markdown_py",
    "install_steps": [
      "apt-get install markdown_py 2>/dev/null || which markdown_py",
      "Verify: markdown_py --version",
      "supercli plugins install ./plugins/markdown_py --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "markdown_py",
      "resource": "self",
      "action": "version",
      "description": "Print markdown_py version",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdown_py",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install markdown_py: apt-get install markdown_py 2>/dev/null || which markdown_py"
      },
      "args": []
    },
    {
      "namespace": "markdown_py",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to markdown_py CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdown_py",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install markdown_py: apt-get install markdown_py 2>/dev/null || which markdown_py"
      },
      "args": []
    }
  ]
}