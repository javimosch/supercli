{
  "name": "agents-flex",
  "version": "0.1.0",
  "description": "Agents-flex is A Lightweight Java AI Application Development Framework.",
  "source": "https://github.com/agents-flex/agents-flex",
  "checks": [
    {
      "type": "binary",
      "name": "agents-flex"
    }
  ],
  "install_guidance": {
    "plugin": "agents-flex",
    "binary": "agents-flex",
    "check": "which agents-flex",
    "install_steps": [
      "pip install agents-flex",
      "Verify: agents-flex --version",
      "supercli plugins install ./plugins/agents-flex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agents-flex",
      "resource": "self",
      "action": "version",
      "description": "Print agents-flex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agents-flex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agents-flex: pip install agents-flex"
      },
      "args": []
    },
    {
      "namespace": "agents-flex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agents-flex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agents-flex",
        "passthrough": true,
        "missingDependencyHelp": "Install agents-flex: pip install agents-flex"
      },
      "args": []
    }
  ]
}