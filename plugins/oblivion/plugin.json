{
  "name": "oblivion",
  "version": "0.1.0",
  "description": "Unofficial warp client for android",
  "source": "https://github.com/oblivion/oblivion",
  "checks": [
    {
      "type": "binary",
      "name": "oblivion"
    }
  ],
  "install_guidance": {
    "plugin": "oblivion",
    "binary": "oblivion",
    "check": "which oblivion",
    "install_steps": [
      "pip install oblivion",
      "Verify: oblivion --version",
      "supercli plugins install ./plugins/oblivion --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oblivion",
      "resource": "self",
      "action": "version",
      "description": "Print oblivion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oblivion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oblivion: pip install oblivion"
      },
      "args": []
    },
    {
      "namespace": "oblivion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oblivion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oblivion",
        "passthrough": true,
        "missingDependencyHelp": "Install oblivion: pip install oblivion"
      },
      "args": []
    }
  ]
}