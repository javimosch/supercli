{
  "name": "easy_install",
  "version": "1.0.0",
  "description": "easy_install \u2014 Python package installer",
  "source": "setuptools.readthedocs.io",
  "checks": [
    {
      "type": "binary",
      "name": "easy_install"
    }
  ],
  "install_guidance": {
    "plugin": "easy_install",
    "binary": "easy_install",
    "check": "which easy_install",
    "install_steps": [
      "# Install easy_install",
      "# See setuptools.readthedocs.io",
      "# apt: sudo apt-get install easy_install",
      "# brew: brew install easy_install",
      "# cargo: cargo install easy_install",
      "# npm: npm install -g easy_install",
      "# pip: pip install easy_install"
    ]
  },
  "commands": [
    {
      "namespace": "easy_install",
      "resource": "easy_install",
      "action": "run",
      "description": "Run easy_install",
      "adapter": "process",
      "adapterConfig": {
        "command": "easy_install",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install easy_install from setuptools.readthedocs.io"
      },
      "args": []
    }
  ]
}