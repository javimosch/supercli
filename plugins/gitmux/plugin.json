{
  "name": "gitmux",
  "version": "0.1.0",
  "description": "Git status in tmux status bar",
  "source": "https://github.com/arl/gitmux",
  "checks": [
    {
      "type": "binary",
      "name": "gitmux"
    }
  ],
  "install_guidance": {
    "plugin": "gitmux",
    "binary": "gitmux",
    "check": "which gitmux",
    "install_steps": [
      "brew install gitmux",
      "Verify: gitmux --version",
      "supercli plugins install ./plugins/gitmux --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitmux",
      "resource": "self",
      "action": "version",
      "description": "Print gitmux version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitmux",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitmux: brew install gitmux"
      },
      "args": []
    },
    {
      "namespace": "gitmux",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitmux CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitmux",
        "passthrough": true,
        "missingDependencyHelp": "Install gitmux"
      },
      "args": []
    }
  ]
}