{
  "name": "zack",
  "version": "0.1.0",
  "description": "Backtesting engine in Zig",
  "source": "https://github.com/zack/zack",
  "checks": [
    {
      "type": "binary",
      "name": "zack"
    }
  ],
  "install_guidance": {
    "plugin": "zack",
    "binary": "zack",
    "check": "which zack",
    "install_steps": [
      "pip install zack",
      "Verify: zack --version",
      "supercli plugins install ./plugins/zack --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zack",
      "resource": "self",
      "action": "version",
      "description": "Print zack version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zack",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zack: pip install zack"
      },
      "args": []
    },
    {
      "namespace": "zack",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zack CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zack",
        "passthrough": true,
        "missingDependencyHelp": "Install zack: pip install zack"
      },
      "args": []
    }
  ]
}