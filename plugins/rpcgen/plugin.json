{
  "name": "rpcgen",
  "version": "1.0.0",
  "description": "rpcgen \u2014 rpcgen \u2014 CLI utility",
  "source": "/usr/bin/rpcgen",
  "checks": [
    {
      "type": "binary",
      "name": "rpcgen"
    }
  ],
  "install_guidance": {
    "plugin": "rpcgen",
    "binary": "rpcgen",
    "check": "which rpcgen",
    "install_steps": [
      "# Install rpcgen:",
      "# apt: sudo apt-get install rpcgen",
      "# brew: brew install rpcgen",
      "# cargo: cargo install rpcgen",
      "# npm: npm install -g rpcgen",
      "# pip: pip install rpcgen",
      "# or download from /usr/bin/rpcgen"
    ]
  },
  "commands": [
    {
      "namespace": "rpcgen",
      "resource": "rpcgen",
      "action": "run",
      "description": "Run rpcgen",
      "adapter": "process",
      "adapterConfig": {
        "command": "rpcgen",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rpcgen from /usr/bin/rpcgen"
      },
      "args": []
    }
  ]
}