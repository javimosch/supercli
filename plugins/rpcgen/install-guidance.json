{
  "plugin": "rpcgen",
  "binary": "rpcgen",
  "check": "which rpcgen",
  "install_steps": [
    "# Install rpcgen",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rpcgen-linux-amd64 -o /usr/local/bin/rpcgen",
    "chmod +x /usr/local/bin/rpcgen",
    "# Or via package manager, see /usr/bin/rpcgen"
  ]
}