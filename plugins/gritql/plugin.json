{
  "name": "gritql",
  "version": "0.1.0",
  "description": "GritQL is a query language for searching, linting, and modifying code.",
  "source": "https://github.com/gritql/gritql",
  "checks": [
    {
      "type": "binary",
      "name": "gritql"
    }
  ],
  "install_guidance": {
    "plugin": "gritql",
    "binary": "gritql",
    "check": "which gritql",
    "install_steps": [
      "pip install gritql",
      "Verify: gritql --version",
      "supercli plugins install ./plugins/gritql --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gritql",
      "resource": "self",
      "action": "version",
      "description": "Print gritql version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gritql",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gritql: pip install gritql"
      },
      "args": []
    },
    {
      "namespace": "gritql",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gritql CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gritql",
        "passthrough": true,
        "missingDependencyHelp": "Install gritql: pip install gritql"
      },
      "args": []
    }
  ]
}