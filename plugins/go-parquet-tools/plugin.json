{
  "name": "go-parquet-tools",
  "version": "0.1.0",
  "description": "Utility to deal with Parquet data",
  "source": "https://github.com/hangxie/parquet-tools",
  "checks": [
    {
      "type": "binary",
      "name": "go-parquet-tools"
    }
  ],
  "install_guidance": {
    "plugin": "go-parquet-tools",
    "binary": "go-parquet-tools",
    "check": "which go-parquet-tools",
    "install_steps": [
      "brew install go-parquet-tools",
      "Verify: go-parquet-tools --version",
      "supercli plugins install ./plugins/go-parquet-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "go-parquet-tools",
      "resource": "self",
      "action": "version",
      "description": "Print go-parquet-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-parquet-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-parquet-tools: brew install go-parquet-tools"
      },
      "args": []
    },
    {
      "namespace": "go-parquet-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-parquet-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-parquet-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install go-parquet-tools"
      },
      "args": []
    }
  ]
}