{
  "name": "espeak",
  "version": "0.1.0",
  "description": "Text-to-speech engine for the command line",
  "source": "https",
  "checks": [{"type": "binary", "name": "espeak"}],
  "install_guidance": {
    "plugin": "espeak",
    "binary": "espeak",
    "check": "which espeak",
    "install_steps": [
      "brew install espeak",
      "Verify: espeak --version",
      "supercli plugins install ./plugins/espeak --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "espeak",
      "resource": "self",
      "action": "version",
      "description": "Print espeak version",
      "adapter": "process",
      "adapterConfig": {"command": "espeak", "baseArgs": ["--version"], "missingDependencyHelp": "Install espeak: brew install espeak"},
      "args": []
    },
    {
      "namespace": "espeak",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to espeak CLI",
      "adapter": "process",
      "adapterConfig": {"command": "espeak", "passthrough": true, "missingDependencyHelp": "Install espeak: brew install espeak"},
      "args": []
    }
  ]
}
