{
  "name": "zapret-discord-youtube-linux",
  "version": "0.1.0",
  "description": "(NOW ONLY FOR NFTABLES) Port zapret-discord-youtube from Flowseal and bol-van for easy to use on lin",
  "source": "https://github.com/zapret-discord-youtube-linux/zapret-discord-youtube-linux",
  "checks": [
    {
      "type": "binary",
      "name": "zapret-discord-youtube-linux"
    }
  ],
  "install_guidance": {
    "plugin": "zapret-discord-youtube-linux",
    "binary": "zapret-discord-youtube-linux",
    "check": "which zapret-discord-youtube-linux",
    "install_steps": [
      "pip install zapret-discord-youtube-linux",
      "Verify: zapret-discord-youtube-linux --version",
      "supercli plugins install ./plugins/zapret-discord-youtube-linux --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zapret-discord-youtube-linux",
      "resource": "self",
      "action": "version",
      "description": "Print zapret-discord-youtube-linux version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zapret-discord-youtube-linux",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zapret-discord-youtube-linux: pip install zapret-discord-youtube-linux"
      },
      "args": []
    },
    {
      "namespace": "zapret-discord-youtube-linux",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zapret-discord-youtube-linux CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zapret-discord-youtube-linux",
        "passthrough": true,
        "missingDependencyHelp": "Install zapret-discord-youtube-linux: pip install zapret-discord-youtube-linux"
      },
      "args": []
    }
  ]
}