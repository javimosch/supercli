{
  "plugin": "fmtcnv",
  "binary": "fmtcnv",
  "check": "which fmtcnv",
  "install_steps": [
    "cargo install fmtcnv",
    "Verify: fmtcnv --version",
    "supercli plugins install ./plugins/fmtcnv --on-conflict replace --json"
  ],
  "note": "Requires Rust toolchain. Alternative: download binary from GitHub releases or use cargo-binstall."
}
