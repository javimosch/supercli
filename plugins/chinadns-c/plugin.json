{
  "name": "chinadns-c",
  "version": "0.1.0",
  "description": "Port of ChinaDNS to C: fix irregularities with DNS in China",
  "source": "https://github.com/shadowsocks/ChinaDNS",
  "checks": [
    {
      "type": "binary",
      "name": "chinadns-c"
    }
  ],
  "install_guidance": {
    "plugin": "chinadns-c",
    "binary": "chinadns-c",
    "check": "which chinadns-c",
    "install_steps": [
      "brew install chinadns-c",
      "Verify: chinadns-c --version",
      "supercli plugins install ./plugins/chinadns-c --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chinadns-c",
      "resource": "self",
      "action": "version",
      "description": "Print chinadns-c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chinadns-c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chinadns-c: brew install chinadns-c"
      },
      "args": []
    },
    {
      "namespace": "chinadns-c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chinadns-c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chinadns-c",
        "passthrough": true,
        "missingDependencyHelp": "Install chinadns-c"
      },
      "args": []
    }
  ]
}