{
  "name": "devmem",
  "version": "0.1.0",
  "description": "CLI tool: devmem",
  "source": "https://packages.debian.org/devmem",
  "checks": [{ "type": "binary", "name": "devmem" }],
  "install_guidance": {
    "plugin": "devmem", "binary": "devmem", "check": "which devmem",
    "install_steps": ["apt-get install devmem 2>/dev/null || which devmem", "Verify: devmem --version", "supercli plugins install ./plugins/devmem --on-conflict replace --json"]
