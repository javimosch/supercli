{
  "name": "chatterbox",
  "version": "0.1.0",
  "description": "SoTA open-source TTS",
  "source": "https://github.com/chatterbox/chatterbox",
  "checks": [
    {
      "type": "binary",
      "name": "chatterbox"
    }
  ],
  "install_guidance": {
    "plugin": "chatterbox",
    "binary": "chatterbox",
    "check": "which chatterbox",
    "install_steps": [
      "pip install chatterbox",
      "Verify: chatterbox --version",
      "supercli plugins install ./plugins/chatterbox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "chatterbox",
      "resource": "self",
      "action": "version",
      "description": "Print chatterbox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chatterbox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chatterbox: pip install chatterbox"
      },
      "args": []
    },
    {
      "namespace": "chatterbox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chatterbox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chatterbox",
        "passthrough": true,
        "missingDependencyHelp": "Install chatterbox: pip install chatterbox"
      },
      "args": []
    }
  ]
}