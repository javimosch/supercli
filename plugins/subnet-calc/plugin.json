{
  "name": "subnet-calc",
  "version": "0.1.0",
  "description": "CIDR range and subnet calculator for network planning",
  "source": "https://github.com/subnet-calc/subnet-calc",
  "checks": [{ "type": "binary", "name": "subnet-calc" }],
  "install_guidance": {
    "plugin": "subnet-calc",
    "binary": "subnet-calc",
    "check": "which subnet-calc",
    "install_steps": ["go install github.com/subnet-calc/cli@latest", "Verify: subnet-calc --version", "supercli plugins install ./plugins/subnet-calc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "subnet-calc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to subnet-calc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "subnet-calc",
      "passthrough": true,
      "missingDependencyHelp": "Install subnet-calc: go install github.com/subnet-calc/cli@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
