{
  "name": "libdill",
  "version": "0.1.0",
  "description": "Structured concurrency in C",
  "source": "https://github.com/sustrik/libdill",
  "checks": [
    {
      "type": "binary",
      "name": "libdill"
    }
  ],
  "install_guidance": {
    "plugin": "libdill",
    "binary": "libdill",
    "check": "which libdill",
    "install_steps": [
      "brew install libdill",
      "Verify: libdill --version",
      "supercli plugins install ./plugins/libdill --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libdill",
      "resource": "self",
      "action": "version",
      "description": "Print libdill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libdill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libdill: brew install libdill"
      },
      "args": []
    },
    {
      "namespace": "libdill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libdill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libdill",
        "passthrough": true,
        "missingDependencyHelp": "Install libdill"
      },
      "args": []
    }
  ]
}