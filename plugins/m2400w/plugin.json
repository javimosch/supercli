{
  "name": "m2400w",
  "version": "0.1.0",
  "description": "CLI tool: m2400w",
  "source": "https://manpages.debian.org/m2400w",
  "checks": [
    {
      "type": "binary",
      "name": "m2400w"
    }
  ],
  "install_guidance": {
    "plugin": "m2400w",
    "binary": "m2400w",
    "check": "which m2400w",
    "install_steps": [
      "apt-get install m2400w 2>/dev/null || which m2400w",
      "Verify: m2400w --version",
      "supercli plugins install ./plugins/m2400w --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "m2400w",
      "resource": "self",
      "action": "version",
      "description": "Print m2400w version",
      "adapter": "process",
      "adapterConfig": {
        "command": "m2400w",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install m2400w: apt-get install m2400w 2>/dev/null || which m2400w"
      },
      "args": []
    },
    {
      "namespace": "m2400w",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to m2400w CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "m2400w",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install m2400w: apt-get install m2400w 2>/dev/null || which m2400w"
      },
      "args": []
    }
  ]
}