{
  "name": "pipedream-vultr-cli",
  "version": "0.1.0",
  "description": "a pipedream to use vultr-cli to run some docker",
  "source": "https://github.com/pipedream-vultr-cli/pipedream-vultr-cli",
  "checks": [
    {
      "type": "binary",
      "name": "pipedream-vultr-cli"
    }
  ],
  "install_guidance": {
    "plugin": "pipedream-vultr-cli",
    "binary": "pipedream-vultr-cli",
    "check": "which pipedream-vultr-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: pipedream-vultr-cli --version",
      "supercli plugins install ./plugins/pipedream-vultr-cli --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "pipedream-vultr-cli",
      "resource": "self",
      "action": "version",
      "description": "Print pipedream-vultr-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pipedream-vultr-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pipedream-vultr-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "pipedream-vultr-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pipedream-vultr-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pipedream-vultr-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install pipedream-vultr-cli from project repository"
      },
      "args": []
    }
  ]
}