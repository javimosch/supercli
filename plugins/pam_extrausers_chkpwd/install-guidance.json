{
  "plugin": "pam_extrausers_chkpwd",
  "binary": "pam_extrausers_chkpwd",
  "check": "which pam_extrausers_chkpwd",
  "install_steps": [
    "# Install pam_extrausers_chkpwd",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pam_extrausers_chkpwd-linux-amd64 -o /usr/local/bin/pam_extrausers_chkpwd",
    "chmod +x /usr/local/bin/pam_extrausers_chkpwd",
    "# Or via package manager, see /usr/sbin/pam_extrausers_chkpwd"
  ]
}