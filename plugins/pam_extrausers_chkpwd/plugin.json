{
  "name": "pam-extrausers-chkpwd",
  "version": "1.0.0",
  "description": "pam-extrausers-chkpwd \u2014 pam_extrausers_chkpwd \u2014 CLI utility",
  "source": "/usr/sbin/pam_extrausers_chkpwd",
  "checks": [
    {
      "type": "binary",
      "name": "pam_extrausers_chkpwd"
    }
  ],
  "install_guidance": {
    "plugin": "pam-extrausers-chkpwd",
    "binary": "pam_extrausers_chkpwd",
    "check": "which pam_extrausers_chkpwd",
    "install_steps": [
      "# Install pam-extrausers-chkpwd:",
      "# apt: sudo apt-get install pam-extrausers-chkpwd",
      "# brew: brew install pam-extrausers-chkpwd",
      "# cargo: cargo install pam-extrausers-chkpwd",
      "# npm: npm install -g pam-extrausers-chkpwd",
      "# pip: pip install pam-extrausers-chkpwd",
      "# or download from /usr/sbin/pam_extrausers_chkpwd"
    ]
  },
  "commands": [
    {
      "namespace": "pam",
      "resource": "chkpwd",
      "action": "run",
      "description": "Run pam-extrausers-chkpwd",
      "adapter": "process",
      "adapterConfig": {
        "command": "pam_extrausers_chkpwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pam-extrausers-chkpwd from /usr/sbin/pam_extrausers_chkpwd"
      },
      "args": []
    }
  ]
}