{
  "name": "fork-cleaner",
  "version": "0.1.0",
  "description": "Cleans up old and inactive forks on your GitHub account",
  "source": "https://github.com/caarlos0/fork-cleaner",
  "checks": [
    {
      "type": "binary",
      "name": "fork-cleaner"
    }
  ],
  "install_guidance": {
    "plugin": "fork-cleaner",
    "binary": "fork-cleaner",
    "check": "which fork-cleaner",
    "install_steps": [
      "brew install fork-cleaner",
      "Verify: fork-cleaner --version",
      "supercli plugins install ./plugins/fork-cleaner --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fork-cleaner",
      "resource": "self",
      "action": "version",
      "description": "Print fork-cleaner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fork-cleaner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fork-cleaner: brew install fork-cleaner"
      },
      "args": []
    },
    {
      "namespace": "fork-cleaner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fork-cleaner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fork-cleaner",
        "passthrough": true,
        "missingDependencyHelp": "Install fork-cleaner"
      },
      "args": []
    }
  ]
}