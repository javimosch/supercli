{
  "name": "zip",
  "version": "0.1.0",
  "description": "File compression and packaging utility",
  "source": "https",
  "checks": [{"type": "binary", "name": "zip"}],
  "install_guidance": {
    "plugin": "zip",
    "binary": "zip",
    "check": "which zip",
    "install_steps": [
      "brew install zip",
      "Verify: zip --version",
      "supercli plugins install ./plugins/zip --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "zip",
      "resource": "self",
      "action": "version",
      "description": "Print zip version",
      "adapter": "process",
      "adapterConfig": {"command": "zip", "baseArgs": ["--version"], "missingDependencyHelp": "Install zip: brew install zip"},
      "args": []
    },
    {
      "namespace": "zip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zip CLI",
      "adapter": "process",
      "adapterConfig": {"command": "zip", "passthrough": true, "missingDependencyHelp": "Install zip: brew install zip"},
      "args": []
    }
  ]
}
