{
  "name": "pnminterp-gen",
  "version": "0.1.0",
  "description": "CLI tool: pnminterp-gen",
  "source": "https://manpages.debian.org/pnminterp-gen",
  "checks": [
    {
      "type": "binary",
      "name": "pnminterp-gen"
    }
  ],
  "install_guidance": {
    "plugin": "pnminterp-gen",
    "binary": "pnminterp-gen",
    "check": "which pnminterp-gen",
    "install_steps": [
      "apt-get install pnminterp-gen 2>/dev/null || which pnminterp-gen",
      "Verify: pnminterp-gen --version",
      "supercli plugins install ./plugins/pnminterp-gen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnminterp-gen",
      "resource": "self",
      "action": "version",
      "description": "Print pnminterp-gen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnminterp-gen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnminterp-gen: apt-get install pnminterp-gen 2>/dev/null || which pnminterp-gen"
      },
      "args": []
    },
    {
      "namespace": "pnminterp-gen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnminterp-gen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnminterp-gen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnminterp-gen: apt-get install pnminterp-gen 2>/dev/null || which pnminterp-gen"
      },
      "args": []
    }
  ]
}