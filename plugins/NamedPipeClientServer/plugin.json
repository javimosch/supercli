{
  "name": "NamedPipeClientServer",
  "version": "0.1.0",
  "description": "Windows IPC with Named Pipes",
  "source": "https://github.com/NamedPipeClientServer/NamedPipeClientServer",
  "checks": [
    {
      "type": "binary",
      "name": "NamedPipeClientServer"
    }
  ],
  "install_guidance": {
    "plugin": "NamedPipeClientServer",
    "binary": "NamedPipeClientServer",
    "check": "which NamedPipeClientServer",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: NamedPipeClientServer --version",
      "supercli plugins install ./plugins/NamedPipeClientServer --on-conflict replace --json"
    ],
    "note": "C++ language CLI tool"
  },
  "commands": [
    {
      "namespace": "NamedPipeClientServer",
      "resource": "self",
      "action": "version",
      "description": "Print NamedPipeClientServer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "NamedPipeClientServer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NamedPipeClientServer from project repository"
      },
      "args": []
    },
    {
      "namespace": "NamedPipeClientServer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to NamedPipeClientServer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "NamedPipeClientServer",
        "passthrough": true,
        "missingDependencyHelp": "Install NamedPipeClientServer from project repository"
      },
      "args": []
    }
  ]
}