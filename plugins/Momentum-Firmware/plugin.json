{
  "name": "Momentum-Firmware",
  "version": "0.1.0",
  "description": "\ud83d\udc2c Feature-rich, stable and customizable Flipper Firmware",
  "source": "https://github.com/Momentum-Firmware/Momentum-Firmware",
  "checks": [
    {
      "type": "binary",
      "name": "momentum-firmware"
    }
  ],
  "install_guidance": {
    "plugin": "Momentum-Firmware",
    "binary": "momentum-firmware",
    "check": "which momentum-firmware",
    "install_steps": [
      "pip install momentum-firmware",
      "Verify: momentum-firmware --version",
      "supercli plugins install ./plugins/Momentum-Firmware --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Momentum-Firmware",
      "resource": "self",
      "action": "version",
      "description": "Print Momentum-Firmware version",
      "adapter": "process",
      "adapterConfig": {
        "command": "momentum-firmware",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Momentum-Firmware: pip install momentum-firmware"
      },
      "args": []
    },
    {
      "namespace": "Momentum-Firmware",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to momentum-firmware CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "momentum-firmware",
        "passthrough": true,
        "missingDependencyHelp": "Install Momentum-Firmware: pip install momentum-firmware"
      },
      "args": []
    }
  ]
}