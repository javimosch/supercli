{
  "name": "atk-registry",
  "version": "0.1.0",
  "description": "CLI tool: atk-registry",
  "source": "https://packages.debian.org/atk-registry",
  "checks": [{ "type": "binary", "name": "atk-registry" }],
  "install_guidance": {
    "plugin": "atk-registry", "binary": "atk-registry", "check": "which atk-registry",
    "install_steps": ["apt-get install atk-registry 2>/dev/null || which atk-registry", "Verify: atk-registry --version", "supercli plugins install ./plugins/atk-registry --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "atk-registry", "resource": "_", "action": "_",
    "description": "Passthrough to atk-registry CLI",
    "adapter": "process", "adapterConfig": { "command": "atk-registry", "passthrough": true, "missingDependencyHelp": "Install atk-registry: apt-get install atk-registry" }, "args": []
  }]
}
