{
  "name": "openai-agents-python",
  "version": "0.1.0",
  "description": "A lightweight, powerful framework for multi-agent workflows",
  "source": "https://github.com/openai-agents-python/openai-agents-python",
  "checks": [
    {
      "type": "binary",
      "name": "openai-agents-python"
    }
  ],
  "install_guidance": {
    "plugin": "openai-agents-python",
    "binary": "openai-agents-python",
    "check": "which openai-agents-python",
    "install_steps": [
      "pip install openai-agents-python",
      "Verify: openai-agents-python --version",
      "supercli plugins install ./plugins/openai-agents-python --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openai-agents-python",
      "resource": "self",
      "action": "version",
      "description": "Print openai-agents-python version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openai-agents-python",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openai-agents-python: pip install openai-agents-python"
      },
      "args": []
    },
    {
      "namespace": "openai-agents-python",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openai-agents-python CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openai-agents-python",
        "passthrough": true,
        "missingDependencyHelp": "Install openai-agents-python: pip install openai-agents-python"
      },
      "args": []
    }
  ]
}