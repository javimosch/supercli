{
  "name": "lm4tools",
  "version": "0.1.0",
  "description": "Tools for TI Stellaris Launchpad boards",
  "source": "https://github.com/utzig/lm4tools",
  "checks": [
    {
      "type": "binary",
      "name": "lm4tools"
    }
  ],
  "install_guidance": {
    "plugin": "lm4tools",
    "binary": "lm4tools",
    "check": "which lm4tools",
    "install_steps": [
      "brew install lm4tools",
      "Verify: lm4tools --version",
      "supercli plugins install ./plugins/lm4tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lm4tools",
      "resource": "self",
      "action": "version",
      "description": "Print lm4tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lm4tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lm4tools: brew install lm4tools"
      },
      "args": []
    },
    {
      "namespace": "lm4tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lm4tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lm4tools",
        "passthrough": true,
        "missingDependencyHelp": "Install lm4tools"
      },
      "args": []
    }
  ]
}