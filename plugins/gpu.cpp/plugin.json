{
  "name": "gpu.cpp",
  "version": "0.1.0",
  "description": "A lightweight library for portable low-level GPU computation using WebGPU. ",
  "source": "https://github.com/gpu.cpp/gpu.cpp",
  "checks": [
    {
      "type": "binary",
      "name": "gpu.cpp"
    }
  ],
  "install_guidance": {
    "plugin": "gpu.cpp",
    "binary": "gpu.cpp",
    "check": "which gpu.cpp",
    "install_steps": [
      "pip install gpu.cpp",
      "Verify: gpu.cpp --version",
      "supercli plugins install ./plugins/gpu.cpp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gpu.cpp",
      "resource": "self",
      "action": "version",
      "description": "Print gpu.cpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpu.cpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gpu.cpp: pip install gpu.cpp"
      },
      "args": []
    },
    {
      "namespace": "gpu.cpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpu.cpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpu.cpp",
        "passthrough": true,
        "missingDependencyHelp": "Install gpu.cpp: pip install gpu.cpp"
      },
      "args": []
    }
  ]
}