{
  "name": "googlews",
  "version": "1.0.0",
  "description": "Google Workspace CLI integration for supercli",
  "source": "https://github.com/googleworkspace/cli",
  "checks": [
    {
      "type": "binary",
      "name": "googlews",
      "args": [
        "version"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "googlews",
    "binary": "googlews",
    "check": "googlews version",
    "install_steps": [
      "go install github.com/googleworkspace/cli@latest"
    ],
    "note": "Requires Google OAuth2 credentials. Run `googlews auth login` to authenticate."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "googlews",
      "resource": "drive",
      "action": "run",
      "description": "Google Drive management - upload, download, share files and folders",
      "adapter": "process",
      "adapterConfig": {
        "command": "googlews",
        "baseArgs": [
          "drive"
        ],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install googlews: go install github.com/googleworkspace/cli@latest"
      },
      "args": []
    },
