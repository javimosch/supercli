{
  "name": "ncurses6-config",
  "version": "0.1.0",
  "description": "CLI tool: ncurses6-config",
  "source": "https://manpages.debian.org/ncurses6-config",
  "checks": [
    {
      "type": "binary",
      "name": "ncurses6-config"
    }
  ],
  "install_guidance": {
    "plugin": "ncurses6-config",
    "binary": "ncurses6-config",
    "check": "which ncurses6-config",
    "install_steps": [
      "apt-get install ncurses6-config 2>/dev/null || which ncurses6-config",
      "Verify: ncurses6-config --version",
      "supercli plugins install ./plugins/ncurses6-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ncurses6-config",
      "resource": "self",
      "action": "version",
      "description": "Print ncurses6-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncurses6-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ncurses6-config: apt-get install ncurses6-config 2>/dev/null || which ncurses6-config"
      },
      "args": []
    },
    {
      "namespace": "ncurses6-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ncurses6-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncurses6-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ncurses6-config: apt-get install ncurses6-config 2>/dev/null || which ncurses6-config"
      },
      "args": []
    }
  ]
}