{
  "name": "dory",
  "version": "0.1.0",
  "description": "Development proxy for docker",
  "source": "https://github.com/freedomben/dory",
  "checks": [
    {
      "type": "binary",
      "name": "dory"
    }
  ],
  "install_guidance": {
    "plugin": "dory",
    "binary": "dory",
    "check": "which dory",
    "install_steps": [
      "brew install dory",
      "Verify: dory --version",
      "supercli plugins install ./plugins/dory --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dory",
      "resource": "self",
      "action": "version",
      "description": "Print dory version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dory",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dory: brew install dory"
      },
      "args": []
    },
    {
      "namespace": "dory",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dory CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dory",
        "passthrough": true,
        "missingDependencyHelp": "Install dory"
      },
      "args": []
    }
  ]
}