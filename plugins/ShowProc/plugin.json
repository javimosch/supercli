{
  "name": "ShowProc",
  "version": "0.1.0",
  "description": "An AmigaOS command line program that displays information about all open Shell/CLI processes",
  "source": "https://github.com/ShowProc/ShowProc",
  "checks": [
    {
      "type": "binary",
      "name": "ShowProc"
    }
  ],
  "install_guidance": {
    "plugin": "ShowProc",
    "binary": "ShowProc",
    "check": "which ShowProc",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: ShowProc --version",
      "supercli plugins install ./plugins/ShowProc --on-conflict replace --json"
    ],
    "note": "C language CLI tool"
  },
  "commands": [
    {
      "namespace": "ShowProc",
      "resource": "self",
      "action": "version",
      "description": "Print ShowProc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ShowProc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ShowProc from project repository"
      },
      "args": []
    },
    {
      "namespace": "ShowProc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ShowProc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ShowProc",
        "passthrough": true,
        "missingDependencyHelp": "Install ShowProc from project repository"
      },
      "args": []
    }
  ]
}