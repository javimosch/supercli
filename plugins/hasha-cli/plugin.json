{
  "name": "hasha-cli",
  "version": "0.1.0",
  "description": "Hashing made simple. Get the hash of text or stdin.",
  "source": "https://github.com/hasha-cli/hasha-cli",
  "checks": [
    {
      "type": "binary",
      "name": "hasha-cli"
    }
  ],
  "install_guidance": {
    "plugin": "hasha-cli",
    "binary": "hasha-cli",
    "check": "which hasha-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: hasha-cli --version",
      "supercli plugins install ./plugins/hasha-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "hasha-cli",
      "resource": "self",
      "action": "version",
      "description": "Print hasha-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hasha-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hasha-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "hasha-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hasha-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hasha-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install hasha-cli from project repository"
      },
      "args": []
    }
  ]
}