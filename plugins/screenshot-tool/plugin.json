{
  "name": "screenshot-tool",
  "version": "0.1.0",
  "description": "Spec-driven automated app screenshot generator",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "screenshot-tool" }],
  "install_guidance": {
    "plugin": "screenshot-tool",
    "binary": "screenshot-tool",
    "check": "which screenshot-tool",
    "install_steps": ["npm install -g screenshot-tool", "Verify: screenshot-tool --version", "supercli plugins install ./plugins/screenshot-tool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "screenshot-tool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to screenshot-tool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "screenshot-tool",
      "passthrough": true,
      "missingDependencyHelp": "Install screenshot-tool: npm install -g screenshot-tool"
    },
    "args": []
  }]
}
