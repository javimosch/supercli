{
  "name": "cdxgen",
  "version": "0.1.0",
  "description": "Creates CycloneDX Software Bill-of-Materials (SBOM) for projects",
  "source": "https://github.com/CycloneDX/cdxgen",
  "checks": [
    {
      "type": "binary",
      "name": "cdxgen"
    }
  ],
  "install_guidance": {
    "plugin": "cdxgen",
    "binary": "cdxgen",
    "check": "which cdxgen",
    "install_steps": [
      "brew install cdxgen",
      "Verify: cdxgen --version",
      "supercli plugins install ./plugins/cdxgen --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cdxgen",
      "resource": "self",
      "action": "version",
      "description": "Print cdxgen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdxgen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cdxgen: brew install cdxgen"
      },
      "args": []
    },
    {
      "namespace": "cdxgen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cdxgen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdxgen",
        "passthrough": true,
        "missingDependencyHelp": "Install cdxgen"
      },
      "args": []
    }
  ]
}