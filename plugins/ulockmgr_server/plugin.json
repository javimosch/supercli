{
  "name": "ulockmgr_server",
  "version": "0.1.0",
  "description": "CLI tool: ulockmgr_server",
  "source": "https://manpages.debian.org/ulockmgr_server",
  "checks": [
    {
      "type": "binary",
      "name": "ulockmgr_server"
    }
  ],
  "install_guidance": {
    "plugin": "ulockmgr_server",
    "binary": "ulockmgr_server",
    "check": "which ulockmgr_server",
    "install_steps": [
      "apt-get install ulockmgr_server 2>/dev/null || which ulockmgr_server",
      "Verify: ulockmgr_server --version",
      "supercli plugins install ./plugins/ulockmgr_server --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ulockmgr_server",
      "resource": "self",
      "action": "version",
      "description": "Print ulockmgr_server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ulockmgr_server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ulockmgr_server: apt-get install ulockmgr_server 2>/dev/null || which ulockmgr_server"
      },
      "args": []
    },
    {
      "namespace": "ulockmgr_server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ulockmgr_server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ulockmgr_server",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ulockmgr_server: apt-get install ulockmgr_server 2>/dev/null || which ulockmgr_server"
      },
      "args": []
    }
  ]
}