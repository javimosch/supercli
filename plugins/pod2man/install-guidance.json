{
  "plugin": "pod2man",
  "binary": "pod2man",
  "check": "which pod2man",
  "install_steps": [
    "# Install pod2man",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pod2man-linux-amd64 -o /usr/local/bin/pod2man",
    "chmod +x /usr/local/bin/pod2man",
    "# Or via package manager, see /usr/bin/pod2man"
  ]
}