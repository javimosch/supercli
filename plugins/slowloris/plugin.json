{
  "name": "slowloris",
  "version": "0.1.0",
  "description": "Low bandwidth DoS tool for testing server connection handling",
  "source": "https://github.com/gkbrk/slowloris",
  "checks": [{ "type": "binary", "name": "slowloris" }],
  "install_guidance": {
    "plugin": "slowloris",
    "binary": "slowloris",
    "check": "which slowloris",
    "install_steps": ["pip install slowloris", "Verify: slowloris --version", "supercli plugins install ./plugins/slowloris --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "slowloris",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to slowloris CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "slowloris",
      "passthrough": true,
      "missingDependencyHelp": "Install slowloris: pip install slowloris"
    },
    "args": []
  }]
}
