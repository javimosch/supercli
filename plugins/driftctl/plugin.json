{
  "name": "driftctl",
  "version": "0.1.0",
  "description": "Detect, track and alert on infrastructure drift",
  "source": "https://github.com/snyk/driftctl",
  "checks": [
    {
      "type": "binary",
      "name": "driftctl"
    }
  ],
  "install_guidance": {
    "plugin": "driftctl",
    "binary": "driftctl",
    "check": "which driftctl",
    "install_steps": [
      "brew install driftctl",
      "Verify: driftctl --version",
      "supercli plugins install ./plugins/driftctl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "driftctl",
      "resource": "self",
      "action": "version",
      "description": "Print driftctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "driftctl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install driftctl: brew install driftctl"
      },
      "args": []
    },
    {
      "namespace": "driftctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to driftctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "driftctl",
        "passthrough": true,
        "missingDependencyHelp": "Install driftctl"
      },
      "args": []
    }
  ]
}