{
  "plugin": "dpkg-preconfigure",
  "binary": "dpkg-preconfigure",
  "check": "which dpkg-preconfigure",
  "install_steps": [
    "apt-get install dpkg-preconfigure 2>/dev/null || which dpkg-preconfigure",
    "Verify: dpkg-preconfigure --version",
    "supercli plugins install ./plugins/dpkg-preconfigure --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}