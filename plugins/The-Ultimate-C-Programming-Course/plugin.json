{
  "name": "The-Ultimate-C-Programming-Course",
  "version": "0.1.0",
  "description": "This is the C language code and supplement material for the Ultimate C language Course on CodeWithHa",
  "source": "https://github.com/The-Ultimate-C-Programming-Course/The-Ultimate-C-Programming-Course",
  "checks": [
    {
      "type": "binary",
      "name": "the-ultimate-c-programming-course"
    }
  ],
  "install_guidance": {
    "plugin": "The-Ultimate-C-Programming-Course",
    "binary": "the-ultimate-c-programming-course",
    "check": "which the-ultimate-c-programming-course",
    "install_steps": [
      "pip install the-ultimate-c-programming-course",
      "Verify: the-ultimate-c-programming-course --version",
      "supercli plugins install ./plugins/The-Ultimate-C-Programming-Course --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "The-Ultimate-C-Programming-Course",
      "resource": "self",
      "action": "version",
      "description": "Print The-Ultimate-C-Programming-Course version",
      "adapter": "process",
      "adapterConfig": {
        "command": "the-ultimate-c-programming-course",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install The-Ultimate-C-Programming-Course: pip install the-ultimate-c-programming-course"
      },
      "args": []
    },
    {
      "namespace": "The-Ultimate-C-Programming-Course",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to the-ultimate-c-programming-course CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "the-ultimate-c-programming-course",
        "passthrough": true,
        "missingDependencyHelp": "Install The-Ultimate-C-Programming-Course: pip install the-ultimate-c-programming-course"
      },
      "args": []
    }
  ]
}