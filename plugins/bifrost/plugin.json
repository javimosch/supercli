{
  "name": "bifrost",
  "version": "0.1.0",
  "description": "Fastest enterprise AI gateway (50x faster than LiteLLM) with adaptive load balancer, cluster mode, g",
  "source": "https://github.com/bifrost/bifrost",
  "checks": [
    {
      "type": "binary",
      "name": "bifrost"
    }
  ],
  "install_guidance": {
    "plugin": "bifrost",
    "binary": "bifrost",
    "check": "which bifrost",
    "install_steps": [
      "pip install bifrost",
      "Verify: bifrost --version",
      "supercli plugins install ./plugins/bifrost --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bifrost",
      "resource": "self",
      "action": "version",
      "description": "Print bifrost version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bifrost",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bifrost: pip install bifrost"
      },
      "args": []
    },
    {
      "namespace": "bifrost",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bifrost CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bifrost",
        "passthrough": true,
        "missingDependencyHelp": "Install bifrost: pip install bifrost"
      },
      "args": []
    }
  ]
}