{
  "name": "cvsps",
  "version": "0.1.0",
  "description": "CLI tool: cvsps",
  "source": "https://packages.debian.org/cvsps",
  "checks": [{ "type": "binary", "name": "cvsps" }],
  "install_guidance": {
    "plugin": "cvsps", "binary": "cvsps", "check": "which cvsps",
    "install_steps": ["apt-get install cvsps 2>/dev/null || which cvsps", "Verify: cvsps --version", "supercli plugins install ./plugins/cvsps --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cvsps", "resource": "_", "action": "_",
    "description": "Passthrough to cvsps CLI",
    "adapter": "process", "adapterConfig": { "command": "cvsps", "passthrough": true, "missingDependencyHelp": "Install cvsps: apt-get install cvsps" }, "args": []
  }]
}
