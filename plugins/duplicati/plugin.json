{
  "name": "duplicati",
  "version": "0.1.0",
  "description": "Free backup client with CLI",
  "source": "https://github.com/duplicati/duplicati",
  "checks": [
    {
      "type": "binary",
      "name": "duplicati"
    }
  ],
  "install_guidance": {
    "plugin": "duplicati",
    "binary": "duplicati",
    "check": "which duplicati",
    "install_steps": [
      "brew install duplicati",
      "Verify: duplicati --version",
      "supercli plugins install ./plugins/duplicati --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "duplicati",
      "resource": "self",
      "action": "version",
      "description": "Print duplicati version",
      "adapter": "process",
      "adapterConfig": {
        "command": "duplicati",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install duplicati: brew install duplicati"
      },
      "args": []
    },
    {
      "namespace": "duplicati",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to duplicati CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "duplicati",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install duplicati: brew install duplicati"
      },
      "args": []
    }
  ]
}
