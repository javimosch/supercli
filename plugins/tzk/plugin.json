{
  "name": "tzk",
  "version": "0.1.0",
  "description": "Alternative Zettelkasten tool with graph features",
  "source": "https://github.com/tzk/tzk",
  "checks": [{ "type": "binary", "name": "tzk" }],
  "install_guidance": {
    "plugin": "tzk",
    "binary": "tzk",
    "check": "which tzk",
    "install_steps": ["pip install tzk", "Verify: tzk --version", "supercli plugins install ./plugins/tzk --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tzk",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tzk CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tzk",
      "passthrough": true,
      "missingDependencyHelp": "Install tzk: pip install tzk", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
