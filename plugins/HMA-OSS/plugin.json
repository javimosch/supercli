{
  "name": "HMA-OSS",
  "version": "0.1.0",
  "description": "A ROOT REQUIRED LSPosed/Zygisk module to hide your app list, settings, package installers and more. ",
  "source": "https://github.com/HMA-OSS/HMA-OSS",
  "checks": [
    {
      "type": "binary",
      "name": "hma-oss"
    }
  ],
  "install_guidance": {
    "plugin": "HMA-OSS",
    "binary": "hma-oss",
    "check": "which hma-oss",
    "install_steps": [
      "pip install hma-oss",
      "Verify: hma-oss --version",
      "supercli plugins install ./plugins/HMA-OSS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "HMA-OSS",
      "resource": "self",
      "action": "version",
      "description": "Print HMA-OSS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hma-oss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install HMA-OSS: pip install hma-oss"
      },
      "args": []
    },
    {
      "namespace": "HMA-OSS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hma-oss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hma-oss",
        "passthrough": true,
        "missingDependencyHelp": "Install HMA-OSS: pip install hma-oss"
      },
      "args": []
    }
  ]
}