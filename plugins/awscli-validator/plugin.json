{
  "name": "awscli-validator",
  "version": "0.1.0",
  "description": "awscli-validator is a Python package designed to validate and parse AWS CLI command outputs. It ensures that the outputs conform to expected schemas or data formats, providing a reliable way to automate AWS CLI operations in scripts and pipelines.",
  "source": "https://github.com/awscli-validator/awscli-validator",
  "checks": [
    {
      "type": "binary",
      "name": "awscli-validator"
    }
  ],
  "install_guidance": {
    "plugin": "awscli-validator",
    "binary": "awscli-validator",
    "check": "which awscli-validator",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: awscli-validator --version",
      "supercli plugins install ./plugins/awscli-validator --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "awscli-validator",
      "resource": "self",
      "action": "version",
      "description": "Print awscli-validator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awscli-validator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awscli-validator from project repository"
      },
      "args": []
    },
    {
      "namespace": "awscli-validator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awscli-validator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awscli-validator",
        "passthrough": true,
        "missingDependencyHelp": "Install awscli-validator from project repository"
      },
      "args": []
    }
  ]
}