{
  "name": "n8n-mcp",
  "version": "0.1.0",
  "description": "A MCP for Claude Desktop / Claude Code / Windsurf / Cursor to build n8n workflows for you ",
  "source": "https://github.com/n8n-mcp/n8n-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "n8n-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "n8n-mcp",
    "binary": "n8n-mcp",
    "check": "which n8n-mcp",
    "install_steps": [
      "pip install n8n-mcp",
      "Verify: n8n-mcp --version",
      "supercli plugins install ./plugins/n8n-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "n8n-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print n8n-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "n8n-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install n8n-mcp: pip install n8n-mcp"
      },
      "args": []
    },
    {
      "namespace": "n8n-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to n8n-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "n8n-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install n8n-mcp: pip install n8n-mcp"
      },
      "args": []
    }
  ]
}