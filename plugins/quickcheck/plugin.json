{
  "name": "quickcheck",
  "version": "0.1.0",
  "description": "quickcheck — property-based testing for Rust",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "quickcheck"
    }
  ],
  "install_guidance": {
    "plugin": "quickcheck",
    "binary": "quickcheck",
    "check": "which quickcheck",
    "install_steps": [
      "cargo install quickcheck",
      "Verify: quickcheck --version",
      "supercli plugins install ./plugins/quickcheck --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "quickcheck",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quickcheck",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install quickcheck"
      },
      "args": []
    }
  ]
}
