{
  "name": "freeze",
  "version": "0.1.0",
  "description": "Generate images of code and terminal output \ud83d\udcf8",
  "source": "https://github.com/freeze/freeze",
  "checks": [
    {
      "type": "binary",
      "name": "freeze"
    }
  ],
  "install_guidance": {
    "plugin": "freeze",
    "binary": "freeze",
    "check": "which freeze",
    "install_steps": [
      "pip install freeze",
      "Verify: freeze --version",
      "supercli plugins install ./plugins/freeze --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "freeze",
      "resource": "self",
      "action": "version",
      "description": "Print freeze version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freeze",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install freeze: pip install freeze"
      },
      "args": []
    },
    {
      "namespace": "freeze",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freeze CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freeze",
        "passthrough": true,
        "missingDependencyHelp": "Install freeze: pip install freeze"
      },
      "args": []
    }
  ]
}