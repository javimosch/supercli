{
  "name": "freeze",
  "version": "0.1.0",
  "description": "Generate images of code and terminal output for presentations",
  "source": "https://github.com/charmbracelet/freeze",
  "checks": [{ "type": "binary", "name": "freeze" }],
  "install_guidance": {
    "plugin": "freeze",
    "binary": "freeze",
    "check": "which freeze",
    "install_steps": ["brew install freeze", "Verify: freeze --version", "supercli plugins install ./plugins/freeze --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "freeze",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to freeze CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "freeze",
      "passthrough": true,
      "missingDependencyHelp": "Install freeze: brew install freeze"
    },
    "args": []
  }]
}
