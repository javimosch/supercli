{
  "name": "javah",
  "version": "0.1.0",
  "description": "CLI tool: javah",
  "source": "https://manpages.debian.org/javah",
  "checks": [
    {
      "type": "binary",
      "name": "javah"
    }
  ],
  "install_guidance": {
    "plugin": "javah",
    "binary": "javah",
    "check": "which javah",
    "install_steps": [
      "apt-get install javah 2>/dev/null || which javah",
      "Verify: javah --version",
      "supercli plugins install ./plugins/javah --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "javah",
      "resource": "self",
      "action": "version",
      "description": "Print javah version",
      "adapter": "process",
      "adapterConfig": {
        "command": "javah",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install javah: apt-get install javah 2>/dev/null || which javah"
      },
      "args": []
    },
    {
      "namespace": "javah",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to javah CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "javah",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install javah: apt-get install javah 2>/dev/null || which javah"
      },
      "args": []
    }
  ]
}