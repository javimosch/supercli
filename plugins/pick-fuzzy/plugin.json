{
  "name": "pick-fuzzy",
  "version": "0.1.0",
  "description": "Simple command-line fuzzy file and text picker in C",
  "source": "https://github.com/mptcp/pick",
  "checks": [{ "type": "binary", "name": "pick-fuzzy" }],
  "install_guidance": {
    "plugin": "pick-fuzzy",
    "binary": "pick-fuzzy",
    "check": "which pick-fuzzy",
    "install_steps": ["brew install pick", "Verify: pick-fuzzy --version", "supercli plugins install ./plugins/pick-fuzzy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pick-fuzzy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pick-fuzzy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pick-fuzzy",
      "passthrough": true,
      "missingDependencyHelp": "Install pick-fuzzy: brew install pick", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
