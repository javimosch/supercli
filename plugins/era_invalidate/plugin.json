      "description": "Print era_invalidate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "era_invalidate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install era_invalidate: apt-get install era_invalidate 2>/dev/null || which era_invalidate"
      },
      "args": []
    },
    {
      "namespace": "era_invalidate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to era_invalidate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "era_invalidate",
        "passthrough": true,
