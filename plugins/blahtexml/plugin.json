{
  "name": "blahtexml",
  "version": "0.1.0",
  "description": "Converts equations into Math ML",
  "source": "https://github.com/gvanas/blahtexml",
  "checks": [
    {
      "type": "binary",
      "name": "blahtexml"
    }
  ],
  "install_guidance": {
    "plugin": "blahtexml",
    "binary": "blahtexml",
    "check": "which blahtexml",
    "install_steps": [
      "brew install blahtexml",
      "Verify: blahtexml --version",
      "supercli plugins install ./plugins/blahtexml --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "blahtexml",
      "resource": "self",
      "action": "version",
      "description": "Print blahtexml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "blahtexml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install blahtexml: brew install blahtexml"
      },
      "args": []
    },
    {
      "namespace": "blahtexml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to blahtexml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "blahtexml",
        "passthrough": true,
        "missingDependencyHelp": "Install blahtexml"
      },
      "args": []
    }
  ]
}