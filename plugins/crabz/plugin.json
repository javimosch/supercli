{
  "name": "crabz",
  "version": "0.1.0",
  "description": "Like pigz, but in Rust",
  "source": "https://github.com/sstadick/crabz",
  "checks": [
    {
      "type": "binary",
      "name": "crabz"
    }
  ],
  "install_guidance": {
    "plugin": "crabz",
    "binary": "crabz",
    "check": "which crabz",
    "install_steps": [
      "brew install crabz",
      "Verify: crabz --version",
      "supercli plugins install ./plugins/crabz --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "crabz",
      "resource": "self",
      "action": "version",
      "description": "Print crabz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crabz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crabz: brew install crabz"
      },
      "args": []
    },
    {
      "namespace": "crabz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crabz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crabz",
        "passthrough": true,
        "missingDependencyHelp": "Install crabz"
      },
      "args": []
    }
  ]
}