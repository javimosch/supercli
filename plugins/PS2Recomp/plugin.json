{
  "name": "PS2Recomp",
  "version": "0.1.0",
  "description": "Playstation 2 Static Recompiler & Runtime Tool to make native PC ports",
  "source": "https://github.com/PS2Recomp/PS2Recomp",
  "checks": [
    {
      "type": "binary",
      "name": "ps2recomp"
    }
  ],
  "install_guidance": {
    "plugin": "PS2Recomp",
    "binary": "ps2recomp",
    "check": "which ps2recomp",
    "install_steps": [
      "pip install ps2recomp",
      "Verify: ps2recomp --version",
      "supercli plugins install ./plugins/PS2Recomp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PS2Recomp",
      "resource": "self",
      "action": "version",
      "description": "Print PS2Recomp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps2recomp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PS2Recomp: pip install ps2recomp"
      },
      "args": []
    },
    {
      "namespace": "PS2Recomp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ps2recomp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps2recomp",
        "passthrough": true,
        "missingDependencyHelp": "Install PS2Recomp: pip install ps2recomp"
      },
      "args": []
    }
  ]
}