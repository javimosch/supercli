{
  "name": "dnstwist",
  "version": "1.0.0",
  "description": "dnstwist \u2014 DNS twist detection",
  "source": "github.com/elceef/dnstwist",
  "checks": [
    {
      "type": "binary",
      "name": "dnstwist"
    }
  ],
  "install_guidance": {
    "plugin": "dnstwist",
    "binary": "dnstwist",
    "check": "which dnstwist",
    "install_steps": [
      "# Install dnstwist",
      "# See github.com/elceef/dnstwist",
      "# apt: sudo apt-get install dnstwist",
      "# brew: brew install dnstwist",
      "# cargo: cargo install dnstwist",
      "# npm: npm install -g dnstwist",
      "# pip: pip install dnstwist"
    ]
  },
  "commands": [
    {
      "namespace": "dnstwist",
      "resource": "dnstwist",
      "action": "run",
      "description": "Run dnstwist",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnstwist",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dnstwist from github.com/elceef/dnstwist"
      },
      "args": []
    }
  ]
}