{
  "name": "crystalline",
  "version": "0.1.0",
  "description": "Language Server Protocol implementation for Crystal",
  "source": "https://github.com/elbywan/crystalline",
  "checks": [
    {
      "type": "binary",
      "name": "crystalline"
    }
  ],
  "install_guidance": {
    "plugin": "crystalline",
    "binary": "crystalline",
    "check": "which crystalline",
    "install_steps": [
      "brew install crystalline",
      "Verify: crystalline --version",
      "supercli plugins install ./plugins/crystalline --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "crystalline",
      "resource": "self",
      "action": "version",
      "description": "Print crystalline version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crystalline",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crystalline: brew install crystalline"
      },
      "args": []
    },
    {
      "namespace": "crystalline",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crystalline CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crystalline",
        "passthrough": true,
        "missingDependencyHelp": "Install crystalline"
      },
      "args": []
    }
  ]
}