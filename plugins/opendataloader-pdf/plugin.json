{
  "name": "opendataloader-pdf",
  "version": "0.1.0",
  "description": "PDF Parser for AI-ready data. Automate PDF accessibility. Open-source.",
  "source": "https://github.com/opendataloader-pdf/opendataloader-pdf",
  "checks": [
    {
      "type": "binary",
      "name": "opendataloader-pdf"
    }
  ],
  "install_guidance": {
    "plugin": "opendataloader-pdf",
    "binary": "opendataloader-pdf",
    "check": "which opendataloader-pdf",
    "install_steps": [
      "pip install opendataloader-pdf",
      "Verify: opendataloader-pdf --version",
      "supercli plugins install ./plugins/opendataloader-pdf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "opendataloader-pdf",
      "resource": "self",
      "action": "version",
      "description": "Print opendataloader-pdf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "opendataloader-pdf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install opendataloader-pdf: pip install opendataloader-pdf"
      },
      "args": []
    },
    {
      "namespace": "opendataloader-pdf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to opendataloader-pdf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "opendataloader-pdf",
        "passthrough": true,
        "missingDependencyHelp": "Install opendataloader-pdf: pip install opendataloader-pdf"
      },
      "args": []
    }
  ]
}