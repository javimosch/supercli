{
  "name": "dee-arxiv",
  "version": "0.1.0",
  "description": "Search academic papers on arXiv with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-arxiv" }],
  "install_guidance": {
    "plugin": "dee-arxiv",
    "binary": "dee-arxiv",
    "check": "which dee-arxiv",
    "install_steps": ["cargo install dee-arxiv", "Verify: dee-arxiv --version", "supercli plugins install ./plugins/dee-arxiv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-arxiv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-arxiv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-arxiv",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-arxiv: cargo install dee-arxiv"
    },
    "args": []
  }]
}
