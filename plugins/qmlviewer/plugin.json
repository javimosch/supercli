{
  "name": "qmlviewer",
  "version": "0.1.0",
  "description": "CLI tool: qmlviewer",
  "source": "https://manpages.debian.org/qmlviewer",
  "checks": [
    {
      "type": "binary",
      "name": "qmlviewer"
    }
  ],
  "install_guidance": {
    "plugin": "qmlviewer",
    "binary": "qmlviewer",
    "check": "which qmlviewer",
    "install_steps": [
      "apt-get install qmlviewer 2>/dev/null || which qmlviewer",
      "Verify: qmlviewer --version",
      "supercli plugins install ./plugins/qmlviewer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmlviewer",
      "resource": "self",
      "action": "version",
      "description": "Print qmlviewer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlviewer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmlviewer: apt-get install qmlviewer 2>/dev/null || which qmlviewer"
      },
      "args": []
    },
    {
      "namespace": "qmlviewer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmlviewer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlviewer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmlviewer: apt-get install qmlviewer 2>/dev/null || which qmlviewer"
      },
      "args": []
    }
  ]
}