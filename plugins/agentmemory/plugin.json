{
  "name": "agentmemory",
  "version": "0.1.0",
  "description": "#1 Persistent memory for AI coding agents based on real-world benchmarks",
  "source": "https://github.com/agentmemory/agentmemory",
  "checks": [
    {
      "type": "binary",
      "name": "agentmemory"
    }
  ],
  "install_guidance": {
    "plugin": "agentmemory",
    "binary": "agentmemory",
    "check": "which agentmemory",
    "install_steps": [
      "pip install agentmemory",
      "Verify: agentmemory --version",
      "supercli plugins install ./plugins/agentmemory --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agentmemory",
      "resource": "self",
      "action": "version",
      "description": "Print agentmemory version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agentmemory: pip install agentmemory"
      },
      "args": []
    },
    {
      "namespace": "agentmemory",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agentmemory CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentmemory",
        "passthrough": true,
        "missingDependencyHelp": "Install agentmemory: pip install agentmemory"
      },
      "args": []
    }
  ]
}