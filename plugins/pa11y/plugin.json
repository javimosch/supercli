{
  "name": "pa11y",
  "version": "0.1.0",
  "description": "Automated accessibility testing tool",
  "source": "https://github.com/pa11y/pa11y",
  "checks": [
    {
      "type": "binary",
      "name": "pa11y"
    }
  ],
  "install_guidance": {
    "plugin": "pa11y",
    "binary": "pa11y",
    "check": "which pa11y",
    "install_steps": [
      "npm install -g pa11y",
      "Verify: pa11y --version",
      "supercli plugins install ./plugins/pa11y --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "pa11y",
      "resource": "self",
      "action": "version",
      "description": "Print pa11y version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pa11y",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pa11y: npm install -g pa11y"
      },
      "args": []
    },
    {
      "namespace": "pa11y",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pa11y CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pa11y",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pa11y: npm install -g pa11y"
      },
      "args": []
    }
  ]
}
