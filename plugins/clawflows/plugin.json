{
  "name": "clawflows",
  "version": "0.1.0",
  "description": "\u26a1\ufe0f Superpowers for your Openclaw. Powerful prebuilt agent workflows.",
  "source": "https://github.com/clawflows/clawflows",
  "checks": [
    {
      "type": "binary",
      "name": "clawflows"
    }
  ],
  "install_guidance": {
    "plugin": "clawflows",
    "binary": "clawflows",
    "check": "which clawflows",
    "install_steps": [
      "pip install clawflows",
      "Verify: clawflows --version",
      "supercli plugins install ./plugins/clawflows --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clawflows",
      "resource": "self",
      "action": "version",
      "description": "Print clawflows version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clawflows",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clawflows: pip install clawflows"
      },
      "args": []
    },
    {
      "namespace": "clawflows",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clawflows CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clawflows",
        "passthrough": true,
        "missingDependencyHelp": "Install clawflows: pip install clawflows"
      },
      "args": []
    }
  ]
}