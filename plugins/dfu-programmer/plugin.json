{
  "name": "dfu-programmer",
  "version": "0.1.0",
  "description": "Device firmware update based USB programmer for Atmel chips",
  "source": "https://github.com/dfu-programmer/dfu-programmer",
  "checks": [
    {
      "type": "binary",
      "name": "dfu-programmer"
    }
  ],
  "install_guidance": {
    "plugin": "dfu-programmer",
    "binary": "dfu-programmer",
    "check": "which dfu-programmer",
    "install_steps": [
      "brew install dfu-programmer",
      "Verify: dfu-programmer --version",
      "supercli plugins install ./plugins/dfu-programmer --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dfu-programmer",
      "resource": "self",
      "action": "version",
      "description": "Print dfu-programmer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dfu-programmer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dfu-programmer: brew install dfu-programmer"
      },
      "args": []
    },
    {
      "namespace": "dfu-programmer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dfu-programmer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dfu-programmer",
        "passthrough": true,
        "missingDependencyHelp": "Install dfu-programmer"
      },
      "args": []
    }
  ]
}