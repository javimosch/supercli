{
  "name": "geteltorito",
  "version": "0.1.0",
  "description": "geteltorito \u2014 an El Torito boot image extractor",
  "source": "https://manpages.debian.org/geteltorito",
  "checks": [
    {
      "type": "binary",
      "name": "geteltorito"
    }
  ],
  "install_guidance": {
    "plugin": "geteltorito",
    "binary": "geteltorito",
    "check": "which geteltorito",
    "install_steps": [
      "apt-get install geteltorito 2>/dev/null || which geteltorito",
      "Verify: geteltorito --version",
      "supercli plugins install ./plugins/geteltorito --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "geteltorito",
      "resource": "self",
      "action": "version",
      "description": "Print geteltorito version",
      "adapter": "process",
      "adapterConfig": {
        "command": "geteltorito",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install geteltorito: apt-get install geteltorito 2>/dev/null || which geteltorito"
      },
      "args": []
    },
    {
      "namespace": "geteltorito",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to geteltorito CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "geteltorito",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install geteltorito: apt-get install geteltorito 2>/dev/null || which geteltorito"
      },
      "args": []
    }
  ]
}