{
  "name": "loadunimap",
  "version": "0.1.0",
  "description": "CLI tool: loadunimap",
  "source": "https://manpages.debian.org/loadunimap",
  "checks": [
    {
      "type": "binary",
      "name": "loadunimap"
    }
  ],
  "install_guidance": {
    "plugin": "loadunimap",
    "binary": "loadunimap",
    "check": "which loadunimap",
    "install_steps": [
      "apt-get install loadunimap 2>/dev/null || which loadunimap",
      "Verify: loadunimap --version",
      "supercli plugins install ./plugins/loadunimap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "loadunimap",
      "resource": "self",
      "action": "version",
      "description": "Print loadunimap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "loadunimap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install loadunimap: apt-get install loadunimap 2>/dev/null || which loadunimap"
      },
      "args": []
    },
    {
      "namespace": "loadunimap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to loadunimap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "loadunimap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install loadunimap: apt-get install loadunimap 2>/dev/null || which loadunimap"
      },
      "args": []
    }
  ]
}