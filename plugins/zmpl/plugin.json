{
  "name": "zmpl",
  "version": "0.1.0",
  "description": "Zmpl is a templating language written in Zig",
  "source": "https://github.com/zmpl/zmpl",
  "checks": [
    {
      "type": "binary",
      "name": "zmpl"
    }
  ],
  "install_guidance": {
    "plugin": "zmpl",
    "binary": "zmpl",
    "check": "which zmpl",
    "install_steps": [
      "pip install zmpl",
      "Verify: zmpl --version",
      "supercli plugins install ./plugins/zmpl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zmpl",
      "resource": "self",
      "action": "version",
      "description": "Print zmpl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zmpl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zmpl: pip install zmpl"
      },
      "args": []
    },
    {
      "namespace": "zmpl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zmpl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zmpl",
        "passthrough": true,
        "missingDependencyHelp": "Install zmpl: pip install zmpl"
      },
      "args": []
    }
  ]
}