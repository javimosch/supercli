{
  "name": "uni",
  "version": "0.1.0",
  "description": "Query the Unicode database from the CLI: identify codepoints, search by name, print blocks/categories, and find emojis",
  "source": "https://github.com/arp242/uni",
  "checks": [
    { "type": "binary", "name": "uni" }
  ],
  "install_guidance": {
    "plugin": "uni",
    "binary": "uni",
    "check": "which uni",
    "install_steps": [
      "go install zgo.at/uni/v2@latest",
      "Verify: uni help",
      "supercli plugins install ./plugins/uni --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uni",
      "resource": "self",
      "action": "help",
      "description": "Print uni usage, including the -format output template reference",
      "adapter": "process",
      "adapterConfig": {
        "command": "uni",
        "baseArgs": ["help"],
        "missingDependencyHelp": "Install uni: go install zgo.at/uni/v2@latest"
      },
      "args": []
    },
    {
      "namespace": "uni",
      "resource": "unicode",
      "action": "identify",
      "description": "Identify codepoints in a string or stdin (uni identify 'h€y'; shortcut: i)",
      "adapter": "process",
      "adapterConfig": {
        "command": "uni",
        "baseArgs": ["identify"],
        "passthrough": true,
        "missingDependencyHelp": "Install uni: go install zgo.at/uni/v2@latest"
      },
      "args": []
    },
    {
      "namespace": "uni",
      "resource": "unicode",
      "action": "search",
      "description": "Search characters by description words (uni search euro; shortcut: s)",
      "adapter": "process",
      "adapterConfig": {
        "command": "uni",
        "baseArgs": ["search"],
        "passthrough": true,
        "missingDependencyHelp": "Install uni: go install zgo.at/uni/v2@latest"
      },
      "args": []
    },
    {
      "namespace": "uni",
      "resource": "unicode",
      "action": "print",
      "description": "Print codepoints by number, range, category, or block (uni print arrows; shortcut: p)",
      "adapter": "process",
      "adapterConfig": {
        "command": "uni",
        "baseArgs": ["print"],
        "passthrough": true,
        "missingDependencyHelp": "Install uni: go install zgo.at/uni/v2@latest"
      },
      "args": []
    },
    {
      "namespace": "uni",
      "resource": "unicode",
      "action": "emoji",
      "description": "Find emojis by name or keyword (uni emoji cry; shortcut: e)",
      "adapter": "process",
      "adapterConfig": {
        "command": "uni",
        "baseArgs": ["emoji"],
        "passthrough": true,
        "missingDependencyHelp": "Install uni: go install zgo.at/uni/v2@latest"
      },
      "args": []
    },
    {
      "namespace": "uni",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uni CLI (uni i/s/p/e shortcuts, -f format strings, -json, etc.)",
      "adapter": "process",
      "adapterConfig": {
        "command": "uni",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install uni: go install zgo.at/uni/v2@latest"
      },
      "args": []
    }
  ]
}
