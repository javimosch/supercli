{
  "name": "multigres",
  "version": "0.1.0",
  "description": "Vitess for Postgres — distributed PostgreSQL at scale",
  "source": "https://github.com/multigres/multigres",
  "checks": [
    {
      "type": "binary",
      "name": "multigres"
    }
  ],
  "install_guidance": {
    "plugin": "multigres",
    "binary": "multigres",
    "check": "which multigres",
    "install_steps": [
      "go install github.com/multigres/multigres@latest",
      "Verify: multigres --version",
      "supercli plugins install ./plugins/multigres --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "multigres",
    "resource": "self",
    "action": "version",
    "description": "Print multigres version",
    "adapter": "process",
    "adapterConfig": {
      "command": "multigres",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install multigres: go install github.com/multigres/multigres@latest"
    },
    "args": []
  },
  {
    "namespace": "multigres",
    "resource": "server",
    "action": "start",
    "description": "Start the Multigres server",
    "adapter": "process",
    "adapterConfig": {
      "command": "multigres",
      "passthrough": true,
      "missingDependencyHelp": "Install multigres: go install github.com/multigres/multigres@latest"
    },
    "args": []
  },
  {
    "namespace": "multigres",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to multigres CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "multigres",
      "passthrough": true,
      "missingDependencyHelp": "Install multigres"
    },
    "args": []
  }
]
}