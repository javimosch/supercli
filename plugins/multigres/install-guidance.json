{
  "plugin": "multigres",
  "binary": "multigres",
  "check": "which multigres",
  "install_steps": [
    "go install github.com/multigres/multigres@latest",
    "Verify: multigres --version",
    "supercli plugins install ./plugins/multigres --on-conflict replace --json"
  ],
  "note": "Brings Vitess-like sharding and distribution to PostgreSQL."
}