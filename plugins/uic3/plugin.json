{
  "name": "uic3",
  "version": "0.1.0",
  "description": "CLI tool: uic3",
  "source": "https://manpages.debian.org/uic3",
  "checks": [
    {
      "type": "binary",
      "name": "uic3"
    }
  ],
  "install_guidance": {
    "plugin": "uic3",
    "binary": "uic3",
    "check": "which uic3",
    "install_steps": [
      "apt-get install uic3 2>/dev/null || which uic3",
      "Verify: uic3 --version",
      "supercli plugins install ./plugins/uic3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uic3",
      "resource": "self",
      "action": "version",
      "description": "Print uic3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uic3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uic3: apt-get install uic3 2>/dev/null || which uic3"
      },
      "args": []
    },
    {
      "namespace": "uic3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uic3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uic3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uic3: apt-get install uic3 2>/dev/null || which uic3"
      },
      "args": []
    }
  ]
}