{
  "name": "unmkinitramfs",
  "version": "0.1.0",
  "description": "CLI tool: unmkinitramfs",
  "source": "https://manpages.debian.org/unmkinitramfs",
  "checks": [
    {
      "type": "binary",
      "name": "unmkinitramfs"
    }
  ],
  "install_guidance": {
    "plugin": "unmkinitramfs",
    "binary": "unmkinitramfs",
    "check": "which unmkinitramfs",
    "install_steps": [
      "apt-get install unmkinitramfs 2>/dev/null || which unmkinitramfs",
      "Verify: unmkinitramfs --version",
      "supercli plugins install ./plugins/unmkinitramfs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unmkinitramfs",
      "resource": "self",
      "action": "version",
      "description": "Print unmkinitramfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unmkinitramfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unmkinitramfs: apt-get install unmkinitramfs 2>/dev/null || which unmkinitramfs"
      },
      "args": []
    },
    {
      "namespace": "unmkinitramfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unmkinitramfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unmkinitramfs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unmkinitramfs: apt-get install unmkinitramfs 2>/dev/null || which unmkinitramfs"
      },
      "args": []
    }
  ]
}