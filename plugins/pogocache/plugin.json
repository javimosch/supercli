{
  "name": "pogocache",
  "version": "0.1.0",
  "description": "Fast caching software with a focus on low latency and cpu efficiency.",
  "source": "https://github.com/pogocache/pogocache",
  "checks": [
    {
      "type": "binary",
      "name": "pogocache"
    }
  ],
  "install_guidance": {
    "plugin": "pogocache",
    "binary": "pogocache",
    "check": "which pogocache",
    "install_steps": [
      "pip install pogocache",
      "Verify: pogocache --version",
      "supercli plugins install ./plugins/pogocache --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pogocache",
      "resource": "self",
      "action": "version",
      "description": "Print pogocache version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pogocache",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pogocache: pip install pogocache"
      },
      "args": []
    },
    {
      "namespace": "pogocache",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pogocache CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pogocache",
        "passthrough": true,
        "missingDependencyHelp": "Install pogocache: pip install pogocache"
      },
      "args": []
    }
  ]
}