{
  "name": "cmd",
  "version": "0.1.0",
  "description": "CLI tool: cmd",
  "source": "https://packages.debian.org/cmd",
  "checks": [{ "type": "binary", "name": "cmd" }],
  "install_guidance": {
    "plugin": "cmd", "binary": "cmd", "check": "which cmd",
    "install_steps": ["apt-get install cmd 2>/dev/null || which cmd", "Verify: cmd --version", "supercli plugins install ./plugins/cmd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cmd", "resource": "_", "action": "_",
    "description": "Passthrough to cmd CLI",
    "adapter": "process", "adapterConfig": { "command": "cmd", "passthrough": true, "missingDependencyHelp": "Install cmd: apt-get install cmd" }, "args": []
  }]
}
