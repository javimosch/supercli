{
  "name": "poetry-export-plugin",
  "version": "0.1.0",
  "description": "Export Poetry lock file to requirements.txt format",
  "source": "https://github.com/python-poetry/poetry-plugin-export",
  "checks": [{ "type": "binary", "name": "poetry-plugin-export" }],
  "install_guidance": {
    "plugin": "poetry-export-plugin",
    "binary": "poetry-plugin-export",
    "check": "which poetry-plugin-export",
    "install_steps": ["pip install poetry-plugin-export", "Verify: poetry-plugin-export --version", "supercli plugins install ./plugins/poetry-export-plugin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "poetry-export-plugin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to poetry-plugin-export CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "poetry-plugin-export",
      "passthrough": true,
      "missingDependencyHelp": "Install poetry-export-plugin: pip install poetry-plugin-export"
    },
    "args": []
  }]
}
