  "commands": [{
    "namespace": "apt-add-repository", "resource": "_", "action": "_",
    "description": "Passthrough to apt-add-repository CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-add-repository", "passthrough": true, "missingDependencyHelp": "Install apt-add-repository: apt-get install apt-add-repository" }, "args": []
  }]
}
