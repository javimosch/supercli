{
  "name": "apt-add-repository",
  "version": "0.1.0",
  "description": "CLI tool: apt-add-repository",
  "source": "https://packages.debian.org/apt-add-repository",
  "checks": [{ "type": "binary", "name": "apt-add-repository" }],
  "install_guidance": {
    "plugin": "apt-add-repository", "binary": "apt-add-repository", "check": "which apt-add-repository",
    "install_steps": ["apt-get install apt-add-repository 2>/dev/null || which apt-add-repository", "Verify: apt-add-repository --version", "supercli plugins install ./plugins/apt-add-repository --on-conflict replace --json"]
