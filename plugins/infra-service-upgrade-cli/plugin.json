{
  "name": "infra-service-upgrade-cli",
  "version": "0.1.0",
  "description": "batch upgrade for rancher infra-services",
  "source": "https://github.com/infra-service-upgrade-cli/infra-service-upgrade-cli",
  "checks": [
    {
      "type": "binary",
      "name": "infra-service-upgrade-cli"
    }
  ],
  "install_guidance": {
    "plugin": "infra-service-upgrade-cli",
    "binary": "infra-service-upgrade-cli",
    "check": "which infra-service-upgrade-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: infra-service-upgrade-cli --version",
      "supercli plugins install ./plugins/infra-service-upgrade-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "infra-service-upgrade-cli",
      "resource": "self",
      "action": "version",
      "description": "Print infra-service-upgrade-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "infra-service-upgrade-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install infra-service-upgrade-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "infra-service-upgrade-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to infra-service-upgrade-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "infra-service-upgrade-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install infra-service-upgrade-cli from project repository"
      },
      "args": []
    }
  ]
}