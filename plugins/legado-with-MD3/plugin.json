      "adapterConfig": {
        "command": "legado-with-md3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install legado-with-MD3: pip install legado-with-md3"
      },
      "args": []
    },
    {
      "namespace": "legado-with-MD3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to legado-with-md3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "legado-with-md3",
        "passthrough": true,
        "missingDependencyHelp": "Install legado-with-MD3: pip install legado-with-md3"
      },
      "args": []
    }
  ]
