  "source": "https://github.com/legado-with-MD3/legado-with-MD3",
  "checks": [
    {
      "type": "binary",
      "name": "legado-with-md3"
    }
  ],
  "install_guidance": {
    "plugin": "legado-with-MD3",
    "binary": "legado-with-md3",
    "check": "which legado-with-md3",
    "install_steps": [
      "pip install legado-with-md3",
      "Verify: legado-with-md3 --version",
      "supercli plugins install ./plugins/legado-with-MD3 --on-conflict replace --json"
    ]
