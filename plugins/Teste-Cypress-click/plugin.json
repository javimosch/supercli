{
  "name": "Teste-Cypress-click",
  "version": "0.1.0",
  "description": "Primeiros estudos de automação com Cypress — testes funcionais e prática de cliques em diferentes situações de UI",
  "source": "https://github.com/Teste-Cypress-click/Teste-Cypress-click",
  "checks": [
    {
      "type": "binary",
      "name": "Teste-Cypress-click"
    }
  ],
  "install_guidance": {
    "plugin": "Teste-Cypress-click",
    "binary": "Teste-Cypress-click",
    "check": "which Teste-Cypress-click",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Teste-Cypress-click --version",
      "supercli plugins install ./plugins/Teste-Cypress-click --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "Teste-Cypress-click",
      "resource": "self",
      "action": "version",
      "description": "Print Teste-Cypress-click version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Teste-Cypress-click",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Teste-Cypress-click from project repository"
      },
      "args": []
    },
    {
      "namespace": "Teste-Cypress-click",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Teste-Cypress-click CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Teste-Cypress-click",
        "passthrough": true,
        "missingDependencyHelp": "Install Teste-Cypress-click from project repository"
      },
      "args": []
    }
  ]
}