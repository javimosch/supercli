{
  "name": "compose-bridge",
  "version": "0.1.0",
  "description": "CLI tool: compose-bridge",
  "source": "https://packages.debian.org/compose-bridge",
  "checks": [{ "type": "binary", "name": "compose-bridge" }],
  "install_guidance": {
    "plugin": "compose-bridge", "binary": "compose-bridge", "check": "which compose-bridge",
    "install_steps": ["apt-get install compose-bridge 2>/dev/null || which compose-bridge", "Verify: compose-bridge --version", "supercli plugins install ./plugins/compose-bridge --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "compose-bridge", "resource": "_", "action": "_",
    "description": "Passthrough to compose-bridge CLI",
    "adapter": "process", "adapterConfig": { "command": "compose-bridge", "passthrough": true, "missingDependencyHelp": "Install compose-bridge: apt-get install compose-bridge" }, "args": []
  }]
}
