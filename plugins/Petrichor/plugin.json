{
  "name": "Petrichor",
  "version": "0.1.0",
  "description": "An offline macOS music player",
  "source": "https://github.com/Petrichor/Petrichor",
  "checks": [
    {
      "type": "binary",
      "name": "petrichor"
    }
  ],
  "install_guidance": {
    "plugin": "Petrichor",
    "binary": "petrichor",
    "check": "which petrichor",
    "install_steps": [
      "pip install petrichor",
      "Verify: petrichor --version",
      "supercli plugins install ./plugins/Petrichor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Petrichor",
      "resource": "self",
      "action": "version",
      "description": "Print Petrichor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "petrichor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Petrichor: pip install petrichor"
      },
      "args": []
    },
    {
      "namespace": "Petrichor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to petrichor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "petrichor",
        "passthrough": true,
        "missingDependencyHelp": "Install Petrichor: pip install petrichor"
      },
      "args": []
    }
  ]
}