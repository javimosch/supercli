{
  "name": "cmake-lint",
  "version": "0.1.0",
  "description": "Static code checker for CMake files",
  "source": "https://github.com/cmake-lint/cmake-lint",
  "checks": [
    {
      "type": "binary",
      "name": "cmake-lint"
    }
  ],
  "install_guidance": {
    "plugin": "cmake-lint",
    "binary": "cmake-lint",
    "check": "which cmake-lint",
    "install_steps": [
      "brew install cmake-lint",
      "Verify: cmake-lint --version",
      "supercli plugins install ./plugins/cmake-lint --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cmake-lint",
      "resource": "self",
      "action": "version",
      "description": "Print cmake-lint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmake-lint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmake-lint: brew install cmake-lint"
      },
      "args": []
    },
    {
      "namespace": "cmake-lint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmake-lint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmake-lint",
        "passthrough": true,
        "missingDependencyHelp": "Install cmake-lint"
      },
      "args": []
    }
  ]
}