{
  "name": "at_pkg",
  "version": "0.1.0",
  "description": "CLI tool: at_pkg",
  "source": "https://packages.debian.org/at_pkg",
  "checks": [{ "type": "binary", "name": "at_pkg" }],
  "install_guidance": {
    "plugin": "at_pkg", "binary": "at_pkg", "check": "which at_pkg",
    "install_steps": ["apt-get install at_pkg 2>/dev/null || which at_pkg", "Verify: at_pkg --version", "supercli plugins install ./plugins/at_pkg --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_pkg", "resource": "_", "action": "_",
    "description": "Passthrough to at_pkg CLI",
    "adapter": "process", "adapterConfig": { "command": "at_pkg", "passthrough": true, "missingDependencyHelp": "Install at_pkg: apt-get install at_pkg" }, "args": []
  }]
}
