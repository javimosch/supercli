{
  "name": "claw-code",
  "version": "0.1.0",
  "description": "The repo is finally unlocked. enjoy the party! The fastest repo in history to surpass 100K stars \u2b50. ",
  "source": "https://github.com/claw-code/claw-code",
  "checks": [
    {
      "type": "binary",
      "name": "claw-code"
    }
  ],
  "install_guidance": {
    "plugin": "claw-code",
    "binary": "claw-code",
    "check": "which claw-code",
    "install_steps": [
      "pip install claw-code",
      "Verify: claw-code --version",
      "supercli plugins install ./plugins/claw-code --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claw-code",
      "resource": "self",
      "action": "version",
      "description": "Print claw-code version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claw-code",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claw-code: pip install claw-code"
      },
      "args": []
    },
    {
      "namespace": "claw-code",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claw-code CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claw-code",
        "passthrough": true,
        "missingDependencyHelp": "Install claw-code: pip install claw-code"
      },
      "args": []
    }
  ]
}