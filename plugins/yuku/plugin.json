{
  "name": "yuku",
  "version": "0.1.0",
  "description": "High-performance JavaScript/TypeScript compiler toolchain in Zig.",
  "source": "https://github.com/yuku/yuku",
  "checks": [
    {
      "type": "binary",
      "name": "yuku"
    }
  ],
  "install_guidance": {
    "plugin": "yuku",
    "binary": "yuku",
    "check": "which yuku",
    "install_steps": [
      "pip install yuku",
      "Verify: yuku --version",
      "supercli plugins install ./plugins/yuku --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yuku",
      "resource": "self",
      "action": "version",
      "description": "Print yuku version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuku",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yuku: pip install yuku"
      },
      "args": []
    },
    {
      "namespace": "yuku",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yuku CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuku",
        "passthrough": true,
        "missingDependencyHelp": "Install yuku: pip install yuku"
      },
      "args": []
    }
  ]
}