{
  "name": "yuku",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript compiler toolchain in Zig",
  "source": "https://github.com/nicholasgasior/yuku",
  "checks": [{"type": "binary", "name": "yuku"}],
  "install_guidance": {
    "plugin": "yuku",
    "binary": "yuku",
    "check": "which yuku",
    "install_steps": [
      "cargo install yuku",
      "Verify: yuku --version",
      "supercli plugins install ./yuku --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "yuku",
      "resource": "self",
      "action": "version",
      "description": "Print yuku version",
      "adapter": "process",
      "adapterConfig": {"command": "yuku", "baseArgs": ["--version"], "missingDependencyHelp": "Install yuku: cargo install yuku"},
      "args": []
    },
    {
      "namespace": "yuku",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yuku CLI",
      "adapter": "process",
      "adapterConfig": {"command": "yuku", "passthrough": true, "missingDependencyHelp": "Install yuku: cargo install yuku"},
      "args": []
    }
  ]
}
