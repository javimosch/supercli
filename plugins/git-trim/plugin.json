{
  "name": "git-trim",
  "version": "0.1.0",
  "description": "Automatically prune merged and stray git branches",
  "source": "https://github.com/foriequal0/git-trim",
  "checks": [{ "type": "binary", "name": "git-trim" }],
  "install_guidance": {
    "plugin": "git-trim",
    "binary": "git-trim",
    "check": "which git-trim",
    "install_steps": ["cargo install git-trim", "Verify: git-trim --version", "supercli plugins install ./plugins/git-trim --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-trim",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-trim CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-trim",
      "passthrough": true,
      "missingDependencyHelp": "Install git-trim: cargo install git-trim", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
