{
  "name": "kurly",
  "version": "0.1.0",
  "description": "cURL alternative with improved convenience features",
  "source": "https://github.com/davidjpeacock/kurly",
  "checks": [{ "type": "binary", "name": "kurly" }],
  "install_guidance": {
    "plugin": "kurly",
    "binary": "kurly",
    "check": "which kurly",
    "install_steps": ["go get github.com/davidjpeacock/kurly", "Verify: kurly --version", "supercli plugins install ./plugins/kurly --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kurly",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kurly CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kurly",
      "passthrough": true,
      "missingDependencyHelp": "Install kurly: go get github.com/davidjpeacock/kurly", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
