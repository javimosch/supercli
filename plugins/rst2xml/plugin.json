{
  "name": "rst2xml",
  "version": "0.1.0",
  "description": "CLI tool: rst2xml",
  "source": "https://manpages.debian.org/rst2xml",
  "checks": [
    {
      "type": "binary",
      "name": "rst2xml"
    }
  ],
  "install_guidance": {
    "plugin": "rst2xml",
    "binary": "rst2xml",
    "check": "which rst2xml",
    "install_steps": [
      "apt-get install rst2xml 2>/dev/null || which rst2xml",
      "Verify: rst2xml --version",
      "supercli plugins install ./plugins/rst2xml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rst2xml",
      "resource": "self",
      "action": "version",
      "description": "Print rst2xml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2xml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rst2xml: apt-get install rst2xml 2>/dev/null || which rst2xml"
      },
      "args": []
    },
    {
      "namespace": "rst2xml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rst2xml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2xml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rst2xml: apt-get install rst2xml 2>/dev/null || which rst2xml"
      },
      "args": []
    }
  ]
}