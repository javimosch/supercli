{
  "name": "libtcod",
  "version": "0.1.0",
  "description": "API for roguelike developers",
  "source": "https://github.com/libtcod/libtcod",
  "checks": [
    {
      "type": "binary",
      "name": "libtcod"
    }
  ],
  "install_guidance": {
    "plugin": "libtcod",
    "binary": "libtcod",
    "check": "which libtcod",
    "install_steps": [
      "brew install libtcod",
      "Verify: libtcod --version",
      "supercli plugins install ./plugins/libtcod --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libtcod",
      "resource": "self",
      "action": "version",
      "description": "Print libtcod version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libtcod",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libtcod: brew install libtcod"
      },
      "args": []
    },
    {
      "namespace": "libtcod",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libtcod CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libtcod",
        "passthrough": true,
        "missingDependencyHelp": "Install libtcod"
      },
      "args": []
    }
  ]
}