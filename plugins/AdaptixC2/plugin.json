{
  "name": "AdaptixC2",
  "version": "0.1.0",
  "description": "AdaptixC2 is a highly modular advanced redteam toolkit",
  "source": "https://github.com/AdaptixC2/AdaptixC2",
  "checks": [
    {
      "type": "binary",
      "name": "adaptixc2"
    }
  ],
  "install_guidance": {
    "plugin": "AdaptixC2",
    "binary": "adaptixc2",
    "check": "which adaptixc2",
    "install_steps": [
      "pip install adaptixc2",
      "Verify: adaptixc2 --version",
      "supercli plugins install ./plugins/AdaptixC2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AdaptixC2",
      "resource": "self",
      "action": "version",
      "description": "Print AdaptixC2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "adaptixc2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AdaptixC2: pip install adaptixc2"
      },
      "args": []
    },
    {
      "namespace": "AdaptixC2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to adaptixc2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "adaptixc2",
        "passthrough": true,
        "missingDependencyHelp": "Install AdaptixC2: pip install adaptixc2"
      },
      "args": []
    }
  ]
}