{
  "name": "aa-teardown",
  "version": "0.1.0",
  "description": "CLI tool: aa-teardown",
  "source": "https://manpages.debian.org/aa-teardown",
  "checks": [
    {
      "type": "binary",
      "name": "aa-teardown"
    }
  ],
  "install_guidance": {
    "plugin": "aa-teardown",
    "binary": "aa-teardown",
    "check": "which aa-teardown",
    "install_steps": [
      "apt-get install aa-teardown 2>/dev/null || which aa-teardown",
      "Verify: aa-teardown --version",
      "supercli plugins install ./plugins/aa-teardown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aa-teardown",
      "resource": "self",
      "action": "version",
      "description": "Print aa-teardown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aa-teardown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aa-teardown: apt-get install aa-teardown 2>/dev/null || which aa-teardown"
      },
      "args": []
    },
    {
      "namespace": "aa-teardown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aa-teardown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aa-teardown",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install aa-teardown: apt-get install aa-teardown 2>/dev/null || which aa-teardown"
      },
      "args": []
    }
  ]
}