{
  "name": "dhall-to-yaml",
  "version": "0.1.0",
  "description": "CLI tool: dhall-to-yaml",
  "source": "https://packages.debian.org/dhall-to-yaml",
  "checks": [{ "type": "binary", "name": "dhall-to-yaml" }],
  "install_guidance": {
    "plugin": "dhall-to-yaml", "binary": "dhall-to-yaml", "check": "which dhall-to-yaml",
    "install_steps": ["apt-get install dhall-to-yaml 2>/dev/null || which dhall-to-yaml", "Verify: dhall-to-yaml --version", "supercli plugins install ./plugins/dhall-to-yaml --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-to-yaml", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-to-yaml CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-to-yaml", "passthrough": true, "missingDependencyHelp": "Install dhall-to-yaml: apt-get install dhall-to-yaml" }, "args": []
  }]
}
