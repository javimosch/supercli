{
  "name": "tsort",
  "version": "0.1.0",
  "description": "tsort — Topological sort",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "tsort"
    }
  ],
  "install_guidance": {
    "plugin": "tsort",
    "binary": "tsort",
    "check": "which tsort",
    "install_steps": [
      "brew install coreutils",
      "supercli plugins install ./plugins/tsort --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tsort",
      "resource": "self",
      "action": "version",
      "description": "Print tsort version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tsort",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tsort: brew install coreutils"
      },
      "args": []
    },
    {
      "namespace": "tsort",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tsort CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tsort",
        "passthrough": true,
        "missingDependencyHelp": "Install tsort: brew install coreutils"
      },
      "args": []
    }
  ]
}
