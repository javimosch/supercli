{
  "name": "Galaxy",
  "version": "0.1.0",
  "description": "\u4e00\u4e2a\u60f3\u8ba9\u4f60\u6d4b\u8bd5\u52a0\u5bc6\u6d41\u91cf\u50cf\u6d4b\u8bd5\u660e\u6587\u4e00\u6837\u7b80\u5355\u9ad8\u6548\u7684 Burp \u63d2\u4ef6\u3002 A Burp plugin that makes testing encrypted traffic as simple and ef",
  "source": "https://github.com/Galaxy/Galaxy",
  "checks": [
    {
      "type": "binary",
      "name": "galaxy"
    }
  ],
  "install_guidance": {
    "plugin": "Galaxy",
    "binary": "galaxy",
    "check": "which galaxy",
    "install_steps": [
      "pip install galaxy",
      "Verify: galaxy --version",
      "supercli plugins install ./plugins/Galaxy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Galaxy",
      "resource": "self",
      "action": "version",
      "description": "Print Galaxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "galaxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Galaxy: pip install galaxy"
      },
      "args": []
    },
    {
      "namespace": "Galaxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to galaxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "galaxy",
        "passthrough": true,
        "missingDependencyHelp": "Install Galaxy: pip install galaxy"
      },
      "args": []
    }
  ]
}