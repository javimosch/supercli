{
  "name": "ox",
  "version": "0.1.0",
  "description": "Rust text editor with a focus on simplicity",
  "source": "https://github.com/curl.sh/ox",
  "checks": [{ "type": "binary", "name": "ox" }],
  "install_guidance": {
    "plugin": "ox",
    "binary": "ox",
    "check": "which ox",
    "install_steps": ["cargo install ox", "Verify: ox --version", "supercli plugins install ./plugins/ox --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ox",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ox CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ox",
      "passthrough": true,
      "missingDependencyHelp": "Install ox: cargo install ox", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
