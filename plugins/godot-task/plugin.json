{
  "name": "godot-task",
  "version": "0.1.0",
  "description": "Automate Godot project tasks including build and export via CLI",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "godot-task" }],
  "install_guidance": {
    "plugin": "godot-task",
    "binary": "godot-task",
    "check": "which godot-task",
    "install_steps": ["npm install -g godot-task", "Verify: godot-task --version", "supercli plugins install ./plugins/godot-task --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "godot-task",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to godot-task CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "godot-task",
      "passthrough": true,
      "missingDependencyHelp": "Install godot-task: npm install -g godot-task"
    },
    "args": []
  }]
}
