{
  "name": "phpdismod",
  "version": "0.1.0",
  "description": "CLI tool: phpdismod",
  "source": "https://manpages.debian.org/phpdismod",
  "checks": [
    {
      "type": "binary",
      "name": "phpdismod"
    }
  ],
  "install_guidance": {
    "plugin": "phpdismod",
    "binary": "phpdismod",
    "check": "which phpdismod",
    "install_steps": [
      "apt-get install phpdismod 2>/dev/null || which phpdismod",
      "Verify: phpdismod --version",
      "supercli plugins install ./plugins/phpdismod --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "phpdismod",
      "resource": "self",
      "action": "version",
      "description": "Print phpdismod version",
      "adapter": "process",
      "adapterConfig": {
        "command": "phpdismod",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install phpdismod: apt-get install phpdismod 2>/dev/null || which phpdismod"
      },
      "args": []
    },
    {
      "namespace": "phpdismod",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to phpdismod CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "phpdismod",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install phpdismod: apt-get install phpdismod 2>/dev/null || which phpdismod"
      },
      "args": []
    }
  ]
}