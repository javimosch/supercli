{
  "name": "codefetch",
  "version": "0.1.0",
  "description": "codefetch — turn codebases into AI-friendly Markdown with token counting and tree views",
  "source": "https://github.com/regenrek/codefetch",
  "checks": [
    { "type": "binary", "name": "codefetch" }
  ],
  "install_guidance": {
    "plugin": "codefetch",
    "binary": "codefetch",
    "check": "which codefetch",
    "install_steps": [
      "npm install -g codefetch",
      "Verify: codefetch --version",
      "supercli plugins install ./plugins/codefetch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "codefetch",
      "resource": "self",
      "action": "help",
      "description": "Print codefetch usage and options",
      "adapter": "process",
      "adapterConfig": {
        "command": "codefetch",
        "baseArgs": ["--help"],
        "missingDependencyHelp": "Install codefetch: npm install -g codefetch"
      },
      "args": []
    },
    {
      "namespace": "codefetch",
      "resource": "codebase",
      "action": "process",
      "description": "Process local codebase into AI-friendly Markdown. Use --dir, -e, --max-tokens, -t for tree, --output to control output.",
      "adapter": "process",
      "adapterConfig": {
        "command": "codefetch",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install codefetch: npm install -g codefetch"
      },
      "args": []
    },
    {
      "namespace": "codefetch",
      "resource": "codebase",
      "action": "open",
      "description": "Process codebase, copy to clipboard, and open ChatGPT/Claude/Gemini in browser. Use --chat-url and --chat-model to choose AI.",
      "adapter": "process",
      "adapterConfig": {
        "command": "codefetch",
        "baseArgs": ["open"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install codefetch: npm install -g codefetch"
      },
      "args": []
    },
    {
      "namespace": "codefetch",
      "resource": "codebase",
      "action": "url",
      "description": "Fetch and process a GitHub repo or website URL into Markdown. Supports --branch, --no-api, --github-token.",
      "adapter": "process",
      "adapterConfig": {
        "command": "codefetch",
        "baseArgs": ["--url"],
        "positionalArgs": ["url"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install codefetch: npm install -g codefetch"
      },
      "args": [
        { "name": "url", "type": "string", "required": true, "description": "GitHub repo URL (e.g., github.com/facebook/react) or website URL" }
      ]
    },
    {
      "namespace": "codefetch",
      "resource": "project",
      "action": "init",
      "description": "Initialize codefetch project config (.codefetchignore, codefetch.config.mjs)",
      "adapter": "process",
      "adapterConfig": {
        "command": "codefetch",
        "baseArgs": ["init"],
        "cwd": "invoke_cwd",
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install codefetch: npm install -g codefetch"
      },
      "args": []
    },
    {
      "namespace": "codefetch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codefetch CLI for any command or flag not covered by specific resources. Includes: --token-count-only, --project-tree, --prompt, --dry-run, --exclude-dir, --include-files, --max-pages, --max-depth, etc.",
      "adapter": "process",
      "adapterConfig": {
        "command": "codefetch",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install codefetch: npm install -g codefetch"
      },
      "args": []
    }
  ]
}
