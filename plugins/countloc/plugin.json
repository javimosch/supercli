{
  "name": "countloc",
  "version": "0.1.0",
  "description": "Fast and simple source code line counter",
  "source": "https://github.com/euroelessar/countloc",
  "checks": [{ "type": "binary", "name": "countloc" }],
  "install_guidance": {
    "plugin": "countloc",
    "binary": "countloc",
    "check": "which countloc",
    "install_steps": ["cargo install countloc", "Verify: countloc --version", "supercli plugins install ./plugins/countloc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "countloc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to countloc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "countloc",
      "passthrough": true,
      "missingDependencyHelp": "Install countloc: cargo install countloc", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
