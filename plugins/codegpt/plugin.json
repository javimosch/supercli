{
  "name": "codegpt",
  "version": "0.1.0",
  "description": "CLI tool: codegpt",
  "source": "https://packages.debian.org/codegpt",
  "checks": [{ "type": "binary", "name": "codegpt" }],
  "install_guidance": {
    "plugin": "codegpt", "binary": "codegpt", "check": "which codegpt",
    "install_steps": ["apt-get install codegpt 2>/dev/null || which codegpt", "Verify: codegpt --version", "supercli plugins install ./plugins/codegpt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "codegpt", "resource": "_", "action": "_",
    "description": "Passthrough to codegpt CLI",
    "adapter": "process", "adapterConfig": { "command": "codegpt", "passthrough": true, "missingDependencyHelp": "Install codegpt: apt-get install codegpt" }, "args": []
  }]
}
