{
  "name": "facter",
  "version": "1.0.0",
  "description": "facter \u2014 System info",
  "source": "puppet.com",
  "checks": [
    {
      "type": "binary",
      "name": "facter"
    }
  ],
  "install_guidance": {
    "plugin": "facter",
    "binary": "facter",
    "check": "which facter",
    "install_steps": [
      "# Install facter",
      "# See puppet.com",
      "# apt: sudo apt-get install facter",
      "# brew: brew install facter",
      "# cargo: cargo install facter",
      "# npm: npm install -g facter",
      "# pip: pip install facter"
    ]
  },
  "commands": [
    {
      "namespace": "facter",
      "resource": "facter",
      "action": "run",
      "description": "Run facter",
      "adapter": "process",
      "adapterConfig": {
        "command": "facter",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install facter from puppet.com"
      },
      "args": []
    }
  ]
}