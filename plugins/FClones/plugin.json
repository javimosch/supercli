{
  "name": "FClones",
  "version": "0.1.0",
  "description": "Efficient Duplicate File Finder.",
  "source": "https://github.com/pkolaczk/fclones",
  "checks": [
    {
      "type": "binary",
      "name": "FClones"
    }
  ],
  "install_guidance": {
    "plugin": "FClones",
    "binary": "FClones",
    "check": "which FClones",
    "install_steps": [
      "cargo install FClones",
      "Verify: FClones --version",
      "supercli plugins install ./plugins/FClones --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "FClones",
      "resource": "self",
      "action": "version",
      "description": "Print FClones version",
      "adapter": "process",
      "adapterConfig": {
        "command": "FClones",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FClones: cargo install FClones"
      },
      "args": []
    },
    {
      "namespace": "FClones",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to FClones CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "FClones",
        "passthrough": true,
        "missingDependencyHelp": "Install FClones"
      },
      "args": []
    }
  ]
}