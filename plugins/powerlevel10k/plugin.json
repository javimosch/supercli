{
  "name": "powerlevel10k",
  "version": "0.1.0",
  "description": "Fast zsh theme with instant prompt — CLI configuration and status export",
  "source": "https://github.com/romkatv/powerlevel10k",
  "checks": [
    {
      "type": "binary",
      "name": "powerlevel10k"
    }
  ],
  "install_guidance": {
    "plugin": "powerlevel10k",
    "binary": "powerlevel10k",
    "check": "which powerlevel10k",
    "install_steps": [
      "git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k",
      "Verify: powerlevel10k --version",
      "supercli plugins install ./plugins/powerlevel10k --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "powerlevel10k",
      "resource": "self",
      "action": "version",
      "description": "Print powerlevel10k version",
      "adapter": "process",
      "adapterConfig": {
        "command": "powerlevel10k",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install powerlevel10k: git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k"
      },
      "args": []
    },
    {
      "namespace": "powerlevel10k",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to powerlevel10k CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "powerlevel10k",
        "passthrough": true,
        "missingDependencyHelp": "Install powerlevel10k: git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k"
      },
      "args": []
    }
  ]
}
