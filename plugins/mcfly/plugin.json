{
  "name": "mcfly",
  "version": "0.1.0",
  "description": "Fly through your shell history. Great Scott! — smart shell history search with neural ranking",
  "source": "https://github.com/cantino/mcfly",
  "checks": [
    { "type": "binary", "name": "mcfly" }
  ],
  "install_guidance": {
    "plugin": "mcfly",
    "binary": "mcfly",
    "check": "which mcfly",
    "install_steps": [
      "cargo install mcfly",
      "Verify: mcfly --version",
      "supercli plugins install ./plugins/mcfly --on-conflict replace --json"
    ],
    "note": "Requires Rust/Cargo. Also available via Homebrew: brew install mcfly"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mcfly",
      "resource": "self",
      "action": "version",
      "description": "Print mcfly version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcfly",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install mcfly: cargo install mcfly"
      },
      "args": []
    },
    {
      "namespace": "mcfly",
      "resource": "history",
      "action": "search",
      "description": "Search shell history with neural ranking",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcfly",
        "baseArgs": ["search"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "positionalArgs": ["query"],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install mcfly: cargo install mcfly"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search query for shell history" }
      ]
    },
    {
      "namespace": "mcfly",
      "resource": "history",
      "action": "dump",
      "description": "Dump all shell history entries",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcfly",
        "baseArgs": ["dump"],
        "missingDependencyHelp": "Install mcfly: cargo install mcfly"
      },
      "args": []
    },
    {
      "namespace": "mcfly",
      "resource": "history",
      "action": "train",
      "description": "Train mcfly on the current shell history",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcfly",
        "baseArgs": ["train", "--train-all"],
        "missingDependencyHelp": "Install mcfly: cargo install mcfly"
      },
      "args": []
    },
    {
      "namespace": "mcfly",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mcfly CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcfly",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "missingDependencyHelp": "Install mcfly: cargo install mcfly"
      },
      "args": []
    }
  ]
}
