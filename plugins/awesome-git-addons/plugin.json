{
  "name": "awesome-git-addons",
  "version": "0.1.0",
  "description": "Addons that extend git cli",
  "source": "https://github.com/stevemao/awesome-git-addons#readme",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-git-addons"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-git-addons",
    "binary": "awesome-git-addons",
    "check": "which awesome-git-addons",
    "install_steps": [
      "See https://github.com/stevemao/awesome-git-addons#readme",
      "Verify: awesome-git-addons --version",
      "supercli plugins install ./plugins/awesome-git-addons --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "awesome-git-addons",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-git-addons version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-git-addons",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-git-addons: See https://github.com/stevemao/awesome-git-addons#readme"
      },
      "args": []
    },
    {
      "namespace": "awesome-git-addons",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-git-addons CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-git-addons",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-git-addons"
      },
      "args": []
    }
  ]
}