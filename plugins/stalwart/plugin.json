{
  "name": "stalwart",
  "version": "0.1.0",
  "description": "All-in-one Mail & Collaboration server. Secure, scalable and fluent in every protocol (IMAP, JMAP, S",
  "source": "https://github.com/stalwart/stalwart",
  "checks": [
    {
      "type": "binary",
      "name": "stalwart"
    }
  ],
  "install_guidance": {
    "plugin": "stalwart",
    "binary": "stalwart",
    "check": "which stalwart",
    "install_steps": [
      "pip install stalwart",
      "Verify: stalwart --version",
      "supercli plugins install ./plugins/stalwart --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "stalwart",
      "resource": "self",
      "action": "version",
      "description": "Print stalwart version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stalwart",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install stalwart: pip install stalwart"
      },
      "args": []
    },
    {
      "namespace": "stalwart",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stalwart CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stalwart",
        "passthrough": true,
        "missingDependencyHelp": "Install stalwart: pip install stalwart"
      },
      "args": []
    }
  ]
}