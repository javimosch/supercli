{
  "name": "open-interpreter",
  "version": "0.1.0",
  "description": "Natural language interface for computers",
  "source": "https://github.com/OpenInterpreter/open-interpreter",
  "checks": [{ "type": "binary", "name": "open-interpreter" }],
  "install_guidance": {
    "plugin": "open-interpreter",
    "binary": "open-interpreter",
    "check": "which open-interpreter",
    "install_steps": ["pip install open-interpreter", "Verify: open-interpreter --version", "supercli plugins install ./plugins/open-interpreter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "open-interpreter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to open-interpreter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "open-interpreter",
      "passthrough": true,
      "missingDependencyHelp": "Install open-interpreter: pip install open-interpreter", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
