{
  "name": "json2ts",
  "version": "0.1.0",
  "description": "Compile JSONSchema to TypeScript type declarations",
  "source": "https://github.com/bcherny/json-schema-to-typescript",
  "checks": [
    {
      "type": "binary",
      "name": "json2ts"
    }
  ],
  "install_guidance": {
    "plugin": "json2ts",
    "binary": "json2ts",
    "check": "which json2ts",
    "install_steps": [
      "brew install json2ts",
      "Verify: json2ts --version",
      "supercli plugins install ./plugins/json2ts --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "json2ts",
      "resource": "self",
      "action": "version",
      "description": "Print json2ts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "json2ts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install json2ts: brew install json2ts"
      },
      "args": []
    },
    {
      "namespace": "json2ts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to json2ts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "json2ts",
        "passthrough": true,
        "missingDependencyHelp": "Install json2ts"
      },
      "args": []
    }
  ]
}