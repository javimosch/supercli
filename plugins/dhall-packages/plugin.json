{
  "name": "dhall-packages",
  "version": "0.1.0",
  "description": "CLI tool: dhall-packages",
  "source": "https://packages.debian.org/dhall-packages",
  "checks": [{ "type": "binary", "name": "dhall-packages" }],
  "install_guidance": {
    "plugin": "dhall-packages", "binary": "dhall-packages", "check": "which dhall-packages",
    "install_steps": ["apt-get install dhall-packages 2>/dev/null || which dhall-packages", "Verify: dhall-packages --version", "supercli plugins install ./plugins/dhall-packages --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-packages", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-packages CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-packages", "passthrough": true, "missingDependencyHelp": "Install dhall-packages: apt-get install dhall-packages" }, "args": []
  }]
}
