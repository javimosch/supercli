{
  "name": "lcount",
  "version": "0.1.0",
  "description": "Fast line counting alternative for text processing",
  "source": "https://github.com/kbknapp/lcount",
  "checks": [{ "type": "binary", "name": "lcount" }],
  "install_guidance": {
    "plugin": "lcount",
    "binary": "lcount",
    "check": "which lcount",
    "install_steps": ["cargo install lcount", "Verify: lcount --version", "supercli plugins install ./plugins/lcount --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lcount",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lcount CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lcount",
      "passthrough": true,
      "missingDependencyHelp": "Install lcount: cargo install lcount", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
