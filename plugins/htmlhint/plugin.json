{
  "name": "htmlhint",
  "version": "0.1.0",
  "description": "HTML linter with configurable rules",
  "source": "https://github.com/htmlhint/HTMLHint",
  "checks": [
    {
      "type": "binary",
      "name": "htmlhint"
    }
  ],
  "install_guidance": {
    "plugin": "htmlhint",
    "binary": "htmlhint",
    "check": "which htmlhint",
    "install_steps": [
      "npm install -g htmlhint",
      "Verify: htmlhint --version",
      "supercli plugins install ./plugins/htmlhint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "htmlhint",
      "resource": "self",
      "action": "version",
      "description": "Print htmlhint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "htmlhint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install htmlhint: npm install -g htmlhint"
      },
      "args": []
    },
    {
      "namespace": "htmlhint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to htmlhint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "htmlhint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install htmlhint: npm install -g htmlhint"
      },
      "args": []
    }
  ]
}
