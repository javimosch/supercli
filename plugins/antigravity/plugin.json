{
  "name": "antigravity",
  "version": "0.1.0",
  "description": "CLI tool: antigravity",
  "source": "https://packages.debian.org/antigravity",
  "checks": [{ "type": "binary", "name": "antigravity" }],
  "install_guidance": {
    "plugin": "antigravity", "binary": "antigravity", "check": "which antigravity",
    "install_steps": ["apt-get install antigravity 2>/dev/null || which antigravity", "Verify: antigravity --version", "supercli plugins install ./plugins/antigravity --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "antigravity", "resource": "_", "action": "_",
    "description": "Passthrough to antigravity CLI",
    "adapter": "process", "adapterConfig": { "command": "antigravity", "passthrough": true, "missingDependencyHelp": "Install antigravity: apt-get install antigravity" }, "args": []
  }]
}
