{
  "name": "gobject-introspection",
  "version": "0.1.0",
  "description": "Generate introspection data for GObject libraries",
  "checks": [
    {
      "type": "binary",
      "name": "gobject-introspection"
    }
  ],
  "install_guidance": {
    "plugin": "gobject-introspection",
    "binary": "gobject-introspection",
    "check": "which gobject-introspection",
    "install_steps": [
      "brew install gobject-introspection",
      "Verify: gobject-introspection --version",
      "supercli plugins install ./plugins/gobject-introspection --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gobject-introspection",
      "resource": "self",
      "action": "version",
      "description": "Print gobject-introspection version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gobject-introspection",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gobject-introspection: brew install gobject-introspection"
      },
      "args": []
    },
    {
      "namespace": "gobject-introspection",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gobject-introspection CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gobject-introspection",
        "passthrough": true,
        "missingDependencyHelp": "Install gobject-introspection"
      },
      "args": []
    }
  ]
}