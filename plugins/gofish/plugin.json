{
  "name": "gofish",
  "version": "0.1.0",
  "description": "Cross-platform package manager for the command line",
  "source": "https://github.com/fishworks/gofish",
  "checks": [{ "type": "binary", "name": "gofish" }],
  "install_guidance": {
    "plugin": "gofish",
    "binary": "gofish",
    "check": "which gofish",
    "install_steps": ["brew install gofish", "Verify: gofish --version", "supercli plugins install ./plugins/gofish --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gofish",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gofish CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gofish",
      "passthrough": true,
      "missingDependencyHelp": "Install gofish: brew install gofish", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
