{
  "name": "perlthanks",
  "version": "0.1.0",
  "description": "CLI tool: perlthanks",
  "source": "https://manpages.debian.org/perlthanks",
  "checks": [
    {
      "type": "binary",
      "name": "perlthanks"
    }
  ],
  "install_guidance": {
    "plugin": "perlthanks",
    "binary": "perlthanks",
    "check": "which perlthanks",
    "install_steps": [
      "apt-get install perlthanks 2>/dev/null || which perlthanks",
      "Verify: perlthanks --version",
      "supercli plugins install ./plugins/perlthanks --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "perlthanks",
      "resource": "self",
      "action": "version",
      "description": "Print perlthanks version",
      "adapter": "process",
      "adapterConfig": {
        "command": "perlthanks",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install perlthanks: apt-get install perlthanks 2>/dev/null || which perlthanks"
      },
      "args": []
    },
    {
      "namespace": "perlthanks",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to perlthanks CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "perlthanks",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install perlthanks: apt-get install perlthanks 2>/dev/null || which perlthanks"
      },
      "args": []
    }
  ]
}