{
  "name": "cgasm",
  "version": "0.1.0",
  "description": "x86 assembly documentation",
  "source": "https://github.com/bnagy/cgasm",
  "checks": [
    {
      "type": "binary",
      "name": "cgasm"
    }
  ],
  "install_guidance": {
    "plugin": "cgasm",
    "binary": "cgasm",
    "check": "which cgasm",
    "install_steps": [
      "See https://github.com/bnagy/cgasm",
      "Verify: cgasm --version",
      "supercli plugins install ./plugins/cgasm --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "cgasm",
      "resource": "self",
      "action": "version",
      "description": "Print cgasm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cgasm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cgasm: See https://github.com/bnagy/cgasm"
      },
      "args": []
    },
    {
      "namespace": "cgasm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cgasm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cgasm",
        "passthrough": true,
        "missingDependencyHelp": "Install cgasm"
      },
      "args": []
    }
  ]
}