{
  "name": "afio",
  "version": "0.1.0",
  "description": "Creates cpio-format archives",
  "source": "https://github.com/kholtman/afio",
  "checks": [
    {
      "type": "binary",
      "name": "afio"
    }
  ],
  "install_guidance": {
    "plugin": "afio",
    "binary": "afio",
    "check": "which afio",
    "install_steps": [
      "brew install afio",
      "Verify: afio --version",
      "supercli plugins install ./plugins/afio --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "afio",
      "resource": "self",
      "action": "version",
      "description": "Print afio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "afio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install afio: brew install afio"
      },
      "args": []
    },
    {
      "namespace": "afio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to afio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "afio",
        "passthrough": true,
        "missingDependencyHelp": "Install afio"
      },
      "args": []
    }
  ]
}