{
  "name": "ipget",
  "version": "0.1.0",
  "description": "Retrieve files over IPFS and save them locally",
  "source": "https://github.com/ipfs/ipget/",
  "checks": [
    {
      "type": "binary",
      "name": "ipget"
    }
  ],
  "install_guidance": {
    "plugin": "ipget",
    "binary": "ipget",
    "check": "which ipget",
    "install_steps": [
      "brew install ipget",
      "Verify: ipget --version",
      "supercli plugins install ./plugins/ipget --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ipget",
      "resource": "self",
      "action": "version",
      "description": "Print ipget version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipget",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipget: brew install ipget"
      },
      "args": []
    },
    {
      "namespace": "ipget",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipget CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipget",
        "passthrough": true,
        "missingDependencyHelp": "Install ipget"
      },
      "args": []
    }
  ]
}