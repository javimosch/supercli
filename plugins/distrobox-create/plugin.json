{
  "name": "distrobox-create",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-create",
  "source": "https://packages.debian.org/distrobox-create",
  "checks": [{ "type": "binary", "name": "distrobox-create" }],
  "install_guidance": {
    "plugin": "distrobox-create", "binary": "distrobox-create", "check": "which distrobox-create",
    "install_steps": ["apt-get install distrobox-create 2>/dev/null || which distrobox-create", "Verify: distrobox-create --version", "supercli plugins install ./plugins/distrobox-create --on-conflict replace --json"]
