{
  "name": "friendly-find",
  "version": "0.1.0",
  "description": "Usable replacement for find.",
  "source": "https://github.com/sjl/friendly-find",
  "checks": [
    {
      "type": "binary",
      "name": "friendly-find"
    }
  ],
  "install_guidance": {
    "plugin": "friendly-find",
    "binary": "friendly-find",
    "check": "which friendly-find",
    "install_steps": [
      "brew install friendly-find",
      "Verify: friendly-find --version",
      "supercli plugins install ./plugins/friendly-find --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "friendly-find",
      "resource": "self",
      "action": "version",
      "description": "Print friendly-find version",
      "adapter": "process",
      "adapterConfig": {
        "command": "friendly-find",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install friendly-find: brew install friendly-find"
      },
      "args": []
    },
    {
      "namespace": "friendly-find",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to friendly-find CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "friendly-find",
        "passthrough": true,
        "missingDependencyHelp": "Install friendly-find"
      },
      "args": []
    }
  ]
}