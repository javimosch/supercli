{
  "name": "agents",
  "version": "0.1.0",
  "description": "Multi-harness agentic plugin marketplace for Claude Code, Codex CLI, Cursor, OpenCode, and Gemini CL",
  "source": "https://github.com/agents/agents",
  "checks": [
    {
      "type": "binary",
      "name": "agents"
    }
  ],
  "install_guidance": {
    "plugin": "agents",
    "binary": "agents",
    "check": "which agents",
    "install_steps": [
      "pip install agents",
      "Verify: agents --version",
      "supercli plugins install ./plugins/agents --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agents",
      "resource": "self",
      "action": "version",
      "description": "Print agents version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agents",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agents: pip install agents"
      },
      "args": []
    },
    {
      "namespace": "agents",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agents CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agents",
        "passthrough": true,
        "missingDependencyHelp": "Install agents: pip install agents"
      },
      "args": []
    }
  ]
}