{
  "name": "DroidDesk",
  "version": "0.1.0",
  "description": "DroidDesk turns your Android phone into a real Linux desktop using Termux, Termux X11, TUR, and Proo",
  "source": "https://github.com/DroidDesk/DroidDesk",
  "checks": [
    {
      "type": "binary",
      "name": "droiddesk"
    }
  ],
  "install_guidance": {
    "plugin": "DroidDesk",
    "binary": "droiddesk",
    "check": "which droiddesk",
    "install_steps": [
      "pip install droiddesk",
      "Verify: droiddesk --version",
      "supercli plugins install ./plugins/DroidDesk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DroidDesk",
      "resource": "self",
      "action": "version",
      "description": "Print DroidDesk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "droiddesk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DroidDesk: pip install droiddesk"
      },
      "args": []
    },
    {
      "namespace": "DroidDesk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to droiddesk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "droiddesk",
        "passthrough": true,
        "missingDependencyHelp": "Install DroidDesk: pip install droiddesk"
      },
      "args": []
    }
  ]
}