{
  "name": "distrobox-export",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-export",
  "source": "https://packages.debian.org/distrobox-export",
  "checks": [{ "type": "binary", "name": "distrobox-export" }],
  "install_guidance": {
    "plugin": "distrobox-export", "binary": "distrobox-export", "check": "which distrobox-export",
    "install_steps": ["apt-get install distrobox-export 2>/dev/null || which distrobox-export", "Verify: distrobox-export --version", "supercli plugins install ./plugins/distrobox-export --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distrobox-export", "resource": "_", "action": "_",
    "description": "Passthrough to distrobox-export CLI",
    "adapter": "process", "adapterConfig": { "command": "distrobox-export", "passthrough": true, "missingDependencyHelp": "Install distrobox-export: apt-get install distrobox-export" }, "args": []
  }]
}
