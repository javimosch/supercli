{
  "name": "Color-manager",
  "version": "0.1.0",
  "description": "Extract and save image color palettes from the command line",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "Color-manager" }],
  "install_guidance": {
    "plugin": "Color-manager",
    "binary": "Color-manager",
    "check": "which Color-manager",
    "install_steps": ["git clone && pip install -r requirements.txt", "Verify: Color-manager --version", "supercli plugins install ./plugins/Color-manager --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "Color-manager",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to Color-manager CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "Color-manager",
      "passthrough": true,
      "missingDependencyHelp": "Install Color-manager: git clone && pip install -r requirements.txt"
    },
    "args": []
  }]
}
