{
  "name": "storm",
  "version": "0.1.0",
  "description": "An LLM-powered knowledge curation system that researches a topic and generates a full-length report ",
  "source": "https://github.com/storm/storm",
  "checks": [
    {
      "type": "binary",
      "name": "storm"
    }
  ],
  "install_guidance": {
    "plugin": "storm",
    "binary": "storm",
    "check": "which storm",
    "install_steps": [
      "pip install storm",
      "Verify: storm --version",
      "supercli plugins install ./plugins/storm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "storm",
      "resource": "self",
      "action": "version",
      "description": "Print storm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "storm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install storm: pip install storm"
      },
      "args": []
    },
    {
      "namespace": "storm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to storm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "storm",
        "passthrough": true,
        "missingDependencyHelp": "Install storm: pip install storm"
      },
      "args": []
    }
  ]
}