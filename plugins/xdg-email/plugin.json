{
  "name": "xdg-email",
  "version": "0.1.0",
  "description": "CLI tool: xdg-email",
  "source": "https://manpages.debian.org/xdg-email",
  "checks": [
    {
      "type": "binary",
      "name": "xdg-email"
    }
  ],
  "install_guidance": {
    "plugin": "xdg-email",
    "binary": "xdg-email",
    "check": "which xdg-email",
    "install_steps": [
      "apt-get install xdg-email 2>/dev/null || which xdg-email",
      "Verify: xdg-email --version",
      "supercli plugins install ./plugins/xdg-email --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xdg-email",
      "resource": "self",
      "action": "version",
      "description": "Print xdg-email version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdg-email",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xdg-email: apt-get install xdg-email 2>/dev/null || which xdg-email"
      },
      "args": []
    },
    {
      "namespace": "xdg-email",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xdg-email CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdg-email",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xdg-email: apt-get install xdg-email 2>/dev/null || which xdg-email"
      },
      "args": []
    }
  ]
}