{
  "name": "qmlscene",
  "version": "0.1.0",
  "description": "CLI tool: qmlscene",
  "source": "https://manpages.debian.org/qmlscene",
  "checks": [
    {
      "type": "binary",
      "name": "qmlscene"
    }
  ],
  "install_guidance": {
    "plugin": "qmlscene",
    "binary": "qmlscene",
    "check": "which qmlscene",
    "install_steps": [
      "apt-get install qmlscene 2>/dev/null || which qmlscene",
      "Verify: qmlscene --version",
      "supercli plugins install ./plugins/qmlscene --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmlscene",
      "resource": "self",
      "action": "version",
      "description": "Print qmlscene version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlscene",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmlscene: apt-get install qmlscene 2>/dev/null || which qmlscene"
      },
      "args": []
    },
    {
      "namespace": "qmlscene",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmlscene CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlscene",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmlscene: apt-get install qmlscene 2>/dev/null || which qmlscene"
      },
      "args": []
    }
  ]
}