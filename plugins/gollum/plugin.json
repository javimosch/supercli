{
  "name": "gollum",
  "version": "1.0.0",
  "description": "gollum \u2014 Git wiki",
  "source": "github.com/gollum/gollum",
  "checks": [
    {
      "type": "binary",
      "name": "gollum"
    }
  ],
  "install_guidance": {
    "plugin": "gollum",
    "binary": "gollum",
    "check": "which gollum",
    "install_steps": [
      "# Install gollum",
      "# See github.com/gollum/gollum",
      "# apt: sudo apt-get install gollum",
      "# brew: brew install gollum",
      "# cargo: cargo install gollum",
      "# npm: npm install -g gollum",
      "# pip: pip install gollum"
    ]
  },
  "commands": [
    {
      "namespace": "gollum",
      "resource": "gollum",
      "action": "run",
      "description": "Run gollum",
      "adapter": "process",
      "adapterConfig": {
        "command": "gollum",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gollum from github.com/gollum/gollum"
      },
      "args": []
    }
  ]
}