{
  "name": "cdt",
  "version": "0.1.0",
  "description": "CLI tool: cdt",
  "source": "https://packages.debian.org/cdt",
  "checks": [{ "type": "binary", "name": "cdt" }],
  "install_guidance": {
    "plugin": "cdt", "binary": "cdt", "check": "which cdt",
    "install_steps": ["apt-get install cdt 2>/dev/null || which cdt", "Verify: cdt --version", "supercli plugins install ./plugins/cdt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cdt", "resource": "_", "action": "_",
    "description": "Passthrough to cdt CLI",
    "adapter": "process", "adapterConfig": { "command": "cdt", "passthrough": true, "missingDependencyHelp": "Install cdt: apt-get install cdt" }, "args": []
  }]
}
