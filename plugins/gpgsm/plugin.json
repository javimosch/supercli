{
  "name": "gpgsm",
  "version": "0.1.0",
  "description": "S/MIME and X.509 cryptographic agent",
  "source": "https://packages.debian.org/gpgsm",
  "checks": [{ "type": "binary", "name": "gpgsm" }],
  "install_guidance": {
    "plugin": "gpgsm", "binary": "gpgsm", "check": "which gpgsm",
    "install_steps": ["apt-get install gpgsm", "Verify: gpgsm --version", "supercli plugins install ./plugins/gpgsm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gpgsm", "resource": "_", "action": "_",
    "description": "Passthrough to gpgsm CLI",
    "adapter": "process", "adapterConfig": { "command": "gpgsm", "passthrough": true, "missingDependencyHelp": "Install gpgsm: apt-get install gpgsm" }, "args": []
  }]
}
