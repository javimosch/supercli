{
  "name": "certificate-ripper",
  "version": "0.1.0",
  "description": "Tool to extract server certificates",
  "source": "https://github.com/Hakky54/certificate-ripper",
  "checks": [
    {
      "type": "binary",
      "name": "certificate-ripper"
    }
  ],
  "install_guidance": {
    "plugin": "certificate-ripper",
    "binary": "certificate-ripper",
    "check": "which certificate-ripper",
    "install_steps": [
      "brew install certificate-ripper",
      "Verify: certificate-ripper --version",
      "supercli plugins install ./plugins/certificate-ripper --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "certificate-ripper",
      "resource": "self",
      "action": "version",
      "description": "Print certificate-ripper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "certificate-ripper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install certificate-ripper: brew install certificate-ripper"
      },
      "args": []
    },
    {
      "namespace": "certificate-ripper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to certificate-ripper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "certificate-ripper",
        "passthrough": true,
        "missingDependencyHelp": "Install certificate-ripper"
      },
      "args": []
    }
  ]
}