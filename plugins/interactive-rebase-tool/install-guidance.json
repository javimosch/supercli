{
  "plugin": "interactive-rebase-tool",
  "binary": "interactive-rebase-tool",
  "check": "which interactive-rebase-tool",
  "install_steps": [
    "# Install interactive-rebase-tool",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/interactive-rebase-tool-linux-amd64 -o /usr/local/bin/interactive-rebase-tool",
    "chmod +x /usr/local/bin/interactive-rebase-tool",
    "# Or via package manager, see github.com/MitMaro/git-interactive-rebase-tool"
  ]
}