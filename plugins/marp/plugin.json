{
  "name": "marp",
  "version": "0.1.0",
  "description": "Easily convert Marp Markdown files into static HTML/CSS, PDF, PPT and images",
  "source": "https://github.com/marp-team/marp-cli",
  "checks": [
    {
      "type": "binary",
      "name": "marp"
    }
  ],
  "install_guidance": {
    "plugin": "marp",
    "binary": "marp",
    "check": "which marp",
    "install_steps": [
      "brew install marp",
      "Verify: marp --version",
      "supercli plugins install ./plugins/marp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "marp",
      "resource": "self",
      "action": "version",
      "description": "Print marp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "marp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install marp: brew install marp"
      },
      "args": []
    },
    {
      "namespace": "marp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to marp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "marp",
        "passthrough": true,
        "missingDependencyHelp": "Install marp"
      },
      "args": []
    }
  ]
}