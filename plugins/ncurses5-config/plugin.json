{
  "name": "ncurses5-config",
  "version": "0.1.0",
  "description": "CLI tool: ncurses5-config",
  "source": "https://manpages.debian.org/ncurses5-config",
  "checks": [
    {
      "type": "binary",
      "name": "ncurses5-config"
    }
  ],
  "install_guidance": {
    "plugin": "ncurses5-config",
    "binary": "ncurses5-config",
    "check": "which ncurses5-config",
    "install_steps": [
      "apt-get install ncurses5-config 2>/dev/null || which ncurses5-config",
      "Verify: ncurses5-config --version",
      "supercli plugins install ./plugins/ncurses5-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ncurses5-config",
      "resource": "self",
      "action": "version",
      "description": "Print ncurses5-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncurses5-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ncurses5-config: apt-get install ncurses5-config 2>/dev/null || which ncurses5-config"
      },
      "args": []
    },
    {
      "namespace": "ncurses5-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ncurses5-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncurses5-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ncurses5-config: apt-get install ncurses5-config 2>/dev/null || which ncurses5-config"
      },
      "args": []
    }
  ]
}