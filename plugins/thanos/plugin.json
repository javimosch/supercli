{
  "name": "thanos",
  "version": "0.1.0",
  "description": "Highly available Prometheus setup with long term storage",
  "source": "https://github.com/thanos-io/thanos",
  "checks": [{ "type": "binary", "name": "thanos" }],
  "install_guidance": {
    "plugin": "thanos",
    "binary": "thanos",
    "check": "which thanos",
    "install_steps": ["brew install thanos", "Verify: thanos --version", "supercli plugins install ./plugins/thanos --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "thanos",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to thanos CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "thanos",
      "passthrough": true,
      "missingDependencyHelp": "Install thanos: brew install thanos"
    },
    "args": []
  }]
}
