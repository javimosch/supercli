{
  "name": "vimail",
  "version": "0.1.0",
  "description": "Terminal email client with Vim-style keybindings written in Go",
  "source": "go",
  "checks": [{ "type": "binary", "name": "vimail" }],
  "install_guidance": {
    "plugin": "vimail",
    "binary": "vimail",
    "check": "which vimail",
    "install_steps": ["go install github.com/gausejakub/vimail@latest", "Verify: vimail --version", "supercli plugins install ./plugins/vimail --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vimail",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vimail CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vimail",
      "passthrough": true,
      "missingDependencyHelp": "Install vimail: go install github.com/gausejakub/vimail@latest"
    },
    "args": []
  }]
}
