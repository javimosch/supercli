{
  "name": "ali",
  "version": "0.1.0",
  "description": "Load testing tool capable of performing real-time analysis",
  "source": "https://github.com/nakabonne/ali",
  "checks": [{ "type": "binary", "name": "ali" }],
  "install_guidance": {
    "plugin": "ali",
    "binary": "ali",
    "check": "which ali",
    "install_steps": ["go install github.com/nakabonne/ali@latest", "Verify: ali --version", "supercli plugins install ./plugins/ali --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ali",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ali CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ali",
      "passthrough": true,
      "missingDependencyHelp": "Install ali: go install github.com/nakabonne/ali@latest"
    },
    "args": []
  }]
}
