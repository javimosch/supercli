{
  "name": "OpenSplat",
  "version": "0.1.0",
  "description": "Production-grade 3D gaussian splatting with CPU/GPU support for Windows, Mac and Linux \ud83d\ude80",
  "source": "https://github.com/OpenSplat/OpenSplat",
  "checks": [
    {
      "type": "binary",
      "name": "opensplat"
    }
  ],
  "install_guidance": {
    "plugin": "OpenSplat",
    "binary": "opensplat",
    "check": "which opensplat",
    "install_steps": [
      "pip install opensplat",
      "Verify: opensplat --version",
      "supercli plugins install ./plugins/OpenSplat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenSplat",
      "resource": "self",
      "action": "version",
      "description": "Print OpenSplat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "opensplat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenSplat: pip install opensplat"
      },
      "args": []
    },
    {
      "namespace": "OpenSplat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to opensplat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "opensplat",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenSplat: pip install opensplat"
      },
      "args": []
    }
  ]
}