{
  "name": "gitql",
  "version": "0.1.0",
  "description": "Git query language",
  "source": "https://github.com/filhodanuvem/gitql",
  "checks": [
    {
      "type": "binary",
      "name": "gitql"
    }
  ],
  "install_guidance": {
    "plugin": "gitql",
    "binary": "gitql",
    "check": "which gitql",
    "install_steps": [
      "brew install gitql",
      "Verify: gitql --version",
      "supercli plugins install ./plugins/gitql --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitql",
      "resource": "self",
      "action": "version",
      "description": "Print gitql version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitql",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitql: brew install gitql"
      },
      "args": []
    },
    {
      "namespace": "gitql",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitql CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitql",
        "passthrough": true,
        "missingDependencyHelp": "Install gitql"
      },
      "args": []
    }
  ]
}