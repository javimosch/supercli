{
  "name": "breeze-shell",
  "version": "0.1.0",
  "description": "An alternative Windows context menu, and more.",
  "source": "https://github.com/breeze-shell/breeze-shell",
  "checks": [
    {
      "type": "binary",
      "name": "breeze-shell"
    }
  ],
  "install_guidance": {
    "plugin": "breeze-shell",
    "binary": "breeze-shell",
    "check": "which breeze-shell",
    "install_steps": [
      "pip install breeze-shell",
      "Verify: breeze-shell --version",
      "supercli plugins install ./plugins/breeze-shell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "breeze-shell",
      "resource": "self",
      "action": "version",
      "description": "Print breeze-shell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "breeze-shell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install breeze-shell: pip install breeze-shell"
      },
      "args": []
    },
    {
      "namespace": "breeze-shell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to breeze-shell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "breeze-shell",
        "passthrough": true,
        "missingDependencyHelp": "Install breeze-shell: pip install breeze-shell"
      },
      "args": []
    }
  ]
}