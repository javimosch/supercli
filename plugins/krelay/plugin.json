{
  "name": "krelay",
  "version": "0.1.0",
  "description": "Kubernetes relay for exposing services to localhost",
  "source": "https://github.com/knight42/krelay",
  "checks": [{ "type": "binary", "name": "krelay" }],
  "install_guidance": {
    "plugin": "krelay",
    "binary": "krelay",
    "check": "which krelay",
    "install_steps": ["brew install krelay", "Verify: krelay --version", "supercli plugins install ./plugins/krelay --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "krelay",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to krelay CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "krelay",
      "passthrough": true,
      "missingDependencyHelp": "Install krelay: brew install krelay"
    },
    "args": []
  }]
}
