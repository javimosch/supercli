{
  "name": "langchat",
  "version": "0.1.0",
  "description": "LangChat: Java LLMs/AI Project, Supports Multi AI Providers( Gitee AI/ \u667a\u8c31\u6e05\u8a00 / \u963f\u91cc\u901a\u4e49 / \u767e\u5ea6\u5343\u5e06 / DeepSeek",
  "source": "https://github.com/langchat/langchat",
  "checks": [
    {
      "type": "binary",
      "name": "langchat"
    }
  ],
  "install_guidance": {
    "plugin": "langchat",
    "binary": "langchat",
    "check": "which langchat",
    "install_steps": [
      "pip install langchat",
      "Verify: langchat --version",
      "supercli plugins install ./plugins/langchat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "langchat",
      "resource": "self",
      "action": "version",
      "description": "Print langchat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "langchat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install langchat: pip install langchat"
      },
      "args": []
    },
    {
      "namespace": "langchat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to langchat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "langchat",
        "passthrough": true,
        "missingDependencyHelp": "Install langchat: pip install langchat"
      },
      "args": []
    }
  ]
}