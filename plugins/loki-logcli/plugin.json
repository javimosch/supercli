{
  "name": "loki-logcli",
  "version": "0.1.0",
  "description": "Command line tool for querying Grafana Loki log aggregation",
  "source": "https://github.com/grafana/loki",
  "checks": [{ "type": "binary", "name": "logcli" }],
  "install_guidance": {
    "plugin": "loki-logcli",
    "binary": "logcli",
    "check": "which logcli",
    "install_steps": ["brew install loki-logcli", "Verify: logcli --version", "supercli plugins install ./plugins/loki-logcli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "loki-logcli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to logcli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "logcli",
      "passthrough": true,
      "missingDependencyHelp": "Install loki-logcli: brew install loki-logcli"
    },
    "args": []
  }]
}
