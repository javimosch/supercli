{
  "name": "kubergrunt",
  "version": "0.1.0",
  "description": "Collection of tools for Kubernetes cluster management",
  "source": "https://github.com/gruntwork-io/kubergrunt",
  "checks": [{ "type": "binary", "name": "kubergrunt" }],
  "install_guidance": {
    "plugin": "kubergrunt",
    "binary": "kubergrunt",
    "check": "which kubergrunt",
    "install_steps": ["brew install kubergrunt", "Verify: kubergrunt --version", "supercli plugins install ./plugins/kubergrunt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubergrunt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubergrunt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubergrunt",
      "passthrough": true,
      "missingDependencyHelp": "Install kubergrunt: brew install kubergrunt"
    },
    "args": []
  }]
}
