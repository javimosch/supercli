{
  "name": "wttr.in",
  "version": "0.1.0",
  "description": "Weather",
  "source": "https://github.com/chubin/wttr.in",
  "checks": [
    {
      "type": "binary",
      "name": "wttr.in"
    }
  ],
  "install_guidance": {
    "plugin": "wttr.in",
    "binary": "wttr.in",
    "check": "which wttr.in",
    "install_steps": [
      "See https://github.com/chubin/wttr.in",
      "Verify: wttr.in --version",
      "supercli plugins install ./plugins/wttr.in --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "wttr.in",
      "resource": "self",
      "action": "version",
      "description": "Print wttr.in version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wttr.in",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wttr.in: See https://github.com/chubin/wttr.in"
      },
      "args": []
    },
    {
      "namespace": "wttr.in",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wttr.in CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wttr.in",
        "passthrough": true,
        "missingDependencyHelp": "Install wttr.in"
      },
      "args": []
    }
  ]
}