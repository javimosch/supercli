{
  "name": "sidekick",
  "version": "0.1.0",
  "description": "Bare metal to production ready in mins; your own fly server on your VPS.",
  "source": "https://github.com/sidekick/sidekick",
  "checks": [
    {
      "type": "binary",
      "name": "sidekick"
    }
  ],
  "install_guidance": {
    "plugin": "sidekick",
    "binary": "sidekick",
    "check": "which sidekick",
    "install_steps": [
      "pip install sidekick",
      "Verify: sidekick --version",
      "supercli plugins install ./plugins/sidekick --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sidekick",
      "resource": "self",
      "action": "version",
      "description": "Print sidekick version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sidekick",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sidekick: pip install sidekick"
      },
      "args": []
    },
    {
      "namespace": "sidekick",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sidekick CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sidekick",
        "passthrough": true,
        "missingDependencyHelp": "Install sidekick: pip install sidekick"
      },
      "args": []
    }
  ]
}