{
  "name": "NagramX",
  "version": "0.1.0",
  "description": "A variant of Nagram with additional features.",
  "source": "https://github.com/NagramX/NagramX",
  "checks": [
    {
      "type": "binary",
      "name": "nagramx"
    }
  ],
  "install_guidance": {
    "plugin": "NagramX",
    "binary": "nagramx",
    "check": "which nagramx",
    "install_steps": [
      "pip install nagramx",
      "Verify: nagramx --version",
      "supercli plugins install ./plugins/NagramX --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NagramX",
      "resource": "self",
      "action": "version",
      "description": "Print NagramX version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nagramx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NagramX: pip install nagramx"
      },
      "args": []
    },
    {
      "namespace": "NagramX",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nagramx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nagramx",
        "passthrough": true,
        "missingDependencyHelp": "Install NagramX: pip install nagramx"
      },
      "args": []
    }
  ]
}