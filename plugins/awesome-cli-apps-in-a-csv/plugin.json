{
  "name": "awesome-cli-apps-in-a-csv",
  "version": "0.1.0",
  "description": "Extensive list of CLI apps",
  "source": "https://github.com/toolleeo/awesome-cli-apps-in-a-csv",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-cli-apps-in-a-csv"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-cli-apps-in-a-csv",
    "binary": "awesome-cli-apps-in-a-csv",
    "check": "which awesome-cli-apps-in-a-csv",
    "install_steps": [
      "See https://github.com/toolleeo/awesome-cli-apps-in-a-csv",
      "Verify: awesome-cli-apps-in-a-csv --version",
      "supercli plugins install ./plugins/awesome-cli-apps-in-a-csv --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "awesome-cli-apps-in-a-csv",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-cli-apps-in-a-csv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-cli-apps-in-a-csv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-cli-apps-in-a-csv: See https://github.com/toolleeo/awesome-cli-apps-in-a-csv"
      },
      "args": []
    },
    {
      "namespace": "awesome-cli-apps-in-a-csv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-cli-apps-in-a-csv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-cli-apps-in-a-csv",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-cli-apps-in-a-csv"
      },
      "args": []
    }
  ]
}