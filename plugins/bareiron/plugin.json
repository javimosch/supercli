{
  "name": "bareiron",
  "version": "0.1.0",
  "description": "Minimalist Minecraft server for memory-restrictive embedded systems",
  "source": "https://github.com/bareiron/bareiron",
  "checks": [
    {
      "type": "binary",
      "name": "bareiron"
    }
  ],
  "install_guidance": {
    "plugin": "bareiron",
    "binary": "bareiron",
    "check": "which bareiron",
    "install_steps": [
      "pip install bareiron",
      "Verify: bareiron --version",
      "supercli plugins install ./plugins/bareiron --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bareiron",
      "resource": "self",
      "action": "version",
      "description": "Print bareiron version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bareiron",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bareiron: pip install bareiron"
      },
      "args": []
    },
    {
      "namespace": "bareiron",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bareiron CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bareiron",
        "passthrough": true,
        "missingDependencyHelp": "Install bareiron: pip install bareiron"
      },
      "args": []
    }
  ]
}