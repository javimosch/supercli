{
  "name": "cargo-clean",
  "version": "0.1.0",
  "description": "cargo-clean — remove Rust build artifacts to reclaim disk space",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-clean"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-clean",
    "binary": "cargo-clean",
    "check": "which cargo-clean",
    "install_steps": [
      "brew install rust",
      "supercli plugins install ./plugins/cargo-clean --on-conflict replace --json"
    ],
    "note": "Development tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo-clean",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-clean CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-clean",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-clean: brew install rust"
      },
      "args": []
    }
  ]
}
