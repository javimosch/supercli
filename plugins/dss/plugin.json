{
  "name": "dss",
  "version": "1.0.0",
  "description": "dss \u2014 DNS over HTTPS CLI",
  "source": "github.com/dss/dss",
  "checks": [
    {
      "type": "binary",
      "name": "dss"
    }
  ],
  "install_guidance": {
    "plugin": "dss",
    "binary": "dss",
    "check": "which dss",
    "install_steps": [
      "# Install dss",
      "# See github.com/dss/dss",
      "# apt: sudo apt-get install dss",
      "# brew: brew install dss",
      "# cargo: cargo install dss",
      "# npm: npm install -g dss",
      "# pip: pip install dss"
    ]
  },
  "commands": [
    {
      "namespace": "dss",
      "resource": "dss",
      "action": "run",
      "description": "Run dss",
      "adapter": "process",
      "adapterConfig": {
        "command": "dss",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dss from github.com/dss/dss"
      },
      "args": []
    }
  ]
}