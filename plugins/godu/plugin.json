{
  "name": "godu",
  "version": "1.0.0",
  "description": "godu \u2014 Disk usage analyzer",
  "source": "github.com/viktomas/godu",
  "checks": [
    {
      "type": "binary",
      "name": "godu"
    }
  ],
  "install_guidance": {
    "plugin": "godu",
    "binary": "godu",
    "check": "which godu",
    "install_steps": [
      "# Install godu:",
      "# apt: sudo apt-get install godu",
      "# brew: brew install godu",
      "# cargo: cargo install godu",
      "# npm: npm install -g godu",
      "# pip: pip install godu",
      "# or download from github.com/viktomas/godu"
    ]
  },
  "commands": [
    {
      "namespace": "godu",
      "resource": "godu",
      "action": "run",
      "description": "Run godu",
      "adapter": "process",
      "adapterConfig": {
        "command": "godu",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install godu from github.com/viktomas/godu"
      },
      "args": []
    }
  ]
}