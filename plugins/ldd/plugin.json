{
  "name": "ldd",
  "version": "1.0.0",
  "description": "ldd \u2014 ldd \u2014 CLI utility",
  "source": "/usr/bin/ldd",
  "checks": [
    {
      "type": "binary",
      "name": "ldd"
    }
  ],
  "install_guidance": {
    "plugin": "ldd",
    "binary": "ldd",
    "check": "which ldd",
    "install_steps": [
      "# Install ldd:",
      "# apt: sudo apt-get install ldd",
      "# brew: brew install ldd",
      "# cargo: cargo install ldd",
      "# npm: npm install -g ldd",
      "# pip: pip install ldd",
      "# or download from /usr/bin/ldd"
    ]
  },
  "commands": [
    {
      "namespace": "ldd",
      "resource": "ldd",
      "action": "run",
      "description": "Run ldd",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ldd from /usr/bin/ldd"
      },
      "args": []
    }
  ]
}