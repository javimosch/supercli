{
  "plugin": "ldd",
  "binary": "ldd",
  "check": "which ldd",
  "install_steps": [
    "# Install ldd",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ldd-linux-amd64 -o /usr/local/bin/ldd",
