{
  "name": "jsonfmt",
  "version": "0.1.0",
  "description": "Like gofmt, but for JSON files",
  "source": "https://github.com/caarlos0/jsonfmt",
  "checks": [
    {
      "type": "binary",
      "name": "jsonfmt"
    }
  ],
  "install_guidance": {
    "plugin": "jsonfmt",
    "binary": "jsonfmt",
    "check": "which jsonfmt",
    "install_steps": [
      "brew install jsonfmt",
      "Verify: jsonfmt --version",
      "supercli plugins install ./plugins/jsonfmt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jsonfmt",
      "resource": "self",
      "action": "version",
      "description": "Print jsonfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsonfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jsonfmt: brew install jsonfmt"
      },
      "args": []
    },
    {
      "namespace": "jsonfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jsonfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsonfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install jsonfmt"
      },
      "args": []
    }
  ]
}