{
  "name": "inih",
  "version": "0.1.0",
  "description": "Simple .INI file parser in C",
  "source": "https://github.com/benhoyt/inih",
  "checks": [
    {
      "type": "binary",
      "name": "inih"
    }
  ],
  "install_guidance": {
    "plugin": "inih",
    "binary": "inih",
    "check": "which inih",
    "install_steps": [
      "brew install inih",
      "Verify: inih --version",
      "supercli plugins install ./plugins/inih --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "inih",
      "resource": "self",
      "action": "version",
      "description": "Print inih version",
      "adapter": "process",
      "adapterConfig": {
        "command": "inih",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install inih: brew install inih"
      },
      "args": []
    },
    {
      "namespace": "inih",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to inih CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "inih",
        "passthrough": true,
        "missingDependencyHelp": "Install inih"
      },
      "args": []
    }
  ]
}