{
  "name": "what-url",
  "version": "0.1.0",
  "description": "Identify and classify URLs from command line",
  "source": "https://github.com/hackebrot/what-url",
  "checks": [{ "type": "binary", "name": "what-url" }],
  "install_guidance": {
    "plugin": "what-url",
    "binary": "what-url",
    "check": "which what-url",
    "install_steps": ["pip install what-url", "Verify: what-url --version", "supercli plugins install ./plugins/what-url --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "what-url",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to what-url CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "what-url",
      "passthrough": true,
      "missingDependencyHelp": "Install what-url: pip install what-url", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
