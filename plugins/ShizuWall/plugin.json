{
  "name": "ShizuWall",
  "version": "0.1.0",
  "description": "Lightweight, no vpn firewall solution for Android 11+",
  "source": "https://github.com/ShizuWall/ShizuWall",
  "checks": [
    {
      "type": "binary",
      "name": "shizuwall"
    }
  ],
  "install_guidance": {
    "plugin": "ShizuWall",
    "binary": "shizuwall",
    "check": "which shizuwall",
    "install_steps": [
      "pip install shizuwall",
      "Verify: shizuwall --version",
      "supercli plugins install ./plugins/ShizuWall --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ShizuWall",
      "resource": "self",
      "action": "version",
      "description": "Print ShizuWall version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shizuwall",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ShizuWall: pip install shizuwall"
      },
      "args": []
    },
    {
      "namespace": "ShizuWall",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shizuwall CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shizuwall",
        "passthrough": true,
        "missingDependencyHelp": "Install ShizuWall: pip install shizuwall"
      },
      "args": []
    }
  ]
}