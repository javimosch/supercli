{
  "plugin": "lsattr",
  "binary": "lsattr",
  "check": "which lsattr",
  "install_steps": [
    "# Install lsattr",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/lsattr-linux-amd64 -o /usr/local/bin/lsattr",
    "chmod +x /usr/local/bin/lsattr",
    "# Or via package manager, see /usr/bin/lsattr"
  ]
}