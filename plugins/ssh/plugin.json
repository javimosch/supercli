{
  "name": "ssh",
  "version": "0.1.0",
  "description": "OpenSSH client — secure shell for remote login and command execution",
  "source": "https",
  "checks": [{"type": "binary", "name": "ssh"}],
  "install_guidance": {
    "plugin": "ssh",
    "binary": "ssh",
    "check": "which ssh",
    "install_steps": [
      "apt-get install openssh-client",
      "Verify: ssh -V",
      "supercli plugins install ./plugins/ssh --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "ssh",
      "resource": "self",
      "action": "version",
      "description": "Show SSH version",
      "adapter": "process",
      "adapterConfig": {"command": "ssh", "baseArgs": ["-V"], "missingDependencyHelp": "Install ssh: apt-get install openssh-client"},
      "args": []
    },
    {
      "namespace": "ssh",
      "resource": "host",
      "action": "connect",
      "description": "Connect to remote host",
      "adapter": "process",
      "adapterConfig": {"command": "ssh", "missingDependencyHelp": "Install ssh: apt-get install openssh-client"},
      "args": [
        {"name": "user@host", "type": "string", "required": true, "description": "User and host (user@hostname)"},
        {"name": "--port", "type": "string", "required": false, "description": "SSH port (-p)"},
        {"name": "--identity", "type": "string", "required": false, "description": "Identity file (-i)"},
        {"name": "--verbose", "type": "boolean", "required": false, "description": "Verbose mode (-v)"}
      ]
    },
    {
      "namespace": "ssh",
      "resource": "host",
      "action": "command",
      "description": "Execute command on remote host",
      "adapter": "process",
      "adapterConfig": {"command": "ssh", "missingDependencyHelp": "Install ssh: apt-get install openssh-client"},
      "args": [
        {"name": "user@host", "type": "string", "required": true, "description": "User and host (user@hostname)"},
        {"name": "command", "type": "string", "required": true, "description": "Command to execute"},
        {"name": "--port", "type": "string", "required": false, "description": "SSH port (-p)"},
        {"name": "--identity", "type": "string", "required": false, "description": "Identity file (-i)"},
        {"name": "--tty", "type": "boolean", "required": false, "description": "Force pseudo-terminal allocation (-t)"}
      ]
    },
    {
      "namespace": "ssh",
      "resource": "tunnel",
      "action": "local-forward",
      "description": "Set up local port forwarding",
      "adapter": "process",
      "adapterConfig": {"command": "ssh", "missingDependencyHelp": "Install ssh: apt-get install openssh-client"},
      "args": [
        {"name": "user@host", "type": "string", "required": true, "description": "SSH destination"},
        {"name": "local-port", "type": "string", "required": true, "description": "Local port to forward from"},
        {"name": "remote-host", "type": "string", "required": true, "description": "Remote target host"},
        {"name": "remote-port", "type": "string", "required": true, "description": "Remote target port"},
        {"name": "--port", "type": "string", "required": false, "description": "SSH port (-p)"},
        {"name": "--identity", "type": "string", "required": false, "description": "Identity file (-i)"},
        {"name": "--background", "type": "boolean", "required": false, "description": "Run in background (-Nf)"}
      ]
    },
    {
      "namespace": "ssh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ssh CLI",
      "adapter": "process",
      "adapterConfig": {"command": "ssh", "passthrough": true, "missingDependencyHelp": "Install ssh: apt-get install openssh-client"},
      "args": []
    }
  ]
}
