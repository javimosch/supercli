{
  "name": "wren",
  "version": "0.1.0",
  "description": "wren - Advanced task management system",
  "source": "github.com/wren-cli/wren",
  "checks": [
    {
      "type": "binary",
      "name": "wren"
    }
  ],
  "install_guidance": {
    "plugin": "wren",
    "binary": "wren",
    "check": "which wren",
    "install_steps": [
      "pip install wren-cli"
    ]
  },
  "commands": [
    {
      "namespace": "wren",
      "resource": "task",
      "action": "run",
      "description": "Run advanced task management",
      "adapter": "process",
      "adapterConfig": {
        "command": "wren",
        "passthrough": true,
        "invoke_cwd": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install wren from github.com/wren-cli/wren"
      },
      "args": []
    }
  ]
}