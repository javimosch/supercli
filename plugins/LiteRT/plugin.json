{
  "name": "LiteRT",
  "version": "0.1.0",
  "description": "LiteRT, successor to TensorFlow Lite. is Google's On-device framework for high-performance ML & GenA",
  "source": "https://github.com/LiteRT/LiteRT",
  "checks": [
    {
      "type": "binary",
      "name": "litert"
    }
  ],
  "install_guidance": {
    "plugin": "LiteRT",
    "binary": "litert",
    "check": "which litert",
    "install_steps": [
      "pip install litert",
      "Verify: litert --version",
      "supercli plugins install ./plugins/LiteRT --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LiteRT",
      "resource": "self",
      "action": "version",
      "description": "Print LiteRT version",
      "adapter": "process",
      "adapterConfig": {
        "command": "litert",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LiteRT: pip install litert"
      },
      "args": []
    },
    {
      "namespace": "LiteRT",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to litert CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "litert",
        "passthrough": true,
        "missingDependencyHelp": "Install LiteRT: pip install litert"
      },
      "args": []
    }
  ]
}