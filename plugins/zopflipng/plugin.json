{
  "name": "zopflipng",
  "version": "0.1.0",
  "description": "Optimize PNG using Zopfli compression",
  "source": "https://github.com/google/zopfli",
  "checks": [{ "type": "binary", "name": "zopflipng" }],
  "install_guidance": {
    "plugin": "zopflipng",
    "binary": "zopflipng",
    "check": "which zopflipng",
    "install_steps": ["brew install zopfli", "Verify: zopflipng --version", "supercli plugins install ./plugins/zopflipng --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zopflipng",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zopflipng CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zopflipng",
      "passthrough": true,
      "missingDependencyHelp": "Install zopflipng: brew install zopfli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
