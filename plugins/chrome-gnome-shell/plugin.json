{
  "name": "chrome-gnome-shell",
  "version": "0.1.0",
  "description": "CLI tool: chrome-gnome-shell",
  "source": "https://packages.debian.org/chrome-gnome-shell",
  "checks": [{ "type": "binary", "name": "chrome-gnome-shell" }],
  "install_guidance": {
    "plugin": "chrome-gnome-shell", "binary": "chrome-gnome-shell", "check": "which chrome-gnome-shell",
    "install_steps": ["apt-get install chrome-gnome-shell 2>/dev/null || which chrome-gnome-shell", "Verify: chrome-gnome-shell --version", "supercli plugins install ./plugins/chrome-gnome-shell --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "chrome-gnome-shell", "resource": "_", "action": "_",
    "description": "Passthrough to chrome-gnome-shell CLI",
    "adapter": "process", "adapterConfig": { "command": "chrome-gnome-shell", "passthrough": true, "missingDependencyHelp": "Install chrome-gnome-shell: apt-get install chrome-gnome-shell" }, "args": []
  }]
}
