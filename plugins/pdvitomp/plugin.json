{
  "name": "pdvitomp",
  "version": "0.1.0",
  "description": "CLI tool: pdvitomp",
  "source": "https://manpages.debian.org/pdvitomp",
  "checks": [
    {
      "type": "binary",
      "name": "pdvitomp"
    }
  ],
  "install_guidance": {
    "plugin": "pdvitomp",
    "binary": "pdvitomp",
    "check": "which pdvitomp",
    "install_steps": [
      "apt-get install pdvitomp 2>/dev/null || which pdvitomp",
      "Verify: pdvitomp --version",
      "supercli plugins install ./plugins/pdvitomp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdvitomp",
      "resource": "self",
      "action": "version",
      "description": "Print pdvitomp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdvitomp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdvitomp: apt-get install pdvitomp 2>/dev/null || which pdvitomp"
      },
      "args": []
    },
    {
      "namespace": "pdvitomp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdvitomp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdvitomp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdvitomp: apt-get install pdvitomp 2>/dev/null || which pdvitomp"
      },
      "args": []
    }
  ]
}