{
  "name": "JxrEncApp",
  "version": "0.1.0",
  "description": "CLI tool: JxrEncApp",
  "source": "https://manpages.debian.org/JxrEncApp",
  "checks": [
    {
      "type": "binary",
      "name": "JxrEncApp"
    }
  ],
  "install_guidance": {
    "plugin": "JxrEncApp",
    "binary": "JxrEncApp",
    "check": "which JxrEncApp",
    "install_steps": [
      "apt-get install JxrEncApp 2>/dev/null || which JxrEncApp",
      "Verify: JxrEncApp --version",
      "supercli plugins install ./plugins/JxrEncApp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "JxrEncApp",
      "resource": "self",
      "action": "version",
      "description": "Print JxrEncApp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "JxrEncApp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install JxrEncApp: apt-get install JxrEncApp 2>/dev/null || which JxrEncApp"
      },
      "args": []
    },
    {
      "namespace": "JxrEncApp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to JxrEncApp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "JxrEncApp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install JxrEncApp: apt-get install JxrEncApp 2>/dev/null || which JxrEncApp"
      },
      "args": []
    }
  ]
}