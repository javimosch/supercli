{
  "name": "lapce",
  "version": "0.1.0",
  "description": "Lightning-fast and powerful code editor in Rust",
  "source": "https://github.com/lapce/lapce",
  "checks": [{ "type": "binary", "name": "lapce" }],
  "install_guidance": {
    "plugin": "lapce",
    "binary": "lapce",
    "check": "which lapce",
    "install_steps": ["brew install lapce", "Verify: lapce --version", "supercli plugins install ./plugins/lapce --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lapce",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lapce CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lapce",
      "passthrough": true,
      "missingDependencyHelp": "Install lapce: brew install lapce", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
