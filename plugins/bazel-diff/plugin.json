{
  "name": "bazel-diff",
  "version": "0.1.0",
  "description": "Performs Bazel Target Diffing between two revisions in Git",
  "source": "https://github.com/Tinder/bazel-diff/",
  "checks": [
    {
      "type": "binary",
      "name": "bazel-diff"
    }
  ],
  "install_guidance": {
    "plugin": "bazel-diff",
    "binary": "bazel-diff",
    "check": "which bazel-diff",
    "install_steps": [
      "brew install bazel-diff",
      "Verify: bazel-diff --version",
      "supercli plugins install ./plugins/bazel-diff --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bazel-diff",
      "resource": "self",
      "action": "version",
      "description": "Print bazel-diff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bazel-diff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bazel-diff: brew install bazel-diff"
      },
      "args": []
    },
    {
      "namespace": "bazel-diff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bazel-diff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bazel-diff",
        "passthrough": true,
        "missingDependencyHelp": "Install bazel-diff"
      },
      "args": []
    }
  ]
}