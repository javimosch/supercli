{
  "name": "krane",
  "version": "0.1.0",
  "description": "Kubernetes deploy tool with rollout verification",
  "source": "https://github.com/Shopify/krane",
  "checks": [
    {
      "type": "binary",
      "name": "krane"
    }
  ],
  "install_guidance": {
    "plugin": "krane",
    "binary": "krane",
    "check": "which krane",
    "install_steps": [
      "brew install krane",
      "Verify: krane --version",
      "supercli plugins install ./plugins/krane --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "krane",
      "resource": "self",
      "action": "version",
      "description": "Print krane version",
      "adapter": "process",
      "adapterConfig": {
        "command": "krane",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install krane: brew install krane"
      },
      "args": []
    },
    {
      "namespace": "krane",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to krane CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "krane",
        "passthrough": true,
        "missingDependencyHelp": "Install krane"
      },
      "args": []
    }
  ]
}