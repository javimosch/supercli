{
  "name": "tabulate",
  "version": "0.1.0",
  "description": "CLI tool: tabulate",
  "source": "https://manpages.debian.org/tabulate",
  "checks": [
    {
      "type": "binary",
      "name": "tabulate"
    }
  ],
  "install_guidance": {
    "plugin": "tabulate",
    "binary": "tabulate",
    "check": "which tabulate",
    "install_steps": [
      "apt-get install tabulate 2>/dev/null || which tabulate",
      "Verify: tabulate --version",
      "supercli plugins install ./plugins/tabulate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tabulate",
      "resource": "self",
      "action": "version",
      "description": "Print tabulate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tabulate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tabulate: apt-get install tabulate 2>/dev/null || which tabulate"
      },
      "args": []
    },
    {
      "namespace": "tabulate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tabulate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tabulate",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tabulate: apt-get install tabulate 2>/dev/null || which tabulate"
      },
      "args": []
    }
  ]
}