{
  "name": "split-logfile",
  "version": "0.1.0",
  "description": "CLI tool: split-logfile",
  "source": "https://manpages.debian.org/split-logfile",
  "checks": [
    {
      "type": "binary",
      "name": "split-logfile"
    }
  ],
  "install_guidance": {
    "plugin": "split-logfile",
    "binary": "split-logfile",
    "check": "which split-logfile",
    "install_steps": [
      "apt-get install split-logfile 2>/dev/null || which split-logfile",
      "Verify: split-logfile --version",
      "supercli plugins install ./plugins/split-logfile --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "split-logfile",
      "resource": "self",
      "action": "version",
      "description": "Print split-logfile version",
      "adapter": "process",
      "adapterConfig": {
        "command": "split-logfile",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install split-logfile: apt-get install split-logfile 2>/dev/null || which split-logfile"
      },
      "args": []
    },
    {
      "namespace": "split-logfile",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to split-logfile CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "split-logfile",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install split-logfile: apt-get install split-logfile 2>/dev/null || which split-logfile"
      },
      "args": []
    }
  ]
}