{
  "name": "autocycler",
  "version": "0.1.0",
  "description": "Tool for generating consensus long-read assemblies for bacterial genomes",
  "source": "https://github.com/rrwick/Autocycler",
  "checks": [
    {
      "type": "binary",
      "name": "autocycler"
    }
  ],
  "install_guidance": {
    "plugin": "autocycler",
    "binary": "autocycler",
    "check": "which autocycler",
    "install_steps": [
      "brew install autocycler",
      "Verify: autocycler --version",
      "supercli plugins install ./plugins/autocycler --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "autocycler",
      "resource": "self",
      "action": "version",
      "description": "Print autocycler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "autocycler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install autocycler: brew install autocycler"
      },
      "args": []
    },
    {
      "namespace": "autocycler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to autocycler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "autocycler",
        "passthrough": true,
        "missingDependencyHelp": "Install autocycler"
      },
      "args": []
    }
  ]
}