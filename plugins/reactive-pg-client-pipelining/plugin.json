{
  "name": "reactive-pg-client-pipelining",
  "version": "0.1.0",
  "description": "Trying to reproduce an issue with pipelining",
  "source": "https://github.com/reactive-pg-client-pipelining/reactive-pg-client-pipelining",
  "checks": [
    {
      "type": "binary",
      "name": "reactive-pg-client-pipelining"
    }
  ],
  "install_guidance": {
    "plugin": "reactive-pg-client-pipelining",
    "binary": "reactive-pg-client-pipelining",
    "check": "which reactive-pg-client-pipelining",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: reactive-pg-client-pipelining --version",
      "supercli plugins install ./plugins/reactive-pg-client-pipelining --on-conflict replace --json"
    ],
    "note": "Kotlin language CLI tool"
  },
  "commands": [
    {
      "namespace": "reactive-pg-client-pipelining",
      "resource": "self",
      "action": "version",
      "description": "Print reactive-pg-client-pipelining version",
      "adapter": "process",
      "adapterConfig": {
        "command": "reactive-pg-client-pipelining",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install reactive-pg-client-pipelining from project repository"
      },
      "args": []
    },
    {
      "namespace": "reactive-pg-client-pipelining",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to reactive-pg-client-pipelining CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "reactive-pg-client-pipelining",
        "passthrough": true,
        "missingDependencyHelp": "Install reactive-pg-client-pipelining from project repository"
      },
      "args": []
    }
  ]
}