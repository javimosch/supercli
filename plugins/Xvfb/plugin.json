{
  "name": "Xvfb",
  "version": "0.1.0",
  "description": "CLI tool: Xvfb",
  "source": "https://manpages.debian.org/Xvfb",
  "checks": [
    {
      "type": "binary",
      "name": "Xvfb"
    }
  ],
  "install_guidance": {
    "plugin": "Xvfb",
    "binary": "Xvfb",
    "check": "which Xvfb",
    "install_steps": [
      "apt-get install Xvfb 2>/dev/null || which Xvfb",
      "Verify: Xvfb --version",
      "supercli plugins install ./plugins/Xvfb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Xvfb",
      "resource": "self",
      "action": "version",
      "description": "Print Xvfb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xvfb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Xvfb: apt-get install Xvfb 2>/dev/null || which Xvfb"
      },
      "args": []
    },
    {
      "namespace": "Xvfb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Xvfb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xvfb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install Xvfb: apt-get install Xvfb 2>/dev/null || which Xvfb"
      },
      "args": []
    }
  ]
}