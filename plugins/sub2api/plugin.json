{
  "name": "sub2api",
  "version": "0.1.0",
  "description": "Sub2API \u4e00\u7ad9\u5f0f\u5f00\u6e90\u4e2d\u8f6c\u670d\u52a1\uff0c\u8ba9 Claude\u3001Openai \u3001Gemini\u3001Antigravity\u8ba2\u9605\u7edf\u4e00\u63a5\u5165\uff0c\u652f\u6301\u62fc\u8f66\u5171\u4eab\uff0c\u66f4\u9ad8\u6548\u5206\u644a\u6210\u672c\uff0c\u539f\u751f\u5de5\u5177\u65e0\u7f1d\u4f7f\u7528\u3002",
  "source": "https://github.com/sub2api/sub2api",
  "checks": [
    {
      "type": "binary",
      "name": "sub2api"
    }
  ],
  "install_guidance": {
    "plugin": "sub2api",
    "binary": "sub2api",
    "check": "which sub2api",
    "install_steps": [
      "pip install sub2api",
      "Verify: sub2api --version",
      "supercli plugins install ./plugins/sub2api --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sub2api",
      "resource": "self",
      "action": "version",
      "description": "Print sub2api version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sub2api",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sub2api: pip install sub2api"
      },
      "args": []
    },
    {
      "namespace": "sub2api",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sub2api CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sub2api",
        "passthrough": true,
        "missingDependencyHelp": "Install sub2api: pip install sub2api"
      },
      "args": []
    }
  ]
}