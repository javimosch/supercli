{
  "name": "terragrunt-atlantis-config",
  "version": "0.1.0",
  "description": "Generate Atlantis config for Terragrunt repos",
  "source": "https://github.com/gruntwork-io/terragrunt-atlantis-config",
  "checks": [{ "type": "binary", "name": "terragrunt-atlantis-config" }],
  "install_guidance": {
    "plugin": "terragrunt-atlantis-config",
    "binary": "terragrunt-atlantis-config",
    "check": "which terragrunt-atlantis-config",
    "install_steps": ["brew install terragrunt-atlantis-config", "Verify: terragrunt-atlantis-config --version", "supercli plugins install ./plugins/terragrunt-atlantis-config --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terragrunt-atlantis-config",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terragrunt-atlantis-config CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terragrunt-atlantis-config",
      "passthrough": true,
      "missingDependencyHelp": "Install terragrunt-atlantis-config: brew install terragrunt-atlantis-config"
    },
    "args": []
  }]
}
