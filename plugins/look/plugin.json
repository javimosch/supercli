{
  "name": "look",
  "version": "0.1.0",
  "description": "Display lines beginning with a given string",
  "source": "https://packages.debian.org/look",
  "checks": [
    { "type": "binary", "name": "look" }
  ],
  "install_guidance": {
    "plugin": "look",
    "binary": "look",
    "check": "which look",
    "install_steps": [
      "apt-get install util-linux",
      "Verify: look --version",
      "supercli plugins install ./plugins/look --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "look",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to look CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "look",
        "passthrough": true,
        "missingDependencyHelp": "Install look: apt-get install util-linux"
      },
      "args": []
    }
  ]
}
