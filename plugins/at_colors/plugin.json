{
  "name": "at_colors",
  "version": "0.1.0",
  "description": "CLI tool: at_colors",
  "source": "https://packages.debian.org/at_colors",
  "checks": [{ "type": "binary", "name": "at_colors" }],
  "install_guidance": {
    "plugin": "at_colors", "binary": "at_colors", "check": "which at_colors",
    "install_steps": ["apt-get install at_colors 2>/dev/null || which at_colors", "Verify: at_colors --version", "supercli plugins install ./plugins/at_colors --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_colors", "resource": "_", "action": "_",
    "description": "Passthrough to at_colors CLI",
    "adapter": "process", "adapterConfig": { "command": "at_colors", "passthrough": true, "missingDependencyHelp": "Install at_colors: apt-get install at_colors" }, "args": []
  }]
}
