{
  "name": "pg_graphql",
  "version": "0.1.0",
  "description": "GraphQL support for PostgreSQL",
  "source": "https://github.com/supabase/pg_graphql",
  "checks": [{ "type": "binary", "name": "pg_graphql" }],
  "install_guidance": {
    "plugin": "pg_graphql",
    "binary": "pg_graphql",
    "check": "which pg_graphql",
    "install_steps": ["cargo install pg_graphql", "Verify: pg_graphql --version", "supercli plugins install ./plugins/pg_graphql --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pg_graphql",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pg_graphql CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pg_graphql",
      "passthrough": true,
      "missingDependencyHelp": "Install pg_graphql: cargo install pg_graphql"
    },
    "args": []
  }]
}
