{
  "name": "rand",
  "version": "0.1.0",
  "description": "rand — Rust random number generator library",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "rand"
    }
  ],
  "install_guidance": {
    "plugin": "rand",
    "binary": "rand",
    "check": "which rand",
    "install_steps": [
      "cargo install rand",
      "Verify: rand --version",
      "supercli plugins install ./plugins/rand --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rand",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rand",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rand"
      },
      "args": []
    }
  ]
}
