{
  "name": "Gewechat",
  "version": "0.1.0",
  "description": "\u5fae\u4fe1\u673a\u5668\u4eba\u6846\u67b6\uff0c\u4e2a\u4eba\u5fae\u4fe1\u4e8c\u6b21\u5f00\u53d1\uff0c\u6700\u7b80\u5355\u6613\u7528\u7684\u514d\u8d39\u4e8c\u5f00\u6846\u67b6,\u5fae\u4fe1ipad\u767b\u5f55\uff08\u975eHOOK\u7834\u89e3\u684c\u9762\u7aef\uff09",
  "source": "https://github.com/Gewechat/Gewechat",
  "checks": [
    {
      "type": "binary",
      "name": "gewechat"
    }
  ],
  "install_guidance": {
    "plugin": "Gewechat",
    "binary": "gewechat",
    "check": "which gewechat",
    "install_steps": [
      "pip install gewechat",
      "Verify: gewechat --version",
      "supercli plugins install ./plugins/Gewechat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Gewechat",
      "resource": "self",
      "action": "version",
      "description": "Print Gewechat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gewechat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Gewechat: pip install gewechat"
      },
      "args": []
    },
    {
      "namespace": "Gewechat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gewechat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gewechat",
        "passthrough": true,
        "missingDependencyHelp": "Install Gewechat: pip install gewechat"
      },
      "args": []
    }
  ]
}