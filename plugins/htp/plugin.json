{
  "name": "htp",
  "version": "0.1.0",
  "description": "HTTP test processor — run HTTP requests from files, validate responses, JSON report output",
  "source": "https://github.com/htp/htp",
  "checks": [
    {
      "type": "binary",
      "name": "htp"
    }
  ],
  "install_guidance": {
    "plugin": "htp",
    "binary": "htp",
    "check": "which htp",
    "install_steps": [
      "cargo install htp",
      "Verify: htp --version",
      "supercli plugins install ./plugins/htp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "htp",
      "resource": "self",
      "action": "version",
      "description": "Print htp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "htp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install htp: cargo install htp"
      },
      "args": []
    },
    {
      "namespace": "htp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to htp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "htp",
        "passthrough": true,
        "missingDependencyHelp": "Install htp: cargo install htp"
      },
      "args": []
    }
  ]
}
