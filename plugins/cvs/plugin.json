{
  "name": "cvs",
  "version": "0.1.0",
  "description": "CLI tool: cvs",
  "source": "https://packages.debian.org/cvs",
  "checks": [{ "type": "binary", "name": "cvs" }],
  "install_guidance": {
    "plugin": "cvs", "binary": "cvs", "check": "which cvs",
    "install_steps": ["apt-get install cvs 2>/dev/null || which cvs", "Verify: cvs --version", "supercli plugins install ./plugins/cvs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cvs", "resource": "_", "action": "_",
    "description": "Passthrough to cvs CLI",
    "adapter": "process", "adapterConfig": { "command": "cvs", "passthrough": true, "missingDependencyHelp": "Install cvs: apt-get install cvs" }, "args": []
  }]
}
