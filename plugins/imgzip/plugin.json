{
  "name": "imgzip",
  "version": "0.1.0",
  "description": "Image compression CLI - batch compress PNG, JPG, WebP, GIF with optional resize and format conversion",
  "source": "https://github.com/imgzip/imgzip",
  "checks": [
    {
      "type": "binary",
      "name": "imgzip"
    }
  ],
  "install_guidance": {
    "plugin": "imgzip",
    "binary": "imgzip",
    "check": "which imgzip",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: imgzip --version",
      "supercli plugins install ./plugins/imgzip --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "imgzip",
      "resource": "self",
      "action": "version",
      "description": "Print imgzip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgzip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install imgzip from project repository"
      },
      "args": []
    },
    {
      "namespace": "imgzip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to imgzip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgzip",
        "passthrough": true,
        "missingDependencyHelp": "Install imgzip from project repository"
      },
      "args": []
    }
  ]
}