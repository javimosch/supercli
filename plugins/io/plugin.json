{
  "name": "io",
  "version": "0.1.0",
  "description": " Easy input/output in ZIG. ",
  "source": "https://github.com/io/io",
  "checks": [
    {
      "type": "binary",
      "name": "io"
    }
  ],
  "install_guidance": {
    "plugin": "io",
    "binary": "io",
    "check": "which io",
    "install_steps": [
      "pip install io",
      "Verify: io --version",
      "supercli plugins install ./plugins/io --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "io",
      "resource": "self",
      "action": "version",
      "description": "Print io version",
      "adapter": "process",
      "adapterConfig": {
        "command": "io",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install io: pip install io"
      },
      "args": []
    },
    {
      "namespace": "io",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to io CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "io",
        "passthrough": true,
        "missingDependencyHelp": "Install io: pip install io"
      },
      "args": []
    }
  ]
}