{
  "name": "blender-cli-rendering",
  "version": "0.1.0",
  "description": "Set of Python scripts for headless Blender rendering automation",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "blender-cli-rendering" }],
  "install_guidance": {
    "plugin": "blender-cli-rendering",
    "binary": "blender-cli-rendering",
    "check": "which blender-cli-rendering",
    "install_steps": ["git clone && pip install .", "Verify: blender-cli-rendering --version", "supercli plugins install ./plugins/blender-cli-rendering --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "blender-cli-rendering",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to blender-cli-rendering CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "blender-cli-rendering",
      "passthrough": true,
      "missingDependencyHelp": "Install blender-cli-rendering: git clone && pip install ."
    },
    "args": []
  }]
}
