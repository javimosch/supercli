{
  "name": "zvec",
  "version": "0.1.0",
  "description": "A lightweight, lightning-fast, in-process vector database",
  "source": "https://github.com/zvec/zvec",
  "checks": [
    {
      "type": "binary",
      "name": "zvec"
    }
  ],
  "install_guidance": {
    "plugin": "zvec",
    "binary": "zvec",
    "check": "which zvec",
    "install_steps": [
      "pip install zvec",
      "Verify: zvec --version",
      "supercli plugins install ./plugins/zvec --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zvec",
      "resource": "self",
      "action": "version",
      "description": "Print zvec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zvec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zvec: pip install zvec"
      },
      "args": []
    },
    {
      "namespace": "zvec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zvec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zvec",
        "passthrough": true,
        "missingDependencyHelp": "Install zvec: pip install zvec"
      },
      "args": []
    }
  ]
}