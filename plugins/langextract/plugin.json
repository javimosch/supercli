{
  "name": "langextract",
  "version": "0.1.0",
  "description": "Extract structured information from unstructured text using LLMs with source grounding",
  "source": "https://github.com/google/langextract",
  "checks": [
    {
      "type": "binary",
      "name": "langextract"
    }
  ],
  "install_guidance": {
    "plugin": "langextract",
    "binary": "langextract",
    "check": "which langextract",
    "install_steps": [
      "pip install langextract",
      "Verify: langextract --version",
      "supercli plugins install ./plugins/langextract --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "langextract",
    "resource": "self",
    "action": "version",
    "description": "Print langextract version",
    "adapter": "process",
    "adapterConfig": {
      "command": "langextract",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install langextract: pip install langextract"
    },
    "args": []
  },
  {
    "namespace": "langextract",
    "resource": "text",
    "action": "extract",
    "description": "Extract structured information from text",
    "adapter": "process",
    "adapterConfig": {
      "command": "langextract",
      "passthrough": true,
      "missingDependencyHelp": "Install langextract: pip install langextract"
    },
    "args": []
  },
  {
    "namespace": "langextract",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to langextract CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "langextract",
      "passthrough": true,
      "missingDependencyHelp": "Install langextract"
    },
    "args": []
  }
]
}