{
  "name": "sparrow-wifi",
  "version": "0.1.0",
  "description": "Spectral awareness tool for WiFi and BLE analysis",
  "source": "https://github.com/ghostop14/sparrow-wifi",
  "checks": [{ "type": "binary", "name": "sparrow-wifi" }],
  "install_guidance": {
    "plugin": "sparrow-wifi",
    "binary": "sparrow-wifi",
    "check": "which sparrow-wifi",
    "install_steps": ["git clone and install", "Verify: sparrow-wifi --version", "supercli plugins install ./plugins/sparrow-wifi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sparrow-wifi",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sparrow-wifi CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sparrow-wifi",
      "passthrough": true,
      "missingDependencyHelp": "Install sparrow-wifi: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
