{
  "name": "terragrunt",
  "version": "0.1.0",
  "description": "Thin wrapper around Terraform for extra DRY configurations",
  "source": "https://github.com/gruntwork-io/terragrunt",
  "checks": [{ "type": "binary", "name": "terragrunt" }],
  "install_guidance": {
    "plugin": "terragrunt",
    "binary": "terragrunt",
    "check": "which terragrunt",
    "install_steps": ["brew install terragrunt", "Verify: terragrunt --version", "supercli plugins install ./plugins/terragrunt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terragrunt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terragrunt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terragrunt",
      "passthrough": true,
      "missingDependencyHelp": "Install terragrunt: brew install terragrunt"
    },
    "args": []
  }]
}
