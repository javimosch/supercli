{
  "name": "dscanner",
  "version": "0.1.0",
  "description": "Analyses e.g. the style and syntax of D code",
  "source": "https://github.com/dlang-community/D-Scanner",
  "checks": [
    {
      "type": "binary",
      "name": "dscanner"
    }
  ],
  "install_guidance": {
    "plugin": "dscanner",
    "binary": "dscanner",
    "check": "which dscanner",
    "install_steps": [
      "brew install dscanner",
      "Verify: dscanner --version",
      "supercli plugins install ./plugins/dscanner --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dscanner",
      "resource": "self",
      "action": "version",
      "description": "Print dscanner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dscanner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dscanner: brew install dscanner"
      },
      "args": []
    },
    {
      "namespace": "dscanner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dscanner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dscanner",
        "passthrough": true,
        "missingDependencyHelp": "Install dscanner"
      },
      "args": []
    }
  ]
}