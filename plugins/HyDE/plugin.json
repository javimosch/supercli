{
  "name": "HyDE",
  "version": "0.1.0",
  "description": "HyDE, your Development Environment \ud83d\udda5\ufe0f\ud83d\udcbb",
  "source": "https://github.com/HyDE/HyDE",
  "checks": [
    {
      "type": "binary",
      "name": "hyde"
    }
  ],
  "install_guidance": {
    "plugin": "HyDE",
    "binary": "hyde",
    "check": "which hyde",
    "install_steps": [
      "pip install hyde",
      "Verify: hyde --version",
      "supercli plugins install ./plugins/HyDE --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "HyDE",
      "resource": "self",
      "action": "version",
      "description": "Print HyDE version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hyde",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install HyDE: pip install hyde"
      },
      "args": []
    },
    {
      "namespace": "HyDE",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hyde CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hyde",
        "passthrough": true,
        "missingDependencyHelp": "Install HyDE: pip install hyde"
      },
      "args": []
    }
  ]
}