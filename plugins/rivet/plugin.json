{
  "name": "rivet",
  "version": "0.1.0",
  "description": "Rivet Actors are the primitive for stateful workloads. Built for AI agents, collaborative apps, and ",
  "source": "https://github.com/rivet/rivet",
  "checks": [
    {
      "type": "binary",
      "name": "rivet"
    }
  ],
  "install_guidance": {
    "plugin": "rivet",
    "binary": "rivet",
    "check": "which rivet",
    "install_steps": [
      "pip install rivet",
      "Verify: rivet --version",
      "supercli plugins install ./plugins/rivet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rivet",
      "resource": "self",
      "action": "version",
      "description": "Print rivet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rivet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rivet: pip install rivet"
      },
      "args": []
    },
    {
      "namespace": "rivet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rivet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rivet",
        "passthrough": true,
        "missingDependencyHelp": "Install rivet: pip install rivet"
      },
      "args": []
    }
  ]
}