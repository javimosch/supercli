{
  "name": "aliddns",
  "version": "0.1.0",
  "description": "Aliyun(Alibaba Cloud) ddns for golang",
  "source": "https://github.com/OpenIoTHub/aliddns",
  "checks": [
    {
      "type": "binary",
      "name": "aliddns"
    }
  ],
  "install_guidance": {
    "plugin": "aliddns",
    "binary": "aliddns",
    "check": "which aliddns",
    "install_steps": [
      "brew install aliddns",
      "Verify: aliddns --version",
      "supercli plugins install ./plugins/aliddns --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "aliddns",
      "resource": "self",
      "action": "version",
      "description": "Print aliddns version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aliddns",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aliddns: brew install aliddns"
      },
      "args": []
    },
    {
      "namespace": "aliddns",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aliddns CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aliddns",
        "passthrough": true,
        "missingDependencyHelp": "Install aliddns"
      },
      "args": []
    }
  ]
}