{
  "name": "setlogcons",
  "version": "0.1.0",
  "description": "CLI tool: setlogcons",
  "source": "https://manpages.debian.org/setlogcons",
  "checks": [
    {
      "type": "binary",
      "name": "setlogcons"
    }
  ],
  "install_guidance": {
    "plugin": "setlogcons",
    "binary": "setlogcons",
    "check": "which setlogcons",
    "install_steps": [
      "apt-get install setlogcons 2>/dev/null || which setlogcons",
      "Verify: setlogcons --version",
      "supercli plugins install ./plugins/setlogcons --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "setlogcons",
      "resource": "self",
      "action": "version",
      "description": "Print setlogcons version",
      "adapter": "process",
      "adapterConfig": {
        "command": "setlogcons",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install setlogcons: apt-get install setlogcons 2>/dev/null || which setlogcons"
      },
      "args": []
    },
    {
      "namespace": "setlogcons",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to setlogcons CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "setlogcons",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install setlogcons: apt-get install setlogcons 2>/dev/null || which setlogcons"
      },
      "args": []
    }
  ]
}