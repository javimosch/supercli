{
  "name": "chromedp",
  "version": "0.1.0",
  "description": "Chrome DevTools Protocol client in Go",
  "source": "https://github.com/chromedp/chromedp",
  "checks": [
    {
      "type": "binary",
      "name": "chromedp"
    }
  ],
  "install_guidance": {
    "plugin": "chromedp",
    "binary": "chromedp",
    "check": "which chromedp",
    "install_steps": [
      "go install github.com/chromedp/chromedp@latest",
      "Verify: chromedp --version",
      "supercli plugins install ./plugins/chromedp --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "chromedp",
      "resource": "self",
      "action": "version",
      "description": "Print chromedp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chromedp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chromedp: go install github.com/chromedp/chromedp@latest"
      },
      "args": []
    },
    {
      "namespace": "chromedp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chromedp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chromedp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install chromedp: go install github.com/chromedp/chromedp@latest"
      },
      "args": []
    }
  ]
}
