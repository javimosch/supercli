{
  "name": "ztk",
  "version": "0.1.0",
  "description": "CLI proxy that reduces LLM token consumption by 78%+. Single Zig binary under 260KB. Zero dependenci",
  "source": "https://github.com/ztk/ztk",
  "checks": [
    {
      "type": "binary",
      "name": "ztk"
    }
  ],
  "install_guidance": {
    "plugin": "ztk",
    "binary": "ztk",
    "check": "which ztk",
    "install_steps": [
      "pip install ztk",
      "Verify: ztk --version",
      "supercli plugins install ./plugins/ztk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ztk",
      "resource": "self",
      "action": "version",
      "description": "Print ztk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ztk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ztk: pip install ztk"
      },
      "args": []
    },
    {
      "namespace": "ztk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ztk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ztk",
        "passthrough": true,
        "missingDependencyHelp": "Install ztk: pip install ztk"
      },
      "args": []
    }
  ]
}