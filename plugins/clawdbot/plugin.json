{
  "name": "clawdbot",
  "version": "0.1.0",
  "description": "CLI tool: clawdbot",
  "source": "https://packages.debian.org/clawdbot",
  "checks": [{ "type": "binary", "name": "clawdbot" }],
  "install_guidance": {
    "plugin": "clawdbot", "binary": "clawdbot", "check": "which clawdbot",
    "install_steps": ["apt-get install clawdbot 2>/dev/null || which clawdbot", "Verify: clawdbot --version", "supercli plugins install ./plugins/clawdbot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clawdbot", "resource": "_", "action": "_",
    "description": "Passthrough to clawdbot CLI",
    "adapter": "process", "adapterConfig": { "command": "clawdbot", "passthrough": true, "missingDependencyHelp": "Install clawdbot: apt-get install clawdbot" }, "args": []
  }]
}
