{
  "name": "kwm",
  "version": "0.1.0",
  "description": "A window manager based on River Wayland compositor",
  "source": "https://github.com/kwm/kwm",
  "checks": [
    {
      "type": "binary",
      "name": "kwm"
    }
  ],
  "install_guidance": {
    "plugin": "kwm",
    "binary": "kwm",
    "check": "which kwm",
    "install_steps": [
      "pip install kwm",
      "Verify: kwm --version",
      "supercli plugins install ./plugins/kwm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kwm",
      "resource": "self",
      "action": "version",
      "description": "Print kwm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kwm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kwm: pip install kwm"
      },
      "args": []
    },
    {
      "namespace": "kwm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kwm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kwm",
        "passthrough": true,
        "missingDependencyHelp": "Install kwm: pip install kwm"
      },
      "args": []
    }
  ]
}