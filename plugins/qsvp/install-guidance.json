{
  "plugin": "qsvp",
  "binary": "qsvp",
  "check": "which qsvp",
  "install_steps": [
    "apt-get install qsvp 2>/dev/null || which qsvp",
    "Verify: qsvp --version",
    "supercli plugins install ./plugins/qsvp --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}