{
  "name": "osquery",
  "version": "0.1.0",
  "description": "SQL-powered operating system instrumentation and analytics",
  "source": "https://github.com/osquery/osquery",
  "checks": [{ "type": "binary", "name": "osqueryd" }],
  "install_guidance": {
    "plugin": "osquery",
    "binary": "osqueryd",
    "check": "which osqueryd",
    "install_steps": ["brew install osquery", "Verify: osqueryd --version", "supercli plugins install ./plugins/osquery --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "osquery",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to osqueryd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "osqueryd",
      "passthrough": true,
      "missingDependencyHelp": "Install osquery: brew install osquery"
    },
    "args": []
  }]
}
