{
  "name": "arttime",
  "version": "0.1.0",
  "description": "CLI app blending ASCII art with timekeeping",
  "source": "https://github.com/nickelc/arttime",
  "checks": [
    {
      "type": "binary",
      "name": "arttime"
    }
  ],
  "install_guidance": {
    "plugin": "arttime",
    "binary": "arttime",
    "check": "which arttime",
    "install_steps": [
      "brew install arttime",
      "Verify: arttime --version",
      "supercli plugins install ./plugins/arttime --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "arttime",
      "resource": "self",
      "action": "version",
      "description": "Print arttime version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arttime",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arttime: brew install arttime"
      },
      "args": []
    },
    {
      "namespace": "arttime",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arttime",
      "adapter": "process",
      "adapterConfig": {
        "command": "arttime",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install arttime: brew install arttime"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
