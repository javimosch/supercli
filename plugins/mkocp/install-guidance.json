{
  "plugin": "mkocp",
  "binary": "mkocp",
  "check": "which mkocp",
  "install_steps": [
    "apt-get install mkocp 2>/dev/null || which mkocp",
    "Verify: mkocp --version",
    "supercli plugins install ./plugins/mkocp --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}