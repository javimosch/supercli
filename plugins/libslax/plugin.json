{
  "name": "libslax",
  "version": "0.1.0",
  "description": "Implementation of the SLAX language (an XSLT alternative)",
  "source": "https://github.com/Juniper/libslax/wiki",
  "checks": [
    {
      "type": "binary",
      "name": "libslax"
    }
  ],
  "install_guidance": {
    "plugin": "libslax",
    "binary": "libslax",
    "check": "which libslax",
    "install_steps": [
      "brew install libslax",
      "Verify: libslax --version",
      "supercli plugins install ./plugins/libslax --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libslax",
      "resource": "self",
      "action": "version",
      "description": "Print libslax version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libslax",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libslax: brew install libslax"
      },
      "args": []
    },
    {
      "namespace": "libslax",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libslax CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libslax",
        "passthrough": true,
        "missingDependencyHelp": "Install libslax"
      },
      "args": []
    }
  ]
}