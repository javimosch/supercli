{
  "name": "oat2dex",
  "version": "0.1.0",
  "description": "OAT to DEX converter for Android analysis",
  "source": "https://github.com/testwhat/Oat2Dex",
  "checks": [
    {
      "type": "binary",
      "name": "oat2dex"
    }
  ],
  "install_guidance": {
    "plugin": "oat2dex",
    "binary": "oat2dex",
    "check": "which oat2dex",
    "install_steps": [
      "pip install oat2dex",
      "Verify: oat2dex --version",
      "supercli plugins install ./plugins/oat2dex --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "oat2dex",
      "resource": "self",
      "action": "version",
      "description": "Print oat2dex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oat2dex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oat2dex: pip install oat2dex"
      },
      "args": []
    },
    {
      "namespace": "oat2dex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oat2dex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oat2dex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install oat2dex: pip install oat2dex"
      },
      "args": []
    }
  ]
}
