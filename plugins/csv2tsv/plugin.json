{
  "name": "csv2tsv",
  "version": "0.1.0",
  "description": "CSV to TSV converter",
  "source": "https://github.com/me-io/csv2tsv",
  "checks": [
    {
      "type": "binary",
      "name": "csv2tsv"
    }
  ],
  "install_guidance": {
    "plugin": "csv2tsv",
    "binary": "csv2tsv",
    "check": "which csv2tsv",
    "install_steps": [
      "brew install csv2tsv",
      "Verify: csv2tsv --version",
      "supercli plugins install ./plugins/csv2tsv --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "csv2tsv",
      "resource": "self",
      "action": "version",
      "description": "Print csv2tsv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csv2tsv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csv2tsv: brew install csv2tsv"
      },
      "args": []
    },
    {
      "namespace": "csv2tsv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csv2tsv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csv2tsv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install csv2tsv: brew install csv2tsv"
      },
      "args": []
    }
  ]
}
