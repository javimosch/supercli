{
  "plugin": "coderabbit-cli",
  "binary": "cr",
  "check": "which cr",
  "install_steps": [
    "curl -fsSL https://cli.coderabbit.ai/install.sh | sh",
    "Verify: cr --help",
    "supercli plugins install ./plugins/coderabbit-cli --on-conflict replace --json"
  ],
  "note": "Also available via Homebrew: brew install coderabbit. Requires auth: cr auth login."
}
