{
  "name": "pico-os",
  "version": "0.1.0",
  "description": "A minimal RISC-V 32-bit OS written in Zig.",
  "source": "https://github.com/pico-os/pico-os",
  "checks": [
    {
      "type": "binary",
      "name": "pico-os"
    }
  ],
  "install_guidance": {
    "plugin": "pico-os",
    "binary": "pico-os",
    "check": "which pico-os",
    "install_steps": [
      "pip install pico-os",
      "Verify: pico-os --version",
      "supercli plugins install ./plugins/pico-os --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pico-os",
      "resource": "self",
      "action": "version",
      "description": "Print pico-os version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pico-os",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pico-os: pip install pico-os"
      },
      "args": []
    },
    {
      "namespace": "pico-os",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pico-os CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pico-os",
        "passthrough": true,
        "missingDependencyHelp": "Install pico-os: pip install pico-os"
      },
      "args": []
    }
  ]
}