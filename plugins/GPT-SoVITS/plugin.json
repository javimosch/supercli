{
  "name": "GPT-SoVITS",
  "version": "0.1.0",
  "description": "1 min voice data can also be used to train a good TTS model! (few shot voice cloning)",
  "source": "https://github.com/GPT-SoVITS/GPT-SoVITS",
  "checks": [
    {
      "type": "binary",
      "name": "gpt-sovits"
    }
  ],
  "install_guidance": {
    "plugin": "GPT-SoVITS",
    "binary": "gpt-sovits",
    "check": "which gpt-sovits",
    "install_steps": [
      "pip install gpt-sovits",
      "Verify: gpt-sovits --version",
      "supercli plugins install ./plugins/GPT-SoVITS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GPT-SoVITS",
      "resource": "self",
      "action": "version",
      "description": "Print GPT-SoVITS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpt-sovits",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GPT-SoVITS: pip install gpt-sovits"
      },
      "args": []
    },
    {
      "namespace": "GPT-SoVITS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpt-sovits CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpt-sovits",
        "passthrough": true,
        "missingDependencyHelp": "Install GPT-SoVITS: pip install gpt-sovits"
      },
      "args": []
    }
  ]
}