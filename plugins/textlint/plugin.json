{
  "name": "textlint",
  "version": "0.1.0",
  "description": "Natural language linter for multiple languages",
  "source": "https://github.com/textlint/textlint",
  "checks": [
    {
      "type": "binary",
      "name": "textlint"
    }
  ],
  "install_guidance": {
    "plugin": "textlint",
    "binary": "textlint",
    "check": "which textlint",
    "install_steps": [
      "npm install -g textlint",
      "Verify: textlint --version",
      "supercli plugins install ./plugins/textlint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "textlint",
      "resource": "self",
      "action": "version",
      "description": "Print textlint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "textlint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install textlint: npm install -g textlint"
      },
      "args": []
    },
    {
      "namespace": "textlint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to textlint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "textlint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install textlint: npm install -g textlint"
      },
      "args": []
    }
  ]
}
