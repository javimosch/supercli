{
  "name": "maturin",
  "version": "0.1.0",
  "description": "Build and publish Rust crates as Python packages",
  "source": "https://github.com/PyO3/maturin",
  "checks": [{ "type": "binary", "name": "maturin" }],
  "install_guidance": {
    "plugin": "maturin",
    "binary": "maturin",
    "check": "which maturin",
    "install_steps": ["pip install maturin", "Verify: maturin --version", "supercli plugins install ./plugins/maturin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "maturin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to maturin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "maturin",
      "passthrough": true,
      "missingDependencyHelp": "Install maturin: pip install maturin", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
