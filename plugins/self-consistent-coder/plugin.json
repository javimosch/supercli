{
  "name": "self-consistent-coder",
  "version": "0.1.0",
  "description": "\u5982\u4f55\u6210\u4e3a\u4e00\u540d\u81ea\u6d3d\u7684\u7a0b\u5e8f\u5458",
  "source": "https://github.com/self-consistent-coder/self-consistent-coder",
  "checks": [
    {
      "type": "binary",
      "name": "self-consistent-coder"
    }
  ],
  "install_guidance": {
    "plugin": "self-consistent-coder",
    "binary": "self-consistent-coder",
    "check": "which self-consistent-coder",
    "install_steps": [
      "pip install self-consistent-coder",
      "Verify: self-consistent-coder --version",
      "supercli plugins install ./plugins/self-consistent-coder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "self-consistent-coder",
      "resource": "self",
      "action": "version",
      "description": "Print self-consistent-coder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "self-consistent-coder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install self-consistent-coder: pip install self-consistent-coder"
      },
      "args": []
    },
    {
      "namespace": "self-consistent-coder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to self-consistent-coder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "self-consistent-coder",
        "passthrough": true,
        "missingDependencyHelp": "Install self-consistent-coder: pip install self-consistent-coder"
      },
      "args": []
    }
  ]
}