{
  "name": "is-reachable-cli",
  "version": "0.1.0",
  "description": "Check if hostnames are reachable or not",
  "source": "https://github.com/beatfreaker/is-reachable-cli",
  "checks": [
    {
      "type": "binary",
      "name": "is-reachable-cli"
    }
  ],
  "install_guidance": {
    "plugin": "is-reachable-cli",
    "binary": "is-reachable-cli",
    "check": "which is-reachable-cli",
    "install_steps": [
      "See https://github.com/beatfreaker/is-reachable-cli",
      "Verify: is-reachable-cli --version",
      "supercli plugins install ./plugins/is-reachable-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "is-reachable-cli",
      "resource": "self",
      "action": "version",
      "description": "Print is-reachable-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "is-reachable-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install is-reachable-cli: See https://github.com/beatfreaker/is-reachable-cli"
      },
      "args": []
    },
    {
      "namespace": "is-reachable-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to is-reachable-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "is-reachable-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install is-reachable-cli"
      },
      "args": []
    }
  ]
}