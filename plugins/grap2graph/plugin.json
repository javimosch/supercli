{
  "name": "grap2graph",
  "version": "0.1.0",
  "description": "CLI tool: grap2graph",
  "source": "https://manpages.debian.org/grap2graph",
  "checks": [
    {
      "type": "binary",
      "name": "grap2graph"
    }
  ],
  "install_guidance": {
    "plugin": "grap2graph",
    "binary": "grap2graph",
    "check": "which grap2graph",
    "install_steps": [
      "apt-get install grap2graph 2>/dev/null || which grap2graph",
      "Verify: grap2graph --version",
      "supercli plugins install ./plugins/grap2graph --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grap2graph",
      "resource": "self",
      "action": "version",
      "description": "Print grap2graph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grap2graph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grap2graph: apt-get install grap2graph 2>/dev/null || which grap2graph"
      },
      "args": []
    },
    {
      "namespace": "grap2graph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grap2graph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grap2graph",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install grap2graph: apt-get install grap2graph 2>/dev/null || which grap2graph"
      },
      "args": []
    }
  ]
}