{
  "plugin": "ubuntu-distro-info",
  "binary": "ubuntu-distro-info",
  "check": "which ubuntu-distro-info",
  "install_steps": [
    "apt-get install ubuntu-distro-info 2>/dev/null || which ubuntu-distro-info",
    "Verify: ubuntu-distro-info --version",
    "supercli plugins install ./plugins/ubuntu-distro-info --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}