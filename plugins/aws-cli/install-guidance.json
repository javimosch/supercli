{
  "plugin": "aws-cli",
  "binary": "aws",
  "check": "which aws",
  "install_steps": [
    "brew install awscli",
    "pipx install awscli",
    "Verify: aws --version",
    "supercli plugins install ./plugins/aws-cli --on-conflict replace --json"
  ],
  "note": "Homebrew formula is `awscli`; the binary it installs is `aws`."
}
