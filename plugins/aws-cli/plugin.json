{
  "name": "aws-cli",
  "version": "0.1.0",
  "description": "AWS CLI — command-line interface for Amazon Web Services",
  "source": "https://github.com/aws/aws-cli",
  "checks": [
    {
      "type": "binary",
      "name": "aws"
    }
  ],
  "install_guidance": {
    "plugin": "aws-cli",
    "binary": "aws",
    "check": "which aws",
    "install_steps": [
      "brew install awscli",
      "pipx install awscli",
      "Verify: aws --version",
      "supercli plugins install ./plugins/aws-cli --on-conflict replace --json"
    ],
    "note": "Homebrew formula is `awscli`; the binary it installs is `aws`."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aws-cli",
      "resource": "self",
      "action": "version",
      "description": "Print aws-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install aws-cli: brew install awscli"
      },
      "args": []
    },
    {
      "namespace": "aws-cli",
      "resource": "cli",
      "action": "run",
      "description": "AWS CLI — command-line interface for Amazon Web Services",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install aws-cli: brew install awscli"
      },
      "args": []
    }
  ]
}
