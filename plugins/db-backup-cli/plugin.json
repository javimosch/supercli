{
  "name": "db-backup-cli",
  "version": "0.1.0",
  "description": "Database Backup CLI Utility is a versatile and user-friendly command-line tool designed to streamline the process of backing up and restoring databases.",
  "source": "https://github.com/db-backup-cli/db-backup-cli",
  "checks": [
    {
      "type": "binary",
      "name": "db-backup-cli"
    }
  ],
  "install_guidance": {
    "plugin": "db-backup-cli",
    "binary": "db-backup-cli",
    "check": "which db-backup-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: db-backup-cli --version",
      "supercli plugins install ./plugins/db-backup-cli --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "db-backup-cli",
      "resource": "self",
      "action": "version",
      "description": "Print db-backup-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "db-backup-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install db-backup-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "db-backup-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to db-backup-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "db-backup-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install db-backup-cli from project repository"
      },
      "args": []
    }
  ]
}