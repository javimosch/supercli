{
  "name": "openclaw",
  "version": "0.1.0",
  "description": "Your own personal AI assistant. Any OS. Any Platform. The lobster way. \ud83e\udd9e ",
  "source": "https://github.com/openclaw/openclaw",
  "checks": [
    {
      "type": "binary",
      "name": "openclaw"
    }
  ],
  "install_guidance": {
    "plugin": "openclaw",
    "binary": "openclaw",
    "check": "which openclaw",
    "install_steps": [
      "pip install openclaw",
      "Verify: openclaw --version",
      "supercli plugins install ./plugins/openclaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openclaw",
      "resource": "self",
      "action": "version",
      "description": "Print openclaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openclaw: pip install openclaw"
      },
      "args": []
    },
    {
      "namespace": "openclaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install openclaw: pip install openclaw"
      },
      "args": []
    }
  ]
}