{
  "name": "oxigdal-cli",
  "version": "0.1.0",
  "description": "Pure Rust CLI for GDAL-like geospatial format conversion",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "oxigdal-cli" }],
  "install_guidance": {
    "plugin": "oxigdal-cli",
    "binary": "oxigdal-cli",
    "check": "which oxigdal-cli",
    "install_steps": ["cargo install oxigdal", "Verify: oxigdal-cli --version", "supercli plugins install ./plugins/oxigdal-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "oxigdal-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to oxigdal-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "oxigdal-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install oxigdal-cli: cargo install oxigdal"
    },
    "args": []
  }]
}
