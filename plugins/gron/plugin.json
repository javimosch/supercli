{
  "name": "gron",
  "version": "0.1.0",
  "description": "Make JSON greppable by flattening it into assignment statements",
  "source": "https://github.com/tomnomnom/gron",
  "checks": [{ "type": "binary", "name": "gron" }],
  "install_guidance": {
    "plugin": "gron",
    "binary": "gron",
    "check": "which gron",
    "install_steps": ["brew install gron", "Verify: gron --version", "supercli plugins install ./plugins/gron --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gron",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gron CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gron",
      "passthrough": true,
      "missingDependencyHelp": "Install gron: brew install gron"
    },
    "args": []
  }]
}
