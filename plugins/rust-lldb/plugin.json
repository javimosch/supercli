{
  "name": "rust-lldb",
  "version": "0.1.0",
  "description": "CLI tool: rust-lldb",
  "source": "https://crates.io/crates/rust-lldb",
  "checks": [
    {
      "type": "binary",
      "name": "rust-lldb"
    }
  ],
  "install_guidance": {
    "plugin": "rust-lldb",
    "binary": "rust-lldb",
    "check": "which rust-lldb",
    "install_steps": [
      "cargo install rust-lldb",
      "Verify: rust-lldb --version",
      "supercli plugins install ./plugins/rust-lldb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rust-lldb",
      "resource": "self",
      "action": "version",
      "description": "Print rust-lldb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-lldb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rust-lldb: cargo install rust-lldb"
      },
      "args": []
    },
    {
      "namespace": "rust-lldb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rust-lldb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-lldb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rust-lldb: cargo install rust-lldb"
      },
      "args": []
    }
  ]
}