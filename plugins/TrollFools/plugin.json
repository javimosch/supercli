{
  "name": "TrollFools",
  "version": "0.1.0",
  "description": "In-place tweak injection with insert_dylib and ChOma.",
  "source": "https://github.com/TrollFools/TrollFools",
  "checks": [
    {
      "type": "binary",
      "name": "trollfools"
    }
  ],
  "install_guidance": {
    "plugin": "TrollFools",
    "binary": "trollfools",
    "check": "which trollfools",
    "install_steps": [
      "pip install trollfools",
      "Verify: trollfools --version",
      "supercli plugins install ./plugins/TrollFools --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TrollFools",
      "resource": "self",
      "action": "version",
      "description": "Print TrollFools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trollfools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TrollFools: pip install trollfools"
      },
      "args": []
    },
    {
      "namespace": "TrollFools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trollfools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trollfools",
        "passthrough": true,
        "missingDependencyHelp": "Install TrollFools: pip install trollfools"
      },
      "args": []
    }
  ]
}