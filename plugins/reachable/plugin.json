{
  "name": "reachable",
  "version": "0.1.0",
  "description": "Check if a domain is up",
  "source": "https://github.com/italolelis/reachable",
  "checks": [
    {
      "type": "binary",
      "name": "reachable"
    }
  ],
  "install_guidance": {
    "plugin": "reachable",
    "binary": "reachable",
    "check": "which reachable",
    "install_steps": [
      "See https://github.com/italolelis/reachable",
      "Verify: reachable --version",
      "supercli plugins install ./plugins/reachable --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "reachable",
      "resource": "self",
      "action": "version",
      "description": "Print reachable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "reachable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install reachable: See https://github.com/italolelis/reachable"
      },
      "args": []
    },
    {
      "namespace": "reachable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to reachable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "reachable",
        "passthrough": true,
        "missingDependencyHelp": "Install reachable"
      },
      "args": []
    }
  ]
}