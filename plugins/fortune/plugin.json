{
  "name": "fortune",
  "version": "0.1.0",
  "description": "Display random quotes and aphorisms",
  "source": "https",
  "checks": [{"type": "binary", "name": "fortune"}],
  "install_guidance": {
    "plugin": "fortune",
    "binary": "fortune",
    "check": "which fortune",
    "install_steps": [
      "brew install fortune",
      "Verify: fortune --version",
      "supercli plugins install ./plugins/fortune --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "fortune",
      "resource": "self",
      "action": "version",
      "description": "Print fortune version",
      "adapter": "process",
      "adapterConfig": {"command": "fortune", "baseArgs": ["--version"], "missingDependencyHelp": "Install fortune: brew install fortune"},
      "args": []
    },
    {
      "namespace": "fortune",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fortune CLI",
      "adapter": "process",
      "adapterConfig": {"command": "fortune", "passthrough": true, "missingDependencyHelp": "Install fortune: brew install fortune"},
      "args": []
    }
  ]
}
