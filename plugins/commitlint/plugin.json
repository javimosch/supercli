{
  "name": "commitlint",
  "version": "0.1.0",
  "description": "Conventional commit message linter",
  "source": "https://github.com/conventional-changelog/commitlint",
  "checks": [
    {
      "type": "binary",
      "name": "commitlint"
    }
  ],
  "install_guidance": {
    "plugin": "commitlint",
    "binary": "commitlint",
    "check": "which commitlint",
    "install_steps": [
      "npm install -g @commitlint/cli",
      "Verify: commitlint --version",
      "supercli plugins install ./plugins/commitlint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "commitlint",
      "resource": "self",
      "action": "version",
      "description": "Print commitlint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "commitlint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install commitlint: npm install -g @commitlint/cli"
      },
      "args": []
    },
    {
      "namespace": "commitlint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to commitlint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "commitlint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install commitlint: npm install -g @commitlint/cli"
      },
      "args": []
    }
  ]
}
