{
  "name": "fgallery",
  "version": "1.0.0",
  "description": "fgallery \u2014 Photo gallery",
  "source": "github.com/thomastweets/fgallery",
  "checks": [
    {
      "type": "binary",
      "name": "fgallery"
    }
  ],
  "install_guidance": {
    "plugin": "fgallery",
    "binary": "fgallery",
    "check": "which fgallery",
    "install_steps": [
      "# Install fgallery",
      "# See github.com/thomastweets/fgallery",
      "# apt: sudo apt-get install fgallery",
      "# brew: brew install fgallery",
      "# cargo: cargo install fgallery",
      "# npm: npm install -g fgallery",
      "# pip: pip install fgallery"
    ]
  },
  "commands": [
    {
      "namespace": "fgallery",
      "resource": "fgallery",
      "action": "run",
      "description": "Run fgallery",
      "adapter": "process",
      "adapterConfig": {
        "command": "fgallery",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fgallery from github.com/thomastweets/fgallery"
      },
      "args": []
    }
  ]
}