{
  "name": "Helm",
  "version": "0.1.0",
  "description": "Minimalistic timer",
  "source": "https://github.com/0xjuanma/helm",
  "checks": [
    {
      "type": "binary",
      "name": "Helm"
    }
  ],
  "install_guidance": {
    "plugin": "Helm",
    "binary": "Helm",
    "check": "which Helm",
    "install_steps": [
      "brew install Helm",
      "Verify: Helm --version",
      "supercli plugins install ./plugins/Helm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Helm",
      "resource": "self",
      "action": "version",
      "description": "Print Helm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Helm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Helm: brew install Helm"
      },
      "args": []
    },
    {
      "namespace": "Helm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Helm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Helm",
        "passthrough": true,
        "missingDependencyHelp": "Install Helm"
      },
      "args": []
    }
  ]
}