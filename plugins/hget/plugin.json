{
  "name": "hget",
  "version": "0.1.0",
  "description": "Render websites in plain text from your terminal",
  "source": "https://github.com/bevacqua/hget",
  "checks": [
    {
      "type": "binary",
      "name": "hget"
    }
  ],
  "install_guidance": {
    "plugin": "hget",
    "binary": "hget",
    "check": "which hget",
    "install_steps": [
      "See https://github.com/bevacqua/hget",
      "Verify: hget --version",
      "supercli plugins install ./plugins/hget --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "hget",
      "resource": "self",
      "action": "version",
      "description": "Print hget version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hget",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hget: See https://github.com/bevacqua/hget"
      },
      "args": []
    },
    {
      "namespace": "hget",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hget CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hget",
        "passthrough": true,
        "missingDependencyHelp": "Install hget"
      },
      "args": []
    }
  ]
}