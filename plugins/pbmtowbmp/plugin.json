{
  "name": "pbmtowbmp",
  "version": "0.1.0",
  "description": "CLI tool: pbmtowbmp",
  "source": "https://manpages.debian.org/pbmtowbmp",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtowbmp"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtowbmp",
    "binary": "pbmtowbmp",
    "check": "which pbmtowbmp",
    "install_steps": [
      "apt-get install pbmtowbmp 2>/dev/null || which pbmtowbmp",
      "Verify: pbmtowbmp --version",
      "supercli plugins install ./plugins/pbmtowbmp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtowbmp",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtowbmp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtowbmp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtowbmp: apt-get install pbmtowbmp 2>/dev/null || which pbmtowbmp"
      },
      "args": []
    },
    {
      "namespace": "pbmtowbmp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtowbmp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtowbmp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtowbmp: apt-get install pbmtowbmp 2>/dev/null || which pbmtowbmp"
      },
      "args": []
    }
  ]
}