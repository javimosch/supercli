{
  "name": "ppmtotga",
  "version": "0.1.0",
  "description": "CLI tool: ppmtotga",
  "source": "https://manpages.debian.org/ppmtotga",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtotga"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtotga",
    "binary": "ppmtotga",
    "check": "which ppmtotga",
    "install_steps": [
      "apt-get install ppmtotga 2>/dev/null || which ppmtotga",
      "Verify: ppmtotga --version",
      "supercli plugins install ./plugins/ppmtotga --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtotga",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtotga version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtotga",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtotga: apt-get install ppmtotga 2>/dev/null || which ppmtotga"
      },
      "args": []
    },
    {
      "namespace": "ppmtotga",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtotga CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtotga",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtotga: apt-get install ppmtotga 2>/dev/null || which ppmtotga"
      },
      "args": []
    }
  ]
}