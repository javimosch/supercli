{
  "name": "cron-schedule-cli",
  "version": "0.1.0",
  "description": "A cron expression parser and validator. Parses, explains, and validates cron schedule expressions with human-readable output and JSON support.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "cron-schedule-cli"
    }
  ],
  "install_guidance": {
    "plugin": "cron-schedule-cli",
    "binary": "cron-schedule-cli",
    "check": "which cron-schedule-cli",
    "install_steps": [
      "cargo install cron-schedule-cli",
      "Verify: cron-schedule-cli --version",
      "supercli plugins install ./plugins/cron-schedule-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cron-schedule-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cron-schedule-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cron-schedule-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install cron-schedule-cli: cargo install cron-schedule-cli"
      },
      "args": []
    }
  ]
}
