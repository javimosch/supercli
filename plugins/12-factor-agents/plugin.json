{
  "name": "12-factor-agents",
  "version": "0.1.0",
  "description": "What are the principles we can use to build LLM-powered software that is actually good enough to put",
  "source": "https://github.com/12-factor-agents/12-factor-agents",
  "checks": [
    {
      "type": "binary",
      "name": "12-factor-agents"
    }
  ],
  "install_guidance": {
    "plugin": "12-factor-agents",
    "binary": "12-factor-agents",
    "check": "which 12-factor-agents",
    "install_steps": [
      "pip install 12-factor-agents",
      "Verify: 12-factor-agents --version",
      "supercli plugins install ./plugins/12-factor-agents --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "12-factor-agents",
      "resource": "self",
      "action": "version",
      "description": "Print 12-factor-agents version",
      "adapter": "process",
      "adapterConfig": {
        "command": "12-factor-agents",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install 12-factor-agents: pip install 12-factor-agents"
      },
      "args": []
    },
    {
      "namespace": "12-factor-agents",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to 12-factor-agents CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "12-factor-agents",
        "passthrough": true,
        "missingDependencyHelp": "Install 12-factor-agents: pip install 12-factor-agents"
      },
      "args": []
    }
  ]
}