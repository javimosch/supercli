{
  "name": "lua-language-server",
  "version": "0.1.0",
  "description": "Language Server for the Lua language",
  "checks": [
    {
      "type": "binary",
      "name": "lua-language-server"
    }
  ],
  "install_guidance": {
    "plugin": "lua-language-server",
    "binary": "lua-language-server",
    "check": "which lua-language-server",
    "install_steps": [
      "brew install lua-language-server",
      "Verify: lua-language-server --version",
      "supercli plugins install ./plugins/lua-language-server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lua-language-server",
      "resource": "self",
      "action": "version",
      "description": "Print lua-language-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lua-language-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lua-language-server: brew install lua-language-server"
      },
      "args": []
    },
    {
      "namespace": "lua-language-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lua-language-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lua-language-server",
        "passthrough": true,
        "missingDependencyHelp": "Install lua-language-server"
      },
      "args": []
    }
  ]
}