{
  "name": "interactive-rebase",
  "version": "1.0.0",
  "description": "interactive-rebase \u2014 Interactive rebase",
  "source": "github.com/MitMaro/git-interactive-rebase-tool",
  "checks": [
    {
      "type": "binary",
      "name": "interactive-rebase-tool"
    }
  ],
  "install_guidance": {
    "plugin": "interactive-rebase",
    "binary": "interactive-rebase-tool",
    "check": "which interactive-rebase-tool",
    "install_steps": [
      "# Install interactive-rebase",
      "# See github.com/MitMaro/git-interactive-rebase-tool",
      "# apt: sudo apt-get install interactive-rebase",
      "# brew: brew install interactive-rebase",
      "# cargo: cargo install interactive-rebase",
      "# npm: npm install -g interactive-rebase",
      "# pip: pip install interactive-rebase"
    ]
  },
  "commands": [
    {
      "namespace": "interactive",
      "resource": "rebase",
      "action": "run",
      "description": "Run interactive-rebase",
      "adapter": "process",
      "adapterConfig": {
        "command": "interactive-rebase-tool",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install interactive-rebase from github.com/MitMaro/git-interactive-rebase-tool"
      },
      "args": []
    }
  ]
}