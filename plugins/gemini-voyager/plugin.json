{
  "name": "gemini-voyager",
  "version": "0.1.0",
  "description": "An all-in-one enhancement suite for Google Gemini & AI Studio - timeline navigation, folder manageme",
  "source": "https://github.com/gemini-voyager/gemini-voyager",
  "checks": [
    {
      "type": "binary",
      "name": "gemini-voyager"
    }
  ],
  "install_guidance": {
    "plugin": "gemini-voyager",
    "binary": "gemini-voyager",
    "check": "which gemini-voyager",
    "install_steps": [
      "pip install gemini-voyager",
      "Verify: gemini-voyager --version",
      "supercli plugins install ./plugins/gemini-voyager --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gemini-voyager",
      "resource": "self",
      "action": "version",
      "description": "Print gemini-voyager version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemini-voyager",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gemini-voyager: pip install gemini-voyager"
      },
      "args": []
    },
    {
      "namespace": "gemini-voyager",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gemini-voyager CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemini-voyager",
        "passthrough": true,
        "missingDependencyHelp": "Install gemini-voyager: pip install gemini-voyager"
      },
      "args": []
    }
  ]
}