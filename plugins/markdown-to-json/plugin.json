{
  "name": "markdown-to-json",
  "version": "0.1.0",
  "description": "Convert markdown to structured JSON data",
  "source": "https://github.com/scottstanfield/markdown-to-json",
  "checks": [{ "type": "binary", "name": "markdown-to-json" }],
  "install_guidance": {
    "plugin": "markdown-to-json",
    "binary": "markdown-to-json",
    "check": "which markdown-to-json",
    "install_steps": ["npm install -g markdown-to-json-cli", "Verify: markdown-to-json --version", "supercli plugins install ./plugins/markdown-to-json --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "markdown-to-json",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to markdown-to-json CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "markdown-to-json",
      "passthrough": true,
      "missingDependencyHelp": "Install markdown-to-json: npm install -g markdown-to-json-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
