{
  "name": "ai-engineering-from-scratch",
  "version": "0.1.0",
  "description": "Learn it. Build it. Ship it for others.",
  "source": "https://github.com/ai-engineering-from-scratch/ai-engineering-from-scratch",
  "checks": [
    {
      "type": "binary",
      "name": "ai-engineering-from-scratch"
    }
  ],
  "install_guidance": {
    "plugin": "ai-engineering-from-scratch",
    "binary": "ai-engineering-from-scratch",
    "check": "which ai-engineering-from-scratch",
    "install_steps": [
      "pip install ai-engineering-from-scratch",
      "Verify: ai-engineering-from-scratch --version",
      "supercli plugins install ./plugins/ai-engineering-from-scratch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ai-engineering-from-scratch",
      "resource": "self",
      "action": "version",
      "description": "Print ai-engineering-from-scratch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ai-engineering-from-scratch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ai-engineering-from-scratch: pip install ai-engineering-from-scratch"
      },
      "args": []
    },
    {
      "namespace": "ai-engineering-from-scratch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ai-engineering-from-scratch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ai-engineering-from-scratch",
        "passthrough": true,
        "missingDependencyHelp": "Install ai-engineering-from-scratch: pip install ai-engineering-from-scratch"
      },
      "args": []
    }
  ]
}