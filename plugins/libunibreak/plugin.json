{
  "name": "libunibreak",
  "version": "0.1.0",
  "description": "Implementation of the Unicode line- and word-breaking algorithms",
  "source": "https://github.com/adah1972/libunibreak",
  "checks": [
    {
      "type": "binary",
      "name": "libunibreak"
    }
  ],
  "install_guidance": {
    "plugin": "libunibreak",
    "binary": "libunibreak",
    "check": "which libunibreak",
    "install_steps": [
      "brew install libunibreak",
      "Verify: libunibreak --version",
      "supercli plugins install ./plugins/libunibreak --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libunibreak",
      "resource": "self",
      "action": "version",
      "description": "Print libunibreak version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libunibreak",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libunibreak: brew install libunibreak"
      },
      "args": []
    },
    {
      "namespace": "libunibreak",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libunibreak CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libunibreak",
        "passthrough": true,
        "missingDependencyHelp": "Install libunibreak"
      },
      "args": []
    }
  ]
}