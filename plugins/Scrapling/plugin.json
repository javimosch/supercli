{
  "name": "Scrapling",
  "version": "0.1.0",
  "description": "\ud83d\udd77\ufe0f An adaptive Web Scraping framework that handles everything from a single request to a full-scale ",
  "source": "https://github.com/Scrapling/Scrapling",
  "checks": [
    {
      "type": "binary",
      "name": "scrapling"
    }
  ],
  "install_guidance": {
    "plugin": "Scrapling",
    "binary": "scrapling",
    "check": "which scrapling",
    "install_steps": [
      "pip install scrapling",
      "Verify: scrapling --version",
      "supercli plugins install ./plugins/Scrapling --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Scrapling",
      "resource": "self",
      "action": "version",
      "description": "Print Scrapling version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scrapling",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Scrapling: pip install scrapling"
      },
      "args": []
    },
    {
      "namespace": "Scrapling",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scrapling CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scrapling",
        "passthrough": true,
        "missingDependencyHelp": "Install Scrapling: pip install scrapling"
      },
      "args": []
    }
  ]
}