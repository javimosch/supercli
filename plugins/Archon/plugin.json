{
  "name": "Archon",
  "version": "0.1.0",
  "description": "The first open-source harness builder for AI coding. Make AI coding deterministic and repeatable.",
  "source": "https://github.com/Archon/Archon",
  "checks": [
    {
      "type": "binary",
      "name": "archon"
    }
  ],
  "install_guidance": {
    "plugin": "Archon",
    "binary": "archon",
    "check": "which archon",
    "install_steps": [
      "pip install archon",
      "Verify: archon --version",
      "supercli plugins install ./plugins/Archon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Archon",
      "resource": "self",
      "action": "version",
      "description": "Print Archon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "archon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Archon: pip install archon"
      },
      "args": []
    },
    {
      "namespace": "Archon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to archon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "archon",
        "passthrough": true,
        "missingDependencyHelp": "Install Archon: pip install archon"
      },
      "args": []
    }
  ]
}