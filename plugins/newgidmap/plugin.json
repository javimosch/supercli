{
  "name": "newgidmap",
  "version": "0.1.0",
  "description": "CLI tool: newgidmap",
  "source": "https://manpages.debian.org/newgidmap",
  "checks": [
    {
      "type": "binary",
      "name": "newgidmap"
    }
  ],
  "install_guidance": {
    "plugin": "newgidmap",
    "binary": "newgidmap",
    "check": "which newgidmap",
    "install_steps": [
      "apt-get install newgidmap 2>/dev/null || which newgidmap",
      "Verify: newgidmap --version",
      "supercli plugins install ./plugins/newgidmap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "newgidmap",
      "resource": "self",
      "action": "version",
      "description": "Print newgidmap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "newgidmap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install newgidmap: apt-get install newgidmap 2>/dev/null || which newgidmap"
      },
      "args": []
    },
    {
      "namespace": "newgidmap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to newgidmap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "newgidmap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install newgidmap: apt-get install newgidmap 2>/dev/null || which newgidmap"
      },
      "args": []
    }
  ]
}