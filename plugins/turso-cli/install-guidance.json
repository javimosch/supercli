{
  "plugin": "turso-cli",
  "binary": "turso",
  "check": "which turso",
  "install_steps": [
    "brew install tursodatabase/tap/turso",
    "Verify: turso --version",
    "supercli plugins install ./plugins/turso-cli --on-conflict replace --json"
  ],
  "note": "Requires auth: turso auth login or TURSO_API_TOKEN env var"
}
