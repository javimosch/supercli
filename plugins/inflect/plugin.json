{
  "name": "inflect",
  "version": "0.1.0",
  "description": "Generate plurals ordinals and article a/an forms",
  "source": "https://github.com/jaraco/inflect",
  "checks": [{ "type": "binary", "name": "inflect" }],
  "install_guidance": {
    "plugin": "inflect",
    "binary": "inflect",
    "check": "which inflect",
    "install_steps": ["pip install inflect", "Verify: inflect --version", "supercli plugins install ./plugins/inflect --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "inflect",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to inflect CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "inflect",
      "passthrough": true,
      "missingDependencyHelp": "Install inflect: pip install inflect", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
