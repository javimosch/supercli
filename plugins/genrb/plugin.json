{
  "name": "genrb",
  "version": "0.1.0",
  "description": "CLI tool: genrb",
  "source": "https://manpages.debian.org/genrb",
  "checks": [
    {
      "type": "binary",
      "name": "genrb"
    }
  ],
  "install_guidance": {
    "plugin": "genrb",
    "binary": "genrb",
    "check": "which genrb",
    "install_steps": [
      "apt-get install genrb 2>/dev/null || which genrb",
      "Verify: genrb --version",
      "supercli plugins install ./plugins/genrb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "genrb",
      "resource": "self",
      "action": "version",
      "description": "Print genrb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "genrb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install genrb: apt-get install genrb 2>/dev/null || which genrb"
      },
      "args": []
    },
    {
      "namespace": "genrb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to genrb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "genrb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install genrb: apt-get install genrb 2>/dev/null || which genrb"
      },
      "args": []
    }
  ]
}