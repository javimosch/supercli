{
  "name": "fatrace",
  "version": "1.0.0",
  "description": "fatrace \u2014 File access trace",
  "source": "github.com/martin-helmich/fatrace",
  "checks": [
    {
      "type": "binary",
      "name": "fatrace"
    }
  ],
  "install_guidance": {
    "plugin": "fatrace",
    "binary": "fatrace",
    "check": "which fatrace",
    "install_steps": [
      "# Install fatrace",
      "# See github.com/martin-helmich/fatrace",
      "# apt: sudo apt-get install fatrace",
      "# brew: brew install fatrace",
      "# cargo: cargo install fatrace",
      "# npm: npm install -g fatrace",
      "# pip: pip install fatrace"
    ]
  },
  "commands": [
    {
      "namespace": "fatrace",
      "resource": "fatrace",
      "action": "run",
      "description": "Run fatrace",
      "adapter": "process",
      "adapterConfig": {
        "command": "fatrace",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fatrace from github.com/martin-helmich/fatrace"
      },
      "args": []
    }
  ]
}