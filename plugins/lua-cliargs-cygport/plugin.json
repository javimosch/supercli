{
  "name": "lua-cliargs-cygport",
  "version": "0.1.0",
  "description": "A personal playground The upstream is https://github.com/amireh/lua_cliargs",
  "source": "https://github.com/lua-cliargs-cygport/lua-cliargs-cygport",
  "checks": [
    {
      "type": "binary",
      "name": "lua-cliargs-cygport"
    }
  ],
  "install_guidance": {
    "plugin": "lua-cliargs-cygport",
    "binary": "lua-cliargs-cygport",
    "check": "which lua-cliargs-cygport",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: lua-cliargs-cygport --version",
      "supercli plugins install ./plugins/lua-cliargs-cygport --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "lua-cliargs-cygport",
      "resource": "self",
      "action": "version",
      "description": "Print lua-cliargs-cygport version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lua-cliargs-cygport",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lua-cliargs-cygport from project repository"
      },
      "args": []
    },
    {
      "namespace": "lua-cliargs-cygport",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lua-cliargs-cygport CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lua-cliargs-cygport",
        "passthrough": true,
        "missingDependencyHelp": "Install lua-cliargs-cygport from project repository"
      },
      "args": []
    }
  ]
}