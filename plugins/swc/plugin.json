{
  "name": "swc",
  "version": "0.1.0",
  "description": "Fast Rust-based JS/TS compiler",
  "source": "https://github.com/swc-project/swc",
  "checks": [
    {
      "type": "binary",
      "name": "swc"
    }
  ],
  "install_guidance": {
    "plugin": "swc",
    "binary": "swc",
    "check": "which swc",
    "install_steps": [
      "npm install -g @swc/cli",
      "Verify: swc --version",
      "supercli plugins install ./plugins/swc --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "swc",
      "resource": "self",
      "action": "version",
      "description": "Print swc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "swc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install swc: npm install -g @swc/cli"
      },
      "args": []
    },
    {
      "namespace": "swc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to swc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "swc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install swc: npm install -g @swc/cli"
      },
      "args": []
    }
  ]
}
