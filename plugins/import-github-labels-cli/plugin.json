{
  "name": "import-github-labels-cli",
  "version": "0.1.0",
  "description": "Sync labels between Github repos",
  "source": "https://github.com/abhijithvijayan/import-github-labels-cli",
  "checks": [
    {
      "type": "binary",
      "name": "import-github-labels-cli"
    }
  ],
  "install_guidance": {
    "plugin": "import-github-labels-cli",
    "binary": "import-github-labels-cli",
    "check": "which import-github-labels-cli",
    "install_steps": [
      "See https://github.com/abhijithvijayan/import-github-labels-cli",
      "Verify: import-github-labels-cli --version",
      "supercli plugins install ./plugins/import-github-labels-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "import-github-labels-cli",
      "resource": "self",
      "action": "version",
      "description": "Print import-github-labels-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "import-github-labels-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install import-github-labels-cli: See https://github.com/abhijithvijayan/import-github-labels-cli"
      },
      "args": []
    },
    {
      "namespace": "import-github-labels-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to import-github-labels-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "import-github-labels-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install import-github-labels-cli"
      },
      "args": []
    }
  ]
}