{
  "name": "readme-gen",
  "version": "1.0.0",
  "description": "CLI that generates beautiful README.md files",
  "source": "https://github.com/kefranabg/readme-md-generator",
  "checks": [
    {
      "type": "binary",
      "name": "readme-md-generator"
    }
  ],
  "install_guidance": {
    "plugin": "readme-gen",
    "binary": "readme-md-generator",
    "check": "readme-md-generator --version",
    "install_steps": [
      "npm install -g readme-md-generator"
    ],
    "note": "Requires Node.js and npm. Installs globally as 'readme-md-generator'."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "readme-gen",
      "resource": "readme",
      "action": "generate",
      "description": "Generate a README.md via interactive questionnaire",
      "adapter": "process",
      "adapterConfig": {
        "command": "readme-md-generator",
        "missingDependencyHelp": "Install readme-md-generator: npm install -g readme-md-generator"
      },
      "args": []
    },
    {
      "namespace": "readme-gen",
      "resource": "self",
      "action": "version",
      "description": "Print readme-md-generator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "readme-md-generator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install readme-md-generator: npm install -g readme-md-generator"
      },
      "args": []
    },
    {
      "namespace": "readme-gen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to readme-md-generator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "readme-md-generator",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install readme-md-generator: npm install -g readme-md-generator"
      },
      "args": []
    }
  ]
}
