{
  "name": "yt-x",
  "version": "0.1.0",
  "description": "Posix script to browse youtube plus other yt-dlp supported sites from your terminal (fzf) or app lau",
  "source": "https://github.com/yt-x/yt-x",
  "checks": [
    {
      "type": "binary",
      "name": "yt-x"
    }
  ],
  "install_guidance": {
    "plugin": "yt-x",
    "binary": "yt-x",
    "check": "which yt-x",
    "install_steps": [
      "pip install yt-x",
      "Verify: yt-x --version",
      "supercli plugins install ./plugins/yt-x --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yt-x",
      "resource": "self",
      "action": "version",
      "description": "Print yt-x version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yt-x",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yt-x: pip install yt-x"
      },
      "args": []
    },
    {
      "namespace": "yt-x",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yt-x CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yt-x",
        "passthrough": true,
        "missingDependencyHelp": "Install yt-x: pip install yt-x"
      },
      "args": []
    }
  ]
}