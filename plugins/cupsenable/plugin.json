{
  "name": "cupsenable",
  "version": "0.1.0",
  "description": "Enable CUPS printers/classes",
  "source": "https://packages.debian.org/cupsenable",
  "checks": [{ "type": "binary", "name": "cupsenable" }],
  "install_guidance": {
    "plugin": "cupsenable", "binary": "cupsenable", "check": "which cupsenable",
    "install_steps": ["apt-get install cups", "Verify: cupsenable --version", "supercli plugins install ./plugins/cupsenable --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cupsenable", "resource": "_", "action": "_",
    "description": "Passthrough to cupsenable CLI",
    "adapter": "process", "adapterConfig": { "command": "cupsenable", "passthrough": true, "missingDependencyHelp": "Install cupsenable: apt-get install cups" }, "args": []
  }]
}
