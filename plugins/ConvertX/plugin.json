{
  "name": "ConvertX",
  "version": "0.1.0",
  "description": "\ud83d\udcbe Self-hosted online file converter. Supports 1000+ formats \u2699\ufe0f",
  "source": "https://github.com/ConvertX/ConvertX",
  "checks": [
    {
      "type": "binary",
      "name": "convertx"
    }
  ],
  "install_guidance": {
    "plugin": "ConvertX",
    "binary": "convertx",
    "check": "which convertx",
    "install_steps": [
      "pip install convertx",
      "Verify: convertx --version",
      "supercli plugins install ./plugins/ConvertX --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ConvertX",
      "resource": "self",
      "action": "version",
      "description": "Print ConvertX version",
      "adapter": "process",
      "adapterConfig": {
        "command": "convertx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ConvertX: pip install convertx"
      },
      "args": []
    },
    {
      "namespace": "ConvertX",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to convertx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "convertx",
        "passthrough": true,
        "missingDependencyHelp": "Install ConvertX: pip install convertx"
      },
      "args": []
    }
  ]
}