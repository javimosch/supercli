{
  "name": "dvilj2p",
  "version": "0.1.0",
  "description": "CLI tool: dvilj2p",
  "source": "https://manpages.debian.org/dvilj2p",
  "checks": [
    {
      "type": "binary",
      "name": "dvilj2p"
    }
  ],
  "install_guidance": {
    "plugin": "dvilj2p",
    "binary": "dvilj2p",
    "check": "which dvilj2p",
    "install_steps": [
      "apt-get install dvilj2p 2>/dev/null || which dvilj2p",
      "Verify: dvilj2p --version",
      "supercli plugins install ./plugins/dvilj2p --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvilj2p",
      "resource": "self",
      "action": "version",
      "description": "Print dvilj2p version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj2p",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvilj2p: apt-get install dvilj2p 2>/dev/null || which dvilj2p"
      },
      "args": []
    },
    {
      "namespace": "dvilj2p",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvilj2p CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj2p",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvilj2p: apt-get install dvilj2p 2>/dev/null || which dvilj2p"
      },
      "args": []
    }
  ]
}