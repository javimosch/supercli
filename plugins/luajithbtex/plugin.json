{
  "name": "luajithbtex",
  "version": "0.1.0",
  "description": "CLI tool: luajithbtex",
  "source": "https://manpages.debian.org/luajithbtex",
  "checks": [
    {
      "type": "binary",
      "name": "luajithbtex"
    }
  ],
  "install_guidance": {
    "plugin": "luajithbtex",
    "binary": "luajithbtex",
    "check": "which luajithbtex",
    "install_steps": [
      "apt-get install luajithbtex 2>/dev/null || which luajithbtex",
      "Verify: luajithbtex --version",
      "supercli plugins install ./plugins/luajithbtex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "luajithbtex",
      "resource": "self",
      "action": "version",
      "description": "Print luajithbtex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "luajithbtex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install luajithbtex: apt-get install luajithbtex 2>/dev/null || which luajithbtex"
      },
      "args": []
    },
    {
      "namespace": "luajithbtex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to luajithbtex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "luajithbtex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install luajithbtex: apt-get install luajithbtex 2>/dev/null || which luajithbtex"
      },
      "args": []
    }
  ]
}