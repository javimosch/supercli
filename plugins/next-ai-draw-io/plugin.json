{
  "name": "next-ai-draw-io",
  "version": "0.1.0",
  "description": "A next.js web application that integrates AI capabilities with draw.io diagrams. This app allows you",
  "source": "https://github.com/next-ai-draw-io/next-ai-draw-io",
  "checks": [
    {
      "type": "binary",
      "name": "next-ai-draw-io"
    }
  ],
  "install_guidance": {
    "plugin": "next-ai-draw-io",
    "binary": "next-ai-draw-io",
    "check": "which next-ai-draw-io",
    "install_steps": [
      "pip install next-ai-draw-io",
      "Verify: next-ai-draw-io --version",
      "supercli plugins install ./plugins/next-ai-draw-io --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "next-ai-draw-io",
      "resource": "self",
      "action": "version",
      "description": "Print next-ai-draw-io version",
      "adapter": "process",
      "adapterConfig": {
        "command": "next-ai-draw-io",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install next-ai-draw-io: pip install next-ai-draw-io"
      },
      "args": []
    },
    {
      "namespace": "next-ai-draw-io",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to next-ai-draw-io CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "next-ai-draw-io",
        "passthrough": true,
        "missingDependencyHelp": "Install next-ai-draw-io: pip install next-ai-draw-io"
      },
      "args": []
    }
  ]
}