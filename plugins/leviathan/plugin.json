{
  "name": "leviathan",
  "version": "0.1.0",
  "description": "A lightning-fast Zig-powered event loop for Python's asyncio.",
  "source": "https://github.com/leviathan/leviathan",
  "checks": [
    {
      "type": "binary",
      "name": "leviathan"
    }
  ],
  "install_guidance": {
    "plugin": "leviathan",
    "binary": "leviathan",
    "check": "which leviathan",
    "install_steps": [
      "pip install leviathan",
      "Verify: leviathan --version",
      "supercli plugins install ./plugins/leviathan --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "leviathan",
      "resource": "self",
      "action": "version",
      "description": "Print leviathan version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leviathan",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install leviathan: pip install leviathan"
      },
      "args": []
    },
    {
      "namespace": "leviathan",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leviathan CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leviathan",
        "passthrough": true,
        "missingDependencyHelp": "Install leviathan: pip install leviathan"
      },
      "args": []
    }
  ]
}