{
  "name": "gosec",
  "version": "0.1.0",
  "description": "Go security checker that inspects source code for vulnerabilities",
  "source": "https://github.com/securecodewarrior/gosec",
  "checks": [{ "type": "binary", "name": "gosec" }],
  "install_guidance": {
    "plugin": "gosec",
    "binary": "gosec",
    "check": "which gosec",
    "install_steps": ["go install github.com/securecodewarrior/gosec/v2/cmd/gosec@latest", "Verify: gosec --version", "supercli plugins install ./plugins/gosec --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gosec",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gosec CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gosec",
      "passthrough": true,
      "missingDependencyHelp": "Install gosec: go install github.com/securecodewarrior/gosec/v2/cmd/gosec@latest"
    },
    "args": []
  }]
}
