{
  "name": "gosec",
  "version": "0.1.0",
  "description": "gosec — Go security checker for finding vulnerabilities in code",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "gosec"
    }
  ],
  "install_guidance": {
    "plugin": "gosec",
    "binary": "gosec",
    "check": "which gosec",
