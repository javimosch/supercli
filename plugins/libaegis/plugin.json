{
  "name": "libaegis",
  "version": "0.1.0",
  "description": "Portable C implementations of the AEGIS family of encryption algorithms",
  "source": "https://github.com/aegis-aead/libaegis",
  "checks": [
    {
      "type": "binary",
      "name": "libaegis"
    }
  ],
  "install_guidance": {
    "plugin": "libaegis",
    "binary": "libaegis",
    "check": "which libaegis",
    "install_steps": [
      "brew install libaegis",
      "Verify: libaegis --version",
      "supercli plugins install ./plugins/libaegis --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libaegis",
      "resource": "self",
      "action": "version",
      "description": "Print libaegis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libaegis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libaegis: brew install libaegis"
      },
      "args": []
    },
    {
      "namespace": "libaegis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libaegis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libaegis",
        "passthrough": true,
        "missingDependencyHelp": "Install libaegis"
      },
      "args": []
    }
  ]
}