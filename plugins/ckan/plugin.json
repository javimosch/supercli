{
  "name": "ckan",
  "version": "0.1.0",
  "description": "Comprehensive Kerbal Archive Network",
  "source": "https://github.com/KSP-CKAN/CKAN/",
  "checks": [
    {
      "type": "binary",
      "name": "ckan"
    }
  ],
  "install_guidance": {
    "plugin": "ckan",
    "binary": "ckan",
    "check": "which ckan",
    "install_steps": [
      "brew install ckan",
      "Verify: ckan --version",
      "supercli plugins install ./plugins/ckan --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ckan",
      "resource": "self",
      "action": "version",
      "description": "Print ckan version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ckan",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ckan: brew install ckan"
      },
      "args": []
    },
    {
      "namespace": "ckan",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ckan CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ckan",
        "passthrough": true,
        "missingDependencyHelp": "Install ckan"
      },
      "args": []
    }
  ]
}