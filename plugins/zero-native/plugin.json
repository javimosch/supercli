{
  "name": "zero-native",
  "version": "0.1.0",
  "description": "Build desktop + mobile apps with Zig and web UI",
  "source": "https://github.com/zero-native/zero-native",
  "checks": [
    {
      "type": "binary",
      "name": "zero-native"
    }
  ],
  "install_guidance": {
    "plugin": "zero-native",
    "binary": "zero-native",
    "check": "which zero-native",
    "install_steps": [
      "pip install zero-native",
      "Verify: zero-native --version",
      "supercli plugins install ./plugins/zero-native --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zero-native",
      "resource": "self",
      "action": "version",
      "description": "Print zero-native version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zero-native",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zero-native: pip install zero-native"
      },
      "args": []
    },
    {
      "namespace": "zero-native",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zero-native CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zero-native",
        "passthrough": true,
        "missingDependencyHelp": "Install zero-native: pip install zero-native"
      },
      "args": []
    }
  ]
}