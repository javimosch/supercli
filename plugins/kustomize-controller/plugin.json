{
  "name": "kustomize-controller",
  "version": "0.1.0",
  "description": "Kustomize-aware controller for Flux CD",
  "source": "https://github.com/fluxcd/kustomize-controller",
  "checks": [{ "type": "binary", "name": "kustomize-controller" }],
  "install_guidance": {
    "plugin": "kustomize-controller",
    "binary": "kustomize-controller",
    "check": "which kustomize-controller",
    "install_steps": ["brew install kustomize-controller", "Verify: kustomize-controller --version", "supercli plugins install ./plugins/kustomize-controller --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kustomize-controller",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kustomize-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kustomize-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install kustomize-controller: brew install kustomize-controller"
    },
    "args": []
  }]
}
