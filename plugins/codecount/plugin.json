{
  "name": "codecount",
  "version": "0.1.0",
  "description": "Simple code line counter for multiple languages",
  "source": "https://github.com/lambdalisue/codecount",
  "checks": [{ "type": "binary", "name": "codecount" }],
  "install_guidance": {
    "plugin": "codecount",
    "binary": "codecount",
    "check": "which codecount",
    "install_steps": ["pip install codecount", "Verify: codecount --version", "supercli plugins install ./plugins/codecount --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "codecount",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to codecount CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "codecount",
      "passthrough": true,
      "missingDependencyHelp": "Install codecount: pip install codecount", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
