{
  "name": "agent",
  "version": "0.1.0",
  "description": "CLI tool: agent",
  "source": "https://packages.debian.org/agent",
  "checks": [{ "type": "binary", "name": "agent" }],
  "install_guidance": {
    "plugin": "agent", "binary": "agent", "check": "which agent",
    "install_steps": ["apt-get install agent 2>/dev/null || which agent", "Verify: agent --version", "supercli plugins install ./plugins/agent --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "agent", "resource": "_", "action": "_",
    "description": "Passthrough to agent CLI",
    "adapter": "process", "adapterConfig": { "command": "agent", "passthrough": true, "missingDependencyHelp": "Install agent: apt-get install agent" }, "args": []
  }]
}
