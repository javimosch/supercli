{
  "name": "claude-code-router",
  "version": "0.1.0",
  "description": "Use Claude Code as the foundation for coding infrastructure, allowing you to decide how to interact ",
  "source": "https://github.com/claude-code-router/claude-code-router",
  "checks": [
    {
      "type": "binary",
      "name": "claude-code-router"
    }
  ],
  "install_guidance": {
    "plugin": "claude-code-router",
    "binary": "claude-code-router",
    "check": "which claude-code-router",
    "install_steps": [
      "pip install claude-code-router",
      "Verify: claude-code-router --version",
      "supercli plugins install ./plugins/claude-code-router --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-code-router",
      "resource": "self",
      "action": "version",
      "description": "Print claude-code-router version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-router",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-code-router: pip install claude-code-router"
      },
      "args": []
    },
    {
      "namespace": "claude-code-router",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-code-router CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-router",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-code-router: pip install claude-code-router"
      },
      "args": []
    }
  ]
}