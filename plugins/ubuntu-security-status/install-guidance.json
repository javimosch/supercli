{
  "plugin": "ubuntu-security-status",
  "binary": "ubuntu-security-status",
  "check": "which ubuntu-security-status",
  "install_steps": [
    "apt-get install ubuntu-security-status 2>/dev/null || which ubuntu-security-status",
    "Verify: ubuntu-security-status --version",
    "supercli plugins install ./plugins/ubuntu-security-status --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}