{
  "name": "dh_strip",
  "version": "0.1.0",
  "description": "CLI tool: dh_strip",
  "source": "https://packages.debian.org/dh_strip",
  "checks": [{ "type": "binary", "name": "dh_strip" }],
  "install_guidance": {
    "plugin": "dh_strip", "binary": "dh_strip", "check": "which dh_strip",
    "install_steps": ["apt-get install dh_strip 2>/dev/null || which dh_strip", "Verify: dh_strip --version", "supercli plugins install ./plugins/dh_strip --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_strip", "resource": "_", "action": "_",
    "description": "Passthrough to dh_strip CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_strip", "passthrough": true, "missingDependencyHelp": "Install dh_strip: apt-get install dh_strip" }, "args": []
  }]
}
