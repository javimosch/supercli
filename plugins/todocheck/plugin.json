{
  "name": "todocheck",
  "version": "0.1.0",
  "description": "Static code analyzer for annotated TODO comments.",
  "source": "https://github.com/preslavmihaylov/todocheck",
  "checks": [
    {
      "type": "binary",
      "name": "todocheck"
    }
  ],
  "install_guidance": {
    "plugin": "todocheck",
    "binary": "todocheck",
    "check": "which todocheck",
    "install_steps": [
      "See https://github.com/preslavmihaylov/todocheck",
      "Verify: todocheck --version",
      "supercli plugins install ./plugins/todocheck --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "todocheck",
      "resource": "self",
      "action": "version",
      "description": "Print todocheck version",
      "adapter": "process",
      "adapterConfig": {
        "command": "todocheck",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install todocheck: See https://github.com/preslavmihaylov/todocheck"
      },
      "args": []
    },
    {
      "namespace": "todocheck",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to todocheck CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "todocheck",
        "passthrough": true,
        "missingDependencyHelp": "Install todocheck"
      },
      "args": []
    }
  ]
}