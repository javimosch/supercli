{
  "name": "afmtodit",
  "version": "0.1.0",
  "description": "CLI tool: afmtodit",
  "source": "https://packages.debian.org/afmtodit",
  "checks": [{ "type": "binary", "name": "afmtodit" }],
  "install_guidance": {
    "plugin": "afmtodit", "binary": "afmtodit", "check": "which afmtodit",
    "install_steps": ["apt-get install afmtodit 2>/dev/null || which afmtodit", "Verify: afmtodit --version", "supercli plugins install ./plugins/afmtodit --on-conflict replace --json"]
