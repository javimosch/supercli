  "commands": [{
    "namespace": "afmtodit", "resource": "_", "action": "_",
    "description": "Passthrough to afmtodit CLI",
    "adapter": "process", "adapterConfig": { "command": "afmtodit", "passthrough": true, "missingDependencyHelp": "Install afmtodit: apt-get install afmtodit" }, "args": []
  }]
}
