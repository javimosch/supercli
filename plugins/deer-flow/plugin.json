{
  "name": "deer-flow",
  "version": "0.1.0",
  "description": "An open-source long-horizon SuperAgent harness that researches, codes, and creates. With the help of",
  "source": "https://github.com/deer-flow/deer-flow",
  "checks": [
    {
      "type": "binary",
      "name": "deer-flow"
    }
  ],
  "install_guidance": {
    "plugin": "deer-flow",
    "binary": "deer-flow",
    "check": "which deer-flow",
    "install_steps": [
      "pip install deer-flow",
      "Verify: deer-flow --version",
      "supercli plugins install ./plugins/deer-flow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "deer-flow",
      "resource": "self",
      "action": "version",
      "description": "Print deer-flow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deer-flow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install deer-flow: pip install deer-flow"
      },
      "args": []
    },
    {
      "namespace": "deer-flow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deer-flow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deer-flow",
        "passthrough": true,
        "missingDependencyHelp": "Install deer-flow: pip install deer-flow"
      },
      "args": []
    }
  ]
}