{
  "name": "lspcmcia",
  "version": "0.1.0",
  "description": "CLI tool: lspcmcia",
  "source": "https://manpages.debian.org/lspcmcia",
  "checks": [
    {
      "type": "binary",
      "name": "lspcmcia"
    }
  ],
  "install_guidance": {
    "plugin": "lspcmcia",
    "binary": "lspcmcia",
    "check": "which lspcmcia",
    "install_steps": [
      "apt-get install lspcmcia 2>/dev/null || which lspcmcia",
      "Verify: lspcmcia --version",
      "supercli plugins install ./plugins/lspcmcia --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lspcmcia",
      "resource": "self",
      "action": "version",
      "description": "Print lspcmcia version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lspcmcia",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lspcmcia: apt-get install lspcmcia 2>/dev/null || which lspcmcia"
      },
      "args": []
    },
    {
      "namespace": "lspcmcia",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lspcmcia CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lspcmcia",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lspcmcia: apt-get install lspcmcia 2>/dev/null || which lspcmcia"
      },
      "args": []
    }
  ]
}