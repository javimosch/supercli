{
  "name": "hprof-conv",
  "version": "0.1.0",
  "description": "CLI tool: hprof-conv",
  "source": "https://manpages.debian.org/hprof-conv",
  "checks": [
    {
      "type": "binary",
      "name": "hprof-conv"
    }
  ],
  "install_guidance": {
    "plugin": "hprof-conv",
    "binary": "hprof-conv",
    "check": "which hprof-conv",
    "install_steps": [
      "apt-get install hprof-conv 2>/dev/null || which hprof-conv",
      "Verify: hprof-conv --version",
      "supercli plugins install ./plugins/hprof-conv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hprof-conv",
      "resource": "self",
      "action": "version",
      "description": "Print hprof-conv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hprof-conv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hprof-conv: apt-get install hprof-conv 2>/dev/null || which hprof-conv"
      },
      "args": []
    },
    {
      "namespace": "hprof-conv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hprof-conv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hprof-conv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hprof-conv: apt-get install hprof-conv 2>/dev/null || which hprof-conv"
      },
      "args": []
    }
  ]
}