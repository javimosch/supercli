{
  "name": "wcount",
  "version": "0.1.0",
  "description": "Fast word counting alternative for text files",
  "source": "https://github.com/kbknapp/wcount",
  "checks": [{ "type": "binary", "name": "wcount" }],
  "install_guidance": {
    "plugin": "wcount",
    "binary": "wcount",
    "check": "which wcount",
    "install_steps": ["cargo install wcount", "Verify: wcount --version", "supercli plugins install ./plugins/wcount --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wcount",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wcount CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wcount",
      "passthrough": true,
      "missingDependencyHelp": "Install wcount: cargo install wcount", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
