{
  "name": "nom",
  "version": "0.1.0",
  "description": "nom — parser combinator library for Rust",
  "source": "https://github.com/rust-bakery/nom",
  "checks": [
    {
      "type": "binary",
      "name": "nom"
    }
  ],
  "install_guidance": {
    "plugin": "nom",
    "binary": "nom",
    "check": "which nom",
    "install_steps": [
      "cargo add nom",
      "Verify: nom --version",
      "supercli plugins install ./plugins/nom --on-conflict replace --json"
    ],
    "note": "nom is a Rust parser-combinator library — use `cargo add nom` inside a Rust project."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nom",
      "resource": "self",
      "action": "version",
      "description": "Print nom version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nom",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install nom: cargo add nom"
      },
      "args": []
    }
  ]
}
