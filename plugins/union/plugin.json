{
  "name": "union",
  "version": "0.1.0",
  "description": "The trust-minimized, zero-knowledge bridging protocol, designed for censorship resistance, extremely",
  "source": "https://github.com/union/union",
  "checks": [
    {
      "type": "binary",
      "name": "union"
    }
  ],
  "install_guidance": {
    "plugin": "union",
    "binary": "union",
    "check": "which union",
    "install_steps": [
      "pip install union",
      "Verify: union --version",
      "supercli plugins install ./plugins/union --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "union",
      "resource": "self",
      "action": "version",
      "description": "Print union version",
      "adapter": "process",
      "adapterConfig": {
        "command": "union",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install union: pip install union"
      },
      "args": []
    },
    {
      "namespace": "union",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to union CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "union",
        "passthrough": true,
        "missingDependencyHelp": "Install union: pip install union"
      },
      "args": []
    }
  ]
}