{
  "name": "bar",
  "version": "0.1.0",
  "description": "Simple progress bar for shell pipelines and command output",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "bar" }],
  "install_guidance": {
    "plugin": "bar",
    "binary": "bar",
    "check": "which bar",
    "install_steps": ["sudo apt install bar", "Verify: bar --version", "supercli plugins install ./plugins/bar --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bar",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bar CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bar",
      "passthrough": true,
      "missingDependencyHelp": "Install bar: sudo apt install bar"
    },
    "args": []
  }]
}
