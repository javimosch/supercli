{
  "name": "progressline",
  "version": "0.1.0",
  "description": "Show progress of processes through pipelines",
  "source": "https://github.com/nvbn/progressline",
  "checks": [{ "type": "binary", "name": "progressline" }],
  "install_guidance": {
    "plugin": "progressline",
    "binary": "progressline",
    "check": "which progressline",
    "install_steps": ["pip install progressline", "Verify: progressline --version", "supercli plugins install ./plugins/progressline --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "progressline",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to progressline CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "progressline",
      "passthrough": true,
      "missingDependencyHelp": "Install progressline: pip install progressline", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
