{
  "name": "RustTraining",
  "version": "0.1.0",
  "description": "Beginner, advanced, expert level Rust training material",
  "source": "https://github.com/RustTraining/RustTraining",
  "checks": [
    {
      "type": "binary",
      "name": "rusttraining"
    }
  ],
  "install_guidance": {
    "plugin": "RustTraining",
    "binary": "rusttraining",
    "check": "which rusttraining",
    "install_steps": [
      "pip install rusttraining",
      "Verify: rusttraining --version",
      "supercli plugins install ./plugins/RustTraining --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RustTraining",
      "resource": "self",
      "action": "version",
      "description": "Print RustTraining version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rusttraining",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RustTraining: pip install rusttraining"
      },
      "args": []
    },
    {
      "namespace": "RustTraining",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rusttraining CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rusttraining",
        "passthrough": true,
        "missingDependencyHelp": "Install RustTraining: pip install rusttraining"
      },
      "args": []
    }
  ]
}