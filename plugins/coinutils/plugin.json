{
  "name": "coinutils",
  "version": "0.1.0",
  "description": "COIN-OR utilities",
  "source": "https://github.com/coin-or/CoinUtils",
  "checks": [
    {
      "type": "binary",
      "name": "coinutils"
    }
  ],
  "install_guidance": {
    "plugin": "coinutils",
    "binary": "coinutils",
    "check": "which coinutils",
    "install_steps": [
      "brew install coinutils",
      "Verify: coinutils --version",
      "supercli plugins install ./plugins/coinutils --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "coinutils",
      "resource": "self",
      "action": "version",
      "description": "Print coinutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coinutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coinutils: brew install coinutils"
      },
      "args": []
    },
    {
      "namespace": "coinutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coinutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coinutils",
        "passthrough": true,
        "missingDependencyHelp": "Install coinutils"
      },
      "args": []
    }
  ]
}