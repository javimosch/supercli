{
  "name": "lft.db",
  "version": "0.1.0",
  "description": "CLI tool: lft.db",
  "source": "https://manpages.debian.org/lft.db",
  "checks": [
    {
      "type": "binary",
      "name": "lft.db"
    }
  ],
  "install_guidance": {
    "plugin": "lft.db",
    "binary": "lft.db",
    "check": "which lft.db",
    "install_steps": [
      "apt-get install lft.db 2>/dev/null || which lft.db",
      "Verify: lft.db --version",
      "supercli plugins install ./plugins/lft.db --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lft.db",
      "resource": "self",
      "action": "version",
      "description": "Print lft.db version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lft.db",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lft.db: apt-get install lft.db 2>/dev/null || which lft.db"
      },
      "args": []
    },
    {
      "namespace": "lft.db",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lft.db CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lft.db",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lft.db: apt-get install lft.db 2>/dev/null || which lft.db"
      },
      "args": []
    }
  ]
}