{
  "name": "qtplugininfo",
  "version": "0.1.0",
  "description": "CLI tool: qtplugininfo",
  "source": "https://manpages.debian.org/qtplugininfo",
  "checks": [
    {
      "type": "binary",
      "name": "qtplugininfo"
    }
  ],
  "install_guidance": {
    "plugin": "qtplugininfo",
    "binary": "qtplugininfo",
    "check": "which qtplugininfo",
    "install_steps": [
      "apt-get install qtplugininfo 2>/dev/null || which qtplugininfo",
      "Verify: qtplugininfo --version",
      "supercli plugins install ./plugins/qtplugininfo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qtplugininfo",
      "resource": "self",
      "action": "version",
      "description": "Print qtplugininfo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qtplugininfo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qtplugininfo: apt-get install qtplugininfo 2>/dev/null || which qtplugininfo"
      },
      "args": []
    },
    {
      "namespace": "qtplugininfo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qtplugininfo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qtplugininfo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qtplugininfo: apt-get install qtplugininfo 2>/dev/null || which qtplugininfo"
      },
      "args": []
    }
  ]
}