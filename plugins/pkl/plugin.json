{
  "name": "pkl",
  "version": "0.1.0",
  "description": "A configuration as code language with rich validation and tooling.",
  "source": "https://github.com/pkl/pkl",
  "checks": [
    {
      "type": "binary",
      "name": "pkl"
    }
  ],
  "install_guidance": {
    "plugin": "pkl",
    "binary": "pkl",
    "check": "which pkl",
    "install_steps": [
      "pip install pkl",
      "Verify: pkl --version",
      "supercli plugins install ./plugins/pkl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pkl",
      "resource": "self",
      "action": "version",
      "description": "Print pkl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pkl: pip install pkl"
      },
      "args": []
    },
    {
      "namespace": "pkl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pkl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkl",
        "passthrough": true,
        "missingDependencyHelp": "Install pkl: pip install pkl"
      },
      "args": []
    }
  ]
}