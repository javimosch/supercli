{
  "name": "boilerplate",
  "version": "0.1.0",
  "description": "Generate code from templates using Go templates",
  "source": "https://github.com/gruntwork-io/boilerplate",
  "checks": [{ "type": "binary", "name": "gruntwork-boilerplate" }],
  "install_guidance": {
    "plugin": "boilerplate",
    "binary": "gruntwork-boilerplate",
    "check": "which gruntwork-boilerplate",
    "install_steps": ["brew install boilerplate", "Verify: gruntwork-boilerplate --version", "supercli plugins install ./plugins/boilerplate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "boilerplate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gruntwork-boilerplate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gruntwork-boilerplate",
      "passthrough": true,
      "missingDependencyHelp": "Install boilerplate: brew install boilerplate"
    },
    "args": []
  }]
}
