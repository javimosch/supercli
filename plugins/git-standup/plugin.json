{
  "name": "git-standup",
  "version": "0.1.0",
  "description": "Recall what you did last working day",
  "source": "https://github.com/kamranahmedse/git-standup",
  "checks": [
    {
      "type": "binary",
      "name": "git-standup"
    }
  ],
  "install_guidance": {
    "plugin": "git-standup",
    "binary": "git-standup",
    "check": "which git-standup",
    "install_steps": [
      "brew install git-standup",
      "Verify: git-standup --version",
      "supercli plugins install ./plugins/git-standup --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "git-standup",
      "resource": "self",
      "action": "version",
      "description": "Print git-standup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-standup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-standup: brew install git-standup"
      },
      "args": []
    },
    {
      "namespace": "git-standup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-standup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-standup",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install git-standup: brew install git-standup"
      },
      "args": []
    }
  ]
}
