{
  "name": "git-standup",
  "version": "0.1.0",
  "description": "Recall what you did on the last working day",
  "source": "https://github.com/kamranahmedse/git-standup",
  "checks": [{ "type": "binary", "name": "git-standup" }],
  "install_guidance": {
    "plugin": "git-standup",
    "binary": "git-standup",
    "check": "which git-standup",
    "install_steps": ["npm install -g git-standup", "Verify: git-standup --version", "supercli plugins install ./plugins/git-standup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-standup",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-standup CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-standup",
      "passthrough": true,
      "missingDependencyHelp": "Install git-standup: npm install -g git-standup"
    },
    "args": []
  }]
}
