{
  "name": "opencloud",
  "version": "0.1.0",
  "description": "\ud83c\udf24\ufe0f OpenCloud is the open source platform for file management, sharing and collaboration. Simple and ",
  "source": "https://github.com/opencloud/opencloud",
  "checks": [
    {
      "type": "binary",
      "name": "opencloud"
    }
  ],
  "install_guidance": {
    "plugin": "opencloud",
    "binary": "opencloud",
    "check": "which opencloud",
    "install_steps": [
      "pip install opencloud",
      "Verify: opencloud --version",
      "supercli plugins install ./plugins/opencloud --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "opencloud",
      "resource": "self",
      "action": "version",
      "description": "Print opencloud version",
      "adapter": "process",
      "adapterConfig": {
        "command": "opencloud",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install opencloud: pip install opencloud"
      },
      "args": []
    },
    {
      "namespace": "opencloud",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to opencloud CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "opencloud",
        "passthrough": true,
        "missingDependencyHelp": "Install opencloud: pip install opencloud"
      },
      "args": []
    }
  ]
}