{
  "name": "opencloud",
  "version": "0.1.0",
  "description": "Open source platform for file management, sharing and collaboration",
  "source": "https://github.com/opencloud-eu/opencloud",
  "checks": [
    {
      "type": "binary",
      "name": "opencloud"
    }
  ],
  "install_guidance": {
    "plugin": "opencloud",
    "binary": "opencloud",
    "check": "which opencloud",
    "install_steps": [
      "go install github.com/opencloud-eu/opencloud@latest",
      "Verify: opencloud --version",
      "supercli plugins install ./plugins/opencloud --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "opencloud",
    "resource": "self",
    "action": "version",
    "description": "Print opencloud version",
    "adapter": "process",
    "adapterConfig": {
      "command": "opencloud",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install opencloud: go install github.com/opencloud-eu/opencloud@latest"
    },
    "args": []
  },
  {
    "namespace": "opencloud",
    "resource": "server",
    "action": "start",
    "description": "Start the OpenCloud server",
    "adapter": "process",
    "adapterConfig": {
      "command": "opencloud",
      "passthrough": true,
      "missingDependencyHelp": "Install opencloud: go install github.com/opencloud-eu/opencloud@latest"
    },
    "args": []
  },
  {
    "namespace": "opencloud",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to opencloud CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "opencloud",
      "passthrough": true,
      "missingDependencyHelp": "Install opencloud"
    },
    "args": []
  }
]
}