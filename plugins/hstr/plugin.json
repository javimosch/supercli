{
  "name": "hstr",
  "version": "0.1.0",
  "description": "Shell history suggest box — easily view, navigate, search, and manage your bash and zsh command history.",
  "source": "https://github.com/dvorka-oss/hstr",
  "checks": [
    { "type": "binary", "name": "hstr" }
  ],
  "install_guidance": {
    "plugin": "hstr",
    "binary": "hstr",
    "check": "which hstr",
    "install_steps": [
      "brew install hstr",
      "sudo apt install hstr",
      "sudo dnf install hstr",
      "Verify: hstr --version",
      "supercli plugins install ./plugins/hstr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hstr",
      "resource": "history",
      "action": "search",
      "description": "Open interactive history search TUI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hstr",
        "baseArgs": [],
        "missingDependencyHelp": "Install hstr: brew install hstr"
      },
      "args": [
        { "name": "--non-interactive", "type": "boolean", "description": "Print matching history items to stdout without TUI" },
        { "name": "--keywords", "type": "string", "description": "Comma-separated keywords to search for (non-interactive mode)" }
      ]
    },
    {
      "namespace": "hstr",
      "resource": "config",
      "action": "bash",
      "description": "Show bash configuration snippet for hstr integration",
      "adapter": "process",
      "adapterConfig": {
        "command": "hstr",
        "baseArgs": ["--show-bash-configuration"],
        "missingDependencyHelp": "Install hstr: brew install hstr"
      },
      "args": []
    },
    {
      "namespace": "hstr",
      "resource": "config",
      "action": "zsh",
      "description": "Show zsh configuration snippet for hstr integration",
      "adapter": "process",
      "adapterConfig": {
        "command": "hstr",
        "baseArgs": ["--show-zsh-configuration"],
        "missingDependencyHelp": "Install hstr: brew install hstr"
      },
      "args": []
    },
    {
      "namespace": "hstr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hstr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hstr",
        "passthrough": true,
        "missingDependencyHelp": "Install hstr: brew install hstr"
      },
      "args": []
    }
  ]
}
