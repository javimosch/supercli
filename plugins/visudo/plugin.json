{
  "name": "visudo",
  "version": "0.1.0",
  "description": "visudo — safely edit the sudoers file with syntax validation",
  "source": "https",
  "checks": [{"type": "binary", "name": "visudo"}],
  "install_guidance": {
    "plugin": "visudo",
    "binary": "visudo",
    "check": "which visudo",
    "install_steps": [
      "apt-get install sudo",
      "Verify: visudo --version",
      "supercli plugins install ./plugins/visudo --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "visudo",
      "resource": "self",
      "action": "version",
      "description": "Print visudo version",
      "adapter": "process",
      "adapterConfig": {"command": "visudo", "baseArgs": ["--version"], "missingDependencyHelp": "Install visudo: apt-get install sudo"},
      "args": []
    },
    {
      "namespace": "visudo",
      "resource": "file",
      "action": "check",
      "description": "Check sudoers file syntax without editing",
      "adapter": "process",
      "adapterConfig": {"command": "visudo", "baseArgs": ["-c", "-f"], "missingDependencyHelp": "Install visudo: apt-get install sudo"},
      "args": [
        {"name": "file", "type": "string", "required": true, "description": "Path to sudoers file to check"}
      ]
    },
    {
      "namespace": "visudo",
      "resource": "file",
      "action": "edit",
      "description": "Edit a specific sudoers file",
      "adapter": "process",
      "adapterConfig": {"command": "visudo", "baseArgs": ["-f"], "missingDependencyHelp": "Install visudo: apt-get install sudo"},
      "args": [
        {"name": "file", "type": "string", "required": true, "description": "Path to sudoers file to edit"}
      ]
    },
    {
      "namespace": "visudo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to visudo CLI",
      "adapter": "process",
      "adapterConfig": {"command": "visudo", "passthrough": true, "missingDependencyHelp": "Install visudo: apt-get install sudo"},
      "args": []
    }
  ]
}
