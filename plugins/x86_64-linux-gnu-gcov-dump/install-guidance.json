{
  "plugin": "x86_64-linux-gnu-gcov-dump",
  "binary": "x86_64-linux-gnu-gcov-dump",
  "check": "which x86_64-linux-gnu-gcov-dump",
  "install_steps": [
    "apt-get install x86_64-linux-gnu-gcov-dump 2>/dev/null || which x86_64-linux-gnu-gcov-dump",
