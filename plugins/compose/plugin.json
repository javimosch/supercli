{
  "name": "compose",
  "version": "0.1.0",
  "description": "CLI tool: compose",
  "source": "https://packages.debian.org/compose",
  "checks": [{ "type": "binary", "name": "compose" }],
  "install_guidance": {
    "plugin": "compose", "binary": "compose", "check": "which compose",
    "install_steps": ["apt-get install compose 2>/dev/null || which compose", "Verify: compose --version", "supercli plugins install ./plugins/compose --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "compose", "resource": "_", "action": "_",
    "description": "Passthrough to compose CLI",
    "adapter": "process", "adapterConfig": { "command": "compose", "passthrough": true, "missingDependencyHelp": "Install compose: apt-get install compose" }, "args": []
  }]
}
