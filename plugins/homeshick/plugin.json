{
  "name": "homeshick",
  "version": "0.1.0",
  "description": "Git-based dotfile synchronizer in bash",
  "source": "https://github.com/andsens/homeshick",
  "checks": [{ "type": "binary", "name": "homeshick" }],
  "install_guidance": {
    "plugin": "homeshick",
    "binary": "homeshick",
    "check": "which homeshick",
    "install_steps": ["git clone and source", "Verify: homeshick --version", "supercli plugins install ./plugins/homeshick --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "homeshick",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to homeshick CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "homeshick",
      "passthrough": true,
      "missingDependencyHelp": "Install homeshick: git clone and source", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
