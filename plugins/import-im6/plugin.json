{
  "name": "import-im6",
  "version": "0.1.0",
  "description": "CLI tool: import-im6",
  "source": "https://manpages.debian.org/import-im6",
  "checks": [
    {
      "type": "binary",
      "name": "import-im6"
    }
  ],
  "install_guidance": {
    "plugin": "import-im6",
    "binary": "import-im6",
    "check": "which import-im6",
    "install_steps": [
      "apt-get install import-im6 2>/dev/null || which import-im6",
      "Verify: import-im6 --version",
      "supercli plugins install ./plugins/import-im6 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "import-im6",
      "resource": "self",
      "action": "version",
      "description": "Print import-im6 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "import-im6",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install import-im6: apt-get install import-im6 2>/dev/null || which import-im6"
      },
      "args": []
    },
    {
      "namespace": "import-im6",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to import-im6 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "import-im6",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install import-im6: apt-get install import-im6 2>/dev/null || which import-im6"
      },
      "args": []
    }
  ]
}