{
  "name": "ik_llama.cpp",
  "version": "0.1.0",
  "description": "llama.cpp fork with additional SOTA quants and improved performance",
  "source": "https://github.com/ik_llama.cpp/ik_llama.cpp",
  "checks": [
    {
      "type": "binary",
      "name": "ik-llama.cpp"
    }
  ],
  "install_guidance": {
    "plugin": "ik_llama.cpp",
    "binary": "ik-llama.cpp",
    "check": "which ik-llama.cpp",
    "install_steps": [
      "pip install ik-llama.cpp",
      "Verify: ik-llama.cpp --version",
      "supercli plugins install ./plugins/ik_llama.cpp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ik_llama.cpp",
      "resource": "self",
      "action": "version",
      "description": "Print ik_llama.cpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ik-llama.cpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ik_llama.cpp: pip install ik-llama.cpp"
      },
      "args": []
    },
    {
      "namespace": "ik_llama.cpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ik-llama.cpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ik-llama.cpp",
        "passthrough": true,
        "missingDependencyHelp": "Install ik_llama.cpp: pip install ik-llama.cpp"
      },
      "args": []
    }
  ]
}