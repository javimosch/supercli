{
  "name": "vFlow",
  "version": "0.1.0",
  "description": "vFlow \u662f\u4e00\u6b3e\u4e3a Android \u5e73\u53f0\u8bbe\u8ba1\u7684\u3001\u5f3a\u5927\u4e14\u9ad8\u5ea6\u53ef\u6269\u5c55\u7684\u81ea\u52a8\u5316\u5de5\u5177\u3002\u5b83\u5141\u8bb8\u4f60\u901a\u8fc7\u56fe\u5f62\u5316\u754c\u9762\uff0c\u5c06\u4e00\u7cfb\u5217\u201c\u52a8\u4f5c\u6a21\u5757\u201d\u81ea\u7531\u7ec4\u5408\u6210\u5f3a\u5927\u7684\u201c\u5de5\u4f5c\u6d41\u201d\uff0c\u4ece\u800c\u81ea\u52a8\u5b8c\u6210\u5404\u79cd\u65e5\u5e38\u7684\u3001\u91cd\u590d\u6027\u7684\u5c4f\u5e55\u64cd\u4f5c\u4efb\u52a1\u3002",
  "source": "https://github.com/vFlow/vFlow",
  "checks": [
    {
      "type": "binary",
      "name": "vflow"
    }
  ],
  "install_guidance": {
    "plugin": "vFlow",
    "binary": "vflow",
    "check": "which vflow",
    "install_steps": [
      "pip install vflow",
      "Verify: vflow --version",
      "supercli plugins install ./plugins/vFlow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vFlow",
      "resource": "self",
      "action": "version",
      "description": "Print vFlow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vflow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vFlow: pip install vflow"
      },
      "args": []
    },
    {
      "namespace": "vFlow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vflow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vflow",
        "passthrough": true,
        "missingDependencyHelp": "Install vFlow: pip install vflow"
      },
      "args": []
    }
  ]
}