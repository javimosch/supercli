{
  "name": "lemonade",
  "version": "0.1.0",
  "description": "Lemonade helps users discover and run local AI apps by serving optimized LLMs right from their own G",
  "source": "https://github.com/lemonade/lemonade",
  "checks": [
    {
      "type": "binary",
      "name": "lemonade"
    }
  ],
  "install_guidance": {
    "plugin": "lemonade",
    "binary": "lemonade",
    "check": "which lemonade",
    "install_steps": [
      "pip install lemonade",
      "Verify: lemonade --version",
      "supercli plugins install ./plugins/lemonade --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lemonade",
      "resource": "self",
      "action": "version",
      "description": "Print lemonade version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lemonade",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lemonade: pip install lemonade"
      },
      "args": []
    },
    {
      "namespace": "lemonade",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lemonade CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lemonade",
        "passthrough": true,
        "missingDependencyHelp": "Install lemonade: pip install lemonade"
      },
      "args": []
    }
  ]
}