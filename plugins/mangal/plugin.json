{
  "name": "mangal",
  "version": "0.1.0",
  "description": "The most advanced CLI manga downloader with Lua scrapers and multiple export formats",
  "source": "https://github.com/metafates/mangal",
  "checks": [{ "type": "binary", "name": "mangal" }],
  "install_guidance": {
    "plugin": "mangal",
    "binary": "mangal",
    "check": "which mangal",
    "install_steps": [
      "go install github.com/metafates/mangal@latest",
      "Or: brew install mangal",
      "Or download from https://github.com/metafates/mangal/releases",
      "Verify: mangal --version",
      "supercli plugins install ./plugins/mangal --on-conflict replace --json"
    ],
    "note": "Available via Go install and Homebrew. Source: https://github.com/metafates/mangal (1.7k+ stars). Written in Go."
  },
  "commands": [
    {
      "namespace": "mangal", "resource": "self", "action": "version",
      "description": "Print mangal version",
      "adapter": "process",
      "adapterConfig": { "command": "mangal", "missingDependencyHelp": "Install mangal: go install github.com/metafates/mangal@latest", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "mangal", "resource": "_", "action": "_",
      "description": "Passthrough to mangal CLI",
      "adapter": "process",
      "adapterConfig": { "command": "mangal", "missingDependencyHelp": "Install mangal: go install github.com/metafates/mangal@latest", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
