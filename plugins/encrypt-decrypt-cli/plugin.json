{
  "name": "encrypt-decrypt-cli",
  "version": "0.1.0",
  "description": "Simple CLI-tool for encryption/decryption data",
  "source": "https://github.com/encrypt-decrypt-cli/encrypt-decrypt-cli",
  "checks": [
    {
      "type": "binary",
      "name": "encrypt-decrypt-cli"
    }
  ],
  "install_guidance": {
    "plugin": "encrypt-decrypt-cli",
    "binary": "encrypt-decrypt-cli",
    "check": "which encrypt-decrypt-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: encrypt-decrypt-cli --version",
      "supercli plugins install ./plugins/encrypt-decrypt-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "encrypt-decrypt-cli",
      "resource": "self",
      "action": "version",
      "description": "Print encrypt-decrypt-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "encrypt-decrypt-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install encrypt-decrypt-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "encrypt-decrypt-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to encrypt-decrypt-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "encrypt-decrypt-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install encrypt-decrypt-cli from project repository"
      },
      "args": []
    }
  ]
}