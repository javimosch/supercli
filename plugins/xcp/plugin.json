{
  "name": "xcp",
  "version": "0.1.0",
  "description": "xcp \u2014 an extended cp with progress bars, parallel copies (Rust).",
  "source": "https://github.com/tarka/xcp",
  "checks": [
    {
      "type": "binary",
      "name": "xcp"
    }
  ],
  "install_guidance": {
    "plugin": "xcp",
    "binary": "xcp",
    "check": "which xcp",
    "install_steps": [
      "cargo install xcp",
      "brew install xcp",
      "supercli plugins install ./plugins/xcp --on-conflict replace --json"
    ],
    "note": "Rust. Extended cp with progress."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xcp",
      "resource": "file",
      "action": "copy",
      "description": "Copy files with progress",
      "adapter": "process",
      "adapterConfig": {
        "command": "xcp",
        "missingDependencyHelp": "Install xcp",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "xcp",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xcp",
        "missingDependencyHelp": "Install xcp",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
