{
  "name": "jenkins-lts",
  "version": "0.1.0",
  "description": "Extendable open source continuous integration server",
  "checks": [
    {
      "type": "binary",
      "name": "jenkins-lts"
    }
  ],
  "install_guidance": {
    "plugin": "jenkins-lts",
    "binary": "jenkins-lts",
    "check": "which jenkins-lts",
    "install_steps": [
      "brew install jenkins-lts",
      "Verify: jenkins-lts --version",
      "supercli plugins install ./plugins/jenkins-lts --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jenkins-lts",
      "resource": "self",
      "action": "version",
      "description": "Print jenkins-lts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jenkins-lts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jenkins-lts: brew install jenkins-lts"
      },
      "args": []
    },
    {
      "namespace": "jenkins-lts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jenkins-lts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jenkins-lts",
        "passthrough": true,
        "missingDependencyHelp": "Install jenkins-lts"
      },
      "args": []
    }
  ]
}