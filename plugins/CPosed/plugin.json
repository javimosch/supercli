{
  "name": "CPosed",
  "version": "0.1.0",
  "description": "\u26a1 Continuously updated Android framework forked from Lsposed, enhanced with advanced detection bypas",
  "source": "https://github.com/CPosed/CPosed",
  "checks": [
    {
      "type": "binary",
      "name": "cposed"
    }
  ],
  "install_guidance": {
    "plugin": "CPosed",
    "binary": "cposed",
    "check": "which cposed",
    "install_steps": [
      "pip install cposed",
      "Verify: cposed --version",
      "supercli plugins install ./plugins/CPosed --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CPosed",
      "resource": "self",
      "action": "version",
      "description": "Print CPosed version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cposed",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CPosed: pip install cposed"
      },
      "args": []
    },
    {
      "namespace": "CPosed",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cposed CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cposed",
        "passthrough": true,
        "missingDependencyHelp": "Install CPosed: pip install cposed"
      },
      "args": []
    }
  ]
}