{
  "name": "Hex",
  "version": "0.1.0",
  "description": "VOICE \u2192 WORDS",
  "source": "https://github.com/Hex/Hex",
  "checks": [
    {
      "type": "binary",
      "name": "hex"
    }
  ],
  "install_guidance": {
    "plugin": "Hex",
    "binary": "hex",
    "check": "which hex",
    "install_steps": [
      "pip install hex",
      "Verify: hex --version",
      "supercli plugins install ./plugins/Hex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Hex",
      "resource": "self",
      "action": "version",
      "description": "Print Hex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Hex: pip install hex"
      },
      "args": []
    },
    {
      "namespace": "Hex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hex",
        "passthrough": true,
        "missingDependencyHelp": "Install Hex: pip install hex"
      },
      "args": []
    }
  ]
}