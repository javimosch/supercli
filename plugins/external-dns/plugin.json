{
  "name": "external-dns",
  "version": "0.1.0",
  "description": "Configure external DNS servers for Kubernetes resources",
  "source": "https://github.com/kubernetes-sigs/external-dns",
  "checks": [{ "type": "binary", "name": "external-dns" }],
  "install_guidance": {
    "plugin": "external-dns",
    "binary": "external-dns",
    "check": "which external-dns",
    "install_steps": ["brew install external-dns", "Verify: external-dns --version", "supercli plugins install ./plugins/external-dns --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "external-dns",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to external-dns CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "external-dns",
      "passthrough": true,
      "missingDependencyHelp": "Install external-dns: brew install external-dns"
    },
    "args": []
  }]
}
