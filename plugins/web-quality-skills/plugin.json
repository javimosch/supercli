{
  "name": "web-quality-skills",
  "version": "0.1.0",
  "description": "Agent Skills for optimizing web quality based on Lighthouse and Core Web Vitals.",
  "source": "https://github.com/web-quality-skills/web-quality-skills",
  "checks": [
    {
      "type": "binary",
      "name": "web-quality-skills"
    }
  ],
  "install_guidance": {
    "plugin": "web-quality-skills",
    "binary": "web-quality-skills",
    "check": "which web-quality-skills",
    "install_steps": [
      "pip install web-quality-skills",
      "Verify: web-quality-skills --version",
      "supercli plugins install ./plugins/web-quality-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "web-quality-skills",
      "resource": "self",
      "action": "version",
      "description": "Print web-quality-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "web-quality-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install web-quality-skills: pip install web-quality-skills"
      },
      "args": []
    },
    {
      "namespace": "web-quality-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to web-quality-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "web-quality-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install web-quality-skills: pip install web-quality-skills"
      },
      "args": []
    }
  ]
}