{
  "name": "avahi-publish",
  "version": "0.1.0",
  "description": "Register an mDNS/DNS-SD service or host name or address mapping using the Avahi daemon",
  "source": "https://packages.debian.org/avahi-publish",
  "checks": [{ "type": "binary", "name": "avahi-publish" }],
  "install_guidance": {
    "plugin": "avahi-publish", "binary": "avahi-publish", "check": "which avahi-publish",
    "install_steps": ["apt-get install avahi-utils", "Verify: avahi-publish --version", "supercli plugins install ./plugins/avahi-publish --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "avahi-publish", "resource": "_", "action": "_",
    "description": "Passthrough to avahi-publish CLI",
    "adapter": "process", "adapterConfig": { "command": "avahi-publish", "passthrough": true, "missingDependencyHelp": "Install avahi-publish: apt-get install avahi-utils" }, "args": []
  }]
}
