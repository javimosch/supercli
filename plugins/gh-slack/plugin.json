{
  "name": "gh-slack",
  "version": "0.1.0",
  "description": "Structured JSON Slack agent for AI tool integration",
  "source": "https://www.npmjs.com/package/@alankyshum/slack-cli",
  "checks": [{ "type": "binary", "name": "gh-slack" }],
  "install_guidance": {
    "plugin": "gh-slack",
    "binary": "gh-slack",
    "check": "which gh-slack",
    "install_steps": ["npm install -g @alankyshum/slack-cli", "Verify: gh-slack --version", "supercli plugins install ./plugins/gh-slack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gh-slack",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gh-slack CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gh-slack",
      "passthrough": true,
      "missingDependencyHelp": "Install gh-slack: npm install -g @alankyshum/slack-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
