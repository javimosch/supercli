{
  "name": "ccheck",
  "version": "0.1.0",
  "description": "Check X509 certificate expiration from the command-line, with TAP output",
  "source": "https://github.com/nerdlem/ccheck",
  "checks": [
    {
      "type": "binary",
      "name": "ccheck"
    }
  ],
  "install_guidance": {
    "plugin": "ccheck",
    "binary": "ccheck",
    "check": "which ccheck",
    "install_steps": [
      "brew install ccheck",
      "Verify: ccheck --version",
      "supercli plugins install ./plugins/ccheck --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ccheck",
      "resource": "self",
      "action": "version",
      "description": "Print ccheck version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccheck",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ccheck: brew install ccheck"
      },
      "args": []
    },
    {
      "namespace": "ccheck",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ccheck CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccheck",
        "passthrough": true,
        "missingDependencyHelp": "Install ccheck"
      },
      "args": []
    }
  ]
}