{
  "name": "iot-telemetry-normalizer",
  "version": "0.1.0",
  "description": "Production-style Python pipeline for normalizing IoT manufacturing telemetry data into a unified schema with validation, logging, CLI support, and automated testing.",
  "source": "https://github.com/iot-telemetry-normalizer/iot-telemetry-normalizer",
  "checks": [
    {
      "type": "binary",
      "name": "iot-telemetry-normalizer"
    }
  ],
  "install_guidance": {
    "plugin": "iot-telemetry-normalizer",
    "binary": "iot-telemetry-normalizer",
    "check": "which iot-telemetry-normalizer",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: iot-telemetry-normalizer --version",
      "supercli plugins install ./plugins/iot-telemetry-normalizer --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "iot-telemetry-normalizer",
      "resource": "self",
      "action": "version",
      "description": "Print iot-telemetry-normalizer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iot-telemetry-normalizer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iot-telemetry-normalizer from project repository"
      },
      "args": []
    },
    {
      "namespace": "iot-telemetry-normalizer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iot-telemetry-normalizer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iot-telemetry-normalizer",
        "passthrough": true,
        "missingDependencyHelp": "Install iot-telemetry-normalizer from project repository"
      },
      "args": []
    }
  ]
}