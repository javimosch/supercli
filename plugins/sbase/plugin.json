{
  "name": "sbase",
  "version": "1.0.0",
  "description": "sbase \u2014 Suckless coreutils",
  "source": "core.suckless.org/sbase",
  "checks": [
    {
      "type": "binary",
      "name": "sbase"
    }
  ],
  "install_guidance": {
    "plugin": "sbase",
    "binary": "sbase",
    "check": "which sbase",
    "install_steps": [
      "# Install sbase:",
      "# apt: sudo apt-get install sbase",
      "# brew: brew install sbase",
      "# cargo: cargo install sbase",
      "# npm: npm install -g sbase",
      "# pip: pip install sbase",
      "# or download from core.suckless.org/sbase"
    ]
  },
  "commands": [
    {
      "namespace": "sbase",
      "resource": "sbase",
      "action": "run",
      "description": "Run sbase",
      "adapter": "process",
      "adapterConfig": {
        "command": "sbase",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install sbase from core.suckless.org/sbase"
      },
      "args": []
    }
  ]
}