{
  "name": "x-www-browser",
  "version": "0.1.0",
  "description": "CLI tool: x-www-browser",
  "source": "https://manpages.debian.org/x-www-browser",
  "checks": [
    {
      "type": "binary",
      "name": "x-www-browser"
    }
  ],
  "install_guidance": {
    "plugin": "x-www-browser",
    "binary": "x-www-browser",
    "check": "which x-www-browser",
    "install_steps": [
      "apt-get install x-www-browser 2>/dev/null || which x-www-browser",
      "Verify: x-www-browser --version",
      "supercli plugins install ./plugins/x-www-browser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "x-www-browser",
      "resource": "self",
      "action": "version",
      "description": "Print x-www-browser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "x-www-browser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install x-www-browser: apt-get install x-www-browser 2>/dev/null || which x-www-browser"
      },
      "args": []
    },
    {
      "namespace": "x-www-browser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to x-www-browser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "x-www-browser",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install x-www-browser: apt-get install x-www-browser 2>/dev/null || which x-www-browser"
      },
      "args": []
    }
  ]
}