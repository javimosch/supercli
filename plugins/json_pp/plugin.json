{
  "name": "json_pp",
  "version": "0.1.0",
  "description": "json_pp — JSON pretty-printer and converter for command-line use",
  "source": "https://metacpan.org/pod/JSON::PP",
  "checks": [
    {
      "type": "binary",
      "name": "json_pp"
    }
  ],
  "install_guidance": {
    "plugin": "json_pp",
    "binary": "json_pp",
    "check": "which json_pp",
    "install_steps": [
      "apt install json-pp (Debian/Ubuntu)",
      "brew install json-pp (macOS)",
      "cpan JSON::PP",
      "supercli plugins install ./plugins/json_pp --on-conflict replace --json"
    ],
    "note": "Part of the Perl JSON::PP module. Usually pre-installed on most systems."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "json_pp",
      "resource": "self",
      "action": "version",
      "description": "Print json_pp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "json_pp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install json_pp: apt install json-pp"
      },
      "args": []
    },
    {
      "namespace": "json_pp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to json_pp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "json_pp",
        "passthrough": true,
        "missingDependencyHelp": "Install json_pp: apt install json-pp"
      },
      "args": []
    }
  ]
}
