{
  "name": "hcxtools",
  "version": "0.1.0",
  "description": "Utils for conversion of cap/pcap/pcapng WiFi dump files",
  "source": "https://github.com/ZerBea/hcxtools",
  "checks": [
    {
      "type": "binary",
      "name": "hcxtools"
    }
  ],
  "install_guidance": {
    "plugin": "hcxtools",
    "binary": "hcxtools",
    "check": "which hcxtools",
    "install_steps": [
      "brew install hcxtools",
      "Verify: hcxtools --version",
      "supercli plugins install ./plugins/hcxtools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hcxtools",
      "resource": "self",
      "action": "version",
      "description": "Print hcxtools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hcxtools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hcxtools: brew install hcxtools"
      },
      "args": []
    },
    {
      "namespace": "hcxtools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hcxtools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hcxtools",
        "passthrough": true,
        "missingDependencyHelp": "Install hcxtools"
      },
      "args": []
    }
  ]
}