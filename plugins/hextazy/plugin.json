{
  "name": "hextazy",
  "version": "0.1.0",
  "description": "A colorful hex editor and viewer for the terminal. Displays binary files with syntax highlighting and supports structured output for pipeline analysis.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "hextazy"
    }
  ],
  "install_guidance": {
    "plugin": "hextazy",
    "binary": "hextazy",
    "check": "which hextazy",
    "install_steps": [
      "cargo install hextazy",
      "Verify: hextazy --version",
      "supercli plugins install ./plugins/hextazy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hextazy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hextazy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hextazy",
        "passthrough": true,
        "missingDependencyHelp": "Install hextazy: cargo install hextazy"
      },
      "args": []
    }
  ]
}
