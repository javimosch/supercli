{
  "name": "tcpdump",
  "version": "0.1.0",
  "description": "Network packet capture and analysis",
  "source": "https",
  "checks": [{"type": "binary", "name": "tcpdump"}],
  "install_guidance": {
    "plugin": "tcpdump",
    "binary": "tcpdump",
    "check": "which tcpdump",
    "install_steps": [
      "brew install tcpdump",
      "Verify: tcpdump --version",
      "supercli plugins install ./plugins/tcpdump --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "tcpdump",
      "resource": "self",
      "action": "version",
      "description": "Print tcpdump version",
      "adapter": "process",
      "adapterConfig": {"command": "tcpdump", "baseArgs": ["--version"], "missingDependencyHelp": "Install tcpdump: brew install tcpdump"},
      "args": []
    },
    {
      "namespace": "tcpdump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tcpdump CLI",
      "adapter": "process",
      "adapterConfig": {"command": "tcpdump", "passthrough": true, "missingDependencyHelp": "Install tcpdump: brew install tcpdump"},
      "args": []
    }
  ]
}
