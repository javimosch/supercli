{
  "name": "port-available-cli",
  "version": "0.1.0",
  "description": "A port availability checker for the command line. Tests if TCP/UDP ports are open or available with fast timeout-based scanning and JSON output.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "port-available-cli"
    }
  ],
  "install_guidance": {
    "plugin": "port-available-cli",
    "binary": "port-available-cli",
    "check": "which port-available-cli",
    "install_steps": [
      "cargo install port-available-cli",
      "Verify: port-available-cli --version",
      "supercli plugins install ./plugins/port-available-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "port-available-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to port-available-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "port-available-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install port-available-cli: cargo install port-available-cli"
      },
      "args": []
    }
  ]
}
