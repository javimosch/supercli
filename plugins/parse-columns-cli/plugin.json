{
  "name": "parse-columns-cli",
  "version": "0.1.0",
  "description": "Parse text columns to JSON",
  "source": "https://github.com/sindresorhus/parse-columns-cli",
  "checks": [
    {
      "type": "binary",
      "name": "parse-columns-cli"
    }
  ],
  "install_guidance": {
    "plugin": "parse-columns-cli",
    "binary": "parse-columns-cli",
    "check": "which parse-columns-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/parse-columns-cli",
      "Verify: parse-columns-cli --version",
      "supercli plugins install ./plugins/parse-columns-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "parse-columns-cli",
      "resource": "self",
      "action": "version",
      "description": "Print parse-columns-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "parse-columns-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install parse-columns-cli: See https://github.com/sindresorhus/parse-columns-cli"
      },
      "args": []
    },
    {
      "namespace": "parse-columns-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to parse-columns-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "parse-columns-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install parse-columns-cli"
      },
      "args": []
    }
  ]
}