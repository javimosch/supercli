{
  "name": "tabula-java",
  "version": "0.1.0",
  "description": "Extract tables from PDFs into CSV using Java CLI",
  "source": "https://github.com/tabulapdf/tabula-java",
  "checks": [{ "type": "binary", "name": "tabula-java" }],
  "install_guidance": {
    "plugin": "tabula-java",
    "binary": "tabula-java",
    "check": "which tabula-java",
    "install_steps": ["brew install tabula", "Verify: tabula-java --version", "supercli plugins install ./plugins/tabula-java --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tabula-java",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tabula-java CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tabula-java",
      "passthrough": true,
      "missingDependencyHelp": "Install tabula-java: brew install tabula", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
