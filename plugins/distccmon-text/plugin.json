{
  "name": "distccmon-text",
  "version": "0.1.0",
  "description": "CLI tool: distccmon-text",
  "source": "https://packages.debian.org/distccmon-text",
  "checks": [{ "type": "binary", "name": "distccmon-text" }],
  "install_guidance": {
    "plugin": "distccmon-text", "binary": "distccmon-text", "check": "which distccmon-text",
    "install_steps": ["apt-get install distccmon-text 2>/dev/null || which distccmon-text", "Verify: distccmon-text --version", "supercli plugins install ./plugins/distccmon-text --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distccmon-text", "resource": "_", "action": "_",
    "description": "Passthrough to distccmon-text CLI",
    "adapter": "process", "adapterConfig": { "command": "distccmon-text", "passthrough": true, "missingDependencyHelp": "Install distccmon-text: apt-get install distccmon-text" }, "args": []
  }]
}
