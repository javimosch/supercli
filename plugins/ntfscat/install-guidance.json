{
  "plugin": "ntfscat",
  "binary": "ntfscat",
  "check": "which ntfscat",
  "install_steps": [
    "# Install ntfscat",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ntfscat-linux-amd64 -o /usr/local/bin/ntfscat",
    "chmod +x /usr/local/bin/ntfscat",
    "# Or via package manager, see /usr/bin/ntfscat"
  ]
}