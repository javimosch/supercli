{
  "name": "vllm-ascend",
  "version": "0.1.0",
  "description": "Community maintained hardware plugin for vLLM on Ascend",
  "source": "https://github.com/vllm-ascend/vllm-ascend",
  "checks": [
    {
      "type": "binary",
      "name": "vllm-ascend"
    }
  ],
  "install_guidance": {
    "plugin": "vllm-ascend",
    "binary": "vllm-ascend",
    "check": "which vllm-ascend",
    "install_steps": [
      "pip install vllm-ascend",
      "Verify: vllm-ascend --version",
      "supercli plugins install ./plugins/vllm-ascend --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vllm-ascend",
      "resource": "self",
      "action": "version",
      "description": "Print vllm-ascend version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vllm-ascend",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vllm-ascend: pip install vllm-ascend"
      },
      "args": []
    },
    {
      "namespace": "vllm-ascend",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vllm-ascend CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vllm-ascend",
        "passthrough": true,
        "missingDependencyHelp": "Install vllm-ascend: pip install vllm-ascend"
      },
      "args": []
    }
  ]
}