{
  "name": "octotype",
  "version": "0.1.0",
  "description": "A customizable typing trainer",
  "source": "https://github.com/mahlquistj/octotype",
  "checks": [
    {
      "type": "binary",
      "name": "octotype"
    }
  ],
  "install_guidance": {
    "plugin": "octotype",
    "binary": "octotype",
    "check": "which octotype",
    "install_steps": [
      "cargo install octotype",
      "Verify: octotype --version",
      "supercli plugins install ./plugins/octotype --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "octotype",
      "resource": "self",
      "action": "version",
      "description": "Print octotype version",
      "adapter": "process",
      "adapterConfig": {
        "command": "octotype",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install octotype: cargo install octotype"
      },
      "args": []
    },
    {
      "namespace": "octotype",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to octotype CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "octotype",
        "passthrough": true,
        "missingDependencyHelp": "Install octotype"
      },
      "args": []
    }
  ]
}