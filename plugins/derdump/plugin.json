{
  "name": "derdump",
  "version": "0.1.0",
  "description": "CLI tool: derdump",
  "source": "https://packages.debian.org/derdump",
  "checks": [{ "type": "binary", "name": "derdump" }],
  "install_guidance": {
    "plugin": "derdump", "binary": "derdump", "check": "which derdump",
    "install_steps": ["apt-get install derdump 2>/dev/null || which derdump", "Verify: derdump --version", "supercli plugins install ./plugins/derdump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "derdump", "resource": "_", "action": "_",
    "description": "Passthrough to derdump CLI",
    "adapter": "process", "adapterConfig": { "command": "derdump", "passthrough": true, "missingDependencyHelp": "Install derdump: apt-get install derdump" }, "args": []
  }]
}
