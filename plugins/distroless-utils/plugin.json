{
  "name": "distroless-utils",
  "version": "0.1.0",
  "description": "Utilities to inspect and interject within distroless containers",
  "source": "go",
  "checks": [{ "type": "binary", "name": "distroless-utils" }],
  "install_guidance": {
    "plugin": "distroless-utils",
    "binary": "distroless-utils",
    "check": "which distroless-utils",
    "install_steps": ["go get github.com/GoogleContainerTools/distroless", "Verify: distroless-utils --version", "supercli plugins install ./plugins/distroless-utils --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distroless-utils",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to distroless-utils CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "distroless-utils",
      "passthrough": true,
      "missingDependencyHelp": "Install distroless-utils: go get github.com/GoogleContainerTools/distroless"
    },
    "args": []
  }]
}
