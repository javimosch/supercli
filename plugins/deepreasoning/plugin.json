{
  "name": "deepreasoning",
  "version": "0.1.0",
  "description": "A high-performance LLM inference API and Chat UI that integrates DeepSeek R1's CoT reasoning traces ",
  "source": "https://github.com/deepreasoning/deepreasoning",
  "checks": [
    {
      "type": "binary",
      "name": "deepreasoning"
    }
  ],
  "install_guidance": {
    "plugin": "deepreasoning",
    "binary": "deepreasoning",
    "check": "which deepreasoning",
    "install_steps": [
      "pip install deepreasoning",
      "Verify: deepreasoning --version",
      "supercli plugins install ./plugins/deepreasoning --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "deepreasoning",
      "resource": "self",
      "action": "version",
      "description": "Print deepreasoning version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepreasoning",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install deepreasoning: pip install deepreasoning"
      },
      "args": []
    },
    {
      "namespace": "deepreasoning",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deepreasoning CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepreasoning",
        "passthrough": true,
        "missingDependencyHelp": "Install deepreasoning: pip install deepreasoning"
      },
      "args": []
    }
  ]
}