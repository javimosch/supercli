{
  "name": "EventStore.Client.Reactive",
  "version": "0.1.0",
  "description": "Reactive extensions for eventstore subscriptions",
  "source": "https://github.com/EventStore.Client.Reactive/EventStore.Client.Reactive",
  "checks": [
    {
      "type": "binary",
      "name": "EventStore.Client.Reactive"
    }
  ],
  "install_guidance": {
    "plugin": "EventStore.Client.Reactive",
    "binary": "EventStore.Client.Reactive",
    "check": "which EventStore.Client.Reactive",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: EventStore.Client.Reactive --version",
      "supercli plugins install ./plugins/EventStore.Client.Reactive --on-conflict replace --json"
    ],
    "note": "C# language CLI tool"
  },
  "commands": [
    {
      "namespace": "EventStore.Client.Reactive",
      "resource": "self",
      "action": "version",
      "description": "Print EventStore.Client.Reactive version",
      "adapter": "process",
      "adapterConfig": {
        "command": "EventStore.Client.Reactive",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install EventStore.Client.Reactive from project repository"
      },
      "args": []
    },
    {
      "namespace": "EventStore.Client.Reactive",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to EventStore.Client.Reactive CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "EventStore.Client.Reactive",
        "passthrough": true,
        "missingDependencyHelp": "Install EventStore.Client.Reactive from project repository"
      },
      "args": []
    }
  ]
}