{
  "name": "certtool",
  "version": "0.1.0",
  "description": "Certificate manipulation tool",
  "source": "https://packages.debian.org/certtool",
  "checks": [{ "type": "binary", "name": "certtool" }],
  "install_guidance": {
    "plugin": "certtool", "binary": "certtool", "check": "which certtool",
    "install_steps": ["apt-get install gnutls-bin", "Verify: certtool --version", "supercli plugins install ./plugins/certtool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "certtool", "resource": "_", "action": "_",
    "description": "Passthrough to certtool CLI",
    "adapter": "process", "adapterConfig": { "command": "certtool", "passthrough": true, "missingDependencyHelp": "Install certtool: apt-get install gnutls-bin" }, "args": []
  }]
}
