{
  "name": "umount.udisks2",
  "version": "0.1.0",
  "description": "CLI tool: umount.udisks2",
  "source": "https://manpages.debian.org/umount.udisks2",
  "checks": [
    {
      "type": "binary",
      "name": "umount.udisks2"
    }
  ],
  "install_guidance": {
    "plugin": "umount.udisks2",
    "binary": "umount.udisks2",
    "check": "which umount.udisks2",
    "install_steps": [
      "apt-get install umount.udisks2 2>/dev/null || which umount.udisks2",
      "Verify: umount.udisks2 --version",
      "supercli plugins install ./plugins/umount.udisks2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "umount.udisks2",
      "resource": "self",
      "action": "version",
      "description": "Print umount.udisks2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "umount.udisks2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install umount.udisks2: apt-get install umount.udisks2 2>/dev/null || which umount.udisks2"
      },
      "args": []
    },
    {
      "namespace": "umount.udisks2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to umount.udisks2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "umount.udisks2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install umount.udisks2: apt-get install umount.udisks2 2>/dev/null || which umount.udisks2"
      },
      "args": []
    }
  ]
}