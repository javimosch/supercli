{
  "plugin": "ripsecrets",
  "binary": "ripsecrets",
  "check": "which ripsecrets",
  "install_steps": [
    "cargo install --git https://github.com/sirwart/ripsecrets --branch main",
    "Verify: ripsecrets --version",
    "supercli plugins install ./plugins/ripsecrets --on-conflict replace --json"
  ]
}
