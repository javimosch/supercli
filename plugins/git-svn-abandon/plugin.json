{
  "name": "git-svn-abandon",
  "version": "0.1.0",
  "description": "History-preserving svn-to-git migration",
  "source": "https://github.com/nothingmuch/git-svn-abandon",
  "checks": [
    {
      "type": "binary",
      "name": "git-svn-abandon"
    }
  ],
  "install_guidance": {
    "plugin": "git-svn-abandon",
    "binary": "git-svn-abandon",
    "check": "which git-svn-abandon",
    "install_steps": [
      "brew install git-svn-abandon",
      "Verify: git-svn-abandon --version",
      "supercli plugins install ./plugins/git-svn-abandon --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-svn-abandon",
      "resource": "self",
      "action": "version",
      "description": "Print git-svn-abandon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-svn-abandon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-svn-abandon: brew install git-svn-abandon"
      },
      "args": []
    },
    {
      "namespace": "git-svn-abandon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-svn-abandon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-svn-abandon",
        "passthrough": true,
        "missingDependencyHelp": "Install git-svn-abandon"
      },
      "args": []
    }
  ]
}