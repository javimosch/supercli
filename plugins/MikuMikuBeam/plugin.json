{
  "name": "MikuMikuBeam",
  "version": "0.1.0",
  "description": "An open-source network stresser tool but it's Hatsune Miku",
  "source": "https://github.com/MikuMikuBeam/MikuMikuBeam",
  "checks": [
    {
      "type": "binary",
      "name": "mikumikubeam"
    }
  ],
  "install_guidance": {
    "plugin": "MikuMikuBeam",
    "binary": "mikumikubeam",
    "check": "which mikumikubeam",
    "install_steps": [
      "pip install mikumikubeam",
      "Verify: mikumikubeam --version",
      "supercli plugins install ./plugins/MikuMikuBeam --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MikuMikuBeam",
      "resource": "self",
      "action": "version",
      "description": "Print MikuMikuBeam version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mikumikubeam",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MikuMikuBeam: pip install mikumikubeam"
      },
      "args": []
    },
    {
      "namespace": "MikuMikuBeam",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mikumikubeam CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mikumikubeam",
        "passthrough": true,
        "missingDependencyHelp": "Install MikuMikuBeam: pip install mikumikubeam"
      },
      "args": []
    }
  ]
}