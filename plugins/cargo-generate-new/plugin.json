{
  "name": "cargo-generate-new",
  "version": "0.1.0",
  "description": "cargo-generate — cargo extension for generating new Rust projects",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-generate-new"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-generate-new",
    "binary": "cargo-generate-new",
    "check": "which cargo-generate-new",
    "install_steps": [
      "cargo install cargo-generate-new",
      "Verify: cargo-generate-new --version",
      "supercli plugins install ./plugins/cargo-generate-new --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo-generate-new",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-generate-new",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-generate-new"
      },
      "args": []
    }
  ]
}
