{
  "name": "pokedex-compose",
  "version": "0.1.0",
  "description": "\ud83d\udde1\ufe0f Pokedex Compose demonstrates modern Android development with Jetpack Compose, Hilt, Coroutines, F",
  "source": "https://github.com/pokedex-compose/pokedex-compose",
  "checks": [
    {
      "type": "binary",
      "name": "pokedex-compose"
    }
  ],
  "install_guidance": {
    "plugin": "pokedex-compose",
    "binary": "pokedex-compose",
    "check": "which pokedex-compose",
    "install_steps": [
      "pip install pokedex-compose",
      "Verify: pokedex-compose --version",
      "supercli plugins install ./plugins/pokedex-compose --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pokedex-compose",
      "resource": "self",
      "action": "version",
      "description": "Print pokedex-compose version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pokedex-compose",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pokedex-compose: pip install pokedex-compose"
      },
      "args": []
    },
    {
      "namespace": "pokedex-compose",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pokedex-compose CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pokedex-compose",
        "passthrough": true,
        "missingDependencyHelp": "Install pokedex-compose: pip install pokedex-compose"
      },
      "args": []
    }
  ]
}