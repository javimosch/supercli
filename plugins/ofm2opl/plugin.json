{
  "name": "ofm2opl",
  "version": "0.1.0",
  "description": "CLI tool: ofm2opl",
  "source": "https://manpages.debian.org/ofm2opl",
  "checks": [
    {
      "type": "binary",
      "name": "ofm2opl"
    }
  ],
  "install_guidance": {
    "plugin": "ofm2opl",
    "binary": "ofm2opl",
    "check": "which ofm2opl",
    "install_steps": [
      "apt-get install ofm2opl 2>/dev/null || which ofm2opl",
      "Verify: ofm2opl --version",
      "supercli plugins install ./plugins/ofm2opl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ofm2opl",
      "resource": "self",
      "action": "version",
      "description": "Print ofm2opl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ofm2opl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ofm2opl: apt-get install ofm2opl 2>/dev/null || which ofm2opl"
      },
      "args": []
    },
    {
      "namespace": "ofm2opl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ofm2opl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ofm2opl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ofm2opl: apt-get install ofm2opl 2>/dev/null || which ofm2opl"
      },
      "args": []
    }
  ]
}