{
  "name": "CordysCRM",
  "version": "0.1.0",
  "description": "\ud83d\udd25 Cordys CRM \u662f\u65b0\u4e00\u4ee3\u5f00\u6e90 AI CRM \u7cfb\u7edf\uff0c\u878d\u5408\u4fe1\u606f\u5316\u3001\u6570\u5b57\u5316\u4e0e\u667a\u80fd\u5316\uff0c\u4e3a\u79c1\u6709\u5316\u90e8\u7f72\u800c\u751f\u3002",
  "source": "https://github.com/CordysCRM/CordysCRM",
  "checks": [
    {
      "type": "binary",
      "name": "cordyscrm"
    }
  ],
  "install_guidance": {
    "plugin": "CordysCRM",
    "binary": "cordyscrm",
    "check": "which cordyscrm",
    "install_steps": [
      "pip install cordyscrm",
      "Verify: cordyscrm --version",
      "supercli plugins install ./plugins/CordysCRM --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CordysCRM",
      "resource": "self",
      "action": "version",
      "description": "Print CordysCRM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cordyscrm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CordysCRM: pip install cordyscrm"
      },
      "args": []
    },
    {
      "namespace": "CordysCRM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cordyscrm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cordyscrm",
        "passthrough": true,
        "missingDependencyHelp": "Install CordysCRM: pip install cordyscrm"
      },
      "args": []
    }
  ]
}