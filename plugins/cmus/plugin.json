{
  "name": "cmus",
  "version": "1.0.0",
  "description": "cmus \u2014 Music player in terminal",
  "source": "cmus.github.io",
  "checks": [
    {
      "type": "binary",
      "name": "cmus"
    }
  ],
  "install_guidance": {
    "plugin": "cmus",
    "binary": "cmus",
    "check": "which cmus",
    "install_steps": [
      "# Install cmus",
      "# See cmus.github.io",
      "# apt: sudo apt-get install cmus",
      "# brew: brew install cmus",
      "# cargo: cargo install cmus",
      "# npm: npm install -g cmus",
      "# pip: pip install cmus"
    ]
  },
  "commands": [
    {
      "namespace": "cmus",
      "resource": "cmus",
      "action": "run",
      "description": "Run cmus",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmus",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cmus from cmus.github.io"
      },
      "args": []
    }
  ]
}