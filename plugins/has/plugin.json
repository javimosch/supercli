{
  "name": "has",
  "version": "0.1.0",
  "description": "Checks for the presence of various commands and their versions on the path",
  "source": "https://github.com/kdabir/has",
  "checks": [
    {
      "type": "binary",
      "name": "has"
    }
  ],
  "install_guidance": {
    "plugin": "has",
    "binary": "has",
    "check": "which has",
    "install_steps": [
      "brew install has",
      "Verify: has --version",
      "supercli plugins install ./plugins/has --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "has",
      "resource": "self",
      "action": "version",
      "description": "Print has version",
      "adapter": "process",
      "adapterConfig": {
        "command": "has",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install has: brew install has"
      },
      "args": []
    },
    {
      "namespace": "has",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to has CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "has",
        "passthrough": true,
        "missingDependencyHelp": "Install has"
      },
      "args": []
    }
  ]
}