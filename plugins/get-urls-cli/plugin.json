{
  "name": "get-urls-cli",
  "version": "0.1.0",
  "description": "Get all URLs in a text file or stdin",
  "source": "https://github.com/get-urls-cli/get-urls-cli",
  "checks": [
    {
      "type": "binary",
      "name": "get-urls-cli"
    }
  ],
  "install_guidance": {
    "plugin": "get-urls-cli",
    "binary": "get-urls-cli",
    "check": "which get-urls-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: get-urls-cli --version",
      "supercli plugins install ./plugins/get-urls-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "get-urls-cli",
      "resource": "self",
      "action": "version",
      "description": "Print get-urls-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-urls-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install get-urls-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "get-urls-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to get-urls-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-urls-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install get-urls-cli from project repository"
      },
      "args": []
    }
  ]
}