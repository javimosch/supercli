{
  "name": "VBoxSDL",
  "version": "0.1.0",
  "description": "CLI tool: VBoxSDL",
  "source": "https://manpages.debian.org/VBoxSDL",
  "checks": [
    {
      "type": "binary",
      "name": "VBoxSDL"
    }
  ],
  "install_guidance": {
    "plugin": "VBoxSDL",
    "binary": "VBoxSDL",
    "check": "which VBoxSDL",
    "install_steps": [
      "apt-get install VBoxSDL 2>/dev/null || which VBoxSDL",
      "Verify: VBoxSDL --version",
      "supercli plugins install ./plugins/VBoxSDL --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VBoxSDL",
      "resource": "self",
      "action": "version",
      "description": "Print VBoxSDL version",
      "adapter": "process",
      "adapterConfig": {
        "command": "VBoxSDL",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VBoxSDL: apt-get install VBoxSDL 2>/dev/null || which VBoxSDL"
      },
      "args": []
    },
    {
      "namespace": "VBoxSDL",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to VBoxSDL CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "VBoxSDL",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install VBoxSDL: apt-get install VBoxSDL 2>/dev/null || which VBoxSDL"
      },
      "args": []
    }
  ]
}