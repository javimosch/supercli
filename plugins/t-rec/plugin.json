{
  "name": "t-rec",
  "version": "0.1.0",
  "description": "Blazingly fast terminal window recorder to GIF and MP4",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "t-rec" }],
  "install_guidance": {
    "plugin": "t-rec",
    "binary": "t-rec",
    "check": "which t-rec",
    "install_steps": ["cargo install t-rec", "Verify: t-rec --version", "supercli plugins install ./plugins/t-rec --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "t-rec",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to t-rec CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "t-rec",
      "passthrough": true,
      "missingDependencyHelp": "Install t-rec: cargo install t-rec"
    },
    "args": []
  }]
}
