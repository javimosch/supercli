{
  "name": "ripgrep-all",
  "version": "0.1.0",
  "description": "ripgrep-all — search documents with ripgrep backend",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "ripgrep-all"
    }
  ],
  "install_guidance": {
    "plugin": "ripgrep-all",
    "binary": "ripgrep-all",
    "check": "which ripgrep-all",
    "install_steps": [
      "cargo install ripgrep-all",
      "Verify: ripgrep-all --version",
      "supercli plugins install ./plugins/ripgrep-all --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ripgrep-all",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ripgrep-all",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ripgrep-all"
      },
      "args": []
    }
  ]
}
