{
  "name": "grepapi",
  "version": "0.1.0",
  "description": "Affordable, CLI agent-first SerpApi alternative \u2014 search results via JSON API",
  "source": "https://github.com/javimosch/grepapi",
  "checks": [
    {
      "type": "binary",
      "name": "grepapi"
    }
  ],
  "install_guidance": {
    "plugin": "grepapi",
    "binary": "grepapi",
    "check": "which grepapi",
    "install_steps": [
      "Build from source: https://github.com/javimosch/grepapi",
      "Verify: grepapi version || grepapi guide"
    ]
  },
  "commands": [
    {
      "namespace": "grepapi",
      "resource": "self",
      "action": "serve",
      "description": "Start the API server",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepapi",
        "baseArgs": [
          "serve"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install grepapi from https://github.com/javimosch/grepapi"
      },
      "args": [
        {
          "name": "port",
          "type": "integer",
          "required": false,
          "description": "Port number",
          "default": 8790
        }
      ]
    },
    {
      "namespace": "grepapi",
      "resource": "self",
      "action": "migrate",
      "description": "Run database migrations",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepapi",
        "baseArgs": [
          "migrate"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install grepapi from https://github.com/javimosch/grepapi"
      },
      "args": []
    },
    {
      "namespace": "grepapi",
      "resource": "self",
      "action": "grant",
      "description": "Grant a plan to an email",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepapi",
        "baseArgs": [
          "grant"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install grepapi from https://github.com/javimosch/grepapi"
      },
      "args": [
        {
          "name": "email",
          "type": "string",
          "required": true,
          "description": "User email"
        },
        {
          "name": "plan",
          "type": "string",
          "required": false,
          "description": "Plan name"
        }
      ]
    },
    {
      "namespace": "grepapi",
      "resource": "self",
      "action": "evict",
      "description": "Evict expired sessions",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepapi",
        "baseArgs": [
          "evict"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install grepapi from https://github.com/javimosch/grepapi"
      },
      "args": []
    },
    {
      "namespace": "grepapi",
      "resource": "self",
      "action": "cleanup",
      "description": "Clean up stale data",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepapi",
        "baseArgs": [
          "cleanup"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install grepapi from https://github.com/javimosch/grepapi"
      },
      "args": [
        {
          "name": "dry-run",
          "type": "boolean",
          "required": false,
          "description": "Dry run mode"
        }
      ]
    },
    {
      "namespace": "grepapi",
      "resource": "self",
      "action": "forget",
      "description": "Forget an entity by ID",
      "adapter": "process",
      "adapterConfig": {
        "command": "grepapi",
        "baseArgs": [
          "forget"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install grepapi from https://github.com/javimosch/grepapi"
      },
      "args": [
        {
          "name": "entity-id",
          "type": "string",
          "required": true,
          "description": "Entity ID to forget"
        }
      ]
    }
  ]
}