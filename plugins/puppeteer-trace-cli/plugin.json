{
  "name": "puppeteer-trace-cli",
  "version": "0.1.0",
  "description": "Simple wrapper around Puppeteer to trace webpage from command line",
  "source": "https://github.com/puppeteer-trace-cli/puppeteer-trace-cli",
  "checks": [
    {
      "type": "binary",
      "name": "puppeteer-trace-cli"
    }
  ],
  "install_guidance": {
    "plugin": "puppeteer-trace-cli",
    "binary": "puppeteer-trace-cli",
    "check": "which puppeteer-trace-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: puppeteer-trace-cli --version",
      "supercli plugins install ./plugins/puppeteer-trace-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "puppeteer-trace-cli",
      "resource": "self",
      "action": "version",
      "description": "Print puppeteer-trace-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "puppeteer-trace-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install puppeteer-trace-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "puppeteer-trace-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to puppeteer-trace-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "puppeteer-trace-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install puppeteer-trace-cli from project repository"
      },
      "args": []
    }
  ]
}