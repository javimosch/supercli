{
  "name": "mapscrn",
  "version": "0.1.0",
  "description": "mapscrn \u2014 load screen output mapping table",
  "source": "https://manpages.debian.org/mapscrn",
  "checks": [
    {
      "type": "binary",
      "name": "mapscrn"
    }
  ],
  "install_guidance": {
    "plugin": "mapscrn",
    "binary": "mapscrn",
    "check": "which mapscrn",
    "install_steps": [
      "apt-get install mapscrn 2>/dev/null || which mapscrn",
      "Verify: mapscrn --version",
      "supercli plugins install ./plugins/mapscrn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mapscrn",
      "resource": "self",
      "action": "version",
      "description": "Print mapscrn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mapscrn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mapscrn: apt-get install mapscrn 2>/dev/null || which mapscrn"
      },
      "args": []
    },
    {
      "namespace": "mapscrn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mapscrn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mapscrn",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mapscrn: apt-get install mapscrn 2>/dev/null || which mapscrn"
      },
      "args": []
    }
  ]
}