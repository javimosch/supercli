{
  "name": "usbipd",
  "version": "0.1.0",
  "description": "CLI tool: usbipd",
  "source": "https://manpages.debian.org/usbipd",
  "checks": [
    {
      "type": "binary",
      "name": "usbipd"
    }
  ],
  "install_guidance": {
    "plugin": "usbipd",
    "binary": "usbipd",
    "check": "which usbipd",
    "install_steps": [
      "apt-get install usbipd 2>/dev/null || which usbipd",
      "Verify: usbipd --version",
      "supercli plugins install ./plugins/usbipd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "usbipd",
      "resource": "self",
      "action": "version",
      "description": "Print usbipd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "usbipd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install usbipd: apt-get install usbipd 2>/dev/null || which usbipd"
      },
      "args": []
    },
    {
      "namespace": "usbipd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to usbipd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "usbipd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install usbipd: apt-get install usbipd 2>/dev/null || which usbipd"
      },
      "args": []
    }
  ]
}