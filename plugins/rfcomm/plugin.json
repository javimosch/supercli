{
  "name": "rfcomm",
  "version": "0.1.0",
  "description": "CLI tool: rfcomm",
  "source": "https://manpages.debian.org/rfcomm",
  "checks": [
    {
      "type": "binary",
      "name": "rfcomm"
    }
  ],
  "install_guidance": {
    "plugin": "rfcomm",
    "binary": "rfcomm",
    "check": "which rfcomm",
    "install_steps": [
      "apt-get install rfcomm 2>/dev/null || which rfcomm",
      "Verify: rfcomm --version",
      "supercli plugins install ./plugins/rfcomm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rfcomm",
      "resource": "self",
      "action": "version",
      "description": "Print rfcomm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rfcomm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rfcomm: apt-get install rfcomm 2>/dev/null || which rfcomm"
      },
      "args": []
    },
    {
      "namespace": "rfcomm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rfcomm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rfcomm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rfcomm: apt-get install rfcomm 2>/dev/null || which rfcomm"
      },
      "args": []
    }
  ]
}