{
  "name": "nltk",
  "version": "0.1.0",
  "description": "CLI tool: nltk",
  "source": "https://manpages.debian.org/nltk",
  "checks": [
    {
      "type": "binary",
      "name": "nltk"
    }
  ],
  "install_guidance": {
    "plugin": "nltk",
    "binary": "nltk",
    "check": "which nltk",
    "install_steps": [
      "apt-get install nltk 2>/dev/null || which nltk",
      "Verify: nltk --version",
      "supercli plugins install ./plugins/nltk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nltk",
      "resource": "self",
      "action": "version",
      "description": "Print nltk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nltk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nltk: apt-get install nltk 2>/dev/null || which nltk"
      },
      "args": []
    },
    {
      "namespace": "nltk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nltk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nltk",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nltk: apt-get install nltk 2>/dev/null || which nltk"
      },
      "args": []
    }
  ]
}