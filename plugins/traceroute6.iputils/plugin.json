{
  "name": "traceroute6.iputils",
  "version": "0.1.0",
  "description": "CLI tool: traceroute6.iputils",
  "source": "https://manpages.debian.org/traceroute6.iputils",
  "checks": [
    {
      "type": "binary",
      "name": "traceroute6.iputils"
    }
  ],
  "install_guidance": {
    "plugin": "traceroute6.iputils",
    "binary": "traceroute6.iputils",
    "check": "which traceroute6.iputils",
    "install_steps": [
      "apt-get install traceroute6.iputils 2>/dev/null || which traceroute6.iputils",
      "Verify: traceroute6.iputils --version",
      "supercli plugins install ./plugins/traceroute6.iputils --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "traceroute6.iputils",
      "resource": "self",
      "action": "version",
      "description": "Print traceroute6.iputils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceroute6.iputils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install traceroute6.iputils: apt-get install traceroute6.iputils 2>/dev/null || which traceroute6.iputils"
      },
      "args": []
    },
    {
      "namespace": "traceroute6.iputils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to traceroute6.iputils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceroute6.iputils",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install traceroute6.iputils: apt-get install traceroute6.iputils 2>/dev/null || which traceroute6.iputils"
      },
      "args": []
    }
  ]
}