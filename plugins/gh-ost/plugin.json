{
  "name": "gh-ost",
  "version": "0.1.0",
  "description": "Triggerless online schema migration solution for MySQL",
  "source": "https://github.com/github/gh-ost",
  "checks": [
    {
      "type": "binary",
      "name": "gh-ost"
    }
  ],
  "install_guidance": {
    "plugin": "gh-ost",
    "binary": "gh-ost",
    "check": "which gh-ost",
    "install_steps": [
      "brew install gh-ost",
      "Verify: gh-ost --version",
      "supercli plugins install ./plugins/gh-ost --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gh-ost",
      "resource": "self",
      "action": "version",
      "description": "Print gh-ost version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-ost",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gh-ost: brew install gh-ost"
      },
      "args": []
    },
    {
      "namespace": "gh-ost",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gh-ost CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-ost",
        "passthrough": true,
        "missingDependencyHelp": "Install gh-ost"
      },
      "args": []
    }
  ]
}