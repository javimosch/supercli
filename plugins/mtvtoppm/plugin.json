{
  "name": "mtvtoppm",
  "version": "0.1.0",
  "description": "CLI tool: mtvtoppm",
  "source": "https://manpages.debian.org/mtvtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "mtvtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "mtvtoppm",
    "binary": "mtvtoppm",
    "check": "which mtvtoppm",
    "install_steps": [
      "apt-get install mtvtoppm 2>/dev/null || which mtvtoppm",
      "Verify: mtvtoppm --version",
      "supercli plugins install ./plugins/mtvtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mtvtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print mtvtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtvtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mtvtoppm: apt-get install mtvtoppm 2>/dev/null || which mtvtoppm"
      },
      "args": []
    },
    {
      "namespace": "mtvtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mtvtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtvtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mtvtoppm: apt-get install mtvtoppm 2>/dev/null || which mtvtoppm"
      },
      "args": []
    }
  ]
}