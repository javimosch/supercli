{
  "name": "conjure-im6",
  "version": "0.1.0",
  "description": "CLI tool: conjure-im6",
  "source": "https://packages.debian.org/conjure-im6",
  "checks": [{ "type": "binary", "name": "conjure-im6" }],
  "install_guidance": {
    "plugin": "conjure-im6", "binary": "conjure-im6", "check": "which conjure-im6",
    "install_steps": ["apt-get install conjure-im6 2>/dev/null || which conjure-im6", "Verify: conjure-im6 --version", "supercli plugins install ./plugins/conjure-im6 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "conjure-im6", "resource": "_", "action": "_",
    "description": "Passthrough to conjure-im6 CLI",
    "adapter": "process", "adapterConfig": { "command": "conjure-im6", "passthrough": true, "missingDependencyHelp": "Install conjure-im6: apt-get install conjure-im6" }, "args": []
  }]
}
