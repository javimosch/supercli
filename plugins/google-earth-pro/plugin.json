{
  "name": "google-earth-pro",
  "version": "0.1.0",
  "description": "CLI tool: google-earth-pro",
  "source": "https://manpages.debian.org/google-earth-pro",
  "checks": [
    {
      "type": "binary",
      "name": "google-earth-pro"
    }
  ],
  "install_guidance": {
    "plugin": "google-earth-pro",
    "binary": "google-earth-pro",
    "check": "which google-earth-pro",
    "install_steps": [
      "apt-get install google-earth-pro 2>/dev/null || which google-earth-pro",
      "Verify: google-earth-pro --version",
      "supercli plugins install ./plugins/google-earth-pro --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "google-earth-pro",
      "resource": "self",
      "action": "version",
      "description": "Print google-earth-pro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-earth-pro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install google-earth-pro: apt-get install google-earth-pro 2>/dev/null || which google-earth-pro"
      },
      "args": []
    },
    {
      "namespace": "google-earth-pro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to google-earth-pro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-earth-pro",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install google-earth-pro: apt-get install google-earth-pro 2>/dev/null || which google-earth-pro"
      },
      "args": []
    }
  ]
}