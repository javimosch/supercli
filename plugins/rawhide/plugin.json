{
  "name": "rawhide",
  "version": "0.1.0",
  "description": "Find files using pretty C expressions",
  "source": "https://github.com/raforg/rawhide",
  "checks": [
    {
      "type": "binary",
      "name": "rawhide"
    }
  ],
  "install_guidance": {
    "plugin": "rawhide",
    "binary": "rawhide",
    "check": "which rawhide",
    "install_steps": [
      "See https://github.com/raforg/rawhide",
      "Verify: rawhide --version",
      "supercli plugins install ./plugins/rawhide --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "rawhide",
      "resource": "self",
      "action": "version",
      "description": "Print rawhide version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rawhide",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rawhide: See https://github.com/raforg/rawhide"
      },
      "args": []
    },
    {
      "namespace": "rawhide",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rawhide CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rawhide",
        "passthrough": true,
        "missingDependencyHelp": "Install rawhide"
      },
      "args": []
    }
  ]
}