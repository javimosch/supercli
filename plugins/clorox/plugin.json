{
  "name": "clorox",
  "version": "0.1.0",
  "description": "CLI color picker in Rust",
  "source": "https://github.com/nicholasgasior/clorox",
  "checks": [{"type": "binary", "name": "clorox"}],
  "install_guidance": {
    "plugin": "clorox",
    "binary": "clorox",
    "check": "which clorox",
    "install_steps": [
      "cargo install clorox",
      "Verify: clorox --version",
      "supercli plugins install ./clorox --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "clorox",
      "resource": "self",
      "action": "version",
      "description": "Print clorox version",
      "adapter": "process",
      "adapterConfig": {"command": "clorox", "baseArgs": ["--version"], "missingDependencyHelp": "Install clorox: cargo install clorox"},
      "args": []
    },
    {
      "namespace": "clorox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clorox CLI",
      "adapter": "process",
      "adapterConfig": {"command": "clorox", "passthrough": true, "missingDependencyHelp": "Install clorox: cargo install clorox"},
      "args": []
    }
  ]
}
