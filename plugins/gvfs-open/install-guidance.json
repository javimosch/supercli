{
  "plugin": "gvfs-open",
  "binary": "gvfs-open",
  "check": "which gvfs-open",
  "install_steps": [
    "apt-get install gvfs-open 2>/dev/null || which gvfs-open",
    "Verify: gvfs-open --version",
    "supercli plugins install ./plugins/gvfs-open --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}