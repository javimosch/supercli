{
  "name": "qr-verify",
  "version": "0.1.0",
  "description": "Verify scannable QR Code in batch in TypeScript",
  "source": "https://github.com/nicedoc/qr-verify",
  "checks": [
    {
      "type": "binary",
      "name": "qr-verify"
    }
  ],
  "install_guidance": {
    "plugin": "qr-verify",
    "binary": "qr-verify",
    "check": "which qr-verify",
    "install_steps": [
      "npm install -g qr-verify",
      "Verify: qr-verify --version",
      "supercli plugins install ./plugins/qr-verify --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qr-verify",
      "resource": "self",
      "action": "version",
      "description": "Print qr-verify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qr-verify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qr-verify: npm install -g qr-verify"
      },
      "args": []
    },
    {
      "namespace": "qr-verify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qr-verify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qr-verify",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qr-verify: npm install -g qr-verify"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
