{
  "name": "nautilus-autorun-software",
  "version": "0.1.0",
  "description": "CLI tool: nautilus-autorun-software",
  "source": "https://manpages.debian.org/nautilus-autorun-software",
  "checks": [
    {
      "type": "binary",
      "name": "nautilus-autorun-software"
    }
  ],
  "install_guidance": {
    "plugin": "nautilus-autorun-software",
    "binary": "nautilus-autorun-software",
    "check": "which nautilus-autorun-software",
    "install_steps": [
      "apt-get install nautilus-autorun-software 2>/dev/null || which nautilus-autorun-software",
      "Verify: nautilus-autorun-software --version",
      "supercli plugins install ./plugins/nautilus-autorun-software --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nautilus-autorun-software",
      "resource": "self",
      "action": "version",
      "description": "Print nautilus-autorun-software version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nautilus-autorun-software",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nautilus-autorun-software: apt-get install nautilus-autorun-software 2>/dev/null || which nautilus-autorun-software"
      },
      "args": []
    },
    {
      "namespace": "nautilus-autorun-software",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nautilus-autorun-software CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nautilus-autorun-software",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nautilus-autorun-software: apt-get install nautilus-autorun-software 2>/dev/null || which nautilus-autorun-software"
      },
      "args": []
    }
  ]
}