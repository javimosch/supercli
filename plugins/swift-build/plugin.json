{
  "name": "swift-build",
  "version": "0.1.0",
  "description": "A high-level build system based on llbuild, used by Xcode, Swift Playground, and the Swift Package M",
  "source": "https://github.com/swift-build/swift-build",
  "checks": [
    {
      "type": "binary",
      "name": "swift-build"
    }
  ],
  "install_guidance": {
    "plugin": "swift-build",
    "binary": "swift-build",
    "check": "which swift-build",
    "install_steps": [
      "pip install swift-build",
      "Verify: swift-build --version",
      "supercli plugins install ./plugins/swift-build --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "swift-build",
      "resource": "self",
      "action": "version",
      "description": "Print swift-build version",
      "adapter": "process",
      "adapterConfig": {
        "command": "swift-build",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install swift-build: pip install swift-build"
      },
      "args": []
    },
    {
      "namespace": "swift-build",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to swift-build CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "swift-build",
        "passthrough": true,
        "missingDependencyHelp": "Install swift-build: pip install swift-build"
      },
      "args": []
    }
  ]
}