{
  "name": "wildq",
  "version": "0.1.0",
  "description": "jq-like processor for TOML, JSON, INI, and YAML files",
  "source": "https://github.com/nicholasgasior/wildq",
  "checks": [
    {
      "type": "binary",
      "name": "wildq"
    }
  ],
  "install_guidance": {
    "plugin": "wildq",
    "binary": "wildq",
    "check": "which wildq",
    "install_steps": [
      "pip install wildq",
      "Verify: wildq --version",
      "supercli plugins install ./plugins/wildq --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wildq",
      "resource": "self",
      "action": "version",
      "description": "Print wildq version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wildq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wildq: pip install wildq"
      },
      "args": []
    },
    {
      "namespace": "wildq",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wildq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wildq",
        "passthrough": true,
        "missingDependencyHelp": "Install wildq: pip install wildq"
      },
      "args": []
    }
  ]
}
