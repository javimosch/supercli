{
  "name": "dna-patch",
  "version": "0.1.0",
  "description": "Apply simple sequence edit files to DNA fasta files",
  "source": "go",
  "checks": [{ "type": "binary", "name": "dna-patch" }],
  "install_guidance": {
    "plugin": "dna-patch",
    "binary": "dna-patch",
    "check": "which dna-patch",
    "install_steps": ["go install github.com/dna-patch@latest", "Verify: dna-patch --version", "supercli plugins install ./plugins/dna-patch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dna-patch",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dna-patch CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dna-patch",
      "passthrough": true,
      "missingDependencyHelp": "Install dna-patch: go install github.com/dna-patch@latest"
    },
    "args": []
  }]
}
