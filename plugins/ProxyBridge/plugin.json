{
  "name": "ProxyBridge",
  "version": "0.1.0",
  "description": "Proxifier Alternative to redirect any Windows/MacOS/Linux TCP and UDP traffic to HTTP/Socks5 proxy",
  "source": "https://github.com/ProxyBridge/ProxyBridge",
  "checks": [
    {
      "type": "binary",
      "name": "proxybridge"
    }
  ],
  "install_guidance": {
    "plugin": "ProxyBridge",
    "binary": "proxybridge",
    "check": "which proxybridge",
    "install_steps": [
      "pip install proxybridge",
      "Verify: proxybridge --version",
      "supercli plugins install ./plugins/ProxyBridge --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ProxyBridge",
      "resource": "self",
      "action": "version",
      "description": "Print ProxyBridge version",
      "adapter": "process",
      "adapterConfig": {
        "command": "proxybridge",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ProxyBridge: pip install proxybridge"
      },
      "args": []
    },
    {
      "namespace": "ProxyBridge",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to proxybridge CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "proxybridge",
        "passthrough": true,
        "missingDependencyHelp": "Install ProxyBridge: pip install proxybridge"
      },
      "args": []
    }
  ]
}