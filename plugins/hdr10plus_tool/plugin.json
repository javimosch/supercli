{
  "name": "hdr10plus_tool",
  "version": "0.1.0",
  "description": "CLI utility to work with HDR10+ in HEVC files",
  "source": "https://github.com/quietvoid/hdr10plus_tool",
  "checks": [
    {
      "type": "binary",
      "name": "hdr10plus_tool"
    }
  ],
  "install_guidance": {
    "plugin": "hdr10plus_tool",
    "binary": "hdr10plus_tool",
    "check": "which hdr10plus_tool",
    "install_steps": [
      "brew install hdr10plus_tool",
      "Verify: hdr10plus_tool --version",
      "supercli plugins install ./plugins/hdr10plus_tool --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hdr10plus_tool",
      "resource": "self",
      "action": "version",
      "description": "Print hdr10plus_tool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdr10plus_tool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hdr10plus_tool: brew install hdr10plus_tool"
      },
      "args": []
    },
    {
      "namespace": "hdr10plus_tool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hdr10plus_tool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdr10plus_tool",
        "passthrough": true,
        "missingDependencyHelp": "Install hdr10plus_tool"
      },
      "args": []
    }
  ]
}