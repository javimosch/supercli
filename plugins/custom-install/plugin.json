{
  "name": "custom-install",
  "version": "0.1.0",
  "description": "Install CIA files directly to Nintendo 3DS SD card",
  "source": "https://github.com/ihaveamac/custom-install",
  "checks": [
    {
      "type": "binary",
      "name": "custom-install"
    }
  ],
  "install_guidance": {
    "plugin": "custom-install",
    "binary": "custom-install",
    "check": "which custom-install",
    "install_steps": [
      "brew install custom-install",
      "Verify: custom-install --version",
      "supercli plugins install ./plugins/custom-install --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "custom-install",
      "resource": "self",
      "action": "version",
      "description": "Print custom-install version",
      "adapter": "process",
      "adapterConfig": {
        "command": "custom-install",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install custom-install: brew install custom-install"
      },
      "args": []
    },
    {
      "namespace": "custom-install",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to custom-install CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "custom-install",
        "passthrough": true,
        "missingDependencyHelp": "Install custom-install"
      },
      "args": []
    }
  ]
}