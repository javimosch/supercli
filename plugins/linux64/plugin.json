{
  "name": "linux64",
  "version": "0.1.0",
  "description": "CLI tool: linux64",
  "source": "https://manpages.debian.org/linux64",
  "checks": [
    {
      "type": "binary",
      "name": "linux64"
    }
  ],
  "install_guidance": {
    "plugin": "linux64",
    "binary": "linux64",
    "check": "which linux64",
    "install_steps": [
      "apt-get install linux64 2>/dev/null || which linux64",
      "Verify: linux64 --version",
      "supercli plugins install ./plugins/linux64 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linux64",
      "resource": "self",
      "action": "version",
      "description": "Print linux64 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux64",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install linux64: apt-get install linux64 2>/dev/null || which linux64"
      },
      "args": []
    },
    {
      "namespace": "linux64",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to linux64 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux64",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install linux64: apt-get install linux64 2>/dev/null || which linux64"
      },
      "args": []
    }
  ]
}