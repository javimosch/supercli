{
  "name": "ctk",
  "version": "0.1.0",
  "description": "CLI tool: ctk",
  "source": "https://packages.debian.org/ctk",
  "checks": [{ "type": "binary", "name": "ctk" }],
  "install_guidance": {
    "plugin": "ctk", "binary": "ctk", "check": "which ctk",
    "install_steps": ["apt-get install ctk 2>/dev/null || which ctk", "Verify: ctk --version", "supercli plugins install ./plugins/ctk --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctk", "resource": "_", "action": "_",
    "description": "Passthrough to ctk CLI",
    "adapter": "process", "adapterConfig": { "command": "ctk", "passthrough": true, "missingDependencyHelp": "Install ctk: apt-get install ctk" }, "args": []
  }]
}
