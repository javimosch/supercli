{
  "name": "zignal",
  "version": "0.1.0",
  "description": "zero-dependency image processing library",
  "source": "https://github.com/zignal/zignal",
  "checks": [
    {
      "type": "binary",
      "name": "zignal"
    }
  ],
  "install_guidance": {
    "plugin": "zignal",
    "binary": "zignal",
    "check": "which zignal",
    "install_steps": [
      "pip install zignal",
      "Verify: zignal --version",
      "supercli plugins install ./plugins/zignal --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zignal",
      "resource": "self",
      "action": "version",
      "description": "Print zignal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zignal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zignal: pip install zignal"
      },
      "args": []
    },
    {
      "namespace": "zignal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zignal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zignal",
        "passthrough": true,
        "missingDependencyHelp": "Install zignal: pip install zignal"
      },
      "args": []
    }
  ]
}