{
  "name": "meetup-cli",
  "version": "0.1.0",
  "description": "Meetup.com client",
  "source": "https://github.com/specious/meetup-cli",
  "checks": [
    {
      "type": "binary",
      "name": "meetup-cli"
    }
  ],
  "install_guidance": {
    "plugin": "meetup-cli",
    "binary": "meetup-cli",
    "check": "which meetup-cli",
    "install_steps": [
      "See https://github.com/specious/meetup-cli",
      "Verify: meetup-cli --version",
      "supercli plugins install ./plugins/meetup-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "meetup-cli",
      "resource": "self",
      "action": "version",
      "description": "Print meetup-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "meetup-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install meetup-cli: See https://github.com/specious/meetup-cli"
      },
      "args": []
    },
    {
      "namespace": "meetup-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to meetup-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "meetup-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install meetup-cli"
      },
      "args": []
    }
  ]
}