{
  "name": "xtables-nft-multi",
  "version": "0.1.0",
  "description": "CLI tool: xtables-nft-multi",
  "source": "https://manpages.debian.org/xtables-nft-multi",
  "checks": [
    {
      "type": "binary",
      "name": "xtables-nft-multi"
    }
  ],
  "install_guidance": {
    "plugin": "xtables-nft-multi",
    "binary": "xtables-nft-multi",
    "check": "which xtables-nft-multi",
    "install_steps": [
      "apt-get install xtables-nft-multi 2>/dev/null || which xtables-nft-multi",
      "Verify: xtables-nft-multi --version",
      "supercli plugins install ./plugins/xtables-nft-multi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xtables-nft-multi",
      "resource": "self",
      "action": "version",
      "description": "Print xtables-nft-multi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xtables-nft-multi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xtables-nft-multi: apt-get install xtables-nft-multi 2>/dev/null || which xtables-nft-multi"
      },
      "args": []
    },
    {
      "namespace": "xtables-nft-multi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xtables-nft-multi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xtables-nft-multi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xtables-nft-multi: apt-get install xtables-nft-multi 2>/dev/null || which xtables-nft-multi"
      },
      "args": []
    }
  ]
}