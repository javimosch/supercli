{
  "name": "rsnip",
  "version": "0.1.0",
  "description": "Powerful Rust-based code snippet manager",
  "source": "https://github.com/sysid/rsnip",
  "checks": [{ "type": "binary", "name": "rsnip" }],
  "install_guidance": {
    "plugin": "rsnip",
    "binary": "rsnip",
    "check": "which rsnip",
    "install_steps": ["cargo install rsnip", "Verify: rsnip --version", "supercli plugins install ./plugins/rsnip --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rsnip",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rsnip CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rsnip",
      "passthrough": true,
      "missingDependencyHelp": "Install rsnip: cargo install rsnip", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
