{
  "name": "elvis",
  "version": "0.1.0",
  "description": "Erlang Style Reviewer",
  "source": "https://github.com/inaka/elvis",
  "checks": [
    {
      "type": "binary",
      "name": "elvis"
    }
  ],
  "install_guidance": {
    "plugin": "elvis",
    "binary": "elvis",
    "check": "which elvis",
    "install_steps": [
      "brew install elvis",
      "Verify: elvis --version",
      "supercli plugins install ./plugins/elvis --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "elvis",
      "resource": "self",
      "action": "version",
      "description": "Print elvis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "elvis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install elvis: brew install elvis"
      },
      "args": []
    },
    {
      "namespace": "elvis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to elvis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "elvis",
        "passthrough": true,
        "missingDependencyHelp": "Install elvis"
      },
      "args": []
    }
  ]
}