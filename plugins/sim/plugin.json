{
  "name": "sim",
  "version": "0.1.0",
  "description": "Build, deploy, and orchestrate AI agents. Sim is the central intelligence layer for your AI workforc",
  "source": "https://github.com/sim/sim",
  "checks": [
    {
      "type": "binary",
      "name": "sim"
    }
  ],
  "install_guidance": {
    "plugin": "sim",
    "binary": "sim",
    "check": "which sim",
    "install_steps": [
      "pip install sim",
      "Verify: sim --version",
      "supercli plugins install ./plugins/sim --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sim",
      "resource": "self",
      "action": "version",
      "description": "Print sim version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sim",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sim: pip install sim"
      },
      "args": []
    },
    {
      "namespace": "sim",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sim CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sim",
        "passthrough": true,
        "missingDependencyHelp": "Install sim: pip install sim"
      },
      "args": []
    }
  ]
}