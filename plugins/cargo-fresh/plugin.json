{
  "name": "cargo-fresh",
  "version": "0.1.0",
  "description": "Check and update globally installed Cargo packages with JSON output and smart prerelease detection",
  "source": "https://github.com/jenkinpan/cargo-fresh",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-fresh"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-fresh",
    "binary": "cargo-fresh",
    "check": "which cargo-fresh",
    "install_steps": [
      "cargo install cargo-fresh",
      "Verify: cargo-fresh --version",
      "supercli plugins install ./plugins/cargo-fresh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo-fresh",
      "resource": "self",
      "action": "version",
      "description": "Print cargo-fresh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-fresh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-fresh: cargo install cargo-fresh"
      },
      "args": []
    },
    {
      "namespace": "cargo-fresh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-fresh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-fresh",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-fresh: cargo install cargo-fresh"
      },
      "args": []
    }
  ]
}
