{
  "name": "cfn-flip",
  "version": "0.1.0",
  "description": "Convert AWS CloudFormation templates between JSON and YAML formats",
  "source": "https://github.com/awslabs/aws-cfn-template-flip",
  "checks": [
    {
      "type": "binary",
      "name": "cfn-flip"
    }
  ],
  "install_guidance": {
    "plugin": "cfn-flip",
    "binary": "cfn-flip",
    "check": "which cfn-flip",
    "install_steps": [
      "brew install cfn-flip",
      "Verify: cfn-flip --version",
      "supercli plugins install ./plugins/cfn-flip --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cfn-flip",
      "resource": "self",
      "action": "version",
      "description": "Print cfn-flip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cfn-flip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cfn-flip: brew install cfn-flip"
      },
      "args": []
    },
    {
      "namespace": "cfn-flip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cfn-flip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cfn-flip",
        "passthrough": true,
        "missingDependencyHelp": "Install cfn-flip"
      },
      "args": []
    }
  ]
}