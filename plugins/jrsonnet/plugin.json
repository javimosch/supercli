{
  "name": "jrsonnet",
  "version": "0.1.0",
  "description": "Rust implementation of Jsonnet language",
  "source": "https://github.com/CertainLach/jrsonnet",
  "checks": [
    {
      "type": "binary",
      "name": "jrsonnet"
    }
  ],
  "install_guidance": {
    "plugin": "jrsonnet",
    "binary": "jrsonnet",
    "check": "which jrsonnet",
    "install_steps": [
      "brew install jrsonnet",
      "Verify: jrsonnet --version",
      "supercli plugins install ./plugins/jrsonnet --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jrsonnet",
      "resource": "self",
      "action": "version",
      "description": "Print jrsonnet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jrsonnet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jrsonnet: brew install jrsonnet"
      },
      "args": []
    },
    {
      "namespace": "jrsonnet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jrsonnet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jrsonnet",
        "passthrough": true,
        "missingDependencyHelp": "Install jrsonnet"
      },
      "args": []
    }
  ]
}