{
  "plugin": "wasm-pack",
  "binary": "wasm-pack",
  "check": "which wasm-pack",
  "install_steps": [
    "cargo install wasm-pack",
    "Verify: wasm-pack --version",
    "supercli plugins install ./plugins/wasm-pack --on-conflict replace --json"
  ],
  "note": "Also available via npm: npm install -g wasm-pack. Requires Rust toolchain."
}
