{
  "name": "counts",
  "version": "0.1.0",
  "description": "Tool for ad hoc profiling",
  "source": "https://github.com/nnethercote/counts",
  "checks": [
    {
      "type": "binary",
      "name": "counts"
    }
  ],
  "install_guidance": {
    "plugin": "counts",
    "binary": "counts",
    "check": "which counts",
    "install_steps": [
      "brew install counts",
      "Verify: counts --version",
      "supercli plugins install ./plugins/counts --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "counts",
      "resource": "self",
      "action": "version",
      "description": "Print counts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "counts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install counts: brew install counts"
      },
      "args": []
    },
    {
      "namespace": "counts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to counts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "counts",
        "passthrough": true,
        "missingDependencyHelp": "Install counts"
      },
      "args": []
    }
  ]
}