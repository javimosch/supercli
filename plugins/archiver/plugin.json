{
  "name": "archiver",
  "version": "0.1.0",
  "description": "Go library and CLI for multiple archive format handling",
  "source": "https://github.com/mholt/archiver",
  "checks": [{ "type": "binary", "name": "archiver" }],
  "install_guidance": {
    "plugin": "archiver",
    "binary": "archiver",
    "check": "which archiver",
    "install_steps": ["go get github.com/mholt/archiver", "Verify: archiver --version", "supercli plugins install ./plugins/archiver --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "archiver",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to archiver CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "archiver",
      "passthrough": true,
      "missingDependencyHelp": "Install archiver: go get github.com/mholt/archiver", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
