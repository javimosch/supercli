{
  "name": "gotpm",
  "version": "0.1.0",
  "description": "CLI for using TPM 2.0",
  "source": "https://github.com/google/go-tpm-tools",
  "checks": [
    {
      "type": "binary",
      "name": "gotpm"
    }
  ],
  "install_guidance": {
    "plugin": "gotpm",
    "binary": "gotpm",
    "check": "which gotpm",
    "install_steps": [
      "brew install gotpm",
      "Verify: gotpm --version",
      "supercli plugins install ./plugins/gotpm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gotpm",
      "resource": "self",
      "action": "version",
      "description": "Print gotpm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotpm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gotpm: brew install gotpm"
      },
      "args": []
    },
    {
      "namespace": "gotpm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gotpm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotpm",
        "passthrough": true,
        "missingDependencyHelp": "Install gotpm"
      },
      "args": []
    }
  ]
}