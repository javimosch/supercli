{
  "name": "ppmdither",
  "version": "0.1.0",
  "description": "CLI tool: ppmdither",
  "source": "https://manpages.debian.org/ppmdither",
  "checks": [
    {
      "type": "binary",
      "name": "ppmdither"
    }
  ],
  "install_guidance": {
    "plugin": "ppmdither",
    "binary": "ppmdither",
    "check": "which ppmdither",
    "install_steps": [
      "apt-get install ppmdither 2>/dev/null || which ppmdither",
      "Verify: ppmdither --version",
      "supercli plugins install ./plugins/ppmdither --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmdither",
      "resource": "self",
      "action": "version",
      "description": "Print ppmdither version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmdither",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmdither: apt-get install ppmdither 2>/dev/null || which ppmdither"
      },
      "args": []
    },
    {
      "namespace": "ppmdither",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmdither CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmdither",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmdither: apt-get install ppmdither 2>/dev/null || which ppmdither"
      },
      "args": []
    }
  ]
}