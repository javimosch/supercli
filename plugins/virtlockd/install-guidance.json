{
  "plugin": "virtlockd",
  "binary": "virtlockd",
  "check": "which virtlockd",
  "install_steps": [
    "apt-get install virtlockd 2>/dev/null || which virtlockd",
    "Verify: virtlockd --version",
    "supercli plugins install ./plugins/virtlockd --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}