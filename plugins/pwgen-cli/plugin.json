{
  "name": "pwgen-cli",
  "version": "0.1.0",
  "description": "Memorable password generator with multiple modes",
  "source": "https://github.com/agile6v/pwgen-cli",
  "checks": [{ "type": "binary", "name": "pwgen-cli" }],
  "install_guidance": {
    "plugin": "pwgen-cli",
    "binary": "pwgen-cli",
    "check": "which pwgen-cli",
    "install_steps": ["npm install -g pwgen-cli", "Verify: pwgen-cli --version", "supercli plugins install ./plugins/pwgen-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pwgen-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pwgen-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pwgen-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install pwgen-cli: npm install -g pwgen-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
