{
  "name": "LLocalSearch",
  "version": "0.1.0",
  "description": "LLocalSearch is a completely locally running search aggregator using LLM Agents. The user can ask a ",
  "source": "https://github.com/LLocalSearch/LLocalSearch",
  "checks": [
    {
      "type": "binary",
      "name": "llocalsearch"
    }
  ],
  "install_guidance": {
    "plugin": "LLocalSearch",
    "binary": "llocalsearch",
    "check": "which llocalsearch",
    "install_steps": [
      "pip install llocalsearch",
      "Verify: llocalsearch --version",
      "supercli plugins install ./plugins/LLocalSearch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LLocalSearch",
      "resource": "self",
      "action": "version",
      "description": "Print LLocalSearch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llocalsearch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LLocalSearch: pip install llocalsearch"
      },
      "args": []
    },
    {
      "namespace": "LLocalSearch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llocalsearch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llocalsearch",
        "passthrough": true,
        "missingDependencyHelp": "Install LLocalSearch: pip install llocalsearch"
      },
      "args": []
    }
  ]
}