{
  "name": "ui",
  "version": "0.1.0",
  "description": "A set of beautifully-designed, accessible components and a code distribution platform. Works with yo",
  "source": "https://github.com/ui/ui",
  "checks": [
    {
      "type": "binary",
      "name": "ui"
    }
  ],
  "install_guidance": {
    "plugin": "ui",
    "binary": "ui",
    "check": "which ui",
    "install_steps": [
      "pip install ui",
      "Verify: ui --version",
      "supercli plugins install ./plugins/ui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ui",
      "resource": "self",
      "action": "version",
      "description": "Print ui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ui: pip install ui"
      },
      "args": []
    },
    {
      "namespace": "ui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ui",
        "passthrough": true,
        "missingDependencyHelp": "Install ui: pip install ui"
      },
      "args": []
    }
  ]
}