{
  "name": "commitlint-cli",
  "version": "0.1.0",
  "description": "Lint commit messages to follow conventional commit standards",
  "source": "https://github.com/conventional-changelog/commitlint",
  "checks": [{ "type": "binary", "name": "commitlint" }],
  "install_guidance": {
    "plugin": "commitlint-cli",
    "binary": "commitlint",
    "check": "which commitlint",
    "install_steps": ["npm install -g @commitlint/cli", "Verify: commitlint --version", "supercli plugins install ./plugins/commitlint-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "commitlint-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to commitlint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "commitlint",
      "passthrough": true,
      "missingDependencyHelp": "Install commitlint-cli: npm install -g @commitlint/cli"
    },
    "args": []
  }]
}
