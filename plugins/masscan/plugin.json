      "args": []
    },
    {
      "namespace": "masscan",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to masscan CLI",
      "adapter": "process",
      "adapterConfig": {"command": "masscan", "passthrough": true, "missingDependencyHelp": "Install masscan: brew install masscan"},
      "args": []
    }
  ]
