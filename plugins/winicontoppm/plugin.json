{
  "name": "winicontoppm",
  "version": "0.1.0",
  "description": "CLI tool: winicontoppm",
  "source": "https://manpages.debian.org/winicontoppm",
  "checks": [
    {
      "type": "binary",
      "name": "winicontoppm"
    }
  ],
  "install_guidance": {
    "plugin": "winicontoppm",
    "binary": "winicontoppm",
    "check": "which winicontoppm",
    "install_steps": [
      "apt-get install winicontoppm 2>/dev/null || which winicontoppm",
      "Verify: winicontoppm --version",
      "supercli plugins install ./plugins/winicontoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "winicontoppm",
      "resource": "self",
      "action": "version",
      "description": "Print winicontoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "winicontoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install winicontoppm: apt-get install winicontoppm 2>/dev/null || which winicontoppm"
      },
      "args": []
    },
    {
      "namespace": "winicontoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to winicontoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "winicontoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install winicontoppm: apt-get install winicontoppm 2>/dev/null || which winicontoppm"
      },
      "args": []
    }
  ]
}