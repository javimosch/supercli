{
  "name": "MiniCPM-V",
  "version": "0.1.0",
  "description": "A Pocket-Sized MLLM for Ultra-Efficient Image and Video Understanding on Your Phone",
  "source": "https://github.com/MiniCPM-V/MiniCPM-V",
  "checks": [
    {
      "type": "binary",
      "name": "minicpm-v"
    }
  ],
  "install_guidance": {
    "plugin": "MiniCPM-V",
    "binary": "minicpm-v",
    "check": "which minicpm-v",
    "install_steps": [
      "pip install minicpm-v",
      "Verify: minicpm-v --version",
      "supercli plugins install ./plugins/MiniCPM-V --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MiniCPM-V",
      "resource": "self",
      "action": "version",
      "description": "Print MiniCPM-V version",
      "adapter": "process",
      "adapterConfig": {
        "command": "minicpm-v",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MiniCPM-V: pip install minicpm-v"
      },
      "args": []
    },
    {
      "namespace": "MiniCPM-V",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to minicpm-v CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "minicpm-v",
        "passthrough": true,
        "missingDependencyHelp": "Install MiniCPM-V: pip install minicpm-v"
      },
      "args": []
    }
  ]
}