{
  "name": "git-machete",
  "version": "0.1.0",
  "description": "Git repository organizer & rebase workflow automation tool",
  "source": "https://github.com/VirtusLab/git-machete",
  "checks": [
    {
      "type": "binary",
      "name": "git-machete"
    }
  ],
  "install_guidance": {
    "plugin": "git-machete",
    "binary": "git-machete",
    "check": "which git-machete",
    "install_steps": [
      "brew install git-machete",
      "Verify: git-machete --version",
      "supercli plugins install ./plugins/git-machete --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-machete",
      "resource": "self",
      "action": "version",
      "description": "Print git-machete version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-machete",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-machete: brew install git-machete"
      },
      "args": []
    },
    {
      "namespace": "git-machete",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-machete CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-machete",
        "passthrough": true,
        "missingDependencyHelp": "Install git-machete"
      },
      "args": []
    }
  ]
}