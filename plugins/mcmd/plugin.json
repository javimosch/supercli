{
  "name": "mcmd",
  "version": "0.1.0",
  "description": "Statistical analysis and manipulation tool for tabular data",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "mcmd" }],
  "install_guidance": {
    "plugin": "mcmd",
    "binary": "mcmd",
    "check": "which mcmd",
    "install_steps": ["git clone && make", "Verify: mcmd --version", "supercli plugins install ./plugins/mcmd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mcmd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mcmd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mcmd",
      "passthrough": true,
      "missingDependencyHelp": "Install mcmd: git clone && make"
    },
    "args": []
  }]
}
