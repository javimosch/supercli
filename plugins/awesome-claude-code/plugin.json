{
  "name": "awesome-claude-code",
  "version": "0.1.0",
  "description": "A curated list of awesome skills, hooks, slash-commands, agent orchestrators, applications, and plug",
  "source": "https://github.com/awesome-claude-code/awesome-claude-code",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-claude-code"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-claude-code",
    "binary": "awesome-claude-code",
    "check": "which awesome-claude-code",
    "install_steps": [
      "pip install awesome-claude-code",
      "Verify: awesome-claude-code --version",
      "supercli plugins install ./plugins/awesome-claude-code --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-claude-code",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-claude-code version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-claude-code",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-claude-code: pip install awesome-claude-code"
      },
      "args": []
    },
    {
      "namespace": "awesome-claude-code",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-claude-code CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-claude-code",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-claude-code: pip install awesome-claude-code"
      },
      "args": []
    }
  ]
}