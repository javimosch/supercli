{
  "name": "skate",
  "version": "0.1.0",
  "description": "Personal key-value store for the terminal",
  "source": "https://github.com/charmbracelet/skate",
  "checks": [{ "type": "binary", "name": "skate" }],
  "install_guidance": {
    "plugin": "skate",
    "binary": "skate",
    "check": "which skate",
    "install_steps": ["brew install skate", "Verify: skate --version", "supercli plugins install ./plugins/skate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "skate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to skate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "skate",
      "passthrough": true,
      "missingDependencyHelp": "Install skate: brew install skate"
    },
    "args": []
  }]
}
