{
  "name": "oxipng",
  "version": "0.1.0",
  "description": "Rust-based PNG optimizer with Zopfli mode",
  "source": "https://github.com/shssoichiro/oxipng",
  "checks": [
    {
      "type": "binary",
      "name": "oxipng"
    }
  ],
  "install_guidance": {
    "plugin": "oxipng",
    "binary": "oxipng",
    "check": "which oxipng",
    "install_steps": [
      "cargo install oxipng",
      "Verify: oxipng --version",
      "supercli plugins install ./plugins/oxipng --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "oxipng",
      "resource": "self",
      "action": "version",
      "description": "Print oxipng version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxipng",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oxipng: cargo install oxipng"
      },
      "args": []
    },
    {
      "namespace": "oxipng",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oxipng CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxipng",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install oxipng: cargo install oxipng"
      },
      "args": []
    }
  ]
}
