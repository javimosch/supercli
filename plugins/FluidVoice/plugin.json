{
  "name": "FluidVoice",
  "version": "0.1.0",
  "description": "FluidVoice - Fastest macOS Offline Dictation app - Voice to Text fully Local. One \u2b50 takes us a long ",
  "source": "https://github.com/FluidVoice/FluidVoice",
  "checks": [
    {
      "type": "binary",
      "name": "fluidvoice"
    }
  ],
  "install_guidance": {
    "plugin": "FluidVoice",
    "binary": "fluidvoice",
    "check": "which fluidvoice",
    "install_steps": [
      "pip install fluidvoice",
      "Verify: fluidvoice --version",
      "supercli plugins install ./plugins/FluidVoice --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FluidVoice",
      "resource": "self",
      "action": "version",
      "description": "Print FluidVoice version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fluidvoice",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FluidVoice: pip install fluidvoice"
      },
      "args": []
    },
    {
      "namespace": "FluidVoice",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fluidvoice CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fluidvoice",
        "passthrough": true,
        "missingDependencyHelp": "Install FluidVoice: pip install fluidvoice"
      },
      "args": []
    }
  ]
}