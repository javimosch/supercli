{
  "name": "Snapzy",
  "version": "0.1.0",
  "description": "An open-source native macOS screenshot and screen recording app. A CleanShot X alternative.",
  "source": "https://github.com/Snapzy/Snapzy",
  "checks": [
    {
      "type": "binary",
      "name": "snapzy"
    }
  ],
  "install_guidance": {
    "plugin": "Snapzy",
    "binary": "snapzy",
    "check": "which snapzy",
    "install_steps": [
      "pip install snapzy",
      "Verify: snapzy --version",
      "supercli plugins install ./plugins/Snapzy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Snapzy",
      "resource": "self",
      "action": "version",
      "description": "Print Snapzy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "snapzy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Snapzy: pip install snapzy"
      },
      "args": []
    },
    {
      "namespace": "Snapzy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to snapzy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "snapzy",
        "passthrough": true,
        "missingDependencyHelp": "Install Snapzy: pip install snapzy"
      },
      "args": []
    }
  ]
}