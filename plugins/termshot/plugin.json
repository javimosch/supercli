{
  "name": "termshot",
  "version": "0.1.0",
  "description": "Create terminal screenshots as PNG images",
  "source": "https://github.com/homeport/termshot",
  "checks": [{ "type": "binary", "name": "termshot" }],
  "install_guidance": {
    "plugin": "termshot",
    "binary": "termshot",
    "check": "which termshot",
    "install_steps": ["cargo install termshot", "Verify: termshot --version", "supercli plugins install ./plugins/termshot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "termshot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to termshot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "termshot",
      "passthrough": true,
      "missingDependencyHelp": "Install termshot: cargo install termshot", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
