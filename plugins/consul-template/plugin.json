{
  "name": "consul-template",
  "version": "0.1.0",
  "description": "Generic template rendering and notifications with Consul",
  "source": "https://github.com/hashicorp/consul-template",
  "checks": [{ "type": "binary", "name": "consul-template" }],
  "install_guidance": {
    "plugin": "consul-template",
    "binary": "consul-template",
    "check": "which consul-template",
    "install_steps": ["brew install consul-template", "Verify: consul-template --version", "supercli plugins install ./plugins/consul-template --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "consul-template",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to consul-template CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "consul-template",
      "passthrough": true,
      "missingDependencyHelp": "Install consul-template: brew install consul-template"
    },
    "args": []
  }]
}
