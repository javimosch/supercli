{
  "name": "guard",
  "version": "0.1.0",
  "description": "gRPC WireGuard server implementation for tunnel management",
  "source": "go",
  "checks": [{ "type": "binary", "name": "guard" }],
  "install_guidance": {
    "plugin": "guard",
    "binary": "guard",
    "check": "which guard",
    "install_steps": ["go install github.com/stellarproject/guard@latest", "Verify: guard --version", "supercli plugins install ./plugins/guard --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "guard",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to guard CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "guard",
      "passthrough": true,
      "missingDependencyHelp": "Install guard: go install github.com/stellarproject/guard@latest"
    },
    "args": []
  }]
}
