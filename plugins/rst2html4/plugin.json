{
  "name": "rst2html4",
  "version": "0.1.0",
  "description": "CLI tool: rst2html4",
  "source": "https://manpages.debian.org/rst2html4",
  "checks": [
    {
      "type": "binary",
      "name": "rst2html4"
    }
  ],
  "install_guidance": {
    "plugin": "rst2html4",
    "binary": "rst2html4",
    "check": "which rst2html4",
    "install_steps": [
      "apt-get install rst2html4 2>/dev/null || which rst2html4",
      "Verify: rst2html4 --version",
      "supercli plugins install ./plugins/rst2html4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rst2html4",
      "resource": "self",
      "action": "version",
      "description": "Print rst2html4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2html4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rst2html4: apt-get install rst2html4 2>/dev/null || which rst2html4"
      },
      "args": []
    },
    {
      "namespace": "rst2html4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rst2html4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2html4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rst2html4: apt-get install rst2html4 2>/dev/null || which rst2html4"
      },
      "args": []
    }
  ]
}