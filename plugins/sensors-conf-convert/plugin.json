{
  "name": "sensors-conf-convert",
  "version": "0.1.0",
  "description": "CLI tool: sensors-conf-convert",
  "source": "https://manpages.debian.org/sensors-conf-convert",
  "checks": [
    {
      "type": "binary",
      "name": "sensors-conf-convert"
    }
  ],
  "install_guidance": {
    "plugin": "sensors-conf-convert",
    "binary": "sensors-conf-convert",
    "check": "which sensors-conf-convert",
    "install_steps": [
      "apt-get install sensors-conf-convert 2>/dev/null || which sensors-conf-convert",
      "Verify: sensors-conf-convert --version",
      "supercli plugins install ./plugins/sensors-conf-convert --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sensors-conf-convert",
      "resource": "self",
      "action": "version",
      "description": "Print sensors-conf-convert version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sensors-conf-convert",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sensors-conf-convert: apt-get install sensors-conf-convert 2>/dev/null || which sensors-conf-convert"
      },
      "args": []
    },
    {
      "namespace": "sensors-conf-convert",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sensors-conf-convert CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sensors-conf-convert",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sensors-conf-convert: apt-get install sensors-conf-convert 2>/dev/null || which sensors-conf-convert"
      },
      "args": []
    }
  ]
}