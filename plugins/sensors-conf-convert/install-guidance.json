{
  "plugin": "sensors-conf-convert",
  "binary": "sensors-conf-convert",
  "check": "which sensors-conf-convert",
  "install_steps": [
    "apt-get install sensors-conf-convert 2>/dev/null || which sensors-conf-convert",
    "Verify: sensors-conf-convert --version",
    "supercli plugins install ./plugins/sensors-conf-convert --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}