{
  "name": "md5sum.textutils",
  "version": "0.1.0",
  "description": "CLI tool: md5sum.textutils",
  "source": "https://manpages.debian.org/md5sum.textutils",
  "checks": [
    {
      "type": "binary",
      "name": "md5sum.textutils"
    }
  ],
  "install_guidance": {
    "plugin": "md5sum.textutils",
    "binary": "md5sum.textutils",
    "check": "which md5sum.textutils",
    "install_steps": [
      "apt-get install md5sum.textutils 2>/dev/null || which md5sum.textutils",
      "Verify: md5sum.textutils --version",
      "supercli plugins install ./plugins/md5sum.textutils --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "md5sum.textutils",
      "resource": "self",
      "action": "version",
      "description": "Print md5sum.textutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "md5sum.textutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install md5sum.textutils: apt-get install md5sum.textutils 2>/dev/null || which md5sum.textutils"
      },
      "args": []
    },
    {
      "namespace": "md5sum.textutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to md5sum.textutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "md5sum.textutils",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install md5sum.textutils: apt-get install md5sum.textutils 2>/dev/null || which md5sum.textutils"
      },
      "args": []
    }
  ]
}