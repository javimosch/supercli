{
  "name": "pandoc-include",
  "version": "0.1.0",
  "description": "Pandoc filter for including files",
  "source": "https://github.com/DCsunset/pandoc-include",
  "checks": [
    {
      "type": "binary",
      "name": "pandoc-include"
    }
  ],
  "install_guidance": {
    "plugin": "pandoc-include",
    "binary": "pandoc-include",
    "check": "which pandoc-include",
    "install_steps": [
      "pip install pandoc-include",
      "Verify: pandoc-include --version",
      "supercli plugins install ./plugins/pandoc-include --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "pandoc-include",
      "resource": "self",
      "action": "version",
      "description": "Print pandoc-include version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pandoc-include",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pandoc-include: pip install pandoc-include"
      },
      "args": []
    },
    {
      "namespace": "pandoc-include",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pandoc-include CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pandoc-include",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pandoc-include: pip install pandoc-include"
      },
      "args": []
    }
  ]
}
