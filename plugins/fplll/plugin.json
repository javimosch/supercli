{
  "name": "fplll",
  "version": "0.1.0",
  "description": "Lattice algorithms using floating-point arithmetic",
  "source": "https://github.com/fplll/fplll",
  "checks": [
    {
      "type": "binary",
      "name": "fplll"
    }
  ],
  "install_guidance": {
    "plugin": "fplll",
    "binary": "fplll",
    "check": "which fplll",
    "install_steps": [
      "brew install fplll",
      "Verify: fplll --version",
      "supercli plugins install ./plugins/fplll --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fplll",
      "resource": "self",
      "action": "version",
      "description": "Print fplll version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fplll",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fplll: brew install fplll"
      },
      "args": []
    },
    {
      "namespace": "fplll",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fplll CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fplll",
        "passthrough": true,
        "missingDependencyHelp": "Install fplll"
      },
      "args": []
    }
  ]
}