{
  "name": "dtool",
  "version": "0.1.0",
  "description": "Collection of development tools.",
  "source": "https://github.com/guoxbin/dtool",
  "checks": [
    {
      "type": "binary",
      "name": "dtool"
    }
  ],
  "install_guidance": {
    "plugin": "dtool",
    "binary": "dtool",
    "check": "which dtool",
    "install_steps": [
      "cargo install dtool",
      "Verify: dtool --version",
      "supercli plugins install ./plugins/dtool --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dtool",
      "resource": "self",
      "action": "version",
      "description": "Print dtool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dtool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dtool: cargo install dtool"
      },
      "args": []
    },
    {
      "namespace": "dtool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dtool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dtool",
        "passthrough": true,
        "missingDependencyHelp": "Install dtool"
      },
      "args": []
    }
  ]
}