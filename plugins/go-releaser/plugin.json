{
  "name": "go-releaser",
  "version": "0.1.0",
  "description": "Go project release automation CLI — build, package, and publish with JSON output",
  "source": "https://github.com/go-releaser/go-releaser",
  "checks": [
    {
      "type": "binary",
      "name": "go-releaser"
    }
  ],
  "install_guidance": {
    "plugin": "go-releaser",
    "binary": "go-releaser",
    "check": "which go-releaser",
    "install_steps": [
      "go install github.com/go-releaser/go-releaser@latest",
      "Verify: go-releaser --version",
      "supercli plugins install ./plugins/go-releaser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-releaser",
      "resource": "self",
      "action": "version",
      "description": "Print go-releaser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-releaser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-releaser: go install github.com/go-releaser/go-releaser@latest"
      },
      "args": []
    },
    {
      "namespace": "go-releaser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-releaser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-releaser",
        "passthrough": true,
        "missingDependencyHelp": "Install go-releaser: go install github.com/go-releaser/go-releaser@latest"
      },
      "args": []
    }
  ]
}
