{
  "name": "openclaude",
  "version": "0.1.0",
  "description": "runs anywhere. uses anything",
  "source": "https://github.com/openclaude/openclaude",
  "checks": [
    {
      "type": "binary",
      "name": "openclaude"
    }
  ],
  "install_guidance": {
    "plugin": "openclaude",
    "binary": "openclaude",
    "check": "which openclaude",
    "install_steps": [
      "pip install openclaude",
      "Verify: openclaude --version",
      "supercli plugins install ./plugins/openclaude --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openclaude",
      "resource": "self",
      "action": "version",
      "description": "Print openclaude version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaude",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openclaude: pip install openclaude"
      },
      "args": []
    },
    {
      "namespace": "openclaude",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openclaude CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaude",
        "passthrough": true,
        "missingDependencyHelp": "Install openclaude: pip install openclaude"
      },
      "args": []
    }
  ]
}