{
  "name": "gcc-8",
  "version": "0.1.0",
  "description": "CLI tool: gcc-8",
  "source": "https://manpages.debian.org/gcc-8",
  "checks": [
    {
      "type": "binary",
      "name": "gcc-8"
    }
  ],
  "install_guidance": {
    "plugin": "gcc-8",
    "binary": "gcc-8",
    "check": "which gcc-8",
    "install_steps": [
      "apt-get install gcc-8 2>/dev/null || which gcc-8",
      "Verify: gcc-8 --version",
      "supercli plugins install ./plugins/gcc-8 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gcc-8",
      "resource": "self",
      "action": "version",
      "description": "Print gcc-8 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcc-8",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcc-8: apt-get install gcc-8 2>/dev/null || which gcc-8"
      },
      "args": []
    },
    {
      "namespace": "gcc-8",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcc-8 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcc-8",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gcc-8: apt-get install gcc-8 2>/dev/null || which gcc-8"
      },
      "args": []
    }
  ]
}