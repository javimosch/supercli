{
  "name": "fancy-cat",
  "version": "0.1.0",
  "description": "PDF reader for terminal emulators using the Kitty image protocol",
  "source": "https://github.com/fancy-cat/fancy-cat",
  "checks": [
    {
      "type": "binary",
      "name": "fancy-cat"
    }
  ],
  "install_guidance": {
    "plugin": "fancy-cat",
    "binary": "fancy-cat",
    "check": "which fancy-cat",
    "install_steps": [
      "pip install fancy-cat",
      "Verify: fancy-cat --version",
      "supercli plugins install ./plugins/fancy-cat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fancy-cat",
      "resource": "self",
      "action": "version",
      "description": "Print fancy-cat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fancy-cat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fancy-cat: pip install fancy-cat"
      },
      "args": []
    },
    {
      "namespace": "fancy-cat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fancy-cat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fancy-cat",
        "passthrough": true,
        "missingDependencyHelp": "Install fancy-cat: pip install fancy-cat"
      },
      "args": []
    }
  ]
}