{
  "name": "conjure",
  "version": "1.0.0",
  "description": "conjure \u2014 HTTP API testing from terminal",
  "source": "github.com/conjure-cp/conjure",
  "checks": [
    {
      "type": "binary",
      "name": "conjure"
    }
  ],
  "install_guidance": {
    "plugin": "conjure",
    "binary": "conjure",
    "check": "which conjure",
    "install_steps": [
      "# Install conjure",
      "# See github.com/conjure-cp/conjure",
      "# apt: sudo apt-get install conjure",
      "# brew: brew install conjure",
      "# cargo: cargo install conjure",
      "# npm: npm install -g conjure",
      "# pip: pip install conjure"
    ]
  },
  "commands": [
    {
      "namespace": "conjure",
      "resource": "conjure",
      "action": "run",
      "description": "Run conjure",
      "adapter": "process",
      "adapterConfig": {
        "command": "conjure",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install conjure from github.com/conjure-cp/conjure"
      },
      "args": []
    }
  ]
}