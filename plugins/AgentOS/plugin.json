{
  "name": "AgentOS",
  "version": "0.1.0",
  "description": "Airymax AgentOS Transcend context limits. Achieve near-infinite memory.",
  "source": "https://github.com/AgentOS/AgentOS",
  "checks": [
    {
      "type": "binary",
      "name": "agentos"
    }
  ],
  "install_guidance": {
    "plugin": "AgentOS",
    "binary": "agentos",
    "check": "which agentos",
    "install_steps": [
      "pip install agentos",
      "Verify: agentos --version",
      "supercli plugins install ./plugins/AgentOS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AgentOS",
      "resource": "self",
      "action": "version",
      "description": "Print AgentOS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AgentOS: pip install agentos"
      },
      "args": []
    },
    {
      "namespace": "AgentOS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agentos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentos",
        "passthrough": true,
        "missingDependencyHelp": "Install AgentOS: pip install agentos"
      },
      "args": []
    }
  ]
}