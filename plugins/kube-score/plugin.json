{
  "name": "kube-score",
  "version": "0.1.0",
  "description": "Kubernetes object analysis scoring tool",
  "source": "https://github.com/zegl/kube-score",
  "checks": [
    {
      "type": "binary",
      "name": "kube-score"
    }
  ],
  "install_guidance": {
    "plugin": "kube-score",
    "binary": "kube-score",
    "check": "which kube-score",
    "install_steps": [
      "brew install kube-score",
      "Verify: kube-score --version",
      "supercli plugins install ./plugins/kube-score --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "kube-score",
      "resource": "self",
      "action": "version",
      "description": "Print kube-score version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kube-score",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kube-score: brew install kube-score"
      },
      "args": []
    },
    {
      "namespace": "kube-score",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kube-score CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kube-score",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install kube-score: brew install kube-score"
      },
      "args": []
    }
  ]
}
