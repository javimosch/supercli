{
  "name": "discrawl",
  "version": "0.1.0",
  "description": "discrawl - Discord CLI with sqlite backend",
  "source": "github.com/ayn2op/discrawl",
  "checks": [
    {
      "type": "binary",
      "name": "discrawl"
    }
  ],
  "install_guidance": {
    "plugin": "discrawl",
    "binary": "discrawl",
    "check": "which discrawl",
    "install_steps": [
      "go install github.com/ayn2op/discrawl@latest"
    ]
  },
  "commands": [
    {
      "namespace": "discrawl",
      "resource": "discord",
      "action": "run",
      "description": "Run Discord CLI with sqlite backend",
      "adapter": "process",
      "adapterConfig": {
        "command": "discrawl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install discrawl from github.com/ayn2op/discrawl"
      },
      "args": []
    }
  ]
}