{
  "name": "RFM69-MQTT-client",
  "version": "0.1.0",
  "description": "Arduino - RFM69 based sensors and MQTT gateway ",
  "source": "https://github.com/RFM69-MQTT-client/RFM69-MQTT-client",
  "checks": [
    {
      "type": "binary",
      "name": "RFM69-MQTT-client"
    }
  ],
  "install_guidance": {
    "plugin": "RFM69-MQTT-client",
    "binary": "RFM69-MQTT-client",
    "check": "which RFM69-MQTT-client",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: RFM69-MQTT-client --version",
      "supercli plugins install ./plugins/RFM69-MQTT-client --on-conflict replace --json"
    ],
    "note": "Arduino language CLI tool"
  },
  "commands": [
    {
      "namespace": "RFM69-MQTT-client",
      "resource": "self",
      "action": "version",
      "description": "Print RFM69-MQTT-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "RFM69-MQTT-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RFM69-MQTT-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "RFM69-MQTT-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to RFM69-MQTT-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "RFM69-MQTT-client",
        "passthrough": true,
        "missingDependencyHelp": "Install RFM69-MQTT-client from project repository"
      },
      "args": []
    }
  ]
}