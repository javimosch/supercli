{
  "name": "androidify",
  "version": "0.1.0",
  "description": "Sample app for Androidify",
  "source": "https://github.com/androidify/androidify",
  "checks": [
    {
      "type": "binary",
      "name": "androidify"
    }
  ],
  "install_guidance": {
    "plugin": "androidify",
    "binary": "androidify",
    "check": "which androidify",
    "install_steps": [
      "pip install androidify",
      "Verify: androidify --version",
      "supercli plugins install ./plugins/androidify --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "androidify",
      "resource": "self",
      "action": "version",
      "description": "Print androidify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "androidify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install androidify: pip install androidify"
      },
      "args": []
    },
    {
      "namespace": "androidify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to androidify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "androidify",
        "passthrough": true,
        "missingDependencyHelp": "Install androidify: pip install androidify"
      },
      "args": []
    }
  ]
}