{
  "name": "AIGenerateCode",
  "version": "0.1.0",
  "description": "Android\u8c37\u6b4c\u4e0a\u67b6\u9a6c\u7532\u5305\u5783\u573e\u4ee3\u7801\u6df7\u6dc6",
  "source": "https://github.com/AIGenerateCode/AIGenerateCode",
  "checks": [
    {
      "type": "binary",
      "name": "aigeneratecode"
    }
  ],
  "install_guidance": {
    "plugin": "AIGenerateCode",
    "binary": "aigeneratecode",
    "check": "which aigeneratecode",
    "install_steps": [
      "pip install aigeneratecode",
      "Verify: aigeneratecode --version",
      "supercli plugins install ./plugins/AIGenerateCode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AIGenerateCode",
      "resource": "self",
      "action": "version",
      "description": "Print AIGenerateCode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aigeneratecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AIGenerateCode: pip install aigeneratecode"
      },
      "args": []
    },
    {
      "namespace": "AIGenerateCode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aigeneratecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aigeneratecode",
        "passthrough": true,
        "missingDependencyHelp": "Install AIGenerateCode: pip install aigeneratecode"
      },
      "args": []
    }
  ]
}