{
  "name": "aperture-node",
  "version": "0.1.0",
  "description": "Record macOS screen from Node.js applications",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "aperture-node" }],
  "install_guidance": {
    "plugin": "aperture-node",
    "binary": "aperture-node",
    "check": "which aperture-node",
    "install_steps": ["npm install aperture-node", "Verify: aperture-node --version", "supercli plugins install ./plugins/aperture-node --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aperture-node",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to aperture-node CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "aperture-node",
      "passthrough": true,
      "missingDependencyHelp": "Install aperture-node: npm install aperture-node"
    },
    "args": []
  }]
}
