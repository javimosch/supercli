{
  "name": "hyprlock",
  "version": "0.1.0",
  "description": "Hyprland's GPU-accelerated screen locking utility",
  "source": "https://github.com/hyprlock/hyprlock",
  "checks": [
    {
      "type": "binary",
      "name": "hyprlock"
    }
  ],
  "install_guidance": {
    "plugin": "hyprlock",
    "binary": "hyprlock",
    "check": "which hyprlock",
    "install_steps": [
      "pip install hyprlock",
      "Verify: hyprlock --version",
      "supercli plugins install ./plugins/hyprlock --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hyprlock",
      "resource": "self",
      "action": "version",
      "description": "Print hyprlock version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hyprlock",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hyprlock: pip install hyprlock"
      },
      "args": []
    },
    {
      "namespace": "hyprlock",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hyprlock CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hyprlock",
        "passthrough": true,
        "missingDependencyHelp": "Install hyprlock: pip install hyprlock"
      },
      "args": []
    }
  ]
}