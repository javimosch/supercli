{
  "name": "encoding-converter",
  "version": "0.1.0",
  "description": "Batch text file charset re-encoding CLI utility",
  "source": "https://github.com/encoding-converter/encoding-converter",
  "checks": [
    {
      "type": "binary",
      "name": "encoding-converter"
    }
  ],
  "install_guidance": {
    "plugin": "encoding-converter",
    "binary": "encoding-converter",
    "check": "which encoding-converter",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: encoding-converter --version",
      "supercli plugins install ./plugins/encoding-converter --on-conflict replace --json"
    ],
    "note": "C# language CLI tool"
  },
  "commands": [
    {
      "namespace": "encoding-converter",
      "resource": "self",
      "action": "version",
      "description": "Print encoding-converter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "encoding-converter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install encoding-converter from project repository"
      },
      "args": []
    },
    {
      "namespace": "encoding-converter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to encoding-converter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "encoding-converter",
        "passthrough": true,
        "missingDependencyHelp": "Install encoding-converter from project repository"
      },
      "args": []
    }
  ]
}