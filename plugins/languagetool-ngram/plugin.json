{
  "name": "languagetool-ngram",
  "version": "0.1.0",
  "description": "N-gram based language detection and checking",
  "source": "https://github.com/languagetool-org/languagetool-ngrams",
  "checks": [{ "type": "binary", "name": "languagetool-ngram" }],
  "install_guidance": {
    "plugin": "languagetool-ngram",
    "binary": "languagetool-ngram",
    "check": "which languagetool-ngram",
    "install_steps": ["brew install languagetool-ngrams", "Verify: languagetool-ngram --version", "supercli plugins install ./plugins/languagetool-ngram --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "languagetool-ngram",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to languagetool-ngram CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "languagetool-ngram",
      "passthrough": true,
      "missingDependencyHelp": "Install languagetool-ngram: brew install languagetool-ngrams", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
