{
  "name": "avra",
  "version": "0.1.0",
  "description": "Assembler for the Atmel AVR microcontroller family",
  "source": "https://github.com/Ro5bert/avra",
  "checks": [
    {
      "type": "binary",
      "name": "avra"
    }
  ],
  "install_guidance": {
    "plugin": "avra",
    "binary": "avra",
    "check": "which avra",
    "install_steps": [
      "brew install avra",
      "Verify: avra --version",
      "supercli plugins install ./plugins/avra --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "avra",
      "resource": "self",
      "action": "version",
      "description": "Print avra version",
      "adapter": "process",
      "adapterConfig": {
        "command": "avra",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install avra: brew install avra"
      },
      "args": []
    },
    {
      "namespace": "avra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to avra CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "avra",
        "passthrough": true,
        "missingDependencyHelp": "Install avra"
      },
      "args": []
    }
  ]
}