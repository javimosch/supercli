{
  "name": "dhcpd",
  "version": "0.1.0",
  "description": "CLI tool: dhcpd",
  "source": "https://packages.debian.org/dhcpd",
  "checks": [{ "type": "binary", "name": "dhcpd" }],
  "install_guidance": {
    "plugin": "dhcpd", "binary": "dhcpd", "check": "which dhcpd",
    "install_steps": ["apt-get install dhcpd 2>/dev/null || which dhcpd", "Verify: dhcpd --version", "supercli plugins install ./plugins/dhcpd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhcpd", "resource": "_", "action": "_",
    "description": "Passthrough to dhcpd CLI",
    "adapter": "process", "adapterConfig": { "command": "dhcpd", "passthrough": true, "missingDependencyHelp": "Install dhcpd: apt-get install dhcpd" }, "args": []
  }]
}
