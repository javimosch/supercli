{
  "name": "defendnot",
  "version": "0.1.0",
  "description": "An even funnier way to disable windows defender. (through WSC api)",
  "source": "https://github.com/defendnot/defendnot",
  "checks": [
    {
      "type": "binary",
      "name": "defendnot"
    }
  ],
  "install_guidance": {
    "plugin": "defendnot",
    "binary": "defendnot",
    "check": "which defendnot",
    "install_steps": [
      "pip install defendnot",
      "Verify: defendnot --version",
      "supercli plugins install ./plugins/defendnot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "defendnot",
      "resource": "self",
      "action": "version",
      "description": "Print defendnot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "defendnot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install defendnot: pip install defendnot"
      },
      "args": []
    },
    {
      "namespace": "defendnot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to defendnot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "defendnot",
        "passthrough": true,
        "missingDependencyHelp": "Install defendnot: pip install defendnot"
      },
      "args": []
    }
  ]
}