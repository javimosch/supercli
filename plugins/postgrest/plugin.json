{
  "name": "postgrest",
  "version": "0.1.0",
  "description": "Turn PostgreSQL database into a RESTful API server",
  "source": "https://github.com/PostgREST/postgrest",
  "checks": [{ "type": "binary", "name": "postgrest" }],
  "install_guidance": {
    "plugin": "postgrest",
    "binary": "postgrest",
    "check": "which postgrest",
    "install_steps": ["brew install postgrest", "Verify: postgrest --version", "supercli plugins install ./plugins/postgrest --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "postgrest",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to postgrest CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "postgrest",
      "passthrough": true,
      "missingDependencyHelp": "Install postgrest: brew install postgrest"
    },
    "args": []
  }]
}
