{
  "name": "dosfstools",
  "version": "0.1.0",
  "description": "Tools to create, check and label file systems of the FAT family",
  "source": "https://github.com/dosfstools",
  "checks": [
    {
      "type": "binary",
      "name": "dosfstools"
    }
  ],
  "install_guidance": {
    "plugin": "dosfstools",
    "binary": "dosfstools",
    "check": "which dosfstools",
    "install_steps": [
      "brew install dosfstools",
      "Verify: dosfstools --version",
      "supercli plugins install ./plugins/dosfstools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dosfstools",
      "resource": "self",
      "action": "version",
      "description": "Print dosfstools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dosfstools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dosfstools: brew install dosfstools"
      },
      "args": []
    },
    {
      "namespace": "dosfstools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dosfstools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dosfstools",
        "passthrough": true,
        "missingDependencyHelp": "Install dosfstools"
      },
      "args": []
    }
  ]
}