{
  "name": "docx2txt",
  "version": "0.1.0",
  "description": "CLI tool: docx2txt",
  "source": "https://manpages.debian.org/docx2txt",
  "checks": [
    {
      "type": "binary",
      "name": "docx2txt"
    }
  ],
  "install_guidance": {
    "plugin": "docx2txt",
    "binary": "docx2txt",
    "check": "which docx2txt",
    "install_steps": [
      "apt-get install docx2txt 2>/dev/null || which docx2txt",
      "Verify: docx2txt --version",
      "supercli plugins install ./plugins/docx2txt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "docx2txt",
      "resource": "self",
      "action": "version",
      "description": "Print docx2txt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docx2txt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docx2txt: apt-get install docx2txt 2>/dev/null || which docx2txt"
      },
      "args": []
    },
    {
      "namespace": "docx2txt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docx2txt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docx2txt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install docx2txt: apt-get install docx2txt 2>/dev/null || which docx2txt"
      },
      "args": []
    }
  ]
}