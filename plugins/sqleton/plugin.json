{
  "name": "sqleton",
  "version": "1.0.0",
  "description": "Powerful SQL CLI tool with rich output and JSON support for multiple database types",
  "source": "https://github.com/go-go-golems/sqleton",
  "checks": [
    {
      "type": "binary",
      "name": "sqleton",
      "args": [
        "version"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "sqleton",
    "binary": "sqleton",
    "check": "sqleton version",
    "install_steps": [
      "go install github.com/go-go-golems/sqleton@latest",
      "Or download from: https://github.com/go-go-golems/sqleton/releases"
    ],
    "note": "sqleton is a powerful SQL CLI tool with rich output formatting, supporting MySQL, PostgreSQL, SQLite and other databases with professional-grade output"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sqleton",
      "resource": "sql",
      "action": "query",
      "description": "Execute SQL query with JSON output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "sqleton query --db-type \"{{db_type}}\" --host \"{{host}}\" --database \"{{database}}\" --output json \"{{query}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "db_type",
          "type": "string",
          "required": true,
          "description": "Database type (mysql, postgres, sqlite, ...)"
        },
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "Database host"
        },
        {
          "name": "database",
          "type": "string",
          "required": true,
          "description": "Database name"
        },
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "SQL query to execute"
        }
      ]
    },
    {
      "namespace": "sqleton",
      "resource": "sql",
      "action": "query-mysql",
      "description": "Execute SQL query on MySQL with JSON output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "sqleton query --db-type mysql --host \"{{host}}\" --user \"{{user}}\" --database \"{{database}}\" --output json \"{{query}}\"",
        "unsafe": true
