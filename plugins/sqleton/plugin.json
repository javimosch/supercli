{
  "name": "sqleton",
  "version": "1.0.0",
  "description": "Powerful SQL CLI tool with rich output and JSON support for multiple database types",
  "commands": [
    {
      "name": "query",
      "description": "Execute SQL query with JSON output",
      "binary": "sqleton",
      "args": ["query", "--db-type", "{{.db_type}}", "--host", "{{.host}}", "--database", "{{.database}}", "--output", "json", "{{.query}}"],
      "output_format": "json"
    },
    {
      "name": "query-mysql",
      "description": "Execute SQL query on MySQL with JSON output",
      "binary": "sqleton",
      "args": ["query", "--db-type", "mysql", "--host", "{{.host}}", "--user", "{{.user}}", "--database", "{{.database}}", "--output", "json", "{{.query}}"],
      "output_format": "json"
    },
    {
      "name": "query-postgres",
      "description": "Execute SQL query on PostgreSQL with JSON output",
      "binary": "sqleton",
      "args": ["query", "--db-type", "postgres", "--host", "{{.host}}", "--user", "{{.user}}", "--database", "{{.database}}", "--output", "json", "{{.query}}"],
      "output_format": "json"
    },
    {
      "name": "query-sqlite",
      "description": "Execute SQL query on SQLite with JSON output",
      "binary": "sqleton",
      "args": ["query", "--db-type", "sqlite", "--database", "{{.database}}", "--output", "json", "{{.query}}"],
      "output_format": "json"
    },
    {
      "name": "export-csv",
      "description": "Export query results to CSV",
      "binary": "sqleton",
      "args": ["query", "--db-type", "{{.db_type}}", "--host", "{{.host}}", "--database", "{{.database}}", "--output", "csv", "{{.query}}"],
      "output_format": "csv"
    },
    {
      "name": "export-yaml",
      "description": "Export query results to YAML",
      "binary": "sqleton",
      "args": ["query", "--db-type", "{{.db_type}}", "--host", "{{.host}}", "--database", "{{.database}}", "--output", "yaml", "{{.query}}"],
      "output_format": "yaml"
    },
    {
      "name": "list-tables",
      "description": "List all tables in database",
      "binary": "sqleton",
      "args": ["db", "ls-tables", "--db-type", "{{.db_type}}", "--host", "{{.host}}", "--database", "{{.database}}"],
      "output_format": "json"
    },
    {
      "name": "describe-table",
      "description": "Describe table structure",
      "binary": "sqleton",
      "args": ["select", "--table", "{{.table}}", "--describe", "--db-type", "{{.db_type}}", "--host", "{{.host}}", "--database", "{{.database}}"],
      "output_format": "json"
    },
    {
      "name": "test-connection",
      "description": "Test database connection",
      "binary": "sqleton",
      "args": ["db", "test", "--db-type", "{{.db_type}}", "--host", "{{.host}}", "--database", "{{.database}}"],
      "output_format": "text"
    }
  ]
}