{
  "name": "iris.c",
  "version": "0.1.0",
  "description": "Flux 2 image generation model pure C inference",
  "source": "https://github.com/iris.c/iris.c",
  "checks": [
    {
      "type": "binary",
      "name": "iris.c"
    }
  ],
  "install_guidance": {
    "plugin": "iris.c",
    "binary": "iris.c",
    "check": "which iris.c",
    "install_steps": [
      "pip install iris.c",
      "Verify: iris.c --version",
      "supercli plugins install ./plugins/iris.c --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iris.c",
      "resource": "self",
      "action": "version",
      "description": "Print iris.c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iris.c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iris.c: pip install iris.c"
      },
      "args": []
    },
    {
      "namespace": "iris.c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iris.c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iris.c",
        "passthrough": true,
        "missingDependencyHelp": "Install iris.c: pip install iris.c"
      },
      "args": []
    }
  ]
}