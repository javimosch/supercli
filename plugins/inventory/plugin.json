{
  "name": "inventory",
  "version": "0.1.0",
  "description": "Move files like an old text adventure.",
  "source": "https://github.com/mothdotmonster/inventory",
  "checks": [
    {
      "type": "binary",
      "name": "inventory"
    }
  ],
  "install_guidance": {
    "plugin": "inventory",
    "binary": "inventory",
    "check": "which inventory",
    "install_steps": [
      "See https://github.com/mothdotmonster/inventory",
      "Verify: inventory --version",
      "supercli plugins install ./plugins/inventory --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "inventory",
      "resource": "self",
      "action": "version",
      "description": "Print inventory version",
      "adapter": "process",
      "adapterConfig": {
        "command": "inventory",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install inventory: See https://github.com/mothdotmonster/inventory"
      },
      "args": []
    },
    {
      "namespace": "inventory",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to inventory CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "inventory",
        "passthrough": true,
        "missingDependencyHelp": "Install inventory"
      },
      "args": []
    }
  ]
}