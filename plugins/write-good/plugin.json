{
  "name": "write-good",
  "version": "0.1.0",
  "description": "Naive prose linter for simpler English writing",
  "source": "https://github.com/btford/write-good",
  "checks": [
    {
      "type": "binary",
      "name": "write-good"
    }
  ],
  "install_guidance": {
    "plugin": "write-good",
    "binary": "write-good",
    "check": "which write-good",
    "install_steps": [
      "npm install -g write-good",
      "Verify: write-good --version",
      "supercli plugins install ./plugins/write-good --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "write-good",
      "resource": "self",
      "action": "version",
      "description": "Print write-good version",
      "adapter": "process",
      "adapterConfig": {
        "command": "write-good",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install write-good: npm install -g write-good"
      },
      "args": []
    },
    {
      "namespace": "write-good",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to write-good CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "write-good",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install write-good: npm install -g write-good"
      },
      "args": []
    }
  ]
}
