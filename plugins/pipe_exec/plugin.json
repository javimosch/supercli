{
  "name": "pipe_exec",
  "version": "0.1.0",
  "description": "Run executables from stdin, pipes and ttys without creating a temporary file",
  "source": "https://github.com/koraa/pipe_exec",
  "checks": [
    {
      "type": "binary",
      "name": "pipe_exec"
    }
  ],
  "install_guidance": {
    "plugin": "pipe_exec",
    "binary": "pipe_exec",
    "check": "which pipe_exec",
    "install_steps": [
      "See https://github.com/koraa/pipe_exec",
      "Verify: pipe_exec --version",
      "supercli plugins install ./plugins/pipe_exec --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "pipe_exec",
      "resource": "self",
      "action": "version",
      "description": "Print pipe_exec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pipe_exec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pipe_exec: See https://github.com/koraa/pipe_exec"
      },
      "args": []
    },
    {
      "namespace": "pipe_exec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pipe_exec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pipe_exec",
        "passthrough": true,
        "missingDependencyHelp": "Install pipe_exec"
      },
      "args": []
    }
  ]
}