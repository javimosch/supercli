{
  "name": "git-plus",
  "version": "0.1.0",
  "description": "Git utilities: git multi, git relation, git old-branches, git recent",
  "source": "https://github.com/tkrajina/git-plus",
  "checks": [
    {
      "type": "binary",
      "name": "git-plus"
    }
  ],
  "install_guidance": {
    "plugin": "git-plus",
    "binary": "git-plus",
    "check": "which git-plus",
    "install_steps": [
      "brew install git-plus",
      "Verify: git-plus --version",
      "supercli plugins install ./plugins/git-plus --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-plus",
      "resource": "self",
      "action": "version",
      "description": "Print git-plus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-plus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-plus: brew install git-plus"
      },
      "args": []
    },
    {
      "namespace": "git-plus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-plus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-plus",
        "passthrough": true,
        "missingDependencyHelp": "Install git-plus"
      },
      "args": []
    }
  ]
}