{
  "name": "post-grohtml",
  "version": "0.1.0",
  "description": "CLI tool: post-grohtml",
  "source": "https://manpages.debian.org/post-grohtml",
  "checks": [
    {
      "type": "binary",
      "name": "post-grohtml"
    }
  ],
  "install_guidance": {
    "plugin": "post-grohtml",
    "binary": "post-grohtml",
    "check": "which post-grohtml",
    "install_steps": [
      "apt-get install post-grohtml 2>/dev/null || which post-grohtml",
      "Verify: post-grohtml --version",
      "supercli plugins install ./plugins/post-grohtml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "post-grohtml",
      "resource": "self",
      "action": "version",
      "description": "Print post-grohtml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "post-grohtml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install post-grohtml: apt-get install post-grohtml 2>/dev/null || which post-grohtml"
      },
      "args": []
    },
    {
      "namespace": "post-grohtml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to post-grohtml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "post-grohtml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install post-grohtml: apt-get install post-grohtml 2>/dev/null || which post-grohtml"
      },
      "args": []
    }
  ]
}