{
  "name": "aseprite-cli",
  "version": "0.1.0",
  "description": "Lightweight script for batch-exporting Aseprite pixel art files",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "aseprite-cli" }],
  "install_guidance": {
    "plugin": "aseprite-cli",
    "binary": "aseprite-cli",
    "check": "which aseprite-cli",
    "install_steps": ["npm install -g aseprite-cli", "Verify: aseprite-cli --version", "supercli plugins install ./plugins/aseprite-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aseprite-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to aseprite-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "aseprite-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install aseprite-cli: npm install -g aseprite-cli"
    },
    "args": []
  }]
}
