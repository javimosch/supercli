{
  "name": "logmerge",
  "version": "0.1.0",
  "description": "Log file merger CLI — combine and sort log files by timestamp with JSON output",
  "source": "https://github.com/logmerge/logmerge",
  "checks": [
    {
      "type": "binary",
      "name": "logmerge"
    }
  ],
  "install_guidance": {
    "plugin": "logmerge",
    "binary": "logmerge",
    "check": "which logmerge",
    "install_steps": [
      "cargo install logmerge",
      "Verify: logmerge --version",
      "supercli plugins install ./plugins/logmerge --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "logmerge",
      "resource": "self",
      "action": "version",
      "description": "Print logmerge version",
      "adapter": "process",
      "adapterConfig": {
        "command": "logmerge",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install: cargo install logmerge"
      },
      "args": []
    },
    {
      "namespace": "logmerge",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to logmerge",
      "adapter": "process",
      "adapterConfig": {
        "command": "logmerge",
        "passthrough": true,
        "missingDependencyHelp": "Install: cargo install logmerge"
      },
      "args": []
    }
  ]
}
