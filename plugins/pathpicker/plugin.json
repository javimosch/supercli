{
  "name": "pathpicker",
  "version": "0.1.0",
  "description": "After parsing the output from a command, PathPicker presents you with a nice UI to select which files you're interested in",
  "source": "https://github.com/facebook/pathpicker/",
  "checks": [
    {
      "type": "binary",
      "name": "pathpicker"
    }
  ],
  "install_guidance": {
    "plugin": "pathpicker",
    "binary": "pathpicker",
    "check": "which pathpicker",
    "install_steps": [
      "See https://github.com/facebook/pathpicker/",
      "Verify: pathpicker --version",
      "supercli plugins install ./plugins/pathpicker --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "pathpicker",
      "resource": "self",
      "action": "version",
      "description": "Print pathpicker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pathpicker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pathpicker: See https://github.com/facebook/pathpicker/"
      },
      "args": []
    },
    {
      "namespace": "pathpicker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pathpicker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pathpicker",
        "passthrough": true,
        "missingDependencyHelp": "Install pathpicker"
      },
      "args": []
    }
  ]
}