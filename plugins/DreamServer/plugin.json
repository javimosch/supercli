{
  "name": "DreamServer",
  "version": "0.1.0",
  "description": "Turn your PC, Mac, or Linux box into an AI server.  LLM inference, chat UI, voice, agents, workflows",
  "source": "https://github.com/DreamServer/DreamServer",
  "checks": [
    {
      "type": "binary",
      "name": "dreamserver"
    }
  ],
  "install_guidance": {
    "plugin": "DreamServer",
    "binary": "dreamserver",
    "check": "which dreamserver",
    "install_steps": [
      "pip install dreamserver",
      "Verify: dreamserver --version",
      "supercli plugins install ./plugins/DreamServer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DreamServer",
      "resource": "self",
      "action": "version",
      "description": "Print DreamServer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dreamserver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DreamServer: pip install dreamserver"
      },
      "args": []
    },
    {
      "namespace": "DreamServer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dreamserver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dreamserver",
        "passthrough": true,
        "missingDependencyHelp": "Install DreamServer: pip install dreamserver"
      },
      "args": []
    }
  ]
}