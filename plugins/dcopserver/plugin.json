{
  "name": "dcopserver",
  "version": "0.1.0",
  "description": "CLI tool: dcopserver",
  "source": "https://packages.debian.org/dcopserver",
  "checks": [{ "type": "binary", "name": "dcopserver" }],
  "install_guidance": {
    "plugin": "dcopserver", "binary": "dcopserver", "check": "which dcopserver",
    "install_steps": ["apt-get install dcopserver 2>/dev/null || which dcopserver", "Verify: dcopserver --version", "supercli plugins install ./plugins/dcopserver --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dcopserver", "resource": "_", "action": "_",
    "description": "Passthrough to dcopserver CLI",
    "adapter": "process", "adapterConfig": { "command": "dcopserver", "passthrough": true, "missingDependencyHelp": "Install dcopserver: apt-get install dcopserver" }, "args": []
  }]
}
