{
  "name": "cyrus-passwd",
  "version": "0.1.0",
  "description": "CLI tool: cyrus-passwd",
  "source": "https://packages.debian.org/cyrus-passwd",
  "checks": [{ "type": "binary", "name": "cyrus-passwd" }],
  "install_guidance": {
    "plugin": "cyrus-passwd", "binary": "cyrus-passwd", "check": "which cyrus-passwd",
    "install_steps": ["apt-get install cyrus-passwd 2>/dev/null || which cyrus-passwd", "Verify: cyrus-passwd --version", "supercli plugins install ./plugins/cyrus-passwd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cyrus-passwd", "resource": "_", "action": "_",
    "description": "Passthrough to cyrus-passwd CLI",
    "adapter": "process", "adapterConfig": { "command": "cyrus-passwd", "passthrough": true, "missingDependencyHelp": "Install cyrus-passwd: apt-get install cyrus-passwd" }, "args": []
  }]
}
