{
  "name": "systeroid-tui",
  "version": "0.1.0",
  "description": "Terminal user interface over systeroid sysctl manager",
  "source": "https://github.com/orhun/systeroid",
  "checks": [{ "type": "binary", "name": "systeroid-tui" }],
  "install_guidance": {
    "plugin": "systeroid-tui",
    "binary": "systeroid-tui",
    "check": "which systeroid-tui",
    "install_steps": ["cargo install systeroid-tui", "Verify: systeroid-tui --version", "supercli plugins install ./plugins/systeroid-tui --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "systeroid-tui",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to systeroid-tui CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "systeroid-tui",
      "passthrough": true,
      "missingDependencyHelp": "Install systeroid-tui: cargo install systeroid-tui"
    },
    "args": []
  }]
}
