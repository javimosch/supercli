{
  "name": "gvmap.sh",
  "version": "0.1.0",
  "description": "CLI tool: gvmap.sh",
  "source": "https://manpages.debian.org/gvmap.sh",
  "checks": [
    {
      "type": "binary",
      "name": "gvmap.sh"
    }
  ],
  "install_guidance": {
    "plugin": "gvmap.sh",
    "binary": "gvmap.sh",
    "check": "which gvmap.sh",
    "install_steps": [
      "apt-get install gvmap.sh 2>/dev/null || which gvmap.sh",
      "Verify: gvmap.sh --version",
      "supercli plugins install ./plugins/gvmap.sh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gvmap.sh",
      "resource": "self",
      "action": "version",
      "description": "Print gvmap.sh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvmap.sh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gvmap.sh: apt-get install gvmap.sh 2>/dev/null || which gvmap.sh"
      },
      "args": []
    },
    {
      "namespace": "gvmap.sh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gvmap.sh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvmap.sh",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gvmap.sh: apt-get install gvmap.sh 2>/dev/null || which gvmap.sh"
      },
      "args": []
    }
  ]
}