{
  "name": "ncp",
  "version": "0.1.0",
  "description": "Transfer files and folders, to and from NFS servers",
  "source": "https://github.com/kha7iq/ncp",
  "checks": [
    {
      "type": "binary",
      "name": "ncp"
    }
  ],
  "install_guidance": {
    "plugin": "ncp",
    "binary": "ncp",
    "check": "which ncp",
    "install_steps": [
      "See https://github.com/kha7iq/ncp",
      "Verify: ncp --version",
      "supercli plugins install ./plugins/ncp --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ncp",
      "resource": "self",
      "action": "version",
      "description": "Print ncp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ncp: See https://github.com/kha7iq/ncp"
      },
      "args": []
    },
    {
      "namespace": "ncp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ncp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncp",
        "passthrough": true,
        "missingDependencyHelp": "Install ncp"
      },
      "args": []
    }
  ]
}