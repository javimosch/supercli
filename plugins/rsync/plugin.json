{
  "name": "rsync",
  "version": "0.1.0",
  "description": "Fast file synchronization and transfer tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "rsync"}],
  "install_guidance": {
    "plugin": "rsync",
    "binary": "rsync",
    "check": "which rsync",
    "install_steps": [
      "brew install rsync",
      "Verify: rsync --version",
      "supercli plugins install ./plugins/rsync --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "rsync",
      "resource": "self",
      "action": "version",
      "description": "Print rsync version",
      "adapter": "process",
      "adapterConfig": {"command": "rsync", "baseArgs": ["--version"], "missingDependencyHelp": "Install rsync: brew install rsync"},
      "args": []
    },
    {
      "namespace": "rsync",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rsync CLI",
      "adapter": "process",
      "adapterConfig": {"command": "rsync", "passthrough": true, "missingDependencyHelp": "Install rsync: brew install rsync"},
      "args": []
    }
  ]
}
