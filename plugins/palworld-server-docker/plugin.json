{
  "name": "palworld-server-docker",
  "version": "0.1.0",
  "description": "A Docker Container to easily run a Palworld dedicated server.",
  "source": "https://github.com/palworld-server-docker/palworld-server-docker",
  "checks": [
    {
      "type": "binary",
      "name": "palworld-server-docker"
    }
  ],
  "install_guidance": {
    "plugin": "palworld-server-docker",
    "binary": "palworld-server-docker",
    "check": "which palworld-server-docker",
    "install_steps": [
      "pip install palworld-server-docker",
      "Verify: palworld-server-docker --version",
      "supercli plugins install ./plugins/palworld-server-docker --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "palworld-server-docker",
      "resource": "self",
      "action": "version",
      "description": "Print palworld-server-docker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "palworld-server-docker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install palworld-server-docker: pip install palworld-server-docker"
      },
      "args": []
    },
    {
      "namespace": "palworld-server-docker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to palworld-server-docker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "palworld-server-docker",
        "passthrough": true,
        "missingDependencyHelp": "Install palworld-server-docker: pip install palworld-server-docker"
      },
      "args": []
    }
  ]
}