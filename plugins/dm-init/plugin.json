    "plugin": "dm-init", "binary": "dm-init", "check": "which dm-init",
    "install_steps": ["apt-get install dm-init 2>/dev/null || which dm-init", "Verify: dm-init --version", "supercli plugins install ./plugins/dm-init --on-conflict replace --json"]
