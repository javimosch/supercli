{
  "name": "rdircd",
  "version": "0.1.0",
  "description": "Daemon to use Discord through an IRC client bridge",
  "source": "python",
  "checks": [{ "type": "binary", "name": "rdircd" }],
  "install_guidance": {
    "plugin": "rdircd",
    "binary": "rdircd",
    "check": "which rdircd",
    "install_steps": ["git clone && python3 rdircd", "Verify: rdircd --version", "supercli plugins install ./plugins/rdircd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rdircd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rdircd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rdircd",
      "passthrough": true,
      "missingDependencyHelp": "Install rdircd: git clone && python3 rdircd"
    },
    "args": []
  }]
}
