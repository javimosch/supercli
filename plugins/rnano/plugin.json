{
  "name": "rnano",
  "version": "1.0.0",
  "description": "rnano \u2014 rnano \u2014 CLI utility",
  "source": "/usr/bin/rnano",
  "checks": [
    {
      "type": "binary",
      "name": "rnano"
    }
  ],
  "install_guidance": {
    "plugin": "rnano",
    "binary": "rnano",
    "check": "which rnano",
    "install_steps": [
      "# Install rnano:",
      "# apt: sudo apt-get install rnano",
      "# brew: brew install rnano",
      "# cargo: cargo install rnano",
      "# npm: npm install -g rnano",
      "# pip: pip install rnano",
      "# or download from /usr/bin/rnano"
    ]
  },
  "commands": [
    {
      "namespace": "rnano",
      "resource": "rnano",
      "action": "run",
      "description": "Run rnano",
      "adapter": "process",
      "adapterConfig": {
        "command": "rnano",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rnano from /usr/bin/rnano"
      },
      "args": []
    }
  ]
}