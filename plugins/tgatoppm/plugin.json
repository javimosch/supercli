{
  "name": "tgatoppm",
  "version": "0.1.0",
  "description": "CLI tool: tgatoppm",
  "source": "https://manpages.debian.org/tgatoppm",
  "checks": [
    {
      "type": "binary",
      "name": "tgatoppm"
    }
  ],
  "install_guidance": {
    "plugin": "tgatoppm",
    "binary": "tgatoppm",
    "check": "which tgatoppm",
    "install_steps": [
      "apt-get install tgatoppm 2>/dev/null || which tgatoppm",
      "Verify: tgatoppm --version",
      "supercli plugins install ./plugins/tgatoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tgatoppm",
      "resource": "self",
      "action": "version",
      "description": "Print tgatoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tgatoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tgatoppm: apt-get install tgatoppm 2>/dev/null || which tgatoppm"
      },
      "args": []
    },
    {
      "namespace": "tgatoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tgatoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tgatoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tgatoppm: apt-get install tgatoppm 2>/dev/null || which tgatoppm"
      },
      "args": []
    }
  ]
}