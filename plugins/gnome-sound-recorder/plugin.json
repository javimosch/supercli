{
  "name": "gnome-sound-recorder",
  "version": "0.1.0",
  "description": "CLI tool: gnome-sound-recorder",
  "source": "https://manpages.debian.org/gnome-sound-recorder",
  "checks": [
    {
      "type": "binary",
      "name": "gnome-sound-recorder"
    }
  ],
  "install_guidance": {
    "plugin": "gnome-sound-recorder",
    "binary": "gnome-sound-recorder",
    "check": "which gnome-sound-recorder",
    "install_steps": [
      "apt-get install gnome-sound-recorder 2>/dev/null || which gnome-sound-recorder",
      "Verify: gnome-sound-recorder --version",
      "supercli plugins install ./plugins/gnome-sound-recorder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gnome-sound-recorder",
      "resource": "self",
      "action": "version",
      "description": "Print gnome-sound-recorder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-sound-recorder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gnome-sound-recorder: apt-get install gnome-sound-recorder 2>/dev/null || which gnome-sound-recorder"
      },
      "args": []
    },
    {
      "namespace": "gnome-sound-recorder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gnome-sound-recorder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-sound-recorder",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gnome-sound-recorder: apt-get install gnome-sound-recorder 2>/dev/null || which gnome-sound-recorder"
      },
      "args": []
    }
  ]
}