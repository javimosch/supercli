{
  "name": "lofromtemplate",
  "version": "0.1.0",
  "description": "CLI tool: lofromtemplate",
  "source": "https://manpages.debian.org/lofromtemplate",
  "checks": [
    {
      "type": "binary",
      "name": "lofromtemplate"
    }
  ],
  "install_guidance": {
    "plugin": "lofromtemplate",
    "binary": "lofromtemplate",
    "check": "which lofromtemplate",
    "install_steps": [
      "apt-get install lofromtemplate 2>/dev/null || which lofromtemplate",
      "Verify: lofromtemplate --version",
      "supercli plugins install ./plugins/lofromtemplate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lofromtemplate",
      "resource": "self",
      "action": "version",
      "description": "Print lofromtemplate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lofromtemplate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lofromtemplate: apt-get install lofromtemplate 2>/dev/null || which lofromtemplate"
      },
      "args": []
    },
    {
      "namespace": "lofromtemplate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lofromtemplate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lofromtemplate",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lofromtemplate: apt-get install lofromtemplate 2>/dev/null || which lofromtemplate"
      },
      "args": []
    }
  ]
}