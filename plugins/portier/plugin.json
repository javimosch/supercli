{
  "name": "portier",
  "version": "0.1.0",
  "description": "SSO for your app in one redirect \u2014 OIDC/OAuth, 100 free auths then 1 EUR per 100 via peage",
  "source": "https://github.com/javimosch/portier",
  "checks": [
    {
      "type": "binary",
      "name": "portier"
    }
  ],
  "install_guidance": {
    "plugin": "portier",
    "binary": "portier",
    "check": "which portier",
    "install_steps": [
      "Build from source: https://github.com/javimosch/portier",
      "Verify: portier version || portier guide"
    ]
  },
  "commands": [
    {
      "namespace": "portier",
      "resource": "self",
      "action": "guide",
      "description": "Print the agent guide (JSON with endpoints, providers, billing)",
      "adapter": "process",
      "adapterConfig": {
        "command": "portier",
        "baseArgs": [
          "guide"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install portier from https://github.com/javimosch/portier"
      },
      "args": []
    },
    {
      "namespace": "portier",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "portier",
        "baseArgs": [
          "version"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install portier from https://github.com/javimosch/portier"
      },
      "args": []
    }
  ]
}