{
  "name": "litestream",
  "version": "0.1.0",
  "description": "Streaming SQLite replication to S3 for disaster recovery",
  "source": "go",
  "checks": [{ "type": "binary", "name": "litestream" }],
  "install_guidance": {
    "plugin": "litestream",
    "binary": "litestream",
    "check": "which litestream",
    "install_steps": ["go install github.com/benbjohnson/litestream/cmd/litestream@latest", "Verify: litestream --version", "supercli plugins install ./plugins/litestream --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "litestream",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to litestream CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "litestream",
      "passthrough": true,
      "missingDependencyHelp": "Install litestream: go install github.com/benbjohnson/litestream/cmd/litestream@latest"
    },
    "args": []
  }]
}
