{
  "name": "redpen",
  "version": "0.1.0",
  "description": "Document validator for HTML/LaTeX/Markdown",
  "source": "https://github.com/redpen-cc/redpen",
  "checks": [
    {
      "type": "binary",
      "name": "redpen"
    }
  ],
  "install_guidance": {
    "plugin": "redpen",
    "binary": "redpen",
    "check": "which redpen",
    "install_steps": [
      "npm install -g redpen",
      "Verify: redpen --version",
      "supercli plugins install ./plugins/redpen --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "redpen",
      "resource": "self",
      "action": "version",
      "description": "Print redpen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "redpen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install redpen: npm install -g redpen"
      },
      "args": []
    },
    {
      "namespace": "redpen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to redpen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "redpen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install redpen: npm install -g redpen"
      },
      "args": []
    }
  ]
}
