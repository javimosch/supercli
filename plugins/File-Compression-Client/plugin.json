{
  "name": "File-Compression-Client",
  "version": "0.1.0",
  "description": "A compression and decompression program utilizing LZ78 lossless algorithms",
  "source": "https://github.com/File-Compression-Client/File-Compression-Client",
  "checks": [
    {
      "type": "binary",
      "name": "File-Compression-Client"
    }
  ],
  "install_guidance": {
    "plugin": "File-Compression-Client",
    "binary": "File-Compression-Client",
    "check": "which File-Compression-Client",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: File-Compression-Client --version",
      "supercli plugins install ./plugins/File-Compression-Client --on-conflict replace --json"
    ],
    "note": "C language CLI tool"
  },
  "commands": [
    {
      "namespace": "File-Compression-Client",
      "resource": "self",
      "action": "version",
      "description": "Print File-Compression-Client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "File-Compression-Client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install File-Compression-Client from project repository"
      },
      "args": []
    },
    {
      "namespace": "File-Compression-Client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to File-Compression-Client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "File-Compression-Client",
        "passthrough": true,
        "missingDependencyHelp": "Install File-Compression-Client from project repository"
      },
      "args": []
    }
  ]
}