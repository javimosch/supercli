{
  "name": "erfa",
  "version": "0.1.0",
  "description": "Essential Routines for Fundamental Astronomy",
  "source": "https://github.com/liberfa/erfa",
  "checks": [
    {
      "type": "binary",
      "name": "erfa"
    }
  ],
  "install_guidance": {
    "plugin": "erfa",
    "binary": "erfa",
    "check": "which erfa",
    "install_steps": [
      "brew install erfa",
      "Verify: erfa --version",
      "supercli plugins install ./plugins/erfa --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "erfa",
      "resource": "self",
      "action": "version",
      "description": "Print erfa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "erfa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install erfa: brew install erfa"
      },
      "args": []
    },
    {
      "namespace": "erfa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to erfa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "erfa",
        "passthrough": true,
        "missingDependencyHelp": "Install erfa"
      },
      "args": []
    }
  ]
}