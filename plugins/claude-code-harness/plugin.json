{
  "name": "claude-code-harness",
  "version": "0.1.0",
  "description": "Claude Code Dedicated Development Harness - Achieving High-Quality Development Through an Autonomous",
  "source": "https://github.com/claude-code-harness/claude-code-harness",
  "checks": [
    {
      "type": "binary",
      "name": "claude-code-harness"
    }
  ],
  "install_guidance": {
    "plugin": "claude-code-harness",
    "binary": "claude-code-harness",
    "check": "which claude-code-harness",
    "install_steps": [
      "pip install claude-code-harness",
      "Verify: claude-code-harness --version",
      "supercli plugins install ./plugins/claude-code-harness --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-code-harness",
      "resource": "self",
      "action": "version",
      "description": "Print claude-code-harness version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-harness",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-code-harness: pip install claude-code-harness"
      },
      "args": []
    },
    {
      "namespace": "claude-code-harness",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-code-harness CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-harness",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-code-harness: pip install claude-code-harness"
      },
      "args": []
    }
  ]
}