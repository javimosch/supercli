{
  "name": "bupstash",
  "version": "0.1.0",
  "description": "Encrypted efficient deduplicated backup tool in Rust",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "bupstash" }],
  "install_guidance": {
    "plugin": "bupstash",
    "binary": "bupstash",
    "check": "which bupstash",
    "install_steps": ["cargo install bupstash", "Verify: bupstash --version", "supercli plugins install ./plugins/bupstash --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bupstash",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bupstash CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bupstash",
      "passthrough": true,
      "missingDependencyHelp": "Install bupstash: cargo install bupstash"
    },
    "args": []
  }]
}
