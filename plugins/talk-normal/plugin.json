{
  "name": "talk-normal",
  "version": "0.1.0",
  "description": "Make any LLM talk like a normal person. A system prompt that removes AI slop.",
  "source": "https://github.com/talk-normal/talk-normal",
  "checks": [
    {
      "type": "binary",
      "name": "talk-normal"
    }
  ],
  "install_guidance": {
    "plugin": "talk-normal",
    "binary": "talk-normal",
    "check": "which talk-normal",
    "install_steps": [
      "pip install talk-normal",
      "Verify: talk-normal --version",
      "supercli plugins install ./plugins/talk-normal --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "talk-normal",
      "resource": "self",
      "action": "version",
      "description": "Print talk-normal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "talk-normal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install talk-normal: pip install talk-normal"
      },
      "args": []
    },
    {
      "namespace": "talk-normal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to talk-normal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "talk-normal",
        "passthrough": true,
        "missingDependencyHelp": "Install talk-normal: pip install talk-normal"
      },
      "args": []
    }
  ]
}