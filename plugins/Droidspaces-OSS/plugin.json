{
  "name": "Droidspaces-OSS",
  "version": "0.1.0",
  "description": "A lightweight, LXC-like container runtime for Android and Linux. Run full Linux distributions native",
  "source": "https://github.com/Droidspaces-OSS/Droidspaces-OSS",
  "checks": [
    {
      "type": "binary",
      "name": "droidspaces-oss"
    }
  ],
  "install_guidance": {
    "plugin": "Droidspaces-OSS",
    "binary": "droidspaces-oss",
    "check": "which droidspaces-oss",
    "install_steps": [
      "pip install droidspaces-oss",
      "Verify: droidspaces-oss --version",
      "supercli plugins install ./plugins/Droidspaces-OSS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Droidspaces-OSS",
      "resource": "self",
      "action": "version",
      "description": "Print Droidspaces-OSS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "droidspaces-oss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Droidspaces-OSS: pip install droidspaces-oss"
      },
      "args": []
    },
    {
      "namespace": "Droidspaces-OSS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to droidspaces-oss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "droidspaces-oss",
        "passthrough": true,
        "missingDependencyHelp": "Install Droidspaces-OSS: pip install droidspaces-oss"
      },
      "args": []
    }
  ]
}