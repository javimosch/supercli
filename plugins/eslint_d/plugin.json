{
  "name": "eslint_d",
  "version": "0.1.0",
  "description": "Speed up eslint to accelerate your development workflow",
  "source": "https://github.com/mantoni/eslint_d.js",
  "checks": [
    {
      "type": "binary",
      "name": "eslint_d"
    }
  ],
  "install_guidance": {
    "plugin": "eslint_d",
    "binary": "eslint_d",
    "check": "which eslint_d",
    "install_steps": [
      "brew install eslint_d",
      "Verify: eslint_d --version",
      "supercli plugins install ./plugins/eslint_d --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "eslint_d",
      "resource": "self",
      "action": "version",
      "description": "Print eslint_d version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eslint_d",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eslint_d: brew install eslint_d"
      },
      "args": []
    },
    {
      "namespace": "eslint_d",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eslint_d CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eslint_d",
        "passthrough": true,
        "missingDependencyHelp": "Install eslint_d"
      },
      "args": []
    }
  ]
}