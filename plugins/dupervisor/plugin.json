{
  "name": "dupervisor",
  "version": "0.1.0",
  "description": "Config converter for YAML, JSON, and INI formats",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "dupervisor" }],
  "install_guidance": {
    "plugin": "dupervisor",
    "binary": "dupervisor",
    "check": "which dupervisor",
    "install_steps": ["pip install dupervisor", "Verify: dupervisor --version", "supercli plugins install ./plugins/dupervisor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dupervisor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dupervisor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dupervisor",
      "passthrough": true,
      "missingDependencyHelp": "Install dupervisor: pip install dupervisor"
    },
    "args": []
  }]
}
