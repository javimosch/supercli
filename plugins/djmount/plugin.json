{
  "name": "djmount",
  "version": "0.1.0",
  "description": "CLI tool: djmount",
  "source": "https://packages.debian.org/djmount",
  "checks": [{ "type": "binary", "name": "djmount" }],
  "install_guidance": {
    "plugin": "djmount", "binary": "djmount", "check": "which djmount",
    "install_steps": ["apt-get install djmount 2>/dev/null || which djmount", "Verify: djmount --version", "supercli plugins install ./plugins/djmount --on-conflict replace --json"]
