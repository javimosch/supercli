{
  "name": "loccount",
  "version": "0.1.0",
  "description": "Fast code line counter with multi-language support",
  "source": "https://gitlab.com/esr/loccount",
  "checks": [{ "type": "binary", "name": "loccount" }],
  "install_guidance": {
    "plugin": "loccount",
    "binary": "loccount",
    "check": "which loccount",
    "install_steps": ["go install gitlab.com/esr/loccount@latest", "Verify: loccount --version", "supercli plugins install ./plugins/loccount --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "loccount",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to loccount CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "loccount",
      "passthrough": true,
      "missingDependencyHelp": "Install loccount: go install gitlab.com/esr/loccount@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
