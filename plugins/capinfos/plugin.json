  "commands": [{
    "namespace": "capinfos", "resource": "_", "action": "_",
    "description": "Passthrough to capinfos CLI",
    "adapter": "process", "adapterConfig": { "command": "capinfos", "passthrough": true, "missingDependencyHelp": "Install capinfos: apt-get install wireshark-common" }, "args": []
  }]
}
