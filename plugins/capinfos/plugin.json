{
  "name": "capinfos",
  "version": "0.1.0",
  "description": "Packet capture file information",
  "source": "https://packages.debian.org/capinfos",
  "checks": [{ "type": "binary", "name": "capinfos" }],
  "install_guidance": {
    "plugin": "capinfos", "binary": "capinfos", "check": "which capinfos",
    "install_steps": ["apt-get install wireshark-common", "Verify: capinfos --version", "supercli plugins install ./plugins/capinfos --on-conflict replace --json"]
