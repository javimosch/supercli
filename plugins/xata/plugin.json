{
  "name": "xata",
  "version": "0.1.0",
  "description": "Xata serverless database CLI",
  "source": "https://github.com/xataio/cli",
  "checks": [{ "type": "binary", "name": "xata" }],
  "install_guidance": {
    "plugin": "xata",
    "binary": "xata",
    "check": "which xata",
    "install_steps": ["npm install -g @xata.io/cli", "Verify: xata --version", "supercli plugins install ./plugins/xata --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "xata",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to xata CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "xata",
      "passthrough": true,
      "missingDependencyHelp": "Install xata: npm install -g @xata.io/cli"
    },
    "args": []
  }]
}
