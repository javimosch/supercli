{
  "name": "async-profiler",
  "version": "0.1.0",
  "description": "Sampling CPU & HEAP profiler for Java using AsyncGetCallTrace + perf_events",
  "source": "https://github.com/async-profiler/async-profiler",
  "checks": [
    {
      "type": "binary",
      "name": "async-profiler"
    }
  ],
  "install_guidance": {
    "plugin": "async-profiler",
    "binary": "async-profiler",
    "check": "which async-profiler",
    "install_steps": [
      "brew install async-profiler",
      "Verify: async-profiler --version",
      "supercli plugins install ./plugins/async-profiler --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "async-profiler",
      "resource": "self",
      "action": "version",
      "description": "Print async-profiler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "async-profiler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install async-profiler: brew install async-profiler"
      },
      "args": []
    },
    {
      "namespace": "async-profiler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to async-profiler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "async-profiler",
        "passthrough": true,
        "missingDependencyHelp": "Install async-profiler"
      },
      "args": []
    }
  ]
}