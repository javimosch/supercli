{
  "name": "pdm-build",
  "version": "0.1.0",
  "description": "PEP 517 build backend for PDM Python projects",
  "source": "https://github.com/pdm-project/pdm",
  "checks": [{ "type": "binary", "name": "pdm-build" }],
  "install_guidance": {
    "plugin": "pdm-build",
    "binary": "pdm-build",
    "check": "which pdm-build",
    "install_steps": ["pip install pdm-build", "Verify: pdm-build --version", "supercli plugins install ./plugins/pdm-build --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdm-build",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdm-build CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdm-build",
      "passthrough": true,
      "missingDependencyHelp": "Install pdm-build: pip install pdm-build", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
