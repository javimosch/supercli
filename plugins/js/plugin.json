{
  "name": "js",
  "version": "0.1.0",
  "description": "CLI tool: js",
  "source": "https://manpages.debian.org/js",
  "checks": [
    {
      "type": "binary",
      "name": "js"
    }
  ],
  "install_guidance": {
    "plugin": "js",
    "binary": "js",
    "check": "which js",
    "install_steps": [
      "apt-get install js 2>/dev/null || which js",
      "Verify: js --version",
      "supercli plugins install ./plugins/js --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "js",
      "resource": "self",
      "action": "version",
      "description": "Print js version",
      "adapter": "process",
      "adapterConfig": {
        "command": "js",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install js: apt-get install js 2>/dev/null || which js"
      },
      "args": []
    },
    {
      "namespace": "js",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to js CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "js",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install js: apt-get install js 2>/dev/null || which js"
      },
      "args": []
    }
  ]
}