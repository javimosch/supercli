{
  "name": "dh_installexamples",
  "version": "0.1.0",
  "description": "CLI tool: dh_installexamples",
  "source": "https://packages.debian.org/dh_installexamples",
  "checks": [{ "type": "binary", "name": "dh_installexamples" }],
  "install_guidance": {
    "plugin": "dh_installexamples", "binary": "dh_installexamples", "check": "which dh_installexamples",
    "install_steps": ["apt-get install dh_installexamples 2>/dev/null || which dh_installexamples", "Verify: dh_installexamples --version", "supercli plugins install ./plugins/dh_installexamples --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_installexamples", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installexamples CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installexamples", "passthrough": true, "missingDependencyHelp": "Install dh_installexamples: apt-get install dh_installexamples" }, "args": []
  }]
}
