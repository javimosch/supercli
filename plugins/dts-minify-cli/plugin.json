{
  "name": "dts-minify-cli",
  "version": "0.1.0",
  "description": "A simple cli tool for minify .d.ts files",
  "source": "https://jsr.io/@lino/dts-minify-cli",
  "checks": [
    {
      "type": "binary",
      "name": "dts-minify-cli"
    }
  ],
  "install_guidance": {
    "plugin": "dts-minify-cli",
    "binary": "dts-minify-cli",
    "check": "which dts-minify-cli",
    "install_steps": [
      "Check https://jsr.io/@lino/dts-minify-cli for installation instructions",
      "Verify: dts-minify-cli --version",
      "supercli plugins install ./plugins/dts-minify-cli --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "dts-minify-cli",
      "resource": "self",
      "action": "version",
      "description": "Print dts-minify-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dts-minify-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dts-minify-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "dts-minify-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dts-minify-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dts-minify-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install dts-minify-cli from project repository"
      },
      "args": []
    }
  ]
}