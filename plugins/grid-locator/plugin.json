{
  "name": "grid-locator",
  "version": "0.1.0",
  "description": "Convert between lat/lon and Maidenhead grid squares for ham radio",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "grid-locator" }],
  "install_guidance": {
    "plugin": "grid-locator",
    "binary": "grid-locator",
    "check": "which grid-locator",
    "install_steps": ["pip install grid-locator", "Verify: grid-locator --version", "supercli plugins install ./plugins/grid-locator --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "grid-locator",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to grid-locator CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "grid-locator",
      "passthrough": true,
      "missingDependencyHelp": "Install grid-locator: pip install grid-locator"
    },
    "args": []
  }]
}
