{
  "name": "llrt",
  "version": "0.1.0",
  "description": "LLRT (Low Latency Runtime) is an experimental, lightweight JavaScript runtime designed to address th",
  "source": "https://github.com/llrt/llrt",
  "checks": [
    {
      "type": "binary",
      "name": "llrt"
    }
  ],
  "install_guidance": {
    "plugin": "llrt",
    "binary": "llrt",
    "check": "which llrt",
    "install_steps": [
      "pip install llrt",
      "Verify: llrt --version",
      "supercli plugins install ./plugins/llrt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "llrt",
      "resource": "self",
      "action": "version",
      "description": "Print llrt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llrt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llrt: pip install llrt"
      },
      "args": []
    },
    {
      "namespace": "llrt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llrt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llrt",
        "passthrough": true,
        "missingDependencyHelp": "Install llrt: pip install llrt"
      },
      "args": []
    }
  ]
}