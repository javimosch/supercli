{
  "name": "ispell-wrapper",
  "version": "0.1.0",
  "description": "CLI tool: ispell-wrapper",
  "source": "https://manpages.debian.org/ispell-wrapper",
  "checks": [
    {
      "type": "binary",
      "name": "ispell-wrapper"
    }
  ],
  "install_guidance": {
    "plugin": "ispell-wrapper",
    "binary": "ispell-wrapper",
    "check": "which ispell-wrapper",
    "install_steps": [
      "apt-get install ispell-wrapper 2>/dev/null || which ispell-wrapper",
      "Verify: ispell-wrapper --version",
      "supercli plugins install ./plugins/ispell-wrapper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ispell-wrapper",
      "resource": "self",
      "action": "version",
      "description": "Print ispell-wrapper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ispell-wrapper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ispell-wrapper: apt-get install ispell-wrapper 2>/dev/null || which ispell-wrapper"
      },
      "args": []
    },
    {
      "namespace": "ispell-wrapper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ispell-wrapper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ispell-wrapper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ispell-wrapper: apt-get install ispell-wrapper 2>/dev/null || which ispell-wrapper"
      },
      "args": []
    }
  ]
}