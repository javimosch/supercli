{
  "name": "ConvertBooks",
  "version": "0.1.0",
  "description": "CLI for batch converting books into EPUB MOBI and AZW3 formats",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "ConvertBooks" }],
  "install_guidance": {
    "plugin": "ConvertBooks",
    "binary": "ConvertBooks",
    "check": "which ConvertBooks",
    "install_steps": ["git clone && python3 convert_books.py", "Verify: ConvertBooks --version", "supercli plugins install ./plugins/ConvertBooks --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ConvertBooks",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ConvertBooks CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ConvertBooks",
      "passthrough": true,
      "missingDependencyHelp": "Install ConvertBooks: git clone && python3 convert_books.py"
    },
    "args": []
  }]
}
