{
  "name": "prr",
  "version": "0.1.0",
  "description": "AI-powered pull request reviewer in your terminal — headless JSON review mode for CI",
  "source": "https://github.com/andreujuanc/prr",
  "checks": [
    {
      "type": "binary",
      "name": "prr"
    }
  ],
  "install_guidance": {
    "plugin": "prr",
    "binary": "prr",
    "check": "which prr",
    "install_steps": [
      "go install github.com/andreujuanc/prr@latest",
      "Verify: prr --version",
      "supercli plugins install ./plugins/prr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "prr",
      "resource": "self",
      "action": "version",
      "description": "Print prr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "prr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install prr: go install github.com/andreujuanc/prr@latest"
      },
      "args": []
    },
    {
      "namespace": "prr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to prr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "prr",
        "passthrough": true,
        "missingDependencyHelp": "Install prr: go install github.com/andreujuanc/prr@latest"
      },
      "args": []
    }
  ]
}
