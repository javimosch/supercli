{
  "name": "rst2pseudoxml",
  "version": "0.1.0",
  "description": "CLI tool: rst2pseudoxml",
  "source": "https://manpages.debian.org/rst2pseudoxml",
  "checks": [
    {
      "type": "binary",
      "name": "rst2pseudoxml"
    }
  ],
  "install_guidance": {
    "plugin": "rst2pseudoxml",
    "binary": "rst2pseudoxml",
    "check": "which rst2pseudoxml",
    "install_steps": [
      "apt-get install rst2pseudoxml 2>/dev/null || which rst2pseudoxml",
      "Verify: rst2pseudoxml --version",
      "supercli plugins install ./plugins/rst2pseudoxml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rst2pseudoxml",
      "resource": "self",
      "action": "version",
      "description": "Print rst2pseudoxml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2pseudoxml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rst2pseudoxml: apt-get install rst2pseudoxml 2>/dev/null || which rst2pseudoxml"
      },
      "args": []
    },
    {
      "namespace": "rst2pseudoxml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rst2pseudoxml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2pseudoxml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rst2pseudoxml: apt-get install rst2pseudoxml 2>/dev/null || which rst2pseudoxml"
      },
      "args": []
    }
  ]
}