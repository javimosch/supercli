{
  "name": "ninja",
  "version": "1.0.0",
  "description": "ninja \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=ninja+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "ninja"
    }
  ],
  "install_guidance": {
    "plugin": "ninja",
    "binary": "ninja",
    "check": "which ninja",
    "install_steps": [
      "Install ninja via package manager: apt install ninja or brew install ninja"
    ]
  },
  "commands": [
    {
      "namespace": "ninja",
      "resource": "run",
      "action": "exec",
      "description": "ninja \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "ninja",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ninja via your package manager"
      },
      "args": []
    }
  ]
}