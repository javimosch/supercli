{
  "name": "killport",
  "version": "0.1.0",
  "description": "Command-line tool to kill processes listening on a specific port",
  "source": "https://github.com/jkfran/killport",
  "checks": [
    {
      "type": "binary",
      "name": "killport"
    }
  ],
  "install_guidance": {
    "plugin": "killport",
    "binary": "killport",
    "check": "which killport",
    "install_steps": [
      "brew install killport",
      "Verify: killport --version",
      "supercli plugins install ./plugins/killport --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "killport",
      "resource": "self",
      "action": "version",
      "description": "Print killport version",
      "adapter": "process",
      "adapterConfig": {
        "command": "killport",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install killport: brew install killport"
      },
      "args": []
    },
    {
      "namespace": "killport",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to killport CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "killport",
        "passthrough": true,
        "missingDependencyHelp": "Install killport"
      },
      "args": []
    }
  ]
}