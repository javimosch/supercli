    "plugin": "at_remote", "binary": "at_remote", "check": "which at_remote",
    "install_steps": ["apt-get install at_remote 2>/dev/null || which at_remote", "Verify: at_remote --version", "supercli plugins install ./plugins/at_remote --on-conflict replace --json"]
