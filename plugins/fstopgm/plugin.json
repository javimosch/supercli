{
  "name": "fstopgm",
  "version": "0.1.0",
  "description": "CLI tool: fstopgm",
  "source": "https://manpages.debian.org/fstopgm",
  "checks": [
    {
      "type": "binary",
      "name": "fstopgm"
    }
  ],
  "install_guidance": {
    "plugin": "fstopgm",
    "binary": "fstopgm",
    "check": "which fstopgm",
    "install_steps": [
      "apt-get install fstopgm 2>/dev/null || which fstopgm",
      "Verify: fstopgm --version",
      "supercli plugins install ./plugins/fstopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fstopgm",
      "resource": "self",
      "action": "version",
      "description": "Print fstopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fstopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fstopgm: apt-get install fstopgm 2>/dev/null || which fstopgm"
      },
      "args": []
    },
    {
      "namespace": "fstopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fstopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fstopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fstopgm: apt-get install fstopgm 2>/dev/null || which fstopgm"
      },
      "args": []
    }
  ]
}