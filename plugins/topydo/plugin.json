{
  "name": "topydo",
  "version": "0.1.0",
  "description": "Powerful todo list for console in Python",
  "source": "https://github.com/nicedoc/topydo",
  "checks": [
    {
      "type": "binary",
      "name": "topydo"
    }
  ],
  "install_guidance": {
    "plugin": "topydo",
    "binary": "topydo",
    "check": "which topydo",
    "install_steps": [
      "pip install topydo",
      "Verify: topydo --version",
      "supercli plugins install ./plugins/topydo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "topydo",
      "resource": "self",
      "action": "version",
      "description": "Print topydo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "topydo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install topydo: pip install topydo"
      },
      "args": []
    },
    {
      "namespace": "topydo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to topydo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "topydo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install topydo: pip install topydo"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
