{
  "name": "limactl",
  "version": "0.1.0",
  "description": "Linux virtual machines on macOS and Linux hosts",
  "source": "https://github.com/lima-vm/lima",
  "checks": [{ "type": "binary", "name": "limactl" }],
  "install_guidance": {
    "plugin": "limactl",
    "binary": "limactl",
    "check": "which limactl",
    "install_steps": ["brew install lima", "Verify: limactl --version", "supercli plugins install ./plugins/limactl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "limactl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to limactl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "limactl",
      "passthrough": true,
      "missingDependencyHelp": "Install limactl: brew install lima"
    },
    "args": []
  }]
}
