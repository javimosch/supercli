{
  "name": "remind",
  "version": "0.1.0",
  "description": "Sophisticated calendar and alarm system",
  "source": "https://github.com/dianne-sk/remind",
  "checks": [
    {
      "type": "binary",
      "name": "remind"
    }
  ],
  "install_guidance": {
    "plugin": "remind",
    "binary": "remind",
    "check": "which remind",
    "install_steps": [
      "brew install remind",
      "Verify: remind --version",
      "supercli plugins install ./plugins/remind --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "remind",
      "resource": "self",
      "action": "version",
      "description": "Print remind version",
      "adapter": "process",
      "adapterConfig": {
        "command": "remind",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install remind: brew install remind"
      },
      "args": []
    },
    {
      "namespace": "remind",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to remind CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "remind",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install remind: brew install remind"
      },
      "args": []
    }
  ]
}
