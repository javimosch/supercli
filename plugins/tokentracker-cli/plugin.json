{
  "name": "tokentracker-cli",
  "version": "0.1.0",
  "description": "Token usage and fitness-style tracker for AI agent activity",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "tokentracker-cli" }],
  "install_guidance": {
    "plugin": "tokentracker-cli",
    "binary": "tokentracker-cli",
    "check": "which tokentracker-cli",
    "install_steps": ["npm install -g tokentracker-cli", "Verify: tokentracker-cli --version", "supercli plugins install ./plugins/tokentracker-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tokentracker-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tokentracker-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tokentracker-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install tokentracker-cli: npm install -g tokentracker-cli"
    },
    "args": []
  }]
}
