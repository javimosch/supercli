{
  "name": "envset",
  "version": "0.1.0",
  "description": "Environment variable manager CLI — load, validate, and export env vars as JSON",
  "source": "https://github.com/envset/envset",
  "checks": [
    {
      "type": "binary",
      "name": "envset"
    }
  ],
  "install_guidance": {
    "plugin": "envset",
    "binary": "envset",
    "check": "which envset",
    "install_steps": [
      "go install github.com/envset/envset@latest",
      "Verify: envset --version",
      "supercli plugins install ./plugins/envset --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "envset",
      "resource": "self",
      "action": "version",
      "description": "Print envset version",
      "adapter": "process",
      "adapterConfig": {
        "command": "envset",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install: go install github.com/envset/envset@latest"
      },
      "args": []
    },
    {
      "namespace": "envset",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to envset",
      "adapter": "process",
      "adapterConfig": {
        "command": "envset",
        "passthrough": true,
        "missingDependencyHelp": "Install: go install github.com/envset/envset@latest"
      },
      "args": []
    }
  ]
}
