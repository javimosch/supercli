{
  "name": "NPatch",
  "version": "0.1.0",
  "description": "NPatch\u662f\u4e00\u4e2a\u590d\u523b\u81eaLSPatch\uff0c\u4ee5LSPosed\u4e3a\u57fa\u7840\u7684\u514droot\u7684Xposed\u6846\u67b6",
  "source": "https://github.com/NPatch/NPatch",
  "checks": [
    {
      "type": "binary",
      "name": "npatch"
    }
  ],
  "install_guidance": {
    "plugin": "NPatch",
    "binary": "npatch",
    "check": "which npatch",
    "install_steps": [
      "pip install npatch",
      "Verify: npatch --version",
      "supercli plugins install ./plugins/NPatch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NPatch",
      "resource": "self",
      "action": "version",
      "description": "Print NPatch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "npatch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NPatch: pip install npatch"
      },
      "args": []
    },
    {
      "namespace": "NPatch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to npatch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "npatch",
        "passthrough": true,
        "missingDependencyHelp": "Install NPatch: pip install npatch"
      },
      "args": []
    }
  ]
}