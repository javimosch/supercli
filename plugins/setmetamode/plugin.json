{
  "name": "setmetamode",
  "version": "0.1.0",
  "description": "CLI tool: setmetamode",
  "source": "https://manpages.debian.org/setmetamode",
  "checks": [
    {
      "type": "binary",
      "name": "setmetamode"
    }
  ],
  "install_guidance": {
    "plugin": "setmetamode",
    "binary": "setmetamode",
    "check": "which setmetamode",
    "install_steps": [
      "apt-get install setmetamode 2>/dev/null || which setmetamode",
      "Verify: setmetamode --version",
      "supercli plugins install ./plugins/setmetamode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "setmetamode",
      "resource": "self",
      "action": "version",
      "description": "Print setmetamode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "setmetamode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install setmetamode: apt-get install setmetamode 2>/dev/null || which setmetamode"
      },
      "args": []
    },
    {
      "namespace": "setmetamode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to setmetamode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "setmetamode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install setmetamode: apt-get install setmetamode 2>/dev/null || which setmetamode"
      },
      "args": []
    }
  ]
}