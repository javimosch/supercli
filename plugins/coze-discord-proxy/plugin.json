{
  "name": "coze-discord-proxy",
  "version": "0.1.0",
  "description": "\u4ee3\u7406Discord\u5bf9\u8bddCoze-Bot\uff0c\u5b9e\u73b0\u4ee5API\u5f62\u5f0f\u8bf7\u6c42GPT4\u6a21\u578b\uff0c\u63d0\u4f9b\u5bf9\u8bdd\u3001\u6587\u751f\u56fe\u3001\u56fe\u751f\u6587\u3001\u77e5\u8bc6\u5e93\u68c0\u7d22\u7b49\u529f\u80fd\u3002",
  "source": "https://github.com/coze-discord-proxy/coze-discord-proxy",
  "checks": [
    {
      "type": "binary",
      "name": "coze-discord-proxy"
    }
  ],
  "install_guidance": {
    "plugin": "coze-discord-proxy",
    "binary": "coze-discord-proxy",
    "check": "which coze-discord-proxy",
    "install_steps": [
      "pip install coze-discord-proxy",
      "Verify: coze-discord-proxy --version",
      "supercli plugins install ./plugins/coze-discord-proxy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "coze-discord-proxy",
      "resource": "self",
      "action": "version",
      "description": "Print coze-discord-proxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coze-discord-proxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coze-discord-proxy: pip install coze-discord-proxy"
      },
      "args": []
    },
    {
      "namespace": "coze-discord-proxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coze-discord-proxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coze-discord-proxy",
        "passthrough": true,
        "missingDependencyHelp": "Install coze-discord-proxy: pip install coze-discord-proxy"
      },
      "args": []
    }
  ]
}