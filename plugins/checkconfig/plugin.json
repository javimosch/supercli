{
  "name": "checkconfig",
  "version": "0.1.0",
  "description": "CLI tool: checkconfig",
  "source": "https://packages.debian.org/checkconfig",
  "checks": [{ "type": "binary", "name": "checkconfig" }],
  "install_guidance": {
    "plugin": "checkconfig", "binary": "checkconfig", "check": "which checkconfig",
    "install_steps": ["apt-get install checkconfig 2>/dev/null || which checkconfig", "Verify: checkconfig --version", "supercli plugins install ./plugins/checkconfig --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "checkconfig", "resource": "_", "action": "_",
    "description": "Passthrough to checkconfig CLI",
    "adapter": "process", "adapterConfig": { "command": "checkconfig", "passthrough": true, "missingDependencyHelp": "Install checkconfig: apt-get install checkconfig" }, "args": []
  }]
}
