{
  "name": "wovf2ovp",
  "version": "0.1.0",
  "description": "CLI tool: wovf2ovp",
  "source": "https://manpages.debian.org/wovf2ovp",
  "checks": [
    {
      "type": "binary",
      "name": "wovf2ovp"
    }
  ],
  "install_guidance": {
    "plugin": "wovf2ovp",
    "binary": "wovf2ovp",
    "check": "which wovf2ovp",
    "install_steps": [
      "apt-get install wovf2ovp 2>/dev/null || which wovf2ovp",
      "Verify: wovf2ovp --version",
      "supercli plugins install ./plugins/wovf2ovp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wovf2ovp",
      "resource": "self",
      "action": "version",
      "description": "Print wovf2ovp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wovf2ovp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wovf2ovp: apt-get install wovf2ovp 2>/dev/null || which wovf2ovp"
      },
      "args": []
    },
    {
      "namespace": "wovf2ovp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wovf2ovp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wovf2ovp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wovf2ovp: apt-get install wovf2ovp 2>/dev/null || which wovf2ovp"
      },
      "args": []
    }
  ]
}