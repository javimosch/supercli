{
  "name": "TrollInstallerX",
  "version": "0.1.0",
  "description": "A TrollStore installer for iOS 14.0 - 16.6.1",
  "source": "https://github.com/TrollInstallerX/TrollInstallerX",
  "checks": [
    {
      "type": "binary",
      "name": "trollinstallerx"
    }
  ],
  "install_guidance": {
    "plugin": "TrollInstallerX",
    "binary": "trollinstallerx",
    "check": "which trollinstallerx",
    "install_steps": [
      "pip install trollinstallerx",
      "Verify: trollinstallerx --version",
      "supercli plugins install ./plugins/TrollInstallerX --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TrollInstallerX",
      "resource": "self",
      "action": "version",
      "description": "Print TrollInstallerX version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trollinstallerx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TrollInstallerX: pip install trollinstallerx"
      },
      "args": []
    },
    {
      "namespace": "TrollInstallerX",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trollinstallerx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trollinstallerx",
        "passthrough": true,
        "missingDependencyHelp": "Install TrollInstallerX: pip install trollinstallerx"
      },
      "args": []
    }
  ]
}