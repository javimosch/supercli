{
  "name": "SCENARI",
  "version": "0.1.0",
  "description": "CLI tool: SCENARI",
  "source": "https://manpages.debian.org/SCENARI",
  "checks": [
    {
      "type": "binary",
      "name": "SCENARI"
    }
  ],
  "install_guidance": {
    "plugin": "SCENARI",
    "binary": "SCENARI",
    "check": "which SCENARI",
    "install_steps": [
      "apt-get install SCENARI 2>/dev/null || which SCENARI",
      "Verify: SCENARI --version",
      "supercli plugins install ./plugins/SCENARI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SCENARI",
      "resource": "self",
      "action": "version",
      "description": "Print SCENARI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "SCENARI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SCENARI: apt-get install SCENARI 2>/dev/null || which SCENARI"
      },
      "args": []
    },
    {
      "namespace": "SCENARI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to SCENARI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "SCENARI",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install SCENARI: apt-get install SCENARI 2>/dev/null || which SCENARI"
      },
      "args": []
    }
  ]
}