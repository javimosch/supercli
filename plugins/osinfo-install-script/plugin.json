{
  "name": "osinfo-install-script",
  "version": "0.1.0",
  "description": "CLI tool: osinfo-install-script",
  "source": "https://manpages.debian.org/osinfo-install-script",
  "checks": [
    {
      "type": "binary",
      "name": "osinfo-install-script"
    }
  ],
  "install_guidance": {
    "plugin": "osinfo-install-script",
    "binary": "osinfo-install-script",
    "check": "which osinfo-install-script",
    "install_steps": [
      "apt-get install osinfo-install-script 2>/dev/null || which osinfo-install-script",
      "Verify: osinfo-install-script --version",
      "supercli plugins install ./plugins/osinfo-install-script --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "osinfo-install-script",
      "resource": "self",
      "action": "version",
      "description": "Print osinfo-install-script version",
      "adapter": "process",
      "adapterConfig": {
        "command": "osinfo-install-script",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install osinfo-install-script: apt-get install osinfo-install-script 2>/dev/null || which osinfo-install-script"
      },
      "args": []
    },
    {
      "namespace": "osinfo-install-script",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to osinfo-install-script CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "osinfo-install-script",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install osinfo-install-script: apt-get install osinfo-install-script 2>/dev/null || which osinfo-install-script"
      },
      "args": []
    }
  ]
}