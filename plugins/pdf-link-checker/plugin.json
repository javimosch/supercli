{
  "name": "pdf-link-checker",
  "version": "0.1.0",
  "description": "Automated verification of broken links within PDF files",
  "source": "https://github.com/a-nau/pdf-link-checker",
  "checks": [{ "type": "binary", "name": "pdf-link-checker" }],
  "install_guidance": {
    "plugin": "pdf-link-checker",
    "binary": "pdf-link-checker",
    "check": "which pdf-link-checker",
    "install_steps": ["pip install pdf-link-checker", "Verify: pdf-link-checker --version", "supercli plugins install ./plugins/pdf-link-checker --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdf-link-checker",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdf-link-checker CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdf-link-checker",
      "passthrough": true,
      "missingDependencyHelp": "Install pdf-link-checker: pip install pdf-link-checker", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
