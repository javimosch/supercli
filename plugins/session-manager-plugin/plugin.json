{
  "name": "session-manager-plugin",
  "version": "0.1.0",
  "description": "CLI tool: session-manager-plugin",
  "source": "https://manpages.debian.org/session-manager-plugin",
  "checks": [
    {
      "type": "binary",
      "name": "session-manager-plugin"
    }
  ],
  "install_guidance": {
    "plugin": "session-manager-plugin",
    "binary": "session-manager-plugin",
    "check": "which session-manager-plugin",
    "install_steps": [
      "apt-get install session-manager-plugin 2>/dev/null || which session-manager-plugin",
      "Verify: session-manager-plugin --version",
      "supercli plugins install ./plugins/session-manager-plugin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "session-manager-plugin",
      "resource": "self",
      "action": "version",
      "description": "Print session-manager-plugin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "session-manager-plugin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install session-manager-plugin: apt-get install session-manager-plugin 2>/dev/null || which session-manager-plugin"
      },
      "args": []
    },
    {
      "namespace": "session-manager-plugin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to session-manager-plugin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "session-manager-plugin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install session-manager-plugin: apt-get install session-manager-plugin 2>/dev/null || which session-manager-plugin"
      },
      "args": []
    }
  ]
}