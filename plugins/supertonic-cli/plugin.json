{
  "name": "supertonic-cli",
  "version": "0.1.0",
  "description": "On-device TTS from the command line — 31 languages, 10 voices, no cloud, built on Supertonic (ONNX)",
  "source": "https://github.com/javimosch/supertonic-cli",
  "checks": [
    { "type": "binary", "name": "supertonic-cli" }
  ],
  "install_guidance": {
    "plugin": "supertonic-cli",
    "binary": "supertonic-cli",
    "check": "which supertonic-cli && python3 -c 'from supertonic import TTS'",
    "install_steps": [
      "pip install supertonic",
      "pip install supertonic-cli",
      "Verify: supertonic-cli --help",
      "supercli plugins install ./plugins/supertonic-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "supertonic-cli",
      "resource": "self",
      "action": "version",
      "description": "Print supertonic-cli info",
      "adapter": "process",
      "adapterConfig": {
        "command": "supertonic-cli",
        "baseArgs": ["info"],
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install: pip install supertonic && pip install supertonic-cli"
      },
      "args": []
    },
    {
      "namespace": "supertonic-cli",
      "resource": "tts",
      "action": "synthesize",
      "description": "Synthesize speech from text to file",
      "adapter": "process",
      "adapterConfig": {
        "command": "supertonic-cli",
        "baseArgs": ["synthesize"],
        "cwd": "invoke_cwd",
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install: pip install supertonic && pip install supertonic-cli"
      },
      "args": [
        {"name": "text", "type": "string", "required": false, "description": "Text to synthesize"},
        {"name": "voice", "type": "string", "required": false, "description": "Voice: M1-M5 male, F1-F5 female"},
        {"name": "lang", "type": "string", "required": false, "description": "Language code"},
        {"name": "output", "type": "string", "required": false, "description": "Output WAV path"},
        {"name": "machine", "type": "boolean", "required": false, "description": "Machine JSON output"}
      ]
    },
    {
      "namespace": "supertonic-cli",
      "resource": "tts",
      "action": "speak",
      "description": "Synthesize and play aloud immediately, auto-cleanup temp file",
      "adapter": "process",
      "adapterConfig": {
        "command": "supertonic-cli",
        "baseArgs": ["speak"],
        "cwd": "invoke_cwd",
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install: pip install supertonic && pip install supertonic-cli"
      },
      "args": [
        {"name": "text", "type": "string", "required": false, "description": "Text to speak"},
        {"name": "voice", "type": "string", "required": false, "description": "Voice: M1-M5 male, F1-F5 female"},
        {"name": "lang", "type": "string", "required": false, "description": "Language code"},
        {"name": "machine", "type": "boolean", "required": false, "description": "Machine JSON output"}
      ]
    },
    {
      "namespace": "supertonic-cli",
      "resource": "tts",
      "action": "voices",
      "description": "List available voices",
      "adapter": "process",
      "adapterConfig": {
        "command": "supertonic-cli",
        "baseArgs": ["voices", "--machine"],
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install: pip install supertonic && pip install supertonic-cli"
      },
      "args": []
    },
    {
      "namespace": "supertonic-cli",
      "resource": "tts",
      "action": "languages",
      "description": "List supported languages",
      "adapter": "process",
      "adapterConfig": {
        "command": "supertonic-cli",
        "baseArgs": ["languages", "--machine"],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install: pip install supertonic && pip install supertonic-cli"
      },
      "args": []
    },
    {
      "namespace": "supertonic-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to supertonic-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "supertonic-cli",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install: pip install supertonic && pip install supertonic-cli"
      },
      "args": []
    }
  ]
}
