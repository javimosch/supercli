{
  "name": "pi1toppm",
  "version": "0.1.0",
  "description": "CLI tool: pi1toppm",
  "source": "https://manpages.debian.org/pi1toppm",
  "checks": [
    {
      "type": "binary",
      "name": "pi1toppm"
    }
  ],
  "install_guidance": {
    "plugin": "pi1toppm",
    "binary": "pi1toppm",
    "check": "which pi1toppm",
    "install_steps": [
      "apt-get install pi1toppm 2>/dev/null || which pi1toppm",
      "Verify: pi1toppm --version",
      "supercli plugins install ./plugins/pi1toppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pi1toppm",
      "resource": "self",
      "action": "version",
      "description": "Print pi1toppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pi1toppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pi1toppm: apt-get install pi1toppm 2>/dev/null || which pi1toppm"
      },
      "args": []
    },
    {
      "namespace": "pi1toppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pi1toppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pi1toppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pi1toppm: apt-get install pi1toppm 2>/dev/null || which pi1toppm"
      },
      "args": []
    }
  ]
}