{
  "name": "remodex",
  "version": "0.1.0",
  "description": "Remote Control for Codex.",
  "source": "https://github.com/remodex/remodex",
  "checks": [
    {
      "type": "binary",
      "name": "remodex"
    }
  ],
  "install_guidance": {
    "plugin": "remodex",
    "binary": "remodex",
    "check": "which remodex",
    "install_steps": [
      "pip install remodex",
      "Verify: remodex --version",
      "supercli plugins install ./plugins/remodex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "remodex",
      "resource": "self",
      "action": "version",
      "description": "Print remodex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "remodex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install remodex: pip install remodex"
      },
      "args": []
    },
    {
      "namespace": "remodex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to remodex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "remodex",
        "passthrough": true,
        "missingDependencyHelp": "Install remodex: pip install remodex"
      },
      "args": []
    }
  ]
}