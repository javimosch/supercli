{
  "name": "at-spi2-core",
  "version": "0.1.0",
  "description": "CLI tool: at-spi2-core",
  "source": "https://packages.debian.org/at-spi2-core",
  "checks": [{ "type": "binary", "name": "at-spi2-core" }],
  "install_guidance": {
    "plugin": "at-spi2-core", "binary": "at-spi2-core", "check": "which at-spi2-core",
    "install_steps": ["apt-get install at-spi2-core 2>/dev/null || which at-spi2-core", "Verify: at-spi2-core --version", "supercli plugins install ./plugins/at-spi2-core --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-spi2-core", "resource": "_", "action": "_",
    "description": "Passthrough to at-spi2-core CLI",
    "adapter": "process", "adapterConfig": { "command": "at-spi2-core", "passthrough": true, "missingDependencyHelp": "Install at-spi2-core: apt-get install at-spi2-core" }, "args": []
  }]
}
