{
  "name": "gospider",
  "version": "1.0.0",
  "description": "gospider \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=gospider+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "gospider"
    }
  ],
  "install_guidance": {
    "plugin": "gospider",
    "binary": "gospider",
    "check": "which gospider",
    "install_steps": [
      "Install gospider via package manager: apt install gospider or brew install gospider"
    ]
  },
  "commands": [
    {
      "namespace": "gospider",
      "resource": "run",
      "action": "exec",
      "description": "gospider \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "gospider",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gospider via your package manager"
      },
      "args": []
    }
  ]
}