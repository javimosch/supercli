{
  "name": "jfmt",
  "version": "0.1.0",
  "description": "Batch cli to beautify js, html, and css files",
  "source": "https://github.com/jfmt/jfmt",
  "checks": [
    {
      "type": "binary",
      "name": "jfmt"
    }
  ],
  "install_guidance": {
    "plugin": "jfmt",
    "binary": "jfmt",
    "check": "which jfmt",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: jfmt --version",
      "supercli plugins install ./plugins/jfmt --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "jfmt",
      "resource": "self",
      "action": "version",
      "description": "Print jfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jfmt from project repository"
      },
      "args": []
    },
    {
      "namespace": "jfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install jfmt from project repository"
      },
      "args": []
    }
  ]
}