{
  "name": "osmf",
  "version": "0.1.0",
  "description": "OpenStreetMap find - A simple command line tool to explore OSM data.",
  "source": "https://github.com/codesoap/osmar",
  "checks": [
    {
      "type": "binary",
      "name": "osmf"
    }
  ],
  "install_guidance": {
    "plugin": "osmf",
    "binary": "osmf",
    "check": "which osmf",
    "install_steps": [
      "See https://github.com/codesoap/osmar",
      "Verify: osmf --version",
      "supercli plugins install ./plugins/osmf --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "osmf",
      "resource": "self",
      "action": "version",
      "description": "Print osmf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "osmf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install osmf: See https://github.com/codesoap/osmar"
      },
      "args": []
    },
    {
      "namespace": "osmf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to osmf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "osmf",
        "passthrough": true,
        "missingDependencyHelp": "Install osmf"
      },
      "args": []
    }
  ]
}