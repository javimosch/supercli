{
  "name": "wkhtmltoimage",
  "version": "0.1.0",
  "description": "CLI tool: wkhtmltoimage",
  "source": "https://manpages.debian.org/wkhtmltoimage",
  "checks": [
    {
      "type": "binary",
      "name": "wkhtmltoimage"
    }
  ],
  "install_guidance": {
    "plugin": "wkhtmltoimage",
    "binary": "wkhtmltoimage",
    "check": "which wkhtmltoimage",
    "install_steps": [
      "apt-get install wkhtmltoimage 2>/dev/null || which wkhtmltoimage",
      "Verify: wkhtmltoimage --version",
      "supercli plugins install ./plugins/wkhtmltoimage --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wkhtmltoimage",
      "resource": "self",
      "action": "version",
      "description": "Print wkhtmltoimage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wkhtmltoimage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wkhtmltoimage: apt-get install wkhtmltoimage 2>/dev/null || which wkhtmltoimage"
      },
      "args": []
    },
    {
      "namespace": "wkhtmltoimage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wkhtmltoimage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wkhtmltoimage",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wkhtmltoimage: apt-get install wkhtmltoimage 2>/dev/null || which wkhtmltoimage"
      },
      "args": []
    }
  ]
}