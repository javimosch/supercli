{
  "name": "image-reflector",
  "version": "0.1.0",
  "description": "Reflect container image metadata in Kubernetes",
  "source": "https://github.com/fluxcd/image-reflector-controller",
  "checks": [{ "type": "binary", "name": "image-reflector-controller" }],
  "install_guidance": {
    "plugin": "image-reflector",
    "binary": "image-reflector-controller",
    "check": "which image-reflector-controller",
    "install_steps": ["brew install image-reflector", "Verify: image-reflector-controller --version", "supercli plugins install ./plugins/image-reflector --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "image-reflector",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to image-reflector-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "image-reflector-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install image-reflector: brew install image-reflector"
    },
    "args": []
  }]
}
