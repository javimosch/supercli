{
  "name": "ancient",
  "version": "0.1.0",
  "description": "Decompression routines for ancient formats",
  "source": "https://github.com/temisu/ancient",
  "checks": [
    {
      "type": "binary",
      "name": "ancient"
    }
  ],
  "install_guidance": {
    "plugin": "ancient",
    "binary": "ancient",
    "check": "which ancient",
    "install_steps": [
      "brew install ancient",
      "Verify: ancient --version",
      "supercli plugins install ./plugins/ancient --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ancient",
      "resource": "self",
      "action": "version",
      "description": "Print ancient version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ancient",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ancient: brew install ancient"
      },
      "args": []
    },
    {
      "namespace": "ancient",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ancient CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ancient",
        "passthrough": true,
        "missingDependencyHelp": "Install ancient"
      },
      "args": []
    }
  ]
}