{
  "name": "dottie",
  "version": "1.0.0",
  "description": "dottie \u2014 Dotfile templating",
  "source": "github.com/avelino/dottie",
  "checks": [
    {
      "type": "binary",
      "name": "dottie"
    }
  ],
  "install_guidance": {
    "plugin": "dottie",
    "binary": "dottie",
    "check": "which dottie",
    "install_steps": [
      "# Install dottie",
      "# See github.com/avelino/dottie",
      "# apt: sudo apt-get install dottie",
      "# brew: brew install dottie",
      "# cargo: cargo install dottie",
      "# npm: npm install -g dottie",
      "# pip: pip install dottie"
    ]
  },
  "commands": [
    {
      "namespace": "dottie",
      "resource": "dottie",
      "action": "run",
      "description": "Run dottie",
      "adapter": "process",
      "adapterConfig": {
        "command": "dottie",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dottie from github.com/avelino/dottie"
      },
      "args": []
    }
  ]
}