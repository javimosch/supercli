{
  "name": "when",
  "version": "0.1.0",
  "description": "Timezone-aware date/time calculator",
  "source": "https://github.com/b6d8/when",
  "checks": [
    {
      "type": "binary",
      "name": "when"
    }
  ],
  "install_guidance": {
    "plugin": "when",
    "binary": "when",
    "check": "which when",
    "install_steps": [
      "pip install when",
      "Verify: when --version",
      "supercli plugins install ./plugins/when --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "when",
      "resource": "self",
      "action": "version",
      "description": "Print when version",
      "adapter": "process",
      "adapterConfig": {
        "command": "when",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install when: pip install when"
      },
      "args": []
    },
    {
      "namespace": "when",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to when CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "when",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install when: pip install when"
      },
      "args": []
    }
  ]
}
