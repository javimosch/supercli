{
  "name": "sqfscat",
  "version": "0.1.0",
  "description": "CLI tool: sqfscat",
  "source": "https://manpages.debian.org/sqfscat",
  "checks": [
    {
      "type": "binary",
      "name": "sqfscat"
    }
  ],
  "install_guidance": {
    "plugin": "sqfscat",
    "binary": "sqfscat",
    "check": "which sqfscat",
    "install_steps": [
      "apt-get install sqfscat 2>/dev/null || which sqfscat",
      "Verify: sqfscat --version",
      "supercli plugins install ./plugins/sqfscat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sqfscat",
      "resource": "self",
      "action": "version",
      "description": "Print sqfscat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqfscat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sqfscat: apt-get install sqfscat 2>/dev/null || which sqfscat"
      },
      "args": []
    },
    {
      "namespace": "sqfscat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sqfscat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqfscat",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sqfscat: apt-get install sqfscat 2>/dev/null || which sqfscat"
      },
      "args": []
    }
  ]
}