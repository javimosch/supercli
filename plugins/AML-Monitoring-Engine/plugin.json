{
  "name": "AML-Monitoring-Engine",
  "version": "0.1.0",
  "description": "AML end to end system",
  "source": "https://github.com/AML-Monitoring-Engine/AML-Monitoring-Engine",
  "checks": [
    {
      "type": "binary",
      "name": "aml-monitoring-engine"
    }
  ],
  "install_guidance": {
    "plugin": "AML-Monitoring-Engine",
    "binary": "aml-monitoring-engine",
    "check": "which aml-monitoring-engine",
    "install_steps": [
      "pip install aml-monitoring-engine",
      "Verify: aml-monitoring-engine --version",
      "supercli plugins install ./plugins/AML-Monitoring-Engine --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AML-Monitoring-Engine",
      "resource": "self",
      "action": "version",
      "description": "Print AML-Monitoring-Engine version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aml-monitoring-engine",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AML-Monitoring-Engine: pip install aml-monitoring-engine"
      },
      "args": []
    },
    {
      "namespace": "AML-Monitoring-Engine",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aml-monitoring-engine CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aml-monitoring-engine",
        "passthrough": true,
        "missingDependencyHelp": "Install AML-Monitoring-Engine: pip install aml-monitoring-engine"
      },
      "args": []
    }
  ]
}