{
  "name": "gfold",
  "version": "0.1.0",
  "description": "Help keep track of your Git repositories, written in Rust",
  "source": "https://github.com/nickgerace/gfold",
  "checks": [
    {
      "type": "binary",
      "name": "gfold"
    }
  ],
  "install_guidance": {
    "plugin": "gfold",
    "binary": "gfold",
    "check": "which gfold",
    "install_steps": [
      "brew install gfold",
      "Verify: gfold --version",
      "supercli plugins install ./plugins/gfold --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gfold",
      "resource": "self",
      "action": "version",
      "description": "Print gfold version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gfold",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gfold: brew install gfold"
      },
      "args": []
    },
    {
      "namespace": "gfold",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gfold CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gfold",
        "passthrough": true,
        "missingDependencyHelp": "Install gfold"
      },
      "args": []
    }
  ]
}