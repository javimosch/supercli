{
  "name": "tifftopnm",
  "version": "0.1.0",
  "description": "CLI tool: tifftopnm",
  "source": "https://manpages.debian.org/tifftopnm",
  "checks": [
    {
      "type": "binary",
      "name": "tifftopnm"
    }
  ],
  "install_guidance": {
    "plugin": "tifftopnm",
    "binary": "tifftopnm",
    "check": "which tifftopnm",
    "install_steps": [
      "apt-get install tifftopnm 2>/dev/null || which tifftopnm",
      "Verify: tifftopnm --version",
      "supercli plugins install ./plugins/tifftopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tifftopnm",
      "resource": "self",
      "action": "version",
      "description": "Print tifftopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tifftopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tifftopnm: apt-get install tifftopnm 2>/dev/null || which tifftopnm"
      },
      "args": []
    },
    {
      "namespace": "tifftopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tifftopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tifftopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tifftopnm: apt-get install tifftopnm 2>/dev/null || which tifftopnm"
      },
      "args": []
    }
  ]
}