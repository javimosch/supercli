{
  "name": "repo-radar-cli",
  "version": "0.1.0",
  "description": "GitHub repo monitoring CLI — track stars, issues, and releases with JSON export",
  "source": "https://github.com/repo-radar/repo-radar-cli",
  "checks": [
    {
      "type": "binary",
      "name": "repo-radar"
    }
  ],
  "install_guidance": {
    "plugin": "repo-radar-cli",
    "binary": "repo-radar",
    "check": "which repo-radar",
    "install_steps": [
      "cargo install repo-radar-cli",
      "Verify: repo-radar --version",
      "supercli plugins install ./plugins/repo-radar-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "repo-radar-cli",
      "resource": "self",
      "action": "version",
      "description": "Print repo-radar-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "repo-radar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install repo-radar-cli: cargo install repo-radar-cli"
      },
      "args": []
    },
    {
      "namespace": "repo-radar-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to repo-radar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "repo-radar",
        "passthrough": true,
        "missingDependencyHelp": "Install repo-radar-cli: cargo install repo-radar-cli"
      },
      "args": []
    }
  ]
}
