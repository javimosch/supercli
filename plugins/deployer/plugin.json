{
  "name": "deployer",
  "version": "0.1.0",
  "description": "Deployment tool for PHP applications with zero downtime",
  "source": "composer",
  "checks": [{ "type": "binary", "name": "deployer" }],
  "install_guidance": {
    "plugin": "deployer",
    "binary": "deployer",
    "check": "which deployer",
    "install_steps": ["composer require deployer/deployer", "Verify: deployer --version", "supercli plugins install ./plugins/deployer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "deployer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to deployer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "deployer",
      "passthrough": true,
      "missingDependencyHelp": "Install deployer: composer require deployer/deployer"
    },
    "args": []
  }]
}
