{
  "name": "rcssmin",
  "version": "0.1.0",
  "description": "Fast CSS minifier with C-coded backend",
  "source": "https://github.com/ndparker/rcssmin",
  "checks": [{ "type": "binary", "name": "rcssmin" }],
  "install_guidance": {
    "plugin": "rcssmin",
    "binary": "rcssmin",
    "check": "which rcssmin",
    "install_steps": ["pip install rcssmin", "Verify: rcssmin --version", "supercli plugins install ./plugins/rcssmin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rcssmin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rcssmin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rcssmin",
      "passthrough": true,
      "missingDependencyHelp": "Install rcssmin: pip install rcssmin", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
