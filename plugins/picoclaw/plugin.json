{
  "name": "picoclaw",
  "version": "0.1.0",
  "description": "Tiny, Fast, and Deployable anywhere \u2014 automate the mundane, unleash your creativity",
  "source": "https://github.com/picoclaw/picoclaw",
  "checks": [
    {
      "type": "binary",
      "name": "picoclaw"
    }
  ],
  "install_guidance": {
    "plugin": "picoclaw",
    "binary": "picoclaw",
    "check": "which picoclaw",
    "install_steps": [
      "pip install picoclaw",
      "Verify: picoclaw --version",
      "supercli plugins install ./plugins/picoclaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "picoclaw",
      "resource": "self",
      "action": "version",
      "description": "Print picoclaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "picoclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install picoclaw: pip install picoclaw"
      },
      "args": []
    },
    {
      "namespace": "picoclaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to picoclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "picoclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install picoclaw: pip install picoclaw"
      },
      "args": []
    }
  ]
}