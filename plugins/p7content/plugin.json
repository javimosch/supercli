{
  "name": "p7content",
  "version": "0.1.0",
  "description": "CLI tool: p7content",
  "source": "https://manpages.debian.org/p7content",
  "checks": [
    {
      "type": "binary",
      "name": "p7content"
    }
  ],
  "install_guidance": {
    "plugin": "p7content",
    "binary": "p7content",
    "check": "which p7content",
    "install_steps": [
      "apt-get install p7content 2>/dev/null || which p7content",
      "Verify: p7content --version",
      "supercli plugins install ./plugins/p7content --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "p7content",
      "resource": "self",
      "action": "version",
      "description": "Print p7content version",
      "adapter": "process",
      "adapterConfig": {
        "command": "p7content",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install p7content: apt-get install p7content 2>/dev/null || which p7content"
      },
      "args": []
    },
    {
      "namespace": "p7content",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to p7content CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "p7content",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install p7content: apt-get install p7content 2>/dev/null || which p7content"
      },
      "args": []
    }
  ]
}