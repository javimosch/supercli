{
  "name": "systeroid",
  "version": "0.1.0",
  "description": "Query and set sysctl parameters from the CLI",
  "source": "https://github.com/orhun/systeroid",
  "checks": [{ "type": "binary", "name": "systeroid" }],
  "install_guidance": {
    "plugin": "systeroid",
    "binary": "systeroid",
    "check": "which systeroid",
    "install_steps": ["cargo install systeroid", "Verify: systeroid --version", "supercli plugins install ./plugins/systeroid --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "systeroid",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to systeroid CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "systeroid",
      "passthrough": true,
      "missingDependencyHelp": "Install systeroid: cargo install systeroid"
    },
    "args": []
  }]
}
