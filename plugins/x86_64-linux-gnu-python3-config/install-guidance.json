{
  "plugin": "x86_64-linux-gnu-python3-config",
  "binary": "x86_64-linux-gnu-python3-config",
  "check": "which x86_64-linux-gnu-python3-config",
  "install_steps": [
    "apt-get install libpython3-dev 2>/dev/null || which x86_64-linux-gnu-python3-config",
    "Verify: x86_64-linux-gnu-python3-config --version",
    "supercli plugins install ./plugins/x86_64-linux-gnu-python3-config --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}