{
  "name": "loimpress",
  "version": "0.1.0",
  "description": "CLI tool: loimpress",
  "source": "https://manpages.debian.org/loimpress",
  "checks": [
    {
      "type": "binary",
      "name": "loimpress"
    }
  ],
  "install_guidance": {
    "plugin": "loimpress",
    "binary": "loimpress",
    "check": "which loimpress",
    "install_steps": [
      "apt-get install loimpress 2>/dev/null || which loimpress",
      "Verify: loimpress --version",
      "supercli plugins install ./plugins/loimpress --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "loimpress",
      "resource": "self",
      "action": "version",
      "description": "Print loimpress version",
      "adapter": "process",
      "adapterConfig": {
        "command": "loimpress",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install loimpress: apt-get install loimpress 2>/dev/null || which loimpress"
      },
      "args": []
    },
    {
      "namespace": "loimpress",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to loimpress CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "loimpress",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install loimpress: apt-get install loimpress 2>/dev/null || which loimpress"
      },
      "args": []
    }
  ]
}