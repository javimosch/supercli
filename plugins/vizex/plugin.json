{
  "name": "vizex",
  "version": "0.1.0",
  "description": "Visualize the disk space usage for every partition and media on the user's machine.",
  "source": "https://github.com/bexxmodd/vizex",
  "checks": [
    {
      "type": "binary",
      "name": "vizex"
    }
  ],
  "install_guidance": {
    "plugin": "vizex",
    "binary": "vizex",
    "check": "which vizex",
    "install_steps": [
      "See https://github.com/bexxmodd/vizex",
      "Verify: vizex --version",
      "supercli plugins install ./plugins/vizex --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "vizex",
      "resource": "self",
      "action": "version",
      "description": "Print vizex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vizex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vizex: See https://github.com/bexxmodd/vizex"
      },
      "args": []
    },
    {
      "namespace": "vizex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vizex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vizex",
        "passthrough": true,
        "missingDependencyHelp": "Install vizex"
      },
      "args": []
    }
  ]
}