{
  "name": "at-log",
  "version": "0.1.0",
  "description": "CLI tool: at-log",
  "source": "https://packages.debian.org/at-log",
  "checks": [{ "type": "binary", "name": "at-log" }],
  "install_guidance": {
    "plugin": "at-log", "binary": "at-log", "check": "which at-log",
    "install_steps": ["apt-get install at-log 2>/dev/null || which at-log", "Verify: at-log --version", "supercli plugins install ./plugins/at-log --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-log", "resource": "_", "action": "_",
    "description": "Passthrough to at-log CLI",
    "adapter": "process", "adapterConfig": { "command": "at-log", "passthrough": true, "missingDependencyHelp": "Install at-log: apt-get install at-log" }, "args": []
  }]
}
