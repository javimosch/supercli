{
  "name": "scspell",
  "version": "0.1.0",
  "description": "Source code spell checker with custom dictionaries",
  "source": "https://github.com/myint/scspell",
  "checks": [{ "type": "binary", "name": "scspell" }],
  "install_guidance": {
    "plugin": "scspell",
    "binary": "scspell",
    "check": "which scspell",
    "install_steps": ["pip install scspell3k", "Verify: scspell --version", "supercli plugins install ./plugins/scspell --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "scspell",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to scspell CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "scspell",
      "passthrough": true,
      "missingDependencyHelp": "Install scspell: pip install scspell3k", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
