{
  "name": "yu-ai-agent",
  "version": "0.1.0",
  "description": "\u7f16\u7a0b\u5bfc\u822a 2025 \u5e74 AI \u5f00\u53d1\u5b9e\u6218\u65b0\u9879\u76ee\uff0c\u57fa\u4e8e Spring Boot 3 + Java 21 + Spring AI \u6784\u5efa AI \u604b\u7231\u5927\u5e08\u5e94\u7528\u548c ReAct \u6a21\u5f0f\u81ea\u4e3b\u89c4\u5212\u667a\u80fd\u4f53YuManus\uff0c\u8986",
  "source": "https://github.com/yu-ai-agent/yu-ai-agent",
  "checks": [
    {
      "type": "binary",
      "name": "yu-ai-agent"
    }
  ],
  "install_guidance": {
    "plugin": "yu-ai-agent",
    "binary": "yu-ai-agent",
    "check": "which yu-ai-agent",
    "install_steps": [
      "pip install yu-ai-agent",
      "Verify: yu-ai-agent --version",
      "supercli plugins install ./plugins/yu-ai-agent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yu-ai-agent",
      "resource": "self",
      "action": "version",
      "description": "Print yu-ai-agent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yu-ai-agent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yu-ai-agent: pip install yu-ai-agent"
      },
      "args": []
    },
    {
      "namespace": "yu-ai-agent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yu-ai-agent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yu-ai-agent",
        "passthrough": true,
        "missingDependencyHelp": "Install yu-ai-agent: pip install yu-ai-agent"
      },
      "args": []
    }
  ]
}