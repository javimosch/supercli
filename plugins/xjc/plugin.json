{
  "name": "xjc",
  "version": "0.1.0",
  "description": "CLI tool: xjc",
  "source": "https://manpages.debian.org/xjc",
  "checks": [
    {
      "type": "binary",
      "name": "xjc"
    }
  ],
  "install_guidance": {
    "plugin": "xjc",
    "binary": "xjc",
    "check": "which xjc",
    "install_steps": [
      "apt-get install xjc 2>/dev/null || which xjc",
      "Verify: xjc --version",
      "supercli plugins install ./plugins/xjc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xjc",
      "resource": "self",
      "action": "version",
      "description": "Print xjc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xjc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xjc: apt-get install xjc 2>/dev/null || which xjc"
      },
      "args": []
    },
    {
      "namespace": "xjc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xjc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xjc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xjc: apt-get install xjc 2>/dev/null || which xjc"
      },
      "args": []
    }
  ]
}