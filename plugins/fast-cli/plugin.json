{
  "name": "fast-cli",
  "version": "0.1.0",
  "description": "Speed Test CLI",
  "source": "https://github.com/mikkelam/fast-cli",
  "checks": [
    { "type": "binary", "name": "fast-cli" }
  ],
  "install_guidance": {
    "plugin": "fast-cli",
    "binary": "fast-cli",
    "check": "which fast-cli",
    "install_steps": [
      "curl -sSL https://raw.githubusercontent.com/mikkelam/fast-cli/main/install.sh | bash",
      "Verify: fast-cli --version",
      "supercli plugins install ./plugins/fast-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fast-cli",
      "resource": "self",
      "action": "version",
      "description": "Print fast-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fast-cli",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install fast-cli: curl -sSL https://raw.githubusercontent.com/mikkelam/fast-cli/main/install.sh | bash"
      },
      "args": []
    },
    {
      "namespace": "fast-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fast-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fast-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install fast-cli"
      },
      "args": []
    }
  ]
}
