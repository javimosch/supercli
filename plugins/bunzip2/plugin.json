{
  "name": "bunzip2",
  "version": "1.0.0",
  "description": "bunzip2 \u2014 CLI bunzip2 \u2014 Command-line utility for system administration",
  "source": "https://github.com/search?q=bunzip2+cli",
  "checks": [
    {
      "type": "binary",
      "name": "bunzip2"
    }
