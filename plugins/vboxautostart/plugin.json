{
  "name": "vboxautostart",
  "version": "0.1.0",
  "description": "CLI tool: vboxautostart",
  "source": "https://manpages.debian.org/vboxautostart",
  "checks": [
    {
      "type": "binary",
      "name": "vboxautostart"
    }
  ],
  "install_guidance": {
    "plugin": "vboxautostart",
    "binary": "vboxautostart",
    "check": "which vboxautostart",
    "install_steps": [
      "apt-get install vboxautostart 2>/dev/null || which vboxautostart",
      "Verify: vboxautostart --version",
      "supercli plugins install ./plugins/vboxautostart --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vboxautostart",
      "resource": "self",
      "action": "version",
      "description": "Print vboxautostart version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vboxautostart",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vboxautostart: apt-get install vboxautostart 2>/dev/null || which vboxautostart"
      },
      "args": []
    },
    {
      "namespace": "vboxautostart",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vboxautostart CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vboxautostart",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vboxautostart: apt-get install vboxautostart 2>/dev/null || which vboxautostart"
      },
      "args": []
    }
  ]
}