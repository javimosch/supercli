{
  "name": "ppmtoleaf",
  "version": "0.1.0",
  "description": "CLI tool: ppmtoleaf",
  "source": "https://manpages.debian.org/ppmtoleaf",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtoleaf"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtoleaf",
    "binary": "ppmtoleaf",
    "check": "which ppmtoleaf",
    "install_steps": [
      "apt-get install ppmtoleaf 2>/dev/null || which ppmtoleaf",
      "Verify: ppmtoleaf --version",
      "supercli plugins install ./plugins/ppmtoleaf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtoleaf",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtoleaf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoleaf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtoleaf: apt-get install ppmtoleaf 2>/dev/null || which ppmtoleaf"
      },
      "args": []
    },
    {
      "namespace": "ppmtoleaf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtoleaf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoleaf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtoleaf: apt-get install ppmtoleaf 2>/dev/null || which ppmtoleaf"
      },
      "args": []
    }
  ]
}