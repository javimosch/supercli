{
  "name": "g3topbm",
  "version": "0.1.0",
  "description": "CLI tool: g3topbm",
  "source": "https://manpages.debian.org/g3topbm",
  "checks": [
    {
      "type": "binary",
      "name": "g3topbm"
    }
  ],
  "install_guidance": {
    "plugin": "g3topbm",
    "binary": "g3topbm",
    "check": "which g3topbm",
    "install_steps": [
      "apt-get install g3topbm 2>/dev/null || which g3topbm",
      "Verify: g3topbm --version",
      "supercli plugins install ./plugins/g3topbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "g3topbm",
      "resource": "self",
      "action": "version",
      "description": "Print g3topbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "g3topbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install g3topbm: apt-get install g3topbm 2>/dev/null || which g3topbm"
      },
      "args": []
    },
    {
      "namespace": "g3topbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to g3topbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "g3topbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install g3topbm: apt-get install g3topbm 2>/dev/null || which g3topbm"
      },
      "args": []
    }
  ]
}