{
  "name": "paste-click",
  "version": "0.1.0",
  "description": "Paste text, images, video or any file",
  "source": "http://paste.click",
  "checks": [
    {
      "type": "binary",
      "name": "paste-click"
    }
  ],
  "install_guidance": {
    "plugin": "paste-click",
    "binary": "paste-click",
    "check": "which paste-click",
    "install_steps": [
      "Check http://paste.click for installation instructions",
      "Verify: paste-click --version",
      "supercli plugins install ./plugins/paste-click --on-conflict replace --json"
    ],
    "note": "CSS language CLI tool"
  },
  "commands": [
    {
      "namespace": "paste-click",
      "resource": "self",
      "action": "version",
      "description": "Print paste-click version",
      "adapter": "process",
      "adapterConfig": {
        "command": "paste-click",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install paste-click from project repository"
      },
      "args": []
    },
    {
      "namespace": "paste-click",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to paste-click CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "paste-click",
        "passthrough": true,
        "missingDependencyHelp": "Install paste-click from project repository"
      },
      "args": []
    }
  ]
}