{
  "name": "android-reverse-engineering-skill",
  "version": "0.1.0",
  "description": "Claude Code skill to support Android app's reverse engineering",
  "source": "https://github.com/android-reverse-engineering-skill/android-reverse-engineering-skill",
  "checks": [
    {
      "type": "binary",
      "name": "android-reverse-engineering-skill"
    }
  ],
  "install_guidance": {
    "plugin": "android-reverse-engineering-skill",
    "binary": "android-reverse-engineering-skill",
    "check": "which android-reverse-engineering-skill",
    "install_steps": [
      "pip install android-reverse-engineering-skill",
      "Verify: android-reverse-engineering-skill --version",
      "supercli plugins install ./plugins/android-reverse-engineering-skill --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "android-reverse-engineering-skill",
      "resource": "self",
      "action": "version",
      "description": "Print android-reverse-engineering-skill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "android-reverse-engineering-skill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install android-reverse-engineering-skill: pip install android-reverse-engineering-skill"
      },
      "args": []
    },
    {
      "namespace": "android-reverse-engineering-skill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to android-reverse-engineering-skill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "android-reverse-engineering-skill",
        "passthrough": true,
        "missingDependencyHelp": "Install android-reverse-engineering-skill: pip install android-reverse-engineering-skill"
      },
      "args": []
    }
  ]
}