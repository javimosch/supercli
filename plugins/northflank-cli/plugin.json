{
  "name": "northflank-cli",
  "version": "0.1.0",
  "description": "Northflank platform CLI for deployments",
  "source": "https",
  "checks": [{"type": "binary", "name": "northflank"}],
  "install_guidance": {
    "plugin": "northflank-cli",
    "binary": "northflank",
    "check": "which northflank",
    "install_steps": [
      "brew install northflank",
      "Verify: northflank --version",
      "supercli plugins install ./plugins/northflank-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "northflank-cli",
      "resource": "self",
      "action": "version",
      "description": "Print northflank-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "northflank", "baseArgs": ["--version"], "missingDependencyHelp": "Install northflank-cli: brew install northflank"},
      "args": []
    },
    {
      "namespace": "northflank-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to northflank CLI",
      "adapter": "process",
      "adapterConfig": {"command": "northflank", "passthrough": true, "missingDependencyHelp": "Install northflank-cli: brew install northflank"},
      "args": []
    }
  ]
}
