{
  "name": "clickhouse-php-client",
  "version": "0.1.0",
  "description": "PHP Driver for ClickHouse columnar DBMS https://clickhouse.yandex",
  "source": "https://github.com/clickhouse-php-client/clickhouse-php-client",
  "checks": [
    {
      "type": "binary",
      "name": "clickhouse-php-client"
    }
  ],
  "install_guidance": {
    "plugin": "clickhouse-php-client",
    "binary": "clickhouse-php-client",
    "check": "which clickhouse-php-client",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: clickhouse-php-client --version",
      "supercli plugins install ./plugins/clickhouse-php-client --on-conflict replace --json"
    ],
    "note": "PHP language CLI tool"
  },
  "commands": [
    {
      "namespace": "clickhouse-php-client",
      "resource": "self",
      "action": "version",
      "description": "Print clickhouse-php-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clickhouse-php-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clickhouse-php-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "clickhouse-php-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clickhouse-php-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clickhouse-php-client",
        "passthrough": true,
        "missingDependencyHelp": "Install clickhouse-php-client from project repository"
      },
      "args": []
    }
  ]
}