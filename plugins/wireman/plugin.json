{
  "name": "wireman",
  "version": "0.1.0",
  "description": "WireGuard configuration manager from the CLI",
  "source": "https://github.com/nicknisi/wireman",
  "checks": [{ "type": "binary", "name": "wireman" }],
  "install_guidance": {
    "plugin": "wireman",
    "binary": "wireman",
    "check": "which wireman",
    "install_steps": ["cargo install wireman", "Verify: wireman --version", "supercli plugins install ./plugins/wireman --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wireman",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wireman CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wireman",
      "passthrough": true,
      "missingDependencyHelp": "Install wireman: cargo install wireman"
    },
    "args": []
  }]
}
