{
  "name": "at_config",
  "version": "0.1.0",
  "description": "CLI tool: at_config",
  "source": "https://packages.debian.org/at_config",
  "checks": [{ "type": "binary", "name": "at_config" }],
  "install_guidance": {
    "plugin": "at_config", "binary": "at_config", "check": "which at_config",
    "install_steps": ["apt-get install at_config 2>/dev/null || which at_config", "Verify: at_config --version", "supercli plugins install ./plugins/at_config --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_config", "resource": "_", "action": "_",
    "description": "Passthrough to at_config CLI",
    "adapter": "process", "adapterConfig": { "command": "at_config", "passthrough": true, "missingDependencyHelp": "Install at_config: apt-get install at_config" }, "args": []
  }]
}
