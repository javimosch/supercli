{
  "name": "app-manifest-cli",
  "version": "0.1.0",
  "description": "Manipulate Android and iOS app manifest files via CLI",
  "source": "https://github.com/MitchTalmadge/Emoji-Tools",
  "checks": [{ "type": "binary", "name": "app-manifest-cli" }],
  "install_guidance": {
    "plugin": "app-manifest-cli",
    "binary": "app-manifest-cli",
    "check": "which app-manifest-cli",
    "install_steps": ["npm install -g app-manifest-cli", "Verify: app-manifest-cli --version", "supercli plugins install ./plugins/app-manifest-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "app-manifest-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to app-manifest-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "app-manifest-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install app-manifest-cli: npm install -g app-manifest-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
