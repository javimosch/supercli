{
  "name": "updvitomp",
  "version": "0.1.0",
  "description": "CLI tool: updvitomp",
  "source": "https://manpages.debian.org/updvitomp",
  "checks": [
    {
      "type": "binary",
      "name": "updvitomp"
    }
  ],
  "install_guidance": {
    "plugin": "updvitomp",
    "binary": "updvitomp",
    "check": "which updvitomp",
    "install_steps": [
      "apt-get install updvitomp 2>/dev/null || which updvitomp",
      "Verify: updvitomp --version",
      "supercli plugins install ./plugins/updvitomp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "updvitomp",
      "resource": "self",
      "action": "version",
      "description": "Print updvitomp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "updvitomp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install updvitomp: apt-get install updvitomp 2>/dev/null || which updvitomp"
      },
      "args": []
    },
    {
      "namespace": "updvitomp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to updvitomp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "updvitomp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install updvitomp: apt-get install updvitomp 2>/dev/null || which updvitomp"
      },
      "args": []
    }
  ]
}