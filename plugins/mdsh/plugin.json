{
  "name": "mdsh",
  "version": "0.1.0",
  "description": "Run shell commands embedded in Markdown files",
  "source": "https://github.com/bashup/mdsh",
  "checks": [{ "type": "binary", "name": "mdsh" }],
  "install_guidance": {
    "plugin": "mdsh",
    "binary": "mdsh",
    "check": "which mdsh",
    "install_steps": ["cargo install mdsh", "Verify: mdsh --version", "supercli plugins install ./plugins/mdsh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdsh",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdsh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdsh",
      "passthrough": true,
      "missingDependencyHelp": "Install mdsh: cargo install mdsh", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
