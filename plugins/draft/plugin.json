{
  "name": "draft",
  "version": "1.0.0",
  "description": "draft \u2014 Kubernetes app generator",
  "source": "github.com/Azure/draft",
  "checks": [
    {
      "type": "binary",
      "name": "draft"
    }
  ],
  "install_guidance": {
    "plugin": "draft",
    "binary": "draft",
    "check": "which draft",
    "install_steps": [
      "# Install draft",
      "# See github.com/Azure/draft",
      "# apt: sudo apt-get install draft",
      "# brew: brew install draft",
      "# cargo: cargo install draft",
      "# npm: npm install -g draft",
      "# pip: pip install draft"
    ]
  },
  "commands": [
    {
      "namespace": "draft",
      "resource": "draft",
      "action": "run",
      "description": "Run draft",
      "adapter": "process",
      "adapterConfig": {
        "command": "draft",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install draft from github.com/Azure/draft"
      },
      "args": []
    }
  ]
}