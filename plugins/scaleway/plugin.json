{
  "name": "scaleway",
  "version": "0.1.0",
  "description": "Scaleway CLI — command-line tool for Scaleway cloud",
  "source": "https://github.com/scaleway/scaleway-cli",
  "checks": [
    {
      "type": "binary",
      "name": "scw"
    }
  ],
  "install_guidance": {
    "plugin": "scaleway",
    "binary": "scw",
    "check": "which scw",
    "install_steps": [
      "brew install scw",
      "Verify: scw --version",
      "supercli plugins install ./plugins/scaleway --on-conflict replace --json"
    ],
    "note": "The Scaleway CLI binary is `scw`."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "scaleway",
      "resource": "self",
      "action": "version",
      "description": "Print scaleway version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scw",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install scaleway: brew install scw"
      },
      "args": []
    },
    {
      "namespace": "scaleway",
      "resource": "cli",
      "action": "run",
      "description": "Scaleway CLI — command-line tool for Scaleway cloud",
      "adapter": "process",
      "adapterConfig": {
        "command": "scw",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install scaleway: brew install scw"
      },
      "args": []
    }
  ]
}
