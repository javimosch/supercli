{
  "name": "ghc",
  "version": "0.1.0",
  "description": "GHC — Glasgow Haskell Compiler for compiling Haskell programs",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "ghc"
    }
  ],
  "install_guidance": {
    "plugin": "ghc",
