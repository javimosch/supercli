{
  "name": "ppm3d",
  "version": "0.1.0",
  "description": "CLI tool: ppm3d",
  "source": "https://manpages.debian.org/ppm3d",
  "checks": [
    {
      "type": "binary",
      "name": "ppm3d"
    }
  ],
  "install_guidance": {
    "plugin": "ppm3d",
    "binary": "ppm3d",
    "check": "which ppm3d",
    "install_steps": [
      "apt-get install ppm3d 2>/dev/null || which ppm3d",
      "Verify: ppm3d --version",
      "supercli plugins install ./plugins/ppm3d --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppm3d",
      "resource": "self",
      "action": "version",
      "description": "Print ppm3d version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppm3d",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppm3d: apt-get install ppm3d 2>/dev/null || which ppm3d"
      },
      "args": []
    },
    {
      "namespace": "ppm3d",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppm3d CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppm3d",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppm3d: apt-get install ppm3d 2>/dev/null || which ppm3d"
      },
      "args": []
    }
  ]
}