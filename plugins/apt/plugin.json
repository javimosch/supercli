{
  "name": "apt",
  "version": "1.0.0",
  "description": "apt \u2014 CLI apt \u2014 Command-line utility for system administration",
  "source": "https://github.com/search?q=apt+cli",
  "checks": [
    {
      "type": "binary",
      "name": "apt"
    }
  ],
  "install_guidance": {
    "plugin": "apt",
    "binary": "apt",
    "check": "which apt",
    "install_steps": [
      "Install via package manager: apt install apt or brew install apt"
    ]
  },
  "commands": [
    {
      "namespace": "apt",
      "resource": "run",
      "action": "exec",
      "description": "apt \u2014 Command-line utility for system administration",
      "adapter": "process",
      "adapterConfig": {
        "command": "apt",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install apt via package manager"
      },
      "args": []
    }
  ]
}