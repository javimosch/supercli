{
  "name": "kanata",
  "version": "0.1.0",
  "description": "An advanced keyboard remapping and macro tool for Linux. Configures complex key bindings, layers, and macros for custom keyboard layouts.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "kanata"
    }
  ],
  "install_guidance": {
    "plugin": "kanata",
    "binary": "kanata",
    "check": "which kanata",
    "install_steps": [
      "cargo install kanata",
      "Verify: kanata --version",
      "supercli plugins install ./plugins/kanata --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kanata",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kanata CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kanata",
        "passthrough": true,
        "missingDependencyHelp": "Install kanata: cargo install kanata"
      },
      "args": []
    }
  ]
}
