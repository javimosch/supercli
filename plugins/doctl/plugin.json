{
  "name": "doctl",
  "version": "0.1.0",
  "description": "doctl — DigitalOcean CLI for managing cloud resources",
  "source": "https://github.com/digitalocean/doctl",
  "checks": [
    {
      "type": "binary",
      "name": "doctl"
    }
  ],
  "install_guidance": {
    "plugin": "doctl",
    "binary": "doctl",
    "check": "which doctl",
    "install_steps": [
      "brew install doctl",
      "Verify: doctl --version",
      "supercli plugins install ./plugins/doctl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "doctl",
      "resource": "self",
      "action": "version",
      "description": "Print doctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doctl",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install doctl: brew install doctl"
      },
      "args": []
    },
    {
      "namespace": "doctl",
      "resource": "cli",
      "action": "run",
      "description": "doctl — DigitalOcean CLI for managing cloud resources",
      "adapter": "process",
      "adapterConfig": {
        "command": "doctl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doctl: brew install doctl"
      },
      "args": []
    }
  ]
}
