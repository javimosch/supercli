{
  "name": "env_parallel.ash",
  "version": "0.1.0",
  "description": "CLI tool: env_parallel.ash",
  "source": "https://manpages.debian.org/env_parallel.ash",
  "checks": [
    {
      "type": "binary",
      "name": "env_parallel.ash"
    }
  ],
  "install_guidance": {
    "plugin": "env_parallel.ash",
    "binary": "env_parallel.ash",
    "check": "which env_parallel.ash",
    "install_steps": [
      "apt-get install env_parallel.ash 2>/dev/null || which env_parallel.ash",
      "Verify: env_parallel.ash --version",
      "supercli plugins install ./plugins/env_parallel.ash --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "env_parallel.ash",
      "resource": "self",
      "action": "version",
      "description": "Print env_parallel.ash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "env_parallel.ash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install env_parallel.ash: apt-get install env_parallel.ash 2>/dev/null || which env_parallel.ash"
      },
      "args": []
    },
    {
      "namespace": "env_parallel.ash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to env_parallel.ash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "env_parallel.ash",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install env_parallel.ash: apt-get install env_parallel.ash 2>/dev/null || which env_parallel.ash"
      },
      "args": []
    }
  ]
}