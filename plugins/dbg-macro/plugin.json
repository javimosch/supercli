{
  "name": "dbg-macro",
  "version": "0.1.0",
  "description": "Dbg(…) macro for C++",
  "source": "https://github.com/sharkdp/dbg-macro",
  "checks": [
    {
      "type": "binary",
      "name": "dbg-macro"
    }
  ],
  "install_guidance": {
    "plugin": "dbg-macro",
    "binary": "dbg-macro",
    "check": "which dbg-macro",
    "install_steps": [
      "brew install dbg-macro",
      "Verify: dbg-macro --version",
      "supercli plugins install ./plugins/dbg-macro --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dbg-macro",
      "resource": "self",
      "action": "version",
      "description": "Print dbg-macro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbg-macro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dbg-macro: brew install dbg-macro"
      },
      "args": []
    },
    {
      "namespace": "dbg-macro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dbg-macro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbg-macro",
        "passthrough": true,
        "missingDependencyHelp": "Install dbg-macro"
      },
      "args": []
    }
  ]
}