{
  "name": "cargo-make",
  "version": "1.0.0",
  "description": "cargo-make \u2014 Rust task runner and build automation. Define complex build workflows in Makefile.toml. Non-interactive.",
  "source": "https://github.com/sagiegurari/cargo-make",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-make"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-make",
    "binary": "cargo-make",
    "check": "cargo-make --version",
    "install_steps": [
      "curl -LO https://github.com/sagiegurari/cargo-make/releases/download/0.37.24/cargo-make-v0.37.24-x86_64-unknown-linux-gnu.zip && unzip -o cargo-make-v0.37.24-x86_64-unknown-linux-gnu.zip && sudo mv cargo-make-v0.37.24-x86_64-unknown-linux-gnu/cargo-make /usr/local/bin/ && rm -rf cargo-make-v0.37.24-x86_64-unknown-linux-gnu*"
    ],
    "note": "Binary from GitHub releases."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo",
      "resource": "make",
      "action": "run",
      "description": "cargo-make \u2014 Rust task runner and build automation. Define complex build workflows in Makefile.toml. Non-interactive.",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-make",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install from https://github.com/sagiegurari/cargo-make"
      },
      "args": []
    }
  ]
}