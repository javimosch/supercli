{
  "plugin": "cargo-make",
  "binary": "cargo-make",
  "check": "cargo-make --version",
  "install_steps": [
    "curl -LO https://github.com/sagiegurari/cargo-make/releases/download/0.37.24/cargo-make-v0.37.24-x86_64-unknown-linux-gnu.zip && unzip -o cargo-make-v0.37.24-x86_64-unknown-linux-gnu.zip && sudo mv cargo-make-v0.37.24-x86_64-unknown-linux-gnu/cargo-make /usr/local/bin/ && rm -rf cargo-make-v0.37.24-x86_64-unknown-linux-gnu*"
  ]
}