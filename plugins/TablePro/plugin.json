{
  "name": "TablePro",
  "version": "0.1.0",
  "description": "Free and open source database client built natively for developers",
  "source": "https://github.com/TablePro/TablePro",
  "checks": [
    {
      "type": "binary",
      "name": "tablepro"
    }
  ],
  "install_guidance": {
    "plugin": "TablePro",
    "binary": "tablepro",
    "check": "which tablepro",
    "install_steps": [
      "pip install tablepro",
      "Verify: tablepro --version",
      "supercli plugins install ./plugins/TablePro --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TablePro",
      "resource": "self",
      "action": "version",
      "description": "Print TablePro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tablepro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TablePro: pip install tablepro"
      },
      "args": []
    },
    {
      "namespace": "TablePro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tablepro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tablepro",
        "passthrough": true,
        "missingDependencyHelp": "Install TablePro: pip install tablepro"
      },
      "args": []
    }
  ]
}