{
  "name": "gdk-pixbuf-thumbnailer",
  "version": "0.1.0",
  "description": "CLI tool: gdk-pixbuf-thumbnailer",
  "source": "https://manpages.debian.org/gdk-pixbuf-thumbnailer",
  "checks": [
    {
      "type": "binary",
      "name": "gdk-pixbuf-thumbnailer"
    }
  ],
  "install_guidance": {
    "plugin": "gdk-pixbuf-thumbnailer",
    "binary": "gdk-pixbuf-thumbnailer",
    "check": "which gdk-pixbuf-thumbnailer",
    "install_steps": [
      "apt-get install gdk-pixbuf-thumbnailer 2>/dev/null || which gdk-pixbuf-thumbnailer",
      "Verify: gdk-pixbuf-thumbnailer --version",
      "supercli plugins install ./plugins/gdk-pixbuf-thumbnailer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdk-pixbuf-thumbnailer",
      "resource": "self",
      "action": "version",
      "description": "Print gdk-pixbuf-thumbnailer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdk-pixbuf-thumbnailer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdk-pixbuf-thumbnailer: apt-get install gdk-pixbuf-thumbnailer 2>/dev/null || which gdk-pixbuf-thumbnailer"
      },
      "args": []
    },
    {
      "namespace": "gdk-pixbuf-thumbnailer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdk-pixbuf-thumbnailer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdk-pixbuf-thumbnailer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gdk-pixbuf-thumbnailer: apt-get install gdk-pixbuf-thumbnailer 2>/dev/null || which gdk-pixbuf-thumbnailer"
      },
      "args": []
    }
  ]
}