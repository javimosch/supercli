{
  "name": "jmxtrans",
  "version": "0.1.0",
  "description": "Tool to connect to JVMs and query their attributes",
  "source": "https://github.com/jmxtrans/jmxtrans",
  "checks": [
    {
      "type": "binary",
      "name": "jmxtrans"
    }
  ],
  "install_guidance": {
    "plugin": "jmxtrans",
    "binary": "jmxtrans",
    "check": "which jmxtrans",
    "install_steps": [
      "brew install jmxtrans",
      "Verify: jmxtrans --version",
      "supercli plugins install ./plugins/jmxtrans --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jmxtrans",
      "resource": "self",
      "action": "version",
      "description": "Print jmxtrans version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jmxtrans",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jmxtrans: brew install jmxtrans"
      },
      "args": []
    },
    {
      "namespace": "jmxtrans",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jmxtrans CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jmxtrans",
        "passthrough": true,
        "missingDependencyHelp": "Install jmxtrans"
      },
      "args": []
    }
  ]
}