{
  "name": "k8sgpt",
  "version": "0.1.0",
  "description": "Giving Kubernetes Superpowers to everyone",
  "source": "https://github.com/k8sgpt/k8sgpt",
  "checks": [
    {
      "type": "binary",
      "name": "k8sgpt"
    }
  ],
  "install_guidance": {
    "plugin": "k8sgpt",
    "binary": "k8sgpt",
    "check": "which k8sgpt",
    "install_steps": [
      "pip install k8sgpt",
      "Verify: k8sgpt --version",
      "supercli plugins install ./plugins/k8sgpt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "k8sgpt",
      "resource": "self",
      "action": "version",
      "description": "Print k8sgpt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "k8sgpt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install k8sgpt: pip install k8sgpt"
      },
      "args": []
    },
    {
      "namespace": "k8sgpt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to k8sgpt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "k8sgpt",
        "passthrough": true,
        "missingDependencyHelp": "Install k8sgpt: pip install k8sgpt"
      },
      "args": []
    }
  ]
}