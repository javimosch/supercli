{
  "name": "llama-cpp",
  "version": "0.1.0",
  "description": "Inference of LLM models in pure C++ with CLI",
  "source": "https://github.com/ggerganov/llama.cpp",
  "checks": [{ "type": "binary", "name": "llama-cpp" }],
  "install_guidance": {
    "plugin": "llama-cpp",
    "binary": "llama-cpp",
    "check": "which llama-cpp",
    "install_steps": ["brew install llama.cpp", "Verify: llama-cpp --version", "supercli plugins install ./plugins/llama-cpp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "llama-cpp",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to llama-cpp CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "llama-cpp",
      "passthrough": true,
      "missingDependencyHelp": "Install llama-cpp: brew install llama.cpp", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
