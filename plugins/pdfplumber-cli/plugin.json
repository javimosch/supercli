{
  "name": "pdfplumber-cli",
  "version": "0.1.0",
  "description": "Extract tables and text from PDFs with precise layout",
  "source": "https://github.com/jsvine/pdfplumber",
  "checks": [{ "type": "binary", "name": "pdfplumber-cli" }],
  "install_guidance": {
    "plugin": "pdfplumber-cli",
    "binary": "pdfplumber-cli",
    "check": "which pdfplumber-cli",
    "install_steps": ["pip install pdfplumber", "Verify: pdfplumber-cli --version", "supercli plugins install ./plugins/pdfplumber-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdfplumber-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdfplumber-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdfplumber-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install pdfplumber-cli: pip install pdfplumber", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
