{
  "name": "dee-openrouter",
  "version": "0.1.0",
  "description": "Compare LLM model pricing and capabilities with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-openrouter" }],
  "install_guidance": {
    "plugin": "dee-openrouter",
    "binary": "dee-openrouter",
    "check": "which dee-openrouter",
    "install_steps": ["cargo install dee-openrouter", "Verify: dee-openrouter --version", "supercli plugins install ./plugins/dee-openrouter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-openrouter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-openrouter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-openrouter",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-openrouter: cargo install dee-openrouter"
    },
    "args": []
  }]
}
