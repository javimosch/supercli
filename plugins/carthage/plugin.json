{
  "name": "carthage",
  "version": "0.1.0",
  "description": "Decentralized dependency manager for Cocoa",
  "source": "https://github.com/Carthage/Carthage",
  "checks": [
    {
      "type": "binary",
      "name": "carthage"
    }
  ],
  "install_guidance": {
    "plugin": "carthage",
    "binary": "carthage",
    "check": "which carthage",
    "install_steps": [
      "brew install carthage",
      "Verify: carthage --version",
      "supercli plugins install ./plugins/carthage --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "carthage",
      "resource": "self",
      "action": "version",
      "description": "Print carthage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "carthage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install carthage: brew install carthage"
      },
      "args": []
    },
    {
      "namespace": "carthage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to carthage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "carthage",
        "passthrough": true,
        "missingDependencyHelp": "Install carthage"
      },
      "args": []
    }
  ]
}