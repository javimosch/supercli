{
  "name": "diamond",
  "version": "0.1.0",
  "description": "Accelerated BLAST compatible local sequence aligner",
  "source": "https://github.com/bbuchfink/diamond",
  "checks": [
    {
      "type": "binary",
      "name": "diamond"
    }
  ],
  "install_guidance": {
    "plugin": "diamond",
    "binary": "diamond",
    "check": "which diamond",
    "install_steps": [
      "brew install diamond",
      "Verify: diamond --version",
      "supercli plugins install ./plugins/diamond --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "diamond",
      "resource": "self",
      "action": "version",
      "description": "Print diamond version",
      "adapter": "process",
      "adapterConfig": {
        "command": "diamond",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install diamond: brew install diamond"
      },
      "args": []
    },
    {
      "namespace": "diamond",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to diamond CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "diamond",
        "passthrough": true,
        "missingDependencyHelp": "Install diamond"
      },
      "args": []
    }
  ]
}