{
  "name": "python3-config",
  "version": "0.1.0",
  "description": "Python build configuration utility",
  "source": "https://manpages.debian.org/python3-config",
  "checks": [{ "type": "binary", "name": "python3-config" }],
  "install_guidance": {
    "plugin": "python3-config",
    "binary": "python3-config",
    "check": "which python3-config",
    "install_steps": [
      "apt-get install python3-dev",
      "Verify: python3-config --version",
      "supercli plugins install ./plugins/python3-config --on-conflict replace --json"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [{
    "namespace": "python3-config",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to python3-config CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "python3-config",
      "passthrough": true,
      "missingDependencyHelp": "Install python3-config: apt-get install python3-dev"
    },
    "args": []
  }]
}
