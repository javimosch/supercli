{
  "name": "appstreamcli",
  "version": "0.1.0",
  "description": "CLI tool: appstreamcli",
  "source": "https://packages.debian.org/appstreamcli",
  "checks": [{ "type": "binary", "name": "appstreamcli" }],
  "install_guidance": {
    "plugin": "appstreamcli", "binary": "appstreamcli", "check": "which appstreamcli",
    "install_steps": ["apt-get install appstreamcli 2>/dev/null || which appstreamcli", "Verify: appstreamcli --version", "supercli plugins install ./plugins/appstreamcli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "appstreamcli", "resource": "_", "action": "_",
    "description": "Passthrough to appstreamcli CLI",
    "adapter": "process", "adapterConfig": { "command": "appstreamcli", "passthrough": true, "missingDependencyHelp": "Install appstreamcli: apt-get install appstreamcli" }, "args": []
  }]
}
