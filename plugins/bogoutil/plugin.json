{
  "name": "bogoutil",
  "version": "0.1.0",
  "description": "bogoutil \u2014 dumps, loads, and maintains bogofilter database files",
  "source": "https://packages.debian.org/bogoutil",
  "checks": [{ "type": "binary", "name": "bogoutil" }],
  "install_guidance": {
    "plugin": "bogoutil", "binary": "bogoutil", "check": "which bogoutil",
    "install_steps": ["apt-get install bogoutil 2>/dev/null || which bogoutil", "Verify: bogoutil --version", "supercli plugins install ./plugins/bogoutil --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bogoutil", "resource": "_", "action": "_",
    "description": "Passthrough to bogoutil CLI",
    "adapter": "process", "adapterConfig": { "command": "bogoutil", "passthrough": true, "missingDependencyHelp": "Install bogoutil: apt-get install bogoutil" }, "args": []
  }]
}
