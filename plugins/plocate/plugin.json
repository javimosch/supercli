{
  "name": "plocate",
  "version": "0.1.0",
  "description": "A much faster locate; plocate is a locate based on posting lists, completely replacing mlocate with a much faster (and smaller) index.",
  "checks": [
    {
      "type": "binary",
      "name": "plocate"
    }
  ],
  "install_guidance": {
    "plugin": "plocate",
    "binary": "plocate",
    "check": "which plocate",
    "install_steps": [
      "See undefined",
      "Verify: plocate --version",
      "supercli plugins install ./plugins/plocate --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "plocate",
      "resource": "self",
      "action": "version",
      "description": "Print plocate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "plocate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install plocate: See undefined"
      },
      "args": []
    },
    {
      "namespace": "plocate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to plocate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "plocate",
        "passthrough": true,
        "missingDependencyHelp": "Install plocate"
      },
      "args": []
    }
  ]
}