{
  "name": "FadCam",
  "version": "0.1.0",
  "description": "Open-source, ad-free Android multimedia recorder with background video recording, screen recording, ",
  "source": "https://github.com/FadCam/FadCam",
  "checks": [
    {
      "type": "binary",
      "name": "fadcam"
    }
  ],
  "install_guidance": {
    "plugin": "FadCam",
    "binary": "fadcam",
    "check": "which fadcam",
    "install_steps": [
      "pip install fadcam",
      "Verify: fadcam --version",
      "supercli plugins install ./plugins/FadCam --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FadCam",
      "resource": "self",
      "action": "version",
      "description": "Print FadCam version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fadcam",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FadCam: pip install fadcam"
      },
      "args": []
    },
    {
      "namespace": "FadCam",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fadcam CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fadcam",
        "passthrough": true,
        "missingDependencyHelp": "Install FadCam: pip install fadcam"
      },
      "args": []
    }
  ]
}