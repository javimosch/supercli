{
  "name": "chartdb",
  "version": "0.1.0",
  "description": "Database diagrams editor that allows you to visualize and design your DB with a single query.",
  "source": "https://github.com/chartdb/chartdb",
  "checks": [
    {
      "type": "binary",
      "name": "chartdb"
    }
  ],
  "install_guidance": {
    "plugin": "chartdb",
    "binary": "chartdb",
    "check": "which chartdb",
    "install_steps": [
      "pip install chartdb",
      "Verify: chartdb --version",
      "supercli plugins install ./plugins/chartdb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "chartdb",
      "resource": "self",
      "action": "version",
      "description": "Print chartdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chartdb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chartdb: pip install chartdb"
      },
      "args": []
    },
    {
      "namespace": "chartdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chartdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chartdb",
        "passthrough": true,
        "missingDependencyHelp": "Install chartdb: pip install chartdb"
      },
      "args": []
    }
  ]
}