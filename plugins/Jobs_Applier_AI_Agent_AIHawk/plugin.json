{
  "name": "Jobs_Applier_AI_Agent_AIHawk",
  "version": "0.1.0",
  "description": "AIHawk aims to easy job hunt process by automating the job application process. Utilizing artificial",
  "source": "https://github.com/Jobs_Applier_AI_Agent_AIHawk/Jobs_Applier_AI_Agent_AIHawk",
  "checks": [
    {
      "type": "binary",
      "name": "jobs-applier-ai-agent-aihawk"
    }
  ],
  "install_guidance": {
    "plugin": "Jobs_Applier_AI_Agent_AIHawk",
    "binary": "jobs-applier-ai-agent-aihawk",
    "check": "which jobs-applier-ai-agent-aihawk",
    "install_steps": [
      "pip install jobs-applier-ai-agent-aihawk",
      "Verify: jobs-applier-ai-agent-aihawk --version",
      "supercli plugins install ./plugins/Jobs_Applier_AI_Agent_AIHawk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Jobs_Applier_AI_Agent_AIHawk",
      "resource": "self",
      "action": "version",
      "description": "Print Jobs_Applier_AI_Agent_AIHawk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jobs-applier-ai-agent-aihawk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Jobs_Applier_AI_Agent_AIHawk: pip install jobs-applier-ai-agent-aihawk"
      },
      "args": []
    },
    {
      "namespace": "Jobs_Applier_AI_Agent_AIHawk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jobs-applier-ai-agent-aihawk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jobs-applier-ai-agent-aihawk",
        "passthrough": true,
        "missingDependencyHelp": "Install Jobs_Applier_AI_Agent_AIHawk: pip install jobs-applier-ai-agent-aihawk"
      },
      "args": []
    }
  ]
}