{
  "name": "tls.zig",
  "version": "0.1.0",
  "description": "TLS 1.3/1.2  client and TLS 1.3 server in Zig",
  "source": "https://github.com/tls.zig/tls.zig",
  "checks": [
    {
      "type": "binary",
      "name": "tls.zig"
    }
  ],
  "install_guidance": {
    "plugin": "tls.zig",
    "binary": "tls.zig",
    "check": "which tls.zig",
    "install_steps": [
      "pip install tls.zig",
      "Verify: tls.zig --version",
      "supercli plugins install ./plugins/tls.zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tls.zig",
      "resource": "self",
      "action": "version",
      "description": "Print tls.zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tls.zig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tls.zig: pip install tls.zig"
      },
      "args": []
    },
    {
      "namespace": "tls.zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tls.zig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tls.zig",
        "passthrough": true,
        "missingDependencyHelp": "Install tls.zig: pip install tls.zig"
      },
      "args": []
    }
  ]
}