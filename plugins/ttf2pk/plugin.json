{
  "name": "ttf2pk",
  "version": "0.1.0",
  "description": "CLI tool: ttf2pk",
  "source": "https://manpages.debian.org/ttf2pk",
  "checks": [
    {
      "type": "binary",
      "name": "ttf2pk"
    }
  ],
  "install_guidance": {
    "plugin": "ttf2pk",
    "binary": "ttf2pk",
    "check": "which ttf2pk",
    "install_steps": [
      "apt-get install ttf2pk 2>/dev/null || which ttf2pk",
      "Verify: ttf2pk --version",
      "supercli plugins install ./plugins/ttf2pk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ttf2pk",
      "resource": "self",
      "action": "version",
      "description": "Print ttf2pk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttf2pk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ttf2pk: apt-get install ttf2pk 2>/dev/null || which ttf2pk"
      },
      "args": []
    },
    {
      "namespace": "ttf2pk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ttf2pk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttf2pk",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ttf2pk: apt-get install ttf2pk 2>/dev/null || which ttf2pk"
      },
      "args": []
    }
  ]
}