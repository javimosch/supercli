{
  "name": "ttysvr",
  "version": "0.1.0",
  "description": "Terminal screensaver collection in Rust",
  "source": "https://github.com/cxreiff/ttysvr",
  "checks": [{ "type": "binary", "name": "ttysvr" }],
  "install_guidance": {
    "plugin": "ttysvr",
    "binary": "ttysvr",
    "check": "which ttysvr",
    "install_steps": ["cargo install ttysvr", "Verify: ttysvr --version", "supercli plugins install ./plugins/ttysvr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ttysvr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ttysvr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ttysvr",
      "passthrough": true,
      "missingDependencyHelp": "Install ttysvr: cargo install ttysvr", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
