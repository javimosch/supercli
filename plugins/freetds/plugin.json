{
  "name": "freetds",
  "version": "0.1.0",
  "description": "Libraries to talk to Microsoft SQL Server and Sybase databases",
  "checks": [
    {
      "type": "binary",
      "name": "freetds"
    }
  ],
  "install_guidance": {
    "plugin": "freetds",
    "binary": "freetds",
    "check": "which freetds",
    "install_steps": [
      "brew install freetds",
      "Verify: freetds --version",
      "supercli plugins install ./plugins/freetds --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "freetds",
      "resource": "self",
      "action": "version",
      "description": "Print freetds version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freetds",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install freetds: brew install freetds"
      },
      "args": []
    },
    {
      "namespace": "freetds",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freetds CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freetds",
        "passthrough": true,
        "missingDependencyHelp": "Install freetds"
      },
      "args": []
    }
  ]
}