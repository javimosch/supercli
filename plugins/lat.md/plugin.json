{
  "name": "lat.md",
  "version": "1.0.0",
  "description": "Knowledge graph for your codebase, written in markdown. AI agents navigate project context via wiki-linked markdown files instead of grepping.",
  "source": "https://github.com/1st1/lat.md",
  "checks": [
    { "type": "binary", "name": "lat" }
  ],
  "install_guidance": {
    "plugin": "lat.md",
    "binary": "lat",
    "check": "lat --version 2>&1 | head -3",
    "install_steps": [
      "npm install -g lat.md",
      "Run: sc lat.md self init  — scaffold lat.md/ in your project"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lat.md",
      "resource": "self",
      "action": "init",
      "description": "Scaffold lat.md knowledge graph directory in current project",
      "adapter": "process",
      "adapterConfig": {
        "command": "lat",
        "baseArgs": ["init"],
        "cwd": "invoke_cwd",
        "parseJson": false,
        "timeout_ms": 15000
      },
      "args": []
    },
    {
      "namespace": "lat.md",
      "resource": "self",
      "action": "check",
      "description": "Enforce referential consistency of the knowledge graph",
      "adapter": "process",
      "adapterConfig": {
        "command": "lat",
        "baseArgs": ["check"],
        "cwd": "invoke_cwd",
        "parseJson": false,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "lat.md",
      "resource": "graph",
      "action": "search",
      "description": "Search the knowledge graph by query",
      "adapter": "process",
      "adapterConfig": {
        "command": "lat",
        "baseArgs": ["search"],
        "positionalArgs": ["query"],
        "cwd": "invoke_cwd",
        "parseJson": false,
        "timeout_ms": 15000
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search query" }
      ]
    },
    {
      "namespace": "lat.md",
      "resource": "graph",
      "action": "section",
      "description": "Read a specific section from the knowledge graph by ID",
      "adapter": "process",
      "adapterConfig": {
        "command": "lat",
        "baseArgs": ["section"],
        "positionalArgs": ["id"],
        "cwd": "invoke_cwd",
        "parseJson": false,
        "timeout_ms": 15000
      },
      "args": [
        { "name": "id", "type": "string", "required": true, "description": "Section ID (e.g. architecture#Overview)" }
      ]
    },
    {
      "namespace": "lat.md",
      "resource": "self",
      "action": "version",
      "description": "Print lat CLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lat",
        "baseArgs": ["--version"],
        "parseJson": false,
        "timeout_ms": 5000
      },
      "args": []
    },
    {
      "namespace": "lat.md",
      "resource": "_",
      "action": "_",
      "description": "Passthrough for advanced lat commands",
      "adapter": "process",
      "adapterConfig": {
        "command": "lat",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "parseJson": false,
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
