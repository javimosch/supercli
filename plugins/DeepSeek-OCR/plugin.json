{
  "name": "DeepSeek-OCR",
  "version": "0.1.0",
  "description": "Contexts Optical Compression",
  "source": "https://github.com/DeepSeek-OCR/DeepSeek-OCR",
  "checks": [
    {
      "type": "binary",
      "name": "deepseek-ocr"
    }
  ],
  "install_guidance": {
    "plugin": "DeepSeek-OCR",
    "binary": "deepseek-ocr",
    "check": "which deepseek-ocr",
    "install_steps": [
      "pip install deepseek-ocr",
      "Verify: deepseek-ocr --version",
      "supercli plugins install ./plugins/DeepSeek-OCR --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DeepSeek-OCR",
      "resource": "self",
      "action": "version",
      "description": "Print DeepSeek-OCR version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepseek-ocr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DeepSeek-OCR: pip install deepseek-ocr"
      },
      "args": []
    },
    {
      "namespace": "DeepSeek-OCR",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deepseek-ocr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepseek-ocr",
        "passthrough": true,
        "missingDependencyHelp": "Install DeepSeek-OCR: pip install deepseek-ocr"
      },
      "args": []
    }
  ]
}