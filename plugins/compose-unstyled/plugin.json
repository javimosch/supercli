{
  "name": "compose-unstyled",
  "version": "0.1.0",
  "description": "The missing Design System layer for Compose UI",
  "source": "https://github.com/compose-unstyled/compose-unstyled",
  "checks": [
    {
      "type": "binary",
      "name": "compose-unstyled"
    }
  ],
  "install_guidance": {
    "plugin": "compose-unstyled",
    "binary": "compose-unstyled",
    "check": "which compose-unstyled",
    "install_steps": [
      "pip install compose-unstyled",
      "Verify: compose-unstyled --version",
      "supercli plugins install ./plugins/compose-unstyled --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "compose-unstyled",
      "resource": "self",
      "action": "version",
      "description": "Print compose-unstyled version",
      "adapter": "process",
      "adapterConfig": {
        "command": "compose-unstyled",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install compose-unstyled: pip install compose-unstyled"
      },
      "args": []
    },
    {
      "namespace": "compose-unstyled",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to compose-unstyled CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "compose-unstyled",
        "passthrough": true,
        "missingDependencyHelp": "Install compose-unstyled: pip install compose-unstyled"
      },
      "args": []
    }
  ]
}