{
  "name": "slap",
  "version": "0.1.0",
  "description": "Sublime-like terminal-based text editor",
  "source": "https://github.com/slap-editor/slap",
  "checks": [{ "type": "binary", "name": "slap" }],
  "install_guidance": {
    "plugin": "slap",
    "binary": "slap",
    "check": "which slap",
    "install_steps": ["npm install -g slap-cli", "Verify: slap --version", "supercli plugins install ./plugins/slap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "slap",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to slap CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "slap",
      "passthrough": true,
      "missingDependencyHelp": "Install slap: npm install -g slap-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
