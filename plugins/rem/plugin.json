{
  "name": "rem",
  "version": "0.1.0",
  "description": "Manage macOS Reminders",
  "source": "https://github.com/BRO3886/rem",
  "checks": [
    {
      "type": "binary",
      "name": "rem"
    }
  ],
  "install_guidance": {
    "plugin": "rem",
    "binary": "rem",
    "check": "which rem",
    "install_steps": [
      "brew install rem",
      "Verify: rem --version",
      "supercli plugins install ./plugins/rem --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "rem",
      "resource": "self",
      "action": "version",
      "description": "Print rem version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rem",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rem: brew install rem"
      },
      "args": []
    },
    {
      "namespace": "rem",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rem CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rem",
        "passthrough": true,
        "missingDependencyHelp": "Install rem"
      },
      "args": []
    }
  ]
}