{
  "name": "esc-m",
  "version": "0.1.0",
  "description": "CLI tool: esc-m",
  "source": "https://manpages.debian.org/esc-m",
  "checks": [
    {
      "type": "binary",
      "name": "esc-m"
    }
  ],
  "install_guidance": {
    "plugin": "esc-m",
    "binary": "esc-m",
    "check": "which esc-m",
    "install_steps": [
      "apt-get install esc-m 2>/dev/null || which esc-m",
      "Verify: esc-m --version",
      "supercli plugins install ./plugins/esc-m --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "esc-m",
      "resource": "self",
      "action": "version",
      "description": "Print esc-m version",
      "adapter": "process",
      "adapterConfig": {
        "command": "esc-m",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install esc-m: apt-get install esc-m 2>/dev/null || which esc-m"
      },
      "args": []
    },
    {
      "namespace": "esc-m",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to esc-m CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "esc-m",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install esc-m: apt-get install esc-m 2>/dev/null || which esc-m"
      },
      "args": []
    }
  ]
}