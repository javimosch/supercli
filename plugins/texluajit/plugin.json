{
  "name": "texluajit",
  "version": "0.1.0",
  "description": "CLI tool: texluajit",
  "source": "https://manpages.debian.org/texluajit",
  "checks": [
    {
      "type": "binary",
      "name": "texluajit"
    }
  ],
  "install_guidance": {
    "plugin": "texluajit",
    "binary": "texluajit",
    "check": "which texluajit",
    "install_steps": [
      "apt-get install texluajit 2>/dev/null || which texluajit",
      "Verify: texluajit --version",
      "supercli plugins install ./plugins/texluajit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "texluajit",
      "resource": "self",
      "action": "version",
      "description": "Print texluajit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "texluajit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install texluajit: apt-get install texluajit 2>/dev/null || which texluajit"
      },
      "args": []
    },
    {
      "namespace": "texluajit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to texluajit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "texluajit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install texluajit: apt-get install texluajit 2>/dev/null || which texluajit"
      },
      "args": []
    }
  ]
}