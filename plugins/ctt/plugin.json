{
  "name": "ctt",
  "version": "0.1.0",
  "description": "CLI tool: ctt",
  "source": "https://packages.debian.org/ctt",
  "checks": [{ "type": "binary", "name": "ctt" }],
  "install_guidance": {
    "plugin": "ctt", "binary": "ctt", "check": "which ctt",
    "install_steps": ["apt-get install ctt 2>/dev/null || which ctt", "Verify: ctt --version", "supercli plugins install ./plugins/ctt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctt", "resource": "_", "action": "_",
    "description": "Passthrough to ctt CLI",
    "adapter": "process", "adapterConfig": { "command": "ctt", "passthrough": true, "missingDependencyHelp": "Install ctt: apt-get install ctt" }, "args": []
  }]
}
