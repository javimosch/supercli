{
  "name": "rtacct",
  "version": "1.0.0",
  "description": "rtacct — rtacct — CLI utility",
  "source": "https://wiki.linuxfoundation.org/networking/iproute2",
  "checks": [
    {
      "type": "binary",
      "name": "rtacct"
    }
  ],
  "install_guidance": {
    "plugin": "rtacct",
    "binary": "rtacct",
    "check": "which rtacct",
    "install_steps": [
      "# Install rtacct:",
      "# apt: sudo apt-get install rtacct",
      "# brew: brew install rtacct",
      "# cargo: cargo install rtacct",
      "# npm: npm install -g rtacct",
      "# pip: pip install rtacct",
      "# or download from /usr/sbin/rtacct"
    ]
  },
  "commands": [
    {
      "namespace": "rtacct",
      "resource": "rtacct",
      "action": "run",
      "description": "Run rtacct",
      "adapter": "process",
      "adapterConfig": {
        "command": "rtacct",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rtacct from /usr/sbin/rtacct"
      },
      "args": []
    }
  ]
}
