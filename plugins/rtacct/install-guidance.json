{
  "plugin": "rtacct",
  "binary": "rtacct",
  "check": "which rtacct",
  "install_steps": [
    "# Install rtacct",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rtacct-linux-amd64 -o /usr/local/bin/rtacct",
    "chmod +x /usr/local/bin/rtacct",
    "# Or via package manager, see /usr/sbin/rtacct"
  ]
}