{
  "name": "encfs",
  "version": "0.1.0",
  "description": "Encrypted filesystem in user-space based on [FUSE](https://it.wikipedia.org/wiki/FUSE), mounts an encrypted directory into a clear one.",
  "source": "https://github.com/vgough/encfs",
  "checks": [
    {
      "type": "binary",
      "name": "encfs"
    }
  ],
  "install_guidance": {
    "plugin": "encfs",
    "binary": "encfs",
    "check": "which encfs",
    "install_steps": [
      "brew install encfs",
      "Verify: encfs --version",
      "supercli plugins install ./plugins/encfs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "encfs",
      "resource": "self",
      "action": "version",
      "description": "Print encfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "encfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install encfs: brew install encfs"
      },
      "args": []
    },
    {
      "namespace": "encfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to encfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "encfs",
        "passthrough": true,
        "missingDependencyHelp": "Install encfs"
      },
      "args": []
    }
  ]
}