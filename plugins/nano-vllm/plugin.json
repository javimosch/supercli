{
  "name": "nano-vllm",
  "version": "0.1.0",
  "description": "Nano vLLM — minimal vLLM implementation with paged and flash attention",
  "source": "https://github.com/GeeeekExplorer/nano-vllm",
  "checks": [
    {
      "type": "binary",
      "name": "nano-vllm"
    }
  ],
  "install_guidance": {
    "plugin": "nano-vllm",
    "binary": "nano-vllm",
    "check": "which nano-vllm",
    "install_steps": [
      "pip install nano-vllm",
      "Verify: nano-vllm --version",
      "supercli plugins install ./plugins/nano-vllm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "nano-vllm",
    "resource": "self",
    "action": "version",
    "description": "Print nano-vllm version",
    "adapter": "process",
    "adapterConfig": {
      "command": "nano-vllm",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install nano-vllm: pip install nano-vllm"
    },
    "args": []
  },
  {
    "namespace": "nano-vllm",
    "resource": "server",
    "action": "start",
    "description": "Start the nano-vLLM server",
    "adapter": "process",
    "adapterConfig": {
      "command": "nano-vllm",
      "passthrough": true,
      "missingDependencyHelp": "Install nano-vllm: pip install nano-vllm"
    },
    "args": []
  },
  {
    "namespace": "nano-vllm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nano-vllm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nano-vllm",
      "passthrough": true,
      "missingDependencyHelp": "Install nano-vllm"
    },
    "args": []
  }
]
}