{
  "plugin": "nano-vllm",
  "binary": "nano-vllm",
  "check": "which nano-vllm",
  "install_steps": [
    "pip install nano-vllm",
    "Verify: nano-vllm --version",
    "supercli plugins install ./plugins/nano-vllm --on-conflict replace --json"
  ],
  "note": "Simple, minimal vLLM replication with self-contained paged attention."
}