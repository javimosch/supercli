{
  "name": "godot-zig",
  "version": "0.1.0",
  "description": "Zig bindings for Godot 4",
  "source": "https://github.com/godot-zig/godot-zig",
  "checks": [
    {
      "type": "binary",
      "name": "godot-zig"
    }
  ],
  "install_guidance": {
    "plugin": "godot-zig",
    "binary": "godot-zig",
    "check": "which godot-zig",
    "install_steps": [
      "pip install godot-zig",
      "Verify: godot-zig --version",
      "supercli plugins install ./plugins/godot-zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "godot-zig",
      "resource": "self",
      "action": "version",
      "description": "Print godot-zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "godot-zig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install godot-zig: pip install godot-zig"
      },
      "args": []
    },
    {
      "namespace": "godot-zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to godot-zig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "godot-zig",
        "passthrough": true,
        "missingDependencyHelp": "Install godot-zig: pip install godot-zig"
      },
      "args": []
    }
  ]
}