{
  "name": "daemontools",
  "version": "0.1.0",
  "description": "Collection of tools for managing Unix services and daemons",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "daemontools" }],
  "install_guidance": {
    "plugin": "daemontools",
    "binary": "daemontools",
    "check": "which daemontools",
    "install_steps": ["make && sudo make install", "Verify: daemontools --version", "supercli plugins install ./plugins/daemontools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "daemontools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to daemontools CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "daemontools",
      "passthrough": true,
      "missingDependencyHelp": "Install daemontools: make && sudo make install"
    },
    "args": []
  }]
}
