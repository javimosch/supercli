{
  "name": "dify",
  "version": "0.1.0",
  "description": "Production-ready platform for agentic workflow development.",
  "source": "https://github.com/dify/dify",
  "checks": [
    {
      "type": "binary",
      "name": "dify"
    }
  ],
  "install_guidance": {
    "plugin": "dify",
    "binary": "dify",
    "check": "which dify",
    "install_steps": [
      "pip install dify",
      "Verify: dify --version",
      "supercli plugins install ./plugins/dify --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dify",
      "resource": "self",
      "action": "version",
      "description": "Print dify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dify: pip install dify"
      },
      "args": []
    },
    {
      "namespace": "dify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dify",
        "passthrough": true,
        "missingDependencyHelp": "Install dify: pip install dify"
      },
      "args": []
    }
  ]
}