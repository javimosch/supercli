{
  "name": "ffprobe",
  "version": "1.0.0",
  "description": "ffprobe \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=ffprobe+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "ffprobe"
    }
  ],
  "install_guidance": {
    "plugin": "ffprobe",
    "binary": "ffprobe",
    "check": "which ffprobe",
    "install_steps": [
      "Install ffprobe via package manager: apt install ffprobe or brew install ffprobe"
    ]
  },
  "commands": [
    {
      "namespace": "ffprobe",
      "resource": "run",
      "action": "exec",
      "description": "ffprobe \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "ffprobe",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ffprobe via your package manager"
      },
      "args": []
    }
  ]
}