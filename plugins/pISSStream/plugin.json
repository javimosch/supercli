{
  "name": "pISSStream",
  "version": "0.1.0",
  "description": "App that shows how full the International Space Station's urine tank is in real time, available for ",
  "source": "https://github.com/pISSStream/pISSStream",
  "checks": [
    {
      "type": "binary",
      "name": "pissstream"
    }
  ],
  "install_guidance": {
    "plugin": "pISSStream",
    "binary": "pissstream",
    "check": "which pissstream",
    "install_steps": [
      "pip install pissstream",
      "Verify: pissstream --version",
      "supercli plugins install ./plugins/pISSStream --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pISSStream",
      "resource": "self",
      "action": "version",
      "description": "Print pISSStream version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pissstream",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pISSStream: pip install pissstream"
      },
      "args": []
    },
    {
      "namespace": "pISSStream",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pissstream CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pissstream",
        "passthrough": true,
        "missingDependencyHelp": "Install pISSStream: pip install pissstream"
      },
      "args": []
    }
  ]
}