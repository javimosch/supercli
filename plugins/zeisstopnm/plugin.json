{
  "name": "zeisstopnm",
  "version": "0.1.0",
  "description": "CLI tool: zeisstopnm",
  "source": "https://manpages.debian.org/zeisstopnm",
  "checks": [
    {
      "type": "binary",
      "name": "zeisstopnm"
    }
  ],
  "install_guidance": {
    "plugin": "zeisstopnm",
    "binary": "zeisstopnm",
    "check": "which zeisstopnm",
    "install_steps": [
      "apt-get install zeisstopnm 2>/dev/null || which zeisstopnm",
      "Verify: zeisstopnm --version",
      "supercli plugins install ./plugins/zeisstopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zeisstopnm",
      "resource": "self",
      "action": "version",
      "description": "Print zeisstopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zeisstopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zeisstopnm: apt-get install zeisstopnm 2>/dev/null || which zeisstopnm"
      },
      "args": []
    },
    {
      "namespace": "zeisstopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zeisstopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zeisstopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install zeisstopnm: apt-get install zeisstopnm 2>/dev/null || which zeisstopnm"
      },
      "args": []
    }
  ]
}