{
  "name": "ares",
  "version": "0.1.0",
  "description": "Automated decoding of encrypted text",
  "source": "https://github.com/bee-san/Ares",
  "checks": [
    {
      "type": "binary",
      "name": "ares"
    }
  ],
  "install_guidance": {
    "plugin": "ares",
    "binary": "ares",
    "check": "which ares",
    "install_steps": [
      "brew install ares",
      "Verify: ares --version",
      "supercli plugins install ./plugins/ares --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ares",
      "resource": "self",
      "action": "version",
      "description": "Print ares version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ares",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ares: brew install ares"
      },
      "args": []
    },
    {
      "namespace": "ares",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ares CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ares",
        "passthrough": true,
        "missingDependencyHelp": "Install ares"
      },
      "args": []
    }
  ]
}