{
  "name": "jump",
  "version": "0.1.0",
  "description": "Helps you navigate your file system faster by learning your habits",
  "source": "https://github.com/gsamokovarov/jump",
  "checks": [
    {
      "type": "binary",
      "name": "jump"
    }
  ],
  "install_guidance": {
    "plugin": "jump",
    "binary": "jump",
    "check": "which jump",
    "install_steps": [
      "brew install jump",
      "Verify: jump --version",
      "supercli plugins install ./plugins/jump --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jump",
      "resource": "self",
      "action": "version",
      "description": "Print jump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jump: brew install jump"
      },
      "args": []
    },
    {
      "namespace": "jump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jump",
        "passthrough": true,
        "missingDependencyHelp": "Install jump"
      },
      "args": []
    }
  ]
}