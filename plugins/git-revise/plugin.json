{
  "name": "git-revise",
  "version": "0.1.0",
  "description": "Rebase alternative for amending and splitting commits",
  "source": "https://github.com/mwhudson/git-revise",
  "checks": [{ "type": "binary", "name": "git-revise" }],
  "install_guidance": {
    "plugin": "git-revise",
    "binary": "git-revise",
    "check": "which git-revise",
    "install_steps": ["pip install git-revise", "Verify: git-revise --version", "supercli plugins install ./plugins/git-revise --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-revise",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-revise CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-revise",
      "passthrough": true,
      "missingDependencyHelp": "Install git-revise: pip install git-revise", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
