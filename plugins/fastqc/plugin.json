{
  "name": "fastqc",
  "version": "1.0.0",
  "description": "fastqc \u2014 QC for sequencing",
  "source": "bioinformatics.babraham.ac.uk/projects/fastqc",
  "checks": [
    {
      "type": "binary",
      "name": "fastqc"
    }
  ],
  "install_guidance": {
    "plugin": "fastqc",
    "binary": "fastqc",
    "check": "which fastqc",
    "install_steps": [
      "# Install fastqc",
      "# See bioinformatics.babraham.ac.uk/projects/fastqc",
      "# apt: sudo apt-get install fastqc",
      "# brew: brew install fastqc",
      "# cargo: cargo install fastqc",
      "# npm: npm install -g fastqc",
      "# pip: pip install fastqc"
    ]
  },
  "commands": [
    {
      "namespace": "fastqc",
      "resource": "fastqc",
      "action": "run",
      "description": "Run fastqc",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastqc",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fastqc from bioinformatics.babraham.ac.uk/projects/fastqc"
      },
      "args": []
    }
  ]
}