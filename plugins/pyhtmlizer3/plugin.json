{
  "name": "pyhtmlizer3",
  "version": "0.1.0",
  "description": "CLI tool: pyhtmlizer3",
  "source": "https://manpages.debian.org/pyhtmlizer3",
  "checks": [
    {
      "type": "binary",
      "name": "pyhtmlizer3"
    }
  ],
  "install_guidance": {
    "plugin": "pyhtmlizer3",
    "binary": "pyhtmlizer3",
    "check": "which pyhtmlizer3",
    "install_steps": [
      "apt-get install pyhtmlizer3 2>/dev/null || which pyhtmlizer3",
      "Verify: pyhtmlizer3 --version",
      "supercli plugins install ./plugins/pyhtmlizer3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyhtmlizer3",
      "resource": "self",
      "action": "version",
      "description": "Print pyhtmlizer3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyhtmlizer3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyhtmlizer3: apt-get install pyhtmlizer3 2>/dev/null || which pyhtmlizer3"
      },
      "args": []
    },
    {
      "namespace": "pyhtmlizer3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyhtmlizer3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyhtmlizer3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyhtmlizer3: apt-get install pyhtmlizer3 2>/dev/null || which pyhtmlizer3"
      },
      "args": []
    }
  ]
}