{
  "name": "simpdftex",
  "version": "0.1.0",
  "description": "CLI tool: simpdftex",
  "source": "https://manpages.debian.org/simpdftex",
  "checks": [
    {
      "type": "binary",
      "name": "simpdftex"
    }
  ],
  "install_guidance": {
    "plugin": "simpdftex",
    "binary": "simpdftex",
    "check": "which simpdftex",
    "install_steps": [
      "apt-get install simpdftex 2>/dev/null || which simpdftex",
      "Verify: simpdftex --version",
      "supercli plugins install ./plugins/simpdftex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "simpdftex",
      "resource": "self",
      "action": "version",
      "description": "Print simpdftex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "simpdftex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install simpdftex: apt-get install simpdftex 2>/dev/null || which simpdftex"
      },
      "args": []
    },
    {
      "namespace": "simpdftex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to simpdftex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "simpdftex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install simpdftex: apt-get install simpdftex 2>/dev/null || which simpdftex"
      },
      "args": []
    }
  ]
}