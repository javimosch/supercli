{
  "name": "strace-log-merge",
  "version": "0.1.0",
  "description": "CLI tool: strace-log-merge",
  "source": "https://manpages.debian.org/strace-log-merge",
  "checks": [
    {
      "type": "binary",
      "name": "strace-log-merge"
    }
  ],
  "install_guidance": {
    "plugin": "strace-log-merge",
    "binary": "strace-log-merge",
    "check": "which strace-log-merge",
    "install_steps": [
      "apt-get install strace-log-merge 2>/dev/null || which strace-log-merge",
      "Verify: strace-log-merge --version",
      "supercli plugins install ./plugins/strace-log-merge --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "strace-log-merge",
      "resource": "self",
      "action": "version",
      "description": "Print strace-log-merge version",
      "adapter": "process",
      "adapterConfig": {
        "command": "strace-log-merge",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install strace-log-merge: apt-get install strace-log-merge 2>/dev/null || which strace-log-merge"
      },
      "args": []
    },
    {
      "namespace": "strace-log-merge",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to strace-log-merge CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "strace-log-merge",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install strace-log-merge: apt-get install strace-log-merge 2>/dev/null || which strace-log-merge"
      },
      "args": []
    }
  ]
}