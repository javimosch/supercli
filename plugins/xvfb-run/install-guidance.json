{
  "plugin": "xvfb-run",
  "binary": "xvfb-run",
  "check": "which xvfb-run",
  "install_steps": [
    "apt-get install xvfb-run 2>/dev/null || which xvfb-run",
    "Verify: xvfb-run --version",
    "supercli plugins install ./plugins/xvfb-run --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}