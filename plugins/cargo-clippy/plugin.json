{
  "name": "cargo-clippy",
  "version": "0.1.0",
  "description": "CLI tool: cargo-clippy",
  "source": "https://packages.debian.org/cargo-clippy",
  "checks": [{ "type": "binary", "name": "cargo-clippy" }],
  "install_guidance": {
    "plugin": "cargo-clippy", "binary": "cargo-clippy", "check": "which cargo-clippy",
    "install_steps": ["apt-get install cargo-clippy 2>/dev/null || which cargo-clippy", "Verify: cargo-clippy --version", "supercli plugins install ./plugins/cargo-clippy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-clippy", "resource": "_", "action": "_",
    "description": "Passthrough to cargo-clippy CLI",
    "adapter": "process", "adapterConfig": { "command": "cargo-clippy", "passthrough": true, "missingDependencyHelp": "Install cargo-clippy: apt-get install cargo-clippy" }, "args": []
  }]
}
