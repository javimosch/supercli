{
  "name": "EPUBKit",
  "version": "0.1.0",
  "description": "Simple programmatic EPUB parser and converter in Swift",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "EPUBKit" }],
  "install_guidance": {
    "plugin": "EPUBKit",
    "binary": "EPUBKit",
    "check": "which EPUBKit",
    "install_steps": ["swift build -c release", "Verify: EPUBKit --version", "supercli plugins install ./plugins/EPUBKit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "EPUBKit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to EPUBKit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "EPUBKit",
      "passthrough": true,
      "missingDependencyHelp": "Install EPUBKit: swift build -c release"
    },
    "args": []
  }]
}
