{
  "name": "bartycrouch",
  "version": "0.1.0",
  "description": "Incrementally update/translate your Strings files",
  "source": "https://github.com/FlineDev/BartyCrouch",
  "checks": [
    {
      "type": "binary",
      "name": "bartycrouch"
    }
  ],
  "install_guidance": {
    "plugin": "bartycrouch",
    "binary": "bartycrouch",
    "check": "which bartycrouch",
    "install_steps": [
      "brew install bartycrouch",
      "Verify: bartycrouch --version",
      "supercli plugins install ./plugins/bartycrouch --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bartycrouch",
      "resource": "self",
      "action": "version",
      "description": "Print bartycrouch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bartycrouch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bartycrouch: brew install bartycrouch"
      },
      "args": []
    },
    {
      "namespace": "bartycrouch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bartycrouch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bartycrouch",
        "passthrough": true,
        "missingDependencyHelp": "Install bartycrouch"
      },
      "args": []
    }
  ]
}