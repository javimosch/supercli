{
  "name": "select-default-ispell",
  "version": "0.1.0",
  "description": "CLI tool: select-default-ispell",
  "source": "https://manpages.debian.org/select-default-ispell",
  "checks": [
    {
      "type": "binary",
      "name": "select-default-ispell"
    }
  ],
  "install_guidance": {
    "plugin": "select-default-ispell",
    "binary": "select-default-ispell",
    "check": "which select-default-ispell",
    "install_steps": [
      "apt-get install select-default-ispell 2>/dev/null || which select-default-ispell",
      "Verify: select-default-ispell --version",
      "supercli plugins install ./plugins/select-default-ispell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "select-default-ispell",
      "resource": "self",
      "action": "version",
      "description": "Print select-default-ispell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "select-default-ispell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install select-default-ispell: apt-get install select-default-ispell 2>/dev/null || which select-default-ispell"
      },
      "args": []
    },
    {
      "namespace": "select-default-ispell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to select-default-ispell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "select-default-ispell",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install select-default-ispell: apt-get install select-default-ispell 2>/dev/null || which select-default-ispell"
      },
      "args": []
    }
  ]
}