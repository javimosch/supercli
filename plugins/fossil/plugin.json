{
  "name": "fossil",
  "version": "0.1.0",
  "description": "Fossil distributed version control and wiki",
  "source": "https",
  "checks": [{"type": "binary", "name": "fossil"}],
  "install_guidance": {
    "plugin": "fossil",
    "binary": "fossil",
    "check": "which fossil",
    "install_steps": [
      "brew install fossil",
      "Verify: fossil --version",
      "supercli plugins install ./plugins/fossil --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "fossil",
      "resource": "self",
      "action": "version",
      "description": "Print fossil version",
      "adapter": "process",
      "adapterConfig": {"command": "fossil", "baseArgs": ["--version"], "missingDependencyHelp": "Install fossil: brew install fossil"},
      "args": []
    },
    {
      "namespace": "fossil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fossil CLI",
      "adapter": "process",
      "adapterConfig": {"command": "fossil", "passthrough": true, "missingDependencyHelp": "Install fossil: brew install fossil"},
      "args": []
    }
  ]
}
