{
  "name": "traceproto.db",
  "version": "0.1.0",
  "description": "CLI tool: traceproto.db",
  "source": "https://manpages.debian.org/traceproto.db",
  "checks": [
    {
      "type": "binary",
      "name": "traceproto.db"
    }
  ],
  "install_guidance": {
    "plugin": "traceproto.db",
    "binary": "traceproto.db",
    "check": "which traceproto.db",
    "install_steps": [
      "apt-get install traceproto.db 2>/dev/null || which traceproto.db",
      "Verify: traceproto.db --version",
      "supercli plugins install ./plugins/traceproto.db --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "traceproto.db",
      "resource": "self",
      "action": "version",
      "description": "Print traceproto.db version",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceproto.db",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install traceproto.db: apt-get install traceproto.db 2>/dev/null || which traceproto.db"
      },
      "args": []
    },
    {
      "namespace": "traceproto.db",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to traceproto.db CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceproto.db",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install traceproto.db: apt-get install traceproto.db 2>/dev/null || which traceproto.db"
      },
      "args": []
    }
  ]
}