{
  "name": "festival",
  "version": "0.1.0",
  "description": "General multi-lingual speech synthesis system with CLI",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "festival" }],
  "install_guidance": {
    "plugin": "festival",
    "binary": "festival",
    "check": "which festival",
    "install_steps": ["sudo apt install festival", "Verify: festival --version", "supercli plugins install ./plugins/festival --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "festival",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to festival CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "festival",
      "passthrough": true,
      "missingDependencyHelp": "Install festival: sudo apt install festival"
    },
    "args": []
  }]
}
