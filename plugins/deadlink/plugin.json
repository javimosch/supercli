{
  "name": "deadlink",
  "version": "0.1.0",
  "description": "Find dead links in files",
  "source": "https://github.com/nschloe/deadlink",
  "checks": [
    {
      "type": "binary",
      "name": "deadlink"
    }
  ],
  "install_guidance": {
    "plugin": "deadlink",
    "binary": "deadlink",
    "check": "which deadlink",
    "install_steps": [
      "See https://github.com/nschloe/deadlink",
      "Verify: deadlink --version",
      "supercli plugins install ./plugins/deadlink --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "deadlink",
      "resource": "self",
      "action": "version",
      "description": "Print deadlink version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deadlink",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install deadlink: See https://github.com/nschloe/deadlink"
      },
      "args": []
    },
    {
      "namespace": "deadlink",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deadlink CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deadlink",
        "passthrough": true,
        "missingDependencyHelp": "Install deadlink"
      },
      "args": []
    }
  ]
}