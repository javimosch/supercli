{
  "name": "sparkly-cli",
  "version": "0.1.0",
  "description": "Generate sparklines ▁▂▃▅▂▇",
  "source": "https://github.com/sindresorhus/sparkly-cli",
  "checks": [
    {
      "type": "binary",
      "name": "sparkly-cli"
    }
  ],
  "install_guidance": {
    "plugin": "sparkly-cli",
    "binary": "sparkly-cli",
    "check": "which sparkly-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/sparkly-cli",
      "Verify: sparkly-cli --version",
      "supercli plugins install ./plugins/sparkly-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "sparkly-cli",
      "resource": "self",
      "action": "version",
      "description": "Print sparkly-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sparkly-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sparkly-cli: See https://github.com/sindresorhus/sparkly-cli"
      },
      "args": []
    },
    {
      "namespace": "sparkly-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sparkly-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sparkly-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install sparkly-cli"
      },
      "args": []
    }
  ]
}