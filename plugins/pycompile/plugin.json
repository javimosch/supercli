{
  "name": "pycompile",
  "version": "0.1.0",
  "description": "CLI tool: pycompile",
  "source": "https://manpages.debian.org/pycompile",
  "checks": [
    {
      "type": "binary",
      "name": "pycompile"
    }
  ],
  "install_guidance": {
    "plugin": "pycompile",
    "binary": "pycompile",
    "check": "which pycompile",
    "install_steps": [
      "apt-get install pycompile 2>/dev/null || which pycompile",
      "Verify: pycompile --version",
      "supercli plugins install ./plugins/pycompile --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pycompile",
      "resource": "self",
      "action": "version",
      "description": "Print pycompile version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pycompile",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pycompile: apt-get install pycompile 2>/dev/null || which pycompile"
      },
      "args": []
    },
    {
      "namespace": "pycompile",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pycompile CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pycompile",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pycompile: apt-get install pycompile 2>/dev/null || which pycompile"
      },
      "args": []
    }
  ]
}