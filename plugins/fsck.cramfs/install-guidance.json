{
  "plugin": "fsck.cramfs",
  "binary": "fsck.cramfs",
  "check": "which fsck.cramfs",
  "install_steps": [
    "apt-get install fsck.cramfs 2>/dev/null || which fsck.cramfs",
    "Verify: fsck.cramfs --version",
    "supercli plugins install ./plugins/fsck.cramfs --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}