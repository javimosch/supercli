{
  "name": "Jmp",
  "version": "0.1.0",
  "description": "Change directory with smart searching of the path specified through regex.",
  "source": "https://github.com/gholmes829/Jmp",
  "checks": [
    {
      "type": "binary",
      "name": "Jmp"
    }
  ],
  "install_guidance": {
    "plugin": "Jmp",
    "binary": "Jmp",
    "check": "which Jmp",
    "install_steps": [
      "See https://github.com/gholmes829/Jmp",
      "Verify: Jmp --version",
      "supercli plugins install ./plugins/Jmp --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Jmp",
      "resource": "self",
      "action": "version",
      "description": "Print Jmp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Jmp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Jmp: See https://github.com/gholmes829/Jmp"
      },
      "args": []
    },
    {
      "namespace": "Jmp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Jmp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Jmp",
        "passthrough": true,
        "missingDependencyHelp": "Install Jmp"
      },
      "args": []
    }
  ]
}