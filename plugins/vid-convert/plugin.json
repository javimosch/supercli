{
  "name": "vid-convert",
  "version": "0.1.0",
  "description": "Convert video files between formats using FFmpeg wrapper",
  "source": "https://github.com/johndoe/vid-convert",
  "checks": [{ "type": "binary", "name": "vid-convert" }],
  "install_guidance": {
    "plugin": "vid-convert",
    "binary": "vid-convert",
    "check": "which vid-convert",
    "install_steps": ["pip install vid-convert", "Verify: vid-convert --version", "supercli plugins install ./plugins/vid-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vid-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vid-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vid-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install vid-convert: pip install vid-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
