{
  "name": "policy-controller",
  "version": "0.1.0",
  "description": "Open Policy Agent Gatekeeper for Flux",
  "source": "https://github.com/fluxcd/flux2",
  "checks": [{ "type": "binary", "name": "policy-controller" }],
  "install_guidance": {
    "plugin": "policy-controller",
    "binary": "policy-controller",
    "check": "which policy-controller",
    "install_steps": ["brew install policy-controller", "Verify: policy-controller --version", "supercli plugins install ./plugins/policy-controller --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "policy-controller",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to policy-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "policy-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install policy-controller: brew install policy-controller"
    },
    "args": []
  }]
}
