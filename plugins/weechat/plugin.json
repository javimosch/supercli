{
  "name": "weechat",
  "version": "0.1.0",
  "description": "The extensible chat client with plugin support, scripting, and relay capabilities",
  "source": "https://github.com/weechat/weechat",
  "checks": [{ "type": "binary", "name": "weechat" }],
  "install_guidance": {
    "plugin": "weechat",
    "binary": "weechat",
    "check": "which weechat",
    "install_steps": [
      "sudo apt install weechat",
      "Or: brew install weechat",
      "Or: sudo pacman -S weechat",
      "Verify: weechat --version",
      "supercli plugins install ./plugins/weechat --on-conflict replace --json"
    ],
    "note": "Available via all major package managers. Source: https://github.com/weechat/weechat (3.3k+ stars). Written in C."
  },
  "commands": [
    {
      "namespace": "weechat", "resource": "self", "action": "version",
      "description": "Print weechat version",
      "adapter": "process",
      "adapterConfig": { "command": "weechat", "missingDependencyHelp": "Install weechat: sudo apt install weechat", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "weechat", "resource": "_", "action": "_",
      "description": "Passthrough to weechat CLI",
      "adapter": "process",
      "adapterConfig": { "command": "weechat", "missingDependencyHelp": "Install weechat: sudo apt install weechat", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
