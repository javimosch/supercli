{
  "name": "dhall-toml",
  "version": "0.1.0",
  "description": "Convert between Dhall and Toml",
  "source": "https://github.com/dhall-lang/dhall-haskell/tree/main/dhall-toml",
  "checks": [
    {
      "type": "binary",
      "name": "dhall-toml"
    }
  ],
  "install_guidance": {
    "plugin": "dhall-toml",
    "binary": "dhall-toml",
    "check": "which dhall-toml",
    "install_steps": [
      "brew install dhall-toml",
      "Verify: dhall-toml --version",
      "supercli plugins install ./plugins/dhall-toml --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dhall-toml",
      "resource": "self",
      "action": "version",
      "description": "Print dhall-toml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dhall-toml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dhall-toml: brew install dhall-toml"
      },
      "args": []
    },
    {
      "namespace": "dhall-toml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dhall-toml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dhall-toml",
        "passthrough": true,
        "missingDependencyHelp": "Install dhall-toml"
      },
      "args": []
    }
  ]
}