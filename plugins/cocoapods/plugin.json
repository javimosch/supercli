{
  "name": "cocoapods",
  "version": "0.1.0",
  "description": "Dependency manager for Cocoa projects",
  "checks": [
    {
      "type": "binary",
      "name": "cocoapods"
    }
  ],
  "install_guidance": {
    "plugin": "cocoapods",
    "binary": "cocoapods",
    "check": "which cocoapods",
    "install_steps": [
      "brew install cocoapods",
      "Verify: cocoapods --version",
      "supercli plugins install ./plugins/cocoapods --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cocoapods",
      "resource": "self",
      "action": "version",
      "description": "Print cocoapods version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cocoapods",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cocoapods: brew install cocoapods"
      },
      "args": []
    },
    {
      "namespace": "cocoapods",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cocoapods CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cocoapods",
        "passthrough": true,
        "missingDependencyHelp": "Install cocoapods"
      },
      "args": []
    }
  ]
}