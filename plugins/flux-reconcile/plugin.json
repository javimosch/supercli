{
  "name": "flux-reconcile",
  "version": "0.1.0",
  "description": "Trigger reconciliation of Flux CD resources",
  "source": "https://github.com/fluxcd/flux2",
  "checks": [{ "type": "binary", "name": "flux-reconcile" }],
  "install_guidance": {
    "plugin": "flux-reconcile",
    "binary": "flux-reconcile",
    "check": "which flux-reconcile",
    "install_steps": ["brew install flux-reconcile", "Verify: flux-reconcile --version", "supercli plugins install ./plugins/flux-reconcile --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "flux-reconcile",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to flux-reconcile CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flux-reconcile",
      "passthrough": true,
      "missingDependencyHelp": "Install flux-reconcile: brew install flux-reconcile"
    },
    "args": []
  }]
}
