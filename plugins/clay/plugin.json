{
  "name": "clay",
  "version": "0.1.0",
  "description": "High performance UI layout library in C.",
  "source": "https://github.com/clay/clay",
  "checks": [
    {
      "type": "binary",
      "name": "clay"
    }
  ],
  "install_guidance": {
    "plugin": "clay",
    "binary": "clay",
    "check": "which clay",
    "install_steps": [
      "pip install clay",
      "Verify: clay --version",
      "supercli plugins install ./plugins/clay --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clay",
      "resource": "self",
      "action": "version",
      "description": "Print clay version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clay",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clay: pip install clay"
      },
      "args": []
    },
    {
      "namespace": "clay",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clay CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clay",
        "passthrough": true,
        "missingDependencyHelp": "Install clay: pip install clay"
      },
      "args": []
    }
  ]
}