{
  "name": "aipexbase",
  "version": "0.1.0",
  "description": "AipexBase is an AI-native BaaS platform. You only need to develop the frontend with vibe coding tool",
  "source": "https://github.com/aipexbase/aipexbase",
  "checks": [
    {
      "type": "binary",
      "name": "aipexbase"
    }
  ],
  "install_guidance": {
    "plugin": "aipexbase",
    "binary": "aipexbase",
    "check": "which aipexbase",
    "install_steps": [
      "pip install aipexbase",
      "Verify: aipexbase --version",
      "supercli plugins install ./plugins/aipexbase --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aipexbase",
      "resource": "self",
      "action": "version",
      "description": "Print aipexbase version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aipexbase",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aipexbase: pip install aipexbase"
      },
      "args": []
    },
    {
      "namespace": "aipexbase",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aipexbase CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aipexbase",
        "passthrough": true,
        "missingDependencyHelp": "Install aipexbase: pip install aipexbase"
      },
      "args": []
    }
  ]
}