{
  "name": "apt-cdrom",
  "version": "0.1.0",
  "description": "CLI tool: apt-cdrom",
  "source": "https://packages.debian.org/apt-cdrom",
  "checks": [{ "type": "binary", "name": "apt-cdrom" }],
  "install_guidance": {
    "plugin": "apt-cdrom", "binary": "apt-cdrom", "check": "which apt-cdrom",
    "install_steps": ["apt-get install apt-cdrom 2>/dev/null || which apt-cdrom", "Verify: apt-cdrom --version", "supercli plugins install ./plugins/apt-cdrom --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apt-cdrom", "resource": "_", "action": "_",
    "description": "Passthrough to apt-cdrom CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-cdrom", "passthrough": true, "missingDependencyHelp": "Install apt-cdrom: apt-get install apt-cdrom" }, "args": []
  }]
}
