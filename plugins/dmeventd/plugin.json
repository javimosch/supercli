{
  "name": "dmeventd",
  "version": "0.1.0",
  "description": "CLI tool: dmeventd",
  "source": "https://packages.debian.org/dmeventd",
  "checks": [{ "type": "binary", "name": "dmeventd" }],
  "install_guidance": {
