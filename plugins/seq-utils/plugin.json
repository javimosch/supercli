{
  "name": "seq-utils",
  "version": "0.1.0",
  "description": "Lightweight collection of fasta/fastq sequence manipulation utilities",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "seq-utils" }],
  "install_guidance": {
    "plugin": "seq-utils",
    "binary": "seq-utils",
    "check": "which seq-utils",
    "install_steps": ["pip install seq-utils", "Verify: seq-utils --version", "supercli plugins install ./plugins/seq-utils --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "seq-utils",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to seq-utils CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "seq-utils",
      "passthrough": true,
      "missingDependencyHelp": "Install seq-utils: pip install seq-utils"
    },
    "args": []
  }]
}
