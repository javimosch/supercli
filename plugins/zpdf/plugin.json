{
  "name": "zpdf",
  "version": "0.1.0",
  "description": "Zero-copy PDF text extraction in Zig",
  "source": "https://github.com/nicholasgasior/zpdf",
  "checks": [{"type": "binary", "name": "zpdf"}],
  "install_guidance": {
    "plugin": "zpdf",
    "binary": "zpdf",
    "check": "which zpdf",
    "install_steps": [
      "cargo install zpdf",
      "Verify: zpdf --version",
      "supercli plugins install ./zpdf --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "zpdf",
      "resource": "self",
      "action": "version",
      "description": "Print zpdf version",
      "adapter": "process",
      "adapterConfig": {"command": "zpdf", "baseArgs": ["--version"], "missingDependencyHelp": "Install zpdf: cargo install zpdf"},
      "args": []
    },
    {
      "namespace": "zpdf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zpdf CLI",
      "adapter": "process",
      "adapterConfig": {"command": "zpdf", "passthrough": true, "missingDependencyHelp": "Install zpdf: cargo install zpdf"},
      "args": []
    }
  ]
}
