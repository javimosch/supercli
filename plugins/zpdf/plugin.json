{
  "name": "zpdf",
  "version": "0.1.0",
  "description": "Zero-copy PDF text extraction library written in Zig. High-performance, memory-mapped parsing with S",
  "source": "https://github.com/zpdf/zpdf",
  "checks": [
    {
      "type": "binary",
      "name": "zpdf"
    }
  ],
  "install_guidance": {
    "plugin": "zpdf",
    "binary": "zpdf",
    "check": "which zpdf",
    "install_steps": [
      "pip install zpdf",
      "Verify: zpdf --version",
      "supercli plugins install ./plugins/zpdf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zpdf",
      "resource": "self",
      "action": "version",
      "description": "Print zpdf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zpdf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zpdf: pip install zpdf"
      },
      "args": []
    },
    {
      "namespace": "zpdf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zpdf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zpdf",
        "passthrough": true,
        "missingDependencyHelp": "Install zpdf: pip install zpdf"
      },
      "args": []
    }
  ]
}