{
  "name": "msgpack-tools",
  "version": "0.1.0",
  "description": "Utilities for MessagePack serialization encoding and decoding",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "msgpack-tools" }],
  "install_guidance": {
    "plugin": "msgpack-tools",
    "binary": "msgpack-tools",
    "check": "which msgpack-tools",
    "install_steps": ["npm install -g msgpack-tools", "Verify: msgpack-tools --version", "supercli plugins install ./plugins/msgpack-tools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "msgpack-tools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to msgpack-tools CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "msgpack-tools",
      "passthrough": true,
      "missingDependencyHelp": "Install msgpack-tools: npm install -g msgpack-tools"
    },
    "args": []
  }]
}
