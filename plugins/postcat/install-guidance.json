{
  "plugin": "postcat",
  "binary": "postcat",
  "check": "which postcat",
  "install_steps": [
    "# Install postcat",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/postcat-linux-amd64 -o /usr/local/bin/postcat",
    "chmod +x /usr/local/bin/postcat",
    "# Or via package manager, see /usr/sbin/postcat"
  ]
}