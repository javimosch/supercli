{
  "name": "postcat",
  "version": "1.0.0",
  "description": "postcat \u2014 postcat \u2014 CLI utility",
  "source": "/usr/sbin/postcat",
  "checks": [
    {
      "type": "binary",
      "name": "postcat"
    }
  ],
  "install_guidance": {
    "plugin": "postcat",
    "binary": "postcat",
    "check": "which postcat",
    "install_steps": [
      "# Install postcat:",
      "# apt: sudo apt-get install postcat",
      "# brew: brew install postcat",
      "# cargo: cargo install postcat",
      "# npm: npm install -g postcat",
      "# pip: pip install postcat",
      "# or download from /usr/sbin/postcat"
    ]
  },
  "commands": [
    {
      "namespace": "postcat",
      "resource": "postcat",
      "action": "run",
      "description": "Run postcat",
      "adapter": "process",
      "adapterConfig": {
        "command": "postcat",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postcat from /usr/sbin/postcat"
      },
      "args": []
    }
  ]
}