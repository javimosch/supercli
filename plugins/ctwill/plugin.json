{
  "name": "ctwill",
  "version": "0.1.0",
  "description": "CLI tool: ctwill",
  "source": "https://packages.debian.org/ctwill",
  "checks": [{ "type": "binary", "name": "ctwill" }],
  "install_guidance": {
    "plugin": "ctwill", "binary": "ctwill", "check": "which ctwill",
    "install_steps": ["apt-get install ctwill 2>/dev/null || which ctwill", "Verify: ctwill --version", "supercli plugins install ./plugins/ctwill --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctwill", "resource": "_", "action": "_",
    "description": "Passthrough to ctwill CLI",
    "adapter": "process", "adapterConfig": { "command": "ctwill", "passthrough": true, "missingDependencyHelp": "Install ctwill: apt-get install ctwill" }, "args": []
  }]
}
