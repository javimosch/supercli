{
  "name": "ccusage",
  "version": "0.1.0",
  "description": "Analyze coding (agent) CLI token usage and costs from local data.",
  "source": "https://github.com/ccusage/ccusage",
  "checks": [
    {
      "type": "binary",
      "name": "ccusage"
    }
  ],
  "install_guidance": {
    "plugin": "ccusage",
    "binary": "ccusage",
    "check": "which ccusage",
    "install_steps": [
      "pip install ccusage",
      "Verify: ccusage --version",
      "supercli plugins install ./plugins/ccusage --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ccusage",
      "resource": "self",
      "action": "version",
      "description": "Print ccusage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccusage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ccusage: pip install ccusage"
      },
      "args": []
    },
    {
      "namespace": "ccusage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ccusage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccusage",
        "passthrough": true,
        "missingDependencyHelp": "Install ccusage: pip install ccusage"
      },
      "args": []
    }
  ]
}