{
  "name": "ccusage",
  "version": "0.1.0",
  "description": "Analyze coding CLI token usage and costs from local data with JSON output",
  "source": "https://github.com/ryoppippi/ccusage",
  "checks": [
    {
      "type": "binary",
      "name": "ccusage"
    }
  ],
  "install_guidance": {
    "plugin": "ccusage",
    "binary": "ccusage",
    "check": "which ccusage",
    "install_steps": [
      "npm install -g ccusage",
      "Verify: ccusage --version",
      "supercli plugins install ./plugins/ccusage --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ccusage",
      "resource": "self",
      "action": "version",
      "description": "Print ccusage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccusage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ccusage: npm install -g ccusage"
      },
      "args": []
    },
    {
      "namespace": "ccusage",
      "resource": "usage",
      "action": "daily",
      "description": "Show daily token usage and costs",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccusage",
        "baseArgs": [
          "daily"
        ],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ccusage: npm install -g ccusage"
      },
      "args": [
        {
          "name": "source",
          "type": "string",
          "required": false,
          "description": "Filter by source (claude, codex, gemini, etc.)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "Output as JSON"
        }
      ]
    },
    {
      "namespace": "ccusage",
      "resource": "usage",
      "action": "weekly",
      "description": "Show weekly token usage and costs",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccusage",
        "baseArgs": [
          "weekly"
        ],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ccusage: npm install -g ccusage"
      },
      "args": [
        {
          "name": "source",
          "type": "string",
          "required": false,
          "description": "Filter by source (claude, codex, gemini, etc.)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "Output as JSON"
        }
      ]
    },
    {
      "namespace": "ccusage",
      "resource": "usage",
      "action": "monthly",
      "description": "Show monthly token usage and costs",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccusage",
        "baseArgs": [
          "monthly"
        ],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ccusage: npm install -g ccusage"
      },
      "args": [
        {
          "name": "source",
          "type": "string",
          "required": false,
          "description": "Filter by source (claude, codex, gemini, etc.)"
        },
        {
          "name": "json",
          "type": "boolean",
          "required": false,
          "description": "Output as JSON"
        }
      ]
    },
    {
      "namespace": "ccusage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ccusage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccusage",
        "passthrough": true,
        "missingDependencyHelp": "Install ccusage: npm install -g ccusage"
      },
      "args": []
    }
  ]
}