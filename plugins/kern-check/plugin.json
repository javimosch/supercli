{
  "name": "kern-check",
  "version": "0.1.0",
  "description": "Validate kerning pairs in font files for typography QA",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "kern-check" }],
  "install_guidance": {
    "plugin": "kern-check",
    "binary": "kern-check",
    "check": "which kern-check",
    "install_steps": ["cargo install kern-check", "Verify: kern-check --version", "supercli plugins install ./plugins/kern-check --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kern-check",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kern-check CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kern-check",
      "passthrough": true,
      "missingDependencyHelp": "Install kern-check: cargo install kern-check"
    },
    "args": []
  }]
}
