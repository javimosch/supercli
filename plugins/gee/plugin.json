{
  "name": "gee",
  "version": "0.1.0",
  "description": "CLI repository manager and automation tool written in rust.",
  "source": "https://github.com/human37/gee",
  "checks": [
    {
      "type": "binary",
      "name": "gee"
    }
  ],
  "install_guidance": {
    "plugin": "gee",
    "binary": "gee",
    "check": "which gee",
    "install_steps": [
      "See https://github.com/human37/gee",
      "Verify: gee --version",
      "supercli plugins install ./plugins/gee --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gee",
      "resource": "self",
      "action": "version",
      "description": "Print gee version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gee",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gee: See https://github.com/human37/gee"
      },
      "args": []
    },
    {
      "namespace": "gee",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gee CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gee",
        "passthrough": true,
        "missingDependencyHelp": "Install gee"
      },
      "args": []
    }
  ]
}