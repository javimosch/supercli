{
  "name": "BetterCapture",
  "version": "0.1.0",
  "description": "The macOS screen recorder for the rest of us - always free and open source with a native look and fe",
  "source": "https://github.com/BetterCapture/BetterCapture",
  "checks": [
    {
      "type": "binary",
      "name": "bettercapture"
    }
  ],
  "install_guidance": {
    "plugin": "BetterCapture",
    "binary": "bettercapture",
    "check": "which bettercapture",
    "install_steps": [
      "pip install bettercapture",
      "Verify: bettercapture --version",
      "supercli plugins install ./plugins/BetterCapture --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BetterCapture",
      "resource": "self",
      "action": "version",
      "description": "Print BetterCapture version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bettercapture",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BetterCapture: pip install bettercapture"
      },
      "args": []
    },
    {
      "namespace": "BetterCapture",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bettercapture CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bettercapture",
        "passthrough": true,
        "missingDependencyHelp": "Install BetterCapture: pip install bettercapture"
      },
      "args": []
    }
  ]
}