{
  "name": "aplaymidi",
  "version": "0.1.0",
  "description": "CLI tool: aplaymidi",
  "source": "https://packages.debian.org/aplaymidi",
  "checks": [{ "type": "binary", "name": "aplaymidi" }],
  "install_guidance": {
    "plugin": "aplaymidi", "binary": "aplaymidi", "check": "which aplaymidi",
    "install_steps": ["apt-get install aplaymidi 2>/dev/null || which aplaymidi", "Verify: aplaymidi --version", "supercli plugins install ./plugins/aplaymidi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aplaymidi", "resource": "_", "action": "_",
    "description": "Passthrough to aplaymidi CLI",
    "adapter": "process", "adapterConfig": { "command": "aplaymidi", "passthrough": true, "missingDependencyHelp": "Install aplaymidi: apt-get install aplaymidi" }, "args": []
  }]
}
