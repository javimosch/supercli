{
  "name": "iconvconfig",
  "version": "1.0.0",
  "description": "iconvconfig \u2014 iconvconfig \u2014 CLI utility",
  "source": "/usr/sbin/iconvconfig",
  "checks": [
    {
      "type": "binary",
      "name": "iconvconfig"
    }
  ],
  "install_guidance": {
    "plugin": "iconvconfig",
    "binary": "iconvconfig",
    "check": "which iconvconfig",
    "install_steps": [
      "# Install iconvconfig:",
      "# apt: sudo apt-get install iconvconfig",
      "# brew: brew install iconvconfig",
      "# cargo: cargo install iconvconfig",
      "# npm: npm install -g iconvconfig",
      "# pip: pip install iconvconfig",
      "# or download from /usr/sbin/iconvconfig"
    ]
  },
  "commands": [
    {
      "namespace": "iconvconfig",
      "resource": "iconvconfig",
      "action": "run",
      "description": "Run iconvconfig",
      "adapter": "process",
      "adapterConfig": {
        "command": "iconvconfig",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install iconvconfig from /usr/sbin/iconvconfig"
      },
      "args": []
    }
  ]
}