{
  "plugin": "iconvconfig",
  "binary": "iconvconfig",
  "check": "which iconvconfig",
  "install_steps": [
    "# Install iconvconfig",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/iconvconfig-linux-amd64 -o /usr/local/bin/iconvconfig",
    "chmod +x /usr/local/bin/iconvconfig",
    "# Or via package manager, see /usr/sbin/iconvconfig"
  ]
}