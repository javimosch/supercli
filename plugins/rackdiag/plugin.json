{
  "name": "rackdiag",
  "version": "0.1.0",
  "description": "Generate rack layout diagrams from simple text input",
  "source": "https://github.com/blockdiag/rackdiag",
  "checks": [{ "type": "binary", "name": "rackdiag" }],
  "install_guidance": {
    "plugin": "rackdiag",
    "binary": "rackdiag",
    "check": "which rackdiag",
    "install_steps": ["pip install rackdiag", "Verify: rackdiag --version", "supercli plugins install ./plugins/rackdiag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rackdiag",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rackdiag CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rackdiag",
      "passthrough": true,
      "missingDependencyHelp": "Install rackdiag: pip install rackdiag", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
