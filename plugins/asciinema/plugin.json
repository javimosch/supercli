{
  "name": "asciinema",
  "version": "0.1.0",
  "description": "Terminal session recorder and companion app for asciinema.org",
  "source": "https://github.com/asciinema/asciinema",
  "checks": [
    {
      "type": "binary",
      "name": "asciinema"
    }
  ],
  "install_guidance": {
    "plugin": "asciinema",
    "binary": "asciinema",
    "check": "which asciinema",
    "install_steps": [
      "cargo install asciinema",
      "Verify: asciinema --version",
      "supercli plugins install ./plugins/asciinema --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "asciinema",
      "resource": "self",
      "action": "version",
      "description": "Print asciinema version",
      "adapter": "process",
      "adapterConfig": {
        "command": "asciinema",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install asciinema: cargo install asciinema"
      },
      "args": []
    },
    {
      "namespace": "asciinema",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to asciinema CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "asciinema",
        "passthrough": true,
        "missingDependencyHelp": "Install asciinema"
      },
      "args": []
    }
  ]
}