{
  "name": "LogInsight",
  "version": "0.1.0",
  "description": "Log analysis CLI with real-time error tracking and alerts.",
  "source": "https://github.com/LogInsight/LogInsight",
  "checks": [
    {
      "type": "binary",
      "name": "LogInsight"
    }
  ],
  "install_guidance": {
    "plugin": "LogInsight",
    "binary": "LogInsight",
    "check": "which LogInsight",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: LogInsight --version",
      "supercli plugins install ./plugins/LogInsight --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "LogInsight",
      "resource": "self",
      "action": "version",
      "description": "Print LogInsight version",
      "adapter": "process",
      "adapterConfig": {
        "command": "LogInsight",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LogInsight from project repository"
      },
      "args": []
    },
    {
      "namespace": "LogInsight",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to LogInsight CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "LogInsight",
        "passthrough": true,
        "missingDependencyHelp": "Install LogInsight from project repository"
      },
      "args": []
    }
  ]
}