{
  "name": "defrag.f2fs",
  "version": "0.1.0",
  "description": "CLI tool: defrag.f2fs",
  "source": "https://manpages.debian.org/defrag.f2fs",
  "checks": [
    {
      "type": "binary",
      "name": "defrag.f2fs"
    }
  ],
  "install_guidance": {
    "plugin": "defrag.f2fs",
    "binary": "defrag.f2fs",
    "check": "which defrag.f2fs",
    "install_steps": [
      "apt-get install defrag.f2fs 2>/dev/null || which defrag.f2fs",
      "Verify: defrag.f2fs --version",
      "supercli plugins install ./plugins/defrag.f2fs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "defrag.f2fs",
      "resource": "self",
      "action": "version",
      "description": "Print defrag.f2fs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "defrag.f2fs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install defrag.f2fs: apt-get install defrag.f2fs 2>/dev/null || which defrag.f2fs"
      },
      "args": []
    },
    {
      "namespace": "defrag.f2fs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to defrag.f2fs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "defrag.f2fs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install defrag.f2fs: apt-get install defrag.f2fs 2>/dev/null || which defrag.f2fs"
      },
      "args": []
    }
  ]
}