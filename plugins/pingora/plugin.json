{
  "name": "pingora",
  "version": "0.1.0",
  "description": "A library for building fast, reliable and evolvable network services.",
  "source": "https://github.com/pingora/pingora",
  "checks": [
    {
      "type": "binary",
      "name": "pingora"
    }
  ],
  "install_guidance": {
    "plugin": "pingora",
    "binary": "pingora",
    "check": "which pingora",
    "install_steps": [
      "pip install pingora",
      "Verify: pingora --version",
      "supercli plugins install ./plugins/pingora --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pingora",
      "resource": "self",
      "action": "version",
      "description": "Print pingora version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pingora",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pingora: pip install pingora"
      },
      "args": []
    },
    {
      "namespace": "pingora",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pingora CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pingora",
        "passthrough": true,
        "missingDependencyHelp": "Install pingora: pip install pingora"
      },
      "args": []
    }
  ]
}