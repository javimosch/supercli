{
  "name": "mdlt",
  "version": "0.1.0",
  "description": "A command-line utility for quick symbolic math and arithmetic from the terminal",
  "source": "https://github.com/metadelta/mdlt",
  "checks": [
    {
      "type": "binary",
      "name": "mdlt"
    }
  ],
  "install_guidance": {
    "plugin": "mdlt",
    "binary": "mdlt",
    "check": "which mdlt",
    "install_steps": [
      "npm i -g mdlt",
      "Verify: mdlt --help"
    ],
    "note": "Available via npm. Lightweight CLI tool for quick symbolic math. Source: https://github.com/metadelta/mdlt. Written in JavaScript."
  },
  "commands": [
    {
      "namespace": "mdlt",
      "resource": "self",
      "action": "version",
      "description": "Print mdlt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdlt",
        "missingDependencyHelp": "Install: npm i -g mdlt",
        "baseArgs": ["--help"]
      },
      "args": []
    },
    {
      "namespace": "mdlt",
      "resource": "calc",
      "action": "derive",
      "description": "Compute the derivative of an expression",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdlt",
        "baseArgs": ["derive"],
        "missingDependencyHelp": "Install: npm i -g mdlt"
      },
      "args": [
        {
          "name": "expression",
          "type": "string",
          "required": true,
          "description": "Expression to differentiate (e.g. 'x^2')",
          "positional": true
        }
      ]
    },
    {
      "namespace": "mdlt",
      "resource": "calc",
      "action": "integrate",
      "description": "Compute the integral of an expression",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdlt",
        "baseArgs": ["integrate"],
        "missingDependencyHelp": "Install: npm i -g mdlt"
      },
      "args": [
        {
          "name": "expression",
          "type": "string",
          "required": true,
          "description": "Expression to integrate (e.g. 'x^2')",
          "positional": true
        }
      ]
    },
    {
      "namespace": "mdlt",
      "resource": "calc",
      "action": "simplify",
      "description": "Simplify an algebraic expression",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdlt",
        "baseArgs": ["simplify"],
        "missingDependencyHelp": "Install: npm i -g mdlt"
      },
      "args": [
        {
          "name": "expression",
          "type": "string",
          "required": true,
          "description": "Expression to simplify (e.g. 'x + x + 2*8')",
          "positional": true
        }
      ]
    },
    {
      "namespace": "mdlt",
      "resource": "calc",
      "action": "factor",
      "description": "Factor an algebraic expression",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdlt",
        "baseArgs": ["factor"],
        "missingDependencyHelp": "Install: npm i -g mdlt"
      },
      "args": [
        {
          "name": "expression",
          "type": "string",
          "required": true,
          "description": "Expression to factor (e.g. 'x^2 - 1')",
          "positional": true
        }
      ]
    },
    {
      "namespace": "mdlt",
      "resource": "calc",
      "action": "evaluate",
      "description": "Evaluate a numeric expression",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdlt",
        "baseArgs": [],
        "missingDependencyHelp": "Install: npm i -g mdlt"
      },
      "args": [
        {
          "name": "expression",
          "type": "string",
          "required": true,
          "description": "Numeric expression to evaluate (e.g. '2 + 2')",
          "positional": true
        }
      ]
    },
    {
      "namespace": "mdlt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mdlt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdlt",
        "passthrough": true,
        "missingDependencyHelp": "Install: npm i -g mdlt"
      },
      "args": []
    }
  ]
}
