{
  "name": "splitfont",
  "version": "0.1.0",
  "description": "CLI tool: splitfont",
  "source": "https://manpages.debian.org/splitfont",
  "checks": [
    {
      "type": "binary",
      "name": "splitfont"
    }
  ],
  "install_guidance": {
    "plugin": "splitfont",
    "binary": "splitfont",
    "check": "which splitfont",
    "install_steps": [
      "apt-get install splitfont 2>/dev/null || which splitfont",
      "Verify: splitfont --version",
      "supercli plugins install ./plugins/splitfont --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "splitfont",
      "resource": "self",
      "action": "version",
      "description": "Print splitfont version",
      "adapter": "process",
      "adapterConfig": {
        "command": "splitfont",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install splitfont: apt-get install splitfont 2>/dev/null || which splitfont"
      },
      "args": []
    },
    {
      "namespace": "splitfont",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to splitfont CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "splitfont",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install splitfont: apt-get install splitfont 2>/dev/null || which splitfont"
      },
      "args": []
    }
  ]
}