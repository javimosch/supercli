{
  "name": "elm-format",
  "version": "0.1.0",
  "description": "Elm source code formatter, inspired by gofmt",
  "source": "https://github.com/avh4/elm-format",
  "checks": [
    {
      "type": "binary",
      "name": "elm-format"
    }
  ],
  "install_guidance": {
    "plugin": "elm-format",
    "binary": "elm-format",
    "check": "which elm-format",
    "install_steps": [
      "brew install elm-format",
      "Verify: elm-format --version",
      "supercli plugins install ./plugins/elm-format --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "elm-format",
      "resource": "self",
      "action": "version",
      "description": "Print elm-format version",
      "adapter": "process",
      "adapterConfig": {
        "command": "elm-format",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install elm-format: brew install elm-format"
      },
      "args": []
    },
    {
      "namespace": "elm-format",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to elm-format CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "elm-format",
        "passthrough": true,
        "missingDependencyHelp": "Install elm-format"
      },
      "args": []
    }
  ]
}