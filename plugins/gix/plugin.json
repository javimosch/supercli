{
  "name": "gix",
  "version": "0.1.0",
  "description": "Pure Rust Git implementation with extensive CLI tools",
  "source": "https://github.com/Byron/gitoxide",
  "checks": [{ "type": "binary", "name": "gix" }],
  "install_guidance": {
    "plugin": "gix",
    "binary": "gix",
    "check": "which gix",
    "install_steps": ["cargo install gix", "Verify: gix --version", "supercli plugins install ./plugins/gix --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gix",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gix CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gix",
      "passthrough": true,
      "missingDependencyHelp": "Install gix: cargo install gix"
    },
    "args": []
  }]
}
