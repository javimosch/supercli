{
  "name": "foxglove-cli",
  "version": "0.1.0",
  "description": "Foxglove command-line tool",
  "source": "https://github.com/foxglove/foxglove-cli",
  "checks": [
    {
      "type": "binary",
      "name": "foxglove-cli"
    }
  ],
  "install_guidance": {
    "plugin": "foxglove-cli",
    "binary": "foxglove-cli",
    "check": "which foxglove-cli",
    "install_steps": [
      "brew install foxglove-cli",
      "Verify: foxglove-cli --version",
      "supercli plugins install ./plugins/foxglove-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "foxglove-cli",
      "resource": "self",
      "action": "version",
      "description": "Print foxglove-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "foxglove-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install foxglove-cli: brew install foxglove-cli"
      },
      "args": []
    },
    {
      "namespace": "foxglove-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to foxglove-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "foxglove-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install foxglove-cli"
      },
      "args": []
    }
  ]
}