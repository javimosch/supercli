{
  "name": "py.test-benchmark",
  "version": "0.1.0",
  "description": "CLI tool: py.test-benchmark",
  "source": "https://manpages.debian.org/py.test-benchmark",
  "checks": [
    {
      "type": "binary",
      "name": "py.test-benchmark"
    }
  ],
  "install_guidance": {
    "plugin": "py.test-benchmark",
    "binary": "py.test-benchmark",
    "check": "which py.test-benchmark",
    "install_steps": [
      "apt-get install py.test-benchmark 2>/dev/null || which py.test-benchmark",
      "Verify: py.test-benchmark --version",
      "supercli plugins install ./plugins/py.test-benchmark --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "py.test-benchmark",
      "resource": "self",
      "action": "version",
      "description": "Print py.test-benchmark version",
      "adapter": "process",
      "adapterConfig": {
        "command": "py.test-benchmark",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install py.test-benchmark: apt-get install py.test-benchmark 2>/dev/null || which py.test-benchmark"
      },
      "args": []
    },
    {
      "namespace": "py.test-benchmark",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to py.test-benchmark CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "py.test-benchmark",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install py.test-benchmark: apt-get install py.test-benchmark 2>/dev/null || which py.test-benchmark"
      },
      "args": []
    }
  ]
}