{
  "name": "pg_dump",
  "version": "0.1.0",
  "description": "PostgreSQL database dump",
  "source": "https://packages.debian.org/pg_dump",
  "checks": [{ "type": "binary", "name": "pg_dump" }],
  "install_guidance": {
    "plugin": "pg_dump", "binary": "pg_dump", "check": "which pg_dump",
    "install_steps": ["apt-get install postgresql-client", "Verify: pg_dump --version", "supercli plugins install ./plugins/pg_dump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pg_dump", "resource": "_", "action": "_",
    "description": "Passthrough to pg_dump CLI",
    "adapter": "process", "adapterConfig": { "command": "pg_dump", "passthrough": true, "missingDependencyHelp": "Install pg_dump: apt-get install postgresql-client" }, "args": []
  }]
}
