{
  "name": "boring.notch",
  "version": "0.1.0",
  "description": "TheBoringNotch: Not so boring notch That Rocks \ud83c\udfb8\ud83c\udfb6",
  "source": "https://github.com/boring.notch/boring.notch",
  "checks": [
    {
      "type": "binary",
      "name": "boring.notch"
    }
  ],
  "install_guidance": {
    "plugin": "boring.notch",
    "binary": "boring.notch",
    "check": "which boring.notch",
    "install_steps": [
      "pip install boring.notch",
      "Verify: boring.notch --version",
      "supercli plugins install ./plugins/boring.notch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "boring.notch",
      "resource": "self",
      "action": "version",
      "description": "Print boring.notch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "boring.notch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install boring.notch: pip install boring.notch"
      },
      "args": []
    },
    {
      "namespace": "boring.notch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to boring.notch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "boring.notch",
        "passthrough": true,
        "missingDependencyHelp": "Install boring.notch: pip install boring.notch"
      },
      "args": []
    }
  ]
}