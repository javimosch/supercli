{
  "name": "proselint",
  "version": "0.1.0",
  "description": "Prose linter for writing style checking",
  "source": "https://github.com/amperser/proselint",
  "checks": [
    {
      "type": "binary",
      "name": "proselint"
    }
  ],
  "install_guidance": {
    "plugin": "proselint",
    "binary": "proselint",
    "check": "which proselint",
    "install_steps": [
      "pip install proselint",
      "Verify: proselint --version",
      "supercli plugins install ./plugins/proselint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "proselint",
      "resource": "self",
      "action": "version",
      "description": "Print proselint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "proselint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install proselint: pip install proselint"
      },
      "args": []
    },
    {
      "namespace": "proselint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to proselint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "proselint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install proselint: pip install proselint"
      },
      "args": []
    }
  ]
}
