{
  "name": "ldid-procursus",
  "version": "0.1.0",
  "description": "Put real or fake signatures in a Mach-O binary",
  "source": "https://github.com/ProcursusTeam/ldid",
  "checks": [
    {
      "type": "binary",
      "name": "ldid-procursus"
    }
  ],
  "install_guidance": {
    "plugin": "ldid-procursus",
    "binary": "ldid-procursus",
    "check": "which ldid-procursus",
    "install_steps": [
      "brew install ldid-procursus",
      "Verify: ldid-procursus --version",
      "supercli plugins install ./plugins/ldid-procursus --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ldid-procursus",
      "resource": "self",
      "action": "version",
      "description": "Print ldid-procursus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldid-procursus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ldid-procursus: brew install ldid-procursus"
      },
      "args": []
    },
    {
      "namespace": "ldid-procursus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ldid-procursus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldid-procursus",
        "passthrough": true,
        "missingDependencyHelp": "Install ldid-procursus"
      },
      "args": []
    }
  ]
}