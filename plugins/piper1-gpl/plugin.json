{
  "name": "piper1-gpl",
  "version": "0.1.0",
  "description": "Fast and local neural text-to-speech engine",
  "source": "https://github.com/piper1-gpl/piper1-gpl",
  "checks": [
    {
      "type": "binary",
      "name": "piper1-gpl"
    }
  ],
  "install_guidance": {
    "plugin": "piper1-gpl",
    "binary": "piper1-gpl",
    "check": "which piper1-gpl",
    "install_steps": [
      "pip install piper1-gpl",
      "Verify: piper1-gpl --version",
      "supercli plugins install ./plugins/piper1-gpl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "piper1-gpl",
      "resource": "self",
      "action": "version",
      "description": "Print piper1-gpl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "piper1-gpl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install piper1-gpl: pip install piper1-gpl"
      },
      "args": []
    },
    {
      "namespace": "piper1-gpl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to piper1-gpl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "piper1-gpl",
        "passthrough": true,
        "missingDependencyHelp": "Install piper1-gpl: pip install piper1-gpl"
      },
      "args": []
    }
  ]
}