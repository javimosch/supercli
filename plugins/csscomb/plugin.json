{
  "name": "csscomb",
  "version": "0.1.0",
  "description": "CSS coding style formatter",
  "source": "https://github.com/csscomb/csscomb",
  "checks": [
    {
      "type": "binary",
      "name": "csscomb"
    }
  ],
  "install_guidance": {
    "plugin": "csscomb",
    "binary": "csscomb",
    "check": "which csscomb",
    "install_steps": [
      "npm install -g csscomb",
      "Verify: csscomb --version",
      "supercli plugins install ./plugins/csscomb --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "csscomb",
      "resource": "self",
      "action": "version",
      "description": "Print csscomb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csscomb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csscomb: npm install -g csscomb"
      },
      "args": []
    },
    {
      "namespace": "csscomb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csscomb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csscomb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install csscomb: npm install -g csscomb"
      },
      "args": []
    }
  ]
}
