{
  "name": "prise",
  "version": "0.1.0",
  "description": "a terminal multiplexer for modern terminals",
  "source": "https://github.com/prise/prise",
  "checks": [
    {
      "type": "binary",
      "name": "prise"
    }
  ],
  "install_guidance": {
    "plugin": "prise",
    "binary": "prise",
    "check": "which prise",
    "install_steps": [
      "pip install prise",
      "Verify: prise --version",
      "supercli plugins install ./plugins/prise --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "prise",
      "resource": "self",
      "action": "version",
      "description": "Print prise version",
      "adapter": "process",
      "adapterConfig": {
        "command": "prise",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install prise: pip install prise"
      },
      "args": []
    },
    {
      "namespace": "prise",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to prise CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "prise",
        "passthrough": true,
        "missingDependencyHelp": "Install prise: pip install prise"
      },
      "args": []
    }
  ]
}