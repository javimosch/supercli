{
  "name": "sql-formatter",
  "version": "0.1.0",
  "description": "Node.js based formatter for pretty-printing SQL",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "sql-formatter" }],
  "install_guidance": {
    "plugin": "sql-formatter",
    "binary": "sql-formatter",
    "check": "which sql-formatter",
    "install_steps": ["npm install -g sql-formatter", "Verify: sql-formatter --version", "supercli plugins install ./plugins/sql-formatter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sql-formatter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sql-formatter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sql-formatter",
      "passthrough": true,
      "missingDependencyHelp": "Install sql-formatter: npm install -g sql-formatter"
    },
    "args": []
  }]
}
