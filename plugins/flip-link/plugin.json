{
  "name": "flip-link",
  "version": "0.1.0",
  "description": "Adds zero-cost stack overflow protection to your embedded programs",
  "source": "https://github.com/knurling-rs/flip-link",
  "checks": [
    {
      "type": "binary",
      "name": "flip-link"
    }
  ],
  "install_guidance": {
    "plugin": "flip-link",
    "binary": "flip-link",
    "check": "which flip-link",
    "install_steps": [
      "brew install flip-link",
      "Verify: flip-link --version",
      "supercli plugins install ./plugins/flip-link --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "flip-link",
      "resource": "self",
      "action": "version",
      "description": "Print flip-link version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flip-link",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flip-link: brew install flip-link"
      },
      "args": []
    },
    {
      "namespace": "flip-link",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flip-link CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flip-link",
        "passthrough": true,
        "missingDependencyHelp": "Install flip-link"
      },
      "args": []
    }
  ]
}