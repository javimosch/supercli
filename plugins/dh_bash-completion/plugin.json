{
  "name": "dh_bash-completion",
  "version": "0.1.0",
  "description": "CLI tool: dh_bash-completion",
  "source": "https://packages.debian.org/dh_bash-completion",
  "checks": [{ "type": "binary", "name": "dh_bash-completion" }],
  "install_guidance": {
    "plugin": "dh_bash-completion", "binary": "dh_bash-completion", "check": "which dh_bash-completion",
    "install_steps": ["apt-get install dh_bash-completion 2>/dev/null || which dh_bash-completion", "Verify: dh_bash-completion --version", "supercli plugins install ./plugins/dh_bash-completion --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_bash-completion", "resource": "_", "action": "_",
    "description": "Passthrough to dh_bash-completion CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_bash-completion", "passthrough": true, "missingDependencyHelp": "Install dh_bash-completion: apt-get install dh_bash-completion" }, "args": []
  }]
}
