{
  "name": "gdzig",
  "version": "0.1.0",
  "description": "Zig bindings for Godot 4",
  "source": "https://github.com/gdzig/gdzig",
  "checks": [
    {
      "type": "binary",
      "name": "gdzig"
    }
  ],
  "install_guidance": {
    "plugin": "gdzig",
    "binary": "gdzig",
    "check": "which gdzig",
    "install_steps": [
      "pip install gdzig",
      "Verify: gdzig --version",
      "supercli plugins install ./plugins/gdzig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdzig",
      "resource": "self",
      "action": "version",
      "description": "Print gdzig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdzig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdzig: pip install gdzig"
      },
      "args": []
    },
    {
      "namespace": "gdzig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdzig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdzig",
        "passthrough": true,
        "missingDependencyHelp": "Install gdzig: pip install gdzig"
      },
      "args": []
    }
  ]
}