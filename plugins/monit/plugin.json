{
  "name": "monit",
  "version": "0.1.0",
  "description": "Process and system monitoring agent with automatic recovery",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "monit" }],
  "install_guidance": {
    "plugin": "monit",
    "binary": "monit",
    "check": "which monit",
    "install_steps": ["sudo apt install monit", "Verify: monit --version", "supercli plugins install ./plugins/monit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "monit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to monit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "monit",
      "passthrough": true,
      "missingDependencyHelp": "Install monit: sudo apt install monit"
    },
    "args": []
  }]
}
