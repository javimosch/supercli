{
  "name": "tpp",
  "version": "0.1.0",
  "description": "(text presentation program) - a ncurses Ruby program that allows producing nice text-based presentation with simple markup language.",
  "source": "https://github.com/Kerrick/tpp",
  "checks": [
    {
      "type": "binary",
      "name": "tpp"
    }
  ],
  "install_guidance": {
    "plugin": "tpp",
    "binary": "tpp",
    "check": "which tpp",
    "install_steps": [
      "See https://github.com/Kerrick/tpp",
      "Verify: tpp --version",
      "supercli plugins install ./plugins/tpp --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "tpp",
      "resource": "self",
      "action": "version",
      "description": "Print tpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tpp: See https://github.com/Kerrick/tpp"
      },
      "args": []
    },
    {
      "namespace": "tpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tpp",
        "passthrough": true,
        "missingDependencyHelp": "Install tpp"
      },
      "args": []
    }
  ]
}