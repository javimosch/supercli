{
  "name": "apiark",
  "version": "0.1.0",
  "description": "Minimalist CLI for REST and JSON API request testing",
  "source": "https://github.com/apiark/cli",
  "checks": [{ "type": "binary", "name": "apiark" }],
  "install_guidance": {
    "plugin": "apiark",
    "binary": "apiark",
    "check": "which apiark",
    "install_steps": ["git clone and install", "Verify: apiark --version", "supercli plugins install ./plugins/apiark --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apiark",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to apiark CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "apiark",
      "passthrough": true,
      "missingDependencyHelp": "Install apiark: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
