{
  "name": "cargo-about",
  "version": "0.1.0",
  "description": "Generate license and dependency reports for Rust crates",
  "source": "https://github.com/EmbarkStudios/cargo-about",
  "checks": [{ "type": "binary", "name": "cargo-about" }],
  "install_guidance": {
    "plugin": "cargo-about",
    "binary": "cargo-about",
    "check": "which cargo-about",
    "install_steps": ["cargo install cargo-about", "Verify: cargo-about --version", "supercli plugins install ./plugins/cargo-about --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-about",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-about CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-about",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-about: cargo install cargo-about", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
