{
  "name": "rclip",
  "version": "0.1.0",
  "description": "Semantic photo search",
  "source": "https://github.com/yurijmikhalevich/rclip",
  "checks": [
    {
      "type": "binary",
      "name": "rclip"
    }
  ],
  "install_guidance": {
    "plugin": "rclip",
    "binary": "rclip",
    "check": "which rclip",
    "install_steps": [
      "See https://github.com/yurijmikhalevich/rclip",
      "Verify: rclip --version",
      "supercli plugins install ./plugins/rclip --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "rclip",
      "resource": "self",
      "action": "version",
      "description": "Print rclip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rclip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rclip: See https://github.com/yurijmikhalevich/rclip"
      },
      "args": []
    },
    {
      "namespace": "rclip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rclip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rclip",
        "passthrough": true,
        "missingDependencyHelp": "Install rclip"
      },
      "args": []
    }
  ]
}