{
  "name": "BitNet",
  "version": "0.1.0",
  "description": "Official inference framework for 1-bit LLMs",
  "source": "https://github.com/BitNet/BitNet",
  "checks": [
    {
      "type": "binary",
      "name": "bitnet"
    }
  ],
  "install_guidance": {
    "plugin": "BitNet",
    "binary": "bitnet",
    "check": "which bitnet",
    "install_steps": [
      "pip install bitnet",
      "Verify: bitnet --version",
      "supercli plugins install ./plugins/BitNet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BitNet",
      "resource": "self",
      "action": "version",
      "description": "Print BitNet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitnet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BitNet: pip install bitnet"
      },
      "args": []
    },
    {
      "namespace": "BitNet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bitnet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitnet",
        "passthrough": true,
        "missingDependencyHelp": "Install BitNet: pip install bitnet"
      },
      "args": []
    }
  ]
}