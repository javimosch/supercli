{
  "name": "ketch",
  "version": "0.1.0",
  "description": "Application delivery framework on Kubernetes",
  "source": "https://github.com/shipa-corp/ketch",
  "checks": [{ "type": "binary", "name": "ketch" }],
  "install_guidance": {
    "plugin": "ketch",
    "binary": "ketch",
    "check": "which ketch",
    "install_steps": ["brew install ketch", "Verify: ketch --version", "supercli plugins install ./plugins/ketch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ketch",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ketch CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ketch",
      "passthrough": true,
      "missingDependencyHelp": "Install ketch: brew install ketch"
    },
    "args": []
  }]
}
