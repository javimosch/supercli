{
  "name": "PDF-to-CBZ",
  "version": "0.1.0",
  "description": "Bidirectional converter for PDF and comic book archive formats",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "PDF-to-CBZ" }],
  "install_guidance": {
    "plugin": "PDF-to-CBZ",
    "binary": "PDF-to-CBZ",
    "check": "which PDF-to-CBZ",
    "install_steps": ["git clone && pip install .", "Verify: PDF-to-CBZ --version", "supercli plugins install ./plugins/PDF-to-CBZ --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "PDF-to-CBZ",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to PDF-to-CBZ CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "PDF-to-CBZ",
      "passthrough": true,
      "missingDependencyHelp": "Install PDF-to-CBZ: git clone && pip install ."
    },
    "args": []
  }]
}
