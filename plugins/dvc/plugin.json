{
  "name": "dvc",
  "version": "0.1.0",
  "description": "Data Version Control for machine learning projects and datasets",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "dvc" }],
  "install_guidance": {
    "plugin": "dvc",
    "binary": "dvc",
    "check": "which dvc",
    "install_steps": ["pip install dvc", "Verify: dvc --version", "supercli plugins install ./plugins/dvc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dvc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dvc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dvc",
      "passthrough": true,
      "missingDependencyHelp": "Install dvc: pip install dvc"
    },
    "args": []
  }]
}
