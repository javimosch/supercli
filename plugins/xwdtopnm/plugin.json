{
  "name": "xwdtopnm",
  "version": "0.1.0",
  "description": "CLI tool: xwdtopnm",
  "source": "https://manpages.debian.org/xwdtopnm",
  "checks": [
    {
      "type": "binary",
      "name": "xwdtopnm"
    }
  ],
  "install_guidance": {
    "plugin": "xwdtopnm",
    "binary": "xwdtopnm",
    "check": "which xwdtopnm",
    "install_steps": [
      "apt-get install xwdtopnm 2>/dev/null || which xwdtopnm",
      "Verify: xwdtopnm --version",
      "supercli plugins install ./plugins/xwdtopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xwdtopnm",
      "resource": "self",
      "action": "version",
      "description": "Print xwdtopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xwdtopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xwdtopnm: apt-get install xwdtopnm 2>/dev/null || which xwdtopnm"
      },
      "args": []
    },
    {
      "namespace": "xwdtopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xwdtopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xwdtopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xwdtopnm: apt-get install xwdtopnm 2>/dev/null || which xwdtopnm"
      },
      "args": []
    }
  ]
}