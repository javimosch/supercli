{
  "name": "dfmt",
  "version": "0.1.0",
  "description": "Formatter for D source code",
  "source": "https://github.com/dlang-community/dfmt",
  "checks": [
    {
      "type": "binary",
      "name": "dfmt"
    }
  ],
  "install_guidance": {
    "plugin": "dfmt",
    "binary": "dfmt",
    "check": "which dfmt",
    "install_steps": [
      "brew install dfmt",
      "Verify: dfmt --version",
      "supercli plugins install ./plugins/dfmt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dfmt",
      "resource": "self",
      "action": "version",
      "description": "Print dfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dfmt: brew install dfmt"
      },
      "args": []
    },
    {
      "namespace": "dfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install dfmt"
      },
      "args": []
    }
  ]
}