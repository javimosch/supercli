{
  "name": "emp",
  "version": "0.1.0",
  "description": "CLI for Empire",
  "source": "https://github.com/remind101/empire",
  "checks": [
    {
      "type": "binary",
      "name": "emp"
    }
  ],
  "install_guidance": {
    "plugin": "emp",
    "binary": "emp",
    "check": "which emp",
    "install_steps": [
      "brew install emp",
      "Verify: emp --version",
      "supercli plugins install ./plugins/emp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "emp",
      "resource": "self",
      "action": "version",
      "description": "Print emp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "emp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install emp: brew install emp"
      },
      "args": []
    },
    {
      "namespace": "emp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to emp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "emp",
        "passthrough": true,
        "missingDependencyHelp": "Install emp"
      },
      "args": []
    }
  ]
}