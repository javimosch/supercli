{
  "name": "vendir",
  "version": "0.1.0",
  "description": "Declaratively manage vendor directories for your project",
  "source": "https://github.com/carvel-dev/vendir",
  "checks": [{ "type": "binary", "name": "vendir" }],
  "install_guidance": {
    "plugin": "vendir",
    "binary": "vendir",
    "check": "which vendir",
    "install_steps": ["brew install vendir", "Verify: vendir --version", "supercli plugins install ./plugins/vendir --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vendir",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vendir CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vendir",
      "passthrough": true,
      "missingDependencyHelp": "Install vendir: brew install vendir"
    },
    "args": []
  }]
}
