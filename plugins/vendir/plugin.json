{
  "name": "vendir",
  "version": "0.1.0",
  "description": "Vendor directory manager",
  "source": "https://packages.debian.org/vendir",
  "checks": [{ "type": "binary", "name": "vendir" }],
  "install_guidance": {
    "plugin": "vendir", "binary": "vendir", "check": "which vendir",
    "install_steps": ["apt-get install vendir", "Verify: vendir --version", "supercli plugins install ./plugins/vendir --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vendir", "resource": "_", "action": "_",
    "description": "Passthrough to vendir CLI",
    "adapter": "process", "adapterConfig": { "command": "vendir", "passthrough": true, "missingDependencyHelp": "Install vendir: apt-get install vendir" }, "args": []
  }]
}
