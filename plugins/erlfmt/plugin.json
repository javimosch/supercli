{
  "name": "erlfmt",
  "version": "0.1.0",
  "description": "Automated code formatter for Erlang",
  "source": "https://github.com/WhatsApp/erlfmt",
  "checks": [
    {
      "type": "binary",
      "name": "erlfmt"
    }
  ],
  "install_guidance": {
    "plugin": "erlfmt",
    "binary": "erlfmt",
    "check": "which erlfmt",
    "install_steps": [
      "brew install erlfmt",
      "Verify: erlfmt --version",
      "supercli plugins install ./plugins/erlfmt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "erlfmt",
      "resource": "self",
      "action": "version",
      "description": "Print erlfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "erlfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install erlfmt: brew install erlfmt"
      },
      "args": []
    },
    {
      "namespace": "erlfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to erlfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "erlfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install erlfmt"
      },
      "args": []
    }
  ]
}