{
  "name": "deepl-cli",
  "version": "0.1.0",
  "description": "deepl-cli — DeepL translation client for the command line. Translate text between supported languages with formal/informal tone options, glossary support, and file translation. Outputs plain text or JSON for programmatic consumption.",
  "source": "https://github.com/ffflorian/deepl-cli",
  "checks": [
    {
      "type": "binary",
      "name": "deepl-cli"
    }
  ],
  "install_guidance": {
    "plugin": "deepl-cli",
    "binary": "deepl-cli",
    "check": "which deepl-cli",
    "install_steps": [
      "npm install -g deepl-cli",
      "Verify: deepl-cli --version",
      "supercli plugins install ./plugins/deepl-cli --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "deepl-cli",
      "resource": "self",
      "action": "version",
      "description": "Print deepl-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepl-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install deepl-cli: npm install -g deepl-cli"
      },
      "args": []
    },
    {
      "namespace": "deepl-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deepl-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepl-cli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install deepl-cli: npm install -g deepl-cli"
      },
      "args": []
    }
  ]
}
