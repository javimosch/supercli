{
  "name": "mobi-convert",
  "version": "0.1.0",
  "description": "Convert files to Kindle MOBI ebook format from CLI",
  "source": "https://github.com/johndoe/mobi-convert",
  "checks": [{ "type": "binary", "name": "mobi-convert" }],
  "install_guidance": {
    "plugin": "mobi-convert",
    "binary": "mobi-convert",
    "check": "which mobi-convert",
    "install_steps": ["pip install mobi-convert", "Verify: mobi-convert --version", "supercli plugins install ./plugins/mobi-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mobi-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mobi-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mobi-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install mobi-convert: pip install mobi-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
