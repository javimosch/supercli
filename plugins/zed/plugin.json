{
  "name": "zed",
  "version": "0.1.0",
  "description": "High-performance code editor with built-in AI",
  "source": "https://github.com/zed-industries/zed",
  "checks": [{ "type": "binary", "name": "zed" }],
  "install_guidance": {
    "plugin": "zed",
    "binary": "zed",
    "check": "which zed",
    "install_steps": ["brew install zed", "Verify: zed --version", "supercli plugins install ./plugins/zed --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zed",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zed CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zed",
      "passthrough": true,
      "missingDependencyHelp": "Install zed: brew install zed", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
