{
  "name": "dee-gas",
  "version": "0.1.0",
  "description": "Look up gas prices from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-gas" }],
  "install_guidance": {
    "plugin": "dee-gas",
    "binary": "dee-gas",
    "check": "which dee-gas",
    "install_steps": ["cargo install dee-gas", "Verify: dee-gas --version", "supercli plugins install ./plugins/dee-gas --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-gas",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-gas CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-gas",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-gas: cargo install dee-gas"
    },
    "args": []
  }]
}
