{
  "name": "kube-hunter",
  "version": "0.1.0",
  "description": "Penetration testing tool for Kubernetes clusters",
  "source": "https://github.com/aquasecurity/kube-hunter",
  "checks": [{ "type": "binary", "name": "kube-hunter" }],
  "install_guidance": {
    "plugin": "kube-hunter",
    "binary": "kube-hunter",
    "check": "which kube-hunter",
    "install_steps": ["pip install kube-hunter", "Verify: kube-hunter --version", "supercli plugins install ./plugins/kube-hunter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kube-hunter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kube-hunter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kube-hunter",
      "passthrough": true,
      "missingDependencyHelp": "Install kube-hunter: pip install kube-hunter"
    },
    "args": []
  }]
}
