{
  "name": "gts2xyz",
  "version": "0.1.0",
  "description": "CLI tool: gts2xyz",
  "source": "https://manpages.debian.org/gts2xyz",
  "checks": [
    {
      "type": "binary",
      "name": "gts2xyz"
    }
  ],
  "install_guidance": {
    "plugin": "gts2xyz",
    "binary": "gts2xyz",
    "check": "which gts2xyz",
    "install_steps": [
      "apt-get install gts2xyz 2>/dev/null || which gts2xyz",
      "Verify: gts2xyz --version",
      "supercli plugins install ./plugins/gts2xyz --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gts2xyz",
      "resource": "self",
      "action": "version",
      "description": "Print gts2xyz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gts2xyz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gts2xyz: apt-get install gts2xyz 2>/dev/null || which gts2xyz"
      },
      "args": []
    },
    {
      "namespace": "gts2xyz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gts2xyz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gts2xyz",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gts2xyz: apt-get install gts2xyz 2>/dev/null || which gts2xyz"
      },
      "args": []
    }
  ]
}