{
  "name": "cpgr",
  "version": "1.0.0",
  "description": "cpgr \u2014 cpgr \u2014 CLI utility",
  "source": "/usr/sbin/cpgr",
  "checks": [
    {
      "type": "binary",
      "name": "cpgr"
    }
  ],
  "install_guidance": {
    "plugin": "cpgr",
    "binary": "cpgr",
    "check": "which cpgr",
    "install_steps": [
      "# Install cpgr:",
      "# apt: sudo apt-get install cpgr",
      "# brew: brew install cpgr",
      "# cargo: cargo install cpgr",
      "# npm: npm install -g cpgr",
      "# pip: pip install cpgr",
      "# or download from /usr/sbin/cpgr"
    ]
  },
  "commands": [
    {
      "namespace": "cpgr",
      "resource": "cpgr",
      "action": "run",
      "description": "Run cpgr",
      "adapter": "process",
      "adapterConfig": {
        "command": "cpgr",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cpgr from /usr/sbin/cpgr"
      },
      "args": []
    }
  ]
}