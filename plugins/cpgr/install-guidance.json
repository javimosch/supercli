{
  "plugin": "cpgr",
  "binary": "cpgr",
  "check": "which cpgr",
  "install_steps": [
    "# Install cpgr",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/cpgr-linux-amd64 -o /usr/local/bin/cpgr",
    "chmod +x /usr/local/bin/cpgr",
    "# Or via package manager, see /usr/sbin/cpgr"
  ]
}