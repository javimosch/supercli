{
  "name": "git-who",
  "version": "0.1.0",
  "description": "Git blame for file trees",
  "source": "https://github.com/sinclairtarget/git-who",
  "checks": [
    {
      "type": "binary",
      "name": "git-who"
    }
  ],
  "install_guidance": {
    "plugin": "git-who",
    "binary": "git-who",
    "check": "which git-who",
    "install_steps": [
      "brew install git-who",
      "Verify: git-who --version",
      "supercli plugins install ./plugins/git-who --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-who",
      "resource": "self",
      "action": "version",
      "description": "Print git-who version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-who",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-who: brew install git-who"
      },
      "args": []
    },
    {
      "namespace": "git-who",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-who CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-who",
        "passthrough": true,
        "missingDependencyHelp": "Install git-who"
      },
      "args": []
    }
  ]
}