{
  "name": "cfssljson",
  "version": "0.1.0",
  "description": "Convert CFSSL JSON certificate bundles into individual files",
  "source": "https://github.com/cloudflare/cfssl",
  "checks": [{ "type": "binary", "name": "cfssljson" }],
  "install_guidance": {
    "plugin": "cfssljson",
    "binary": "cfssljson",
    "check": "which cfssljson",
    "install_steps": ["go install github.com/cloudflare/cfssl/cmd/cfssljson@latest", "Verify: cfssljson --version", "supercli plugins install ./plugins/cfssljson --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cfssljson",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cfssljson CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cfssljson",
      "passthrough": true,
      "missingDependencyHelp": "Install cfssljson: go install github.com/cloudflare/cfssl/cmd/cfssljson@latest"
    },
    "args": []
  }]
}
