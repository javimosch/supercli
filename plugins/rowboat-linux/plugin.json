{
  "name": "rowboat-linux",
  "version": "0.1.0",
  "description": "CLI tool: rowboat-linux",
  "source": "https://manpages.debian.org/rowboat-linux",
  "checks": [
    {
      "type": "binary",
      "name": "rowboat-linux"
    }
  ],
  "install_guidance": {
    "plugin": "rowboat-linux",
    "binary": "rowboat-linux",
    "check": "which rowboat-linux",
    "install_steps": [
      "apt-get install rowboat-linux 2>/dev/null || which rowboat-linux",
      "Verify: rowboat-linux --version",
      "supercli plugins install ./plugins/rowboat-linux --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rowboat-linux",
      "resource": "self",
      "action": "version",
      "description": "Print rowboat-linux version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rowboat-linux",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rowboat-linux: apt-get install rowboat-linux 2>/dev/null || which rowboat-linux"
      },
      "args": []
    },
    {
      "namespace": "rowboat-linux",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rowboat-linux CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rowboat-linux",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rowboat-linux: apt-get install rowboat-linux 2>/dev/null || which rowboat-linux"
      },
      "args": []
    }
  ]
}