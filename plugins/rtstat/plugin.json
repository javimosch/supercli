{
  "name": "rtstat",
  "version": "1.0.0",
  "description": "rtstat \u2014 rtstat \u2014 CLI utility",
  "source": "/usr/bin/rtstat",
  "checks": [
    {
      "type": "binary",
      "name": "rtstat"
    }
  ],
  "install_guidance": {
    "plugin": "rtstat",
    "binary": "rtstat",
    "check": "which rtstat",
    "install_steps": [
      "# Install rtstat:",
      "# apt: sudo apt-get install rtstat",
      "# brew: brew install rtstat",
      "# cargo: cargo install rtstat",
      "# npm: npm install -g rtstat",
      "# pip: pip install rtstat",
      "# or download from /usr/bin/rtstat"
    ]
  },
  "commands": [
    {
      "namespace": "rtstat",
      "resource": "rtstat",
      "action": "run",
      "description": "Run rtstat",
      "adapter": "process",
      "adapterConfig": {
        "command": "rtstat",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rtstat from /usr/bin/rtstat"
      },
      "args": []
    }
  ]
}