{
  "plugin": "rtstat",
  "binary": "rtstat",
  "check": "which rtstat",
  "install_steps": [
    "# Install rtstat",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rtstat-linux-amd64 -o /usr/local/bin/rtstat",
    "chmod +x /usr/local/bin/rtstat",
    "# Or via package manager, see /usr/bin/rtstat"
  ]
}