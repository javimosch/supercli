{
  "name": "enableAppleAI",
  "version": "0.1.0",
  "description": "Enable Apple Intelligence on Macs sold in Mainland China with SIP enabled, for version between  MacO",
  "source": "https://github.com/enableAppleAI/enableAppleAI",
  "checks": [
    {
      "type": "binary",
      "name": "enableappleai"
    }
  ],
  "install_guidance": {
    "plugin": "enableAppleAI",
    "binary": "enableappleai",
    "check": "which enableappleai",
    "install_steps": [
      "pip install enableappleai",
      "Verify: enableappleai --version",
      "supercli plugins install ./plugins/enableAppleAI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "enableAppleAI",
      "resource": "self",
      "action": "version",
      "description": "Print enableAppleAI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "enableappleai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install enableAppleAI: pip install enableappleai"
      },
      "args": []
    },
    {
      "namespace": "enableAppleAI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enableappleai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enableappleai",
        "passthrough": true,
        "missingDependencyHelp": "Install enableAppleAI: pip install enableappleai"
      },
      "args": []
    }
  ]
}