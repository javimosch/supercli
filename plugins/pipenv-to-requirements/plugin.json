{
  "name": "pipenv-to-requirements",
  "version": "0.1.0",
  "description": "Convert Pipfile/Pipfile.lock to requirements.txt",
  "source": "https://github.com/search/pipenv-to-requirements",
  "checks": [{ "type": "binary", "name": "pipenv-to-requirements" }],
  "install_guidance": {
    "plugin": "pipenv-to-requirements",
    "binary": "pipenv-to-requirements",
    "check": "which pipenv-to-requirements",
    "install_steps": ["pip install pipenv-to-requirements", "Verify: pipenv-to-requirements --version", "supercli plugins install ./plugins/pipenv-to-requirements --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipenv-to-requirements",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipenv-to-requirements CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipenv-to-requirements",
      "passthrough": true,
      "missingDependencyHelp": "Install pipenv-to-requirements: pip install pipenv-to-requirements"
    },
    "args": []
  }]
}
