{
  "name": "jy",
  "version": "0.1.0",
  "description": "JSON to-and-from YAML parser CLI, plus more formats",
  "source": "https://github.com/jy/jy",
  "checks": [
    {
      "type": "binary",
      "name": "jy"
    }
  ],
  "install_guidance": {
    "plugin": "jy",
    "binary": "jy",
    "check": "which jy",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: jy --version",
      "supercli plugins install ./plugins/jy --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "jy",
      "resource": "self",
      "action": "version",
      "description": "Print jy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jy from project repository"
      },
      "args": []
    },
    {
      "namespace": "jy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jy",
        "passthrough": true,
        "missingDependencyHelp": "Install jy from project repository"
      },
      "args": []
    }
  ]
}