{
  "name": "gresource",
  "version": "0.1.0",
  "description": "CLI tool: gresource",
  "source": "https://manpages.debian.org/gresource",
  "checks": [
    {
      "type": "binary",
      "name": "gresource"
    }
  ],
  "install_guidance": {
    "plugin": "gresource",
    "binary": "gresource",
    "check": "which gresource",
    "install_steps": [
      "apt-get install gresource 2>/dev/null || which gresource",
      "Verify: gresource --version",
      "supercli plugins install ./plugins/gresource --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gresource",
      "resource": "self",
      "action": "version",
      "description": "Print gresource version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gresource",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gresource: apt-get install gresource 2>/dev/null || which gresource"
      },
      "args": []
    },
    {
      "namespace": "gresource",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gresource CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gresource",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gresource: apt-get install gresource 2>/dev/null || which gresource"
      },
      "args": []
    }
  ]
}