{
  "name": "pbmtoepsi",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoepsi",
  "source": "https://manpages.debian.org/pbmtoepsi",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoepsi"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoepsi",
    "binary": "pbmtoepsi",
    "check": "which pbmtoepsi",
    "install_steps": [
      "apt-get install pbmtoepsi 2>/dev/null || which pbmtoepsi",
      "Verify: pbmtoepsi --version",
      "supercli plugins install ./plugins/pbmtoepsi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoepsi",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoepsi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoepsi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoepsi: apt-get install pbmtoepsi 2>/dev/null || which pbmtoepsi"
      },
      "args": []
    },
    {
      "namespace": "pbmtoepsi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoepsi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoepsi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoepsi: apt-get install pbmtoepsi 2>/dev/null || which pbmtoepsi"
      },
      "args": []
    }
  ]
}