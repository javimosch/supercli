{
  "name": "okteto",
  "version": "0.1.0",
  "description": "Develop applications on Kubernetes",
  "source": "https://github.com/okteto/okteto",
  "checks": [{ "type": "binary", "name": "okteto" }],
  "install_guidance": {
    "plugin": "okteto",
    "binary": "okteto",
    "check": "which okteto",
    "install_steps": ["brew install okteto", "Verify: okteto --version", "supercli plugins install ./plugins/okteto --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "okteto",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to okteto CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "okteto",
      "passthrough": true,
      "missingDependencyHelp": "Install okteto: brew install okteto"
    },
    "args": []
  }]
}
