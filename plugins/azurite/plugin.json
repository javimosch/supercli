{
  "name": "azurite",
  "version": "0.1.0",
  "description": "Lightweight server clone of Azure Storage that simulates it locally",
  "source": "https://github.com/Azure/Azurite",
  "checks": [
    {
      "type": "binary",
      "name": "azurite"
    }
  ],
  "install_guidance": {
    "plugin": "azurite",
    "binary": "azurite",
    "check": "which azurite",
    "install_steps": [
      "brew install azurite",
      "Verify: azurite --version",
      "supercli plugins install ./plugins/azurite --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "azurite",
      "resource": "self",
      "action": "version",
      "description": "Print azurite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "azurite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install azurite: brew install azurite"
      },
      "args": []
    },
    {
      "namespace": "azurite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to azurite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "azurite",
        "passthrough": true,
        "missingDependencyHelp": "Install azurite"
      },
      "args": []
    }
  ]
}