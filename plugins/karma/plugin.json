{
  "name": "karma",
  "version": "0.1.0",
  "description": "\u65b0\u6570\u636e\u6d1e\u5bdf\u65b9\u5f0f",
  "source": "https://github.com/karma/karma",
  "checks": [
    {
      "type": "binary",
      "name": "karma"
    }
  ],
  "install_guidance": {
    "plugin": "karma",
    "binary": "karma",
    "check": "which karma",
    "install_steps": [
      "pip install karma",
      "Verify: karma --version",
      "supercli plugins install ./plugins/karma --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "karma",
      "resource": "self",
      "action": "version",
      "description": "Print karma version",
      "adapter": "process",
      "adapterConfig": {
        "command": "karma",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install karma: pip install karma"
      },
      "args": []
    },
    {
      "namespace": "karma",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to karma CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "karma",
        "passthrough": true,
        "missingDependencyHelp": "Install karma: pip install karma"
      },
      "args": []
    }
  ]
}