{
  "name": "stash",
  "version": "0.1.0",
  "description": "Backup and restore Kubernetes volumes",
  "source": "https://github.com/stashed/stash",
  "checks": [{ "type": "binary", "name": "stash" }],
  "install_guidance": {
    "plugin": "stash",
    "binary": "stash",
    "check": "which stash",
    "install_steps": ["brew install stash", "Verify: stash --version", "supercli plugins install ./plugins/stash --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "stash",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to stash CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "stash",
      "passthrough": true,
      "missingDependencyHelp": "Install stash: brew install stash"
    },
    "args": []
  }]
}
