{
  "name": "kubens",
  "version": "0.1.0",
  "description": "Switch between Kubernetes namespaces quickly",
  "source": "https://github.com/ahmetb/kubectx",
  "checks": [{ "type": "binary", "name": "kubens" }],
  "install_guidance": {
    "plugin": "kubens",
    "binary": "kubens",
    "check": "which kubens",
    "install_steps": ["brew install kubens", "Verify: kubens --version", "supercli plugins install ./plugins/kubens --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubens",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubens CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubens",
      "passthrough": true,
      "missingDependencyHelp": "Install kubens: brew install kubens"
    },
    "args": []
  }]
}
