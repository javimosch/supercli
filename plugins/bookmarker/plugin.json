{
  "name": "bookmarker",
  "version": "0.1.0",
  "description": "CLI bookmark management with tagging and search",
  "source": "https://github.com/e-walker/bookmarker",
  "checks": [{ "type": "binary", "name": "bookmarker" }],
  "install_guidance": {
    "plugin": "bookmarker",
    "binary": "bookmarker",
    "check": "which bookmarker",
    "install_steps": ["npm install -g bookmarker-cli", "Verify: bookmarker --version", "supercli plugins install ./plugins/bookmarker --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bookmarker",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bookmarker CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bookmarker",
      "passthrough": true,
      "missingDependencyHelp": "Install bookmarker: npm install -g bookmarker-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
