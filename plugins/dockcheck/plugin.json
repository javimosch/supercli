{
  "name": "dockcheck",
  "version": "0.1.0",
  "description": "Automatically check and update Docker container images",
  "source": "https://github.com/nicholasgasior/dockcheck",
  "checks": [
    {
      "type": "binary",
      "name": "dockcheck"
    }
  ],
  "install_guidance": {
    "plugin": "dockcheck",
    "binary": "dockcheck",
    "check": "which dockcheck",
    "install_steps": [
      "curl -sSL https://raw.githubusercontent.com/nicholasgasior/dockcheck/main/install.sh | bash",
      "Verify: dockcheck --version",
      "supercli plugins install ./plugins/dockcheck --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dockcheck",
      "resource": "self",
      "action": "version",
      "description": "Print dockcheck version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockcheck",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dockcheck: curl -sSL https://raw.githubusercontent.com/nicholasgasior/dockcheck/main/install.sh | bash"
      },
      "args": []
    },
    {
      "namespace": "dockcheck",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dockcheck CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockcheck",
        "passthrough": true,
        "missingDependencyHelp": "Install dockcheck: curl -sSL https://raw.githubusercontent.com/nicholasgasior/dockcheck/main/install.sh | bash"
      },
      "args": []
    }
  ]
}
