{
  "name": "uscope",
  "version": "0.1.0",
  "description": "\u03bcscope \ud83d\udd2c",
  "source": "https://github.com/uscope/uscope",
  "checks": [
    {
      "type": "binary",
      "name": "uscope"
    }
  ],
  "install_guidance": {
    "plugin": "uscope",
    "binary": "uscope",
    "check": "which uscope",
    "install_steps": [
      "pip install uscope",
      "Verify: uscope --version",
      "supercli plugins install ./plugins/uscope --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uscope",
      "resource": "self",
      "action": "version",
      "description": "Print uscope version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uscope",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uscope: pip install uscope"
      },
      "args": []
    },
    {
      "namespace": "uscope",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uscope CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uscope",
        "passthrough": true,
        "missingDependencyHelp": "Install uscope: pip install uscope"
      },
      "args": []
    }
  ]
}