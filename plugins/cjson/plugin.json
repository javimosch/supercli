{
  "name": "cjson",
  "version": "0.1.0",
  "description": "Ultralightweight JSON parser in ANSI C",
  "source": "https://github.com/DaveGamble/cJSON",
  "checks": [
    {
      "type": "binary",
      "name": "cjson"
    }
  ],
  "install_guidance": {
    "plugin": "cjson",
    "binary": "cjson",
    "check": "which cjson",
    "install_steps": [
      "brew install cjson",
      "Verify: cjson --version",
      "supercli plugins install ./plugins/cjson --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cjson",
      "resource": "self",
      "action": "version",
      "description": "Print cjson version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cjson",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cjson: brew install cjson"
      },
      "args": []
    },
    {
      "namespace": "cjson",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cjson CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cjson",
        "passthrough": true,
        "missingDependencyHelp": "Install cjson"
      },
      "args": []
    }
  ]
}