{
  "name": "dot_builtins",
  "version": "0.1.0",
  "description": "CLI tool: dot_builtins",
  "source": "https://manpages.debian.org/dot_builtins",
  "checks": [
    {
      "type": "binary",
      "name": "dot_builtins"
    }
  ],
  "install_guidance": {
    "plugin": "dot_builtins",
    "binary": "dot_builtins",
    "check": "which dot_builtins",
    "install_steps": [
      "apt-get install dot_builtins 2>/dev/null || which dot_builtins",
      "Verify: dot_builtins --version",
      "supercli plugins install ./plugins/dot_builtins --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dot_builtins",
      "resource": "self",
      "action": "version",
      "description": "Print dot_builtins version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dot_builtins",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dot_builtins: apt-get install dot_builtins 2>/dev/null || which dot_builtins"
      },
      "args": []
    },
    {
      "namespace": "dot_builtins",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dot_builtins CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dot_builtins",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dot_builtins: apt-get install dot_builtins 2>/dev/null || which dot_builtins"
      },
      "args": []
    }
  ]
}