{
  "name": "gemtopbm",
  "version": "0.1.0",
  "description": "CLI tool: gemtopbm",
  "source": "https://manpages.debian.org/gemtopbm",
  "checks": [
    {
      "type": "binary",
      "name": "gemtopbm"
    }
  ],
  "install_guidance": {
    "plugin": "gemtopbm",
    "binary": "gemtopbm",
    "check": "which gemtopbm",
    "install_steps": [
      "apt-get install gemtopbm 2>/dev/null || which gemtopbm",
      "Verify: gemtopbm --version",
      "supercli plugins install ./plugins/gemtopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gemtopbm",
      "resource": "self",
      "action": "version",
      "description": "Print gemtopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemtopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gemtopbm: apt-get install gemtopbm 2>/dev/null || which gemtopbm"
      },
      "args": []
    },
    {
      "namespace": "gemtopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gemtopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemtopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gemtopbm: apt-get install gemtopbm 2>/dev/null || which gemtopbm"
      },
      "args": []
    }
  ]
}