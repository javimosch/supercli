{
  "name": "fastrace",
  "version": "0.1.0",
  "description": "Dependency-free traceroute implementation in pure C",
  "source": "https://github.com/davidesantangelo/fastrace",
  "checks": [
    {
      "type": "binary",
      "name": "fastrace"
    }
  ],
  "install_guidance": {
    "plugin": "fastrace",
    "binary": "fastrace",
    "check": "which fastrace",
    "install_steps": [
      "brew install fastrace",
      "Verify: fastrace --version",
      "supercli plugins install ./plugins/fastrace --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fastrace",
      "resource": "self",
      "action": "version",
      "description": "Print fastrace version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastrace",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastrace: brew install fastrace"
      },
      "args": []
    },
    {
      "namespace": "fastrace",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastrace CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastrace",
        "passthrough": true,
        "missingDependencyHelp": "Install fastrace"
      },
      "args": []
    }
  ]
}