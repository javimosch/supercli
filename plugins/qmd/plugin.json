{
  "name": "qmd",
  "version": "0.1.0",
  "description": "mini cli search engine for your docs, knowledge bases, meeting notes, whatever. Tracking current sot",
  "source": "https://github.com/qmd/qmd",
  "checks": [
    {
      "type": "binary",
      "name": "qmd"
    }
  ],
  "install_guidance": {
    "plugin": "qmd",
    "binary": "qmd",
    "check": "which qmd",
    "install_steps": [
      "pip install qmd",
      "Verify: qmd --version",
      "supercli plugins install ./plugins/qmd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmd",
      "resource": "self",
      "action": "version",
      "description": "Print qmd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmd: pip install qmd"
      },
      "args": []
    },
    {
      "namespace": "qmd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmd",
        "passthrough": true,
        "missingDependencyHelp": "Install qmd: pip install qmd"
      },
      "args": []
    }
  ]
}