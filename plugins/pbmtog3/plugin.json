{
  "name": "pbmtog3",
  "version": "0.1.0",
  "description": "CLI tool: pbmtog3",
  "source": "https://manpages.debian.org/pbmtog3",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtog3"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtog3",
    "binary": "pbmtog3",
    "check": "which pbmtog3",
    "install_steps": [
      "apt-get install pbmtog3 2>/dev/null || which pbmtog3",
      "Verify: pbmtog3 --version",
      "supercli plugins install ./plugins/pbmtog3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtog3",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtog3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtog3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtog3: apt-get install pbmtog3 2>/dev/null || which pbmtog3"
      },
      "args": []
    },
    {
      "namespace": "pbmtog3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtog3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtog3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtog3: apt-get install pbmtog3 2>/dev/null || which pbmtog3"
      },
      "args": []
    }
  ]
}