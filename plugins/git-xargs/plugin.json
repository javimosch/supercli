{
  "name": "git-xargs",
  "version": "0.1.0",
  "description": "Run commands against multiple git repositories in parallel",
  "source": "https://github.com/gruntwork-io/git-xargs",
  "checks": [{ "type": "binary", "name": "git-xargs" }],
  "install_guidance": {
    "plugin": "git-xargs",
    "binary": "git-xargs",
    "check": "which git-xargs",
    "install_steps": ["brew install git-xargs", "Verify: git-xargs --version", "supercli plugins install ./plugins/git-xargs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-xargs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-xargs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-xargs",
      "passthrough": true,
      "missingDependencyHelp": "Install git-xargs: brew install git-xargs"
    },
    "args": []
  }]
}
