{
  "name": "Roo-Code",
  "version": "0.1.0",
  "description": "Roo Code gives you a whole dev team of AI agents in your code editor.",
  "source": "https://github.com/Roo-Code/Roo-Code",
  "checks": [
    {
      "type": "binary",
      "name": "roo-code"
    }
  ],
  "install_guidance": {
    "plugin": "Roo-Code",
    "binary": "roo-code",
    "check": "which roo-code",
    "install_steps": [
      "pip install roo-code",
      "Verify: roo-code --version",
      "supercli plugins install ./plugins/Roo-Code --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Roo-Code",
      "resource": "self",
      "action": "version",
      "description": "Print Roo-Code version",
      "adapter": "process",
      "adapterConfig": {
        "command": "roo-code",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Roo-Code: pip install roo-code"
      },
      "args": []
    },
    {
      "namespace": "Roo-Code",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to roo-code CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "roo-code",
        "passthrough": true,
        "missingDependencyHelp": "Install Roo-Code: pip install roo-code"
      },
      "args": []
    }
  ]
}