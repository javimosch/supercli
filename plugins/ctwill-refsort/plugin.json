{
  "name": "ctwill-refsort",
  "version": "0.1.0",
  "description": "CLI tool: ctwill-refsort",
  "source": "https://packages.debian.org/ctwill-refsort",
  "checks": [{ "type": "binary", "name": "ctwill-refsort" }],
  "install_guidance": {
    "plugin": "ctwill-refsort", "binary": "ctwill-refsort", "check": "which ctwill-refsort",
    "install_steps": ["apt-get install ctwill-refsort 2>/dev/null || which ctwill-refsort", "Verify: ctwill-refsort --version", "supercli plugins install ./plugins/ctwill-refsort --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctwill-refsort", "resource": "_", "action": "_",
    "description": "Passthrough to ctwill-refsort CLI",
    "adapter": "process", "adapterConfig": { "command": "ctwill-refsort", "passthrough": true, "missingDependencyHelp": "Install ctwill-refsort: apt-get install ctwill-refsort" }, "args": []
  }]
}
