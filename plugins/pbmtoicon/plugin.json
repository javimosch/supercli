{
  "name": "pbmtoicon",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoicon",
  "source": "https://manpages.debian.org/pbmtoicon",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoicon"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoicon",
    "binary": "pbmtoicon",
    "check": "which pbmtoicon",
    "install_steps": [
      "apt-get install pbmtoicon 2>/dev/null || which pbmtoicon",
      "Verify: pbmtoicon --version",
      "supercli plugins install ./plugins/pbmtoicon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoicon",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoicon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoicon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoicon: apt-get install pbmtoicon 2>/dev/null || which pbmtoicon"
      },
      "args": []
    },
    {
      "namespace": "pbmtoicon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoicon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoicon",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoicon: apt-get install pbmtoicon 2>/dev/null || which pbmtoicon"
      },
      "args": []
    }
  ]
}