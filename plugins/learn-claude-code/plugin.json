{
  "name": "learn-claude-code",
  "version": "0.1.0",
  "description": "Bash is all you need -  A nano claude code\u2013like \u300cagent harness\u300d, built from 0 to 1",
  "source": "https://github.com/learn-claude-code/learn-claude-code",
  "checks": [
    {
      "type": "binary",
      "name": "learn-claude-code"
    }
  ],
  "install_guidance": {
    "plugin": "learn-claude-code",
    "binary": "learn-claude-code",
    "check": "which learn-claude-code",
    "install_steps": [
      "pip install learn-claude-code",
      "Verify: learn-claude-code --version",
      "supercli plugins install ./plugins/learn-claude-code --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "learn-claude-code",
      "resource": "self",
      "action": "version",
      "description": "Print learn-claude-code version",
      "adapter": "process",
      "adapterConfig": {
        "command": "learn-claude-code",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install learn-claude-code: pip install learn-claude-code"
      },
      "args": []
    },
    {
      "namespace": "learn-claude-code",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to learn-claude-code CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "learn-claude-code",
        "passthrough": true,
        "missingDependencyHelp": "Install learn-claude-code: pip install learn-claude-code"
      },
      "args": []
    }
  ]
}