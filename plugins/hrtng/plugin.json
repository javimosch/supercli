{
  "name": "hrtng",
  "version": "0.1.0",
  "description": "IDA Pro plugin with a rich set of features: decryption, deobfuscation, patching, lib code recognitio",
  "source": "https://github.com/hrtng/hrtng",
  "checks": [
    {
      "type": "binary",
      "name": "hrtng"
    }
  ],
  "install_guidance": {
    "plugin": "hrtng",
    "binary": "hrtng",
    "check": "which hrtng",
    "install_steps": [
      "pip install hrtng",
      "Verify: hrtng --version",
      "supercli plugins install ./plugins/hrtng --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hrtng",
      "resource": "self",
      "action": "version",
      "description": "Print hrtng version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hrtng",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hrtng: pip install hrtng"
      },
      "args": []
    },
    {
      "namespace": "hrtng",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hrtng CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hrtng",
        "passthrough": true,
        "missingDependencyHelp": "Install hrtng: pip install hrtng"
      },
      "args": []
    }
  ]
}