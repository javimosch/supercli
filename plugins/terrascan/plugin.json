{
  "name": "terrascan",
  "version": "0.1.0",
  "description": "Detect security and compliance violations in IaC",
  "source": "https://github.com/tenable/terrascan",
  "checks": [{ "type": "binary", "name": "terrascan" }],
  "install_guidance": {
    "plugin": "terrascan",
    "binary": "terrascan",
    "check": "which terrascan",
    "install_steps": ["brew install terrascan", "Verify: terrascan --version", "supercli plugins install ./plugins/terrascan --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terrascan",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terrascan CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terrascan",
      "passthrough": true,
      "missingDependencyHelp": "Install terrascan: brew install terrascan"
    },
    "args": []
  }]
}
