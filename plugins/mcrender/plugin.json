{
  "name": "mcrender",
  "version": "0.1.0",
  "description": "Render isometric images of Minecraft worlds from CLI",
  "source": "https://github.com/avdstaaij/mcrender",
  "checks": [{ "type": "binary", "name": "mcrender" }],
  "install_guidance": {
    "plugin": "mcrender",
    "binary": "mcrender",
    "check": "which mcrender",
    "install_steps": ["pip install mcrender", "Verify: mcrender --version", "supercli plugins install ./plugins/mcrender --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mcrender",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mcrender CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mcrender",
      "passthrough": true,
      "missingDependencyHelp": "Install mcrender: pip install mcrender", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
