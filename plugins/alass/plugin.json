{
  "name": "alass",
  "version": "0.1.0",
  "description": "Automatic Language-Agnostic Subtitle Synchronization",
  "source": "https://github.com/kaegi/alass",
  "checks": [
    {
      "type": "binary",
      "name": "alass"
    }
  ],
  "install_guidance": {
    "plugin": "alass",
    "binary": "alass",
    "check": "which alass",
    "install_steps": [
      "brew install alass",
      "Verify: alass --version",
      "supercli plugins install ./plugins/alass --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "alass",
      "resource": "self",
      "action": "version",
      "description": "Print alass version",
      "adapter": "process",
      "adapterConfig": {
        "command": "alass",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install alass: brew install alass"
      },
      "args": []
    },
    {
      "namespace": "alass",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to alass CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "alass",
        "passthrough": true,
        "missingDependencyHelp": "Install alass"
      },
      "args": []
    }
  ]
}