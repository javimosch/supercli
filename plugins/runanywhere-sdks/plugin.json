{
  "name": "runanywhere-sdks",
  "version": "0.1.0",
  "description": "Production ready toolkit to run AI locally",
  "source": "https://github.com/runanywhere-sdks/runanywhere-sdks",
  "checks": [
    {
      "type": "binary",
      "name": "runanywhere-sdks"
    }
  ],
  "install_guidance": {
    "plugin": "runanywhere-sdks",
    "binary": "runanywhere-sdks",
    "check": "which runanywhere-sdks",
    "install_steps": [
      "pip install runanywhere-sdks",
      "Verify: runanywhere-sdks --version",
      "supercli plugins install ./plugins/runanywhere-sdks --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "runanywhere-sdks",
      "resource": "self",
      "action": "version",
      "description": "Print runanywhere-sdks version",
      "adapter": "process",
      "adapterConfig": {
        "command": "runanywhere-sdks",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install runanywhere-sdks: pip install runanywhere-sdks"
      },
      "args": []
    },
    {
      "namespace": "runanywhere-sdks",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to runanywhere-sdks CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "runanywhere-sdks",
        "passthrough": true,
        "missingDependencyHelp": "Install runanywhere-sdks: pip install runanywhere-sdks"
      },
      "args": []
    }
  ]
}