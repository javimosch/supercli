{
  "name": "impactor",
  "version": "0.1.0",
  "description": "Feature-rich iOS/tvOS sideloading application written in Rust",
  "source": "https://github.com/claration/Impactor",
  "checks": [
    {
      "type": "binary",
      "name": "impactor"
    }
  ],
  "install_guidance": {
    "plugin": "impactor",
    "binary": "impactor",
    "check": "which impactor",
    "install_steps": [
      "cargo install impactor",
      "Verify: impactor --version",
      "supercli plugins install ./plugins/impactor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "impactor",
    "resource": "self",
    "action": "version",
    "description": "Print impactor version",
    "adapter": "process",
    "adapterConfig": {
      "command": "impactor",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install impactor: cargo install impactor"
    },
    "args": []
  },
  {
    "namespace": "impactor",
    "resource": "app",
    "action": "sign",
    "description": "Sign and sideload an iOS app",
    "adapter": "process",
    "adapterConfig": {
      "command": "impactor",
      "baseArgs": [
        "sign"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install impactor: cargo install impactor"
    },
    "args": []
  },
  {
    "namespace": "impactor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to impactor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "impactor",
      "passthrough": true,
      "missingDependencyHelp": "Install impactor"
    },
    "args": []
  }
]
}