{
  "name": "git-svn",
  "version": "0.1.0",
  "description": "Bidirectional operation between a Subversion repository and Git",
  "checks": [
    {
      "type": "binary",
      "name": "git-svn"
    }
  ],
  "install_guidance": {
    "plugin": "git-svn",
    "binary": "git-svn",
    "check": "which git-svn",
    "install_steps": [
      "brew install git-svn",
      "Verify: git-svn --version",
      "supercli plugins install ./plugins/git-svn --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-svn",
      "resource": "self",
      "action": "version",
      "description": "Print git-svn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-svn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-svn: brew install git-svn"
      },
      "args": []
    },
    {
      "namespace": "git-svn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-svn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-svn",
        "passthrough": true,
        "missingDependencyHelp": "Install git-svn"
      },
      "args": []
    }
  ]
}