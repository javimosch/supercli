{
  "name": "happyfinder",
  "version": "0.1.0",
  "description": "(another) Fuzzy file finder for the command line",
  "source": "https://github.com/hugows/hf",
  "checks": [
    {
      "type": "binary",
      "name": "happyfinder"
    }
  ],
  "install_guidance": {
    "plugin": "happyfinder",
    "binary": "happyfinder",
    "check": "which happyfinder",
    "install_steps": [
      "See https://github.com/hugows/hf",
      "Verify: happyfinder --version",
      "supercli plugins install ./plugins/happyfinder --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "happyfinder",
      "resource": "self",
      "action": "version",
      "description": "Print happyfinder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "happyfinder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install happyfinder: See https://github.com/hugows/hf"
      },
      "args": []
    },
    {
      "namespace": "happyfinder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to happyfinder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "happyfinder",
        "passthrough": true,
        "missingDependencyHelp": "Install happyfinder"
      },
      "args": []
    }
  ]
}