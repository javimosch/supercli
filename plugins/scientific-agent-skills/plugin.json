{
  "name": "scientific-agent-skills",
  "version": "0.1.0",
  "description": "Turn any AI agent into an AI Scientist. The #1 Agent Skills library for science, used by 160,000+ sc",
  "source": "https://github.com/scientific-agent-skills/scientific-agent-skills",
  "checks": [
    {
      "type": "binary",
      "name": "scientific-agent-skills"
    }
  ],
  "install_guidance": {
    "plugin": "scientific-agent-skills",
    "binary": "scientific-agent-skills",
    "check": "which scientific-agent-skills",
    "install_steps": [
      "pip install scientific-agent-skills",
      "Verify: scientific-agent-skills --version",
      "supercli plugins install ./plugins/scientific-agent-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "scientific-agent-skills",
      "resource": "self",
      "action": "version",
      "description": "Print scientific-agent-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scientific-agent-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scientific-agent-skills: pip install scientific-agent-skills"
      },
      "args": []
    },
    {
      "namespace": "scientific-agent-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scientific-agent-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scientific-agent-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install scientific-agent-skills: pip install scientific-agent-skills"
      },
      "args": []
    }
  ]
}