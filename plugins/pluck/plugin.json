{
  "name": "pluck",
  "version": "0.1.0",
  "description": "Local Rust daemon replacing cat and grep for AI agents — symbol-aware code reading and search",
  "source": "https://github.com/hunhee98/pluck",
  "checks": [
    {
      "type": "binary",
      "name": "pluck"
    }
  ],
  "install_guidance": {
    "plugin": "pluck",
    "binary": "pluck",
    "check": "which pluck",
    "install_steps": [
      "cargo install pluck-cli",
      "Verify: pluck --version",
      "supercli plugins install ./plugins/pluck --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pluck",
      "resource": "self",
      "action": "version",
      "description": "Print pluck version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pluck",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pluck: cargo install pluck-cli"
      },
      "args": []
    },
    {
      "namespace": "pluck",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pluck CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pluck",
        "passthrough": true,
        "missingDependencyHelp": "Install pluck: cargo install pluck-cli"
      },
      "args": []
    }
  ]
}
