{
  "name": "rustdoc",
  "version": "0.1.0",
  "description": "rustdoc — Rust documentation tool for generating crate API docs",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "rustdoc"
    }
  ],
  "install_guidance": {
    "plugin": "rustdoc",
    "binary": "rustdoc",
    "check": "which rustdoc",
    "install_steps": [
      "brew install rust"
    ],
    "note": "Tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rustdoc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough",
      "adapter": "process",
      "adapterConfig": {
        "command": "rustdoc",
        "passthrough": true,
        "missingDependencyHelp": "Install rustdoc: brew install rust"
      },
      "args": []
    }
  ]
}
