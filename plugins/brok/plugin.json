{
  "name": "brok",
  "version": "0.1.0",
  "description": "Find broken links in text documents.",
  "source": "https://github.com/smallhadroncollider/brok",
  "checks": [
    {
      "type": "binary",
      "name": "brok"
    }
  ],
  "install_guidance": {
    "plugin": "brok",
    "binary": "brok",
    "check": "which brok",
    "install_steps": [
      "See https://github.com/smallhadroncollider/brok",
      "Verify: brok --version",
      "supercli plugins install ./plugins/brok --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "brok",
      "resource": "self",
      "action": "version",
      "description": "Print brok version",
      "adapter": "process",
      "adapterConfig": {
        "command": "brok",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install brok: See https://github.com/smallhadroncollider/brok"
      },
      "args": []
    },
    {
      "namespace": "brok",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to brok CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "brok",
        "passthrough": true,
        "missingDependencyHelp": "Install brok"
      },
      "args": []
    }
  ]
}