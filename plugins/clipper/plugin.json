{
  "name": "clipper",
  "version": "0.1.0",
  "description": "Lightweight Go-based clipboard management tool",
  "source": "https://github.com/wincent/clipper",
  "checks": [{ "type": "binary", "name": "clipper" }],
  "install_guidance": {
    "plugin": "clipper",
    "binary": "clipper",
    "check": "which clipper",
    "install_steps": ["go install github.com/wincent/clipper@latest", "Verify: clipper --version", "supercli plugins install ./plugins/clipper --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clipper",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clipper CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clipper",
      "passthrough": true,
      "missingDependencyHelp": "Install clipper: go install github.com/wincent/clipper@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
