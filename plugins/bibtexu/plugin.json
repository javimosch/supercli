{
  "name": "bibtexu",
  "version": "0.1.0",
  "description": "CLI tool: bibtexu",
  "source": "https://packages.debian.org/bibtexu",
  "checks": [{ "type": "binary", "name": "bibtexu" }],
  "install_guidance": {
    "plugin": "bibtexu", "binary": "bibtexu", "check": "which bibtexu",
    "install_steps": ["apt-get install bibtexu 2>/dev/null || which bibtexu", "Verify: bibtexu --version", "supercli plugins install ./plugins/bibtexu --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bibtexu", "resource": "_", "action": "_",
    "description": "Passthrough to bibtexu CLI",
    "adapter": "process", "adapterConfig": { "command": "bibtexu", "passthrough": true, "missingDependencyHelp": "Install bibtexu: apt-get install bibtexu" }, "args": []
  }]
}
