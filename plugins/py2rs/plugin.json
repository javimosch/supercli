{
  "name": "py2rs",
  "version": "0.1.0",
  "description": "Convert Python code to Rust with type inference",
  "source": "https://github.com/rochacbruno/py2rs",
  "checks": [{ "type": "binary", "name": "py2rs" }],
  "install_guidance": {
    "plugin": "py2rs",
    "binary": "py2rs",
    "check": "which py2rs",
    "install_steps": ["cargo install py2rs", "Verify: py2rs --version", "supercli plugins install ./plugins/py2rs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "py2rs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to py2rs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "py2rs",
      "passthrough": true,
      "missingDependencyHelp": "Install py2rs: cargo install py2rs", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
