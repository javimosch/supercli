{
  "name": "cpc",
  "version": "0.1.0",
  "description": "Copy file contents to clipboard from the terminal",
  "source": "https://github.com/dalance/cpc",
  "checks": [{ "type": "binary", "name": "cpc" }],
  "install_guidance": {
    "plugin": "cpc",
    "binary": "cpc",
    "check": "which cpc",
    "install_steps": ["cargo install cpc", "Verify: cpc --version", "supercli plugins install ./plugins/cpc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cpc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cpc",
      "passthrough": true,
      "missingDependencyHelp": "Install cpc: cargo install cpc"
    },
    "args": []
  }]
}
