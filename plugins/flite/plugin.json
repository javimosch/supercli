    "resource": "_",
    "action": "_",
    "description": "Passthrough to flite CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flite",
      "passthrough": true,
      "missingDependencyHelp": "Install flite: sudo apt install flite"
    },
    "args": []
  }]
}
