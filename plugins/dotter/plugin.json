{
  "name": "dotter",
  "version": "0.1.0",
  "description": "Rust-based templating dotfile manager with handlebars support",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "dotter" }],
  "install_guidance": {
    "plugin": "dotter",
    "binary": "dotter",
    "check": "which dotter",
    "install_steps": ["cargo install dotter", "Verify: dotter --version", "supercli plugins install ./plugins/dotter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dotter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dotter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dotter",
      "passthrough": true,
      "missingDependencyHelp": "Install dotter: cargo install dotter"
    },
    "args": []
  }]
}
