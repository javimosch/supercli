{
  "name": "llm",
  "version": "0.1.0",
  "description": "[Unmaintained, see README] An ecosystem of Rust libraries for working with large language models",
  "source": "https://github.com/llm/llm",
  "checks": [
    {
      "type": "binary",
      "name": "llm"
    }
  ],
  "install_guidance": {
    "plugin": "llm",
    "binary": "llm",
    "check": "which llm",
    "install_steps": [
      "pip install llm",
      "Verify: llm --version",
      "supercli plugins install ./plugins/llm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "llm",
      "resource": "self",
      "action": "version",
      "description": "Print llm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llm: pip install llm"
      },
      "args": []
    },
    {
      "namespace": "llm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llm",
        "passthrough": true,
        "missingDependencyHelp": "Install llm: pip install llm"
      },
      "args": []
    }
  ]
}