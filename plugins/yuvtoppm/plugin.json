{
  "name": "yuvtoppm",
  "version": "0.1.0",
  "description": "CLI tool: yuvtoppm",
  "source": "https://manpages.debian.org/yuvtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "yuvtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "yuvtoppm",
    "binary": "yuvtoppm",
    "check": "which yuvtoppm",
    "install_steps": [
      "apt-get install yuvtoppm 2>/dev/null || which yuvtoppm",
      "Verify: yuvtoppm --version",
      "supercli plugins install ./plugins/yuvtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yuvtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print yuvtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuvtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yuvtoppm: apt-get install yuvtoppm 2>/dev/null || which yuvtoppm"
      },
      "args": []
    },
    {
      "namespace": "yuvtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yuvtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yuvtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install yuvtoppm: apt-get install yuvtoppm 2>/dev/null || which yuvtoppm"
      },
      "args": []
    }
  ]
}