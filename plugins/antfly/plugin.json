{
  "name": "antfly",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/antfly/antfly",
  "checks": [
    {
      "type": "binary",
      "name": "antfly"
    }
  ],
  "install_guidance": {
    "plugin": "antfly",
    "binary": "antfly",
    "check": "which antfly",
    "install_steps": [
      "pip install antfly",
      "Verify: antfly --version",
      "supercli plugins install ./plugins/antfly --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "antfly",
      "resource": "self",
      "action": "version",
      "description": "Print antfly version",
      "adapter": "process",
      "adapterConfig": {
        "command": "antfly",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install antfly: pip install antfly"
      },
      "args": []
    },
    {
      "namespace": "antfly",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to antfly CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "antfly",
        "passthrough": true,
        "missingDependencyHelp": "Install antfly: pip install antfly"
      },
      "args": []
    }
  ]
}