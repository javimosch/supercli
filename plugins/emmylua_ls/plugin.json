{
  "name": "emmylua_ls",
  "version": "0.1.0",
  "description": "Lua Language Server",
  "source": "https://github.com/EmmyLuaLs/emmylua-analyzer-rust",
  "checks": [
    {
      "type": "binary",
      "name": "emmylua_ls"
    }
  ],
  "install_guidance": {
    "plugin": "emmylua_ls",
    "binary": "emmylua_ls",
    "check": "which emmylua_ls",
    "install_steps": [
      "brew install emmylua_ls",
      "Verify: emmylua_ls --version",
      "supercli plugins install ./plugins/emmylua_ls --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "emmylua_ls",
      "resource": "self",
      "action": "version",
      "description": "Print emmylua_ls version",
      "adapter": "process",
      "adapterConfig": {
        "command": "emmylua_ls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install emmylua_ls: brew install emmylua_ls"
      },
      "args": []
    },
    {
      "namespace": "emmylua_ls",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to emmylua_ls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "emmylua_ls",
        "passthrough": true,
        "missingDependencyHelp": "Install emmylua_ls"
      },
      "args": []
    }
  ]
}