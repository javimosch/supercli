{
  "name": "cmark-gfm",
  "version": "0.1.0",
  "description": "C implementation of GitHub Flavored Markdown",
  "source": "https://github.com/github/cmark-gfm",
  "checks": [
    {
      "type": "binary",
      "name": "cmark-gfm"
    }
  ],
  "install_guidance": {
    "plugin": "cmark-gfm",
    "binary": "cmark-gfm",
    "check": "which cmark-gfm",
    "install_steps": [
      "brew install cmark-gfm",
      "Verify: cmark-gfm --version",
      "supercli plugins install ./plugins/cmark-gfm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cmark-gfm",
      "resource": "self",
      "action": "version",
      "description": "Print cmark-gfm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmark-gfm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmark-gfm: brew install cmark-gfm"
      },
      "args": []
    },
    {
      "namespace": "cmark-gfm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmark-gfm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmark-gfm",
        "passthrough": true,
        "missingDependencyHelp": "Install cmark-gfm"
      },
      "args": []
    }
  ]
}