{
  "name": "keyring",
  "version": "0.1.0",
  "description": "CLI tool: keyring",
  "source": "https://manpages.debian.org/keyring",
  "checks": [
    {
      "type": "binary",
      "name": "keyring"
    }
  ],
  "install_guidance": {
    "plugin": "keyring",
    "binary": "keyring",
    "check": "which keyring",
    "install_steps": [
      "apt-get install keyring 2>/dev/null || which keyring",
      "Verify: keyring --version",
      "supercli plugins install ./plugins/keyring --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "keyring",
      "resource": "self",
      "action": "version",
      "description": "Print keyring version",
      "adapter": "process",
      "adapterConfig": {
        "command": "keyring",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install keyring: apt-get install keyring 2>/dev/null || which keyring"
      },
      "args": []
    },
    {
      "namespace": "keyring",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to keyring CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "keyring",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install keyring: apt-get install keyring 2>/dev/null || which keyring"
      },
      "args": []
    }
  ]
}