{
  "name": "tune.exfat",
  "version": "0.1.0",
  "description": "CLI tool: tune.exfat",
  "source": "https://manpages.debian.org/tune.exfat",
  "checks": [
    {
      "type": "binary",
      "name": "tune.exfat"
    }
  ],
  "install_guidance": {
    "plugin": "tune.exfat",
    "binary": "tune.exfat",
    "check": "which tune.exfat",
    "install_steps": [
      "apt-get install tune.exfat 2>/dev/null || which tune.exfat",
      "Verify: tune.exfat --version",
      "supercli plugins install ./plugins/tune.exfat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tune.exfat",
      "resource": "self",
      "action": "version",
      "description": "Print tune.exfat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tune.exfat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tune.exfat: apt-get install tune.exfat 2>/dev/null || which tune.exfat"
      },
      "args": []
    },
    {
      "namespace": "tune.exfat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tune.exfat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tune.exfat",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tune.exfat: apt-get install tune.exfat 2>/dev/null || which tune.exfat"
      },
      "args": []
    }
  ]
}