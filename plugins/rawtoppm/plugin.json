{
  "name": "rawtoppm",
  "version": "0.1.0",
  "description": "CLI tool: rawtoppm",
  "source": "https://manpages.debian.org/rawtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "rawtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "rawtoppm",
    "binary": "rawtoppm",
    "check": "which rawtoppm",
    "install_steps": [
      "apt-get install rawtoppm 2>/dev/null || which rawtoppm",
      "Verify: rawtoppm --version",
      "supercli plugins install ./plugins/rawtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rawtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print rawtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rawtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rawtoppm: apt-get install rawtoppm 2>/dev/null || which rawtoppm"
      },
      "args": []
    },
    {
      "namespace": "rawtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rawtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rawtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rawtoppm: apt-get install rawtoppm 2>/dev/null || which rawtoppm"
      },
      "args": []
    }
  ]
}