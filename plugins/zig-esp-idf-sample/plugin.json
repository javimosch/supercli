{
  "name": "zig-esp-idf-sample",
  "version": "0.1.0",
  "description": "Run Zig on esp-idf (Xtensa/RISC-V)",
  "source": "https://github.com/zig-esp-idf-sample/zig-esp-idf-sample",
  "checks": [
    {
      "type": "binary",
      "name": "zig-esp-idf-sample"
    }
  ],
  "install_guidance": {
    "plugin": "zig-esp-idf-sample",
    "binary": "zig-esp-idf-sample",
    "check": "which zig-esp-idf-sample",
    "install_steps": [
      "pip install zig-esp-idf-sample",
      "Verify: zig-esp-idf-sample --version",
      "supercli plugins install ./plugins/zig-esp-idf-sample --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig-esp-idf-sample",
      "resource": "self",
      "action": "version",
      "description": "Print zig-esp-idf-sample version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-esp-idf-sample",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig-esp-idf-sample: pip install zig-esp-idf-sample"
      },
      "args": []
    },
    {
      "namespace": "zig-esp-idf-sample",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig-esp-idf-sample CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-esp-idf-sample",
        "passthrough": true,
        "missingDependencyHelp": "Install zig-esp-idf-sample: pip install zig-esp-idf-sample"
      },
      "args": []
    }
  ]
}