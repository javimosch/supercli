{
  "name": "dehydrated",
  "version": "1.0.0",
  "description": "dehydrated \u2014 ACME client",
  "source": "github.com/dehydrated-io/dehydrated",
  "checks": [
    {
      "type": "binary",
      "name": "dehydrated"
    }
  ],
  "install_guidance": {
    "plugin": "dehydrated",
    "binary": "dehydrated",
    "check": "which dehydrated",
    "install_steps": [
      "# Install dehydrated",
      "# See github.com/dehydrated-io/dehydrated",
      "# apt: sudo apt-get install dehydrated",
      "# brew: brew install dehydrated",
      "# cargo: cargo install dehydrated",
      "# npm: npm install -g dehydrated",
      "# pip: pip install dehydrated"
    ]
  },
  "commands": [
    {
      "namespace": "dehydrated",
      "resource": "dehydrated",
      "action": "run",
      "description": "Run dehydrated",
      "adapter": "process",
      "adapterConfig": {
        "command": "dehydrated",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dehydrated from github.com/dehydrated-io/dehydrated"
      },
      "args": []
    }
  ]
}