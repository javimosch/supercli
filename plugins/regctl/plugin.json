{
  "name": "regctl",
  "version": "0.1.0",
  "description": "Docker registry client for managing container images",
  "source": "https://github.com/regclient/regclient",
  "checks": [{ "type": "binary", "name": "regctl" }],
  "install_guidance": {
    "plugin": "regctl",
    "binary": "regctl",
    "check": "which regctl",
    "install_steps": ["brew install regctl", "Verify: regctl --version", "supercli plugins install ./plugins/regctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "regctl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to regctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "regctl",
      "passthrough": true,
      "missingDependencyHelp": "Install regctl: brew install regctl"
    },
    "args": []
  }]
}
