{
  "name": "blackbox",
  "version": "0.1.0",
  "description": "Safely store secrets in git with GPG encryption",
  "source": "https://github.com/StackExchange/blackbox",
  "checks": [{ "type": "binary", "name": "blackbox" }],
  "install_guidance": {
    "plugin": "blackbox",
    "binary": "blackbox",
    "check": "which blackbox",
    "install_steps": ["brew install blackbox", "Verify: blackbox --version", "supercli plugins install ./plugins/blackbox --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "blackbox",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to blackbox CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "blackbox",
      "passthrough": true,
      "missingDependencyHelp": "Install blackbox: brew install blackbox", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
