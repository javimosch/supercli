{
  "name": "bccmd",
  "version": "0.1.0",
  "description": "CLI tool: bccmd",
  "source": "https://packages.debian.org/bccmd",
  "checks": [{ "type": "binary", "name": "bccmd" }],
  "install_guidance": {
    "plugin": "bccmd", "binary": "bccmd", "check": "which bccmd",
    "install_steps": ["apt-get install bccmd 2>/dev/null || which bccmd", "Verify: bccmd --version", "supercli plugins install ./plugins/bccmd --on-conflict replace --json"]
