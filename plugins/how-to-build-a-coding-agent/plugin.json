{
  "name": "how-to-build-a-coding-agent",
  "version": "0.1.0",
  "description": "A workshop that teaches you how to build your own coding agent. Similar to Roo code, Cline, Amp, Cur",
  "source": "https://github.com/how-to-build-a-coding-agent/how-to-build-a-coding-agent",
  "checks": [
    {
      "type": "binary",
      "name": "how-to-build-a-coding-agent"
    }
  ],
  "install_guidance": {
    "plugin": "how-to-build-a-coding-agent",
    "binary": "how-to-build-a-coding-agent",
    "check": "which how-to-build-a-coding-agent",
    "install_steps": [
      "pip install how-to-build-a-coding-agent",
      "Verify: how-to-build-a-coding-agent --version",
      "supercli plugins install ./plugins/how-to-build-a-coding-agent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "how-to-build-a-coding-agent",
      "resource": "self",
      "action": "version",
      "description": "Print how-to-build-a-coding-agent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "how-to-build-a-coding-agent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install how-to-build-a-coding-agent: pip install how-to-build-a-coding-agent"
      },
      "args": []
    },
    {
      "namespace": "how-to-build-a-coding-agent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to how-to-build-a-coding-agent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "how-to-build-a-coding-agent",
        "passthrough": true,
        "missingDependencyHelp": "Install how-to-build-a-coding-agent: pip install how-to-build-a-coding-agent"
      },
      "args": []
    }
  ]
}