{
  "plugin": "neon-cli",
  "binary": "neonctl",
  "check": "which neonctl",
  "install_steps": [
    "npm i -g neonctl",
    "Verify: neonctl --version",
    "supercli plugins install ./plugins/neon-cli --on-conflict replace --json"
  ],
  "note": "Requires auth: neonctl auth or NEON_API_KEY env var"
}
