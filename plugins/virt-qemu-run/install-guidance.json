{
  "plugin": "virt-qemu-run",
  "binary": "virt-qemu-run",
  "check": "which virt-qemu-run",
  "install_steps": [
    "apt-get install virt-qemu-run 2>/dev/null || which virt-qemu-run",
    "Verify: virt-qemu-run --version",
    "supercli plugins install ./plugins/virt-qemu-run --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}