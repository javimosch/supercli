{
  "name": "xflock4",
  "version": "0.1.0",
  "description": "CLI tool: xflock4",
  "source": "https://manpages.debian.org/xflock4",
  "checks": [
    {
      "type": "binary",
      "name": "xflock4"
    }
  ],
  "install_guidance": {
    "plugin": "xflock4",
    "binary": "xflock4",
    "check": "which xflock4",
    "install_steps": [
      "apt-get install xflock4 2>/dev/null || which xflock4",
      "Verify: xflock4 --version",
      "supercli plugins install ./plugins/xflock4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xflock4",
      "resource": "self",
      "action": "version",
      "description": "Print xflock4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xflock4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xflock4: apt-get install xflock4 2>/dev/null || which xflock4"
      },
      "args": []
    },
    {
      "namespace": "xflock4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xflock4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xflock4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xflock4: apt-get install xflock4 2>/dev/null || which xflock4"
      },
      "args": []
    }
  ]
}