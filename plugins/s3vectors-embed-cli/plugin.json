{
  "name": "s3vectors-embed-cli",
  "version": "0.1.0",
  "description": "Semantic similarity search on S3 media",
  "source": "https://github.com/s3vectors/s3vectors-embed-cli",
  "checks": [
    {
      "type": "binary",
      "name": "s3vectors-embed-cli"
    }
  ],
  "install_guidance": {
    "plugin": "s3vectors-embed-cli",
    "binary": "s3vectors-embed-cli",
    "check": "which s3vectors-embed-cli",
    "install_steps": [
      "pip install s3vectors-embed-cli",
      "Verify: s3vectors-embed-cli --version",
      "supercli plugins install ./plugins/s3vectors-embed-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "s3vectors-embed-cli",
      "resource": "self",
      "action": "version",
      "description": "Print s3vectors-embed-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "s3vectors-embed-cli",
        "missingDependencyHelp": "Install s3vectors-embed-cli: pip install s3vectors-embed-cli",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "s3vectors-embed-cli",
      "resource": "media",
      "action": "index",
      "description": "Index media files for semantic search",
      "adapter": "process",
      "adapterConfig": {
        "command": "s3vectors-embed-cli",
        "missingDependencyHelp": "Install s3vectors-embed-cli: pip install s3vectors-embed-cli",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "s3vectors-embed-cli",
      "resource": "media",
      "action": "search",
      "description": "Semantic similarity search on indexed media",
      "adapter": "process",
      "adapterConfig": {
        "command": "s3vectors-embed-cli",
        "missingDependencyHelp": "Install s3vectors-embed-cli: pip install s3vectors-embed-cli",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "s3vectors-embed-cli",
      "resource": "_",
      "action": "_",
      "description": "_ _ via s3vectors-embed-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "s3vectors-embed-cli",
        "missingDependencyHelp": "Install s3vectors-embed-cli: pip install s3vectors-embed-cli",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
