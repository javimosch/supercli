{
  "name": "dynomite",
  "version": "0.1.0",
  "description": "Generic dynamo implementation for different k-v storage engines",
  "source": "https://github.com/Netflix/dynomite",
  "checks": [
    {
      "type": "binary",
      "name": "dynomite"
    }
  ],
  "install_guidance": {
    "plugin": "dynomite",
    "binary": "dynomite",
    "check": "which dynomite",
    "install_steps": [
      "brew install dynomite",
      "Verify: dynomite --version",
      "supercli plugins install ./plugins/dynomite --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dynomite",
      "resource": "self",
      "action": "version",
      "description": "Print dynomite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dynomite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dynomite: brew install dynomite"
      },
      "args": []
    },
    {
      "namespace": "dynomite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dynomite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dynomite",
        "passthrough": true,
        "missingDependencyHelp": "Install dynomite"
      },
      "args": []
    }
  ]
}