{
  "name": "errcheck",
  "version": "0.1.0",
  "description": "Finds silently ignored errors in Go code",
  "source": "https://github.com/kisielk/errcheck",
  "checks": [
    {
      "type": "binary",
      "name": "errcheck"
    }
  ],
  "install_guidance": {
    "plugin": "errcheck",
    "binary": "errcheck",
    "check": "which errcheck",
    "install_steps": [
      "brew install errcheck",
      "Verify: errcheck --version",
      "supercli plugins install ./plugins/errcheck --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "errcheck",
      "resource": "self",
      "action": "version",
      "description": "Print errcheck version",
      "adapter": "process",
      "adapterConfig": {
        "command": "errcheck",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install errcheck: brew install errcheck"
      },
      "args": []
    },
    {
      "namespace": "errcheck",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to errcheck CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "errcheck",
        "passthrough": true,
        "missingDependencyHelp": "Install errcheck"
      },
      "args": []
    }
  ]
}