{
  "name": "poweroff",
  "version": "1.0.0",
  "description": "poweroff \u2014 poweroff \u2014 CLI utility",
  "source": "/usr/sbin/poweroff",
  "checks": [
    {
      "type": "binary",
      "name": "poweroff"
    }
  ],
  "install_guidance": {
    "plugin": "poweroff",
    "binary": "poweroff",
    "check": "which poweroff",
    "install_steps": [
      "# Install poweroff:",
      "# apt: sudo apt-get install poweroff",
      "# brew: brew install poweroff",
      "# cargo: cargo install poweroff",
      "# npm: npm install -g poweroff",
      "# pip: pip install poweroff",
      "# or download from /usr/sbin/poweroff"
    ]
  },
  "commands": [
    {
      "namespace": "poweroff",
      "resource": "poweroff",
      "action": "run",
      "description": "Run poweroff",
      "adapter": "process",
      "adapterConfig": {
        "command": "poweroff",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install poweroff from /usr/sbin/poweroff"
      },
      "args": []
    }
  ]
}