{
  "name": "fprintd-delete",
  "version": "0.1.0",
  "description": "CLI tool: fprintd-delete",
  "source": "https://manpages.debian.org/fprintd-delete",
  "checks": [
    {
      "type": "binary",
      "name": "fprintd-delete"
    }
  ],
  "install_guidance": {
    "plugin": "fprintd-delete",
    "binary": "fprintd-delete",
    "check": "which fprintd-delete",
    "install_steps": [
      "apt-get install fprintd-delete 2>/dev/null || which fprintd-delete",
      "Verify: fprintd-delete --version",
      "supercli plugins install ./plugins/fprintd-delete --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fprintd-delete",
      "resource": "self",
      "action": "version",
      "description": "Print fprintd-delete version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fprintd-delete",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fprintd-delete: apt-get install fprintd-delete 2>/dev/null || which fprintd-delete"
      },
      "args": []
    },
    {
      "namespace": "fprintd-delete",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fprintd-delete CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fprintd-delete",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fprintd-delete: apt-get install fprintd-delete 2>/dev/null || which fprintd-delete"
      },
      "args": []
    }
  ]
}