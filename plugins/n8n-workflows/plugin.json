{
  "name": "n8n-workflows",
  "version": "0.1.0",
  "description": "all of the workflows of n8n i could find (also from the site itself)",
  "source": "https://github.com/n8n-workflows/n8n-workflows",
  "checks": [
    {
      "type": "binary",
      "name": "n8n-workflows"
    }
  ],
  "install_guidance": {
    "plugin": "n8n-workflows",
    "binary": "n8n-workflows",
    "check": "which n8n-workflows",
    "install_steps": [
      "pip install n8n-workflows",
      "Verify: n8n-workflows --version",
      "supercli plugins install ./plugins/n8n-workflows --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "n8n-workflows",
      "resource": "self",
      "action": "version",
      "description": "Print n8n-workflows version",
      "adapter": "process",
      "adapterConfig": {
        "command": "n8n-workflows",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install n8n-workflows: pip install n8n-workflows"
      },
      "args": []
    },
    {
      "namespace": "n8n-workflows",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to n8n-workflows CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "n8n-workflows",
        "passthrough": true,
        "missingDependencyHelp": "Install n8n-workflows: pip install n8n-workflows"
      },
      "args": []
    }
  ]
}