{
  "name": "iptables",
  "version": "1.0.0",
  "description": "iptables \u2014 Packet filtering firewall",
  "source": "netfilter.org",
  "checks": [
    {
      "type": "binary",
      "name": "iptables"
    }
  ],
  "install_guidance": {
    "plugin": "iptables",
    "binary": "iptables",
    "check": "which iptables",
    "install_steps": [
      "# Install iptables:",
      "# apt: sudo apt-get install iptables",
      "# brew: brew install iptables",
      "# cargo: cargo install iptables",
      "# npm: npm install -g iptables",
      "# pip: pip install iptables",
      "# or download from netfilter.org"
    ]
  },
  "commands": [
    {
      "namespace": "iptables",
      "resource": "iptables",
      "action": "run",
      "description": "Run iptables",
      "adapter": "process",
      "adapterConfig": {
        "command": "iptables",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install iptables from netfilter.org"
      },
      "args": []
    }
  ]
}