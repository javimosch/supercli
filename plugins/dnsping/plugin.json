{
  "name": "dnsping",
  "version": "0.1.0",
  "description": "Check packet loss and latency of DNS servers with detailed statistics",
  "source": "go",
  "checks": [{ "type": "binary", "name": "dnsping" }],
  "install_guidance": {
    "plugin": "dnsping",
    "binary": "dnsping",
    "check": "which dnsping",
    "install_steps": ["go install fortio.org/dnsping@latest", "Verify: dnsping --version", "supercli plugins install ./plugins/dnsping --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dnsping",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dnsping CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dnsping",
      "passthrough": true,
      "missingDependencyHelp": "Install dnsping: go install fortio.org/dnsping@latest"
    },
    "args": []
  }]
}
