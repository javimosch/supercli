{
  "name": "kapp",
  "version": "0.1.0",
  "description": "Lightweight Kubernetes application management tool",
  "source": "https://github.com/carvel-dev/kapp",
  "checks": [{ "type": "binary", "name": "kapp" }],
  "install_guidance": {
    "plugin": "kapp",
    "binary": "kapp",
    "check": "which kapp",
    "install_steps": ["brew install kapp", "Verify: kapp --version", "supercli plugins install ./plugins/kapp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kapp",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kapp CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kapp",
      "passthrough": true,
      "missingDependencyHelp": "Install kapp: brew install kapp"
    },
    "args": []
  }]
}
