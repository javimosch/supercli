{
  "name": "textrank",
  "version": "0.1.0",
  "description": "TextRank implementation for keyword extraction",
  "source": "https://github.com/summanlp/textrank",
  "checks": [{ "type": "binary", "name": "textrank" }],
  "install_guidance": {
    "plugin": "textrank",
    "binary": "textrank",
    "check": "which textrank",
    "install_steps": ["pip install textrank", "Verify: textrank --version", "supercli plugins install ./plugins/textrank --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "textrank",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to textrank CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "textrank",
      "passthrough": true,
      "missingDependencyHelp": "Install textrank: pip install textrank", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
