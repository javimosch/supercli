{
  "name": "flyway",
  "version": "0.1.0",
  "description": "Database version control to control migrations",
  "checks": [
    {
      "type": "binary",
      "name": "flyway"
    }
  ],
  "install_guidance": {
    "plugin": "flyway",
    "binary": "flyway",
    "check": "which flyway",
    "install_steps": [
      "brew install flyway",
      "Verify: flyway --version",
      "supercli plugins install ./plugins/flyway --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "flyway",
      "resource": "self",
      "action": "version",
      "description": "Print flyway version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flyway",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flyway: brew install flyway"
      },
      "args": []
    },
    {
      "namespace": "flyway",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flyway CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flyway",
        "passthrough": true,
        "missingDependencyHelp": "Install flyway"
      },
      "args": []
    }
  ]
}