{
  "name": "docutils",
  "version": "1.0.0",
  "description": "docutils \u2014 Python doc utils",
  "source": "docutils.sourceforge.io",
  "checks": [
    {
      "type": "binary",
      "name": "docutils"
    }
  ],
  "install_guidance": {
    "plugin": "docutils",
    "binary": "docutils",
    "check": "which docutils",
    "install_steps": [
      "# Install docutils",
      "# See docutils.sourceforge.io",
      "# apt: sudo apt-get install docutils",
      "# brew: brew install docutils",
      "# cargo: cargo install docutils",
      "# npm: npm install -g docutils",
      "# pip: pip install docutils"
    ]
  },
  "commands": [
    {
      "namespace": "docutils",
      "resource": "docutils",
      "action": "run",
      "description": "Run docutils",
      "adapter": "process",
      "adapterConfig": {
        "command": "docutils",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install docutils from docutils.sourceforge.io"
      },
      "args": []
    }
  ]
}