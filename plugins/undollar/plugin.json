{
  "name": "undollar",
  "version": "0.1.0",
  "description": "Strip the '$' preceding copy-pasted terminal commands",
  "source": "https://github.com/ImFeelingDucky/undollar",
  "checks": [
    {
      "type": "binary",
      "name": "undollar"
    }
  ],
  "install_guidance": {
    "plugin": "undollar",
    "binary": "undollar",
    "check": "which undollar",
    "install_steps": [
      "See https://github.com/ImFeelingDucky/undollar",
      "Verify: undollar --version",
      "supercli plugins install ./plugins/undollar --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "undollar",
      "resource": "self",
      "action": "version",
      "description": "Print undollar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "undollar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install undollar: See https://github.com/ImFeelingDucky/undollar"
      },
      "args": []
    },
    {
      "namespace": "undollar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to undollar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "undollar",
        "passthrough": true,
        "missingDependencyHelp": "Install undollar"
      },
      "args": []
    }
  ]
}