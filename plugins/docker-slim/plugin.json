{
  "name": "docker-slim",
  "version": "1.0.0",
  "description": "docker-slim \u2014 Minify Docker images",
  "source": "github.com/docker-slim/docker-slim",
  "checks": [
    {
      "type": "binary",
      "name": "docker-slim"
    }
  ],
  "install_guidance": {
    "plugin": "docker-slim",
    "binary": "docker-slim",
    "check": "which docker-slim",
    "install_steps": [
      "# Install docker-slim",
      "# See github.com/docker-slim/docker-slim",
      "# apt: sudo apt-get install docker-slim",
      "# brew: brew install docker-slim",
      "# cargo: cargo install docker-slim",
      "# npm: npm install -g docker-slim",
      "# pip: pip install docker-slim"
    ]
  },
  "commands": [
    {
      "namespace": "docker",
      "resource": "slim",
      "action": "run",
      "description": "Run docker-slim",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-slim",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install docker-slim from github.com/docker-slim/docker-slim"
      },
      "args": []
    }
  ]
}