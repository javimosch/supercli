{
  "name": "astron-rpa",
  "version": "0.1.0",
  "description": "Agent-ready RPA suite with out-of-the-box automation tools. Built for individuals and enterprises.",
  "source": "https://github.com/astron-rpa/astron-rpa",
  "checks": [
    {
      "type": "binary",
      "name": "astron-rpa"
    }
  ],
  "install_guidance": {
    "plugin": "astron-rpa",
    "binary": "astron-rpa",
    "check": "which astron-rpa",
    "install_steps": [
      "pip install astron-rpa",
      "Verify: astron-rpa --version",
      "supercli plugins install ./plugins/astron-rpa --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "astron-rpa",
      "resource": "self",
      "action": "version",
      "description": "Print astron-rpa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "astron-rpa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install astron-rpa: pip install astron-rpa"
      },
      "args": []
    },
    {
      "namespace": "astron-rpa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to astron-rpa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "astron-rpa",
        "passthrough": true,
        "missingDependencyHelp": "Install astron-rpa: pip install astron-rpa"
      },
      "args": []
    }
  ]
}