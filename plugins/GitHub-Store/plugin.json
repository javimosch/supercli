{
  "name": "GitHub-Store",
  "version": "0.1.0",
  "description": "\ud83e\ude75 A free, open-source app store for GitHub releases \u2014 browse, discover, and install apps with one cl",
  "source": "https://github.com/GitHub-Store/GitHub-Store",
  "checks": [
    {
      "type": "binary",
      "name": "github-store"
    }
  ],
  "install_guidance": {
    "plugin": "GitHub-Store",
    "binary": "github-store",
    "check": "which github-store",
    "install_steps": [
      "pip install github-store",
      "Verify: github-store --version",
      "supercli plugins install ./plugins/GitHub-Store --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GitHub-Store",
      "resource": "self",
      "action": "version",
      "description": "Print GitHub-Store version",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-store",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GitHub-Store: pip install github-store"
      },
      "args": []
    },
    {
      "namespace": "GitHub-Store",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to github-store CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-store",
        "passthrough": true,
        "missingDependencyHelp": "Install GitHub-Store: pip install github-store"
      },
      "args": []
    }
  ]
}