{
  "name": "install-clever-completion",
  "version": "0.1.0",
  "description": "CLI tool: install-clever-completion",
  "source": "https://manpages.debian.org/install-clever-completion",
  "checks": [
    {
      "type": "binary",
      "name": "install-clever-completion"
    }
  ],
  "install_guidance": {
    "plugin": "install-clever-completion",
    "binary": "install-clever-completion",
    "check": "which install-clever-completion",
    "install_steps": [
      "apt-get install install-clever-completion 2>/dev/null || which install-clever-completion",
      "Verify: install-clever-completion --version",
      "supercli plugins install ./plugins/install-clever-completion --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "install-clever-completion",
      "resource": "self",
      "action": "version",
      "description": "Print install-clever-completion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-clever-completion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install install-clever-completion: apt-get install install-clever-completion 2>/dev/null || which install-clever-completion"
      },
      "args": []
    },
    {
      "namespace": "install-clever-completion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to install-clever-completion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-clever-completion",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install install-clever-completion: apt-get install install-clever-completion 2>/dev/null || which install-clever-completion"
      },
      "args": []
    }
  ]
}