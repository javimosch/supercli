{
  "name": "fdk-aac-encoder",
  "version": "0.1.0",
  "description": "Command-line encoder frontend for libfdk-aac",
  "source": "https://github.com/nu774/fdkaac",
  "checks": [
    {
      "type": "binary",
      "name": "fdk-aac-encoder"
    }
  ],
  "install_guidance": {
    "plugin": "fdk-aac-encoder",
    "binary": "fdk-aac-encoder",
    "check": "which fdk-aac-encoder",
    "install_steps": [
      "brew install fdk-aac-encoder",
      "Verify: fdk-aac-encoder --version",
      "supercli plugins install ./plugins/fdk-aac-encoder --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fdk-aac-encoder",
      "resource": "self",
      "action": "version",
      "description": "Print fdk-aac-encoder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fdk-aac-encoder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fdk-aac-encoder: brew install fdk-aac-encoder"
      },
      "args": []
    },
    {
      "namespace": "fdk-aac-encoder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fdk-aac-encoder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fdk-aac-encoder",
        "passthrough": true,
        "missingDependencyHelp": "Install fdk-aac-encoder"
      },
      "args": []
    }
  ]
}