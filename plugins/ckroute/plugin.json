{
  "name": "ckroute",
  "version": "0.1.0",
  "description": "CLI tool: ckroute",
  "source": "https://packages.debian.org/ckroute",
  "checks": [{ "type": "binary", "name": "ckroute" }],
  "install_guidance": {
    "plugin": "ckroute", "binary": "ckroute", "check": "which ckroute",
    "install_steps": ["which ckroute", "Verify: ckroute --version", "supercli plugins install ./plugins/ckroute --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ckroute", "resource": "_", "action": "_",
    "description": "Passthrough to ckroute CLI",
    "adapter": "process",
    "adapterConfig": { "command": "ckroute", "passthrough": true,
    "missingDependencyHelp": "Install ckroute: which ckroute" }, "args": []
  }]
}
