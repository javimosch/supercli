{
  "name": "MicYou",
  "version": "0.1.0",
  "description": "MicYou is a powerful tool that turns your Android device into a high-quality microphone for your PC.",
  "source": "https://github.com/MicYou/MicYou",
  "checks": [
    {
      "type": "binary",
      "name": "micyou"
    }
  ],
  "install_guidance": {
    "plugin": "MicYou",
    "binary": "micyou",
    "check": "which micyou",
    "install_steps": [
      "pip install micyou",
      "Verify: micyou --version",
      "supercli plugins install ./plugins/MicYou --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MicYou",
      "resource": "self",
      "action": "version",
      "description": "Print MicYou version",
      "adapter": "process",
      "adapterConfig": {
        "command": "micyou",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MicYou: pip install micyou"
      },
      "args": []
    },
    {
      "namespace": "MicYou",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to micyou CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "micyou",
        "passthrough": true,
        "missingDependencyHelp": "Install MicYou: pip install micyou"
      },
      "args": []
    }
  ]
}