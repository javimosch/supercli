{
  "name": "do-release-upgrade",
  "version": "1.0.0",
  "description": "Upgrade Ubuntu/Debian system to the next LTS release",
  "checks": [
    {
      "type": "binary",
      "name": "do-release-upgrade"
    }
  ],
  "install_guidance": {
    "plugin": "do-release-upgrade",
    "binary": "do-release-upgrade",
    "check": "which do-release-upgrade",
    "install_steps": [
      "Install via package manager"
    ]
  },
  "commands": [
    {
      "namespace": "do-release-upgrade",
      "resource": "run",
      "action": "exec",
      "description": "Upgrade system to next LTS release",
      "adapter": "process",
      "adapterConfig": {
        "command": "do-release-upgrade",
        "passthrough": true,
        "timeout_ms": 30000
      }
    }
  ]
}