{
  "name": "funzzy",
  "version": "0.1.0",
  "description": "Lightweight file watcher",
  "source": "https://github.com/cristianoliveira/funzzy",
  "checks": [
    {
      "type": "binary",
      "name": "funzzy"
    }
  ],
  "install_guidance": {
    "plugin": "funzzy",
    "binary": "funzzy",
    "check": "which funzzy",
    "install_steps": [
      "brew install funzzy",
      "Verify: funzzy --version",
      "supercli plugins install ./plugins/funzzy --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "funzzy",
      "resource": "self",
      "action": "version",
      "description": "Print funzzy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "funzzy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install funzzy: brew install funzzy"
      },
      "args": []
    },
    {
      "namespace": "funzzy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to funzzy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "funzzy",
        "passthrough": true,
        "missingDependencyHelp": "Install funzzy"
      },
      "args": []
    }
  ]
}