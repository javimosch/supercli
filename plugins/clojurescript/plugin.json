{
  "name": "clojurescript",
  "version": "0.1.0",
  "description": "Clojure to JS compiler",
  "source": "https://github.com/clojure/clojurescript",
  "checks": [
    {
      "type": "binary",
      "name": "clojurescript"
    }
  ],
  "install_guidance": {
    "plugin": "clojurescript",
    "binary": "clojurescript",
    "check": "which clojurescript",
    "install_steps": [
      "brew install clojurescript",
      "Verify: clojurescript --version",
      "supercli plugins install ./plugins/clojurescript --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clojurescript",
      "resource": "self",
      "action": "version",
      "description": "Print clojurescript version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clojurescript",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clojurescript: brew install clojurescript"
      },
      "args": []
    },
    {
      "namespace": "clojurescript",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clojurescript CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clojurescript",
        "passthrough": true,
        "missingDependencyHelp": "Install clojurescript"
      },
      "args": []
    }
  ]
}