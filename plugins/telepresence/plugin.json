{
  "name": "telepresence",
  "version": "0.1.0",
  "description": "Local development against a remote Kubernetes cluster",
  "source": "https://github.com/telepresenceio/telepresence",
  "checks": [{ "type": "binary", "name": "telepresence" }],
  "install_guidance": {
    "plugin": "telepresence",
    "binary": "telepresence",
    "check": "which telepresence",
    "install_steps": ["brew install telepresence", "Verify: telepresence --version", "supercli plugins install ./plugins/telepresence --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "telepresence",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to telepresence CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "telepresence",
      "passthrough": true,
      "missingDependencyHelp": "Install telepresence: brew install telepresence"
    },
    "args": []
  }]
}
