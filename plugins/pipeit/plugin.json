{
  "name": "pipeit",
  "version": "0.1.0",
  "description": "Execute text selections as shell commands",
  "source": "https://github.com/charmbracelet/pipeit",
  "checks": [{ "type": "binary", "name": "pipeit" }],
  "install_guidance": {
    "plugin": "pipeit",
    "binary": "pipeit",
    "check": "which pipeit",
    "install_steps": ["brew install pipeit", "Verify: pipeit --version", "supercli plugins install ./plugins/pipeit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipeit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipeit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipeit",
      "passthrough": true,
      "missingDependencyHelp": "Install pipeit: brew install pipeit"
    },
    "args": []
  }]
}
