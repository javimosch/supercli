{
  "name": "nanoclaw",
  "version": "0.1.0",
  "description": "A lightweight alternative to OpenClaw that runs in containers for security. Connects to WhatsApp, Te",
  "source": "https://github.com/nanoclaw/nanoclaw",
  "checks": [
    {
      "type": "binary",
      "name": "nanoclaw"
    }
  ],
  "install_guidance": {
    "plugin": "nanoclaw",
    "binary": "nanoclaw",
    "check": "which nanoclaw",
    "install_steps": [
      "pip install nanoclaw",
      "Verify: nanoclaw --version",
      "supercli plugins install ./plugins/nanoclaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nanoclaw",
      "resource": "self",
      "action": "version",
      "description": "Print nanoclaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanoclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nanoclaw: pip install nanoclaw"
      },
      "args": []
    },
    {
      "namespace": "nanoclaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nanoclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanoclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install nanoclaw: pip install nanoclaw"
      },
      "args": []
    }
  ]
}