{
  "name": "chrome-devtools-mcp",
  "version": "0.1.0",
  "description": "Chrome DevTools for coding agents",
  "source": "https://github.com/chrome-devtools-mcp/chrome-devtools-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "chrome-devtools-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "chrome-devtools-mcp",
    "binary": "chrome-devtools-mcp",
    "check": "which chrome-devtools-mcp",
    "install_steps": [
      "pip install chrome-devtools-mcp",
      "Verify: chrome-devtools-mcp --version",
      "supercli plugins install ./plugins/chrome-devtools-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "chrome-devtools-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print chrome-devtools-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chrome-devtools-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chrome-devtools-mcp: pip install chrome-devtools-mcp"
      },
      "args": []
    },
    {
      "namespace": "chrome-devtools-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chrome-devtools-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chrome-devtools-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install chrome-devtools-mcp: pip install chrome-devtools-mcp"
      },
      "args": []
    }
  ]
}