{
  "name": "dm-policy",
  "version": "0.1.0",
  "description": "CLI tool: dm-policy",
  "source": "https://packages.debian.org/dm-policy",
  "checks": [{ "type": "binary", "name": "dm-policy" }],
  "install_guidance": {
    "plugin": "dm-policy", "binary": "dm-policy", "check": "which dm-policy",
    "install_steps": ["apt-get install dm-policy 2>/dev/null || which dm-policy", "Verify: dm-policy --version", "supercli plugins install ./plugins/dm-policy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dm-policy", "resource": "_", "action": "_",
    "description": "Passthrough to dm-policy CLI",
    "adapter": "process", "adapterConfig": { "command": "dm-policy", "passthrough": true, "missingDependencyHelp": "Install dm-policy: apt-get install dm-policy" }, "args": []
  }]
}
