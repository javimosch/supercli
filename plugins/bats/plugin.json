{
  "name": "bats",
  "version": "0.1.0",
  "description": "Bash Automated Testing System — a TAP-compliant testing framework for Bash, with test suite support, mocking, and CI integration.",
  "source": "https://github.com/bats-core/bats-core",
  "checks": [
    {
      "type": "binary",
      "name": "bats"
    }
  ],
  "install_guidance": {
    "plugin": "bats",
    "binary": "bats",
    "check": "bats --version",
    "install_steps": [
      "npm install -g bats",
      "bats --version"
    ],
    "note": "Also available via brew: brew install bats-core. On Debian/Ubuntu: apt install bats."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bats",
      "resource": "test",
      "action": "run",
      "description": "Run a bats test file or test suite",
      "adapter": "process",
      "adapterConfig": {
        "command": "bats",
        "passthrough": true,
        "missingDependencyHelp": "Install bats: npm install -g bats"
      },
      "args": [
        {
          "name": "--count",
          "type": "boolean",
          "description": "Count test cases without running them"
        },
        {
          "name": "--filter",
          "type": "string",
          "description": "Filter test cases by pattern"
        },
        {
          "name": "--formatter",
          "type": "string",
          "description": "Output formatter (tap, pretty, junit)"
        },
        {
          "name": "--jobs",
          "type": "integer",
          "description": "Number of parallel jobs"
        },
        {
          "name": "--no-parallel",
          "type": "boolean",
          "description": "Disable parallel execution"
        },
        {
          "name": "--recursive",
          "type": "boolean",
          "description": "Recurse into subdirectories"
        },
        {
          "name": "--tap",
          "type": "boolean",
          "description": "Output in TAP format"
        },
        {
          "name": "--timing",
          "type": "boolean",
          "description": "Show timing information"
        },
        {
          "name": "files",
          "type": "string",
          "required": true,
          "description": "Test file(s) or directory to run"
        }
      ]
    },
    {
      "namespace": "bats",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bats CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bats",
        "passthrough": true,
        "missingDependencyHelp": "Install bats: npm install -g bats"
      },
      "args": []
    }
  ]
}
