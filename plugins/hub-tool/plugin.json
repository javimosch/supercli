{
  "name": "hub-tool",
  "version": "0.1.0",
  "description": "Docker Hub experimental CLI tool",
  "source": "https://github.com/docker/hub-tool",
  "checks": [
    {
      "type": "binary",
      "name": "hub-tool"
    }
  ],
  "install_guidance": {
    "plugin": "hub-tool",
    "binary": "hub-tool",
    "check": "which hub-tool",
    "install_steps": [
      "brew install hub-tool",
      "Verify: hub-tool --version",
      "supercli plugins install ./plugins/hub-tool --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hub-tool",
      "resource": "self",
      "action": "version",
      "description": "Print hub-tool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hub-tool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hub-tool: brew install hub-tool"
      },
      "args": []
    },
    {
      "namespace": "hub-tool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hub-tool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hub-tool",
        "passthrough": true,
        "missingDependencyHelp": "Install hub-tool"
      },
      "args": []
    }
  ]
}