{
  "name": "grub-file",
  "version": "0.1.0",
  "description": "CLI tool: grub-file",
  "source": "https://manpages.debian.org/grub-file",
  "checks": [
    {
      "type": "binary",
      "name": "grub-file"
    }
  ],
  "install_guidance": {
    "plugin": "grub-file",
    "binary": "grub-file",
    "check": "which grub-file",
    "install_steps": [
      "apt-get install grub-file 2>/dev/null || which grub-file",
      "Verify: grub-file --version",
      "supercli plugins install ./plugins/grub-file --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grub-file",
      "resource": "self",
      "action": "version",
      "description": "Print grub-file version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grub-file",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grub-file: apt-get install grub-file 2>/dev/null || which grub-file"
      },
      "args": []
    },
    {
      "namespace": "grub-file",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grub-file CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grub-file",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install grub-file: apt-get install grub-file 2>/dev/null || which grub-file"
      },
      "args": []
    }
  ]
}