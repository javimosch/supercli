{
  "plugin": "update-grub2",
  "binary": "update-grub2",
  "check": "which update-grub2",
  "install_steps": [
    "apt-get install update-grub2 2>/dev/null || which update-grub2",
    "Verify: update-grub2 --version",
    "supercli plugins install ./plugins/update-grub2 --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}