{
  "name": "flytectl",
  "version": "0.1.0",
  "description": "CLI for the Flyte workflow orchestration platform for ML pipelines",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "flytectl" }],
  "install_guidance": {
    "plugin": "flytectl",
    "binary": "flytectl",
    "check": "which flytectl",
    "install_steps": ["brew install flytectl", "Verify: flytectl --version", "supercli plugins install ./plugins/flytectl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "flytectl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to flytectl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flytectl",
      "passthrough": true,
      "missingDependencyHelp": "Install flytectl: brew install flytectl"
    },
    "args": []
  }]
}
