{
  "name": "afflib",
  "version": "0.1.0",
  "description": "Advanced Forensic Format",
  "source": "https://github.com/sshock/AFFLIBv3",
  "checks": [
    {
      "type": "binary",
      "name": "afflib"
    }
  ],
  "install_guidance": {
    "plugin": "afflib",
    "binary": "afflib",
    "check": "which afflib",
    "install_steps": [
      "brew install afflib",
      "Verify: afflib --version",
      "supercli plugins install ./plugins/afflib --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "afflib",
      "resource": "self",
      "action": "version",
      "description": "Print afflib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "afflib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install afflib: brew install afflib"
      },
      "args": []
    },
    {
      "namespace": "afflib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to afflib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "afflib",
        "passthrough": true,
        "missingDependencyHelp": "Install afflib"
      },
      "args": []
    }
  ]
}