{
  "name": "apt-key",
  "version": "0.1.0",
  "description": "CLI tool: apt-key",
  "source": "https://packages.debian.org/apt-key",
  "checks": [{ "type": "binary", "name": "apt-key" }],
  "install_guidance": {
    "plugin": "apt-key", "binary": "apt-key", "check": "which apt-key",
    "install_steps": ["apt-get install apt-key 2>/dev/null || which apt-key", "Verify: apt-key --version", "supercli plugins install ./plugins/apt-key --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apt-key", "resource": "_", "action": "_",
    "description": "Passthrough to apt-key CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-key", "passthrough": true, "missingDependencyHelp": "Install apt-key: apt-get install apt-key" }, "args": []
  }]
}
