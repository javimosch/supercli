{
  "name": "xdriinfo",
  "version": "0.1.0",
  "description": "CLI tool: xdriinfo",
  "source": "https://manpages.debian.org/xdriinfo",
  "checks": [
    {
      "type": "binary",
      "name": "xdriinfo"
    }
  ],
  "install_guidance": {
    "plugin": "xdriinfo",
    "binary": "xdriinfo",
    "check": "which xdriinfo",
    "install_steps": [
      "apt-get install xdriinfo 2>/dev/null || which xdriinfo",
      "Verify: xdriinfo --version",
      "supercli plugins install ./plugins/xdriinfo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xdriinfo",
      "resource": "self",
      "action": "version",
      "description": "Print xdriinfo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdriinfo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xdriinfo: apt-get install xdriinfo 2>/dev/null || which xdriinfo"
      },
      "args": []
    },
    {
      "namespace": "xdriinfo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xdriinfo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdriinfo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xdriinfo: apt-get install xdriinfo 2>/dev/null || which xdriinfo"
      },
      "args": []
    }
  ]
}