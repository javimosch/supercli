{
  "name": "RDS-CLI",
  "version": "0.1.0",
  "description": "Snom Redirection service XML-RPC Python CLI",
  "source": "https://github.com/RDS-CLI/RDS-CLI",
  "checks": [
    {
      "type": "binary",
      "name": "RDS-CLI"
    }
  ],
  "install_guidance": {
    "plugin": "RDS-CLI",
    "binary": "RDS-CLI",
    "check": "which RDS-CLI",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: RDS-CLI --version",
      "supercli plugins install ./plugins/RDS-CLI --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "RDS-CLI",
      "resource": "self",
      "action": "version",
      "description": "Print RDS-CLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "RDS-CLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RDS-CLI from project repository"
      },
      "args": []
    },
    {
      "namespace": "RDS-CLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to RDS-CLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "RDS-CLI",
        "passthrough": true,
        "missingDependencyHelp": "Install RDS-CLI from project repository"
      },
      "args": []
    }
  ]
}