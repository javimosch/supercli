{
  "name": "cava",
  "version": "0.1.0",
  "description": "Console-based Audio Visualizer for ALSA",
  "source": "https://github.com/karlstav/cava",
  "checks": [
    {
      "type": "binary",
      "name": "cava"
    }
  ],
  "install_guidance": {
    "plugin": "cava",
    "binary": "cava",
    "check": "which cava",
    "install_steps": [
      "brew install cava",
      "Verify: cava --version",
      "supercli plugins install ./plugins/cava --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cava",
      "resource": "self",
      "action": "version",
      "description": "Print cava version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cava",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cava: brew install cava"
      },
      "args": []
    },
    {
      "namespace": "cava",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cava CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cava",
        "passthrough": true,
        "missingDependencyHelp": "Install cava"
      },
      "args": []
    }
  ]
}