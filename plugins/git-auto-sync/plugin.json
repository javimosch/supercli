{
  "name": "git-auto-sync",
  "version": "0.1.0",
  "description": "Sync directories via automatic git commits and pushes",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "git-auto-sync" }],
  "install_guidance": {
    "plugin": "git-auto-sync",
    "binary": "git-auto-sync",
    "check": "which git-auto-sync",
    "install_steps": ["git clone && make install", "Verify: git-auto-sync --version", "supercli plugins install ./plugins/git-auto-sync --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-auto-sync",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-auto-sync CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-auto-sync",
      "passthrough": true,
      "missingDependencyHelp": "Install git-auto-sync: git clone && make install"
    },
    "args": []
  }]
}
