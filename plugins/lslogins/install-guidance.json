{
  "plugin": "lslogins",
  "binary": "lslogins",
  "check": "which lslogins",
  "install_steps": [
    "# Install lslogins",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/lslogins-linux-amd64 -o /usr/local/bin/lslogins",
    "chmod +x /usr/local/bin/lslogins",
    "# Or via package manager, see /usr/bin/lslogins"
  ]
}