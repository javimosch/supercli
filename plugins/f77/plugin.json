{
  "name": "f77",
  "version": "0.1.0",
  "description": "CLI tool: f77",
  "source": "https://manpages.debian.org/f77",
  "checks": [
    {
      "type": "binary",
      "name": "f77"
    }
  ],
  "install_guidance": {
    "plugin": "f77",
    "binary": "f77",
    "check": "which f77",
    "install_steps": [
      "apt-get install f77 2>/dev/null || which f77",
      "Verify: f77 --version",
      "supercli plugins install ./plugins/f77 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "f77",
      "resource": "self",
      "action": "version",
      "description": "Print f77 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "f77",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install f77: apt-get install f77 2>/dev/null || which f77"
      },
      "args": []
    },
    {
      "namespace": "f77",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to f77 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "f77",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install f77: apt-get install f77 2>/dev/null || which f77"
      },
      "args": []
    }
  ]
}