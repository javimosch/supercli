{
  "name": "suna",
  "version": "0.1.0",
  "description": "The Company AI Command Center",
  "source": "https://github.com/suna/suna",
  "checks": [
    {
      "type": "binary",
      "name": "suna"
    }
  ],
  "install_guidance": {
    "plugin": "suna",
    "binary": "suna",
    "check": "which suna",
    "install_steps": [
      "pip install suna",
      "Verify: suna --version",
      "supercli plugins install ./plugins/suna --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "suna",
      "resource": "self",
      "action": "version",
      "description": "Print suna version",
      "adapter": "process",
      "adapterConfig": {
        "command": "suna",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install suna: pip install suna"
      },
      "args": []
    },
    {
      "namespace": "suna",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to suna CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "suna",
        "passthrough": true,
        "missingDependencyHelp": "Install suna: pip install suna"
      },
      "args": []
    }
  ]
}