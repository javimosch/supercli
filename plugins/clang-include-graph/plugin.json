{
  "name": "clang-include-graph",
  "version": "0.1.0",
  "description": "Simple tool for visualizing and analyzing C/C++ project include graph",
  "source": "https://github.com/bkryza/clang-include-graph",
  "checks": [
    {
      "type": "binary",
      "name": "clang-include-graph"
    }
  ],
  "install_guidance": {
    "plugin": "clang-include-graph",
    "binary": "clang-include-graph",
    "check": "which clang-include-graph",
    "install_steps": [
      "brew install clang-include-graph",
      "Verify: clang-include-graph --version",
      "supercli plugins install ./plugins/clang-include-graph --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clang-include-graph",
      "resource": "self",
      "action": "version",
      "description": "Print clang-include-graph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clang-include-graph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clang-include-graph: brew install clang-include-graph"
      },
      "args": []
    },
    {
      "namespace": "clang-include-graph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clang-include-graph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clang-include-graph",
        "passthrough": true,
        "missingDependencyHelp": "Install clang-include-graph"
      },
      "args": []
    }
  ]
}