{
  "name": "nob.h",
  "version": "0.1.0",
  "description": "Header only library for writing build recipes in C. ",
  "source": "https://github.com/nob.h/nob.h",
  "checks": [
    {
      "type": "binary",
      "name": "nob.h"
    }
  ],
  "install_guidance": {
    "plugin": "nob.h",
    "binary": "nob.h",
    "check": "which nob.h",
    "install_steps": [
      "pip install nob.h",
      "Verify: nob.h --version",
      "supercli plugins install ./plugins/nob.h --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nob.h",
      "resource": "self",
      "action": "version",
      "description": "Print nob.h version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nob.h",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nob.h: pip install nob.h"
      },
      "args": []
    },
    {
      "namespace": "nob.h",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nob.h CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nob.h",
        "passthrough": true,
        "missingDependencyHelp": "Install nob.h: pip install nob.h"
      },
      "args": []
    }
  ]
}