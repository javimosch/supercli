{
  "name": "gopls",
  "version": "0.1.0",
  "description": "Language server for the Go language",
  "source": "https://github.com/golang/tools/tree/master/gopls",
  "checks": [
    {
      "type": "binary",
      "name": "gopls"
    }
  ],
  "install_guidance": {
    "plugin": "gopls",
    "binary": "gopls",
    "check": "which gopls",
    "install_steps": [
      "brew install gopls",
      "Verify: gopls --version",
      "supercli plugins install ./plugins/gopls --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gopls",
      "resource": "self",
      "action": "version",
      "description": "Print gopls version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gopls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gopls: brew install gopls"
      },
      "args": []
    },
    {
      "namespace": "gopls",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gopls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gopls",
        "passthrough": true,
        "missingDependencyHelp": "Install gopls"
      },
      "args": []
    }
  ]
}