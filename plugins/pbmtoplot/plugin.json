{
  "name": "pbmtoplot",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoplot",
  "source": "https://manpages.debian.org/pbmtoplot",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoplot"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoplot",
    "binary": "pbmtoplot",
    "check": "which pbmtoplot",
    "install_steps": [
      "apt-get install pbmtoplot 2>/dev/null || which pbmtoplot",
      "Verify: pbmtoplot --version",
      "supercli plugins install ./plugins/pbmtoplot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoplot",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoplot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoplot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoplot: apt-get install pbmtoplot 2>/dev/null || which pbmtoplot"
      },
      "args": []
    },
    {
      "namespace": "pbmtoplot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoplot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoplot",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoplot: apt-get install pbmtoplot 2>/dev/null || which pbmtoplot"
      },
      "args": []
    }
  ]
}