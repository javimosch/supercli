{
  "name": "qmlbundle",
  "version": "0.1.0",
  "description": "CLI tool: qmlbundle",
  "source": "https://manpages.debian.org/qmlbundle",
  "checks": [
    {
      "type": "binary",
      "name": "qmlbundle"
    }
  ],
  "install_guidance": {
    "plugin": "qmlbundle",
    "binary": "qmlbundle",
    "check": "which qmlbundle",
    "install_steps": [
      "apt-get install qmlbundle 2>/dev/null || which qmlbundle",
      "Verify: qmlbundle --version",
      "supercli plugins install ./plugins/qmlbundle --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmlbundle",
      "resource": "self",
      "action": "version",
      "description": "Print qmlbundle version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlbundle",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmlbundle: apt-get install qmlbundle 2>/dev/null || which qmlbundle"
      },
      "args": []
    },
    {
      "namespace": "qmlbundle",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmlbundle CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlbundle",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmlbundle: apt-get install qmlbundle 2>/dev/null || which qmlbundle"
      },
      "args": []
    }
  ]
}