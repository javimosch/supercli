{
  "name": "ipp-usb",
  "version": "0.1.0",
  "description": "CLI tool: ipp-usb",
  "source": "https://manpages.debian.org/ipp-usb",
  "checks": [
    {
      "type": "binary",
      "name": "ipp-usb"
    }
  ],
  "install_guidance": {
    "plugin": "ipp-usb",
    "binary": "ipp-usb",
    "check": "which ipp-usb",
    "install_steps": [
      "apt-get install ipp-usb 2>/dev/null || which ipp-usb",
      "Verify: ipp-usb --version",
      "supercli plugins install ./plugins/ipp-usb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ipp-usb",
      "resource": "self",
      "action": "version",
      "description": "Print ipp-usb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipp-usb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipp-usb: apt-get install ipp-usb 2>/dev/null || which ipp-usb"
      },
      "args": []
    },
    {
      "namespace": "ipp-usb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipp-usb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipp-usb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ipp-usb: apt-get install ipp-usb 2>/dev/null || which ipp-usb"
      },
      "args": []
    }
  ]
}