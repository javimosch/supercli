{
  "name": "pocket-tagger",
  "version": "0.1.0",
  "description": "CLI tool for tagging and sorting saved items and habits",
  "source": "go",
  "checks": [{ "type": "binary", "name": "pocket-tagger" }],
  "install_guidance": {
    "plugin": "pocket-tagger",
    "binary": "pocket-tagger",
    "check": "which pocket-tagger",
    "install_steps": ["go install github.com/michaelheap/pocket-tagger@latest", "Verify: pocket-tagger --version", "supercli plugins install ./plugins/pocket-tagger --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pocket-tagger",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pocket-tagger CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pocket-tagger",
      "passthrough": true,
      "missingDependencyHelp": "Install pocket-tagger: go install github.com/michaelheap/pocket-tagger@latest"
    },
    "args": []
  }]
}
