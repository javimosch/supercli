{
  "name": "qwen-code",
  "version": "0.1.0",
  "description": "An open-source AI coding agent that lives in your terminal.",
  "source": "https://github.com/qwen-code/qwen-code",
  "checks": [
    {
      "type": "binary",
      "name": "qwen-code"
    }
  ],
  "install_guidance": {
    "plugin": "qwen-code",
    "binary": "qwen-code",
    "check": "which qwen-code",
    "install_steps": [
      "pip install qwen-code",
      "Verify: qwen-code --version",
      "supercli plugins install ./plugins/qwen-code --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qwen-code",
      "resource": "self",
      "action": "version",
      "description": "Print qwen-code version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qwen-code",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qwen-code: pip install qwen-code"
      },
      "args": []
    },
    {
      "namespace": "qwen-code",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qwen-code CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qwen-code",
        "passthrough": true,
        "missingDependencyHelp": "Install qwen-code: pip install qwen-code"
      },
      "args": []
    }
  ]
}