{
  "name": "mpif90",
  "version": "0.1.0",
  "description": "CLI tool: mpif90",
  "source": "https://manpages.debian.org/mpif90",
  "checks": [
    {
      "type": "binary",
      "name": "mpif90"
    }
  ],
  "install_guidance": {
    "plugin": "mpif90",
    "binary": "mpif90",
    "check": "which mpif90",
    "install_steps": [
      "apt-get install mpif90 2>/dev/null || which mpif90",
      "Verify: mpif90 --version",
      "supercli plugins install ./plugins/mpif90 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpif90",
      "resource": "self",
      "action": "version",
      "description": "Print mpif90 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpif90",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpif90: apt-get install mpif90 2>/dev/null || which mpif90"
      },
      "args": []
    },
    {
      "namespace": "mpif90",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpif90 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpif90",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mpif90: apt-get install mpif90 2>/dev/null || which mpif90"
      },
      "args": []
    }
  ]
}