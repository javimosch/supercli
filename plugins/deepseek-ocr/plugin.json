{
  "name": "deepseek-ocr",
  "version": "0.1.0",
  "description": "Contexts Optical Compression for vision-based language models by DeepSeek",
  "source": "https://github.com/deepseek-ai/DeepSeek-OCR",
  "checks": [
    {
      "type": "binary",
      "name": "deepseek-ocr"
    }
  ],
  "install_guidance": {
    "plugin": "deepseek-ocr",
    "binary": "deepseek-ocr",
    "check": "which deepseek-ocr",
    "install_steps": [
      "pip install deepseek-ocr",
      "Verify: deepseek-ocr --version",
      "supercli plugins install ./plugins/deepseek-ocr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "deepseek-ocr",
    "resource": "self",
    "action": "version",
    "description": "Print deepseek-ocr version",
    "adapter": "process",
    "adapterConfig": {
      "command": "deepseek-ocr",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install deepseek-ocr: pip install deepseek-ocr"
    },
    "args": []
  },
  {
    "namespace": "deepseek-ocr",
    "resource": "image",
    "action": "compress",
    "description": "Compress image for LLM context",
    "adapter": "process",
    "adapterConfig": {
      "command": "deepseek-ocr",
      "passthrough": true,
      "missingDependencyHelp": "Install deepseek-ocr: pip install deepseek-ocr"
    },
    "args": []
  },
  {
    "namespace": "deepseek-ocr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to deepseek-ocr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "deepseek-ocr",
      "passthrough": true,
      "missingDependencyHelp": "Install deepseek-ocr"
    },
    "args": []
  }
]
}