{
  "name": "transmission-gtk",
  "version": "0.1.0",
  "description": "CLI tool: transmission-gtk",
  "source": "https://manpages.debian.org/transmission-gtk",
  "checks": [
    {
      "type": "binary",
      "name": "transmission-gtk"
    }
  ],
  "install_guidance": {
    "plugin": "transmission-gtk",
    "binary": "transmission-gtk",
    "check": "which transmission-gtk",
    "install_steps": [
      "apt-get install transmission-gtk 2>/dev/null || which transmission-gtk",
      "Verify: transmission-gtk --version",
      "supercli plugins install ./plugins/transmission-gtk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "transmission-gtk",
      "resource": "self",
      "action": "version",
      "description": "Print transmission-gtk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "transmission-gtk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install transmission-gtk: apt-get install transmission-gtk 2>/dev/null || which transmission-gtk"
      },
      "args": []
    },
    {
      "namespace": "transmission-gtk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to transmission-gtk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "transmission-gtk",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install transmission-gtk: apt-get install transmission-gtk 2>/dev/null || which transmission-gtk"
      },
      "args": []
    }
  ]
}