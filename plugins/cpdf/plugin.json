{
  "name": "cpdf",
  "version": "0.1.0",
  "description": "PDF Command-line Tools",
  "source": "https://github.com/johnwhitington/cpdf-source",
  "checks": [
    {
      "type": "binary",
      "name": "cpdf"
    }
  ],
  "install_guidance": {
    "plugin": "cpdf",
    "binary": "cpdf",
    "check": "which cpdf",
    "install_steps": [
      "brew install cpdf",
      "Verify: cpdf --version",
      "supercli plugins install ./plugins/cpdf --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cpdf",
      "resource": "self",
      "action": "version",
      "description": "Print cpdf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cpdf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cpdf: brew install cpdf"
      },
      "args": []
    },
    {
      "namespace": "cpdf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cpdf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cpdf",
        "passthrough": true,
        "missingDependencyHelp": "Install cpdf"
      },
      "args": []
    }
  ]
}