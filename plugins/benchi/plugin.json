{
  "name": "benchi",
  "version": "0.1.0",
  "description": "Benchmarking tool for data pipelines",
  "source": "https://github.com/ConduitIO/benchi",
  "checks": [
    {
      "type": "binary",
      "name": "benchi"
    }
  ],
  "install_guidance": {
    "plugin": "benchi",
    "binary": "benchi",
    "check": "which benchi",
    "install_steps": [
      "brew install benchi",
      "Verify: benchi --version",
      "supercli plugins install ./plugins/benchi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "benchi",
      "resource": "self",
      "action": "version",
      "description": "Print benchi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "benchi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install benchi: brew install benchi"
      },
      "args": []
    },
    {
      "namespace": "benchi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to benchi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "benchi",
        "passthrough": true,
        "missingDependencyHelp": "Install benchi"
      },
      "args": []
    }
  ]
}