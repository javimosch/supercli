{
  "name": "rgb-conv",
  "version": "0.1.0",
  "description": "Convert between RGB and other color formats via CLI",
  "source": "https://github.com/pankaj-upadhyay/rgb-conv",
  "checks": [{ "type": "binary", "name": "rgb-conv" }],
  "install_guidance": {
    "plugin": "rgb-conv",
    "binary": "rgb-conv",
    "check": "which rgb-conv",
    "install_steps": ["pip install rgb-conv", "Verify: rgb-conv --version", "supercli plugins install ./plugins/rgb-conv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rgb-conv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rgb-conv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rgb-conv",
      "passthrough": true,
      "missingDependencyHelp": "Install rgb-conv: pip install rgb-conv", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
