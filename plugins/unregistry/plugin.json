{
  "name": "unregistry",
  "version": "0.1.0",
  "description": "Push docker images directly to remote servers without an external registry",
  "source": "https://github.com/unregistry/unregistry",
  "checks": [
    {
      "type": "binary",
      "name": "unregistry"
    }
  ],
  "install_guidance": {
    "plugin": "unregistry",
    "binary": "unregistry",
    "check": "which unregistry",
    "install_steps": [
      "pip install unregistry",
      "Verify: unregistry --version",
      "supercli plugins install ./plugins/unregistry --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unregistry",
      "resource": "self",
      "action": "version",
      "description": "Print unregistry version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unregistry",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unregistry: pip install unregistry"
      },
      "args": []
    },
    {
      "namespace": "unregistry",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unregistry CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unregistry",
        "passthrough": true,
        "missingDependencyHelp": "Install unregistry: pip install unregistry"
      },
      "args": []
    }
  ]
}