{
  "plugin": "unregistry",
  "binary": "unregistry",
  "check": "which unregistry",
  "install_steps": [
    "go install github.com/psviderski/unregistry@latest",
    "Verify: unregistry --version",
    "supercli plugins install ./plugins/unregistry --on-conflict replace --json"
  ],
  "note": "Push Docker images directly to remote servers over SSH."
}
