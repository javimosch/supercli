{
  "plugin": "py3rsa-verify",
  "binary": "py3rsa-verify",
  "check": "which py3rsa-verify",
  "install_steps": [
    "apt-get install py3rsa-verify 2>/dev/null || which py3rsa-verify",
    "Verify: py3rsa-verify --version",
    "supercli plugins install ./plugins/py3rsa-verify --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}