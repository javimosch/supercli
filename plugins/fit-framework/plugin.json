{
  "name": "fit-framework",
  "version": "0.1.0",
  "description": "FIT: \u4f01\u4e1a\u7ea7AI\u5f00\u53d1\u6846\u67b6\uff0c\u63d0\u4f9b\u591a\u8bed\u8a00\u51fd\u6570\u5f15\u64ce\uff08FIT\uff09\u3001\u6d41\u5f0f\u7f16\u6392\u5f15\u64ce\uff08WaterFlow\uff09\u53caJava\u751f\u6001\u7684LangChain\u66ff\u4ee3\u65b9\u6848\uff08FEL\uff09\u3002\u539f\u751f/Spring\u53cc\u6a21\u8fd0\u884c\uff0c\u652f\u6301\u63d2\u4ef6\u70ed\u63d2\u62d4\u4e0e\u667a\u80fd\u805a\u6563",
  "source": "https://github.com/fit-framework/fit-framework",
  "checks": [
    {
      "type": "binary",
      "name": "fit-framework"
    }
  ],
  "install_guidance": {
    "plugin": "fit-framework",
    "binary": "fit-framework",
    "check": "which fit-framework",
    "install_steps": [
      "pip install fit-framework",
      "Verify: fit-framework --version",
      "supercli plugins install ./plugins/fit-framework --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fit-framework",
      "resource": "self",
      "action": "version",
      "description": "Print fit-framework version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fit-framework",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fit-framework: pip install fit-framework"
      },
      "args": []
    },
    {
      "namespace": "fit-framework",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fit-framework CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fit-framework",
        "passthrough": true,
        "missingDependencyHelp": "Install fit-framework: pip install fit-framework"
      },
      "args": []
    }
  ]
}