{
  "name": "questionary",
  "version": "0.1.0",
  "description": "Python CLI prompts library with non-interactive mode",
  "source": "https://github.com/tmbo/questionary",
  "checks": [
    {
      "type": "binary",
      "name": "questionary"
    }
  ],
  "install_guidance": {
    "plugin": "questionary",
    "binary": "questionary",
    "check": "which questionary",
    "install_steps": [
      "pip install questionary",
      "Verify: questionary --version",
      "supercli plugins install ./plugins/questionary --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "questionary",
      "resource": "self",
      "action": "version",
      "description": "Print questionary version",
      "adapter": "process",
      "adapterConfig": {
        "command": "questionary",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install questionary: pip install questionary"
      },
      "args": []
    },
    {
      "namespace": "questionary",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to questionary CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "questionary",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install questionary: pip install questionary"
      },
      "args": []
    }
  ]
}
