{
  "name": "pocketbase",
  "version": "0.3.0",
  "description": "PocketBase open-source backend CLI",
  "source": "https://github.com/pocketbase/pocketbase",
  "checks": [
    {
      "type": "binary",
      "name": "pocketbase"
    }
  ],
  "install_guidance": {
    "plugin": "pocketbase",
    "binary": "pocketbase",
    "check": "which pocketbase",
    "install_steps": [
      "brew install pocketbase",
      "Verify: pocketbase --version",
      "supercli plugins install ./plugins/pocketbase --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "pocketbase",
      "resource": "self",
      "action": "serve",
      "description": "Start PocketBase server in development mode",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/serve.js",
          "start"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    },
    {
      "namespace": "pocketbase",
      "resource": "server",
      "action": "stop",
      "description": "Stop PocketBase server",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/serve.js",
          "stop"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    },
    {
      "namespace": "pocketbase",
      "resource": "server",
      "action": "restart",
      "description": "Restart PocketBase server",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/serve.js",
          "restart"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    },
    {
      "namespace": "pocketbase",
      "resource": "server",
      "action": "status",
      "description": "Check PocketBase server status",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/serve.js",
          "status"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    },
    {
      "namespace": "pocketbase",
      "resource": "health",
      "action": "check",
      "description": "Check PocketBase server health and response time",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/health-check.js"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    },
    {
      "namespace": "pocketbase",
      "resource": "self",
      "action": "version",
      "description": "Print pocketbase version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pocketbase",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    },
    {
      "namespace": "pocketbase",
      "resource": "migration",
      "action": "create",
      "description": "Create a new migration file (non-interactive with --force)",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/migration-manager.js",
          "create"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": [
        {
          "name": "name",
          "description": "Migration name",
          "required": true
        },
        {
          "name": "force",
          "description": "Skip confirmation prompt",
          "required": false
        }
      ]
    },
    {
      "namespace": "pocketbase",
      "resource": "migration",
      "action": "up",
      "description": "Apply pending migrations (non-interactive with --force)",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/migration-manager.js",
          "up"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": [
        {
          "name": "force",
          "description": "Skip confirmation prompt",
          "required": false
        }
      ]
    },
    {
      "namespace": "pocketbase",
      "resource": "migration",
      "action": "down",
      "description": "Revert last N migrations (non-interactive with --force)",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/migration-manager.js",
          "down"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": [
        {
          "name": "count",
          "description": "Number of migrations to revert (default: 1)",
          "required": false
        },
        {
          "name": "force",
          "description": "Skip confirmation prompt",
          "required": false
        }
      ]
    },
    {
      "namespace": "pocketbase",
      "resource": "collection",
      "action": "create",
      "description": "Create a new PocketBase collection",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/collection-manager.js",
          "create"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": [
        {
          "name": "name",
          "description": "Collection name",
          "required": true
        },
        {
          "name": "type",
          "description": "Collection type (base or auth)",
          "required": false
        }
      ]
    },
    {
      "namespace": "pocketbase",
      "resource": "collection",
      "action": "list",
      "description": "List all PocketBase collections",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/collection-manager.js",
          "list"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    },
    {
      "namespace": "pocketbase",
      "resource": "collection",
      "action": "delete",
      "description": "Delete a PocketBase collection",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "baseArgs": [
          "/home/jarancibia/ai/supercli/plugins/pocketbase/collection-manager.js",
          "delete"
        ],
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": [
        {
          "name": "id",
          "description": "Collection ID",
          "required": true
        }
      ]
    },
    {
      "namespace": "pocketbase",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pocketbase CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pocketbase",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pocketbase: brew install pocketbase"
      },
      "args": []
    }
  ]
}
