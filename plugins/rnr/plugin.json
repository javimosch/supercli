{
  "name": "rnr",
  "version": "1.0.0",
  "description": "rnr \u2014 Batch rename tool",
  "source": "crates.io/crates/rnr",
  "checks": [
    {
      "type": "binary",
      "name": "rnr"
    }
  ],
  "install_guidance": {
    "plugin": "rnr",
    "binary": "rnr",
    "check": "which rnr",
    "install_steps": [
      "# Install rnr:",
      "# apt: sudo apt-get install rnr",
      "# brew: brew install rnr",
      "# cargo: cargo install rnr",
      "# npm: npm install -g rnr",
      "# pip: pip install rnr",
      "# or download from crates.io/crates/rnr"
    ]
  },
  "commands": [
    {
      "namespace": "rnr",
      "resource": "rnr",
      "action": "run",
      "description": "Run rnr",
      "adapter": "process",
      "adapterConfig": {
        "command": "rnr",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rnr from crates.io/crates/rnr"
      },
      "args": []
    }
  ]
}