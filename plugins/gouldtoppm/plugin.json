{
  "name": "gouldtoppm",
  "version": "0.1.0",
  "description": "CLI tool: gouldtoppm",
  "source": "https://manpages.debian.org/gouldtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "gouldtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "gouldtoppm",
    "binary": "gouldtoppm",
    "check": "which gouldtoppm",
    "install_steps": [
      "apt-get install gouldtoppm 2>/dev/null || which gouldtoppm",
      "Verify: gouldtoppm --version",
      "supercli plugins install ./plugins/gouldtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gouldtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print gouldtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gouldtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gouldtoppm: apt-get install gouldtoppm 2>/dev/null || which gouldtoppm"
      },
      "args": []
    },
    {
      "namespace": "gouldtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gouldtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gouldtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gouldtoppm: apt-get install gouldtoppm 2>/dev/null || which gouldtoppm"
      },
      "args": []
    }
  ]
}