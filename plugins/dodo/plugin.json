{
  "name": "dodo",
  "version": "0.1.0",
  "description": "Graphical CLI hybrid email client based on notmuch for Python",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "dodo" }],
  "install_guidance": {
    "plugin": "dodo",
    "binary": "dodo",
    "check": "which dodo",
    "install_steps": ["pip install dodo-email", "Verify: dodo --version", "supercli plugins install ./plugins/dodo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dodo",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dodo CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dodo",
      "passthrough": true,
      "missingDependencyHelp": "Install dodo: pip install dodo-email"
    },
    "args": []
  }]
}
