{
  "name": "ACGC-PC-Port",
  "version": "0.1.0",
  "description": "Unofficial PC Port of Animal Crossing Gamecube",
  "source": "https://github.com/ACGC-PC-Port/ACGC-PC-Port",
  "checks": [
    {
      "type": "binary",
      "name": "acgc-pc-port"
    }
  ],
  "install_guidance": {
    "plugin": "ACGC-PC-Port",
    "binary": "acgc-pc-port",
    "check": "which acgc-pc-port",
    "install_steps": [
      "pip install acgc-pc-port",
      "Verify: acgc-pc-port --version",
      "supercli plugins install ./plugins/ACGC-PC-Port --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ACGC-PC-Port",
      "resource": "self",
      "action": "version",
      "description": "Print ACGC-PC-Port version",
      "adapter": "process",
      "adapterConfig": {
        "command": "acgc-pc-port",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ACGC-PC-Port: pip install acgc-pc-port"
      },
      "args": []
    },
    {
      "namespace": "ACGC-PC-Port",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to acgc-pc-port CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "acgc-pc-port",
        "passthrough": true,
        "missingDependencyHelp": "Install ACGC-PC-Port: pip install acgc-pc-port"
      },
      "args": []
    }
  ]
}