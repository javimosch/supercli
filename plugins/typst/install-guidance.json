{
  "plugin": "typst",
  "binary": "typst",
  "check": "which typst",
  "install_steps": [
    "brew install typst",
    "Verify: typst --version",
    "supercli plugins install ./plugins/typst --on-conflict replace --json"
  ],
  "note": "Install from package manager. Also available via cargo: cargo install typst-cli"
}
