{
  "name": "vibe-kanban",
  "version": "0.1.0",
  "description": "Get 10X more out of Claude Code, Codex or any coding agent",
  "source": "https://github.com/vibe-kanban/vibe-kanban",
  "checks": [
    {
      "type": "binary",
      "name": "vibe-kanban"
    }
  ],
  "install_guidance": {
    "plugin": "vibe-kanban",
    "binary": "vibe-kanban",
    "check": "which vibe-kanban",
    "install_steps": [
      "pip install vibe-kanban",
      "Verify: vibe-kanban --version",
      "supercli plugins install ./plugins/vibe-kanban --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vibe-kanban",
      "resource": "self",
      "action": "version",
      "description": "Print vibe-kanban version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibe-kanban",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vibe-kanban: pip install vibe-kanban"
      },
      "args": []
    },
    {
      "namespace": "vibe-kanban",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vibe-kanban CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibe-kanban",
        "passthrough": true,
        "missingDependencyHelp": "Install vibe-kanban: pip install vibe-kanban"
      },
      "args": []
    }
  ]
}