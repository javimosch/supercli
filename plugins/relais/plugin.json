{
  "name": "relais",
  "version": "0.1.0",
  "description": "An inbox your agent can block on \u2014 catch webhooks, OAuth callbacks and approvals from any ephemeral agent",
  "source": "https://github.com/javimosch/relais",
  "checks": [
    {
      "type": "binary",
      "name": "relais"
    }
  ],
  "install_guidance": {
    "plugin": "relais",
    "binary": "relais",
    "check": "which relais",
    "install_steps": [
      "Build from source: https://github.com/javimosch/relais",
      "Verify: relais version || relais guide"
    ]
  },
  "commands": [
    {
      "namespace": "relais",
      "resource": "inbox",
      "action": "new",
      "description": "Create a new ephemeral inbox",
      "adapter": "process",
      "adapterConfig": {
        "command": "relais",
        "baseArgs": [
          "inbox-new"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install relais from https://github.com/javimosch/relais"
      },
      "args": [
        {
          "name": "label",
          "type": "string",
          "required": false,
          "description": "Optional label"
        }
      ]
    },
    {
      "namespace": "relais",
      "resource": "inbox",
      "action": "list",
      "description": "List all inboxes",
      "adapter": "process",
      "adapterConfig": {
        "command": "relais",
        "baseArgs": [
          "inboxes"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install relais from https://github.com/javimosch/relais"
      },
      "args": []
    },
    {
      "namespace": "relais",
      "resource": "stats",
      "action": "show",
      "description": "Show platform statistics",
      "adapter": "process",
      "adapterConfig": {
        "command": "relais",
        "baseArgs": [
          "stats"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install relais from https://github.com/javimosch/relais"
      },
      "args": []
    },
    {
      "namespace": "relais",
      "resource": "self",
      "action": "guide",
      "description": "Print the agent guide (JSON)",
      "adapter": "process",
      "adapterConfig": {
        "command": "relais",
        "baseArgs": [
          "guide"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install relais from https://github.com/javimosch/relais"
      },
      "args": []
    },
    {
      "namespace": "relais",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "relais",
        "baseArgs": [
          "version"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install relais from https://github.com/javimosch/relais"
      },
      "args": []
    }
  ]
}