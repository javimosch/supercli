{
  "name": "dee-parking",
  "version": "0.1.0",
  "description": "Find parking locations from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-parking" }],
  "install_guidance": {
    "plugin": "dee-parking",
    "binary": "dee-parking",
    "check": "which dee-parking",
    "install_steps": ["cargo install dee-parking", "Verify: dee-parking --version", "supercli plugins install ./plugins/dee-parking --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-parking",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-parking CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-parking",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-parking: cargo install dee-parking"
    },
    "args": []
  }]
}
