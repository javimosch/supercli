{
  "name": "getopts",
  "version": "0.1.0",
  "description": "getopts — command-line argument parsing library",
  "source": "https://github.com/rust-lang/getopts",
  "checks": [
    {
      "type": "binary",
      "name": "getopts"
    }
  ],
  "install_guidance": {
    "plugin": "getopts",
    "binary": "getopts",
    "check": "which getopts",
    "install_steps": [
      "cargo add getopts",
      "Verify: getopts --version",
      "supercli plugins install ./plugins/getopts --on-conflict replace --json"
    ],
    "note": "getopts is a Rust library — use `cargo add getopts` inside a Rust project."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "getopts",
      "resource": "self",
      "action": "version",
      "description": "Print getopts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "getopts",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install getopts: cargo add getopts"
      },
      "args": []
    }
  ]
}
