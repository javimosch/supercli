{
  "plugin": "getopts",
  "binary": "getopts",
  "check": "which getopts",
  "install_steps": [
    "cargo add getopts",
    "Verify: getopts --version",
    "supercli plugins install ./plugins/getopts --on-conflict replace --json"
  ],
  "note": "getopts is a Rust library — use `cargo add getopts` inside a Rust project."
}
