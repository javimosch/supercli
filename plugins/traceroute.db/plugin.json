{
  "name": "traceroute.db",
  "version": "0.1.0",
  "description": "CLI tool: traceroute.db",
  "source": "https://manpages.debian.org/traceroute.db",
  "checks": [
    {
      "type": "binary",
      "name": "traceroute.db"
    }
  ],
  "install_guidance": {
    "plugin": "traceroute.db",
    "binary": "traceroute.db",
    "check": "which traceroute.db",
    "install_steps": [
      "apt-get install traceroute.db 2>/dev/null || which traceroute.db",
      "Verify: traceroute.db --version",
      "supercli plugins install ./plugins/traceroute.db --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "traceroute.db",
      "resource": "self",
      "action": "version",
      "description": "Print traceroute.db version",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceroute.db",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install traceroute.db: apt-get install traceroute.db 2>/dev/null || which traceroute.db"
      },
      "args": []
    },
    {
      "namespace": "traceroute.db",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to traceroute.db CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceroute.db",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install traceroute.db: apt-get install traceroute.db 2>/dev/null || which traceroute.db"
      },
      "args": []
    }
  ]
}