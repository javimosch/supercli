{
  "name": "BiliPai",
  "version": "0.1.0",
  "description": "\u539f\u751f\u3001\u7eaf\u51c0\u3001\u53ef\u6269\u5c55 \u2014\u2014 \u91cd\u65b0\u5b9a\u4e49\u4f60\u7684 B \u7ad9\u4f53\u9a8c",
  "source": "https://github.com/BiliPai/BiliPai",
  "checks": [
    {
      "type": "binary",
      "name": "bilipai"
    }
  ],
  "install_guidance": {
    "plugin": "BiliPai",
    "binary": "bilipai",
    "check": "which bilipai",
    "install_steps": [
      "pip install bilipai",
      "Verify: bilipai --version",
      "supercli plugins install ./plugins/BiliPai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BiliPai",
      "resource": "self",
      "action": "version",
      "description": "Print BiliPai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bilipai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BiliPai: pip install bilipai"
      },
      "args": []
    },
    {
      "namespace": "BiliPai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bilipai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bilipai",
        "passthrough": true,
        "missingDependencyHelp": "Install BiliPai: pip install bilipai"
      },
      "args": []
    }
  ]
}