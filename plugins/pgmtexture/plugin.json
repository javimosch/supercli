{
  "name": "pgmtexture",
  "version": "0.1.0",
  "description": "CLI tool: pgmtexture",
  "source": "https://manpages.debian.org/pgmtexture",
  "checks": [
    {
      "type": "binary",
      "name": "pgmtexture"
    }
  ],
  "install_guidance": {
    "plugin": "pgmtexture",
    "binary": "pgmtexture",
    "check": "which pgmtexture",
    "install_steps": [
      "apt-get install pgmtexture 2>/dev/null || which pgmtexture",
      "Verify: pgmtexture --version",
      "supercli plugins install ./plugins/pgmtexture --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgmtexture",
      "resource": "self",
      "action": "version",
      "description": "Print pgmtexture version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmtexture",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgmtexture: apt-get install pgmtexture 2>/dev/null || which pgmtexture"
      },
      "args": []
    },
    {
      "namespace": "pgmtexture",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgmtexture CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmtexture",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pgmtexture: apt-get install pgmtexture 2>/dev/null || which pgmtexture"
      },
      "args": []
    }
  ]
}