{
  "name": "termora",
  "version": "0.1.0",
  "description": "Termora is a terminal emulator and SSH client for Windows, macOS and Linux.",
  "source": "https://github.com/termora/termora",
  "checks": [
    {
      "type": "binary",
      "name": "termora"
    }
  ],
  "install_guidance": {
    "plugin": "termora",
    "binary": "termora",
    "check": "which termora",
    "install_steps": [
      "pip install termora",
      "Verify: termora --version",
      "supercli plugins install ./plugins/termora --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "termora",
      "resource": "self",
      "action": "version",
      "description": "Print termora version",
      "adapter": "process",
      "adapterConfig": {
        "command": "termora",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install termora: pip install termora"
      },
      "args": []
    },
    {
      "namespace": "termora",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to termora CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "termora",
        "passthrough": true,
        "missingDependencyHelp": "Install termora: pip install termora"
      },
      "args": []
    }
  ]
}