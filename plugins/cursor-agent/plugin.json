{
  "name": "cursor-agent",
  "version": "0.1.0",
  "description": "CLI tool: cursor-agent",
  "source": "https://packages.debian.org/cursor-agent",
  "checks": [{ "type": "binary", "name": "cursor-agent" }],
  "install_guidance": {
    "plugin": "cursor-agent", "binary": "cursor-agent", "check": "which cursor-agent",
    "install_steps": ["apt-get install cursor-agent 2>/dev/null || which cursor-agent", "Verify: cursor-agent --version", "supercli plugins install ./plugins/cursor-agent --on-conflict replace --json"]
