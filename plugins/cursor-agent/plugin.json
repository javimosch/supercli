    "namespace": "cursor-agent", "resource": "_", "action": "_",
    "description": "Passthrough to cursor-agent CLI",
    "adapter": "process", "adapterConfig": { "command": "cursor-agent", "passthrough": true, "missingDependencyHelp": "Install cursor-agent: apt-get install cursor-agent" }, "args": []
  }]
}
