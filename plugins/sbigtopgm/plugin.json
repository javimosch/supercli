{
  "name": "sbigtopgm",
  "version": "0.1.0",
  "description": "CLI tool: sbigtopgm",
  "source": "https://manpages.debian.org/sbigtopgm",
  "checks": [
    {
      "type": "binary",
      "name": "sbigtopgm"
    }
  ],
  "install_guidance": {
    "plugin": "sbigtopgm",
    "binary": "sbigtopgm",
    "check": "which sbigtopgm",
    "install_steps": [
      "apt-get install sbigtopgm 2>/dev/null || which sbigtopgm",
      "Verify: sbigtopgm --version",
      "supercli plugins install ./plugins/sbigtopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sbigtopgm",
      "resource": "self",
      "action": "version",
      "description": "Print sbigtopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sbigtopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sbigtopgm: apt-get install sbigtopgm 2>/dev/null || which sbigtopgm"
      },
      "args": []
    },
    {
      "namespace": "sbigtopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sbigtopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sbigtopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sbigtopgm: apt-get install sbigtopgm 2>/dev/null || which sbigtopgm"
      },
      "args": []
    }
  ]
}