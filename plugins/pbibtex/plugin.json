{
  "name": "pbibtex",
  "version": "0.1.0",
  "description": "CLI tool: pbibtex",
  "source": "https://manpages.debian.org/pbibtex",
  "checks": [
    {
      "type": "binary",
      "name": "pbibtex"
    }
  ],
  "install_guidance": {
    "plugin": "pbibtex",
    "binary": "pbibtex",
    "check": "which pbibtex",
    "install_steps": [
      "apt-get install pbibtex 2>/dev/null || which pbibtex",
      "Verify: pbibtex --version",
      "supercli plugins install ./plugins/pbibtex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbibtex",
      "resource": "self",
      "action": "version",
      "description": "Print pbibtex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbibtex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbibtex: apt-get install pbibtex 2>/dev/null || which pbibtex"
      },
      "args": []
    },
    {
      "namespace": "pbibtex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbibtex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbibtex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbibtex: apt-get install pbibtex 2>/dev/null || which pbibtex"
      },
      "args": []
    }
  ]
}