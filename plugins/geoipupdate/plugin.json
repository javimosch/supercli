{
  "name": "geoipupdate",
  "version": "0.1.0",
  "description": "Automatic updates of GeoIP2 and GeoIP Legacy databases",
  "source": "https://github.com/maxmind/geoipupdate",
  "checks": [
    {
      "type": "binary",
      "name": "geoipupdate"
    }
  ],
  "install_guidance": {
    "plugin": "geoipupdate",
    "binary": "geoipupdate",
    "check": "which geoipupdate",
    "install_steps": [
      "brew install geoipupdate",
      "Verify: geoipupdate --version",
      "supercli plugins install ./plugins/geoipupdate --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "geoipupdate",
      "resource": "self",
      "action": "version",
      "description": "Print geoipupdate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "geoipupdate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install geoipupdate: brew install geoipupdate"
      },
      "args": []
    },
    {
      "namespace": "geoipupdate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to geoipupdate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "geoipupdate",
        "passthrough": true,
        "missingDependencyHelp": "Install geoipupdate"
      },
      "args": []
    }
  ]
}