{
  "plugin": "geoipupdate",
  "binary": "geoipupdate",
  "check": "which geoipupdate",
  "install_steps": [
    "brew install geoipupdate",
    "Verify: geoipupdate --version",
    "supercli plugins install ./plugins/geoipupdate --on-conflict replace --json"
  ],
  "note": "Install from package manager"
}