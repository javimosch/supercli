{
  "name": "MIHOMO_YAMLS",
  "version": "0.1.0",
  "description": "\u4e00\u4e2a\u7cbe\u5fc3\u6574\u7406\u7684 Mihomo (Clash Meta) \u914d\u7f6e\u6587\u4ef6\u4ed3\u5e93\uff0c\u901a\u8fc7 GitHub Actions \u6bcf\u65e5\u81ea\u52a8\u540c\u6b65\u4e0a\u6e38\u4f18\u8d28\u89c4\u5219\uff0c\u63d0\u4f9b\u4ece\u5165\u95e8\u5230\u8fdb\u9636\u7684\u5b8c\u6574\u89e3\u51b3\u65b9\u6848\u3002",
  "source": "https://github.com/MIHOMO_YAMLS/MIHOMO_YAMLS",
  "checks": [
    {
      "type": "binary",
      "name": "mihomo-yamls"
    }
  ],
  "install_guidance": {
    "plugin": "MIHOMO_YAMLS",
    "binary": "mihomo-yamls",
    "check": "which mihomo-yamls",
    "install_steps": [
      "pip install mihomo-yamls",
      "Verify: mihomo-yamls --version",
      "supercli plugins install ./plugins/MIHOMO_YAMLS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MIHOMO_YAMLS",
      "resource": "self",
      "action": "version",
      "description": "Print MIHOMO_YAMLS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mihomo-yamls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MIHOMO_YAMLS: pip install mihomo-yamls"
      },
      "args": []
    },
    {
      "namespace": "MIHOMO_YAMLS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mihomo-yamls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mihomo-yamls",
        "passthrough": true,
        "missingDependencyHelp": "Install MIHOMO_YAMLS: pip install mihomo-yamls"
      },
      "args": []
    }
  ]
}