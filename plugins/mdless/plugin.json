{
  "name": "mdless",
  "version": "0.1.0",
  "description": "Markdown pager with colors and theme support",
  "source": "https://github.com/ttscoff/mdless",
  "checks": [
    {
      "type": "binary",
      "name": "mdless"
    }
  ],
  "install_guidance": {
    "plugin": "mdless",
    "binary": "mdless",
    "check": "which mdless",
    "install_steps": [
      "gem install mdless",
      "Verify: mdless --version",
      "supercli plugins install ./plugins/mdless --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "mdless",
      "resource": "self",
      "action": "version",
      "description": "Print mdless version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdless",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mdless: gem install mdless"
      },
      "args": []
    },
    {
      "namespace": "mdless",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mdless CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdless",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mdless: gem install mdless"
      },
      "args": []
    }
  ]
}
