{
  "name": "iconv",
  "version": "0.1.0",
  "description": "iconv — convert text between character encodings (GNU libc)",
  "source": "https://www.gnu.org/software/libc/manual/html_node/iconv-Examples.html",
  "checks": [
    {
      "type": "binary",
      "name": "iconv"
    }
  ],
  "install_guidance": {
    "plugin": "iconv",
    "binary": "iconv",
    "check": "which iconv",
    "install_steps": [
      "Pre-installed on most Linux systems (glibc)",
      "macOS: built-in",
      "Verify: iconv --version",
      "supercli plugins install ./plugins/iconv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iconv",
      "resource": "self",
      "action": "version",
      "description": "Show iconv version info",
      "adapter": "process",
      "adapterConfig": {
        "command": "iconv",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "iconv is part of glibc: typically pre-installed"
      },
      "args": []
    },
    {
      "namespace": "iconv",
      "resource": "encoding",
      "action": "list",
      "description": "List all known character encodings",
      "adapter": "process",
      "adapterConfig": {
        "command": "iconv",
        "baseArgs": ["--list"],
        "missingDependencyHelp": "iconv is part of glibc: typically pre-installed"
      },
      "args": []
    },
    {
      "namespace": "iconv",
      "resource": "encoding",
      "action": "convert",
      "description": "Convert text from one encoding to another",
      "adapter": "process",
      "adapterConfig": {
        "command": "iconv",
        "missingDependencyHelp": "iconv is part of glibc: typically pre-installed"
      },
      "args": [
        { "name": "--from-code", "type": "string", "required": true, "description": "Source encoding (e.g. UTF-8, ISO-8859-1, ASCII)" },
        { "name": "--to-code", "type": "string", "required": true, "description": "Target encoding (e.g. UTF-8, ISO-8859-1, ASCII)" },
        { "name": "--output", "type": "string", "description": "Output file (default: stdout)" },
        { "name": "--silent", "type": "boolean", "description": "Suppress warnings" },
        { "name": "--verbose", "type": "boolean", "description": "Print progress information" },
        { "name": "file", "type": "string", "required": false, "description": "Input file (default: stdin)" }
      ]
    },
    {
      "namespace": "iconv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iconv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iconv",
        "passthrough": true,
        "missingDependencyHelp": "iconv is part of glibc: typically pre-installed"
      },
      "args": []
    }
  ]
}
