{
  "name": "X11",
  "version": "0.1.0",
  "description": "CLI tool: X11",
  "source": "https://manpages.debian.org/X11",
  "checks": [
    {
      "type": "binary",
      "name": "X11"
    }
  ],
  "install_guidance": {
    "plugin": "X11",
    "binary": "X11",
    "check": "which X11",
    "install_steps": [
      "apt-get install X11 2>/dev/null || which X11",
      "Verify: X11 --version",
      "supercli plugins install ./plugins/X11 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "X11",
      "resource": "self",
      "action": "version",
      "description": "Print X11 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "X11",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install X11: apt-get install X11 2>/dev/null || which X11"
      },
      "args": []
    },
    {
      "namespace": "X11",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to X11 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "X11",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install X11: apt-get install X11 2>/dev/null || which X11"
      },
      "args": []
    }
  ]
}