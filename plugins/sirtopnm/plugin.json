{
  "name": "sirtopnm",
  "version": "0.1.0",
  "description": "CLI tool: sirtopnm",
  "source": "https://manpages.debian.org/sirtopnm",
  "checks": [
    {
      "type": "binary",
      "name": "sirtopnm"
    }
  ],
  "install_guidance": {
    "plugin": "sirtopnm",
    "binary": "sirtopnm",
    "check": "which sirtopnm",
    "install_steps": [
      "apt-get install sirtopnm 2>/dev/null || which sirtopnm",
      "Verify: sirtopnm --version",
      "supercli plugins install ./plugins/sirtopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sirtopnm",
      "resource": "self",
      "action": "version",
      "description": "Print sirtopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sirtopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sirtopnm: apt-get install sirtopnm 2>/dev/null || which sirtopnm"
      },
      "args": []
    },
    {
      "namespace": "sirtopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sirtopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sirtopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sirtopnm: apt-get install sirtopnm 2>/dev/null || which sirtopnm"
      },
      "args": []
    }
  ]
}