{
  "name": "grantlee",
  "version": "0.1.0",
  "description": "Libraries for text templating with Qt",
  "source": "https://github.com/steveire/grantlee",
  "checks": [
    {
      "type": "binary",
      "name": "grantlee"
    }
  ],
  "install_guidance": {
    "plugin": "grantlee",
    "binary": "grantlee",
    "check": "which grantlee",
    "install_steps": [
      "brew install grantlee",
      "Verify: grantlee --version",
      "supercli plugins install ./plugins/grantlee --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "grantlee",
      "resource": "self",
      "action": "version",
      "description": "Print grantlee version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grantlee",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grantlee: brew install grantlee"
      },
      "args": []
    },
    {
      "namespace": "grantlee",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grantlee CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grantlee",
        "passthrough": true,
        "missingDependencyHelp": "Install grantlee"
      },
      "args": []
    }
  ]
}