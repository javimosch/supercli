{
  "name": "wizer",
  "version": "0.1.0",
  "description": "WASM pre-initializer CLI — pre-run WASM modules to snapshot state for fast cold starts",
  "source": "https://github.com/bytecodealliance/wizer",
  "checks": [
    {
      "type": "binary",
      "name": "wizer"
    }
  ],
  "install_guidance": {
    "plugin": "wizer",
    "binary": "wizer",
    "check": "which wizer",
    "install_steps": [
      "cargo install wizer",
      "Verify: wizer --version",
      "supercli plugins install ./plugins/wizer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wizer",
      "resource": "self",
      "action": "version",
      "description": "Print wizer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wizer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wizer: cargo install wizer"
      },
      "args": []
    },
    {
      "namespace": "wizer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wizer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wizer",
        "passthrough": true,
        "missingDependencyHelp": "Install wizer: cargo install wizer"
      },
      "args": []
    }
  ]
}
