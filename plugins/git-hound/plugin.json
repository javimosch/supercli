{
  "name": "git-hound",
  "version": "0.1.0",
  "description": "Git plugin that prevents sensitive data from being committed",
  "source": "https://github.com/ezekg/git-hound",
  "checks": [
    {
      "type": "binary",
      "name": "git-hound"
    }
  ],
  "install_guidance": {
    "plugin": "git-hound",
    "binary": "git-hound",
    "check": "which git-hound",
    "install_steps": [
      "brew install git-hound",
      "Verify: git-hound --version",
      "supercli plugins install ./plugins/git-hound --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-hound",
      "resource": "self",
      "action": "version",
      "description": "Print git-hound version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-hound",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-hound: brew install git-hound"
      },
      "args": []
    },
    {
      "namespace": "git-hound",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-hound CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-hound",
        "passthrough": true,
        "missingDependencyHelp": "Install git-hound"
      },
      "args": []
    }
  ]
}