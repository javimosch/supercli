{
  "plugin": "ldattach",
  "binary": "ldattach",
  "check": "which ldattach",
  "install_steps": [
    "# Install ldattach",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ldattach-linux-amd64 -o /usr/local/bin/ldattach",
    "chmod +x /usr/local/bin/ldattach",
    "# Or via package manager, see /usr/sbin/ldattach"
  ]
}