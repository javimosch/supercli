{
  "name": "yake",
  "version": "0.1.0",
  "description": "Unsupervised keyword extraction from single documents",
  "source": "https://github.com/LIAAD/yake",
  "checks": [{ "type": "binary", "name": "yake" }],
  "install_guidance": {
    "plugin": "yake",
    "binary": "yake",
    "check": "which yake",
    "install_steps": ["pip install yake", "Verify: yake --version", "supercli plugins install ./plugins/yake --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yake",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yake CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yake",
      "passthrough": true,
      "missingDependencyHelp": "Install yake: pip install yake", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
