{
  "plugin": "argc",
  "binary": "argc",
  "check": "which argc",
  "install_steps": [
    "cargo install argc",
    "brew install argc",
    "Verify: argc --version",
    "supercli plugins install ./plugins/argc --on-conflict replace --json"
  ],
  "note": "Source: https://github.com/sigoden/argc (1143 stars). Written in Rust."
}
