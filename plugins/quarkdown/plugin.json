{
  "name": "quarkdown",
  "version": "0.1.0",
  "description": "\ud83e\ude90 Markdown with superpowers: from ideas to papers, presentations, websites, books, and knowledge bas",
  "source": "https://github.com/quarkdown/quarkdown",
  "checks": [
    {
      "type": "binary",
      "name": "quarkdown"
    }
  ],
  "install_guidance": {
    "plugin": "quarkdown",
    "binary": "quarkdown",
    "check": "which quarkdown",
    "install_steps": [
      "pip install quarkdown",
      "Verify: quarkdown --version",
      "supercli plugins install ./plugins/quarkdown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "quarkdown",
      "resource": "self",
      "action": "version",
      "description": "Print quarkdown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quarkdown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install quarkdown: pip install quarkdown"
      },
      "args": []
    },
    {
      "namespace": "quarkdown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to quarkdown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "quarkdown",
        "passthrough": true,
        "missingDependencyHelp": "Install quarkdown: pip install quarkdown"
      },
      "args": []
    }
  ]
}