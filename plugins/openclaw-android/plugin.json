{
  "name": "openclaw-android",
  "version": "0.1.0",
  "description": "Run OpenClaw on Android with a single command \u2014 no proot, no Linux",
  "source": "https://github.com/openclaw-android/openclaw-android",
  "checks": [
    {
      "type": "binary",
      "name": "openclaw-android"
    }
  ],
  "install_guidance": {
    "plugin": "openclaw-android",
    "binary": "openclaw-android",
    "check": "which openclaw-android",
    "install_steps": [
      "pip install openclaw-android",
      "Verify: openclaw-android --version",
      "supercli plugins install ./plugins/openclaw-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openclaw-android",
      "resource": "self",
      "action": "version",
      "description": "Print openclaw-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaw-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openclaw-android: pip install openclaw-android"
      },
      "args": []
    },
    {
      "namespace": "openclaw-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openclaw-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaw-android",
        "passthrough": true,
        "missingDependencyHelp": "Install openclaw-android: pip install openclaw-android"
      },
      "args": []
    }
  ]
}