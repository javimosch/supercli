{
  "name": "qgltf",
  "version": "0.1.0",
  "description": "CLI tool: qgltf",
  "source": "https://manpages.debian.org/qgltf",
  "checks": [
    {
      "type": "binary",
      "name": "qgltf"
    }
  ],
  "install_guidance": {
    "plugin": "qgltf",
    "binary": "qgltf",
    "check": "which qgltf",
    "install_steps": [
      "apt-get install qgltf 2>/dev/null || which qgltf",
      "Verify: qgltf --version",
      "supercli plugins install ./plugins/qgltf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qgltf",
      "resource": "self",
      "action": "version",
      "description": "Print qgltf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qgltf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qgltf: apt-get install qgltf 2>/dev/null || which qgltf"
      },
      "args": []
    },
    {
      "namespace": "qgltf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qgltf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qgltf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qgltf: apt-get install qgltf 2>/dev/null || which qgltf"
      },
      "args": []
    }
  ]
}