{
  "name": "ws",
  "version": "0.1.0",
  "description": "Generic WebSocket CLI tool for testing connections",
  "source": "go",
  "checks": [{ "type": "binary", "name": "ws" }],
  "install_guidance": {
    "plugin": "ws",
    "binary": "ws",
    "check": "which ws",
    "install_steps": ["go get github.com/yhat/ws", "Verify: ws --version", "supercli plugins install ./plugins/ws --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ws",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ws CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ws",
      "passthrough": true,
      "missingDependencyHelp": "Install ws: go get github.com/yhat/ws"
    },
    "args": []
  }]
}
