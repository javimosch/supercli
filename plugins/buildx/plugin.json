{
  "name": "buildx",
  "version": "0.1.0",
  "description": "Docker CLI plugin for extended build capabilities",
  "source": "https://github.com/docker/buildx",
  "checks": [
    {
      "type": "binary",
      "name": "docker-buildx"
    }
  ],
  "install_guidance": {
    "plugin": "buildx",
    "binary": "docker-buildx",
    "check": "which docker-buildx",
    "install_steps": [
      "Docker CLI plugin (included with Docker Desktop)",
      "Verify: docker-buildx --version",
      "supercli plugins install ./plugins/buildx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "buildx",
      "resource": "self",
      "action": "version",
      "description": "Print buildx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-buildx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install buildx: Docker CLI plugin (included with Docker Desktop)"
      },
      "args": []
    },
    {
      "namespace": "buildx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-buildx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-buildx",
        "passthrough": true,
        "missingDependencyHelp": "Install buildx: Docker CLI plugin (included with Docker Desktop)"
      },
      "args": []
    }
  ]
}
