{
  "name": "damai",
  "version": "0.1.0",
  "description": "\ud83d\udd25 \ud83d\udd25 \u5b98\u65b9\u63a8\u8350 \ud83d\udd25 \ud83d\udd25 \u9ad8\u5e76\u53d1\u5927\u9ea6\u7f51\u552e\u7968\u7cfb\u7edf\uff0c\u4f7f\u7528 SpringCloud\u3001Kafka\u3001Redis\u3001Sentinel\u3001ElasticSearch\u3001ShardingSphere \u7b49\uff0c\u901a\u8fc7\u4f18\u5316\u9501\u7684\u7b56\u7565\u3001",
  "source": "https://github.com/damai/damai",
  "checks": [
    {
      "type": "binary",
      "name": "damai"
    }
  ],
  "install_guidance": {
    "plugin": "damai",
    "binary": "damai",
    "check": "which damai",
    "install_steps": [
      "pip install damai",
      "Verify: damai --version",
      "supercli plugins install ./plugins/damai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "damai",
      "resource": "self",
      "action": "version",
      "description": "Print damai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "damai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install damai: pip install damai"
      },
      "args": []
    },
    {
      "namespace": "damai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to damai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "damai",
        "passthrough": true,
        "missingDependencyHelp": "Install damai: pip install damai"
      },
      "args": []
    }
  ]
}