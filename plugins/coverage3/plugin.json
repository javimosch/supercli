{
  "name": "coverage3",
  "version": "0.1.0",
  "description": "CLI tool: coverage3",
  "source": "https://packages.debian.org/coverage3",
  "checks": [{ "type": "binary", "name": "coverage3" }],
  "install_guidance": {
    "plugin": "coverage3", "binary": "coverage3", "check": "which coverage3",
    "install_steps": ["apt-get install coverage3 2>/dev/null || which coverage3", "Verify: coverage3 --version", "supercli plugins install ./plugins/coverage3 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "coverage3", "resource": "_", "action": "_",
    "description": "Passthrough to coverage3 CLI",
    "adapter": "process", "adapterConfig": { "command": "coverage3", "passthrough": true, "missingDependencyHelp": "Install coverage3: apt-get install coverage3" }, "args": []
  }]
}
