{
  "name": "fastgron",
  "version": "0.1.0",
  "description": "High-performance JSON to GRON converter",
  "source": "https://github.com/adamritter/fastgron",
  "checks": [
    {
      "type": "binary",
      "name": "fastgron"
    }
  ],
  "install_guidance": {
    "plugin": "fastgron",
    "binary": "fastgron",
    "check": "which fastgron",
    "install_steps": [
      "brew install fastgron",
      "Verify: fastgron --version",
      "supercli plugins install ./plugins/fastgron --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fastgron",
      "resource": "self",
      "action": "version",
      "description": "Print fastgron version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastgron",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastgron: brew install fastgron"
      },
      "args": []
    },
    {
      "namespace": "fastgron",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastgron CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastgron",
        "passthrough": true,
        "missingDependencyHelp": "Install fastgron"
      },
      "args": []
    }
  ]
}