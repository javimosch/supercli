{
  "name": "mpif77",
  "version": "0.1.0",
  "description": "CLI tool: mpif77",
  "source": "https://manpages.debian.org/mpif77",
  "checks": [
    {
      "type": "binary",
      "name": "mpif77"
    }
  ],
  "install_guidance": {
    "plugin": "mpif77",
    "binary": "mpif77",
    "check": "which mpif77",
    "install_steps": [
      "apt-get install mpif77 2>/dev/null || which mpif77",
      "Verify: mpif77 --version",
      "supercli plugins install ./plugins/mpif77 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpif77",
      "resource": "self",
      "action": "version",
      "description": "Print mpif77 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpif77",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpif77: apt-get install mpif77 2>/dev/null || which mpif77"
      },
      "args": []
    },
    {
      "namespace": "mpif77",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpif77 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpif77",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mpif77: apt-get install mpif77 2>/dev/null || which mpif77"
      },
      "args": []
    }
  ]
}