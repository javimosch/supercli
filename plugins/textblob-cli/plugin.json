{
  "name": "textblob-cli",
  "version": "0.1.0",
  "description": "Lightweight text processing CLI for NLP tasks",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "textblob-cli" }],
  "install_guidance": {
    "plugin": "textblob-cli",
    "binary": "textblob-cli",
    "check": "which textblob-cli",
    "install_steps": ["pip install textblob", "Verify: textblob-cli --version", "supercli plugins install ./plugins/textblob-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "textblob-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to textblob-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "textblob-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install textblob-cli: pip install textblob"
    },
    "args": []
  }]
}
