{
  "name": "leetgo",
  "version": "0.1.0",
  "description": "CLI tool for LeetCode",
  "source": "https://github.com/j178/leetgo",
  "checks": [
    {
      "type": "binary",
      "name": "leetgo"
    }
  ],
  "install_guidance": {
    "plugin": "leetgo",
    "binary": "leetgo",
    "check": "which leetgo",
    "install_steps": [
      "brew install leetgo",
      "Verify: leetgo --version",
      "supercli plugins install ./plugins/leetgo --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "leetgo",
      "resource": "self",
      "action": "version",
      "description": "Print leetgo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetgo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install leetgo: brew install leetgo"
      },
      "args": []
    },
    {
      "namespace": "leetgo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leetgo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetgo",
        "passthrough": true,
        "missingDependencyHelp": "Install leetgo"
      },
      "args": []
    }
  ]
}