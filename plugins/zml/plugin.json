{
  "name": "zml",
  "version": "0.1.0",
  "description": "Any model. Any hardware. Zero compromise. Built with @ziglang / @openxla / MLIR / @bazelbuild",
  "source": "https://github.com/zml/zml",
  "checks": [
    {
      "type": "binary",
      "name": "zml"
    }
  ],
  "install_guidance": {
    "plugin": "zml",
    "binary": "zml",
    "check": "which zml",
    "install_steps": [
      "pip install zml",
      "Verify: zml --version",
      "supercli plugins install ./plugins/zml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zml",
      "resource": "self",
      "action": "version",
      "description": "Print zml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zml: pip install zml"
      },
      "args": []
    },
    {
      "namespace": "zml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zml",
        "passthrough": true,
        "missingDependencyHelp": "Install zml: pip install zml"
      },
      "args": []
    }
  ]
}