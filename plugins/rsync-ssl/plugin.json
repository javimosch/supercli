{
  "name": "rsync-ssl",
  "version": "1.0.0",
  "description": "rsync-ssl \u2014 rsync-ssl \u2014 CLI utility",
  "source": "/usr/bin/rsync-ssl",
  "checks": [
    {
      "type": "binary",
      "name": "rsync-ssl"
    }
  ],
  "install_guidance": {
    "plugin": "rsync-ssl",
    "binary": "rsync-ssl",
    "check": "which rsync-ssl",
    "install_steps": [
      "# Install rsync-ssl:",
      "# apt: sudo apt-get install rsync-ssl",
      "# brew: brew install rsync-ssl",
      "# cargo: cargo install rsync-ssl",
      "# npm: npm install -g rsync-ssl",
      "# pip: pip install rsync-ssl",
      "# or download from /usr/bin/rsync-ssl"
    ]
  },
  "commands": [
    {
      "namespace": "rsync",
      "resource": "ssl",
      "action": "run",
      "description": "Run rsync-ssl",
      "adapter": "process",
      "adapterConfig": {
        "command": "rsync-ssl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rsync-ssl from /usr/bin/rsync-ssl"
      },
      "args": []
    }
  ]
}