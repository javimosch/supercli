{
  "plugin": "rsync-ssl",
  "binary": "rsync-ssl",
  "check": "which rsync-ssl",
  "install_steps": [
    "# Install rsync-ssl",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rsync-ssl-linux-amd64 -o /usr/local/bin/rsync-ssl",
    "chmod +x /usr/local/bin/rsync-ssl",
    "# Or via package manager, see /usr/bin/rsync-ssl"
  ]
}