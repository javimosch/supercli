{
  "name": "ppmtosixel",
  "version": "0.1.0",
  "description": "CLI tool: ppmtosixel",
  "source": "https://manpages.debian.org/ppmtosixel",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtosixel"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtosixel",
    "binary": "ppmtosixel",
    "check": "which ppmtosixel",
    "install_steps": [
      "apt-get install ppmtosixel 2>/dev/null || which ppmtosixel",
      "Verify: ppmtosixel --version",
      "supercli plugins install ./plugins/ppmtosixel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtosixel",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtosixel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtosixel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtosixel: apt-get install ppmtosixel 2>/dev/null || which ppmtosixel"
      },
      "args": []
    },
    {
      "namespace": "ppmtosixel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtosixel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtosixel",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtosixel: apt-get install ppmtosixel 2>/dev/null || which ppmtosixel"
      },
      "args": []
    }
  ]
}