{
  "name": "kubectx",
  "version": "0.1.0",
  "description": "Fast way to switch between Kubernetes contexts and namespaces",
  "source": "https://github.com/ahmetb/kubectx",
  "checks": [{ "type": "binary", "name": "kubectx" }],
  "install_guidance": {
    "plugin": "kubectx",
    "binary": "kubectx",
    "check": "which kubectx",
    "install_steps": ["brew install kubectx", "Verify: kubectx --version", "supercli plugins install ./plugins/kubectx --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubectx",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubectx CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubectx",
      "passthrough": true,
      "missingDependencyHelp": "Install kubectx: brew install kubectx"
    },
    "args": []
  }]
}
