{
  "name": "uuid-gen-cli",
  "version": "0.1.0",
  "description": "Quick UUID v4 generator for the terminal",
  "source": "https://github.com/vdemedes/uuid-gen-cli",
  "checks": [{ "type": "binary", "name": "uuid-gen-cli" }],
  "install_guidance": {
    "plugin": "uuid-gen-cli",
    "binary": "uuid-gen-cli",
    "check": "which uuid-gen-cli",
    "install_steps": ["npm install -g uuid-gen-cli", "Verify: uuid-gen-cli --version", "supercli plugins install ./plugins/uuid-gen-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "uuid-gen-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to uuid-gen-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "uuid-gen-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install uuid-gen-cli: npm install -g uuid-gen-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
