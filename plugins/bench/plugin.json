{
  "name": "bench",
  "version": "0.1.0",
  "description": "Command-line benchmark tool",
  "source": "https://github.com/Gabriella439/bench",
  "checks": [
    {
      "type": "binary",
      "name": "bench"
    }
  ],
  "install_guidance": {
    "plugin": "bench",
    "binary": "bench",
    "check": "which bench",
    "install_steps": [
      "brew install bench",
      "Verify: bench --version",
      "supercli plugins install ./plugins/bench --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bench",
      "resource": "self",
      "action": "version",
      "description": "Print bench version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bench",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bench: brew install bench"
      },
      "args": []
    },
    {
      "namespace": "bench",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bench CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bench",
        "passthrough": true,
        "missingDependencyHelp": "Install bench"
      },
      "args": []
    }
  ]
}