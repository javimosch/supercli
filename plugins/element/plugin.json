{
  "name": "element",
  "version": "0.1.0",
  "description": "Periodic table on the command line.",
  "source": "https://github.com/gennaro-tedesco/element",
  "checks": [
    {
      "type": "binary",
      "name": "element"
    }
  ],
  "install_guidance": {
    "plugin": "element",
    "binary": "element",
    "check": "which element",
    "install_steps": [
      "See https://github.com/gennaro-tedesco/element",
      "Verify: element --version",
      "supercli plugins install ./plugins/element --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "element",
      "resource": "self",
      "action": "version",
      "description": "Print element version",
      "adapter": "process",
      "adapterConfig": {
        "command": "element",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install element: See https://github.com/gennaro-tedesco/element"
      },
      "args": []
    },
    {
      "namespace": "element",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to element CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "element",
        "passthrough": true,
        "missingDependencyHelp": "Install element"
      },
      "args": []
    }
  ]
}