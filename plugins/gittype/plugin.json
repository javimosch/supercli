{
  "name": "gittype",
  "version": "0.1.0",
  "description": "Turn your source code into typing challenges",
  "source": "https://github.com/unhappychoice/gittype",
  "checks": [
    {
      "type": "binary",
      "name": "gittype"
    }
  ],
  "install_guidance": {
    "plugin": "gittype",
    "binary": "gittype",
    "check": "which gittype",
    "install_steps": [
      "cargo install gittype",
      "Verify: gittype --version",
      "supercli plugins install ./plugins/gittype --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gittype",
      "resource": "self",
      "action": "version",
      "description": "Print gittype version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gittype",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gittype: cargo install gittype"
      },
      "args": []
    },
    {
      "namespace": "gittype",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gittype CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gittype",
        "passthrough": true,
        "missingDependencyHelp": "Install gittype"
      },
      "args": []
    }
  ]
}