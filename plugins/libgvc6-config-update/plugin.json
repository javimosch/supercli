{
  "name": "libgvc6-config-update",
  "version": "0.1.0",
  "description": "CLI tool: libgvc6-config-update",
  "source": "https://manpages.debian.org/libgvc6-config-update",
  "checks": [
    {
      "type": "binary",
      "name": "libgvc6-config-update"
    }
  ],
  "install_guidance": {
    "plugin": "libgvc6-config-update",
    "binary": "libgvc6-config-update",
    "check": "which libgvc6-config-update",
    "install_steps": [
      "apt-get install libgvc6-config-update 2>/dev/null || which libgvc6-config-update",
      "Verify: libgvc6-config-update --version",
      "supercli plugins install ./plugins/libgvc6-config-update --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "libgvc6-config-update",
      "resource": "self",
      "action": "version",
      "description": "Print libgvc6-config-update version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libgvc6-config-update",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libgvc6-config-update: apt-get install libgvc6-config-update 2>/dev/null || which libgvc6-config-update"
      },
      "args": []
    },
    {
      "namespace": "libgvc6-config-update",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libgvc6-config-update CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libgvc6-config-update",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install libgvc6-config-update: apt-get install libgvc6-config-update 2>/dev/null || which libgvc6-config-update"
      },
      "args": []
    }
  ]
}