{
  "name": "BaFi",
  "version": "0.1.0",
  "description": "Universal JSON, BSON, YAML, CSV, XML translator to ANY format using templates.",
  "source": "https://github.com/mmalcek/bafi",
  "checks": [
    {
      "type": "binary",
      "name": "BaFi"
    }
  ],
  "install_guidance": {
    "plugin": "BaFi",
    "binary": "BaFi",
    "check": "which BaFi",
    "install_steps": [
      "See https://github.com/mmalcek/bafi",
      "Verify: BaFi --version",
      "supercli plugins install ./plugins/BaFi --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "BaFi",
      "resource": "self",
      "action": "version",
      "description": "Print BaFi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "BaFi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BaFi: See https://github.com/mmalcek/bafi"
      },
      "args": []
    },
    {
      "namespace": "BaFi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to BaFi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "BaFi",
        "passthrough": true,
        "missingDependencyHelp": "Install BaFi"
      },
      "args": []
    }
  ]
}