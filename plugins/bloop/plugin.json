{
  "name": "bloop",
  "version": "0.1.0",
  "description": "AI code search engine for your repositories",
  "source": "https://github.com/BloopAI/bloop",
  "checks": [{ "type": "binary", "name": "bloop" }],
  "install_guidance": {
    "plugin": "bloop",
    "binary": "bloop",
    "check": "which bloop",
    "install_steps": ["brew install bloop", "Verify: bloop --version", "supercli plugins install ./plugins/bloop --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bloop",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bloop CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bloop",
      "passthrough": true,
      "missingDependencyHelp": "Install bloop: brew install bloop", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
