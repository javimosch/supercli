{
  "name": "paragrep",
  "version": "0.1.0",
  "description": "Greps regular expressions in a text file(s) and prints out the paragraphs containing those expressions, a paragraph is defined as a block of text delimited by an empty or blank line, fully customizable via command line parameters.",
  "source": "https://github.com/bmc/paragrep",
  "checks": [
    {
      "type": "binary",
      "name": "paragrep"
    }
  ],
  "install_guidance": {
    "plugin": "paragrep",
    "binary": "paragrep",
    "check": "which paragrep",
    "install_steps": [
      "See https://github.com/bmc/paragrep",
      "Verify: paragrep --version",
      "supercli plugins install ./plugins/paragrep --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "paragrep",
      "resource": "self",
      "action": "version",
      "description": "Print paragrep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "paragrep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install paragrep: See https://github.com/bmc/paragrep"
      },
      "args": []
    },
    {
      "namespace": "paragrep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to paragrep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "paragrep",
        "passthrough": true,
        "missingDependencyHelp": "Install paragrep"
      },
      "args": []
    }
  ]
}