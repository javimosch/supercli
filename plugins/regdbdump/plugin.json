{
  "name": "regdbdump",
  "version": "0.1.0",
  "description": "CLI tool: regdbdump",
  "source": "https://manpages.debian.org/regdbdump",
  "checks": [
    {
      "type": "binary",
      "name": "regdbdump"
    }
  ],
  "install_guidance": {
    "plugin": "regdbdump",
    "binary": "regdbdump",
    "check": "which regdbdump",
    "install_steps": [
      "apt-get install regdbdump 2>/dev/null || which regdbdump",
      "Verify: regdbdump --version",
      "supercli plugins install ./plugins/regdbdump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "regdbdump",
      "resource": "self",
      "action": "version",
      "description": "Print regdbdump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "regdbdump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install regdbdump: apt-get install regdbdump 2>/dev/null || which regdbdump"
      },
      "args": []
    },
    {
      "namespace": "regdbdump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to regdbdump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "regdbdump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install regdbdump: apt-get install regdbdump 2>/dev/null || which regdbdump"
      },
      "args": []
    }
  ]
}