{
  "name": "dh_python3-ply",
  "version": "0.1.0",
  "description": "CLI tool: dh_python3-ply",
  "source": "https://manpages.debian.org/dh_python3-ply",
  "checks": [
    {
      "type": "binary",
      "name": "dh_python3-ply"
    }
  ],
  "install_guidance": {
    "plugin": "dh_python3-ply",
    "binary": "dh_python3-ply",
    "check": "which dh_python3-ply",
    "install_steps": [
      "apt-get install dh_python3-ply 2>/dev/null || which dh_python3-ply",
      "Verify: dh_python3-ply --version",
      "supercli plugins install ./plugins/dh_python3-ply --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dh_python3-ply",
      "resource": "self",
      "action": "version",
      "description": "Print dh_python3-ply version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dh_python3-ply",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dh_python3-ply: apt-get install dh_python3-ply 2>/dev/null || which dh_python3-ply"
      },
      "args": []
    },
    {
      "namespace": "dh_python3-ply",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dh_python3-ply CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dh_python3-ply",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dh_python3-ply: apt-get install dh_python3-ply 2>/dev/null || which dh_python3-ply"
      },
      "args": []
    }
  ]
}