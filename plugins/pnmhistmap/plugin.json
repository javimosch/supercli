{
  "name": "pnmhistmap",
  "version": "0.1.0",
  "description": "CLI tool: pnmhistmap",
  "source": "https://manpages.debian.org/pnmhistmap",
  "checks": [
    {
      "type": "binary",
      "name": "pnmhistmap"
    }
  ],
  "install_guidance": {
    "plugin": "pnmhistmap",
    "binary": "pnmhistmap",
    "check": "which pnmhistmap",
    "install_steps": [
      "apt-get install pnmhistmap 2>/dev/null || which pnmhistmap",
      "Verify: pnmhistmap --version",
      "supercli plugins install ./plugins/pnmhistmap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmhistmap",
      "resource": "self",
      "action": "version",
      "description": "Print pnmhistmap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmhistmap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmhistmap: apt-get install pnmhistmap 2>/dev/null || which pnmhistmap"
      },
      "args": []
    },
    {
      "namespace": "pnmhistmap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmhistmap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmhistmap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmhistmap: apt-get install pnmhistmap 2>/dev/null || which pnmhistmap"
      },
      "args": []
    }
  ]
}