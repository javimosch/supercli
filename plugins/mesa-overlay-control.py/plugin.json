{
  "name": "mesa-overlay-control.py",
  "version": "0.1.0",
  "description": "CLI tool: mesa-overlay-control.py",
  "source": "https://manpages.debian.org/mesa-overlay-control.py",
  "checks": [
    {
      "type": "binary",
      "name": "mesa-overlay-control.py"
    }
  ],
  "install_guidance": {
    "plugin": "mesa-overlay-control.py",
    "binary": "mesa-overlay-control.py",
    "check": "which mesa-overlay-control.py",
    "install_steps": [
      "apt-get install mesa-overlay-control.py 2>/dev/null || which mesa-overlay-control.py",
      "Verify: mesa-overlay-control.py --version",
      "supercli plugins install ./plugins/mesa-overlay-control.py --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mesa-overlay-control.py",
      "resource": "self",
      "action": "version",
      "description": "Print mesa-overlay-control.py version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mesa-overlay-control.py",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mesa-overlay-control.py: apt-get install mesa-overlay-control.py 2>/dev/null || which mesa-overlay-control.py"
      },
      "args": []
    },
    {
      "namespace": "mesa-overlay-control.py",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mesa-overlay-control.py CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mesa-overlay-control.py",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mesa-overlay-control.py: apt-get install mesa-overlay-control.py 2>/dev/null || which mesa-overlay-control.py"
      },
      "args": []
    }
  ]
}