{
  "name": "toml-sort-cli",
  "version": "0.1.0",
  "description": "A TOML configuration file sorter and formatter. Alphabetically sorts keys in TOML files for consistent, diff-friendly configuration management.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "toml-sort-cli"
    }
  ],
  "install_guidance": {
    "plugin": "toml-sort-cli",
    "binary": "toml-sort-cli",
    "check": "which toml-sort-cli",
    "install_steps": [
      "cargo install toml-sort-cli",
      "Verify: toml-sort-cli --version",
      "supercli plugins install ./plugins/toml-sort-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "toml-sort-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to toml-sort-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "toml-sort-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install toml-sort-cli: cargo install toml-sort-cli"
      },
      "args": []
    }
  ]
}
