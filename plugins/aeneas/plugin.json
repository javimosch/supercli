{
  "name": "aeneas",
  "version": "0.1.0",
  "description": "Align text to audio automatically in Python",
  "source": "https://github.com/nicedoc/aeneas",
  "checks": [
    {
      "type": "binary",
      "name": "aeneas"
    }
  ],
  "install_guidance": {
    "plugin": "aeneas",
    "binary": "aeneas",
    "check": "which aeneas",
    "install_steps": [
      "pip install aeneas",
      "Verify: aeneas --version",
      "supercli plugins install ./plugins/aeneas --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aeneas",
      "resource": "self",
      "action": "version",
      "description": "Print aeneas version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aeneas",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aeneas: pip install aeneas"
      },
      "args": []
    },
    {
      "namespace": "aeneas",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aeneas CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aeneas",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install aeneas: pip install aeneas"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
