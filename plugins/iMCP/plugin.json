{
  "name": "iMCP",
  "version": "0.1.0",
  "description": "A macOS app that provides an MCP server to your Messages, Contacts, Reminders and more",
  "source": "https://github.com/iMCP/iMCP",
  "checks": [
    {
      "type": "binary",
      "name": "imcp"
    }
  ],
  "install_guidance": {
    "plugin": "iMCP",
    "binary": "imcp",
    "check": "which imcp",
    "install_steps": [
      "pip install imcp",
      "Verify: imcp --version",
      "supercli plugins install ./plugins/iMCP --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iMCP",
      "resource": "self",
      "action": "version",
      "description": "Print iMCP version",
      "adapter": "process",
      "adapterConfig": {
        "command": "imcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iMCP: pip install imcp"
      },
      "args": []
    },
    {
      "namespace": "iMCP",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to imcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "imcp",
        "passthrough": true,
        "missingDependencyHelp": "Install iMCP: pip install imcp"
      },
      "args": []
    }
  ]
}