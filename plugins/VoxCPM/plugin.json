{
  "name": "VoxCPM",
  "version": "0.1.0",
  "description": "VoxCPM2: Tokenizer-Free TTS for Multilingual Speech Generation, Creative Voice Design, and True-to-L",
  "source": "https://github.com/VoxCPM/VoxCPM",
  "checks": [
    {
      "type": "binary",
      "name": "voxcpm"
    }
  ],
  "install_guidance": {
    "plugin": "VoxCPM",
    "binary": "voxcpm",
    "check": "which voxcpm",
    "install_steps": [
      "pip install voxcpm",
      "Verify: voxcpm --version",
      "supercli plugins install ./plugins/VoxCPM --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VoxCPM",
      "resource": "self",
      "action": "version",
      "description": "Print VoxCPM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "voxcpm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VoxCPM: pip install voxcpm"
      },
      "args": []
    },
    {
      "namespace": "VoxCPM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to voxcpm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "voxcpm",
        "passthrough": true,
        "missingDependencyHelp": "Install VoxCPM: pip install voxcpm"
      },
      "args": []
    }
  ]
}