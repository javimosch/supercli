{
  "name": "makefile2graph",
  "version": "0.1.0",
  "description": "Create a graph of dependencies from GNU-Make",
  "source": "https://github.com/lindenb/makefile2graph",
  "checks": [
    {
      "type": "binary",
      "name": "makefile2graph"
    }
  ],
  "install_guidance": {
    "plugin": "makefile2graph",
    "binary": "makefile2graph",
    "check": "which makefile2graph",
    "install_steps": [
      "brew install makefile2graph",
      "Verify: makefile2graph --version",
      "supercli plugins install ./plugins/makefile2graph --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "makefile2graph",
      "resource": "self",
      "action": "version",
      "description": "Print makefile2graph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "makefile2graph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install makefile2graph: brew install makefile2graph"
      },
      "args": []
    },
    {
      "namespace": "makefile2graph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to makefile2graph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "makefile2graph",
        "passthrough": true,
        "missingDependencyHelp": "Install makefile2graph"
      },
      "args": []
    }
  ]
}