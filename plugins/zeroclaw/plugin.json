{
  "name": "zeroclaw",
  "version": "0.1.0",
  "description": "Fast, small, and fully autonomous AI personal assistant infrastructure, any OS, any platform \u2014 deplo",
  "source": "https://github.com/zeroclaw/zeroclaw",
  "checks": [
    {
      "type": "binary",
      "name": "zeroclaw"
    }
  ],
  "install_guidance": {
    "plugin": "zeroclaw",
    "binary": "zeroclaw",
    "check": "which zeroclaw",
    "install_steps": [
      "pip install zeroclaw",
      "Verify: zeroclaw --version",
      "supercli plugins install ./plugins/zeroclaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zeroclaw",
      "resource": "self",
      "action": "version",
      "description": "Print zeroclaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zeroclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zeroclaw: pip install zeroclaw"
      },
      "args": []
    },
    {
      "namespace": "zeroclaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zeroclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zeroclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install zeroclaw: pip install zeroclaw"
      },
      "args": []
    }
  ]
}