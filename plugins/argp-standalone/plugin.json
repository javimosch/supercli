{
  "name": "argp-standalone",
  "version": "0.1.0",
  "description": "Standalone version of arguments parsing functions from GLIBC",
  "source": "https://github.com/argp-standalone/argp-standalone",
  "checks": [
    {
      "type": "binary",
      "name": "argp-standalone"
    }
  ],
  "install_guidance": {
    "plugin": "argp-standalone",
    "binary": "argp-standalone",
    "check": "which argp-standalone",
    "install_steps": [
      "brew install argp-standalone",
      "Verify: argp-standalone --version",
      "supercli plugins install ./plugins/argp-standalone --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "argp-standalone",
      "resource": "self",
      "action": "version",
      "description": "Print argp-standalone version",
      "adapter": "process",
      "adapterConfig": {
        "command": "argp-standalone",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install argp-standalone: brew install argp-standalone"
      },
      "args": []
    },
    {
      "namespace": "argp-standalone",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to argp-standalone CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "argp-standalone",
        "passthrough": true,
        "missingDependencyHelp": "Install argp-standalone"
      },
      "args": []
    }
  ]
}