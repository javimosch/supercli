{
  "name": "md4c",
  "version": "0.1.0",
  "description": "C Markdown parser. Fast. SAX-like interface",
  "source": "https://github.com/mity/md4c",
  "checks": [
    {
      "type": "binary",
      "name": "md4c"
    }
  ],
  "install_guidance": {
    "plugin": "md4c",
    "binary": "md4c",
    "check": "which md4c",
    "install_steps": [
      "brew install md4c",
      "Verify: md4c --version",
      "supercli plugins install ./plugins/md4c --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "md4c",
      "resource": "self",
      "action": "version",
      "description": "Print md4c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "md4c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install md4c: brew install md4c"
      },
      "args": []
    },
    {
      "namespace": "md4c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to md4c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "md4c",
        "passthrough": true,
        "missingDependencyHelp": "Install md4c"
      },
      "args": []
    }
  ]
}