{
  "name": "easyredmine-cli",
  "version": "1.0.2",
  "description": "easyredmine-cli — Redmine API client for EasyRedmine. Read issues, post comments, edit descriptions, change status, assign users, search project members, self-update.",
  "source": "https://github.com/javimosch/easyredmine-cli",
  "checks": [
    { "type": "binary", "name": "easyredmine-cli" }
  ],
  "install_guidance": {
    "plugin": "easyredmine-cli",
    "binary": "easyredmine-cli",
    "check": "which easyredmine-cli",
    "install_steps": [
      "cd ~/ai/easyredmine-cli && go build -ldflags=\"-s -w\" -o easyredmine-cli main.go",
      "cp easyredmine-cli ~/.local/bin/"
    ],
    "note": "Go binary. Build from source at ~/ai/easyredmine-cli."
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    {
      "namespace": "easyredmine",
      "resource": "issue",
      "action": "search",
      "description": "Smart search across open issues. Phrase broken into words, matched, deduped, ranked by match count.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["issue", "search"],
        "positionalArgs": ["query"],
        "timeout_ms": 120000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search phrase" }
      ]
    },
    {
      "namespace": "easyredmine",
      "resource": "issue",
      "action": "show",
      "description": "Show issue details by ID. Supports --json.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["issue", "show"],
        "positionalArgs": ["id"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "id", "type": "string", "required": true, "description": "Issue ID" }
      ]
    },
    {
      "namespace": "easyredmine",
      "resource": "issue",
      "action": "comment",
      "description": "Add a comment to an issue. Use --text for the comment body.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["issue", "comment"],
        "positionalArgs": ["id"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "id", "type": "string", "required": true, "description": "Issue ID" },
        { "name": "text", "type": "string", "required": true, "description": "Comment text" }
      ]
    },
    {
      "namespace": "easyredmine",
      "resource": "issue",
      "action": "edit",
      "description": "Edit issue description. Use --description.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["issue", "edit"],
        "positionalArgs": ["id"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "id", "type": "string", "required": true, "description": "Issue ID" },
        { "name": "description", "type": "string", "required": true, "description": "New description text" }
      ]
    },
    {
      "namespace": "easyredmine",
      "resource": "issue",
      "action": "status",
      "description": "Change issue status. Use --status-id.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["issue", "status"],
        "positionalArgs": ["id"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "id", "type": "string", "required": true, "description": "Issue ID" },
        { "name": "status-id", "type": "number", "required": true, "description": "Status ID" }
      ]
    },
    {
      "namespace": "easyredmine",
      "resource": "issue",
      "action": "assign",
      "description": "Assign issue to user. Use --assigned-to-id.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["issue", "assign"],
        "positionalArgs": ["id"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "id", "type": "string", "required": true, "description": "Issue ID" },
        { "name": "assigned-to-id", "type": "number", "required": true, "description": "Assigned user ID" }
      ]
    },
    {
      "namespace": "easyredmine",
      "resource": "user",
      "action": "search",
      "description": "Search users/groups/roles in a project. Use --project-id.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["user", "search"],
        "positionalArgs": ["query"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search query (name, group, or role)" },
        { "name": "project-id", "type": "number", "required": true, "description": "Project ID" }
      ]
    },
    {
      "namespace": "easyredmine",
      "resource": "update",
      "action": "check",
      "description": "Check for updates from GitHub releases. Use --check-only to check without installing.",
      "adapter": "process",
      "adapterConfig": {
        "command": "easyredmine-cli",
        "baseArgs": ["update"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Build easyredmine-cli from ~/ai/easyredmine-cli"
      },
      "args": [
        { "name": "check-only", "type": "boolean", "required": false, "description": "Only check for updates, don't install" }
      ]
    }
  ]
}
