{
  "plugin": "easyredmine-cli",
  "binary": "easyredmine-cli",
  "check": "which easyredmine-cli",
  "install_steps": [
    "cd ~/ai/easyredmine-cli && go build -ldflags=\"-s -w\" -o easyredmine-cli main.go",
    "sudo mv easyredmine-cli /usr/local/bin/"
  ],
  "note": "Go binary. Build from source at ~/ai/easyredmine-cli. Requires Go 1.22+."
}
