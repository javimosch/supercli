{
  "name": "fixpspps",
  "version": "0.1.0",
  "description": "CLI tool: fixpspps",
  "source": "https://manpages.debian.org/fixpspps",
  "checks": [
    {
      "type": "binary",
      "name": "fixpspps"
    }
  ],
  "install_guidance": {
    "plugin": "fixpspps",
    "binary": "fixpspps",
    "check": "which fixpspps",
    "install_steps": [
      "apt-get install fixpspps 2>/dev/null || which fixpspps",
      "Verify: fixpspps --version",
      "supercli plugins install ./plugins/fixpspps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixpspps",
      "resource": "self",
      "action": "version",
      "description": "Print fixpspps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixpspps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixpspps: apt-get install fixpspps 2>/dev/null || which fixpspps"
      },
      "args": []
    },
    {
      "namespace": "fixpspps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixpspps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixpspps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixpspps: apt-get install fixpspps 2>/dev/null || which fixpspps"
      },
      "args": []
    }
  ]
}