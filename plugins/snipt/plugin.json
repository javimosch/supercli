{
  "name": "snipt",
  "version": "0.1.0",
  "description": "Text snippet expansion and management tool",
  "source": "https://github.com/nicholasgasior/snipt",
  "checks": [
    {
      "type": "binary",
      "name": "snipt"
    }
  ],
  "install_guidance": {
    "plugin": "snipt",
    "binary": "snipt",
    "check": "which snipt",
    "install_steps": [
      "cargo install snipt",
      "Verify: snipt --version",
      "supercli plugins install ./plugins/snipt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "snipt",
      "resource": "self",
      "action": "version",
      "description": "Print snipt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "snipt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install snipt: cargo install snipt"
      },
      "args": []
    },
    {
      "namespace": "snipt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to snipt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "snipt",
        "passthrough": true,
        "missingDependencyHelp": "Install snipt: cargo install snipt"
      },
      "args": []
    }
  ]
}
