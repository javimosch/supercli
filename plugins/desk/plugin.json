{
  "name": "desk",
  "version": "1.0.0",
  "description": "desk \u2014 Workspace manager",
  "source": "github.com/jamesob/desk",
  "checks": [
    {
      "type": "binary",
      "name": "desk"
    }
  ],
  "install_guidance": {
    "plugin": "desk",
    "binary": "desk",
    "check": "which desk",
    "install_steps": [
      "# Install desk",
      "# See github.com/jamesob/desk",
      "# apt: sudo apt-get install desk",
      "# brew: brew install desk",
      "# cargo: cargo install desk",
      "# npm: npm install -g desk",
      "# pip: pip install desk"
    ]
  },
  "commands": [
    {
      "namespace": "desk",
      "resource": "desk",
      "action": "run",
      "description": "Run desk",
      "adapter": "process",
      "adapterConfig": {
        "command": "desk",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install desk from github.com/jamesob/desk"
      },
      "args": []
    }
  ]
}