{
  "name": "tennis",
  "version": "0.1.0",
  "description": "Stylish CSV tables in terminal",
  "source": "https://github.com/nicholasgasior/tennis",
  "checks": [{"type": "binary", "name": "tennis"}],
  "install_guidance": {
    "plugin": "tennis",
    "binary": "tennis",
    "check": "which tennis",
    "install_steps": [
      "cargo install tennis",
      "Verify: tennis --version",
      "supercli plugins install ./tennis --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "tennis",
      "resource": "self",
      "action": "version",
      "description": "Print tennis version",
      "adapter": "process",
      "adapterConfig": {"command": "tennis", "baseArgs": ["--version"], "missingDependencyHelp": "Install tennis: cargo install tennis"},
      "args": []
    },
    {
      "namespace": "tennis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tennis CLI",
      "adapter": "process",
      "adapterConfig": {"command": "tennis", "passthrough": true, "missingDependencyHelp": "Install tennis: cargo install tennis"},
      "args": []
    }
  ]
}
