{
  "name": "agenticSeek",
  "version": "0.1.0",
  "description": "Fully Local Manus AI. No APIs, No $200 monthly bills. Enjoy an autonomous agent that thinks, browses",
  "source": "https://github.com/agenticSeek/agenticSeek",
  "checks": [
    {
      "type": "binary",
      "name": "agenticseek"
    }
  ],
  "install_guidance": {
    "plugin": "agenticSeek",
    "binary": "agenticseek",
    "check": "which agenticseek",
    "install_steps": [
      "pip install agenticseek",
      "Verify: agenticseek --version",
      "supercli plugins install ./plugins/agenticSeek --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agenticSeek",
      "resource": "self",
      "action": "version",
      "description": "Print agenticSeek version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agenticseek",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agenticSeek: pip install agenticseek"
      },
      "args": []
    },
    {
      "namespace": "agenticSeek",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agenticseek CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agenticseek",
        "passthrough": true,
        "missingDependencyHelp": "Install agenticSeek: pip install agenticseek"
      },
      "args": []
    }
  ]
}