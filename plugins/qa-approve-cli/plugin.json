{
  "name": "qa-approve-cli",
  "version": "0.1.0",
  "description": "use driver cli to qa approve drivers in batch",
  "source": "https://github.com/qa-approve-cli/qa-approve-cli",
  "checks": [
    {
      "type": "binary",
      "name": "qa-approve-cli"
    }
  ],
  "install_guidance": {
    "plugin": "qa-approve-cli",
    "binary": "qa-approve-cli",
    "check": "which qa-approve-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: qa-approve-cli --version",
      "supercli plugins install ./plugins/qa-approve-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "qa-approve-cli",
      "resource": "self",
      "action": "version",
      "description": "Print qa-approve-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qa-approve-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qa-approve-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "qa-approve-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qa-approve-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qa-approve-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install qa-approve-cli from project repository"
      },
      "args": []
    }
  ]
}