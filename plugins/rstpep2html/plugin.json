{
  "name": "rstpep2html",
  "version": "0.1.0",
  "description": "CLI tool: rstpep2html",
  "source": "https://manpages.debian.org/rstpep2html",
  "checks": [
    {
      "type": "binary",
      "name": "rstpep2html"
    }
  ],
  "install_guidance": {
    "plugin": "rstpep2html",
    "binary": "rstpep2html",
    "check": "which rstpep2html",
    "install_steps": [
      "apt-get install rstpep2html 2>/dev/null || which rstpep2html",
      "Verify: rstpep2html --version",
      "supercli plugins install ./plugins/rstpep2html --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rstpep2html",
      "resource": "self",
      "action": "version",
      "description": "Print rstpep2html version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rstpep2html",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rstpep2html: apt-get install rstpep2html 2>/dev/null || which rstpep2html"
      },
      "args": []
    },
    {
      "namespace": "rstpep2html",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rstpep2html CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rstpep2html",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rstpep2html: apt-get install rstpep2html 2>/dev/null || which rstpep2html"
      },
      "args": []
    }
  ]
}