{
  "name": "bgpq4",
  "version": "0.1.0",
  "description": "BGP filtering automation for Cisco, Juniper, BIRD and OpenBGPD routers",
  "source": "https://github.com/bgp/bgpq4",
  "checks": [
    {
      "type": "binary",
      "name": "bgpq4"
    }
  ],
  "install_guidance": {
    "plugin": "bgpq4",
    "binary": "bgpq4",
    "check": "which bgpq4",
    "install_steps": [
      "brew install bgpq4",
      "Verify: bgpq4 --version",
      "supercli plugins install ./plugins/bgpq4 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bgpq4",
      "resource": "self",
      "action": "version",
      "description": "Print bgpq4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bgpq4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bgpq4: brew install bgpq4"
      },
      "args": []
    },
    {
      "namespace": "bgpq4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bgpq4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bgpq4",
        "passthrough": true,
        "missingDependencyHelp": "Install bgpq4"
      },
      "args": []
    }
  ]
}