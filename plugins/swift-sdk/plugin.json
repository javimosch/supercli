{
  "name": "swift-sdk",
  "version": "0.1.0",
  "description": "The official Swift SDK for Model Context Protocol servers and clients.",
  "source": "https://github.com/swift-sdk/swift-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "swift-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "swift-sdk",
    "binary": "swift-sdk",
    "check": "which swift-sdk",
    "install_steps": [
      "pip install swift-sdk",
      "Verify: swift-sdk --version",
      "supercli plugins install ./plugins/swift-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "swift-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print swift-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "swift-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install swift-sdk: pip install swift-sdk"
      },
      "args": []
    },
    {
      "namespace": "swift-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to swift-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "swift-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install swift-sdk: pip install swift-sdk"
      },
      "args": []
    }
  ]
}