{
  "name": "git-open",
  "version": "0.1.0",
  "description": "Open the repo page for a git remote",
  "source": "https://github.com/paulirish/git-open",
  "checks": [
    {
      "type": "binary",
      "name": "git-open"
    }
  ],
  "install_guidance": {
    "plugin": "git-open",
    "binary": "git-open",
    "check": "which git-open",
    "install_steps": [
      "npm install -g git-open",
      "Verify: git-open --version",
      "supercli plugins install ./plugins/git-open --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "git-open",
      "resource": "self",
      "action": "version",
      "description": "Print git-open version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-open",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-open: npm install -g git-open"
      },
      "args": []
    },
    {
      "namespace": "git-open",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-open CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-open",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install git-open: npm install -g git-open"
      },
      "args": []
    }
  ]
}
