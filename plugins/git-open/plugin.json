{
  "name": "git-open",
  "version": "0.1.0",
  "description": "Open the GitHub page for a repo in your browser",
  "source": "https://github.com/paulirish/git-open",
  "checks": [{ "type": "binary", "name": "git-open" }],
  "install_guidance": {
    "plugin": "git-open",
    "binary": "git-open",
    "check": "which git-open",
    "install_steps": ["npm install -g git-open", "Verify: git-open --version", "supercli plugins install ./plugins/git-open --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-open",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-open CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-open",
      "passthrough": true,
      "missingDependencyHelp": "Install git-open: npm install -g git-open"
    },
    "args": []
  }]
}
