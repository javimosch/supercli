{
  "name": "speccy",
  "version": "0.1.0",
  "description": "OpenAPI specification linter and validator",
  "source": "https://github.com/wework/speccy",
  "checks": [
    {
      "type": "binary",
      "name": "speccy"
    }
  ],
  "install_guidance": {
    "plugin": "speccy",
    "binary": "speccy",
    "check": "which speccy",
    "install_steps": [
      "npm install -g speccy",
      "Verify: speccy --version",
      "supercli plugins install ./plugins/speccy --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "speccy",
      "resource": "self",
      "action": "version",
      "description": "Print speccy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "speccy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install speccy: npm install -g speccy"
      },
      "args": []
    },
    {
      "namespace": "speccy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to speccy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "speccy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install speccy: npm install -g speccy"
      },
      "args": []
    }
  ]
}
