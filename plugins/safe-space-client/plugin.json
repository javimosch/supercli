{
  "name": "safe-space-client",
  "version": "0.1.0",
  "description": "CLI tool: safe-space-client",
  "source": "https://safe-space-client.vercel.app",
  "checks": [
    {
      "type": "binary",
      "name": "safe-space-client"
    }
  ],
  "install_guidance": {
    "plugin": "safe-space-client",
    "binary": "safe-space-client",
    "check": "which safe-space-client",
    "install_steps": [
      "Check https://safe-space-client.vercel.app for installation instructions",
      "Verify: safe-space-client --version",
      "supercli plugins install ./plugins/safe-space-client --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "safe-space-client",
      "resource": "self",
      "action": "version",
      "description": "Print safe-space-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "safe-space-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install safe-space-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "safe-space-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to safe-space-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "safe-space-client",
        "passthrough": true,
        "missingDependencyHelp": "Install safe-space-client from project repository"
      },
      "args": []
    }
  ]
}