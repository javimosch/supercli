{
  "name": "phlare",
  "version": "0.1.0",
  "description": "Continuous profiling database from Grafana for flamegraphs",
  "source": "https://github.com/grafana/phlare",
  "checks": [{ "type": "binary", "name": "phlare" }],
  "install_guidance": {
    "plugin": "phlare",
    "binary": "phlare",
    "check": "which phlare",
    "install_steps": ["brew install phlare", "Verify: phlare --version", "supercli plugins install ./plugins/phlare --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "phlare",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to phlare CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "phlare",
      "passthrough": true,
      "missingDependencyHelp": "Install phlare: brew install phlare"
    },
    "args": []
  }]
}
