{
  "name": "graphviz2drawio",
  "version": "0.1.0",
  "description": "Convert graphviz (dot) files into draw.io / lucid (mxGraph) format",
  "source": "https://github.com/hbmartin/graphviz2drawio/",
  "checks": [
    {
      "type": "binary",
      "name": "graphviz2drawio"
    }
  ],
  "install_guidance": {
    "plugin": "graphviz2drawio",
    "binary": "graphviz2drawio",
    "check": "which graphviz2drawio",
    "install_steps": [
      "brew install graphviz2drawio",
      "Verify: graphviz2drawio --version",
      "supercli plugins install ./plugins/graphviz2drawio --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "graphviz2drawio",
      "resource": "self",
      "action": "version",
      "description": "Print graphviz2drawio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphviz2drawio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install graphviz2drawio: brew install graphviz2drawio"
      },
      "args": []
    },
    {
      "namespace": "graphviz2drawio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to graphviz2drawio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphviz2drawio",
        "passthrough": true,
        "missingDependencyHelp": "Install graphviz2drawio"
      },
      "args": []
    }
  ]
}