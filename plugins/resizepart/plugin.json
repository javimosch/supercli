{
  "name": "resizepart",
  "version": "1.0.0",
  "description": "resizepart \u2014 resizepart \u2014 CLI utility",
  "source": "/usr/bin/resizepart",
  "checks": [
    {
      "type": "binary",
      "name": "resizepart"
    }
  ],
  "install_guidance": {
    "plugin": "resizepart",
    "binary": "resizepart",
    "check": "which resizepart",
    "install_steps": [
      "# Install resizepart:",
      "# apt: sudo apt-get install resizepart",
      "# brew: brew install resizepart",
      "# cargo: cargo install resizepart",
      "# npm: npm install -g resizepart",
      "# pip: pip install resizepart",
      "# or download from /usr/bin/resizepart"
    ]
  },
  "commands": [
    {
      "namespace": "resizepart",
      "resource": "resizepart",
      "action": "run",
      "description": "Run resizepart",
      "adapter": "process",
      "adapterConfig": {
        "command": "resizepart",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install resizepart from /usr/bin/resizepart"
      },
      "args": []
    }
  ]
}