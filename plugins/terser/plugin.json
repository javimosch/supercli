{
  "name": "terser",
  "version": "0.1.0",
  "description": "JavaScript mangler and compressor for ES6+",
  "source": "https://github.com/terser/terser",
  "checks": [
    {
      "type": "binary",
      "name": "terser"
    }
  ],
  "install_guidance": {
    "plugin": "terser",
    "binary": "terser",
    "check": "which terser",
    "install_steps": [
      "npm install -g terser",
      "Verify: terser --version",
      "supercli plugins install ./plugins/terser --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "terser",
      "resource": "self",
      "action": "version",
      "description": "Print terser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "terser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install terser: npm install -g terser"
      },
      "args": []
    },
    {
      "namespace": "terser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to terser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "terser",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install terser: npm install -g terser"
      },
      "args": []
    }
  ]
}
