{
  "name": "tree-query",
  "version": "0.1.0",
  "description": "tree-query — query tree structures",
  "source": "https://github.com/dominictarr/tree-query",
  "checks": [
    {
      "type": "binary",
      "name": "tree-query"
    }
  ],
  "install_guidance": {
    "plugin": "tree-query",
    "binary": "tree-query",
    "check": "which tree-query",
    "install_steps": [
      "npm install tree-query",
      "Verify: tree-query --version",
      "supercli plugins install ./plugins/tree-query --on-conflict replace --json"
    ],
    "note": "tree-query is a JavaScript library ('like jQuery, but on directory trees')."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tree-query",
      "resource": "self",
      "action": "version",
      "description": "Print tree-query version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tree-query",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install tree-query: npm install tree-query"
      },
      "args": []
    }
  ]
}
