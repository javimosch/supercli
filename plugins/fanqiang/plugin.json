{
  "name": "fanqiang",
  "version": "0.1.0",
  "description": "\u514d\u8d39\u7ffb\u5899\u3001\u514d\u8d39\u79d1\u5b66\u4e0a\u7f51\u3001\u7ffb\u5899\u7ffb\u5899\u3001\u79d1\u5b66\u4e0a\u7f51\u3001Mac/iOS/\u5b89\u5353\u7ffb\u5899\u3001\u7ffb\u5899\u7ffb\u5899\u3001\u81ea\u7531\u4e0a\u7f51\u3001 \u4e00\u952e\u7ffb\u5899\u6d4f\u89c8\u5668\u3001\u514d\u8d39shadowsocks/ss/ssr/v2ray/hysteria/hysteria2/",
  "source": "https://github.com/fanqiang/fanqiang",
  "checks": [
    {
      "type": "binary",
      "name": "fanqiang"
    }
  ],
  "install_guidance": {
    "plugin": "fanqiang",
    "binary": "fanqiang",
    "check": "which fanqiang",
    "install_steps": [
      "pip install fanqiang",
      "Verify: fanqiang --version",
      "supercli plugins install ./plugins/fanqiang --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fanqiang",
      "resource": "self",
      "action": "version",
      "description": "Print fanqiang version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fanqiang",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fanqiang: pip install fanqiang"
      },
      "args": []
    },
    {
      "namespace": "fanqiang",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fanqiang CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fanqiang",
        "passthrough": true,
        "missingDependencyHelp": "Install fanqiang: pip install fanqiang"
      },
      "args": []
    }
  ]
}