{
  "name": "sqlite-history",
  "version": "0.1.0",
  "description": "Log and manage bash-like command history in SQLite",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "sqlite-history" }],
  "install_guidance": {
    "plugin": "sqlite-history",
    "binary": "sqlite-history",
    "check": "which sqlite-history",
    "install_steps": ["pip install sqlite-history", "Verify: sqlite-history --version", "supercli plugins install ./plugins/sqlite-history --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sqlite-history",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sqlite-history CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sqlite-history",
      "passthrough": true,
      "missingDependencyHelp": "Install sqlite-history: pip install sqlite-history"
    },
    "args": []
  }]
}
