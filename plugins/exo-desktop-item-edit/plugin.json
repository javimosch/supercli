{
  "name": "exo-desktop-item-edit",
  "version": "0.1.0",
  "description": "CLI tool: exo-desktop-item-edit",
  "source": "https://manpages.debian.org/exo-desktop-item-edit",
  "checks": [
    {
      "type": "binary",
      "name": "exo-desktop-item-edit"
    }
  ],
  "install_guidance": {
    "plugin": "exo-desktop-item-edit",
    "binary": "exo-desktop-item-edit",
    "check": "which exo-desktop-item-edit",
    "install_steps": [
      "apt-get install exo-desktop-item-edit 2>/dev/null || which exo-desktop-item-edit",
      "Verify: exo-desktop-item-edit --version",
      "supercli plugins install ./plugins/exo-desktop-item-edit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "exo-desktop-item-edit",
      "resource": "self",
      "action": "version",
      "description": "Print exo-desktop-item-edit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "exo-desktop-item-edit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install exo-desktop-item-edit: apt-get install exo-desktop-item-edit 2>/dev/null || which exo-desktop-item-edit"
      },
      "args": []
    },
    {
      "namespace": "exo-desktop-item-edit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to exo-desktop-item-edit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "exo-desktop-item-edit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install exo-desktop-item-edit: apt-get install exo-desktop-item-edit 2>/dev/null || which exo-desktop-item-edit"
      },
      "args": []
    }
  ]
}