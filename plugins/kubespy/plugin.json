{
  "name": "kubespy",
  "version": "0.1.0",
  "description": "Tools for observing Kubernetes resources in real time",
  "source": "https://github.com/pulumi/kubespy",
  "checks": [{ "type": "binary", "name": "kubespy" }],
  "install_guidance": {
    "plugin": "kubespy",
    "binary": "kubespy",
    "check": "which kubespy",
    "install_steps": ["brew install kubespy", "Verify: kubespy --version", "supercli plugins install ./plugins/kubespy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubespy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubespy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubespy",
      "passthrough": true,
      "missingDependencyHelp": "Install kubespy: brew install kubespy"
    },
    "args": []
  }]
}
