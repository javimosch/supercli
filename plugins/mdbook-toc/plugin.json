{
  "name": "mdbook-toc",
  "version": "0.1.0",
  "description": "Auto-generate table of contents for mdBook projects",
  "source": "https://github.com/badboy/mdbook-toc",
  "checks": [{ "type": "binary", "name": "mdbook-toc" }],
  "install_guidance": {
    "plugin": "mdbook-toc",
    "binary": "mdbook-toc",
    "check": "which mdbook-toc",
    "install_steps": ["cargo install mdbook-toc", "Verify: mdbook-toc --version", "supercli plugins install ./plugins/mdbook-toc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdbook-toc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdbook-toc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdbook-toc",
      "passthrough": true,
      "missingDependencyHelp": "Install mdbook-toc: cargo install mdbook-toc", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
