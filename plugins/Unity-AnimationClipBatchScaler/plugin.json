{
  "name": "Unity-AnimationClipBatchScaler",
  "version": "0.1.0",
  "description": "Batch Scale AnimationClip",
  "source": "https://github.com/Unity-AnimationClipBatchScaler/Unity-AnimationClipBatchScaler",
  "checks": [
    {
      "type": "binary",
      "name": "Unity-AnimationClipBatchScaler"
    }
  ],
  "install_guidance": {
    "plugin": "Unity-AnimationClipBatchScaler",
    "binary": "Unity-AnimationClipBatchScaler",
    "check": "which Unity-AnimationClipBatchScaler",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Unity-AnimationClipBatchScaler --version",
      "supercli plugins install ./plugins/Unity-AnimationClipBatchScaler --on-conflict replace --json"
    ],
    "note": "C# language CLI tool"
  },
  "commands": [
    {
      "namespace": "Unity-AnimationClipBatchScaler",
      "resource": "self",
      "action": "version",
      "description": "Print Unity-AnimationClipBatchScaler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Unity-AnimationClipBatchScaler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Unity-AnimationClipBatchScaler from project repository"
      },
      "args": []
    },
    {
      "namespace": "Unity-AnimationClipBatchScaler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Unity-AnimationClipBatchScaler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Unity-AnimationClipBatchScaler",
        "passthrough": true,
        "missingDependencyHelp": "Install Unity-AnimationClipBatchScaler from project repository"
      },
      "args": []
    }
  ]
}