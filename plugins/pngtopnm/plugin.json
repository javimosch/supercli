{
  "name": "pngtopnm",
  "version": "0.1.0",
  "description": "CLI tool: pngtopnm",
  "source": "https://manpages.debian.org/pngtopnm",
  "checks": [
    {
      "type": "binary",
      "name": "pngtopnm"
    }
  ],
  "install_guidance": {
    "plugin": "pngtopnm",
    "binary": "pngtopnm",
    "check": "which pngtopnm",
    "install_steps": [
      "apt-get install pngtopnm 2>/dev/null || which pngtopnm",
      "Verify: pngtopnm --version",
      "supercli plugins install ./plugins/pngtopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pngtopnm",
      "resource": "self",
      "action": "version",
      "description": "Print pngtopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pngtopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pngtopnm: apt-get install pngtopnm 2>/dev/null || which pngtopnm"
      },
      "args": []
    },
    {
      "namespace": "pngtopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pngtopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pngtopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pngtopnm: apt-get install pngtopnm 2>/dev/null || which pngtopnm"
      },
      "args": []
    }
  ]
}