{
  "name": "libflowmanager",
  "version": "0.1.0",
  "description": "Flow-based measurement tasks with packet-based inputs",
  "source": "https://github.com/LibtraceTeam/libflowmanager",
  "checks": [
    {
      "type": "binary",
      "name": "libflowmanager"
    }
  ],
  "install_guidance": {
    "plugin": "libflowmanager",
    "binary": "libflowmanager",
    "check": "which libflowmanager",
    "install_steps": [
      "brew install libflowmanager",
      "Verify: libflowmanager --version",
      "supercli plugins install ./plugins/libflowmanager --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libflowmanager",
      "resource": "self",
      "action": "version",
      "description": "Print libflowmanager version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libflowmanager",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libflowmanager: brew install libflowmanager"
      },
      "args": []
    },
    {
      "namespace": "libflowmanager",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libflowmanager CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libflowmanager",
        "passthrough": true,
        "missingDependencyHelp": "Install libflowmanager"
      },
      "args": []
    }
  ]
}