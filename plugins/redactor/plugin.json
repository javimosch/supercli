{
  "name": "redactor",
  "version": "0.1.0",
  "description": "PDF redaction tool ensuring secure and irreversible text removal",
  "source": "go",
  "checks": [{ "type": "binary", "name": "redactor" }],
  "install_guidance": {
    "plugin": "redactor",
    "binary": "redactor",
    "check": "which redactor",
    "install_steps": ["go install github.com/ypcrts/redactor@latest", "Verify: redactor --version", "supercli plugins install ./plugins/redactor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "redactor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to redactor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "redactor",
      "passthrough": true,
      "missingDependencyHelp": "Install redactor: go install github.com/ypcrts/redactor@latest"
    },
    "args": []
  }]
}
