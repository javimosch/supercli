{
  "name": "imgp",
  "version": "1.0.0",
  "description": "imgp \u2014 Image optimization CLI",
  "source": "github.com/jarun/imgp",
  "checks": [
    {
      "type": "binary",
      "name": "imgp"
    }
  ],
  "install_guidance": {
    "plugin": "imgp",
    "binary": "imgp",
    "check": "which imgp",
    "install_steps": [
      "# Install imgp:",
      "# apt: sudo apt-get install imgp",
      "# brew: brew install imgp",
      "# cargo: cargo install imgp",
      "# npm: npm install -g imgp",
      "# pip: pip install imgp",
      "# or download from github.com/jarun/imgp"
    ]
  },
  "commands": [
    {
      "namespace": "imgp",
      "resource": "imgp",
      "action": "run",
      "description": "Run imgp",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgp",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install imgp from github.com/jarun/imgp"
      },
      "args": []
    }
  ]
}