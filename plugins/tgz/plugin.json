{
  "name": "tgz",
  "version": "0.1.0",
  "description": "CLI tool: tgz",
  "source": "https://manpages.debian.org/tgz",
  "checks": [
    {
      "type": "binary",
      "name": "tgz"
    }
  ],
  "install_guidance": {
    "plugin": "tgz",
    "binary": "tgz",
    "check": "which tgz",
    "install_steps": [
      "apt-get install tgz 2>/dev/null || which tgz",
      "Verify: tgz --version",
      "supercli plugins install ./plugins/tgz --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tgz",
      "resource": "self",
      "action": "version",
      "description": "Print tgz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tgz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tgz: apt-get install tgz 2>/dev/null || which tgz"
      },
      "args": []
    },
    {
      "namespace": "tgz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tgz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tgz",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tgz: apt-get install tgz 2>/dev/null || which tgz"
      },
      "args": []
    }
  ]
}