{
  "name": "dos2unix",
  "version": "0.1.0",
  "description": "Convert DOS line endings to Unix",
  "source": "https://github.com/coffebar/dos2unix",
  "checks": [
    {
      "type": "binary",
      "name": "dos2unix"
    }
  ],
  "install_guidance": {
    "plugin": "dos2unix",
    "binary": "dos2unix",
    "check": "which dos2unix",
    "install_steps": [
      "brew install dos2unix",
      "Verify: dos2unix --version",
      "supercli plugins install ./plugins/dos2unix --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "dos2unix",
      "resource": "self",
      "action": "version",
      "description": "Print dos2unix version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dos2unix",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dos2unix: brew install dos2unix"
      },
      "args": []
    },
    {
      "namespace": "dos2unix",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dos2unix CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dos2unix",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dos2unix: brew install dos2unix"
      },
      "args": []
    }
  ]
}
