{
  "name": "linux32",
  "version": "0.1.0",
  "description": "CLI tool: linux32",
  "source": "https://manpages.debian.org/linux32",
  "checks": [
    {
      "type": "binary",
      "name": "linux32"
    }
  ],
  "install_guidance": {
    "plugin": "linux32",
    "binary": "linux32",
    "check": "which linux32",
    "install_steps": [
      "apt-get install linux32 2>/dev/null || which linux32",
      "Verify: linux32 --version",
      "supercli plugins install ./plugins/linux32 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linux32",
      "resource": "self",
      "action": "version",
      "description": "Print linux32 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux32",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install linux32: apt-get install linux32 2>/dev/null || which linux32"
      },
      "args": []
    },
    {
      "namespace": "linux32",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to linux32 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux32",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install linux32: apt-get install linux32 2>/dev/null || which linux32"
      },
      "args": []
    }
  ]
}