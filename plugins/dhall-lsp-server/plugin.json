{
  "name": "dhall-lsp-server",
  "version": "0.1.0",
  "description": "CLI tool: dhall-lsp-server",
  "source": "https://packages.debian.org/dhall-lsp-server",
  "checks": [{ "type": "binary", "name": "dhall-lsp-server" }],
  "install_guidance": {
    "plugin": "dhall-lsp-server", "binary": "dhall-lsp-server", "check": "which dhall-lsp-server",
    "install_steps": ["apt-get install dhall-lsp-server 2>/dev/null || which dhall-lsp-server", "Verify: dhall-lsp-server --version", "supercli plugins install ./plugins/dhall-lsp-server --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-lsp-server", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-lsp-server CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-lsp-server", "passthrough": true, "missingDependencyHelp": "Install dhall-lsp-server: apt-get install dhall-lsp-server" }, "args": []
  }]
}
