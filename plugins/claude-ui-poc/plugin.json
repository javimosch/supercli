{
  "name": "claude-ui-poc",
  "version": "0.1.0",
  "description": "CLI tool: claude-ui-poc",
  "source": "https://packages.debian.org/claude-ui-poc",
  "checks": [{ "type": "binary", "name": "claude-ui-poc" }],
  "install_guidance": {
    "plugin": "claude-ui-poc", "binary": "claude-ui-poc", "check": "which claude-ui-poc",
    "install_steps": ["apt-get install claude-ui-poc 2>/dev/null || which claude-ui-poc", "Verify: claude-ui-poc --version", "supercli plugins install ./plugins/claude-ui-poc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "claude-ui-poc", "resource": "_", "action": "_",
    "description": "Passthrough to claude-ui-poc CLI",
    "adapter": "process", "adapterConfig": { "command": "claude-ui-poc", "passthrough": true, "missingDependencyHelp": "Install claude-ui-poc: apt-get install claude-ui-poc" }, "args": []
  }]
}
