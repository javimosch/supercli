{
  "name": "pager",
  "version": "1.0.0",
  "description": "pager \u2014 pager \u2014 CLI utility",
  "source": "/usr/bin/pager",
  "checks": [
    {
      "type": "binary",
      "name": "pager"
    }
  ],
  "install_guidance": {
    "plugin": "pager",
    "binary": "pager",
    "check": "which pager",
    "install_steps": [
      "# Install pager:",
      "# apt: sudo apt-get install pager",
      "# brew: brew install pager",
      "# cargo: cargo install pager",
      "# npm: npm install -g pager",
      "# pip: pip install pager",
      "# or download from /usr/bin/pager"
    ]
  },
  "commands": [
    {
      "namespace": "pager",
      "resource": "pager",
      "action": "run",
      "description": "Run pager",
      "adapter": "process",
      "adapterConfig": {
        "command": "pager",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pager from /usr/bin/pager"
      },
      "args": []
    }
  ]
}