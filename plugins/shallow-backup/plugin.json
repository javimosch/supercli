{
  "name": "shallow-backup",
  "version": "0.1.0",
  "description": "Git integrated backup tool",
  "source": "https://github.com/alichtman/shallow-backup",
  "checks": [
    {
      "type": "binary",
      "name": "shallow-backup"
    }
  ],
  "install_guidance": {
    "plugin": "shallow-backup",
    "binary": "shallow-backup",
    "check": "which shallow-backup",
    "install_steps": [
      "brew install shallow-backup",
      "Verify: shallow-backup --version",
      "supercli plugins install ./plugins/shallow-backup --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "shallow-backup",
      "resource": "self",
      "action": "version",
      "description": "Print shallow-backup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shallow-backup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shallow-backup: brew install shallow-backup"
      },
      "args": []
    },
    {
      "namespace": "shallow-backup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shallow-backup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shallow-backup",
        "passthrough": true,
        "missingDependencyHelp": "Install shallow-backup"
      },
      "args": []
    }
  ]
}