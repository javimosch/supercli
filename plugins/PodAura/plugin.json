{
  "name": "PodAura",
  "version": "0.1.0",
  "description": "All-in-on podcast app for RSS, media dl & play. MVI arch, Material You style. \u2b50\ufe0f Star to support!",
  "source": "https://github.com/PodAura/PodAura",
  "checks": [
    {
      "type": "binary",
      "name": "podaura"
    }
  ],
  "install_guidance": {
    "plugin": "PodAura",
    "binary": "podaura",
    "check": "which podaura",
    "install_steps": [
      "pip install podaura",
      "Verify: podaura --version",
      "supercli plugins install ./plugins/PodAura --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PodAura",
      "resource": "self",
      "action": "version",
      "description": "Print PodAura version",
      "adapter": "process",
      "adapterConfig": {
        "command": "podaura",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PodAura: pip install podaura"
      },
      "args": []
    },
    {
      "namespace": "PodAura",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to podaura CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "podaura",
        "passthrough": true,
        "missingDependencyHelp": "Install PodAura: pip install podaura"
      },
      "args": []
    }
  ]
}