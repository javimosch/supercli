{
  "name": "avrdude",
  "version": "0.1.0",
  "description": "Atmel AVR MCU programmer",
  "checks": [
    {
      "type": "binary",
      "name": "avrdude"
    }
  ],
  "install_guidance": {
    "plugin": "avrdude",
    "binary": "avrdude",
    "check": "which avrdude",
    "install_steps": [
      "brew install avrdude",
      "Verify: avrdude --version",
      "supercli plugins install ./plugins/avrdude --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "avrdude",
      "resource": "self",
      "action": "version",
      "description": "Print avrdude version",
      "adapter": "process",
      "adapterConfig": {
        "command": "avrdude",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install avrdude: brew install avrdude"
      },
      "args": []
    },
    {
      "namespace": "avrdude",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to avrdude CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "avrdude",
        "passthrough": true,
        "missingDependencyHelp": "Install avrdude"
      },
      "args": []
    }
  ]
}