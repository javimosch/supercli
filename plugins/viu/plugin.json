{
  "name": "viu",
  "version": "0.1.0",
  "description": "Terminal image viewer with native support for iTerm and Kitty inline images — display images, GIFs, and animated content directly in the terminal",
  "source": "https://github.com/atanunq/viu",
  "checks": [
    {
      "type": "binary",
      "name": "viu"
    }
  ],
  "install_guidance": {
    "plugin": "viu",
    "binary": "viu",
    "check": "which viu",
    "install_steps": [
      "cargo install viu",
      "Or: brew install viu",
      "Or download binary from https://github.com/atanunq/viu/releases",
      "Verify: viu --version"
    ]
  },
  "commands": [
    {
      "namespace": "viu",
      "resource": "image",
      "action": "view",
      "description": "Display one or more images in the terminal",
      "adapter": "process",
      "adapterConfig": {
        "command": "viu",
        "baseArgs": [],
        "missingDependencyHelp": "Install viu: cargo install viu",
        "passthrough": true
      },
      "args": [
        {
          "name": "files",
          "type": "string",
          "required": true,
          "description": "Image file(s) to display (use - for stdin)"
        },
        {
          "name": "width",
          "type": "string",
          "required": false,
          "description": "Resize image to a specific width"
        },
        {
          "name": "height",
          "type": "string",
          "required": false,
          "description": "Resize image to a specific height"
        },
        {
          "name": "x",
          "type": "string",
          "required": false,
          "description": "X offset for image placement"
        },
        {
          "name": "y",
          "type": "string",
          "required": false,
          "description": "Y offset for image placement"
        },
        {
          "name": "absolute-offset",
          "type": "boolean",
          "required": false,
          "description": "Use absolute positioning from top-left terminal corner"
        },
        {
          "name": "recursive",
          "type": "boolean",
          "required": false,
          "description": "Recurse into directories"
        },
        {
          "name": "blocks",
          "type": "boolean",
          "required": false,
          "description": "Force block character output"
        },
        {
          "name": "name",
          "type": "boolean",
          "required": false,
          "description": "Print filename before displaying"
        },
        {
          "name": "caption",
          "type": "boolean",
          "required": false,
          "description": "Print caption after displaying"
        },
        {
          "name": "transparent",
          "type": "boolean",
          "required": false,
          "description": "Display transparent images with transparent background"
        },
        {
          "name": "frame-rate",
          "type": "string",
          "required": false,
          "description": "Set GIF playback frame rate in fps"
        },
        {
          "name": "once",
          "type": "boolean",
          "required": false,
          "description": "Loop GIF only once"
        },
        {
          "name": "static",
          "type": "boolean",
          "required": false,
          "description": "Show only first frame of GIF"
        }
      ]
    },
    {
      "namespace": "viu",
      "resource": "self",
      "action": "version",
      "description": "Print viu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "viu",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install viu: cargo install viu"
      },
      "args": []
    }
  ]
}
