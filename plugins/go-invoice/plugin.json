{
  "name": "go-invoice",
  "version": "0.1.0",
  "description": "CLI with MCP support for billing and invoice generation",
  "source": "go",
  "checks": [{ "type": "binary", "name": "go-invoice" }],
  "install_guidance": {
    "plugin": "go-invoice",
    "binary": "go-invoice",
    "check": "which go-invoice",
    "install_steps": ["go install github.com/mrz1836/go-invoice/cmd/go-invoice@latest", "Verify: go-invoice --version", "supercli plugins install ./plugins/go-invoice --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "go-invoice",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to go-invoice CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-invoice",
      "passthrough": true,
      "missingDependencyHelp": "Install go-invoice: go install github.com/mrz1836/go-invoice/cmd/go-invoice@latest"
    },
    "args": []
  }]
}
