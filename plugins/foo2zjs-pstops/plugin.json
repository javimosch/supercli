{
  "name": "foo2zjs-pstops",
  "version": "0.1.0",
  "description": "add PS code for foo2*-wrapper (printer-driver-foo2zjs-common)",
  "source": "https://manpages.debian.org/foo2zjs-pstops",
  "checks": [
    {
      "type": "binary",
      "name": "foo2zjs-pstops"
    }
  ],
  "install_guidance": {
    "plugin": "foo2zjs-pstops",
    "binary": "foo2zjs-pstops",
    "check": "which foo2zjs-pstops",
    "install_steps": [
      "apt-get install foo2zjs-pstops 2>/dev/null || which foo2zjs-pstops",
      "Verify: foo2zjs-pstops --version",
      "supercli plugins install ./plugins/foo2zjs-pstops --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "foo2zjs-pstops",
      "resource": "self",
      "action": "version",
      "description": "Print foo2zjs-pstops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "foo2zjs-pstops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install foo2zjs-pstops: apt-get install foo2zjs-pstops 2>/dev/null || which foo2zjs-pstops"
      },
      "args": []
    },
    {
      "namespace": "foo2zjs-pstops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to foo2zjs-pstops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "foo2zjs-pstops",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install foo2zjs-pstops: apt-get install foo2zjs-pstops 2>/dev/null || which foo2zjs-pstops"
      },
      "args": []
    }
  ]
}