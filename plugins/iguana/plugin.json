{
  "name": "iguana",
  "version": "0.1.0",
  "description": "Universal serialization engine",
  "source": "https://github.com/qicosmos/iguana",
  "checks": [
    {
      "type": "binary",
      "name": "iguana"
    }
  ],
  "install_guidance": {
    "plugin": "iguana",
    "binary": "iguana",
    "check": "which iguana",
    "install_steps": [
      "brew install iguana",
      "Verify: iguana --version",
      "supercli plugins install ./plugins/iguana --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "iguana",
      "resource": "self",
      "action": "version",
      "description": "Print iguana version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iguana",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iguana: brew install iguana"
      },
      "args": []
    },
    {
      "namespace": "iguana",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iguana CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iguana",
        "passthrough": true,
        "missingDependencyHelp": "Install iguana"
      },
      "args": []
    }
  ]
}