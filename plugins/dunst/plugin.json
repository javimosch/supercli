{
  "name": "dunst",
  "version": "1.0.0",
  "description": "dunst \u2014 Notification daemon",
  "source": "dunst-project.org",
  "checks": [
    {
      "type": "binary",
      "name": "dunst"
    }
  ],
  "install_guidance": {
    "plugin": "dunst",
    "binary": "dunst",
    "check": "which dunst",
    "install_steps": [
      "# Install dunst",
      "# See dunst-project.org",
      "# apt: sudo apt-get install dunst",
      "# brew: brew install dunst",
      "# cargo: cargo install dunst",
      "# npm: npm install -g dunst",
      "# pip: pip install dunst"
    ]
  },
  "commands": [
    {
      "namespace": "dunst",
      "resource": "dunst",
      "action": "run",
      "description": "Run dunst",
      "adapter": "process",
      "adapterConfig": {
        "command": "dunst",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dunst from dunst-project.org"
      },
      "args": []
    }
  ]
}