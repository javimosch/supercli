{
  "name": "dfu_prog",
  "version": "0.1.0",
  "description": "CLI tool: dfu_prog",
  "source": "https://packages.debian.org/dfu_prog",
  "checks": [{ "type": "binary", "name": "dfu_prog" }],
  "install_guidance": {
    "plugin": "dfu_prog", "binary": "dfu_prog", "check": "which dfu_prog",
    "install_steps": ["apt-get install dfu_prog 2>/dev/null || which dfu_prog", "Verify: dfu_prog --version", "supercli plugins install ./plugins/dfu_prog --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dfu_prog", "resource": "_", "action": "_",
    "description": "Passthrough to dfu_prog CLI",
    "adapter": "process", "adapterConfig": { "command": "dfu_prog", "passthrough": true, "missingDependencyHelp": "Install dfu_prog: apt-get install dfu_prog" }, "args": []
  }]
}
