{
  "name": "projclean",
  "version": "0.1.0",
  "description": "A project build artifact cleanup tool. Scans directories for build outputs, cache files, and temporary artifacts to reclaim disk space across projects.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "projclean"
    }
  ],
  "install_guidance": {
    "plugin": "projclean",
    "binary": "projclean",
    "check": "which projclean",
    "install_steps": [
      "cargo install projclean",
      "Verify: projclean --version",
      "supercli plugins install ./plugins/projclean --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "projclean",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to projclean CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "projclean",
        "passthrough": true,
        "missingDependencyHelp": "Install projclean: cargo install projclean"
      },
      "args": []
    }
  ]
}
