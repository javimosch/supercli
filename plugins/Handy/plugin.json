{
  "name": "Handy",
  "version": "0.1.0",
  "description": "A free, open source, and extensible speech-to-text application that works completely offline.",
  "source": "https://github.com/Handy/Handy",
  "checks": [
    {
      "type": "binary",
      "name": "handy"
    }
  ],
  "install_guidance": {
    "plugin": "Handy",
    "binary": "handy",
    "check": "which handy",
    "install_steps": [
      "pip install handy",
      "Verify: handy --version",
      "supercli plugins install ./plugins/Handy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Handy",
      "resource": "self",
      "action": "version",
      "description": "Print Handy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "handy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Handy: pip install handy"
      },
      "args": []
    },
    {
      "namespace": "Handy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to handy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "handy",
        "passthrough": true,
        "missingDependencyHelp": "Install Handy: pip install handy"
      },
      "args": []
    }
  ]
}