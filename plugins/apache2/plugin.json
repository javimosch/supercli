{
  "name": "apache2",
  "version": "0.1.0",
  "description": "CLI tool: apache2",
  "source": "https://packages.debian.org/apache2",
  "checks": [{ "type": "binary", "name": "apache2" }],
  "install_guidance": {
    "plugin": "apache2", "binary": "apache2", "check": "which apache2",
    "install_steps": ["apt-get install apache2 2>/dev/null || which apache2", "Verify: apache2 --version", "supercli plugins install ./plugins/apache2 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apache2", "resource": "_", "action": "_",
    "description": "Passthrough to apache2 CLI",
    "adapter": "process", "adapterConfig": { "command": "apache2", "passthrough": true, "missingDependencyHelp": "Install apache2: apt-get install apache2" }, "args": []
  }]
}
