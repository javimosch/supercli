{
  "name": "x86_64-linux-gnu-ar",
  "version": "0.1.0",
  "description": "CLI tool: x86_64-linux-gnu-ar",
  "source": "https://manpages.debian.org/x86_64-linux-gnu-ar",
  "checks": [
    {
      "type": "binary",
      "name": "x86_64-linux-gnu-ar"
    }
  ],
  "install_guidance": {
    "plugin": "x86_64-linux-gnu-ar",
    "binary": "x86_64-linux-gnu-ar",
    "check": "which x86_64-linux-gnu-ar",
    "install_steps": [
      "apt-get install x86_64-linux-gnu-ar 2>/dev/null || which x86_64-linux-gnu-ar",
      "Verify: x86_64-linux-gnu-ar --version",
      "supercli plugins install ./plugins/x86_64-linux-gnu-ar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "x86_64-linux-gnu-ar",
      "resource": "self",
      "action": "version",
      "description": "Print x86_64-linux-gnu-ar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "x86_64-linux-gnu-ar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install x86_64-linux-gnu-ar: apt-get install x86_64-linux-gnu-ar 2>/dev/null || which x86_64-linux-gnu-ar"
      },
      "args": []
    },
    {
      "namespace": "x86_64-linux-gnu-ar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to x86_64-linux-gnu-ar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "x86_64-linux-gnu-ar",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install x86_64-linux-gnu-ar: apt-get install x86_64-linux-gnu-ar 2>/dev/null || which x86_64-linux-gnu-ar"
      },
      "args": []
    }
  ]
}