{
  "name": "alpine-ssh",
  "version": "0.1.0",
  "description": "Minimal Alpine-based environment for jump-box SSH tunneling",
  "source": "docker",
  "checks": [{ "type": "binary", "name": "alpine-ssh" }],
  "install_guidance": {
    "plugin": "alpine-ssh",
    "binary": "alpine-ssh",
    "check": "which alpine-ssh",
    "install_steps": ["docker run --rm -it typezac/alpine-ssh", "Verify: alpine-ssh --version", "supercli plugins install ./plugins/alpine-ssh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "alpine-ssh",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to alpine-ssh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "alpine-ssh",
      "passthrough": true,
      "missingDependencyHelp": "Install alpine-ssh: docker run --rm -it typezac/alpine-ssh"
    },
    "args": []
  }]
}
