{
  "name": "dh_perl_openssl",
  "version": "0.1.0",
  "description": "CLI tool: dh_perl_openssl",
  "source": "https://packages.debian.org/dh_perl_openssl",
  "checks": [{ "type": "binary", "name": "dh_perl_openssl" }],
  "install_guidance": {
    "plugin": "dh_perl_openssl", "binary": "dh_perl_openssl", "check": "which dh_perl_openssl",
    "install_steps": ["apt-get install dh_perl_openssl 2>/dev/null || which dh_perl_openssl", "Verify: dh_perl_openssl --version", "supercli plugins install ./plugins/dh_perl_openssl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_perl_openssl", "resource": "_", "action": "_",
    "description": "Passthrough to dh_perl_openssl CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_perl_openssl", "passthrough": true, "missingDependencyHelp": "Install dh_perl_openssl: apt-get install dh_perl_openssl" }, "args": []
  }]
}
