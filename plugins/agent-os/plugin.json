{
  "name": "agent-os",
  "version": "0.1.0",
  "description": "Agent OS is a system for injecting your codebase standards and writing better specs for spec-driven ",
  "source": "https://github.com/agent-os/agent-os",
  "checks": [
    {
      "type": "binary",
      "name": "agent-os"
    }
  ],
  "install_guidance": {
    "plugin": "agent-os",
    "binary": "agent-os",
    "check": "which agent-os",
    "install_steps": [
      "pip install agent-os",
      "Verify: agent-os --version",
      "supercli plugins install ./plugins/agent-os --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agent-os",
      "resource": "self",
      "action": "version",
      "description": "Print agent-os version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-os",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agent-os: pip install agent-os"
      },
      "args": []
    },
    {
      "namespace": "agent-os",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agent-os CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-os",
        "passthrough": true,
        "missingDependencyHelp": "Install agent-os: pip install agent-os"
      },
      "args": []
    }
  ]
}