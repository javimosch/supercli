{
  "name": "NodeQuality",
  "version": "0.1.0",
  "description": "\u5728\u6c99\u7bb1\u73af\u5883\u4e2d\u8fd0\u884cvps\u6d4b\u8bd5\u811a\u672c\uff0c\u5e76\u6392\u7248\u6d4b\u8bd5\u7ed3\u679c",
  "source": "https://github.com/NodeQuality/NodeQuality",
  "checks": [
    {
      "type": "binary",
      "name": "nodequality"
    }
  ],
  "install_guidance": {
    "plugin": "NodeQuality",
    "binary": "nodequality",
    "check": "which nodequality",
    "install_steps": [
      "pip install nodequality",
      "Verify: nodequality --version",
      "supercli plugins install ./plugins/NodeQuality --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NodeQuality",
      "resource": "self",
      "action": "version",
      "description": "Print NodeQuality version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nodequality",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NodeQuality: pip install nodequality"
      },
      "args": []
    },
    {
      "namespace": "NodeQuality",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nodequality CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nodequality",
        "passthrough": true,
        "missingDependencyHelp": "Install NodeQuality: pip install nodequality"
      },
      "args": []
    }
  ]
}