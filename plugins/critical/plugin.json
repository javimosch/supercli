{
  "name": "critical",
  "version": "0.1.0",
  "description": "Extract and inline critical-path CSS",
  "source": "https://github.com/addyosmani/critical",
  "checks": [
    {
      "type": "binary",
      "name": "critical"
    }
  ],
  "install_guidance": {
    "plugin": "critical",
    "binary": "critical",
    "check": "which critical",
    "install_steps": [
      "npm install -g critical",
      "Verify: critical --version",
      "supercli plugins install ./plugins/critical --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "critical",
      "resource": "self",
      "action": "version",
      "description": "Print critical version",
      "adapter": "process",
      "adapterConfig": {
        "command": "critical",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install critical: npm install -g critical"
      },
      "args": []
    },
    {
      "namespace": "critical",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to critical CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "critical",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install critical: npm install -g critical"
      },
      "args": []
    }
  ]
}
