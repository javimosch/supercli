{
  "name": "cupstestppd",
  "version": "0.1.0",
  "description": "CLI tool: cupstestppd",
  "source": "https://manpages.debian.org/cupstestppd",
  "checks": [
    {
      "type": "binary",
      "name": "cupstestppd"
    }
  ],
  "install_guidance": {
    "plugin": "cupstestppd",
    "binary": "cupstestppd",
    "check": "which cupstestppd",
    "install_steps": [
      "apt-get install cupstestppd 2>/dev/null || which cupstestppd",
      "Verify: cupstestppd --version",
      "supercli plugins install ./plugins/cupstestppd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cupstestppd",
      "resource": "self",
      "action": "version",
      "description": "Print cupstestppd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cupstestppd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cupstestppd: apt-get install cupstestppd 2>/dev/null || which cupstestppd"
      },
      "args": []
    },
    {
      "namespace": "cupstestppd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cupstestppd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cupstestppd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install cupstestppd: apt-get install cupstestppd 2>/dev/null || which cupstestppd"
      },
      "args": []
    }
  ]
}