{
  "name": "gzip",
  "version": "0.1.0",
  "description": "gzip — GNU file compression utility for single-file compression",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "gzip"
    }
  ],
  "install_guidance": {
    "plugin": "gzip",
    "binary": "gzip",
    "check": "which gzip",
    "install_steps": [
      "brew install gzip",
      "Verify: gzip --version",
      "supercli plugins install ./plugins/gzip --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gzip",
      "resource": "self",
      "action": "version",
      "description": "Print gzip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gzip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gzip: brew install gzip"
      },
      "args": []
    },
    {
      "namespace": "gzip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gzip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gzip",
        "passthrough": true,
        "missingDependencyHelp": "Install gzip: brew install gzip"
      },
      "args": []
    }
  ]
}
