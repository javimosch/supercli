{
  "name": "gemtopnm",
  "version": "0.1.0",
  "description": "CLI tool: gemtopnm",
  "source": "https://manpages.debian.org/gemtopnm",
  "checks": [
    {
      "type": "binary",
      "name": "gemtopnm"
    }
  ],
  "install_guidance": {
    "plugin": "gemtopnm",
    "binary": "gemtopnm",
    "check": "which gemtopnm",
    "install_steps": [
      "apt-get install gemtopnm 2>/dev/null || which gemtopnm",
      "Verify: gemtopnm --version",
      "supercli plugins install ./plugins/gemtopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gemtopnm",
      "resource": "self",
      "action": "version",
      "description": "Print gemtopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemtopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gemtopnm: apt-get install gemtopnm 2>/dev/null || which gemtopnm"
      },
      "args": []
    },
    {
      "namespace": "gemtopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gemtopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemtopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gemtopnm: apt-get install gemtopnm 2>/dev/null || which gemtopnm"
      },
      "args": []
    }
  ]
}