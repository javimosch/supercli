{
  "name": "cockpit-tools",
  "version": "0.1.0",
  "description": " \ud83d\ude80 \u901a\u7528 AI IDE \u8d26\u53f7\u7ba1\u7406\u5de5\u5177\uff1a\u652f\u6301 Antigravity / Codex / GitHub Copilot / Windsurf / Kiro / Cursor / Gemini-cli ",
  "source": "https://github.com/cockpit-tools/cockpit-tools",
  "checks": [
    {
      "type": "binary",
      "name": "cockpit-tools"
    }
  ],
  "install_guidance": {
    "plugin": "cockpit-tools",
    "binary": "cockpit-tools",
    "check": "which cockpit-tools",
    "install_steps": [
      "pip install cockpit-tools",
      "Verify: cockpit-tools --version",
      "supercli plugins install ./plugins/cockpit-tools --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cockpit-tools",
      "resource": "self",
      "action": "version",
      "description": "Print cockpit-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cockpit-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cockpit-tools: pip install cockpit-tools"
      },
      "args": []
    },
    {
      "namespace": "cockpit-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cockpit-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cockpit-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install cockpit-tools: pip install cockpit-tools"
      },
      "args": []
    }
  ]
}