{
  "name": "Clipboard",
  "version": "0.1.0",
  "description": "Cut, copy, and paste anything, anywhere",
  "source": "https://github.com/Slackadays/Clipboard",
  "checks": [
    {
      "type": "binary",
      "name": "Clipboard"
    }
  ],
  "install_guidance": {
    "plugin": "Clipboard",
    "binary": "Clipboard",
    "check": "which Clipboard",
    "install_steps": [
      "brew install Clipboard",
      "Verify: Clipboard --version",
      "supercli plugins install ./plugins/Clipboard --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Clipboard",
      "resource": "self",
      "action": "version",
      "description": "Print Clipboard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Clipboard",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Clipboard: brew install Clipboard"
      },
      "args": []
    },
    {
      "namespace": "Clipboard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Clipboard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Clipboard",
        "passthrough": true,
        "missingDependencyHelp": "Install Clipboard"
      },
      "args": []
    }
  ]
}