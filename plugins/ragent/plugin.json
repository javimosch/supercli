{
  "name": "ragent",
  "version": "0.1.0",
  "description": "\u4f01\u4e1a\u7ea7 Agentic RAG \u667a\u80fd\u4f53 - \u5168\u94fe\u8def\u8986\u76d6\u6587\u6863\u89e3\u6790\u3001\u591a\u8def\u68c0\u7d22\u3001\u610f\u56fe\u8bc6\u522b\u3001\u95ee\u9898\u91cd\u5199\u3001\u4f1a\u8bdd\u8bb0\u5fc6\u3001MCP \u5de5\u5177\u8c03\u7528\u4e0e\u6df1\u5ea6\u601d\u8003\u3002\u9762\u5411\u771f\u5b9e\u4e1a\u52a1\u573a\u666f\uff0c\u4ece 0 \u5230 1 \u5b8c\u6574\u5de5\u7a0b\u5b9e\u73b0\u3002",
  "source": "https://github.com/ragent/ragent",
  "checks": [
    {
      "type": "binary",
      "name": "ragent"
    }
  ],
  "install_guidance": {
    "plugin": "ragent",
    "binary": "ragent",
    "check": "which ragent",
    "install_steps": [
      "pip install ragent",
      "Verify: ragent --version",
      "supercli plugins install ./plugins/ragent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ragent",
      "resource": "self",
      "action": "version",
      "description": "Print ragent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ragent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ragent: pip install ragent"
      },
      "args": []
    },
    {
      "namespace": "ragent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ragent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ragent",
        "passthrough": true,
        "missingDependencyHelp": "Install ragent: pip install ragent"
      },
      "args": []
    }
  ]
}