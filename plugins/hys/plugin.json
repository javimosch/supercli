{
  "name": "hys",
  "version": "0.1.0",
  "description": "Terminal RSS Reader for Digital Minimalists in Zig \u2014 Tool for Escaping the Doomscroll",
  "source": "https://github.com/hys/hys",
  "checks": [
    {
      "type": "binary",
      "name": "hys"
    }
  ],
  "install_guidance": {
    "plugin": "hys",
    "binary": "hys",
    "check": "which hys",
    "install_steps": [
      "pip install hys",
      "Verify: hys --version",
      "supercli plugins install ./plugins/hys --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hys",
      "resource": "self",
      "action": "version",
      "description": "Print hys version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hys",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hys: pip install hys"
      },
      "args": []
    },
    {
      "namespace": "hys",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hys CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hys",
        "passthrough": true,
        "missingDependencyHelp": "Install hys: pip install hys"
      },
      "args": []
    }
  ]
}