{
  "name": "journalot",
  "version": "0.1.0",
  "description": "Journaling tool with git sync",
  "source": "https://github.com/jtaylortech/journalot",
  "checks": [
    {
      "type": "binary",
      "name": "journalot"
    }
  ],
  "install_guidance": {
    "plugin": "journalot",
    "binary": "journalot",
    "check": "which journalot",
    "install_steps": [
      "See https://github.com/jtaylortech/journalot",
      "Verify: journalot --version",
      "supercli plugins install ./plugins/journalot --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "journalot",
      "resource": "self",
      "action": "version",
      "description": "Print journalot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "journalot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install journalot: See https://github.com/jtaylortech/journalot"
      },
      "args": []
    },
    {
      "namespace": "journalot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to journalot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "journalot",
        "passthrough": true,
        "missingDependencyHelp": "Install journalot"
      },
      "args": []
    }
  ]
}