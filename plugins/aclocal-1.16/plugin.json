{
  "name": "aclocal-1.16",
  "version": "0.1.0",
  "description": "CLI tool: aclocal-1.16",
  "source": "https://manpages.debian.org/aclocal-1.16",
  "checks": [
    {
      "type": "binary",
      "name": "aclocal-1.16"
    }
  ],
  "install_guidance": {
    "plugin": "aclocal-1.16",
    "binary": "aclocal-1.16",
    "check": "which aclocal-1.16",
    "install_steps": [
      "apt-get install aclocal-1.16 2>/dev/null || which aclocal-1.16",
      "Verify: aclocal-1.16 --version",
      "supercli plugins install ./plugins/aclocal-1.16 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aclocal-1.16",
      "resource": "self",
      "action": "version",
      "description": "Print aclocal-1.16 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aclocal-1.16",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aclocal-1.16: apt-get install aclocal-1.16 2>/dev/null || which aclocal-1.16"
      },
      "args": []
    },
    {
      "namespace": "aclocal-1.16",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aclocal-1.16 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aclocal-1.16",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install aclocal-1.16: apt-get install aclocal-1.16 2>/dev/null || which aclocal-1.16"
      },
      "args": []
    }
  ]
}