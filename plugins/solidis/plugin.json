{
  "name": "solidis",
  "version": "0.1.0",
  "description": "Tiny TypeScript Redis client designed for serverless environments",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "solidis" }],
  "install_guidance": {
    "plugin": "solidis",
    "binary": "solidis",
    "check": "which solidis",
    "install_steps": ["npm install solidis", "Verify: solidis --version", "supercli plugins install ./plugins/solidis --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "solidis",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to solidis CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "solidis",
      "passthrough": true,
      "missingDependencyHelp": "Install solidis: npm install solidis"
    },
    "args": []
  }]
}
