{
  "name": "resumx",
  "version": "0.1.0",
  "description": "Markdown resume renderer with auto page-fitting",
  "source": "https://github.com/resumx/resumx",
  "checks": [
    {
      "type": "binary",
      "name": "resumx"
    }
  ],
  "install_guidance": {
    "plugin": "resumx",
    "binary": "resumx",
    "check": "which resumx",
    "install_steps": [
      "See https://github.com/resumx/resumx",
      "Verify: resumx --version",
      "supercli plugins install ./plugins/resumx --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "resumx",
      "resource": "self",
      "action": "version",
      "description": "Print resumx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "resumx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install resumx: See https://github.com/resumx/resumx"
      },
      "args": []
    },
    {
      "namespace": "resumx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to resumx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "resumx",
        "passthrough": true,
        "missingDependencyHelp": "Install resumx"
      },
      "args": []
    }
  ]
}