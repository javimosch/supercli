{
  "name": "c2w",
  "version": "0.1.0",
  "description": "convert CLI programs to Web services",
  "source": "https://github.com/c2w/c2w",
  "checks": [
    {
      "type": "binary",
      "name": "c2w"
    }
  ],
  "install_guidance": {
    "plugin": "c2w",
    "binary": "c2w",
    "check": "which c2w",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: c2w --version",
      "supercli plugins install ./plugins/c2w --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "c2w",
      "resource": "self",
      "action": "version",
      "description": "Print c2w version",
      "adapter": "process",
      "adapterConfig": {
        "command": "c2w",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install c2w from project repository"
      },
      "args": []
    },
    {
      "namespace": "c2w",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to c2w CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "c2w",
        "passthrough": true,
        "missingDependencyHelp": "Install c2w from project repository"
      },
      "args": []
    }
  ]
}