{
  "name": "fmdiff",
  "version": "0.1.0",
  "description": "Use FileMerge as a diff command for Subversion and Mercurial",
  "source": "https://github.com/brunodefraine/fmscripts",
  "checks": [
    {
      "type": "binary",
      "name": "fmdiff"
    }
  ],
  "install_guidance": {
    "plugin": "fmdiff",
    "binary": "fmdiff",
    "check": "which fmdiff",
    "install_steps": [
      "brew install fmdiff",
      "Verify: fmdiff --version",
      "supercli plugins install ./plugins/fmdiff --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fmdiff",
      "resource": "self",
      "action": "version",
      "description": "Print fmdiff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fmdiff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fmdiff: brew install fmdiff"
      },
      "args": []
    },
    {
      "namespace": "fmdiff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fmdiff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fmdiff",
        "passthrough": true,
        "missingDependencyHelp": "Install fmdiff"
      },
      "args": []
    }
  ]
}