{
  "name": "kots-cli",
  "version": "0.1.0",
  "description": "Kubernetes Off-The-Shelf software delivery CLI",
  "source": "https://github.com/replicatedhq/kots",
  "checks": [{ "type": "binary", "name": "kots" }],
  "install_guidance": {
    "plugin": "kots-cli",
    "binary": "kots",
    "check": "which kots",
    "install_steps": ["brew install kots", "Verify: kots --version", "supercli plugins install ./plugins/kots-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kots-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kots CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kots",
      "passthrough": true,
      "missingDependencyHelp": "Install kots-cli: brew install kots"
    },
    "args": []
  }]
}
