{
  "name": "foomatic-rip",
  "version": "0.1.0",
  "description": "CLI tool: foomatic-rip",
  "source": "https://manpages.debian.org/foomatic-rip",
  "checks": [
    {
      "type": "binary",
      "name": "foomatic-rip"
    }
  ],
  "install_guidance": {
    "plugin": "foomatic-rip",
    "binary": "foomatic-rip",
    "check": "which foomatic-rip",
    "install_steps": [
      "apt-get install foomatic-rip 2>/dev/null || which foomatic-rip",
      "Verify: foomatic-rip --version",
      "supercli plugins install ./plugins/foomatic-rip --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "foomatic-rip",
      "resource": "self",
      "action": "version",
      "description": "Print foomatic-rip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "foomatic-rip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install foomatic-rip: apt-get install foomatic-rip 2>/dev/null || which foomatic-rip"
      },
      "args": []
    },
    {
      "namespace": "foomatic-rip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to foomatic-rip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "foomatic-rip",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install foomatic-rip: apt-get install foomatic-rip 2>/dev/null || which foomatic-rip"
      },
      "args": []
    }
  ]
}