{
  "name": "purple-ssh",
  "version": "0.1.0",
  "description": "Ratatui-powered terminal SSH client with modern UI",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "purple-ssh" }],
  "install_guidance": {
    "plugin": "purple-ssh",
    "binary": "purple-ssh",
    "check": "which purple-ssh",
    "install_steps": ["cargo install purple-ssh", "Verify: purple-ssh --version", "supercli plugins install ./plugins/purple-ssh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "purple-ssh",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to purple-ssh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "purple-ssh",
      "passthrough": true,
      "missingDependencyHelp": "Install purple-ssh: cargo install purple-ssh"
    },
    "args": []
  }]
}
