{
  "name": "pyinstaller",
  "version": "0.1.0",
  "description": "CLI tool: pyinstaller",
  "source": "https://manpages.debian.org/pyinstaller",
  "checks": [
    {
      "type": "binary",
      "name": "pyinstaller"
    }
  ],
  "install_guidance": {
    "plugin": "pyinstaller",
    "binary": "pyinstaller",
    "check": "which pyinstaller",
    "install_steps": [
      "apt-get install pyinstaller 2>/dev/null || which pyinstaller",
      "Verify: pyinstaller --version",
      "supercli plugins install ./plugins/pyinstaller --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyinstaller",
      "resource": "self",
      "action": "version",
      "description": "Print pyinstaller version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyinstaller",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyinstaller: apt-get install pyinstaller 2>/dev/null || which pyinstaller"
      },
      "args": []
    },
    {
      "namespace": "pyinstaller",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyinstaller CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyinstaller",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyinstaller: apt-get install pyinstaller 2>/dev/null || which pyinstaller"
      },
      "args": []
    }
  ]
}