{
  "name": "envsub",
  "version": "0.1.0",
  "description": "Substitute environment variables in file templates",
  "source": "https://github.com/danday74/envsub",
  "checks": [{ "type": "binary", "name": "envsub" }],
  "install_guidance": {
    "plugin": "envsub",
    "binary": "envsub",
    "check": "which envsub",
    "install_steps": ["npm install -g envsub", "Verify: envsub --version", "supercli plugins install ./plugins/envsub --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "envsub",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to envsub CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "envsub",
      "passthrough": true,
      "missingDependencyHelp": "Install envsub: npm install -g envsub", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
