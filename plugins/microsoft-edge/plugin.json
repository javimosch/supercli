{
  "name": "microsoft-edge",
  "version": "0.1.0",
  "description": "CLI tool: microsoft-edge",
  "source": "https://manpages.debian.org/microsoft-edge",
  "checks": [
    {
      "type": "binary",
      "name": "microsoft-edge"
    }
  ],
  "install_guidance": {
    "plugin": "microsoft-edge",
    "binary": "microsoft-edge",
    "check": "which microsoft-edge",
    "install_steps": [
      "apt-get install microsoft-edge 2>/dev/null || which microsoft-edge",
      "Verify: microsoft-edge --version",
      "supercli plugins install ./plugins/microsoft-edge --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "microsoft-edge",
      "resource": "self",
      "action": "version",
      "description": "Print microsoft-edge version",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsoft-edge",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install microsoft-edge: apt-get install microsoft-edge 2>/dev/null || which microsoft-edge"
      },
      "args": []
    },
    {
      "namespace": "microsoft-edge",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to microsoft-edge CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsoft-edge",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install microsoft-edge: apt-get install microsoft-edge 2>/dev/null || which microsoft-edge"
      },
      "args": []
    }
  ]
}