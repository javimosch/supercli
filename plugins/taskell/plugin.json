{
  "name": "taskell",
  "version": "0.1.0",
  "description": "Interactive kanban board/task manager.",
  "source": "https://github.com/smallhadroncollider/taskell",
  "checks": [
    {
      "type": "binary",
      "name": "taskell"
    }
  ],
  "install_guidance": {
    "plugin": "taskell",
    "binary": "taskell",
    "check": "which taskell",
    "install_steps": [
      "See https://github.com/smallhadroncollider/taskell",
      "Verify: taskell --version",
      "supercli plugins install ./plugins/taskell --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "taskell",
      "resource": "self",
      "action": "version",
      "description": "Print taskell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "taskell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install taskell: See https://github.com/smallhadroncollider/taskell"
      },
      "args": []
    },
    {
      "namespace": "taskell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to taskell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "taskell",
        "passthrough": true,
        "missingDependencyHelp": "Install taskell"
      },
      "args": []
    }
  ]
}