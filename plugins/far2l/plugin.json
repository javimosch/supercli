{
  "name": "far2l",
  "version": "0.1.0",
  "description": "Orthodox file manager clone with Linux and macOS support",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "far2l" }],
  "install_guidance": {
    "plugin": "far2l",
    "binary": "far2l",
    "check": "which far2l",
    "install_steps": ["sudo apt install far2l", "Verify: far2l --version", "supercli plugins install ./plugins/far2l --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "far2l",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to far2l CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "far2l",
      "passthrough": true,
      "missingDependencyHelp": "Install far2l: sudo apt install far2l"
    },
    "args": []
  }]
}
