{
  "name": "aptitude",
  "version": "0.1.0",
  "description": "CLI tool: aptitude",
  "source": "https://packages.debian.org/aptitude",
  "checks": [{ "type": "binary", "name": "aptitude" }],
  "install_guidance": {
    "plugin": "aptitude", "binary": "aptitude", "check": "which aptitude",
    "install_steps": ["apt-get install aptitude 2>/dev/null || which aptitude", "Verify: aptitude --version", "supercli plugins install ./plugins/aptitude --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aptitude", "resource": "_", "action": "_",
    "description": "Passthrough to aptitude CLI",
    "adapter": "process", "adapterConfig": { "command": "aptitude", "passthrough": true, "missingDependencyHelp": "Install aptitude: apt-get install aptitude" }, "args": []
  }]
}
