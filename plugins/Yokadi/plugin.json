{
  "name": "Yokadi",
  "version": "0.1.0",
  "description": "Project-based todo manager: every task must be specified with a mandatory project indication. Tasks are stored within a SQLlite DB. Written in Python.",
  "source": "https://github.com/agateau/yokadi",
  "checks": [
    {
      "type": "binary",
      "name": "Yokadi"
    }
  ],
  "install_guidance": {
    "plugin": "Yokadi",
    "binary": "Yokadi",
    "check": "which Yokadi",
    "install_steps": [
      "See https://github.com/agateau/yokadi",
      "Verify: Yokadi --version",
      "supercli plugins install ./plugins/Yokadi --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Yokadi",
      "resource": "self",
      "action": "version",
      "description": "Print Yokadi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Yokadi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Yokadi: See https://github.com/agateau/yokadi"
      },
      "args": []
    },
    {
      "namespace": "Yokadi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Yokadi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Yokadi",
        "passthrough": true,
        "missingDependencyHelp": "Install Yokadi"
      },
      "args": []
    }
  ]
}