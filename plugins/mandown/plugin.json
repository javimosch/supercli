{
  "name": "mandown",
  "version": "0.1.0",
  "description": "Man-page inspired Markdown viewer",
  "source": "https://github.com/Titor8115/mandown",
  "checks": [
    {
      "type": "binary",
      "name": "mandown"
    }
  ],
  "install_guidance": {
    "plugin": "mandown",
    "binary": "mandown",
    "check": "which mandown",
    "install_steps": [
      "brew install mandown",
      "Verify: mandown --version",
      "supercli plugins install ./plugins/mandown --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "mandown",
      "resource": "self",
      "action": "version",
      "description": "Print mandown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mandown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mandown: brew install mandown"
      },
      "args": []
    },
    {
      "namespace": "mandown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mandown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mandown",
        "passthrough": true,
        "missingDependencyHelp": "Install mandown"
      },
      "args": []
    }
  ]
}