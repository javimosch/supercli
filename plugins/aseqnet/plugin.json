{
  "name": "aseqnet",
  "version": "0.1.0",
  "description": "CLI tool: aseqnet",
  "source": "https://packages.debian.org/aseqnet",
  "checks": [{ "type": "binary", "name": "aseqnet" }],
  "install_guidance": {
    "plugin": "aseqnet", "binary": "aseqnet", "check": "which aseqnet",
    "install_steps": ["apt-get install aseqnet 2>/dev/null || which aseqnet", "Verify: aseqnet --version", "supercli plugins install ./plugins/aseqnet --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aseqnet", "resource": "_", "action": "_",
    "description": "Passthrough to aseqnet CLI",
    "adapter": "process", "adapterConfig": { "command": "aseqnet", "passthrough": true, "missingDependencyHelp": "Install aseqnet: apt-get install aseqnet" }, "args": []
  }]
}
