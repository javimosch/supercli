{
  "name": "pgmbentley",
  "version": "0.1.0",
  "description": "CLI tool: pgmbentley",
  "source": "https://manpages.debian.org/pgmbentley",
  "checks": [
    {
      "type": "binary",
      "name": "pgmbentley"
    }
  ],
  "install_guidance": {
    "plugin": "pgmbentley",
    "binary": "pgmbentley",
    "check": "which pgmbentley",
    "install_steps": [
      "apt-get install pgmbentley 2>/dev/null || which pgmbentley",
      "Verify: pgmbentley --version",
      "supercli plugins install ./plugins/pgmbentley --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgmbentley",
      "resource": "self",
      "action": "version",
      "description": "Print pgmbentley version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmbentley",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgmbentley: apt-get install pgmbentley 2>/dev/null || which pgmbentley"
      },
      "args": []
    },
    {
      "namespace": "pgmbentley",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgmbentley CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmbentley",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pgmbentley: apt-get install pgmbentley 2>/dev/null || which pgmbentley"
      },
      "args": []
    }
  ]
}