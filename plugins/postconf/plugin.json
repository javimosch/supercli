{
  "name": "postconf",
  "version": "1.0.0",
  "description": "postconf \u2014 postconf \u2014 CLI utility",
  "source": "/usr/sbin/postconf",
  "checks": [
    {
      "type": "binary",
      "name": "postconf"
    }
  ],
  "install_guidance": {
    "plugin": "postconf",
    "binary": "postconf",
    "check": "which postconf",
    "install_steps": [
      "# Install postconf:",
      "# apt: sudo apt-get install postconf",
      "# brew: brew install postconf",
      "# cargo: cargo install postconf",
      "# npm: npm install -g postconf",
      "# pip: pip install postconf",
      "# or download from /usr/sbin/postconf"
    ]
  },
  "commands": [
    {
      "namespace": "postconf",
      "resource": "postconf",
      "action": "run",
      "description": "Run postconf",
      "adapter": "process",
      "adapterConfig": {
        "command": "postconf",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postconf from /usr/sbin/postconf"
      },
      "args": []
    }
  ]
}