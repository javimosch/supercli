{
  "plugin": "postconf",
  "binary": "postconf",
  "check": "which postconf",
  "install_steps": [
    "# Install postconf",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/postconf-linux-amd64 -o /usr/local/bin/postconf",
    "chmod +x /usr/local/bin/postconf",
    "# Or via package manager, see /usr/sbin/postconf"
  ]
}