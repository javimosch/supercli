{
  "name": "dbx",
  "version": "0.1.0",
  "description": "Fast database client for MySQL, PostgreSQL, and SQLite",
  "source": "https://github.com/nicholasgasior/dbx",
  "checks": [
    {
      "type": "binary",
      "name": "dbx"
    }
  ],
  "install_guidance": {
    "plugin": "dbx",
    "binary": "dbx",
    "check": "which dbx",
    "install_steps": [
      "cargo install dbx",
      "Verify: dbx --version",
      "supercli plugins install ./plugins/dbx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dbx",
      "resource": "self",
      "action": "version",
      "description": "Print dbx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dbx: cargo install dbx"
      },
      "args": []
    },
    {
      "namespace": "dbx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dbx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbx",
        "passthrough": true,
        "missingDependencyHelp": "Install dbx: cargo install dbx"
      },
      "args": []
    }
  ]
}
