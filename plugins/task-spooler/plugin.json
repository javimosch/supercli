{
  "name": "task-spooler",
  "version": "0.1.0",
  "description": "Queue jobs for linear execution",
  "checks": [
    {
      "type": "binary",
      "name": "task-spooler"
    }
  ],
  "install_guidance": {
    "plugin": "task-spooler",
    "binary": "task-spooler",
    "check": "which task-spooler",
    "install_steps": [
      "brew install task-spooler",
      "Verify: task-spooler --version",
      "supercli plugins install ./plugins/task-spooler --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "task-spooler",
      "resource": "self",
      "action": "version",
      "description": "Print task-spooler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "task-spooler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install task-spooler: brew install task-spooler"
      },
      "args": []
    },
    {
      "namespace": "task-spooler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to task-spooler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "task-spooler",
        "passthrough": true,
        "missingDependencyHelp": "Install task-spooler"
      },
      "args": []
    }
  ]
}