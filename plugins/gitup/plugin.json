{
  "name": "gitup",
  "version": "0.1.0",
  "description": "Update multiple git repositories at once",
  "source": "https://github.com/earwig/git-repo-updater",
  "checks": [
    {
      "type": "binary",
      "name": "gitup"
    }
  ],
  "install_guidance": {
    "plugin": "gitup",
    "binary": "gitup",
    "check": "which gitup",
    "install_steps": [
      "brew install gitup",
      "Verify: gitup --version",
      "supercli plugins install ./plugins/gitup --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitup",
      "resource": "self",
      "action": "version",
      "description": "Print gitup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitup: brew install gitup"
      },
      "args": []
    },
    {
      "namespace": "gitup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitup",
        "passthrough": true,
        "missingDependencyHelp": "Install gitup"
      },
      "args": []
    }
  ]
}