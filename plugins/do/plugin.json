{
  "name": "do",
  "version": "0.1.0",
  "description": "Tiny wrapper for organizing bash tasks in a folder",
  "source": "go",
  "checks": [{ "type": "binary", "name": "do" }],
  "install_guidance": {
    "plugin": "do",
    "binary": "do",
    "check": "which do",
    "install_steps": ["go install github.com/do@latest", "Verify: do --version", "supercli plugins install ./plugins/do --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "do",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to do CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "do",
      "passthrough": true,
      "missingDependencyHelp": "Install do: go install github.com/do@latest"
    },
    "args": []
  }]
}
