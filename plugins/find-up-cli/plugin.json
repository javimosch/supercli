{
  "name": "find-up-cli",
  "version": "0.1.0",
  "description": "Find a file by walking up parent directories",
  "source": "https://github.com/sindresorhus/find-up-cli",
  "checks": [
    {
      "type": "binary",
      "name": "find-up-cli"
    }
  ],
  "install_guidance": {
    "plugin": "find-up-cli",
    "binary": "find-up-cli",
    "check": "which find-up-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/find-up-cli",
      "Verify: find-up-cli --version",
      "supercli plugins install ./plugins/find-up-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "find-up-cli",
      "resource": "self",
      "action": "version",
      "description": "Print find-up-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "find-up-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install find-up-cli: See https://github.com/sindresorhus/find-up-cli"
      },
      "args": []
    },
    {
      "namespace": "find-up-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to find-up-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "find-up-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install find-up-cli"
      },
      "args": []
    }
  ]
}