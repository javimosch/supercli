{
  "name": "dh_installinit",
  "version": "0.1.0",
  "description": "CLI tool: dh_installinit",
  "source": "https://packages.debian.org/dh_installinit",
  "checks": [{ "type": "binary", "name": "dh_installinit" }],
  "install_guidance": {
    "plugin": "dh_installinit", "binary": "dh_installinit", "check": "which dh_installinit",
    "install_steps": ["apt-get install dh_installinit 2>/dev/null || which dh_installinit", "Verify: dh_installinit --version", "supercli plugins install ./plugins/dh_installinit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_installinit", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installinit CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installinit", "passthrough": true, "missingDependencyHelp": "Install dh_installinit: apt-get install dh_installinit" }, "args": []
  }]
}
