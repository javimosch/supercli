{
  "name": "CLIProxyAPI",
  "version": "0.1.0",
  "description": "Wrap Gemini CLI, Antigravity, ChatGPT Codex, Claude Code, Grok Build as an OpenAI/Gemini/Claude/Code",
  "source": "https://github.com/CLIProxyAPI/CLIProxyAPI",
  "checks": [
    {
      "type": "binary",
      "name": "cliproxyapi"
    }
  ],
  "install_guidance": {
    "plugin": "CLIProxyAPI",
    "binary": "cliproxyapi",
    "check": "which cliproxyapi",
    "install_steps": [
      "pip install cliproxyapi",
      "Verify: cliproxyapi --version",
      "supercli plugins install ./plugins/CLIProxyAPI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CLIProxyAPI",
      "resource": "self",
      "action": "version",
      "description": "Print CLIProxyAPI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cliproxyapi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CLIProxyAPI: pip install cliproxyapi"
      },
      "args": []
    },
    {
      "namespace": "CLIProxyAPI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cliproxyapi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cliproxyapi",
        "passthrough": true,
        "missingDependencyHelp": "Install CLIProxyAPI: pip install cliproxyapi"
      },
      "args": []
    }
  ]
}