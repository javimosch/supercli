{
  "name": "stride",
  "version": "1.0.0",
  "description": "High-performance filesystem traversal and search tool with JSON output support",
  "commands": [
    {
      "name": "walk",
      "description": "Traverse directory with JSON output",
      "binary": "stride",
      "args": ["{{.path}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "walk-workers",
      "description": "Traverse directory with custom worker count",
      "binary": "stride",
      "args": ["{{.path}}", "--format=json", "--workers={{.workers}}"],
      "output_format": "json"
    },
    {
      "name": "find-name",
      "description": "Find files by name pattern with JSON output",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--name={{.pattern}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "find-regex",
      "description": "Find files by regex pattern with JSON output",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--regex={{.pattern}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "find-large",
      "description": "Find files larger than specified size",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--larger-than={{.size}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "find-small",
      "description": "Find files smaller than specified size",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--smaller-than={{.size}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "find-recent",
      "description": "Find files modified recently",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--newer-than={{.time}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "find-old",
      "description": "Find files older than specified time",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--older-than={{.time}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "find-depth",
      "description": "Find files with maximum depth limit",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--max-depth={{.depth}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "find-permissions",
      "description": "Find files by exact permissions",
      "binary": "stride",
      "args": ["find", "{{.path}}", "--exact-permissions={{.perms}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "watch",
      "description": "Watch directory for changes with JSON output",
      "binary": "stride",
      "args": ["watch", "{{.path}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "watch-pattern",
      "description": "Watch for specific file patterns",
      "binary": "stride",
      "args": ["watch", "{{.path}}", "--pattern={{.pattern}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "watch-events",
      "description": "Watch for specific event types",
      "binary": "stride",
      "args": ["watch", "{{.path}}", "--events={{.events}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "analyze",
      "description": "Analyze directory structure with JSON output",
      "binary": "stride",
      "args": ["analyze", "{{.path}}", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "analyze-duplicates",
      "description": "Find duplicate files with JSON output",
      "binary": "stride",
      "args": ["analyze", "{{.path}}", "--duplicates", "--format=json"],
      "output_format": "json"
    },
    {
      "name": "analyze-code",
      "description": "Analyze code statistics with JSON output",
      "binary": "stride",
      "args": ["analyze", "{{.path}}", "--code-stats", "--languages={{.langs}}", "--format=json"],
      "output_format": "json"
    }
  ]
}