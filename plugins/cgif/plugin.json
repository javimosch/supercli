{
  "name": "cgif",
  "version": "0.1.0",
  "description": "GIF encoder written in C",
  "source": "https://github.com/dloebl/cgif",
  "checks": [
    {
      "type": "binary",
      "name": "cgif"
    }
  ],
  "install_guidance": {
    "plugin": "cgif",
    "binary": "cgif",
    "check": "which cgif",
    "install_steps": [
      "brew install cgif",
      "Verify: cgif --version",
      "supercli plugins install ./plugins/cgif --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cgif",
      "resource": "self",
      "action": "version",
      "description": "Print cgif version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cgif",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cgif: brew install cgif"
      },
      "args": []
    },
    {
      "namespace": "cgif",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cgif CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cgif",
        "passthrough": true,
        "missingDependencyHelp": "Install cgif"
      },
      "args": []
    }
  ]
}