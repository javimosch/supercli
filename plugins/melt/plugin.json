{
  "name": "melt",
  "version": "0.1.0",
  "description": "Backup and restore SSH keys and ed25519 keypairs",
  "source": "https://github.com/charmbracelet/melt",
  "checks": [{ "type": "binary", "name": "melt" }],
  "install_guidance": {
    "plugin": "melt",
    "binary": "melt",
    "check": "which melt",
    "install_steps": ["brew install melt", "Verify: melt --version", "supercli plugins install ./plugins/melt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "melt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to melt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "melt",
      "passthrough": true,
      "missingDependencyHelp": "Install melt: brew install melt"
    },
    "args": []
  }]
}
