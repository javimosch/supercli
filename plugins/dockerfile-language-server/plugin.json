{
  "name": "dockerfile-language-server",
  "version": "0.1.0",
  "description": "Language server for Dockerfiles powered by Node, TypeScript, and VSCode",
  "source": "https://github.com/rcjsuen/dockerfile-language-server",
  "checks": [
    {
      "type": "binary",
      "name": "dockerfile-language-server"
    }
  ],
  "install_guidance": {
    "plugin": "dockerfile-language-server",
    "binary": "dockerfile-language-server",
    "check": "which dockerfile-language-server",
    "install_steps": [
      "brew install dockerfile-language-server",
      "Verify: dockerfile-language-server --version",
      "supercli plugins install ./plugins/dockerfile-language-server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dockerfile-language-server",
      "resource": "self",
      "action": "version",
      "description": "Print dockerfile-language-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockerfile-language-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dockerfile-language-server: brew install dockerfile-language-server"
      },
      "args": []
    },
    {
      "namespace": "dockerfile-language-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dockerfile-language-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockerfile-language-server",
        "passthrough": true,
        "missingDependencyHelp": "Install dockerfile-language-server"
      },
      "args": []
    }
  ]
}