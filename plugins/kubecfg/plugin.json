{
  "name": "kubecfg",
  "version": "0.1.0",
  "description": "Manage complex enterprise Kubernetes environments as code",
  "source": "https://github.com/kubecfg/kubecfg",
  "checks": [
    {
      "type": "binary",
      "name": "kubecfg"
    }
  ],
  "install_guidance": {
    "plugin": "kubecfg",
    "binary": "kubecfg",
    "check": "which kubecfg",
    "install_steps": [
      "brew install kubecfg",
      "Verify: kubecfg --version",
      "supercli plugins install ./plugins/kubecfg --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kubecfg",
      "resource": "self",
      "action": "version",
      "description": "Print kubecfg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubecfg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kubecfg: brew install kubecfg"
      },
      "args": []
    },
    {
      "namespace": "kubecfg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kubecfg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubecfg",
        "passthrough": true,
        "missingDependencyHelp": "Install kubecfg"
      },
      "args": []
    }
  ]
}