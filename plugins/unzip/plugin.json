{
  "name": "unzip",
  "version": "0.1.0",
  "description": "File extraction utility for zip archives",
  "source": "https",
  "checks": [{"type": "binary", "name": "unzip"}],
  "install_guidance": {
    "plugin": "unzip",
    "binary": "unzip",
    "check": "which unzip",
    "install_steps": [
      "brew install unzip",
      "Verify: unzip --version",
      "supercli plugins install ./plugins/unzip --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "unzip",
      "resource": "self",
      "action": "version",
      "description": "Print unzip version",
      "adapter": "process",
      "adapterConfig": {"command": "unzip", "baseArgs": ["--version"], "missingDependencyHelp": "Install unzip: brew install unzip"},
      "args": []
    },
    {
      "namespace": "unzip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unzip CLI",
      "adapter": "process",
      "adapterConfig": {"command": "unzip", "passthrough": true, "missingDependencyHelp": "Install unzip: brew install unzip"},
      "args": []
    }
  ]
}
