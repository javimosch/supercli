{
  "name": "md4w",
  "version": "0.1.0",
  "description": "A Markdown renderer written in Zig & C, compiled to WebAssymbly.",
  "source": "https://github.com/md4w/md4w",
  "checks": [
    {
      "type": "binary",
      "name": "md4w"
    }
  ],
  "install_guidance": {
    "plugin": "md4w",
    "binary": "md4w",
    "check": "which md4w",
    "install_steps": [
      "pip install md4w",
      "Verify: md4w --version",
      "supercli plugins install ./plugins/md4w --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "md4w",
      "resource": "self",
      "action": "version",
      "description": "Print md4w version",
      "adapter": "process",
      "adapterConfig": {
        "command": "md4w",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install md4w: pip install md4w"
      },
      "args": []
    },
    {
      "namespace": "md4w",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to md4w CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "md4w",
        "passthrough": true,
        "missingDependencyHelp": "Install md4w: pip install md4w"
      },
      "args": []
    }
  ]
}