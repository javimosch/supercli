{
  "name": "alias",
  "version": "0.1.0",
  "description": "CLI tool: alias",
  "source": "https://packages.debian.org/alias",
  "checks": [{ "type": "binary", "name": "alias" }],
  "install_guidance": {
    "plugin": "alias", "binary": "alias", "check": "which alias",
    "install_steps": ["apt-get install alias 2>/dev/null || which alias", "Verify: alias --version", "supercli plugins install ./plugins/alias --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "alias", "resource": "_", "action": "_",
    "description": "Passthrough to alias CLI",
    "adapter": "process", "adapterConfig": { "command": "alias", "passthrough": true, "missingDependencyHelp": "Install alias: apt-get install alias" }, "args": []
  }]
}
