{
  "name": "ps2txt",
  "version": "0.1.0",
  "description": "CLI tool: ps2txt",
  "source": "https://manpages.debian.org/ps2txt",
  "checks": [
    {
      "type": "binary",
      "name": "ps2txt"
    }
  ],
  "install_guidance": {
    "plugin": "ps2txt",
    "binary": "ps2txt",
    "check": "which ps2txt",
    "install_steps": [
      "apt-get install ps2txt 2>/dev/null || which ps2txt",
      "Verify: ps2txt --version",
      "supercli plugins install ./plugins/ps2txt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ps2txt",
      "resource": "self",
      "action": "version",
      "description": "Print ps2txt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps2txt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ps2txt: apt-get install ps2txt 2>/dev/null || which ps2txt"
      },
      "args": []
    },
    {
      "namespace": "ps2txt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ps2txt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps2txt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ps2txt: apt-get install ps2txt 2>/dev/null || which ps2txt"
      },
      "args": []
    }
  ]
}