{
  "name": "conrad",
  "version": "0.1.0",
  "description": "Track conferences and meetups.",
  "source": "https://github.com/vinayak-mehta/conrad",
  "checks": [
    {
      "type": "binary",
      "name": "conrad"
    }
  ],
  "install_guidance": {
    "plugin": "conrad",
    "binary": "conrad",
    "check": "which conrad",
    "install_steps": [
      "See https://github.com/vinayak-mehta/conrad",
      "Verify: conrad --version",
      "supercli plugins install ./plugins/conrad --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "conrad",
      "resource": "self",
      "action": "version",
      "description": "Print conrad version",
      "adapter": "process",
      "adapterConfig": {
        "command": "conrad",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install conrad: See https://github.com/vinayak-mehta/conrad"
      },
      "args": []
    },
    {
      "namespace": "conrad",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to conrad CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "conrad",
        "passthrough": true,
        "missingDependencyHelp": "Install conrad"
      },
      "args": []
    }
  ]
}