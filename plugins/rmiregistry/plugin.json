{
  "name": "rmiregistry",
  "version": "0.1.0",
  "description": "rmiregistry \u2014 create and start a remote object registry on the specified port on the current host",
  "source": "https://manpages.debian.org/rmiregistry",
  "checks": [
    {
      "type": "binary",
      "name": "rmiregistry"
    }
  ],
  "install_guidance": {
    "plugin": "rmiregistry",
    "binary": "rmiregistry",
    "check": "which rmiregistry",
    "install_steps": [
      "apt-get install rmiregistry 2>/dev/null || which rmiregistry",
      "Verify: rmiregistry --version",
      "supercli plugins install ./plugins/rmiregistry --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rmiregistry",
      "resource": "self",
      "action": "version",
      "description": "Print rmiregistry version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rmiregistry",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rmiregistry: apt-get install rmiregistry 2>/dev/null || which rmiregistry"
      },
      "args": []
    },
    {
      "namespace": "rmiregistry",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rmiregistry CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rmiregistry",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rmiregistry: apt-get install rmiregistry 2>/dev/null || which rmiregistry"
      },
      "args": []
    }
  ]
}