{
  "name": "pythonfinder",
  "version": "0.1.0",
  "description": "Find Python installations on the system",
  "source": "https://github.com/sarugaku/pythonfinder",
  "checks": [{ "type": "binary", "name": "pythonfinder" }],
  "install_guidance": {
    "plugin": "pythonfinder",
    "binary": "pythonfinder",
    "check": "which pythonfinder",
    "install_steps": ["pip install pythonfinder", "Verify: pythonfinder --version", "supercli plugins install ./plugins/pythonfinder --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pythonfinder",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pythonfinder CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pythonfinder",
      "passthrough": true,
      "missingDependencyHelp": "Install pythonfinder: pip install pythonfinder", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
