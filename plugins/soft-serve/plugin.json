{
  "name": "soft-serve",
  "version": "0.1.0",
  "description": "Self-hostable Git server for the command line",
  "source": "https://github.com/charmbracelet/soft-serve",
  "checks": [{ "type": "binary", "name": "soft-serve" }],
  "install_guidance": {
    "plugin": "soft-serve",
    "binary": "soft-serve",
    "check": "which soft-serve",
    "install_steps": ["brew install soft-serve", "Verify: soft-serve --version", "supercli plugins install ./plugins/soft-serve --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "soft-serve",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to soft-serve CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "soft-serve",
      "passthrough": true,
      "missingDependencyHelp": "Install soft-serve: brew install soft-serve"
    },
    "args": []
  }]
}
