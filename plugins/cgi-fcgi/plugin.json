{
  "name": "cgi-fcgi",
  "version": "0.1.0",
  "description": "CLI tool: cgi-fcgi",
  "source": "https://packages.debian.org/cgi-fcgi",
  "checks": [{ "type": "binary", "name": "cgi-fcgi" }],
  "install_guidance": {
    "plugin": "cgi-fcgi", "binary": "cgi-fcgi", "check": "which cgi-fcgi",
    "install_steps": ["apt-get install cgi-fcgi 2>/dev/null || which cgi-fcgi", "Verify: cgi-fcgi --version", "supercli plugins install ./plugins/cgi-fcgi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cgi-fcgi", "resource": "_", "action": "_",
    "description": "Passthrough to cgi-fcgi CLI",
    "adapter": "process", "adapterConfig": { "command": "cgi-fcgi", "passthrough": true, "missingDependencyHelp": "Install cgi-fcgi: apt-get install cgi-fcgi" }, "args": []
  }]
}
