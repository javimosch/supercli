{
  "name": "phar",
  "version": "0.1.0",
  "description": "CLI tool: phar",
  "source": "https://manpages.debian.org/phar",
  "checks": [
    {
      "type": "binary",
      "name": "phar"
    }
  ],
  "install_guidance": {
    "plugin": "phar",
    "binary": "phar",
    "check": "which phar",
    "install_steps": [
      "apt-get install phar 2>/dev/null || which phar",
      "Verify: phar --version",
      "supercli plugins install ./plugins/phar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "phar",
      "resource": "self",
      "action": "version",
      "description": "Print phar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "phar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install phar: apt-get install phar 2>/dev/null || which phar"
      },
      "args": []
    },
    {
      "namespace": "phar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to phar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "phar",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install phar: apt-get install phar 2>/dev/null || which phar"
      },
      "args": []
    }
  ]
}