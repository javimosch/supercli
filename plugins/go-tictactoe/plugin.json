{
  "name": "go-tictactoe",
  "version": "0.1.0",
  "description": "Simple terminal tic-tac-toe game in Go",
  "source": "https://github.com/bndr/go-tictactoe",
  "checks": [{ "type": "binary", "name": "go-tictactoe" }],
  "install_guidance": {
    "plugin": "go-tictactoe",
    "binary": "go-tictactoe",
    "check": "which go-tictactoe",
    "install_steps": ["go install github.com/bndr/go-tictactoe@latest", "Verify: go-tictactoe --version", "supercli plugins install ./plugins/go-tictactoe --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "go-tictactoe",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to go-tictactoe CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-tictactoe",
      "passthrough": true,
      "missingDependencyHelp": "Install go-tictactoe: go install github.com/bndr/go-tictactoe@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
