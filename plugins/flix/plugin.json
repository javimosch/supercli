{
  "name": "flix",
  "version": "1.0.0",
  "description": "flix \u2014 Flix language",
  "source": "flix.dev",
  "checks": [
    {
      "type": "binary",
      "name": "flix"
    }
  ],
  "install_guidance": {
    "plugin": "flix",
    "binary": "flix",
    "check": "which flix",
    "install_steps": [
      "# Install flix",
      "# See flix.dev",
      "# apt: sudo apt-get install flix",
      "# brew: brew install flix",
      "# cargo: cargo install flix",
      "# npm: npm install -g flix",
      "# pip: pip install flix"
    ]
  },
  "commands": [
    {
      "namespace": "flix",
      "resource": "flix",
      "action": "run",
      "description": "Run flix",
      "adapter": "process",
      "adapterConfig": {
        "command": "flix",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install flix from flix.dev"
      },
      "args": []
    }
  ]
}