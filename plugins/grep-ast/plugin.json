{
  "name": "grep-ast",
  "version": "0.1.0",
  "description": "CLI tool: grep-ast",
  "source": "https://manpages.debian.org/grep-ast",
  "checks": [
    {
      "type": "binary",
      "name": "grep-ast"
    }
  ],
  "install_guidance": {
    "plugin": "grep-ast",
    "binary": "grep-ast",
    "check": "which grep-ast",
    "install_steps": [
      "apt-get install grep-ast 2>/dev/null || which grep-ast",
      "Verify: grep-ast --version",
      "supercli plugins install ./plugins/grep-ast --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grep-ast",
      "resource": "self",
      "action": "version",
      "description": "Print grep-ast version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grep-ast",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grep-ast: apt-get install grep-ast 2>/dev/null || which grep-ast"
      },
      "args": []
    },
    {
      "namespace": "grep-ast",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grep-ast CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grep-ast",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install grep-ast: apt-get install grep-ast 2>/dev/null || which grep-ast"
      },
      "args": []
    }
  ]
}