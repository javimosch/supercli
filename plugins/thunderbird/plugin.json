      "resource": "self",
      "action": "version",
      "description": "Print thunderbird version",
      "adapter": "process",
      "adapterConfig": {
        "command": "thunderbird",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install thunderbird: apt-get install thunderbird 2>/dev/null || which thunderbird"
      },
      "args": []
    },
    {
      "namespace": "thunderbird",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to thunderbird CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "thunderbird",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install thunderbird: apt-get install thunderbird 2>/dev/null || which thunderbird"
      },
      "args": []
    }
  ]
