{
  "plugin": "bunx",
  "binary": "bunx",
  "check": "which bunx",
  "install_steps": [
    "brew install oven-sh/bun/bun",
    "Verify: bunx --version",
    "supercli plugins install ./plugins/bunx --on-conflict replace --json"
  ],
  "note": "bunx is bundled with Bun runtime. Also available via curl -fsSL https://bun.sh/install | bash."
}
