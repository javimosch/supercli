{
  "name": "bunx",
  "version": "0.1.0",
  "description": "bunx — Bun's fast npm package runner for executing packages without installation",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "bunx"
    }
  ],
  "install_guidance": {
    "plugin": "bunx",
    "binary": "bunx",
    "check": "which bunx",
    "install_steps": [
      "brew install oven-sh/bun/bun"
    ],
    "note": "Development tool. bunx is bundled with Bun runtime."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bunx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bunx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bunx",
        "passthrough": true,
        "missingDependencyHelp": "Install bun: brew install oven-sh/bun/bun"
      },
      "args": []
    }
  ]
}
