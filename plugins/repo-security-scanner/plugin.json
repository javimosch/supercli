{
  "name": "repo-security-scanner",
  "version": "0.1.0",
  "description": "Find secrets in git repos in Go",
  "source": "https://github.com/UKHomeOffice/repo-security-scanner",
  "checks": [{"type": "binary", "name": "repo-security-scanner"}],
  "install_guidance": {
    "plugin": "repo-security-scanner",
    "binary": "repo-security-scanner",
    "check": "which repo-security-scanner",
    "install_steps": [
      "go install github.com/UKHomeOffice/repo-security-scanner@latest",
      "Verify: repo-security-scanner --version",
      "supercli plugins install ./repo-security-scanner --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "repo-security-scanner",
      "resource": "self",
      "action": "version",
      "description": "Print repo-security-scanner version",
      "adapter": "process",
      "adapterConfig": {"command": "repo-security-scanner", "baseArgs": ["--version"], "missingDependencyHelp": "Install repo-security-scanner: go install github.com/UKHomeOffice/repo-security-scanner@latest"},
      "args": []
    },
    {
      "namespace": "repo-security-scanner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to repo-security-scanner CLI",
      "adapter": "process",
      "adapterConfig": {"command": "repo-security-scanner", "passthrough": true, "missingDependencyHelp": "Install repo-security-scanner: go install github.com/UKHomeOffice/repo-security-scanner@latest"},
      "args": []
    }
  ]
}
