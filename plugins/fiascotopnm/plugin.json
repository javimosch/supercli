{
  "name": "fiascotopnm",
  "version": "0.1.0",
  "description": "CLI tool: fiascotopnm",
  "source": "https://manpages.debian.org/fiascotopnm",
  "checks": [
    {
      "type": "binary",
      "name": "fiascotopnm"
    }
  ],
  "install_guidance": {
    "plugin": "fiascotopnm",
    "binary": "fiascotopnm",
    "check": "which fiascotopnm",
    "install_steps": [
      "apt-get install fiascotopnm 2>/dev/null || which fiascotopnm",
      "Verify: fiascotopnm --version",
      "supercli plugins install ./plugins/fiascotopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fiascotopnm",
      "resource": "self",
      "action": "version",
      "description": "Print fiascotopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fiascotopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fiascotopnm: apt-get install fiascotopnm 2>/dev/null || which fiascotopnm"
      },
      "args": []
    },
    {
      "namespace": "fiascotopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fiascotopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fiascotopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fiascotopnm: apt-get install fiascotopnm 2>/dev/null || which fiascotopnm"
      },
      "args": []
    }
  ]
}