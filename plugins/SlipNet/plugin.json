{
  "name": "SlipNet",
  "version": "0.1.0",
  "description": "Android VPN client with DNS tunneling (DNSTT, NoizDNS & Slipstream), NaiveProxy, SSH, Tor, and DoH s",
  "source": "https://github.com/SlipNet/SlipNet",
  "checks": [
    {
      "type": "binary",
      "name": "slipnet"
    }
  ],
  "install_guidance": {
    "plugin": "SlipNet",
    "binary": "slipnet",
    "check": "which slipnet",
    "install_steps": [
      "pip install slipnet",
      "Verify: slipnet --version",
      "supercli plugins install ./plugins/SlipNet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SlipNet",
      "resource": "self",
      "action": "version",
      "description": "Print SlipNet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "slipnet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SlipNet: pip install slipnet"
      },
      "args": []
    },
    {
      "namespace": "SlipNet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to slipnet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "slipnet",
        "passthrough": true,
        "missingDependencyHelp": "Install SlipNet: pip install slipnet"
      },
      "args": []
    }
  ]
}