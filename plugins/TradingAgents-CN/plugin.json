{
  "name": "TradingAgents-CN",
  "version": "0.1.0",
  "description": "\u57fa\u4e8e\u591a\u667a\u80fd\u4f53LLM\u7684\u4e2d\u6587\u91d1\u878d\u4ea4\u6613\u6846\u67b6 - TradingAgents\u4e2d\u6587\u589e\u5f3a\u7248",
  "source": "https://github.com/TradingAgents-CN/TradingAgents-CN",
  "checks": [
    {
      "type": "binary",
      "name": "tradingagents-cn"
    }
  ],
  "install_guidance": {
    "plugin": "TradingAgents-CN",
    "binary": "tradingagents-cn",
    "check": "which tradingagents-cn",
    "install_steps": [
      "pip install tradingagents-cn",
      "Verify: tradingagents-cn --version",
      "supercli plugins install ./plugins/TradingAgents-CN --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TradingAgents-CN",
      "resource": "self",
      "action": "version",
      "description": "Print TradingAgents-CN version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tradingagents-cn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TradingAgents-CN: pip install tradingagents-cn"
      },
      "args": []
    },
    {
      "namespace": "TradingAgents-CN",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tradingagents-cn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tradingagents-cn",
        "passthrough": true,
        "missingDependencyHelp": "Install TradingAgents-CN: pip install tradingagents-cn"
      },
      "args": []
    }
  ]
}