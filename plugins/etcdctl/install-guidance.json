{
  "plugin": "etcdctl",
  "binary": "etcdctl",
  "check": "which etcdctl",
  "install_steps": [
    "# Install etcdctl",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/etcdctl-linux-amd64 -o /usr/local/bin/etcdctl",
    "chmod +x /usr/local/bin/etcdctl",
    "# Or via package manager, see etcd.io"
  ]
}