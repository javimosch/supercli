{
  "name": "etcdctl",
  "version": "1.0.0",
  "description": "etcdctl — etcd CLI client",
  "source": "https://etcd.io",
  "checks": [
    {
      "type": "binary",
      "name": "etcdctl"
    }
  ],
  "install_guidance": {
    "plugin": "etcdctl",
    "binary": "etcdctl",
    "check": "which etcdctl",
    "install_steps": [
      "# Install etcdctl:",
      "# apt: sudo apt-get install etcdctl",
      "# brew: brew install etcdctl",
      "# cargo: cargo install etcdctl",
      "# npm: npm install -g etcdctl",
      "# pip: pip install etcdctl",
      "# or download from etcd.io"
    ]
  },
  "commands": [
    {
      "namespace": "etcdctl",
      "resource": "etcdctl",
      "action": "run",
      "description": "Run etcdctl",
      "adapter": "process",
      "adapterConfig": {
        "command": "etcdctl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install etcdctl from etcd.io"
      },
      "args": []
    }
  ]
}
