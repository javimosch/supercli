{
  "name": "sgitopnm",
  "version": "0.1.0",
  "description": "CLI tool: sgitopnm",
  "source": "https://manpages.debian.org/sgitopnm",
  "checks": [
    {
      "type": "binary",
      "name": "sgitopnm"
    }
  ],
  "install_guidance": {
    "plugin": "sgitopnm",
    "binary": "sgitopnm",
    "check": "which sgitopnm",
    "install_steps": [
      "apt-get install sgitopnm 2>/dev/null || which sgitopnm",
      "Verify: sgitopnm --version",
      "supercli plugins install ./plugins/sgitopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sgitopnm",
      "resource": "self",
      "action": "version",
      "description": "Print sgitopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sgitopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sgitopnm: apt-get install sgitopnm 2>/dev/null || which sgitopnm"
      },
      "args": []
    },
    {
      "namespace": "sgitopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sgitopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sgitopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sgitopnm: apt-get install sgitopnm 2>/dev/null || which sgitopnm"
      },
      "args": []
    }
  ]
}