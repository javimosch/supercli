{
  "plugin": "pipectl",
  "binary": "pipectl",
  "check": "which pipectl",
  "install_steps": [
    "go install github.com/pipectl/pipectl/cmd/pipectl@latest",
    "Verify: pipectl --version",
    "supercli plugins install ./plugins/pipectl --on-conflict replace --json"
  ],
  "note": "Requires Go toolchain installed. Single binary with no runtime dependencies."
}
