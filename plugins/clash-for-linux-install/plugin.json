{
  "name": "clash-for-linux-install",
  "version": "0.1.0",
  "description": "\ud83d\ude3c \u4f18\u96c5\u5730\u4f7f\u7528\u57fa\u4e8e clash/mihomo \u7684\u4ee3\u7406\u73af\u5883",
  "source": "https://github.com/clash-for-linux-install/clash-for-linux-install",
  "checks": [
    {
      "type": "binary",
      "name": "clash-for-linux-install"
    }
  ],
  "install_guidance": {
    "plugin": "clash-for-linux-install",
    "binary": "clash-for-linux-install",
    "check": "which clash-for-linux-install",
    "install_steps": [
      "pip install clash-for-linux-install",
      "Verify: clash-for-linux-install --version",
      "supercli plugins install ./plugins/clash-for-linux-install --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clash-for-linux-install",
      "resource": "self",
      "action": "version",
      "description": "Print clash-for-linux-install version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clash-for-linux-install",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clash-for-linux-install: pip install clash-for-linux-install"
      },
      "args": []
    },
    {
      "namespace": "clash-for-linux-install",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clash-for-linux-install CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clash-for-linux-install",
        "passthrough": true,
        "missingDependencyHelp": "Install clash-for-linux-install: pip install clash-for-linux-install"
      },
      "args": []
    }
  ]
}