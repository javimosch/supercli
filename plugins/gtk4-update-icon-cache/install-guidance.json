{
  "plugin": "gtk4-update-icon-cache",
  "binary": "gtk4-update-icon-cache",
  "check": "which gtk4-update-icon-cache",
  "install_steps": [
    "apt-get install gtk4-update-icon-cache 2>/dev/null || which gtk4-update-icon-cache",
