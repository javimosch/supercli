{
  "name": "remindee-bot",
  "version": "0.1.0",
  "description": "A Telegram reminder bot CLI for scheduling notifications. Creates and manages timed reminders sent via Telegram with structured configuration.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "remindee-bot"
    }
  ],
  "install_guidance": {
    "plugin": "remindee-bot",
    "binary": "remindee-bot",
    "check": "which remindee-bot",
    "install_steps": [
      "cargo install remindee-bot",
      "Verify: remindee-bot --version",
      "supercli plugins install ./plugins/remindee-bot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "remindee-bot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to remindee-bot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "remindee-bot",
        "passthrough": true,
        "missingDependencyHelp": "Install remindee-bot: cargo install remindee-bot"
      },
      "args": []
    }
  ]
}
