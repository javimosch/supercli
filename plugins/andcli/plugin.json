{
  "name": "andcli",
  "version": "0.1.0",
  "description": "Work with 2FA tokens from multiple OTP providers",
  "source": "https://github.com/tjblackheart/andcli",
  "checks": [
    {
      "type": "binary",
      "name": "andcli"
    }
  ],
  "install_guidance": {
    "plugin": "andcli",
    "binary": "andcli",
    "check": "which andcli",
    "install_steps": [
      "See https://github.com/tjblackheart/andcli",
      "Verify: andcli --version",
      "supercli plugins install ./plugins/andcli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "andcli",
      "resource": "self",
      "action": "version",
      "description": "Print andcli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "andcli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install andcli: See https://github.com/tjblackheart/andcli"
      },
      "args": []
    },
    {
      "namespace": "andcli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to andcli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "andcli",
        "passthrough": true,
        "missingDependencyHelp": "Install andcli"
      },
      "args": []
    }
  ]
}