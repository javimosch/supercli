{
  "name": "tokamak",
  "version": "0.1.0",
  "description": "Web framework for Zig that leverages dependency injection for clean, modular application development",
  "source": "https://github.com/tokamak/tokamak",
  "checks": [
    {
      "type": "binary",
      "name": "tokamak"
    }
  ],
  "install_guidance": {
    "plugin": "tokamak",
    "binary": "tokamak",
    "check": "which tokamak",
    "install_steps": [
      "pip install tokamak",
      "Verify: tokamak --version",
      "supercli plugins install ./plugins/tokamak --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tokamak",
      "resource": "self",
      "action": "version",
      "description": "Print tokamak version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tokamak",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tokamak: pip install tokamak"
      },
      "args": []
    },
    {
      "namespace": "tokamak",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tokamak CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tokamak",
        "passthrough": true,
        "missingDependencyHelp": "Install tokamak: pip install tokamak"
      },
      "args": []
    }
  ]
}