{
  "name": "moeda",
  "version": "0.1.0",
  "description": "Foreign exchange rates and currency conversion",
  "source": "https://github.com/thompsonemerson/moeda",
  "checks": [
    {
      "type": "binary",
      "name": "moeda"
    }
  ],
  "install_guidance": {
    "plugin": "moeda",
    "binary": "moeda",
    "check": "which moeda",
    "install_steps": [
      "See https://github.com/thompsonemerson/moeda",
      "Verify: moeda --version",
      "supercli plugins install ./plugins/moeda --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "moeda",
      "resource": "self",
      "action": "version",
      "description": "Print moeda version",
      "adapter": "process",
      "adapterConfig": {
        "command": "moeda",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install moeda: See https://github.com/thompsonemerson/moeda"
      },
      "args": []
    },
    {
      "namespace": "moeda",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to moeda CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "moeda",
        "passthrough": true,
        "missingDependencyHelp": "Install moeda"
      },
      "args": []
    }
  ]
}