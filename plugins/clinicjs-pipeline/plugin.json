{
  "name": "clinicjs-pipeline",
  "version": "0.1.0",
  "description": "ClinicJS pipeline for Github actions",
  "source": "https://github.com/clinicjs-pipeline/clinicjs-pipeline",
  "checks": [
    {
      "type": "binary",
      "name": "clinicjs-pipeline"
    }
  ],
  "install_guidance": {
    "plugin": "clinicjs-pipeline",
    "binary": "clinicjs-pipeline",
    "check": "which clinicjs-pipeline",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: clinicjs-pipeline --version",
      "supercli plugins install ./plugins/clinicjs-pipeline --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "clinicjs-pipeline",
      "resource": "self",
      "action": "version",
      "description": "Print clinicjs-pipeline version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clinicjs-pipeline",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clinicjs-pipeline from project repository"
      },
      "args": []
    },
    {
      "namespace": "clinicjs-pipeline",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clinicjs-pipeline CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clinicjs-pipeline",
        "passthrough": true,
        "missingDependencyHelp": "Install clinicjs-pipeline from project repository"
      },
      "args": []
    }
  ]
}