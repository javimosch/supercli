{
  "name": "hubble",
  "version": "0.1.0",
  "description": "Network, Service & Security Observability for Kubernetes using eBPF",
  "source": "https://github.com/cilium/hubble",
  "checks": [
    {
      "type": "binary",
      "name": "hubble"
    }
  ],
  "install_guidance": {
    "plugin": "hubble",
    "binary": "hubble",
    "check": "which hubble",
    "install_steps": [
      "brew install hubble",
      "Verify: hubble --version",
      "supercli plugins install ./plugins/hubble --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hubble",
      "resource": "self",
      "action": "version",
      "description": "Print hubble version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hubble",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hubble: brew install hubble"
      },
      "args": []
    },
    {
      "namespace": "hubble",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hubble CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hubble",
        "passthrough": true,
        "missingDependencyHelp": "Install hubble"
      },
      "args": []
    }
  ]
}