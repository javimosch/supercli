{
  "name": "cabextract",
  "version": "0.1.0",
  "description": "Microsoft CAB archive extractor",
  "source": "https://github.com/kyz/cabextract",
  "checks": [
    {
      "type": "binary",
      "name": "cabextract"
    }
  ],
  "install_guidance": {
    "plugin": "cabextract",
    "binary": "cabextract",
    "check": "which cabextract",
    "install_steps": [
      "brew install cabextract",
      "Verify: cabextract --version",
      "supercli plugins install ./plugins/cabextract --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "cabextract",
      "resource": "self",
      "action": "version",
      "description": "Print cabextract version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cabextract",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cabextract: brew install cabextract"
      },
      "args": []
    },
    {
      "namespace": "cabextract",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cabextract CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cabextract",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install cabextract: brew install cabextract"
      },
      "args": []
    }
  ]
}
