{
  "name": "codebase-memory-mcp",
  "version": "0.1.0",
  "description": "High-performance code intelligence MCP server. Indexes codebases into a persistent knowledge graph \u2014",
  "source": "https://github.com/codebase-memory-mcp/codebase-memory-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "codebase-memory-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "codebase-memory-mcp",
    "binary": "codebase-memory-mcp",
    "check": "which codebase-memory-mcp",
    "install_steps": [
      "pip install codebase-memory-mcp",
      "Verify: codebase-memory-mcp --version",
      "supercli plugins install ./plugins/codebase-memory-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "codebase-memory-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print codebase-memory-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codebase-memory-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install codebase-memory-mcp: pip install codebase-memory-mcp"
      },
      "args": []
    },
    {
      "namespace": "codebase-memory-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codebase-memory-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codebase-memory-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install codebase-memory-mcp: pip install codebase-memory-mcp"
      },
      "args": []
    }
  ]
}