{
  "name": "postmulti",
  "version": "1.0.0",
  "description": "postmulti \u2014 postmulti \u2014 CLI utility",
  "source": "/usr/sbin/postmulti",
  "checks": [
    {
      "type": "binary",
      "name": "postmulti"
    }
  ],
  "install_guidance": {
    "plugin": "postmulti",
    "binary": "postmulti",
    "check": "which postmulti",
    "install_steps": [
      "# Install postmulti:",
      "# apt: sudo apt-get install postmulti",
      "# brew: brew install postmulti",
      "# cargo: cargo install postmulti",
      "# npm: npm install -g postmulti",
      "# pip: pip install postmulti",
      "# or download from /usr/sbin/postmulti"
    ]
  },
  "commands": [
    {
      "namespace": "postmulti",
      "resource": "postmulti",
      "action": "run",
      "description": "Run postmulti",
      "adapter": "process",
      "adapterConfig": {
        "command": "postmulti",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postmulti from /usr/sbin/postmulti"
      },
      "args": []
    }
  ]
}