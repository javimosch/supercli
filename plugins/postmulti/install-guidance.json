{
  "plugin": "postmulti",
  "binary": "postmulti",
  "check": "which postmulti",
  "install_steps": [
    "# Install postmulti",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/postmulti-linux-amd64 -o /usr/local/bin/postmulti",
    "chmod +x /usr/local/bin/postmulti",
    "# Or via package manager, see /usr/sbin/postmulti"
  ]
}