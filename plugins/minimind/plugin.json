{
  "name": "minimind",
  "version": "0.1.0",
  "description": "\ud83e\udde0\u300c\u5927\u6a21\u578b\u300d2\u5c0f\u65f6\u5b8c\u5168\u4ece0\u8bad\u7ec364M\u7684\u5c0f\u53c2\u6570LLM\uff01Train a 64M-parameter LLM from scratch in just 2h!",
  "source": "https://github.com/minimind/minimind",
  "checks": [
    {
      "type": "binary",
      "name": "minimind"
    }
  ],
  "install_guidance": {
    "plugin": "minimind",
    "binary": "minimind",
    "check": "which minimind",
    "install_steps": [
      "pip install minimind",
      "Verify: minimind --version",
      "supercli plugins install ./plugins/minimind --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "minimind",
      "resource": "self",
      "action": "version",
      "description": "Print minimind version",
      "adapter": "process",
      "adapterConfig": {
        "command": "minimind",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install minimind: pip install minimind"
      },
      "args": []
    },
    {
      "namespace": "minimind",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to minimind CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "minimind",
        "passthrough": true,
        "missingDependencyHelp": "Install minimind: pip install minimind"
      },
      "args": []
    }
  ]
}