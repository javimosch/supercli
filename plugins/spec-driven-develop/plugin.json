{
  "name": "spec-driven-develop",
  "version": "0.1.0",
  "description": "Cross-platform AI agent skill for disciplined spec-driven development — analyze, decompose, track, execute large-scale refactors and migrations",
  "source": "https://github.com/zhu1090093659/spec_driven_develop",
  "checks": [
    { "type": "binary", "name": "git" }
  ],
  "install_guidance": {
    "plugin": "spec-driven-develop",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/zhu1090093659/spec_driven_develop.git",
      "supercli plugins install ./plugins/spec-driven-develop --on-conflict replace --json",
      "sc skills teach spec-driven-develop:quickstart"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "spec-driven-develop",
      "resource": "self",
      "action": "version",
      "description": "Print spec-driven-develop info",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": ["spec-driven-develop v0.1.0 — Use sc skills teach spec-driven-develop:quickstart"],
        "missingDependencyHelp": "Clone: git clone https://github.com/zhu1090093659/spec_driven_develop.git"
      },
      "args": []
    },
    {
      "namespace": "spec-driven-develop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough — clone and teach",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": ["Clone https://github.com/zhu1090093659/spec_driven_develop.git then: sc skills teach spec-driven-develop:quickstart"],
        "passthrough": true,
        "missingDependencyHelp": "Install: git clone https://github.com/zhu1090093659/spec_driven_develop.git"
      },
      "args": []
    }
  ]
}
