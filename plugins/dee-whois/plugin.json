{
  "name": "dee-whois",
  "version": "0.1.0",
  "description": "Parse WHOIS domain lookups into structured JSON",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-whois" }],
  "install_guidance": {
    "plugin": "dee-whois",
    "binary": "dee-whois",
    "check": "which dee-whois",
    "install_steps": ["cargo install dee-whois", "Verify: dee-whois --version", "supercli plugins install ./plugins/dee-whois --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-whois",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-whois CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-whois",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-whois: cargo install dee-whois"
    },
    "args": []
  }]
}
