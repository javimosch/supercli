{
  "name": "microsandbox",
  "version": "0.1.0",
  "description": "\ud83e\uddf1 local-first and microVM-backed programmable sandboxes for AI agents",
  "source": "https://github.com/microsandbox/microsandbox",
  "checks": [
    {
      "type": "binary",
      "name": "microsandbox"
    }
  ],
  "install_guidance": {
    "plugin": "microsandbox",
    "binary": "microsandbox",
    "check": "which microsandbox",
    "install_steps": [
      "pip install microsandbox",
      "Verify: microsandbox --version",
      "supercli plugins install ./plugins/microsandbox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "microsandbox",
      "resource": "self",
      "action": "version",
      "description": "Print microsandbox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsandbox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install microsandbox: pip install microsandbox"
      },
      "args": []
    },
    {
      "namespace": "microsandbox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to microsandbox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsandbox",
        "passthrough": true,
        "missingDependencyHelp": "Install microsandbox: pip install microsandbox"
      },
      "args": []
    }
  ]
}