{
  "name": "z3",
  "version": "0.1.0",
  "description": "Microsoft's SMT solver",
  "source": "https://github.com/Z3Prover/z3",
  "checks": [
    {
      "type": "binary",
      "name": "z3"
    }
  ],
  "install_guidance": {
    "plugin": "z3",
    "binary": "z3",
    "check": "which z3",
    "install_steps": [
      "brew install z3",
      "Verify: z3 --version",
      "supercli plugins install ./plugins/z3 --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "z3",
      "resource": "self",
      "action": "version",
      "description": "Print z3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "z3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install z3: brew install z3"
      },
      "args": []
    },
    {
      "namespace": "z3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to z3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "z3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install z3: brew install z3"
      },
      "args": []
    }
  ]
}
