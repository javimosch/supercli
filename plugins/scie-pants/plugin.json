{
  "name": "scie-pants",
  "version": "0.1.0",
  "description": "Self-contained Python executable for the Pants build system",
  "source": "https://github.com/pantsbuild/scie-pants",
  "checks": [{ "type": "binary", "name": "scie-pants" }],
  "install_guidance": {
    "plugin": "scie-pants",
    "binary": "scie-pants",
    "check": "which scie-pants",
    "install_steps": ["curl install", "Verify: scie-pants --version", "supercli plugins install ./plugins/scie-pants --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "scie-pants",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to scie-pants CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "scie-pants",
      "passthrough": true,
      "missingDependencyHelp": "Install scie-pants: curl install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
