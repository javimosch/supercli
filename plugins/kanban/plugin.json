{
  "name": "kanban",
  "version": "0.1.0",
  "description": "Keyboard-driven project management tool inspired by lazygit",
  "source": "https://github.com/fulsomenko/kanban",
  "checks": [
    {
      "type": "binary",
      "name": "kanban"
    }
  ],
  "install_guidance": {
    "plugin": "kanban",
    "binary": "kanban",
    "check": "which kanban",
    "install_steps": [
      "See https://github.com/fulsomenko/kanban",
      "Verify: kanban --version",
      "supercli plugins install ./plugins/kanban --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "kanban",
      "resource": "self",
      "action": "version",
      "description": "Print kanban version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kanban",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kanban: See https://github.com/fulsomenko/kanban"
      },
      "args": []
    },
    {
      "namespace": "kanban",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kanban CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kanban",
        "passthrough": true,
        "missingDependencyHelp": "Install kanban"
      },
      "args": []
    }
  ]
}