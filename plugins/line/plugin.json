{
  "name": "line",
  "version": "0.1.0",
  "description": "Micro-sequencer for live coding MIDI music in the terminal",
  "source": "https://github.com/line-sequencer/line",
  "checks": [{ "type": "binary", "name": "line" }],
  "install_guidance": {
    "plugin": "line",
    "binary": "line",
    "check": "which line",
    "install_steps": ["cargo install line-sequencer", "Verify: line --version", "supercli plugins install ./plugins/line --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "line",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to line CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "line",
      "passthrough": true,
      "missingDependencyHelp": "Install line: cargo install line-sequencer", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
