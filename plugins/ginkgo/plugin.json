{
  "name": "ginkgo",
  "version": "1.0.0",
  "description": "ginkgo \u2014 Go test framework",
  "source": "github.com/onsi/ginkgo",
  "checks": [
    {
      "type": "binary",
      "name": "ginkgo"
    }
  ],
  "install_guidance": {
    "plugin": "ginkgo",
    "binary": "ginkgo",
    "check": "which ginkgo",
    "install_steps": [
      "# Install ginkgo",
      "# See github.com/onsi/ginkgo",
      "# apt: sudo apt-get install ginkgo",
      "# brew: brew install ginkgo",
      "# cargo: cargo install ginkgo",
      "# npm: npm install -g ginkgo",
      "# pip: pip install ginkgo"
    ]
  },
  "commands": [
    {
      "namespace": "ginkgo",
      "resource": "ginkgo",
      "action": "run",
      "description": "Run ginkgo",
      "adapter": "process",
      "adapterConfig": {
        "command": "ginkgo",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ginkgo from github.com/onsi/ginkgo"
      },
      "args": []
    }
  ]
}