{
  "name": "goodls",
  "version": "0.1.0",
  "description": "goodls \u2014 a high-performance CLI tool to concurrently download shared files and folders from Google Drive.",
  "source": "https://github.com/tanaikech/goodls",
  "checks": [
    {
      "type": "binary",
      "name": "goodls"
    }
  ],
  "install_guidance": {
    "plugin": "goodls",
    "binary": "goodls",
    "check": "which goodls",
    "install_steps": [
      "go install github.com/tanaikech/goodls@latest",
      "supercli plugins install ./plugins/goodls --on-conflict replace --json"
    ],
    "note": "Go. Google Drive downloader."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "goodls",
      "resource": "drive",
      "action": "download",
      "description": "Download from Google Drive",
      "adapter": "process",
      "adapterConfig": {
        "command": "goodls",
        "missingDependencyHelp": "Install goodls",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "goodls",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "goodls",
        "missingDependencyHelp": "Install goodls",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
