{
  "name": "fetch-timeline-cli",
  "version": "0.1.0",
  "description": "Fetch Twitter user's timeline from your terminal :zap:.",
  "source": "https://kikobeats.github.io/fetch-timeline-cli/",
  "checks": [
    {
      "type": "binary",
      "name": "fetch-timeline-cli"
    }
  ],
  "install_guidance": {
    "plugin": "fetch-timeline-cli",
    "binary": "fetch-timeline-cli",
    "check": "which fetch-timeline-cli",
    "install_steps": [
      "Check https://kikobeats.github.io/fetch-timeline-cli/ for installation instructions",
      "Verify: fetch-timeline-cli --version",
      "supercli plugins install ./plugins/fetch-timeline-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "fetch-timeline-cli",
      "resource": "self",
      "action": "version",
      "description": "Print fetch-timeline-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fetch-timeline-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fetch-timeline-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "fetch-timeline-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fetch-timeline-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fetch-timeline-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install fetch-timeline-cli from project repository"
      },
      "args": []
    }
  ]
}