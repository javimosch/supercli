{
  "name": "yeetgif",
  "version": "0.1.0",
  "description": "GIF effects CLI in Go",
  "source": "https://github.com/bitcrwr/yeetgif",
  "checks": [{"type": "binary", "name": "yeetgif"}],
  "install_guidance": {
    "plugin": "yeetgif",
    "binary": "yeetgif",
    "check": "which yeetgif",
    "install_steps": [
      "go install github.com/bitcrwr/yeetgif@latest",
      "Verify: yeetgif --version",
      "supercli plugins install ./yeetgif --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "yeetgif",
      "resource": "self",
      "action": "version",
      "description": "Print yeetgif version",
      "adapter": "process",
      "adapterConfig": {"command": "yeetgif", "baseArgs": ["--version"], "missingDependencyHelp": "Install yeetgif: go install github.com/bitcrwr/yeetgif@latest"},
      "args": []
    },
    {
      "namespace": "yeetgif",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yeetgif CLI",
      "adapter": "process",
      "adapterConfig": {"command": "yeetgif", "passthrough": true, "missingDependencyHelp": "Install yeetgif: go install github.com/bitcrwr/yeetgif@latest"},
      "args": []
    }
  ]
}
