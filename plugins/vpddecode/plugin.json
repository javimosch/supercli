{
  "name": "vpddecode",
  "version": "0.1.0",
  "description": "CLI tool: vpddecode",
  "source": "https://manpages.debian.org/vpddecode",
  "checks": [
    {
      "type": "binary",
      "name": "vpddecode"
    }
  ],
  "install_guidance": {
    "plugin": "vpddecode",
    "binary": "vpddecode",
    "check": "which vpddecode",
    "install_steps": [
      "apt-get install vpddecode 2>/dev/null || which vpddecode",
      "Verify: vpddecode --version",
      "supercli plugins install ./plugins/vpddecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vpddecode",
      "resource": "self",
      "action": "version",
      "description": "Print vpddecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vpddecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vpddecode: apt-get install vpddecode 2>/dev/null || which vpddecode"
      },
      "args": []
    },
    {
      "namespace": "vpddecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vpddecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vpddecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vpddecode: apt-get install vpddecode 2>/dev/null || which vpddecode"
      },
      "args": []
    }
  ]
}