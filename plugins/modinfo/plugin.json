{
  "name": "modinfo",
  "version": "1.0.0",
  "description": "modinfo \u2014 modinfo \u2014 CLI utility",
  "source": "/usr/sbin/modinfo",
  "checks": [
    {
      "type": "binary",
      "name": "modinfo"
    }
  ],
  "install_guidance": {
    "plugin": "modinfo",
    "binary": "modinfo",
    "check": "which modinfo",
