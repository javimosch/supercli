{
  "name": "Timetrap",
  "version": "0.1.0",
  "description": "Simple timetracker",
  "source": "https://github.com/samg/timetrap",
  "checks": [
    {
      "type": "binary",
      "name": "Timetrap"
    }
  ],
  "install_guidance": {
    "plugin": "Timetrap",
    "binary": "Timetrap",
    "check": "which Timetrap",
    "install_steps": [
      "See https://github.com/samg/timetrap",
      "Verify: Timetrap --version",
      "supercli plugins install ./plugins/Timetrap --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Timetrap",
      "resource": "self",
      "action": "version",
      "description": "Print Timetrap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Timetrap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Timetrap: See https://github.com/samg/timetrap"
      },
      "args": []
    },
    {
      "namespace": "Timetrap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Timetrap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Timetrap",
        "passthrough": true,
        "missingDependencyHelp": "Install Timetrap"
      },
      "args": []
    }
  ]
}