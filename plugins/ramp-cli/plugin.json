{
  "name": "ramp-cli",
  "version": "0.1.0",
  "description": "Agent-ready spend and finance service provisioning from the terminal via Ramp.",
  "source": "https://ramp.com",
  "checks": [
    { "type": "binary", "name": "ramp" }
  ],
  "install_guidance": {
    "plugin": "ramp-cli",
    "binary": "ramp",
    "check": "which ramp",
    "install_steps": [
      "npm i -g @ramp/cli",
      "Verify: ramp --version",
      "supercli plugins install ./plugins/ramp-cli --on-conflict replace --json"
    ],
    "note": "Requires RAMP_API_KEY env var. Agent-ready design."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ramp-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ramp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ramp",
        "passthrough": true,
        "missingDependencyHelp": "Install ramp: npm i -g @ramp/cli"
      },
      "args": []
    }
  ]
}
