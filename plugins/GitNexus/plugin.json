{
  "name": "GitNexus",
  "version": "0.1.0",
  "description": "GitNexus: The Zero-Server Code Intelligence Engine -       GitNexus is a client-side knowledge graph",
  "source": "https://github.com/GitNexus/GitNexus",
  "checks": [
    {
      "type": "binary",
      "name": "gitnexus"
    }
  ],
  "install_guidance": {
    "plugin": "GitNexus",
    "binary": "gitnexus",
    "check": "which gitnexus",
    "install_steps": [
      "pip install gitnexus",
      "Verify: gitnexus --version",
      "supercli plugins install ./plugins/GitNexus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GitNexus",
      "resource": "self",
      "action": "version",
      "description": "Print GitNexus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitnexus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GitNexus: pip install gitnexus"
      },
      "args": []
    },
    {
      "namespace": "GitNexus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitnexus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitnexus",
        "passthrough": true,
        "missingDependencyHelp": "Install GitNexus: pip install gitnexus"
      },
      "args": []
    }
  ]
}