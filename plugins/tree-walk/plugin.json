{
  "name": "tree-walk",
  "version": "0.1.0",
  "description": "tree-walk — traverse directory trees",
  "source": "https://github.com/pdubroy/tree-walk",
  "checks": [
    {
      "type": "binary",
      "name": "tree-walk"
    }
  ],
  "install_guidance": {
    "plugin": "tree-walk",
    "binary": "tree-walk",
    "check": "which tree-walk",
    "install_steps": [
      "npm install tree-walk",
      "Verify: tree-walk --version",
      "supercli plugins install ./plugins/tree-walk --on-conflict replace --json"
    ],
    "note": "tree-walk is a JavaScript library for traversing and transforming tree structures."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tree-walk",
      "resource": "self",
      "action": "version",
      "description": "Print tree-walk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tree-walk",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install tree-walk: npm install tree-walk"
      },
      "args": []
    }
  ]
}
