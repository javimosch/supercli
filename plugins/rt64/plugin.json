{
  "name": "rt64",
  "version": "0.1.0",
  "description": "RT64 is an N64 graphics renderer for playing with enhancements in emulators and native ports.",
  "source": "https://github.com/rt64/rt64",
  "checks": [
    {
      "type": "binary",
      "name": "rt64"
    }
  ],
  "install_guidance": {
    "plugin": "rt64",
    "binary": "rt64",
    "check": "which rt64",
    "install_steps": [
      "pip install rt64",
      "Verify: rt64 --version",
      "supercli plugins install ./plugins/rt64 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rt64",
      "resource": "self",
      "action": "version",
      "description": "Print rt64 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rt64",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rt64: pip install rt64"
      },
      "args": []
    },
    {
      "namespace": "rt64",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rt64 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rt64",
        "passthrough": true,
        "missingDependencyHelp": "Install rt64: pip install rt64"
      },
      "args": []
    }
  ]
}