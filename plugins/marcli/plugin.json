{
  "name": "marcli",
  "version": "0.1.0",
  "description": "Parse MARC (ISO 2709) files",
  "source": "https://github.com/hectorcorrea/marcli",
  "checks": [
    {
      "type": "binary",
      "name": "marcli"
    }
  ],
  "install_guidance": {
    "plugin": "marcli",
    "binary": "marcli",
    "check": "which marcli",
    "install_steps": [
      "brew install marcli",
      "Verify: marcli --version",
      "supercli plugins install ./plugins/marcli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "marcli",
      "resource": "self",
      "action": "version",
      "description": "Print marcli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "marcli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install marcli: brew install marcli"
      },
      "args": []
    },
    {
      "namespace": "marcli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to marcli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "marcli",
        "passthrough": true,
        "missingDependencyHelp": "Install marcli"
      },
      "args": []
    }
  ]
}