{
  "name": "ppmtoyuvsplit",
  "version": "0.1.0",
  "description": "CLI tool: ppmtoyuvsplit",
  "source": "https://manpages.debian.org/ppmtoyuvsplit",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtoyuvsplit"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtoyuvsplit",
    "binary": "ppmtoyuvsplit",
    "check": "which ppmtoyuvsplit",
    "install_steps": [
      "apt-get install ppmtoyuvsplit 2>/dev/null || which ppmtoyuvsplit",
      "Verify: ppmtoyuvsplit --version",
      "supercli plugins install ./plugins/ppmtoyuvsplit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtoyuvsplit",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtoyuvsplit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoyuvsplit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtoyuvsplit: apt-get install ppmtoyuvsplit 2>/dev/null || which ppmtoyuvsplit"
      },
      "args": []
    },
    {
      "namespace": "ppmtoyuvsplit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtoyuvsplit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoyuvsplit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtoyuvsplit: apt-get install ppmtoyuvsplit 2>/dev/null || which ppmtoyuvsplit"
      },
      "args": []
    }
  ]
}