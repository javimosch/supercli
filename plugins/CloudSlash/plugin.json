{
  "name": "CloudSlash",
  "version": "0.1.0",
  "description": "CloudSlash - Local-first AWS forensic engine",
  "source": "github.com/CloudSlash/cloudslash",
  "checks": [
    {
      "type": "binary",
      "name": "cloudslash"
    }
  ],
  "install_guidance": {
    "plugin": "CloudSlash",
    "binary": "cloudslash",
    "check": "which cloudslash",
    "install_steps": [
      "go install github.com/CloudSlash/cloudslash@latest"
    ]
  },
  "commands": [
    {
      "namespace": "cloudslash",
      "resource": "forensics",
      "action": "run",
      "description": "Run local-first AWS forensic engine",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudslash",
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install cloudslash from github.com/CloudSlash/cloudslash"
      },
      "args": []
    }
  ]
}