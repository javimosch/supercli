{
  "name": "b2-tools",
  "version": "0.1.0",
  "description": "B2 Cloud Storage Command-Line Tools",
  "source": "https://github.com/Backblaze/B2_Command_Line_Tool",
  "checks": [
    {
      "type": "binary",
      "name": "b2-tools"
    }
  ],
  "install_guidance": {
    "plugin": "b2-tools",
    "binary": "b2-tools",
    "check": "which b2-tools",
    "install_steps": [
      "brew install b2-tools",
      "Verify: b2-tools --version",
      "supercli plugins install ./plugins/b2-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "b2-tools",
      "resource": "self",
      "action": "version",
      "description": "Print b2-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "b2-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install b2-tools: brew install b2-tools"
      },
      "args": []
    },
    {
      "namespace": "b2-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to b2-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "b2-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install b2-tools"
      },
      "args": []
    }
  ]
}