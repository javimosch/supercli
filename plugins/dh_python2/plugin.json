{
  "name": "dh_python2",
  "version": "0.1.0",
  "description": "CLI tool: dh_python2",
  "source": "https://packages.debian.org/dh_python2",
  "checks": [{ "type": "binary", "name": "dh_python2" }],
  "install_guidance": {
    "plugin": "dh_python2", "binary": "dh_python2", "check": "which dh_python2",
    "install_steps": ["apt-get install dh_python2 2>/dev/null || which dh_python2", "Verify: dh_python2 --version", "supercli plugins install ./plugins/dh_python2 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_python2", "resource": "_", "action": "_",
    "description": "Passthrough to dh_python2 CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_python2", "passthrough": true, "missingDependencyHelp": "Install dh_python2: apt-get install dh_python2" }, "args": []
  }]
}
