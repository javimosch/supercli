{
  "name": "obfus.h",
  "version": "0.1.0",
  "description": "Macro-header for compile-time C obfuscation (tcc, win x86/x64)",
  "source": "https://github.com/obfus.h/obfus.h",
  "checks": [
    {
      "type": "binary",
      "name": "obfus.h"
    }
  ],
  "install_guidance": {
    "plugin": "obfus.h",
    "binary": "obfus.h",
    "check": "which obfus.h",
    "install_steps": [
      "pip install obfus.h",
      "Verify: obfus.h --version",
      "supercli plugins install ./plugins/obfus.h --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "obfus.h",
      "resource": "self",
      "action": "version",
      "description": "Print obfus.h version",
      "adapter": "process",
      "adapterConfig": {
        "command": "obfus.h",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install obfus.h: pip install obfus.h"
      },
      "args": []
    },
    {
      "namespace": "obfus.h",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to obfus.h CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "obfus.h",
        "passthrough": true,
        "missingDependencyHelp": "Install obfus.h: pip install obfus.h"
      },
      "args": []
    }
  ]
}