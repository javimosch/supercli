{
  "name": "Sat-Pipeline-CLI",
  "version": "0.1.0",
  "description": "Satellite Pipeline using Python Based CLI, can handle Planet & DigitalGlobe Data",
  "source": "https://github.com/Sat-Pipeline-CLI/Sat-Pipeline-CLI",
  "checks": [
    {
      "type": "binary",
      "name": "Sat-Pipeline-CLI"
    }
  ],
  "install_guidance": {
    "plugin": "Sat-Pipeline-CLI",
    "binary": "Sat-Pipeline-CLI",
    "check": "which Sat-Pipeline-CLI",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Sat-Pipeline-CLI --version",
      "supercli plugins install ./plugins/Sat-Pipeline-CLI --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "Sat-Pipeline-CLI",
      "resource": "self",
      "action": "version",
      "description": "Print Sat-Pipeline-CLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Sat-Pipeline-CLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Sat-Pipeline-CLI from project repository"
      },
      "args": []
    },
    {
      "namespace": "Sat-Pipeline-CLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Sat-Pipeline-CLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Sat-Pipeline-CLI",
        "passthrough": true,
        "missingDependencyHelp": "Install Sat-Pipeline-CLI from project repository"
      },
      "args": []
    }
  ]
}