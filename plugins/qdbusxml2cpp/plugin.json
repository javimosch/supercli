{
  "name": "qdbusxml2cpp",
  "version": "0.1.0",
  "description": "CLI tool: qdbusxml2cpp",
  "source": "https://manpages.debian.org/qdbusxml2cpp",
  "checks": [
    {
      "type": "binary",
      "name": "qdbusxml2cpp"
    }
  ],
  "install_guidance": {
    "plugin": "qdbusxml2cpp",
    "binary": "qdbusxml2cpp",
    "check": "which qdbusxml2cpp",
    "install_steps": [
      "apt-get install qdbusxml2cpp 2>/dev/null || which qdbusxml2cpp",
      "Verify: qdbusxml2cpp --version",
      "supercli plugins install ./plugins/qdbusxml2cpp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qdbusxml2cpp",
      "resource": "self",
      "action": "version",
      "description": "Print qdbusxml2cpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qdbusxml2cpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qdbusxml2cpp: apt-get install qdbusxml2cpp 2>/dev/null || which qdbusxml2cpp"
      },
      "args": []
    },
    {
      "namespace": "qdbusxml2cpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qdbusxml2cpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qdbusxml2cpp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qdbusxml2cpp: apt-get install qdbusxml2cpp 2>/dev/null || which qdbusxml2cpp"
      },
      "args": []
    }
  ]
}