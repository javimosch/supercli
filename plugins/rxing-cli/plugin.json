{
  "name": "rxing-cli",
  "version": "0.1.0",
  "description": "Command line barcode reading in Rust",
  "source": "https://github.com/nicholasgasior/rxing-cli",
  "checks": [{"type": "binary", "name": "rxing-cli"}],
  "install_guidance": {
    "plugin": "rxing-cli",
    "binary": "rxing-cli",
    "check": "which rxing-cli",
    "install_steps": [
      "cargo install rxing-cli",
      "Verify: rxing-cli --version",
      "supercli plugins install ./rxing-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "rxing-cli",
      "resource": "self",
      "action": "version",
      "description": "Print rxing-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "rxing-cli", "baseArgs": ["--version"], "missingDependencyHelp": "Install rxing-cli: cargo install rxing-cli"},
      "args": []
    },
    {
      "namespace": "rxing-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rxing-cli CLI",
      "adapter": "process",
      "adapterConfig": {"command": "rxing-cli", "passthrough": true, "missingDependencyHelp": "Install rxing-cli: cargo install rxing-cli"},
      "args": []
    }
  ]
}
