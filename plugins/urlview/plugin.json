{
  "name": "urlview",
  "version": "0.1.0",
  "description": "Extract and view URLs from text",
  "source": "https://github.com/sigpipe/urlview",
  "checks": [
    {
      "type": "binary",
      "name": "urlview"
    }
  ],
  "install_guidance": {
    "plugin": "urlview",
    "binary": "urlview",
    "check": "which urlview",
    "install_steps": [
      "brew install urlview",
      "Verify: urlview --version",
      "supercli plugins install ./plugins/urlview --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "urlview",
      "resource": "self",
      "action": "version",
      "description": "Print urlview version",
      "adapter": "process",
      "adapterConfig": {
        "command": "urlview",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install urlview: brew install urlview"
      },
      "args": []
    },
    {
      "namespace": "urlview",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to urlview CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "urlview",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install urlview: brew install urlview"
      },
      "args": []
    }
  ]
}
