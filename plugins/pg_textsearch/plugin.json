{
  "name": "pg_textsearch",
  "version": "0.1.0",
  "description": "PostgreSQL extension for BM25 relevance-ranked full-text search. Postgres OSS licensed.",
  "source": "https://github.com/pg_textsearch/pg_textsearch",
  "checks": [
    {
      "type": "binary",
      "name": "pg-textsearch"
    }
  ],
  "install_guidance": {
    "plugin": "pg_textsearch",
    "binary": "pg-textsearch",
    "check": "which pg-textsearch",
    "install_steps": [
      "pip install pg-textsearch",
      "Verify: pg-textsearch --version",
      "supercli plugins install ./plugins/pg_textsearch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pg_textsearch",
      "resource": "self",
      "action": "version",
      "description": "Print pg_textsearch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg-textsearch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pg_textsearch: pip install pg-textsearch"
      },
      "args": []
    },
    {
      "namespace": "pg_textsearch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pg-textsearch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg-textsearch",
        "passthrough": true,
        "missingDependencyHelp": "Install pg_textsearch: pip install pg-textsearch"
      },
      "args": []
    }
  ]
}