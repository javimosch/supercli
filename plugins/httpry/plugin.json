{
  "name": "httpry",
  "version": "0.1.0",
  "description": "Packet sniffer for displaying and logging HTTP traffic",
  "source": "https://github.com/jbittel/httpry",
  "checks": [
    {
      "type": "binary",
      "name": "httpry"
    }
  ],
  "install_guidance": {
    "plugin": "httpry",
    "binary": "httpry",
    "check": "which httpry",
    "install_steps": [
      "brew install httpry",
      "Verify: httpry --version",
      "supercli plugins install ./plugins/httpry --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "httpry",
      "resource": "self",
      "action": "version",
      "description": "Print httpry version",
      "adapter": "process",
      "adapterConfig": {
        "command": "httpry",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install httpry: brew install httpry"
      },
      "args": []
    },
    {
      "namespace": "httpry",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to httpry CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "httpry",
        "passthrough": true,
        "missingDependencyHelp": "Install httpry"
      },
      "args": []
    }
  ]
}