{
  "name": "jqfmt",
  "version": "0.1.0",
  "description": "Opinionated formatter for jq",
  "source": "https://github.com/noperator/jqfmt",
  "checks": [
    {
      "type": "binary",
      "name": "jqfmt"
    }
  ],
  "install_guidance": {
    "plugin": "jqfmt",
    "binary": "jqfmt",
    "check": "which jqfmt",
    "install_steps": [
      "brew install jqfmt",
      "Verify: jqfmt --version",
      "supercli plugins install ./plugins/jqfmt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jqfmt",
      "resource": "self",
      "action": "version",
      "description": "Print jqfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jqfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jqfmt: brew install jqfmt"
      },
      "args": []
    },
    {
      "namespace": "jqfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jqfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jqfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install jqfmt"
      },
      "args": []
    }
  ]
}