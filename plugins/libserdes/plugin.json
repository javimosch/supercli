{
  "name": "libserdes",
  "version": "0.1.0",
  "description": "Schema ser/deserializer lib for Avro + Confluent Schema Registry",
  "source": "https://github.com/confluentinc/libserdes",
  "checks": [
    {
      "type": "binary",
      "name": "libserdes"
    }
  ],
  "install_guidance": {
    "plugin": "libserdes",
    "binary": "libserdes",
    "check": "which libserdes",
    "install_steps": [
      "brew install libserdes",
      "Verify: libserdes --version",
      "supercli plugins install ./plugins/libserdes --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libserdes",
      "resource": "self",
      "action": "version",
      "description": "Print libserdes version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libserdes",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libserdes: brew install libserdes"
      },
      "args": []
    },
    {
      "namespace": "libserdes",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libserdes CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libserdes",
        "passthrough": true,
        "missingDependencyHelp": "Install libserdes"
      },
      "args": []
    }
  ]
}