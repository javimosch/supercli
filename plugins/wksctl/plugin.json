{
  "name": "wksctl",
  "version": "0.1.0",
  "description": "Weave Kubernetes System control for GitOps cluster management",
  "source": "https://github.com/weaveworks/wksctl",
  "checks": [{ "type": "binary", "name": "wksctl" }],
  "install_guidance": {
    "plugin": "wksctl",
    "binary": "wksctl",
    "check": "which wksctl",
    "install_steps": ["brew install wksctl", "Verify: wksctl --version", "supercli plugins install ./plugins/wksctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wksctl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wksctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wksctl",
      "passthrough": true,
      "missingDependencyHelp": "Install wksctl: brew install wksctl"
    },
    "args": []
  }]
}
