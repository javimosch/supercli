{
  "name": "git-interactive-rebase-tool",
  "version": "0.1.0",
  "description": "Full-featured terminal rebase replacement",
  "source": "https://github.com/MitMaro/git-interactive-rebase-tool",
  "checks": [{ "type": "binary", "name": "git-interactive-rebase-tool" }],
  "install_guidance": {
    "plugin": "git-interactive-rebase-tool",
    "binary": "git-interactive-rebase-tool",
    "check": "which git-interactive-rebase-tool",
    "install_steps": ["cargo install git-interactive-rebase-tool", "Verify: git-interactive-rebase-tool --version", "supercli plugins install ./plugins/git-interactive-rebase-tool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-interactive-rebase-tool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-interactive-rebase-tool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-interactive-rebase-tool",
      "passthrough": true,
      "missingDependencyHelp": "Install git-interactive-rebase-tool: cargo install git-interactive-rebase-tool", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
