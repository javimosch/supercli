{
  "name": "plymouthd",
  "version": "0.1.0",
  "description": "CLI tool: plymouthd",
  "source": "https://manpages.debian.org/plymouthd",
  "checks": [
    {
      "type": "binary",
      "name": "plymouthd"
    }
  ],
  "install_guidance": {
    "plugin": "plymouthd",
    "binary": "plymouthd",
    "check": "which plymouthd",
    "install_steps": [
      "apt-get install plymouthd 2>/dev/null || which plymouthd",
      "Verify: plymouthd --version",
      "supercli plugins install ./plugins/plymouthd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "plymouthd",
      "resource": "self",
      "action": "version",
      "description": "Print plymouthd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "plymouthd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install plymouthd: apt-get install plymouthd 2>/dev/null || which plymouthd"
      },
      "args": []
    },
    {
      "namespace": "plymouthd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to plymouthd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "plymouthd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install plymouthd: apt-get install plymouthd 2>/dev/null || which plymouthd"
      },
      "args": []
    }
  ]
}