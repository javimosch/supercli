{
  "name": "mgrep",
  "version": "0.1.0",
  "description": "Semantic grep for searching code with meaning",
  "source": "https://github.com/nicholasgasior/mgrep",
  "checks": [
    {
      "type": "binary",
      "name": "mgrep"
    }
  ],
  "install_guidance": {
    "plugin": "mgrep",
    "binary": "mgrep",
    "check": "which mgrep",
    "install_steps": [
      "npm install -g mgrep",
      "Verify: mgrep --version",
      "supercli plugins install ./plugins/mgrep --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mgrep",
      "resource": "self",
      "action": "version",
      "description": "Print mgrep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mgrep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mgrep: npm install -g mgrep"
      },
      "args": []
    },
    {
      "namespace": "mgrep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mgrep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mgrep",
        "passthrough": true,
        "missingDependencyHelp": "Install mgrep: npm install -g mgrep"
      },
      "args": []
    }
  ]
}
