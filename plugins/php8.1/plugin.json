{
  "name": "php8.1",
  "version": "0.1.0",
  "description": "CLI tool: php8.1",
  "source": "https://manpages.debian.org/php8.1",
  "checks": [
    {
      "type": "binary",
      "name": "php8.1"
    }
  ],
  "install_guidance": {
    "plugin": "php8.1",
    "binary": "php8.1",
    "check": "which php8.1",
    "install_steps": [
      "apt-get install php8.1 2>/dev/null || which php8.1",
      "Verify: php8.1 --version",
      "supercli plugins install ./plugins/php8.1 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "php8.1",
      "resource": "self",
      "action": "version",
      "description": "Print php8.1 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "php8.1",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install php8.1: apt-get install php8.1 2>/dev/null || which php8.1"
      },
      "args": []
    },
    {
      "namespace": "php8.1",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to php8.1 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "php8.1",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install php8.1: apt-get install php8.1 2>/dev/null || which php8.1"
      },
      "args": []
    }
  ]
}