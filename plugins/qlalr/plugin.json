{
  "name": "qlalr",
  "version": "0.1.0",
  "description": "CLI tool: qlalr",
  "source": "https://manpages.debian.org/qlalr",
  "checks": [
    {
      "type": "binary",
      "name": "qlalr"
    }
  ],
  "install_guidance": {
    "plugin": "qlalr",
    "binary": "qlalr",
    "check": "which qlalr",
    "install_steps": [
      "apt-get install qlalr 2>/dev/null || which qlalr",
      "Verify: qlalr --version",
      "supercli plugins install ./plugins/qlalr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qlalr",
      "resource": "self",
      "action": "version",
      "description": "Print qlalr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qlalr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qlalr: apt-get install qlalr 2>/dev/null || which qlalr"
      },
      "args": []
    },
    {
      "namespace": "qlalr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qlalr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qlalr",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qlalr: apt-get install qlalr 2>/dev/null || which qlalr"
      },
      "args": []
    }
  ]
}