{
  "name": "fsck.ext3",
  "version": "0.1.0",
  "description": "CLI tool: fsck.ext3",
  "source": "https://manpages.debian.org/fsck.ext3",
  "checks": [
    {
      "type": "binary",
      "name": "fsck.ext3"
    }
  ],
  "install_guidance": {
    "plugin": "fsck.ext3",
    "binary": "fsck.ext3",
    "check": "which fsck.ext3",
    "install_steps": [
      "apt-get install fsck.ext3 2>/dev/null || which fsck.ext3",
      "Verify: fsck.ext3 --version",
      "supercli plugins install ./plugins/fsck.ext3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fsck.ext3",
      "resource": "self",
      "action": "version",
      "description": "Print fsck.ext3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsck.ext3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fsck.ext3: apt-get install fsck.ext3 2>/dev/null || which fsck.ext3"
      },
      "args": []
    },
    {
      "namespace": "fsck.ext3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fsck.ext3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsck.ext3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fsck.ext3: apt-get install fsck.ext3 2>/dev/null || which fsck.ext3"
      },
      "args": []
    }
  ]
}