{
  "name": "go-template-cli",
  "version": "0.1.0",
  "description": "Render JSON/YAML/TOML data through Go templates",
  "source": "https://github.com/nicm/go-template-cli",
  "checks": [
    {
      "type": "binary",
      "name": "go-template-cli"
    }
  ],
  "install_guidance": {
    "plugin": "go-template-cli",
    "binary": "go-template-cli",
    "check": "which go-template-cli",
    "install_steps": [
      "go install github.com/nicm/go-template-cli@latest",
      "Verify: go-template-cli --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-template-cli",
      "resource": "self",
      "action": "version",
      "description": "Print go-template-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-template-cli",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install go-template-cli: go install github.com/nicm/go-template-cli@latest"
      },
      "args": []
    },
    {
      "namespace": "go-template-cli",
      "resource": "file",
      "action": "render",
      "description": "Render Go templates with JSON, YAML, or TOML context data",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-template-cli",
        "baseArgs": ["--cwd", "invoke_cwd"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install go-template-cli: go install github.com/nicm/go-template-cli@latest"
      },
      "args": []
    },
    {
      "namespace": "go-template-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-template-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-template-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install go-template-cli: go install github.com/nicm/go-template-cli@latest"
      },
      "args": []
    }
  ]
}