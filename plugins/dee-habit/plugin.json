{
  "name": "dee-habit",
  "version": "0.1.0",
  "description": "Habit and streak tracker from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-habit" }],
  "install_guidance": {
    "plugin": "dee-habit",
    "binary": "dee-habit",
    "check": "which dee-habit",
    "install_steps": ["cargo install dee-habit", "Verify: dee-habit --version", "supercli plugins install ./plugins/dee-habit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-habit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-habit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-habit",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-habit: cargo install dee-habit"
    },
    "args": []
  }]
}
