{
  "plugin": "rletopnm",
  "binary": "rletopnm",
  "check": "which rletopnm",
  "install_steps": [
    "apt-get install rletopnm 2>/dev/null || which rletopnm",
    "Verify: rletopnm --version",
    "supercli plugins install ./plugins/rletopnm --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}