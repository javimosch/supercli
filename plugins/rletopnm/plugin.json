{
  "name": "rletopnm",
  "version": "0.1.0",
  "description": "CLI tool: rletopnm",
  "source": "https://manpages.debian.org/rletopnm",
  "checks": [
    {
      "type": "binary",
      "name": "rletopnm"
    }
  ],
  "install_guidance": {
    "plugin": "rletopnm",
    "binary": "rletopnm",
    "check": "which rletopnm",
    "install_steps": [
      "apt-get install rletopnm 2>/dev/null || which rletopnm",
      "Verify: rletopnm --version",
      "supercli plugins install ./plugins/rletopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rletopnm",
      "resource": "self",
      "action": "version",
      "description": "Print rletopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rletopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rletopnm: apt-get install rletopnm 2>/dev/null || which rletopnm"
      },
      "args": []
    },
    {
      "namespace": "rletopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rletopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rletopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rletopnm: apt-get install rletopnm 2>/dev/null || which rletopnm"
      },
      "args": []
    }
  ]
}