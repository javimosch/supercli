{
  "name": "Dayflow",
  "version": "0.1.0",
  "description": "The automatic work journal. Privately turns your screen into a timeline of what you actually accompl",
  "source": "https://github.com/Dayflow/Dayflow",
  "checks": [
    {
      "type": "binary",
      "name": "dayflow"
    }
  ],
  "install_guidance": {
    "plugin": "Dayflow",
    "binary": "dayflow",
    "check": "which dayflow",
    "install_steps": [
      "pip install dayflow",
      "Verify: dayflow --version",
      "supercli plugins install ./plugins/Dayflow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Dayflow",
      "resource": "self",
      "action": "version",
      "description": "Print Dayflow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dayflow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Dayflow: pip install dayflow"
      },
      "args": []
    },
    {
      "namespace": "Dayflow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dayflow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dayflow",
        "passthrough": true,
        "missingDependencyHelp": "Install Dayflow: pip install dayflow"
      },
      "args": []
    }
  ]
}