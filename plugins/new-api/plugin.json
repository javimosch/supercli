{
  "name": "new-api",
  "version": "0.1.0",
  "description": "A unified AI model hub for aggregation & distribution. It supports cross-converting various LLMs int",
  "source": "https://github.com/new-api/new-api",
  "checks": [
    {
      "type": "binary",
      "name": "new-api"
    }
  ],
  "install_guidance": {
    "plugin": "new-api",
    "binary": "new-api",
    "check": "which new-api",
    "install_steps": [
      "pip install new-api",
      "Verify: new-api --version",
      "supercli plugins install ./plugins/new-api --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "new-api",
      "resource": "self",
      "action": "version",
      "description": "Print new-api version",
      "adapter": "process",
      "adapterConfig": {
        "command": "new-api",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install new-api: pip install new-api"
      },
      "args": []
    },
    {
      "namespace": "new-api",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to new-api CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "new-api",
        "passthrough": true,
        "missingDependencyHelp": "Install new-api: pip install new-api"
      },
      "args": []
    }
  ]
}