{
  "name": "xetex",
  "version": "0.1.0",
  "description": "xetex \u2014 extended TeX with native support for Unicode, OpenType, system fonts",
  "source": "https://manpages.debian.org/xetex",
  "checks": [
    {
      "type": "binary",
      "name": "xetex"
    }
  ],
  "install_guidance": {
    "plugin": "xetex",
    "binary": "xetex",
    "check": "which xetex",
    "install_steps": [
      "apt-get install xetex 2>/dev/null || which xetex",
      "Verify: xetex --version",
      "supercli plugins install ./plugins/xetex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xetex",
      "resource": "self",
      "action": "version",
      "description": "Print xetex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xetex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xetex: apt-get install xetex 2>/dev/null || which xetex"
      },
      "args": []
    },
    {
      "namespace": "xetex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xetex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xetex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xetex: apt-get install xetex 2>/dev/null || which xetex"
      },
      "args": []
    }
  ]
}