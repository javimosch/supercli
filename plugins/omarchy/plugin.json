{
  "name": "omarchy",
  "version": "0.1.0",
  "description": "Beautiful, Modern & Opinionated Linux",
  "source": "https://github.com/omarchy/omarchy",
  "checks": [
    {
      "type": "binary",
      "name": "omarchy"
    }
  ],
  "install_guidance": {
    "plugin": "omarchy",
    "binary": "omarchy",
    "check": "which omarchy",
    "install_steps": [
      "pip install omarchy",
      "Verify: omarchy --version",
      "supercli plugins install ./plugins/omarchy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "omarchy",
      "resource": "self",
      "action": "version",
      "description": "Print omarchy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "omarchy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install omarchy: pip install omarchy"
      },
      "args": []
    },
    {
      "namespace": "omarchy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to omarchy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "omarchy",
        "passthrough": true,
        "missingDependencyHelp": "Install omarchy: pip install omarchy"
      },
      "args": []
    }
  ]
}