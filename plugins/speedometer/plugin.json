{
  "name": "speedometer",
  "version": "1.0.0",
  "description": "speedometer \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=speedometer+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "speedometer"
    }
  ],
  "install_guidance": {
    "plugin": "speedometer",
    "binary": "speedometer",
    "check": "which speedometer",
    "install_steps": [
      "Install speedometer via package manager: apt install speedometer or brew install speedometer"
    ]
  },
  "commands": [
    {
      "namespace": "speedometer",
      "resource": "run",
      "action": "exec",
      "description": "speedometer \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "speedometer",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install speedometer via your package manager"
      },
      "args": []
    }
  ]
}