{
  "plugin": "xdg-mime",
  "binary": "xdg-mime",
  "check": "which xdg-mime",
  "install_steps": [
    "apt-get install xdg-mime 2>/dev/null || which xdg-mime",
    "Verify: xdg-mime --version",
    "supercli plugins install ./plugins/xdg-mime --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}