{
  "name": "easy-file-organizer",
  "version": "0.1.0",
  "description": "CLI tool: easy-file-organizer",
  "source": "https://manpages.debian.org/easy-file-organizer",
  "checks": [
    {
      "type": "binary",
      "name": "easy-file-organizer"
    }
  ],
  "install_guidance": {
    "plugin": "easy-file-organizer",
    "binary": "easy-file-organizer",
    "check": "which easy-file-organizer",
    "install_steps": [
      "apt-get install easy-file-organizer 2>/dev/null || which easy-file-organizer",
      "Verify: easy-file-organizer --version",
      "supercli plugins install ./plugins/easy-file-organizer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "easy-file-organizer",
      "resource": "self",
      "action": "version",
      "description": "Print easy-file-organizer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "easy-file-organizer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install easy-file-organizer: apt-get install easy-file-organizer 2>/dev/null || which easy-file-organizer"
      },
      "args": []
    },
    {
      "namespace": "easy-file-organizer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to easy-file-organizer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "easy-file-organizer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install easy-file-organizer: apt-get install easy-file-organizer 2>/dev/null || which easy-file-organizer"
      },
      "args": []
    }
  ]
}