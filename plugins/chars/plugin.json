{
  "name": "chars",
  "version": "0.1.0",
  "description": "Display names and codes for various ASCII (and Unicode) characters / code points.",
  "source": "https://github.com/antifuchs/chars",
  "checks": [
    {
      "type": "binary",
      "name": "chars"
    }
  ],
  "install_guidance": {
    "plugin": "chars",
    "binary": "chars",
    "check": "which chars",
    "install_steps": [
      "cargo install chars",
      "Verify: chars --version",
      "supercli plugins install ./plugins/chars --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chars",
      "resource": "self",
      "action": "version",
      "description": "Print chars version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chars",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chars: cargo install chars"
      },
      "args": []
    },
    {
      "namespace": "chars",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chars CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chars",
        "passthrough": true,
        "missingDependencyHelp": "Install chars"
      },
      "args": []
    }
  ]
}