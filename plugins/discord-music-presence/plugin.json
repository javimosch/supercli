{
  "name": "discord-music-presence",
  "version": "0.1.0",
  "description": "The Discord music status that works with any media player",
  "source": "https://github.com/discord-music-presence/discord-music-presence",
  "checks": [
    {
      "type": "binary",
      "name": "discord-music-presence"
    }
  ],
  "install_guidance": {
    "plugin": "discord-music-presence",
    "binary": "discord-music-presence",
    "check": "which discord-music-presence",
    "install_steps": [
      "pip install discord-music-presence",
      "Verify: discord-music-presence --version",
      "supercli plugins install ./plugins/discord-music-presence --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "discord-music-presence",
      "resource": "self",
      "action": "version",
      "description": "Print discord-music-presence version",
      "adapter": "process",
      "adapterConfig": {
        "command": "discord-music-presence",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install discord-music-presence: pip install discord-music-presence"
      },
      "args": []
    },
    {
      "namespace": "discord-music-presence",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to discord-music-presence CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "discord-music-presence",
        "passthrough": true,
        "missingDependencyHelp": "Install discord-music-presence: pip install discord-music-presence"
      },
      "args": []
    }
  ]
}