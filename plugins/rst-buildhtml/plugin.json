{
  "name": "rst-buildhtml",
  "version": "0.1.0",
  "description": "CLI tool: rst-buildhtml",
  "source": "https://manpages.debian.org/rst-buildhtml",
  "checks": [
    {
      "type": "binary",
      "name": "rst-buildhtml"
    }
  ],
  "install_guidance": {
    "plugin": "rst-buildhtml",
    "binary": "rst-buildhtml",
    "check": "which rst-buildhtml",
    "install_steps": [
      "apt-get install rst-buildhtml 2>/dev/null || which rst-buildhtml",
      "Verify: rst-buildhtml --version",
      "supercli plugins install ./plugins/rst-buildhtml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rst-buildhtml",
      "resource": "self",
      "action": "version",
      "description": "Print rst-buildhtml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst-buildhtml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rst-buildhtml: apt-get install rst-buildhtml 2>/dev/null || which rst-buildhtml"
      },
      "args": []
    },
    {
      "namespace": "rst-buildhtml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rst-buildhtml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst-buildhtml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rst-buildhtml: apt-get install rst-buildhtml 2>/dev/null || which rst-buildhtml"
      },
      "args": []
    }
  ]
}