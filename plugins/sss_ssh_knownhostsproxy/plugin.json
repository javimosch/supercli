{
  "name": "sss_ssh_knownhostsproxy",
  "version": "0.1.0",
  "description": "CLI tool: sss_ssh_knownhostsproxy",
  "source": "https://manpages.debian.org/sss_ssh_knownhostsproxy",
  "checks": [
    {
      "type": "binary",
      "name": "sss_ssh_knownhostsproxy"
    }
  ],
  "install_guidance": {
    "plugin": "sss_ssh_knownhostsproxy",
    "binary": "sss_ssh_knownhostsproxy",
    "check": "which sss_ssh_knownhostsproxy",
    "install_steps": [
      "apt-get install sss_ssh_knownhostsproxy 2>/dev/null || which sss_ssh_knownhostsproxy",
      "Verify: sss_ssh_knownhostsproxy --version",
      "supercli plugins install ./plugins/sss_ssh_knownhostsproxy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sss_ssh_knownhostsproxy",
      "resource": "self",
      "action": "version",
      "description": "Print sss_ssh_knownhostsproxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sss_ssh_knownhostsproxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sss_ssh_knownhostsproxy: apt-get install sss_ssh_knownhostsproxy 2>/dev/null || which sss_ssh_knownhostsproxy"
      },
      "args": []
    },
    {
      "namespace": "sss_ssh_knownhostsproxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sss_ssh_knownhostsproxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sss_ssh_knownhostsproxy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sss_ssh_knownhostsproxy: apt-get install sss_ssh_knownhostsproxy 2>/dev/null || which sss_ssh_knownhostsproxy"
      },
      "args": []
    }
  ]
}