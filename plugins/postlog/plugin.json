{
  "name": "postlog",
  "version": "1.0.0",
  "description": "postlog \u2014 postlog \u2014 CLI utility",
  "source": "/usr/sbin/postlog",
  "checks": [
    {
      "type": "binary",
      "name": "postlog"
    }
  ],
  "install_guidance": {
    "plugin": "postlog",
    "binary": "postlog",
    "check": "which postlog",
    "install_steps": [
      "# Install postlog:",
      "# apt: sudo apt-get install postlog",
      "# brew: brew install postlog",
      "# cargo: cargo install postlog",
      "# npm: npm install -g postlog",
      "# pip: pip install postlog",
      "# or download from /usr/sbin/postlog"
    ]
  },
  "commands": [
    {
      "namespace": "postlog",
      "resource": "postlog",
      "action": "run",
      "description": "Run postlog",
      "adapter": "process",
      "adapterConfig": {
        "command": "postlog",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postlog from /usr/sbin/postlog"
      },
      "args": []
    }
  ]
}