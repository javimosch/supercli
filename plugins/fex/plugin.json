{
  "name": "fex",
  "version": "0.1.0",
  "description": "A command-line file explorer prioritizing quick navigation.",
  "source": "https://github.com/fex/fex",
  "checks": [
    {
      "type": "binary",
      "name": "fex"
    }
  ],
  "install_guidance": {
    "plugin": "fex",
    "binary": "fex",
    "check": "which fex",
    "install_steps": [
      "pip install fex",
      "Verify: fex --version",
      "supercli plugins install ./plugins/fex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fex",
      "resource": "self",
      "action": "version",
      "description": "Print fex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fex: pip install fex"
      },
      "args": []
    },
    {
      "namespace": "fex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fex",
        "passthrough": true,
        "missingDependencyHelp": "Install fex: pip install fex"
      },
      "args": []
    }
  ]
}