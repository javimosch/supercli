{
  "name": "reaver",
  "version": "0.1.0",
  "description": "WPS PIN attack tool for wireless testing",
  "source": "https://github.com/t6x/reaver-wps-fork-t6x",
  "checks": [
    {
      "type": "binary",
      "name": "reaver"
    }
  ],
  "install_guidance": {
    "plugin": "reaver",
    "binary": "reaver",
    "check": "which reaver",
    "install_steps": [
      "brew install reaver",
      "Verify: reaver --version",
      "supercli plugins install ./plugins/reaver --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "reaver",
      "resource": "self",
      "action": "version",
      "description": "Print reaver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "reaver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install reaver: brew install reaver"
      },
      "args": []
    },
    {
      "namespace": "reaver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to reaver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "reaver",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install reaver: brew install reaver"
      },
      "args": []
    }
  ]
}
