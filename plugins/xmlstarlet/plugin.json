{
  "name": "xmlstarlet",
  "version": "0.1.0",
  "description": "XMLStarlet — XML command-line toolkit for querying, editing, transforming, and validating XML documents. Supports XPath, XSLT, XInclude, XSD validation, and namespace-aware operations.",
  "source": "https://github.com/abandis/xmlstarlet",
  "checks": [
    {
      "type": "binary",
      "name": "xmlstarlet"
    }
  ],
  "install_guidance": {
    "plugin": "xmlstarlet",
    "binary": "xmlstarlet",
    "check": "which xmlstarlet",
    "install_steps": [
      "brew install xmlstarlet",
      "Verify: xmlstarlet --version",
      "supercli plugins install ./plugins/xmlstarlet --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "xmlstarlet",
      "resource": "self",
      "action": "version",
      "description": "Print xmlstarlet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlstarlet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xmlstarlet: brew install xmlstarlet"
      },
      "args": []
    },
    {
      "namespace": "xmlstarlet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xmlstarlet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlstarlet",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xmlstarlet: brew install xmlstarlet"
      },
      "args": []
    }
  ]
}
