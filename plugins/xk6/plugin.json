{
  "name": "xk6",
  "version": "0.1.0",
  "description": "Custom k6 builder to create k6 binaries with extensions",
  "source": "https://github.com/grafana/xk6",
  "checks": [{ "type": "binary", "name": "xk6" }],
  "install_guidance": {
    "plugin": "xk6",
    "binary": "xk6",
    "check": "which xk6",
    "install_steps": ["go install go.k6.io/xk6/cmd/xk6@latest", "Verify: xk6 --version", "supercli plugins install ./plugins/xk6 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "xk6",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to xk6 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "xk6",
      "passthrough": true,
      "missingDependencyHelp": "Install xk6: go install go.k6.io/xk6/cmd/xk6@latest"
    },
    "args": []
  }]
}
