{
  "name": "ctie",
  "version": "0.1.0",
  "description": "merge or apply CWEB change files (texlive-binaries)",
  "source": "https://packages.debian.org/ctie",
  "checks": [{ "type": "binary", "name": "ctie" }],
  "install_guidance": {
    "plugin": "ctie", "binary": "ctie", "check": "which ctie",
    "install_steps": ["apt-get install ctie 2>/dev/null || which ctie", "Verify: ctie --version", "supercli plugins install ./plugins/ctie --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctie", "resource": "_", "action": "_",
    "description": "Passthrough to ctie CLI",
    "adapter": "process", "adapterConfig": { "command": "ctie", "passthrough": true, "missingDependencyHelp": "Install ctie: apt-get install ctie" }, "args": []
  }]
}
