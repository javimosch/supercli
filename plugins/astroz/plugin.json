{
  "name": "astroz",
  "version": "0.1.0",
  "description": "Astrodynamics and Spacecraft Toolkit. Features fast orbit prop, celestial precession, CCSDS parsing,",
  "source": "https://github.com/astroz/astroz",
  "checks": [
    {
      "type": "binary",
      "name": "astroz"
    }
  ],
  "install_guidance": {
    "plugin": "astroz",
    "binary": "astroz",
    "check": "which astroz",
    "install_steps": [
      "pip install astroz",
      "Verify: astroz --version",
      "supercli plugins install ./plugins/astroz --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "astroz",
      "resource": "self",
      "action": "version",
      "description": "Print astroz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "astroz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install astroz: pip install astroz"
      },
      "args": []
    },
    {
      "namespace": "astroz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to astroz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "astroz",
        "passthrough": true,
        "missingDependencyHelp": "Install astroz: pip install astroz"
      },
      "args": []
    }
  ]
}