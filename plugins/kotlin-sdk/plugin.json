{
  "name": "kotlin-sdk",
  "version": "0.1.0",
  "description": "The official Kotlin SDK for Model Context Protocol servers and clients. Maintained in collaboration ",
  "source": "https://github.com/kotlin-sdk/kotlin-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "kotlin-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "kotlin-sdk",
    "binary": "kotlin-sdk",
    "check": "which kotlin-sdk",
    "install_steps": [
      "pip install kotlin-sdk",
      "Verify: kotlin-sdk --version",
      "supercli plugins install ./plugins/kotlin-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kotlin-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print kotlin-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kotlin-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kotlin-sdk: pip install kotlin-sdk"
      },
      "args": []
    },
    {
      "namespace": "kotlin-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kotlin-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kotlin-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install kotlin-sdk: pip install kotlin-sdk"
      },
      "args": []
    }
  ]
}