{
  "name": "cvt",
  "version": "0.1.0",
  "description": "CLI tool: cvt",
  "source": "https://packages.debian.org/cvt",
  "checks": [{ "type": "binary", "name": "cvt" }],
  "install_guidance": {
    "plugin": "cvt", "binary": "cvt", "check": "which cvt",
    "install_steps": ["apt-get install cvt 2>/dev/null || which cvt", "Verify: cvt --version", "supercli plugins install ./plugins/cvt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cvt", "resource": "_", "action": "_",
    "description": "Passthrough to cvt CLI",
    "adapter": "process", "adapterConfig": { "command": "cvt", "passthrough": true, "missingDependencyHelp": "Install cvt: apt-get install cvt" }, "args": []
  }]
}
