{
  "name": "xfrun4",
  "version": "0.1.0",
  "description": "CLI tool: xfrun4",
  "source": "https://manpages.debian.org/xfrun4",
  "checks": [
    {
      "type": "binary",
      "name": "xfrun4"
    }
  ],
  "install_guidance": {
    "plugin": "xfrun4",
    "binary": "xfrun4",
    "check": "which xfrun4",
    "install_steps": [
      "apt-get install xfrun4 2>/dev/null || which xfrun4",
      "Verify: xfrun4 --version",
      "supercli plugins install ./plugins/xfrun4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfrun4",
      "resource": "self",
      "action": "version",
      "description": "Print xfrun4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfrun4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfrun4: apt-get install xfrun4 2>/dev/null || which xfrun4"
      },
      "args": []
    },
    {
      "namespace": "xfrun4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfrun4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfrun4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfrun4: apt-get install xfrun4 2>/dev/null || which xfrun4"
      },
      "args": []
    }
  ]
}