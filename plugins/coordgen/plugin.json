{
  "name": "coordgen",
  "version": "0.1.0",
  "description": "Schrodinger-developed 2D Coordinate Generation",
  "source": "https://github.com/schrodinger/coordgenlibs",
  "checks": [
    {
      "type": "binary",
      "name": "coordgen"
    }
  ],
  "install_guidance": {
    "plugin": "coordgen",
    "binary": "coordgen",
    "check": "which coordgen",
    "install_steps": [
      "brew install coordgen",
      "Verify: coordgen --version",
      "supercli plugins install ./plugins/coordgen --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "coordgen",
      "resource": "self",
      "action": "version",
      "description": "Print coordgen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coordgen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coordgen: brew install coordgen"
      },
      "args": []
    },
    {
      "namespace": "coordgen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coordgen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coordgen",
        "passthrough": true,
        "missingDependencyHelp": "Install coordgen"
      },
      "args": []
    }
  ]
}