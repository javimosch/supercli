{
  "name": "mediafetch-go",
  "version": "0.1.0",
  "description": "Lightweight Go package for media metadata and downloading",
  "source": "go",
  "checks": [{ "type": "binary", "name": "mediafetch-go" }],
  "install_guidance": {
    "plugin": "mediafetch-go",
    "binary": "mediafetch-go",
    "check": "which mediafetch-go",
    "install_steps": ["go install github.com/mediafetch-go@latest", "Verify: mediafetch-go --version", "supercli plugins install ./plugins/mediafetch-go --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mediafetch-go",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mediafetch-go CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mediafetch-go",
      "passthrough": true,
      "missingDependencyHelp": "Install mediafetch-go: go install github.com/mediafetch-go@latest"
    },
    "args": []
  }]
}
