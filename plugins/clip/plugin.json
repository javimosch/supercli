{
  "name": "clip",
  "version": "0.1.0",
  "description": "Create high-quality charts from the command-line",
  "source": "https://github.com/asmuth/clip",
  "checks": [
    {
      "type": "binary",
      "name": "clip"
    }
  ],
  "install_guidance": {
    "plugin": "clip",
    "binary": "clip",
    "check": "which clip",
    "install_steps": [
      "brew install clip",
      "Verify: clip --version",
      "supercli plugins install ./plugins/clip --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clip",
      "resource": "self",
      "action": "version",
      "description": "Print clip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clip: brew install clip"
      },
      "args": []
    },
    {
      "namespace": "clip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clip",
        "passthrough": true,
        "missingDependencyHelp": "Install clip"
      },
      "args": []
    }
  ]
}