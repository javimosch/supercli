{
  "name": "scalpel",
  "version": "0.1.0",
  "description": "A surgical debugging tool to uncover the layers under your app.",
  "source": "https://github.com/scalpel/scalpel",
  "checks": [
    {
      "type": "binary",
      "name": "scalpel"
    }
  ],
  "install_guidance": {
    "plugin": "scalpel",
    "binary": "scalpel",
    "check": "which scalpel",
    "install_steps": [
      "Download from https://github.com/scalpel/scalpel/releases",
      "Verify: scalpel --version",
      "supercli plugins install ./plugins/scalpel --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "scalpel",
      "resource": "self",
      "action": "version",
      "description": "Print scalpel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scalpel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scalpel from GitHub releases"
      },
      "args": []
    },
    {
      "namespace": "scalpel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scalpel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scalpel",
        "passthrough": true,
        "missingDependencyHelp": "Install scalpel from GitHub releases"
      },
      "args": []
    }
  ]
}
