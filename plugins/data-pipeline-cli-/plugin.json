{
  "name": "data-pipeline-cli-",
  "version": "0.1.0",
  "description": "A command -line tool for cleaning and inspecting csv datasets",
  "source": "https://github.com/data-pipeline-cli-/data-pipeline-cli-",
  "checks": [
    {
      "type": "binary",
      "name": "data-pipeline-cli-"
    }
  ],
  "install_guidance": {
    "plugin": "data-pipeline-cli-",
    "binary": "data-pipeline-cli-",
    "check": "which data-pipeline-cli-",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: data-pipeline-cli- --version",
      "supercli plugins install ./plugins/data-pipeline-cli- --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "data-pipeline-cli-",
      "resource": "self",
      "action": "version",
      "description": "Print data-pipeline-cli- version",
      "adapter": "process",
      "adapterConfig": {
        "command": "data-pipeline-cli-",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install data-pipeline-cli- from project repository"
      },
      "args": []
    },
    {
      "namespace": "data-pipeline-cli-",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to data-pipeline-cli- CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "data-pipeline-cli-",
        "passthrough": true,
        "missingDependencyHelp": "Install data-pipeline-cli- from project repository"
      },
      "args": []
    }
  ]
}