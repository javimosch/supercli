{
  "name": "kwt",
  "version": "0.1.0",
  "description": "Kubernetes workstation tools for cluster exploration",
  "source": "https://github.com/carvel-dev/kwt",
  "checks": [{ "type": "binary", "name": "kwt" }],
  "install_guidance": {
    "plugin": "kwt",
    "binary": "kwt",
    "check": "which kwt",
    "install_steps": ["brew install kwt", "Verify: kwt --version", "supercli plugins install ./plugins/kwt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kwt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kwt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kwt",
      "passthrough": true,
      "missingDependencyHelp": "Install kwt: brew install kwt"
    },
    "args": []
  }]
}
