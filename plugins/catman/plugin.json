{
  "name": "catman",
  "version": "0.1.0",
  "description": "CLI tool: catman",
  "source": "https://packages.debian.org/catman",
  "checks": [{ "type": "binary", "name": "catman" }],
  "install_guidance": {
    "plugin": "catman", "binary": "catman", "check": "which catman",
    "install_steps": ["apt-get install catman 2>/dev/null || which catman", "Verify: catman --version", "supercli plugins install ./plugins/catman --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "catman", "resource": "_", "action": "_",
    "description": "Passthrough to catman CLI",
    "adapter": "process", "adapterConfig": { "command": "catman", "passthrough": true, "missingDependencyHelp": "Install catman: apt-get install catman" }, "args": []
  }]
}
