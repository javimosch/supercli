{
  "name": "dee-qr",
  "version": "0.1.0",
  "description": "Generate and decode QR codes from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-qr" }],
  "install_guidance": {
    "plugin": "dee-qr",
    "binary": "dee-qr",
    "check": "which dee-qr",
    "install_steps": ["cargo install dee-qr", "Verify: dee-qr --version", "supercli plugins install ./plugins/dee-qr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-qr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-qr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-qr",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-qr: cargo install dee-qr"
    },
    "args": []
  }]
}
