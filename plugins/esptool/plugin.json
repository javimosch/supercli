{
  "name": "esptool",
  "version": "0.1.0",
  "description": "ESP8266 and ESP32 serial bootloader utility",
  "checks": [
    {
      "type": "binary",
      "name": "esptool"
    }
  ],
  "install_guidance": {
    "plugin": "esptool",
    "binary": "esptool",
    "check": "which esptool",
    "install_steps": [
      "brew install esptool",
      "Verify: esptool --version",
      "supercli plugins install ./plugins/esptool --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "esptool",
      "resource": "self",
      "action": "version",
      "description": "Print esptool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "esptool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install esptool: brew install esptool"
      },
      "args": []
    },
    {
      "namespace": "esptool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to esptool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "esptool",
        "passthrough": true,
        "missingDependencyHelp": "Install esptool"
      },
      "args": []
    }
  ]
}