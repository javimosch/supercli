{
  "name": "PeerBanHelper",
  "version": "0.1.0",
  "description": "Automatically block unwanted, leeches and abnormal BT peers with support for customized and cloud rules.| BT 反吸血工具 - 自动封禁不受欢迎、吸血和异常的 BT 客户端，并支持自定义规则。支持 qB/qBEE/Deluge/BiglyBT/BitComet",
  "source": "https://github.com/PeerBanHelper/PeerBanHelper",
  "checks": [
    {
      "type": "binary",
      "name": "peerbanhelper"
    }
  ],
  "install_guidance": {
    "plugin": "PeerBanHelper",
    "binary": "peerbanhelper",
    "check": "which peerbanhelper",
    "install_steps": [
      "pip install peerbanhelper",
      "Verify: peerbanhelper --version",
      "supercli plugins install ./plugins/PeerBanHelper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PeerBanHelper",
      "resource": "self",
      "action": "version",
      "description": "Print PeerBanHelper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "peerbanhelper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PeerBanHelper: pip install peerbanhelper"
      },
      "args": []
    },
    {
      "namespace": "PeerBanHelper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to peerbanhelper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "peerbanhelper",
        "passthrough": true,
        "missingDependencyHelp": "Install PeerBanHelper: pip install peerbanhelper"
      },
      "args": []
    }
  ]
}