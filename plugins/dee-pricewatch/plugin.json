{
  "name": "dee-pricewatch",
  "version": "0.1.0",
  "description": "Monitor webpage prices from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-pricewatch" }],
  "install_guidance": {
    "plugin": "dee-pricewatch",
    "binary": "dee-pricewatch",
    "check": "which dee-pricewatch",
    "install_steps": ["cargo install dee-pricewatch", "Verify: dee-pricewatch --version", "supercli plugins install ./plugins/dee-pricewatch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-pricewatch",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-pricewatch CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-pricewatch",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-pricewatch: cargo install dee-pricewatch"
    },
    "args": []
  }]
}
