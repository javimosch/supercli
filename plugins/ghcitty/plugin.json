{
  "name": "ghcitty",
  "version": "0.1.0",
  "description": "Fast, friendly GHCi",
  "source": "https://github.com/mattlianje/ghcitty",
  "checks": [
    {
      "type": "binary",
      "name": "ghcitty"
    }
  ],
  "install_guidance": {
    "plugin": "ghcitty",
    "binary": "ghcitty",
    "check": "which ghcitty",
    "install_steps": [
      "brew install ghcitty",
      "Verify: ghcitty --version",
      "supercli plugins install ./plugins/ghcitty --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ghcitty",
      "resource": "self",
      "action": "version",
      "description": "Print ghcitty version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghcitty",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ghcitty: brew install ghcitty"
      },
      "args": []
    },
    {
      "namespace": "ghcitty",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghcitty CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghcitty",
        "passthrough": true,
        "missingDependencyHelp": "Install ghcitty"
      },
      "args": []
    }
  ]
}