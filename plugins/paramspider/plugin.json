{
  "name": "paramspider",
  "version": "0.1.0",
  "description": "Parameter spider for web application testing",
  "source": "https://github.com/devanshbatham/ParamSpider",
  "checks": [
    {
      "type": "binary",
      "name": "paramspider"
    }
  ],
  "install_guidance": {
    "plugin": "paramspider",
    "binary": "paramspider",
    "check": "which paramspider",
    "install_steps": [
      "pip install paramspider",
      "Verify: paramspider --version",
      "supercli plugins install ./plugins/paramspider --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "paramspider",
      "resource": "self",
      "action": "version",
      "description": "Print paramspider version",
      "adapter": "process",
      "adapterConfig": {
        "command": "paramspider",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install paramspider: pip install paramspider"
      },
      "args": []
    },
    {
      "namespace": "paramspider",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to paramspider CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "paramspider",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install paramspider: pip install paramspider"
      },
      "args": []
    }
  ]
}
