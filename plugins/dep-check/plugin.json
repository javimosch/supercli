{
  "name": "dep-check",
  "version": "0.1.0",
  "description": "Small-scale vulnerability and dependency scanner",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "dep-check" }],
  "install_guidance": {
    "plugin": "dep-check",
    "binary": "dep-check",
    "check": "which dep-check",
    "install_steps": ["npm install -g dep-check", "Verify: dep-check --version", "supercli plugins install ./plugins/dep-check --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dep-check",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dep-check CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dep-check",
      "passthrough": true,
      "missingDependencyHelp": "Install dep-check: npm install -g dep-check"
    },
    "args": []
  }]
}
