{
  "name": "tg-cli",
  "version": "0.1.0",
  "description": "tg-cli — Telegram CLI for local-first sync, search, export via MTProto with JSON/YAML output",
  "source": "https://github.com/public-clis/tg-cli",
  "checks": [
    { "type": "binary", "name": "tg" }
  ],
  "install_guidance": {
    "plugin": "tg-cli",
    "binary": "tg",
    "check": "which tg",
    "install_steps": [
      "uv tool install kabi-tg-cli",
      "Verify: tg --version",
      "supercli plugins install ./plugins/tg-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tg-cli",
      "resource": "self",
      "action": "version",
      "description": "Print tg-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tg",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install tg-cli: uv tool install kabi-tg-cli"
      },
      "args": []
    },
    {
      "namespace": "tg-cli",
      "resource": "self",
      "action": "status",
      "description": "Check account and sync status",
      "adapter": "process",
      "adapterConfig": {
        "command": "tg",
        "baseArgs": ["status", "--yaml"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tg-cli"
      },
      "args": []
    },
    {
      "namespace": "tg-cli",
      "resource": "chats",
      "action": "list",
      "description": "List Telegram chats",
      "adapter": "process",
      "adapterConfig": {
        "command": "tg",
        "baseArgs": ["chats", "--yaml"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tg-cli"
      },
      "args": []
    },
    {
      "namespace": "tg-cli",
      "resource": "search",
      "action": "run",
      "description": "Search messages by keyword",
      "adapter": "process",
      "adapterConfig": {
        "command": "tg",
        "baseArgs": ["search"],
        "positionalArgs": ["query"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tg-cli"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search keyword or regex" }
      ]
    },
    {
      "namespace": "tg-cli",
      "resource": "recent",
      "action": "list",
      "description": "List recent messages",
      "adapter": "process",
      "adapterConfig": {
        "command": "tg",
        "baseArgs": ["recent", "--yaml"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tg-cli"
      },
      "args": [
        { "name": "hours", "type": "string", "required": false, "description": "Hours to look back (e.g., 24)" },
        { "name": "limit", "type": "string", "required": false, "description": "Max messages" }
      ]
    },
    {
      "namespace": "tg-cli",
      "resource": "refresh",
      "action": "run",
      "description": "Refresh local Telegram cache",
      "adapter": "process",
      "adapterConfig": {
        "command": "tg",
        "baseArgs": ["refresh", "--yaml"],
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install tg-cli"
      },
      "args": []
    },
    {
      "namespace": "tg-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tg",
        "passthrough": true,
        "missingDependencyHelp": "Install tg-cli"
      },
      "args": []
    }
  ]
}
