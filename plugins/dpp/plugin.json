{
  "name": "dpp",
  "version": "0.1.0",
  "description": "Directly include C headers in D source code",
  "source": "https://github.com/atilaneves/dpp",
  "checks": [
    {
      "type": "binary",
      "name": "dpp"
    }
  ],
  "install_guidance": {
    "plugin": "dpp",
    "binary": "dpp",
    "check": "which dpp",
    "install_steps": [
      "brew install dpp",
      "Verify: dpp --version",
      "supercli plugins install ./plugins/dpp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dpp",
      "resource": "self",
      "action": "version",
      "description": "Print dpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dpp: brew install dpp"
      },
      "args": []
    },
    {
      "namespace": "dpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dpp",
        "passthrough": true,
        "missingDependencyHelp": "Install dpp"
      },
      "args": []
    }
  ]
}