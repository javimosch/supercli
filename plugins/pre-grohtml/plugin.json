{
  "name": "pre-grohtml",
  "version": "0.1.0",
  "description": "CLI tool: pre-grohtml",
  "source": "https://manpages.debian.org/pre-grohtml",
  "checks": [
    {
      "type": "binary",
      "name": "pre-grohtml"
    }
  ],
  "install_guidance": {
    "plugin": "pre-grohtml",
    "binary": "pre-grohtml",
    "check": "which pre-grohtml",
    "install_steps": [
      "apt-get install pre-grohtml 2>/dev/null || which pre-grohtml",
      "Verify: pre-grohtml --version",
      "supercli plugins install ./plugins/pre-grohtml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pre-grohtml",
      "resource": "self",
      "action": "version",
      "description": "Print pre-grohtml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pre-grohtml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pre-grohtml: apt-get install pre-grohtml 2>/dev/null || which pre-grohtml"
      },
      "args": []
    },
    {
      "namespace": "pre-grohtml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pre-grohtml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pre-grohtml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pre-grohtml: apt-get install pre-grohtml 2>/dev/null || which pre-grohtml"
      },
      "args": []
    }
  ]
}