{
  "name": "icuexportdata",
  "version": "0.1.0",
  "description": "CLI tool: icuexportdata",
  "source": "https://manpages.debian.org/icuexportdata",
  "checks": [
    {
      "type": "binary",
      "name": "icuexportdata"
    }
  ],
  "install_guidance": {
    "plugin": "icuexportdata",
    "binary": "icuexportdata",
    "check": "which icuexportdata",
    "install_steps": [
      "apt-get install icuexportdata 2>/dev/null || which icuexportdata",
      "Verify: icuexportdata --version",
      "supercli plugins install ./plugins/icuexportdata --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "icuexportdata",
      "resource": "self",
      "action": "version",
      "description": "Print icuexportdata version",
      "adapter": "process",
      "adapterConfig": {
        "command": "icuexportdata",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install icuexportdata: apt-get install icuexportdata 2>/dev/null || which icuexportdata"
      },
      "args": []
    },
    {
      "namespace": "icuexportdata",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to icuexportdata CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "icuexportdata",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install icuexportdata: apt-get install icuexportdata 2>/dev/null || which icuexportdata"
      },
      "args": []
    }
  ]
}