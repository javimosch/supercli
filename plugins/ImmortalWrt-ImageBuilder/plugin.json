{
  "name": "ImmortalWrt-ImageBuilder",
  "version": "0.1.0",
  "description": "\u5b83\u662f\u4e00\u4e2a\u5de5\u4f5c\u6d41\u3002\u53ef\u5feb\u901f\u6784\u5efa \u53ef\u9009docker\u3001\u53ef\u9009\u81ea\u5b9a\u4e49\u56fa\u4ef6\u5927\u5c0f\u7684 immortalWrt\u3002\u5b83\u76f8\u5f53\u4e8e\u4e00\u4e2a\u4e91\u7aef\u7684ImageBuilder,\u5c5e\u4e8e\u6784\u5efa\u7684\u8303\u7574,\u4e0d\u7b97\u662f\u7f16\u8bd1\u3002\u76ee\u524d\u4e5f\u652f\u6301\u7b2c\u4e09\u65b9\u63d2\u4ef6\u7684\u6309\u9700\u96c6\u6210\u3002",
  "source": "https://github.com/ImmortalWrt-ImageBuilder/ImmortalWrt-ImageBuilder",
  "checks": [
    {
      "type": "binary",
      "name": "immortalwrt-imagebuilder"
    }
  ],
  "install_guidance": {
    "plugin": "ImmortalWrt-ImageBuilder",
    "binary": "immortalwrt-imagebuilder",
    "check": "which immortalwrt-imagebuilder",
    "install_steps": [
      "pip install immortalwrt-imagebuilder",
      "Verify: immortalwrt-imagebuilder --version",
      "supercli plugins install ./plugins/ImmortalWrt-ImageBuilder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ImmortalWrt-ImageBuilder",
      "resource": "self",
      "action": "version",
      "description": "Print ImmortalWrt-ImageBuilder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "immortalwrt-imagebuilder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ImmortalWrt-ImageBuilder: pip install immortalwrt-imagebuilder"
      },
      "args": []
    },
    {
      "namespace": "ImmortalWrt-ImageBuilder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to immortalwrt-imagebuilder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "immortalwrt-imagebuilder",
        "passthrough": true,
        "missingDependencyHelp": "Install ImmortalWrt-ImageBuilder: pip install immortalwrt-imagebuilder"
      },
      "args": []
    }
  ]
}