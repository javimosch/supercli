{
  "name": "dbmate",
  "version": "0.1.0",
  "description": "Lightweight framework-agnostic database migration tool",
  "source": "https://github.com/amacneil/dbmate",
  "checks": [{ "type": "binary", "name": "dbmate" }],
  "install_guidance": {
    "plugin": "dbmate",
    "binary": "dbmate",
    "check": "which dbmate",
    "install_steps": ["brew install dbmate", "Verify: dbmate --version", "supercli plugins install ./plugins/dbmate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dbmate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dbmate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dbmate",
      "passthrough": true,
      "missingDependencyHelp": "Install dbmate: brew install dbmate"
    },
    "args": []
  }]
}
