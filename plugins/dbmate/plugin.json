{
  "name": "dbmate",
  "version": "1.0.0",
  "description": "dbmate \u2014 Database migration",
  "source": "github.com/amacneil/dbmate",
  "checks": [
    {
      "type": "binary",
      "name": "dbmate"
    }
  ],
  "install_guidance": {
    "plugin": "dbmate",
    "binary": "dbmate",
    "check": "which dbmate",
    "install_steps": [
      "# Install dbmate",
      "# See github.com/amacneil/dbmate",
      "# apt: sudo apt-get install dbmate",
      "# brew: brew install dbmate",
      "# cargo: cargo install dbmate",
      "# npm: npm install -g dbmate",
      "# pip: pip install dbmate"
    ]
  },
  "commands": [
    {
      "namespace": "dbmate",
      "resource": "dbmate",
      "action": "run",
      "description": "Run dbmate",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbmate",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dbmate from github.com/amacneil/dbmate"
      },
      "args": []
    }
  ]
}