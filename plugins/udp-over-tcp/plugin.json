{
  "name": "udp-over-tcp",
  "version": "0.1.0",
  "description": "Tunnel UDP datagrams over TCP for restricted network environments",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "udp-over-tcp" }],
  "install_guidance": {
    "plugin": "udp-over-tcp",
    "binary": "udp-over-tcp",
    "check": "which udp-over-tcp",
    "install_steps": ["cargo install udp-over-tcp", "Verify: udp-over-tcp --version", "supercli plugins install ./plugins/udp-over-tcp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "udp-over-tcp",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to udp-over-tcp CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "udp-over-tcp",
      "passthrough": true,
      "missingDependencyHelp": "Install udp-over-tcp: cargo install udp-over-tcp"
    },
    "args": []
  }]
}
