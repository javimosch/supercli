{
  "name": "qft",
  "version": "0.1.0",
  "description": "A peer-to-peer file transfer tool using UDP for high-speed data exchange. Transfers files directly between machines without intermediate servers.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "qft"
    }
  ],
  "install_guidance": {
    "plugin": "qft",
    "binary": "qft",
    "check": "which qft",
    "install_steps": [
      "cargo install qft",
      "Verify: qft --version",
      "supercli plugins install ./plugins/qft --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qft",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qft CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qft",
        "passthrough": true,
        "missingDependencyHelp": "Install qft: cargo install qft"
      },
      "args": []
    }
  ]
}
