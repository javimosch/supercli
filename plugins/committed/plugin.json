{
  "name": "committed",
  "version": "0.1.0",
  "description": "Nitpicking commit history since beabf39",
  "source": "https://github.com/crate-ci/committed",
  "checks": [
    {
      "type": "binary",
      "name": "committed"
    }
  ],
  "install_guidance": {
    "plugin": "committed",
    "binary": "committed",
    "check": "which committed",
    "install_steps": [
      "brew install committed",
      "Verify: committed --version",
      "supercli plugins install ./plugins/committed --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "committed",
      "resource": "self",
      "action": "version",
      "description": "Print committed version",
      "adapter": "process",
      "adapterConfig": {
        "command": "committed",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install committed: brew install committed"
      },
      "args": []
    },
    {
      "namespace": "committed",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to committed CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "committed",
        "passthrough": true,
        "missingDependencyHelp": "Install committed"
      },
      "args": []
    }
  ]
}