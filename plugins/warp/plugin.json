{
  "name": "warp",
  "version": "0.1.0",
  "description": "Secure and simple terminal sharing",
  "source": "https://github.com/spolu/warp",
  "checks": [
    {
      "type": "binary",
      "name": "warp"
    }
  ],
  "install_guidance": {
    "plugin": "warp",
    "binary": "warp",
    "check": "which warp",
    "install_steps": [
      "See https://github.com/spolu/warp",
      "Verify: warp --version",
      "supercli plugins install ./plugins/warp --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "warp",
      "resource": "self",
      "action": "version",
      "description": "Print warp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "warp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install warp: See https://github.com/spolu/warp"
      },
      "args": []
    },
    {
      "namespace": "warp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to warp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "warp",
        "passthrough": true,
        "missingDependencyHelp": "Install warp"
      },
      "args": []
    }
  ]
}