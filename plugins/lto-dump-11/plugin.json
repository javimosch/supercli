{
  "name": "lto-dump-11",
  "version": "0.1.0",
  "description": "CLI tool: lto-dump-11",
  "source": "https://manpages.debian.org/lto-dump-11",
  "checks": [
    {
      "type": "binary",
      "name": "lto-dump-11"
    }
  ],
  "install_guidance": {
    "plugin": "lto-dump-11",
    "binary": "lto-dump-11",
    "check": "which lto-dump-11",
    "install_steps": [
      "apt-get install lto-dump-11 2>/dev/null || which lto-dump-11",
      "Verify: lto-dump-11 --version",
      "supercli plugins install ./plugins/lto-dump-11 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lto-dump-11",
      "resource": "self",
      "action": "version",
      "description": "Print lto-dump-11 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lto-dump-11",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lto-dump-11: apt-get install lto-dump-11 2>/dev/null || which lto-dump-11"
      },
      "args": []
    },
    {
      "namespace": "lto-dump-11",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lto-dump-11 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lto-dump-11",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lto-dump-11: apt-get install lto-dump-11 2>/dev/null || which lto-dump-11"
      },
      "args": []
    }
  ]
}