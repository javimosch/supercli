{
  "name": "transdep",
  "version": "0.1.0",
  "description": "Analyze DNS dependency graphs to discover single points of failure",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "transdep" }],
  "install_guidance": {
    "plugin": "transdep",
    "binary": "transdep",
    "check": "which transdep",
    "install_steps": ["make all", "Verify: transdep --version", "supercli plugins install ./plugins/transdep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "transdep",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to transdep CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "transdep",
      "passthrough": true,
      "missingDependencyHelp": "Install transdep: make all"
    },
    "args": []
  }]
}
