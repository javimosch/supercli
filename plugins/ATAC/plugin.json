{
  "name": "ATAC",
  "version": "0.1.0",
  "description": "A simple API client (postman like) in your terminal",
  "source": "https://github.com/ATAC/ATAC",
  "checks": [
    {
      "type": "binary",
      "name": "atac"
    }
  ],
  "install_guidance": {
    "plugin": "ATAC",
    "binary": "atac",
    "check": "which atac",
    "install_steps": [
      "pip install atac",
      "Verify: atac --version",
      "supercli plugins install ./plugins/ATAC --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ATAC",
      "resource": "self",
      "action": "version",
      "description": "Print ATAC version",
      "adapter": "process",
      "adapterConfig": {
        "command": "atac",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ATAC: pip install atac"
      },
      "args": []
    },
    {
      "namespace": "ATAC",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to atac CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "atac",
        "passthrough": true,
        "missingDependencyHelp": "Install ATAC: pip install atac"
      },
      "args": []
    }
  ]
}