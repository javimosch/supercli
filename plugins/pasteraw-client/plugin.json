{
  "name": "pasteraw-client",
  "version": "0.1.0",
  "description": "Pipe stdin to a raw pastebin.",
  "source": "https://pypi.python.org/pypi/pasteraw",
  "checks": [
    {
      "type": "binary",
      "name": "pasteraw-client"
    }
  ],
  "install_guidance": {
    "plugin": "pasteraw-client",
    "binary": "pasteraw-client",
    "check": "which pasteraw-client",
    "install_steps": [
      "Check https://pypi.python.org/pypi/pasteraw for installation instructions",
      "Verify: pasteraw-client --version",
      "supercli plugins install ./plugins/pasteraw-client --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "pasteraw-client",
      "resource": "self",
      "action": "version",
      "description": "Print pasteraw-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pasteraw-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pasteraw-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "pasteraw-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pasteraw-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pasteraw-client",
        "passthrough": true,
        "missingDependencyHelp": "Install pasteraw-client from project repository"
      },
      "args": []
    }
  ]
}