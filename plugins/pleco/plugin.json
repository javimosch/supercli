{
  "name": "pleco",
  "version": "0.1.0",
  "description": "Rust chess engine with CLI for board analysis",
  "source": "https://github.com/pleco-rs/Pleco",
  "checks": [{ "type": "binary", "name": "pleco" }],
  "install_guidance": {
    "plugin": "pleco",
    "binary": "pleco",
    "check": "which pleco",
    "install_steps": ["cargo install pleco", "Verify: pleco --version", "supercli plugins install ./plugins/pleco --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pleco",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pleco CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pleco",
      "passthrough": true,
      "missingDependencyHelp": "Install pleco: cargo install pleco", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
