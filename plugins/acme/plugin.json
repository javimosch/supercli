{
  "name": "acme",
  "version": "0.1.0",
  "description": "Plan 9 text editor and window system from Bell Labs",
  "source": "https://9fans.github.io/plan9port/",
  "checks": [{ "type": "binary", "name": "acme" }],
  "install_guidance": {
    "plugin": "acme",
    "binary": "acme",
    "check": "which acme",
    "install_steps": ["brew install plan9port", "Verify: acme --version", "supercli plugins install ./plugins/acme --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "acme",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to acme CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "acme",
      "passthrough": true,
      "missingDependencyHelp": "Install acme: brew install plan9port", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
