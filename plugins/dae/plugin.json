{
  "name": "dae",
  "version": "0.1.0",
  "description": "eBPF-based Linux high-performance transparent proxy solution.",
  "source": "https://github.com/dae/dae",
  "checks": [
    {
      "type": "binary",
      "name": "dae"
    }
  ],
  "install_guidance": {
    "plugin": "dae",
    "binary": "dae",
    "check": "which dae",
    "install_steps": [
      "pip install dae",
      "Verify: dae --version",
      "supercli plugins install ./plugins/dae --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dae",
      "resource": "self",
      "action": "version",
      "description": "Print dae version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dae",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dae: pip install dae"
      },
      "args": []
    },
    {
      "namespace": "dae",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dae CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dae",
        "passthrough": true,
        "missingDependencyHelp": "Install dae: pip install dae"
      },
      "args": []
    }
  ]
}