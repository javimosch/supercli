{
  "name": "ai-code-review",
  "version": "0.1.0",
  "description": "AI-powered review tool with semantic chunking and structured analysis",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "ai-code-review" }],
  "install_guidance": {
    "plugin": "ai-code-review",
    "binary": "ai-code-review",
    "check": "which ai-code-review",
    "install_steps": ["npm install -g @bobmatnyc/ai-code-review", "Verify: ai-code-review --version", "supercli plugins install ./plugins/ai-code-review --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ai-code-review",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ai-code-review CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ai-code-review",
      "passthrough": true,
      "missingDependencyHelp": "Install ai-code-review: npm install -g @bobmatnyc/ai-code-review"
    },
    "args": []
  }]
}
