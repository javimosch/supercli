{
  "name": "litra",
  "version": "0.1.0",
  "description": "Control Logitech Litra lights from the command-line",
  "source": "https://github.com/timrogers/litra-rs",
  "checks": [
    {
      "type": "binary",
      "name": "litra"
    }
  ],
  "install_guidance": {
    "plugin": "litra",
    "binary": "litra",
    "check": "which litra",
    "install_steps": [
      "brew install litra",
      "Verify: litra --version",
      "supercli plugins install ./plugins/litra --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "litra",
      "resource": "self",
      "action": "version",
      "description": "Print litra version",
      "adapter": "process",
      "adapterConfig": {
        "command": "litra",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install litra: brew install litra"
      },
      "args": []
    },
    {
      "namespace": "litra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to litra CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "litra",
        "passthrough": true,
        "missingDependencyHelp": "Install litra"
      },
      "args": []
    }
  ]
}