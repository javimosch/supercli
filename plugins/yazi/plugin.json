{
  "name": "yazi",
  "description": "Blazing fast terminal file manager written in Rust",
  "version": "1.0.0",
  "binary": "yazi",
  "check": "yazi --version",
  "install": {
    "method": "cargo",
    "command": "cargo install --locked yazi-fm yazi-cli"
  },
  "commands": {
    "open": {
      "command": "yazi",
      "description": "Open yazi file manager in current directory"
    },
    "open-path": {
      "command": "yazi {path}",
      "description": "Open yazi at specific path",
      "args": ["path"]
    }
  }
}
