{
  "name": "yazi",
  "version": "1.0.0",
  "description": "Blazing fast terminal file manager written in Rust",
  "source": "https://github.com/sxyazi/yazi",
  "checks": [
    {
      "type": "binary",
      "name": "yazi"
    }
  ],
  "install_guidance": {
    "plugin": "yazi",
    "binary": "yazi",
    "check": "yazi --version",
    "install_steps": [
      "Install via cargo: cargo install --locked yazi-fm yazi-cli",
      "Or download prebuilt binary from GitHub releases",
      "For macOS: brew install yazi",
      "For Arch Linux: pacman -S yazi"
    ],
    "note": "Requires Rust toolchain for cargo install. Also installs ya (yazi CLI) for scripting."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yazi",
      "resource": "files",
      "action": "open",
      "description": "Open yazi file manager in current directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "yazi",
        "missingDependencyHelp": "Install yazi: Install via cargo: cargo install --locked yazi-fm yazi-cli"
      },
      "args": []
    },
    {
      "namespace": "yazi",
      "resource": "files",
      "action": "open-path",
      "description": "Open yazi at specific path",
      "adapter": "process",
      "adapterConfig": {
        "command": "yazi",
        "positionalArgs": [
          "path"
        ],
        "missingDependencyHelp": "Install yazi: Install via cargo: cargo install --locked yazi-fm yazi-cli"
      },
      "args": [
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "Directory path to open",
          "positional": true
        }
      ]
    },
    {
      "namespace": "yazi",
      "resource": "self",
      "action": "version",
      "description": "Print yazi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yazi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yazi: Install via cargo: cargo install --locked yazi-fm yazi-cli"
      },
      "args": []
    },
    {
      "namespace": "yazi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yazi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yazi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install yazi: Install via cargo: cargo install --locked yazi-fm yazi-cli"
      },
      "args": []
    }
  ]
}
