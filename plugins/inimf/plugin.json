{
  "name": "inimf",
  "version": "0.1.0",
  "description": "CLI tool: inimf",
  "source": "https://manpages.debian.org/inimf",
  "checks": [
    {
      "type": "binary",
      "name": "inimf"
    }
  ],
  "install_guidance": {
    "plugin": "inimf",
    "binary": "inimf",
    "check": "which inimf",
    "install_steps": [
      "apt-get install inimf 2>/dev/null || which inimf",
      "Verify: inimf --version",
      "supercli plugins install ./plugins/inimf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "inimf",
      "resource": "self",
      "action": "version",
      "description": "Print inimf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "inimf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install inimf: apt-get install inimf 2>/dev/null || which inimf"
      },
      "args": []
    },
    {
      "namespace": "inimf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to inimf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "inimf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install inimf: apt-get install inimf 2>/dev/null || which inimf"
      },
      "args": []
    }
  ]
}