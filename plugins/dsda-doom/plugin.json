{
  "name": "dsda-doom",
  "version": "0.1.0",
  "description": "Fork of prboom+ with a focus on speedrunning",
  "source": "https://github.com/kraflab/dsda-doom",
  "checks": [
    {
      "type": "binary",
      "name": "dsda-doom"
    }
  ],
  "install_guidance": {
    "plugin": "dsda-doom",
    "binary": "dsda-doom",
    "check": "which dsda-doom",
    "install_steps": [
      "brew install dsda-doom",
      "Verify: dsda-doom --version",
      "supercli plugins install ./plugins/dsda-doom --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dsda-doom",
      "resource": "self",
      "action": "version",
      "description": "Print dsda-doom version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dsda-doom",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dsda-doom: brew install dsda-doom"
      },
      "args": []
    },
    {
      "namespace": "dsda-doom",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dsda-doom CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dsda-doom",
        "passthrough": true,
        "missingDependencyHelp": "Install dsda-doom"
      },
      "args": []
    }
  ]
}