{
  "name": "names",
  "version": "0.1.0",
  "description": "A random name generator CLI designed for naming containers, servers, and cloud resources. Generates unique, pronounceable names for infrastructure automation.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "names"
    }
  ],
  "install_guidance": {
    "plugin": "names",
    "binary": "names",
    "check": "which names",
    "install_steps": [
      "cargo install names",
      "Verify: names --version",
      "supercli plugins install ./plugins/names --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "names",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to names CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "names",
        "passthrough": true,
        "missingDependencyHelp": "Install names: cargo install names"
      },
      "args": []
    }
  ]
}
