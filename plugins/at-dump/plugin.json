{
  "name": "at-dump",
  "version": "0.1.0",
  "description": "CLI tool: at-dump",
  "source": "https://packages.debian.org/at-dump",
  "checks": [{ "type": "binary", "name": "at-dump" }],
  "install_guidance": {
    "plugin": "at-dump", "binary": "at-dump", "check": "which at-dump",
    "install_steps": ["apt-get install at-dump 2>/dev/null || which at-dump", "Verify: at-dump --version", "supercli plugins install ./plugins/at-dump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-dump", "resource": "_", "action": "_",
    "description": "Passthrough to at-dump CLI",
    "adapter": "process", "adapterConfig": { "command": "at-dump", "passthrough": true, "missingDependencyHelp": "Install at-dump: apt-get install at-dump" }, "args": []
  }]
}
