{
  "name": "SVGO",
  "version": "0.1.0",
  "description": "Optimize SVG files",
  "source": "https://github.com/svg/svgo",
  "checks": [
    {
      "type": "binary",
      "name": "SVGO"
    }
  ],
  "install_guidance": {
    "plugin": "SVGO",
    "binary": "SVGO",
    "check": "which SVGO",
    "install_steps": [
      "brew install SVGO",
      "Verify: SVGO --version",
      "supercli plugins install ./plugins/SVGO --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "SVGO",
      "resource": "self",
      "action": "version",
      "description": "Print SVGO version",
      "adapter": "process",
      "adapterConfig": {
        "command": "SVGO",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SVGO: brew install SVGO"
      },
      "args": []
    },
    {
      "namespace": "SVGO",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to SVGO CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "SVGO",
        "passthrough": true,
        "missingDependencyHelp": "Install SVGO"
      },
      "args": []
    }
  ]
}