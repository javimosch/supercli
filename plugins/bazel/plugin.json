{
  "name": "bazel",
  "version": "1.0.0",
  "description": "bazel \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=bazel+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "bazel"
    }
  ],
  "install_guidance": {
    "plugin": "bazel",
    "binary": "bazel",
    "check": "which bazel",
    "install_steps": [
      "Install bazel via package manager: apt install bazel or brew install bazel"
    ]
  },
  "commands": [
    {
      "namespace": "bazel",
      "resource": "run",
      "action": "exec",
      "description": "bazel \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "bazel",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install bazel via your package manager"
      },
      "args": []
    }
  ]
}