{
  "name": "dasht",
  "version": "1.0.0",
  "description": "dasht \u2014 API docs browser",
  "source": "github.com/sunaku/dasht",
  "checks": [
    {
      "type": "binary",
      "name": "dasht"
    }
  ],
  "install_guidance": {
    "plugin": "dasht",
    "binary": "dasht",
    "check": "which dasht",
    "install_steps": [
      "# Install dasht",
      "# See github.com/sunaku/dasht",
      "# apt: sudo apt-get install dasht",
      "# brew: brew install dasht",
      "# cargo: cargo install dasht",
      "# npm: npm install -g dasht",
      "# pip: pip install dasht"
    ]
  },
  "commands": [
    {
      "namespace": "dasht",
      "resource": "dasht",
      "action": "run",
      "description": "Run dasht",
      "adapter": "process",
      "adapterConfig": {
        "command": "dasht",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dasht from github.com/sunaku/dasht"
      },
      "args": []
    }
  ]
}