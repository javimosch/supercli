{
  "name": "awesome-swift-macos-apps",
  "version": "0.1.0",
  "description": "A curated collection of open-source macOS applications built with Swift",
  "source": "https://github.com/awesome-swift-macos-apps/awesome-swift-macos-apps",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-swift-macos-apps"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-swift-macos-apps",
    "binary": "awesome-swift-macos-apps",
    "check": "which awesome-swift-macos-apps",
    "install_steps": [
      "pip install awesome-swift-macos-apps",
      "Verify: awesome-swift-macos-apps --version",
      "supercli plugins install ./plugins/awesome-swift-macos-apps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-swift-macos-apps",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-swift-macos-apps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-swift-macos-apps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-swift-macos-apps: pip install awesome-swift-macos-apps"
      },
      "args": []
    },
    {
      "namespace": "awesome-swift-macos-apps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-swift-macos-apps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-swift-macos-apps",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-swift-macos-apps: pip install awesome-swift-macos-apps"
      },
      "args": []
    }
  ]
}