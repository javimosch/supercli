{
  "name": "shipit",
  "version": "0.1.0",
  "description": "Automate deployment tasks in Node.js with shipit",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "shipit" }],
  "install_guidance": {
    "plugin": "shipit",
    "binary": "shipit",
    "check": "which shipit",
    "install_steps": ["npm install shipit-cli", "Verify: shipit --version", "supercli plugins install ./plugins/shipit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "shipit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to shipit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "shipit",
      "passthrough": true,
      "missingDependencyHelp": "Install shipit: npm install shipit-cli"
    },
    "args": []
  }]
}
