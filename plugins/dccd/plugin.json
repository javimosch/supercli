{
  "name": "dccd",
  "version": "0.1.0",
  "description": "CLI tool: dccd",
  "source": "https://packages.debian.org/dccd",
  "checks": [{ "type": "binary", "name": "dccd" }],
  "install_guidance": {
    "plugin": "dccd", "binary": "dccd", "check": "which dccd",
    "install_steps": ["apt-get install dccd 2>/dev/null || which dccd", "Verify: dccd --version", "supercli plugins install ./plugins/dccd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dccd", "resource": "_", "action": "_",
    "description": "Passthrough to dccd CLI",
    "adapter": "process", "adapterConfig": { "command": "dccd", "passthrough": true, "missingDependencyHelp": "Install dccd: apt-get install dccd" }, "args": []
  }]
}
