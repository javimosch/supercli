{
  "name": "reboot",
  "version": "1.0.0",
  "description": "reboot \u2014 power off, reboot, or halt the machine",
  "source": "https://github.com/slicer69/sysvinit",
  "checks": [
    {
      "type": "binary",
      "name": "reboot"
    }
  ],
  "install_guidance": {
    "plugin": "reboot",
    "binary": "reboot",
    "check": "which reboot",
    "install_steps": [
      "# Install reboot:",
      "# apt: sudo apt-get install reboot",
      "# brew: brew install reboot",
      "# cargo: cargo install reboot",
      "# npm: npm install -g reboot",
      "# pip: pip install reboot",
      "# or download from /usr/sbin/reboot"
    ]
  },
  "commands": [
    {
      "namespace": "reboot",
      "resource": "reboot",
      "action": "run",
      "description": "Run reboot",
      "adapter": "process",
      "adapterConfig": {
        "command": "reboot",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install reboot from /usr/sbin/reboot"
      },
      "args": []
    }
  ]
}