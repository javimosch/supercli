{
  "name": "unar",
  "version": "0.1.0",
  "description": "unar — universal archive extractor supporting RAR, 7z, tar, gzip, bzip2, ZIP, ISO, CAB and 60+ formats",
  "source": "https://github.com/macos-archive/unar",
  "checks": [
    { "type": "binary", "name": "unar" }
  ],
  "install_guidance": {
    "plugin": "unar",
    "binary": "unar",
    "check": "which unar",
    "install_steps": ["brew install unar", "Verify: unar --version", "supercli plugins install ./plugins/unar --on-conflict replace --json"]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unar",
        "passthrough": true,
        "missingDependencyHelp": "Install unar: brew install unar"
      },
      "args": []
    }
  ]
}
