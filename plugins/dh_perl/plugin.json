{
  "name": "dh_perl",
  "version": "0.1.0",
  "description": "CLI tool: dh_perl",
  "source": "https://packages.debian.org/dh_perl",
  "checks": [{ "type": "binary", "name": "dh_perl" }],
  "install_guidance": {
    "plugin": "dh_perl", "binary": "dh_perl", "check": "which dh_perl",
    "install_steps": ["apt-get install dh_perl 2>/dev/null || which dh_perl", "Verify: dh_perl --version", "supercli plugins install ./plugins/dh_perl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_perl", "resource": "_", "action": "_",
    "description": "Passthrough to dh_perl CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_perl", "passthrough": true, "missingDependencyHelp": "Install dh_perl: apt-get install dh_perl" }, "args": []
  }]
}
