{
  "name": "dbs-tools",
  "version": "0.1.0",
  "description": "Perl tools to transform account / transaction data from DBS Bank into proper CSV",
  "source": "https://github.com/dbs-tools/dbs-tools",
  "checks": [
    {
      "type": "binary",
      "name": "dbs-tools"
    }
  ],
  "install_guidance": {
    "plugin": "dbs-tools",
    "binary": "dbs-tools",
    "check": "which dbs-tools",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: dbs-tools --version",
      "supercli plugins install ./plugins/dbs-tools --on-conflict replace --json"
    ],
    "note": "Perl language CLI tool"
  },
  "commands": [
    {
      "namespace": "dbs-tools",
      "resource": "self",
      "action": "version",
      "description": "Print dbs-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbs-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dbs-tools from project repository"
      },
      "args": []
    },
    {
      "namespace": "dbs-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dbs-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbs-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install dbs-tools from project repository"
      },
      "args": []
    }
  ]
}