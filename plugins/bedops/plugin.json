{
  "name": "bedops",
  "version": "0.1.0",
  "description": "Set and statistical operations on genomic data of arbitrary scale",
  "source": "https://github.com/bedops/bedops",
  "checks": [
    {
      "type": "binary",
      "name": "bedops"
    }
  ],
  "install_guidance": {
    "plugin": "bedops",
    "binary": "bedops",
    "check": "which bedops",
    "install_steps": [
      "brew install bedops",
      "Verify: bedops --version",
      "supercli plugins install ./plugins/bedops --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bedops",
      "resource": "self",
      "action": "version",
      "description": "Print bedops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bedops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bedops: brew install bedops"
      },
      "args": []
    },
    {
      "namespace": "bedops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bedops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bedops",
        "passthrough": true,
        "missingDependencyHelp": "Install bedops"
      },
      "args": []
    }
  ]
}