{
  "name": "llgo",
  "version": "0.1.0",
  "description": "Go compiler based on LLVM integrate with the C ecosystem and Python",
  "source": "https://github.com/goplus/llgo",
  "checks": [
    {
      "type": "binary",
      "name": "llgo"
    }
  ],
  "install_guidance": {
    "plugin": "llgo",
    "binary": "llgo",
    "check": "which llgo",
    "install_steps": [
      "brew install llgo",
      "Verify: llgo --version",
      "supercli plugins install ./plugins/llgo --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "llgo",
      "resource": "self",
      "action": "version",
      "description": "Print llgo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llgo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llgo: brew install llgo"
      },
      "args": []
    },
    {
      "namespace": "llgo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llgo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llgo",
        "passthrough": true,
        "missingDependencyHelp": "Install llgo"
      },
      "args": []
    }
  ]
}