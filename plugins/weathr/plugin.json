{
  "name": "weathr",
  "version": "0.1.0",
  "description": "ASCII animations",
  "source": "https://github.com/veirt/weathr",
  "checks": [
    {
      "type": "binary",
      "name": "weathr"
    }
  ],
  "install_guidance": {
    "plugin": "weathr",
    "binary": "weathr",
    "check": "which weathr",
    "install_steps": [
      "cargo install weathr",
      "Verify: weathr --version",
      "supercli plugins install ./plugins/weathr --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "weathr",
      "resource": "self",
      "action": "version",
      "description": "Print weathr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "weathr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install weathr: cargo install weathr"
      },
      "args": []
    },
    {
      "namespace": "weathr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to weathr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "weathr",
        "passthrough": true,
        "missingDependencyHelp": "Install weathr"
      },
      "args": []
    }
  ]
}