{
  "name": "clac",
  "version": "0.1.0",
  "description": "Command-line, stack-based calculator with postfix notation",
  "source": "https://github.com/soveran/clac",
  "checks": [
    {
      "type": "binary",
      "name": "clac"
    }
  ],
  "install_guidance": {
    "plugin": "clac",
    "binary": "clac",
    "check": "which clac",
    "install_steps": [
      "brew install clac",
      "Verify: clac --version",
      "supercli plugins install ./plugins/clac --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clac",
      "resource": "self",
      "action": "version",
      "description": "Print clac version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clac",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clac: brew install clac"
      },
      "args": []
    },
    {
      "namespace": "clac",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clac CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clac",
        "passthrough": true,
        "missingDependencyHelp": "Install clac"
      },
      "args": []
    }
  ]
}