{
  "name": "licensefinder",
  "version": "0.1.0",
  "description": "Find licenses for your project's dependencies",
  "source": "https://github.com/pivotal/LicenseFinder",
  "checks": [
    {
      "type": "binary",
      "name": "licensefinder"
    }
  ],
  "install_guidance": {
    "plugin": "licensefinder",
    "binary": "licensefinder",
    "check": "which licensefinder",
    "install_steps": [
      "brew install licensefinder",
      "Verify: licensefinder --version",
      "supercli plugins install ./plugins/licensefinder --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "licensefinder",
      "resource": "self",
      "action": "version",
      "description": "Print licensefinder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "licensefinder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install licensefinder: brew install licensefinder"
      },
      "args": []
    },
    {
      "namespace": "licensefinder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to licensefinder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "licensefinder",
        "passthrough": true,
        "missingDependencyHelp": "Install licensefinder"
      },
      "args": []
    }
  ]
}