{
  "name": "updo",
  "version": "0.1.0",
  "description": "Website monitoring tool",
  "source": "https://github.com/Owloops/updo",
  "checks": [
    {
      "type": "binary",
      "name": "updo"
    }
  ],
  "install_guidance": {
    "plugin": "updo",
    "binary": "updo",
    "check": "which updo",
    "install_steps": [
      "See https://github.com/Owloops/updo",
      "Verify: updo --version",
      "supercli plugins install ./plugins/updo --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "updo",
      "resource": "self",
      "action": "version",
      "description": "Print updo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "updo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install updo: See https://github.com/Owloops/updo"
      },
      "args": []
    },
    {
      "namespace": "updo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to updo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "updo",
        "passthrough": true,
        "missingDependencyHelp": "Install updo"
      },
      "args": []
    }
  ]
}