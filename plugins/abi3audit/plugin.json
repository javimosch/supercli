{
  "name": "abi3audit",
  "version": "0.1.0",
  "description": "Scans Python packages for abi3 violations and inconsistencies",
  "source": "https://github.com/pypa/abi3audit",
  "checks": [
    {
      "type": "binary",
      "name": "abi3audit"
    }
  ],
  "install_guidance": {
    "plugin": "abi3audit",
    "binary": "abi3audit",
    "check": "which abi3audit",
    "install_steps": [
      "brew install abi3audit",
      "Verify: abi3audit --version",
      "supercli plugins install ./plugins/abi3audit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "abi3audit",
      "resource": "self",
      "action": "version",
      "description": "Print abi3audit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "abi3audit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install abi3audit: brew install abi3audit"
      },
      "args": []
    },
    {
      "namespace": "abi3audit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to abi3audit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "abi3audit",
        "passthrough": true,
        "missingDependencyHelp": "Install abi3audit"
      },
      "args": []
    }
  ]
}