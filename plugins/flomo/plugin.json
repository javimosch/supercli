{
  "name": "flomo",
  "version": "0.1.0",
  "description": "Flowmodoro timer CLI for productivity in Python",
  "source": "https://github.com/nicedoc/flomo",
  "checks": [
    {
      "type": "binary",
      "name": "flomo"
    }
  ],
  "install_guidance": {
    "plugin": "flomo",
    "binary": "flomo",
    "check": "which flomo",
    "install_steps": [
      "pip install flomo",
      "Verify: flomo --version",
      "supercli plugins install ./plugins/flomo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "flomo",
      "resource": "self",
      "action": "version",
      "description": "Print flomo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flomo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flomo: pip install flomo"
      },
      "args": []
    },
    {
      "namespace": "flomo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flomo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flomo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install flomo: pip install flomo"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
