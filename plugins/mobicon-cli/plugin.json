{
  "name": "mobicon-cli",
  "version": "0.1.0",
  "description": "Mobile app icon generator",
  "source": "https://github.com/SamVerschueren/mobicon-cli",
  "checks": [
    {
      "type": "binary",
      "name": "mobicon-cli"
    }
  ],
  "install_guidance": {
    "plugin": "mobicon-cli",
    "binary": "mobicon-cli",
    "check": "which mobicon-cli",
    "install_steps": [
      "See https://github.com/SamVerschueren/mobicon-cli",
      "Verify: mobicon-cli --version",
      "supercli plugins install ./plugins/mobicon-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "mobicon-cli",
      "resource": "self",
      "action": "version",
      "description": "Print mobicon-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mobicon-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mobicon-cli: See https://github.com/SamVerschueren/mobicon-cli"
      },
      "args": []
    },
    {
      "namespace": "mobicon-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mobicon-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mobicon-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install mobicon-cli"
      },
      "args": []
    }
  ]
}