{
  "name": "hart",
  "version": "0.1.0",
  "description": "Agent-first artifact host \u2014 publish self-contained HTML/JSX to a live, versioned, sandboxed URL",
  "source": "https://github.com/javimosch/hart",
  "checks": [
    {
      "type": "binary",
      "name": "hart"
    }
  ],
  "install_guidance": {
    "plugin": "hart",
    "binary": "hart",
    "check": "which hart",
    "install_steps": [
      "Build from source: https://github.com/javimosch/hart",
      "Verify: hart version || hart guide"
    ]
  },
  "commands": [
    {
      "namespace": "hart",
      "resource": "artifact",
      "action": "publish",
      "description": "Publish an HTML/JSX file to a live URL",
      "adapter": "process",
      "adapterConfig": {
        "command": "hart",
        "baseArgs": [
          "publish"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install hart from https://github.com/javimosch/hart"
      },
      "args": [
        {
          "name": "file",
          "type": "string",
          "required": true,
          "description": "HTML file path"
        },
        {
          "name": "owner",
          "type": "string",
          "required": true,
          "description": "Owner namespace"
        },
        {
          "name": "artifact",
          "type": "string",
          "required": true,
          "description": "Artifact name"
        },
        {
          "name": "csp-mode",
          "type": "string",
          "required": false,
          "description": "CSP mode: strict|landing|custom"
        }
      ]
    },
    {
      "namespace": "hart",
      "resource": "self",
      "action": "serve",
      "description": "Start the hart daemon",
      "adapter": "process",
      "adapterConfig": {
        "command": "hart",
        "baseArgs": [
          "serve"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install hart from https://github.com/javimosch/hart"
      },
      "args": [
        {
          "name": "port",
          "type": "integer",
          "required": false,
          "description": "Port number",
          "default": 8795
        }
      ]
    },
    {
      "namespace": "hart",
      "resource": "artifact",
      "action": "list",
      "description": "List artifacts",
      "adapter": "process",
      "adapterConfig": {
        "command": "hart",
        "baseArgs": [
          "artifacts"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install hart from https://github.com/javimosch/hart"
      },
      "args": [
        {
          "name": "owner",
          "type": "string",
          "required": false,
          "description": "Filter by owner"
        }
      ]
    },
    {
      "namespace": "hart",
      "resource": "artifact",
      "action": "delete",
      "description": "Delete an artifact",
      "adapter": "process",
      "adapterConfig": {
        "command": "hart",
        "baseArgs": [
          "delete"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install hart from https://github.com/javimosch/hart"
      },
      "args": [
        {
          "name": "owner",
          "type": "string",
          "required": true,
          "description": "Owner"
        },
        {
          "name": "artifact",
          "type": "string",
          "required": true,
          "description": "Artifact name"
        }
      ]
    },
    {
      "namespace": "hart",
      "resource": "self",
      "action": "guide",
      "description": "Print the agent guide",
      "adapter": "process",
      "adapterConfig": {
        "command": "hart",
        "baseArgs": [
          "guide"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install hart from https://github.com/javimosch/hart"
      },
      "args": []
    },
    {
      "namespace": "hart",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hart",
        "baseArgs": [
          "version"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install hart from https://github.com/javimosch/hart"
      },
      "args": []
    }
  ]
}