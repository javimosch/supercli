{
  "name": "AiToEarn",
  "version": "0.1.0",
  "description": "AI-powered earning platform CLI for monetizing AI capabilities and services",
  "source": "https://github.com/AiToEarn/AiToEarn",
  "checks": [
    {
      "type": "binary",
      "name": "aitoearn"
    }
  ],
  "install_guidance": {
    "plugin": "AiToEarn",
    "binary": "aitoearn",
    "check": "which aitoearn",
    "install_steps": [
      "pip install aitoearn",
      "Verify: aitoearn --version",
      "supercli plugins install ./plugins/AiToEarn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AiToEarn",
      "resource": "self",
      "action": "version",
      "description": "Print AiToEarn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aitoearn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AiToEarn: pip install aitoearn"
      },
      "args": []
    },
    {
      "namespace": "AiToEarn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aitoearn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aitoearn",
        "passthrough": true,
        "missingDependencyHelp": "Install AiToEarn: pip install aitoearn"
      },
      "args": []
    }
  ]
}