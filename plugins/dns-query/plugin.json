{
  "name": "dns-query",
  "version": "0.1.0",
  "description": "Advanced DNS lookup tool with DNS-over-HTTPS support",
  "source": "https://github.com/dns-query/dns-query",
  "checks": [{ "type": "binary", "name": "dns-query" }],
  "install_guidance": {
    "plugin": "dns-query",
    "binary": "dns-query",
    "check": "which dns-query",
    "install_steps": ["go install github.com/dns-query/cli@latest", "Verify: dns-query --version", "supercli plugins install ./plugins/dns-query --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dns-query",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dns-query CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dns-query",
      "passthrough": true,
      "missingDependencyHelp": "Install dns-query: go install github.com/dns-query/cli@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
