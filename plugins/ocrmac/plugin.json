{
  "name": "ocrmac",
  "version": "0.1.0",
  "description": "macOS native OCR using Vision framework from CLI",
  "source": "https://github.com/straussmaximilian/ocrmac",
  "checks": [{ "type": "binary", "name": "ocrmac" }],
  "install_guidance": {
    "plugin": "ocrmac",
    "binary": "ocrmac",
    "check": "which ocrmac",
    "install_steps": ["pip install ocrmac", "Verify: ocrmac --version", "supercli plugins install ./plugins/ocrmac --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ocrmac",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ocrmac CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ocrmac",
      "passthrough": true,
      "missingDependencyHelp": "Install ocrmac: pip install ocrmac", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
