{
  "name": "ab",
  "version": "0.1.0",
  "description": "Apache HTTP server benchmarking tool",
  "source": "https://github.com/apache/httpd",
  "checks": [{ "type": "binary", "name": "ab" }],
  "install_guidance": {
    "plugin": "ab",
    "binary": "ab",
    "check": "which ab",
    "install_steps": ["apt install apache2-utils", "Verify: ab --version", "supercli plugins install ./plugins/ab --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ab",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ab CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ab",
      "passthrough": true,
      "missingDependencyHelp": "Install ab: apt install apache2-utils"
    },
    "args": []
  }]
}
