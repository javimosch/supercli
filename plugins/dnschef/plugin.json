{
  "name": "dnschef",
  "version": "1.0.0",
  "description": "dnschef \u2014 DNS proxy",
  "source": "github.com/iphelix/dnschef",
  "checks": [
    {
      "type": "binary",
      "name": "dnschef"
    }
  ],
  "install_guidance": {
    "plugin": "dnschef",
    "binary": "dnschef",
    "check": "which dnschef",
    "install_steps": [
      "# Install dnschef",
      "# See github.com/iphelix/dnschef",
      "# apt: sudo apt-get install dnschef",
      "# brew: brew install dnschef",
      "# cargo: cargo install dnschef",
      "# npm: npm install -g dnschef",
      "# pip: pip install dnschef"
    ]
  },
  "commands": [
    {
      "namespace": "dnschef",
      "resource": "dnschef",
      "action": "run",
      "description": "Run dnschef",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnschef",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dnschef from github.com/iphelix/dnschef"
      },
      "args": []
    }
  ]
}