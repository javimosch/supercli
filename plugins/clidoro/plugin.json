{
  "name": "clidoro",
  "version": "0.1.0",
  "description": "Terminal Pomodoro timer with task tracking integration",
  "source": "https://github.com/ahmadawais/clidoro",
  "checks": [{ "type": "binary", "name": "clidoro" }],
  "install_guidance": {
    "plugin": "clidoro",
    "binary": "clidoro",
    "check": "which clidoro",
    "install_steps": ["npm install -g clidoro", "Verify: clidoro --version", "supercli plugins install ./plugins/clidoro --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clidoro",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clidoro CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clidoro",
      "passthrough": true,
      "missingDependencyHelp": "Install clidoro: npm install -g clidoro", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
