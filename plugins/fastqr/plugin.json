{
  "name": "fastqr",
  "version": "0.1.0",
  "description": "High-performance C++ QR code generator for batch usage",
  "source": "https://github.com/tranhuucanh/fastqr",
  "checks": [{ "type": "binary", "name": "fastqr" }],
  "install_guidance": {
    "plugin": "fastqr",
    "binary": "fastqr",
    "check": "which fastqr",
    "install_steps": ["build from source", "Verify: fastqr --version", "supercli plugins install ./plugins/fastqr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fastqr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fastqr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fastqr",
      "passthrough": true,
      "missingDependencyHelp": "Install fastqr: build from source", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
