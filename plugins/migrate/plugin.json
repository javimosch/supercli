{
  "name": "migrate",
  "version": "0.1.0",
  "description": "Database migrations written in Go with CLI and library",
  "source": "https://github.com/golang-migrate/migrate",
  "checks": [{ "type": "binary", "name": "migrate" }],
  "install_guidance": {
    "plugin": "migrate",
    "binary": "migrate",
    "check": "which migrate",
    "install_steps": ["go install -tags postgres github.com/golang-migrate/migrate/v4/cmd/migrate@latest", "Verify: migrate --version", "supercli plugins install ./plugins/migrate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "migrate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to migrate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "migrate",
      "passthrough": true,
      "missingDependencyHelp": "Install migrate: go install -tags postgres github.com/golang-migrate/migrate/v4/cmd/migrate@latest"
    },
    "args": []
  }]
}
