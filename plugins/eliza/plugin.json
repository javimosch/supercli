{
  "name": "eliza",
  "version": "0.1.0",
  "description": "Open source agentic operating system",
  "source": "https://github.com/eliza/eliza",
  "checks": [
    {
      "type": "binary",
      "name": "eliza"
    }
  ],
  "install_guidance": {
    "plugin": "eliza",
    "binary": "eliza",
    "check": "which eliza",
    "install_steps": [
      "pip install eliza",
      "Verify: eliza --version",
      "supercli plugins install ./plugins/eliza --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "eliza",
      "resource": "self",
      "action": "version",
      "description": "Print eliza version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eliza",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eliza: pip install eliza"
      },
      "args": []
    },
    {
      "namespace": "eliza",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eliza CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eliza",
        "passthrough": true,
        "missingDependencyHelp": "Install eliza: pip install eliza"
      },
      "args": []
    }
  ]
}