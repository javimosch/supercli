{
  "name": "tabiew",
  "version": "0.1.0",
  "description": "High-performance terminal-based CSV and data viewer",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "tabiew" }],
  "install_guidance": {
    "plugin": "tabiew",
    "binary": "tabiew",
    "check": "which tabiew",
    "install_steps": ["cargo install tabiew", "Verify: tabiew --version", "supercli plugins install ./plugins/tabiew --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tabiew",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tabiew CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tabiew",
      "passthrough": true,
      "missingDependencyHelp": "Install tabiew: cargo install tabiew"
    },
    "args": []
  }]
}
