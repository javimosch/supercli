{
  "name": "dhall-openapi",
  "version": "0.1.0",
  "description": "CLI tool: dhall-openapi",
  "source": "https://packages.debian.org/dhall-openapi",
  "checks": [{ "type": "binary", "name": "dhall-openapi" }],
  "install_guidance": {
    "plugin": "dhall-openapi", "binary": "dhall-openapi", "check": "which dhall-openapi",
    "install_steps": ["apt-get install dhall-openapi 2>/dev/null || which dhall-openapi", "Verify: dhall-openapi --version", "supercli plugins install ./plugins/dhall-openapi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-openapi", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-openapi CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-openapi", "passthrough": true, "missingDependencyHelp": "Install dhall-openapi: apt-get install dhall-openapi" }, "args": []
  }]
}
