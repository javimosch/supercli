{
  "name": "ruflo",
  "version": "0.1.0",
  "description": "\ud83c\udf0a The leading agent meta-harness for Claude. Deploy intelligent multi-agent swarms, coordinate auton",
  "source": "https://github.com/ruflo/ruflo",
  "checks": [
    {
      "type": "binary",
      "name": "ruflo"
    }
  ],
  "install_guidance": {
    "plugin": "ruflo",
    "binary": "ruflo",
    "check": "which ruflo",
    "install_steps": [
      "pip install ruflo",
      "Verify: ruflo --version",
      "supercli plugins install ./plugins/ruflo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ruflo",
      "resource": "self",
      "action": "version",
      "description": "Print ruflo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruflo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ruflo: pip install ruflo"
      },
      "args": []
    },
    {
      "namespace": "ruflo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ruflo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruflo",
        "passthrough": true,
        "missingDependencyHelp": "Install ruflo: pip install ruflo"
      },
      "args": []
    }
  ]
}