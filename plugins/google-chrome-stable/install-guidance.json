{
  "plugin": "google-chrome-stable",
  "binary": "google-chrome-stable",
  "check": "which google-chrome-stable",
  "install_steps": [
    "apt-get install google-chrome-stable 2>/dev/null || which google-chrome-stable",
    "Verify: google-chrome-stable --version",
    "supercli plugins install ./plugins/google-chrome-stable --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}