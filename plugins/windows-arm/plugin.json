{
  "name": "windows-arm",
  "version": "0.1.0",
  "description": "Windows for ARM in a Docker container.",
  "source": "https://github.com/windows-arm/windows-arm",
  "checks": [
    {
      "type": "binary",
      "name": "windows-arm"
    }
  ],
  "install_guidance": {
    "plugin": "windows-arm",
    "binary": "windows-arm",
    "check": "which windows-arm",
    "install_steps": [
      "pip install windows-arm",
      "Verify: windows-arm --version",
      "supercli plugins install ./plugins/windows-arm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "windows-arm",
      "resource": "self",
      "action": "version",
      "description": "Print windows-arm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "windows-arm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install windows-arm: pip install windows-arm"
      },
      "args": []
    },
    {
      "namespace": "windows-arm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to windows-arm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "windows-arm",
        "passthrough": true,
        "missingDependencyHelp": "Install windows-arm: pip install windows-arm"
      },
      "args": []
    }
  ]
}