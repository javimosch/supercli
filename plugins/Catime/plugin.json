{
  "name": "Catime",
  "version": "0.1.0",
  "description": "\ud83d\udc8cA tiny (995KB) but mighty timer in **pure C** ! \u2014 almost no memory usage!\u2764\ufe0f\u200d\ud83d\udd25 Supports clock, count",
  "source": "https://github.com/Catime/Catime",
  "checks": [
    {
      "type": "binary",
      "name": "catime"
    }
  ],
  "install_guidance": {
    "plugin": "Catime",
    "binary": "catime",
    "check": "which catime",
    "install_steps": [
      "pip install catime",
      "Verify: catime --version",
      "supercli plugins install ./plugins/Catime --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Catime",
      "resource": "self",
      "action": "version",
      "description": "Print Catime version",
      "adapter": "process",
      "adapterConfig": {
        "command": "catime",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Catime: pip install catime"
      },
      "args": []
    },
    {
      "namespace": "Catime",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to catime CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "catime",
        "passthrough": true,
        "missingDependencyHelp": "Install Catime: pip install catime"
      },
      "args": []
    }
  ]
}