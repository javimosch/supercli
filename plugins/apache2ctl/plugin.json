{
  "name": "apache2ctl",
  "version": "0.1.0",
  "description": "CLI tool: apache2ctl",
  "source": "https://packages.debian.org/apache2ctl",
  "checks": [{ "type": "binary", "name": "apache2ctl" }],
  "install_guidance": {
    "plugin": "apache2ctl", "binary": "apache2ctl", "check": "which apache2ctl",
    "install_steps": ["apt-get install apache2ctl 2>/dev/null || which apache2ctl", "Verify: apache2ctl --version", "supercli plugins install ./plugins/apache2ctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apache2ctl", "resource": "_", "action": "_",
    "description": "Passthrough to apache2ctl CLI",
    "adapter": "process", "adapterConfig": { "command": "apache2ctl", "passthrough": true, "missingDependencyHelp": "Install apache2ctl: apt-get install apache2ctl" }, "args": []
  }]
}
