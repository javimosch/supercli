{
  "name": "iOS-OCR-Server",
  "version": "0.1.0",
  "description": "An iOS OCR Server Using Apple\u2019s Vision Framework",
  "source": "https://github.com/iOS-OCR-Server/iOS-OCR-Server",
  "checks": [
    {
      "type": "binary",
      "name": "ios-ocr-server"
    }
  ],
  "install_guidance": {
    "plugin": "iOS-OCR-Server",
    "binary": "ios-ocr-server",
    "check": "which ios-ocr-server",
    "install_steps": [
      "pip install ios-ocr-server",
      "Verify: ios-ocr-server --version",
      "supercli plugins install ./plugins/iOS-OCR-Server --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iOS-OCR-Server",
      "resource": "self",
      "action": "version",
      "description": "Print iOS-OCR-Server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ios-ocr-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iOS-OCR-Server: pip install ios-ocr-server"
      },
      "args": []
    },
    {
      "namespace": "iOS-OCR-Server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ios-ocr-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ios-ocr-server",
        "passthrough": true,
        "missingDependencyHelp": "Install iOS-OCR-Server: pip install ios-ocr-server"
      },
      "args": []
    }
  ]
}