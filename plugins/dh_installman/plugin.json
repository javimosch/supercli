{
  "name": "dh_installman",
  "version": "0.1.0",
  "description": "CLI tool: dh_installman",
  "source": "https://packages.debian.org/dh_installman",
  "checks": [{ "type": "binary", "name": "dh_installman" }],
  "install_guidance": {
    "plugin": "dh_installman", "binary": "dh_installman", "check": "which dh_installman",
    "install_steps": ["apt-get install dh_installman 2>/dev/null || which dh_installman", "Verify: dh_installman --version", "supercli plugins install ./plugins/dh_installman --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_installman", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installman CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installman", "passthrough": true, "missingDependencyHelp": "Install dh_installman: apt-get install dh_installman" }, "args": []
  }]
}
