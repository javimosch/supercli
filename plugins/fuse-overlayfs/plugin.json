{
  "name": "fuse-overlayfs",
  "version": "0.1.0",
  "description": "FUSE implementation for overlayfs",
  "source": "https://github.com/containers/fuse-overlayfs",
  "checks": [
    {
      "type": "binary",
      "name": "fuse-overlayfs"
    }
  ],
  "install_guidance": {
    "plugin": "fuse-overlayfs",
    "binary": "fuse-overlayfs",
    "check": "which fuse-overlayfs",
    "install_steps": [
      "brew install fuse-overlayfs",
      "Verify: fuse-overlayfs --version",
      "supercli plugins install ./plugins/fuse-overlayfs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fuse-overlayfs",
      "resource": "self",
      "action": "version",
      "description": "Print fuse-overlayfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fuse-overlayfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fuse-overlayfs: brew install fuse-overlayfs"
      },
      "args": []
    },
    {
      "namespace": "fuse-overlayfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fuse-overlayfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fuse-overlayfs",
        "passthrough": true,
        "missingDependencyHelp": "Install fuse-overlayfs"
      },
      "args": []
    }
  ]
}