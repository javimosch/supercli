{
  "name": "TuDu",
  "version": "0.1.0",
  "description": "Manage hierarchical todos. Each task has a title, a long text description, a deadline (tudu warns you when the date is close), and a scheduled date. There are categories and priorities.",
  "source": "https://github.com/meskio/tudu",
  "checks": [
    {
      "type": "binary",
      "name": "TuDu"
    }
  ],
  "install_guidance": {
    "plugin": "TuDu",
    "binary": "TuDu",
    "check": "which TuDu",
    "install_steps": [
      "See https://github.com/meskio/tudu",
      "Verify: TuDu --version",
      "supercli plugins install ./plugins/TuDu --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "TuDu",
      "resource": "self",
      "action": "version",
      "description": "Print TuDu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "TuDu",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TuDu: See https://github.com/meskio/tudu"
      },
      "args": []
    },
    {
      "namespace": "TuDu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to TuDu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "TuDu",
        "passthrough": true,
        "missingDependencyHelp": "Install TuDu"
      },
      "args": []
    }
  ]
}