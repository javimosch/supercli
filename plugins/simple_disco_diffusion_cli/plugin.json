{
  "name": "simple_disco_diffusion_cli",
  "version": "0.1.0",
  "description": "A simple cli tool to run disco diffusion",
  "source": "https://github.com/simple_disco_diffusion_cli/simple_disco_diffusion_cli",
  "checks": [
    {
      "type": "binary",
      "name": "simple_disco_diffusion_cli"
    }
  ],
  "install_guidance": {
    "plugin": "simple_disco_diffusion_cli",
    "binary": "simple_disco_diffusion_cli",
    "check": "which simple_disco_diffusion_cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: simple_disco_diffusion_cli --version",
      "supercli plugins install ./plugins/simple_disco_diffusion_cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "simple_disco_diffusion_cli",
      "resource": "self",
      "action": "version",
      "description": "Print simple_disco_diffusion_cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "simple_disco_diffusion_cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install simple_disco_diffusion_cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "simple_disco_diffusion_cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to simple_disco_diffusion_cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "simple_disco_diffusion_cli",
        "passthrough": true,
        "missingDependencyHelp": "Install simple_disco_diffusion_cli from project repository"
      },
      "args": []
    }
  ]
}