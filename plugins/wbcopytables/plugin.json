{
  "name": "wbcopytables",
  "version": "0.1.0",
  "description": "CLI tool: wbcopytables",
  "source": "https://manpages.debian.org/wbcopytables",
  "checks": [
    {
      "type": "binary",
      "name": "wbcopytables"
    }
  ],
  "install_guidance": {
    "plugin": "wbcopytables",
    "binary": "wbcopytables",
    "check": "which wbcopytables",
    "install_steps": [
      "apt-get install wbcopytables 2>/dev/null || which wbcopytables",
      "Verify: wbcopytables --version",
      "supercli plugins install ./plugins/wbcopytables --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wbcopytables",
      "resource": "self",
      "action": "version",
      "description": "Print wbcopytables version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wbcopytables",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wbcopytables: apt-get install wbcopytables 2>/dev/null || which wbcopytables"
      },
      "args": []
    },
    {
      "namespace": "wbcopytables",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wbcopytables CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wbcopytables",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wbcopytables: apt-get install wbcopytables 2>/dev/null || which wbcopytables"
      },
      "args": []
    }
  ]
}