{
  "name": "ovf2ovp",
  "version": "0.1.0",
  "description": "CLI tool: ovf2ovp",
  "source": "https://manpages.debian.org/ovf2ovp",
  "checks": [
    {
      "type": "binary",
      "name": "ovf2ovp"
    }
  ],
  "install_guidance": {
    "plugin": "ovf2ovp",
    "binary": "ovf2ovp",
    "check": "which ovf2ovp",
    "install_steps": [
      "apt-get install ovf2ovp 2>/dev/null || which ovf2ovp",
      "Verify: ovf2ovp --version",
      "supercli plugins install ./plugins/ovf2ovp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ovf2ovp",
      "resource": "self",
      "action": "version",
      "description": "Print ovf2ovp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ovf2ovp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ovf2ovp: apt-get install ovf2ovp 2>/dev/null || which ovf2ovp"
      },
      "args": []
    },
    {
      "namespace": "ovf2ovp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ovf2ovp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ovf2ovp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ovf2ovp: apt-get install ovf2ovp 2>/dev/null || which ovf2ovp"
      },
      "args": []
    }
  ]
}