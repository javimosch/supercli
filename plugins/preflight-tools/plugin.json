{
  "name": "preflight-tools",
  "version": "0.1.0",
  "description": "Kubernetes cluster preflight checks before installation",
  "source": "https://github.com/replicatedhq/troubleshoot",
  "checks": [{ "type": "binary", "name": "preflight" }],
  "install_guidance": {
    "plugin": "preflight-tools",
    "binary": "preflight",
    "check": "which preflight",
    "install_steps": ["brew install preflight", "Verify: preflight --version", "supercli plugins install ./plugins/preflight-tools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "preflight-tools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to preflight CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "preflight",
      "passthrough": true,
      "missingDependencyHelp": "Install preflight-tools: brew install preflight"
    },
    "args": []
  }]
}
