{
  "name": "strace",
  "version": "0.1.0",
  "description": "System call tracer for debugging",
  "source": "https",
  "checks": [{"type": "binary", "name": "strace"}],
  "install_guidance": {
    "plugin": "strace",
    "binary": "strace",
    "check": "which strace",
    "install_steps": [
      "brew install strace",
      "Verify: strace --version",
      "supercli plugins install ./plugins/strace --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "strace",
      "resource": "self",
      "action": "version",
      "description": "Print strace version",
      "adapter": "process",
      "adapterConfig": {"command": "strace", "baseArgs": ["--version"], "missingDependencyHelp": "Install strace: brew install strace"},
      "args": []
    },
    {
      "namespace": "strace",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to strace CLI",
      "adapter": "process",
      "adapterConfig": {"command": "strace", "passthrough": true, "missingDependencyHelp": "Install strace: brew install strace"},
      "args": []
    }
  ]
}
