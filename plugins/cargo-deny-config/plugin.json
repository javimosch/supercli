{
  "name": "cargo-deny-config",
  "version": "0.1.0",
  "description": "Configuration and advisory database for cargo-deny",
  "source": "https://github.com/EmbarkStudios/cargo-deny",
  "checks": [{ "type": "binary", "name": "cargo-deny-config" }],
  "install_guidance": {
    "plugin": "cargo-deny-config",
    "binary": "cargo-deny-config",
    "check": "which cargo-deny-config",
    "install_steps": ["cargo install cargo-deny", "Verify: cargo-deny-config --version", "supercli plugins install ./plugins/cargo-deny-config --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-deny-config",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-deny-config CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-deny-config",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-deny-config: cargo install cargo-deny", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
