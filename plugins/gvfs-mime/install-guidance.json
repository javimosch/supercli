{
  "plugin": "gvfs-mime",
  "binary": "gvfs-mime",
  "check": "which gvfs-mime",
  "install_steps": [
    "apt-get install gvfs-mime 2>/dev/null || which gvfs-mime",
    "Verify: gvfs-mime --version",
    "supercli plugins install ./plugins/gvfs-mime --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}