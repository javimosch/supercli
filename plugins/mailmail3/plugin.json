{
  "name": "mailmail3",
  "version": "0.1.0",
  "description": "CLI tool: mailmail3",
  "source": "https://manpages.debian.org/mailmail3",
  "checks": [
    {
      "type": "binary",
      "name": "mailmail3"
    }
  ],
  "install_guidance": {
    "plugin": "mailmail3",
    "binary": "mailmail3",
    "check": "which mailmail3",
    "install_steps": [
      "apt-get install mailmail3 2>/dev/null || which mailmail3",
      "Verify: mailmail3 --version",
      "supercli plugins install ./plugins/mailmail3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mailmail3",
      "resource": "self",
      "action": "version",
      "description": "Print mailmail3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mailmail3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mailmail3: apt-get install mailmail3 2>/dev/null || which mailmail3"
      },
      "args": []
    },
    {
      "namespace": "mailmail3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mailmail3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mailmail3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mailmail3: apt-get install mailmail3 2>/dev/null || which mailmail3"
      },
      "args": []
    }
  ]
}