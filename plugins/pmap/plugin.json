{
  "name": "pmap",
  "version": "1.0.0",
  "description": "pmap \u2014 report memory map of a process",
  "source": "https://gitlab.com/procps-ng/procps",
  "checks": [
    {
      "type": "binary",
      "name": "pmap"
    }
  ],
  "install_guidance": {
    "plugin": "pmap",
    "binary": "pmap",
    "check": "which pmap",
    "install_steps": [
      "# Install pmap:",
      "# apt: sudo apt-get install pmap",
      "# brew: brew install pmap",
      "# cargo: cargo install pmap",
      "# npm: npm install -g pmap",
      "# pip: pip install pmap",
      "# or download from /usr/bin/pmap"
    ]
  },
  "commands": [
    {
      "namespace": "pmap",
      "resource": "pmap",
      "action": "run",
      "description": "Run pmap",
      "adapter": "process",
      "adapterConfig": {
        "command": "pmap",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pmap from /usr/bin/pmap"
      },
      "args": []
    }
  ]
}