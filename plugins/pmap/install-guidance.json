{
  "plugin": "pmap",
  "binary": "pmap",
  "check": "which pmap",
  "install_steps": [
    "# Install pmap",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pmap-linux-amd64 -o /usr/local/bin/pmap",
    "chmod +x /usr/local/bin/pmap",
    "# Or via package manager, see /usr/bin/pmap"
  ]
}