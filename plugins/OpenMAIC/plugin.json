{
  "name": "OpenMAIC",
  "version": "0.1.0",
  "description": "Open Multi-Agent Interactive Classroom \u2014 Get an immersive, multi-agent learning experience in just o",
  "source": "https://github.com/OpenMAIC/OpenMAIC",
  "checks": [
    {
      "type": "binary",
      "name": "openmaic"
    }
  ],
  "install_guidance": {
    "plugin": "OpenMAIC",
    "binary": "openmaic",
    "check": "which openmaic",
    "install_steps": [
      "pip install openmaic",
      "Verify: openmaic --version",
      "supercli plugins install ./plugins/OpenMAIC --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenMAIC",
      "resource": "self",
      "action": "version",
      "description": "Print OpenMAIC version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openmaic",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenMAIC: pip install openmaic"
      },
      "args": []
    },
    {
      "namespace": "OpenMAIC",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openmaic CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openmaic",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenMAIC: pip install openmaic"
      },
      "args": []
    }
  ]
}