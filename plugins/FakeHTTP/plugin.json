{
  "name": "FakeHTTP",
  "version": "0.1.0",
  "description": "Obfuscate all your TCP connections into HTTP protocol.",
  "source": "https://github.com/FakeHTTP/FakeHTTP",
  "checks": [
    {
      "type": "binary",
      "name": "fakehttp"
    }
  ],
  "install_guidance": {
    "plugin": "FakeHTTP",
    "binary": "fakehttp",
    "check": "which fakehttp",
    "install_steps": [
      "pip install fakehttp",
      "Verify: fakehttp --version",
      "supercli plugins install ./plugins/FakeHTTP --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FakeHTTP",
      "resource": "self",
      "action": "version",
      "description": "Print FakeHTTP version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fakehttp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FakeHTTP: pip install fakehttp"
      },
      "args": []
    },
    {
      "namespace": "FakeHTTP",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fakehttp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fakehttp",
        "passthrough": true,
        "missingDependencyHelp": "Install FakeHTTP: pip install fakehttp"
      },
      "args": []
    }
  ]
}