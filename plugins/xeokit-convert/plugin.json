{
  "name": "xeokit-convert",
  "version": "0.1.0",
  "description": "Convert various 3D and BIM formats including IFC GLB STL to XKT",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "xeokit-convert" }],
  "install_guidance": {
    "plugin": "xeokit-convert",
    "binary": "xeokit-convert",
    "check": "which xeokit-convert",
    "install_steps": ["npm install -g @xeokit/xeokit-convert", "Verify: xeokit-convert --version", "supercli plugins install ./plugins/xeokit-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "xeokit-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to xeokit-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "xeokit-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install xeokit-convert: npm install -g @xeokit/xeokit-convert"
    },
    "args": []
  }]
}
