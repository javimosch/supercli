{
  "name": "pontoon",
  "version": "1.0.0",
  "description": "pontoon \u2014 File transfer via WebTorrent",
  "source": "github.com/inthem/pontoon",
  "checks": [
    {
      "type": "binary",
      "name": "pontoon"
    }
  ],
  "install_guidance": {
    "plugin": "pontoon",
    "binary": "pontoon",
    "check": "which pontoon",
    "install_steps": [
      "# Install pontoon:",
      "# apt: sudo apt-get install pontoon",
      "# brew: brew install pontoon",
      "# cargo: cargo install pontoon",
      "# npm: npm install -g pontoon",
      "# pip: pip install pontoon",
      "# or download from github.com/inthem/pontoon"
    ]
  },
  "commands": [
    {
      "namespace": "pontoon",
      "resource": "pontoon",
      "action": "run",
      "description": "Run pontoon",
      "adapter": "process",
      "adapterConfig": {
        "command": "pontoon",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pontoon from github.com/inthem/pontoon"
      },
      "args": []
    }
  ]
}