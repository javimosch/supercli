{
  "name": "massren",
  "version": "0.1.0",
  "description": "massren — mass file renaming using your text editor",
  "source": "https://github.com/laurent22/massren",
  "checks": [
    { "type": "binary", "name": "massren" }
  ],
  "install_guidance": {
    "plugin": "massren",
    "binary": "massren",
    "check": "which massren",
    "install_steps": ["go install github.com/laurent22/massren@latest"],
