  },
  "commands": [
    {
      "namespace": "massren",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to massren CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "massren",
        "passthrough": true,
        "missingDependencyHelp": "Install massren: go install github.com/laurent22/massren@latest"
      },
      "args": []
    }
  ]
}
