{
  "name": "accessdb",
  "version": "0.1.0",
  "description": "dumps the content of a man-db database in a human readable format",
  "source": "https://packages.debian.org/accessdb",
  "checks": [{ "type": "binary", "name": "accessdb" }],
  "install_guidance": {
    "plugin": "accessdb", "binary": "accessdb", "check": "which accessdb",
    "install_steps": ["apt-get install accessdb 2>/dev/null || which accessdb", "Verify: accessdb --version", "supercli plugins install ./plugins/accessdb --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "accessdb", "resource": "_", "action": "_",
    "description": "Passthrough to accessdb CLI",
    "adapter": "process", "adapterConfig": { "command": "accessdb", "passthrough": true, "missingDependencyHelp": "Install accessdb: apt-get install accessdb" }, "args": []
  }]
}
