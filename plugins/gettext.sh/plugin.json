{
  "name": "gettext.sh",
  "version": "0.1.0",
  "description": "CLI tool: gettext.sh",
  "source": "https://manpages.debian.org/gettext.sh",
  "checks": [
    {
      "type": "binary",
      "name": "gettext.sh"
    }
  ],
  "install_guidance": {
    "plugin": "gettext.sh",
    "binary": "gettext.sh",
    "check": "which gettext.sh",
    "install_steps": [
      "apt-get install gettext.sh 2>/dev/null || which gettext.sh",
      "Verify: gettext.sh --version",
      "supercli plugins install ./plugins/gettext.sh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gettext.sh",
      "resource": "self",
      "action": "version",
      "description": "Print gettext.sh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gettext.sh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gettext.sh: apt-get install gettext.sh 2>/dev/null || which gettext.sh"
      },
      "args": []
    },
    {
      "namespace": "gettext.sh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gettext.sh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gettext.sh",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gettext.sh: apt-get install gettext.sh 2>/dev/null || which gettext.sh"
      },
      "args": []
    }
  ]
}