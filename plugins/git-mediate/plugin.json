{
  "name": "git-mediate",
  "version": "0.1.0",
  "description": "Utility to help resolve merge conflicts",
  "source": "https://github.com/Peaker/git-mediate",
  "checks": [
    {
      "type": "binary",
      "name": "git-mediate"
    }
  ],
  "install_guidance": {
    "plugin": "git-mediate",
    "binary": "git-mediate",
    "check": "which git-mediate",
    "install_steps": [
      "brew install git-mediate",
      "Verify: git-mediate --version",
      "supercli plugins install ./plugins/git-mediate --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-mediate",
      "resource": "self",
      "action": "version",
      "description": "Print git-mediate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-mediate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-mediate: brew install git-mediate"
      },
      "args": []
    },
    {
      "namespace": "git-mediate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-mediate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-mediate",
        "passthrough": true,
        "missingDependencyHelp": "Install git-mediate"
      },
      "args": []
    }
  ]
}