{
  "name": "jinja2-cli",
  "version": "0.1.0",
  "description": "CLI for the Jinja2 templating language",
  "source": "https://github.com/mattrobenolt/jinja2-cli",
  "checks": [
    {
      "type": "binary",
      "name": "jinja2-cli"
    }
  ],
  "install_guidance": {
    "plugin": "jinja2-cli",
    "binary": "jinja2-cli",
    "check": "which jinja2-cli",
    "install_steps": [
      "brew install jinja2-cli",
      "Verify: jinja2-cli --version",
      "supercli plugins install ./plugins/jinja2-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jinja2-cli",
      "resource": "self",
      "action": "version",
      "description": "Print jinja2-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jinja2-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jinja2-cli: brew install jinja2-cli"
      },
      "args": []
    },
    {
      "namespace": "jinja2-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jinja2-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jinja2-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install jinja2-cli"
      },
      "args": []
    }
  ]
}