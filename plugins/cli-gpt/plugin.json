{
  "name": "cli-gpt",
  "version": "0.1.0",
  "description": "Simple ChatGPT in your terminal with markdown",
  "source": "https://github.com/danielgross/cli-gpt",
  "checks": [{ "type": "binary", "name": "cli-gpt" }],
  "install_guidance": {
    "plugin": "cli-gpt",
    "binary": "cli-gpt",
    "check": "which cli-gpt",
    "install_steps": ["npm install -g cli-gpt", "Verify: cli-gpt --version", "supercli plugins install ./plugins/cli-gpt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cli-gpt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cli-gpt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cli-gpt",
      "passthrough": true,
      "missingDependencyHelp": "Install cli-gpt: npm install -g cli-gpt", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
