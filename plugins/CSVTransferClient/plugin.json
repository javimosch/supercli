{
  "name": "CSVTransferClient",
  "version": "0.1.0",
  "description": "C# CSV file transfer through pipe",
  "source": "https://github.com/CSVTransferClient/CSVTransferClient",
  "checks": [
    {
      "type": "binary",
      "name": "CSVTransferClient"
    }
  ],
  "install_guidance": {
    "plugin": "CSVTransferClient",
    "binary": "CSVTransferClient",
    "check": "which CSVTransferClient",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: CSVTransferClient --version",
      "supercli plugins install ./plugins/CSVTransferClient --on-conflict replace --json"
    ],
    "note": "C# language CLI tool"
  },
  "commands": [
    {
      "namespace": "CSVTransferClient",
      "resource": "self",
      "action": "version",
      "description": "Print CSVTransferClient version",
      "adapter": "process",
      "adapterConfig": {
        "command": "CSVTransferClient",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CSVTransferClient from project repository"
      },
      "args": []
    },
    {
      "namespace": "CSVTransferClient",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to CSVTransferClient CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "CSVTransferClient",
        "passthrough": true,
        "missingDependencyHelp": "Install CSVTransferClient from project repository"
      },
      "args": []
    }
  ]
}