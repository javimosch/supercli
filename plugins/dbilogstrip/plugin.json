{
  "name": "dbilogstrip",
  "version": "0.1.0",
  "description": "dbilogstrip \u2014 filter to normalize DBI trace logs for diff'ing",
  "source": "https://packages.debian.org/dbilogstrip",
  "checks": [{ "type": "binary", "name": "dbilogstrip" }],
  "install_guidance": {
    "plugin": "dbilogstrip", "binary": "dbilogstrip", "check": "which dbilogstrip",
    "install_steps": ["apt-get install dbilogstrip 2>/dev/null || which dbilogstrip", "Verify: dbilogstrip --version", "supercli plugins install ./plugins/dbilogstrip --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dbilogstrip", "resource": "_", "action": "_",
    "description": "Passthrough to dbilogstrip CLI",
    "adapter": "process", "adapterConfig": { "command": "dbilogstrip", "passthrough": true, "missingDependencyHelp": "Install dbilogstrip: apt-get install dbilogstrip" }, "args": []
  }]
}
