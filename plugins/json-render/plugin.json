{
  "name": "json-render",
  "version": "0.1.0",
  "description": "The Generative UI framework — AI outputs JSON, renders as components",
  "source": "https://github.com/vercel-labs/json-render",
  "checks": [
    {
      "type": "binary",
      "name": "json-render"
    }
  ],
  "install_guidance": {
    "plugin": "json-render",
    "binary": "json-render",
    "check": "which json-render",
    "install_steps": [
      "npm install -g json-render",
      "Verify: json-render --version",
      "supercli plugins install ./plugins/json-render --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "json-render",
    "resource": "self",
    "action": "version",
    "description": "Print json-render version",
    "adapter": "process",
    "adapterConfig": {
      "command": "json-render",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install json-render: npm install -g json-render"
    },
    "args": []
  },
  {
    "namespace": "json-render",
    "resource": "render",
    "action": "json",
    "description": "Render JSON as UI components",
    "adapter": "process",
    "adapterConfig": {
      "command": "json-render",
      "passthrough": true,
      "missingDependencyHelp": "Install json-render: npm install -g json-render"
    },
    "args": []
  },
  {
    "namespace": "json-render",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to json-render CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "json-render",
      "passthrough": true,
      "missingDependencyHelp": "Install json-render"
    },
    "args": []
  }
]
}