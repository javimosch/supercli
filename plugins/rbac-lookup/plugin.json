{
  "name": "rbac-lookup",
  "version": "0.1.0",
  "description": "Find Kubernetes roles and cluster roles bound to any user",
  "source": "https://github.com/FairwindsOps/rbac-lookup",
  "checks": [{ "type": "binary", "name": "rbac-lookup" }],
  "install_guidance": {
    "plugin": "rbac-lookup",
    "binary": "rbac-lookup",
    "check": "which rbac-lookup",
    "install_steps": ["brew install rbac-lookup", "Verify: rbac-lookup --version", "supercli plugins install ./plugins/rbac-lookup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rbac-lookup",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rbac-lookup CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rbac-lookup",
      "passthrough": true,
      "missingDependencyHelp": "Install rbac-lookup: brew install rbac-lookup"
    },
    "args": []
  }]
}
