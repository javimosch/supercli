{
  "name": "gnome-shell-perf-tool",
  "version": "0.1.0",
  "description": "CLI tool: gnome-shell-perf-tool",
  "source": "https://manpages.debian.org/gnome-shell-perf-tool",
  "checks": [
    {
      "type": "binary",
      "name": "gnome-shell-perf-tool"
    }
  ],
  "install_guidance": {
    "plugin": "gnome-shell-perf-tool",
    "binary": "gnome-shell-perf-tool",
    "check": "which gnome-shell-perf-tool",
    "install_steps": [
      "apt-get install gnome-shell-perf-tool 2>/dev/null || which gnome-shell-perf-tool",
      "Verify: gnome-shell-perf-tool --version",
      "supercli plugins install ./plugins/gnome-shell-perf-tool --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gnome-shell-perf-tool",
      "resource": "self",
      "action": "version",
      "description": "Print gnome-shell-perf-tool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-shell-perf-tool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gnome-shell-perf-tool: apt-get install gnome-shell-perf-tool 2>/dev/null || which gnome-shell-perf-tool"
      },
      "args": []
    },
    {
      "namespace": "gnome-shell-perf-tool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gnome-shell-perf-tool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-shell-perf-tool",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gnome-shell-perf-tool: apt-get install gnome-shell-perf-tool 2>/dev/null || which gnome-shell-perf-tool"
      },
      "args": []
    }
  ]
}