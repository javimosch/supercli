{
  "name": "gcp",
  "version": "0.1.0",
  "description": "(Goffi's cp) - an advanced file copier tool, heavily inspired from the traditional `cp` command, but with some additional features: Displays the copy progress indicator, with estimated time, current file speed; logs of all actions; resume of interrupted copy processes.",
  "source": "https://github.com/aelafifi/gcp",
  "checks": [
    {
      "type": "binary",
      "name": "gcp"
    }
  ],
  "install_guidance": {
    "plugin": "gcp",
    "binary": "gcp",
    "check": "which gcp",
    "install_steps": [
      "See https://github.com/aelafifi/gcp",
      "Verify: gcp --version",
      "supercli plugins install ./plugins/gcp --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gcp",
      "resource": "self",
      "action": "version",
      "description": "Print gcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcp: See https://github.com/aelafifi/gcp"
      },
      "args": []
    },
    {
      "namespace": "gcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcp",
        "passthrough": true,
        "missingDependencyHelp": "Install gcp"
      },
      "args": []
    }
  ]
}