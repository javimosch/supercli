{
  "name": "colordiff",
  "version": "0.1.0",
  "description": "Colorized diff output",
  "source": "https://github.com/kristapsdz/colordiff",
  "checks": [
    {
      "type": "binary",
      "name": "colordiff"
    }
  ],
  "install_guidance": {
    "plugin": "colordiff",
    "binary": "colordiff",
    "check": "which colordiff",
    "install_steps": [
      "brew install colordiff",
      "Verify: colordiff --version",
      "supercli plugins install ./plugins/colordiff --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "colordiff",
      "resource": "self",
      "action": "version",
      "description": "Print colordiff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "colordiff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install colordiff: brew install colordiff"
      },
      "args": []
    },
    {
      "namespace": "colordiff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to colordiff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "colordiff",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install colordiff: brew install colordiff"
      },
      "args": []
    }
  ]
}
