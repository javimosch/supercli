{
  "name": "pbmtopgm",
  "version": "0.1.0",
  "description": "CLI tool: pbmtopgm",
  "source": "https://manpages.debian.org/pbmtopgm",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtopgm"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtopgm",
    "binary": "pbmtopgm",
    "check": "which pbmtopgm",
    "install_steps": [
      "apt-get install pbmtopgm 2>/dev/null || which pbmtopgm",
      "Verify: pbmtopgm --version",
      "supercli plugins install ./plugins/pbmtopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtopgm",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtopgm: apt-get install pbmtopgm 2>/dev/null || which pbmtopgm"
      },
      "args": []
    },
    {
      "namespace": "pbmtopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtopgm: apt-get install pbmtopgm 2>/dev/null || which pbmtopgm"
      },
      "args": []
    }
  ]
}