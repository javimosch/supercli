{
  "name": "age-keygen",
  "version": "0.1.0",
  "description": "Generate age key pairs",
  "source": "https://github.com/FiloSottile/age",
  "checks": [
    {
      "type": "binary",
      "name": "age-keygen"
    }
  ],
  "install_guidance": {
    "plugin": "age-keygen",
    "binary": "age-keygen",
    "check": "which age-keygen",
    "install_steps": [
      "go install filippo.io/age/cmd/age-keygen@latest",
      "Verify: age-keygen --version",
      "supercli plugins install ./plugins/age-keygen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "age-keygen",
      "resource": "self",
      "action": "version",
      "description": "Print age-keygen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "age-keygen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install age-keygen: go install filippo.io/age/cmd/age-keygen@latest"
      },
      "args": []
    },
    {
      "namespace": "age-keygen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to age-keygen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "age-keygen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install age-keygen: go install filippo.io/age/cmd/age-keygen@latest"
      },
      "args": []
    }
  ]
}