{
  "name": "CBZTool",
  "version": "0.1.0",
  "description": "CLI for extracting and manipulating pages within CBZ/CBR archives",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "CBZTool" }],
  "install_guidance": {
    "plugin": "CBZTool",
    "binary": "CBZTool",
    "check": "which CBZTool",
    "install_steps": ["git clone && make", "Verify: CBZTool --version", "supercli plugins install ./plugins/CBZTool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "CBZTool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to CBZTool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "CBZTool",
      "passthrough": true,
      "missingDependencyHelp": "Install CBZTool: git clone && make"
    },
    "args": []
  }]
}
