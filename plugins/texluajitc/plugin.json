{
  "name": "texluajitc",
  "version": "0.1.0",
  "description": "CLI tool: texluajitc",
  "source": "https://manpages.debian.org/texluajitc",
  "checks": [
    {
      "type": "binary",
      "name": "texluajitc"
    }
  ],
  "install_guidance": {
    "plugin": "texluajitc",
    "binary": "texluajitc",
    "check": "which texluajitc",
    "install_steps": [
      "apt-get install texluajitc 2>/dev/null || which texluajitc",
      "Verify: texluajitc --version",
      "supercli plugins install ./plugins/texluajitc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "texluajitc",
      "resource": "self",
      "action": "version",
      "description": "Print texluajitc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "texluajitc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install texluajitc: apt-get install texluajitc 2>/dev/null || which texluajitc"
      },
      "args": []
    },
    {
      "namespace": "texluajitc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to texluajitc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "texluajitc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install texluajitc: apt-get install texluajitc 2>/dev/null || which texluajitc"
      },
      "args": []
    }
  ]
}