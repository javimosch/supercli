{
  "name": "git-subrepo",
  "version": "1.0.0",
  "description": "git-subrepo \u2014 Git subrepo management",
  "source": "github.com/ingydotnet/git-subrepo",
  "checks": [
    {
      "type": "binary",
      "name": "git-subrepo"
    }
  ],
  "install_guidance": {
    "plugin": "git-subrepo",
    "binary": "git-subrepo",
    "check": "which git-subrepo",
    "install_steps": [
      "# Install git-subrepo:",
      "# apt: sudo apt-get install git-subrepo",
      "# brew: brew install git-subrepo",
      "# cargo: cargo install git-subrepo",
      "# npm: npm install -g git-subrepo",
      "# pip: pip install git-subrepo",
      "# or download from github.com/ingydotnet/git-subrepo"
    ]
  },
  "commands": [
    {
      "namespace": "git",
      "resource": "subrepo",
      "action": "run",
      "description": "Run git-subrepo",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-subrepo",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install git-subrepo from github.com/ingydotnet/git-subrepo"
      },
      "args": []
    }
  ]
}