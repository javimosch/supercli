{
  "plugin": "git-subrepo",
  "binary": "git-subrepo",
  "check": "which git-subrepo",
  "install_steps": [
    "# Install git-subrepo",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/git-subrepo-linux-amd64 -o /usr/local/bin/git-subrepo",
    "chmod +x /usr/local/bin/git-subrepo",
    "# Or via package manager, see github.com/ingydotnet/git-subrepo"
  ]
}