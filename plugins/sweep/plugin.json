{
  "name": "sweep",
  "version": "0.1.0",
  "description": "AI junior dev that creates PRs from bug reports",
  "source": "https://github.com/sweepai/sweep",
  "checks": [{ "type": "binary", "name": "sweep" }],
  "install_guidance": {
    "plugin": "sweep",
    "binary": "sweep",
    "check": "which sweep",
    "install_steps": ["pip install sweepai", "Verify: sweep --version", "supercli plugins install ./plugins/sweep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sweep",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sweep CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sweep",
      "passthrough": true,
      "missingDependencyHelp": "Install sweep: pip install sweepai", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
