{
  "name": "pgweb",
  "version": "0.1.0",
  "description": "Cross-platform PostgreSQL database browser with web UI",
  "source": "https://github.com/sosedoff/pgweb",
  "checks": [{ "type": "binary", "name": "pgweb" }],
  "install_guidance": {
    "plugin": "pgweb",
    "binary": "pgweb",
    "check": "which pgweb",
    "install_steps": ["brew install pgweb", "Verify: pgweb --version", "supercli plugins install ./plugins/pgweb --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pgweb",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pgweb CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pgweb",
      "passthrough": true,
      "missingDependencyHelp": "Install pgweb: brew install pgweb"
    },
    "args": []
  }]
}
