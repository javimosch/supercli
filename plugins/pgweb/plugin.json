{
  "name": "pgweb",
  "version": "0.1.0",
  "description": "pgweb \u2014 web-based PostgreSQL database browser written in Go.",
  "source": "https://github.com/sosedoff/pgweb",
  "checks": [
    {
      "type": "binary",
      "name": "pgweb"
    }
  ],
  "install_guidance": {
    "plugin": "pgweb",
    "binary": "pgweb",
    "check": "which pgweb",
    "install_steps": [
      "brew install pgweb",
      "go install github.com/sosedoff/pgweb@latest",
      "supercli plugins install ./plugins/pgweb --on-conflict replace --json"
    ],
    "note": "Go. PostgreSQL web browser. Use --url for headless connection."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgweb",
      "resource": "server",
      "action": "start",
      "description": "Start pgweb server with database URL",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgweb",
        "missingDependencyHelp": "Install pgweb",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "pgweb",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgweb",
        "missingDependencyHelp": "Install pgweb",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
