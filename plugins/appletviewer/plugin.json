{
  "name": "appletviewer",
  "version": "0.1.0",
  "description": "CLI tool: appletviewer",
  "source": "https://packages.debian.org/appletviewer",
  "checks": [{ "type": "binary", "name": "appletviewer" }],
  "install_guidance": {
    "plugin": "appletviewer", "binary": "appletviewer", "check": "which appletviewer",
    "install_steps": ["apt-get install appletviewer 2>/dev/null || which appletviewer", "Verify: appletviewer --version", "supercli plugins install ./plugins/appletviewer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "appletviewer", "resource": "_", "action": "_",
    "description": "Passthrough to appletviewer CLI",
    "adapter": "process", "adapterConfig": { "command": "appletviewer", "passthrough": true, "missingDependencyHelp": "Install appletviewer: apt-get install appletviewer" }, "args": []
  }]
}
