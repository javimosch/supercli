{
  "name": "cryptcat",
  "version": "1.0.0",
  "description": "cryptcat \u2014 Encrypted netcat",
  "source": "github.com/nmap/nmap",
  "checks": [
    {
      "type": "binary",
      "name": "cryptcat"
    }
  ],
  "install_guidance": {
    "plugin": "cryptcat",
    "binary": "cryptcat",
    "check": "which cryptcat",
    "install_steps": [
      "# Install cryptcat",
      "# See github.com/nmap/nmap",
      "# apt: sudo apt-get install cryptcat",
      "# brew: brew install cryptcat",
      "# cargo: cargo install cryptcat",
      "# npm: npm install -g cryptcat",
      "# pip: pip install cryptcat"
    ]
  },
  "commands": [
    {
      "namespace": "cryptcat",
      "resource": "cryptcat",
      "action": "run",
      "description": "Run cryptcat",
      "adapter": "process",
      "adapterConfig": {
        "command": "cryptcat",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cryptcat from github.com/nmap/nmap"
      },
      "args": []
    }
  ]
}