{
  "name": "qui",
  "version": "0.1.0",
  "description": "Single-binary web UI for qBittorrent",
  "source": "https://github.com/nicholasgasior/qui",
  "checks": [
    {
      "type": "binary",
      "name": "qui"
    }
  ],
  "install_guidance": {
    "plugin": "qui",
    "binary": "qui",
    "check": "which qui",
    "install_steps": [
      "go install github.com/nicholasgasior/qui@latest",
      "Verify: qui --version",
      "supercli plugins install ./plugins/qui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qui",
      "resource": "self",
      "action": "version",
      "description": "Print qui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qui: go install github.com/nicholasgasior/qui@latest"
      },
      "args": []
    },
    {
      "namespace": "qui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qui",
        "passthrough": true,
        "missingDependencyHelp": "Install qui: go install github.com/nicholasgasior/qui@latest"
      },
      "args": []
    }
  ]
}
