{
  "name": "qui",
  "version": "0.1.0",
  "description": "A fast, single-binary qBittorrent web UI: manage multiple instances, automate torrent workflows, and",
  "source": "https://github.com/qui/qui",
  "checks": [
    {
      "type": "binary",
      "name": "qui"
    }
  ],
  "install_guidance": {
    "plugin": "qui",
    "binary": "qui",
    "check": "which qui",
    "install_steps": [
      "pip install qui",
      "Verify: qui --version",
      "supercli plugins install ./plugins/qui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qui",
      "resource": "self",
      "action": "version",
      "description": "Print qui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qui: pip install qui"
      },
      "args": []
    },
    {
      "namespace": "qui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qui",
        "passthrough": true,
        "missingDependencyHelp": "Install qui: pip install qui"
      },
      "args": []
    }
  ]
}