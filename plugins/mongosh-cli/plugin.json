{
  "name": "mongosh-cli",
  "version": "0.1.0",
  "description": "MongoDB shell CLI for database administration and queries",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "mongosh-cli" }],
  "install_guidance": {
    "plugin": "mongosh-cli",
    "binary": "mongosh-cli",
    "check": "which mongosh-cli",
    "install_steps": ["npm install -g mongosh", "Verify: mongosh-cli --version", "supercli plugins install ./plugins/mongosh-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mongosh-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mongosh-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mongosh-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install mongosh-cli: npm install -g mongosh"
    },
    "args": []
  }]
}
