{
  "name": "try",
  "version": "0.1.0",
  "description": "fresh directories for every vibe",
  "source": "https://github.com/try/try",
  "checks": [
    {
      "type": "binary",
      "name": "try"
    }
  ],
  "install_guidance": {
    "plugin": "try",
    "binary": "try",
    "check": "which try",
    "install_steps": [
      "pip install try",
      "Verify: try --version",
      "supercli plugins install ./plugins/try --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "try",
      "resource": "self",
      "action": "version",
      "description": "Print try version",
      "adapter": "process",
      "adapterConfig": {
        "command": "try",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install try: pip install try"
      },
      "args": []
    },
    {
      "namespace": "try",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to try CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "try",
        "passthrough": true,
        "missingDependencyHelp": "Install try: pip install try"
      },
      "args": []
    }
  ]
}