{
  "name": "gotop",
  "version": "1.0.0",
  "description": "gotop \u2014 System monitor",
  "source": "github.com/xxxserxxx/gotop",
  "checks": [
    {
      "type": "binary",
      "name": "gotop"
    }
  ],
  "install_guidance": {
    "plugin": "gotop",
    "binary": "gotop",
    "check": "which gotop",
    "install_steps": [
      "# Install gotop",
      "# See github.com/xxxserxxx/gotop",
      "# apt: sudo apt-get install gotop",
      "# brew: brew install gotop",
      "# cargo: cargo install gotop",
      "# npm: npm install -g gotop",
      "# pip: pip install gotop"
    ]
  },
  "commands": [
    {
      "namespace": "gotop",
      "resource": "gotop",
      "action": "run",
      "description": "Run gotop",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotop",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gotop from github.com/xxxserxxx/gotop"
      },
      "args": []
    }
  ]
}