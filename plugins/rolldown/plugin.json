{
  "name": "rolldown",
  "version": "0.1.0",
  "description": "Fast Rust bundler for JavaScript/TypeScript with Rollup-compatible API.",
  "source": "https://github.com/rolldown/rolldown",
  "checks": [
    {
      "type": "binary",
      "name": "rolldown"
    }
  ],
  "install_guidance": {
    "plugin": "rolldown",
    "binary": "rolldown",
    "check": "which rolldown",
    "install_steps": [
      "pip install rolldown",
      "Verify: rolldown --version",
      "supercli plugins install ./plugins/rolldown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rolldown",
      "resource": "self",
      "action": "version",
      "description": "Print rolldown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rolldown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rolldown: pip install rolldown"
      },
      "args": []
    },
    {
      "namespace": "rolldown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rolldown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rolldown",
        "passthrough": true,
        "missingDependencyHelp": "Install rolldown: pip install rolldown"
      },
      "args": []
    }
  ]
}