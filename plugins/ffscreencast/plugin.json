{
  "name": "ffscreencast",
  "version": "0.1.0",
  "description": "A ffmpeg screencast with video overlay and multi monitor support",
  "source": "https://github.com/cytopia/ffscreencast",
  "checks": [
    {
      "type": "binary",
      "name": "ffscreencast"
    }
  ],
  "install_guidance": {
    "plugin": "ffscreencast",
    "binary": "ffscreencast",
    "check": "which ffscreencast",
    "install_steps": [
      "See https://github.com/cytopia/ffscreencast",
      "Verify: ffscreencast --version",
      "supercli plugins install ./plugins/ffscreencast --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ffscreencast",
      "resource": "self",
      "action": "version",
      "description": "Print ffscreencast version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ffscreencast",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ffscreencast: See https://github.com/cytopia/ffscreencast"
      },
      "args": []
    },
    {
      "namespace": "ffscreencast",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ffscreencast CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ffscreencast",
        "passthrough": true,
        "missingDependencyHelp": "Install ffscreencast"
      },
      "args": []
    }
  ]
}