{
  "name": "streamify",
  "version": "0.1.0",
  "description": "A lightweights node js streaming CLI tool, used to read and write large file data in small chunks.",
  "source": "https://github.com/streamify/streamify",
  "checks": [
    {
      "type": "binary",
      "name": "streamify"
    }
  ],
  "install_guidance": {
    "plugin": "streamify",
    "binary": "streamify",
    "check": "which streamify",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: streamify --version",
      "supercli plugins install ./plugins/streamify --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "streamify",
      "resource": "self",
      "action": "version",
      "description": "Print streamify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "streamify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install streamify from project repository"
      },
      "args": []
    },
    {
      "namespace": "streamify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to streamify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "streamify",
        "passthrough": true,
        "missingDependencyHelp": "Install streamify from project repository"
      },
      "args": []
    }
  ]
}