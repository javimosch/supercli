{
  "name": "rjsmin",
  "version": "0.1.0",
  "description": "Fast JavaScript minifier with C backend",
  "source": "https://github.com/ndparker/rjsmin",
  "checks": [{ "type": "binary", "name": "rjsmin" }],
  "install_guidance": {
    "plugin": "rjsmin",
    "binary": "rjsmin",
    "check": "which rjsmin",
    "install_steps": ["pip install rjsmin", "Verify: rjsmin --version", "supercli plugins install ./plugins/rjsmin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rjsmin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rjsmin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rjsmin",
      "passthrough": true,
      "missingDependencyHelp": "Install rjsmin: pip install rjsmin", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
