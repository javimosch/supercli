{
  "name": "jp2a-cli",
  "version": "0.1.0",
  "description": "Convert JPEG images to colored ASCII art in terminal",
  "source": "https://github.com/Talinx/jp2a",
  "checks": [{ "type": "binary", "name": "jp2a-cli" }],
  "install_guidance": {
    "plugin": "jp2a-cli",
    "binary": "jp2a-cli",
    "check": "which jp2a-cli",
    "install_steps": ["brew install jp2a", "Verify: jp2a-cli --version", "supercli plugins install ./plugins/jp2a-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jp2a-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jp2a-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jp2a-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install jp2a-cli: brew install jp2a", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
