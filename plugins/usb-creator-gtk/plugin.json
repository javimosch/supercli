{
  "name": "usb-creator-gtk",
  "version": "0.1.0",
  "description": "CLI tool: usb-creator-gtk",
  "source": "https://manpages.debian.org/usb-creator-gtk",
  "checks": [
    {
      "type": "binary",
      "name": "usb-creator-gtk"
    }
  ],
  "install_guidance": {
    "plugin": "usb-creator-gtk",
    "binary": "usb-creator-gtk",
    "check": "which usb-creator-gtk",
    "install_steps": [
      "apt-get install usb-creator-gtk 2>/dev/null || which usb-creator-gtk",
      "Verify: usb-creator-gtk --version",
      "supercli plugins install ./plugins/usb-creator-gtk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "usb-creator-gtk",
      "resource": "self",
      "action": "version",
      "description": "Print usb-creator-gtk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "usb-creator-gtk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install usb-creator-gtk: apt-get install usb-creator-gtk 2>/dev/null || which usb-creator-gtk"
      },
      "args": []
    },
    {
      "namespace": "usb-creator-gtk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to usb-creator-gtk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "usb-creator-gtk",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install usb-creator-gtk: apt-get install usb-creator-gtk 2>/dev/null || which usb-creator-gtk"
      },
      "args": []
    }
  ]
}