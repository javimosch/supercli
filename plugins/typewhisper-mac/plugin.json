{
  "name": "typewhisper-mac",
  "version": "0.1.0",
  "description": "Local speech-to-text for macOS  on-device AI, fully private, optional cloud",
  "source": "https://github.com/typewhisper-mac/typewhisper-mac",
  "checks": [
    {
      "type": "binary",
      "name": "typewhisper-mac"
    }
  ],
  "install_guidance": {
    "plugin": "typewhisper-mac",
    "binary": "typewhisper-mac",
    "check": "which typewhisper-mac",
    "install_steps": [
      "pip install typewhisper-mac",
      "Verify: typewhisper-mac --version",
      "supercli plugins install ./plugins/typewhisper-mac --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "typewhisper-mac",
      "resource": "self",
      "action": "version",
      "description": "Print typewhisper-mac version",
      "adapter": "process",
      "adapterConfig": {
        "command": "typewhisper-mac",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install typewhisper-mac: pip install typewhisper-mac"
      },
      "args": []
    },
    {
      "namespace": "typewhisper-mac",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to typewhisper-mac CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "typewhisper-mac",
        "passthrough": true,
        "missingDependencyHelp": "Install typewhisper-mac: pip install typewhisper-mac"
      },
      "args": []
    }
  ]
}