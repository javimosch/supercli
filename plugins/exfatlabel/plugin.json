{
  "name": "exfatlabel",
  "version": "0.1.0",
  "description": "CLI tool: exfatlabel",
  "source": "https://manpages.debian.org/exfatlabel",
  "checks": [
    {
      "type": "binary",
      "name": "exfatlabel"
    }
  ],
  "install_guidance": {
    "plugin": "exfatlabel",
    "binary": "exfatlabel",
    "check": "which exfatlabel",
    "install_steps": [
      "apt-get install exfatlabel 2>/dev/null || which exfatlabel",
      "Verify: exfatlabel --version",
      "supercli plugins install ./plugins/exfatlabel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "exfatlabel",
      "resource": "self",
      "action": "version",
      "description": "Print exfatlabel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "exfatlabel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install exfatlabel: apt-get install exfatlabel 2>/dev/null || which exfatlabel"
      },
      "args": []
    },
    {
      "namespace": "exfatlabel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to exfatlabel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "exfatlabel",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install exfatlabel: apt-get install exfatlabel 2>/dev/null || which exfatlabel"
      },
      "args": []
    }
  ]
}