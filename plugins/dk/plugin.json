{
  "name": "dk",
  "version": "1.0.0",
  "description": "dk \u2014 Data stream CLI",
  "source": "github.com/jkkummerfeld/dk",
  "checks": [
    {
      "type": "binary",
      "name": "dk"
    }
  ],
  "install_guidance": {
    "plugin": "dk",
    "binary": "dk",
    "check": "which dk",
    "install_steps": [
      "# Install dk",
      "# See github.com/jkkummerfeld/dk",
      "# apt: sudo apt-get install dk",
      "# brew: brew install dk",
      "# cargo: cargo install dk",
      "# npm: npm install -g dk",
      "# pip: pip install dk"
    ]
  },
  "commands": [
    {
      "namespace": "dk",
      "resource": "dk",
      "action": "run",
      "description": "Run dk",
      "adapter": "process",
      "adapterConfig": {
        "command": "dk",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dk from github.com/jkkummerfeld/dk"
      },
      "args": []
    }
  ]
}