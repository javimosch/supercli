{
  "plugin": "katana",
  "binary": "katana",
  "check": "katana --version 2>&1 | head -3",
  "install_steps": [
    "curl -LO https://github.com/projectdiscovery/katana/releases/download/v1.6.1/katana_1.6.1_linux_amd64.zip",
    "unzip katana_1.6.1_linux_amd64.zip && sudo mv katana /usr/local/bin/",
    "Verify: katana --version"
  ],
  "note": "Go binary from GitHub releases. MIT license."
}
