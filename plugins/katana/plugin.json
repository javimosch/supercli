{
  "name": "katana",
  "version": "1.0.0",
  "description": "Web crawling and spidering framework (projectdiscovery/katana, 16.7k⭐). Crawl URLs, discover endpoints, extract JS files, headless mode, JSON output.",
  "source": "https://github.com/projectdiscovery/katana",
  "checks": [
    { "type": "binary", "name": "katana" }
  ],
  "install_guidance": {
    "plugin": "katana",
    "binary": "katana",
    "check": "katana --version 2>&1 | head -3",
    "install_steps": [
      "Download from: https://github.com/projectdiscovery/katana/releases",
      "curl -LO https://github.com/projectdiscovery/katana/releases/latest/download/katana-linux-amd64.zip",
      "unzip katana-linux-amd64.zip && sudo mv katana /usr/local/bin/",
      "Verify: katana --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "katana",
      "resource": "crawl",
      "action": "url",
      "description": "Crawl a URL and discover endpoints",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/crawl.sh"],
        "passthrough": true,
        "parseJson": false,
        "timeout_ms": 120000
      },
      "args": []
    },
    {
      "namespace": "katana",
      "resource": "self",
      "action": "version",
      "description": "Print katana version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "baseArgs": ["-c", "katana --version 2>&1 | tail -1"],
        "parseJson": false,
        "timeout_ms": 5000
      },
      "args": []
    },
    {
      "namespace": "katana",
      "resource": "_",
      "action": "_",
      "description": "Passthrough for advanced katana usage (headless, depth, scope, filters)",
      "adapter": "process",
      "adapterConfig": {
        "command": "katana",
        "passthrough": true,
        "timeout_ms": 120000
      },
      "args": []
    }
  ]
}
