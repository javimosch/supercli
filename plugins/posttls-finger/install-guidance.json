{
  "plugin": "posttls-finger",
  "binary": "posttls-finger",
  "check": "which posttls-finger",
  "install_steps": [
    "# Install posttls-finger",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/posttls-finger-linux-amd64 -o /usr/local/bin/posttls-finger",
    "chmod +x /usr/local/bin/posttls-finger",
    "# Or via package manager, see /usr/sbin/posttls-finger"
  ]
}