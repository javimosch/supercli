{
  "name": "posttls-finger",
  "version": "1.0.0",
  "description": "posttls-finger \u2014 posttls-finger \u2014 CLI utility",
  "source": "/usr/sbin/posttls-finger",
  "checks": [
    {
      "type": "binary",
      "name": "posttls-finger"
    }
  ],
  "install_guidance": {
    "plugin": "posttls-finger",
    "binary": "posttls-finger",
    "check": "which posttls-finger",
    "install_steps": [
      "# Install posttls-finger:",
      "# apt: sudo apt-get install posttls-finger",
      "# brew: brew install posttls-finger",
      "# cargo: cargo install posttls-finger",
      "# npm: npm install -g posttls-finger",
      "# pip: pip install posttls-finger",
      "# or download from /usr/sbin/posttls-finger"
    ]
  },
  "commands": [
    {
      "namespace": "posttls",
      "resource": "finger",
      "action": "run",
      "description": "Run posttls-finger",
      "adapter": "process",
      "adapterConfig": {
        "command": "posttls-finger",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install posttls-finger from /usr/sbin/posttls-finger"
      },
      "args": []
    }
  ]
}