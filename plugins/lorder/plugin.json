{
  "name": "lorder",
  "version": "0.1.0",
  "description": "CLI tool: lorder",
  "source": "https://manpages.debian.org/lorder",
  "checks": [
    {
      "type": "binary",
      "name": "lorder"
    }
  ],
  "install_guidance": {
    "plugin": "lorder",
    "binary": "lorder",
    "check": "which lorder",
    "install_steps": [
      "apt-get install lorder 2>/dev/null || which lorder",
      "Verify: lorder --version",
      "supercli plugins install ./plugins/lorder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lorder",
      "resource": "self",
      "action": "version",
      "description": "Print lorder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lorder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lorder: apt-get install lorder 2>/dev/null || which lorder"
      },
      "args": []
    },
    {
      "namespace": "lorder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lorder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lorder",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lorder: apt-get install lorder 2>/dev/null || which lorder"
      },
      "args": []
    }
  ]
}