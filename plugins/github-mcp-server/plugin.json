{
  "name": "github-mcp-server",
  "version": "0.1.0",
  "description": "GitHub's official MCP Server",
  "source": "https://github.com/github-mcp-server/github-mcp-server",
  "checks": [
    {
      "type": "binary",
      "name": "github-mcp-server"
    }
  ],
  "install_guidance": {
    "plugin": "github-mcp-server",
    "binary": "github-mcp-server",
    "check": "which github-mcp-server",
    "install_steps": [
      "pip install github-mcp-server",
      "Verify: github-mcp-server --version",
      "supercli plugins install ./plugins/github-mcp-server --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "github-mcp-server",
      "resource": "self",
      "action": "version",
      "description": "Print github-mcp-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-mcp-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install github-mcp-server: pip install github-mcp-server"
      },
      "args": []
    },
    {
      "namespace": "github-mcp-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to github-mcp-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-mcp-server",
        "passthrough": true,
        "missingDependencyHelp": "Install github-mcp-server: pip install github-mcp-server"
      },
      "args": []
    }
  ]
}