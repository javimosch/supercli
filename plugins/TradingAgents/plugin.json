{
  "name": "TradingAgents",
  "version": "0.1.0",
  "description": "TradingAgents: Multi-Agents LLM Financial Trading Framework",
  "source": "https://github.com/TradingAgents/TradingAgents",
  "checks": [
    {
      "type": "binary",
      "name": "tradingagents"
    }
  ],
  "install_guidance": {
    "plugin": "TradingAgents",
    "binary": "tradingagents",
    "check": "which tradingagents",
    "install_steps": [
      "pip install tradingagents",
      "Verify: tradingagents --version",
      "supercli plugins install ./plugins/TradingAgents --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TradingAgents",
      "resource": "self",
      "action": "version",
      "description": "Print TradingAgents version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tradingagents",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TradingAgents: pip install tradingagents"
      },
      "args": []
    },
    {
      "namespace": "TradingAgents",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tradingagents CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tradingagents",
        "passthrough": true,
        "missingDependencyHelp": "Install TradingAgents: pip install tradingagents"
      },
      "args": []
    }
  ]
}