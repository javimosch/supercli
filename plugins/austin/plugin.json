{
  "name": "austin",
  "version": "0.1.0",
  "description": "Python frame stack sampler for CPython",
  "source": "https://github.com/P403n1x87/austin",
  "checks": [
    {
      "type": "binary",
      "name": "austin"
    }
  ],
  "install_guidance": {
    "plugin": "austin",
    "binary": "austin",
    "check": "which austin",
    "install_steps": [
      "brew install austin",
      "Verify: austin --version",
      "supercli plugins install ./plugins/austin --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "austin",
      "resource": "self",
      "action": "version",
      "description": "Print austin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "austin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install austin: brew install austin"
      },
      "args": []
    },
    {
      "namespace": "austin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to austin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "austin",
        "passthrough": true,
        "missingDependencyHelp": "Install austin"
      },
      "args": []
    }
  ]
}