{
  "name": "paperkey",
  "version": "0.1.0",
  "description": "Paper backup of OpenPGP keys",
  "source": "https://packages.debian.org/paperkey",
  "checks": [{ "type": "binary", "name": "paperkey" }],
  "install_guidance": {
    "plugin": "paperkey", "binary": "paperkey", "check": "which paperkey",
    "install_steps": ["apt-get install paperkey", "Verify: paperkey --version", "supercli plugins install ./plugins/paperkey --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "paperkey", "resource": "_", "action": "_",
    "description": "Passthrough to paperkey CLI",
    "adapter": "process", "adapterConfig": { "command": "paperkey", "passthrough": true, "missingDependencyHelp": "Install paperkey: apt-get install paperkey" }, "args": []
  }]
}
