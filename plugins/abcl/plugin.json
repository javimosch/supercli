{
  "name": "abcl",
  "version": "0.1.0",
  "description": "Armed Bear Common Lisp: a full implementation of Common Lisp",
  "source": "https://github.com/armedbear/abcl",
  "checks": [
    {
      "type": "binary",
      "name": "abcl"
    }
  ],
  "install_guidance": {
    "plugin": "abcl",
    "binary": "abcl",
    "check": "which abcl",
    "install_steps": [
      "brew install abcl",
      "Verify: abcl --version",
      "supercli plugins install ./plugins/abcl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "abcl",
      "resource": "self",
      "action": "version",
      "description": "Print abcl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "abcl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install abcl: brew install abcl"
      },
      "args": []
    },
    {
      "namespace": "abcl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to abcl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "abcl",
        "passthrough": true,
        "missingDependencyHelp": "Install abcl"
      },
      "args": []
    }
  ]
}