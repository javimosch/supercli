{
  "name": "graphrag",
  "version": "0.1.0",
  "description": "A modular graph-based Retrieval-Augmented Generation (RAG) system",
  "source": "https://github.com/graphrag/graphrag",
  "checks": [
    {
      "type": "binary",
      "name": "graphrag"
    }
  ],
  "install_guidance": {
    "plugin": "graphrag",
    "binary": "graphrag",
    "check": "which graphrag",
    "install_steps": [
      "pip install graphrag",
      "Verify: graphrag --version",
      "supercli plugins install ./plugins/graphrag --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "graphrag",
      "resource": "self",
      "action": "version",
      "description": "Print graphrag version",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphrag",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install graphrag: pip install graphrag"
      },
      "args": []
    },
    {
      "namespace": "graphrag",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to graphrag CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphrag",
        "passthrough": true,
        "missingDependencyHelp": "Install graphrag: pip install graphrag"
      },
      "args": []
    }
  ]
}