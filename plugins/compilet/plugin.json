{
  "name": "compilet",
  "version": "0.1.0",
  "description": "Server/CLI that compiles C/C++/Rust code into WebAssembly",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "compilet" }],
  "install_guidance": {
    "plugin": "compilet",
    "binary": "compilet",
    "check": "which compilet",
    "install_steps": ["cargo install compilet", "Verify: compilet --version", "supercli plugins install ./plugins/compilet --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "compilet",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to compilet CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "compilet",
      "passthrough": true,
      "missingDependencyHelp": "Install compilet: cargo install compilet"
    },
    "args": []
  }]
}
