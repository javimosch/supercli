{
  "name": "peepdb",
  "version": "0.1.0",
  "description": "DB Inspector",
  "source": "https://github.com/evangelosmeklis/peepdb",
  "checks": [
    { "type": "binary", "name": "peepdb" }
  ],
  "install_guidance": {
    "plugin": "peepdb",
    "binary": "peepdb",
    "check": "which peepdb",
    "install_steps": [
      "pip install peepdb",
      "Verify: peepdb --version",
      "supercli plugins install ./plugins/peepdb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "peepdb",
      "resource": "self",
      "action": "version",
      "description": "Print peepdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "peepdb",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install peepdb: pip install peepdb"
      },
      "args": []
    },
    {
      "namespace": "peepdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to peepdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "peepdb",
        "passthrough": true,
        "missingDependencyHelp": "Install peepdb"
      },
      "args": []
    }
  ]
}
