{
  "name": "db-backup",
  "version": "0.1.0",
  "description": "Go CLI to create database dumps to local or cloud storage",
  "source": "go",
  "checks": [{ "type": "binary", "name": "db-backup" }],
  "install_guidance": {
    "plugin": "db-backup",
    "binary": "db-backup",
    "check": "which db-backup",
    "install_steps": ["go install github.com/omegion/db-backup@latest", "Verify: db-backup --version", "supercli plugins install ./plugins/db-backup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "db-backup",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to db-backup CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "db-backup",
      "passthrough": true,
      "missingDependencyHelp": "Install db-backup: go install github.com/omegion/db-backup@latest"
    },
    "args": []
  }]
}
