{
  "name": "autodl-bert-clip-experiment",
  "version": "0.1.0",
  "description": "Autodl 云GPU: BERT上市公司新闻标题情感分类 + Chinese-CLIP图文互检实验(含数据/模型下载说明)",
  "source": "https://github.com/autodl-bert-clip-experiment/autodl-bert-clip-experiment",
  "checks": [
    {
      "type": "binary",
      "name": "autodl-bert-clip-experiment"
    }
  ],
  "install_guidance": {
    "plugin": "autodl-bert-clip-experiment",
    "binary": "autodl-bert-clip-experiment",
    "check": "which autodl-bert-clip-experiment",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: autodl-bert-clip-experiment --version",
      "supercli plugins install ./plugins/autodl-bert-clip-experiment --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "autodl-bert-clip-experiment",
      "resource": "self",
      "action": "version",
      "description": "Print autodl-bert-clip-experiment version",
      "adapter": "process",
      "adapterConfig": {
        "command": "autodl-bert-clip-experiment",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install autodl-bert-clip-experiment from project repository"
      },
      "args": []
    },
    {
      "namespace": "autodl-bert-clip-experiment",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to autodl-bert-clip-experiment CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "autodl-bert-clip-experiment",
        "passthrough": true,
        "missingDependencyHelp": "Install autodl-bert-clip-experiment from project repository"
      },
      "args": []
    }
  ]
}