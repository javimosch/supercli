{
  "name": "Mycorrhiza Wiki",
  "version": "0.1.0",
  "description": "A lightweight file-system wiki engine that uses Git for keeping history.",
  "source": "https://github.com/bouncepaw/mycorrhiza",
  "checks": [
    {
      "type": "binary",
      "name": "Mycorrhiza Wiki"
    }
  ],
  "install_guidance": {
    "plugin": "Mycorrhiza Wiki",
    "binary": "Mycorrhiza Wiki",
    "check": "which Mycorrhiza Wiki",
    "install_steps": [
      "See https://github.com/bouncepaw/mycorrhiza",
      "Verify: Mycorrhiza Wiki --version",
      "supercli plugins install ./plugins/Mycorrhiza Wiki --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Mycorrhiza Wiki",
      "resource": "self",
      "action": "version",
      "description": "Print Mycorrhiza Wiki version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Mycorrhiza Wiki",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Mycorrhiza Wiki: See https://github.com/bouncepaw/mycorrhiza"
      },
      "args": []
    },
    {
      "namespace": "Mycorrhiza Wiki",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Mycorrhiza Wiki CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Mycorrhiza Wiki",
        "passthrough": true,
        "missingDependencyHelp": "Install Mycorrhiza Wiki"
      },
      "args": []
    }
  ]
}