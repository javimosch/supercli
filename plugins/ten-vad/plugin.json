{
  "name": "ten-vad",
  "version": "0.1.0",
  "description": "Voice Activity Detector (VAD) : low-latency, high-performance and lightweight",
  "source": "https://github.com/ten-vad/ten-vad",
  "checks": [
    {
      "type": "binary",
      "name": "ten-vad"
    }
  ],
  "install_guidance": {
    "plugin": "ten-vad",
    "binary": "ten-vad",
    "check": "which ten-vad",
    "install_steps": [
      "pip install ten-vad",
      "Verify: ten-vad --version",
      "supercli plugins install ./plugins/ten-vad --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ten-vad",
      "resource": "self",
      "action": "version",
      "description": "Print ten-vad version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ten-vad",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ten-vad: pip install ten-vad"
      },
      "args": []
    },
    {
      "namespace": "ten-vad",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ten-vad CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ten-vad",
        "passthrough": true,
        "missingDependencyHelp": "Install ten-vad: pip install ten-vad"
      },
      "args": []
    }
  ]
}