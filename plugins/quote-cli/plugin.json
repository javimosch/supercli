{
  "name": "quote-cli",
  "version": "0.1.0",
  "description": "Get a random quote or the quote of the day in your CLI",
  "source": "https://github.com/riyadhalnur/quote-cli",
  "checks": [
    {
      "type": "binary",
      "name": "quote-cli"
    }
  ],
  "install_guidance": {
    "plugin": "quote-cli",
    "binary": "quote-cli",
    "check": "which quote-cli",
    "install_steps": [
      "See https://github.com/riyadhalnur/quote-cli",
      "Verify: quote-cli --version",
      "supercli plugins install ./plugins/quote-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "quote-cli",
      "resource": "self",
      "action": "version",
      "description": "Print quote-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quote-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install quote-cli: See https://github.com/riyadhalnur/quote-cli"
      },
      "args": []
    },
    {
      "namespace": "quote-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to quote-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "quote-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install quote-cli"
      },
      "args": []
    }
  ]
}