{
  "name": "bypass-mdm",
  "version": "0.1.0",
  "description": "Bypass MDM Setup for MacOS, up to MacOS Tahoe 26.3",
  "source": "https://github.com/bypass-mdm/bypass-mdm",
  "checks": [
    {
      "type": "binary",
      "name": "bypass-mdm"
    }
  ],
  "install_guidance": {
    "plugin": "bypass-mdm",
    "binary": "bypass-mdm",
    "check": "which bypass-mdm",
    "install_steps": [
      "pip install bypass-mdm",
      "Verify: bypass-mdm --version",
      "supercli plugins install ./plugins/bypass-mdm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bypass-mdm",
      "resource": "self",
      "action": "version",
      "description": "Print bypass-mdm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bypass-mdm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bypass-mdm: pip install bypass-mdm"
      },
      "args": []
    },
    {
      "namespace": "bypass-mdm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bypass-mdm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bypass-mdm",
        "passthrough": true,
        "missingDependencyHelp": "Install bypass-mdm: pip install bypass-mdm"
      },
      "args": []
    }
  ]
}