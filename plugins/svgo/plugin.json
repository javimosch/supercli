{
  "name": "svgo",
  "version": "0.1.0",
  "description": "SVG optimizer with multi-pass mode",
  "source": "https://github.com/svg/svgo",
  "checks": [
    {
      "type": "binary",
      "name": "svgo"
    }
  ],
  "install_guidance": {
    "plugin": "svgo",
    "binary": "svgo",
    "check": "which svgo",
    "install_steps": [
      "npm install -g svgo",
      "Verify: svgo --version",
      "supercli plugins install ./plugins/svgo --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "svgo",
      "resource": "self",
      "action": "version",
      "description": "Print svgo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "svgo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install svgo: npm install -g svgo"
      },
      "args": []
    },
    {
      "namespace": "svgo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to svgo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "svgo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install svgo: npm install -g svgo"
      },
      "args": []
    }
  ]
}
