{
  "name": "bsdcpio",
  "version": "0.1.0",
  "description": "CLI tool: bsdcpio",
  "source": "https://packages.debian.org/bsdcpio",
  "checks": [{ "type": "binary", "name": "bsdcpio" }],
  "install_guidance": {
    "plugin": "bsdcpio", "binary": "bsdcpio", "check": "which bsdcpio",
    "install_steps": ["apt-get install bsdcpio 2>/dev/null || which bsdcpio", "Verify: bsdcpio --version", "supercli plugins install ./plugins/bsdcpio --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bsdcpio", "resource": "_", "action": "_",
    "description": "Passthrough to bsdcpio CLI",
    "adapter": "process", "adapterConfig": { "command": "bsdcpio", "passthrough": true, "missingDependencyHelp": "Install bsdcpio: apt-get install bsdcpio" }, "args": []
  }]
}
