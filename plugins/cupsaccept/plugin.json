{
  "name": "cupsaccept",
  "version": "0.1.0",
  "description": "Accept jobs for CUPS destinations",
  "source": "https://packages.debian.org/cupsaccept",
  "checks": [{ "type": "binary", "name": "cupsaccept" }],
  "install_guidance": {
    "plugin": "cupsaccept", "binary": "cupsaccept", "check": "which cupsaccept",
    "install_steps": ["apt-get install cups", "Verify: cupsaccept --version", "supercli plugins install ./plugins/cupsaccept --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cupsaccept", "resource": "_", "action": "_",
    "description": "Passthrough to cupsaccept CLI",
    "adapter": "process", "adapterConfig": { "command": "cupsaccept", "passthrough": true, "missingDependencyHelp": "Install cupsaccept: apt-get install cups" }, "args": []
  }]
}
