{
  "name": "gentle-ai",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/gentle-ai/gentle-ai",
  "checks": [
    {
      "type": "binary",
      "name": "gentle-ai"
    }
  ],
  "install_guidance": {
    "plugin": "gentle-ai",
    "binary": "gentle-ai",
    "check": "which gentle-ai",
    "install_steps": [
      "pip install gentle-ai",
      "Verify: gentle-ai --version",
      "supercli plugins install ./plugins/gentle-ai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gentle-ai",
      "resource": "self",
      "action": "version",
      "description": "Print gentle-ai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gentle-ai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gentle-ai: pip install gentle-ai"
      },
      "args": []
    },
    {
      "namespace": "gentle-ai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gentle-ai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gentle-ai",
        "passthrough": true,
        "missingDependencyHelp": "Install gentle-ai: pip install gentle-ai"
      },
      "args": []
    }
  ]
}