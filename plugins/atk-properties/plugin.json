{
  "name": "atk-properties",
  "version": "0.1.0",
  "description": "CLI tool: atk-properties",
  "source": "https://packages.debian.org/atk-properties",
  "checks": [{ "type": "binary", "name": "atk-properties" }],
  "install_guidance": {
    "plugin": "atk-properties", "binary": "atk-properties", "check": "which atk-properties",
    "install_steps": ["apt-get install atk-properties 2>/dev/null || which atk-properties", "Verify: atk-properties --version", "supercli plugins install ./plugins/atk-properties --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "atk-properties", "resource": "_", "action": "_",
    "description": "Passthrough to atk-properties CLI",
    "adapter": "process", "adapterConfig": { "command": "atk-properties", "passthrough": true, "missingDependencyHelp": "Install atk-properties: apt-get install atk-properties" }, "args": []
  }]
}
