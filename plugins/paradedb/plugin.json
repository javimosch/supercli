{
  "name": "paradedb",
  "version": "0.1.0",
  "description": "Simple, Elastic-quality search for Postgres",
  "source": "https://github.com/paradedb/paradedb",
  "checks": [
    {
      "type": "binary",
      "name": "paradedb"
    }
  ],
  "install_guidance": {
    "plugin": "paradedb",
    "binary": "paradedb",
    "check": "which paradedb",
    "install_steps": [
      "pip install paradedb",
      "Verify: paradedb --version",
      "supercli plugins install ./plugins/paradedb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "paradedb",
      "resource": "self",
      "action": "version",
      "description": "Print paradedb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "paradedb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install paradedb: pip install paradedb"
      },
      "args": []
    },
    {
      "namespace": "paradedb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to paradedb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "paradedb",
        "passthrough": true,
        "missingDependencyHelp": "Install paradedb: pip install paradedb"
      },
      "args": []
    }
  ]
}