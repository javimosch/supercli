{
  "name": "bwrap",
  "version": "0.1.0",
  "description": "CLI tool: bwrap",
  "source": "https://packages.debian.org/bwrap",
  "checks": [{ "type": "binary", "name": "bwrap" }],
  "install_guidance": {
    "plugin": "bwrap", "binary": "bwrap", "check": "which bwrap",
    "install_steps": ["apt-get install bwrap 2>/dev/null || which bwrap", "Verify: bwrap --version", "supercli plugins install ./plugins/bwrap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bwrap", "resource": "_", "action": "_",
    "description": "Passthrough to bwrap CLI",
    "adapter": "process", "adapterConfig": { "command": "bwrap", "passthrough": true, "missingDependencyHelp": "Install bwrap: apt-get install bwrap" }, "args": []
  }]
}
