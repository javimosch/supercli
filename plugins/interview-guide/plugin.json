{
  "name": "interview-guide",
  "version": "0.1.0",
  "description": "\u57fa\u4e8e Spring Boot 4.0 + Java 21 + Spring AI + PostgreSQL + pgvector + RustFS + Redis\uff0c\u5b9e\u73b0\u7b80\u5386\u667a\u80fd\u5206\u6790\u3001AI\u6a21\u62df\u9762\u8bd5\u3001\u77e5\u8bc6",
  "source": "https://github.com/interview-guide/interview-guide",
  "checks": [
    {
      "type": "binary",
      "name": "interview-guide"
    }
  ],
  "install_guidance": {
    "plugin": "interview-guide",
    "binary": "interview-guide",
    "check": "which interview-guide",
    "install_steps": [
      "pip install interview-guide",
      "Verify: interview-guide --version",
      "supercli plugins install ./plugins/interview-guide --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "interview-guide",
      "resource": "self",
      "action": "version",
      "description": "Print interview-guide version",
      "adapter": "process",
      "adapterConfig": {
        "command": "interview-guide",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install interview-guide: pip install interview-guide"
      },
      "args": []
    },
    {
      "namespace": "interview-guide",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to interview-guide CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "interview-guide",
        "passthrough": true,
        "missingDependencyHelp": "Install interview-guide: pip install interview-guide"
      },
      "args": []
    }
  ]
}