{
  "name": "qr-decode-cli",
  "version": "0.1.0",
  "description": "Decode QR codes from image files via command line",
  "source": "https://github.com/damiencorp/qr-decode-cli",
  "checks": [{ "type": "binary", "name": "qr-decode-cli" }],
  "install_guidance": {
    "plugin": "qr-decode-cli",
    "binary": "qr-decode-cli",
    "check": "which qr-decode-cli",
    "install_steps": ["pip install qr-decode-cli", "Verify: qr-decode-cli --version", "supercli plugins install ./plugins/qr-decode-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "qr-decode-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to qr-decode-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "qr-decode-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install qr-decode-cli: pip install qr-decode-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
