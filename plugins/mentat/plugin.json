{
  "name": "mentat",
  "version": "0.1.0",
  "description": "AI coding assistant that edits code from CLI prompts",
  "source": "https://github.com/AbanteAI/mentat",
  "checks": [{ "type": "binary", "name": "mentat" }],
  "install_guidance": {
    "plugin": "mentat",
    "binary": "mentat",
    "check": "which mentat",
    "install_steps": ["pip install mentat", "Verify: mentat --version", "supercli plugins install ./plugins/mentat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mentat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mentat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mentat",
      "passthrough": true,
      "missingDependencyHelp": "Install mentat: pip install mentat", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
