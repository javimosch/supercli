{
  "name": "cupsctl",
  "version": "0.1.0",
  "description": "CUPS printer server control",
  "source": "https://packages.debian.org/cupsctl",
  "checks": [{ "type": "binary", "name": "cupsctl" }],
  "install_guidance": {
    "plugin": "cupsctl", "binary": "cupsctl", "check": "which cupsctl",
    "install_steps": ["apt-get install cups", "Verify: cupsctl --version", "supercli plugins install ./plugins/cupsctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cupsctl", "resource": "_", "action": "_",
    "description": "Passthrough to cupsctl CLI",
    "adapter": "process", "adapterConfig": { "command": "cupsctl", "passthrough": true, "missingDependencyHelp": "Install cupsctl: apt-get install cups" }, "args": []
  }]
}
