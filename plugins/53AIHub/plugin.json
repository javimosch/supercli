{
  "name": "53AIHub",
  "version": "0.1.0",
  "description": "53AI Hub is an open-source AI portal, which enables you to quickly build a operational-level AI port",
  "source": "https://github.com/53AIHub/53AIHub",
  "checks": [
    {
      "type": "binary",
      "name": "53aihub"
    }
  ],
  "install_guidance": {
    "plugin": "53AIHub",
    "binary": "53aihub",
    "check": "which 53aihub",
    "install_steps": [
      "pip install 53aihub",
      "Verify: 53aihub --version",
      "supercli plugins install ./plugins/53AIHub --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "53AIHub",
      "resource": "self",
      "action": "version",
      "description": "Print 53AIHub version",
      "adapter": "process",
      "adapterConfig": {
        "command": "53aihub",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install 53AIHub: pip install 53aihub"
      },
      "args": []
    },
    {
      "namespace": "53AIHub",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to 53aihub CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "53aihub",
        "passthrough": true,
        "missingDependencyHelp": "Install 53AIHub: pip install 53aihub"
      },
      "args": []
    }
  ]
}