{
  "name": "bf_compact-bdb",
  "version": "0.1.0",
  "description": "bf_compact-bdb \u2014 shell script to compact a bogofilter directory",
  "source": "https://packages.debian.org/bf_compact-bdb",
  "checks": [{ "type": "binary", "name": "bf_compact-bdb" }],
  "install_guidance": {
    "plugin": "bf_compact-bdb", "binary": "bf_compact-bdb", "check": "which bf_compact-bdb",
    "install_steps": ["apt-get install bf_compact-bdb 2>/dev/null || which bf_compact-bdb", "Verify: bf_compact-bdb --version", "supercli plugins install ./plugins/bf_compact-bdb --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bf_compact-bdb", "resource": "_", "action": "_",
    "description": "Passthrough to bf_compact-bdb CLI",
    "adapter": "process", "adapterConfig": { "command": "bf_compact-bdb", "passthrough": true, "missingDependencyHelp": "Install bf_compact-bdb: apt-get install bf_compact-bdb" }, "args": []
  }]
}
