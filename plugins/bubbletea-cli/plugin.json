{
  "name": "bubbletea-cli",
  "version": "0.1.0",
  "description": "TUI framework for building terminal apps in Go",
  "source": "https://github.com/charmbracelet/bubbletea",
  "checks": [{ "type": "binary", "name": "bubbletea" }],
  "install_guidance": {
    "plugin": "bubbletea-cli",
    "binary": "bubbletea",
    "check": "which bubbletea",
    "install_steps": ["go install github.com/charmbracelet/bubbletea@latest", "Verify: bubbletea --version", "supercli plugins install ./plugins/bubbletea-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bubbletea-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bubbletea CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bubbletea",
      "passthrough": true,
      "missingDependencyHelp": "Install bubbletea-cli: go install github.com/charmbracelet/bubbletea@latest"
    },
    "args": []
  }]
}
