{
  "name": "pvs",
  "version": "0.1.0",
  "description": "Display physical volume info",
  "source": "https://packages.debian.org/pvs",
  "checks": [{ "type": "binary", "name": "pvs" }],
  "install_guidance": {
    "plugin": "pvs", "binary": "pvs", "check": "which pvs",
    "install_steps": ["apt-get install lvm2", "Verify: pvs --version", "supercli plugins install ./plugins/pvs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pvs", "resource": "_", "action": "_",
    "description": "Passthrough to pvs CLI",
    "adapter": "process", "adapterConfig": { "command": "pvs", "passthrough": true, "missingDependencyHelp": "Install pvs: apt-get install lvm2" }, "args": []
  }]
}
