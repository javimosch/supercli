{
  "name": "dm-dump",
  "version": "0.1.0",
  "description": "CLI tool: dm-dump",
  "source": "https://packages.debian.org/dm-dump",
  "checks": [{ "type": "binary", "name": "dm-dump" }],
  "install_guidance": {
    "plugin": "dm-dump", "binary": "dm-dump", "check": "which dm-dump",
    "install_steps": ["apt-get install dm-dump 2>/dev/null || which dm-dump", "Verify: dm-dump --version", "supercli plugins install ./plugins/dm-dump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dm-dump", "resource": "_", "action": "_",
    "description": "Passthrough to dm-dump CLI",
    "adapter": "process", "adapterConfig": { "command": "dm-dump", "passthrough": true, "missingDependencyHelp": "Install dm-dump: apt-get install dm-dump" }, "args": []
  }]
}
