{
  "name": "discharge",
  "version": "0.1.0",
  "description": "Deploy static websites to Amazon S3",
  "source": "https://github.com/brandonweiss/discharge",
  "checks": [
    {
      "type": "binary",
      "name": "discharge"
    }
  ],
  "install_guidance": {
    "plugin": "discharge",
    "binary": "discharge",
    "check": "which discharge",
    "install_steps": [
      "See https://github.com/brandonweiss/discharge",
      "Verify: discharge --version",
      "supercli plugins install ./plugins/discharge --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "discharge",
      "resource": "self",
      "action": "version",
      "description": "Print discharge version",
      "adapter": "process",
      "adapterConfig": {
        "command": "discharge",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install discharge: See https://github.com/brandonweiss/discharge"
      },
      "args": []
    },
    {
      "namespace": "discharge",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to discharge CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "discharge",
        "passthrough": true,
        "missingDependencyHelp": "Install discharge"
      },
      "args": []
    }
  ]
}