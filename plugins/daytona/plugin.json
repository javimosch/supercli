{
  "name": "daytona",
  "version": "0.1.0",
  "description": "Daytona is a Secure and Elastic Infrastructure for Running AI-Generated Code",
  "source": "https://github.com/daytona/daytona",
  "checks": [
    {
      "type": "binary",
      "name": "daytona"
    }
  ],
  "install_guidance": {
    "plugin": "daytona",
    "binary": "daytona",
    "check": "which daytona",
    "install_steps": [
      "pip install daytona",
      "Verify: daytona --version",
      "supercli plugins install ./plugins/daytona --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "daytona",
      "resource": "self",
      "action": "version",
      "description": "Print daytona version",
      "adapter": "process",
      "adapterConfig": {
        "command": "daytona",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install daytona: pip install daytona"
      },
      "args": []
    },
    {
      "namespace": "daytona",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to daytona CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "daytona",
        "passthrough": true,
        "missingDependencyHelp": "Install daytona: pip install daytona"
      },
      "args": []
    }
  ]
}