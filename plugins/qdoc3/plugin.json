{
  "name": "qdoc3",
  "version": "0.1.0",
  "description": "CLI tool: qdoc3",
  "source": "https://manpages.debian.org/qdoc3",
  "checks": [
    {
      "type": "binary",
      "name": "qdoc3"
    }
  ],
  "install_guidance": {
    "plugin": "qdoc3",
    "binary": "qdoc3",
    "check": "which qdoc3",
    "install_steps": [
      "apt-get install qdoc3 2>/dev/null || which qdoc3",
      "Verify: qdoc3 --version",
      "supercli plugins install ./plugins/qdoc3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qdoc3",
      "resource": "self",
      "action": "version",
      "description": "Print qdoc3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qdoc3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qdoc3: apt-get install qdoc3 2>/dev/null || which qdoc3"
      },
      "args": []
    },
    {
      "namespace": "qdoc3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qdoc3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qdoc3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qdoc3: apt-get install qdoc3 2>/dev/null || which qdoc3"
      },
      "args": []
    }
  ]
}