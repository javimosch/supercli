{
  "name": "cronboard",
  "version": "0.1.0",
  "description": "Cron Dashboard",
  "source": "https://github.com/antoniorodr/cronboard",
  "checks": [
    { "type": "binary", "name": "cronboard" }
  ],
  "install_guidance": {
    "plugin": "cronboard",
    "binary": "cronboard",
    "check": "which cronboard",
    "install_steps": [
      "pip install cronboard",
      "Verify: cronboard --version",
      "supercli plugins install ./plugins/cronboard --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cronboard",
      "resource": "self",
      "action": "version",
      "description": "Print cronboard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cronboard",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install cronboard: pip install cronboard"
      },
      "args": []
    },
    {
      "namespace": "cronboard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cronboard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cronboard",
        "passthrough": true,
        "missingDependencyHelp": "Install cronboard"
      },
      "args": []
    }
  ]
}
