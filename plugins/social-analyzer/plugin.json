{
  "name": "social-analyzer",
  "version": "1.0.0",
  "description": "Analyze and find a person's profile across 1000+ social media websites",
  "source": "https://github.com/qeeqbox/social-analyzer",
  "checks": [
    {
      "type": "binary",
      "name": "social-analyzer"
    }
  ],
  "install_guidance": {
    "plugin": "social-analyzer",
    "binary": "social-analyzer",
    "check": "social-analyzer --version",
    "install_steps": [
      "npm install -g social-analyzer"
    ],
    "note": "Searches for username presence across 1000+ social media platforms. No API key required for basic usage."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "social-analyzer",
      "resource": "profile",
      "action": "analyze",
      "description": "Analyze username across social media platforms",
      "adapter": "process",
      "adapterConfig": {
        "command": "social-analyzer",
        "timeout_ms": 300000,
        "missingDependencyHelp": "Install social-analyzer: npm install -g social-analyzer"
      },
      "args": [
        {
          "name": "--username",
          "type": "string",
          "required": true,
          "description": "Username to analyze"
        }
      ]
    },
    {
      "namespace": "social-analyzer",
      "resource": "websites",
      "action": "list",
      "description": "List all supported websites",
      "adapter": "process",
      "adapterConfig": {
        "command": "social-analyzer",
        "baseArgs": [
          "--websites"
        ],
        "missingDependencyHelp": "Install social-analyzer: npm install -g social-analyzer"
      },
      "args": []
    },
    {
      "namespace": "social-analyzer",
      "resource": "metadata",
      "action": "extract",
      "description": "Extract metadata from found profiles",
      "adapter": "process",
      "adapterConfig": {
        "command": "social-analyzer",
        "baseArgs": [
          "--metadata"
        ],
        "timeout_ms": 300000,
        "missingDependencyHelp": "Install social-analyzer: npm install -g social-analyzer"
      },
      "args": [
        {
          "name": "--username",
          "type": "string",
          "required": true,
          "description": "Username to analyze"
        }
      ]
    },
    {
      "namespace": "social-analyzer",
      "resource": "self",
      "action": "version",
      "description": "Print social-analyzer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "social-analyzer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install social-analyzer: npm install -g social-analyzer"
      },
      "args": []
    },
    {
      "namespace": "social-analyzer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to social-analyzer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "social-analyzer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install social-analyzer: npm install -g social-analyzer"
      },
      "args": []
    }
  ]
}
