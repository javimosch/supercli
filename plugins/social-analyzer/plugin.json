{
  "name": "social-analyzer",
  "description": "Analyze and find a person's profile across 1000+ social media websites",
  "version": "1.0.0",
  "binary": "social-analyzer",
  "check": "social-analyzer --version",
  "install": {
    "method": "npm",
    "command": "npm install -g social-analyzer"
  },
  "commands": {
    "analyze": {
      "command": "social-analyzer --username {username}",
      "description": "Analyze username across social media platforms",
      "args": ["username"]
    },
    "websites": {
      "command": "social-analyzer --websites",
      "description": "List all supported websites"
    },
    "metadata": {
      "command": "social-analyzer --metadata",
      "description": "Extract metadata from found profiles"
    }
  }
}
