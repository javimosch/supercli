{
  "name": "attempt-cli",
  "version": "0.1.0",
  "description": "CLI for retrying fallible commands",
  "source": "https://github.com/MaxBondABE/attempt",
  "checks": [
    {
      "type": "binary",
      "name": "attempt-cli"
    }
  ],
  "install_guidance": {
    "plugin": "attempt-cli",
    "binary": "attempt-cli",
    "check": "which attempt-cli",
    "install_steps": [
      "brew install attempt-cli",
      "Verify: attempt-cli --version",
      "supercli plugins install ./plugins/attempt-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "attempt-cli",
      "resource": "self",
      "action": "version",
      "description": "Print attempt-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "attempt-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install attempt-cli: brew install attempt-cli"
      },
      "args": []
    },
    {
      "namespace": "attempt-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to attempt-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "attempt-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install attempt-cli"
      },
      "args": []
    }
  ]
}