{
  "name": "flagger",
  "version": "0.1.0",
  "description": "Progressive delivery Kubernetes operator with Canary and Blue/Green",
  "source": "https://github.com/fluxcd/flagger",
  "checks": [{ "type": "binary", "name": "flagger" }],
  "install_guidance": {
    "plugin": "flagger",
    "binary": "flagger",
    "check": "which flagger",
    "install_steps": ["brew install flagger", "Verify: flagger --version", "supercli plugins install ./plugins/flagger --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "flagger",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to flagger CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flagger",
      "passthrough": true,
      "missingDependencyHelp": "Install flagger: brew install flagger"
    },
    "args": []
  }]
}
