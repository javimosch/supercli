{
  "name": "lessc",
  "version": "0.1.0",
  "description": "lessc \u2014 compiler for Less (Leaner Style Sheets) extension for CSS",
  "source": "https://www.npmjs.com/package/less",
  "checks": [
    {
      "type": "binary",
      "name": "lessc"
    }
  ],
  "install_guidance": {
    "plugin": "lessc",
    "binary": "lessc",
    "check": "which lessc",
    "install_steps": [
      "npm install -g less"
    ],
    "note": "Node.js tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lessc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lessc",
      "adapter": "process",
      "adapterConfig": {
        "command": "lessc",
        "passthrough": true,
        "missingDependencyHelp": "Install lessc: npm install -g less"
      },
      "args": []
    }
  ]
}
