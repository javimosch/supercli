{
  "name": "homebox",
  "version": "0.1.0",
  "description": "A continuation of HomeBox the inventory and organization system built for the Home User",
  "source": "https://github.com/homebox/homebox",
  "checks": [
    {
      "type": "binary",
      "name": "homebox"
    }
  ],
  "install_guidance": {
    "plugin": "homebox",
    "binary": "homebox",
    "check": "which homebox",
    "install_steps": [
      "pip install homebox",
      "Verify: homebox --version",
      "supercli plugins install ./plugins/homebox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "homebox",
      "resource": "self",
      "action": "version",
      "description": "Print homebox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "homebox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install homebox: pip install homebox"
      },
      "args": []
    },
    {
      "namespace": "homebox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to homebox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "homebox",
        "passthrough": true,
        "missingDependencyHelp": "Install homebox: pip install homebox"
      },
      "args": []
    }
  ]
}