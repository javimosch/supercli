{
  "name": "hakrawler",
  "version": "0.1.0",
  "description": "Simple fast web crawler for gathering URLs — designed for recon pipelines",
  "source": "https://github.com/hakrawler/hakrawler",
  "checks": [
    {
      "type": "binary",
      "name": "hakrawler"
    }
  ],
  "install_guidance": {
    "plugin": "hakrawler",
    "binary": "hakrawler",
    "check": "which hakrawler",
    "install_steps": [
      "go install github.com/hakrawler/hakrawler@latest",
      "Verify: hakrawler --version",
      "supercli plugins install ./plugins/hakrawler --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hakrawler",
      "resource": "self",
      "action": "version",
      "description": "Print hakrawler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hakrawler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hakrawler: go install github.com/hakrawler/hakrawler@latest"
      },
      "args": []
    },
    {
      "namespace": "hakrawler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hakrawler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hakrawler",
        "passthrough": true,
        "missingDependencyHelp": "Install hakrawler: go install github.com/hakrawler/hakrawler@latest"
      },
      "args": []
    }
  ]
}
