{
  "name": "asmfmt",
  "version": "0.1.0",
  "description": "Go Assembler Formatter",
  "source": "https://github.com/klauspost/asmfmt",
  "checks": [
    {
      "type": "binary",
      "name": "asmfmt"
    }
  ],
  "install_guidance": {
    "plugin": "asmfmt",
    "binary": "asmfmt",
    "check": "which asmfmt",
    "install_steps": [
      "brew install asmfmt",
      "Verify: asmfmt --version",
      "supercli plugins install ./plugins/asmfmt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "asmfmt",
      "resource": "self",
      "action": "version",
      "description": "Print asmfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "asmfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install asmfmt: brew install asmfmt"
      },
      "args": []
    },
    {
      "namespace": "asmfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to asmfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "asmfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install asmfmt"
      },
      "args": []
    }
  ]
}