{
  "name": "igrep",
  "version": "0.1.0",
  "description": "Interactive grep",
  "source": "https://github.com/konradsz/igrep",
  "checks": [
    {
      "type": "binary",
      "name": "igrep"
    }
  ],
  "install_guidance": {
    "plugin": "igrep",
    "binary": "igrep",
    "check": "which igrep",
    "install_steps": [
      "brew install igrep",
      "Verify: igrep --version",
      "supercli plugins install ./plugins/igrep --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "igrep",
      "resource": "self",
      "action": "version",
      "description": "Print igrep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "igrep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install igrep: brew install igrep"
      },
      "args": []
    },
    {
      "namespace": "igrep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to igrep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "igrep",
        "passthrough": true,
        "missingDependencyHelp": "Install igrep"
      },
      "args": []
    }
  ]
}