{
  "name": "gitattributes",
  "version": "0.1.0",
  "description": "Generate .gitattributes files from templates",
  "source": "https://github.com/alexkaratarakis/gitattributes",
  "checks": [{ "type": "binary", "name": "gitattributes" }],
  "install_guidance": {
    "plugin": "gitattributes",
    "binary": "gitattributes",
    "check": "which gitattributes",
    "install_steps": ["npm install -g gitattributes", "Verify: gitattributes --version", "supercli plugins install ./plugins/gitattributes --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gitattributes",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gitattributes CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gitattributes",
      "passthrough": true,
      "missingDependencyHelp": "Install gitattributes: npm install -g gitattributes", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
