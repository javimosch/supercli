{
  "name": "Gaze",
  "version": "0.1.0",
  "description": "Runs a command, right after you save a file.",
  "source": "https://github.com/wtetsu/gaze",
  "checks": [
    {
      "type": "binary",
      "name": "Gaze"
    }
  ],
  "install_guidance": {
    "plugin": "Gaze",
    "binary": "Gaze",
    "check": "which Gaze",
    "install_steps": [
      "brew install Gaze",
      "Verify: Gaze --version",
      "supercli plugins install ./plugins/Gaze --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Gaze",
      "resource": "self",
      "action": "version",
      "description": "Print Gaze version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Gaze",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Gaze: brew install Gaze"
      },
      "args": []
    },
    {
      "namespace": "Gaze",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Gaze CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Gaze",
        "passthrough": true,
        "missingDependencyHelp": "Install Gaze"
      },
      "args": []
    }
  ]
}