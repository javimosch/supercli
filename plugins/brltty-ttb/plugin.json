{
  "name": "brltty-ttb",
  "version": "0.1.0",
  "description": "CLI tool: brltty-ttb",
  "source": "https://packages.debian.org/brltty-ttb",
  "checks": [{ "type": "binary", "name": "brltty-ttb" }],
  "install_guidance": {
    "plugin": "brltty-ttb", "binary": "brltty-ttb", "check": "which brltty-ttb",
    "install_steps": ["apt-get install brltty-ttb 2>/dev/null || which brltty-ttb", "Verify: brltty-ttb --version", "supercli plugins install ./plugins/brltty-ttb --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "brltty-ttb", "resource": "_", "action": "_",
    "description": "Passthrough to brltty-ttb CLI",
    "adapter": "process", "adapterConfig": { "command": "brltty-ttb", "passthrough": true, "missingDependencyHelp": "Install brltty-ttb: apt-get install brltty-ttb" }, "args": []
  }]
}
