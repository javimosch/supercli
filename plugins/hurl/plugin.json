{
  "name": "hurl",
  "version": "0.1.0",
  "description": "Run and test HTTP requests with simple text format",
  "source": "https://github.com/Orange-OpenSource/hurl",
  "checks": [{ "type": "binary", "name": "hurl" }],
  "install_guidance": {
    "plugin": "hurl",
    "binary": "hurl",
    "check": "which hurl",
    "install_steps": ["brew install hurl", "Verify: hurl --version", "supercli plugins install ./plugins/hurl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hurl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hurl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hurl",
      "passthrough": true,
      "missingDependencyHelp": "Install hurl: brew install hurl"
    },
    "args": []
  }]
}
