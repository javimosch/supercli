{
  "name": "wallpaper-ci",
  "version": "0.1.0",
  "description": "Minimalist tool for cycling desktop wallpapers from directories",
  "source": "https://github.com/aharris88/wallpaper-ci",
  "checks": [{ "type": "binary", "name": "wallpaper-ci" }],
  "install_guidance": {
    "plugin": "wallpaper-ci",
    "binary": "wallpaper-ci",
    "check": "which wallpaper-ci",
    "install_steps": ["git clone and install", "Verify: wallpaper-ci --version", "supercli plugins install ./plugins/wallpaper-ci --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wallpaper-ci",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wallpaper-ci CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wallpaper-ci",
      "passthrough": true,
      "missingDependencyHelp": "Install wallpaper-ci: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
