{
  "name": "at-bat",
  "version": "0.1.0",
  "description": "CLI tool: at-bat",
  "source": "https://packages.debian.org/at-bat",
  "checks": [{ "type": "binary", "name": "at-bat" }],
  "install_guidance": {
    "plugin": "at-bat", "binary": "at-bat", "check": "which at-bat",
    "install_steps": ["apt-get install at-bat 2>/dev/null || which at-bat", "Verify: at-bat --version", "supercli plugins install ./plugins/at-bat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-bat", "resource": "_", "action": "_",
    "description": "Passthrough to at-bat CLI",
    "adapter": "process", "adapterConfig": { "command": "at-bat", "passthrough": true, "missingDependencyHelp": "Install at-bat: apt-get install at-bat" }, "args": []
  }]
}
