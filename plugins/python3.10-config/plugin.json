{
  "name": "python3.10-config",
  "version": "0.1.0",
  "description": "CLI tool: python3.10-config",
  "source": "https://manpages.debian.org/python3.10-config",
  "checks": [
    {
      "type": "binary",
      "name": "python3.10-config"
    }
  ],
  "install_guidance": {
    "plugin": "python3.10-config",
    "binary": "python3.10-config",
    "check": "which python3.10-config",
    "install_steps": [
      "apt-get install python3.10-config 2>/dev/null || which python3.10-config",
      "Verify: python3.10-config --version",
      "supercli plugins install ./plugins/python3.10-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "python3.10-config",
      "resource": "self",
      "action": "version",
      "description": "Print python3.10-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "python3.10-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install python3.10-config: apt-get install python3.10-config 2>/dev/null || which python3.10-config"
      },
      "args": []
    },
    {
      "namespace": "python3.10-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to python3.10-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "python3.10-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install python3.10-config: apt-get install python3.10-config 2>/dev/null || which python3.10-config"
      },
      "args": []
    }
  ]
}