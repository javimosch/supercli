{
  "name": "kmer-db",
  "version": "0.1.0",
  "description": "Fast memory-efficient k-mer counting and querying for bioinformatics",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "kmer-db" }],
  "install_guidance": {
    "plugin": "kmer-db",
    "binary": "kmer-db",
    "check": "which kmer-db",
    "install_steps": ["cargo install kmer-db", "Verify: kmer-db --version", "supercli plugins install ./plugins/kmer-db --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kmer-db",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kmer-db CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kmer-db",
      "passthrough": true,
      "missingDependencyHelp": "Install kmer-db: cargo install kmer-db"
    },
    "args": []
  }]
}
