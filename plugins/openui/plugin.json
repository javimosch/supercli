{
  "name": "openui",
  "version": "0.1.0",
  "description": "OpenUI let's you describe UI using your imagination, then see it rendered live.",
  "source": "https://github.com/openui/openui",
  "checks": [
    {
      "type": "binary",
      "name": "openui"
    }
  ],
  "install_guidance": {
    "plugin": "openui",
    "binary": "openui",
    "check": "which openui",
    "install_steps": [
      "pip install openui",
      "Verify: openui --version",
      "supercli plugins install ./plugins/openui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openui",
      "resource": "self",
      "action": "version",
      "description": "Print openui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openui: pip install openui"
      },
      "args": []
    },
    {
      "namespace": "openui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openui",
        "passthrough": true,
        "missingDependencyHelp": "Install openui: pip install openui"
      },
      "args": []
    }
  ]
}