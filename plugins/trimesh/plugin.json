{
  "name": "trimesh",
  "version": "0.1.0",
  "description": "CLI tool: trimesh",
  "source": "https://manpages.debian.org/trimesh",
  "checks": [
    {
      "type": "binary",
      "name": "trimesh"
    }
  ],
  "install_guidance": {
    "plugin": "trimesh",
    "binary": "trimesh",
    "check": "which trimesh",
    "install_steps": [
      "apt-get install trimesh 2>/dev/null || which trimesh",
      "Verify: trimesh --version",
      "supercli plugins install ./plugins/trimesh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "trimesh",
      "resource": "self",
      "action": "version",
      "description": "Print trimesh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trimesh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install trimesh: apt-get install trimesh 2>/dev/null || which trimesh"
      },
      "args": []
    },
    {
      "namespace": "trimesh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trimesh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trimesh",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install trimesh: apt-get install trimesh 2>/dev/null || which trimesh"
      },
      "args": []
    }
  ]
}