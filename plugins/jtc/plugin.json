{
  "name": "jtc",
  "version": "0.1.0",
  "description": "JSON manipulation and transformation.",
  "source": "https://github.com/ldn-softdev/jtc",
  "checks": [
    {
      "type": "binary",
      "name": "jtc"
    }
  ],
  "install_guidance": {
    "plugin": "jtc",
    "binary": "jtc",
    "check": "which jtc",
    "install_steps": [
      "See https://github.com/ldn-softdev/jtc",
      "Verify: jtc --version",
      "supercli plugins install ./plugins/jtc --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "jtc",
      "resource": "self",
      "action": "version",
      "description": "Print jtc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jtc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jtc: See https://github.com/ldn-softdev/jtc"
      },
      "args": []
    },
    {
      "namespace": "jtc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jtc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jtc",
        "passthrough": true,
        "missingDependencyHelp": "Install jtc"
      },
      "args": []
    }
  ]
}