{
  "name": "gzip-size-cli",
  "version": "0.1.0",
  "description": "Get the gzipped size of a file",
  "source": "https://github.com/sindresorhus/gzip-size-cli",
  "checks": [
    {
      "type": "binary",
      "name": "gzip-size-cli"
    }
  ],
  "install_guidance": {
    "plugin": "gzip-size-cli",
    "binary": "gzip-size-cli",
    "check": "which gzip-size-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/gzip-size-cli",
      "Verify: gzip-size-cli --version",
      "supercli plugins install ./plugins/gzip-size-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gzip-size-cli",
      "resource": "self",
      "action": "version",
      "description": "Print gzip-size-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gzip-size-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gzip-size-cli: See https://github.com/sindresorhus/gzip-size-cli"
      },
      "args": []
    },
    {
      "namespace": "gzip-size-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gzip-size-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gzip-size-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install gzip-size-cli"
      },
      "args": []
    }
  ]
}