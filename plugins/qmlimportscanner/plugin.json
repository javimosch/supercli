{
  "name": "qmlimportscanner",
  "version": "0.1.0",
  "description": "CLI tool: qmlimportscanner",
  "source": "https://manpages.debian.org/qmlimportscanner",
  "checks": [
    {
      "type": "binary",
      "name": "qmlimportscanner"
    }
  ],
  "install_guidance": {
    "plugin": "qmlimportscanner",
    "binary": "qmlimportscanner",
    "check": "which qmlimportscanner",
    "install_steps": [
      "apt-get install qmlimportscanner 2>/dev/null || which qmlimportscanner",
      "Verify: qmlimportscanner --version",
      "supercli plugins install ./plugins/qmlimportscanner --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmlimportscanner",
      "resource": "self",
      "action": "version",
      "description": "Print qmlimportscanner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlimportscanner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmlimportscanner: apt-get install qmlimportscanner 2>/dev/null || which qmlimportscanner"
      },
      "args": []
    },
    {
      "namespace": "qmlimportscanner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmlimportscanner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlimportscanner",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmlimportscanner: apt-get install qmlimportscanner 2>/dev/null || which qmlimportscanner"
      },
      "args": []
    }
  ]
}