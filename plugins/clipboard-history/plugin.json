{
  "name": "clipboard-history",
  "version": "0.1.0",
  "description": "Track and recall clipboard history in the terminal",
  "source": "https://github.com/chrvadala/clipboard-history",
  "checks": [{ "type": "binary", "name": "clipboard-history" }],
  "install_guidance": {
    "plugin": "clipboard-history",
    "binary": "clipboard-history",
    "check": "which clipboard-history",
    "install_steps": ["npm install -g clipboard-history", "Verify: clipboard-history --version", "supercli plugins install ./plugins/clipboard-history --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clipboard-history",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clipboard-history CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clipboard-history",
      "passthrough": true,
      "missingDependencyHelp": "Install clipboard-history: npm install -g clipboard-history", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
