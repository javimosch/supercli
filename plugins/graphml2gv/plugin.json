{
  "name": "graphml2gv",
  "version": "0.1.0",
  "description": "CLI tool: graphml2gv",
  "source": "https://manpages.debian.org/graphml2gv",
  "checks": [
    {
      "type": "binary",
      "name": "graphml2gv"
    }
  ],
  "install_guidance": {
    "plugin": "graphml2gv",
    "binary": "graphml2gv",
    "check": "which graphml2gv",
    "install_steps": [
      "apt-get install graphml2gv 2>/dev/null || which graphml2gv",
      "Verify: graphml2gv --version",
      "supercli plugins install ./plugins/graphml2gv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "graphml2gv",
      "resource": "self",
      "action": "version",
      "description": "Print graphml2gv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphml2gv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install graphml2gv: apt-get install graphml2gv 2>/dev/null || which graphml2gv"
      },
      "args": []
    },
    {
      "namespace": "graphml2gv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to graphml2gv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphml2gv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install graphml2gv: apt-get install graphml2gv 2>/dev/null || which graphml2gv"
      },
      "args": []
    }
  ]
}