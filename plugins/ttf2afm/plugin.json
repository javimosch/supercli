{
  "name": "ttf2afm",
  "version": "0.1.0",
  "description": "CLI tool: ttf2afm",
  "source": "https://manpages.debian.org/ttf2afm",
  "checks": [
    {
      "type": "binary",
      "name": "ttf2afm"
    }
  ],
  "install_guidance": {
    "plugin": "ttf2afm",
    "binary": "ttf2afm",
    "check": "which ttf2afm",
    "install_steps": [
      "apt-get install ttf2afm 2>/dev/null || which ttf2afm",
      "Verify: ttf2afm --version",
      "supercli plugins install ./plugins/ttf2afm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ttf2afm",
      "resource": "self",
      "action": "version",
      "description": "Print ttf2afm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttf2afm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ttf2afm: apt-get install ttf2afm 2>/dev/null || which ttf2afm"
      },
      "args": []
    },
    {
      "namespace": "ttf2afm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ttf2afm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttf2afm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ttf2afm: apt-get install ttf2afm 2>/dev/null || which ttf2afm"
      },
      "args": []
    }
  ]
}