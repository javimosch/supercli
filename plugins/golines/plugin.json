{
  "name": "golines",
  "version": "0.1.0",
  "description": "Golang formatter that fixes long lines",
  "source": "https://github.com/segmentio/golines",
  "checks": [
    {
      "type": "binary",
      "name": "golines"
    }
  ],
  "install_guidance": {
    "plugin": "golines",
    "binary": "golines",
    "check": "which golines",
    "install_steps": [
      "brew install golines",
      "Verify: golines --version",
      "supercli plugins install ./plugins/golines --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "golines",
      "resource": "self",
      "action": "version",
      "description": "Print golines version",
      "adapter": "process",
      "adapterConfig": {
        "command": "golines",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install golines: brew install golines"
      },
      "args": []
    },
    {
      "namespace": "golines",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to golines CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "golines",
        "passthrough": true,
        "missingDependencyHelp": "Install golines"
      },
      "args": []
    }
  ]
}