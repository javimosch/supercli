{
  "name": "alloy",
  "version": "0.1.0",
  "description": "OpenTelemetry Collector distribution with Prometheus pipelines",
  "source": "https://github.com/grafana/alloy",
  "checks": [{ "type": "binary", "name": "alloy" }],
  "install_guidance": {
    "plugin": "alloy",
    "binary": "alloy",
    "check": "which alloy",
    "install_steps": ["brew install alloy", "Verify: alloy --version", "supercli plugins install ./plugins/alloy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "alloy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to alloy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "alloy",
      "passthrough": true,
      "missingDependencyHelp": "Install alloy: brew install alloy"
    },
    "args": []
  }]
}
