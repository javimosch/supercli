{
  "name": "puppet-dropbox",
  "version": "0.1.0",
  "description": "Headless CLI Dropbox Management with Puppet",
  "source": "https://github.com/puppet-dropbox/puppet-dropbox",
  "checks": [
    {
      "type": "binary",
      "name": "puppet-dropbox"
    }
  ],
  "install_guidance": {
    "plugin": "puppet-dropbox",
    "binary": "puppet-dropbox",
    "check": "which puppet-dropbox",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: puppet-dropbox --version",
      "supercli plugins install ./plugins/puppet-dropbox --on-conflict replace --json"
    ],
    "note": "Puppet language CLI tool"
  },
  "commands": [
    {
      "namespace": "puppet-dropbox",
      "resource": "self",
      "action": "version",
      "description": "Print puppet-dropbox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "puppet-dropbox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install puppet-dropbox from project repository"
      },
      "args": []
    },
    {
      "namespace": "puppet-dropbox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to puppet-dropbox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "puppet-dropbox",
        "passthrough": true,
        "missingDependencyHelp": "Install puppet-dropbox from project repository"
      },
      "args": []
    }
  ]
}