{
  "plugin": "mkdosfs",
  "binary": "mkdosfs",
  "check": "which mkdosfs",
  "install_steps": [
    "# Install mkdosfs",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/mkdosfs-linux-amd64 -o /usr/local/bin/mkdosfs",
    "chmod +x /usr/local/bin/mkdosfs",
    "# Or via package manager, see /usr/sbin/mkdosfs"
  ]
}