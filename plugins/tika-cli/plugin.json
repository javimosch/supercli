{
  "name": "tika-cli",
  "version": "0.1.0",
  "description": "Extract text and metadata from various file formats",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "tika-cli" }],
  "install_guidance": {
    "plugin": "tika-cli",
    "binary": "tika-cli",
    "check": "which tika-cli",
    "install_steps": ["java -jar tika-app.jar", "Verify: tika-cli --version", "supercli plugins install ./plugins/tika-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tika-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tika-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tika-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install tika-cli: java -jar tika-app.jar"
    },
    "args": []
  }]
}
