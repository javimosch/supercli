{
  "name": "KernelSU-Next",
  "version": "0.1.0",
  "description": "An advanced Kernel based root solution for Android",
  "source": "https://github.com/KernelSU-Next/KernelSU-Next",
  "checks": [
    {
      "type": "binary",
      "name": "kernelsu-next"
    }
  ],
  "install_guidance": {
    "plugin": "KernelSU-Next",
    "binary": "kernelsu-next",
    "check": "which kernelsu-next",
    "install_steps": [
      "pip install kernelsu-next",
      "Verify: kernelsu-next --version",
      "supercli plugins install ./plugins/KernelSU-Next --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "KernelSU-Next",
      "resource": "self",
      "action": "version",
      "description": "Print KernelSU-Next version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kernelsu-next",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install KernelSU-Next: pip install kernelsu-next"
      },
      "args": []
    },
    {
      "namespace": "KernelSU-Next",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kernelsu-next CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kernelsu-next",
        "passthrough": true,
        "missingDependencyHelp": "Install KernelSU-Next: pip install kernelsu-next"
      },
      "args": []
    }
  ]
}