{
  "name": "dev2",
  "version": "0.1.0",
  "description": "CLI tool: dev2",
  "source": "https://packages.debian.org/dev2",
  "checks": [{ "type": "binary", "name": "dev2" }],
  "install_guidance": {
    "plugin": "dev2", "binary": "dev2", "check": "which dev2",
    "install_steps": ["apt-get install dev2 2>/dev/null || which dev2", "Verify: dev2 --version", "supercli plugins install ./plugins/dev2 --on-conflict replace --json"]
