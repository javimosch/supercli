{
  "name": "replicatedhq",
  "version": "0.1.0",
  "description": "Kubernetes application management platform CLI",
  "source": "https://github.com/replicatedhq/replicated",
  "checks": [{ "type": "binary", "name": "replicated" }],
  "install_guidance": {
    "plugin": "replicatedhq",
    "binary": "replicated",
    "check": "which replicated",
    "install_steps": ["brew install replicated", "Verify: replicated --version", "supercli plugins install ./plugins/replicatedhq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "replicatedhq",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to replicated CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "replicated",
      "passthrough": true,
      "missingDependencyHelp": "Install replicatedhq: brew install replicated"
    },
    "args": []
  }]
}
