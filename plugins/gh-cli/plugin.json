{
  "name": "gh-cli",
  "version": "0.1.0",
  "description": "Official GitHub CLI for pull requests and issues",
  "source": "https://github.com/cli/cli",
  "checks": [{ "type": "binary", "name": "gh" }],
  "install_guidance": {
    "plugin": "gh-cli",
    "binary": "gh",
    "check": "which gh",
    "install_steps": ["brew install gh", "Verify: gh --version", "supercli plugins install ./plugins/gh-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gh-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gh",
      "passthrough": true,
      "missingDependencyHelp": "Install gh-cli: brew install gh", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
