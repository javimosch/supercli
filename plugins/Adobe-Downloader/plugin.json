{
  "name": "Adobe-Downloader",
  "version": "0.1.0",
  "description": "macOS Adobe apps download & installer",
  "source": "https://github.com/Adobe-Downloader/Adobe-Downloader",
  "checks": [
    {
      "type": "binary",
      "name": "adobe-downloader"
    }
  ],
  "install_guidance": {
    "plugin": "Adobe-Downloader",
    "binary": "adobe-downloader",
    "check": "which adobe-downloader",
    "install_steps": [
      "pip install adobe-downloader",
      "Verify: adobe-downloader --version",
      "supercli plugins install ./plugins/Adobe-Downloader --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Adobe-Downloader",
      "resource": "self",
      "action": "version",
      "description": "Print Adobe-Downloader version",
      "adapter": "process",
      "adapterConfig": {
        "command": "adobe-downloader",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Adobe-Downloader: pip install adobe-downloader"
      },
      "args": []
    },
    {
      "namespace": "Adobe-Downloader",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to adobe-downloader CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "adobe-downloader",
        "passthrough": true,
        "missingDependencyHelp": "Install Adobe-Downloader: pip install adobe-downloader"
      },
      "args": []
    }
  ]
}