{
  "name": "abseil",
  "version": "0.1.0",
  "description": "C++ Common Libraries",
  "checks": [
    {
      "type": "binary",
      "name": "abseil"
    }
  ],
  "install_guidance": {
    "plugin": "abseil",
    "binary": "abseil",
    "check": "which abseil",
    "install_steps": [
      "brew install abseil",
      "Verify: abseil --version",
      "supercli plugins install ./plugins/abseil --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "abseil",
      "resource": "self",
      "action": "version",
      "description": "Print abseil version",
      "adapter": "process",
      "adapterConfig": {
        "command": "abseil",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install abseil: brew install abseil"
      },
      "args": []
    },
    {
      "namespace": "abseil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to abseil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "abseil",
        "passthrough": true,
        "missingDependencyHelp": "Install abseil"
      },
      "args": []
    }
  ]
}