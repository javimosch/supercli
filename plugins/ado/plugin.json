  "commands": [{
    "namespace": "ado", "resource": "_", "action": "_",
    "description": "Passthrough to ado CLI",
    "adapter": "process", "adapterConfig": { "command": "ado", "passthrough": true, "missingDependencyHelp": "Install ado: apt-get install ado" }, "args": []
  }]
}
