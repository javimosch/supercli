{
  "name": "ado",
  "version": "0.1.0",
  "description": "CLI tool: ado",
  "source": "https://packages.debian.org/ado",
  "checks": [{ "type": "binary", "name": "ado" }],
  "install_guidance": {
    "plugin": "ado", "binary": "ado", "check": "which ado",
    "install_steps": ["apt-get install ado 2>/dev/null || which ado", "Verify: ado --version", "supercli plugins install ./plugins/ado --on-conflict replace --json"]
