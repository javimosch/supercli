{
  "name": "BettaFish",
  "version": "0.1.0",
  "description": "\u5fae\u8206\uff1a\u4eba\u4eba\u53ef\u7528\u7684\u591aAgent\u8206\u60c5\u5206\u6790\u52a9\u624b\uff0c\u6253\u7834\u4fe1\u606f\u8327\u623f\uff0c\u8fd8\u539f\u8206\u60c5\u539f\u8c8c\uff0c\u9884\u6d4b\u672a\u6765\u8d70\u5411\uff0c\u8f85\u52a9\u51b3\u7b56\uff01\u4ece0\u5b9e\u73b0\uff0c\u4e0d\u4f9d\u8d56\u4efb\u4f55\u6846\u67b6\u3002",
  "source": "https://github.com/BettaFish/BettaFish",
  "checks": [
    {
      "type": "binary",
      "name": "bettafish"
    }
  ],
  "install_guidance": {
    "plugin": "BettaFish",
    "binary": "bettafish",
    "check": "which bettafish",
    "install_steps": [
      "pip install bettafish",
      "Verify: bettafish --version",
      "supercli plugins install ./plugins/BettaFish --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BettaFish",
      "resource": "self",
      "action": "version",
      "description": "Print BettaFish version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bettafish",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BettaFish: pip install bettafish"
      },
      "args": []
    },
    {
      "namespace": "BettaFish",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bettafish CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bettafish",
        "passthrough": true,
        "missingDependencyHelp": "Install BettaFish: pip install bettafish"
      },
      "args": []
    }
  ]
}