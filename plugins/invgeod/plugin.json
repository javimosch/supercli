{
  "name": "invgeod",
  "version": "0.1.0",
  "description": "CLI tool: invgeod",
  "source": "https://manpages.debian.org/invgeod",
  "checks": [
    {
      "type": "binary",
      "name": "invgeod"
    }
  ],
  "install_guidance": {
    "plugin": "invgeod",
    "binary": "invgeod",
    "check": "which invgeod",
    "install_steps": [
      "apt-get install invgeod 2>/dev/null || which invgeod",
      "Verify: invgeod --version",
      "supercli plugins install ./plugins/invgeod --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "invgeod",
      "resource": "self",
      "action": "version",
      "description": "Print invgeod version",
      "adapter": "process",
      "adapterConfig": {
        "command": "invgeod",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install invgeod: apt-get install invgeod 2>/dev/null || which invgeod"
      },
      "args": []
    },
    {
      "namespace": "invgeod",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to invgeod CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "invgeod",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install invgeod: apt-get install invgeod 2>/dev/null || which invgeod"
      },
      "args": []
    }
  ]
}