{
  "name": "ppt-convert",
  "version": "0.1.0",
  "description": "Convert PowerPoint presentations between formats",
  "source": "https://github.com/johndoe/ppt-convert",
  "checks": [{ "type": "binary", "name": "ppt-convert" }],
  "install_guidance": {
    "plugin": "ppt-convert",
    "binary": "ppt-convert",
    "check": "which ppt-convert",
    "install_steps": ["pip install ppt-convert", "Verify: ppt-convert --version", "supercli plugins install ./plugins/ppt-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ppt-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ppt-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ppt-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install ppt-convert: pip install ppt-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
