{
  "name": "sloc",
  "version": "0.1.0",
  "description": "Count source lines of code with language detection",
  "source": "https://github.com/flosse/sloc",
  "checks": [{ "type": "binary", "name": "sloc" }],
  "install_guidance": {
    "plugin": "sloc",
    "binary": "sloc",
    "check": "which sloc",
    "install_steps": ["npm install -g sloc", "Verify: sloc --version", "supercli plugins install ./plugins/sloc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sloc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sloc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sloc",
      "passthrough": true,
      "missingDependencyHelp": "Install sloc: npm install -g sloc", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
