{
  "name": "dnf",
  "version": "0.1.0",
  "description": "Dandified YUM package manager",
  "source": "https://packages.debian.org/dnf",
  "checks": [{ "type": "binary", "name": "dnf" }],
  "install_guidance": {
    "plugin": "dnf", "binary": "dnf", "check": "which dnf",
    "install_steps": ["apt-get install dnf", "Verify: dnf --version", "supercli plugins install ./plugins/dnf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dnf", "resource": "_", "action": "_",
    "description": "Passthrough to dnf CLI",
    "adapter": "process", "adapterConfig": { "command": "dnf", "passthrough": true, "missingDependencyHelp": "Install dnf: apt-get install dnf" }, "args": []
  }]
}
