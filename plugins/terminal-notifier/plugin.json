{
  "name": "terminal-notifier",
  "version": "0.1.0",
  "description": "OS X terminal notifications",
  "source": "https://github.com/julienXX/terminal-notifier",
  "checks": [
    {
      "type": "binary",
      "name": "terminal-notifier"
    }
  ],
  "install_guidance": {
    "plugin": "terminal-notifier",
    "binary": "terminal-notifier",
    "check": "which terminal-notifier",
    "install_steps": [
      "brew install terminal-notifier",
      "Verify: terminal-notifier --version",
      "supercli plugins install ./plugins/terminal-notifier --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "terminal-notifier",
      "resource": "self",
      "action": "version",
      "description": "Print terminal-notifier version",
      "adapter": "process",
      "adapterConfig": {
        "command": "terminal-notifier",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install terminal-notifier: brew install terminal-notifier"
      },
      "args": []
    },
    {
      "namespace": "terminal-notifier",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to terminal-notifier CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "terminal-notifier",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install terminal-notifier: brew install terminal-notifier"
      },
      "args": []
    }
  ]
}
