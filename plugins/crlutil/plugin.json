{
  "name": "crlutil",
  "version": "0.1.0",
  "description": "crlutil — Network Security Service tools",
  "source": "http://www.mozilla.org/projects/security/pki/nss/tools/",
  "checks": [{ "type": "binary", "name": "crlutil" }],
  "install_guidance": {
    "plugin": "crlutil", "binary": "crlutil", "check": "which crlutil",
    "install_steps": ["apt-get install libnss3-tools 2>/dev/null || which crlutil", "Verify: crlutil --version", "supercli plugins install ./plugins/crlutil --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "crlutil", "resource": "_", "action": "_",
    "description": "Passthrough to crlutil CLI",
    "adapter": "process", "adapterConfig": { "command": "crlutil", "passthrough": true, "missingDependencyHelp": "Install crlutil: apt-get install libnss3-tools" }, "args": []
  }]
}
