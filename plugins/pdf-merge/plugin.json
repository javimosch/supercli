{
  "name": "pdf-merge",
  "version": "0.1.0",
  "description": "Merge multiple PDF files into a single document via CLI",
  "source": "https://github.com/jpmarinj/pdf-merge",
  "checks": [{ "type": "binary", "name": "pdf-merge" }],
  "install_guidance": {
    "plugin": "pdf-merge",
    "binary": "pdf-merge",
    "check": "which pdf-merge",
    "install_steps": ["pip install pdf-merge", "Verify: pdf-merge --version", "supercli plugins install ./plugins/pdf-merge --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdf-merge",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdf-merge CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdf-merge",
      "passthrough": true,
      "missingDependencyHelp": "Install pdf-merge: pip install pdf-merge", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
