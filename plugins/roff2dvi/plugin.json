{
  "name": "roff2dvi",
  "version": "0.1.0",
  "description": "CLI tool: roff2dvi",
  "source": "https://manpages.debian.org/roff2dvi",
  "checks": [
    {
      "type": "binary",
      "name": "roff2dvi"
    }
  ],
  "install_guidance": {
    "plugin": "roff2dvi",
    "binary": "roff2dvi",
    "check": "which roff2dvi",
    "install_steps": [
      "apt-get install roff2dvi 2>/dev/null || which roff2dvi",
      "Verify: roff2dvi --version",
      "supercli plugins install ./plugins/roff2dvi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "roff2dvi",
      "resource": "self",
      "action": "version",
      "description": "Print roff2dvi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "roff2dvi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install roff2dvi: apt-get install roff2dvi 2>/dev/null || which roff2dvi"
      },
      "args": []
    },
    {
      "namespace": "roff2dvi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to roff2dvi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "roff2dvi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install roff2dvi: apt-get install roff2dvi 2>/dev/null || which roff2dvi"
      },
      "args": []
    }
  ]
}