{
  "name": "tmpin",
  "version": "0.1.0",
  "description": "Add stdin support to any CLI app that accepts file input",
  "source": "https://github.com/tmpin/tmpin",
  "checks": [
    {
      "type": "binary",
      "name": "tmpin"
    }
  ],
  "install_guidance": {
    "plugin": "tmpin",
    "binary": "tmpin",
    "check": "which tmpin",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: tmpin --version",
      "supercli plugins install ./plugins/tmpin --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "tmpin",
      "resource": "self",
      "action": "version",
      "description": "Print tmpin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmpin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tmpin from project repository"
      },
      "args": []
    },
    {
      "namespace": "tmpin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tmpin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmpin",
        "passthrough": true,
        "missingDependencyHelp": "Install tmpin from project repository"
      },
      "args": []
    }
  ]
}