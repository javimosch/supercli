{
  "name": "dt2dv",
  "version": "0.1.0",
  "description": "CLI tool: dt2dv",
  "source": "https://manpages.debian.org/dt2dv",
  "checks": [
    {
      "type": "binary",
      "name": "dt2dv"
    }
  ],
  "install_guidance": {
    "plugin": "dt2dv",
    "binary": "dt2dv",
    "check": "which dt2dv",
    "install_steps": [
      "apt-get install dt2dv 2>/dev/null || which dt2dv",
      "Verify: dt2dv --version",
      "supercli plugins install ./plugins/dt2dv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dt2dv",
      "resource": "self",
      "action": "version",
      "description": "Print dt2dv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dt2dv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dt2dv: apt-get install dt2dv 2>/dev/null || which dt2dv"
      },
      "args": []
    },
    {
      "namespace": "dt2dv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dt2dv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dt2dv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dt2dv: apt-get install dt2dv 2>/dev/null || which dt2dv"
      },
      "args": []
    }
  ]
}