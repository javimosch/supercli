{
  "name": "yaml-to-json",
  "version": "0.1.0",
  "description": "Convert YAML files to JSON format via CLI",
  "source": "https://github.com/andris9/yaml-to-json",
  "checks": [{ "type": "binary", "name": "yaml-to-json" }],
  "install_guidance": {
    "plugin": "yaml-to-json",
    "binary": "yaml-to-json",
    "check": "which yaml-to-json",
    "install_steps": ["npm install -g yaml-to-json", "Verify: yaml-to-json --version", "supercli plugins install ./plugins/yaml-to-json --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yaml-to-json",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yaml-to-json CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yaml-to-json",
      "passthrough": true,
      "missingDependencyHelp": "Install yaml-to-json: npm install -g yaml-to-json", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
