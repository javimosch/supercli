{
  "name": "pgmtolispm",
  "version": "0.1.0",
  "description": "convert a PGM image to Lisp Machine format (netpbm)",
  "source": "https://manpages.debian.org/pgmtolispm",
  "checks": [
    {
      "type": "binary",
      "name": "pgmtolispm"
    }
  ],
  "install_guidance": {
    "plugin": "pgmtolispm",
    "binary": "pgmtolispm",
    "check": "which pgmtolispm",
    "install_steps": [
      "apt-get install pgmtolispm 2>/dev/null || which pgmtolispm",
      "Verify: pgmtolispm --version",
      "supercli plugins install ./plugins/pgmtolispm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgmtolispm",
      "resource": "self",
      "action": "version",
      "description": "Print pgmtolispm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmtolispm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgmtolispm: apt-get install pgmtolispm 2>/dev/null || which pgmtolispm"
      },
      "args": []
    },
    {
      "namespace": "pgmtolispm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgmtolispm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmtolispm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pgmtolispm: apt-get install pgmtolispm 2>/dev/null || which pgmtolispm"
      },
      "args": []
    }
  ]
}