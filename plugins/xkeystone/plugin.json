{
  "name": "xkeystone",
  "version": "0.1.0",
  "description": "CLI tool: xkeystone",
  "source": "https://manpages.debian.org/xkeystone",
  "checks": [
    {
      "type": "binary",
      "name": "xkeystone"
    }
  ],
  "install_guidance": {
    "plugin": "xkeystone",
    "binary": "xkeystone",
    "check": "which xkeystone",
    "install_steps": [
      "apt-get install xkeystone 2>/dev/null || which xkeystone",
      "Verify: xkeystone --version",
      "supercli plugins install ./plugins/xkeystone --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xkeystone",
      "resource": "self",
      "action": "version",
      "description": "Print xkeystone version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkeystone",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xkeystone: apt-get install xkeystone 2>/dev/null || which xkeystone"
      },
      "args": []
    },
    {
      "namespace": "xkeystone",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xkeystone CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkeystone",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xkeystone: apt-get install xkeystone 2>/dev/null || which xkeystone"
      },
      "args": []
    }
  ]
}