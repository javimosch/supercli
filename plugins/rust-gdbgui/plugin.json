{
  "name": "rust-gdbgui",
  "version": "0.1.0",
  "description": "CLI tool: rust-gdbgui",
  "source": "https://crates.io/crates/rust-gdbgui",
  "checks": [
    {
      "type": "binary",
      "name": "rust-gdbgui"
    }
  ],
  "install_guidance": {
    "plugin": "rust-gdbgui",
    "binary": "rust-gdbgui",
    "check": "which rust-gdbgui",
    "install_steps": [
      "cargo install rust-gdbgui",
      "Verify: rust-gdbgui --version",
      "supercli plugins install ./plugins/rust-gdbgui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rust-gdbgui",
      "resource": "self",
      "action": "version",
      "description": "Print rust-gdbgui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-gdbgui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rust-gdbgui: cargo install rust-gdbgui"
      },
      "args": []
    },
    {
      "namespace": "rust-gdbgui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rust-gdbgui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-gdbgui",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rust-gdbgui: cargo install rust-gdbgui"
      },
      "args": []
    }
  ]
}