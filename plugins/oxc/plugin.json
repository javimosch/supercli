{
  "name": "oxc",
  "version": "0.1.0",
  "description": "\u2693 A collection of high-performance JavaScript tools.",
  "source": "https://github.com/oxc/oxc",
  "checks": [
    {
      "type": "binary",
      "name": "oxc"
    }
  ],
  "install_guidance": {
    "plugin": "oxc",
    "binary": "oxc",
    "check": "which oxc",
    "install_steps": [
      "pip install oxc",
      "Verify: oxc --version",
      "supercli plugins install ./plugins/oxc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oxc",
      "resource": "self",
      "action": "version",
      "description": "Print oxc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oxc: pip install oxc"
      },
      "args": []
    },
    {
      "namespace": "oxc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oxc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxc",
        "passthrough": true,
        "missingDependencyHelp": "Install oxc: pip install oxc"
      },
      "args": []
    }
  ]
}