{
  "name": "EasyTier",
  "version": "0.1.0",
  "description": "A simple, decentralized mesh VPN with WireGuard support.",
  "source": "https://github.com/EasyTier/EasyTier",
  "checks": [
    {
      "type": "binary",
      "name": "easytier"
    }
  ],
  "install_guidance": {
    "plugin": "EasyTier",
    "binary": "easytier",
    "check": "which easytier",
    "install_steps": [
      "pip install easytier",
      "Verify: easytier --version",
      "supercli plugins install ./plugins/EasyTier --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "EasyTier",
      "resource": "self",
      "action": "version",
      "description": "Print EasyTier version",
      "adapter": "process",
      "adapterConfig": {
        "command": "easytier",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install EasyTier: pip install easytier"
      },
      "args": []
    },
    {
      "namespace": "EasyTier",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to easytier CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "easytier",
        "passthrough": true,
        "missingDependencyHelp": "Install EasyTier: pip install easytier"
      },
      "args": []
    }
  ]
}