{
  "name": "bittwist",
  "version": "0.1.0",
  "description": "CLI tool: bittwist",
  "source": "https://packages.debian.org/bittwist",
  "checks": [{ "type": "binary", "name": "bittwist" }],
  "install_guidance": {
    "plugin": "bittwist", "binary": "bittwist", "check": "which bittwist",
    "install_steps": ["apt-get install bittwist 2>/dev/null || which bittwist", "Verify: bittwist --version", "supercli plugins install ./plugins/bittwist --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bittwist", "resource": "_", "action": "_",
    "description": "Passthrough to bittwist CLI",
    "adapter": "process", "adapterConfig": { "command": "bittwist", "passthrough": true, "missingDependencyHelp": "Install bittwist: apt-get install bittwist" }, "args": []
  }]
}
