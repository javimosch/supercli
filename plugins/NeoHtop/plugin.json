{
  "name": "NeoHtop",
  "version": "0.1.0",
  "description": "CLI tool: NeoHtop",
  "source": "https://manpages.debian.org/NeoHtop",
  "checks": [
    {
      "type": "binary",
      "name": "NeoHtop"
    }
  ],
  "install_guidance": {
    "plugin": "NeoHtop",
    "binary": "NeoHtop",
    "check": "which NeoHtop",
    "install_steps": [
      "apt-get install NeoHtop 2>/dev/null || which NeoHtop",
      "Verify: NeoHtop --version",
      "supercli plugins install ./plugins/NeoHtop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NeoHtop",
      "resource": "self",
      "action": "version",
      "description": "Print NeoHtop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "NeoHtop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NeoHtop: apt-get install NeoHtop 2>/dev/null || which NeoHtop"
      },
      "args": []
    },
    {
      "namespace": "NeoHtop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to NeoHtop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "NeoHtop",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install NeoHtop: apt-get install NeoHtop 2>/dev/null || which NeoHtop"
      },
      "args": []
    }
  ]
}