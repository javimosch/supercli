{
  "name": "diffnav",
  "version": "0.1.0",
  "description": "diffnav - Git diff pager with file tree",
  "source": "github.com/wallyqs/diffnav",
  "checks": [
    {
      "type": "binary",
      "name": "diffnav"
    }
  ],
  "install_guidance": {
    "plugin": "diffnav",
    "binary": "diffnav",
    "check": "which diffnav",
    "install_steps": [
      "go install github.com/wallyqs/diffnav@latest"
    ]
  },
  "commands": [
    {
      "namespace": "diffnav",
      "resource": "diff",
      "action": "show",
      "description": "Show git diff with file tree navigation",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffnav",
        "passthrough": true,
        "invoke_cwd": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install diffnav from github.com/wallyqs/diffnav"
      },
      "args": []
    }
  ]
}