{
  "name": "markdown-pdf",
  "version": "0.1.0",
  "description": "Convert Markdown to PDF",
  "source": "https://github.com/alanshaw/markdown-pdf",
  "checks": [
    {
      "type": "binary",
      "name": "markdown-pdf"
    }
  ],
  "install_guidance": {
    "plugin": "markdown-pdf",
    "binary": "markdown-pdf",
    "check": "which markdown-pdf",
    "install_steps": [
      "npm install -g markdown-pdf",
      "Verify: markdown-pdf --version",
      "supercli plugins install ./plugins/markdown-pdf --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "markdown-pdf",
      "resource": "self",
      "action": "version",
      "description": "Print markdown-pdf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdown-pdf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install markdown-pdf: npm install -g markdown-pdf"
      },
      "args": []
    },
    {
      "namespace": "markdown-pdf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to markdown-pdf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdown-pdf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install markdown-pdf: npm install -g markdown-pdf"
      },
      "args": []
    }
  ]
}
