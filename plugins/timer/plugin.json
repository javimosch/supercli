{
  "name": "timer",
  "version": "0.1.0",
  "description": "Simple countdown terminal alarm in Rust",
  "source": "https://github.com/nicholasgasior/timer",
  "checks": [{"type": "binary", "name": "timer"}],
  "install_guidance": {
    "plugin": "timer",
    "binary": "timer",
    "check": "which timer",
    "install_steps": [
      "cargo install timer",
      "Verify: timer --version",
      "supercli plugins install ./timer --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "timer",
      "resource": "self",
      "action": "version",
      "description": "Print timer version",
      "adapter": "process",
      "adapterConfig": {"command": "timer", "baseArgs": ["--version"], "missingDependencyHelp": "Install timer: cargo install timer"},
      "args": []
    },
    {
      "namespace": "timer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to timer CLI",
      "adapter": "process",
      "adapterConfig": {"command": "timer", "passthrough": true, "missingDependencyHelp": "Install timer: cargo install timer"},
      "args": []
    }
  ]
}
