{
  "name": "cmux",
  "version": "0.1.0",
  "description": "Ghostty-based macOS terminal with vertical tabs and notifications for AI coding agents",
  "source": "https://github.com/cmux/cmux",
  "checks": [
    {
      "type": "binary",
      "name": "cmux"
    }
  ],
  "install_guidance": {
    "plugin": "cmux",
    "binary": "cmux",
    "check": "which cmux",
    "install_steps": [
      "pip install cmux",
      "Verify: cmux --version",
      "supercli plugins install ./plugins/cmux --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cmux",
      "resource": "self",
      "action": "version",
      "description": "Print cmux version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmux",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmux: pip install cmux"
      },
      "args": []
    },
    {
      "namespace": "cmux",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmux CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmux",
        "passthrough": true,
        "missingDependencyHelp": "Install cmux: pip install cmux"
      },
      "args": []
    }
  ]
}