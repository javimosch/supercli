{
  "name": "vgimportclone",
  "version": "0.1.0",
  "description": "CLI tool: vgimportclone",
  "source": "https://manpages.debian.org/vgimportclone",
  "checks": [
    {
      "type": "binary",
      "name": "vgimportclone"
    }
  ],
  "install_guidance": {
    "plugin": "vgimportclone",
    "binary": "vgimportclone",
    "check": "which vgimportclone",
    "install_steps": [
      "apt-get install vgimportclone 2>/dev/null || which vgimportclone",
      "Verify: vgimportclone --version",
      "supercli plugins install ./plugins/vgimportclone --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vgimportclone",
      "resource": "self",
      "action": "version",
      "description": "Print vgimportclone version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgimportclone",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vgimportclone: apt-get install vgimportclone 2>/dev/null || which vgimportclone"
      },
      "args": []
    },
    {
      "namespace": "vgimportclone",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vgimportclone CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgimportclone",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vgimportclone: apt-get install vgimportclone 2>/dev/null || which vgimportclone"
      },
      "args": []
    }
  ]
}