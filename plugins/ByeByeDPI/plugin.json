{
  "name": "ByeByeDPI",
  "version": "0.1.0",
  "description": "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 ByeDPI \u0438 \u043f\u0435\u0440\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0432\u0435\u0441\u044c \u0442\u0440\u0430\u0444\u0438\u043a \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0433\u043e",
  "source": "https://github.com/ByeByeDPI/ByeByeDPI",
  "checks": [
    {
      "type": "binary",
      "name": "byebyedpi"
    }
  ],
  "install_guidance": {
    "plugin": "ByeByeDPI",
    "binary": "byebyedpi",
    "check": "which byebyedpi",
    "install_steps": [
      "pip install byebyedpi",
      "Verify: byebyedpi --version",
      "supercli plugins install ./plugins/ByeByeDPI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ByeByeDPI",
      "resource": "self",
      "action": "version",
      "description": "Print ByeByeDPI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "byebyedpi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ByeByeDPI: pip install byebyedpi"
      },
      "args": []
    },
    {
      "namespace": "ByeByeDPI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to byebyedpi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "byebyedpi",
        "passthrough": true,
        "missingDependencyHelp": "Install ByeByeDPI: pip install byebyedpi"
      },
      "args": []
    }
  ]
}