{
  "name": "dh_installudev",
  "version": "0.1.0",
  "description": "CLI tool: dh_installudev",
  "source": "https://packages.debian.org/dh_installudev",
  "checks": [{ "type": "binary", "name": "dh_installudev" }],
  "install_guidance": {
    "plugin": "dh_installudev", "binary": "dh_installudev", "check": "which dh_installudev",
    "install_steps": ["apt-get install dh_installudev 2>/dev/null || which dh_installudev", "Verify: dh_installudev --version", "supercli plugins install ./plugins/dh_installudev --on-conflict replace --json"]
