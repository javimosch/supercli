  "commands": [{
    "namespace": "dh_installudev", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installudev CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installudev", "passthrough": true, "missingDependencyHelp": "Install dh_installudev: apt-get install dh_installudev" }, "args": []
  }]
}
