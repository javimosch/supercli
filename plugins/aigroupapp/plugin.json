{
  "name": "aigroupapp",
  "version": "0.1.0",
  "description": "AI Group is a powerful mobile intelligent assistant application that integrates multiple large langu",
  "source": "https://github.com/aigroupapp/aigroupapp",
  "checks": [
    {
      "type": "binary",
      "name": "aigroupapp"
    }
  ],
  "install_guidance": {
    "plugin": "aigroupapp",
    "binary": "aigroupapp",
    "check": "which aigroupapp",
    "install_steps": [
      "pip install aigroupapp",
      "Verify: aigroupapp --version",
      "supercli plugins install ./plugins/aigroupapp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aigroupapp",
      "resource": "self",
      "action": "version",
      "description": "Print aigroupapp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aigroupapp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aigroupapp: pip install aigroupapp"
      },
      "args": []
    },
    {
      "namespace": "aigroupapp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aigroupapp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aigroupapp",
        "passthrough": true,
        "missingDependencyHelp": "Install aigroupapp: pip install aigroupapp"
      },
      "args": []
    }
  ]
}