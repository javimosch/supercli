{
  "name": "at-completion",
  "version": "0.1.0",
  "description": "CLI tool: at-completion",
  "source": "https://packages.debian.org/at-completion",
  "checks": [{ "type": "binary", "name": "at-completion" }],
  "install_guidance": {
    "plugin": "at-completion", "binary": "at-completion", "check": "which at-completion",
    "install_steps": ["apt-get install at-completion 2>/dev/null || which at-completion", "Verify: at-completion --version", "supercli plugins install ./plugins/at-completion --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-completion", "resource": "_", "action": "_",
    "description": "Passthrough to at-completion CLI",
    "adapter": "process", "adapterConfig": { "command": "at-completion", "passthrough": true, "missingDependencyHelp": "Install at-completion: apt-get install at-completion" }, "args": []
  }]
}
