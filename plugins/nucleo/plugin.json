{
  "name": "nucleo",
  "version": "0.1.0",
  "description": "High-performance Rust fuzzy matching library with CLI interface",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "nucleo" }],
  "install_guidance": {
    "plugin": "nucleo",
    "binary": "nucleo",
    "check": "which nucleo",
    "install_steps": ["cargo install nucleo", "Verify: nucleo --version", "supercli plugins install ./plugins/nucleo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nucleo",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nucleo CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nucleo",
      "passthrough": true,
      "missingDependencyHelp": "Install nucleo: cargo install nucleo"
    },
    "args": []
  }]
}
