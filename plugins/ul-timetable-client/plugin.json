{
  "name": "ul-timetable-client",
  "version": "0.1.0",
  "description": "Angular client for the University of Limerick's timetable ",
  "source": "https://timetable.videtur.io",
  "checks": [
    {
      "type": "binary",
      "name": "ul-timetable-client"
    }
  ],
  "install_guidance": {
    "plugin": "ul-timetable-client",
    "binary": "ul-timetable-client",
    "check": "which ul-timetable-client",
    "install_steps": [
      "Check https://timetable.videtur.io for installation instructions",
      "Verify: ul-timetable-client --version",
      "supercli plugins install ./plugins/ul-timetable-client --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "ul-timetable-client",
      "resource": "self",
      "action": "version",
      "description": "Print ul-timetable-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ul-timetable-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ul-timetable-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "ul-timetable-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ul-timetable-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ul-timetable-client",
        "passthrough": true,
        "missingDependencyHelp": "Install ul-timetable-client from project repository"
      },
      "args": []
    }
  ]
}