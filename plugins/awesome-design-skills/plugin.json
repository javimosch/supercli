{
  "name": "awesome-design-skills",
  "version": "0.1.0",
  "description": "67 DESIGN.md and SKILL.md design skill files for AI design tools — Claude Design, Google Stitch, Codex, Cursor",
  "source": "https://github.com/bergside/awesome-design-skills",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "awesome-design-skills",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/bergside/awesome-design-skills.git",
      "supercli plugins install ./plugins/awesome-design-skills --on-conflict replace --json",
      "sc skills teach awesome-design-skills:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "awesome-design-skills", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["awesome-design-skills v0.1.0 — Use sc skills teach awesome-design-skills:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/bergside/awesome-design-skills.git" }, "args": [] },
    { "namespace": "awesome-design-skills", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/bergside/awesome-design-skills.git then: sc skills teach awesome-design-skills:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/bergside/awesome-design-skills.git" }, "args": [] }
  ]
}
