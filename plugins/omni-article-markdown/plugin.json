{
  "name": "omni-article-markdown",
  "version": "0.1.0",
  "description": "Turn any web article into clean Markdown via CLI tool",
  "source": "https://github.com/caol64/omni-article-markdown",
  "checks": [
    {
      "type": "binary",
      "name": "mdcli"
    }
  ],
  "install_guidance": {
    "plugin": "omni-article-markdown",
    "check": "which mdcli",
    "install_steps": [
      "pip install omni-article-markdown",
      "Verify: mdcli --version",
      "supercli plugins install ./plugins/omni-article-markdown --on-conflict replace --json"
    ],
    "binary": "mdcli"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "omni-article-markdown",
      "resource": "article",
      "action": "parse",
      "description": "Parse a web article or local file into clean Markdown",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdcli",
        "baseArgs": [
          "parse"
        ],
        "positionalArgs": [
          "url"
        ],
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install omni-article-markdown: pip install omni-article-markdown"
      },
      "args": [
        {
          "name": "url",
          "type": "string",
          "required": true,
          "description": "Article URL or local file path",
          "positional": true
        },
        {
          "name": "--save",
          "type": "string",
          "required": false,
          "description": "Save result to directory (use -s for ./)"
        },
        {
          "name": "--no-verify-ssl",
          "type": "boolean",
          "required": false,
          "description": "Disable SSL certificate verification"
        }
      ]
    },
    {
      "namespace": "omni-article-markdown",
      "resource": "article",
      "action": "read",
      "description": "Read and format raw article HTML",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdcli",
        "baseArgs": [
          "read"
        ],
        "positionalArgs": [
          "url"
        ],
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install omni-article-markdown: pip install omni-article-markdown"
      },
      "args": [
        {
          "name": "url",
          "type": "string",
          "required": true,
          "description": "Article URL or local file path",
          "positional": true
        },
        {
          "name": "--prettify",
          "type": "boolean",
          "required": false,
          "description": "Prettify the HTML output"
        }
      ]
    },
    {
      "namespace": "omni-article-markdown",
      "resource": "self",
      "action": "version",
      "description": "Print mdcli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdcli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install omni-article-markdown: pip install omni-article-markdown"
      },
      "args": []
    },
    {
      "namespace": "omni-article-markdown",
      "resource": "help",
      "action": "show",
      "description": "Show mdcli help",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdcli",
        "baseArgs": [
          "--help"
        ],
        "missingDependencyHelp": "Install omni-article-markdown: pip install omni-article-markdown"
      },
      "args": []
    },
    {
      "namespace": "omni-article-markdown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mdcli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdcli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install omni-article-markdown: pip install omni-article-markdown"
      },
      "args": []
    }
  ]
}
