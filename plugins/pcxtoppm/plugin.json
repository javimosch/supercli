{
  "name": "pcxtoppm",
  "version": "0.1.0",
  "description": "CLI tool: pcxtoppm",
  "source": "https://manpages.debian.org/pcxtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "pcxtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "pcxtoppm",
    "binary": "pcxtoppm",
    "check": "which pcxtoppm",
    "install_steps": [
      "apt-get install pcxtoppm 2>/dev/null || which pcxtoppm",
      "Verify: pcxtoppm --version",
      "supercli plugins install ./plugins/pcxtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pcxtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print pcxtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pcxtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pcxtoppm: apt-get install pcxtoppm 2>/dev/null || which pcxtoppm"
      },
      "args": []
    },
    {
      "namespace": "pcxtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pcxtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pcxtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pcxtoppm: apt-get install pcxtoppm 2>/dev/null || which pcxtoppm"
      },
      "args": []
    }
  ]
}