{
  "name": "dhcprelay",
  "version": "0.1.0",
  "description": "CLI tool: dhcprelay",
  "source": "https://packages.debian.org/dhcprelay",
  "checks": [{ "type": "binary", "name": "dhcprelay" }],
  "install_guidance": {
    "plugin": "dhcprelay", "binary": "dhcprelay", "check": "which dhcprelay",
    "install_steps": ["apt-get install dhcprelay 2>/dev/null || which dhcprelay", "Verify: dhcprelay --version", "supercli plugins install ./plugins/dhcprelay --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhcprelay", "resource": "_", "action": "_",
    "description": "Passthrough to dhcprelay CLI",
    "adapter": "process", "adapterConfig": { "command": "dhcprelay", "passthrough": true, "missingDependencyHelp": "Install dhcprelay: apt-get install dhcprelay" }, "args": []
  }]
}
