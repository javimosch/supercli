{
  "name": "dynamo",
  "version": "0.1.0",
  "description": "A Datacenter Scale Distributed Inference Serving Framework",
  "source": "https://github.com/dynamo/dynamo",
  "checks": [
    {
      "type": "binary",
      "name": "dynamo"
    }
  ],
  "install_guidance": {
    "plugin": "dynamo",
    "binary": "dynamo",
    "check": "which dynamo",
    "install_steps": [
      "pip install dynamo",
      "Verify: dynamo --version",
      "supercli plugins install ./plugins/dynamo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dynamo",
      "resource": "self",
      "action": "version",
      "description": "Print dynamo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dynamo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dynamo: pip install dynamo"
      },
      "args": []
    },
    {
      "namespace": "dynamo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dynamo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dynamo",
        "passthrough": true,
        "missingDependencyHelp": "Install dynamo: pip install dynamo"
      },
      "args": []
    }
  ]
}