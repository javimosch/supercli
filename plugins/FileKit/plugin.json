{
  "name": "FileKit",
  "version": "0.1.0",
  "description": "Pick and save Files, Medias and Folder for Kotlin Multiplatform / KMP and Compose Multiplatform / CM",
  "source": "https://github.com/FileKit/FileKit",
  "checks": [
    {
      "type": "binary",
      "name": "filekit"
    }
  ],
  "install_guidance": {
    "plugin": "FileKit",
    "binary": "filekit",
    "check": "which filekit",
    "install_steps": [
      "pip install filekit",
      "Verify: filekit --version",
      "supercli plugins install ./plugins/FileKit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FileKit",
      "resource": "self",
      "action": "version",
      "description": "Print FileKit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "filekit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FileKit: pip install filekit"
      },
      "args": []
    },
    {
      "namespace": "FileKit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to filekit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "filekit",
        "passthrough": true,
        "missingDependencyHelp": "Install FileKit: pip install filekit"
      },
      "args": []
    }
  ]
}