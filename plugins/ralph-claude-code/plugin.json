{
  "name": "ralph-claude-code",
  "version": "0.1.0",
  "description": "Autonomous AI development loop for Claude Code with intelligent exit detection",
  "source": "https://github.com/ralph-claude-code/ralph-claude-code",
  "checks": [
    {
      "type": "binary",
      "name": "ralph-claude-code"
    }
  ],
  "install_guidance": {
    "plugin": "ralph-claude-code",
    "binary": "ralph-claude-code",
    "check": "which ralph-claude-code",
    "install_steps": [
      "pip install ralph-claude-code",
      "Verify: ralph-claude-code --version",
      "supercli plugins install ./plugins/ralph-claude-code --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ralph-claude-code",
      "resource": "self",
      "action": "version",
      "description": "Print ralph-claude-code version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ralph-claude-code",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ralph-claude-code: pip install ralph-claude-code"
      },
      "args": []
    },
    {
      "namespace": "ralph-claude-code",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ralph-claude-code CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ralph-claude-code",
        "passthrough": true,
        "missingDependencyHelp": "Install ralph-claude-code: pip install ralph-claude-code"
      },
      "args": []
    }
  ]
}