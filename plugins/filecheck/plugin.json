{
  "name": "filecheck",
  "version": "0.1.0",
  "description": "File integrity checker CLI — verify checksums and detect changes with JSON report",
  "source": "https://github.com/filecheck/filecheck",
  "checks": [
    {
      "type": "binary",
      "name": "filecheck"
    }
  ],
  "install_guidance": {
    "plugin": "filecheck",
    "binary": "filecheck",
    "check": "which filecheck",
    "install_steps": [
      "cargo install filecheck",
      "Verify: filecheck --version",
      "supercli plugins install ./plugins/filecheck --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "filecheck",
      "resource": "self",
      "action": "version",
      "description": "Print filecheck version",
      "adapter": "process",
      "adapterConfig": {
        "command": "filecheck",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install: cargo install filecheck"
      },
      "args": []
    },
    {
      "namespace": "filecheck",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to filecheck",
      "adapter": "process",
      "adapterConfig": {
        "command": "filecheck",
        "passthrough": true,
        "missingDependencyHelp": "Install: cargo install filecheck"
      },
      "args": []
    }
  ]
}
