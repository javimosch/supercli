{
  "name": "dblatex",
  "version": "0.1.0",
  "description": "DocBook to LaTeX/PDF converter",
  "source": "https://github.com/berteh/dblatex",
  "checks": [
    {
      "type": "binary",
      "name": "dblatex"
    }
  ],
  "install_guidance": {
    "plugin": "dblatex",
    "binary": "dblatex",
    "check": "which dblatex",
    "install_steps": [
      "brew install dblatex",
      "Verify: dblatex --version",
      "supercli plugins install ./plugins/dblatex --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "dblatex",
      "resource": "self",
      "action": "version",
      "description": "Print dblatex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dblatex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dblatex: brew install dblatex"
      },
      "args": []
    },
    {
      "namespace": "dblatex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dblatex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dblatex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dblatex: brew install dblatex"
      },
      "args": []
    }
  ]
}
