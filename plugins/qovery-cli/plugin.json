{
  "name": "qovery-cli",
  "version": "0.1.0",
  "description": "Alternative cloud app infrastructure management CLI",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "qovery-cli" }],
  "install_guidance": {
    "plugin": "qovery-cli",
    "binary": "qovery-cli",
    "check": "which qovery-cli",
    "install_steps": ["brew install Qovery/homebrew-tap/qovery-cli", "Verify: qovery-cli --version", "supercli plugins install ./plugins/qovery-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "qovery-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to qovery-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "qovery-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install qovery-cli: brew install Qovery/homebrew-tap/qovery-cli"
    },
    "args": []
  }]
}
