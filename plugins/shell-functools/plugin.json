{
  "name": "shell-functools",
  "version": "0.1.0",
  "description": "Functional programming tools for shell pipelines",
  "source": "https://github.com/sharkdp/shell-functools",
  "checks": [{ "type": "binary", "name": "shell-functools" }],
  "install_guidance": {
    "plugin": "shell-functools",
    "binary": "shell-functools",
    "check": "which shell-functools",
    "install_steps": ["pip install shell-functools", "Verify: shell-functools --version", "supercli plugins install ./plugins/shell-functools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "shell-functools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to shell-functools CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "shell-functools",
      "passthrough": true,
      "missingDependencyHelp": "Install shell-functools: pip install shell-functools", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
