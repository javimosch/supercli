{
  "name": "korkut",
  "version": "0.1.0",
  "description": "Quick and simple image processing",
  "source": "https://github.com/oguzhaninan/korkut",
  "checks": [
    {
      "type": "binary",
      "name": "korkut"
    }
  ],
  "install_guidance": {
    "plugin": "korkut",
    "binary": "korkut",
    "check": "which korkut",
    "install_steps": [
      "See https://github.com/oguzhaninan/korkut",
      "Verify: korkut --version",
      "supercli plugins install ./plugins/korkut --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "korkut",
      "resource": "self",
      "action": "version",
      "description": "Print korkut version",
      "adapter": "process",
      "adapterConfig": {
        "command": "korkut",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install korkut: See https://github.com/oguzhaninan/korkut"
      },
      "args": []
    },
    {
      "namespace": "korkut",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to korkut CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "korkut",
        "passthrough": true,
        "missingDependencyHelp": "Install korkut"
      },
      "args": []
    }
  ]
}