{
  "name": "oxvg",
  "version": "0.1.0",
  "description": "SVG Optimizer",
  "source": "https://github.com/noahbald/oxvg",
  "checks": [
    { "type": "binary", "name": "oxvg" }
  ],
  "install_guidance": {
    "plugin": "oxvg",
    "binary": "oxvg",
    "check": "which oxvg",
    "install_steps": [
      "cargo install oxvg",
      "Verify: oxvg --version",
      "supercli plugins install ./plugins/oxvg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oxvg",
      "resource": "self",
      "action": "version",
      "description": "Print oxvg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxvg",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install oxvg: cargo install oxvg"
      },
      "args": []
    },
    {
      "namespace": "oxvg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oxvg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxvg",
        "passthrough": true,
        "missingDependencyHelp": "Install oxvg"
      },
      "args": []
    }
  ]
}
