{
  "plugin": "prlimit",
  "binary": "prlimit",
  "check": "which prlimit",
  "install_steps": [
    "# Install prlimit",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/prlimit-linux-amd64 -o /usr/local/bin/prlimit",
    "chmod +x /usr/local/bin/prlimit",
    "# Or via package manager, see /usr/bin/prlimit"
  ]
}