{
  "name": "prlimit",
  "version": "1.0.0",
  "description": "prlimit \u2014 prlimit \u2014 CLI utility",
  "source": "/usr/bin/prlimit",
  "checks": [
    {
      "type": "binary",
      "name": "prlimit"
    }
  ],
  "install_guidance": {
    "plugin": "prlimit",
    "binary": "prlimit",
    "check": "which prlimit",
    "install_steps": [
      "# Install prlimit:",
      "# apt: sudo apt-get install prlimit",
      "# brew: brew install prlimit",
      "# cargo: cargo install prlimit",
      "# npm: npm install -g prlimit",
      "# pip: pip install prlimit",
      "# or download from /usr/bin/prlimit"
    ]
  },
  "commands": [
    {
      "namespace": "prlimit",
      "resource": "prlimit",
      "action": "run",
      "description": "Run prlimit",
      "adapter": "process",
      "adapterConfig": {
        "command": "prlimit",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install prlimit from /usr/bin/prlimit"
      },
      "args": []
    }
  ]
}