{
  "name": "ye",
  "version": "0.1.0",
  "description": "yaml <-> edn (<-> json) converter CLI tool.",
  "source": "https://github.com/ye/ye",
  "checks": [
    {
      "type": "binary",
      "name": "ye"
    }
  ],
  "install_guidance": {
    "plugin": "ye",
    "binary": "ye",
    "check": "which ye",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: ye --version",
      "supercli plugins install ./plugins/ye --on-conflict replace --json"
    ],
    "note": "Clojure language CLI tool"
  },
  "commands": [
    {
      "namespace": "ye",
      "resource": "self",
      "action": "version",
      "description": "Print ye version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ye",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ye from project repository"
      },
      "args": []
    },
    {
      "namespace": "ye",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ye CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ye",
        "passthrough": true,
        "missingDependencyHelp": "Install ye from project repository"
      },
      "args": []
    }
  ]
}