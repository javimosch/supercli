{
  "plugin": "mke2fs",
  "binary": "mke2fs",
  "check": "which mke2fs",
  "install_steps": [
    "# Install mke2fs",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/mke2fs-linux-amd64 -o /usr/local/bin/mke2fs",
    "chmod +x /usr/local/bin/mke2fs",
    "# Or via package manager, see /usr/sbin/mke2fs"
  ]
}