{
  "name": "cpp-11",
  "version": "0.1.0",
  "description": "CLI tool: cpp-11",
  "source": "https://packages.debian.org/cpp-11",
  "checks": [{ "type": "binary", "name": "cpp-11" }],
  "install_guidance": {
    "plugin": "cpp-11", "binary": "cpp-11", "check": "which cpp-11",
    "install_steps": ["apt-get install cpp-11 2>/dev/null || which cpp-11", "Verify: cpp-11 --version", "supercli plugins install ./plugins/cpp-11 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpp-11", "resource": "_", "action": "_",
    "description": "Passthrough to cpp-11 CLI",
    "adapter": "process", "adapterConfig": { "command": "cpp-11", "passthrough": true, "missingDependencyHelp": "Install cpp-11: apt-get install cpp-11" }, "args": []
  }]
}
