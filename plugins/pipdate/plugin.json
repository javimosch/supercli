{
  "name": "pipdate",
  "version": "0.1.0",
  "description": "Check pip package update status from CLI",
  "source": "https://github.com/nicoddemus/pipdate",
  "checks": [{ "type": "binary", "name": "pipdate" }],
  "install_guidance": {
    "plugin": "pipdate",
    "binary": "pipdate",
    "check": "which pipdate",
    "install_steps": ["pip install pipdate", "Verify: pipdate --version", "supercli plugins install ./plugins/pipdate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipdate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipdate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipdate",
      "passthrough": true,
      "missingDependencyHelp": "Install pipdate: pip install pipdate", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
