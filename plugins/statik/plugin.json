{
  "name": "statik",
  "version": "0.1.0",
  "description": "Embed static files into Go executables",
  "source": "https://github.com/rakyll/statik",
  "checks": [{ "type": "binary", "name": "statik" }],
  "install_guidance": {
    "plugin": "statik",
    "binary": "statik",
    "check": "which statik",
    "install_steps": ["go install github.com/rakyll/statik@latest", "Verify: statik --version", "supercli plugins install ./plugins/statik --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "statik",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to statik CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "statik",
      "passthrough": true,
      "missingDependencyHelp": "Install statik: go install github.com/rakyll/statik@latest"
    },
    "args": []
  }]
}
