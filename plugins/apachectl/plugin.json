{
  "name": "apachectl",
  "version": "0.1.0",
  "description": "CLI tool: apachectl",
  "source": "https://packages.debian.org/apachectl",
  "checks": [{ "type": "binary", "name": "apachectl" }],
  "install_guidance": {
    "plugin": "apachectl", "binary": "apachectl", "check": "which apachectl",
    "install_steps": ["apt-get install apachectl 2>/dev/null || which apachectl", "Verify: apachectl --version", "supercli plugins install ./plugins/apachectl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apachectl", "resource": "_", "action": "_",
    "description": "Passthrough to apachectl CLI",
    "adapter": "process", "adapterConfig": { "command": "apachectl", "passthrough": true, "missingDependencyHelp": "Install apachectl: apt-get install apachectl" }, "args": []
  }]
}
