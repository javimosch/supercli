{
  "name": "excalibur-export",
  "version": "0.1.0",
  "description": "Export Excalidraw diagrams to PNG SVG and PDF",
  "source": "https://github.com/excalidraw/excalidraw-cli",
  "checks": [{ "type": "binary", "name": "excalibur-export" }],
  "install_guidance": {
    "plugin": "excalibur-export",
    "binary": "excalibur-export",
    "check": "which excalibur-export",
    "install_steps": ["npm install -g excalibur-export", "Verify: excalibur-export --version", "supercli plugins install ./plugins/excalibur-export --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "excalibur-export",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to excalibur-export CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "excalibur-export",
      "passthrough": true,
      "missingDependencyHelp": "Install excalibur-export: npm install -g excalibur-export", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
