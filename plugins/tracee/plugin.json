{
  "name": "tracee",
  "version": "0.1.0",
  "description": "Linux runtime security and forensics using eBPF",
  "source": "https://github.com/aquasecurity/tracee",
  "checks": [{ "type": "binary", "name": "tracee" }],
  "install_guidance": {
    "plugin": "tracee",
    "binary": "tracee",
    "check": "which tracee",
    "install_steps": ["brew install tracee", "Verify: tracee --version", "supercli plugins install ./plugins/tracee --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tracee",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tracee CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tracee",
      "passthrough": true,
      "missingDependencyHelp": "Install tracee: brew install tracee"
    },
    "args": []
  }]
}
