{
  "name": "bamtools",
  "version": "0.1.0",
  "description": "C++ API and command-line toolkit for BAM data",
  "source": "https://github.com/pezmaster31/bamtools",
  "checks": [
    {
      "type": "binary",
      "name": "bamtools"
    }
  ],
  "install_guidance": {
    "plugin": "bamtools",
    "binary": "bamtools",
    "check": "which bamtools",
    "install_steps": [
      "brew install bamtools",
      "Verify: bamtools --version",
      "supercli plugins install ./plugins/bamtools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bamtools",
      "resource": "self",
      "action": "version",
      "description": "Print bamtools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bamtools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bamtools: brew install bamtools"
      },
      "args": []
    },
    {
      "namespace": "bamtools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bamtools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bamtools",
        "passthrough": true,
        "missingDependencyHelp": "Install bamtools"
      },
      "args": []
    }
  ]
}