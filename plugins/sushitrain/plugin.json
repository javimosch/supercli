{
  "name": "sushitrain",
  "version": "0.1.0",
  "description": "Securely synchronize files with your devices on iOS using Syncthing",
  "source": "https://github.com/sushitrain/sushitrain",
  "checks": [
    {
      "type": "binary",
      "name": "sushitrain"
    }
  ],
  "install_guidance": {
    "plugin": "sushitrain",
    "binary": "sushitrain",
    "check": "which sushitrain",
    "install_steps": [
      "pip install sushitrain",
      "Verify: sushitrain --version",
      "supercli plugins install ./plugins/sushitrain --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sushitrain",
      "resource": "self",
      "action": "version",
      "description": "Print sushitrain version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sushitrain",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sushitrain: pip install sushitrain"
      },
      "args": []
    },
    {
      "namespace": "sushitrain",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sushitrain CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sushitrain",
        "passthrough": true,
        "missingDependencyHelp": "Install sushitrain: pip install sushitrain"
      },
      "args": []
    }
  ]
}