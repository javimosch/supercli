{
  "name": "gltf-pipeline",
  "version": "0.1.0",
  "description": "CLI optimization for glTF models with mesh draco compression",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "gltf-pipeline" }],
  "install_guidance": {
    "plugin": "gltf-pipeline",
    "binary": "gltf-pipeline",
    "check": "which gltf-pipeline",
    "install_steps": ["npm install -g gltf-pipeline", "Verify: gltf-pipeline --version", "supercli plugins install ./plugins/gltf-pipeline --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gltf-pipeline",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gltf-pipeline CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gltf-pipeline",
      "passthrough": true,
      "missingDependencyHelp": "Install gltf-pipeline: npm install -g gltf-pipeline"
    },
    "args": []
  }]
}
