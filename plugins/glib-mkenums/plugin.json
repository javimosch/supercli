{
  "name": "glib-mkenums",
  "version": "0.1.0",
  "description": "CLI tool: glib-mkenums",
  "source": "https://manpages.debian.org/glib-mkenums",
  "checks": [
    {
      "type": "binary",
      "name": "glib-mkenums"
    }
  ],
  "install_guidance": {
    "plugin": "glib-mkenums",
    "binary": "glib-mkenums",
    "check": "which glib-mkenums",
    "install_steps": [
      "apt-get install glib-mkenums 2>/dev/null || which glib-mkenums",
      "Verify: glib-mkenums --version",
      "supercli plugins install ./plugins/glib-mkenums --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "glib-mkenums",
      "resource": "self",
      "action": "version",
      "description": "Print glib-mkenums version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-mkenums",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install glib-mkenums: apt-get install glib-mkenums 2>/dev/null || which glib-mkenums"
      },
      "args": []
    },
    {
      "namespace": "glib-mkenums",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glib-mkenums CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-mkenums",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install glib-mkenums: apt-get install glib-mkenums 2>/dev/null || which glib-mkenums"
      },
      "args": []
    }
  ]
}