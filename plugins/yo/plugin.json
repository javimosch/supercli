{
  "name": "yo",
  "version": "0.1.0",
  "description": "Yeoman \u2014 project scaffolding generator",
  "source": "https://github.com/yeoman/yo",
  "checks": [
    {
      "type": "binary",
      "name": "yo"
    }
  ],
  "install_guidance": {
    "plugin": "yo",
    "binary": "yo",
    "check": "which yo",
    "install_steps": [
      "npm install -g yo",
      "Verify: yo --version",
      "supercli plugins install ./plugins/yo --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "yo",
      "resource": "self",
      "action": "version",
      "description": "Print yo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yo: npm install -g yo"
      },
      "args": []
    },
    {
      "namespace": "yo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install yo: npm install -g yo"
      },
      "args": []
    }
  ]
}
