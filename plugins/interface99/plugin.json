{
  "name": "interface99",
  "version": "0.1.0",
  "description": "Full-featured interfaces for C99",
  "source": "https://github.com/Hirrolot/interface99",
  "checks": [
    {
      "type": "binary",
      "name": "interface99"
    }
  ],
  "install_guidance": {
    "plugin": "interface99",
    "binary": "interface99",
    "check": "which interface99",
    "install_steps": [
      "brew install interface99",
      "Verify: interface99 --version",
      "supercli plugins install ./plugins/interface99 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "interface99",
      "resource": "self",
      "action": "version",
      "description": "Print interface99 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "interface99",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install interface99: brew install interface99"
      },
      "args": []
    },
    {
      "namespace": "interface99",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to interface99 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "interface99",
        "passthrough": true,
        "missingDependencyHelp": "Install interface99"
      },
      "args": []
    }
  ]
}