{
  "name": "AndroidLiquidGlass",
  "version": "0.1.0",
  "description": "Compose Multiplatform Liquid Glass effect",
  "source": "https://github.com/AndroidLiquidGlass/AndroidLiquidGlass",
  "checks": [
    {
      "type": "binary",
      "name": "androidliquidglass"
    }
  ],
  "install_guidance": {
    "plugin": "AndroidLiquidGlass",
    "binary": "androidliquidglass",
    "check": "which androidliquidglass",
    "install_steps": [
      "pip install androidliquidglass",
      "Verify: androidliquidglass --version",
      "supercli plugins install ./plugins/AndroidLiquidGlass --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AndroidLiquidGlass",
      "resource": "self",
      "action": "version",
      "description": "Print AndroidLiquidGlass version",
      "adapter": "process",
      "adapterConfig": {
        "command": "androidliquidglass",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AndroidLiquidGlass: pip install androidliquidglass"
      },
      "args": []
    },
    {
      "namespace": "AndroidLiquidGlass",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to androidliquidglass CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "androidliquidglass",
        "passthrough": true,
        "missingDependencyHelp": "Install AndroidLiquidGlass: pip install androidliquidglass"
      },
      "args": []
    }
  ]
}