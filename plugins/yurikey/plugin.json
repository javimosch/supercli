{
  "name": "yurikey",
  "version": "0.1.0",
  "description": "A systemless module to get strong integrity easily",
  "source": "https://github.com/yurikey/yurikey",
  "checks": [
    {
      "type": "binary",
      "name": "yurikey"
    }
  ],
  "install_guidance": {
    "plugin": "yurikey",
    "binary": "yurikey",
    "check": "which yurikey",
    "install_steps": [
      "pip install yurikey",
      "Verify: yurikey --version",
      "supercli plugins install ./plugins/yurikey --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yurikey",
      "resource": "self",
      "action": "version",
      "description": "Print yurikey version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yurikey",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yurikey: pip install yurikey"
      },
      "args": []
    },
    {
      "namespace": "yurikey",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yurikey CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yurikey",
        "passthrough": true,
        "missingDependencyHelp": "Install yurikey: pip install yurikey"
      },
      "args": []
    }
  ]
}