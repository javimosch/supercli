{
  "name": "folib",
  "version": "0.1.0",
  "description": "\u5168\u8bed\u8a00\u5236\u54c1\u4ed3\u5e93\uff0c\u6db5\u76d6npm\u3001Maven\u3001PyPi\u3001Docker\u3001Gradle\u3001SBT\u3001Cocoapods\u3001Swift\u3001RPM\u3001Debian\u3001PHP\u3001Go\u3001Pub\u3001Ivy\u3001NuGet\u3001Conda\u3001Car",
  "source": "https://github.com/folib/folib",
  "checks": [
    {
      "type": "binary",
      "name": "folib"
    }
  ],
  "install_guidance": {
    "plugin": "folib",
    "binary": "folib",
    "check": "which folib",
    "install_steps": [
      "pip install folib",
      "Verify: folib --version",
      "supercli plugins install ./plugins/folib --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "folib",
      "resource": "self",
      "action": "version",
      "description": "Print folib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "folib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install folib: pip install folib"
      },
      "args": []
    },
    {
      "namespace": "folib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to folib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "folib",
        "passthrough": true,
        "missingDependencyHelp": "Install folib: pip install folib"
      },
      "args": []
    }
  ]
}