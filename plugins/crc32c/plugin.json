{
  "name": "crc32c",
  "version": "0.1.0",
  "description": "Implementation of CRC32C with CPU-specific acceleration",
  "source": "https://github.com/google/crc32c",
  "checks": [
    {
      "type": "binary",
      "name": "crc32c"
    }
  ],
  "install_guidance": {
    "plugin": "crc32c",
    "binary": "crc32c",
    "check": "which crc32c",
    "install_steps": [
      "brew install crc32c",
      "Verify: crc32c --version",
      "supercli plugins install ./plugins/crc32c --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "crc32c",
      "resource": "self",
      "action": "version",
      "description": "Print crc32c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crc32c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crc32c: brew install crc32c"
      },
      "args": []
    },
    {
      "namespace": "crc32c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crc32c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crc32c",
        "passthrough": true,
        "missingDependencyHelp": "Install crc32c"
      },
      "args": []
    }
  ]
}