{
  "name": "cz-git",
  "version": "0.1.0",
  "description": "DX first git commit tool in TypeScript",
  "source": "https://github.com/nicholasgasior/cz-git",
  "checks": [{"type": "binary", "name": "czg"}],
  "install_guidance": {
    "plugin": "cz-git",
    "binary": "czg",
    "check": "which czg",
    "install_steps": [
      "npm install -g czg",
      "Verify: czg --version",
      "supercli plugins install ./cz-git --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "cz-git",
      "resource": "self",
      "action": "version",
      "description": "Print cz-git version",
      "adapter": "process",
      "adapterConfig": {"command": "czg", "baseArgs": ["--version"], "missingDependencyHelp": "Install cz-git: npm install -g czg"},
      "args": []
    },
    {
      "namespace": "cz-git",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cz-git CLI",
      "adapter": "process",
      "adapterConfig": {"command": "czg", "passthrough": true, "missingDependencyHelp": "Install cz-git: npm install -g czg"},
      "args": []
    }
  ]
}
