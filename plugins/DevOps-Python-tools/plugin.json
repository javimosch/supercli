{
  "name": "DevOps-Python-tools",
  "version": "0.1.0",
  "description": "Collection of 80+ DevOps and cloud CLI tools",
  "source": "https://github.com/nicholasgasior/DevOps-Python-tools",
  "checks": [
    {
      "type": "binary",
      "name": "devops-python-tools"
    }
  ],
  "install_guidance": {
    "plugin": "DevOps-Python-tools",
    "binary": "devops-python-tools",
    "check": "which devops-python-tools",
    "install_steps": [
      "pip install devops-python-tools",
      "Verify: devops-python-tools --version",
      "supercli plugins install ./plugins/DevOps-Python-tools --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DevOps-Python-tools",
      "resource": "self",
      "action": "version",
      "description": "Print DevOps-Python-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "devops-python-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DevOps-Python-tools: pip install devops-python-tools"
      },
      "args": []
    },
    {
      "namespace": "DevOps-Python-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to devops-python-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "devops-python-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install DevOps-Python-tools: pip install devops-python-tools"
      },
      "args": []
    }
  ]
}
