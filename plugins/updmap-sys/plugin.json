{
  "name": "updmap-sys",
  "version": "0.1.0",
  "description": "CLI tool: updmap-sys",
  "source": "https://manpages.debian.org/updmap-sys",
  "checks": [
    {
      "type": "binary",
      "name": "updmap-sys"
    }
  ],
  "install_guidance": {
    "plugin": "updmap-sys",
    "binary": "updmap-sys",
    "check": "which updmap-sys",
    "install_steps": [
      "apt-get install updmap-sys 2>/dev/null || which updmap-sys",
      "Verify: updmap-sys --version",
      "supercli plugins install ./plugins/updmap-sys --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "updmap-sys",
      "resource": "self",
      "action": "version",
      "description": "Print updmap-sys version",
      "adapter": "process",
      "adapterConfig": {
        "command": "updmap-sys",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install updmap-sys: apt-get install updmap-sys 2>/dev/null || which updmap-sys"
      },
      "args": []
    },
    {
      "namespace": "updmap-sys",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to updmap-sys CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "updmap-sys",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install updmap-sys: apt-get install updmap-sys 2>/dev/null || which updmap-sys"
      },
      "args": []
    }
  ]
}