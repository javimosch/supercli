{
  "name": "chokidar-cli",
  "version": "0.1.0",
  "description": "CLI to watch file system changes",
  "source": "https://github.com/open-cli-tools/chokidar-cli",
  "checks": [
    {
      "type": "binary",
      "name": "chokidar-cli"
    }
  ],
  "install_guidance": {
    "plugin": "chokidar-cli",
    "binary": "chokidar-cli",
    "check": "which chokidar-cli",
    "install_steps": [
      "npm install -g chokidar-cli",
      "Verify: chokidar-cli --version",
      "supercli plugins install ./plugins/chokidar-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chokidar-cli",
      "resource": "self",
      "action": "version",
      "description": "Print chokidar-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chokidar-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chokidar-cli: npm install -g chokidar-cli"
      },
      "args": []
    },
    {
      "namespace": "chokidar-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chokidar-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chokidar-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install chokidar-cli"
      },
      "args": []
    }
  ]
}