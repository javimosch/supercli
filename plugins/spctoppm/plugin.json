{
  "name": "spctoppm",
  "version": "0.1.0",
  "description": "CLI tool: spctoppm",
  "source": "https://manpages.debian.org/spctoppm",
  "checks": [
    {
      "type": "binary",
      "name": "spctoppm"
    }
  ],
  "install_guidance": {
    "plugin": "spctoppm",
    "binary": "spctoppm",
    "check": "which spctoppm",
    "install_steps": [
      "apt-get install spctoppm 2>/dev/null || which spctoppm",
      "Verify: spctoppm --version",
      "supercli plugins install ./plugins/spctoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "spctoppm",
      "resource": "self",
      "action": "version",
      "description": "Print spctoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spctoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spctoppm: apt-get install spctoppm 2>/dev/null || which spctoppm"
      },
      "args": []
    },
    {
      "namespace": "spctoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spctoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spctoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install spctoppm: apt-get install spctoppm 2>/dev/null || which spctoppm"
      },
      "args": []
    }
  ]
}