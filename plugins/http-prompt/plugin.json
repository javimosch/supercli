{
  "name": "http-prompt",
  "version": "0.1.0",
  "description": "An interactive command-line HTTP and API testing client built on top of HTTPie",
  "source": "https://github.com/httpie/http-prompt",
  "checks": [{ "type": "binary", "name": "http-prompt" }],
  "install_guidance": {
    "plugin": "http-prompt",
    "binary": "http-prompt",
    "check": "which http-prompt",
    "install_steps": [
      "pip install http-prompt",
      "Or: pipx install http-prompt",
      "Verify: http-prompt --version",
      "supercli plugins install ./plugins/http-prompt --on-conflict replace --json"
    ],
    "note": "Available via pip/pipx. Source: https://github.com/httpie/http-prompt (9.1k+ stars). Written in Python."
  },
  "commands": [
    {
      "namespace": "http-prompt", "resource": "self", "action": "version",
      "description": "Print http-prompt version",
      "adapter": "process",
      "adapterConfig": { "command": "http-prompt", "missingDependencyHelp": "Install http-prompt: pip install http-prompt", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "http-prompt", "resource": "_", "action": "_",
      "description": "Passthrough to http-prompt CLI",
      "adapter": "process",
      "adapterConfig": { "command": "http-prompt", "missingDependencyHelp": "Install http-prompt: pip install http-prompt", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
