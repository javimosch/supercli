{
  "name": "mcs",
  "version": "0.1.0",
  "description": "Mono C# compiler",
  "source": "https://packages.debian.org/mcs",
  "checks": [{ "type": "binary", "name": "mcs" }],
  "install_guidance": {
    "plugin": "mcs", "binary": "mcs", "check": "which mcs",
    "install_steps": ["apt-get install mono-mcs", "Verify: mcs --version", "supercli plugins install ./plugins/mcs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mcs", "resource": "_", "action": "_",
    "description": "Passthrough to mcs CLI",
    "adapter": "process", "adapterConfig": { "command": "mcs", "passthrough": true, "missingDependencyHelp": "Install mcs: apt-get install mono-mcs" }, "args": []
  }]
}
