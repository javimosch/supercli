{
  "name": "emojify",
  "version": "0.1.0",
  "description": "Emoji on the command-line :scream:",
  "source": "https://github.com/mrowa44/emojify",
  "checks": [
    {
      "type": "binary",
      "name": "emojify"
    }
  ],
  "install_guidance": {
    "plugin": "emojify",
    "binary": "emojify",
    "check": "which emojify",
    "install_steps": [
      "brew install emojify",
      "Verify: emojify --version",
      "supercli plugins install ./plugins/emojify --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "emojify",
      "resource": "self",
      "action": "version",
      "description": "Print emojify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "emojify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install emojify: brew install emojify"
      },
      "args": []
    },
    {
      "namespace": "emojify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to emojify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "emojify",
        "passthrough": true,
        "missingDependencyHelp": "Install emojify"
      },
      "args": []
    }
  ]
}