{
  "name": "skidl",
  "version": "0.1.0",
  "description": "Describe electronic circuits using Python code instead of schematic editors",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "skidl" }],
  "install_guidance": {
    "plugin": "skidl",
    "binary": "skidl",
    "check": "which skidl",
    "install_steps": ["pip install skidl", "Verify: skidl --version", "supercli plugins install ./plugins/skidl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "skidl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to skidl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "skidl",
      "passthrough": true,
      "missingDependencyHelp": "Install skidl: pip install skidl"
    },
    "args": []
  }]
}
