{
  "name": "import",
  "version": "0.1.0",
  "description": "Capture screenshot/image from X display",
  "source": "https://packages.debian.org/import",
  "checks": [{ "type": "binary", "name": "import" }],
  "install_guidance": {
    "plugin": "import", "binary": "import", "check": "which import",
    "install_steps": ["apt-get install imagemagick", "Verify: import --version", "supercli plugins install ./plugins/import --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "import", "resource": "_", "action": "_",
    "description": "Passthrough to import CLI",
    "adapter": "process", "adapterConfig": { "command": "import", "passthrough": true, "missingDependencyHelp": "Install import: apt-get install imagemagick" }, "args": []
  }]
}
