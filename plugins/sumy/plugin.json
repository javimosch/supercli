{
  "name": "sumy",
  "version": "0.1.0",
  "description": "Automatic text summarizer with multiple algorithms",
  "source": "https://github.com/miso-belica/sumy",
  "checks": [{ "type": "binary", "name": "sumy" }],
  "install_guidance": {
    "plugin": "sumy",
    "binary": "sumy",
    "check": "which sumy",
    "install_steps": ["pip install sumy", "Verify: sumy --version", "supercli plugins install ./plugins/sumy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sumy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sumy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sumy",
      "passthrough": true,
      "missingDependencyHelp": "Install sumy: pip install sumy", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
