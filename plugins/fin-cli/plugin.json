{
  "name": "fin-cli",
  "version": "0.1.0",
  "description": "Lightweight CLI for querying financial stock and ETF metrics",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "fin-cli" }],
  "install_guidance": {
    "plugin": "fin-cli",
    "binary": "fin-cli",
    "check": "which fin-cli",
    "install_steps": ["cargo install fin-cli", "Verify: fin-cli --version", "supercli plugins install ./plugins/fin-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fin-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fin-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fin-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install fin-cli: cargo install fin-cli"
    },
    "args": []
  }]
}
