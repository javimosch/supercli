{
  "name": "terminal-info",
  "version": "0.1.0",
  "description": "Fast Rust CLI toolbox for weather, system info, network diagnostics with JSON output",
  "source": "https://github.com/T-1234567890/terminal-info",
  "checks": [
    {
      "type": "binary",
      "name": "tinfo"
    }
  ],
  "install_guidance": {
    "plugin": "terminal-info",
    "binary": "tinfo",
    "check": "which tinfo",
    "install_steps": [
      "cargo install terminal-info",
      "Verify: tinfo --version",
      "supercli plugins install ./plugins/terminal-info --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tinfo",
      "resource": "self",
      "action": "version",
      "description": "Print terminal-info version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tinfo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install terminal-info: cargo install terminal-info"
      },
      "args": []
    },
    {
      "namespace": "tinfo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tinfo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tinfo",
        "passthrough": true,
        "missingDependencyHelp": "Install terminal-info: cargo install terminal-info"
      },
      "args": []
    }
  ]
}
