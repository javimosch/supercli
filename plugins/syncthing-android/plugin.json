{
  "name": "syncthing-android",
  "version": "0.1.0",
  "description": "Syncthing-Fork - A Syncthing Wrapper for Android.",
  "source": "https://github.com/syncthing-android/syncthing-android",
  "checks": [
    {
      "type": "binary",
      "name": "syncthing-android"
    }
  ],
  "install_guidance": {
    "plugin": "syncthing-android",
    "binary": "syncthing-android",
    "check": "which syncthing-android",
    "install_steps": [
      "pip install syncthing-android",
      "Verify: syncthing-android --version",
      "supercli plugins install ./plugins/syncthing-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "syncthing-android",
      "resource": "self",
      "action": "version",
      "description": "Print syncthing-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "syncthing-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install syncthing-android: pip install syncthing-android"
      },
      "args": []
    },
    {
      "namespace": "syncthing-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to syncthing-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "syncthing-android",
        "passthrough": true,
        "missingDependencyHelp": "Install syncthing-android: pip install syncthing-android"
      },
      "args": []
    }
  ]
}