{
  "name": "nstat",
  "version": "0.1.0",
  "description": "Network statistics",
  "source": "https://packages.debian.org/nstat",
  "checks": [{ "type": "binary", "name": "nstat" }],
  "install_guidance": {
    "plugin": "nstat", "binary": "nstat", "check": "which nstat",
    "install_steps": ["apt-get install iproute2", "Verify: nstat --version", "supercli plugins install ./plugins/nstat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nstat", "resource": "_", "action": "_",
    "description": "Passthrough to nstat CLI",
    "adapter": "process", "adapterConfig": { "command": "nstat", "passthrough": true, "missingDependencyHelp": "Install nstat: apt-get install iproute2" }, "args": []
  }]
}
