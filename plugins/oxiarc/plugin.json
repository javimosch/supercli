{
  "name": "oxiarc",
  "version": "0.1.0",
  "description": "Pure Rust implementation for archiving and compression",
  "source": "https://github.com/cool-japan/oxiarc",
  "checks": [{ "type": "binary", "name": "oxiarc" }],
  "install_guidance": {
    "plugin": "oxiarc",
    "binary": "oxiarc",
    "check": "which oxiarc",
    "install_steps": ["cargo install oxiarc", "Verify: oxiarc --version", "supercli plugins install ./plugins/oxiarc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "oxiarc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to oxiarc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "oxiarc",
      "passthrough": true,
      "missingDependencyHelp": "Install oxiarc: cargo install oxiarc", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
