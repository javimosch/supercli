{
  "name": "ffc.h",
  "version": "0.1.0",
  "description": "Single-header C99 accelerated float/double parsing",
  "source": "https://github.com/kolemannix/ffc.h",
  "checks": [
    {
      "type": "binary",
      "name": "ffc.h"
    }
  ],
  "install_guidance": {
    "plugin": "ffc.h",
    "binary": "ffc.h",
    "check": "which ffc.h",
    "install_steps": [
      "brew install ffc.h",
      "Verify: ffc.h --version",
      "supercli plugins install ./plugins/ffc.h --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ffc.h",
      "resource": "self",
      "action": "version",
      "description": "Print ffc.h version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ffc.h",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ffc.h: brew install ffc.h"
      },
      "args": []
    },
    {
      "namespace": "ffc.h",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ffc.h CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ffc.h",
        "passthrough": true,
        "missingDependencyHelp": "Install ffc.h"
      },
      "args": []
    }
  ]
}