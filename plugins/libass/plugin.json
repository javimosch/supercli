{
  "name": "libass",
  "version": "0.1.0",
  "description": "Subtitle renderer for the ASS/SSA subtitle format",
  "source": "https://github.com/libass/libass",
  "checks": [
    {
      "type": "binary",
      "name": "libass"
    }
  ],
  "install_guidance": {
    "plugin": "libass",
    "binary": "libass",
    "check": "which libass",
    "install_steps": [
      "brew install libass",
      "Verify: libass --version",
      "supercli plugins install ./plugins/libass --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libass",
      "resource": "self",
      "action": "version",
      "description": "Print libass version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libass",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libass: brew install libass"
      },
      "args": []
    },
    {
      "namespace": "libass",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libass CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libass",
        "passthrough": true,
        "missingDependencyHelp": "Install libass"
      },
      "args": []
    }
  ]
}