{
  "name": "flac123",
  "version": "0.1.0",
  "description": "Command-line program for playing FLAC audio files",
  "source": "https://github.com/flac123/flac123",
  "checks": [
    {
      "type": "binary",
      "name": "flac123"
    }
  ],
  "install_guidance": {
    "plugin": "flac123",
    "binary": "flac123",
    "check": "which flac123",
    "install_steps": [
      "brew install flac123",
      "Verify: flac123 --version",
      "supercli plugins install ./plugins/flac123 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "flac123",
      "resource": "self",
      "action": "version",
      "description": "Print flac123 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flac123",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flac123: brew install flac123"
      },
      "args": []
    },
    {
      "namespace": "flac123",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flac123 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flac123",
        "passthrough": true,
        "missingDependencyHelp": "Install flac123"
      },
      "args": []
    }
  ]
}