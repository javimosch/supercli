{
  "name": "nisdomainname",
  "version": "0.1.0",
  "description": "nisdomainname \u2014 show or set the system's NIS/YP domain name",
  "source": "https://manpages.debian.org/nisdomainname",
  "checks": [
    {
      "type": "binary",
      "name": "nisdomainname"
    }
  ],
  "install_guidance": {
    "plugin": "nisdomainname",
    "binary": "nisdomainname",
    "check": "which nisdomainname",
    "install_steps": [
      "apt-get install nisdomainname 2>/dev/null || which nisdomainname",
      "Verify: nisdomainname --version",
      "supercli plugins install ./plugins/nisdomainname --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nisdomainname",
      "resource": "self",
      "action": "version",
      "description": "Print nisdomainname version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nisdomainname",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nisdomainname: apt-get install nisdomainname 2>/dev/null || which nisdomainname"
      },
      "args": []
    },
    {
      "namespace": "nisdomainname",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nisdomainname CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nisdomainname",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nisdomainname: apt-get install nisdomainname 2>/dev/null || which nisdomainname"
      },
      "args": []
    }
  ]
}