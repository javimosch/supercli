{
  "name": "tailspin",
  "version": "0.1.0",
  "description": "Log file highlighter that detects timestamps and levels automatically",
  "source": "https://github.com/bensadeh/tailspin",
  "checks": [{ "type": "binary", "name": "tailspin" }],
  "install_guidance": {
    "plugin": "tailspin",
    "binary": "tailspin",
    "check": "which tailspin",
    "install_steps": ["cargo install tailspin", "Verify: tailspin --version", "supercli plugins install ./plugins/tailspin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tailspin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tailspin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tailspin",
      "passthrough": true,
      "missingDependencyHelp": "Install tailspin: cargo install tailspin"
    },
    "args": []
  }]
}
