{
  "name": "MediaParserTools",
  "version": "0.1.0",
  "description": "解析mp4   flv   ts     h264  ts 文件的一整套工具",
  "source": "https://github.com/MediaParserTools/MediaParserTools",
  "checks": [
    {
      "type": "binary",
      "name": "MediaParserTools"
    }
  ],
  "install_guidance": {
    "plugin": "MediaParserTools",
    "binary": "MediaParserTools",
    "check": "which MediaParserTools",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: MediaParserTools --version",
      "supercli plugins install ./plugins/MediaParserTools --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "MediaParserTools",
      "resource": "self",
      "action": "version",
      "description": "Print MediaParserTools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "MediaParserTools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MediaParserTools from project repository"
      },
      "args": []
    },
    {
      "namespace": "MediaParserTools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to MediaParserTools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "MediaParserTools",
        "passthrough": true,
        "missingDependencyHelp": "Install MediaParserTools from project repository"
      },
      "args": []
    }
  ]
}