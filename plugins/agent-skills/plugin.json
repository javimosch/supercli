{
  "name": "agent-skills",
  "version": "0.1.0",
  "description": "Production-grade engineering skills for AI coding agents.",
  "source": "https://github.com/agent-skills/agent-skills",
  "checks": [
    {
      "type": "binary",
      "name": "agent-skills"
    }
  ],
  "install_guidance": {
    "plugin": "agent-skills",
    "binary": "agent-skills",
    "check": "which agent-skills",
    "install_steps": [
      "pip install agent-skills",
      "Verify: agent-skills --version",
      "supercli plugins install ./plugins/agent-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agent-skills",
      "resource": "self",
      "action": "version",
      "description": "Print agent-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agent-skills: pip install agent-skills"
      },
      "args": []
    },
    {
      "namespace": "agent-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agent-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install agent-skills: pip install agent-skills"
      },
      "args": []
    }
  ]
}