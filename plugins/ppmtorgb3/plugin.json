{
  "name": "ppmtorgb3",
  "version": "0.1.0",
  "description": "CLI tool: ppmtorgb3",
  "source": "https://manpages.debian.org/ppmtorgb3",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtorgb3"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtorgb3",
    "binary": "ppmtorgb3",
    "check": "which ppmtorgb3",
    "install_steps": [
      "apt-get install ppmtorgb3 2>/dev/null || which ppmtorgb3",
      "Verify: ppmtorgb3 --version",
      "supercli plugins install ./plugins/ppmtorgb3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtorgb3",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtorgb3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtorgb3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtorgb3: apt-get install ppmtorgb3 2>/dev/null || which ppmtorgb3"
      },
      "args": []
    },
    {
      "namespace": "ppmtorgb3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtorgb3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtorgb3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtorgb3: apt-get install ppmtorgb3 2>/dev/null || which ppmtorgb3"
      },
      "args": []
    }
  ]
}