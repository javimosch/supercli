{
  "name": "temp-mail-cli",
  "version": "0.1.0",
  "description": "Create disposable email addresses and monitor inboxes",
  "source": "https://github.com/r3d/temp-mail-cli",
  "checks": [{ "type": "binary", "name": "temp-mail-cli" }],
  "install_guidance": {
    "plugin": "temp-mail-cli",
    "binary": "temp-mail-cli",
    "check": "which temp-mail-cli",
    "install_steps": ["npm install -g temp-mail-cli", "Verify: temp-mail-cli --version", "supercli plugins install ./plugins/temp-mail-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "temp-mail-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to temp-mail-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "temp-mail-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install temp-mail-cli: npm install -g temp-mail-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
