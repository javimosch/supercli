{
  "name": "dvilj6",
  "version": "0.1.0",
  "description": "CLI tool: dvilj6",
  "source": "https://manpages.debian.org/dvilj6",
  "checks": [
    {
      "type": "binary",
      "name": "dvilj6"
    }
  ],
  "install_guidance": {
    "plugin": "dvilj6",
    "binary": "dvilj6",
    "check": "which dvilj6",
    "install_steps": [
      "apt-get install dvilj6 2>/dev/null || which dvilj6",
      "Verify: dvilj6 --version",
      "supercli plugins install ./plugins/dvilj6 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvilj6",
      "resource": "self",
      "action": "version",
      "description": "Print dvilj6 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj6",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvilj6: apt-get install dvilj6 2>/dev/null || which dvilj6"
      },
      "args": []
    },
    {
      "namespace": "dvilj6",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvilj6 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj6",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvilj6: apt-get install dvilj6 2>/dev/null || which dvilj6"
      },
      "args": []
    }
  ]
}