{
  "name": "remmina-file-wrapper",
  "version": "0.1.0",
  "description": "CLI tool: remmina-file-wrapper",
  "source": "https://manpages.debian.org/remmina-file-wrapper",
  "checks": [
    {
      "type": "binary",
      "name": "remmina-file-wrapper"
    }
  ],
  "install_guidance": {
    "plugin": "remmina-file-wrapper",
    "binary": "remmina-file-wrapper",
    "check": "which remmina-file-wrapper",
    "install_steps": [
      "apt-get install remmina-file-wrapper 2>/dev/null || which remmina-file-wrapper",
      "Verify: remmina-file-wrapper --version",
      "supercli plugins install ./plugins/remmina-file-wrapper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "remmina-file-wrapper",
      "resource": "self",
      "action": "version",
      "description": "Print remmina-file-wrapper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "remmina-file-wrapper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install remmina-file-wrapper: apt-get install remmina-file-wrapper 2>/dev/null || which remmina-file-wrapper"
      },
      "args": []
    },
    {
      "namespace": "remmina-file-wrapper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to remmina-file-wrapper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "remmina-file-wrapper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install remmina-file-wrapper: apt-get install remmina-file-wrapper 2>/dev/null || which remmina-file-wrapper"
      },
      "args": []
    }
  ]
}