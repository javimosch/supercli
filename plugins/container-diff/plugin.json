{
  "name": "container-diff",
  "version": "0.1.0",
  "description": "Container image diff tool",
  "source": "https://github.com/GoogleContainerTools/container-diff",
  "checks": [
    {
      "type": "binary",
      "name": "container-diff"
    }
  ],
  "install_guidance": {
    "plugin": "container-diff",
    "binary": "container-diff",
    "check": "which container-diff",
    "install_steps": [
      "curl -LO https://storage.googleapis.com/container-diff/latest/container-diff-linux-amd64 && chmod +x container-diff-linux-amd64",
      "Verify: container-diff --version",
      "supercli plugins install ./plugins/container-diff --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "container-diff",
      "resource": "self",
      "action": "version",
      "description": "Print container-diff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "container-diff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install container-diff: curl -LO https://storage.googleapis.com/container-diff/latest/container-diff-linux-amd64 && chmod +x container-diff-linux-amd64"
      },
      "args": []
    },
    {
      "namespace": "container-diff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to container-diff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "container-diff",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install container-diff: curl -LO https://storage.googleapis.com/container-diff/latest/container-diff-linux-amd64 && chmod +x container-diff-linux-amd64"
      },
      "args": []
    }
  ]
}
