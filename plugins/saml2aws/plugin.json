{
  "name": "saml2aws",
  "version": "0.1.0",
  "description": "CLI tool for AWS SAML authentication and temporary credential generation",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "saml2aws" }],
  "install_guidance": {
    "plugin": "saml2aws",
    "binary": "saml2aws",
    "check": "which saml2aws",
    "install_steps": ["brew install saml2aws", "Verify: saml2aws --version", "supercli plugins install ./plugins/saml2aws --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "saml2aws",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to saml2aws CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "saml2aws",
      "passthrough": true,
      "missingDependencyHelp": "Install saml2aws: brew install saml2aws"
    },
    "args": []
  }]
}
