{
  "name": "cntrint",
  "version": "0.1.0",
  "description": "CLI tool: cntrint",
  "source": "https://packages.debian.org/cntrint",
  "checks": [{ "type": "binary", "name": "cntrint" }],
  "install_guidance": {
    "plugin": "cntrint", "binary": "cntrint", "check": "which cntrint",
    "install_steps": ["apt-get install cntrint 2>/dev/null || which cntrint", "Verify: cntrint --version", "supercli plugins install ./plugins/cntrint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cntrint", "resource": "_", "action": "_",
    "description": "Passthrough to cntrint CLI",
    "adapter": "process", "adapterConfig": { "command": "cntrint", "passthrough": true, "missingDependencyHelp": "Install cntrint: apt-get install cntrint" }, "args": []
  }]
}
