{
  "name": "md2confl",
  "version": "0.1.0",
  "description": "Convert Markdown to Confluence wiki markup",
  "source": "https://github.com/peterhudec/md2confl",
  "checks": [{ "type": "binary", "name": "md2confl" }],
  "install_guidance": {
    "plugin": "md2confl",
    "binary": "md2confl",
    "check": "which md2confl",
    "install_steps": ["pip install md2confl", "Verify: md2confl --version", "supercli plugins install ./plugins/md2confl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "md2confl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to md2confl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "md2confl",
      "passthrough": true,
      "missingDependencyHelp": "Install md2confl: pip install md2confl", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
