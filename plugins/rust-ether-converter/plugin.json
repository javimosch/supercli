{
  "name": "rust-ether-converter",
  "version": "0.1.0",
  "description": "Ether unit converter CLI in Rust",
  "source": "https://github.com/nicholasgasior/rust-ether-converter",
  "checks": [{"type": "binary", "name": "ether-converter"}],
  "install_guidance": {
    "plugin": "rust-ether-converter",
    "binary": "ether-converter",
    "check": "which ether-converter",
    "install_steps": [
      "cargo install rust-ether-converter",
      "Verify: ether-converter --version",
      "supercli plugins install ./rust-ether-converter --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "rust-ether-converter",
      "resource": "self",
      "action": "version",
      "description": "Print rust-ether-converter version",
      "adapter": "process",
      "adapterConfig": {"command": "ether-converter", "baseArgs": ["--version"], "missingDependencyHelp": "Install rust-ether-converter: cargo install rust-ether-converter"},
      "args": []
    },
    {
      "namespace": "rust-ether-converter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rust-ether-converter CLI",
      "adapter": "process",
      "adapterConfig": {"command": "ether-converter", "passthrough": true, "missingDependencyHelp": "Install rust-ether-converter: cargo install rust-ether-converter"},
      "args": []
    }
  ]
}
