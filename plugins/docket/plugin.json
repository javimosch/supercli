{
  "name": "docket",
  "version": "1.0.0",
  "description": "docket \u2014 Docker TUI",
  "source": "github.com/docker/docket",
  "checks": [
    {
      "type": "binary",
      "name": "docket"
    }
  ],
  "install_guidance": {
    "plugin": "docket",
    "binary": "docket",
    "check": "which docket",
    "install_steps": [
      "# Install docket",
      "# See github.com/docker/docket",
      "# apt: sudo apt-get install docket",
      "# brew: brew install docket",
      "# cargo: cargo install docket",
      "# npm: npm install -g docket",
      "# pip: pip install docket"
    ]
  },
  "commands": [
    {
      "namespace": "docket",
      "resource": "docket",
      "action": "run",
      "description": "Run docket",
      "adapter": "process",
      "adapterConfig": {
        "command": "docket",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install docket from github.com/docker/docket"
      },
      "args": []
    }
  ]
}