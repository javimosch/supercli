{
  "name": "actdiag",
  "version": "0.1.0",
  "description": "Generate activity network diagrams from text descriptions",
  "source": "https://github.com/blockdiag/actdiag",
  "checks": [{ "type": "binary", "name": "actdiag" }],
  "install_guidance": {
    "plugin": "actdiag",
    "binary": "actdiag",
    "check": "which actdiag",
    "install_steps": ["pip install actdiag", "Verify: actdiag --version", "supercli plugins install ./plugins/actdiag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "actdiag",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to actdiag CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "actdiag",
      "passthrough": true,
      "missingDependencyHelp": "Install actdiag: pip install actdiag", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
