{
  "name": "zinc",
  "version": "0.1.0",
  "description": "Zig INferenCe Engine \u2014 Local LLM inference on AMD GPUs and Apple Silicon",
  "source": "https://github.com/zinc/zinc",
  "checks": [
    {
      "type": "binary",
      "name": "zinc"
    }
  ],
  "install_guidance": {
    "plugin": "zinc",
    "binary": "zinc",
    "check": "which zinc",
    "install_steps": [
      "pip install zinc",
      "Verify: zinc --version",
      "supercli plugins install ./plugins/zinc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zinc",
      "resource": "self",
      "action": "version",
      "description": "Print zinc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zinc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zinc: pip install zinc"
      },
      "args": []
    },
    {
      "namespace": "zinc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zinc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zinc",
        "passthrough": true,
        "missingDependencyHelp": "Install zinc: pip install zinc"
      },
      "args": []
    }
  ]
}