{
  "name": "gtester-report",
  "version": "0.1.0",
  "description": "CLI tool: gtester-report",
  "source": "https://manpages.debian.org/gtester-report",
  "checks": [
    {
      "type": "binary",
      "name": "gtester-report"
    }
  ],
  "install_guidance": {
    "plugin": "gtester-report",
    "binary": "gtester-report",
    "check": "which gtester-report",
    "install_steps": [
      "apt-get install gtester-report 2>/dev/null || which gtester-report",
      "Verify: gtester-report --version",
      "supercli plugins install ./plugins/gtester-report --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gtester-report",
      "resource": "self",
      "action": "version",
      "description": "Print gtester-report version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtester-report",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtester-report: apt-get install gtester-report 2>/dev/null || which gtester-report"
      },
      "args": []
    },
    {
      "namespace": "gtester-report",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtester-report CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtester-report",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gtester-report: apt-get install gtester-report 2>/dev/null || which gtester-report"
      },
      "args": []
    }
  ]
}