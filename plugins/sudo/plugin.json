{
  "name": "sudo",
  "version": "0.1.0",
  "description": "It's sudo, for Windows",
  "source": "https://github.com/sudo/sudo",
  "checks": [
    {
      "type": "binary",
      "name": "sudo"
    }
  ],
  "install_guidance": {
    "plugin": "sudo",
    "binary": "sudo",
    "check": "which sudo",
    "install_steps": [
      "pip install sudo",
      "Verify: sudo --version",
      "supercli plugins install ./plugins/sudo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sudo",
      "resource": "self",
      "action": "version",
      "description": "Print sudo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sudo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sudo: pip install sudo"
      },
      "args": []
    },
    {
      "namespace": "sudo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sudo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sudo",
        "passthrough": true,
        "missingDependencyHelp": "Install sudo: pip install sudo"
      },
      "args": []
    }
  ]
}