{
  "name": "gperl",
  "version": "0.1.0",
  "description": "CLI tool: gperl",
  "source": "https://manpages.debian.org/gperl",
  "checks": [
    {
      "type": "binary",
      "name": "gperl"
    }
  ],
  "install_guidance": {
    "plugin": "gperl",
    "binary": "gperl",
    "check": "which gperl",
    "install_steps": [
      "apt-get install gperl 2>/dev/null || which gperl",
      "Verify: gperl --version",
      "supercli plugins install ./plugins/gperl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gperl",
      "resource": "self",
      "action": "version",
      "description": "Print gperl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gperl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gperl: apt-get install gperl 2>/dev/null || which gperl"
      },
      "args": []
    },
    {
      "namespace": "gperl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gperl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gperl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gperl: apt-get install gperl 2>/dev/null || which gperl"
      },
      "args": []
    }
  ]
}