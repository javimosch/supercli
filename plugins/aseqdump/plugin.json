{
  "name": "aseqdump",
  "version": "0.1.0",
  "description": "CLI tool: aseqdump",
  "source": "https://packages.debian.org/aseqdump",
  "checks": [{ "type": "binary", "name": "aseqdump" }],
  "install_guidance": {
    "plugin": "aseqdump", "binary": "aseqdump", "check": "which aseqdump",
    "install_steps": ["apt-get install aseqdump 2>/dev/null || which aseqdump", "Verify: aseqdump --version", "supercli plugins install ./plugins/aseqdump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aseqdump", "resource": "_", "action": "_",
    "description": "Passthrough to aseqdump CLI",
    "adapter": "process", "adapterConfig": { "command": "aseqdump", "passthrough": true, "missingDependencyHelp": "Install aseqdump: apt-get install aseqdump" }, "args": []
  }]
}
