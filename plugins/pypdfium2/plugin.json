{
  "name": "pypdfium2",
  "version": "0.1.0",
  "description": "CLI tool: pypdfium2",
  "source": "https://manpages.debian.org/pypdfium2",
  "checks": [
    {
      "type": "binary",
      "name": "pypdfium2"
    }
  ],
  "install_guidance": {
    "plugin": "pypdfium2",
    "binary": "pypdfium2",
    "check": "which pypdfium2",
    "install_steps": [
      "apt-get install pypdfium2 2>/dev/null || which pypdfium2",
      "Verify: pypdfium2 --version",
      "supercli plugins install ./plugins/pypdfium2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pypdfium2",
      "resource": "self",
      "action": "version",
      "description": "Print pypdfium2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pypdfium2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pypdfium2: apt-get install pypdfium2 2>/dev/null || which pypdfium2"
      },
      "args": []
    },
    {
      "namespace": "pypdfium2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pypdfium2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pypdfium2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pypdfium2: apt-get install pypdfium2 2>/dev/null || which pypdfium2"
      },
      "args": []
    }
  ]
}