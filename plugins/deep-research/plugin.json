{
  "name": "deep-research",
  "version": "0.1.0",
  "description": "An AI-powered research assistant that performs iterative, deep research on any topic by combining se",
  "source": "https://github.com/deep-research/deep-research",
  "checks": [
    {
      "type": "binary",
      "name": "deep-research"
    }
  ],
  "install_guidance": {
    "plugin": "deep-research",
    "binary": "deep-research",
    "check": "which deep-research",
    "install_steps": [
      "pip install deep-research",
      "Verify: deep-research --version",
      "supercli plugins install ./plugins/deep-research --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "deep-research",
      "resource": "self",
      "action": "version",
      "description": "Print deep-research version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deep-research",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install deep-research: pip install deep-research"
      },
      "args": []
    },
    {
      "namespace": "deep-research",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deep-research CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deep-research",
        "passthrough": true,
        "missingDependencyHelp": "Install deep-research: pip install deep-research"
      },
      "args": []
    }
  ]
}