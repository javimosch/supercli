{
  "name": "icontopbm",
  "version": "0.1.0",
  "description": "CLI tool: icontopbm",
  "source": "https://manpages.debian.org/icontopbm",
  "checks": [
    {
      "type": "binary",
      "name": "icontopbm"
    }
  ],
  "install_guidance": {
    "plugin": "icontopbm",
    "binary": "icontopbm",
    "check": "which icontopbm",
    "install_steps": [
      "apt-get install icontopbm 2>/dev/null || which icontopbm",
      "Verify: icontopbm --version",
      "supercli plugins install ./plugins/icontopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "icontopbm",
      "resource": "self",
      "action": "version",
      "description": "Print icontopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "icontopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install icontopbm: apt-get install icontopbm 2>/dev/null || which icontopbm"
      },
      "args": []
    },
    {
      "namespace": "icontopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to icontopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "icontopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install icontopbm: apt-get install icontopbm 2>/dev/null || which icontopbm"
      },
      "args": []
    }
  ]
}