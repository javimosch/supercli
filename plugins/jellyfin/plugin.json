{
  "name": "jellyfin",
  "version": "1.0.0",
  "description": "jellyfin — Media server",
  "source": "https://jellyfin.org",
  "checks": [
    {
      "type": "binary",
      "name": "jellyfin"
    }
  ],
  "install_guidance": {
    "plugin": "jellyfin",
    "binary": "jellyfin",
