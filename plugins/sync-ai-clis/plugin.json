{
  "name": "sync-ai-clis",
  "version": "0.1.0",
  "description": "Detect, install, update, and verify AI coding CLIs across platforms",
  "source": "https://github.com/hyeonbungi/sync-ai-clis",
  "checks": [
    {
      "type": "binary",
      "name": "sync-ai-clis"
    }
  ],
  "install_guidance": {
    "plugin": "sync-ai-clis",
    "binary": "sync-ai-clis",
    "check": "which sync-ai-clis",
    "install_steps": [
      "cargo install sync-ai-clis",
      "Verify: sync-ai-clis --version",
      "supercli plugins install ./plugins/sync-ai-clis --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sync-ai-clis",
      "resource": "self",
      "action": "version",
      "description": "Print sync-ai-clis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sync-ai-clis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sync-ai-clis: cargo install sync-ai-clis"
      },
      "args": []
    },
    {
      "namespace": "sync-ai-clis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sync-ai-clis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sync-ai-clis",
        "passthrough": true,
        "missingDependencyHelp": "Install sync-ai-clis: cargo install sync-ai-clis"
      },
      "args": []
    }
  ]
}
