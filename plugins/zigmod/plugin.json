{
  "name": "zigmod",
  "version": "0.1.0",
  "description": "Zig package manager and dependency resolver",
  "source": "https://github.com/nektro/zigmod",
  "checks": [{ "type": "binary", "name": "zigmod" }],
  "install_guidance": {
    "plugin": "zigmod",
    "binary": "zigmod",
    "check": "which zigmod",
    "install_steps": ["zig build-exe src/main.zig", "Verify: zigmod --version", "supercli plugins install ./plugins/zigmod --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zigmod",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zigmod CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zigmod",
      "passthrough": true,
      "missingDependencyHelp": "Install zigmod: zig build-exe src/main.zig", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
