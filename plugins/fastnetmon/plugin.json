{
  "name": "fastnetmon",
  "version": "0.1.0",
  "description": "DDoS detection tool with sFlow, Netflow, IPFIX and port mirror support",
  "source": "https://github.com/pavel-odintsov/fastnetmon/",
  "checks": [
    {
      "type": "binary",
      "name": "fastnetmon"
    }
  ],
  "install_guidance": {
    "plugin": "fastnetmon",
    "binary": "fastnetmon",
    "check": "which fastnetmon",
    "install_steps": [
      "brew install fastnetmon",
      "Verify: fastnetmon --version",
      "supercli plugins install ./plugins/fastnetmon --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fastnetmon",
      "resource": "self",
      "action": "version",
      "description": "Print fastnetmon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastnetmon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastnetmon: brew install fastnetmon"
      },
      "args": []
    },
    {
      "namespace": "fastnetmon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastnetmon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastnetmon",
        "passthrough": true,
        "missingDependencyHelp": "Install fastnetmon"
      },
      "args": []
    }
  ]
}