{
  "name": "mono",
  "version": "0.1.0",
  "description": "Cross-platform .NET runtime",
  "source": "https://packages.debian.org/mono",
  "checks": [{ "type": "binary", "name": "mono" }],
  "install_guidance": {
    "plugin": "mono", "binary": "mono", "check": "which mono",
    "install_steps": ["apt-get install mono-complete", "Verify: mono --version", "supercli plugins install ./plugins/mono --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mono", "resource": "_", "action": "_",
    "description": "Passthrough to mono CLI",
    "adapter": "process", "adapterConfig": { "command": "mono", "passthrough": true, "missingDependencyHelp": "Install mono: apt-get install mono-complete" }, "args": []
  }]
}
