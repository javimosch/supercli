{
  "name": "gh-hype-scout",
  "version": "0.1.0",
  "description": "Terminal-first scout for discovering fast-rising GitHub repos with JSON export",
  "source": "https://github.com/agent19710101/gh-hype-scout",
  "checks": [
    {
      "type": "binary",
      "name": "gh-hype-scout"
    }
  ],
  "install_guidance": {
    "plugin": "gh-hype-scout",
    "binary": "gh-hype-scout",
    "check": "which gh-hype-scout",
    "install_steps": [
      "go install github.com/agent19710101/gh-hype-scout@latest",
      "Verify: gh-hype-scout --version",
      "supercli plugins install ./plugins/gh-hype-scout --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gh-hype-scout",
      "resource": "self",
      "action": "version",
      "description": "Print gh-hype-scout version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-hype-scout",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gh-hype-scout: go install github.com/agent19710101/gh-hype-scout@latest"
      },
      "args": []
    },
    {
      "namespace": "gh-hype-scout",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gh-hype-scout CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-hype-scout",
        "passthrough": true,
        "missingDependencyHelp": "Install gh-hype-scout: go install github.com/agent19710101/gh-hype-scout@latest"
      },
      "args": []
    }
  ]
}
