{
  "name": "GuitarPedal",
  "version": "0.1.0",
  "description": "Linus learns analog circuits",
  "source": "https://github.com/GuitarPedal/GuitarPedal",
  "checks": [
    {
      "type": "binary",
      "name": "guitarpedal"
    }
  ],
  "install_guidance": {
    "plugin": "GuitarPedal",
    "binary": "guitarpedal",
    "check": "which guitarpedal",
    "install_steps": [
      "pip install guitarpedal",
      "Verify: guitarpedal --version",
      "supercli plugins install ./plugins/GuitarPedal --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GuitarPedal",
      "resource": "self",
      "action": "version",
      "description": "Print GuitarPedal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "guitarpedal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GuitarPedal: pip install guitarpedal"
      },
      "args": []
    },
    {
      "namespace": "GuitarPedal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to guitarpedal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "guitarpedal",
        "passthrough": true,
        "missingDependencyHelp": "Install GuitarPedal: pip install guitarpedal"
      },
      "args": []
    }
  ]
}