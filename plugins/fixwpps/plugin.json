{
  "name": "fixwpps",
  "version": "0.1.0",
  "description": "CLI tool: fixwpps",
  "source": "https://manpages.debian.org/fixwpps",
  "checks": [
    {
      "type": "binary",
      "name": "fixwpps"
    }
  ],
  "install_guidance": {
    "plugin": "fixwpps",
    "binary": "fixwpps",
    "check": "which fixwpps",
    "install_steps": [
      "apt-get install fixwpps 2>/dev/null || which fixwpps",
      "Verify: fixwpps --version",
      "supercli plugins install ./plugins/fixwpps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixwpps",
      "resource": "self",
      "action": "version",
      "description": "Print fixwpps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixwpps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixwpps: apt-get install fixwpps 2>/dev/null || which fixwpps"
      },
      "args": []
    },
    {
      "namespace": "fixwpps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixwpps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixwpps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixwpps: apt-get install fixwpps 2>/dev/null || which fixwpps"
      },
      "args": []
    }
  ]
}