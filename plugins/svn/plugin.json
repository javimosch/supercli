{
  "name": "svn",
  "version": "0.1.0",
  "description": "Apache Subversion version control client",
  "source": "https",
  "checks": [{"type": "binary", "name": "svn"}],
  "install_guidance": {
    "plugin": "svn",
    "binary": "svn",
    "check": "which svn",
    "install_steps": [
      "brew install subversion",
      "Verify: svn --version",
      "supercli plugins install ./plugins/svn --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "svn",
      "resource": "self",
      "action": "version",
      "description": "Print svn version",
      "adapter": "process",
      "adapterConfig": {"command": "svn", "baseArgs": ["--version"], "missingDependencyHelp": "Install svn: brew install subversion"},
      "args": []
    },
    {
      "namespace": "svn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to svn CLI",
      "adapter": "process",
      "adapterConfig": {"command": "svn", "passthrough": true, "missingDependencyHelp": "Install svn: brew install subversion"},
      "args": []
    }
  ]
}
