{
  "name": "random-data-cli",
  "version": "0.1.0",
  "description": "Generate random mock datasets from the command line",
  "source": "https://github.com/mrmlnc/random-data-cli",
  "checks": [{ "type": "binary", "name": "random-data-cli" }],
  "install_guidance": {
    "plugin": "random-data-cli",
    "binary": "random-data-cli",
    "check": "which random-data-cli",
    "install_steps": ["npm install -g random-data-cli", "Verify: random-data-cli --version", "supercli plugins install ./plugins/random-data-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "random-data-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to random-data-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "random-data-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install random-data-cli: npm install -g random-data-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
