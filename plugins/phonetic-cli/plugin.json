{
  "name": "phonetic-cli",
  "version": "0.1.0",
  "description": "Convert text to NATO phonetic alphabet spelling",
  "source": "https://github.com/rnorth/phonetic-cli",
  "checks": [{ "type": "binary", "name": "phonetic-cli" }],
  "install_guidance": {
    "plugin": "phonetic-cli",
    "binary": "phonetic-cli",
    "check": "which phonetic-cli",
    "install_steps": ["pip install phonetic-cli", "Verify: phonetic-cli --version", "supercli plugins install ./plugins/phonetic-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "phonetic-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to phonetic-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "phonetic-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install phonetic-cli: pip install phonetic-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
