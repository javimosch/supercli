{
  "name": "sqlitekvstore",
  "version": "0.1.0",
  "description": "Key-value abstraction layer on top of SQLite database",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "sqlitekvstore" }],
  "install_guidance": {
    "plugin": "sqlitekvstore",
    "binary": "sqlitekvstore",
    "check": "which sqlitekvstore",
    "install_steps": ["pip install sqlitekvstore", "Verify: sqlitekvstore --version", "supercli plugins install ./plugins/sqlitekvstore --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sqlitekvstore",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sqlitekvstore CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sqlitekvstore",
      "passthrough": true,
      "missingDependencyHelp": "Install sqlitekvstore: pip install sqlitekvstore"
    },
    "args": []
  }]
}
