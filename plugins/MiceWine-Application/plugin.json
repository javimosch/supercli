{
  "name": "MiceWine-Application",
  "version": "0.1.0",
  "description": "MiceWine is a project that aims to run Windows applications and games on Android smartphones.",
  "source": "https://github.com/MiceWine-Application/MiceWine-Application",
  "checks": [
    {
      "type": "binary",
      "name": "micewine-application"
    }
  ],
  "install_guidance": {
    "plugin": "MiceWine-Application",
    "binary": "micewine-application",
    "check": "which micewine-application",
    "install_steps": [
      "pip install micewine-application",
      "Verify: micewine-application --version",
      "supercli plugins install ./plugins/MiceWine-Application --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MiceWine-Application",
      "resource": "self",
      "action": "version",
      "description": "Print MiceWine-Application version",
      "adapter": "process",
      "adapterConfig": {
        "command": "micewine-application",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MiceWine-Application: pip install micewine-application"
      },
      "args": []
    },
    {
      "namespace": "MiceWine-Application",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to micewine-application CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "micewine-application",
        "passthrough": true,
        "missingDependencyHelp": "Install MiceWine-Application: pip install micewine-application"
      },
      "args": []
    }
  ]
}