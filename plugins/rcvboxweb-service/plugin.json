{
  "name": "rcvboxweb-service",
  "version": "0.1.0",
  "description": "CLI tool: rcvboxweb-service",
  "source": "https://manpages.debian.org/rcvboxweb-service",
  "checks": [
    {
      "type": "binary",
      "name": "rcvboxweb-service"
    }
  ],
  "install_guidance": {
    "plugin": "rcvboxweb-service",
    "binary": "rcvboxweb-service",
    "check": "which rcvboxweb-service",
    "install_steps": [
      "apt-get install rcvboxweb-service 2>/dev/null || which rcvboxweb-service",
      "Verify: rcvboxweb-service --version",
      "supercli plugins install ./plugins/rcvboxweb-service --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rcvboxweb-service",
      "resource": "self",
      "action": "version",
      "description": "Print rcvboxweb-service version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcvboxweb-service",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rcvboxweb-service: apt-get install rcvboxweb-service 2>/dev/null || which rcvboxweb-service"
      },
      "args": []
    },
    {
      "namespace": "rcvboxweb-service",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rcvboxweb-service CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcvboxweb-service",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rcvboxweb-service: apt-get install rcvboxweb-service 2>/dev/null || which rcvboxweb-service"
      },
      "args": []
    }
  ]
}