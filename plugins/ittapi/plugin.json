{
  "name": "ittapi",
  "version": "0.1.0",
  "description": "Intel Instrumentation and Tracing Technology (ITT) and Just-In-Time (JIT) API",
  "source": "https://github.com/intel/ittapi",
  "checks": [
    {
      "type": "binary",
      "name": "ittapi"
    }
  ],
  "install_guidance": {
    "plugin": "ittapi",
    "binary": "ittapi",
    "check": "which ittapi",
    "install_steps": [
      "brew install ittapi",
      "Verify: ittapi --version",
      "supercli plugins install ./plugins/ittapi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ittapi",
      "resource": "self",
      "action": "version",
      "description": "Print ittapi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ittapi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ittapi: brew install ittapi"
      },
      "args": []
    },
    {
      "namespace": "ittapi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ittapi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ittapi",
        "passthrough": true,
        "missingDependencyHelp": "Install ittapi"
      },
      "args": []
    }
  ]
}