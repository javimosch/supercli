{
  "name": "get-port-cli",
  "version": "0.1.0",
  "description": "Get an available port",
  "source": "https://github.com/sindresorhus/get-port-cli",
  "checks": [
    {
      "type": "binary",
      "name": "get-port-cli"
    }
  ],
  "install_guidance": {
    "plugin": "get-port-cli",
    "binary": "get-port-cli",
    "check": "which get-port-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/get-port-cli",
      "Verify: get-port-cli --version",
      "supercli plugins install ./plugins/get-port-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "get-port-cli",
      "resource": "self",
      "action": "version",
      "description": "Print get-port-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-port-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install get-port-cli: See https://github.com/sindresorhus/get-port-cli"
      },
      "args": []
    },
    {
      "namespace": "get-port-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to get-port-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-port-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install get-port-cli"
      },
      "args": []
    }
  ]
}