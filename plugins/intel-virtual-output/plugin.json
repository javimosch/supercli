{
  "name": "intel-virtual-output",
  "version": "0.1.0",
  "description": "CLI tool: intel-virtual-output",
  "source": "https://manpages.debian.org/intel-virtual-output",
  "checks": [
    {
      "type": "binary",
      "name": "intel-virtual-output"
    }
  ],
  "install_guidance": {
    "plugin": "intel-virtual-output",
    "binary": "intel-virtual-output",
    "check": "which intel-virtual-output",
    "install_steps": [
      "apt-get install intel-virtual-output 2>/dev/null || which intel-virtual-output",
      "Verify: intel-virtual-output --version",
      "supercli plugins install ./plugins/intel-virtual-output --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "intel-virtual-output",
      "resource": "self",
      "action": "version",
      "description": "Print intel-virtual-output version",
      "adapter": "process",
      "adapterConfig": {
        "command": "intel-virtual-output",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install intel-virtual-output: apt-get install intel-virtual-output 2>/dev/null || which intel-virtual-output"
      },
      "args": []
    },
    {
      "namespace": "intel-virtual-output",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to intel-virtual-output CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "intel-virtual-output",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install intel-virtual-output: apt-get install intel-virtual-output 2>/dev/null || which intel-virtual-output"
      },
      "args": []
    }
  ]
}