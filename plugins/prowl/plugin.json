{
  "name": "prowl",
  "version": "0.1.0",
  "description": "Single-binary CLI for tracking GitHub PRs — non-interactive list with --json for agents",
  "source": "https://github.com/figarocorso/prowl",
  "checks": [
    {
      "type": "binary",
      "name": "prowl"
    }
  ],
  "install_guidance": {
    "plugin": "prowl",
    "binary": "prowl",
    "check": "which prowl",
    "install_steps": [
      "go install github.com/figarocorso/prowl@latest",
      "Verify: prowl --version",
      "supercli plugins install ./plugins/prowl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "prowl",
      "resource": "self",
      "action": "version",
      "description": "Print prowl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "prowl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install prowl: go install github.com/figarocorso/prowl@latest"
      },
      "args": []
    },
    {
      "namespace": "prowl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to prowl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "prowl",
        "passthrough": true,
        "missingDependencyHelp": "Install prowl: go install github.com/figarocorso/prowl@latest"
      },
      "args": []
    }
  ]
}
