{
  "name": "brew",
  "version": "0.1.0",
  "description": "Homebrew — macOS package manager for installing, updating, and managing open-source software packages",
  "source": "https://brew.sh",
  "checks": [
    {
      "type": "binary",
      "name": "brew"
    }
  ],
  "install_guidance": {
    "plugin": "brew",
    "binary": "brew",
    "check": "which brew",
    "install_steps": [
      "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"",
      "Verify: brew --version",
      "supercli plugins install ./plugins/brew --on-conflict replace --json"
    ],
    "note": "Homebrew is the standard package manager for macOS. Also available on Linux via linuxbrew."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "brew",
      "resource": "self",
      "action": "version",
      "description": "Print Homebrew version",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": []
    },
    {
      "namespace": "brew",
      "resource": "package",
      "action": "install",
      "description": "Install a formula or cask",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["install"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": [
        {
          "name": "formula",
          "type": "string",
          "description": "Formula or cask name to install",
          "positional": true
        },
        {
          "name": "cask",
          "type": "boolean",
          "description": "Treat all named arguments as casks",
          "flag": "--cask"
        }
      ]
    },
    {
      "namespace": "brew",
      "resource": "package",
      "action": "uninstall",
      "description": "Uninstall a formula or cask",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["uninstall"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": [
        {
          "name": "formula",
          "type": "string",
          "description": "Formula or cask name to uninstall",
          "positional": true
        }
      ]
    },
    {
      "namespace": "brew",
      "resource": "package",
      "action": "info",
      "description": "Display information about a formula or cask",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["info"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": [
        {
          "name": "formula",
          "type": "string",
          "description": "Formula or cask name",
          "positional": true
        },
        {
          "name": "json",
          "type": "boolean",
          "description": "Output in JSON format",
          "flag": "--json"
        }
      ]
    },
    {
      "namespace": "brew",
      "resource": "self",
      "action": "update",
      "description": "Fetch the newest version of Homebrew and all formulae",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["update"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": []
    },
    {
      "namespace": "brew",
      "resource": "package",
      "action": "upgrade",
      "description": "Upgrade outdated casks and unpinned formulae",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["upgrade"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": [
        {
          "name": "formula",
          "type": "string",
          "description": "Formula or cask to upgrade (omit to upgrade all)",
          "positional": true
        }
      ]
    },
    {
      "namespace": "brew",
      "resource": "package",
      "action": "list",
      "description": "List all installed formulae and casks",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["list"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": [
        {
          "name": "formula",
          "type": "string",
          "description": "Formula or cask name to list files for",
          "positional": true
        },
        {
          "name": "cask",
          "type": "boolean",
          "description": "Only list casks",
          "flag": "--cask"
        },
        {
          "name": "formula-filter",
          "type": "boolean",
          "description": "Only list formulae",
          "flag": "--formula"
        }
      ]
    },
    {
      "namespace": "brew",
      "resource": "package",
      "action": "search",
      "description": "Search for available formulae and casks",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["search"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": [
        {
          "name": "query",
          "type": "string",
          "description": "Search term",
          "positional": true
        }
      ]
    },
    {
      "namespace": "brew",
      "resource": "self",
      "action": "doctor",
      "description": "Check your system for potential problems",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["doctor"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": []
    },
    {
      "namespace": "brew",
      "resource": "self",
      "action": "cleanup",
      "description": "Remove stale lock files and outdated downloads",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["cleanup"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": [
        {
          "name": "dry-run",
          "type": "boolean",
          "description": "Show what would be removed without actually removing",
          "flag": "--dry-run"
        }
      ]
    },
    {
      "namespace": "brew",
      "resource": "package",
      "action": "outdated",
      "description": "List installed formulae and casks with available updates",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "baseArgs": ["outdated"],
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": []
    },
    {
      "namespace": "brew",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Homebrew CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew",
        "passthrough": true,
        "missingDependencyHelp": "Install Homebrew: https://brew.sh"
      },
      "args": []
    }
  ]
}
