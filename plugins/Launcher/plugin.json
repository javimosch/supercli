{
  "name": "Launcher",
  "version": "0.1.0",
  "description": "Firmware Launcher for ESP32 boards like: M5Stack, Lilygo, Marauder and CYD devices.",
  "source": "https://github.com/Launcher/Launcher",
  "checks": [
    {
      "type": "binary",
      "name": "launcher"
    }
  ],
  "install_guidance": {
    "plugin": "Launcher",
    "binary": "launcher",
    "check": "which launcher",
    "install_steps": [
      "pip install launcher",
      "Verify: launcher --version",
      "supercli plugins install ./plugins/Launcher --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Launcher",
      "resource": "self",
      "action": "version",
      "description": "Print Launcher version",
      "adapter": "process",
      "adapterConfig": {
        "command": "launcher",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Launcher: pip install launcher"
      },
      "args": []
    },
    {
      "namespace": "Launcher",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to launcher CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "launcher",
        "passthrough": true,
        "missingDependencyHelp": "Install Launcher: pip install launcher"
      },
      "args": []
    }
  ]
}