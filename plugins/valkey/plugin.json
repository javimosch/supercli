{
  "name": "valkey",
  "version": "0.1.0",
  "description": "A flexible distributed key-value database that is optimized for caching and other realtime workloads",
  "source": "https://github.com/valkey/valkey",
  "checks": [
    {
      "type": "binary",
      "name": "valkey"
    }
  ],
  "install_guidance": {
    "plugin": "valkey",
    "binary": "valkey",
    "check": "which valkey",
    "install_steps": [
      "pip install valkey",
      "Verify: valkey --version",
      "supercli plugins install ./plugins/valkey --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "valkey",
      "resource": "self",
      "action": "version",
      "description": "Print valkey version",
      "adapter": "process",
      "adapterConfig": {
        "command": "valkey",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install valkey: pip install valkey"
      },
      "args": []
    },
    {
      "namespace": "valkey",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to valkey CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "valkey",
        "passthrough": true,
        "missingDependencyHelp": "Install valkey: pip install valkey"
      },
      "args": []
    }
  ]
}