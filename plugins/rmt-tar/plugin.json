{
  "name": "rmt-tar",
  "version": "0.1.0",
  "description": "CLI tool: rmt-tar",
  "source": "https://manpages.debian.org/rmt-tar",
  "checks": [
    {
      "type": "binary",
      "name": "rmt-tar"
    }
  ],
  "install_guidance": {
    "plugin": "rmt-tar",
    "binary": "rmt-tar",
    "check": "which rmt-tar",
    "install_steps": [
      "apt-get install rmt-tar 2>/dev/null || which rmt-tar",
      "Verify: rmt-tar --version",
      "supercli plugins install ./plugins/rmt-tar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rmt-tar",
      "resource": "self",
      "action": "version",
      "description": "Print rmt-tar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rmt-tar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rmt-tar: apt-get install rmt-tar 2>/dev/null || which rmt-tar"
      },
      "args": []
    },
    {
      "namespace": "rmt-tar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rmt-tar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rmt-tar",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rmt-tar: apt-get install rmt-tar 2>/dev/null || which rmt-tar"
      },
      "args": []
    }
  ]
}