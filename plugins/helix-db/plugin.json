{
  "name": "helix-db",
  "version": "0.1.0",
  "description": "HelixDB is an open-source graph-vector database built from scratch in Rust.",
  "source": "https://github.com/helix-db/helix-db",
  "checks": [
    {
      "type": "binary",
      "name": "helix-db"
    }
  ],
  "install_guidance": {
    "plugin": "helix-db",
    "binary": "helix-db",
    "check": "which helix-db",
    "install_steps": [
      "pip install helix-db",
      "Verify: helix-db --version",
      "supercli plugins install ./plugins/helix-db --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "helix-db",
      "resource": "self",
      "action": "version",
      "description": "Print helix-db version",
      "adapter": "process",
      "adapterConfig": {
        "command": "helix-db",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install helix-db: pip install helix-db"
      },
      "args": []
    },
    {
      "namespace": "helix-db",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to helix-db CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "helix-db",
        "passthrough": true,
        "missingDependencyHelp": "Install helix-db: pip install helix-db"
      },
      "args": []
    }
  ]
}