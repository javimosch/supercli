{
  "name": "generate-json-schema",
  "version": "0.1.0",
  "description": "Generate a JSON Schema from Sample JSON",
  "source": "https://github.com/Nijikokun/generate-schema",
  "checks": [
    {
      "type": "binary",
      "name": "generate-json-schema"
    }
  ],
  "install_guidance": {
    "plugin": "generate-json-schema",
    "binary": "generate-json-schema",
    "check": "which generate-json-schema",
    "install_steps": [
      "brew install generate-json-schema",
      "Verify: generate-json-schema --version",
      "supercli plugins install ./plugins/generate-json-schema --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "generate-json-schema",
      "resource": "self",
      "action": "version",
      "description": "Print generate-json-schema version",
      "adapter": "process",
      "adapterConfig": {
        "command": "generate-json-schema",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install generate-json-schema: brew install generate-json-schema"
      },
      "args": []
    },
    {
      "namespace": "generate-json-schema",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to generate-json-schema CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "generate-json-schema",
        "passthrough": true,
        "missingDependencyHelp": "Install generate-json-schema"
      },
      "args": []
    }
  ]
}