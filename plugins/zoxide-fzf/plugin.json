{
  "name": "zoxide-fzf",
  "version": "0.1.0",
  "description": "Smarter cd command with fuzzy finding integration",
  "source": "https://github.com/ajeetdsouza/zoxide",
  "checks": [{ "type": "binary", "name": "zoxide" }],
  "install_guidance": {
    "plugin": "zoxide-fzf",
    "binary": "zoxide",
    "check": "which zoxide",
    "install_steps": ["cargo install zoxide", "Verify: zoxide --version", "supercli plugins install ./plugins/zoxide-fzf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zoxide-fzf",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zoxide CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zoxide",
      "passthrough": true,
      "missingDependencyHelp": "Install zoxide-fzf: cargo install zoxide"
    },
    "args": []
  }]
}
