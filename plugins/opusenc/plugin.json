{
  "name": "opusenc",
  "version": "1.0.0",
  "description": "opusenc \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=opusenc+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "opusenc"
    }
  ],
  "install_guidance": {
    "plugin": "opusenc",
    "binary": "opusenc",
    "check": "which opusenc",
    "install_steps": [
      "Install opusenc via package manager: apt install opusenc or brew install opusenc"
    ]
  },
  "commands": [
    {
      "namespace": "opusenc",
      "resource": "run",
      "action": "exec",
      "description": "opusenc \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "opusenc",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install opusenc via your package manager"
      },
      "args": []
    }
  ]
}