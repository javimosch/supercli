{
  "name": "dee-stash",
  "version": "0.1.0",
  "description": "Read-later manager from the command line with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-stash" }],
  "install_guidance": {
    "plugin": "dee-stash",
    "binary": "dee-stash",
    "check": "which dee-stash",
    "install_steps": ["cargo install dee-stash", "Verify: dee-stash --version", "supercli plugins install ./plugins/dee-stash --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-stash",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-stash CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-stash",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-stash: cargo install dee-stash"
    },
    "args": []
  }]
}
