{
  "name": "EeveeSpotifyReborn",
  "version": "0.1.0",
  "description": "A tweak to enhance Spotify experience",
  "source": "https://github.com/EeveeSpotifyReborn/EeveeSpotifyReborn",
  "checks": [
    {
      "type": "binary",
      "name": "eeveespotifyreborn"
    }
  ],
  "install_guidance": {
    "plugin": "EeveeSpotifyReborn",
    "binary": "eeveespotifyreborn",
    "check": "which eeveespotifyreborn",
    "install_steps": [
      "pip install eeveespotifyreborn",
      "Verify: eeveespotifyreborn --version",
      "supercli plugins install ./plugins/EeveeSpotifyReborn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "EeveeSpotifyReborn",
      "resource": "self",
      "action": "version",
      "description": "Print EeveeSpotifyReborn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eeveespotifyreborn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install EeveeSpotifyReborn: pip install eeveespotifyreborn"
      },
      "args": []
    },
    {
      "namespace": "EeveeSpotifyReborn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eeveespotifyreborn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eeveespotifyreborn",
        "passthrough": true,
        "missingDependencyHelp": "Install EeveeSpotifyReborn: pip install eeveespotifyreborn"
      },
      "args": []
    }
  ]
}