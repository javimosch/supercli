{
  "name": "asymptote",
  "version": "0.1.0",
  "description": "Vector graphics language for technical drawings",
  "source": "https://github.com/vectorgraphics/asymptote",
  "checks": [
    {
      "type": "binary",
      "name": "asymptote"
    }
  ],
  "install_guidance": {
    "plugin": "asymptote",
    "binary": "asymptote",
    "check": "which asymptote",
    "install_steps": [
      "brew install asymptote",
      "Verify: asymptote --version",
      "supercli plugins install ./plugins/asymptote --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "asymptote",
      "resource": "self",
      "action": "version",
      "description": "Print asymptote version",
      "adapter": "process",
      "adapterConfig": {
        "command": "asymptote",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install asymptote: brew install asymptote"
      },
      "args": []
    },
    {
      "namespace": "asymptote",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to asymptote CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "asymptote",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install asymptote: brew install asymptote"
      },
      "args": []
    }
  ]
}
