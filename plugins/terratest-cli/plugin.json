{
  "name": "terratest-cli",
  "version": "0.1.0",
  "description": "CLI wrapper for Terratest infrastructure testing",
  "source": "https://github.com/gruntwork-io/terratest-cli",
  "checks": [{ "type": "binary", "name": "terratest-cli" }],
  "install_guidance": {
    "plugin": "terratest-cli",
    "binary": "terratest-cli",
    "check": "which terratest-cli",
    "install_steps": ["go install github.com/gruntwork-io/terratest-cli@latest", "Verify: terratest-cli --version", "supercli plugins install ./plugins/terratest-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terratest-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terratest-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terratest-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install terratest-cli: go install github.com/gruntwork-io/terratest-cli@latest"
    },
    "args": []
  }]
}
