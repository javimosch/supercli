{
  "name": "innotop",
  "version": "0.1.0",
  "description": "Top clone for MySQL",
  "source": "https://github.com/innotop/innotop/",
  "checks": [
    {
      "type": "binary",
      "name": "innotop"
    }
  ],
  "install_guidance": {
    "plugin": "innotop",
    "binary": "innotop",
    "check": "which innotop",
    "install_steps": [
      "brew install innotop",
      "Verify: innotop --version",
      "supercli plugins install ./plugins/innotop --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "innotop",
      "resource": "self",
      "action": "version",
      "description": "Print innotop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "innotop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install innotop: brew install innotop"
      },
      "args": []
    },
    {
      "namespace": "innotop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to innotop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "innotop",
        "passthrough": true,
        "missingDependencyHelp": "Install innotop"
      },
      "args": []
    }
  ]
}