{
  "name": "highlight",
  "version": "0.1.0",
  "description": "Convert source code to formatted text with syntax highlighting",
  "checks": [
    {
      "type": "binary",
      "name": "highlight"
    }
  ],
  "install_guidance": {
    "plugin": "highlight",
    "binary": "highlight",
    "check": "which highlight",
    "install_steps": [
      "brew install highlight",
      "Verify: highlight --version",
      "supercli plugins install ./plugins/highlight --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "highlight",
      "resource": "self",
      "action": "version",
      "description": "Print highlight version",
      "adapter": "process",
      "adapterConfig": {
        "command": "highlight",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install highlight: brew install highlight"
      },
      "args": []
    },
    {
      "namespace": "highlight",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to highlight CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "highlight",
        "passthrough": true,
        "missingDependencyHelp": "Install highlight"
      },
      "args": []
    }
  ]
}