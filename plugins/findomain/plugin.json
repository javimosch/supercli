{
  "name": "findomain",
  "version": "1.0.0",
  "description": "findomain \u2014 Subdomain finder",
  "source": "github.com/Findomain/Findomain",
  "checks": [
    {
      "type": "binary",
      "name": "findomain"
    }
  ],
  "install_guidance": {
    "plugin": "findomain",
    "binary": "findomain",
    "check": "which findomain",
    "install_steps": [
      "# Install findomain",
      "# See github.com/Findomain/Findomain",
      "# apt: sudo apt-get install findomain",
      "# brew: brew install findomain",
      "# cargo: cargo install findomain",
      "# npm: npm install -g findomain",
      "# pip: pip install findomain"
    ]
  },
  "commands": [
    {
      "namespace": "findomain",
      "resource": "findomain",
      "action": "run",
      "description": "Run findomain",
      "adapter": "process",
      "adapterConfig": {
        "command": "findomain",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install findomain from github.com/Findomain/Findomain"
      },
      "args": []
    }
  ]
}