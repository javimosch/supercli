{
  "name": "docker-squash",
  "version": "0.1.0",
  "description": "Docker image squashing tool",
  "source": "https://github.com/goldmann/docker-squash",
  "checks": [
    {
      "type": "binary",
      "name": "docker-squash"
    }
  ],
  "install_guidance": {
    "plugin": "docker-squash",
    "binary": "docker-squash",
    "check": "which docker-squash",
    "install_steps": [
      "brew install docker-squash",
      "Verify: docker-squash --version",
      "supercli plugins install ./plugins/docker-squash --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "docker-squash",
      "resource": "self",
      "action": "version",
      "description": "Print docker-squash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-squash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-squash: brew install docker-squash"
      },
      "args": []
    },
    {
      "namespace": "docker-squash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-squash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-squash",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-squash"
      },
      "args": []
    }
  ]
}