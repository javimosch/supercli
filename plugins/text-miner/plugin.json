{
  "name": "text-miner",
  "version": "0.1.0",
  "description": "Basic term frequency and text analysis CLI tool",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "text-miner" }],
  "install_guidance": {
    "plugin": "text-miner",
    "binary": "text-miner",
    "check": "which text-miner",
    "install_steps": ["npm install -g text-miner", "Verify: text-miner --version", "supercli plugins install ./plugins/text-miner --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "text-miner",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to text-miner CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "text-miner",
      "passthrough": true,
      "missingDependencyHelp": "Install text-miner: npm install -g text-miner"
    },
    "args": []
  }]
}
