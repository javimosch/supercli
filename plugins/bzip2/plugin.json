{
  "name": "bzip2",
  "version": "0.1.0",
  "description": "High-quality file compression utility",
  "source": "https",
  "checks": [{"type": "binary", "name": "bzip2"}],
  "install_guidance": {
    "plugin": "bzip2",
    "binary": "bzip2",
    "check": "which bzip2",
    "install_steps": [
      "brew install bzip2",
      "Verify: bzip2 --version",
      "supercli plugins install ./plugins/bzip2 --on-conflict replace --json"
    ]
