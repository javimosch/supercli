      "adapterConfig": {"command": "bzip2", "baseArgs": ["--version"], "missingDependencyHelp": "Install bzip2: brew install bzip2"},
      "args": []
    },
    {
      "namespace": "bzip2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bzip2 CLI",
      "adapter": "process",
      "adapterConfig": {"command": "bzip2", "passthrough": true, "missingDependencyHelp": "Install bzip2: brew install bzip2"},
      "args": []
    }
  ]
