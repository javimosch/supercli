{
  "name": "cloudformation-guard",
  "version": "0.1.0",
  "description": "Checks CloudFormation templates for compliance using a declarative syntax",
  "source": "https://github.com/aws-cloudformation/cloudformation-guard",
  "checks": [
    {
      "type": "binary",
      "name": "cloudformation-guard"
    }
  ],
  "install_guidance": {
    "plugin": "cloudformation-guard",
    "binary": "cloudformation-guard",
    "check": "which cloudformation-guard",
    "install_steps": [
      "brew install cloudformation-guard",
      "Verify: cloudformation-guard --version",
      "supercli plugins install ./plugins/cloudformation-guard --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cloudformation-guard",
      "resource": "self",
      "action": "version",
      "description": "Print cloudformation-guard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudformation-guard",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cloudformation-guard: brew install cloudformation-guard"
      },
      "args": []
    },
    {
      "namespace": "cloudformation-guard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cloudformation-guard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudformation-guard",
        "passthrough": true,
        "missingDependencyHelp": "Install cloudformation-guard"
      },
      "args": []
    }
  ]
}