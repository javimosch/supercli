{
  "name": "chardetect",
  "version": "0.1.0",
  "description": "chardetect — Universal Character Encoding Detector (Python3)",
  "source": "https://github.com/chardet/chardet",
  "checks": [{ "type": "binary", "name": "chardetect" }],
  "install_guidance": {
    "plugin": "chardetect", "binary": "chardetect", "check": "which chardetect",
    "install_steps": ["apt-get install python3-chardet 2>/dev/null || which chardetect", "Verify: chardetect --version", "supercli plugins install ./plugins/chardetect --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "chardetect", "resource": "_", "action": "_",
    "description": "Passthrough to chardetect CLI",
    "adapter": "process", "adapterConfig": { "command": "chardetect", "passthrough": true, "missingDependencyHelp": "Install chardetect: apt-get install python3-chardet" }, "args": []
  }]
}
