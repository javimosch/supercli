{
  "name": "bump2version",
  "version": "0.1.0",
  "description": "Version-bump your Python software easily",
  "source": "https://github.com/c4urself/bump2version",
  "checks": [{ "type": "binary", "name": "bump2version" }],
  "install_guidance": {
    "plugin": "bump2version",
    "binary": "bump2version",
    "check": "which bump2version",
    "install_steps": ["pip install bump2version", "Verify: bump2version --version", "supercli plugins install ./plugins/bump2version --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bump2version",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bump2version CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bump2version",
      "passthrough": true,
      "missingDependencyHelp": "Install bump2version: pip install bump2version", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
