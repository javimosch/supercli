{
  "name": "watcher",
  "version": "0.1.0",
  "description": "Watches all the files present in a directory and whenever a file is changed or a file is created/deleted from the directory, it runs a specified command.",
  "source": "https://github.com/sethigeet/watcher",
  "checks": [
    {
      "type": "binary",
      "name": "watcher"
    }
  ],
  "install_guidance": {
    "plugin": "watcher",
    "binary": "watcher",
    "check": "which watcher",
    "install_steps": [
      "brew install watcher",
      "Verify: watcher --version",
      "supercli plugins install ./plugins/watcher --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "watcher",
      "resource": "self",
      "action": "version",
      "description": "Print watcher version",
      "adapter": "process",
      "adapterConfig": {
        "command": "watcher",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install watcher: brew install watcher"
      },
      "args": []
    },
    {
      "namespace": "watcher",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to watcher CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "watcher",
        "passthrough": true,
        "missingDependencyHelp": "Install watcher"
      },
      "args": []
    }
  ]
}