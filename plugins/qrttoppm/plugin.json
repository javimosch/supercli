{
  "name": "qrttoppm",
  "version": "0.1.0",
  "description": "CLI tool: qrttoppm",
  "source": "https://manpages.debian.org/qrttoppm",
  "checks": [
    {
      "type": "binary",
      "name": "qrttoppm"
    }
  ],
  "install_guidance": {
    "plugin": "qrttoppm",
    "binary": "qrttoppm",
    "check": "which qrttoppm",
    "install_steps": [
      "apt-get install qrttoppm 2>/dev/null || which qrttoppm",
      "Verify: qrttoppm --version",
      "supercli plugins install ./plugins/qrttoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qrttoppm",
      "resource": "self",
      "action": "version",
      "description": "Print qrttoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qrttoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qrttoppm: apt-get install qrttoppm 2>/dev/null || which qrttoppm"
      },
      "args": []
    },
    {
      "namespace": "qrttoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qrttoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qrttoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qrttoppm: apt-get install qrttoppm 2>/dev/null || which qrttoppm"
      },
      "args": []
    }
  ]
}