{
  "name": "Xed-Editor",
  "version": "0.1.0",
  "description": "Advanced Text Editor for Android ",
  "source": "https://github.com/Xed-Editor/Xed-Editor",
  "checks": [
    {
      "type": "binary",
      "name": "xed-editor"
    }
  ],
  "install_guidance": {
    "plugin": "Xed-Editor",
    "binary": "xed-editor",
    "check": "which xed-editor",
    "install_steps": [
      "pip install xed-editor",
      "Verify: xed-editor --version",
      "supercli plugins install ./plugins/Xed-Editor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Xed-Editor",
      "resource": "self",
      "action": "version",
      "description": "Print Xed-Editor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xed-editor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Xed-Editor: pip install xed-editor"
      },
      "args": []
    },
    {
      "namespace": "Xed-Editor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xed-editor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xed-editor",
        "passthrough": true,
        "missingDependencyHelp": "Install Xed-Editor: pip install xed-editor"
      },
      "args": []
    }
  ]
}