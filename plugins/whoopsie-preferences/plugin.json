{
  "name": "whoopsie-preferences",
  "version": "0.1.0",
  "description": "CLI tool: whoopsie-preferences",
  "source": "https://manpages.debian.org/whoopsie-preferences",
  "checks": [
    {
      "type": "binary",
      "name": "whoopsie-preferences"
    }
  ],
  "install_guidance": {
    "plugin": "whoopsie-preferences",
    "binary": "whoopsie-preferences",
    "check": "which whoopsie-preferences",
    "install_steps": [
      "apt-get install whoopsie-preferences 2>/dev/null || which whoopsie-preferences",
      "Verify: whoopsie-preferences --version",
      "supercli plugins install ./plugins/whoopsie-preferences --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "whoopsie-preferences",
      "resource": "self",
      "action": "version",
      "description": "Print whoopsie-preferences version",
      "adapter": "process",
      "adapterConfig": {
        "command": "whoopsie-preferences",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install whoopsie-preferences: apt-get install whoopsie-preferences 2>/dev/null || which whoopsie-preferences"
      },
      "args": []
    },
    {
      "namespace": "whoopsie-preferences",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to whoopsie-preferences CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "whoopsie-preferences",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install whoopsie-preferences: apt-get install whoopsie-preferences 2>/dev/null || which whoopsie-preferences"
      },
      "args": []
    }
  ]
}