{
  "name": "git-when-merged",
  "version": "0.1.0",
  "description": "git-when-merged — find when a commit was merged into git history",
  "source": "https://github.com/mhagger/git-when-merged",
  "checks": [
    {
      "type": "binary",
      "name": "git-when-merged"
    }
  ],
  "install_guidance": {
    "plugin": "git-when-merged",
    "binary": "git-when-merged",
    "check": "which git-when-merged",
    "install_steps": [
      "pip install git-when-merged",
      "Verify: git-when-merged --version",
      "supercli plugins install ./plugins/git-when-merged --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "git-when-merged",
      "resource": "self",
      "action": "version",
      "description": "Print git-when-merged version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-when-merged",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-when-merged: pip install git-when-merged"
      },
      "args": []
    },
    {
      "namespace": "git-when-merged",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-when-merged CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-when-merged",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install git-when-merged: pip install git-when-merged"
      },
      "args": []
    }
  ]
}
