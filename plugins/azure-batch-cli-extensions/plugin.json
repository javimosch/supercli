{
  "name": "azure-batch-cli-extensions",
  "version": "0.1.0",
  "description": "Batch extension cli commands for Azure cli v2",
  "source": "https://github.com/azure-batch-cli-extensions/azure-batch-cli-extensions",
  "checks": [
    {
      "type": "binary",
      "name": "azure-batch-cli-extensions"
    }
  ],
  "install_guidance": {
    "plugin": "azure-batch-cli-extensions",
    "binary": "azure-batch-cli-extensions",
    "check": "which azure-batch-cli-extensions",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: azure-batch-cli-extensions --version",
      "supercli plugins install ./plugins/azure-batch-cli-extensions --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "azure-batch-cli-extensions",
      "resource": "self",
      "action": "version",
      "description": "Print azure-batch-cli-extensions version",
      "adapter": "process",
      "adapterConfig": {
        "command": "azure-batch-cli-extensions",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install azure-batch-cli-extensions from project repository"
      },
      "args": []
    },
    {
      "namespace": "azure-batch-cli-extensions",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to azure-batch-cli-extensions CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "azure-batch-cli-extensions",
        "passthrough": true,
        "missingDependencyHelp": "Install azure-batch-cli-extensions from project repository"
      },
      "args": []
    }
  ]
}