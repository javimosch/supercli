{
  "name": "drawio-cli",
  "version": "0.1.0",
  "description": "Export and convert draw.io diagrams from command line",
  "source": "https://github.com/rlespinasse/drawio-export",
  "checks": [{ "type": "binary", "name": "drawio-cli" }],
  "install_guidance": {
    "plugin": "drawio-cli",
    "binary": "drawio-cli",
    "check": "which drawio-cli",
    "install_steps": ["npm install -g drawio-cli", "Verify: drawio-cli --version", "supercli plugins install ./plugins/drawio-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "drawio-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to drawio-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "drawio-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install drawio-cli: npm install -g drawio-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
