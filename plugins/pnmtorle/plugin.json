{
  "name": "pnmtorle",
  "version": "0.1.0",
  "description": "CLI tool: pnmtorle",
  "source": "https://manpages.debian.org/pnmtorle",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtorle"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtorle",
    "binary": "pnmtorle",
    "check": "which pnmtorle",
    "install_steps": [
      "apt-get install pnmtorle 2>/dev/null || which pnmtorle",
      "Verify: pnmtorle --version",
      "supercli plugins install ./plugins/pnmtorle --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtorle",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtorle version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtorle",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtorle: apt-get install pnmtorle 2>/dev/null || which pnmtorle"
      },
      "args": []
    },
    {
      "namespace": "pnmtorle",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtorle CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtorle",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtorle: apt-get install pnmtorle 2>/dev/null || which pnmtorle"
      },
      "args": []
    }
  ]
}