{
  "name": "fb303",
  "version": "0.1.0",
  "description": "Thrift functions for querying information from a service",
  "source": "https://github.com/facebook/fb303",
  "checks": [
    {
      "type": "binary",
      "name": "fb303"
    }
  ],
  "install_guidance": {
    "plugin": "fb303",
    "binary": "fb303",
    "check": "which fb303",
    "install_steps": [
      "brew install fb303",
      "Verify: fb303 --version",
      "supercli plugins install ./plugins/fb303 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fb303",
      "resource": "self",
      "action": "version",
      "description": "Print fb303 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fb303",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fb303: brew install fb303"
      },
      "args": []
    },
    {
      "namespace": "fb303",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fb303 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fb303",
        "passthrough": true,
        "missingDependencyHelp": "Install fb303"
      },
      "args": []
    }
  ]
}