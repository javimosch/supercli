{
  "name": "burn",
  "version": "0.1.0",
  "description": "Kubernetes budget monitoring",
  "source": "https://github.com/helm/burn",
  "checks": [
    {
      "type": "binary",
      "name": "burn"
    }
  ],
  "install_guidance": {
    "plugin": "burn",
    "binary": "burn",
    "check": "which burn",
    "install_steps": [
      "go install github.com/helm/burn@latest",
      "Verify: burn --version",
      "supercli plugins install ./plugins/burn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "burn",
      "resource": "self",
      "action": "version",
      "description": "Print burn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "burn",
        "missingDependencyHelp": "Install burn: go install github.com/helm/burn@latest",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "burn",
      "resource": "budget",
      "action": "list",
      "description": "List Kubernetes budgets",
      "adapter": "process",
      "adapterConfig": {
        "command": "burn",
        "missingDependencyHelp": "Install burn: go install github.com/helm/burn@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "burn",
      "resource": "budget",
      "action": "check",
      "description": "Check budget consumption status",
      "adapter": "process",
      "adapterConfig": {
        "command": "burn",
        "missingDependencyHelp": "Install burn: go install github.com/helm/burn@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "burn",
      "resource": "budget",
      "action": "set",
      "description": "Set a budget for a namespace",
      "adapter": "process",
      "adapterConfig": {
        "command": "burn",
        "missingDependencyHelp": "Install burn: go install github.com/helm/burn@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "burn",
      "resource": "_",
      "action": "_",
      "description": "_ _ via burn",
      "adapter": "process",
      "adapterConfig": {
        "command": "burn",
        "missingDependencyHelp": "Install burn: go install github.com/helm/burn@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
