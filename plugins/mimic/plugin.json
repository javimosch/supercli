{
  "name": "mimic",
  "version": "0.1.0",
  "description": "Open-source text-to-speech engine based on Flite with CLI",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "mimic" }],
  "install_guidance": {
    "plugin": "mimic",
    "binary": "mimic",
    "check": "which mimic",
    "install_steps": ["git clone && ./configure && make", "Verify: mimic --version", "supercli plugins install ./plugins/mimic --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mimic",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mimic CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mimic",
      "passthrough": true,
      "missingDependencyHelp": "Install mimic: git clone && ./configure && make"
    },
    "args": []
  }]
}
