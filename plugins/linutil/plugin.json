{
  "name": "linutil",
  "version": "0.1.0",
  "description": "Chris Titus Tech's Linux Toolbox - Linutil is a distro-agnostic toolbox designed to simplify everyda",
  "source": "https://github.com/linutil/linutil",
  "checks": [
    {
      "type": "binary",
      "name": "linutil"
    }
  ],
  "install_guidance": {
    "plugin": "linutil",
    "binary": "linutil",
    "check": "which linutil",
    "install_steps": [
      "pip install linutil",
      "Verify: linutil --version",
      "supercli plugins install ./plugins/linutil --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linutil",
      "resource": "self",
      "action": "version",
      "description": "Print linutil version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linutil",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install linutil: pip install linutil"
      },
      "args": []
    },
    {
      "namespace": "linutil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to linutil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "linutil",
        "passthrough": true,
        "missingDependencyHelp": "Install linutil: pip install linutil"
      },
      "args": []
    }
  ]
}