{
  "name": "omfonts",
  "version": "0.1.0",
  "description": "CLI tool: omfonts",
  "source": "https://manpages.debian.org/omfonts",
  "checks": [
    {
      "type": "binary",
      "name": "omfonts"
    }
  ],
  "install_guidance": {
    "plugin": "omfonts",
    "binary": "omfonts",
    "check": "which omfonts",
    "install_steps": [
      "apt-get install omfonts 2>/dev/null || which omfonts",
      "Verify: omfonts --version",
      "supercli plugins install ./plugins/omfonts --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "omfonts",
      "resource": "self",
      "action": "version",
      "description": "Print omfonts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "omfonts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install omfonts: apt-get install omfonts 2>/dev/null || which omfonts"
      },
      "args": []
    },
    {
      "namespace": "omfonts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to omfonts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "omfonts",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install omfonts: apt-get install omfonts 2>/dev/null || which omfonts"
      },
      "args": []
    }
  ]
}