{
  "name": "morphe-patches",
  "version": "0.1.0",
  "description": "Morphe Patches",
  "source": "https://github.com/morphe-patches/morphe-patches",
  "checks": [
    {
      "type": "binary",
      "name": "morphe-patches"
    }
  ],
  "install_guidance": {
    "plugin": "morphe-patches",
    "binary": "morphe-patches",
    "check": "which morphe-patches",
    "install_steps": [
      "pip install morphe-patches",
      "Verify: morphe-patches --version",
      "supercli plugins install ./plugins/morphe-patches --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "morphe-patches",
      "resource": "self",
      "action": "version",
      "description": "Print morphe-patches version",
      "adapter": "process",
      "adapterConfig": {
        "command": "morphe-patches",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install morphe-patches: pip install morphe-patches"
      },
      "args": []
    },
    {
      "namespace": "morphe-patches",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to morphe-patches CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "morphe-patches",
        "passthrough": true,
        "missingDependencyHelp": "Install morphe-patches: pip install morphe-patches"
      },
      "args": []
    }
  ]
}