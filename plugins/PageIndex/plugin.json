{
  "name": "PageIndex",
  "version": "0.1.0",
  "description": "\ud83d\udcd1 PageIndex: Document Index for Vectorless, Reasoning-based RAG",
  "source": "https://github.com/PageIndex/PageIndex",
  "checks": [
    {
      "type": "binary",
      "name": "pageindex"
    }
  ],
  "install_guidance": {
    "plugin": "PageIndex",
    "binary": "pageindex",
    "check": "which pageindex",
    "install_steps": [
      "pip install pageindex",
      "Verify: pageindex --version",
      "supercli plugins install ./plugins/PageIndex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PageIndex",
      "resource": "self",
      "action": "version",
      "description": "Print PageIndex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pageindex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PageIndex: pip install pageindex"
      },
      "args": []
    },
    {
      "namespace": "PageIndex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pageindex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pageindex",
        "passthrough": true,
        "missingDependencyHelp": "Install PageIndex: pip install pageindex"
      },
      "args": []
    }
  ]
}