{
  "name": "baoyu-skills",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/baoyu-skills/baoyu-skills",
  "checks": [
    {
      "type": "binary",
      "name": "baoyu-skills"
    }
  ],
  "install_guidance": {
    "plugin": "baoyu-skills",
    "binary": "baoyu-skills",
    "check": "which baoyu-skills",
    "install_steps": [
      "pip install baoyu-skills",
      "Verify: baoyu-skills --version",
      "supercli plugins install ./plugins/baoyu-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "baoyu-skills",
      "resource": "self",
      "action": "version",
      "description": "Print baoyu-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "baoyu-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install baoyu-skills: pip install baoyu-skills"
      },
      "args": []
    },
    {
      "namespace": "baoyu-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to baoyu-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "baoyu-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install baoyu-skills: pip install baoyu-skills"
      },
      "args": []
    }
  ]
}