{
  "name": "zhihu-plus-plus",
  "version": "0.1.0",
  "description": "Zhihu++ | \u77e5\u4e4e++: Ad-free, low cost, AI powered zhihu android 3rd-party client. \u53bb\u5e7f\u544a\u3001\u5360\u7528\u4f4e\u3001AI\u5927\u6a21\u578b\u7684\u65b0\u65f6\u4ee3\u77e5\u4e4e\u5b89\u5353\u7aef",
  "source": "https://github.com/zhihu-plus-plus/zhihu-plus-plus",
  "checks": [
    {
      "type": "binary",
      "name": "zhihu-plus-plus"
    }
  ],
  "install_guidance": {
    "plugin": "zhihu-plus-plus",
    "binary": "zhihu-plus-plus",
    "check": "which zhihu-plus-plus",
    "install_steps": [
      "pip install zhihu-plus-plus",
      "Verify: zhihu-plus-plus --version",
      "supercli plugins install ./plugins/zhihu-plus-plus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zhihu-plus-plus",
      "resource": "self",
      "action": "version",
      "description": "Print zhihu-plus-plus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zhihu-plus-plus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zhihu-plus-plus: pip install zhihu-plus-plus"
      },
      "args": []
    },
    {
      "namespace": "zhihu-plus-plus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zhihu-plus-plus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zhihu-plus-plus",
        "passthrough": true,
        "missingDependencyHelp": "Install zhihu-plus-plus: pip install zhihu-plus-plus"
      },
      "args": []
    }
  ]
}