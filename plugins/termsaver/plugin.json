{
  "name": "termsaver",
  "version": "0.1.0",
  "description": "termsaver to enjoy fancy ASCII screensavers like matrix, clock, starwars, and a couple of not-safe-for-work screens.",
  "checks": [
    {
      "type": "binary",
      "name": "termsaver"
    }
  ],
  "install_guidance": {
    "plugin": "termsaver",
    "binary": "termsaver",
    "check": "which termsaver",
    "install_steps": [
      "See undefined",
      "Verify: termsaver --version",
      "supercli plugins install ./plugins/termsaver --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "termsaver",
      "resource": "self",
      "action": "version",
      "description": "Print termsaver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "termsaver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install termsaver: See undefined"
      },
      "args": []
    },
    {
      "namespace": "termsaver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to termsaver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "termsaver",
        "passthrough": true,
        "missingDependencyHelp": "Install termsaver"
      },
      "args": []
    }
  ]
}