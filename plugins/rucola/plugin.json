{
  "name": "rucola",
  "version": "0.1.0",
  "description": "Manage your markdown notes",
  "source": "https://github.com/Linus-Mussmaecher/rucola",
  "checks": [
    {
      "type": "binary",
      "name": "rucola"
    }
  ],
  "install_guidance": {
    "plugin": "rucola",
    "binary": "rucola",
    "check": "which rucola",
    "install_steps": [
      "See https://github.com/Linus-Mussmaecher/rucola",
      "Verify: rucola --version",
      "supercli plugins install ./plugins/rucola --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "rucola",
      "resource": "self",
      "action": "version",
      "description": "Print rucola version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rucola",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rucola: See https://github.com/Linus-Mussmaecher/rucola"
      },
      "args": []
    },
    {
      "namespace": "rucola",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rucola CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rucola",
        "passthrough": true,
        "missingDependencyHelp": "Install rucola"
      },
      "args": []
    }
  ]
}