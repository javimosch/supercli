{
  "name": "uninstall-clever-completion",
  "version": "0.1.0",
  "description": "CLI tool: uninstall-clever-completion",
  "source": "https://manpages.debian.org/uninstall-clever-completion",
  "checks": [
    {
      "type": "binary",
      "name": "uninstall-clever-completion"
    }
  ],
  "install_guidance": {
    "plugin": "uninstall-clever-completion",
    "binary": "uninstall-clever-completion",
    "check": "which uninstall-clever-completion",
    "install_steps": [
      "apt-get install uninstall-clever-completion 2>/dev/null || which uninstall-clever-completion",
      "Verify: uninstall-clever-completion --version",
      "supercli plugins install ./plugins/uninstall-clever-completion --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uninstall-clever-completion",
      "resource": "self",
      "action": "version",
      "description": "Print uninstall-clever-completion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uninstall-clever-completion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uninstall-clever-completion: apt-get install uninstall-clever-completion 2>/dev/null || which uninstall-clever-completion"
      },
      "args": []
    },
    {
      "namespace": "uninstall-clever-completion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uninstall-clever-completion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uninstall-clever-completion",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uninstall-clever-completion: apt-get install uninstall-clever-completion 2>/dev/null || which uninstall-clever-completion"
      },
      "args": []
    }
  ]
}