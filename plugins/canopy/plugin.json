{
  "name": "canopy",
  "version": "0.1.0",
  "description": "The official go implementation of the Canopy Network protocol",
  "source": "https://github.com/canopy/canopy",
  "checks": [
    {
      "type": "binary",
      "name": "canopy"
    }
  ],
  "install_guidance": {
    "plugin": "canopy",
    "binary": "canopy",
    "check": "which canopy",
    "install_steps": [
      "pip install canopy",
      "Verify: canopy --version",
      "supercli plugins install ./plugins/canopy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "canopy",
      "resource": "self",
      "action": "version",
      "description": "Print canopy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "canopy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install canopy: pip install canopy"
      },
      "args": []
    },
    {
      "namespace": "canopy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to canopy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "canopy",
        "passthrough": true,
        "missingDependencyHelp": "Install canopy: pip install canopy"
      },
      "args": []
    }
  ]
}