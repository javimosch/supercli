{
  "name": "bartib",
  "version": "0.1.0",
  "description": "Simple timetracking for the command line",
  "source": "https://github.com/nikolassv/bartib",
  "checks": [
    {
      "type": "binary",
      "name": "bartib"
    }
  ],
  "install_guidance": {
    "plugin": "bartib",
    "binary": "bartib",
    "check": "which bartib",
    "install_steps": [
      "cargo install bartib",
      "Verify: bartib --version",
      "supercli plugins install ./plugins/bartib --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bartib",
      "resource": "self",
      "action": "version",
      "description": "Print bartib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bartib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bartib: cargo install bartib"
      },
      "args": []
    },
    {
      "namespace": "bartib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bartib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bartib",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install bartib: cargo install bartib"
      },
      "args": []
    }
  ]
}