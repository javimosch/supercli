{
  "name": "vgs",
  "version": "0.1.0",
  "description": "Display volume group info",
  "source": "https://packages.debian.org/vgs",
  "checks": [{ "type": "binary", "name": "vgs" }],
  "install_guidance": {
    "plugin": "vgs", "binary": "vgs", "check": "which vgs",
    "install_steps": ["apt-get install lvm2", "Verify: vgs --version", "supercli plugins install ./plugins/vgs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vgs", "resource": "_", "action": "_",
    "description": "Passthrough to vgs CLI",
    "adapter": "process", "adapterConfig": { "command": "vgs", "passthrough": true, "missingDependencyHelp": "Install vgs: apt-get install lvm2" }, "args": []
  }]
}
