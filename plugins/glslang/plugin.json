{
  "name": "glslang",
  "version": "0.1.0",
  "description": "OpenGL and OpenGL ES reference compiler for shading languages",
  "checks": [
    {
      "type": "binary",
      "name": "glslang"
    }
  ],
  "install_guidance": {
    "plugin": "glslang",
    "binary": "glslang",
    "check": "which glslang",
    "install_steps": [
      "brew install glslang",
      "Verify: glslang --version",
      "supercli plugins install ./plugins/glslang --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "glslang",
      "resource": "self",
      "action": "version",
      "description": "Print glslang version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glslang",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install glslang: brew install glslang"
      },
      "args": []
    },
    {
      "namespace": "glslang",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glslang CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glslang",
        "passthrough": true,
        "missingDependencyHelp": "Install glslang"
      },
      "args": []
    }
  ]
}