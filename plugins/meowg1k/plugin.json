{
  "name": "meowg1k",
  "version": "0.1.0",
  "description": "A purr-fectly scriptable CLI that brings AI superpowers to your terminal—automate commits, reviews, and workflows with feline precision",
  "source": "https://github.com/meowg1k/meowg1k",
  "checks": [
    {
      "type": "binary",
      "name": "meowg1k"
    }
  ],
  "install_guidance": {
    "plugin": "meowg1k",
    "binary": "meowg1k",
    "check": "which meowg1k",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: meowg1k --version",
      "supercli plugins install ./plugins/meowg1k --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "meowg1k",
      "resource": "self",
      "action": "version",
      "description": "Print meowg1k version",
      "adapter": "process",
      "adapterConfig": {
        "command": "meowg1k",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install meowg1k from project repository"
      },
      "args": []
    },
    {
      "namespace": "meowg1k",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to meowg1k CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "meowg1k",
        "passthrough": true,
        "missingDependencyHelp": "Install meowg1k from project repository"
      },
      "args": []
    }
  ]
}