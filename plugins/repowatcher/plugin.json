{
  "name": "repowatcher",
  "version": "0.1.0",
  "description": "Manage and update repository text data and metadata",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "repowatcher" }],
  "install_guidance": {
    "plugin": "repowatcher",
    "binary": "repowatcher",
    "check": "which repowatcher",
    "install_steps": ["npm install -g repowatcher", "Verify: repowatcher --version", "supercli plugins install ./plugins/repowatcher --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "repowatcher",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to repowatcher CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "repowatcher",
      "passthrough": true,
      "missingDependencyHelp": "Install repowatcher: npm install -g repowatcher"
    },
    "args": []
  }]
}
