{
  "name": "arch-wiki",
  "version": "0.1.0",
  "description": "Search the Arch Wiki anywhere from the command line.",
  "source": "https://github.com/deadhead420/arch-wiki",
  "checks": [
    {
      "type": "binary",
      "name": "arch-wiki"
    }
  ],
  "install_guidance": {
    "plugin": "arch-wiki",
    "binary": "arch-wiki",
    "check": "which arch-wiki",
    "install_steps": [
      "See https://github.com/deadhead420/arch-wiki",
      "Verify: arch-wiki --version",
      "supercli plugins install ./plugins/arch-wiki --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "arch-wiki",
      "resource": "self",
      "action": "version",
      "description": "Print arch-wiki version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arch-wiki",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arch-wiki: See https://github.com/deadhead420/arch-wiki"
      },
      "args": []
    },
    {
      "namespace": "arch-wiki",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arch-wiki CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "arch-wiki",
        "passthrough": true,
        "missingDependencyHelp": "Install arch-wiki"
      },
      "args": []
    }
  ]
}