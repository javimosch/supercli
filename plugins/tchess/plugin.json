{
  "name": "tchess",
  "version": "0.1.0",
  "description": "Minimalist terminal-based chess game",
  "source": "https://github.com/dunnkers/tchess",
  "checks": [{ "type": "binary", "name": "tchess" }],
  "install_guidance": {
    "plugin": "tchess",
    "binary": "tchess",
    "check": "which tchess",
    "install_steps": ["cargo install tchess", "Verify: tchess --version", "supercli plugins install ./plugins/tchess --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tchess",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tchess CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tchess",
      "passthrough": true,
      "missingDependencyHelp": "Install tchess: cargo install tchess", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
