{
  "name": "gjs-console",
  "version": "0.1.0",
  "description": "CLI tool: gjs-console",
  "source": "https://manpages.debian.org/gjs-console",
  "checks": [
    {
      "type": "binary",
      "name": "gjs-console"
    }
  ],
  "install_guidance": {
    "plugin": "gjs-console",
    "binary": "gjs-console",
    "check": "which gjs-console",
    "install_steps": [
      "apt-get install gjs-console 2>/dev/null || which gjs-console",
      "Verify: gjs-console --version",
      "supercli plugins install ./plugins/gjs-console --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gjs-console",
      "resource": "self",
      "action": "version",
      "description": "Print gjs-console version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gjs-console",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gjs-console: apt-get install gjs-console 2>/dev/null || which gjs-console"
      },
      "args": []
    },
    {
      "namespace": "gjs-console",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gjs-console CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gjs-console",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gjs-console: apt-get install gjs-console 2>/dev/null || which gjs-console"
      },
      "args": []
    }
  ]
}