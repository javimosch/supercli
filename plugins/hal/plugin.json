{
  "name": "hal",
  "version": "1.0.0",
  "description": "hal \u2014 HAProxy CLI",
  "source": "github.com/haproxy/hal",
  "checks": [
    {
      "type": "binary",
      "name": "hal"
    }
  ],
  "install_guidance": {
    "plugin": "hal",
    "binary": "hal",
    "check": "which hal",
    "install_steps": [
      "# Install hal",
      "# See github.com/haproxy/hal",
      "# apt: sudo apt-get install hal",
      "# brew: brew install hal",
      "# cargo: cargo install hal",
      "# npm: npm install -g hal",
      "# pip: pip install hal"
    ]
  },
  "commands": [
    {
      "namespace": "hal",
      "resource": "hal",
      "action": "run",
      "description": "Run hal",
      "adapter": "process",
      "adapterConfig": {
        "command": "hal",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install hal from github.com/haproxy/hal"
      },
      "args": []
    }
  ]
}