{
  "name": "passgen",
  "version": "1.0.0",
  "description": "passgen — cryptographically secure random password generator. Configurable length, optional special characters. Written in Go.",
  "source": "https://github.com/javimosch/passgen",
  "checks": [{"type": "binary", "name": "passgen"}],
  "install_guidance": {
    "plugin": "passgen","binary": "passgen","check": "which passgen",
    "install_steps": [
      "curl -LO https://github.com/javimosch/passgen/releases/latest/download/passgen-linux-amd64",
      "chmod +x passgen-linux-amd64",
      "sudo mv passgen-linux-amd64 /usr/local/bin/passgen",
      "Verify: passgen 16"]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [{
    "namespace": "passgen","resource": "self","action": "generate",
    "description": "Generate a random password",
    "adapter": "process",
    "adapterConfig": {
      "command": "passgen","positionalArgs": ["length"],"passthrough": true,"timeout_ms": 5000,
      "missingDependencyHelp": "Install passgen: https://github.com/javimosch/passgen"
    },
    "args": [
      {"name":"length","type":"number","required":false,"description":"Password length (default:24)"},
      {"name":"--no-special","type":"boolean","required":false,"description":"Exclude special chars"}
    ]
  }]
}
