{
  "name": "rainfrog",
  "version": "0.1.0",
  "description": "\ud83d\udc38 a database tool for the terminal",
  "source": "https://github.com/rainfrog/rainfrog",
  "checks": [
    {
      "type": "binary",
      "name": "rainfrog"
    }
  ],
  "install_guidance": {
    "plugin": "rainfrog",
    "binary": "rainfrog",
    "check": "which rainfrog",
    "install_steps": [
      "pip install rainfrog",
      "Verify: rainfrog --version",
      "supercli plugins install ./plugins/rainfrog --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rainfrog",
      "resource": "self",
      "action": "version",
      "description": "Print rainfrog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rainfrog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rainfrog: pip install rainfrog"
      },
      "args": []
    },
    {
      "namespace": "rainfrog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rainfrog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rainfrog",
        "passthrough": true,
        "missingDependencyHelp": "Install rainfrog: pip install rainfrog"
      },
      "args": []
    }
  ]
}