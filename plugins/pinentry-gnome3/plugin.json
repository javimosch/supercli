{
  "name": "pinentry-gnome3",
  "version": "0.1.0",
  "description": "CLI tool: pinentry-gnome3",
  "source": "https://manpages.debian.org/pinentry-gnome3",
  "checks": [
    {
      "type": "binary",
      "name": "pinentry-gnome3"
    }
  ],
  "install_guidance": {
    "plugin": "pinentry-gnome3",
    "binary": "pinentry-gnome3",
    "check": "which pinentry-gnome3",
    "install_steps": [
      "apt-get install pinentry-gnome3 2>/dev/null || which pinentry-gnome3",
      "Verify: pinentry-gnome3 --version",
      "supercli plugins install ./plugins/pinentry-gnome3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pinentry-gnome3",
      "resource": "self",
      "action": "version",
      "description": "Print pinentry-gnome3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pinentry-gnome3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pinentry-gnome3: apt-get install pinentry-gnome3 2>/dev/null || which pinentry-gnome3"
      },
      "args": []
    },
    {
      "namespace": "pinentry-gnome3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pinentry-gnome3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pinentry-gnome3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pinentry-gnome3: apt-get install pinentry-gnome3 2>/dev/null || which pinentry-gnome3"
      },
      "args": []
    }
  ]
}