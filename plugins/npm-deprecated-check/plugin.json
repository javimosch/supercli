{
  "name": "npm-deprecated-check",
  "version": "0.1.0",
  "description": "Check for deprecated dependencies",
  "source": "https://github.com/KID-joker/npm-deprecated-check",
  "checks": [
    {
      "type": "binary",
      "name": "npm-deprecated-check"
    }
  ],
  "install_guidance": {
    "plugin": "npm-deprecated-check",
    "binary": "npm-deprecated-check",
    "check": "which npm-deprecated-check",
    "install_steps": [
      "See https://github.com/KID-joker/npm-deprecated-check",
      "Verify: npm-deprecated-check --version",
      "supercli plugins install ./plugins/npm-deprecated-check --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "npm-deprecated-check",
      "resource": "self",
      "action": "version",
      "description": "Print npm-deprecated-check version",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-deprecated-check",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install npm-deprecated-check: See https://github.com/KID-joker/npm-deprecated-check"
      },
      "args": []
    },
    {
      "namespace": "npm-deprecated-check",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to npm-deprecated-check CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-deprecated-check",
        "passthrough": true,
        "missingDependencyHelp": "Install npm-deprecated-check"
      },
      "args": []
    }
  ]
}