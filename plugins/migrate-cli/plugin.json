{
  "name": "migrate-cli",
  "version": "0.1.0",
  "description": "PHP-based CLI for database version control with multiple backends",
  "source": "composer",
  "checks": [{ "type": "binary", "name": "migrate-cli" }],
  "install_guidance": {
    "plugin": "migrate-cli",
    "binary": "migrate-cli",
    "check": "which migrate-cli",
    "install_steps": ["composer require byjg/migration-cli", "Verify: migrate-cli --version", "supercli plugins install ./plugins/migrate-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "migrate-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to migrate-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "migrate-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install migrate-cli: composer require byjg/migration-cli"
    },
    "args": []
  }]
}
