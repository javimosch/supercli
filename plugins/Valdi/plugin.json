{
  "name": "Valdi",
  "version": "0.1.0",
  "description": "Valdi is a cross-platform UI framework that delivers native performance without sacrificing develope",
  "source": "https://github.com/Valdi/Valdi",
  "checks": [
    {
      "type": "binary",
      "name": "valdi"
    }
  ],
  "install_guidance": {
    "plugin": "Valdi",
    "binary": "valdi",
    "check": "which valdi",
    "install_steps": [
      "pip install valdi",
      "Verify: valdi --version",
      "supercli plugins install ./plugins/Valdi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Valdi",
      "resource": "self",
      "action": "version",
      "description": "Print Valdi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "valdi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Valdi: pip install valdi"
      },
      "args": []
    },
    {
      "namespace": "Valdi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to valdi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "valdi",
        "passthrough": true,
        "missingDependencyHelp": "Install Valdi: pip install valdi"
      },
      "args": []
    }
  ]
}