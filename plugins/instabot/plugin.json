{
  "name": "instabot",
  "version": "1.0.0",
  "description": "instabot \u2014 Instagram automation",
  "source": "github.com/instabot/instabot",
  "checks": [
    {
      "type": "binary",
      "name": "instabot"
    }
  ],
  "install_guidance": {
    "plugin": "instabot",
    "binary": "instabot",
    "check": "which instabot",
    "install_steps": [
      "# Install instabot",
      "# See github.com/instabot/instabot",
      "# apt: sudo apt-get install instabot",
      "# brew: brew install instabot",
      "# cargo: cargo install instabot",
      "# npm: npm install -g instabot",
      "# pip: pip install instabot"
    ]
  },
  "commands": [
    {
      "namespace": "instabot",
      "resource": "instabot",
      "action": "run",
      "description": "Run instabot",
      "adapter": "process",
      "adapterConfig": {
        "command": "instabot",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install instabot from github.com/instabot/instabot"
      },
      "args": []
    }
  ]
}