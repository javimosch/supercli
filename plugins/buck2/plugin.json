{
  "name": "buck2",
  "version": "0.1.0",
  "description": "Fast multi-language build system from Meta in Rust",
  "source": "https://github.com/facebook/buck2",
  "checks": [{ "type": "binary", "name": "buck2" }],
  "install_guidance": {
    "plugin": "buck2",
    "binary": "buck2",
    "check": "which buck2",
    "install_steps": ["binary release", "Verify: buck2 --version", "supercli plugins install ./plugins/buck2 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "buck2",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to buck2 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "buck2",
      "passthrough": true,
      "missingDependencyHelp": "Install buck2: binary release", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
