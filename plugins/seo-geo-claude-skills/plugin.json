      "adapter": "process",
      "adapterConfig": {
        "command": "seo-geo-claude-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install seo-geo-claude-skills: pip install seo-geo-claude-skills"
      },
      "args": []
    },
    {
      "namespace": "seo-geo-claude-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to seo-geo-claude-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "seo-geo-claude-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install seo-geo-claude-skills: pip install seo-geo-claude-skills"
      },
      "args": []
    }
  ]
