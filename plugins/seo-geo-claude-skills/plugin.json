    "binary": "seo-geo-claude-skills",
    "check": "which seo-geo-claude-skills",
    "install_steps": [
      "pip install seo-geo-claude-skills",
      "Verify: seo-geo-claude-skills --version",
      "supercli plugins install ./plugins/seo-geo-claude-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "seo-geo-claude-skills",
      "resource": "self",
      "action": "version",
