{
  "name": "dbh2",
  "version": "0.1.0",
  "description": "CLI tool: dbh2",
  "source": "https://packages.debian.org/dbh2",
  "checks": [{ "type": "binary", "name": "dbh2" }],
  "install_guidance": {
    "plugin": "dbh2", "binary": "dbh2", "check": "which dbh2",
    "install_steps": ["apt-get install dbh2 2>/dev/null || which dbh2", "Verify: dbh2 --version", "supercli plugins install ./plugins/dbh2 --on-conflict replace --json"]
