  "commands": [{
    "namespace": "dbh2", "resource": "_", "action": "_",
    "description": "Passthrough to dbh2 CLI",
    "adapter": "process", "adapterConfig": { "command": "dbh2", "passthrough": true, "missingDependencyHelp": "Install dbh2: apt-get install dbh2" }, "args": []
  }]
}
