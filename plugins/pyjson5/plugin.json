{
  "name": "pyjson5",
  "version": "0.1.0",
  "description": "CLI tool: pyjson5",
  "source": "https://manpages.debian.org/pyjson5",
  "checks": [
    {
      "type": "binary",
      "name": "pyjson5"
    }
  ],
  "install_guidance": {
    "plugin": "pyjson5",
    "binary": "pyjson5",
    "check": "which pyjson5",
    "install_steps": [
      "apt-get install pyjson5 2>/dev/null || which pyjson5",
      "Verify: pyjson5 --version",
      "supercli plugins install ./plugins/pyjson5 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyjson5",
      "resource": "self",
      "action": "version",
      "description": "Print pyjson5 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyjson5",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyjson5: apt-get install pyjson5 2>/dev/null || which pyjson5"
      },
      "args": []
    },
    {
      "namespace": "pyjson5",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyjson5 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyjson5",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyjson5: apt-get install pyjson5 2>/dev/null || which pyjson5"
      },
      "args": []
    }
  ]
}