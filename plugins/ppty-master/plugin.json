{
  "name": "ppty-master",
  "version": "0.1.0",
  "description": "PowerPoint presentation generation from documents, Markdown, and data",
  "source": "https://github.com/nicm/pptx-master",
  "checks": [
    {
      "type": "binary",
      "name": "ppt-master"
    }
  ],
  "install_guidance": {
    "plugin": "ppty-master",
    "binary": "ppt-master",
    "check": "which ppt-master",
    "install_steps": [
      "pip install ppt-master",
      "Verify: ppt-master --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppty-master",
      "resource": "self",
      "action": "version",
      "description": "Print ppt-master version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppt-master",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install ppt-master: pip install ppt-master"
      },
      "args": []
    },
    {
      "namespace": "ppty-master",
      "resource": "file",
      "action": "generate",
      "description": "Generate PowerPoint presentations from documents or Markdown",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppt-master",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install ppt-master: pip install ppt-master"
      },
      "args": []
    },
    {
      "namespace": "ppty-master",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppt-master CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppt-master",
        "passthrough": true,
        "missingDependencyHelp": "Install ppt-master: pip install ppt-master"
      },
      "args": []
    }
  ]
}