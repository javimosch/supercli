{
  "name": "pg_duckdb",
  "version": "0.1.0",
  "description": "DuckDB-powered Postgres for high performance apps & analytics.",
  "source": "https://github.com/pg_duckdb/pg_duckdb",
  "checks": [
    {
      "type": "binary",
      "name": "pg-duckdb"
    }
  ],
  "install_guidance": {
    "plugin": "pg_duckdb",
    "binary": "pg-duckdb",
    "check": "which pg-duckdb",
    "install_steps": [
      "pip install pg-duckdb",
      "Verify: pg-duckdb --version",
      "supercli plugins install ./plugins/pg_duckdb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pg_duckdb",
      "resource": "self",
      "action": "version",
      "description": "Print pg_duckdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg-duckdb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pg_duckdb: pip install pg-duckdb"
      },
      "args": []
    },
    {
      "namespace": "pg_duckdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pg-duckdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg-duckdb",
        "passthrough": true,
        "missingDependencyHelp": "Install pg_duckdb: pip install pg-duckdb"
      },
      "args": []
    }
  ]
}