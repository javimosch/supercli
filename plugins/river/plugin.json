{
  "name": "river",
  "version": "0.1.0",
  "description": "Fast and reliable background jobs in Go",
  "source": "https://github.com/river/river",
  "checks": [
    {
      "type": "binary",
      "name": "river"
    }
  ],
  "install_guidance": {
    "plugin": "river",
    "binary": "river",
    "check": "which river",
    "install_steps": [
      "pip install river",
      "Verify: river --version",
      "supercli plugins install ./plugins/river --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "river",
      "resource": "self",
      "action": "version",
      "description": "Print river version",
      "adapter": "process",
      "adapterConfig": {
        "command": "river",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install river: pip install river"
      },
      "args": []
    },
    {
      "namespace": "river",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to river CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "river",
        "passthrough": true,
        "missingDependencyHelp": "Install river: pip install river"
      },
      "args": []
    }
  ]
}