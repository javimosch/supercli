{
  "name": "evans",
  "version": "0.1.0",
  "description": "Interactive gRPC client with REPL mode and JSON output",
  "source": "https://github.com/ktr0731/evans",
  "checks": [{ "type": "binary", "name": "evans" }],
  "install_guidance": {
    "plugin": "evans",
    "binary": "evans",
    "check": "which evans",
    "install_steps": ["brew install evans", "Verify: evans --version", "supercli plugins install ./plugins/evans --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "evans",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to evans CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "evans",
      "passthrough": true,
      "missingDependencyHelp": "Install evans: brew install evans"
    },
    "args": []
  }]
}
