{
  "name": "Foundry-Local",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/Foundry-Local/Foundry-Local",
  "checks": [
    {
      "type": "binary",
      "name": "foundry-local"
    }
  ],
  "install_guidance": {
    "plugin": "Foundry-Local",
    "binary": "foundry-local",
    "check": "which foundry-local",
    "install_steps": [
      "pip install foundry-local",
      "Verify: foundry-local --version",
      "supercli plugins install ./plugins/Foundry-Local --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Foundry-Local",
      "resource": "self",
      "action": "version",
      "description": "Print Foundry-Local version",
      "adapter": "process",
      "adapterConfig": {
        "command": "foundry-local",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Foundry-Local: pip install foundry-local"
      },
      "args": []
    },
    {
      "namespace": "Foundry-Local",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to foundry-local CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "foundry-local",
        "passthrough": true,
        "missingDependencyHelp": "Install Foundry-Local: pip install foundry-local"
      },
      "args": []
    }
  ]
}