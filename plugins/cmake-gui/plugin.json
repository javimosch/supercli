{
  "name": "cmake-gui",
  "version": "0.1.0",
  "description": "CLI tool: cmake-gui",
  "source": "https://packages.debian.org/cmake-gui",
  "checks": [{ "type": "binary", "name": "cmake-gui" }],
  "install_guidance": {
    "plugin": "cmake-gui", "binary": "cmake-gui", "check": "which cmake-gui",
    "install_steps": ["apt-get install cmake-gui 2>/dev/null || which cmake-gui", "Verify: cmake-gui --version", "supercli plugins install ./plugins/cmake-gui --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cmake-gui", "resource": "_", "action": "_",
    "description": "Passthrough to cmake-gui CLI",
    "adapter": "process", "adapterConfig": { "command": "cmake-gui", "passthrough": true, "missingDependencyHelp": "Install cmake-gui: apt-get install cmake-gui" }, "args": []
  }]
}
