{
  "name": "hashify",
  "version": "0.1.0",
  "description": "Simple CLI to generate hashes with md5 sha1 and sha256",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "hashify" }],
  "install_guidance": {
    "plugin": "hashify",
    "binary": "hashify",
    "check": "which hashify",
    "install_steps": ["npm install -g hashify", "Verify: hashify --version", "supercli plugins install ./plugins/hashify --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hashify",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hashify CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hashify",
      "passthrough": true,
      "missingDependencyHelp": "Install hashify: npm install -g hashify"
    },
    "args": []
  }]
}
