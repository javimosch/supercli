{
  "name": "see",
  "version": "0.1.0",
  "description": "CLI tool: see",
  "source": "https://manpages.debian.org/see",
  "checks": [
    {
      "type": "binary",
      "name": "see"
    }
  ],
  "install_guidance": {
    "plugin": "see",
    "binary": "see",
    "check": "which see",
    "install_steps": [
      "apt-get install see 2>/dev/null || which see",
      "Verify: see --version",
      "supercli plugins install ./plugins/see --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "see",
      "resource": "self",
      "action": "version",
      "description": "Print see version",
      "adapter": "process",
      "adapterConfig": {
        "command": "see",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install see: apt-get install see 2>/dev/null || which see"
      },
      "args": []
    },
    {
      "namespace": "see",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to see CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "see",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install see: apt-get install see 2>/dev/null || which see"
      },
      "args": []
    }
  ]
}