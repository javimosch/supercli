{
  "name": "der-ascii",
  "version": "0.1.0",
  "description": "Reversible DER and BER pretty-printer",
  "source": "https://github.com/google/der-ascii",
  "checks": [
    {
      "type": "binary",
      "name": "der-ascii"
    }
  ],
  "install_guidance": {
    "plugin": "der-ascii",
    "binary": "der-ascii",
    "check": "which der-ascii",
    "install_steps": [
      "brew install der-ascii",
      "Verify: der-ascii --version",
      "supercli plugins install ./plugins/der-ascii --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "der-ascii",
      "resource": "self",
      "action": "version",
      "description": "Print der-ascii version",
      "adapter": "process",
      "adapterConfig": {
        "command": "der-ascii",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install der-ascii: brew install der-ascii"
      },
      "args": []
    },
    {
      "namespace": "der-ascii",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to der-ascii CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "der-ascii",
        "passthrough": true,
        "missingDependencyHelp": "Install der-ascii"
      },
      "args": []
    }
  ]
}