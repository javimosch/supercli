{
  "name": "cprof",
  "version": "0.1.0",
  "description": "CLI tool: cprof",
  "source": "https://packages.debian.org/cprof",
  "checks": [{ "type": "binary", "name": "cprof" }],
  "install_guidance": {
    "plugin": "cprof", "binary": "cprof", "check": "which cprof",
    "install_steps": ["apt-get install cprof 2>/dev/null || which cprof", "Verify: cprof --version", "supercli plugins install ./plugins/cprof --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cprof", "resource": "_", "action": "_",
    "description": "Passthrough to cprof CLI",
    "adapter": "process", "adapterConfig": { "command": "cprof", "passthrough": true, "missingDependencyHelp": "Install cprof: apt-get install cprof" }, "args": []
  }]
}
