{
  "name": "strip-json-comments",
  "version": "0.1.0",
  "description": "Remove comments from JSON files for processing",
  "source": "https://github.com/sindresorhus/strip-json-comments-cli",
  "checks": [{ "type": "binary", "name": "strip-json-comments" }],
  "install_guidance": {
    "plugin": "strip-json-comments",
    "binary": "strip-json-comments",
    "check": "which strip-json-comments",
    "install_steps": ["npm install -g strip-json-comments-cli", "Verify: strip-json-comments --version", "supercli plugins install ./plugins/strip-json-comments --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "strip-json-comments",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to strip-json-comments CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "strip-json-comments",
      "passthrough": true,
      "missingDependencyHelp": "Install strip-json-comments: npm install -g strip-json-comments-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
