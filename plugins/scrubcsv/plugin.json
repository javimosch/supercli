{
  "name": "scrubcsv",
  "version": "0.1.0",
  "description": "Remove bad lines and normalize CSV data for clean processing",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "scrubcsv" }],
  "install_guidance": {
    "plugin": "scrubcsv",
    "binary": "scrubcsv",
    "check": "which scrubcsv",
    "install_steps": ["cargo install scrubcsv", "Verify: scrubcsv --version", "supercli plugins install ./plugins/scrubcsv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "scrubcsv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to scrubcsv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "scrubcsv",
      "passthrough": true,
      "missingDependencyHelp": "Install scrubcsv: cargo install scrubcsv"
    },
    "args": []
  }]
}
