{
  "name": "i386",
  "version": "0.1.0",
  "description": "CLI tool: i386",
  "source": "https://manpages.debian.org/i386",
  "checks": [
    {
      "type": "binary",
      "name": "i386"
    }
  ],
  "install_guidance": {
    "plugin": "i386",
    "binary": "i386",
    "check": "which i386",
    "install_steps": [
      "apt-get install i386 2>/dev/null || which i386",
      "Verify: i386 --version",
      "supercli plugins install ./plugins/i386 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "i386",
      "resource": "self",
      "action": "version",
      "description": "Print i386 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "i386",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install i386: apt-get install i386 2>/dev/null || which i386"
      },
      "args": []
    },
    {
      "namespace": "i386",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to i386 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "i386",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install i386: apt-get install i386 2>/dev/null || which i386"
      },
      "args": []
    }
  ]
}