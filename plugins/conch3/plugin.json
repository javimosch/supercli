{
  "name": "conch3",
  "version": "0.1.0",
  "description": "CLI tool: conch3",
  "source": "https://packages.debian.org/conch3",
  "checks": [{ "type": "binary", "name": "conch3" }],
  "install_guidance": {
    "plugin": "conch3", "binary": "conch3", "check": "which conch3",
    "install_steps": ["apt-get install conch3 2>/dev/null || which conch3", "Verify: conch3 --version", "supercli plugins install ./plugins/conch3 --on-conflict replace --json"]
