{
  "name": "bpftop",
  "version": "0.1.0",
  "description": "bpftop provides a dynamic real-time view of running eBPF programs. It displays the average runtime, ",
  "source": "https://github.com/bpftop/bpftop",
  "checks": [
    {
      "type": "binary",
      "name": "bpftop"
    }
  ],
  "install_guidance": {
    "plugin": "bpftop",
    "binary": "bpftop",
    "check": "which bpftop",
    "install_steps": [
      "pip install bpftop",
      "Verify: bpftop --version",
      "supercli plugins install ./plugins/bpftop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bpftop",
      "resource": "self",
      "action": "version",
      "description": "Print bpftop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bpftop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bpftop: pip install bpftop"
      },
      "args": []
    },
    {
      "namespace": "bpftop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bpftop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bpftop",
        "passthrough": true,
        "missingDependencyHelp": "Install bpftop: pip install bpftop"
      },
      "args": []
    }
  ]
}