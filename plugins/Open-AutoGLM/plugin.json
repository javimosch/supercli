{
  "name": "Open-AutoGLM",
  "version": "0.1.0",
  "description": "An Open Phone Agent Model & Framework. Unlocking the AI Phone for Everyone",
  "source": "https://github.com/Open-AutoGLM/Open-AutoGLM",
  "checks": [
    {
      "type": "binary",
      "name": "open-autoglm"
    }
  ],
  "install_guidance": {
    "plugin": "Open-AutoGLM",
    "binary": "open-autoglm",
    "check": "which open-autoglm",
    "install_steps": [
      "pip install open-autoglm",
      "Verify: open-autoglm --version",
      "supercli plugins install ./plugins/Open-AutoGLM --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Open-AutoGLM",
      "resource": "self",
      "action": "version",
      "description": "Print Open-AutoGLM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-autoglm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Open-AutoGLM: pip install open-autoglm"
      },
      "args": []
    },
    {
      "namespace": "Open-AutoGLM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to open-autoglm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-autoglm",
        "passthrough": true,
        "missingDependencyHelp": "Install Open-AutoGLM: pip install open-autoglm"
      },
      "args": []
    }
  ]
}