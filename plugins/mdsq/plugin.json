{
  "name": "mdsq",
  "version": "0.1.0",
  "description": "Query Markdown files using a SQL-like syntax",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "mdsq" }],
  "install_guidance": {
    "plugin": "mdsq",
    "binary": "mdsq",
    "check": "which mdsq",
    "install_steps": ["pip install mdsq", "Verify: mdsq --version", "supercli plugins install ./plugins/mdsq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdsq",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdsq CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdsq",
      "passthrough": true,
      "missingDependencyHelp": "Install mdsq: pip install mdsq"
    },
    "args": []
  }]
}
