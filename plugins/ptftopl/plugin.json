{
  "name": "ptftopl",
  "version": "0.1.0",
  "description": "CLI tool: ptftopl",
  "source": "https://manpages.debian.org/ptftopl",
  "checks": [
    {
      "type": "binary",
      "name": "ptftopl"
    }
  ],
  "install_guidance": {
    "plugin": "ptftopl",
    "binary": "ptftopl",
    "check": "which ptftopl",
    "install_steps": [
      "apt-get install ptftopl 2>/dev/null || which ptftopl",
      "Verify: ptftopl --version",
      "supercli plugins install ./plugins/ptftopl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ptftopl",
      "resource": "self",
      "action": "version",
      "description": "Print ptftopl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ptftopl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ptftopl: apt-get install ptftopl 2>/dev/null || which ptftopl"
      },
      "args": []
    },
    {
      "namespace": "ptftopl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ptftopl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ptftopl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ptftopl: apt-get install ptftopl 2>/dev/null || which ptftopl"
      },
      "args": []
    }
  ]
}