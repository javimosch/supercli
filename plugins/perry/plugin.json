{
  "name": "perry",
  "version": "0.1.0",
  "description": "Fast TypeScript compiler and type checker written in Rust",
  "source": "https://github.com/nicoburniske/perry",
  "checks": [
    {
      "type": "binary",
      "name": "perry"
    }
  ],
  "install_guidance": {
    "plugin": "perry",
    "binary": "perry",
    "check": "which perry",
    "install_steps": [
      "cargo install perry-typescript",
      "Verify: perry --version",
      "supercli plugins install ./plugins/perry --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "perry",
      "resource": "self",
      "action": "version",
      "description": "Print perry version",
      "adapter": "process",
      "adapterConfig": {
        "command": "perry",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install perry: cargo install perry-typescript"
      },
      "args": []
    },
    {
      "namespace": "perry",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to perry CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "perry",
        "passthrough": true,
        "missingDependencyHelp": "Install perry: cargo install perry-typescript"
      },
      "args": []
    }
  ]
}
