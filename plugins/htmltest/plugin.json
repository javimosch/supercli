{
  "name": "htmltest",
  "version": "0.1.0",
  "description": "HTML validator written in Go",
  "source": "https://github.com/wjdp/htmltest",
  "checks": [
    {
      "type": "binary",
      "name": "htmltest"
    }
  ],
  "install_guidance": {
    "plugin": "htmltest",
    "binary": "htmltest",
    "check": "which htmltest",
    "install_steps": [
      "brew install htmltest",
      "Verify: htmltest --version",
      "supercli plugins install ./plugins/htmltest --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "htmltest",
      "resource": "self",
      "action": "version",
      "description": "Print htmltest version",
      "adapter": "process",
      "adapterConfig": {
        "command": "htmltest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install htmltest: brew install htmltest"
      },
      "args": []
    },
    {
      "namespace": "htmltest",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to htmltest CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "htmltest",
        "passthrough": true,
        "missingDependencyHelp": "Install htmltest"
      },
      "args": []
    }
  ]
}