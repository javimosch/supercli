{
  "name": "kerneloops-submit",
  "version": "0.1.0",
  "description": "CLI tool: kerneloops-submit",
  "source": "https://manpages.debian.org/kerneloops-submit",
  "checks": [
    {
      "type": "binary",
      "name": "kerneloops-submit"
    }
  ],
  "install_guidance": {
    "plugin": "kerneloops-submit",
    "binary": "kerneloops-submit",
    "check": "which kerneloops-submit",
    "install_steps": [
      "apt-get install kerneloops-submit 2>/dev/null || which kerneloops-submit",
      "Verify: kerneloops-submit --version",
      "supercli plugins install ./plugins/kerneloops-submit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kerneloops-submit",
      "resource": "self",
      "action": "version",
      "description": "Print kerneloops-submit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kerneloops-submit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kerneloops-submit: apt-get install kerneloops-submit 2>/dev/null || which kerneloops-submit"
      },
      "args": []
    },
    {
      "namespace": "kerneloops-submit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kerneloops-submit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kerneloops-submit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install kerneloops-submit: apt-get install kerneloops-submit 2>/dev/null || which kerneloops-submit"
      },
      "args": []
    }
  ]
}