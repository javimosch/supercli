{
  "name": "rustysd",
  "version": "0.1.0",
  "description": "Minimalist service manager compatible with systemd units",
  "source": "https://github.com/KillingSpark/rustysd",
  "checks": [{ "type": "binary", "name": "rustysd" }],
  "install_guidance": {
    "plugin": "rustysd",
    "binary": "rustysd",
    "check": "which rustysd",
    "install_steps": ["cargo install rustysd", "Verify: rustysd --version", "supercli plugins install ./plugins/rustysd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rustysd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rustysd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rustysd",
      "passthrough": true,
      "missingDependencyHelp": "Install rustysd: cargo install rustysd", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
