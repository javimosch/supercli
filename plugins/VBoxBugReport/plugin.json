{
  "name": "VBoxBugReport",
  "version": "0.1.0",
  "description": "CLI tool: VBoxBugReport",
  "source": "https://manpages.debian.org/VBoxBugReport",
  "checks": [
    {
      "type": "binary",
      "name": "VBoxBugReport"
    }
  ],
  "install_guidance": {
    "plugin": "VBoxBugReport",
    "binary": "VBoxBugReport",
    "check": "which VBoxBugReport",
    "install_steps": [
      "apt-get install VBoxBugReport 2>/dev/null || which VBoxBugReport",
      "Verify: VBoxBugReport --version",
      "supercli plugins install ./plugins/VBoxBugReport --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VBoxBugReport",
      "resource": "self",
      "action": "version",
      "description": "Print VBoxBugReport version",
      "adapter": "process",
      "adapterConfig": {
        "command": "VBoxBugReport",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VBoxBugReport: apt-get install VBoxBugReport 2>/dev/null || which VBoxBugReport"
      },
      "args": []
    },
    {
      "namespace": "VBoxBugReport",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to VBoxBugReport CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "VBoxBugReport",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install VBoxBugReport: apt-get install VBoxBugReport 2>/dev/null || which VBoxBugReport"
      },
      "args": []
    }
  ]
}