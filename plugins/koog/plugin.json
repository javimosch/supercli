{
  "name": "koog",
  "version": "0.1.0",
  "description": "Koog is a JVM (Java and Kotlin) framework for building predictable, fault-tolerant and enterprise-re",
  "source": "https://github.com/koog/koog",
  "checks": [
    {
      "type": "binary",
      "name": "koog"
    }
  ],
  "install_guidance": {
    "plugin": "koog",
    "binary": "koog",
    "check": "which koog",
    "install_steps": [
      "pip install koog",
      "Verify: koog --version",
      "supercli plugins install ./plugins/koog --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "koog",
      "resource": "self",
      "action": "version",
      "description": "Print koog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "koog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install koog: pip install koog"
      },
      "args": []
    },
    {
      "namespace": "koog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to koog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "koog",
        "passthrough": true,
        "missingDependencyHelp": "Install koog: pip install koog"
      },
      "args": []
    }
  ]
}