{
  "name": "mjpegtools",
  "version": "0.1.0",
  "description": "MJPEG video processing tools",
  "source": "https://github.com/dericed/mjpegtools",
  "checks": [
    {
      "type": "binary",
      "name": "mjpegtools"
    }
  ],
  "install_guidance": {
    "plugin": "mjpegtools",
    "binary": "mjpegtools",
    "check": "which mjpegtools",
    "install_steps": [
      "brew install mjpegtools",
      "Verify: mjpegtools --version",
      "supercli plugins install ./plugins/mjpegtools --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "mjpegtools",
      "resource": "self",
      "action": "version",
      "description": "Print mjpegtools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mjpegtools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mjpegtools: brew install mjpegtools"
      },
      "args": []
    },
    {
      "namespace": "mjpegtools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mjpegtools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mjpegtools",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mjpegtools: brew install mjpegtools"
      },
      "args": []
    }
  ]
}
