{
  "name": "pre-commit-ci",
  "version": "0.1.0",
  "description": "Framework for managing multi-language pre-commit hooks",
  "source": "https://github.com/pre-commit/pre-commit",
  "checks": [{ "type": "binary", "name": "pre-commit" }],
  "install_guidance": {
    "plugin": "pre-commit-ci",
    "binary": "pre-commit",
    "check": "which pre-commit",
    "install_steps": ["pip install pre-commit", "Verify: pre-commit --version", "supercli plugins install ./plugins/pre-commit-ci --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pre-commit-ci",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pre-commit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pre-commit",
      "passthrough": true,
      "missingDependencyHelp": "Install pre-commit-ci: pip install pre-commit"
    },
    "args": []
  }]
}
