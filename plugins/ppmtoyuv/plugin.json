{
  "name": "ppmtoyuv",
  "version": "0.1.0",
  "description": "CLI tool: ppmtoyuv",
  "source": "https://manpages.debian.org/ppmtoyuv",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtoyuv"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtoyuv",
    "binary": "ppmtoyuv",
    "check": "which ppmtoyuv",
    "install_steps": [
      "apt-get install ppmtoyuv 2>/dev/null || which ppmtoyuv",
      "Verify: ppmtoyuv --version",
      "supercli plugins install ./plugins/ppmtoyuv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtoyuv",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtoyuv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoyuv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtoyuv: apt-get install ppmtoyuv 2>/dev/null || which ppmtoyuv"
      },
      "args": []
    },
    {
      "namespace": "ppmtoyuv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtoyuv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoyuv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtoyuv: apt-get install ppmtoyuv 2>/dev/null || which ppmtoyuv"
      },
      "args": []
    }
  ]
}