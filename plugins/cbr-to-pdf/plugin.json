{
  "name": "cbr-to-pdf",
  "version": "0.1.0",
  "description": "Convert comic book archives to optimized PDF",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "cbr-to-pdf" }],
  "install_guidance": {
    "plugin": "cbr-to-pdf",
    "binary": "cbr-to-pdf",
    "check": "which cbr-to-pdf",
    "install_steps": ["pip install cbr-to-pdf", "Verify: cbr-to-pdf --version", "supercli plugins install ./plugins/cbr-to-pdf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cbr-to-pdf",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cbr-to-pdf CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cbr-to-pdf",
      "passthrough": true,
      "missingDependencyHelp": "Install cbr-to-pdf: pip install cbr-to-pdf"
    },
    "args": []
  }]
}
