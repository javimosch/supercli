{
  "plugin": "pw-dot",
  "binary": "pw-dot",
  "check": "which pw-dot",
  "install_steps": [
    "apt-get install pw-dot 2>/dev/null || which pw-dot",
    "Verify: pw-dot --version",
    "supercli plugins install ./plugins/pw-dot --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}