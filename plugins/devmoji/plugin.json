{
  "name": "devmoji",
  "version": "0.1.0",
  "description": "Emojify conventional commits in TypeScript",
  "source": "https://github.com/typicode/devmoji",
  "checks": [
    {
      "type": "binary",
      "name": "devmoji"
    }
  ],
  "install_guidance": {
    "plugin": "devmoji",
    "binary": "devmoji",
    "check": "which devmoji",
    "install_steps": [
      "npm install -g devmoji",
      "Verify: devmoji --version",
      "supercli plugins install ./plugins/devmoji --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "devmoji",
      "resource": "self",
      "action": "version",
      "description": "Print devmoji version",
      "adapter": "process",
      "adapterConfig": {
        "command": "devmoji",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install devmoji: npm install -g devmoji"
      },
      "args": []
    },
    {
      "namespace": "devmoji",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to devmoji CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "devmoji",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install devmoji: npm install -g devmoji"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
