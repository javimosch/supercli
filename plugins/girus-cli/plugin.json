{
  "name": "girus-cli",
  "version": "0.1.0",
  "description": "Interactive CLI tool for DevOps labs and practice",
  "source": "https://github.com/badtuxx/girus-cli",
  "checks": [
    {
      "type": "binary",
      "name": "girus"
    }
  ],
  "install_guidance": {
    "plugin": "girus-cli",
    "binary": "girus",
    "check": "which girus",
    "install_steps": [
      "go install github.com/badtuxx/girus-cli@latest",
      "Verify: girus --version",
      "supercli plugins install ./plugins/girus-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "girus-cli",
    "resource": "self",
    "action": "version",
    "description": "Print girus-cli version",
    "adapter": "process",
    "adapterConfig": {
      "command": "girus",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install girus-cli: go install github.com/badtuxx/girus-cli@latest"
    },
    "args": []
  },
  {
    "namespace": "girus-cli",
    "resource": "lab",
    "action": "start",
    "description": "Start an interactive lab",
    "adapter": "process",
    "adapterConfig": {
      "command": "girus",
      "passthrough": true,
      "missingDependencyHelp": "Install girus-cli: go install github.com/badtuxx/girus-cli@latest"
    },
    "args": []
  },
  {
    "namespace": "girus-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to girus CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "girus",
      "passthrough": true,
      "missingDependencyHelp": "Install girus-cli"
    },
    "args": []
  }
]
}