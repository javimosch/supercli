  "commands": [{
    "namespace": "dh_movefiles", "resource": "_", "action": "_",
    "description": "Passthrough to dh_movefiles CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_movefiles", "passthrough": true, "missingDependencyHelp": "Install dh_movefiles: apt-get install dh_movefiles" }, "args": []
  }]
}
