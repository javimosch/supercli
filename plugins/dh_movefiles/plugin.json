{
  "name": "dh_movefiles",
  "version": "0.1.0",
  "description": "CLI tool: dh_movefiles",
  "source": "https://packages.debian.org/dh_movefiles",
  "checks": [{ "type": "binary", "name": "dh_movefiles" }],
  "install_guidance": {
    "plugin": "dh_movefiles", "binary": "dh_movefiles", "check": "which dh_movefiles",
    "install_steps": ["apt-get install dh_movefiles 2>/dev/null || which dh_movefiles", "Verify: dh_movefiles --version", "supercli plugins install ./plugins/dh_movefiles --on-conflict replace --json"]
