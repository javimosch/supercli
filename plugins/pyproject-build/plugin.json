{
  "name": "pyproject-build",
  "version": "0.1.0",
  "description": "CLI tool: pyproject-build",
  "source": "https://manpages.debian.org/pyproject-build",
  "checks": [
    {
      "type": "binary",
      "name": "pyproject-build"
    }
  ],
  "install_guidance": {
    "plugin": "pyproject-build",
    "binary": "pyproject-build",
    "check": "which pyproject-build",
    "install_steps": [
      "apt-get install pyproject-build 2>/dev/null || which pyproject-build",
      "Verify: pyproject-build --version",
      "supercli plugins install ./plugins/pyproject-build --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyproject-build",
      "resource": "self",
      "action": "version",
      "description": "Print pyproject-build version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyproject-build",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyproject-build: apt-get install pyproject-build 2>/dev/null || which pyproject-build"
      },
      "args": []
    },
    {
      "namespace": "pyproject-build",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyproject-build CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyproject-build",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyproject-build: apt-get install pyproject-build 2>/dev/null || which pyproject-build"
      },
      "args": []
    }
  ]
}