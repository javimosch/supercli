{
  "name": "notify-send",
  "version": "0.1.0",
  "description": "CLI tool: notify-send",
  "source": "https://manpages.debian.org/notify-send",
  "checks": [
    {
      "type": "binary",
      "name": "notify-send"
    }
  ],
  "install_guidance": {
    "plugin": "notify-send",
    "binary": "notify-send",
    "check": "which notify-send",
    "install_steps": [
      "apt-get install notify-send 2>/dev/null || which notify-send",
      "Verify: notify-send --version",
      "supercli plugins install ./plugins/notify-send --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "notify-send",
      "resource": "self",
      "action": "version",
      "description": "Print notify-send version",
      "adapter": "process",
      "adapterConfig": {
        "command": "notify-send",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install notify-send: apt-get install notify-send 2>/dev/null || which notify-send"
      },
      "args": []
    },
    {
      "namespace": "notify-send",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to notify-send CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "notify-send",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install notify-send: apt-get install notify-send 2>/dev/null || which notify-send"
      },
      "args": []
    }
  ]
}