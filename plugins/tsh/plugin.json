{
  "name": "tsh",
  "version": "0.1.0",
  "description": "Minimalist terminal session sharing utility",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "tsh" }],
  "install_guidance": {
    "plugin": "tsh",
    "binary": "tsh",
    "check": "which tsh",
    "install_steps": ["npm install -g tsh", "Verify: tsh --version", "supercli plugins install ./plugins/tsh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tsh",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tsh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tsh",
      "passthrough": true,
      "missingDependencyHelp": "Install tsh: npm install -g tsh"
    },
    "args": []
  }]
}
