{
  "name": "ntfstruncate",
  "version": "1.0.0",
  "description": "ntfstruncate \u2014 ntfstruncate \u2014 CLI utility",
  "source": "/usr/bin/ntfstruncate",
  "checks": [
    {
      "type": "binary",
      "name": "ntfstruncate"
    }
  ],
  "install_guidance": {
    "plugin": "ntfstruncate",
    "binary": "ntfstruncate",
    "check": "which ntfstruncate",
    "install_steps": [
      "# Install ntfstruncate:",
      "# apt: sudo apt-get install ntfstruncate",
      "# brew: brew install ntfstruncate",
      "# cargo: cargo install ntfstruncate",
      "# npm: npm install -g ntfstruncate",
      "# pip: pip install ntfstruncate",
      "# or download from /usr/bin/ntfstruncate"
    ]
  },
  "commands": [
    {
      "namespace": "ntfstruncate",
      "resource": "ntfstruncate",
      "action": "run",
      "description": "Run ntfstruncate",
      "adapter": "process",
      "adapterConfig": {
        "command": "ntfstruncate",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ntfstruncate from /usr/bin/ntfstruncate"
      },
      "args": []
    }
  ]
}