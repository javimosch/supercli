{
  "name": "groupmod",
  "version": "0.1.0",
  "description": "CLI tool: groupmod",
  "source": "https://manpages.debian.org/groupmod",
  "checks": [
    {
      "type": "binary",
      "name": "groupmod"
    }
  ],
  "install_guidance": {
    "plugin": "groupmod",
    "binary": "groupmod",
    "check": "which groupmod",
    "install_steps": [
      "apt-get install groupmod 2>/dev/null || which groupmod",
      "Verify: groupmod --version",
      "supercli plugins install ./plugins/groupmod --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "groupmod",
      "resource": "self",
      "action": "version",
      "description": "Print groupmod version",
      "adapter": "process",
      "adapterConfig": {
        "command": "groupmod",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install groupmod: apt-get install groupmod 2>/dev/null || which groupmod"
      },
      "args": []
    },
    {
      "namespace": "groupmod",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to groupmod CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "groupmod",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install groupmod: apt-get install groupmod 2>/dev/null || which groupmod"
      },
      "args": []
    }
  ]
}