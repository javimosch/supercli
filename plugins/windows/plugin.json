{
  "name": "windows",
  "version": "0.1.0",
  "description": "Windows inside a Docker container.",
  "source": "https://github.com/windows/windows",
  "checks": [
    {
      "type": "binary",
      "name": "windows"
    }
  ],
  "install_guidance": {
    "plugin": "windows",
    "binary": "windows",
    "check": "which windows",
    "install_steps": [
      "pip install windows",
      "Verify: windows --version",
      "supercli plugins install ./plugins/windows --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "windows",
      "resource": "self",
      "action": "version",
      "description": "Print windows version",
      "adapter": "process",
      "adapterConfig": {
        "command": "windows",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install windows: pip install windows"
      },
      "args": []
    },
    {
      "namespace": "windows",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to windows CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "windows",
        "passthrough": true,
        "missingDependencyHelp": "Install windows: pip install windows"
      },
      "args": []
    }
  ]
}