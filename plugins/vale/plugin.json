{
  "name": "vale",
  "version": "0.1.0",
  "description": "Grammar and style checker with --output JSON",
  "source": "https://github.com/errata-ai/vale",
  "checks": [
    {
      "type": "binary",
      "name": "vale"
    }
  ],
  "install_guidance": {
    "plugin": "vale",
    "binary": "vale",
    "check": "which vale",
    "install_steps": [
      "brew install vale",
      "Verify: vale --version",
      "supercli plugins install ./plugins/vale --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "vale",
      "resource": "self",
      "action": "version",
      "description": "Print vale version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vale",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vale: brew install vale"
      },
      "args": []
    },
    {
      "namespace": "vale",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vale CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vale",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vale: brew install vale"
      },
      "args": []
    }
  ]
}
