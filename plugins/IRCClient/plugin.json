{
  "name": "IRCClient",
  "version": "0.1.0",
  "description": "Simple cross-platform console IRC client written in C++",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "IRCClient" }],
  "install_guidance": {
    "plugin": "IRCClient",
    "binary": "IRCClient",
    "check": "which IRCClient",
    "install_steps": ["g++ IRCClient.cpp -o ircclient", "Verify: IRCClient --version", "supercli plugins install ./plugins/IRCClient --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "IRCClient",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to IRCClient CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "IRCClient",
      "passthrough": true,
      "missingDependencyHelp": "Install IRCClient: g++ IRCClient.cpp -o ircclient"
    },
    "args": []
  }]
}
