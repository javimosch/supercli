{
  "name": "postman",
  "version": "0.1.0",
  "description": "CLI tool for batch-sending email via SMTP in Go",
  "source": "https://github.com/rustyclg/postman",
  "checks": [{"type": "binary", "name": "postman"}],
  "install_guidance": {
    "plugin": "postman",
    "binary": "postman",
    "check": "which postman",
    "install_steps": [
      "go install github.com/rustyclg/postman@latest",
      "Verify: postman --version",
      "supercli plugins install ./postman --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "postman",
      "resource": "self",
      "action": "version",
      "description": "Print postman version",
      "adapter": "process",
      "adapterConfig": {"command": "postman", "baseArgs": ["--version"], "missingDependencyHelp": "Install postman: go install github.com/rustyclg/postman@latest"},
      "args": []
    },
    {
      "namespace": "postman",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to postman CLI",
      "adapter": "process",
      "adapterConfig": {"command": "postman", "passthrough": true, "missingDependencyHelp": "Install postman: go install github.com/rustyclg/postman@latest"},
      "args": []
    }
  ]
}
