{
  "name": "hash-buster",
  "version": "0.1.0",
  "description": "Simple hash identification and cracking utility",
  "source": "https://github.com/s0md3v/Hash-Buster",
  "checks": [{ "type": "binary", "name": "hash-buster" }],
  "install_guidance": {
    "plugin": "hash-buster",
    "binary": "hash-buster",
    "check": "which hash-buster",
    "install_steps": ["pip install hash-buster", "Verify: hash-buster --version", "supercli plugins install ./plugins/hash-buster --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hash-buster",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hash-buster CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hash-buster",
      "passthrough": true,
      "missingDependencyHelp": "Install hash-buster: pip install hash-buster", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
