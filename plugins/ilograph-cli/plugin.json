{
  "name": "ilograph-cli",
  "version": "0.1.0",
  "description": "Interactive system architecture diagram CLI renderer",
  "source": "https://github.com/ilograph/ilograph",
  "checks": [{ "type": "binary", "name": "ilograph-cli" }],
  "install_guidance": {
    "plugin": "ilograph-cli",
    "binary": "ilograph-cli",
    "check": "which ilograph-cli",
    "install_steps": ["npm install -g ilograph", "Verify: ilograph-cli --version", "supercli plugins install ./plugins/ilograph-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ilograph-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ilograph-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ilograph-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install ilograph-cli: npm install -g ilograph", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
