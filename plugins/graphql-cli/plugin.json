{
  "name": "graphql-cli",
  "version": "0.1.0",
  "description": "Command line tool for GraphQL schema operations and queries",
  "source": "https://github.com/Urigo/graphql-cli",
  "checks": [{ "type": "binary", "name": "graphql-cli" }],
  "install_guidance": {
    "plugin": "graphql-cli",
    "binary": "graphql-cli",
    "check": "which graphql-cli",
    "install_steps": ["npm install -g graphql-cli", "Verify: graphql-cli --version", "supercli plugins install ./plugins/graphql-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "graphql-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to graphql-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "graphql-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install graphql-cli: npm install -g graphql-cli"
    },
    "args": []
  }]
}
