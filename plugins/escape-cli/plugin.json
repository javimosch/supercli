{
  "name": "escape-cli",
  "version": "0.1.0",
  "description": "`escape-cli` command escapes the stdin and outputs the result to stdout.",
  "source": "https://github.com/escape-cli/escape-cli",
  "checks": [
    {
      "type": "binary",
      "name": "escape-cli"
    }
  ],
  "install_guidance": {
    "plugin": "escape-cli",
    "binary": "escape-cli",
    "check": "which escape-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: escape-cli --version",
      "supercli plugins install ./plugins/escape-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "escape-cli",
      "resource": "self",
      "action": "version",
      "description": "Print escape-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "escape-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install escape-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "escape-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to escape-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "escape-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install escape-cli from project repository"
      },
      "args": []
    }
  ]
}