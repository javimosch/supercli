{
  "name": "hy",
  "version": "0.1.0",
  "description": "Dialect of Lisp that's embedded in Python",
  "source": "https://github.com/hylang/hy",
  "checks": [
    {
      "type": "binary",
      "name": "hy"
    }
  ],
  "install_guidance": {
    "plugin": "hy",
    "binary": "hy",
    "check": "which hy",
    "install_steps": [
      "brew install hy",
      "Verify: hy --version",
      "supercli plugins install ./plugins/hy --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hy",
      "resource": "self",
      "action": "version",
      "description": "Print hy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hy: brew install hy"
      },
      "args": []
    },
    {
      "namespace": "hy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hy",
        "passthrough": true,
        "missingDependencyHelp": "Install hy"
      },
      "args": []
    }
  ]
}