{
  "name": "bitchat",
  "version": "0.1.0",
  "description": "bluetooth mesh chat, IRC vibes",
  "source": "https://github.com/bitchat/bitchat",
  "checks": [
    {
      "type": "binary",
      "name": "bitchat"
    }
  ],
  "install_guidance": {
    "plugin": "bitchat",
    "binary": "bitchat",
    "check": "which bitchat",
    "install_steps": [
      "pip install bitchat",
      "Verify: bitchat --version",
      "supercli plugins install ./plugins/bitchat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bitchat",
      "resource": "self",
      "action": "version",
      "description": "Print bitchat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitchat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bitchat: pip install bitchat"
      },
      "args": []
    },
    {
      "namespace": "bitchat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bitchat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitchat",
        "passthrough": true,
        "missingDependencyHelp": "Install bitchat: pip install bitchat"
      },
      "args": []
    }
  ]
}