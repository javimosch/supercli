{
  "name": "gitbackup",
  "version": "0.1.0",
  "description": "Tool to backup your Bitbucket, GitHub and GitLab repositories",
  "source": "https://github.com/amitsaha/gitbackup",
  "checks": [
    {
      "type": "binary",
      "name": "gitbackup"
    }
  ],
  "install_guidance": {
    "plugin": "gitbackup",
    "binary": "gitbackup",
    "check": "which gitbackup",
    "install_steps": [
      "brew install gitbackup",
      "Verify: gitbackup --version",
      "supercli plugins install ./plugins/gitbackup --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitbackup",
      "resource": "self",
      "action": "version",
      "description": "Print gitbackup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitbackup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitbackup: brew install gitbackup"
      },
      "args": []
    },
    {
      "namespace": "gitbackup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitbackup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitbackup",
        "passthrough": true,
        "missingDependencyHelp": "Install gitbackup"
      },
      "args": []
    }
  ]
}