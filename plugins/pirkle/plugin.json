{
  "name": "pirkle",
  "version": "0.1.0",
  "description": "A fast CLI to query CSV, SQLite, and JSON files using PRQL (Pipelined Relational Query Language). Transforms, filters, and joins data in pipelines.",
  "source": "https://github.com/dloss/pirkle",
  "checks": [{ "type": "binary", "name": "pirkle" }],
  "install_guidance": {
    "plugin": "pirkle",
    "binary": "pirkle",
    "check": "which pirkle",
    "install_steps": ["cargo install pirkle", "Verify: pirkle --version", "supercli plugins install ./plugins/pirkle --on-conflict replace --json"]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "pirkle", "resource": "self", "action": "version", "description": "Print pirkle version", "adapter": "process", "adapterConfig": { "command": "pirkle", "baseArgs": ["--version"], "missingDependencyHelp": "Install pirkle: cargo install pirkle" }, "args": [] },
    { "namespace": "pirkle", "resource": "_", "action": "_", "description": "Passthrough to pirkle CLI", "adapter": "process", "adapterConfig": { "command": "pirkle", "passthrough": true, "missingDependencyHelp": "Install pirkle: cargo install pirkle" }, "args": [] }
  ]
}
