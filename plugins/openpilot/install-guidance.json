{
  "plugin": "openpilot",
  "binary": "openpilot",
  "check": "which openpilot",
  "install_steps": [
    "git clone https://github.com/commaai/openpilot.git",
    "Verify: openpilot --version",
    "supercli plugins install ./plugins/openpilot --on-conflict replace --json"
  ],
  "note": "openpilot is an embedded driving system, not a standalone CLI; it runs on comma hardware."
}
