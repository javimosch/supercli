{
  "name": "openpilot",
  "version": "0.1.0",
  "description": "OpenPilot — open-source autonomous driving system",
  "source": "https://github.com/commaai/openpilot",
  "checks": [
    {
      "type": "binary",
      "name": "openpilot"
    }
  ],
  "install_guidance": {
    "plugin": "openpilot",
    "binary": "openpilot",
    "check": "which openpilot",
    "install_steps": [
      "git clone https://github.com/commaai/openpilot.git",
      "Verify: openpilot --version",
      "supercli plugins install ./plugins/openpilot --on-conflict replace --json"
    ],
    "note": "openpilot is an embedded driving system, not a standalone CLI; it runs on comma hardware."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openpilot",
      "resource": "self",
      "action": "version",
      "description": "Print openpilot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openpilot",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install openpilot: git clone https://github.com/commaai/openpilot.git"
      },
      "args": []
    }
  ]
}
