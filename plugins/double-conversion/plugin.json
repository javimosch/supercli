{
  "name": "double-conversion",
  "version": "0.1.0",
  "description": "Binary-decimal and decimal-binary routines for IEEE doubles",
  "source": "https://github.com/google/double-conversion",
  "checks": [
    {
      "type": "binary",
      "name": "double-conversion"
    }
  ],
  "install_guidance": {
    "plugin": "double-conversion",
    "binary": "double-conversion",
    "check": "which double-conversion",
    "install_steps": [
      "brew install double-conversion",
      "Verify: double-conversion --version",
      "supercli plugins install ./plugins/double-conversion --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "double-conversion",
      "resource": "self",
      "action": "version",
      "description": "Print double-conversion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "double-conversion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install double-conversion: brew install double-conversion"
      },
      "args": []
    },
    {
      "namespace": "double-conversion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to double-conversion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "double-conversion",
        "passthrough": true,
        "missingDependencyHelp": "Install double-conversion"
      },
      "args": []
    }
  ]
}