{
  "name": "gibr",
  "version": "0.1.0",
  "description": "Smarter CLI for creating git branches",
  "source": "https://github.com/gibr/gibr",
  "checks": [
    {
      "type": "binary",
      "name": "gibr"
    }
  ],
  "install_guidance": {
    "plugin": "gibr",
    "binary": "gibr",
    "check": "which gibr",
    "install_steps": [
      "pip install gibr",
      "Verify: gibr --version",
      "supercli plugins install ./plugins/gibr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gibr",
      "resource": "self",
      "action": "version",
      "description": "Print gibr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gibr",
        "missingDependencyHelp": "Install gibr: pip install gibr",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "gibr",
      "resource": "branch",
      "action": "create",
      "description": "Create a smart git branch",
      "adapter": "process",
      "adapterConfig": {
        "command": "gibr",
        "missingDependencyHelp": "Install gibr: pip install gibr",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "gibr",
      "resource": "branch",
      "action": "list",
      "description": "List branches created with gibr",
      "adapter": "process",
      "adapterConfig": {
        "command": "gibr",
        "missingDependencyHelp": "Install gibr: pip install gibr",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "gibr",
      "resource": "branch",
      "action": "cleanup",
      "description": "Clean up merged branches",
      "adapter": "process",
      "adapterConfig": {
        "command": "gibr",
        "missingDependencyHelp": "Install gibr: pip install gibr",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "gibr",
      "resource": "_",
      "action": "_",
      "description": "_ _ via gibr",
      "adapter": "process",
      "adapterConfig": {
        "command": "gibr",
        "missingDependencyHelp": "Install gibr: pip install gibr",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
