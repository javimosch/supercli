{
  "name": "levant",
  "version": "0.1.0",
  "description": "Templating and deployment tool for HashiCorp Nomad jobs",
  "source": "https://github.com/hashicorp/levant",
  "checks": [{ "type": "binary", "name": "levant" }],
  "install_guidance": {
    "plugin": "levant",
    "binary": "levant",
    "check": "which levant",
    "install_steps": ["brew install levant", "Verify: levant --version", "supercli plugins install ./plugins/levant --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "levant",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to levant CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "levant",
      "passthrough": true,
      "missingDependencyHelp": "Install levant: brew install levant"
    },
    "args": []
  }]
}
