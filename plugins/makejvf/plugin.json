{
  "name": "makejvf",
  "version": "0.1.0",
  "description": "CLI tool: makejvf",
  "source": "https://manpages.debian.org/makejvf",
  "checks": [
    {
      "type": "binary",
      "name": "makejvf"
    }
  ],
  "install_guidance": {
    "plugin": "makejvf",
    "binary": "makejvf",
    "check": "which makejvf",
    "install_steps": [
      "apt-get install makejvf 2>/dev/null || which makejvf",
      "Verify: makejvf --version",
      "supercli plugins install ./plugins/makejvf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "makejvf",
      "resource": "self",
      "action": "version",
      "description": "Print makejvf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "makejvf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install makejvf: apt-get install makejvf 2>/dev/null || which makejvf"
      },
      "args": []
    },
    {
      "namespace": "makejvf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to makejvf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "makejvf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install makejvf: apt-get install makejvf 2>/dev/null || which makejvf"
      },
      "args": []
    }
  ]
}