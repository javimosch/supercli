{
  "name": "lighthouse",
  "version": "0.1.0",
  "description": "Google Lighthouse website quality audit",
  "source": "https://github.com/GoogleChrome/lighthouse",
  "checks": [
    {
      "type": "binary",
      "name": "lighthouse"
    }
  ],
  "install_guidance": {
    "plugin": "lighthouse",
    "binary": "lighthouse",
    "check": "which lighthouse",
    "install_steps": [
      "npm install -g lighthouse",
      "Verify: lighthouse --version",
      "supercli plugins install ./plugins/lighthouse --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "lighthouse",
      "resource": "self",
      "action": "version",
      "description": "Print lighthouse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lighthouse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lighthouse: npm install -g lighthouse"
      },
      "args": []
    },
    {
      "namespace": "lighthouse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lighthouse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lighthouse",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lighthouse: npm install -g lighthouse"
      },
      "args": []
    }
  ]
}
