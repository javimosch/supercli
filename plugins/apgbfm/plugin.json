{
  "name": "apgbfm",
  "version": "0.1.0",
  "description": "CLI tool: apgbfm",
  "source": "https://packages.debian.org/apgbfm",
  "checks": [{ "type": "binary", "name": "apgbfm" }],
  "install_guidance": {
    "plugin": "apgbfm", "binary": "apgbfm", "check": "which apgbfm",
    "install_steps": ["apt-get install apgbfm 2>/dev/null || which apgbfm", "Verify: apgbfm --version", "supercli plugins install ./plugins/apgbfm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apgbfm", "resource": "_", "action": "_",
    "description": "Passthrough to apgbfm CLI",
    "adapter": "process", "adapterConfig": { "command": "apgbfm", "passthrough": true, "missingDependencyHelp": "Install apgbfm: apt-get install apgbfm" }, "args": []
  }]
}
