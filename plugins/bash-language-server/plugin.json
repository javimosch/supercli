{
  "name": "bash-language-server",
  "version": "0.1.0",
  "description": "Language Server for Bash",
  "source": "https://github.com/bash-lsp/bash-language-server",
  "checks": [
    {
      "type": "binary",
      "name": "bash-language-server"
    }
  ],
  "install_guidance": {
    "plugin": "bash-language-server",
    "binary": "bash-language-server",
    "check": "which bash-language-server",
    "install_steps": [
      "brew install bash-language-server",
      "Verify: bash-language-server --version",
      "supercli plugins install ./plugins/bash-language-server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bash-language-server",
      "resource": "self",
      "action": "version",
      "description": "Print bash-language-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash-language-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bash-language-server: brew install bash-language-server"
      },
      "args": []
    },
    {
      "namespace": "bash-language-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bash-language-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash-language-server",
        "passthrough": true,
        "missingDependencyHelp": "Install bash-language-server"
      },
      "args": []
    }
  ]
}