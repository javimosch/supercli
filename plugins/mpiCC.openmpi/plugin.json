{
  "name": "mpiCC.openmpi",
  "version": "0.1.0",
  "description": "CLI tool: mpiCC.openmpi",
  "source": "https://manpages.debian.org/mpiCC.openmpi",
  "checks": [
    {
      "type": "binary",
      "name": "mpiCC.openmpi"
    }
  ],
  "install_guidance": {
    "plugin": "mpiCC.openmpi",
    "binary": "mpiCC.openmpi",
    "check": "which mpiCC.openmpi",
    "install_steps": [
      "apt-get install mpiCC.openmpi 2>/dev/null || which mpiCC.openmpi",
      "Verify: mpiCC.openmpi --version",
      "supercli plugins install ./plugins/mpiCC.openmpi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpiCC.openmpi",
      "resource": "self",
      "action": "version",
      "description": "Print mpiCC.openmpi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpiCC.openmpi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpiCC.openmpi: apt-get install mpiCC.openmpi 2>/dev/null || which mpiCC.openmpi"
      },
      "args": []
    },
    {
      "namespace": "mpiCC.openmpi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpiCC.openmpi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpiCC.openmpi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mpiCC.openmpi: apt-get install mpiCC.openmpi 2>/dev/null || which mpiCC.openmpi"
      },
      "args": []
    }
  ]
}