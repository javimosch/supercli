{
  "name": "sha256sums.txt",
  "version": "0.1.0",
  "description": "CLI tool: sha256sums.txt",
  "source": "https://manpages.debian.org/sha256sums.txt",
  "checks": [
    {
      "type": "binary",
      "name": "sha256sums.txt"
    }
  ],
  "install_guidance": {
    "plugin": "sha256sums.txt",
    "binary": "sha256sums.txt",
    "check": "which sha256sums.txt",
    "install_steps": [
      "apt-get install sha256sums.txt 2>/dev/null || which sha256sums.txt",
      "Verify: sha256sums.txt --version",
      "supercli plugins install ./plugins/sha256sums.txt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sha256sums.txt",
      "resource": "self",
      "action": "version",
      "description": "Print sha256sums.txt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sha256sums.txt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sha256sums.txt: apt-get install sha256sums.txt 2>/dev/null || which sha256sums.txt"
      },
      "args": []
    },
    {
      "namespace": "sha256sums.txt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sha256sums.txt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sha256sums.txt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sha256sums.txt: apt-get install sha256sums.txt 2>/dev/null || which sha256sums.txt"
      },
      "args": []
    }
  ]
}