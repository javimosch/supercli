{
  "plugin": "c_rehash",
  "binary": "c_rehash",
  "check": "which c_rehash",
  "install_steps": [
    "# Install c_rehash",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/c_rehash-linux-amd64 -o /usr/local/bin/c_rehash",
    "chmod +x /usr/local/bin/c_rehash",
    "# Or via package manager, see /usr/bin/c_rehash"
  ]
}