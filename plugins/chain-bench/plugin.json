{
  "name": "chain-bench",
  "version": "0.1.0",
  "description": "Audit software supply chain security per CIS benchmarks",
  "source": "https://github.com/aquasecurity/chain-bench",
  "checks": [{ "type": "binary", "name": "chain-bench" }],
  "install_guidance": {
    "plugin": "chain-bench",
    "binary": "chain-bench",
    "check": "which chain-bench",
    "install_steps": ["brew install chain-bench", "Verify: chain-bench --version", "supercli plugins install ./plugins/chain-bench --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "chain-bench",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to chain-bench CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "chain-bench",
      "passthrough": true,
      "missingDependencyHelp": "Install chain-bench: brew install chain-bench"
    },
    "args": []
  }]
}
