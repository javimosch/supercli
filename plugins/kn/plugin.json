{
  "name": "kn",
  "version": "0.1.0",
  "description": "Command-line note-taking with search and tags",
  "source": "https://github.com/shikaan/kn",
  "checks": [{ "type": "binary", "name": "kn" }],
  "install_guidance": {
    "plugin": "kn",
    "binary": "kn",
    "check": "which kn",
    "install_steps": ["cargo install kn", "Verify: kn --version", "supercli plugins install ./plugins/kn --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kn",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kn CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kn",
      "passthrough": true,
      "missingDependencyHelp": "Install kn: cargo install kn", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
