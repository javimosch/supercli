{
  "name": "mapscii",
  "version": "0.1.0",
  "description": "Terminal Map Viewer",
  "source": "https://github.com/rastapasta/mapscii",
  "checks": [
    {
      "type": "binary",
      "name": "mapscii"
    }
  ],
  "install_guidance": {
    "plugin": "mapscii",
    "binary": "mapscii",
    "check": "which mapscii",
    "install_steps": [
      "brew install mapscii",
      "Verify: mapscii --version",
      "supercli plugins install ./plugins/mapscii --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "mapscii",
      "resource": "self",
      "action": "version",
      "description": "Print mapscii version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mapscii",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mapscii: brew install mapscii"
      },
      "args": []
    },
    {
      "namespace": "mapscii",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mapscii CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mapscii",
        "passthrough": true,
        "missingDependencyHelp": "Install mapscii"
      },
      "args": []
    }
  ]
}