{
  "name": "oxlint",
  "version": "0.1.0",
  "description": "Rust-based JavaScript/TypeScript linter 50-100x faster than ESLint",
  "source": "https://github.com/oxc-project/oxc",
  "checks": [
    {
      "type": "binary",
      "name": "oxlint"
    }
  ],
  "install_guidance": {
    "plugin": "oxlint",
    "binary": "oxlint",
    "check": "which oxlint",
    "install_steps": [
      "npm install -g oxlint",
      "Verify: oxlint --version",
      "supercli plugins install ./plugins/oxlint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "oxlint",
      "resource": "self",
      "action": "version",
      "description": "Print oxlint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxlint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oxlint: npm install -g oxlint"
      },
      "args": []
    },
    {
      "namespace": "oxlint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oxlint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oxlint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install oxlint: npm install -g oxlint"
      },
      "args": []
    }
  ]
}
