{
  "name": "awslogs",
  "version": "0.1.0",
  "description": "Simple command-line tool to read AWS CloudWatch logs",
  "source": "https://github.com/jorgebastida/awslogs",
  "checks": [
    {
      "type": "binary",
      "name": "awslogs"
    }
  ],
  "install_guidance": {
    "plugin": "awslogs",
    "binary": "awslogs",
    "check": "which awslogs",
    "install_steps": [
      "brew install awslogs",
      "Verify: awslogs --version",
      "supercli plugins install ./plugins/awslogs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "awslogs",
      "resource": "self",
      "action": "version",
      "description": "Print awslogs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awslogs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awslogs: brew install awslogs"
      },
      "args": []
    },
    {
      "namespace": "awslogs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awslogs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awslogs",
        "passthrough": true,
        "missingDependencyHelp": "Install awslogs"
      },
      "args": []
    }
  ]
}