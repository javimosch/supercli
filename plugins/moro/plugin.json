{
  "name": "moro",
  "version": "0.1.0",
  "description": "Simple CLI tool for tracking work hours in the terminal",
  "source": "go",
  "checks": [{ "type": "binary", "name": "moro" }],
  "install_guidance": {
    "plugin": "moro",
    "binary": "moro",
    "check": "which moro",
    "install_steps": ["go install github.com/moro@latest", "Verify: moro --version", "supercli plugins install ./plugins/moro --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "moro",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to moro CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "moro",
      "passthrough": true,
      "missingDependencyHelp": "Install moro: go install github.com/moro@latest"
    },
    "args": []
  }]
}
