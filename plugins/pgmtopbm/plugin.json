{
  "name": "pgmtopbm",
  "version": "0.1.0",
  "description": "CLI tool: pgmtopbm",
  "source": "https://manpages.debian.org/pgmtopbm",
  "checks": [
    {
      "type": "binary",
      "name": "pgmtopbm"
    }
  ],
  "install_guidance": {
    "plugin": "pgmtopbm",
    "binary": "pgmtopbm",
    "check": "which pgmtopbm",
    "install_steps": [
      "apt-get install pgmtopbm 2>/dev/null || which pgmtopbm",
      "Verify: pgmtopbm --version",
      "supercli plugins install ./plugins/pgmtopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgmtopbm",
      "resource": "self",
      "action": "version",
      "description": "Print pgmtopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmtopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgmtopbm: apt-get install pgmtopbm 2>/dev/null || which pgmtopbm"
      },
      "args": []
    },
    {
      "namespace": "pgmtopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgmtopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgmtopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pgmtopbm: apt-get install pgmtopbm 2>/dev/null || which pgmtopbm"
      },
      "args": []
    }
  ]
}