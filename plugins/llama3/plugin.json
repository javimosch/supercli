{
  "name": "llama3",
  "version": "0.1.0",
  "description": "The official Meta Llama 3 GitHub site",
  "source": "https://github.com/llama3/llama3",
  "checks": [
    {
      "type": "binary",
      "name": "llama3"
    }
  ],
  "install_guidance": {
    "plugin": "llama3",
    "binary": "llama3",
    "check": "which llama3",
    "install_steps": [
      "pip install llama3",
      "Verify: llama3 --version",
      "supercli plugins install ./plugins/llama3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "llama3",
      "resource": "self",
      "action": "version",
      "description": "Print llama3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llama3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llama3: pip install llama3"
      },
      "args": []
    },
    {
      "namespace": "llama3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llama3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llama3",
        "passthrough": true,
        "missingDependencyHelp": "Install llama3: pip install llama3"
      },
      "args": []
    }
  ]
}