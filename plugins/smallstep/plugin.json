{
  "name": "smallstep",
  "version": "0.1.0",
  "description": "Smallstep CLI for zero-trust certificates and workflows",
  "source": "https://github.com/smallstep/cli",
  "checks": [{ "type": "binary", "name": "step" }],
  "install_guidance": {
    "plugin": "smallstep",
    "binary": "step",
    "check": "which step",
    "install_steps": ["brew install step", "Verify: step --version", "supercli plugins install ./plugins/smallstep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "smallstep",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to step CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "step",
      "passthrough": true,
      "missingDependencyHelp": "Install smallstep: brew install step"
    },
    "args": []
  }]
}
