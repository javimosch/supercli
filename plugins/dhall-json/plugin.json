{
  "name": "dhall-json",
  "version": "0.1.0",
  "description": "CLI tool: dhall-json",
  "source": "https://packages.debian.org/dhall-json",
  "checks": [{ "type": "binary", "name": "dhall-json" }],
  "install_guidance": {
    "plugin": "dhall-json", "binary": "dhall-json", "check": "which dhall-json",
    "install_steps": ["apt-get install dhall-json 2>/dev/null || which dhall-json", "Verify: dhall-json --version", "supercli plugins install ./plugins/dhall-json --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-json", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-json CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-json", "passthrough": true, "missingDependencyHelp": "Install dhall-json: apt-get install dhall-json" }, "args": []
  }]
}
