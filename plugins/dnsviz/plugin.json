{
  "name": "dnsviz",
  "version": "0.1.0",
  "description": "Tools for analyzing and visualizing DNS and DNSSEC behavior",
  "source": "https://github.com/dnsviz/dnsviz/",
  "checks": [
    {
      "type": "binary",
      "name": "dnsviz"
    }
  ],
  "install_guidance": {
    "plugin": "dnsviz",
    "binary": "dnsviz",
    "check": "which dnsviz",
    "install_steps": [
      "brew install dnsviz",
      "Verify: dnsviz --version",
      "supercli plugins install ./plugins/dnsviz --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dnsviz",
      "resource": "self",
      "action": "version",
      "description": "Print dnsviz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnsviz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dnsviz: brew install dnsviz"
      },
      "args": []
    },
    {
      "namespace": "dnsviz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dnsviz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnsviz",
        "passthrough": true,
        "missingDependencyHelp": "Install dnsviz"
      },
      "args": []
    }
  ]
}