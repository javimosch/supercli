{
  "name": "epub-tools",
  "version": "0.1.0",
  "description": "Essential utilities for EPUB metadata editing renaming and zipping",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "epub-tools" }],
  "install_guidance": {
    "plugin": "epub-tools",
    "binary": "epub-tools",
    "check": "which epub-tools",
    "install_steps": ["stack install", "Verify: epub-tools --version", "supercli plugins install ./plugins/epub-tools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epub-tools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epub-tools CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epub-tools",
      "passthrough": true,
      "missingDependencyHelp": "Install epub-tools: stack install"
    },
    "args": []
  }]
}
