{
  "name": "distrobox-assemble",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-assemble",
  "source": "https://packages.debian.org/distrobox-assemble",
  "checks": [{ "type": "binary", "name": "distrobox-assemble" }],
  "install_guidance": {
    "plugin": "distrobox-assemble", "binary": "distrobox-assemble", "check": "which distrobox-assemble",
    "install_steps": ["apt-get install distrobox-assemble 2>/dev/null || which distrobox-assemble", "Verify: distrobox-assemble --version", "supercli plugins install ./plugins/distrobox-assemble --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distrobox-assemble", "resource": "_", "action": "_",
    "description": "Passthrough to distrobox-assemble CLI",
    "adapter": "process", "adapterConfig": { "command": "distrobox-assemble", "passthrough": true, "missingDependencyHelp": "Install distrobox-assemble: apt-get install distrobox-assemble" }, "args": []
  }]
}
