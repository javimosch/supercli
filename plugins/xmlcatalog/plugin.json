{
  "name": "xmlcatalog",
  "version": "0.1.0",
  "description": "CLI tool: xmlcatalog",
  "source": "https://manpages.debian.org/xmlcatalog",
  "checks": [
    {
      "type": "binary",
      "name": "xmlcatalog"
    }
  ],
  "install_guidance": {
    "plugin": "xmlcatalog",
    "binary": "xmlcatalog",
    "check": "which xmlcatalog",
    "install_steps": [
      "apt-get install xmlcatalog 2>/dev/null || which xmlcatalog",
      "Verify: xmlcatalog --version",
      "supercli plugins install ./plugins/xmlcatalog --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xmlcatalog",
      "resource": "self",
      "action": "version",
      "description": "Print xmlcatalog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlcatalog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xmlcatalog: apt-get install xmlcatalog 2>/dev/null || which xmlcatalog"
      },
      "args": []
    },
    {
      "namespace": "xmlcatalog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xmlcatalog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlcatalog",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xmlcatalog: apt-get install xmlcatalog 2>/dev/null || which xmlcatalog"
      },
      "args": []
    }
  ]
}