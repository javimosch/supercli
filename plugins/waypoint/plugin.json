{
  "name": "waypoint",
  "version": "0.1.0",
  "description": "Developer-oriented application deployment across platforms",
  "source": "https://github.com/hashicorp/waypoint",
  "checks": [{ "type": "binary", "name": "waypoint" }],
  "install_guidance": {
    "plugin": "waypoint",
    "binary": "waypoint",
    "check": "which waypoint",
    "install_steps": ["brew install waypoint", "Verify: waypoint --version", "supercli plugins install ./plugins/waypoint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "waypoint",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to waypoint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "waypoint",
      "passthrough": true,
      "missingDependencyHelp": "Install waypoint: brew install waypoint"
    },
    "args": []
  }]
}
