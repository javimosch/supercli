{
  "name": "arxiv_latex_cleaner",
  "version": "0.1.0",
  "description": "Clean LaTeX code to submit to arXiv",
  "source": "https://github.com/google-research/arxiv-latex-cleaner",
  "checks": [
    {
      "type": "binary",
      "name": "arxiv_latex_cleaner"
    }
  ],
  "install_guidance": {
    "plugin": "arxiv_latex_cleaner",
    "binary": "arxiv_latex_cleaner",
    "check": "which arxiv_latex_cleaner",
    "install_steps": [
      "brew install arxiv_latex_cleaner",
      "Verify: arxiv_latex_cleaner --version",
      "supercli plugins install ./plugins/arxiv_latex_cleaner --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "arxiv_latex_cleaner",
      "resource": "self",
      "action": "version",
      "description": "Print arxiv_latex_cleaner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arxiv_latex_cleaner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arxiv_latex_cleaner: brew install arxiv_latex_cleaner"
      },
      "args": []
    },
    {
      "namespace": "arxiv_latex_cleaner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arxiv_latex_cleaner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "arxiv_latex_cleaner",
        "passthrough": true,
        "missingDependencyHelp": "Install arxiv_latex_cleaner"
      },
      "args": []
    }
  ]
}