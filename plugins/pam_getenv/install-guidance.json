{
  "plugin": "pam_getenv",
  "binary": "pam_getenv",
  "check": "which pam_getenv",
  "install_steps": [
    "# Install pam_getenv",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pam_getenv-linux-amd64 -o /usr/local/bin/pam_getenv",
    "chmod +x /usr/local/bin/pam_getenv",
    "# Or via package manager, see /usr/sbin/pam_getenv"
  ]
}