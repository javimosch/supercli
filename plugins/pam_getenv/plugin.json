{
  "name": "pam-getenv",
  "version": "1.0.0",
  "description": "pam-getenv \u2014 pam_getenv \u2014 CLI utility",
  "source": "/usr/sbin/pam_getenv",
  "checks": [
    {
      "type": "binary",
      "name": "pam_getenv"
    }
  ],
  "install_guidance": {
    "plugin": "pam-getenv",
    "binary": "pam_getenv",
    "check": "which pam_getenv",
    "install_steps": [
      "# Install pam-getenv:",
      "# apt: sudo apt-get install pam-getenv",
      "# brew: brew install pam-getenv",
      "# cargo: cargo install pam-getenv",
      "# npm: npm install -g pam-getenv",
      "# pip: pip install pam-getenv",
      "# or download from /usr/sbin/pam_getenv"
    ]
  },
  "commands": [
    {
      "namespace": "pam",
      "resource": "getenv",
      "action": "run",
      "description": "Run pam-getenv",
      "adapter": "process",
      "adapterConfig": {
        "command": "pam_getenv",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pam-getenv from /usr/sbin/pam_getenv"
      },
      "args": []
    }
  ]
}