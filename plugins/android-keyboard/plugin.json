{
  "name": "android-keyboard",
  "version": "0.1.0",
  "description": "Official FUTO Keyboard Issue Tracker and Source Mirror of https://gitlab.futo.org/keyboard/latinime",
  "source": "https://github.com/android-keyboard/android-keyboard",
  "checks": [
    {
      "type": "binary",
      "name": "android-keyboard"
    }
  ],
  "install_guidance": {
    "plugin": "android-keyboard",
    "binary": "android-keyboard",
    "check": "which android-keyboard",
    "install_steps": [
      "pip install android-keyboard",
      "Verify: android-keyboard --version",
      "supercli plugins install ./plugins/android-keyboard --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "android-keyboard",
      "resource": "self",
      "action": "version",
      "description": "Print android-keyboard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "android-keyboard",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install android-keyboard: pip install android-keyboard"
      },
      "args": []
    },
    {
      "namespace": "android-keyboard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to android-keyboard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "android-keyboard",
        "passthrough": true,
        "missingDependencyHelp": "Install android-keyboard: pip install android-keyboard"
      },
      "args": []
    }
  ]
}