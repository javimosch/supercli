  "commands": [{
    "namespace": "bogotune", "resource": "_", "action": "_",
    "description": "Passthrough to bogotune CLI",
    "adapter": "process", "adapterConfig": { "command": "bogotune", "passthrough": true, "missingDependencyHelp": "Install bogotune: apt-get install bogotune" }, "args": []
  }]
}
