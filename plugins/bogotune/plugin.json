{
  "name": "bogotune",
  "version": "0.1.0",
  "description": "CLI tool: bogotune",
  "source": "https://packages.debian.org/bogotune",
  "checks": [{ "type": "binary", "name": "bogotune" }],
  "install_guidance": {
    "plugin": "bogotune", "binary": "bogotune", "check": "which bogotune",
    "install_steps": ["apt-get install bogotune 2>/dev/null || which bogotune", "Verify: bogotune --version", "supercli plugins install ./plugins/bogotune --on-conflict replace --json"]
