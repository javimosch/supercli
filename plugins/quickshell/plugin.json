{
  "name": "quickshell",
  "version": "0.1.0",
  "description": "Flexible toolkit for making desktop shells with QtQuick, for Wayland and X11",
  "source": "https://github.com/quickshell/quickshell",
  "checks": [
    {
      "type": "binary",
      "name": "quickshell"
    }
  ],
  "install_guidance": {
    "plugin": "quickshell",
    "binary": "quickshell",
    "check": "which quickshell",
    "install_steps": [
      "pip install quickshell",
      "Verify: quickshell --version",
      "supercli plugins install ./plugins/quickshell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "quickshell",
      "resource": "self",
      "action": "version",
      "description": "Print quickshell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quickshell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install quickshell: pip install quickshell"
      },
      "args": []
    },
    {
      "namespace": "quickshell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to quickshell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "quickshell",
        "passthrough": true,
        "missingDependencyHelp": "Install quickshell: pip install quickshell"
      },
      "args": []
    }
  ]
}