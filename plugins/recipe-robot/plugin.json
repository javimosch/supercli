{
  "name": "recipe-robot",
  "version": "0.1.0",
  "description": "CLI tool for creating and managing AutoPkg recipes",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "recipe-robot" }],
  "install_guidance": {
    "plugin": "recipe-robot",
    "binary": "recipe-robot",
    "check": "which recipe-robot",
    "install_steps": ["brew install homebysix/tap/recipe-robot", "Verify: recipe-robot --version", "supercli plugins install ./plugins/recipe-robot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "recipe-robot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to recipe-robot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "recipe-robot",
      "passthrough": true,
      "missingDependencyHelp": "Install recipe-robot: brew install homebysix/tap/recipe-robot"
    },
    "args": []
  }]
}
