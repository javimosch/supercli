{
  "name": "openclaw-china-docker",
  "version": "0.1.0",
  "description": "OpenClaw \u7684\u4e2d\u56fdIM\u5e73\u53f0\u6574\u5408Docker\u7248\u672c\uff0c\u9884\u88c5\u5e76\u914d\u7f6e\u4e86\u98de\u4e66\u3001\u9489\u9489\u3001QQ\u673a\u5668\u4eba\u3001\u4f01\u4e1a\u5fae\u4fe1\u7b49\u4e3b\u6d41\u4e2d\u56fdIM\u8f6f\u4ef6\u7684\u63d2\u4ef6\uff0c\u8ba9\u60a8\u53ef\u4ee5\u5feb\u901f\u90e8\u7f72\u4e00\u4e2a\u652f\u6301\u591a\u4e2a\u4e2d\u56fdIM\u5e73\u53f0\u7684 AI \u673a\u5668\u4eba\u7f51\u5173",
  "source": "https://github.com/openclaw-china-docker/openclaw-china-docker",
  "checks": [
    {
      "type": "binary",
      "name": "openclaw-china-docker"
    }
  ],
  "install_guidance": {
    "plugin": "openclaw-china-docker",
    "binary": "openclaw-china-docker",
    "check": "which openclaw-china-docker",
    "install_steps": [
      "pip install openclaw-china-docker",
      "Verify: openclaw-china-docker --version",
      "supercli plugins install ./plugins/openclaw-china-docker --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openclaw-china-docker",
      "resource": "self",
      "action": "version",
      "description": "Print openclaw-china-docker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaw-china-docker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openclaw-china-docker: pip install openclaw-china-docker"
      },
      "args": []
    },
    {
      "namespace": "openclaw-china-docker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openclaw-china-docker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclaw-china-docker",
        "passthrough": true,
        "missingDependencyHelp": "Install openclaw-china-docker: pip install openclaw-china-docker"
      },
      "args": []
    }
  ]
}