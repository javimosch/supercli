{
  "name": "GitHub-Chinese-Top-Charts",
  "version": "0.1.0",
  "description": "\ud83c\udde8\ud83c\uddf3 GitHub\u4e2d\u6587\u6392\u884c\u699c\uff0c\u5e2e\u52a9\u4f60\u53d1\u73b0\u9ad8\u5206\u4f18\u79c0\u4e2d\u6587\u9879\u76ee\u3002",
  "source": "https://github.com/GitHub-Chinese-Top-Charts/GitHub-Chinese-Top-Charts",
  "checks": [
    {
      "type": "binary",
      "name": "github-chinese-top-charts"
    }
  ],
  "install_guidance": {
    "plugin": "GitHub-Chinese-Top-Charts",
    "binary": "github-chinese-top-charts",
    "check": "which github-chinese-top-charts",
    "install_steps": [
      "pip install github-chinese-top-charts",
      "Verify: github-chinese-top-charts --version",
      "supercli plugins install ./plugins/GitHub-Chinese-Top-Charts --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GitHub-Chinese-Top-Charts",
      "resource": "self",
      "action": "version",
      "description": "Print GitHub-Chinese-Top-Charts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-chinese-top-charts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GitHub-Chinese-Top-Charts: pip install github-chinese-top-charts"
      },
      "args": []
    },
    {
      "namespace": "GitHub-Chinese-Top-Charts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to github-chinese-top-charts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-chinese-top-charts",
        "passthrough": true,
        "missingDependencyHelp": "Install GitHub-Chinese-Top-Charts: pip install github-chinese-top-charts"
      },
      "args": []
    }
  ]
}