{
  "name": "qdbuscpp2xml",
  "version": "0.1.0",
  "description": "CLI tool: qdbuscpp2xml",
  "source": "https://manpages.debian.org/qdbuscpp2xml",
  "checks": [
    {
      "type": "binary",
      "name": "qdbuscpp2xml"
    }
  ],
  "install_guidance": {
    "plugin": "qdbuscpp2xml",
    "binary": "qdbuscpp2xml",
    "check": "which qdbuscpp2xml",
    "install_steps": [
      "apt-get install qdbuscpp2xml 2>/dev/null || which qdbuscpp2xml",
      "Verify: qdbuscpp2xml --version",
      "supercli plugins install ./plugins/qdbuscpp2xml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qdbuscpp2xml",
      "resource": "self",
      "action": "version",
      "description": "Print qdbuscpp2xml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qdbuscpp2xml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qdbuscpp2xml: apt-get install qdbuscpp2xml 2>/dev/null || which qdbuscpp2xml"
      },
      "args": []
    },
    {
      "namespace": "qdbuscpp2xml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qdbuscpp2xml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qdbuscpp2xml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qdbuscpp2xml: apt-get install qdbuscpp2xml 2>/dev/null || which qdbuscpp2xml"
      },
      "args": []
    }
  ]
}