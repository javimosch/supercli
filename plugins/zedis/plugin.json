{
  "name": "zedis",
  "version": "0.1.0",
  "description": "Redis in Zig",
  "source": "https://github.com/zedis/zedis",
  "checks": [
    {
      "type": "binary",
      "name": "zedis"
    }
  ],
  "install_guidance": {
    "plugin": "zedis",
    "binary": "zedis",
    "check": "which zedis",
    "install_steps": [
      "pip install zedis",
      "Verify: zedis --version",
      "supercli plugins install ./plugins/zedis --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zedis",
      "resource": "self",
      "action": "version",
      "description": "Print zedis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zedis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zedis: pip install zedis"
      },
      "args": []
    },
    {
      "namespace": "zedis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zedis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zedis",
        "passthrough": true,
        "missingDependencyHelp": "Install zedis: pip install zedis"
      },
      "args": []
    }
  ]
}