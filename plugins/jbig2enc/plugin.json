{
  "name": "jbig2enc",
  "version": "0.1.0",
  "description": "JBIG2 encoder (for monochrome documents)",
  "source": "https://github.com/agl/jbig2enc",
  "checks": [
    {
      "type": "binary",
      "name": "jbig2enc"
    }
  ],
  "install_guidance": {
    "plugin": "jbig2enc",
    "binary": "jbig2enc",
    "check": "which jbig2enc",
    "install_steps": [
      "brew install jbig2enc",
      "Verify: jbig2enc --version",
      "supercli plugins install ./plugins/jbig2enc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jbig2enc",
      "resource": "self",
      "action": "version",
      "description": "Print jbig2enc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jbig2enc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jbig2enc: brew install jbig2enc"
      },
      "args": []
    },
    {
      "namespace": "jbig2enc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jbig2enc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jbig2enc",
        "passthrough": true,
        "missingDependencyHelp": "Install jbig2enc"
      },
      "args": []
    }
  ]
}