{
  "name": "lstags",
  "version": "0.1.0",
  "description": "Synchronize images across registries",
  "source": "https://github.com/ivanilves/lstags",
  "checks": [
    {
      "type": "binary",
      "name": "lstags"
    }
  ],
  "install_guidance": {
    "plugin": "lstags",
    "binary": "lstags",
    "check": "which lstags",
    "install_steps": [
      "See https://github.com/ivanilves/lstags",
      "Verify: lstags --version",
      "supercli plugins install ./plugins/lstags --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "lstags",
      "resource": "self",
      "action": "version",
      "description": "Print lstags version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lstags",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lstags: See https://github.com/ivanilves/lstags"
      },
      "args": []
    },
    {
      "namespace": "lstags",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lstags CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lstags",
        "passthrough": true,
        "missingDependencyHelp": "Install lstags"
      },
      "args": []
    }
  ]
}