{
  "name": "phone-validate",
  "version": "0.1.0",
  "description": "CLI wrapper for parsing and validating phone formats",
  "source": "https://github.com/dherault/phone-validate",
  "checks": [{ "type": "binary", "name": "phone-validate" }],
  "install_guidance": {
    "plugin": "phone-validate",
    "binary": "phone-validate",
    "check": "which phone-validate",
    "install_steps": ["npm install -g phone-validate", "Verify: phone-validate --version", "supercli plugins install ./plugins/phone-validate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "phone-validate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to phone-validate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "phone-validate",
      "passthrough": true,
      "missingDependencyHelp": "Install phone-validate: npm install -g phone-validate", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
