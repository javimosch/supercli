{
  "name": "tilt",
  "version": "0.1.0",
  "description": "Local Kubernetes development with live updates and no config",
  "source": "https://github.com/tilt-dev/tilt",
  "checks": [{ "type": "binary", "name": "tilt" }],
  "install_guidance": {
    "plugin": "tilt",
    "binary": "tilt",
    "check": "which tilt",
    "install_steps": ["brew install tilt", "Verify: tilt --version", "supercli plugins install ./plugins/tilt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tilt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tilt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tilt",
      "passthrough": true,
      "missingDependencyHelp": "Install tilt: brew install tilt"
    },
    "args": []
  }]
}
