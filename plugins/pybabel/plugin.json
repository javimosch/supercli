{
  "name": "pybabel",
  "version": "0.1.0",
  "description": "CLI tool: pybabel",
  "source": "https://manpages.debian.org/pybabel",
  "checks": [
    {
      "type": "binary",
      "name": "pybabel"
    }
  ],
  "install_guidance": {
    "plugin": "pybabel",
    "binary": "pybabel",
    "check": "which pybabel",
    "install_steps": [
      "apt-get install pybabel 2>/dev/null || which pybabel",
      "Verify: pybabel --version",
      "supercli plugins install ./plugins/pybabel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pybabel",
      "resource": "self",
      "action": "version",
      "description": "Print pybabel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pybabel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pybabel: apt-get install pybabel 2>/dev/null || which pybabel"
      },
      "args": []
    },
    {
      "namespace": "pybabel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pybabel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pybabel",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pybabel: apt-get install pybabel 2>/dev/null || which pybabel"
      },
      "args": []
    }
  ]
}