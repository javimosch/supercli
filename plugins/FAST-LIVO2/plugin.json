{
  "name": "FAST-LIVO2",
  "version": "0.1.0",
  "description": "FAST-LIVO2: Fast, Direct LiDAR-Inertial-Visual Odometry",
  "source": "https://github.com/FAST-LIVO2/FAST-LIVO2",
  "checks": [
    {
      "type": "binary",
      "name": "fast-livo2"
    }
  ],
  "install_guidance": {
    "plugin": "FAST-LIVO2",
    "binary": "fast-livo2",
    "check": "which fast-livo2",
    "install_steps": [
      "pip install fast-livo2",
      "Verify: fast-livo2 --version",
      "supercli plugins install ./plugins/FAST-LIVO2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FAST-LIVO2",
      "resource": "self",
      "action": "version",
      "description": "Print FAST-LIVO2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fast-livo2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FAST-LIVO2: pip install fast-livo2"
      },
      "args": []
    },
    {
      "namespace": "FAST-LIVO2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fast-livo2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fast-livo2",
        "passthrough": true,
        "missingDependencyHelp": "Install FAST-LIVO2: pip install fast-livo2"
      },
      "args": []
    }
  ]
}