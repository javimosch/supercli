{
  "name": "OpenLogi",
  "version": "0.1.0",
  "description": "\u26a1\ufe0fA native, local-first alternative to Logitech Options+, written in Rust \ud83e\udd80 \u2014 remap buttons, DPI, an",
  "source": "https://github.com/OpenLogi/OpenLogi",
  "checks": [
    {
      "type": "binary",
      "name": "openlogi"
    }
  ],
  "install_guidance": {
    "plugin": "OpenLogi",
    "binary": "openlogi",
    "check": "which openlogi",
    "install_steps": [
      "pip install openlogi",
      "Verify: openlogi --version",
      "supercli plugins install ./plugins/OpenLogi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenLogi",
      "resource": "self",
      "action": "version",
      "description": "Print OpenLogi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openlogi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenLogi: pip install openlogi"
      },
      "args": []
    },
    {
      "namespace": "OpenLogi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openlogi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openlogi",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenLogi: pip install openlogi"
      },
      "args": []
    }
  ]
}