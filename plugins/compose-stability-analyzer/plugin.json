{
  "name": "compose-stability-analyzer",
  "version": "0.1.0",
  "description": "\ud83e\udd84 Real-time analysis of Jetpack Compose composable functions' stability directly within Android Stud",
  "source": "https://github.com/compose-stability-analyzer/compose-stability-analyzer",
  "checks": [
    {
      "type": "binary",
      "name": "compose-stability-analyzer"
    }
  ],
  "install_guidance": {
    "plugin": "compose-stability-analyzer",
    "binary": "compose-stability-analyzer",
    "check": "which compose-stability-analyzer",
    "install_steps": [
      "pip install compose-stability-analyzer",
      "Verify: compose-stability-analyzer --version",
      "supercli plugins install ./plugins/compose-stability-analyzer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "compose-stability-analyzer",
      "resource": "self",
      "action": "version",
      "description": "Print compose-stability-analyzer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "compose-stability-analyzer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install compose-stability-analyzer: pip install compose-stability-analyzer"
      },
      "args": []
    },
    {
      "namespace": "compose-stability-analyzer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to compose-stability-analyzer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "compose-stability-analyzer",
        "passthrough": true,
        "missingDependencyHelp": "Install compose-stability-analyzer: pip install compose-stability-analyzer"
      },
      "args": []
    }
  ]
}