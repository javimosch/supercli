{
  "name": "gotify-cli",
  "version": "1.0.0",
  "description": "gotify-cli \u2014 Gotify notification push CLI",
  "source": "github.com/gotify/cli",
  "checks": [
    {
      "type": "binary",
      "name": "gotify-cli"
    }
  ],
  "install_guidance": {
    "plugin": "gotify-cli",
    "binary": "gotify-cli",
    "check": "which gotify-cli",
    "install_steps": [
      "# Install gotify-cli:",
      "# apt: sudo apt-get install gotify-cli",
      "# brew: brew install gotify-cli",
      "# cargo: cargo install gotify-cli",
      "# npm: npm install -g gotify-cli",
      "# pip: pip install gotify-cli",
      "# or download from github.com/gotify/cli"
    ]
  },
  "commands": [
    {
      "namespace": "gotify",
      "resource": "cli",
      "action": "run",
      "description": "Run gotify-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "gotify-cli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gotify-cli from github.com/gotify/cli"
      },
      "args": []
    }
  ]
}