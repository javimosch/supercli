{
  "plugin": "gotify-cli",
  "binary": "gotify-cli",
  "check": "which gotify-cli",
  "install_steps": [
    "# Install gotify-cli",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/gotify-cli-linux-amd64 -o /usr/local/bin/gotify-cli",
    "chmod +x /usr/local/bin/gotify-cli",
    "# Or via package manager, see github.com/gotify/cli"
  ]
}