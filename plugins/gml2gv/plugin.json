{
  "name": "gml2gv",
  "version": "0.1.0",
  "description": "CLI tool: gml2gv",
  "source": "https://manpages.debian.org/gml2gv",
  "checks": [
    {
      "type": "binary",
      "name": "gml2gv"
    }
  ],
  "install_guidance": {
    "plugin": "gml2gv",
    "binary": "gml2gv",
    "check": "which gml2gv",
    "install_steps": [
      "apt-get install gml2gv 2>/dev/null || which gml2gv",
      "Verify: gml2gv --version",
      "supercli plugins install ./plugins/gml2gv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gml2gv",
      "resource": "self",
      "action": "version",
      "description": "Print gml2gv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gml2gv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gml2gv: apt-get install gml2gv 2>/dev/null || which gml2gv"
      },
      "args": []
    },
    {
      "namespace": "gml2gv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gml2gv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gml2gv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gml2gv: apt-get install gml2gv 2>/dev/null || which gml2gv"
      },
      "args": []
    }
  ]
}