{
  "name": "vboximg-mount",
  "version": "0.1.0",
  "description": "CLI tool: vboximg-mount",
  "source": "https://manpages.debian.org/vboximg-mount",
  "checks": [
    {
      "type": "binary",
      "name": "vboximg-mount"
    }
  ],
  "install_guidance": {
    "plugin": "vboximg-mount",
    "binary": "vboximg-mount",
    "check": "which vboximg-mount",
    "install_steps": [
      "apt-get install vboximg-mount 2>/dev/null || which vboximg-mount",
      "Verify: vboximg-mount --version",
      "supercli plugins install ./plugins/vboximg-mount --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vboximg-mount",
      "resource": "self",
      "action": "version",
      "description": "Print vboximg-mount version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vboximg-mount",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vboximg-mount: apt-get install vboximg-mount 2>/dev/null || which vboximg-mount"
      },
      "args": []
    },
    {
      "namespace": "vboximg-mount",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vboximg-mount CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vboximg-mount",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vboximg-mount: apt-get install vboximg-mount 2>/dev/null || which vboximg-mount"
      },
      "args": []
    }
  ]
}