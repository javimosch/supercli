{
  "name": "arpsnmp",
  "version": "0.1.0",
  "description": "CLI tool: arpsnmp",
  "source": "https://packages.debian.org/arpsnmp",
  "checks": [{ "type": "binary", "name": "arpsnmp" }],
  "install_guidance": {
    "plugin": "arpsnmp", "binary": "arpsnmp", "check": "which arpsnmp",
    "install_steps": ["apt-get install arpsnmp 2>/dev/null || which arpsnmp", "Verify: arpsnmp --version", "supercli plugins install ./plugins/arpsnmp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "arpsnmp", "resource": "_", "action": "_",
    "description": "Passthrough to arpsnmp CLI",
    "adapter": "process", "adapterConfig": { "command": "arpsnmp", "passthrough": true, "missingDependencyHelp": "Install arpsnmp: apt-get install arpsnmp" }, "args": []
  }]
}
