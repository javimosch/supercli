{
  "name": "cssmin",
  "version": "0.1.0",
  "description": "Minify CSS files for production deployment",
  "source": "https://github.com/zacharyvoase/cssmin",
  "checks": [{ "type": "binary", "name": "cssmin" }],
  "install_guidance": {
    "plugin": "cssmin",
    "binary": "cssmin",
    "check": "which cssmin",
    "install_steps": ["pip install cssmin", "Verify: cssmin --version", "supercli plugins install ./plugins/cssmin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cssmin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cssmin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cssmin",
      "passthrough": true,
      "missingDependencyHelp": "Install cssmin: pip install cssmin", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
