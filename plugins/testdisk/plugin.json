{
  "name": "testdisk",
  "version": "0.1.0",
  "description": "Powerful free data recovery utility for lost partitions and files",
  "source": "https://github.com/cgsecurity/testdisk",
  "checks": [{ "type": "binary", "name": "testdisk" }],
  "install_guidance": {
    "plugin": "testdisk",
    "binary": "testdisk",
    "check": "which testdisk",
    "install_steps": ["brew install testdisk", "Verify: testdisk --version", "supercli plugins install ./plugins/testdisk --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "testdisk",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to testdisk CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "testdisk",
      "passthrough": true,
      "missingDependencyHelp": "Install testdisk: brew install testdisk"
    },
    "args": []
  }]
}
