{
  "name": "fcgistarter",
  "version": "0.1.0",
  "description": "CLI tool: fcgistarter",
  "source": "https://manpages.debian.org/fcgistarter",
  "checks": [
    {
      "type": "binary",
      "name": "fcgistarter"
    }
  ],
  "install_guidance": {
    "plugin": "fcgistarter",
    "binary": "fcgistarter",
    "check": "which fcgistarter",
    "install_steps": [
      "apt-get install fcgistarter 2>/dev/null || which fcgistarter",
      "Verify: fcgistarter --version",
      "supercli plugins install ./plugins/fcgistarter --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fcgistarter",
      "resource": "self",
      "action": "version",
      "description": "Print fcgistarter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fcgistarter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fcgistarter: apt-get install fcgistarter 2>/dev/null || which fcgistarter"
      },
      "args": []
    },
    {
      "namespace": "fcgistarter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fcgistarter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fcgistarter",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fcgistarter: apt-get install fcgistarter 2>/dev/null || which fcgistarter"
      },
      "args": []
    }
  ]
}