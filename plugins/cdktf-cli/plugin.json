{
  "name": "cdktf-cli",
  "version": "0.1.0",
  "description": "CDKTF-CLI for Terraform Docker image",
  "source": "https://github.com/cdktf-cli/cdktf-cli",
  "checks": [
    {
      "type": "binary",
      "name": "cdktf-cli"
    }
  ],
  "install_guidance": {
    "plugin": "cdktf-cli",
    "binary": "cdktf-cli",
    "check": "which cdktf-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cdktf-cli --version",
      "supercli plugins install ./plugins/cdktf-cli --on-conflict replace --json"
    ],
    "note": "Dockerfile language CLI tool"
  },
  "commands": [
    {
      "namespace": "cdktf-cli",
      "resource": "self",
      "action": "version",
      "description": "Print cdktf-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdktf-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cdktf-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "cdktf-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cdktf-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdktf-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install cdktf-cli from project repository"
      },
      "args": []
    }
  ]
}