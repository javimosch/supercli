{
  "name": "ctail",
  "version": "0.1.0",
  "description": "ctail \u2014 watch and colorize a logfile",
  "source": "https://packages.debian.org/ctail",
  "checks": [{ "type": "binary", "name": "ctail" }],
  "install_guidance": {
    "plugin": "ctail", "binary": "ctail", "check": "which ctail",
    "install_steps": ["apt-get install ctail 2>/dev/null || which ctail", "Verify: ctail --version", "supercli plugins install ./plugins/ctail --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctail", "resource": "_", "action": "_",
    "description": "Passthrough to ctail CLI",
    "adapter": "process", "adapterConfig": { "command": "ctail", "passthrough": true, "missingDependencyHelp": "Install ctail: apt-get install ctail" }, "args": []
  }]
}
