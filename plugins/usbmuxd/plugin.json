{
  "name": "usbmuxd",
  "version": "0.1.0",
  "description": "CLI tool: usbmuxd",
  "source": "https://manpages.debian.org/usbmuxd",
  "checks": [
    {
      "type": "binary",
      "name": "usbmuxd"
    }
  ],
  "install_guidance": {
    "plugin": "usbmuxd",
    "binary": "usbmuxd",
    "check": "which usbmuxd",
    "install_steps": [
      "apt-get install usbmuxd 2>/dev/null || which usbmuxd",
      "Verify: usbmuxd --version",
      "supercli plugins install ./plugins/usbmuxd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "usbmuxd",
      "resource": "self",
      "action": "version",
      "description": "Print usbmuxd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "usbmuxd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install usbmuxd: apt-get install usbmuxd 2>/dev/null || which usbmuxd"
      },
      "args": []
    },
    {
      "namespace": "usbmuxd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to usbmuxd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "usbmuxd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install usbmuxd: apt-get install usbmuxd 2>/dev/null || which usbmuxd"
      },
      "args": []
    }
  ]
}