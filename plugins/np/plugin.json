{
  "name": "np",
  "version": "0.1.0",
  "description": "Better npm publish workflow with git integration",
  "source": "https://github.com/sindresorhus/np",
  "checks": [{ "type": "binary", "name": "np" }],
  "install_guidance": {
    "plugin": "np",
    "binary": "np",
    "check": "which np",
    "install_steps": ["npm install -g np", "Verify: np --version", "supercli plugins install ./plugins/np --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "np",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to np CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "np",
      "passthrough": true,
      "missingDependencyHelp": "Install np: npm install -g np", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
