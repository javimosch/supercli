{
  "name": "rst2html",
  "version": "0.1.0",
  "description": "text processing system for reStructuredText (implemented in Python 3) (python3-docutils)",
  "source": "https://manpages.debian.org/rst2html",
  "checks": [
    {
      "type": "binary",
      "name": "rst2html"
    }
  ],
  "install_guidance": {
    "plugin": "rst2html",
    "binary": "rst2html",
    "check": "which rst2html",
    "install_steps": [
      "apt-get install rst2html 2>/dev/null || which rst2html",
      "Verify: rst2html --version",
      "supercli plugins install ./plugins/rst2html --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rst2html",
      "resource": "self",
      "action": "version",
      "description": "Print rst2html version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2html",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rst2html: apt-get install rst2html 2>/dev/null || which rst2html"
      },
      "args": []
    },
    {
      "namespace": "rst2html",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rst2html CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rst2html",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rst2html: apt-get install rst2html 2>/dev/null || which rst2html"
      },
      "args": []
    }
  ]
}