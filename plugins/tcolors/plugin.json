{
  "name": "tcolors",
  "version": "0.1.0",
  "description": "Commandline color picker and palette builder in Go",
  "source": "https://github.com/tcolors/tcolors",
  "checks": [{"type": "binary", "name": "tcolors"}],
  "install_guidance": {
    "plugin": "tcolors",
    "binary": "tcolors",
    "check": "which tcolors",
    "install_steps": [
      "go install github.com/tcolors/tcolors@latest",
      "Verify: tcolors --version",
      "supercli plugins install ./tcolors --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "tcolors",
      "resource": "self",
      "action": "version",
      "description": "Print tcolors version",
      "adapter": "process",
      "adapterConfig": {"command": "tcolors", "baseArgs": ["--version"], "missingDependencyHelp": "Install tcolors: go install github.com/tcolors/tcolors@latest"},
      "args": []
    },
    {
      "namespace": "tcolors",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tcolors CLI",
      "adapter": "process",
      "adapterConfig": {"command": "tcolors", "passthrough": true, "missingDependencyHelp": "Install tcolors: go install github.com/tcolors/tcolors@latest"},
      "args": []
    }
  ]
}
