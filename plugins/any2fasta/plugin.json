{
  "name": "any2fasta",
  "version": "0.1.0",
  "description": "Convert various sequence formats to FASTA",
  "source": "https://github.com/tseemann/any2fasta",
  "checks": [
    {
      "type": "binary",
      "name": "any2fasta"
    }
  ],
  "install_guidance": {
    "plugin": "any2fasta",
    "binary": "any2fasta",
    "check": "which any2fasta",
    "install_steps": [
      "brew install any2fasta",
      "Verify: any2fasta --version",
      "supercli plugins install ./plugins/any2fasta --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "any2fasta",
      "resource": "self",
      "action": "version",
      "description": "Print any2fasta version",
      "adapter": "process",
      "adapterConfig": {
        "command": "any2fasta",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install any2fasta: brew install any2fasta"
      },
      "args": []
    },
    {
      "namespace": "any2fasta",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to any2fasta CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "any2fasta",
        "passthrough": true,
        "missingDependencyHelp": "Install any2fasta"
      },
      "args": []
    }
  ]
}