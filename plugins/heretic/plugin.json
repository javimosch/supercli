{
  "name": "heretic",
  "version": "0.1.0",
  "description": "Fully automatic censorship removal for language models",
  "source": "https://github.com/heretic/heretic",
  "checks": [
    {
      "type": "binary",
      "name": "heretic"
    }
  ],
  "install_guidance": {
    "plugin": "heretic",
    "binary": "heretic",
    "check": "which heretic",
    "install_steps": [
      "pip install heretic",
      "Verify: heretic --version",
      "supercli plugins install ./plugins/heretic --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "heretic",
      "resource": "self",
      "action": "version",
      "description": "Print heretic version",
      "adapter": "process",
      "adapterConfig": {
        "command": "heretic",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install heretic: pip install heretic"
      },
      "args": []
    },
    {
      "namespace": "heretic",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to heretic CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "heretic",
        "passthrough": true,
        "missingDependencyHelp": "Install heretic: pip install heretic"
      },
      "args": []
    }
  ]
}