{
  "name": "HiFiAlignmentTool",
  "version": "0.1.0",
  "description": "Specialized CLI for pipeline image alignment processing",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "HiFiAlignmentTool" }],
  "install_guidance": {
    "plugin": "HiFiAlignmentTool",
    "binary": "HiFiAlignmentTool",
    "check": "which HiFiAlignmentTool",
    "install_steps": ["git clone && python setup.py", "Verify: HiFiAlignmentTool --version", "supercli plugins install ./plugins/HiFiAlignmentTool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "HiFiAlignmentTool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to HiFiAlignmentTool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "HiFiAlignmentTool",
      "passthrough": true,
      "missingDependencyHelp": "Install HiFiAlignmentTool: git clone && python setup.py"
    },
    "args": []
  }]
}
