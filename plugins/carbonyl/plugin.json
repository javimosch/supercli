{
  "name": "carbonyl",
  "version": "0.1.0",
  "description": "Chromium running inside your terminal via GPU-accelerated rendering",
  "source": "https://github.com/fathyb/carbonyl",
  "checks": [{ "type": "binary", "name": "carbonyl" }],
  "install_guidance": {
    "plugin": "carbonyl",
    "binary": "carbonyl",
    "check": "which carbonyl",
    "install_steps": [
      "cargo install carbonyl",
      "Or download binary from https://github.com/fathyb/carbonyl/releases",
      "Verify: carbonyl --version",
      "supercli plugins install ./plugins/carbonyl --on-conflict replace --json"
    ],
    "note": "Available via Cargo and direct binary downloads. Source: https://github.com/fathyb/carbonyl (19k+ stars). Written in Rust."
  },
  "commands": [
    {
      "namespace": "carbonyl", "resource": "self", "action": "version",
      "description": "Print carbonyl version",
      "adapter": "process",
      "adapterConfig": { "command": "carbonyl", "missingDependencyHelp": "Install carbonyl: cargo install carbonyl", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "carbonyl", "resource": "_", "action": "_",
      "description": "Passthrough to carbonyl CLI",
      "adapter": "process",
      "adapterConfig": { "command": "carbonyl", "missingDependencyHelp": "Install carbonyl: cargo install carbonyl", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
