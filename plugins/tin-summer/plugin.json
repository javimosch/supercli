{
  "name": "tin-summer",
  "version": "0.1.0",
  "description": "Find and prune build artifacts like target/ and node_modules/",
  "source": "https://github.com/vmchale/tin-summer",
  "checks": [{ "type": "binary", "name": "tin-summer" }],
  "install_guidance": {
    "plugin": "tin-summer",
    "binary": "tin-summer",
    "check": "which tin-summer",
    "install_steps": ["cargo install tin-summer", "Verify: tin-summer --version", "supercli plugins install ./plugins/tin-summer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tin-summer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tin-summer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tin-summer",
      "passthrough": true,
      "missingDependencyHelp": "Install tin-summer: cargo install tin-summer"
    },
    "args": []
  }]
}
