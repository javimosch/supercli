{
  "name": "codex-cli",
  "version": "0.1.0",
  "description": "OpenAI Codex CLI for generating code",
  "source": "https://github.com/openai/codex-cli",
  "checks": [{ "type": "binary", "name": "codex-cli" }],
  "install_guidance": {
    "plugin": "codex-cli",
    "binary": "codex-cli",
    "check": "which codex-cli",
    "install_steps": ["pip install codex-cli", "Verify: codex-cli --version", "supercli plugins install ./plugins/codex-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "codex-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to codex-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "codex-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install codex-cli: pip install codex-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
