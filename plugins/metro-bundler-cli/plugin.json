{
  "name": "metro-bundler-cli",
  "version": "0.1.0",
  "description": "A command line tool of metro bundler",
  "source": "https://github.com/metro-bundler-cli/metro-bundler-cli",
  "checks": [
    {
      "type": "binary",
      "name": "metro-bundler-cli"
    }
  ],
  "install_guidance": {
    "plugin": "metro-bundler-cli",
    "binary": "metro-bundler-cli",
    "check": "which metro-bundler-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: metro-bundler-cli --version",
      "supercli plugins install ./plugins/metro-bundler-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "metro-bundler-cli",
      "resource": "self",
      "action": "version",
      "description": "Print metro-bundler-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "metro-bundler-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install metro-bundler-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "metro-bundler-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to metro-bundler-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "metro-bundler-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install metro-bundler-cli from project repository"
      },
      "args": []
    }
  ]
}