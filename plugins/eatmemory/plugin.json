{
  "name": "eatmemory",
  "version": "0.1.0",
  "description": "Simple program to allocate memory from the command-line",
  "source": "https://github.com/julman99/eatmemory",
  "checks": [
    {
      "type": "binary",
      "name": "eatmemory"
    }
  ],
  "install_guidance": {
    "plugin": "eatmemory",
    "binary": "eatmemory",
    "check": "which eatmemory",
    "install_steps": [
      "brew install eatmemory",
      "Verify: eatmemory --version",
      "supercli plugins install ./plugins/eatmemory --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "eatmemory",
      "resource": "self",
      "action": "version",
      "description": "Print eatmemory version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eatmemory",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eatmemory: brew install eatmemory"
      },
      "args": []
    },
    {
      "namespace": "eatmemory",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eatmemory CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eatmemory",
        "passthrough": true,
        "missingDependencyHelp": "Install eatmemory"
      },
      "args": []
    }
  ]
}