{
  "name": "macptopbm",
  "version": "0.1.0",
  "description": "CLI tool: macptopbm",
  "source": "https://manpages.debian.org/macptopbm",
  "checks": [
    {
      "type": "binary",
      "name": "macptopbm"
    }
  ],
  "install_guidance": {
    "plugin": "macptopbm",
    "binary": "macptopbm",
    "check": "which macptopbm",
    "install_steps": [
      "apt-get install macptopbm 2>/dev/null || which macptopbm",
      "Verify: macptopbm --version",
      "supercli plugins install ./plugins/macptopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "macptopbm",
      "resource": "self",
      "action": "version",
      "description": "Print macptopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "macptopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install macptopbm: apt-get install macptopbm 2>/dev/null || which macptopbm"
      },
      "args": []
    },
    {
      "namespace": "macptopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to macptopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "macptopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install macptopbm: apt-get install macptopbm 2>/dev/null || which macptopbm"
      },
      "args": []
    }
  ]
}