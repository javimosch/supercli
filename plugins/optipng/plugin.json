{
  "name": "optipng",
  "version": "0.1.0",
  "description": "PNG optimizer with preservation options",
  "source": "https://github.com/OptiPNG/OptiPNG",
  "checks": [
    {
      "type": "binary",
      "name": "optipng"
    }
  ],
  "install_guidance": {
    "plugin": "optipng",
    "binary": "optipng",
    "check": "which optipng",
    "install_steps": [
      "brew install optipng",
      "Verify: optipng --version",
      "supercli plugins install ./plugins/optipng --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "optipng",
      "resource": "self",
      "action": "version",
      "description": "Print optipng version",
      "adapter": "process",
      "adapterConfig": {
        "command": "optipng",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install optipng: brew install optipng"
      },
      "args": []
    },
    {
      "namespace": "optipng",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to optipng CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "optipng",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install optipng: brew install optipng"
      },
      "args": []
    }
  ]
}
