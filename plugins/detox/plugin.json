{
  "name": "detox",
  "version": "1.0.0",
  "description": "detox \u2014 Filename cleanup",
  "source": "github.com/dharple/detox",
  "checks": [
    {
      "type": "binary",
      "name": "detox"
    }
  ],
  "install_guidance": {
    "plugin": "detox",
    "binary": "detox",
    "check": "which detox",
    "install_steps": [
      "# Install detox",
      "# See github.com/dharple/detox",
      "# apt: sudo apt-get install detox",
      "# brew: brew install detox",
      "# cargo: cargo install detox",
      "# npm: npm install -g detox",
      "# pip: pip install detox"
    ]
  },
  "commands": [
    {
      "namespace": "detox",
      "resource": "detox",
      "action": "run",
      "description": "Run detox",
      "adapter": "process",
      "adapterConfig": {
        "command": "detox",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install detox from github.com/dharple/detox"
      },
      "args": []
    }
  ]
