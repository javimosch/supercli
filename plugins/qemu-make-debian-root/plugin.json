{
  "name": "qemu-make-debian-root",
  "version": "0.1.0",
  "description": "CLI tool: qemu-make-debian-root",
  "source": "https://manpages.debian.org/qemu-make-debian-root",
  "checks": [
    {
      "type": "binary",
      "name": "qemu-make-debian-root"
    }
  ],
  "install_guidance": {
    "plugin": "qemu-make-debian-root",
    "binary": "qemu-make-debian-root",
    "check": "which qemu-make-debian-root",
    "install_steps": [
      "apt-get install qemu-make-debian-root 2>/dev/null || which qemu-make-debian-root",
      "Verify: qemu-make-debian-root --version",
      "supercli plugins install ./plugins/qemu-make-debian-root --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qemu-make-debian-root",
      "resource": "self",
      "action": "version",
      "description": "Print qemu-make-debian-root version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qemu-make-debian-root",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qemu-make-debian-root: apt-get install qemu-make-debian-root 2>/dev/null || which qemu-make-debian-root"
      },
      "args": []
    },
    {
      "namespace": "qemu-make-debian-root",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qemu-make-debian-root CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qemu-make-debian-root",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qemu-make-debian-root: apt-get install qemu-make-debian-root 2>/dev/null || which qemu-make-debian-root"
      },
      "args": []
    }
  ]
}