{
  "name": "awesome-claude-code-subagents",
  "version": "0.1.0",
  "description": "A collection of 100+ specialized Claude Code subagents covering a wide range of development use case",
  "source": "https://github.com/awesome-claude-code-subagents/awesome-claude-code-subagents",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-claude-code-subagents"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-claude-code-subagents",
    "binary": "awesome-claude-code-subagents",
    "check": "which awesome-claude-code-subagents",
    "install_steps": [
      "pip install awesome-claude-code-subagents",
      "Verify: awesome-claude-code-subagents --version",
      "supercli plugins install ./plugins/awesome-claude-code-subagents --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-claude-code-subagents",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-claude-code-subagents version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-claude-code-subagents",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-claude-code-subagents: pip install awesome-claude-code-subagents"
      },
      "args": []
    },
    {
      "namespace": "awesome-claude-code-subagents",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-claude-code-subagents CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-claude-code-subagents",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-claude-code-subagents: pip install awesome-claude-code-subagents"
      },
      "args": []
    }
  ]
}