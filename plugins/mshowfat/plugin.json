{
  "name": "mshowfat",
  "version": "0.1.0",
  "description": "CLI tool: mshowfat",
  "source": "https://manpages.debian.org/mshowfat",
  "checks": [
    {
      "type": "binary",
      "name": "mshowfat"
    }
  ],
  "install_guidance": {
    "plugin": "mshowfat",
    "binary": "mshowfat",
    "check": "which mshowfat",
    "install_steps": [
      "apt-get install mshowfat 2>/dev/null || which mshowfat",
      "Verify: mshowfat --version",
      "supercli plugins install ./plugins/mshowfat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mshowfat",
      "resource": "self",
      "action": "version",
      "description": "Print mshowfat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mshowfat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mshowfat: apt-get install mshowfat 2>/dev/null || which mshowfat"
      },
      "args": []
    },
    {
      "namespace": "mshowfat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mshowfat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mshowfat",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mshowfat: apt-get install mshowfat 2>/dev/null || which mshowfat"
      },
      "args": []
    }
  ]
}