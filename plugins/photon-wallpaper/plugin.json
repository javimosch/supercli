{
  "name": "photon-wallpaper",
  "version": "0.1.0",
  "description": "Sync wallpapers with Bing and Reddit image sources",
  "source": "https://github.com/luigiplr/photon-wallpaper",
  "checks": [{ "type": "binary", "name": "photon-wallpaper" }],
  "install_guidance": {
    "plugin": "photon-wallpaper",
    "binary": "photon-wallpaper",
    "check": "which photon-wallpaper",
    "install_steps": ["git clone and install", "Verify: photon-wallpaper --version", "supercli plugins install ./plugins/photon-wallpaper --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "photon-wallpaper",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to photon-wallpaper CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "photon-wallpaper",
      "passthrough": true,
      "missingDependencyHelp": "Install photon-wallpaper: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
