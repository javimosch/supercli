{
  "name": "synology-locate-file-search-cli",
  "version": "0.1.0",
  "description": "locate / mlocate / updatedb - Synology File Search in a docker container",
  "source": "https://github.com/synology-locate-file-search-cli/synology-locate-file-search-cli",
  "checks": [
    {
      "type": "binary",
      "name": "synology-locate-file-search-cli"
    }
  ],
  "install_guidance": {
    "plugin": "synology-locate-file-search-cli",
    "binary": "synology-locate-file-search-cli",
    "check": "which synology-locate-file-search-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: synology-locate-file-search-cli --version",
      "supercli plugins install ./plugins/synology-locate-file-search-cli --on-conflict replace --json"
    ],
    "note": "Shell language CLI tool"
  },
  "commands": [
    {
      "namespace": "synology-locate-file-search-cli",
      "resource": "self",
      "action": "version",
      "description": "Print synology-locate-file-search-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "synology-locate-file-search-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install synology-locate-file-search-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "synology-locate-file-search-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to synology-locate-file-search-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "synology-locate-file-search-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install synology-locate-file-search-cli from project repository"
      },
      "args": []
    }
  ]
}