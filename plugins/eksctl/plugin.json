{
  "name": "eksctl",
  "version": "0.1.0",
  "description": "Simple command-line tool for creating clusters on Amazon EKS",
  "checks": [
    {
      "type": "binary",
      "name": "eksctl"
    }
  ],
  "install_guidance": {
    "plugin": "eksctl",
    "binary": "eksctl",
    "check": "which eksctl",
    "install_steps": [
      "brew install eksctl",
      "Verify: eksctl --version",
      "supercli plugins install ./plugins/eksctl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "eksctl",
      "resource": "self",
      "action": "version",
      "description": "Print eksctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eksctl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eksctl: brew install eksctl"
      },
      "args": []
    },
    {
      "namespace": "eksctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eksctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eksctl",
        "passthrough": true,
        "missingDependencyHelp": "Install eksctl"
      },
      "args": []
    }
  ]
}