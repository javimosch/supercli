{
  "name": "senv",
  "version": "0.1.0",
  "description": ".env file encryption and decryption tool",
  "source": "https://github.com/nicm/senv",
  "checks": [
    {
      "type": "binary",
      "name": "senv"
    }
  ],
  "install_guidance": {
    "plugin": "senv",
    "binary": "senv",
    "check": "which senv",
    "install_steps": [
      "npm install -g senv",
      "Verify: senv --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "senv",
      "resource": "self",
      "action": "version",
      "description": "Print senv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "senv",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install senv: npm install -g senv"
      },
      "args": []
    },
    {
      "namespace": "senv",
      "resource": "env",
      "action": "encrypt",
      "description": "Encrypt .env files to protect sensitive values",
      "adapter": "process",
      "adapterConfig": {
        "command": "senv",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install senv: npm install -g senv"
      },
      "args": []
    },
    {
      "namespace": "senv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to senv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "senv",
        "passthrough": true,
        "missingDependencyHelp": "Install senv: npm install -g senv"
      },
      "args": []
    }
  ]
}