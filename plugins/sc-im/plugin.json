{
  "name": "sc-im",
  "version": "1.0.0",
  "description": "sc-im \u2014 Spreadsheet calculator (ncurses)",
  "source": "github.com/andmarti1424/sc-im",
  "checks": [
    {
      "type": "binary",
      "name": "sc-im"
    }
  ],
  "install_guidance": {
    "plugin": "sc-im",
    "binary": "sc-im",
    "check": "which sc-im",
    "install_steps": [
      "# Install sc-im:",
      "# apt: sudo apt-get install sc-im",
      "# brew: brew install sc-im",
      "# cargo: cargo install sc-im",
      "# npm: npm install -g sc-im",
      "# pip: pip install sc-im",
      "# or download from github.com/andmarti1424/sc-im"
    ]
  },
  "commands": [
    {
      "namespace": "sc",
      "resource": "im",
      "action": "run",
      "description": "Run sc-im",
      "adapter": "process",
      "adapterConfig": {
        "command": "sc-im",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install sc-im from github.com/andmarti1424/sc-im"
      },
      "args": []
    }
  ]
}