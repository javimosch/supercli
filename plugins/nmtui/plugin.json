{
  "name": "nmtui",
  "version": "0.1.0",
  "description": "CLI tool: nmtui",
  "source": "https://manpages.debian.org/nmtui",
  "checks": [
    {
      "type": "binary",
      "name": "nmtui"
    }
  ],
  "install_guidance": {
    "plugin": "nmtui",
    "binary": "nmtui",
    "check": "which nmtui",
    "install_steps": [
      "apt-get install nmtui 2>/dev/null || which nmtui",
      "Verify: nmtui --version",
      "supercli plugins install ./plugins/nmtui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nmtui",
      "resource": "self",
      "action": "version",
      "description": "Print nmtui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nmtui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nmtui: apt-get install nmtui 2>/dev/null || which nmtui"
      },
      "args": []
    },
    {
      "namespace": "nmtui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nmtui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nmtui",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nmtui: apt-get install nmtui 2>/dev/null || which nmtui"
      },
      "args": []
    }
  ]
}