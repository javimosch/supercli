{
  "name": "ascii85",
  "version": "0.1.0",
  "description": "ascii85 \u2014 encodes or decodes files using Ascii85 ruby library",
  "source": "https://packages.debian.org/ascii85",
  "checks": [{ "type": "binary", "name": "ascii85" }],
  "install_guidance": {
    "plugin": "ascii85", "binary": "ascii85", "check": "which ascii85",
    "install_steps": ["apt-get install ascii85 2>/dev/null || which ascii85", "Verify: ascii85 --version", "supercli plugins install ./plugins/ascii85 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ascii85", "resource": "_", "action": "_",
    "description": "Passthrough to ascii85 CLI",
    "adapter": "process", "adapterConfig": { "command": "ascii85", "passthrough": true, "missingDependencyHelp": "Install ascii85: apt-get install ascii85" }, "args": []
  }]
}
