{
  "name": "libmagic",
  "version": "0.1.0",
  "description": "Implementation of the file(1) command",
  "checks": [
    {
      "type": "binary",
      "name": "libmagic"
    }
  ],
  "install_guidance": {
    "plugin": "libmagic",
    "binary": "libmagic",
    "check": "which libmagic",
    "install_steps": [
      "brew install libmagic",
      "Verify: libmagic --version",
      "supercli plugins install ./plugins/libmagic --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libmagic",
      "resource": "self",
      "action": "version",
      "description": "Print libmagic version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libmagic",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libmagic: brew install libmagic"
      },
      "args": []
    },
    {
      "namespace": "libmagic",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libmagic CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libmagic",
        "passthrough": true,
        "missingDependencyHelp": "Install libmagic"
      },
      "args": []
    }
  ]
}