{
  "name": "wordfreq",
  "version": "0.1.0",
  "description": "Access word frequency data for many languages",
  "source": "https://github.com/rspeer/wordfreq",
  "checks": [{ "type": "binary", "name": "wordfreq" }],
  "install_guidance": {
    "plugin": "wordfreq",
    "binary": "wordfreq",
    "check": "which wordfreq",
    "install_steps": ["pip install wordfreq", "Verify: wordfreq --version", "supercli plugins install ./plugins/wordfreq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wordfreq",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wordfreq CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wordfreq",
      "passthrough": true,
      "missingDependencyHelp": "Install wordfreq: pip install wordfreq", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
