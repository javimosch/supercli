{
  "name": "mx",
  "version": "0.1.0",
  "description": "A tmux session manager written as a single Bash script.",
  "checks": [
    {
      "type": "binary",
      "name": "mx"
    }
  ],
  "install_guidance": {
    "plugin": "mx",
    "binary": "mx",
    "check": "which mx",
    "install_steps": [
      "brew install mx",
      "Verify: mx --version",
      "supercli plugins install ./plugins/mx --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "mx",
      "resource": "self",
      "action": "version",
      "description": "Print mx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mx: brew install mx"
      },
      "args": []
    },
    {
      "namespace": "mx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mx",
        "passthrough": true,
        "missingDependencyHelp": "Install mx"
      },
      "args": []
    }
  ]
}