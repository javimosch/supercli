{
  "name": "huly-selfhost",
  "version": "0.1.0",
  "description": "Huly for Self Hosting",
  "source": "https://github.com/huly-selfhost/huly-selfhost",
  "checks": [
    {
      "type": "binary",
      "name": "huly-selfhost"
    }
  ],
  "install_guidance": {
    "plugin": "huly-selfhost",
    "binary": "huly-selfhost",
    "check": "which huly-selfhost",
    "install_steps": [
      "pip install huly-selfhost",
      "Verify: huly-selfhost --version",
      "supercli plugins install ./plugins/huly-selfhost --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "huly-selfhost",
      "resource": "self",
      "action": "version",
      "description": "Print huly-selfhost version",
      "adapter": "process",
      "adapterConfig": {
        "command": "huly-selfhost",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install huly-selfhost: pip install huly-selfhost"
      },
      "args": []
    },
    {
      "namespace": "huly-selfhost",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to huly-selfhost CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "huly-selfhost",
        "passthrough": true,
        "missingDependencyHelp": "Install huly-selfhost: pip install huly-selfhost"
      },
      "args": []
    }
  ]
}