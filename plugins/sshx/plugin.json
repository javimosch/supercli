{
  "name": "sshx",
  "version": "0.1.0",
  "description": "Share your terminal as a secure, multiplayer, end-to-end-encrypted session on an infinite canvas via one browser link",
  "source": "https://github.com/ekzhang/sshx",
  "checks": [
    { "type": "binary", "name": "sshx" }
  ],
  "install_guidance": {
    "plugin": "sshx",
    "binary": "sshx",
    "check": "which sshx",
    "install_steps": [
      "curl -sSf https://sshx.io/get | sh",
      "Or: cargo install sshx",
      "Or: brew install sshx",
      "Verify: sshx --version",
      "supercli plugins install ./plugins/sshx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sshx",
      "resource": "self",
      "action": "version",
      "description": "Print sshx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sshx",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install sshx: curl -sSf https://sshx.io/get | sh"
      },
      "args": []
    },
    {
      "namespace": "sshx",
      "resource": "session",
      "action": "start",
      "description": "Start a shared terminal session and print a join link (https://sshx.io/s/...). Blocks until session ends. Use --name to set display name",
      "adapter": "process",
      "adapterConfig": {
        "command": "sshx",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install sshx: curl -sSf https://sshx.io/get | sh"
      },
      "args": []
    },
    {
      "namespace": "sshx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sshx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sshx",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install sshx: curl -sSf https://sshx.io/get | sh"
      },
      "args": []
    }
  ]
}
