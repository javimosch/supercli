{
  "name": "cookcli",
  "version": "0.1.0",
  "description": "CLI for parsing planning and managing Cooklang recipes",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "cookcli" }],
  "install_guidance": {
    "plugin": "cookcli",
    "binary": "cookcli",
    "check": "which cookcli",
    "install_steps": ["brew install cookcli", "Verify: cookcli --version", "supercli plugins install ./plugins/cookcli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cookcli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cookcli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cookcli",
      "passthrough": true,
      "missingDependencyHelp": "Install cookcli: brew install cookcli"
    },
    "args": []
  }]
}
