{
  "name": "cloud-nuke",
  "version": "0.1.0",
  "description": "Tool for cleaning up cloud resources across AWS accounts",
  "source": "https://github.com/gruntwork-io/cloud-nuke",
  "checks": [{ "type": "binary", "name": "cloud-nuke" }],
  "install_guidance": {
    "plugin": "cloud-nuke",
    "binary": "cloud-nuke",
    "check": "which cloud-nuke",
    "install_steps": ["brew install cloud-nuke", "Verify: cloud-nuke --version", "supercli plugins install ./plugins/cloud-nuke --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cloud-nuke",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cloud-nuke CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cloud-nuke",
      "passthrough": true,
      "missingDependencyHelp": "Install cloud-nuke: brew install cloud-nuke"
    },
    "args": []
  }]
}
