{
  "name": "camoufox",
  "version": "0.1.0",
  "description": "\ud83e\udd8a Anti-detect browser",
  "source": "https://github.com/camoufox/camoufox",
  "checks": [
    {
      "type": "binary",
      "name": "camoufox"
    }
  ],
  "install_guidance": {
    "plugin": "camoufox",
    "binary": "camoufox",
    "check": "which camoufox",
    "install_steps": [
      "pip install camoufox",
      "Verify: camoufox --version",
      "supercli plugins install ./plugins/camoufox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "camoufox",
      "resource": "self",
      "action": "version",
      "description": "Print camoufox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "camoufox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install camoufox: pip install camoufox"
      },
      "args": []
    },
    {
      "namespace": "camoufox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to camoufox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "camoufox",
        "passthrough": true,
        "missingDependencyHelp": "Install camoufox: pip install camoufox"
      },
      "args": []
    }
  ]
}