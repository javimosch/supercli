{
  "name": "helixdb",
  "version": "0.1.0",
  "description": "Graph-vector database CLI for building and querying knowledge graphs",
  "source": "https://github.com/helixdb/helixdb",
  "checks": [
    {
      "type": "binary",
      "name": "helixdb"
    }
  ],
  "install_guidance": {
    "plugin": "helixdb",
    "binary": "helixdb",
    "check": "which helixdb",
    "install_steps": [
      "cargo install helixdb",
      "Verify: helixdb --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "helixdb",
      "resource": "self",
      "action": "version",
      "description": "Print helixdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "helixdb",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install helixdb: cargo install helixdb"
      },
      "args": []
    },
    {
      "namespace": "helixdb",
      "resource": "db",
      "action": "query",
      "description": "Query the HelixDB graph-vector database",
      "adapter": "process",
      "adapterConfig": {
        "command": "helixdb",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install helixdb: cargo install helixdb"
      },
      "args": []
    },
    {
      "namespace": "helixdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to helixdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "helixdb",
        "passthrough": true,
        "missingDependencyHelp": "Install helixdb: cargo install helixdb"
      },
      "args": []
    }
  ]
}