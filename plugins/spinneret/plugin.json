{
  "name": "spinneret",
  "version": "0.1.0",
  "description": "Terminal spinner collection with many styles",
  "source": "https://github.com/thynson/spinneret",
  "checks": [{ "type": "binary", "name": "spinneret" }],
  "install_guidance": {
    "plugin": "spinneret",
    "binary": "spinneret",
    "check": "which spinneret",
    "install_steps": ["npm install -g spinneret", "Verify: spinneret --version", "supercli plugins install ./plugins/spinneret --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "spinneret",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to spinneret CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "spinneret",
      "passthrough": true,
      "missingDependencyHelp": "Install spinneret: npm install -g spinneret", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
