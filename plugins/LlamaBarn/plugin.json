{
  "name": "LlamaBarn",
  "version": "0.1.0",
  "description": "A cosy home for your LLMs.",
  "source": "https://github.com/LlamaBarn/LlamaBarn",
  "checks": [
    {
      "type": "binary",
      "name": "llamabarn"
    }
  ],
  "install_guidance": {
    "plugin": "LlamaBarn",
    "binary": "llamabarn",
    "check": "which llamabarn",
    "install_steps": [
      "pip install llamabarn",
      "Verify: llamabarn --version",
      "supercli plugins install ./plugins/LlamaBarn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LlamaBarn",
      "resource": "self",
      "action": "version",
      "description": "Print LlamaBarn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llamabarn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LlamaBarn: pip install llamabarn"
      },
      "args": []
    },
    {
      "namespace": "LlamaBarn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llamabarn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llamabarn",
        "passthrough": true,
        "missingDependencyHelp": "Install LlamaBarn: pip install llamabarn"
      },
      "args": []
    }
  ]
}