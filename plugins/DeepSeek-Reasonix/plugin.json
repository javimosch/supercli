{
  "name": "DeepSeek-Reasonix",
  "version": "0.1.0",
  "description": "DeepSeek-native AI coding agent for your terminal. Engineered around prefix-cache stability \u2014 leave ",
  "source": "https://github.com/DeepSeek-Reasonix/DeepSeek-Reasonix",
  "checks": [
    {
      "type": "binary",
      "name": "deepseek-reasonix"
    }
  ],
  "install_guidance": {
    "plugin": "DeepSeek-Reasonix",
    "binary": "deepseek-reasonix",
    "check": "which deepseek-reasonix",
    "install_steps": [
      "pip install deepseek-reasonix",
      "Verify: deepseek-reasonix --version",
      "supercli plugins install ./plugins/DeepSeek-Reasonix --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DeepSeek-Reasonix",
      "resource": "self",
      "action": "version",
      "description": "Print DeepSeek-Reasonix version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepseek-reasonix",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DeepSeek-Reasonix: pip install deepseek-reasonix"
      },
      "args": []
    },
    {
      "namespace": "DeepSeek-Reasonix",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deepseek-reasonix CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepseek-reasonix",
        "passthrough": true,
        "missingDependencyHelp": "Install DeepSeek-Reasonix: pip install deepseek-reasonix"
      },
      "args": []
    }
  ]
}