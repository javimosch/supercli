{
  "name": "editres",
  "version": "0.1.0",
  "description": "CLI tool: editres",
  "source": "https://manpages.debian.org/editres",
  "checks": [
    {
      "type": "binary",
      "name": "editres"
    }
  ],
  "install_guidance": {
    "plugin": "editres",
    "binary": "editres",
    "check": "which editres",
    "install_steps": [
      "apt-get install editres 2>/dev/null || which editres",
      "Verify: editres --version",
      "supercli plugins install ./plugins/editres --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "editres",
      "resource": "self",
      "action": "version",
      "description": "Print editres version",
      "adapter": "process",
      "adapterConfig": {
        "command": "editres",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install editres: apt-get install editres 2>/dev/null || which editres"
      },
      "args": []
    },
    {
      "namespace": "editres",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to editres CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "editres",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install editres: apt-get install editres 2>/dev/null || which editres"
      },
      "args": []
    }
  ]
}