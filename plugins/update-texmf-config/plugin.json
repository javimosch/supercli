{
  "name": "update-texmf-config",
  "version": "0.1.0",
  "description": "update-texmf-config \u2014 script used in maintainer scripts to trigger tex-common actions",
  "source": "https://manpages.debian.org/update-texmf-config",
  "checks": [
    {
      "type": "binary",
      "name": "update-texmf-config"
    }
  ],
  "install_guidance": {
    "plugin": "update-texmf-config",
    "binary": "update-texmf-config",
    "check": "which update-texmf-config",
    "install_steps": [
      "apt-get install update-texmf-config 2>/dev/null || which update-texmf-config",
      "Verify: update-texmf-config --version",
      "supercli plugins install ./plugins/update-texmf-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "update-texmf-config",
      "resource": "self",
      "action": "version",
      "description": "Print update-texmf-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "update-texmf-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install update-texmf-config: apt-get install update-texmf-config 2>/dev/null || which update-texmf-config"
      },
      "args": []
    },
    {
      "namespace": "update-texmf-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to update-texmf-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "update-texmf-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install update-texmf-config: apt-get install update-texmf-config 2>/dev/null || which update-texmf-config"
      },
      "args": []
    }
  ]
}