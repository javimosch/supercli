{
  "name": "lipgloss-cli",
  "version": "0.1.0",
  "description": "Style terminal output with CSS-like definitions in Go",
  "source": "https://github.com/charmbracelet/lipgloss",
  "checks": [{ "type": "binary", "name": "lipgloss" }],
  "install_guidance": {
    "plugin": "lipgloss-cli",
    "binary": "lipgloss",
    "check": "which lipgloss",
    "install_steps": ["brew install lipgloss", "Verify: lipgloss --version", "supercli plugins install ./plugins/lipgloss-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lipgloss-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lipgloss CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lipgloss",
      "passthrough": true,
      "missingDependencyHelp": "Install lipgloss-cli: brew install lipgloss"
    },
    "args": []
  }]
}
