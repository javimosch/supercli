{
  "name": "agentscope",
  "version": "0.1.0",
  "description": "Build and run agents you can see, understand and trust.",
  "source": "https://github.com/agentscope/agentscope",
  "checks": [
    {
      "type": "binary",
      "name": "agentscope"
    }
  ],
  "install_guidance": {
    "plugin": "agentscope",
    "binary": "agentscope",
    "check": "which agentscope",
    "install_steps": [
      "pip install agentscope",
      "Verify: agentscope --version",
      "supercli plugins install ./plugins/agentscope --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agentscope",
      "resource": "self",
      "action": "version",
      "description": "Print agentscope version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentscope",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agentscope: pip install agentscope"
      },
      "args": []
    },
    {
      "namespace": "agentscope",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agentscope CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agentscope",
        "passthrough": true,
        "missingDependencyHelp": "Install agentscope: pip install agentscope"
      },
      "args": []
    }
  ]
}