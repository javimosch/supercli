{
  "name": "corral",
  "version": "0.1.0",
  "description": "Dependency manager for the Pony language",
  "source": "https://github.com/ponylang/corral",
  "checks": [
    {
      "type": "binary",
      "name": "corral"
    }
  ],
  "install_guidance": {
    "plugin": "corral",
    "binary": "corral",
    "check": "which corral",
    "install_steps": [
      "brew install corral",
      "Verify: corral --version",
      "supercli plugins install ./plugins/corral --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "corral",
      "resource": "self",
      "action": "version",
      "description": "Print corral version",
      "adapter": "process",
      "adapterConfig": {
        "command": "corral",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install corral: brew install corral"
      },
      "args": []
    },
    {
      "namespace": "corral",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to corral CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "corral",
        "passthrough": true,
        "missingDependencyHelp": "Install corral"
      },
      "args": []
    }
  ]
}