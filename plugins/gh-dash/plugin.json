{
  "name": "gh-dash",
  "version": "0.1.0",
  "description": "GitHub CLI extension for beautiful dashboards",
  "source": "https://github.com/dlvhdr/gh-dash",
  "checks": [{ "type": "binary", "name": "gh-dash" }],
  "install_guidance": {
    "plugin": "gh-dash",
    "binary": "gh-dash",
    "check": "which gh-dash",
    "install_steps": ["gh extension install dlvhdr/gh-dash", "Verify: gh-dash --version", "supercli plugins install ./plugins/gh-dash --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gh-dash",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gh-dash CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gh-dash",
      "passthrough": true,
      "missingDependencyHelp": "Install gh-dash: gh extension install dlvhdr/gh-dash", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
