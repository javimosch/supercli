{
  "name": "MoggInspectorCLI",
  "version": "0.1.0",
  "description": "Command line tool using MoggInspectorLib to inspect moggs",
  "source": "https://github.com/MoggInspectorCLI/MoggInspectorCLI",
  "checks": [
    {
      "type": "binary",
      "name": "MoggInspectorCLI"
    }
  ],
  "install_guidance": {
    "plugin": "MoggInspectorCLI",
    "binary": "MoggInspectorCLI",
    "check": "which MoggInspectorCLI",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: MoggInspectorCLI --version",
      "supercli plugins install ./plugins/MoggInspectorCLI --on-conflict replace --json"
    ],
    "note": "C# language CLI tool"
  },
  "commands": [
    {
      "namespace": "MoggInspectorCLI",
      "resource": "self",
      "action": "version",
      "description": "Print MoggInspectorCLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "MoggInspectorCLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MoggInspectorCLI from project repository"
      },
      "args": []
    },
    {
      "namespace": "MoggInspectorCLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to MoggInspectorCLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "MoggInspectorCLI",
        "passthrough": true,
        "missingDependencyHelp": "Install MoggInspectorCLI from project repository"
      },
      "args": []
    }
  ]
}