{
  "name": "claude-squad",
  "version": "0.1.0",
  "description": "Manage multiple AI terminal agents like Claude Code, Codex, OpenCode, and Amp.",
  "source": "https://github.com/claude-squad/claude-squad",
  "checks": [
    {
      "type": "binary",
      "name": "claude-squad"
    }
  ],
  "install_guidance": {
    "plugin": "claude-squad",
    "binary": "claude-squad",
    "check": "which claude-squad",
    "install_steps": [
      "pip install claude-squad",
      "Verify: claude-squad --version",
      "supercli plugins install ./plugins/claude-squad --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-squad",
      "resource": "self",
      "action": "version",
      "description": "Print claude-squad version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-squad",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-squad: pip install claude-squad"
      },
      "args": []
    },
    {
      "namespace": "claude-squad",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-squad CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-squad",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-squad: pip install claude-squad"
      },
      "args": []
    }
  ]
}