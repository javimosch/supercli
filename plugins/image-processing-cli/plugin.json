{
  "name": "image-processing-cli",
  "version": "0.1.0",
  "description": "A CLI tool for processing image batches.",
  "source": "https://github.com/image-processing-cli/image-processing-cli",
  "checks": [
    {
      "type": "binary",
      "name": "image-processing-cli"
    }
  ],
  "install_guidance": {
    "plugin": "image-processing-cli",
    "binary": "image-processing-cli",
    "check": "which image-processing-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: image-processing-cli --version",
      "supercli plugins install ./plugins/image-processing-cli --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "image-processing-cli",
      "resource": "self",
      "action": "version",
      "description": "Print image-processing-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "image-processing-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install image-processing-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "image-processing-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to image-processing-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "image-processing-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install image-processing-cli from project repository"
      },
      "args": []
    }
  ]
}