{
  "name": "cd-paranoia",
  "version": "0.1.0",
  "description": "CLI tool: cd-paranoia",
  "source": "https://packages.debian.org/cd-paranoia",
  "checks": [{ "type": "binary", "name": "cd-paranoia" }],
  "install_guidance": {
    "plugin": "cd-paranoia", "binary": "cd-paranoia", "check": "which cd-paranoia",
    "install_steps": ["apt-get install cd-paranoia 2>/dev/null || which cd-paranoia", "Verify: cd-paranoia --version", "supercli plugins install ./plugins/cd-paranoia --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cd-paranoia", "resource": "_", "action": "_",
    "description": "Passthrough to cd-paranoia CLI",
    "adapter": "process", "adapterConfig": { "command": "cd-paranoia", "passthrough": true, "missingDependencyHelp": "Install cd-paranoia: apt-get install cd-paranoia" }, "args": []
  }]
}
