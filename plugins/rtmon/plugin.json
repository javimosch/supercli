{
  "name": "rtmon",
  "version": "1.0.0",
  "description": "rtmon \u2014 rtmon \u2014 CLI utility",
  "source": "/usr/sbin/rtmon",
  "checks": [
    {
      "type": "binary",
      "name": "rtmon"
    }
  ],
  "install_guidance": {
    "plugin": "rtmon",
    "binary": "rtmon",
    "check": "which rtmon",
    "install_steps": [
      "# Install rtmon:",
      "# apt: sudo apt-get install rtmon",
      "# brew: brew install rtmon",
      "# cargo: cargo install rtmon",
      "# npm: npm install -g rtmon",
      "# pip: pip install rtmon",
      "# or download from /usr/sbin/rtmon"
    ]
  },
  "commands": [
    {
      "namespace": "rtmon",
      "resource": "rtmon",
      "action": "run",
      "description": "Run rtmon",
      "adapter": "process",
      "adapterConfig": {
        "command": "rtmon",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rtmon from /usr/sbin/rtmon"
      },
      "args": []
    }
  ]
}