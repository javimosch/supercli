{
  "plugin": "rtmon",
  "binary": "rtmon",
  "check": "which rtmon",
  "install_steps": [
    "# Install rtmon",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rtmon-linux-amd64 -o /usr/local/bin/rtmon",
    "chmod +x /usr/local/bin/rtmon",
    "# Or via package manager, see /usr/sbin/rtmon"
  ]
}