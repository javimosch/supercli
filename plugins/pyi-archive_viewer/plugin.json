{
  "name": "pyi-archive_viewer",
  "version": "0.1.0",
  "description": "CLI tool: pyi-archive_viewer",
  "source": "https://manpages.debian.org/pyi-archive_viewer",
  "checks": [
    {
      "type": "binary",
      "name": "pyi-archive_viewer"
    }
  ],
  "install_guidance": {
    "plugin": "pyi-archive_viewer",
    "binary": "pyi-archive_viewer",
    "check": "which pyi-archive_viewer",
    "install_steps": [
      "apt-get install pyi-archive_viewer 2>/dev/null || which pyi-archive_viewer",
      "Verify: pyi-archive_viewer --version",
      "supercli plugins install ./plugins/pyi-archive_viewer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyi-archive_viewer",
      "resource": "self",
      "action": "version",
      "description": "Print pyi-archive_viewer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-archive_viewer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyi-archive_viewer: apt-get install pyi-archive_viewer 2>/dev/null || which pyi-archive_viewer"
      },
      "args": []
    },
    {
      "namespace": "pyi-archive_viewer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyi-archive_viewer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-archive_viewer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyi-archive_viewer: apt-get install pyi-archive_viewer 2>/dev/null || which pyi-archive_viewer"
      },
      "args": []
    }
  ]
}