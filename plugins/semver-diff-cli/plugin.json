{
  "name": "semver-diff-cli",
  "version": "0.1.0",
  "description": "A semantic version comparison and diff tool. Compares semver versions, identifies breaking changes, and computes version bump types from the CLI.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "semver-diff-cli"
    }
  ],
  "install_guidance": {
    "plugin": "semver-diff-cli",
    "binary": "semver-diff-cli",
    "check": "which semver-diff-cli",
    "install_steps": [
      "cargo install semver-diff-cli",
      "Verify: semver-diff-cli --version",
      "supercli plugins install ./plugins/semver-diff-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "semver-diff-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to semver-diff-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "semver-diff-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install semver-diff-cli: cargo install semver-diff-cli"
      },
      "args": []
    }
  ]
}
