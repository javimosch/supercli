{
  "name": "gemini",
  "version": "0.1.0",
  "description": "Kubernetes cluster state consistency checker",
  "source": "https://github.com/FairwindsOps/gemini",
  "checks": [{ "type": "binary", "name": "gemini" }],
  "install_guidance": {
    "plugin": "gemini",
    "binary": "gemini",
    "check": "which gemini",
    "install_steps": ["brew install gemini", "Verify: gemini --version", "supercli plugins install ./plugins/gemini --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gemini",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gemini CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gemini",
      "passthrough": true,
      "missingDependencyHelp": "Install gemini: brew install gemini"
    },
    "args": []
  }]
}
