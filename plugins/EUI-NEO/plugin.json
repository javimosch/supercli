{
  "name": "EUI-NEO",
  "version": "0.1.0",
  "description": "EUI-NEO is a cross-platform, high-performance, low-overhead C++17 UI framework built on OpenGL and G",
  "source": "https://github.com/EUI-NEO/EUI-NEO",
  "checks": [
    {
      "type": "binary",
      "name": "eui-neo"
    }
  ],
  "install_guidance": {
    "plugin": "EUI-NEO",
    "binary": "eui-neo",
    "check": "which eui-neo",
    "install_steps": [
      "pip install eui-neo",
      "Verify: eui-neo --version",
      "supercli plugins install ./plugins/EUI-NEO --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "EUI-NEO",
      "resource": "self",
      "action": "version",
      "description": "Print EUI-NEO version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eui-neo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install EUI-NEO: pip install eui-neo"
      },
      "args": []
    },
    {
      "namespace": "EUI-NEO",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eui-neo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eui-neo",
        "passthrough": true,
        "missingDependencyHelp": "Install EUI-NEO: pip install eui-neo"
      },
      "args": []
    }
  ]
}