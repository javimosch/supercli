{
  "name": "keccak256-cli",
  "version": "0.1.0",
  "description": "keccak256 encryption cli program; accepts input text from stdin. Suitable for commandline users",
  "source": "https://crates.io/crates/keccak256-cli",
  "checks": [
    {
      "type": "binary",
      "name": "keccak256-cli"
    }
  ],
  "install_guidance": {
    "plugin": "keccak256-cli",
    "binary": "keccak256-cli",
    "check": "which keccak256-cli",
    "install_steps": [
      "Check https://crates.io/crates/keccak256-cli for installation instructions",
      "Verify: keccak256-cli --version",
      "supercli plugins install ./plugins/keccak256-cli --on-conflict replace --json"
    ],
    "note": "Rust language CLI tool"
  },
  "commands": [
    {
      "namespace": "keccak256-cli",
      "resource": "self",
      "action": "version",
      "description": "Print keccak256-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "keccak256-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install keccak256-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "keccak256-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to keccak256-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "keccak256-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install keccak256-cli from project repository"
      },
      "args": []
    }
  ]
}