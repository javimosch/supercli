{
  "name": "bttf",
  "version": "0.1.0",
  "description": "CLI tool for datetime arithmetic, parsing, formatting and more",
  "source": "https://github.com/BurntSushi/bttf",
  "checks": [
    {
      "type": "binary",
      "name": "bttf"
    }
  ],
  "install_guidance": {
    "plugin": "bttf",
    "binary": "bttf",
    "check": "which bttf",
    "install_steps": [
      "brew install bttf",
      "Verify: bttf --version",
      "supercli plugins install ./plugins/bttf --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bttf",
      "resource": "self",
      "action": "version",
      "description": "Print bttf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bttf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bttf: brew install bttf"
      },
      "args": []
    },
    {
      "namespace": "bttf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bttf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bttf",
        "passthrough": true,
        "missingDependencyHelp": "Install bttf"
      },
      "args": []
    }
  ]
}