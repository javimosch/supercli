{
  "name": "smem",
  "version": "0.1.0",
  "description": "smem — memory reporting tool with RSS, PSS, and USS metrics",
  "source": "https://www.selenic.com/smem/",
  "checks": [
    {
      "type": "binary",
      "name": "smem"
    }
  ],
  "install_guidance": {
    "plugin": "smem",
    "binary": "smem",
    "check": "which smem",
    "install_steps": [
      "pip install smem",
      "Verify: smem --version",
      "supercli plugins install ./plugins/smem --on-conflict replace --json"
    ],
    "note": "Also available via apt: sudo apt-get install smem. Provides unique memory reporting features including Proportional Set Size (PSS) and Unique Set Size (USS)."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "smem",
      "resource": "self",
      "action": "version",
      "description": "Print smem version",
      "adapter": "process",
      "adapterConfig": {
        "command": "smem",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install smem: pip install smem"
      },
      "args": []
    },
    {
      "namespace": "smem",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to smem CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "smem",
        "passthrough": true,
        "missingDependencyHelp": "Install smem: pip install smem"
      },
      "args": []
    }
  ]
}
