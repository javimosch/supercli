{
  "name": "dh_makeshlibs",
  "version": "0.1.0",
  "description": "CLI tool: dh_makeshlibs",
  "source": "https://packages.debian.org/dh_makeshlibs",
  "checks": [{ "type": "binary", "name": "dh_makeshlibs" }],
  "install_guidance": {
    "plugin": "dh_makeshlibs", "binary": "dh_makeshlibs", "check": "which dh_makeshlibs",
    "install_steps": ["apt-get install dh_makeshlibs 2>/dev/null || which dh_makeshlibs", "Verify: dh_makeshlibs --version", "supercli plugins install ./plugins/dh_makeshlibs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_makeshlibs", "resource": "_", "action": "_",
    "description": "Passthrough to dh_makeshlibs CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_makeshlibs", "passthrough": true, "missingDependencyHelp": "Install dh_makeshlibs: apt-get install dh_makeshlibs" }, "args": []
  }]
}
