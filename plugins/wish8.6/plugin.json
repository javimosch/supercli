{
  "name": "wish8.6",
  "version": "0.1.0",
  "description": "CLI tool: wish8.6",
  "source": "https://manpages.debian.org/wish8.6",
  "checks": [
    {
      "type": "binary",
      "name": "wish8.6"
    }
  ],
  "install_guidance": {
    "plugin": "wish8.6",
    "binary": "wish8.6",
    "check": "which wish8.6",
    "install_steps": [
      "apt-get install wish8.6 2>/dev/null || which wish8.6",
      "Verify: wish8.6 --version",
      "supercli plugins install ./plugins/wish8.6 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wish8.6",
      "resource": "self",
      "action": "version",
      "description": "Print wish8.6 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wish8.6",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wish8.6: apt-get install wish8.6 2>/dev/null || which wish8.6"
      },
      "args": []
    },
    {
      "namespace": "wish8.6",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wish8.6 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wish8.6",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wish8.6: apt-get install wish8.6 2>/dev/null || which wish8.6"
      },
      "args": []
    }
  ]
}