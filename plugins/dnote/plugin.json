{
  "name": "dnote",
  "version": "0.1.0",
  "description": "A interactive, multi-device notebook",
  "source": "https://github.com/dnote/dnote",
  "checks": [
    {
      "type": "binary",
      "name": "dnote"
    }
  ],
  "install_guidance": {
    "plugin": "dnote",
    "binary": "dnote",
    "check": "which dnote",
    "install_steps": [
      "brew install dnote",
      "Verify: dnote --version",
      "supercli plugins install ./plugins/dnote --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dnote",
      "resource": "self",
      "action": "version",
      "description": "Print dnote version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnote",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dnote: brew install dnote"
      },
      "args": []
    },
    {
      "namespace": "dnote",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dnote CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnote",
        "passthrough": true,
        "missingDependencyHelp": "Install dnote"
      },
      "args": []
    }
  ]
}