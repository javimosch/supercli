{
  "name": "kcat",
  "version": "0.1.0",
  "description": "Generic command-line non-JVM Apache Kafka producer and consumer",
  "source": "https://github.com/edenhill/kcat",
  "checks": [
    {
      "type": "binary",
      "name": "kcat"
    }
  ],
  "install_guidance": {
    "plugin": "kcat",
    "binary": "kcat",
    "check": "which kcat",
    "install_steps": [
      "brew install kcat",
      "Verify: kcat --version",
      "supercli plugins install ./plugins/kcat --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kcat",
      "resource": "self",
      "action": "version",
      "description": "Print kcat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kcat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kcat: brew install kcat"
      },
      "args": []
    },
    {
      "namespace": "kcat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kcat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kcat",
        "passthrough": true,
        "missingDependencyHelp": "Install kcat"
      },
      "args": []
    }
  ]
}