{
  "name": "blutils-cli",
  "version": "0.1.0",
  "description": "A bioinformatics data analysis CLI tool. Processes biological sequence data with structured output for genomics and computational biology pipelines.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "blutils-cli"
    }
  ],
  "install_guidance": {
    "plugin": "blutils-cli",
    "binary": "blutils-cli",
    "check": "which blutils-cli",
    "install_steps": [
      "cargo install blutils-cli",
      "Verify: blutils-cli --version",
      "supercli plugins install ./plugins/blutils-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "blutils-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to blutils-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "blutils-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install blutils-cli: cargo install blutils-cli"
      },
      "args": []
    }
  ]
}
