{
  "name": "iola",
  "version": "0.1.0",
  "description": "Socket client with REST API",
  "source": "https://github.com/pvarentsov/iola",
  "checks": [
    {
      "type": "binary",
      "name": "iola"
    }
  ],
  "install_guidance": {
    "plugin": "iola",
    "binary": "iola",
    "check": "which iola",
    "install_steps": [
      "See https://github.com/pvarentsov/iola",
      "Verify: iola --version",
      "supercli plugins install ./plugins/iola --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "iola",
      "resource": "self",
      "action": "version",
      "description": "Print iola version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iola",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iola: See https://github.com/pvarentsov/iola"
      },
      "args": []
    },
    {
      "namespace": "iola",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iola CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iola",
        "passthrough": true,
        "missingDependencyHelp": "Install iola"
      },
      "args": []
    }
  ]
}