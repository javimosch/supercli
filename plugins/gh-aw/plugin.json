{
  "name": "gh-aw",
  "version": "0.1.0",
  "description": "GitHub Agentic Workflows",
  "source": "https://github.com/gh-aw/gh-aw",
  "checks": [
    {
      "type": "binary",
      "name": "gh-aw"
    }
  ],
  "install_guidance": {
    "plugin": "gh-aw",
    "binary": "gh-aw",
    "check": "which gh-aw",
    "install_steps": [
      "pip install gh-aw",
      "Verify: gh-aw --version",
      "supercli plugins install ./plugins/gh-aw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gh-aw",
      "resource": "self",
      "action": "version",
      "description": "Print gh-aw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-aw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gh-aw: pip install gh-aw"
      },
      "args": []
    },
    {
      "namespace": "gh-aw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gh-aw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gh-aw",
        "passthrough": true,
        "missingDependencyHelp": "Install gh-aw: pip install gh-aw"
      },
      "args": []
    }
  ]
}