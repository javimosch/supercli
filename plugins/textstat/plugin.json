{
  "name": "textstat",
  "version": "0.1.0",
  "description": "Calculate readability scores for text documents",
  "source": "https://github.com/textstat/textstat",
  "checks": [{ "type": "binary", "name": "textstat" }],
  "install_guidance": {
    "plugin": "textstat",
    "binary": "textstat",
    "check": "which textstat",
    "install_steps": ["pip install textstat", "Verify: textstat --version", "supercli plugins install ./plugins/textstat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "textstat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to textstat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "textstat",
      "passthrough": true,
      "missingDependencyHelp": "Install textstat: pip install textstat", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
