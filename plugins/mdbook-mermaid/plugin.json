{
  "name": "mdbook-mermaid",
  "version": "0.1.0",
  "description": "Mermaid diagram preprocessor for mdBook projects",
  "source": "https://github.com/badboy/mdbook-mermaid",
  "checks": [{ "type": "binary", "name": "mdbook-mermaid" }],
  "install_guidance": {
    "plugin": "mdbook-mermaid",
    "binary": "mdbook-mermaid",
    "check": "which mdbook-mermaid",
    "install_steps": ["cargo install mdbook-mermaid", "Verify: mdbook-mermaid --version", "supercli plugins install ./plugins/mdbook-mermaid --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdbook-mermaid",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdbook-mermaid CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdbook-mermaid",
      "passthrough": true,
      "missingDependencyHelp": "Install mdbook-mermaid: cargo install mdbook-mermaid", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
