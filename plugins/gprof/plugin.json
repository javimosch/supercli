{
  "name": "gprof",
  "version": "1.0.0",
  "description": "gprof \u2014 Profiling tool",
  "source": "gnu.org/software/binutils",
  "checks": [
    {
      "type": "binary",
      "name": "gprof"
    }
  ],
  "install_guidance": {
    "plugin": "gprof",
    "binary": "gprof",
    "check": "which gprof",
    "install_steps": [
      "# Install gprof",
      "# See gnu.org/software/binutils",
      "# apt: sudo apt-get install gprof",
      "# brew: brew install gprof",
      "# cargo: cargo install gprof",
      "# npm: npm install -g gprof",
      "# pip: pip install gprof"
    ]
  },
  "commands": [
    {
      "namespace": "gprof",
      "resource": "gprof",
      "action": "run",
      "description": "Run gprof",
      "adapter": "process",
      "adapterConfig": {
        "command": "gprof",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gprof from gnu.org/software/binutils"
      },
      "args": []
    }
  ]
}