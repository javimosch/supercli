{
  "name": "ypdomainname",
  "version": "0.1.0",
  "description": "CLI tool: ypdomainname",
  "source": "https://manpages.debian.org/ypdomainname",
  "checks": [
    {
      "type": "binary",
      "name": "ypdomainname"
    }
  ],
  "install_guidance": {
    "plugin": "ypdomainname",
    "binary": "ypdomainname",
    "check": "which ypdomainname",
    "install_steps": [
      "apt-get install ypdomainname 2>/dev/null || which ypdomainname",
      "Verify: ypdomainname --version",
      "supercli plugins install ./plugins/ypdomainname --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ypdomainname",
      "resource": "self",
      "action": "version",
      "description": "Print ypdomainname version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ypdomainname",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ypdomainname: apt-get install ypdomainname 2>/dev/null || which ypdomainname"
      },
      "args": []
    },
    {
      "namespace": "ypdomainname",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ypdomainname CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ypdomainname",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ypdomainname: apt-get install ypdomainname 2>/dev/null || which ypdomainname"
      },
      "args": []
    }
  ]
}