{
  "name": "cargo-shear",
  "version": "0.1.0",
  "description": "Detect and remove unused dependencies from `Cargo.toml` in Rust projects",
  "source": "https://github.com/Boshen/cargo-shear",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-shear"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-shear",
    "binary": "cargo-shear",
    "check": "which cargo-shear",
    "install_steps": [
      "brew install cargo-shear",
      "Verify: cargo-shear --version",
      "supercli plugins install ./plugins/cargo-shear --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cargo-shear",
      "resource": "self",
      "action": "version",
      "description": "Print cargo-shear version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-shear",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-shear: brew install cargo-shear"
      },
      "args": []
    },
    {
      "namespace": "cargo-shear",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-shear CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-shear",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-shear"
      },
      "args": []
    }
  ]
}