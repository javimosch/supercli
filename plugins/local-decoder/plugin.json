{
  "name": "local-decoder",
  "version": "0.1.0",
  "description": "The Local Decoder CLI tool is a Rust-based command-line utility that allows you to decode encoded strings using different encoding algorithms.",
  "source": "https://github.com/local-decoder/local-decoder",
  "checks": [
    {
      "type": "binary",
      "name": "local-decoder"
    }
  ],
  "install_guidance": {
    "plugin": "local-decoder",
    "binary": "local-decoder",
    "check": "which local-decoder",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: local-decoder --version",
      "supercli plugins install ./plugins/local-decoder --on-conflict replace --json"
    ],
    "note": "Rust language CLI tool"
  },
  "commands": [
    {
      "namespace": "local-decoder",
      "resource": "self",
      "action": "version",
      "description": "Print local-decoder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "local-decoder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install local-decoder from project repository"
      },
      "args": []
    },
    {
      "namespace": "local-decoder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to local-decoder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "local-decoder",
        "passthrough": true,
        "missingDependencyHelp": "Install local-decoder from project repository"
      },
      "args": []
    }
  ]
}