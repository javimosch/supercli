{
  "name": "ink-kit",
  "version": "0.1.0",
  "description": "React component library for onchain applications - See README for modern alternatives",
  "source": "https://github.com/ink-kit/ink-kit",
  "checks": [
    {
      "type": "binary",
      "name": "ink-kit"
    }
  ],
  "install_guidance": {
    "plugin": "ink-kit",
    "binary": "ink-kit",
    "check": "which ink-kit",
    "install_steps": [
      "pip install ink-kit",
      "Verify: ink-kit --version",
      "supercli plugins install ./plugins/ink-kit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ink-kit",
      "resource": "self",
      "action": "version",
      "description": "Print ink-kit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ink-kit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ink-kit: pip install ink-kit"
      },
      "args": []
    },
    {
      "namespace": "ink-kit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ink-kit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ink-kit",
        "passthrough": true,
        "missingDependencyHelp": "Install ink-kit: pip install ink-kit"
      },
      "args": []
    }
  ]
}