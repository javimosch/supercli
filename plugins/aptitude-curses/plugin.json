{
  "name": "aptitude-curses",
  "version": "0.1.0",
  "description": "CLI tool: aptitude-curses",
  "source": "https://packages.debian.org/aptitude-curses",
  "checks": [{ "type": "binary", "name": "aptitude-curses" }],
  "install_guidance": {
    "plugin": "aptitude-curses", "binary": "aptitude-curses", "check": "which aptitude-curses",
    "install_steps": ["apt-get install aptitude-curses 2>/dev/null || which aptitude-curses", "Verify: aptitude-curses --version", "supercli plugins install ./plugins/aptitude-curses --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aptitude-curses", "resource": "_", "action": "_",
    "description": "Passthrough to aptitude-curses CLI",
    "adapter": "process", "adapterConfig": { "command": "aptitude-curses", "passthrough": true, "missingDependencyHelp": "Install aptitude-curses: apt-get install aptitude-curses" }, "args": []
  }]
}
