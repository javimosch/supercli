{
  "name": "urls-cli",
  "version": "0.1.0",
  "description": "Extract and validate URLs from text files",
  "source": "https://github.com/bahmutov/urls-cli",
  "checks": [{ "type": "binary", "name": "urls-cli" }],
  "install_guidance": {
    "plugin": "urls-cli",
    "binary": "urls-cli",
    "check": "which urls-cli",
    "install_steps": ["npm install -g urls-cli", "Verify: urls-cli --version", "supercli plugins install ./plugins/urls-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "urls-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to urls-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "urls-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install urls-cli: npm install -g urls-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
