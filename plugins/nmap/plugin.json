{
  "name": "nmap",
  "version": "0.1.0",
  "description": "Network discovery and security scanning tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "nmap"}],
  "install_guidance": {
    "plugin": "nmap",
    "binary": "nmap",
    "check": "which nmap",
    "install_steps": [
      "brew install nmap",
      "Verify: nmap --version",
      "supercli plugins install ./plugins/nmap --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "nmap",
      "resource": "self",
      "action": "version",
      "description": "Print nmap version",
      "adapter": "process",
      "adapterConfig": {"command": "nmap", "baseArgs": ["--version"], "missingDependencyHelp": "Install nmap: brew install nmap"},
      "args": []
    },
    {
      "namespace": "nmap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nmap CLI",
      "adapter": "process",
      "adapterConfig": {"command": "nmap", "passthrough": true, "missingDependencyHelp": "Install nmap: brew install nmap"},
      "args": []
    }
  ]
}
