{
  "name": "sniffglue",
  "version": "0.1.0",
  "description": "sniffglue \u2014 a secure network sniffer written in Rust.",
  "source": "https://github.com/kpcyrd/sniffglue",
  "checks": [
    {
      "type": "binary",
      "name": "sniffglue"
    }
  ],
  "install_guidance": {
    "plugin": "sniffglue",
    "binary": "sniffglue",
    "check": "which sniffglue",
    "install_steps": [
      "cargo install sniffglue",
      "brew install sniffglue"
    ],
    "note": "Rust. Secure network sniffer."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sniffglue",
      "resource": "capture",
      "action": "run",
      "description": "Capture network packets",
      "adapter": "process",
      "adapterConfig": {
        "command": "sniffglue",
        "missingDependencyHelp": "Install sniffglue",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "sniffglue",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sniffglue",
        "missingDependencyHelp": "Install sniffglue",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
