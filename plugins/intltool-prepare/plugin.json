{
  "name": "intltool-prepare",
  "version": "0.1.0",
  "description": "CLI tool: intltool-prepare",
  "source": "https://manpages.debian.org/intltool-prepare",
  "checks": [
    {
      "type": "binary",
      "name": "intltool-prepare"
    }
  ],
  "install_guidance": {
    "plugin": "intltool-prepare",
    "binary": "intltool-prepare",
    "check": "which intltool-prepare",
    "install_steps": [
      "apt-get install intltool-prepare 2>/dev/null || which intltool-prepare",
      "Verify: intltool-prepare --version",
      "supercli plugins install ./plugins/intltool-prepare --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "intltool-prepare",
      "resource": "self",
      "action": "version",
      "description": "Print intltool-prepare version",
      "adapter": "process",
      "adapterConfig": {
        "command": "intltool-prepare",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install intltool-prepare: apt-get install intltool-prepare 2>/dev/null || which intltool-prepare"
      },
      "args": []
    },
    {
      "namespace": "intltool-prepare",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to intltool-prepare CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "intltool-prepare",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install intltool-prepare: apt-get install intltool-prepare 2>/dev/null || which intltool-prepare"
      },
      "args": []
    }
  ]
}