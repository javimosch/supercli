{
  "name": "eqn2graph",
  "version": "0.1.0",
  "description": "CLI tool: eqn2graph",
  "source": "https://manpages.debian.org/eqn2graph",
  "checks": [
    {
      "type": "binary",
      "name": "eqn2graph"
    }
  ],
  "install_guidance": {
    "plugin": "eqn2graph",
    "binary": "eqn2graph",
    "check": "which eqn2graph",
    "install_steps": [
      "apt-get install eqn2graph 2>/dev/null || which eqn2graph",
      "Verify: eqn2graph --version",
      "supercli plugins install ./plugins/eqn2graph --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "eqn2graph",
      "resource": "self",
      "action": "version",
      "description": "Print eqn2graph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eqn2graph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eqn2graph: apt-get install eqn2graph 2>/dev/null || which eqn2graph"
      },
      "args": []
    },
    {
      "namespace": "eqn2graph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eqn2graph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eqn2graph",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install eqn2graph: apt-get install eqn2graph 2>/dev/null || which eqn2graph"
      },
      "args": []
    }
  ]
}