{
  "name": "nanvault",
  "version": "0.1.0",
  "description": "Ansible vault encrypt/decrypt tool written in Crystal",
  "source": "https://github.com/nicm/nanvault",
  "checks": [
    {
      "type": "binary",
      "name": "nanvault"
    }
  ],
  "install_guidance": {
    "plugin": "nanvault",
    "binary": "nanvault",
    "check": "which nanvault",
    "install_steps": [
      "brew install nanvault",
      "Verify: nanvault --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nanvault",
      "resource": "self",
      "action": "version",
      "description": "Print nanvault version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanvault",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install nanvault: brew install nanvault"
      },
      "args": []
    },
    {
      "namespace": "nanvault",
      "resource": "vault",
      "action": "encrypt",
      "description": "Encrypt files using Ansible vault format",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanvault",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install nanvault: brew install nanvault"
      },
      "args": []
    },
    {
      "namespace": "nanvault",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nanvault CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanvault",
        "passthrough": true,
        "missingDependencyHelp": "Install nanvault: brew install nanvault"
      },
      "args": []
    }
  ]
}