{
  "plugin": "ralph-cli",
  "binary": "ralph-cli",
  "check": "ralph-cli --help",
  "install_steps": [
    "npm install -g superacli",
    "curl -LO https://github.com/javimosch/ralph-cli/releases/latest/download/ralph-cli-linux-amd64",
    "chmod +x ralph-cli-linux-amd64",
    "sudo mv ralph-cli-linux-amd64 /usr/local/bin/ralph-cli",
    "ralph-cli --help",
    "sc plugins install ./plugins/ralph-cli --on-conflict replace --json"
  ],
  "note": "Go binary from javimosch/ralph-cli (MIT). Requires an agent CLI (opencode, claude, codex) installed and available in PATH for story execution. Install supercli: npm install -g superacli"
}
