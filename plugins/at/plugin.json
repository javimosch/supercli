      "resource": "job",
      "action": "schedule",
      "description": "Schedule a job at a specified time",
      "adapter": "process",
      "adapterConfig": {
        "command": "at",
        "baseArgs": [],
        "parseJson": false,
        "missingDependencyHelp": "Install at: brew install at | apt-get install at"
      },
      "args": [
        {
          "name": "timespec",
          "type": "string",
          "description": "Time specification (e.g., 'now + 5 minutes', '12:30', 'teatime tomorrow')",
          "required": true,
          "positional": true
        }
      ]
    },
    {
      "namespace": "at",
      "resource": "job",
      "action": "list",
      "description": "List queued jobs",
      "adapter": "process",
      "adapterConfig": {
        "command": "atq",
        "baseArgs": [],
        "parseJson": false,
        "missingDependencyHelp": "Install at: brew install at | apt-get install at"
      },
      "args": []
    },
    {
      "namespace": "at",
      "resource": "job",
      "action": "remove",
      "description": "Remove a queued job by job number",
      "adapter": "process",
      "adapterConfig": {
        "command": "atrm",
        "baseArgs": [],
        "parseJson": false,
        "missingDependencyHelp": "Install at: brew install at | apt-get install at"
