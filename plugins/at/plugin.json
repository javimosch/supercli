{
  "name": "at",
  "version": "0.1.0",
  "description": "at — schedule one-time jobs for later execution",
  "source": "https://www.gnu.org/software/coreutils/at",
  "checks": [
    {
      "type": "binary",
      "name": "at"
    }
  ],
  "commands": [
