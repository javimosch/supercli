{
  "name": "cmdchallenge",
  "version": "0.1.0",
  "description": "Presents small shell challenge with user submitted solutions",
  "checks": [
    {
      "type": "binary",
      "name": "cmdchallenge"
    }
  ],
  "install_guidance": {
    "plugin": "cmdchallenge",
    "binary": "cmdchallenge",
    "check": "which cmdchallenge",
    "install_steps": [
      "See undefined",
      "Verify: cmdchallenge --version",
      "supercli plugins install ./plugins/cmdchallenge --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "cmdchallenge",
      "resource": "self",
      "action": "version",
      "description": "Print cmdchallenge version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmdchallenge",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmdchallenge: See undefined"
      },
      "args": []
    },
    {
      "namespace": "cmdchallenge",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmdchallenge CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmdchallenge",
        "passthrough": true,
        "missingDependencyHelp": "Install cmdchallenge"
      },
      "args": []
    }
  ]
}