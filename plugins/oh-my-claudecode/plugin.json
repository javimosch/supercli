{
  "name": "oh-my-claudecode",
  "version": "0.1.0",
  "description": "Teams-first Multi-agent orchestration for Claude Code",
  "source": "https://github.com/oh-my-claudecode/oh-my-claudecode",
  "checks": [
    {
      "type": "binary",
      "name": "oh-my-claudecode"
    }
  ],
  "install_guidance": {
    "plugin": "oh-my-claudecode",
    "binary": "oh-my-claudecode",
    "check": "which oh-my-claudecode",
    "install_steps": [
      "pip install oh-my-claudecode",
      "Verify: oh-my-claudecode --version",
      "supercli plugins install ./plugins/oh-my-claudecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oh-my-claudecode",
      "resource": "self",
      "action": "version",
      "description": "Print oh-my-claudecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oh-my-claudecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oh-my-claudecode: pip install oh-my-claudecode"
      },
      "args": []
    },
    {
      "namespace": "oh-my-claudecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oh-my-claudecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oh-my-claudecode",
        "passthrough": true,
        "missingDependencyHelp": "Install oh-my-claudecode: pip install oh-my-claudecode"
      },
      "args": []
    }
  ]
}