{
  "name": "Lens",
  "version": "0.1.0",
  "description": "CLI tool: Lens",
  "source": "https://manpages.debian.org/Lens",
  "checks": [
    {
      "type": "binary",
      "name": "Lens"
    }
  ],
  "install_guidance": {
    "plugin": "Lens",
    "binary": "Lens",
    "check": "which Lens",
    "install_steps": [
      "apt-get install Lens 2>/dev/null || which Lens",
      "Verify: Lens --version",
      "supercli plugins install ./plugins/Lens --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Lens",
      "resource": "self",
      "action": "version",
      "description": "Print Lens version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Lens",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Lens: apt-get install Lens 2>/dev/null || which Lens"
      },
      "args": []
    },
    {
      "namespace": "Lens",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Lens CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Lens",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install Lens: apt-get install Lens 2>/dev/null || which Lens"
      },
      "args": []
    }
  ]
}