{
  "name": "rundoc",
  "version": "0.1.0",
  "description": "Execute code blocks from Markdown documents",
  "source": "https://github.com/LyonSyonII/rundoc",
  "checks": [{ "type": "binary", "name": "rundoc" }],
  "install_guidance": {
    "plugin": "rundoc",
    "binary": "rundoc",
    "check": "which rundoc",
    "install_steps": ["cargo install rundoc", "Verify: rundoc --version", "supercli plugins install ./plugins/rundoc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rundoc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rundoc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rundoc",
      "passthrough": true,
      "missingDependencyHelp": "Install rundoc: cargo install rundoc", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
