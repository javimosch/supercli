{
  "name": "dh_python3",
  "version": "0.1.0",
  "description": "CLI tool: dh_python3",
  "source": "https://packages.debian.org/dh_python3",
  "checks": [{ "type": "binary", "name": "dh_python3" }],
  "install_guidance": {
    "plugin": "dh_python3", "binary": "dh_python3", "check": "which dh_python3",
    "install_steps": ["apt-get install dh_python3 2>/dev/null || which dh_python3", "Verify: dh_python3 --version", "supercli plugins install ./plugins/dh_python3 --on-conflict replace --json"]
