  "commands": [{
    "namespace": "dh_python3", "resource": "_", "action": "_",
    "description": "Passthrough to dh_python3 CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_python3", "passthrough": true, "missingDependencyHelp": "Install dh_python3: apt-get install dh_python3" }, "args": []
  }]
}
