{
  "name": "keyword-extractor-go",
  "version": "0.1.0",
  "description": "Simple Go-based keyword extraction from text",
  "source": "go",
  "checks": [{ "type": "binary", "name": "keyword-extractor-go" }],
  "install_guidance": {
    "plugin": "keyword-extractor-go",
    "binary": "keyword-extractor-go",
    "check": "which keyword-extractor-go",
    "install_steps": ["go install github.com/keyword-extractor-go@latest", "Verify: keyword-extractor-go --version", "supercli plugins install ./plugins/keyword-extractor-go --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "keyword-extractor-go",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to keyword-extractor-go CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "keyword-extractor-go",
      "passthrough": true,
      "missingDependencyHelp": "Install keyword-extractor-go: go install github.com/keyword-extractor-go@latest"
    },
    "args": []
  }]
}
