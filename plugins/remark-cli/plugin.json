{
  "name": "remark-cli",
  "version": "0.1.0",
  "description": "Command line interface for remark markdown processor",
  "source": "https://github.com/remarkjs/remark",
  "checks": [{ "type": "binary", "name": "remark-cli" }],
  "install_guidance": {
    "plugin": "remark-cli",
    "binary": "remark-cli",
    "check": "which remark-cli",
    "install_steps": ["npm install -g remark-cli", "Verify: remark-cli --version", "supercli plugins install ./plugins/remark-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "remark-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to remark-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "remark-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install remark-cli: npm install -g remark-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
