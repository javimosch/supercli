{
  "name": "veniceai-skills",
  "version": "0.1.0",
  "description": "Agent skills for the Venice.ai API — image generation, model access, and AI capabilities via SKILL.md files",
  "source": "https://github.com/veniceai/skills",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "veniceai-skills",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/veniceai/skills.git",
      "supercli plugins install ./plugins/veniceai-skills --on-conflict replace --json",
      "sc skills teach veniceai-skills:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "veniceai-skills", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["veniceai-skills v0.1.0 — Use sc skills teach veniceai-skills:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/veniceai/skills.git" }, "args": [] },
    { "namespace": "veniceai-skills", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/veniceai/skills.git then: sc skills teach veniceai-skills:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/veniceai/skills.git" }, "args": [] }
  ]
}
