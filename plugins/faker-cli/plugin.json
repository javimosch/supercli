{
  "name": "faker-cli",
  "version": "0.1.0",
  "description": "faker-cli — generate fake contextual data: names, addresses, emails, lorem ipsum, company info, finance data, phone numbers, and more. Wraps Faker.js.",
  "source": "https://github.com/lestoni/faker-cli",
  "checks": [
    { "type": "binary", "name": "faker-cli" }
  ],
  "install_guidance": {
    "plugin": "faker-cli",
    "binary": "faker-cli",
    "check": "which faker-cli",
    "install_steps": [
      "npm install -g faker-cli",
      "Verify: faker-cli --version",
      "supercli plugins install ./plugins/faker-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "faker-cli",
      "resource": "self",
      "action": "version",
      "description": "Print faker-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "faker-cli",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install faker-cli: npm install -g faker-cli"
      },
      "args": []
    },
    {
      "namespace": "faker-cli",
      "resource": "data",
      "action": "generate",
      "description": "Generate fake data by category (passthrough: faker-cli --names findName, --helpers userCard, --internet email, --lorem paragraph, etc.)",
      "adapter": "process",
      "adapterConfig": {
        "command": "faker-cli",
        "passthrough": true,
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install faker-cli: npm install -g faker-cli"
      },
      "args": []
    },
    {
      "namespace": "faker-cli",
      "resource": "list",
      "action": "locales",
      "description": "List all available locales for generating localized fake data",
      "adapter": "process",
      "adapterConfig": {
        "command": "faker-cli",
        "baseArgs": ["--locales"],
        "timeout_ms": 10000,
        "missingDependencyHelp": "Install faker-cli: npm install -g faker-cli"
      },
      "args": []
    },
    {
      "namespace": "faker-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to faker-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "faker-cli",
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install faker-cli: npm install -g faker-cli"
      },
      "args": []
    }
  ]
}
