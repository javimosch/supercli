{
  "name": "dh_prep",
  "version": "0.1.0",
  "description": "CLI tool: dh_prep",
  "source": "https://packages.debian.org/dh_prep",
  "checks": [{ "type": "binary", "name": "dh_prep" }],
  "install_guidance": {
    "plugin": "dh_prep", "binary": "dh_prep", "check": "which dh_prep",
    "install_steps": ["apt-get install dh_prep 2>/dev/null || which dh_prep", "Verify: dh_prep --version", "supercli plugins install ./plugins/dh_prep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_prep", "resource": "_", "action": "_",
    "description": "Passthrough to dh_prep CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_prep", "passthrough": true, "missingDependencyHelp": "Install dh_prep: apt-get install dh_prep" }, "args": []
  }]
}
