{
  "name": "awk-language-server",
  "version": "0.1.0",
  "description": "Language server protocol for AWK scripts",
  "source": "https://github.com/nicknisi/awk-language-server",
  "checks": [{ "type": "binary", "name": "awk-language-server" }],
  "install_guidance": {
    "plugin": "awk-language-server",
    "binary": "awk-language-server",
    "check": "which awk-language-server",
    "install_steps": ["npm install -g awk-language-server", "Verify: awk-language-server --version", "supercli plugins install ./plugins/awk-language-server --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "awk-language-server",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to awk-language-server CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "awk-language-server",
      "passthrough": true,
      "missingDependencyHelp": "Install awk-language-server: npm install -g awk-language-server"
    },
    "args": []
  }]
}
