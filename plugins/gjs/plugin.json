{
  "name": "gjs",
  "version": "0.1.0",
  "description": "CLI tool: gjs",
  "source": "https://manpages.debian.org/gjs",
  "checks": [
    {
      "type": "binary",
      "name": "gjs"
    }
  ],
  "install_guidance": {
    "plugin": "gjs",
    "binary": "gjs",
    "check": "which gjs",
    "install_steps": [
      "apt-get install gjs 2>/dev/null || which gjs",
      "Verify: gjs --version",
      "supercli plugins install ./plugins/gjs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gjs",
      "resource": "self",
      "action": "version",
      "description": "Print gjs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gjs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gjs: apt-get install gjs 2>/dev/null || which gjs"
      },
      "args": []
    },
    {
      "namespace": "gjs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gjs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gjs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gjs: apt-get install gjs 2>/dev/null || which gjs"
      },
      "args": []
    }
  ]
}