{
  "name": "OpenClawInstaller",
  "version": "0.1.0",
  "description": "ClawdBot \u4e00\u952e\u90e8\u7f72\u5de5\u5177",
  "source": "https://github.com/OpenClawInstaller/OpenClawInstaller",
  "checks": [
    {
      "type": "binary",
      "name": "openclawinstaller"
    }
  ],
  "install_guidance": {
    "plugin": "OpenClawInstaller",
    "binary": "openclawinstaller",
    "check": "which openclawinstaller",
    "install_steps": [
      "pip install openclawinstaller",
      "Verify: openclawinstaller --version",
      "supercli plugins install ./plugins/OpenClawInstaller --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenClawInstaller",
      "resource": "self",
      "action": "version",
      "description": "Print OpenClawInstaller version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclawinstaller",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenClawInstaller: pip install openclawinstaller"
      },
      "args": []
    },
    {
      "namespace": "OpenClawInstaller",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openclawinstaller CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openclawinstaller",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenClawInstaller: pip install openclawinstaller"
      },
      "args": []
    }
  ]
}