{
  "name": "r3cond0g",
  "version": "0.1.0",
  "description": "Platform suite for container scanning and CVE tracking",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "r3cond0g" }],
  "install_guidance": {
    "plugin": "r3cond0g",
    "binary": "r3cond0g",
    "check": "which r3cond0g",
    "install_steps": ["git clone && npm install", "Verify: r3cond0g --version", "supercli plugins install ./plugins/r3cond0g --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "r3cond0g",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to r3cond0g CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "r3cond0g",
      "passthrough": true,
      "missingDependencyHelp": "Install r3cond0g: git clone && npm install"
    },
    "args": []
  }]
}
