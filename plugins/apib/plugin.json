{
  "name": "apib",
  "version": "0.1.0",
  "description": "HTTP performance-testing tool",
  "source": "https://github.com/apigee/apib",
  "checks": [
    {
      "type": "binary",
      "name": "apib"
    }
  ],
  "install_guidance": {
    "plugin": "apib",
    "binary": "apib",
    "check": "which apib",
    "install_steps": [
      "brew install apib",
      "Verify: apib --version",
      "supercli plugins install ./plugins/apib --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "apib",
      "resource": "self",
      "action": "version",
      "description": "Print apib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "apib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install apib: brew install apib"
      },
      "args": []
    },
    {
      "namespace": "apib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to apib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "apib",
        "passthrough": true,
        "missingDependencyHelp": "Install apib"
      },
      "args": []
    }
  ]
}