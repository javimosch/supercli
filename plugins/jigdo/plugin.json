{
  "name": "jigdo",
  "version": "1.0.0",
  "description": "jigdo \u2014 Debian ISO download",
  "source": "atterer.org/jigdo",
  "checks": [
    {
      "type": "binary",
      "name": "jigdo"
    }
  ],
  "install_guidance": {
    "plugin": "jigdo",
    "binary": "jigdo",
    "check": "which jigdo",
    "install_steps": [
      "# Install jigdo",
      "# See atterer.org/jigdo",
      "# apt: sudo apt-get install jigdo",
      "# brew: brew install jigdo",
      "# cargo: cargo install jigdo",
      "# npm: npm install -g jigdo",
      "# pip: pip install jigdo"
    ]
  },
  "commands": [
    {
      "namespace": "jigdo",
      "resource": "jigdo",
      "action": "run",
      "description": "Run jigdo",
      "adapter": "process",
      "adapterConfig": {
        "command": "jigdo",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install jigdo from atterer.org/jigdo"
      },
      "args": []
    }
  ]
}