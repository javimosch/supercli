{
  "name": "cpy-cli",
  "version": "0.1.0",
  "description": "Copies files",
  "source": "https://github.com/sindresorhus/cpy-cli",
  "checks": [
    {
      "type": "binary",
      "name": "cpy-cli"
    }
  ],
  "install_guidance": {
    "plugin": "cpy-cli",
    "binary": "cpy-cli",
    "check": "which cpy-cli",
    "install_steps": [
      "npm install -g cpy-cli",
      "Verify: cpy-cli --version",
      "supercli plugins install ./plugins/cpy-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cpy-cli",
      "resource": "self",
      "action": "version",
      "description": "Print cpy-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cpy-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cpy-cli: npm install -g cpy-cli"
      },
      "args": []
    },
    {
      "namespace": "cpy-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cpy-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cpy-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install cpy-cli"
      },
      "args": []
    }
  ]
}