{
  "name": "fierce",
  "version": "0.1.0",
  "description": "DNS reconnaissance domain scanner",
  "source": "https://github.com/mschwager/fierce",
  "checks": [
    {
      "type": "binary",
      "name": "fierce"
    }
  ],
  "install_guidance": {
    "plugin": "fierce",
    "binary": "fierce",
    "check": "which fierce",
    "install_steps": [
      "pip install fierce",
      "Verify: fierce --version",
      "supercli plugins install ./plugins/fierce --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "fierce",
      "resource": "self",
      "action": "version",
      "description": "Print fierce version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fierce",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fierce: pip install fierce"
      },
      "args": []
    },
    {
      "namespace": "fierce",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fierce CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fierce",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fierce: pip install fierce"
      },
      "args": []
    }
  ]
}
