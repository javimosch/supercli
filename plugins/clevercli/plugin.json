{
  "name": "clevercli",
  "version": "0.1.0",
  "description": "Collection of ChatGPT powered utilities",
  "source": "https://github.com/clevercli/clevercli",
  "checks": [
    {
      "type": "binary",
      "name": "clevercli"
    }
  ],
  "install_guidance": {
    "plugin": "clevercli",
    "binary": "clevercli",
    "check": "which clevercli",
    "install_steps": [
      "See https://github.com/clevercli/clevercli",
      "Verify: clevercli --version",
      "supercli plugins install ./plugins/clevercli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "clevercli",
      "resource": "self",
      "action": "version",
      "description": "Print clevercli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clevercli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clevercli: See https://github.com/clevercli/clevercli"
      },
      "args": []
    },
    {
      "namespace": "clevercli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clevercli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clevercli",
        "passthrough": true,
        "missingDependencyHelp": "Install clevercli"
      },
      "args": []
    }
  ]
}