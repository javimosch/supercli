{
  "name": "djlint",
  "version": "0.1.0",
  "description": "HTML template formatter and linter for Django/Jinja",
  "source": "https://github.com/djlint/djLint",
  "checks": [{ "type": "binary", "name": "djlint" }],
  "install_guidance": {
    "plugin": "djlint",
    "binary": "djlint",
    "check": "which djlint",
    "install_steps": ["pip install djlint", "Verify: djlint --version", "supercli plugins install ./plugins/djlint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "djlint",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to djlint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "djlint",
      "passthrough": true,
      "missingDependencyHelp": "Install djlint: pip install djlint", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
