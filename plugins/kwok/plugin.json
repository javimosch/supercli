{
  "name": "kwok",
  "version": "0.1.0",
  "description": "Kubernetes cluster simulator with fake nodes and pods",
  "source": "https://github.com/kubernetes-sigs/kwok",
  "checks": [{ "type": "binary", "name": "kwok" }],
  "install_guidance": {
    "plugin": "kwok",
    "binary": "kwok",
    "check": "which kwok",
    "install_steps": ["brew install kwok", "Verify: kwok --version", "supercli plugins install ./plugins/kwok --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kwok",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kwok CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kwok",
      "passthrough": true,
      "missingDependencyHelp": "Install kwok: brew install kwok"
    },
    "args": []
  }]
}
