{
  "name": "oxicloud",
  "version": "0.1.0",
  "description": "Ultra-fast, secure and lightweight self-hosted cloud storage built in Rust",
  "source": "https://github.com/AtalayaLabs/OxiCloud",
  "checks": [
    {
      "type": "binary",
      "name": "oxicloud"
    }
  ],
  "install_guidance": {
    "plugin": "oxicloud",
    "binary": "oxicloud",
    "check": "which oxicloud",
    "install_steps": [
      "cargo install oxicloud",
      "Verify: oxicloud --version",
      "supercli plugins install ./plugins/oxicloud --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "oxicloud",
    "resource": "self",
    "action": "version",
    "description": "Print oxicloud version",
    "adapter": "process",
    "adapterConfig": {
      "command": "oxicloud",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install oxicloud: cargo install oxicloud"
    },
    "args": []
  },
  {
    "namespace": "oxicloud",
    "resource": "server",
    "action": "start",
    "description": "Start the OxiCloud server",
    "adapter": "process",
    "adapterConfig": {
      "command": "oxicloud",
      "baseArgs": [
        "serve"
      ],
      "passthrough": true,
      "timeout_ms": 60000,
      "missingDependencyHelp": "Install oxicloud: cargo install oxicloud"
    },
    "args": []
  },
  {
    "namespace": "oxicloud",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to oxicloud CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "oxicloud",
      "passthrough": true,
      "missingDependencyHelp": "Install oxicloud"
    },
    "args": []
  }
]
}