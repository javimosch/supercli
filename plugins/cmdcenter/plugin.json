{
  "name": "cmdcenter",
  "version": "1.0.0",
  "description": "Generic command execution dashboard with configurable commands via JSON config file",
  "author": "javimosch",
  "binary": "cmdcenter",
  "commands": [
    {
      "name": "init",
      "description": "Initialize config file with defaults"
    },
    {
      "name": "add",
      "description": "Add a new command"
    },
    {
      "name": "edit",
      "description": "Edit an existing command"
    },
    {
      "name": "remove",
      "description": "Remove a command"
    },
    {
      "name": "list",
      "description": "List all configured commands"
    },
    {
      "name": "run",
      "description": "Execute a command by ID"
    },
    {
      "name": "start",
      "description": "Start HTTP server (UI)"
    },
    {
      "name": "stop",
      "description": "Stop daemon server"
    },
    {
      "name": "status",
      "description": "Check daemon status"
    }
  ],
  "checks": [
    {
      "type": "binary",
      "command": "cmdcenter version"
    }
  ]
}
