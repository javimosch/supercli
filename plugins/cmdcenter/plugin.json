{
  "name": "cmdcenter",
  "version": "1.0.0",
  "author": "javimosch",
  "description": "Generic command execution dashboard with configurable commands via JSON config file",
  "checks": [
    {
      "type": "binary",
      "name": "cmdcenter",
      "args": [
        "version"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "cmdcenter",
    "binary": "cmdcenter",
    "check": "cmdcenter version",
    "install_steps": [
      "Download the appropriate binary for your platform from https://github.com/javimosch/cmdcenter/releases",
      "Move the binary to your PATH (e.g., /usr/local/bin/ or ~/bin/)",
      "Make it executable: chmod +x cmdcenter",
      "Initialize config: cmdcenter init"
    ],
    "note": "Ships with empty config - you must add commands via CLI or UI before use"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cmdcenter",
      "resource": "config",
      "action": "init",
      "description": "Initialize config file with defaults",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmdcenter",
        "baseArgs": [
          "init"
        ],
        "missingDependencyHelp": "Install cmdcenter: Download the appropriate binary for your platform from https://github.com/javimosch/cmdcenter/releases"
      },
      "args": []
    },
    {
