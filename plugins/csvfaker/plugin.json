{
  "name": "csvfaker",
  "version": "0.1.0",
  "description": "Generate CSV files with realistic fake data for testing",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "csvfaker" }],
  "install_guidance": {
    "plugin": "csvfaker",
    "binary": "csvfaker",
    "check": "which csvfaker",
    "install_steps": ["pip install csvfaker", "Verify: csvfaker --version", "supercli plugins install ./plugins/csvfaker --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "csvfaker",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to csvfaker CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "csvfaker",
      "passthrough": true,
      "missingDependencyHelp": "Install csvfaker: pip install csvfaker"
    },
    "args": []
  }]
}
