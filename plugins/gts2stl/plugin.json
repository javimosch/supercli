{
  "name": "gts2stl",
  "version": "0.1.0",
  "description": "CLI tool: gts2stl",
  "source": "https://manpages.debian.org/gts2stl",
  "checks": [
    {
      "type": "binary",
      "name": "gts2stl"
    }
  ],
  "install_guidance": {
    "plugin": "gts2stl",
    "binary": "gts2stl",
    "check": "which gts2stl",
    "install_steps": [
      "apt-get install gts2stl 2>/dev/null || which gts2stl",
      "Verify: gts2stl --version",
      "supercli plugins install ./plugins/gts2stl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gts2stl",
      "resource": "self",
      "action": "version",
      "description": "Print gts2stl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gts2stl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gts2stl: apt-get install gts2stl 2>/dev/null || which gts2stl"
      },
      "args": []
    },
    {
      "namespace": "gts2stl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gts2stl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gts2stl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gts2stl: apt-get install gts2stl 2>/dev/null || which gts2stl"
      },
      "args": []
    }
  ]
}