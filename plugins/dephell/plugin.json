{
  "name": "dephell",
  "version": "0.1.0",
  "description": "Universal Python dependency converter and manager",
  "source": "https://github.com/dephell/dephell",
  "checks": [{ "type": "binary", "name": "dephell" }],
  "install_guidance": {
    "plugin": "dephell",
    "binary": "dephell",
    "check": "which dephell",
    "install_steps": ["pip install dephell", "Verify: dephell --version", "supercli plugins install ./plugins/dephell --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dephell",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dephell CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dephell",
      "passthrough": true,
      "missingDependencyHelp": "Install dephell: pip install dephell", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
