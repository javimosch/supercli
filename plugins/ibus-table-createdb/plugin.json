{
  "name": "ibus-table-createdb",
  "version": "0.1.0",
  "description": "CLI tool: ibus-table-createdb",
  "source": "https://manpages.debian.org/ibus-table-createdb",
  "checks": [
    {
      "type": "binary",
      "name": "ibus-table-createdb"
    }
  ],
  "install_guidance": {
    "plugin": "ibus-table-createdb",
    "binary": "ibus-table-createdb",
    "check": "which ibus-table-createdb",
    "install_steps": [
      "apt-get install ibus-table-createdb 2>/dev/null || which ibus-table-createdb",
      "Verify: ibus-table-createdb --version",
      "supercli plugins install ./plugins/ibus-table-createdb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ibus-table-createdb",
      "resource": "self",
      "action": "version",
      "description": "Print ibus-table-createdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ibus-table-createdb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ibus-table-createdb: apt-get install ibus-table-createdb 2>/dev/null || which ibus-table-createdb"
      },
      "args": []
    },
    {
      "namespace": "ibus-table-createdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ibus-table-createdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ibus-table-createdb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ibus-table-createdb: apt-get install ibus-table-createdb 2>/dev/null || which ibus-table-createdb"
      },
      "args": []
    }
  ]
}