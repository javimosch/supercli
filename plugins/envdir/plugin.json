{
  "name": "envdir",
  "version": "1.0.0",
  "description": "envdir \u2014 Dir-based environment",
  "source": "github.com/djberg96/envdir",
  "checks": [
    {
      "type": "binary",
      "name": "envdir"
    }
  ],
  "install_guidance": {
    "plugin": "envdir",
    "binary": "envdir",
    "check": "which envdir",
    "install_steps": [
      "# Install envdir",
      "# See github.com/djberg96/envdir",
      "# apt: sudo apt-get install envdir",
      "# brew: brew install envdir",
      "# cargo: cargo install envdir",
      "# npm: npm install -g envdir",
      "# pip: pip install envdir"
    ]
  },
  "commands": [
    {
      "namespace": "envdir",
      "resource": "envdir",
      "action": "run",
      "description": "Run envdir",
      "adapter": "process",
      "adapterConfig": {
        "command": "envdir",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install envdir from github.com/djberg96/envdir"
      },
      "args": []
    }
  ]
}