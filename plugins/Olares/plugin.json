{
  "name": "Olares",
  "version": "0.1.0",
  "description": "Olares: An Open-Source Personal Cloud to Reclaim Your Data",
  "source": "https://github.com/Olares/Olares",
  "checks": [
    {
      "type": "binary",
      "name": "olares"
    }
  ],
  "install_guidance": {
    "plugin": "Olares",
    "binary": "olares",
    "check": "which olares",
    "install_steps": [
      "pip install olares",
      "Verify: olares --version",
      "supercli plugins install ./plugins/Olares --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Olares",
      "resource": "self",
      "action": "version",
      "description": "Print Olares version",
      "adapter": "process",
      "adapterConfig": {
        "command": "olares",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Olares: pip install olares"
      },
      "args": []
    },
    {
      "namespace": "Olares",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to olares CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "olares",
        "passthrough": true,
        "missingDependencyHelp": "Install Olares: pip install olares"
      },
      "args": []
    }
  ]
}