{
  "name": "header-strip",
  "version": "0.1.0",
  "description": "Remove YAML frontmatter from markdown files",
  "source": "https://github.com/nickcoutsos/header-strip",
  "checks": [{ "type": "binary", "name": "header-strip" }],
  "install_guidance": {
    "plugin": "header-strip",
    "binary": "header-strip",
    "check": "which header-strip",
    "install_steps": ["pip install header-strip", "Verify: header-strip --version", "supercli plugins install ./plugins/header-strip --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "header-strip",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to header-strip CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "header-strip",
      "passthrough": true,
      "missingDependencyHelp": "Install header-strip: pip install header-strip", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
