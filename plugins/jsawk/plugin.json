{
  "name": "jsawk",
  "version": "0.1.0",
  "description": "Like awk, but for JSON, using JavaScript objects and arrays",
  "source": "https://github.com/micha/jsawk",
  "checks": [
    {
      "type": "binary",
      "name": "jsawk"
    }
  ],
  "install_guidance": {
    "plugin": "jsawk",
    "binary": "jsawk",
    "check": "which jsawk",
    "install_steps": [
      "brew install jsawk",
      "Verify: jsawk --version",
      "supercli plugins install ./plugins/jsawk --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jsawk",
      "resource": "self",
      "action": "version",
      "description": "Print jsawk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsawk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jsawk: brew install jsawk"
      },
      "args": []
    },
    {
      "namespace": "jsawk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jsawk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsawk",
        "passthrough": true,
        "missingDependencyHelp": "Install jsawk"
      },
      "args": []
    }
  ]
}