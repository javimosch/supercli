{
  "name": "opentofu",
  "version": "1.0.0",
  "description": "opentofu \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=opentofu+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "opentofu"
    }
  ],
  "install_guidance": {
    "plugin": "opentofu",
    "binary": "opentofu",
    "check": "which opentofu",
    "install_steps": [
      "Install opentofu via package manager: apt install opentofu or brew install opentofu"
    ]
  },
  "commands": [
    {
      "namespace": "opentofu",
      "resource": "run",
      "action": "exec",
      "description": "opentofu \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "opentofu",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install opentofu via your package manager"
      },
      "args": []
    }
  ]
}