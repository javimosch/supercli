{
  "name": "opentofu",
  "version": "0.1.0",
  "description": "OpenTofu — the open-source infrastructure as code tool for declarative cloud resource management",
  "source": "https://github.com/opentofu/opentofu",
  "checks": [
    {
      "type": "binary",
      "name": "tofu"
    }
  ],
  "install_guidance": {
    "plugin": "opentofu",
    "binary": "tofu",
    "check": "which tofu",
    "install_steps": [
      "brew install opentofu",
      "Verify: tofu --version",
      "supercli plugins install ./plugins/opentofu --on-conflict replace --json"
    ],
    "note": "OpenTofu is the open-source fork of Terraform under Linux Foundation stewardship."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "opentofu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tofu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tofu",
        "passthrough": true,
        "missingDependencyHelp": "Install opentofu: brew install opentofu"
      },
      "args": []
    }
  ]
}
