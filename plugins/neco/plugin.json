{
  "name": "neco",
  "version": "0.1.0",
  "description": "Concurrency library for C (coroutines)",
  "source": "https://github.com/neco/neco",
  "checks": [
    {
      "type": "binary",
      "name": "neco"
    }
  ],
  "install_guidance": {
    "plugin": "neco",
    "binary": "neco",
    "check": "which neco",
    "install_steps": [
      "pip install neco",
      "Verify: neco --version",
      "supercli plugins install ./plugins/neco --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "neco",
      "resource": "self",
      "action": "version",
      "description": "Print neco version",
      "adapter": "process",
      "adapterConfig": {
        "command": "neco",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install neco: pip install neco"
      },
      "args": []
    },
    {
      "namespace": "neco",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to neco CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "neco",
        "passthrough": true,
        "missingDependencyHelp": "Install neco: pip install neco"
      },
      "args": []
    }
  ]
}