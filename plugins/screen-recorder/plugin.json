{
  "name": "screen-recorder",
  "version": "0.1.0",
  "description": "Rust-based lightweight screen recording utility",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "screen-recorder" }],
  "install_guidance": {
    "plugin": "screen-recorder",
    "binary": "screen-recorder",
    "check": "which screen-recorder",
    "install_steps": ["cargo install screen-recorder", "Verify: screen-recorder --version", "supercli plugins install ./plugins/screen-recorder --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "screen-recorder",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to screen-recorder CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "screen-recorder",
      "passthrough": true,
      "missingDependencyHelp": "Install screen-recorder: cargo install screen-recorder"
    },
    "args": []
  }]
}
