{
  "name": "bde",
  "version": "0.1.0",
  "description": "Basic Development Environment: foundational C++ libraries used at Bloomberg",
  "source": "https://github.com/bloomberg/bde",
  "checks": [
    {
      "type": "binary",
      "name": "bde"
    }
  ],
  "install_guidance": {
    "plugin": "bde",
    "binary": "bde",
    "check": "which bde",
    "install_steps": [
      "brew install bde",
      "Verify: bde --version",
      "supercli plugins install ./plugins/bde --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bde",
      "resource": "self",
      "action": "version",
      "description": "Print bde version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bde",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bde: brew install bde"
      },
      "args": []
    },
    {
      "namespace": "bde",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bde CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bde",
        "passthrough": true,
        "missingDependencyHelp": "Install bde"
      },
      "args": []
    }
  ]
}