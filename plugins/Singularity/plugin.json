{
  "name": "Singularity",
  "version": "0.1.0",
  "description": "Stealthy Linux Kernel Rootkit for modern kernels (6x)",
  "source": "https://github.com/Singularity/Singularity",
  "checks": [
    {
      "type": "binary",
      "name": "singularity"
    }
  ],
  "install_guidance": {
    "plugin": "Singularity",
    "binary": "singularity",
    "check": "which singularity",
    "install_steps": [
      "pip install singularity",
      "Verify: singularity --version",
      "supercli plugins install ./plugins/Singularity --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Singularity",
      "resource": "self",
      "action": "version",
      "description": "Print Singularity version",
      "adapter": "process",
      "adapterConfig": {
        "command": "singularity",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Singularity: pip install singularity"
      },
      "args": []
    },
    {
      "namespace": "Singularity",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to singularity CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "singularity",
        "passthrough": true,
        "missingDependencyHelp": "Install Singularity: pip install singularity"
      },
      "args": []
    }
  ]
}