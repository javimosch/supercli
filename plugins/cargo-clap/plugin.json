{
  "name": "cargo-clap",
  "version": "0.1.0",
  "description": "cargo-clap — cargo extension for generating CLI argument parsers",
  "source": "https://github.com/clap-rs/clap",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-clap"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-clap",
    "binary": "cargo-clap",
    "check": "which cargo-clap",
    "install_steps": [
      "cargo install cargo-clap",
      "Verify: cargo-clap --version",
      "supercli plugins install ./plugins/cargo-clap --on-conflict replace --json"
    ],
    "note": "Legacy cargo subcommand from clap 2.x; prefer `cargo add clap` in new projects."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo-clap",
      "resource": "self",
      "action": "version",
      "description": "Print cargo-clap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-clap",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install cargo-clap: cargo install cargo-clap"
      },
      "args": []
    }
  ]
}
