{
  "name": "timer-cli",
  "version": "0.1.0",
  "description": "Simple countdown and stopwatch timer for the terminal",
  "source": "https://github.com/michaellyons/timer-cli",
  "checks": [{ "type": "binary", "name": "timer-cli" }],
  "install_guidance": {
    "plugin": "timer-cli",
    "binary": "timer-cli",
    "check": "which timer-cli",
    "install_steps": ["npm install -g timer-cli", "Verify: timer-cli --version", "supercli plugins install ./plugins/timer-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "timer-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to timer-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "timer-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install timer-cli: npm install -g timer-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
