{
  "name": "Portable-AI-USB",
  "version": "0.1.0",
  "description": "A 100% offline, fully portable, zero-trace AI (Ollama + Llama 3 + AnythingLLM) that runs natively fr",
  "source": "https://github.com/Portable-AI-USB/Portable-AI-USB",
  "checks": [
    {
      "type": "binary",
      "name": "portable-ai-usb"
    }
  ],
  "install_guidance": {
    "plugin": "Portable-AI-USB",
    "binary": "portable-ai-usb",
    "check": "which portable-ai-usb",
    "install_steps": [
      "pip install portable-ai-usb",
      "Verify: portable-ai-usb --version",
      "supercli plugins install ./plugins/Portable-AI-USB --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Portable-AI-USB",
      "resource": "self",
      "action": "version",
      "description": "Print Portable-AI-USB version",
      "adapter": "process",
      "adapterConfig": {
        "command": "portable-ai-usb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Portable-AI-USB: pip install portable-ai-usb"
      },
      "args": []
    },
    {
      "namespace": "Portable-AI-USB",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to portable-ai-usb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "portable-ai-usb",
        "passthrough": true,
        "missingDependencyHelp": "Install Portable-AI-USB: pip install portable-ai-usb"
      },
      "args": []
    }
  ]
}