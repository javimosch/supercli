{
  "name": "git-fixup",
  "version": "0.1.0",
  "description": "Alias for git commit --fixup <ref>",
  "source": "https://github.com/keis/git-fixup",
  "checks": [
    {
      "type": "binary",
      "name": "git-fixup"
    }
  ],
  "install_guidance": {
    "plugin": "git-fixup",
    "binary": "git-fixup",
    "check": "which git-fixup",
    "install_steps": [
      "brew install git-fixup",
      "Verify: git-fixup --version",
      "supercli plugins install ./plugins/git-fixup --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-fixup",
      "resource": "self",
      "action": "version",
      "description": "Print git-fixup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-fixup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-fixup: brew install git-fixup"
      },
      "args": []
    },
    {
      "namespace": "git-fixup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-fixup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-fixup",
        "passthrough": true,
        "missingDependencyHelp": "Install git-fixup"
      },
      "args": []
    }
  ]
}