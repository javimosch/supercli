{
  "name": "gocache",
  "version": "0.1.0",
  "description": "Simple Redis-like server clone written in Go",
  "source": "go",
  "checks": [{ "type": "binary", "name": "gocache" }],
  "install_guidance": {
    "plugin": "gocache",
    "binary": "gocache",
    "check": "which gocache",
    "install_steps": ["go install github.com/gocache@latest", "Verify: gocache --version", "supercli plugins install ./plugins/gocache --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gocache",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gocache CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gocache",
      "passthrough": true,
      "missingDependencyHelp": "Install gocache: go install github.com/gocache@latest"
    },
    "args": []
  }]
}
