{
  "name": "sqreenshot",
  "version": "0.1.0",
  "description": "Simple X11 screenshot grabber for GNOME desktop",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "sqreenshot" }],
  "install_guidance": {
    "plugin": "sqreenshot",
    "binary": "sqreenshot",
    "check": "which sqreenshot",
    "install_steps": ["cmake . && make", "Verify: sqreenshot --version", "supercli plugins install ./plugins/sqreenshot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sqreenshot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sqreenshot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sqreenshot",
      "passthrough": true,
      "missingDependencyHelp": "Install sqreenshot: cmake . && make"
    },
    "args": []
  }]
}
