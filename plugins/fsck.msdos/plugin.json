{
  "name": "fsck.msdos",
  "version": "0.1.0",
  "description": "CLI tool: fsck.msdos",
  "source": "https://manpages.debian.org/fsck.msdos",
  "checks": [
    {
      "type": "binary",
      "name": "fsck.msdos"
    }
  ],
  "install_guidance": {
    "plugin": "fsck.msdos",
    "binary": "fsck.msdos",
    "check": "which fsck.msdos",
    "install_steps": [
      "apt-get install fsck.msdos 2>/dev/null || which fsck.msdos",
      "Verify: fsck.msdos --version",
      "supercli plugins install ./plugins/fsck.msdos --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fsck.msdos",
      "resource": "self",
      "action": "version",
      "description": "Print fsck.msdos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsck.msdos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fsck.msdos: apt-get install fsck.msdos 2>/dev/null || which fsck.msdos"
      },
      "args": []
    },
    {
      "namespace": "fsck.msdos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fsck.msdos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsck.msdos",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fsck.msdos: apt-get install fsck.msdos 2>/dev/null || which fsck.msdos"
      },
      "args": []
    }
  ]
}