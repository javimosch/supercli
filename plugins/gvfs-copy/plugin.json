{
  "name": "gvfs-copy",
  "version": "0.1.0",
  "description": "CLI tool: gvfs-copy",
  "source": "https://manpages.debian.org/gvfs-copy",
  "checks": [
    {
      "type": "binary",
      "name": "gvfs-copy"
    }
  ],
  "install_guidance": {
    "plugin": "gvfs-copy",
    "binary": "gvfs-copy",
    "check": "which gvfs-copy",
    "install_steps": [
      "apt-get install gvfs-copy 2>/dev/null || which gvfs-copy",
      "Verify: gvfs-copy --version",
      "supercli plugins install ./plugins/gvfs-copy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gvfs-copy",
      "resource": "self",
      "action": "version",
      "description": "Print gvfs-copy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvfs-copy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gvfs-copy: apt-get install gvfs-copy 2>/dev/null || which gvfs-copy"
      },
      "args": []
    },
    {
      "namespace": "gvfs-copy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gvfs-copy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvfs-copy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gvfs-copy: apt-get install gvfs-copy 2>/dev/null || which gvfs-copy"
      },
      "args": []
    }
  ]
}