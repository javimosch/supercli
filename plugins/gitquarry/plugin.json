{
  "name": "gitquarry",
  "version": "0.1.0",
  "description": "Terminal CLI for GitHub repository search with JSON, CSV, and compact output modes",
  "source": "https://github.com/Microck/gitquarry",
  "checks": [
    {
      "type": "binary",
      "name": "gitquarry"
    }
  ],
  "install_guidance": {
    "plugin": "gitquarry",
    "binary": "gitquarry",
    "check": "which gitquarry",
    "install_steps": [
      "cargo install gitquarry",
      "Verify: gitquarry --version",
      "supercli plugins install ./plugins/gitquarry --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gitquarry",
      "resource": "self",
      "action": "version",
      "description": "Print gitquarry version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitquarry",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitquarry: cargo install gitquarry"
      },
      "args": []
    },
    {
      "namespace": "gitquarry",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitquarry CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitquarry",
        "passthrough": true,
        "missingDependencyHelp": "Install gitquarry: cargo install gitquarry"
      },
      "args": []
    }
  ]
}
