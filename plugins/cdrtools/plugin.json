{
  "name": "cdrtools",
  "version": "0.1.0",
  "description": "CD/DVD/Blu-ray premastering and recording software",
  "checks": [
    {
      "type": "binary",
      "name": "cdrtools"
    }
  ],
  "install_guidance": {
    "plugin": "cdrtools",
    "binary": "cdrtools",
    "check": "which cdrtools",
    "install_steps": [
      "brew install cdrtools",
      "Verify: cdrtools --version",
      "supercli plugins install ./plugins/cdrtools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cdrtools",
      "resource": "self",
      "action": "version",
      "description": "Print cdrtools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdrtools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cdrtools: brew install cdrtools"
      },
      "args": []
    },
    {
      "namespace": "cdrtools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cdrtools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdrtools",
        "passthrough": true,
        "missingDependencyHelp": "Install cdrtools"
      },
      "args": []
    }
  ]
}