{
  "name": "giftopnm",
  "version": "0.1.0",
  "description": "CLI tool: giftopnm",
  "source": "https://manpages.debian.org/giftopnm",
  "checks": [
    {
      "type": "binary",
      "name": "giftopnm"
    }
  ],
  "install_guidance": {
    "plugin": "giftopnm",
    "binary": "giftopnm",
    "check": "which giftopnm",
    "install_steps": [
      "apt-get install giftopnm 2>/dev/null || which giftopnm",
      "Verify: giftopnm --version",
      "supercli plugins install ./plugins/giftopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "giftopnm",
      "resource": "self",
      "action": "version",
      "description": "Print giftopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "giftopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install giftopnm: apt-get install giftopnm 2>/dev/null || which giftopnm"
      },
      "args": []
    },
    {
      "namespace": "giftopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to giftopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "giftopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install giftopnm: apt-get install giftopnm 2>/dev/null || which giftopnm"
      },
      "args": []
    }
  ]
}