{
  "name": "codevis",
  "version": "0.1.0",
  "description": "Turns your code into one large image",
  "source": "https://github.com/sloganking/codevis",
  "checks": [
    {
      "type": "binary",
      "name": "codevis"
    }
  ],
  "install_guidance": {
    "plugin": "codevis",
    "binary": "codevis",
    "check": "which codevis",
    "install_steps": [
      "brew install codevis",
      "Verify: codevis --version",
      "supercli plugins install ./plugins/codevis --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "codevis",
      "resource": "self",
      "action": "version",
      "description": "Print codevis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codevis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install codevis: brew install codevis"
      },
      "args": []
    },
    {
      "namespace": "codevis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codevis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codevis",
        "passthrough": true,
        "missingDependencyHelp": "Install codevis"
      },
      "args": []
    }
  ]
}