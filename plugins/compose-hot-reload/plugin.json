{
  "name": "compose-hot-reload",
  "version": "0.1.0",
  "description": "Compose Hot Reload: Make changes to your UI code in a Compose Multiplatform application, and see the",
  "source": "https://github.com/compose-hot-reload/compose-hot-reload",
  "checks": [
    {
      "type": "binary",
      "name": "compose-hot-reload"
    }
  ],
  "install_guidance": {
    "plugin": "compose-hot-reload",
    "binary": "compose-hot-reload",
    "check": "which compose-hot-reload",
    "install_steps": [
      "pip install compose-hot-reload",
      "Verify: compose-hot-reload --version",
      "supercli plugins install ./plugins/compose-hot-reload --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "compose-hot-reload",
      "resource": "self",
      "action": "version",
      "description": "Print compose-hot-reload version",
      "adapter": "process",
      "adapterConfig": {
        "command": "compose-hot-reload",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install compose-hot-reload: pip install compose-hot-reload"
      },
      "args": []
    },
    {
      "namespace": "compose-hot-reload",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to compose-hot-reload CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "compose-hot-reload",
        "passthrough": true,
        "missingDependencyHelp": "Install compose-hot-reload: pip install compose-hot-reload"
      },
      "args": []
    }
  ]
}