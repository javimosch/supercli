{
  "name": "colfer",
  "version": "0.1.0",
  "description": "Schema compiler for binary data exchange",
  "source": "https://github.com/pascaldekloe/colfer",
  "checks": [
    {
      "type": "binary",
      "name": "colfer"
    }
  ],
  "install_guidance": {
    "plugin": "colfer",
    "binary": "colfer",
    "check": "which colfer",
    "install_steps": [
      "brew install colfer",
      "Verify: colfer --version",
      "supercli plugins install ./plugins/colfer --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "colfer",
      "resource": "self",
      "action": "version",
      "description": "Print colfer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "colfer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install colfer: brew install colfer"
      },
      "args": []
    },
    {
      "namespace": "colfer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to colfer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "colfer",
        "passthrough": true,
        "missingDependencyHelp": "Install colfer"
      },
      "args": []
    }
  ]
}