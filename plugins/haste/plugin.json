{
  "name": "haste",
  "version": "1.0.0",
  "description": "haste \u2014 Pastebin client",
  "source": "github.com/cjmamo/haste",
  "checks": [
    {
      "type": "binary",
      "name": "haste"
    }
  ],
  "install_guidance": {
    "plugin": "haste",
    "binary": "haste",
    "check": "which haste",
    "install_steps": [
      "# Install haste",
      "# See github.com/cjmamo/haste",
      "# apt: sudo apt-get install haste",
      "# brew: brew install haste",
      "# cargo: cargo install haste",
      "# npm: npm install -g haste",
      "# pip: pip install haste"
    ]
  },
  "commands": [
    {
      "namespace": "haste",
      "resource": "haste",
      "action": "run",
      "description": "Run haste",
      "adapter": "process",
      "adapterConfig": {
        "command": "haste",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install haste from github.com/cjmamo/haste"
      },
      "args": []
    }
  ]
}