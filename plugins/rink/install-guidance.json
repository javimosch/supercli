{
  "plugin": "rink",
  "binary": "rink",
  "check": "rink --version",
  "install_steps": [
    "cargo install rink",
    "Verify: rink --version",
    "supercli plugins install ./plugins/rink --on-conflict replace --json"
  ],
  "note": "Requires Rust toolchain (cargo). Also available via Homebrew: brew install rink"
}
