{
  "name": "cloud-sql-proxy",
  "version": "0.1.0",
  "description": "Utility for connecting securely to your Cloud SQL instances",
  "source": "https://github.com/GoogleCloudPlatform/cloud-sql-proxy",
  "checks": [
    {
      "type": "binary",
      "name": "cloud-sql-proxy"
    }
  ],
  "install_guidance": {
    "plugin": "cloud-sql-proxy",
    "binary": "cloud-sql-proxy",
    "check": "which cloud-sql-proxy",
    "install_steps": [
      "brew install cloud-sql-proxy",
      "Verify: cloud-sql-proxy --version",
      "supercli plugins install ./plugins/cloud-sql-proxy --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cloud-sql-proxy",
      "resource": "self",
      "action": "version",
      "description": "Print cloud-sql-proxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloud-sql-proxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cloud-sql-proxy: brew install cloud-sql-proxy"
      },
      "args": []
    },
    {
      "namespace": "cloud-sql-proxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cloud-sql-proxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloud-sql-proxy",
        "passthrough": true,
        "missingDependencyHelp": "Install cloud-sql-proxy"
      },
      "args": []
    }
  ]
}