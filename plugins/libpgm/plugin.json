{
  "name": "libpgm",
  "version": "0.1.0",
  "description": "Implements the PGM reliable multicast protocol",
  "source": "https://github.com/steve-o/openpgm",
  "checks": [
    {
      "type": "binary",
      "name": "libpgm"
    }
  ],
  "install_guidance": {
    "plugin": "libpgm",
    "binary": "libpgm",
    "check": "which libpgm",
    "install_steps": [
      "brew install libpgm",
      "Verify: libpgm --version",
      "supercli plugins install ./plugins/libpgm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libpgm",
      "resource": "self",
      "action": "version",
      "description": "Print libpgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libpgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libpgm: brew install libpgm"
      },
      "args": []
    },
    {
      "namespace": "libpgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libpgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libpgm",
        "passthrough": true,
        "missingDependencyHelp": "Install libpgm"
      },
      "args": []
    }
  ]
}