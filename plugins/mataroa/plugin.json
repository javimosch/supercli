{
  "name": "mataroa",
  "version": "0.1.0",
  "description": "CLI client for the Mataroa blog platform",
  "source": "https://github.com/mataroa-blog/mataroa-cli",
  "checks": [{ "type": "binary", "name": "mataroa" }],
  "install_guidance": {
    "plugin": "mataroa",
    "binary": "mataroa",
    "check": "which mataroa",
    "install_steps": ["pip install mataroa", "Verify: mataroa --version", "supercli plugins install ./plugins/mataroa --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mataroa",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mataroa CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mataroa",
      "passthrough": true,
      "missingDependencyHelp": "Install mataroa: pip install mataroa"
    },
    "args": []
  }]
}
