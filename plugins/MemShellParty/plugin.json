{
  "name": "MemShellParty",
  "version": "0.1.0",
  "description": "\u4e00\u6b3e\u4e13\u6ce8\u4e8e Java \u4e3b\u6d41 Web \u4e2d\u95f4\u4ef6\u7684\u5185\u5b58\u9a6c\u5feb\u901f\u751f\u6210\u5de5\u5177\uff0c\u81f4\u529b\u4e8e\u7b80\u5316\u5b89\u5168\u7814\u7a76\u4eba\u5458\u548c\u7ea2\u961f\u6210\u5458\u7684\u5de5\u4f5c\u6d41\u7a0b\uff0c\u63d0\u5347\u653b\u9632\u6548\u7387",
  "source": "https://github.com/MemShellParty/MemShellParty",
  "checks": [
    {
      "type": "binary",
      "name": "memshellparty"
    }
  ],
  "install_guidance": {
    "plugin": "MemShellParty",
    "binary": "memshellparty",
    "check": "which memshellparty",
    "install_steps": [
      "pip install memshellparty",
      "Verify: memshellparty --version",
      "supercli plugins install ./plugins/MemShellParty --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MemShellParty",
      "resource": "self",
      "action": "version",
      "description": "Print MemShellParty version",
      "adapter": "process",
      "adapterConfig": {
        "command": "memshellparty",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MemShellParty: pip install memshellparty"
      },
      "args": []
    },
    {
      "namespace": "MemShellParty",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to memshellparty CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "memshellparty",
        "passthrough": true,
        "missingDependencyHelp": "Install MemShellParty: pip install memshellparty"
      },
      "args": []
    }
  ]
}