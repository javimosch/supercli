{
  "name": "omlx",
  "version": "0.1.0",
  "description": "LLM inference server with continuous batching and SSD caching for Apple Silicon",
  "source": "https://github.com/jundot/omlx",
  "checks": [
    {
      "type": "binary",
      "name": "omlx"
    }
  ],
  "install_guidance": {
    "plugin": "omlx",
    "binary": "omlx",
    "check": "which omlx",
    "install_steps": [
      "pip install omlx",
      "Verify: omlx --version",
      "supercli plugins install ./plugins/omlx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "omlx",
    "resource": "self",
    "action": "version",
    "description": "Print omlx version",
    "adapter": "process",
    "adapterConfig": {
      "command": "omlx",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install omlx: pip install omlx"
    },
    "args": []
  },
  {
    "namespace": "omlx",
    "resource": "server",
    "action": "start",
    "description": "Start the oMLX inference server",
    "adapter": "process",
    "adapterConfig": {
      "command": "omlx",
      "passthrough": true,
      "missingDependencyHelp": "Install omlx: pip install omlx"
    },
    "args": []
  },
  {
    "namespace": "omlx",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to omlx CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "omlx",
      "passthrough": true,
      "missingDependencyHelp": "Install omlx"
    },
    "args": []
  }
]
}