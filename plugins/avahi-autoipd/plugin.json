{
  "name": "avahi-autoipd",
  "version": "0.1.0",
  "description": "CLI tool: avahi-autoipd",
  "source": "https://packages.debian.org/avahi-autoipd",
  "checks": [{ "type": "binary", "name": "avahi-autoipd" }],
  "install_guidance": {
    "plugin": "avahi-autoipd", "binary": "avahi-autoipd", "check": "which avahi-autoipd",
    "install_steps": ["apt-get install avahi-autoipd 2>/dev/null || which avahi-autoipd", "Verify: avahi-autoipd --version", "supercli plugins install ./plugins/avahi-autoipd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "avahi-autoipd", "resource": "_", "action": "_",
    "description": "Passthrough to avahi-autoipd CLI",
    "adapter": "process", "adapterConfig": { "command": "avahi-autoipd", "passthrough": true, "missingDependencyHelp": "Install avahi-autoipd: apt-get install avahi-autoipd" }, "args": []
  }]
}
