{
  "name": "bun-plugin-dts",
  "version": "0.1.0",
  "description": "Bun TypeScript declaration bundler",
  "source": "https://github.com/wobsoriano/bun-plugin-dts",
  "checks": [{ "type": "binary", "name": "bun-plugin-dts" }],
  "install_guidance": {
    "plugin": "bun-plugin-dts",
    "binary": "bun-plugin-dts",
    "check": "which bun-plugin-dts",
    "install_steps": ["bun add -d bun-plugin-dts", "Verify: bun-plugin-dts --version", "supercli plugins install ./plugins/bun-plugin-dts --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bun-plugin-dts",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bun-plugin-dts CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bun-plugin-dts",
      "passthrough": true,
      "missingDependencyHelp": "Install bun-plugin-dts: bun add -d bun-plugin-dts", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
