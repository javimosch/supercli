{
  "name": "wrk2",
  "version": "0.1.0",
  "description": "Constant throughput and correct latency recording HTTP benchmark",
  "source": "https://github.com/giltene/wrk2",
  "checks": [{ "type": "binary", "name": "wrk2" }],
  "install_guidance": {
    "plugin": "wrk2",
    "binary": "wrk2",
    "check": "which wrk2",
    "install_steps": ["brew install wrk2", "Verify: wrk2 --version", "supercli plugins install ./plugins/wrk2 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wrk2",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wrk2 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wrk2",
      "passthrough": true,
      "missingDependencyHelp": "Install wrk2: brew install wrk2"
    },
    "args": []
  }]
}
