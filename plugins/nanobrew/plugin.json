{
  "name": "nanobrew",
  "version": "0.1.0",
  "description": "The fastest macOS package manager. Written in Zig. 3ms warm installs.",
  "source": "https://github.com/nanobrew/nanobrew",
  "checks": [
    {
      "type": "binary",
      "name": "nanobrew"
    }
  ],
  "install_guidance": {
    "plugin": "nanobrew",
    "binary": "nanobrew",
    "check": "which nanobrew",
    "install_steps": [
      "pip install nanobrew",
      "Verify: nanobrew --version",
      "supercli plugins install ./plugins/nanobrew --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nanobrew",
      "resource": "self",
      "action": "version",
      "description": "Print nanobrew version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanobrew",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nanobrew: pip install nanobrew"
      },
      "args": []
    },
    {
      "namespace": "nanobrew",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nanobrew CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanobrew",
        "passthrough": true,
        "missingDependencyHelp": "Install nanobrew: pip install nanobrew"
      },
      "args": []
    }
  ]
}