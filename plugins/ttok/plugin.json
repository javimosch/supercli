{
  "name": "ttok",
  "version": "0.1.0",
  "description": "Count and truncate text for LLM token limits",
  "source": "https://github.com/simonw/ttok",
  "checks": [{ "type": "binary", "name": "ttok" }],
  "install_guidance": {
    "plugin": "ttok",
    "binary": "ttok",
    "check": "which ttok",
    "install_steps": ["pip install ttok", "Verify: ttok --version", "supercli plugins install ./plugins/ttok --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ttok",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ttok CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ttok",
      "passthrough": true,
      "missingDependencyHelp": "Install ttok: pip install ttok", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
