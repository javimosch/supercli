{
  "name": "libfaketime",
  "version": "0.1.0",
  "description": "Report faked system time to programs",
  "source": "https://github.com/wolfcw/libfaketime",
  "checks": [
    {
      "type": "binary",
      "name": "libfaketime"
    }
  ],
  "install_guidance": {
    "plugin": "libfaketime",
    "binary": "libfaketime",
    "check": "which libfaketime",
    "install_steps": [
      "brew install libfaketime",
      "Verify: libfaketime --version",
      "supercli plugins install ./plugins/libfaketime --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libfaketime",
      "resource": "self",
      "action": "version",
      "description": "Print libfaketime version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libfaketime",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libfaketime: brew install libfaketime"
      },
      "args": []
    },
    {
      "namespace": "libfaketime",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libfaketime CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libfaketime",
        "passthrough": true,
        "missingDependencyHelp": "Install libfaketime"
      },
      "args": []
    }
  ]
}