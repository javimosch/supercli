{
  "name": "ff-rdp-cli",
  "version": "0.1.0",
  "description": "A Firefox Remote Debug Protocol CLI client. Connects to Firefox instances for automated browser debugging and inspection from the command line.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "ff-rdp-cli"
    }
  ],
  "install_guidance": {
    "plugin": "ff-rdp-cli",
    "binary": "ff-rdp-cli",
    "check": "which ff-rdp-cli",
    "install_steps": [
      "cargo install ff-rdp-cli",
      "Verify: ff-rdp-cli --version",
      "supercli plugins install ./plugins/ff-rdp-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ff-rdp-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ff-rdp-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ff-rdp-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install ff-rdp-cli: cargo install ff-rdp-cli"
      },
      "args": []
    }
  ]
}
