{
  "name": "bitcoin-cli",
  "version": "0.1.0",
  "description": "Bitcoin Core CLI for blockchain operations",
  "source": "https",
  "checks": [{"type": "binary", "name": "bitcoin-cli"}],
  "install_guidance": {
    "plugin": "bitcoin-cli",
    "binary": "bitcoin-cli",
    "check": "which bitcoin-cli",
    "install_steps": [
      "brew install bitcoin",
      "Verify: bitcoin-cli --version",
      "supercli plugins install ./plugins/bitcoin-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "bitcoin-cli",
      "resource": "self",
      "action": "version",
      "description": "Print bitcoin-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "bitcoin-cli", "baseArgs": ["--version"], "missingDependencyHelp": "Install bitcoin-cli: brew install bitcoin"},
      "args": []
    },
    {
      "namespace": "bitcoin-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bitcoin-cli CLI",
      "adapter": "process",
      "adapterConfig": {"command": "bitcoin-cli", "passthrough": true, "missingDependencyHelp": "Install bitcoin-cli: brew install bitcoin"},
      "args": []
    }
  ]
}
