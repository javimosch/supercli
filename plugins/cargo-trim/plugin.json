{
  "name": "cargo-trim",
  "version": "0.1.0",
  "description": "A Cargo cache cleanup tool that trims the CARGO_HOME directory. Removes old and unused build artifacts to reclaim disk space from Rust projects.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-trim"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-trim",
    "binary": "cargo-trim",
    "check": "which cargo-trim",
    "install_steps": [
      "cargo install cargo-trim",
      "Verify: cargo-trim --version",
      "supercli plugins install ./plugins/cargo-trim --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo-trim",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-trim CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-trim",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-trim: cargo install cargo-trim"
      },
      "args": []
    }
  ]
}
