{
  "name": "gcloud-lite",
  "version": "0.1.0",
  "description": "Lightweight Google Cloud CLI",
  "source": "https://github.com/gcloud-lite/gcloud-lite",
  "checks": [
    {
      "type": "binary",
      "name": "gcloud-lite"
    }
  ],
  "install_guidance": {
    "plugin": "gcloud-lite",
    "binary": "gcloud-lite",
    "check": "which gcloud-lite",
    "install_steps": [
      "go install github.com/gcloud-lite/gcloud-lite@latest",
      "Verify: gcloud-lite --version",
      "supercli plugins install ./plugins/gcloud-lite --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gcloud-lite",
      "resource": "self",
      "action": "version",
      "description": "Print gcloud-lite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcloud-lite",
        "missingDependencyHelp": "Install gcloud-lite: go install github.com/gcloud-lite/gcloud-lite@latest",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "gcloud-lite",
      "resource": "compute",
      "action": "list",
      "description": "List compute instances",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcloud-lite",
        "missingDependencyHelp": "Install gcloud-lite: go install github.com/gcloud-lite/gcloud-lite@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "gcloud-lite",
      "resource": "storage",
      "action": "list",
      "description": "List storage buckets",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcloud-lite",
        "missingDependencyHelp": "Install gcloud-lite: go install github.com/gcloud-lite/gcloud-lite@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "gcloud-lite",
      "resource": "project",
      "action": "list",
      "description": "List Google Cloud projects",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcloud-lite",
        "missingDependencyHelp": "Install gcloud-lite: go install github.com/gcloud-lite/gcloud-lite@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "gcloud-lite",
      "resource": "_",
      "action": "_",
      "description": "_ _ via gcloud-lite",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcloud-lite",
        "missingDependencyHelp": "Install gcloud-lite: go install github.com/gcloud-lite/gcloud-lite@latest",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
