{
  "plugin": "gcloud-lite",
  "binary": "gcloud-lite",
  "check": "which gcloud-lite",
  "install_steps": [
    "go install github.com/gcloud-lite/gcloud-lite@latest",
    "Verify: gcloud-lite --version",
    "supercli plugins install ./plugins/gcloud-lite --on-conflict replace --json"
  ],
  "note": "Requires Go toolchain and Google Cloud credentials"
}
