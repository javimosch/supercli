{
  "name": "wasm-cmaes",
  "version": "0.1.0",
  "description": "WebAssembly port of CMA-ES optimizer for performance testing",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "wasm-cmaes" }],
  "install_guidance": {
    "plugin": "wasm-cmaes",
    "binary": "wasm-cmaes",
    "check": "which wasm-cmaes",
    "install_steps": ["npm install wasm-cmaes", "Verify: wasm-cmaes --version", "supercli plugins install ./plugins/wasm-cmaes --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wasm-cmaes",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wasm-cmaes CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wasm-cmaes",
      "passthrough": true,
      "missingDependencyHelp": "Install wasm-cmaes: npm install wasm-cmaes"
    },
    "args": []
  }]
}
