{
  "plugin": "gitui",
  "binary": "gitui",
  "check": "which gitui",
  "install_steps": [
    "cargo install gitui",
    "Or: brew install gitui",
    "Or download binary from https://github.com/gitui-org/gitui/releases",
    "Verify: gitui --version",
    "supercli plugins install ./plugins/gitui --on-conflict replace --json"
  ],
  "note": "Available via Cargo, Homebrew, and direct binary downloads. Source: https://github.com/gitui-org/gitui (22k+ stars). Written in Rust."
}
