{
  "name": "fixdlsrps",
  "version": "0.1.0",
  "description": "CLI tool: fixdlsrps",
  "source": "https://manpages.debian.org/fixdlsrps",
  "checks": [
    {
      "type": "binary",
      "name": "fixdlsrps"
    }
  ],
  "install_guidance": {
    "plugin": "fixdlsrps",
    "binary": "fixdlsrps",
    "check": "which fixdlsrps",
    "install_steps": [
      "apt-get install fixdlsrps 2>/dev/null || which fixdlsrps",
      "Verify: fixdlsrps --version",
      "supercli plugins install ./plugins/fixdlsrps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixdlsrps",
      "resource": "self",
      "action": "version",
      "description": "Print fixdlsrps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixdlsrps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixdlsrps: apt-get install fixdlsrps 2>/dev/null || which fixdlsrps"
      },
      "args": []
    },
    {
      "namespace": "fixdlsrps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixdlsrps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixdlsrps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixdlsrps: apt-get install fixdlsrps 2>/dev/null || which fixdlsrps"
      },
      "args": []
    }
  ]
}