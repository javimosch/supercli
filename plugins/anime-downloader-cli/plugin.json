{
  "name": "anime-downloader-cli",
  "version": "0.1.0",
  "description": "At least better than sites with Ads.. Pftt...",
  "source": "https://github.com/anime-downloader-cli/anime-downloader-cli",
  "checks": [
    {
      "type": "binary",
      "name": "anime-downloader-cli"
    }
  ],
  "install_guidance": {
    "plugin": "anime-downloader-cli",
    "binary": "anime-downloader-cli",
    "check": "which anime-downloader-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: anime-downloader-cli --version",
      "supercli plugins install ./plugins/anime-downloader-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "anime-downloader-cli",
      "resource": "self",
      "action": "version",
      "description": "Print anime-downloader-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "anime-downloader-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install anime-downloader-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "anime-downloader-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to anime-downloader-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "anime-downloader-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install anime-downloader-cli from project repository"
      },
      "args": []
    }
  ]
}