{
  "name": "pbmtobbnbg",
  "version": "0.1.0",
  "description": "CLI tool: pbmtobbnbg",
  "source": "https://manpages.debian.org/pbmtobbnbg",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtobbnbg"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtobbnbg",
    "binary": "pbmtobbnbg",
    "check": "which pbmtobbnbg",
    "install_steps": [
      "apt-get install pbmtobbnbg 2>/dev/null || which pbmtobbnbg",
      "Verify: pbmtobbnbg --version",
      "supercli plugins install ./plugins/pbmtobbnbg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtobbnbg",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtobbnbg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtobbnbg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtobbnbg: apt-get install pbmtobbnbg 2>/dev/null || which pbmtobbnbg"
      },
      "args": []
    },
    {
      "namespace": "pbmtobbnbg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtobbnbg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtobbnbg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtobbnbg: apt-get install pbmtobbnbg 2>/dev/null || which pbmtobbnbg"
      },
      "args": []
    }
  ]
}