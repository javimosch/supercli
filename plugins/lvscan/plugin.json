{
  "name": "lvscan",
  "version": "0.1.0",
  "description": "CLI tool: lvscan",
  "source": "https://manpages.debian.org/lvscan",
  "checks": [
    {
      "type": "binary",
      "name": "lvscan"
    }
  ],
  "install_guidance": {
    "plugin": "lvscan",
    "binary": "lvscan",
    "check": "which lvscan",
    "install_steps": [
      "apt-get install lvscan 2>/dev/null || which lvscan",
      "Verify: lvscan --version",
      "supercli plugins install ./plugins/lvscan --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lvscan",
      "resource": "self",
      "action": "version",
      "description": "Print lvscan version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lvscan",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lvscan: apt-get install lvscan 2>/dev/null || which lvscan"
      },
      "args": []
    },
    {
      "namespace": "lvscan",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lvscan CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lvscan",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lvscan: apt-get install lvscan 2>/dev/null || which lvscan"
      },
      "args": []
    }
  ]
}