{
  "name": "dura",
  "version": "0.1.0",
  "description": "Backs up your work automatically via Git commits",
  "source": "https://github.com/tkellogg/dura",
  "checks": [
    {
      "type": "binary",
      "name": "dura"
    }
  ],
  "install_guidance": {
    "plugin": "dura",
    "binary": "dura",
    "check": "which dura",
    "install_steps": [
      "brew install dura",
      "Verify: dura --version",
      "supercli plugins install ./plugins/dura --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dura",
      "resource": "self",
      "action": "version",
      "description": "Print dura version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dura",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dura: brew install dura"
      },
      "args": []
    },
    {
      "namespace": "dura",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dura CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dura",
        "passthrough": true,
        "missingDependencyHelp": "Install dura"
      },
      "args": []
    }
  ]
}