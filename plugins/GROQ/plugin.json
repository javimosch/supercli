{
  "name": "GROQ",
  "version": "0.1.0",
  "description": "JSON processor with queries and projections",
  "source": "https://github.com/sanity-io/groq-cli",
  "checks": [
    {
      "type": "binary",
      "name": "GROQ"
    }
  ],
  "install_guidance": {
    "plugin": "GROQ",
    "binary": "GROQ",
    "check": "which GROQ",
    "install_steps": [
      "See https://github.com/sanity-io/groq-cli",
      "Verify: GROQ --version",
      "supercli plugins install ./plugins/GROQ --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "GROQ",
      "resource": "self",
      "action": "version",
      "description": "Print GROQ version",
      "adapter": "process",
      "adapterConfig": {
        "command": "GROQ",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GROQ: See https://github.com/sanity-io/groq-cli"
      },
      "args": []
    },
    {
      "namespace": "GROQ",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to GROQ CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "GROQ",
        "passthrough": true,
        "missingDependencyHelp": "Install GROQ"
      },
      "args": []
    }
  ]
}