{
  "name": "bolt.new",
  "version": "0.1.0",
  "description": "Prompt, run, edit, and deploy full-stack web applications. -- bolt.new -- Help Center: https://suppo",
  "source": "https://github.com/bolt.new/bolt.new",
  "checks": [
    {
      "type": "binary",
      "name": "bolt.new"
    }
  ],
  "install_guidance": {
    "plugin": "bolt.new",
    "binary": "bolt.new",
    "check": "which bolt.new",
    "install_steps": [
      "pip install bolt.new",
      "Verify: bolt.new --version",
      "supercli plugins install ./plugins/bolt.new --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bolt.new",
      "resource": "self",
      "action": "version",
      "description": "Print bolt.new version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bolt.new",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bolt.new: pip install bolt.new"
      },
      "args": []
    },
    {
      "namespace": "bolt.new",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bolt.new CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bolt.new",
        "passthrough": true,
        "missingDependencyHelp": "Install bolt.new: pip install bolt.new"
      },
      "args": []
    }
  ]
}