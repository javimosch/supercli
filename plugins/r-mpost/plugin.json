{
  "name": "r-mpost",
  "version": "0.1.0",
  "description": "MetaPost tool for TeX documents",
  "source": "https://manpages.debian.org/r-mpost",
  "checks": [{ "type": "binary", "name": "r-mpost" }],
  "install_guidance": {
    "plugin": "r-mpost",
    "binary": "r-mpost",
    "check": "which r-mpost",
    "install_steps": [
      "apt-get install texlive-metapost",
      "Verify: r-mpost --version",
      "supercli plugins install ./plugins/r-mpost --on-conflict replace --json"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [{
    "namespace": "r-mpost",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to r-mpost CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "r-mpost",
      "passthrough": true,
      "missingDependencyHelp": "Install r-mpost: apt-get install texlive-metapost"
    },
    "args": []
  }]
}
