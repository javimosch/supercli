{
  "name": "ladybird",
  "version": "0.1.0",
  "description": "Truly independent web browser",
  "source": "https://github.com/ladybird/ladybird",
  "checks": [
    {
      "type": "binary",
      "name": "ladybird"
    }
  ],
  "install_guidance": {
    "plugin": "ladybird",
    "binary": "ladybird",
    "check": "which ladybird",
    "install_steps": [
      "pip install ladybird",
      "Verify: ladybird --version",
      "supercli plugins install ./plugins/ladybird --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ladybird",
      "resource": "self",
      "action": "version",
      "description": "Print ladybird version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ladybird",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ladybird: pip install ladybird"
      },
      "args": []
    },
    {
      "namespace": "ladybird",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ladybird CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ladybird",
        "passthrough": true,
        "missingDependencyHelp": "Install ladybird: pip install ladybird"
      },
      "args": []
    }
  ]
}