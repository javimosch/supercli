{
  "name": "ziex",
  "version": "0.1.0",
  "description": "Full-stack web framework for Zig. HTML syntax within Zig code, just like JSX but for Zig!",
  "source": "https://github.com/ziex/ziex",
  "checks": [
    {
      "type": "binary",
      "name": "ziex"
    }
  ],
  "install_guidance": {
    "plugin": "ziex",
    "binary": "ziex",
    "check": "which ziex",
    "install_steps": [
      "pip install ziex",
      "Verify: ziex --version",
      "supercli plugins install ./plugins/ziex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ziex",
      "resource": "self",
      "action": "version",
      "description": "Print ziex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ziex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ziex: pip install ziex"
      },
      "args": []
    },
    {
      "namespace": "ziex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ziex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ziex",
        "passthrough": true,
        "missingDependencyHelp": "Install ziex: pip install ziex"
      },
      "args": []
    }
  ]
}