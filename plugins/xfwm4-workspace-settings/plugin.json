{
  "name": "xfwm4-workspace-settings",
  "version": "0.1.0",
  "description": "CLI tool: xfwm4-workspace-settings",
  "source": "https://manpages.debian.org/xfwm4-workspace-settings",
  "checks": [
    {
      "type": "binary",
      "name": "xfwm4-workspace-settings"
    }
  ],
  "install_guidance": {
    "plugin": "xfwm4-workspace-settings",
    "binary": "xfwm4-workspace-settings",
    "check": "which xfwm4-workspace-settings",
    "install_steps": [
      "apt-get install xfwm4-workspace-settings 2>/dev/null || which xfwm4-workspace-settings",
      "Verify: xfwm4-workspace-settings --version",
      "supercli plugins install ./plugins/xfwm4-workspace-settings --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfwm4-workspace-settings",
      "resource": "self",
      "action": "version",
      "description": "Print xfwm4-workspace-settings version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfwm4-workspace-settings",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfwm4-workspace-settings: apt-get install xfwm4-workspace-settings 2>/dev/null || which xfwm4-workspace-settings"
      },
      "args": []
    },
    {
      "namespace": "xfwm4-workspace-settings",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfwm4-workspace-settings CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfwm4-workspace-settings",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfwm4-workspace-settings: apt-get install xfwm4-workspace-settings 2>/dev/null || which xfwm4-workspace-settings"
      },
      "args": []
    }
  ]
}