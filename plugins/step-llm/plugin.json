{
  "name": "step-llm",
  "version": "0.1.0",
  "description": "CLI for generating parametric CAD/STEP models from natural language",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "step-llm" }],
  "install_guidance": {
    "plugin": "step-llm",
    "binary": "step-llm",
    "check": "which step-llm",
    "install_steps": ["pip install step-llm", "Verify: step-llm --version", "supercli plugins install ./plugins/step-llm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "step-llm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to step-llm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "step-llm",
      "passthrough": true,
      "missingDependencyHelp": "Install step-llm: pip install step-llm"
    },
    "args": []
  }]
}
