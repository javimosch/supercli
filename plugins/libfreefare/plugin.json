{
  "name": "libfreefare",
  "version": "0.1.0",
  "description": "API for MIFARE card manipulations",
  "source": "https://github.com/nfc-tools/libfreefare",
  "checks": [
    {
      "type": "binary",
      "name": "libfreefare"
    }
  ],
  "install_guidance": {
    "plugin": "libfreefare",
    "binary": "libfreefare",
    "check": "which libfreefare",
    "install_steps": [
      "brew install libfreefare",
      "Verify: libfreefare --version",
      "supercli plugins install ./plugins/libfreefare --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libfreefare",
      "resource": "self",
      "action": "version",
      "description": "Print libfreefare version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libfreefare",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libfreefare: brew install libfreefare"
      },
      "args": []
    },
    {
      "namespace": "libfreefare",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libfreefare CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libfreefare",
        "passthrough": true,
        "missingDependencyHelp": "Install libfreefare"
      },
      "args": []
    }
  ]
}