{
  "name": "maim",
  "version": "0.1.0",
  "description": "Screenshot tool with minimal interface",
  "source": "https://github.com/naelstrof/maim",
  "checks": [
    {
      "type": "binary",
      "name": "maim"
    }
  ],
  "install_guidance": {
    "plugin": "maim",
    "binary": "maim",
    "check": "which maim",
    "install_steps": [
      "brew install maim",
      "Verify: maim --version",
      "supercli plugins install ./plugins/maim --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "maim",
      "resource": "self",
      "action": "version",
      "description": "Print maim version",
      "adapter": "process",
      "adapterConfig": {
        "command": "maim",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install maim: brew install maim"
      },
      "args": []
    },
    {
      "namespace": "maim",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to maim CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "maim",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install maim: brew install maim"
      },
      "args": []
    }
  ]
}
