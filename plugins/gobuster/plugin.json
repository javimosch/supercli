{
  "name": "gobuster",
  "version": "0.1.0",
  "description": "Directory/file bruteforce tool with --json",
  "source": "https://github.com/OJ/gobuster",
  "checks": [
    {
      "type": "binary",
      "name": "gobuster"
    }
  ],
  "install_guidance": {
    "plugin": "gobuster",
    "binary": "gobuster",
    "check": "which gobuster",
    "install_steps": [
      "brew install gobuster",
      "Verify: gobuster --version",
      "supercli plugins install ./plugins/gobuster --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "gobuster",
      "resource": "self",
      "action": "version",
      "description": "Print gobuster version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gobuster",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gobuster: brew install gobuster"
      },
      "args": []
    },
    {
      "namespace": "gobuster",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gobuster CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gobuster",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gobuster: brew install gobuster"
      },
      "args": []
    }
  ]
}
