{
  "name": "lp_solve",
  "version": "0.1.0",
  "description": "CLI tool: lp_solve",
  "source": "https://manpages.debian.org/lp_solve",
  "checks": [
    {
      "type": "binary",
      "name": "lp_solve"
    }
  ],
  "install_guidance": {
    "plugin": "lp_solve",
    "binary": "lp_solve",
    "check": "which lp_solve",
    "install_steps": [
      "apt-get install lp_solve 2>/dev/null || which lp_solve",
      "Verify: lp_solve --version",
      "supercli plugins install ./plugins/lp_solve --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lp_solve",
      "resource": "self",
      "action": "version",
      "description": "Print lp_solve version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lp_solve",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lp_solve: apt-get install lp_solve 2>/dev/null || which lp_solve"
      },
      "args": []
    },
    {
      "namespace": "lp_solve",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lp_solve CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lp_solve",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lp_solve: apt-get install lp_solve 2>/dev/null || which lp_solve"
      },
      "args": []
    }
  ]
}