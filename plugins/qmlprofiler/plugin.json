{
  "name": "qmlprofiler",
  "version": "0.1.0",
  "description": "CLI tool: qmlprofiler",
  "source": "https://manpages.debian.org/qmlprofiler",
  "checks": [
    {
      "type": "binary",
      "name": "qmlprofiler"
    }
  ],
  "install_guidance": {
    "plugin": "qmlprofiler",
    "binary": "qmlprofiler",
    "check": "which qmlprofiler",
    "install_steps": [
      "apt-get install qmlprofiler 2>/dev/null || which qmlprofiler",
      "Verify: qmlprofiler --version",
      "supercli plugins install ./plugins/qmlprofiler --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmlprofiler",
      "resource": "self",
      "action": "version",
      "description": "Print qmlprofiler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlprofiler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmlprofiler: apt-get install qmlprofiler 2>/dev/null || which qmlprofiler"
      },
      "args": []
    },
    {
      "namespace": "qmlprofiler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmlprofiler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlprofiler",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmlprofiler: apt-get install qmlprofiler 2>/dev/null || which qmlprofiler"
      },
      "args": []
    }
  ]
}