{
  "name": "mimeo",
  "version": "0.1.0",
  "description": "Mimeograph an expert into a SKILL.md or AGENTS.md — convert expertise into reusable AI agent skills",
  "source": "https://github.com/K-Dense-AI/mimeo",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "mimeo",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/K-Dense-AI/mimeo.git",
      "supercli plugins install ./plugins/mimeo --on-conflict replace --json",
      "sc skills teach mimeo:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "mimeo", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["mimeo v0.1.0 — Use sc skills teach mimeo:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/K-Dense-AI/mimeo.git" }, "args": [] },
    { "namespace": "mimeo", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/K-Dense-AI/mimeo.git then: sc skills teach mimeo:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/K-Dense-AI/mimeo.git" }, "args": [] }
  ]
}
