{
  "name": "openhuman",
  "version": "0.1.0",
  "description": "Your Personal AI super intelligence. Private, Simple and extremely powerful.",
  "source": "https://github.com/openhuman/openhuman",
  "checks": [
    {
      "type": "binary",
      "name": "openhuman"
    }
  ],
  "install_guidance": {
    "plugin": "openhuman",
    "binary": "openhuman",
    "check": "which openhuman",
    "install_steps": [
      "pip install openhuman",
      "Verify: openhuman --version",
      "supercli plugins install ./plugins/openhuman --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openhuman",
      "resource": "self",
      "action": "version",
      "description": "Print openhuman version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openhuman",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openhuman: pip install openhuman"
      },
      "args": []
    },
    {
      "namespace": "openhuman",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openhuman CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openhuman",
        "passthrough": true,
        "missingDependencyHelp": "Install openhuman: pip install openhuman"
      },
      "args": []
    }
  ]
}