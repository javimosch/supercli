{
  "name": "gxl2dot",
  "version": "0.1.0",
  "description": "CLI tool: gxl2dot",
  "source": "https://manpages.debian.org/gxl2dot",
  "checks": [
    {
      "type": "binary",
      "name": "gxl2dot"
    }
  ],
  "install_guidance": {
    "plugin": "gxl2dot",
    "binary": "gxl2dot",
    "check": "which gxl2dot",
    "install_steps": [
      "apt-get install gxl2dot 2>/dev/null || which gxl2dot",
      "Verify: gxl2dot --version",
      "supercli plugins install ./plugins/gxl2dot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gxl2dot",
      "resource": "self",
      "action": "version",
      "description": "Print gxl2dot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gxl2dot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gxl2dot: apt-get install gxl2dot 2>/dev/null || which gxl2dot"
      },
      "args": []
    },
    {
      "namespace": "gxl2dot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gxl2dot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gxl2dot",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gxl2dot: apt-get install gxl2dot 2>/dev/null || which gxl2dot"
      },
      "args": []
    }
  ]
}