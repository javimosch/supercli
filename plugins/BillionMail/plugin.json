{
  "name": "BillionMail",
  "version": "0.1.0",
  "description": "BillionMail gives you open-source MailServer, NewsLetter,  Email Marketing \u2014 fully self-hosted, dev-",
  "source": "https://github.com/BillionMail/BillionMail",
  "checks": [
    {
      "type": "binary",
      "name": "billionmail"
    }
  ],
  "install_guidance": {
    "plugin": "BillionMail",
    "binary": "billionmail",
    "check": "which billionmail",
    "install_steps": [
      "pip install billionmail",
      "Verify: billionmail --version",
      "supercli plugins install ./plugins/BillionMail --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BillionMail",
      "resource": "self",
      "action": "version",
      "description": "Print BillionMail version",
      "adapter": "process",
      "adapterConfig": {
        "command": "billionmail",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BillionMail: pip install billionmail"
      },
      "args": []
    },
    {
      "namespace": "BillionMail",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to billionmail CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "billionmail",
        "passthrough": true,
        "missingDependencyHelp": "Install BillionMail: pip install billionmail"
      },
      "args": []
    }
  ]
}