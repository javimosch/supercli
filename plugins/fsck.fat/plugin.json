{
  "name": "fsck.fat",
  "version": "0.1.0",
  "description": "CLI tool: fsck.fat",
  "source": "https://manpages.debian.org/fsck.fat",
  "checks": [
    {
      "type": "binary",
      "name": "fsck.fat"
    }
  ],
  "install_guidance": {
    "plugin": "fsck.fat",
    "binary": "fsck.fat",
    "check": "which fsck.fat",
    "install_steps": [
      "apt-get install fsck.fat 2>/dev/null || which fsck.fat",
      "Verify: fsck.fat --version",
      "supercli plugins install ./plugins/fsck.fat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fsck.fat",
      "resource": "self",
      "action": "version",
      "description": "Print fsck.fat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsck.fat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fsck.fat: apt-get install fsck.fat 2>/dev/null || which fsck.fat"
      },
      "args": []
    },
    {
      "namespace": "fsck.fat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fsck.fat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsck.fat",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fsck.fat: apt-get install fsck.fat 2>/dev/null || which fsck.fat"
      },
      "args": []
    }
  ]
}