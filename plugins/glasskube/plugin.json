{
  "name": "glasskube",
  "version": "0.1.0",
  "description": "K8s Package Manager",
  "source": "https://github.com/glasskube/glasskube",
  "checks": [
    { "type": "binary", "name": "glasskube" }
  ],
  "install_guidance": {
    "plugin": "glasskube",
    "binary": "glasskube",
    "check": "which glasskube",
    "install_steps": [
      "brew install glasskube",
      "Verify: glasskube version",
      "supercli plugins install ./plugins/glasskube --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "glasskube",
      "resource": "self",
      "action": "version",
      "description": "Print glasskube version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glasskube",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install glasskube: brew install glasskube"
      },
      "args": []
    },
    {
      "namespace": "glasskube",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glasskube CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glasskube",
        "passthrough": true,
        "missingDependencyHelp": "Install glasskube"
      },
      "args": []
    }
  ]
}
