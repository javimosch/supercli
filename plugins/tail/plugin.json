{
  "name": "tail",
  "version": "0.1.0",
  "description": "tail — output the last part of files with live follow mode",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "tail"
    }
  ],
  "install_guidance": {
    "plugin": "tail",
    "binary": "tail",
    "check": "which tail",
    "install_steps": [
      "base system",
      "Verify: tail --version 2>/dev/null || tail --help",
      "supercli plugins install ./plugins/tail --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tail",
      "resource": "self",
      "action": "version",
      "description": "Print tail version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tail",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tail: base system"
      },
      "args": []
    },
    {
      "namespace": "tail",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tail CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tail",
        "passthrough": true,
        "missingDependencyHelp": "Install tail: base system"
      },
      "args": []
    }
  ]
}
