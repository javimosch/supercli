{
  "name": "airodump-ng",
  "version": "1.0.0",
  "description": "airodump-ng \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=airodump-ng+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "airodump-ng"
    }
  ],
  "install_guidance": {
    "plugin": "airodump-ng",
    "binary": "airodump-ng",
    "check": "which airodump-ng",
    "install_steps": [
      "Install airodump-ng via package manager: apt install airodump-ng or brew install airodump-ng"
    ]
  },
  "commands": [
    {
      "namespace": "airodumpng",
      "resource": "run",
      "action": "exec",
      "description": "airodump-ng \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "airodump-ng",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install airodump-ng via your package manager"
      },
      "args": []
    }
  ]
}