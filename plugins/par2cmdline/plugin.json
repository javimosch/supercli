{
  "name": "par2cmdline",
  "version": "0.1.0",
  "description": "Parity archive v2 file verification and repair tool",
  "source": "https://github.com/Parchive/par2cmdline",
  "checks": [{ "type": "binary", "name": "par2" }],
  "install_guidance": {
    "plugin": "par2cmdline",
    "binary": "par2",
    "check": "which par2",
    "install_steps": ["brew install par2", "Verify: par2 --version", "supercli plugins install ./plugins/par2cmdline --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "par2cmdline",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to par2 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "par2",
      "passthrough": true,
      "missingDependencyHelp": "Install par2cmdline: brew install par2"
    },
    "args": []
  }]
}
