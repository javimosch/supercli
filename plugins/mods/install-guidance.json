{
  "plugin": "mods",
  "binary": "mods",
  "check": "which mods",
  "install_steps": [
    "go install github.com/charmbracelet/mods@latest",
    "Or: brew install mods",
    "Or: scoop install mods",
    "Or download binary from https://github.com/charmbracelet/mods/releases",
    "Verify: mods --version",
    "supercli plugins install ./plugins/mods --on-conflict replace --json"
  ],
  "note": "Written in Go by Charmbracelet. Requires API key set as env var (OPENAI_API_KEY, ANTHROPIC_API_KEY, or OLLAMA_HOST). Also installable via: nixpkgs, Docker."
}
