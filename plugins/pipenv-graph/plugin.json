{
  "name": "pipenv-graph",
  "version": "0.1.0",
  "description": "Visualize pipenv dependency graphs",
  "source": "https://github.com/naiquevin/pipenv-graph",
  "checks": [{ "type": "binary", "name": "pipenv-graph" }],
  "install_guidance": {
    "plugin": "pipenv-graph",
    "binary": "pipenv-graph",
    "check": "which pipenv-graph",
    "install_steps": ["pip install pipenv-graph", "Verify: pipenv-graph --version", "supercli plugins install ./plugins/pipenv-graph --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipenv-graph",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipenv-graph CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipenv-graph",
      "passthrough": true,
      "missingDependencyHelp": "Install pipenv-graph: pip install pipenv-graph", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
