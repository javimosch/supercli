{
  "name": "pspy",
  "version": "0.1.0",
  "description": "pspy \u2014 unprivileged Linux process snooping tool.",
  "source": "https://github.com/DominicBreuker/pspy",
  "checks": [
    {
      "type": "binary",
      "name": "pspy"
    }
  ],
  "install_guidance": {
    "plugin": "pspy",
    "binary": "pspy",
    "check": "which pspy",
    "install_steps": [
      "go install github.com/DominicBreuker/pspy@latest"
    ],
    "note": "Go. Process snooping (requires root for some features)."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pspy",
      "resource": "process",
      "action": "watch",
      "description": "Watch process creation events",
      "adapter": "process",
      "adapterConfig": {
        "command": "pspy",
        "missingDependencyHelp": "Install pspy",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "pspy",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pspy",
        "missingDependencyHelp": "Install pspy",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
