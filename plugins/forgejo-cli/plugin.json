{
  "name": "forgejo-cli",
  "version": "0.1.0",
  "description": "Forgejo CLI for repository management",
  "source": "https://codeberg.org/forgejo/forgejo-cli",
  "checks": [{ "type": "binary", "name": "forgejo-cli" }],
  "install_guidance": {
    "plugin": "forgejo-cli",
    "binary": "forgejo-cli",
    "check": "which forgejo-cli",
    "install_steps": ["brew install forgejo-cli", "Verify: forgejo-cli --version", "supercli plugins install ./plugins/forgejo-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "forgejo-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to forgejo-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "forgejo-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install forgejo-cli: brew install forgejo-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
