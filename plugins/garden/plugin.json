{
  "name": "garden",
  "version": "0.1.0",
  "description": "Kubernetes development and testing platform",
  "source": "https://github.com/garden-io/garden",
  "checks": [{ "type": "binary", "name": "garden" }],
  "install_guidance": {
    "plugin": "garden",
    "binary": "garden",
    "check": "which garden",
    "install_steps": ["brew install garden", "Verify: garden --version", "supercli plugins install ./plugins/garden --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "garden",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to garden CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "garden",
      "passthrough": true,
      "missingDependencyHelp": "Install garden: brew install garden"
    },
    "args": []
  }]
}
