{
  "name": "fluss",
  "version": "0.1.0",
  "description": "Apache Fluss is a streaming storage built for real-time analytics.",
  "source": "https://github.com/fluss/fluss",
  "checks": [
    {
      "type": "binary",
      "name": "fluss"
    }
  ],
  "install_guidance": {
    "plugin": "fluss",
    "binary": "fluss",
    "check": "which fluss",
    "install_steps": [
      "pip install fluss",
      "Verify: fluss --version",
      "supercli plugins install ./plugins/fluss --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fluss",
      "resource": "self",
      "action": "version",
      "description": "Print fluss version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fluss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fluss: pip install fluss"
      },
      "args": []
    },
    {
      "namespace": "fluss",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fluss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fluss",
        "passthrough": true,
        "missingDependencyHelp": "Install fluss: pip install fluss"
      },
      "args": []
    }
  ]
}