{
  "name": "dist",
  "version": "0.1.0",
  "description": "CLI tool: dist",
  "source": "https://packages.debian.org/dist",
  "checks": [{ "type": "binary", "name": "dist" }],
  "install_guidance": {
    "plugin": "dist", "binary": "dist", "check": "which dist",
    "install_steps": ["apt-get install dist 2>/dev/null || which dist", "Verify: dist --version", "supercli plugins install ./plugins/dist --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dist", "resource": "_", "action": "_",
    "description": "Passthrough to dist CLI",
    "adapter": "process", "adapterConfig": { "command": "dist", "passthrough": true, "missingDependencyHelp": "Install dist: apt-get install dist" }, "args": []
  }]
}
