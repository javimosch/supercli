{
  "plugin": "resvg",
  "binary": "resvg",
  "check": "which resvg",
  "install_steps": [
    "brew install resvg",
    "Or: cargo install resvg",
    "Verify: resvg --version",
    "supercli plugins install ./plugins/resvg --on-conflict replace --json"
  ],
  "note": "resvg is an SVG rendering engine. Converts SVG to PNG/PDF/SVG formats. Written in Rust."
}
