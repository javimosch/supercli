{
  "name": "tractcloud",
  "version": "0.1.0",
  "description": "Local-global streamline point cloud representation for medical imaging",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "tractcloud" }],
  "install_guidance": {
    "plugin": "tractcloud",
    "binary": "tractcloud",
    "check": "which tractcloud",
    "install_steps": ["pip install tractcloud", "Verify: tractcloud --version", "supercli plugins install ./plugins/tractcloud --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tractcloud",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tractcloud CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tractcloud",
      "passthrough": true,
      "missingDependencyHelp": "Install tractcloud: pip install tractcloud"
    },
    "args": []
  }]
}
