{
  "name": "oracle-cloud",
  "version": "1.0.0",
  "description": "oci — Oracle Cloud Infrastructure CLI. Manage OCI compute, networking, storage, and database services.",
  "source": "",
  "checks": [
    { "type": "binary", "name": "oci" }
  ],
  "install_guidance": {
    "plugin": "oracle-cloud",
    "binary": "oci",
    "check": "which oci",
    "install_steps": [
      "bash -c \"$(curl -L https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh)\"",
      "Verify: oci --version",
      "supercli plugins install ./plugins/oracle-cloud --on-conflict replace --json"
    ],
    "note": "Official cloud CLI."
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    {
      "namespace": "oracle",
      "resource": "cloud",
      "action": "run",
      "description": "oci — Oracle Cloud Infrastructure CLI. Manage OCI compute, networking, storage, and database services.",
      "adapter": "process",
      "adapterConfig": {
        "command": "oci",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install Oracle Cloud CLI: bash -c \"$(curl -L https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh)\""
      },
      "args": []
    }
  ]
}
