{
  "name": "chromedriver",
  "version": "0.1.0",
  "description": "chromedriver — Transitional package - chromium-chromedriver -> chromium snap",
  "source": "https://chromium.googlesource.com/chromium/src/",
  "checks": [{ "type": "binary", "name": "chromedriver" }],
  "install_guidance": {
    "plugin": "chromedriver", "binary": "chromedriver", "check": "which chromedriver",
    "install_steps": ["apt-get install chromium-chromedriver 2>/dev/null || which chromedriver", "Verify: chromedriver --version", "supercli plugins install ./plugins/chromedriver --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "chromedriver", "resource": "_", "action": "_",
    "description": "Passthrough to chromedriver CLI",
    "adapter": "process", "adapterConfig": { "command": "chromedriver", "passthrough": true, "missingDependencyHelp": "Install chromedriver: apt-get install chromium-chromedriver" }, "args": []
  }]
}
