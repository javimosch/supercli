{
  "name": "ssl-tls-verify",
  "version": "0.1.0",
  "description": "Verify SSL/TLS connections and inspect certificate chains",
  "source": "go",
  "checks": [{ "type": "binary", "name": "ssl-tls-verify" }],
  "install_guidance": {
    "plugin": "ssl-tls-verify",
    "binary": "ssl-tls-verify",
    "check": "which ssl-tls-verify",
    "install_steps": ["go install github.com/muquit/ssl-tls-verify@latest", "Verify: ssl-tls-verify --version", "supercli plugins install ./plugins/ssl-tls-verify --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ssl-tls-verify",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ssl-tls-verify CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ssl-tls-verify",
      "passthrough": true,
      "missingDependencyHelp": "Install ssl-tls-verify: go install github.com/muquit/ssl-tls-verify@latest"
    },
    "args": []
  }]
}
