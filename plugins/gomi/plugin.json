{
  "name": "gomi",
  "version": "1.0.0",
  "description": "gomi \u2014 Trash can CLI (rm alternative)",
  "source": "github.com/b4b4r07/gomi",
  "checks": [
    {
      "type": "binary",
      "name": "gomi"
    }
  ],
  "install_guidance": {
    "plugin": "gomi",
    "binary": "gomi",
    "check": "which gomi",
    "install_steps": [
      "# Install gomi:",
      "# apt: sudo apt-get install gomi",
      "# brew: brew install gomi",
      "# cargo: cargo install gomi",
      "# npm: npm install -g gomi",
      "# pip: pip install gomi",
      "# or download from github.com/b4b4r07/gomi"
    ]
  },
  "commands": [
    {
      "namespace": "gomi",
      "resource": "gomi",
      "action": "run",
      "description": "Run gomi",
      "adapter": "process",
      "adapterConfig": {
        "command": "gomi",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gomi from github.com/b4b4r07/gomi"
      },
      "args": []
    }
  ]
}