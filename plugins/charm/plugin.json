{
  "name": "charm",
  "version": "0.1.0",
  "description": "Charm CLI -- the official Charm client for Charm Cloud. Upload, download, encrypt, and manage data from the terminal.",
  "source": "https://github.com/charmbracelet/charm",
  "checks": [
    { "type": "binary", "name": "charm" }
  ],
  "install_guidance": {
    "plugin": "charm",
    "binary": "charm",
    "check": "which charm",
    "install_steps": [
      "brew install charm",
      "Or: curl -sSL https://raw.githubusercontent.com/charmbracelet/charm/main/install.sh | bash",
      "Verify: charm --version",
      "supercli plugins install ./plugins/charm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "charm",
      "resource": "self",
      "action": "version",
      "description": "Print charm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "charm",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install charm: brew install charm"
      },
      "args": []
    },
    {
      "namespace": "charm",
      "resource": "data",
      "action": "upload",
      "description": "Pipe data to Charm Cloud (charm pump)",
      "adapter": "process",
      "adapterConfig": {
        "command": "charm",
        "baseArgs": ["pump"],
        "passthrough": true,
        "missingDependencyHelp": "Install charm: brew install charm"
      },
      "args": []
    },
    {
      "namespace": "charm",
      "resource": "data",
      "action": "download",
      "description": "Download data from Charm Cloud",
      "adapter": "process",
      "adapterConfig": {
        "command": "charm",
        "baseArgs": ["download"],
        "passthrough": true,
        "missingDependencyHelp": "Install charm: brew install charm"
      },
      "args": [
        { "name": "url", "type": "string", "required": true, "description": "Charm Cloud URL to download" }
      ]
    },
    {
      "namespace": "charm",
      "resource": "terminal",
      "action": "identify",
      "description": "Show terminal identification info",
      "adapter": "process",
      "adapterConfig": {
        "command": "charm",
        "baseArgs": ["id"],
        "missingDependencyHelp": "Install charm: brew install charm"
      },
      "args": []
    },
    {
      "namespace": "charm",
      "resource": "crypto",
      "action": "encrypt",
      "description": "Encrypt data using Charm keys",
      "adapter": "process",
      "adapterConfig": {
        "command": "charm",
        "baseArgs": ["encrypt"],
        "passthrough": true,
        "missingDependencyHelp": "Install charm: brew install charm"
      },
      "args": []
    },
    {
      "namespace": "charm",
      "resource": "crypto",
      "action": "decrypt",
      "description": "Decrypt data using Charm keys",
      "adapter": "process",
      "adapterConfig": {
        "command": "charm",
        "baseArgs": ["decrypt"],
        "passthrough": true,
        "missingDependencyHelp": "Install charm: brew install charm"
      },
      "args": []
    },
    {
      "namespace": "charm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to charm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "charm",
        "passthrough": true,
        "missingDependencyHelp": "Install charm: brew install charm"
      },
      "args": []
    }
  ]
}
