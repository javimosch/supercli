{
  "name": "pbmtopi3",
  "version": "0.1.0",
  "description": "CLI tool: pbmtopi3",
  "source": "https://manpages.debian.org/pbmtopi3",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtopi3"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtopi3",
    "binary": "pbmtopi3",
    "check": "which pbmtopi3",
    "install_steps": [
      "apt-get install pbmtopi3 2>/dev/null || which pbmtopi3",
      "Verify: pbmtopi3 --version",
      "supercli plugins install ./plugins/pbmtopi3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtopi3",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtopi3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtopi3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtopi3: apt-get install pbmtopi3 2>/dev/null || which pbmtopi3"
      },
      "args": []
    },
    {
      "namespace": "pbmtopi3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtopi3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtopi3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtopi3: apt-get install pbmtopi3 2>/dev/null || which pbmtopi3"
      },
      "args": []
    }
  ]
}