{
  "name": "tre",
  "version": "0.1.0",
  "description": "Tree command with output formatted for aliases and navigation",
  "source": "https://github.com/dduan/tre",
  "checks": [{ "type": "binary", "name": "tre" }],
  "install_guidance": {
    "plugin": "tre",
    "binary": "tre",
    "check": "which tre",
    "install_steps": ["cargo install tre-command", "Verify: tre --version", "supercli plugins install ./plugins/tre --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tre",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tre CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tre",
      "passthrough": true,
      "missingDependencyHelp": "Install tre: cargo install tre-command", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
