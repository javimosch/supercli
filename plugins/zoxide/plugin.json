{
  "name": "zoxide",
  "version": "0.1.0",
  "description": "Zoxide — smart directory jumper with frecency tracking",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "zoxide"
    }
  ],
  "install_guidance": {
    "plugin": "zoxide",
    "binary": "zoxide",
    "check": "which zoxide",
    "install_steps": [
      "cargo install zoxide",
      "Verify: zoxide --version",
      "supercli plugins install ./plugins/zoxide --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zoxide",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zoxide",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zoxide"
      },
      "args": []
    }
  ]
}
