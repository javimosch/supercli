{
  "name": "postdrop",
  "version": "1.0.0",
  "description": "postdrop \u2014 postdrop \u2014 CLI utility",
  "source": "/usr/sbin/postdrop",
  "checks": [
    {
      "type": "binary",
      "name": "postdrop"
    }
  ],
  "install_guidance": {
    "plugin": "postdrop",
    "binary": "postdrop",
    "check": "which postdrop",
    "install_steps": [
      "# Install postdrop:",
      "# apt: sudo apt-get install postdrop",
      "# brew: brew install postdrop",
      "# cargo: cargo install postdrop",
      "# npm: npm install -g postdrop",
      "# pip: pip install postdrop",
      "# or download from /usr/sbin/postdrop"
    ]
  },
  "commands": [
    {
      "namespace": "postdrop",
      "resource": "postdrop",
      "action": "run",
      "description": "Run postdrop",
      "adapter": "process",
      "adapterConfig": {
        "command": "postdrop",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postdrop from /usr/sbin/postdrop"
      },
      "args": []
    }
  ]
}