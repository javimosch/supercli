{
  "name": "bitly-client",
  "version": "0.1.0",
  "description": "Bitly client",
  "source": "https://github.com/specious/bitly-client",
  "checks": [
    {
      "type": "binary",
      "name": "bitly-client"
    }
  ],
  "install_guidance": {
    "plugin": "bitly-client",
    "binary": "bitly-client",
    "check": "which bitly-client",
    "install_steps": [
      "npm install -g bitly-client",
      "Verify: bitly-client --version",
      "supercli plugins install ./plugins/bitly-client --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bitly-client",
      "resource": "self",
      "action": "version",
      "description": "Print bitly-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitly-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bitly-client: npm install -g bitly-client"
      },
      "args": []
    },
    {
      "namespace": "bitly-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bitly-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitly-client",
        "passthrough": true,
        "missingDependencyHelp": "Install bitly-client"
      },
      "args": []
    }
  ]
}