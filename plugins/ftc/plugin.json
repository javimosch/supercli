{
  "name": "ftc",
  "version": "0.1.0",
  "description": "Fast Time Converter for Unix timestamps and human-readable dates",
  "source": "https://github.com/search/ftc",
  "checks": [{ "type": "binary", "name": "ftc" }],
  "install_guidance": {
    "plugin": "ftc",
    "binary": "ftc",
    "check": "which ftc",
    "install_steps": ["cargo install ftc", "Verify: ftc --version", "supercli plugins install ./plugins/ftc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ftc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ftc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ftc",
      "passthrough": true,
      "missingDependencyHelp": "Install ftc: cargo install ftc"
    },
    "args": []
  }]
}
