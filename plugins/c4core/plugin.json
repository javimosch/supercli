{
  "name": "c4core",
  "version": "0.1.0",
  "description": "C++ utilities",
  "source": "https://github.com/biojppm/c4core",
  "checks": [
    {
      "type": "binary",
      "name": "c4core"
    }
  ],
  "install_guidance": {
    "plugin": "c4core",
    "binary": "c4core",
    "check": "which c4core",
    "install_steps": [
      "brew install c4core",
      "Verify: c4core --version",
      "supercli plugins install ./plugins/c4core --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "c4core",
      "resource": "self",
      "action": "version",
      "description": "Print c4core version",
      "adapter": "process",
      "adapterConfig": {
        "command": "c4core",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install c4core: brew install c4core"
      },
      "args": []
    },
    {
      "namespace": "c4core",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to c4core CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "c4core",
        "passthrough": true,
        "missingDependencyHelp": "Install c4core"
      },
      "args": []
    }
  ]
}