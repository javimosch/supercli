{
  "name": "WSGameDebugClient",
  "version": "0.1.0",
  "description": "提供给基于websocket协议的麻将游戏服务器提供调试的工具",
  "source": "https://github.com/WSGameDebugClient/WSGameDebugClient",
  "checks": [
    {
      "type": "binary",
      "name": "WSGameDebugClient"
    }
  ],
  "install_guidance": {
    "plugin": "WSGameDebugClient",
    "binary": "WSGameDebugClient",
    "check": "which WSGameDebugClient",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: WSGameDebugClient --version",
      "supercli plugins install ./plugins/WSGameDebugClient --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "WSGameDebugClient",
      "resource": "self",
      "action": "version",
      "description": "Print WSGameDebugClient version",
      "adapter": "process",
      "adapterConfig": {
        "command": "WSGameDebugClient",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install WSGameDebugClient from project repository"
      },
      "args": []
    },
    {
      "namespace": "WSGameDebugClient",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to WSGameDebugClient CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "WSGameDebugClient",
        "passthrough": true,
        "missingDependencyHelp": "Install WSGameDebugClient from project repository"
      },
      "args": []
    }
  ]
}