{
  "name": "nvim-typescript",
  "version": "0.1.0",
  "description": "Typescript tooling for Neovim",
  "source": "https://github.com/nvim-typescript/nvim-typescript",
  "checks": [
    {
      "type": "binary",
      "name": "nvim-typescript"
    }
  ],
  "install_guidance": {
    "plugin": "nvim-typescript",
    "binary": "nvim-typescript",
    "check": "which nvim-typescript",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: nvim-typescript --version",
      "supercli plugins install ./plugins/nvim-typescript --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "nvim-typescript",
      "resource": "self",
      "action": "version",
      "description": "Print nvim-typescript version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nvim-typescript",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nvim-typescript from project repository"
      },
      "args": []
    },
    {
      "namespace": "nvim-typescript",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nvim-typescript CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nvim-typescript",
        "passthrough": true,
        "missingDependencyHelp": "Install nvim-typescript from project repository"
      },
      "args": []
    }
  ]
}