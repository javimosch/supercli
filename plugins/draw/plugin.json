{
  "name": "draw",
  "version": "1.0.0",
  "description": "draw \u2014 ASCII drawing tool",
  "source": "github.com/maandree/draw",
  "checks": [
    {
      "type": "binary",
      "name": "draw"
    }
  ],
  "install_guidance": {
    "plugin": "draw",
    "binary": "draw",
    "check": "which draw",
    "install_steps": [
      "# Install draw",
      "# See github.com/maandree/draw",
      "# apt: sudo apt-get install draw",
      "# brew: brew install draw",
      "# cargo: cargo install draw",
      "# npm: npm install -g draw",
      "# pip: pip install draw"
    ]
  },
  "commands": [
    {
      "namespace": "draw",
      "resource": "draw",
      "action": "run",
      "description": "Run draw",
      "adapter": "process",
      "adapterConfig": {
        "command": "draw",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install draw from github.com/maandree/draw"
      },
      "args": []
    }
  ]
}