{
  "name": "RepoBar",
  "version": "0.1.0",
  "description": "Show status of GitHub Repos right in your menu bar and terminal: CI, Issues, Pull Requests, Latest R",
  "source": "https://github.com/RepoBar/RepoBar",
  "checks": [
    {
      "type": "binary",
      "name": "repobar"
    }
  ],
  "install_guidance": {
    "plugin": "RepoBar",
    "binary": "repobar",
    "check": "which repobar",
    "install_steps": [
      "pip install repobar",
      "Verify: repobar --version",
      "supercli plugins install ./plugins/RepoBar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RepoBar",
      "resource": "self",
      "action": "version",
      "description": "Print RepoBar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "repobar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RepoBar: pip install repobar"
      },
      "args": []
    },
    {
      "namespace": "RepoBar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to repobar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "repobar",
        "passthrough": true,
        "missingDependencyHelp": "Install RepoBar: pip install repobar"
      },
      "args": []
    }
  ]
}