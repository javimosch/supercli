{
  "name": "xiaozhi-esp32",
  "version": "0.1.0",
  "description": "An MCP-based chatbot | \u4e00\u4e2a\u57fa\u4e8eMCP\u7684\u804a\u5929\u673a\u5668\u4eba",
  "source": "https://github.com/xiaozhi-esp32/xiaozhi-esp32",
  "checks": [
    {
      "type": "binary",
      "name": "xiaozhi-esp32"
    }
  ],
  "install_guidance": {
    "plugin": "xiaozhi-esp32",
    "binary": "xiaozhi-esp32",
    "check": "which xiaozhi-esp32",
    "install_steps": [
      "pip install xiaozhi-esp32",
      "Verify: xiaozhi-esp32 --version",
      "supercli plugins install ./plugins/xiaozhi-esp32 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xiaozhi-esp32",
      "resource": "self",
      "action": "version",
      "description": "Print xiaozhi-esp32 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaozhi-esp32",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xiaozhi-esp32: pip install xiaozhi-esp32"
      },
      "args": []
    },
    {
      "namespace": "xiaozhi-esp32",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xiaozhi-esp32 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaozhi-esp32",
        "passthrough": true,
        "missingDependencyHelp": "Install xiaozhi-esp32: pip install xiaozhi-esp32"
      },
      "args": []
    }
  ]
}