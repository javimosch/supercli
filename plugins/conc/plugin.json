{
  "name": "conc",
  "version": "0.1.0",
  "description": "Better structured concurrency for go",
  "source": "https://github.com/conc/conc",
  "checks": [
    {
      "type": "binary",
      "name": "conc"
    }
  ],
  "install_guidance": {
    "plugin": "conc",
    "binary": "conc",
    "check": "which conc",
    "install_steps": [
      "pip install conc",
      "Verify: conc --version",
      "supercli plugins install ./plugins/conc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "conc",
      "resource": "self",
      "action": "version",
      "description": "Print conc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "conc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install conc: pip install conc"
      },
      "args": []
    },
    {
      "namespace": "conc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to conc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "conc",
        "passthrough": true,
        "missingDependencyHelp": "Install conc: pip install conc"
      },
      "args": []
    }
  ]
}