{
  "name": "danger",
  "version": "1.0.0",
  "description": "danger \u2014 CI automation",
  "source": "danger.systems",
  "checks": [
    {
      "type": "binary",
      "name": "danger"
    }
  ],
  "install_guidance": {
    "plugin": "danger",
    "binary": "danger",
    "check": "which danger",
    "install_steps": [
      "# Install danger",
      "# See danger.systems",
      "# apt: sudo apt-get install danger",
      "# brew: brew install danger",
      "# cargo: cargo install danger",
      "# npm: npm install -g danger",
      "# pip: pip install danger"
    ]
  },
  "commands": [
    {
      "namespace": "danger",
      "resource": "danger",
      "action": "run",
      "description": "Run danger",
      "adapter": "process",
      "adapterConfig": {
        "command": "danger",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install danger from danger.systems"
      },
      "args": []
    }
  ]
}