{
  "name": "lucky-commit",
  "version": "0.1.0",
  "description": "Customize your git commit hashes!",
  "source": "https://github.com/not-an-aardvark/lucky-commit",
  "checks": [
    {
      "type": "binary",
      "name": "lucky-commit"
    }
  ],
  "install_guidance": {
    "plugin": "lucky-commit",
    "binary": "lucky-commit",
    "check": "which lucky-commit",
    "install_steps": [
      "brew install lucky-commit",
      "Verify: lucky-commit --version",
      "supercli plugins install ./plugins/lucky-commit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lucky-commit",
      "resource": "self",
      "action": "version",
      "description": "Print lucky-commit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lucky-commit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lucky-commit: brew install lucky-commit"
      },
      "args": []
    },
    {
      "namespace": "lucky-commit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lucky-commit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lucky-commit",
        "passthrough": true,
        "missingDependencyHelp": "Install lucky-commit"
      },
      "args": []
    }
  ]
}