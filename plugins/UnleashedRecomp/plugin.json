{
  "name": "UnleashedRecomp",
  "version": "0.1.0",
  "description": "An unofficial PC port of the Xbox 360 version of Sonic Unleashed created through the process of stat",
  "source": "https://github.com/UnleashedRecomp/UnleashedRecomp",
  "checks": [
    {
      "type": "binary",
      "name": "unleashedrecomp"
    }
  ],
  "install_guidance": {
    "plugin": "UnleashedRecomp",
    "binary": "unleashedrecomp",
    "check": "which unleashedrecomp",
    "install_steps": [
      "pip install unleashedrecomp",
      "Verify: unleashedrecomp --version",
      "supercli plugins install ./plugins/UnleashedRecomp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "UnleashedRecomp",
      "resource": "self",
      "action": "version",
      "description": "Print UnleashedRecomp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unleashedrecomp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install UnleashedRecomp: pip install unleashedrecomp"
      },
      "args": []
    },
    {
      "namespace": "UnleashedRecomp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unleashedrecomp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unleashedrecomp",
        "passthrough": true,
        "missingDependencyHelp": "Install UnleashedRecomp: pip install unleashedrecomp"
      },
      "args": []
    }
  ]
}