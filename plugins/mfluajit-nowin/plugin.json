{
  "name": "mfluajit-nowin",
  "version": "0.1.0",
  "description": "CLI tool: mfluajit-nowin",
  "source": "https://manpages.debian.org/mfluajit-nowin",
  "checks": [
    {
      "type": "binary",
      "name": "mfluajit-nowin"
    }
  ],
  "install_guidance": {
    "plugin": "mfluajit-nowin",
    "binary": "mfluajit-nowin",
    "check": "which mfluajit-nowin",
    "install_steps": [
      "apt-get install mfluajit-nowin 2>/dev/null || which mfluajit-nowin",
      "Verify: mfluajit-nowin --version",
      "supercli plugins install ./plugins/mfluajit-nowin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mfluajit-nowin",
      "resource": "self",
      "action": "version",
      "description": "Print mfluajit-nowin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mfluajit-nowin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mfluajit-nowin: apt-get install mfluajit-nowin 2>/dev/null || which mfluajit-nowin"
      },
      "args": []
    },
    {
      "namespace": "mfluajit-nowin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mfluajit-nowin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mfluajit-nowin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mfluajit-nowin: apt-get install mfluajit-nowin 2>/dev/null || which mfluajit-nowin"
      },
      "args": []
    }
  ]
}