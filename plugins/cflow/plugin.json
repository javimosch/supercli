{
  "name": "cflow",
  "version": "0.1.0",
  "description": "CLI tool: cflow",
  "source": "https://packages.debian.org/cflow",
  "checks": [{ "type": "binary", "name": "cflow" }],
  "install_guidance": {
    "plugin": "cflow", "binary": "cflow", "check": "which cflow",
    "install_steps": ["apt-get install cflow 2>/dev/null || which cflow", "Verify: cflow --version", "supercli plugins install ./plugins/cflow --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cflow", "resource": "_", "action": "_",
    "description": "Passthrough to cflow CLI",
    "adapter": "process", "adapterConfig": { "command": "cflow", "passthrough": true, "missingDependencyHelp": "Install cflow: apt-get install cflow" }, "args": []
  }]
}
