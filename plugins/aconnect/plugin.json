{
  "name": "aconnect",
  "version": "0.1.0",
  "description": "CLI tool: aconnect",
  "source": "https://packages.debian.org/aconnect",
  "checks": [{ "type": "binary", "name": "aconnect" }],
  "install_guidance": {
    "plugin": "aconnect", "binary": "aconnect", "check": "which aconnect",
    "install_steps": ["apt-get install aconnect 2>/dev/null || which aconnect", "Verify: aconnect --version", "supercli plugins install ./plugins/aconnect --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aconnect", "resource": "_", "action": "_",
    "description": "Passthrough to aconnect CLI",
    "adapter": "process", "adapterConfig": { "command": "aconnect", "passthrough": true, "missingDependencyHelp": "Install aconnect: apt-get install aconnect" }, "args": []
  }]
}
