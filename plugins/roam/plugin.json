{
  "name": "roam",
  "version": "0.1.0",
  "description": "Leave a working agent on a remote box \u2014 dispatch goals to remote agents",
  "source": "https://github.com/javimosch/roam",
  "checks": [
    {
      "type": "binary",
      "name": "roam"
    }
  ],
  "install_guidance": {
    "plugin": "roam",
    "binary": "roam",
    "check": "which roam",
    "install_steps": [
      "Build from source: https://github.com/javimosch/roam",
      "Verify: roam version || roam guide"
    ]
  },
  "commands": [
    {
      "namespace": "roam",
      "resource": "agent",
      "action": "send",
      "description": "Dispatch an agent to a remote host with a goal",
      "adapter": "process",
      "adapterConfig": {
        "command": "roam",
        "baseArgs": [
          "send"
        ],
        "parseJson": true,
        "missingDependencyHelp": "Install roam from https://github.com/javimosch/roam"
      },
      "args": [
        {
          "name": "to",
          "type": "string",
          "required": true,
          "description": "Target host"
        },
        {
          "name": "goal",
          "type": "string",
          "required": true,
          "description": "Goal text (pass LAST)"
        },
        {
          "name": "provider",
          "type": "string",
          "required": false,
          "description": "LLM provider: anthropic|openai|debri"
        },
        {
          "name": "model",
          "type": "string",
          "required": false,
          "description": "Model ID"
        },
        {
          "name": "confirm",
          "type": "boolean",
          "required": false,
          "description": "Require confirmation"
        }
      ]
    }
  ]
}