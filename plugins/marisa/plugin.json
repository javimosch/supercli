{
  "name": "marisa",
  "version": "0.1.0",
  "description": "Matching Algorithm with Recursively Implemented StorAge",
  "source": "https://github.com/s-yata/marisa-trie",
  "checks": [
    {
      "type": "binary",
      "name": "marisa"
    }
  ],
  "install_guidance": {
    "plugin": "marisa",
    "binary": "marisa",
    "check": "which marisa",
    "install_steps": [
      "brew install marisa",
      "Verify: marisa --version",
      "supercli plugins install ./plugins/marisa --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "marisa",
      "resource": "self",
      "action": "version",
      "description": "Print marisa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "marisa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install marisa: brew install marisa"
      },
      "args": []
    },
    {
      "namespace": "marisa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to marisa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "marisa",
        "passthrough": true,
        "missingDependencyHelp": "Install marisa"
      },
      "args": []
    }
  ]
}