{
  "name": "Termux-Desktops",
  "version": "0.1.0",
  "description": "Collection of scripts to launch Desktops with audio in Termux X11 and how to use hardware accelerati",
  "source": "https://github.com/Termux-Desktops/Termux-Desktops",
  "checks": [
    {
      "type": "binary",
      "name": "termux-desktops"
    }
  ],
  "install_guidance": {
    "plugin": "Termux-Desktops",
    "binary": "termux-desktops",
    "check": "which termux-desktops",
    "install_steps": [
      "pip install termux-desktops",
      "Verify: termux-desktops --version",
      "supercli plugins install ./plugins/Termux-Desktops --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Termux-Desktops",
      "resource": "self",
      "action": "version",
      "description": "Print Termux-Desktops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "termux-desktops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Termux-Desktops: pip install termux-desktops"
      },
      "args": []
    },
    {
      "namespace": "Termux-Desktops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to termux-desktops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "termux-desktops",
        "passthrough": true,
        "missingDependencyHelp": "Install Termux-Desktops: pip install termux-desktops"
      },
      "args": []
    }
  ]
}