{
  "name": "at_dump",
  "version": "0.1.0",
  "description": "CLI tool: at_dump",
  "source": "https://packages.debian.org/at_dump",
  "checks": [{ "type": "binary", "name": "at_dump" }],
  "install_guidance": {
    "plugin": "at_dump", "binary": "at_dump", "check": "which at_dump",
    "install_steps": ["apt-get install at_dump 2>/dev/null || which at_dump", "Verify: at_dump --version", "supercli plugins install ./plugins/at_dump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_dump", "resource": "_", "action": "_",
    "description": "Passthrough to at_dump CLI",
    "adapter": "process", "adapterConfig": { "command": "at_dump", "passthrough": true, "missingDependencyHelp": "Install at_dump: apt-get install at_dump" }, "args": []
  }]
}
