{
  "name": "nucleid",
  "version": "0.1.0",
  "description": "Universal npm package cli-wrapper",
  "source": "https://github.com/nucleid/nucleid",
  "checks": [
    {
      "type": "binary",
      "name": "nucleid"
    }
  ],
  "install_guidance": {
    "plugin": "nucleid",
    "binary": "nucleid",
    "check": "which nucleid",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: nucleid --version",
      "supercli plugins install ./plugins/nucleid --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "nucleid",
      "resource": "self",
      "action": "version",
      "description": "Print nucleid version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nucleid",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nucleid from project repository"
      },
      "args": []
    },
    {
      "namespace": "nucleid",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nucleid CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nucleid",
        "passthrough": true,
        "missingDependencyHelp": "Install nucleid from project repository"
      },
      "args": []
    }
  ]
}