{
  "name": "markitdown",
  "version": "0.1.0",
  "description": "Python tool for converting files and office documents to Markdown.",
  "source": "https://github.com/markitdown/markitdown",
  "checks": [
    {
      "type": "binary",
      "name": "markitdown"
    }
  ],
  "install_guidance": {
    "plugin": "markitdown",
    "binary": "markitdown",
    "check": "which markitdown",
    "install_steps": [
      "pip install markitdown",
      "Verify: markitdown --version",
      "supercli plugins install ./plugins/markitdown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "markitdown",
      "resource": "self",
      "action": "version",
      "description": "Print markitdown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "markitdown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install markitdown: pip install markitdown"
      },
      "args": []
    },
    {
      "namespace": "markitdown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to markitdown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "markitdown",
        "passthrough": true,
        "missingDependencyHelp": "Install markitdown: pip install markitdown"
      },
      "args": []
    }
  ]
}