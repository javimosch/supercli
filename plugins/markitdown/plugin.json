{
  "name": "markitdown",
  "version": "0.1.0",
  "description": "Convert files and documents to Markdown",
  "source": "https://github.com/nickelc/markitdown",
  "checks": [
    {
      "type": "binary",
      "name": "markitdown"
    }
  ],
  "install_guidance": {
    "plugin": "markitdown",
    "binary": "markitdown",
    "check": "which markitdown",
    "install_steps": [
      "pip install markitdown",
      "Verify: markitdown --version",
      "supercli plugins install ./plugins/markitdown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "markitdown",
      "resource": "self",
      "action": "version",
      "description": "Print markitdown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "markitdown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install markitdown: pip install markitdown"
      },
      "args": []
    },
    {
      "namespace": "markitdown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to markitdown",
      "adapter": "process",
      "adapterConfig": {
        "command": "markitdown",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install markitdown: pip install markitdown"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
