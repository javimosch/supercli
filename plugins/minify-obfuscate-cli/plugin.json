{
  "name": "minify-obfuscate-cli",
  "version": "0.1.0",
  "description": "A production-ready Python orchestrator for bulk web asset minification and source code protection.",
  "source": "https://leonardosalasd.github.io/minify-obfuscate-cli/",
  "checks": [
    {
      "type": "binary",
      "name": "minify-obfuscate-cli"
    }
  ],
  "install_guidance": {
    "plugin": "minify-obfuscate-cli",
    "binary": "minify-obfuscate-cli",
    "check": "which minify-obfuscate-cli",
    "install_steps": [
      "Check https://leonardosalasd.github.io/minify-obfuscate-cli/ for installation instructions",
      "Verify: minify-obfuscate-cli --version",
      "supercli plugins install ./plugins/minify-obfuscate-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "minify-obfuscate-cli",
      "resource": "self",
      "action": "version",
      "description": "Print minify-obfuscate-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "minify-obfuscate-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install minify-obfuscate-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "minify-obfuscate-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to minify-obfuscate-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "minify-obfuscate-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install minify-obfuscate-cli from project repository"
      },
      "args": []
    }
  ]
}