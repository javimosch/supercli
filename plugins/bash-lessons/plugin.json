{
  "name": "bash-lessons",
  "version": "0.1.0",
  "description": "Practical bash scripting lessons — loops, functions, CLI argument parsing. Each lesson refactors the previous to introduce a new concept.",
  "source": "https://github.com/bash-lessons/bash-lessons",
  "checks": [
    {
      "type": "binary",
      "name": "bash-lessons"
    }
  ],
  "install_guidance": {
    "plugin": "bash-lessons",
    "binary": "bash-lessons",
    "check": "which bash-lessons",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: bash-lessons --version",
      "supercli plugins install ./plugins/bash-lessons --on-conflict replace --json"
    ],
    "note": "Shell language CLI tool"
  },
  "commands": [
    {
      "namespace": "bash-lessons",
      "resource": "self",
      "action": "version",
      "description": "Print bash-lessons version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash-lessons",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bash-lessons from project repository"
      },
      "args": []
    },
    {
      "namespace": "bash-lessons",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bash-lessons CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash-lessons",
        "passthrough": true,
        "missingDependencyHelp": "Install bash-lessons from project repository"
      },
      "args": []
    }
  ]
}