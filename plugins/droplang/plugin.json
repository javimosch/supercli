{
  "name": "droplang",
  "version": "0.1.0",
  "description": "droplang \u2014 \u5220\u9664\u4e00\u79cd PostgreSQL \u8fc7\u7a0b\u8bed\u8a00",
  "source": "https://manpages.debian.org/droplang",
  "checks": [
    {
      "type": "binary",
      "name": "droplang"
    }
  ],
  "install_guidance": {
    "plugin": "droplang",
    "binary": "droplang",
    "check": "which droplang",
    "install_steps": [
      "apt-get install droplang 2>/dev/null || which droplang",
      "Verify: droplang --version",
      "supercli plugins install ./plugins/droplang --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "droplang",
      "resource": "self",
      "action": "version",
      "description": "Print droplang version",
      "adapter": "process",
      "adapterConfig": {
        "command": "droplang",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install droplang: apt-get install droplang 2>/dev/null || which droplang"
      },
      "args": []
    },
    {
      "namespace": "droplang",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to droplang CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "droplang",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install droplang: apt-get install droplang 2>/dev/null || which droplang"
      },
      "args": []
    }
  ]
}