{
  "name": "transcrypt",
  "version": "0.1.0",
  "description": "Transparently encrypt files within a git repository",
  "source": "https://github.com/elasticdog/transcrypt",
  "checks": [{ "type": "binary", "name": "transcrypt" }],
  "install_guidance": {
    "plugin": "transcrypt",
    "binary": "transcrypt",
    "check": "which transcrypt",
    "install_steps": ["brew install transcrypt", "Verify: transcrypt --version", "supercli plugins install ./plugins/transcrypt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "transcrypt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to transcrypt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "transcrypt",
      "passthrough": true,
      "missingDependencyHelp": "Install transcrypt: brew install transcrypt", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
