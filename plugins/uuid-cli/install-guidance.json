{
  "plugin": "uuid-cli",
  "binary": "uuid-cli",
  "check": "which uuid-cli",
  "install_steps": [
    "curl -LO https://github.com/javimosch/uuid-cli/releases/latest/download/uuid-cli-linux-amd64",
    "chmod +x uuid-cli-linux-amd64",
    "sudo mv uuid-cli-linux-amd64 /usr/local/bin/uuid-cli",
    "Verify: uuid-cli"
  ],
  "note": "Go binary from GitHub releases. MIT license. Author: Javier Leandro Arancibia."
}
