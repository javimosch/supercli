{
  "name": "mpif90.openmpi",
  "version": "0.1.0",
  "description": "CLI tool: mpif90.openmpi",
  "source": "https://manpages.debian.org/mpif90.openmpi",
  "checks": [
    {
      "type": "binary",
      "name": "mpif90.openmpi"
    }
  ],
  "install_guidance": {
    "plugin": "mpif90.openmpi",
    "binary": "mpif90.openmpi",
    "check": "which mpif90.openmpi",
    "install_steps": [
      "apt-get install mpif90.openmpi 2>/dev/null || which mpif90.openmpi",
      "Verify: mpif90.openmpi --version",
      "supercli plugins install ./plugins/mpif90.openmpi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpif90.openmpi",
      "resource": "self",
      "action": "version",
      "description": "Print mpif90.openmpi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpif90.openmpi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpif90.openmpi: apt-get install mpif90.openmpi 2>/dev/null || which mpif90.openmpi"
      },
      "args": []
    },
    {
      "namespace": "mpif90.openmpi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpif90.openmpi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpif90.openmpi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mpif90.openmpi: apt-get install mpif90.openmpi 2>/dev/null || which mpif90.openmpi"
      },
      "args": []
    }
  ]
}