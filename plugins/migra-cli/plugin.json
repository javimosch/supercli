{
  "name": "migra-cli",
  "version": "0.1.0",
  "description": "Database migration CLI — rollback, safety checks, SQL templates, multi-database (PostgreSQL, MySQL, SQLite)",
  "source": "https://www.npmjs.com/package/@faizkhairi/migra-cli",
  "checks": [
    {
      "type": "binary",
      "name": "migra-cli"
    }
  ],
  "install_guidance": {
    "plugin": "migra-cli",
    "binary": "migra-cli",
    "check": "which migra-cli",
    "install_steps": [
      "Check https://www.npmjs.com/package/@faizkhairi/migra-cli for installation instructions",
      "Verify: migra-cli --version",
      "supercli plugins install ./plugins/migra-cli --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "migra-cli",
      "resource": "self",
      "action": "version",
      "description": "Print migra-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "migra-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install migra-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "migra-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to migra-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "migra-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install migra-cli from project repository"
      },
      "args": []
    }
  ]
}