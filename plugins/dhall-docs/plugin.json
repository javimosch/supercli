{
  "name": "dhall-docs",
  "version": "0.1.0",
  "description": "CLI tool: dhall-docs",
  "source": "https://packages.debian.org/dhall-docs",
  "checks": [{ "type": "binary", "name": "dhall-docs" }],
  "install_guidance": {
    "plugin": "dhall-docs", "binary": "dhall-docs", "check": "which dhall-docs",
    "install_steps": ["apt-get install dhall-docs 2>/dev/null || which dhall-docs", "Verify: dhall-docs --version", "supercli plugins install ./plugins/dhall-docs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-docs", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-docs CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-docs", "passthrough": true, "missingDependencyHelp": "Install dhall-docs: apt-get install dhall-docs" }, "args": []
  }]
}
