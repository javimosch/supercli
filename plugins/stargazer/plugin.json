{
  "name": "stargazer",
  "version": "0.1.0",
  "description": "GitHub stats from the command line.",
  "source": "https://github.com/gennaro-tedesco/stargazer",
  "checks": [
    {
      "type": "binary",
      "name": "stargazer"
    }
  ],
  "install_guidance": {
    "plugin": "stargazer",
    "binary": "stargazer",
    "check": "which stargazer",
    "install_steps": [
      "See https://github.com/gennaro-tedesco/stargazer",
      "Verify: stargazer --version",
      "supercli plugins install ./plugins/stargazer --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "stargazer",
      "resource": "self",
      "action": "version",
      "description": "Print stargazer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stargazer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install stargazer: See https://github.com/gennaro-tedesco/stargazer"
      },
      "args": []
    },
    {
      "namespace": "stargazer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stargazer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stargazer",
        "passthrough": true,
        "missingDependencyHelp": "Install stargazer"
      },
      "args": []
    }
  ]
}