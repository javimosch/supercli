{
  "name": "browser",
  "version": "0.1.0",
  "description": "Less noise, more browsing.",
  "source": "https://github.com/browser/browser",
  "checks": [
    {
      "type": "binary",
      "name": "browser"
    }
  ],
  "install_guidance": {
    "plugin": "browser",
    "binary": "browser",
    "check": "which browser",
    "install_steps": [
      "pip install browser",
      "Verify: browser --version",
      "supercli plugins install ./plugins/browser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "browser",
      "resource": "self",
      "action": "version",
      "description": "Print browser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "browser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install browser: pip install browser"
      },
      "args": []
    },
    {
      "namespace": "browser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to browser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "browser",
        "passthrough": true,
        "missingDependencyHelp": "Install browser: pip install browser"
      },
      "args": []
    }
  ]
}