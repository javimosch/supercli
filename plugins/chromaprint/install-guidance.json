{
  "plugin": "chromaprint",
  "binary": "chromaprint",
  "check": "which chromaprint",
  "install_steps": [
    "brew install chromaprint",
    "Verify: chromaprint --version",
    "supercli plugins install ./plugins/chromaprint --on-conflict replace --json"
  ],
  "note": "Install from package manager"
}