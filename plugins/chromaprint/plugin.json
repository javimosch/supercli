{
  "name": "chromaprint",
  "version": "0.1.0",
  "description": "Core component of the AcoustID project (Audio fingerprinting)",
  "checks": [
    {
      "type": "binary",
      "name": "chromaprint"
    }
  ],
  "install_guidance": {
    "plugin": "chromaprint",
    "binary": "chromaprint",
    "check": "which chromaprint",
    "install_steps": [
      "brew install chromaprint",
      "Verify: chromaprint --version",
      "supercli plugins install ./plugins/chromaprint --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chromaprint",
      "resource": "self",
      "action": "version",
      "description": "Print chromaprint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chromaprint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chromaprint: brew install chromaprint"
      },
      "args": []
    },
    {
      "namespace": "chromaprint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chromaprint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chromaprint",
        "passthrough": true,
        "missingDependencyHelp": "Install chromaprint"
      },
      "args": []
    }
  ]
}