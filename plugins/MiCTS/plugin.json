{
  "name": "MiCTS",
  "version": "0.1.0",
  "description": "Trigger Circle to Search on any Android 9\u201316 device",
  "source": "https://github.com/MiCTS/MiCTS",
  "checks": [
    {
      "type": "binary",
      "name": "micts"
    }
  ],
  "install_guidance": {
    "plugin": "MiCTS",
    "binary": "micts",
    "check": "which micts",
    "install_steps": [
      "pip install micts",
      "Verify: micts --version",
      "supercli plugins install ./plugins/MiCTS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MiCTS",
      "resource": "self",
      "action": "version",
      "description": "Print MiCTS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "micts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MiCTS: pip install micts"
      },
      "args": []
    },
    {
      "namespace": "MiCTS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to micts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "micts",
        "passthrough": true,
        "missingDependencyHelp": "Install MiCTS: pip install micts"
      },
      "args": []
    }
  ]
}