{
  "name": "pdf_tools",
  "version": "0.1.0",
  "description": "Offline secure toolkit for splitting and compressing PDFs",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "pdf_tools" }],
  "install_guidance": {
    "plugin": "pdf_tools",
    "binary": "pdf_tools",
    "check": "which pdf_tools",
    "install_steps": ["git clone && python3 pdf_tools.py", "Verify: pdf_tools --version", "supercli plugins install ./plugins/pdf_tools --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdf_tools",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdf_tools CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdf_tools",
      "passthrough": true,
      "missingDependencyHelp": "Install pdf_tools: git clone && python3 pdf_tools.py"
    },
    "args": []
  }]
}
