{
  "name": "remarshal",
  "version": "0.1.0",
  "description": "Convert between CBOR, JSON, MessagePack, TOML, and YAML",
  "source": "https://github.com/toml-lang/remarshal",
  "checks": [
    {
      "type": "binary",
      "name": "remarshal"
    }
  ],
  "install_guidance": {
    "plugin": "remarshal",
    "binary": "remarshal",
    "check": "which remarshal",
    "install_steps": [
      "pip install remarshal",
      "Verify: remarshal --version",
      "supercli plugins install ./plugins/remarshal --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "remarshal",
      "resource": "self",
      "action": "version",
      "description": "Print remarshal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "remarshal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install remarshal: pip install remarshal"
      },
      "args": []
    },
    {
      "namespace": "remarshal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to remarshal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "remarshal",
        "passthrough": true,
        "missingDependencyHelp": "Install remarshal: pip install remarshal"
      },
      "args": []
    }
  ]
}
