{
  "name": "lalrpop",
  "version": "0.1.0",
  "description": "LALRPOP — LR parser generator for Rust",
  "source": "https://github.com/lalrpop/lalrpop",
  "checks": [
    {
      "type": "binary",
      "name": "lalrpop"
    }
  ],
  "install_guidance": {
    "plugin": "lalrpop",
    "binary": "lalrpop",
    "check": "which lalrpop",
    "install_steps": [
      "cargo install lalrpop",
      "Verify: lalrpop --version",
      "supercli plugins install ./plugins/lalrpop --on-conflict replace --json"
    ],
    "note": "`cargo install lalrpop` builds the `lalrpop` codegen binary; the library is added with `cargo add lalrpop`."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lalrpop",
      "resource": "self",
      "action": "version",
      "description": "Print lalrpop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lalrpop",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install lalrpop: cargo install lalrpop"
      },
      "args": []
    },
    {
      "namespace": "lalrpop",
      "resource": "cli",
      "action": "run",
      "description": "LALRPOP — LR parser generator for Rust",
      "adapter": "process",
      "adapterConfig": {
        "command": "lalrpop",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install lalrpop: cargo install lalrpop"
      },
      "args": []
    }
  ]
}
