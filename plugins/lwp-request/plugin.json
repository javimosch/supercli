{
  "name": "lwp-request",
  "version": "0.1.0",
  "description": "CLI tool: lwp-request",
  "source": "https://manpages.debian.org/lwp-request",
  "checks": [
    {
      "type": "binary",
      "name": "lwp-request"
    }
  ],
  "install_guidance": {
    "plugin": "lwp-request",
    "binary": "lwp-request",
    "check": "which lwp-request",
    "install_steps": [
      "apt-get install lwp-request 2>/dev/null || which lwp-request",
      "Verify: lwp-request --version",
      "supercli plugins install ./plugins/lwp-request --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lwp-request",
      "resource": "self",
      "action": "version",
      "description": "Print lwp-request version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lwp-request",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lwp-request: apt-get install lwp-request 2>/dev/null || which lwp-request"
      },
      "args": []
    },
    {
      "namespace": "lwp-request",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lwp-request CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lwp-request",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lwp-request: apt-get install lwp-request 2>/dev/null || which lwp-request"
      },
      "args": []
    }
  ]
}