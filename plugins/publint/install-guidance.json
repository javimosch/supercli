{
  "plugin": "publint",
  "binary": "publint",
  "check": "which publint",
  "install_steps": [
    "npm install -g publint",
    "Verify: publint --version",
    "supercli plugins install ./plugins/publint --on-conflict replace --json"
  ],
  "note": "No global install needed — `npx publint` works too. Requires Node.js 18+."
}
