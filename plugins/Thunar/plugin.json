{
  "name": "Thunar",
  "version": "0.1.0",
  "description": "CLI tool: Thunar",
  "source": "https://manpages.debian.org/Thunar",
  "checks": [
    {
      "type": "binary",
      "name": "Thunar"
    }
  ],
  "install_guidance": {
    "plugin": "Thunar",
    "binary": "Thunar",
    "check": "which Thunar",
    "install_steps": [
      "apt-get install Thunar 2>/dev/null || which Thunar",
      "Verify: Thunar --version",
      "supercli plugins install ./plugins/Thunar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Thunar",
      "resource": "self",
      "action": "version",
      "description": "Print Thunar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Thunar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Thunar: apt-get install Thunar 2>/dev/null || which Thunar"
      },
      "args": []
    },
    {
      "namespace": "Thunar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Thunar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Thunar",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install Thunar: apt-get install Thunar 2>/dev/null || which Thunar"
      },
      "args": []
    }
  ]
}