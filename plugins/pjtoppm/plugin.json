{
  "name": "pjtoppm",
  "version": "0.1.0",
  "description": "CLI tool: pjtoppm",
  "source": "https://manpages.debian.org/pjtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "pjtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "pjtoppm",
    "binary": "pjtoppm",
    "check": "which pjtoppm",
    "install_steps": [
      "apt-get install pjtoppm 2>/dev/null || which pjtoppm",
      "Verify: pjtoppm --version",
      "supercli plugins install ./plugins/pjtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pjtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print pjtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pjtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pjtoppm: apt-get install pjtoppm 2>/dev/null || which pjtoppm"
      },
      "args": []
    },
    {
      "namespace": "pjtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pjtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pjtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pjtoppm: apt-get install pjtoppm 2>/dev/null || which pjtoppm"
      },
      "args": []
    }
  ]
}