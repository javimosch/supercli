{
  "name": "MinerU",
  "version": "0.1.0",
  "description": "Transforms complex documents like PDFs and Office docs into LLM-ready markdown/JSON for your Agentic",
  "source": "https://github.com/MinerU/MinerU",
  "checks": [
    {
      "type": "binary",
      "name": "mineru"
    }
  ],
  "install_guidance": {
    "plugin": "MinerU",
    "binary": "mineru",
    "check": "which mineru",
    "install_steps": [
      "pip install mineru",
      "Verify: mineru --version",
      "supercli plugins install ./plugins/MinerU --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MinerU",
      "resource": "self",
      "action": "version",
      "description": "Print MinerU version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mineru",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MinerU: pip install mineru"
      },
      "args": []
    },
    {
      "namespace": "MinerU",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mineru CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mineru",
        "passthrough": true,
        "missingDependencyHelp": "Install MinerU: pip install mineru"
      },
      "args": []
    }
  ]
}