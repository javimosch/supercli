{
  "name": "Android-Native-Root-Detector",
  "version": "0.1.0",
  "description": "A tool to detect root on android",
  "source": "https://github.com/Android-Native-Root-Detector/Android-Native-Root-Detector",
  "checks": [
    {
      "type": "binary",
      "name": "android-native-root-detector"
    }
  ],
  "install_guidance": {
    "plugin": "Android-Native-Root-Detector",
    "binary": "android-native-root-detector",
    "check": "which android-native-root-detector",
    "install_steps": [
      "pip install android-native-root-detector",
      "Verify: android-native-root-detector --version",
      "supercli plugins install ./plugins/Android-Native-Root-Detector --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Android-Native-Root-Detector",
      "resource": "self",
      "action": "version",
      "description": "Print Android-Native-Root-Detector version",
      "adapter": "process",
      "adapterConfig": {
        "command": "android-native-root-detector",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Android-Native-Root-Detector: pip install android-native-root-detector"
      },
      "args": []
    },
    {
      "namespace": "Android-Native-Root-Detector",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to android-native-root-detector CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "android-native-root-detector",
        "passthrough": true,
        "missingDependencyHelp": "Install Android-Native-Root-Detector: pip install android-native-root-detector"
      },
      "args": []
    }
  ]
}