{
  "name": "pam-timestamp-check",
  "version": "1.0.0",
  "description": "pam-timestamp-check \u2014 pam_timestamp_check \u2014 CLI utility",
  "source": "/usr/sbin/pam_timestamp_check",
  "checks": [
    {
      "type": "binary",
      "name": "pam_timestamp_check"
    }
  ],
  "install_guidance": {
    "plugin": "pam-timestamp-check",
    "binary": "pam_timestamp_check",
    "check": "which pam_timestamp_check",
    "install_steps": [
      "# Install pam-timestamp-check:",
      "# apt: sudo apt-get install pam-timestamp-check",
      "# brew: brew install pam-timestamp-check",
      "# cargo: cargo install pam-timestamp-check",
      "# npm: npm install -g pam-timestamp-check",
      "# pip: pip install pam-timestamp-check",
      "# or download from /usr/sbin/pam_timestamp_check"
    ]
  },
  "commands": [
    {
      "namespace": "pam",
      "resource": "check",
      "action": "run",
      "description": "Run pam-timestamp-check",
      "adapter": "process",
      "adapterConfig": {
        "command": "pam_timestamp_check",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pam-timestamp-check from /usr/sbin/pam_timestamp_check"
      },
      "args": []
    }
  ]
}