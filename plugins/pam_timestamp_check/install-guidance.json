{
  "plugin": "pam_timestamp_check",
  "binary": "pam_timestamp_check",
  "check": "which pam_timestamp_check",
  "install_steps": [
    "# Install pam_timestamp_check",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pam_timestamp_check-linux-amd64 -o /usr/local/bin/pam_timestamp_check",
    "chmod +x /usr/local/bin/pam_timestamp_check",
    "# Or via package manager, see /usr/sbin/pam_timestamp_check"
  ]
}