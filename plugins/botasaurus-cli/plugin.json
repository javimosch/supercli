{
  "name": "botasaurus-cli",
  "version": "0.1.0",
  "description": "Web scraping CLI — Cloudflare bypass, anti-detect, JSON output. Wraps Botasaurus (4.7k ⭐)",
  "source": "https://github.com/javimosch/botasaurus-cli",
  "checks": [
    { "type": "binary", "name": "botasaurus-cli" }
  ],
  "install_guidance": {
    "plugin": "botasaurus-cli",
    "binary": "botasaurus-cli",
    "check": "which botasaurus-cli",
    "install_steps": [
      "pip install botasaurus",
      "pip install botasaurus-cli",
      "Verify: botasaurus-cli --help",
      "supercli plugins install ./plugins/botasaurus-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "botasaurus-cli",
      "resource": "self",
      "action": "version",
      "description": "Print botasaurus-cli info",
      "adapter": "process",
      "adapterConfig": {
        "command": "botasaurus-cli",
        "baseArgs": ["info"],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install: pip install botasaurus && pip install botasaurus-cli"
      },
      "args": []
    },
    {
      "namespace": "botasaurus-cli",
      "resource": "web",
      "action": "scrape",
      "description": "Scrape a URL with Cloudflare bypass",
      "adapter": "process",
      "adapterConfig": {
        "command": "botasaurus-cli",
        "baseArgs": ["scrape"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install: pip install botasaurus && pip install botasaurus-cli"
      },
      "args": []
    },
    {
      "namespace": "botasaurus-cli",
      "resource": "web",
      "action": "check",
      "description": "Check if a URL is accessible",
      "adapter": "process",
      "adapterConfig": {
        "command": "botasaurus-cli",
        "baseArgs": ["check"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install: pip install botasaurus && pip install botasaurus-cli"
      },
      "args": []
    },
    {
      "namespace": "botasaurus-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to botasaurus-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "botasaurus-cli",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install: pip install botasaurus && pip install botasaurus-cli"
      },
      "args": []
    }
  ]
}
