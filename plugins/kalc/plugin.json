{
  "name": "kalc",
  "version": "0.1.0",
  "description": "Complex numbers/graphing calculator in Rust",
  "source": "https://github.com/nicholasgasior/kalc",
  "checks": [{"type": "binary", "name": "kalc"}],
  "install_guidance": {
    "plugin": "kalc",
    "binary": "kalc",
    "check": "which kalc",
    "install_steps": [
      "cargo install kalc",
      "Verify: kalc --version",
      "supercli plugins install ./kalc --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "kalc",
      "resource": "self",
      "action": "version",
      "description": "Print kalc version",
      "adapter": "process",
      "adapterConfig": {"command": "kalc", "baseArgs": ["--version"], "missingDependencyHelp": "Install kalc: cargo install kalc"},
      "args": []
    },
    {
      "namespace": "kalc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kalc CLI",
      "adapter": "process",
      "adapterConfig": {"command": "kalc", "passthrough": true, "missingDependencyHelp": "Install kalc: cargo install kalc"},
      "args": []
    }
  ]
}
