{
  "name": "load-tester",
  "version": "0.1.0",
  "description": "Lightweight HTTP load testing tool for performance",
  "source": "https://github.com/load-tester/cli",
  "checks": [{ "type": "binary", "name": "load-tester" }],
  "install_guidance": {
    "plugin": "load-tester",
    "binary": "load-tester",
    "check": "which load-tester",
    "install_steps": ["go install github.com/load-tester/cli@latest", "Verify: load-tester --version", "supercli plugins install ./plugins/load-tester --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "load-tester",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to load-tester CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "load-tester",
      "passthrough": true,
      "missingDependencyHelp": "Install load-tester: go install github.com/load-tester/cli@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
