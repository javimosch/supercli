{
  "name": "HybridFileXfer",
  "version": "0.1.0",
  "description": "\u591a\u8f68\u5feb\u4f20\uff0c\u540c\u65f6\u4f7f\u7528USB\u548c5G\u4e0e2.4GWIFI\u7b49\u901a\u9053\u4f20\u8f93\u6587\u4ef6\u5230\u7535\u8111\uff0c\u69a8\u5e72\u624b\u673aIO\uff01",
  "source": "https://github.com/HybridFileXfer/HybridFileXfer",
  "checks": [
    {
      "type": "binary",
      "name": "hybridfilexfer"
    }
  ],
  "install_guidance": {
    "plugin": "HybridFileXfer",
    "binary": "hybridfilexfer",
    "check": "which hybridfilexfer",
    "install_steps": [
      "pip install hybridfilexfer",
      "Verify: hybridfilexfer --version",
      "supercli plugins install ./plugins/HybridFileXfer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "HybridFileXfer",
      "resource": "self",
      "action": "version",
      "description": "Print HybridFileXfer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hybridfilexfer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install HybridFileXfer: pip install hybridfilexfer"
      },
      "args": []
    },
    {
      "namespace": "HybridFileXfer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hybridfilexfer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hybridfilexfer",
        "passthrough": true,
        "missingDependencyHelp": "Install HybridFileXfer: pip install hybridfilexfer"
      },
      "args": []
    }
  ]
}