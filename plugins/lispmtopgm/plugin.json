{
  "name": "lispmtopgm",
  "version": "0.1.0",
  "description": "lispmtopgm \u2014 convert a Lisp Machine bitmap file to PGM",
  "source": "https://manpages.debian.org/lispmtopgm",
  "checks": [
    {
      "type": "binary",
      "name": "lispmtopgm"
    }
  ],
  "install_guidance": {
    "plugin": "lispmtopgm",
    "binary": "lispmtopgm",
    "check": "which lispmtopgm",
    "install_steps": [
      "apt-get install lispmtopgm 2>/dev/null || which lispmtopgm",
      "Verify: lispmtopgm --version",
      "supercli plugins install ./plugins/lispmtopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lispmtopgm",
      "resource": "self",
      "action": "version",
      "description": "Print lispmtopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lispmtopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lispmtopgm: apt-get install lispmtopgm 2>/dev/null || which lispmtopgm"
      },
      "args": []
    },
    {
      "namespace": "lispmtopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lispmtopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lispmtopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lispmtopgm: apt-get install lispmtopgm 2>/dev/null || which lispmtopgm"
      },
      "args": []
    }
  ]
}