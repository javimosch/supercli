{
  "name": "brltty-ctb",
  "version": "0.1.0",
  "description": "CLI tool: brltty-ctb",
  "source": "https://packages.debian.org/brltty-ctb",
  "checks": [{ "type": "binary", "name": "brltty-ctb" }],
  "install_guidance": {
    "plugin": "brltty-ctb", "binary": "brltty-ctb", "check": "which brltty-ctb",
    "install_steps": ["apt-get install brltty-ctb 2>/dev/null || which brltty-ctb", "Verify: brltty-ctb --version", "supercli plugins install ./plugins/brltty-ctb --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "brltty-ctb", "resource": "_", "action": "_",
    "description": "Passthrough to brltty-ctb CLI",
    "adapter": "process", "adapterConfig": { "command": "brltty-ctb", "passthrough": true, "missingDependencyHelp": "Install brltty-ctb: apt-get install brltty-ctb" }, "args": []
  }]
}
