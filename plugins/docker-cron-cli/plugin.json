{
  "name": "docker-cron-cli",
  "version": "0.1.0",
  "description": "Automatically scan /etc/cron.d in specific docker containers and output it to stdout",
  "source": "https://github.com/docker-cron-cli/docker-cron-cli",
  "checks": [
    {
      "type": "binary",
      "name": "docker-cron-cli"
    }
  ],
  "install_guidance": {
    "plugin": "docker-cron-cli",
    "binary": "docker-cron-cli",
    "check": "which docker-cron-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: docker-cron-cli --version",
      "supercli plugins install ./plugins/docker-cron-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "docker-cron-cli",
      "resource": "self",
      "action": "version",
      "description": "Print docker-cron-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-cron-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-cron-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "docker-cron-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-cron-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-cron-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-cron-cli from project repository"
      },
      "args": []
    }
  ]
}