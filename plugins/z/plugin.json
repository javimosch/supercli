{
  "name": "z",
  "version": "0.1.0",
  "description": "z is the new j, yo",
  "source": "https://github.com/rupa/z",
  "checks": [
    {
      "type": "binary",
      "name": "z"
    }
  ],
  "install_guidance": {
    "plugin": "z",
    "binary": "z",
    "check": "which z",
    "install_steps": [
      "brew install z",
      "Verify: z --version",
      "supercli plugins install ./plugins/z --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "z",
      "resource": "self",
      "action": "version",
      "description": "Print z version",
      "adapter": "process",
      "adapterConfig": {
        "command": "z",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install z: brew install z"
      },
      "args": []
    },
    {
      "namespace": "z",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to z CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "z",
        "passthrough": true,
        "missingDependencyHelp": "Install z"
      },
      "args": []
    }
  ]
}