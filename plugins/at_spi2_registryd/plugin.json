{
  "name": "at_spi2_registryd",
  "version": "0.1.0",
  "description": "CLI tool: at_spi2_registryd",
  "source": "https://packages.debian.org/at_spi2_registryd",
  "checks": [{ "type": "binary", "name": "at_spi2_registryd" }],
  "install_guidance": {
    "plugin": "at_spi2_registryd", "binary": "at_spi2_registryd", "check": "which at_spi2_registryd",
    "install_steps": ["apt-get install at_spi2_registryd 2>/dev/null || which at_spi2_registryd", "Verify: at_spi2_registryd --version", "supercli plugins install ./plugins/at_spi2_registryd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_spi2_registryd", "resource": "_", "action": "_",
    "description": "Passthrough to at_spi2_registryd CLI",
    "adapter": "process", "adapterConfig": { "command": "at_spi2_registryd", "passthrough": true, "missingDependencyHelp": "Install at_spi2_registryd: apt-get install at_spi2_registryd" }, "args": []
  }]
}
