{
  "name": "qml1plugindump",
  "version": "0.1.0",
  "description": "CLI tool: qml1plugindump",
  "source": "https://manpages.debian.org/qml1plugindump",
  "checks": [
    {
      "type": "binary",
      "name": "qml1plugindump"
    }
  ],
  "install_guidance": {
    "plugin": "qml1plugindump",
    "binary": "qml1plugindump",
    "check": "which qml1plugindump",
    "install_steps": [
      "apt-get install qml1plugindump 2>/dev/null || which qml1plugindump",
