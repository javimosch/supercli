      "supercli plugins install ./plugins/qml1plugindump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qml1plugindump",
      "resource": "self",
      "action": "version",
      "description": "Print qml1plugindump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qml1plugindump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qml1plugindump: apt-get install qml1plugindump 2>/dev/null || which qml1plugindump"
      },
      "args": []
    },
    {
      "namespace": "qml1plugindump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qml1plugindump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qml1plugindump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qml1plugindump: apt-get install qml1plugindump 2>/dev/null || which qml1plugindump"
      },
      "args": []
    }
  ]
}