{
  "name": "jdupes",
  "version": "1.0.0",
  "description": "jdupes — Duplicate file finder (fast)",
  "source": "https://github.com/jbruchon/jdupes",
  "checks": [
    {
      "type": "binary",
      "name": "jdupes"
    }
  ],
  "install_guidance": {
    "plugin": "jdupes",
    "binary": "jdupes",
    "check": "which jdupes",
    "install_steps": [
      "# Install jdupes:",
      "# apt: sudo apt-get install jdupes",
      "# brew: brew install jdupes",
      "# cargo: cargo install jdupes",
      "# npm: npm install -g jdupes",
      "# pip: pip install jdupes",
      "# or download from github.com/jbruchon/jdupes"
    ]
  },
  "commands": [
    {
      "namespace": "jdupes",
      "resource": "jdupes",
      "action": "run",
      "description": "Run jdupes",
      "adapter": "process",
      "adapterConfig": {
        "command": "jdupes",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install jdupes from github.com/jbruchon/jdupes"
      },
      "args": []
    }
  ]
}
