{
  "name": "on_ac_power",
  "version": "0.1.0",
  "description": "CLI tool: on_ac_power",
  "source": "https://manpages.debian.org/on_ac_power",
  "checks": [
    {
      "type": "binary",
      "name": "on_ac_power"
    }
  ],
  "install_guidance": {
    "plugin": "on_ac_power",
    "binary": "on_ac_power",
    "check": "which on_ac_power",
    "install_steps": [
      "apt-get install on_ac_power 2>/dev/null || which on_ac_power",
      "Verify: on_ac_power --version",
      "supercli plugins install ./plugins/on_ac_power --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "on_ac_power",
      "resource": "self",
      "action": "version",
      "description": "Print on_ac_power version",
      "adapter": "process",
      "adapterConfig": {
        "command": "on_ac_power",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install on_ac_power: apt-get install on_ac_power 2>/dev/null || which on_ac_power"
      },
      "args": []
    },
    {
      "namespace": "on_ac_power",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to on_ac_power CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "on_ac_power",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install on_ac_power: apt-get install on_ac_power 2>/dev/null || which on_ac_power"
      },
      "args": []
    }
  ]
}