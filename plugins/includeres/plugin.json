{
  "name": "includeres",
  "version": "0.1.0",
  "description": "CLI tool: includeres",
  "source": "https://manpages.debian.org/includeres",
  "checks": [
    {
      "type": "binary",
      "name": "includeres"
    }
  ],
  "install_guidance": {
    "plugin": "includeres",
    "binary": "includeres",
    "check": "which includeres",
    "install_steps": [
      "apt-get install includeres 2>/dev/null || which includeres",
      "Verify: includeres --version",
      "supercli plugins install ./plugins/includeres --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "includeres",
      "resource": "self",
      "action": "version",
      "description": "Print includeres version",
      "adapter": "process",
      "adapterConfig": {
        "command": "includeres",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install includeres: apt-get install includeres 2>/dev/null || which includeres"
      },
      "args": []
    },
    {
      "namespace": "includeres",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to includeres CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "includeres",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install includeres: apt-get install includeres 2>/dev/null || which includeres"
      },
      "args": []
    }
  ]
}