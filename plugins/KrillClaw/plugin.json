{
  "name": "KrillClaw",
  "version": "0.1.0",
  "description": "The world's smallest AI agent runtime. 49KB. Written in Zig. Zero dependencies.",
  "source": "https://github.com/KrillClaw/KrillClaw",
  "checks": [
    {
      "type": "binary",
      "name": "krillclaw"
    }
  ],
  "install_guidance": {
    "plugin": "KrillClaw",
    "binary": "krillclaw",
    "check": "which krillclaw",
    "install_steps": [
      "pip install krillclaw",
      "Verify: krillclaw --version",
      "supercli plugins install ./plugins/KrillClaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "KrillClaw",
      "resource": "self",
      "action": "version",
      "description": "Print KrillClaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "krillclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install KrillClaw: pip install krillclaw"
      },
      "args": []
    },
    {
      "namespace": "KrillClaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to krillclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "krillclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install KrillClaw: pip install krillclaw"
      },
      "args": []
    }
  ]
}