{
  "name": "pyrsa-keygen",
  "version": "0.1.0",
  "description": "CLI tool: pyrsa-keygen",
  "source": "https://manpages.debian.org/pyrsa-keygen",
  "checks": [
    {
      "type": "binary",
      "name": "pyrsa-keygen"
    }
  ],
  "install_guidance": {
    "plugin": "pyrsa-keygen",
    "binary": "pyrsa-keygen",
    "check": "which pyrsa-keygen",
    "install_steps": [
      "apt-get install pyrsa-keygen 2>/dev/null || which pyrsa-keygen",
      "Verify: pyrsa-keygen --version",
      "supercli plugins install ./plugins/pyrsa-keygen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyrsa-keygen",
      "resource": "self",
      "action": "version",
      "description": "Print pyrsa-keygen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrsa-keygen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyrsa-keygen: apt-get install pyrsa-keygen 2>/dev/null || which pyrsa-keygen"
      },
      "args": []
    },
    {
      "namespace": "pyrsa-keygen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyrsa-keygen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrsa-keygen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrsa-keygen: apt-get install pyrsa-keygen 2>/dev/null || which pyrsa-keygen"
      },
      "args": []
    }
  ]
}