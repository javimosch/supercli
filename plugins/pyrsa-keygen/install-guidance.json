{
  "plugin": "pyrsa-keygen",
  "binary": "pyrsa-keygen",
  "check": "which pyrsa-keygen",
  "install_steps": [
    "apt-get install pyrsa-keygen 2>/dev/null || which pyrsa-keygen",
    "Verify: pyrsa-keygen --version",
    "supercli plugins install ./plugins/pyrsa-keygen --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}