{
  "name": "gtk+3",
  "version": "0.1.0",
  "description": "Toolkit for creating graphical user interfaces",
  "checks": [
    {
      "type": "binary",
      "name": "gtk+3"
    }
  ],
  "install_guidance": {
    "plugin": "gtk+3",
    "binary": "gtk+3",
    "check": "which gtk+3",
    "install_steps": [
      "brew install gtk+3",
      "Verify: gtk+3 --version",
      "supercli plugins install ./plugins/gtk+3 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gtk+3",
      "resource": "self",
      "action": "version",
      "description": "Print gtk+3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtk+3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtk+3: brew install gtk+3"
      },
      "args": []
    },
    {
      "namespace": "gtk+3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtk+3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtk+3",
        "passthrough": true,
        "missingDependencyHelp": "Install gtk+3"
      },
      "args": []
    }
  ]
}