{
  "plugin": "sensible-pager",
  "binary": "sensible-pager",
  "check": "which sensible-pager",
  "install_steps": [
    "apt-get install sensible-pager 2>/dev/null || which sensible-pager",
    "Verify: sensible-pager --version",
    "supercli plugins install ./plugins/sensible-pager --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}