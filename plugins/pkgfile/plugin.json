{
  "name": "pkgfile",
  "version": "1.0.0",
  "description": "pkgfile \u2014 Which package owns a file",
  "source": "github.com/falconindy/pkgfile",
  "checks": [
    {
      "type": "binary",
      "name": "pkgfile"
    }
  ],
  "install_guidance": {
    "plugin": "pkgfile",
    "binary": "pkgfile",
    "check": "which pkgfile",
    "install_steps": [
      "# Install pkgfile:",
      "# apt: sudo apt-get install pkgfile",
      "# brew: brew install pkgfile",
      "# cargo: cargo install pkgfile",
      "# npm: npm install -g pkgfile",
      "# pip: pip install pkgfile",
      "# or download from github.com/falconindy/pkgfile"
    ]
  },
  "commands": [
    {
      "namespace": "pkgfile",
      "resource": "pkgfile",
      "action": "run",
      "description": "Run pkgfile",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkgfile",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pkgfile from github.com/falconindy/pkgfile"
      },
      "args": []
    }
  ]
}