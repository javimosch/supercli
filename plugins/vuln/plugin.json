{
  "name": "vuln",
  "version": "0.1.0",
  "description": "Container vulnerability scanner",
  "source": "https://packages.debian.org/vuln",
  "checks": [{ "type": "binary", "name": "vuln" }],
  "install_guidance": {
    "plugin": "vuln", "binary": "vuln", "check": "which vuln",
    "install_steps": ["apt-get install vuln", "Verify: vuln --version", "supercli plugins install ./plugins/vuln --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vuln", "resource": "_", "action": "_",
    "description": "Passthrough to vuln CLI",
    "adapter": "process", "adapterConfig": { "command": "vuln", "passthrough": true, "missingDependencyHelp": "Install vuln: apt-get install vuln" }, "args": []
  }]
}
