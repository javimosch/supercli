{
  "name": "pkgx",
  "version": "0.1.0",
  "description": "pkgx CLI plugin — run any open-source package from over 20,000+ packages without installing globally. Automatic ephemeral environments per directory.",
  "source": "https://docs.pkgx.sh",
  "checks": [
    { "type": "binary", "name": "pkgx" }
  ],
  "install_guidance": {
    "plugin": "pkgx",
    "binary": "pkgx",
    "check": "which pkgx",
    "install_steps": [
      "npm install -g pkgx",
      "Verify: pkgx --version",
      "supercli plugins install ./plugins/pkgx --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "pkgx",
      "resource": "pkg",
      "action": "fetch",
      "description": "Fetch/download a package into local cache",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkgx",
        "baseArgs": ["fetch"],
        "positionalArgs": ["package"],
        "missingDependencyHelp": "Install pkgx: npm install -g pkgx"
      },
      "args": [
        { "name": "package", "type": "string", "required": true, "description": "Package name to fetch" }
      ]
    },
    {
      "namespace": "pkgx",
      "resource": "pkg",
      "action": "deep",
      "description": "Deep search/inspect a package name",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkgx",
        "baseArgs": ["deep"],
        "positionalArgs": ["packageName"],
        "missingDependencyHelp": "Install pkgx: npm install -g pkgx"
      },
      "args": [
        { "name": "packageName", "type": "string", "description": "Package name to search for" }
      ]
    },
    {
      "namespace": "pkgx",
      "resource": "serve",
      "action": "start",
      "description": "Serve the current directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkgx",
        "baseArgs": ["serve"],
        "positionalArgs": ["servePath"],
        "missingDependencyHelp": "Install pkgx: npm install -g pkgx"
      },
      "args": [
        { "name": "servePath", "type": "string", "description": "Path to serve (defaults to current dir)" }
      ]
    },
    {
      "namespace": "pkgx",
      "resource": "self",
      "action": "version",
      "description": "Show pkgx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkgx",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install pkgx: npm install -g pkgx"
      },
      "args": []
    },
    {
      "namespace": "pkgx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pkgx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkgx",
        "passthrough": true,
        "missingDependencyHelp": "Install pkgx: npm install -g pkgx"
      },
      "args": []
    }
  ]
}
