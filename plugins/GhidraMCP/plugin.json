{
  "name": "GhidraMCP",
  "version": "0.1.0",
  "description": "MCP Server for Ghidra",
  "source": "https://github.com/GhidraMCP/GhidraMCP",
  "checks": [
    {
      "type": "binary",
      "name": "ghidramcp"
    }
  ],
  "install_guidance": {
    "plugin": "GhidraMCP",
    "binary": "ghidramcp",
    "check": "which ghidramcp",
    "install_steps": [
      "pip install ghidramcp",
      "Verify: ghidramcp --version",
      "supercli plugins install ./plugins/GhidraMCP --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GhidraMCP",
      "resource": "self",
      "action": "version",
      "description": "Print GhidraMCP version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghidramcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GhidraMCP: pip install ghidramcp"
      },
      "args": []
    },
    {
      "namespace": "GhidraMCP",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghidramcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghidramcp",
        "passthrough": true,
        "missingDependencyHelp": "Install GhidraMCP: pip install ghidramcp"
      },
      "args": []
    }
  ]
}