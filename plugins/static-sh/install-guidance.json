{
  "plugin": "static-sh",
  "binary": "static-sh",
  "check": "which static-sh",
  "install_steps": [
    "apt-get install static-sh 2>/dev/null || which static-sh",
    "Verify: static-sh --version",
    "supercli plugins install ./plugins/static-sh --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}