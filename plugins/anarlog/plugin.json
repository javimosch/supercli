{
  "name": "anarlog",
  "version": "0.1.0",
  "description": "Open source Granola AI Alternative",
  "source": "https://github.com/anarlog/anarlog",
  "checks": [
    {
      "type": "binary",
      "name": "anarlog"
    }
  ],
  "install_guidance": {
    "plugin": "anarlog",
    "binary": "anarlog",
    "check": "which anarlog",
    "install_steps": [
      "pip install anarlog",
      "Verify: anarlog --version",
      "supercli plugins install ./plugins/anarlog --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "anarlog",
      "resource": "self",
      "action": "version",
      "description": "Print anarlog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "anarlog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install anarlog: pip install anarlog"
      },
      "args": []
    },
    {
      "namespace": "anarlog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to anarlog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "anarlog",
        "passthrough": true,
        "missingDependencyHelp": "Install anarlog: pip install anarlog"
      },
      "args": []
    }
  ]
}