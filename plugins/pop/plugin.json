{
  "name": "pop",
  "version": "0.1.0",
  "description": "Send emails from the terminal with Markdown formatting",
  "source": "https://github.com/charmbracelet/pop",
  "checks": [{ "type": "binary", "name": "pop" }],
  "install_guidance": {
    "plugin": "pop",
    "binary": "pop",
    "check": "which pop",
    "install_steps": ["brew install pop", "Verify: pop --version", "supercli plugins install ./plugins/pop --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pop",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pop CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pop",
      "passthrough": true,
      "missingDependencyHelp": "Install pop: brew install pop"
    },
    "args": []
  }]
}
