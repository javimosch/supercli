{
  "name": "kind",
  "version": "0.1.0",
  "description": "Kubernetes IN Docker — local K8s clusters",
  "source": "https",
  "checks": [{"type": "binary", "name": "kind"}],
  "install_guidance": {
    "plugin": "kind",
    "binary": "kind",
    "check": "which kind",
    "install_steps": [
      "brew install kind",
      "Verify: kind --version",
      "supercli plugins install ./plugins/kind --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "kind",
      "resource": "self",
      "action": "version",
      "description": "Print kind version",
      "adapter": "process",
      "adapterConfig": {"command": "kind", "baseArgs": ["--version"], "missingDependencyHelp": "Install kind: brew install kind"},
      "args": []
    },
    {
      "namespace": "kind",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kind CLI",
      "adapter": "process",
      "adapterConfig": {"command": "kind", "passthrough": true, "missingDependencyHelp": "Install kind: brew install kind"},
      "args": []
    }
  ]
}
