{
  "name": "clconf",
  "version": "0.1.0",
  "description": "Merge multiple YAML and JSON config files via path patterns",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "clconf" }],
  "install_guidance": {
    "plugin": "clconf",
    "binary": "clconf",
    "check": "which clconf",
    "install_steps": ["go install github.com/clconf@latest", "Verify: clconf --version", "supercli plugins install ./plugins/clconf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clconf",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clconf CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clconf",
      "passthrough": true,
      "missingDependencyHelp": "Install clconf: go install github.com/clconf@latest"
    },
    "args": []
  }]
}
