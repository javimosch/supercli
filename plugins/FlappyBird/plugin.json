{
  "name": "FlappyBird",
  "version": "0.1.0",
  "description": "Less than 100 Kilobytes. Works for Android 5.0 and above",
  "source": "https://github.com/FlappyBird/FlappyBird",
  "checks": [
    {
      "type": "binary",
      "name": "flappybird"
    }
  ],
  "install_guidance": {
    "plugin": "FlappyBird",
    "binary": "flappybird",
    "check": "which flappybird",
    "install_steps": [
      "pip install flappybird",
      "Verify: flappybird --version",
      "supercli plugins install ./plugins/FlappyBird --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FlappyBird",
      "resource": "self",
      "action": "version",
      "description": "Print FlappyBird version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flappybird",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FlappyBird: pip install flappybird"
      },
      "args": []
    },
    {
      "namespace": "FlappyBird",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flappybird CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flappybird",
        "passthrough": true,
        "missingDependencyHelp": "Install FlappyBird: pip install flappybird"
      },
      "args": []
    }
  ]
}