{
  "name": "cffi",
  "version": "0.1.0",
  "description": "C Foreign Function Interface for Python",
  "checks": [
    {
      "type": "binary",
      "name": "cffi"
    }
  ],
  "install_guidance": {
    "plugin": "cffi",
    "binary": "cffi",
    "check": "which cffi",
    "install_steps": [
      "brew install cffi",
      "Verify: cffi --version",
      "supercli plugins install ./plugins/cffi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cffi",
      "resource": "self",
      "action": "version",
      "description": "Print cffi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cffi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cffi: brew install cffi"
      },
      "args": []
    },
    {
      "namespace": "cffi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cffi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cffi",
        "passthrough": true,
        "missingDependencyHelp": "Install cffi"
      },
      "args": []
    }
  ]
}