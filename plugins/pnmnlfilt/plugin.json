{
  "name": "pnmnlfilt",
  "version": "0.1.0",
  "description": "CLI tool: pnmnlfilt",
  "source": "https://manpages.debian.org/pnmnlfilt",
  "checks": [
    {
      "type": "binary",
      "name": "pnmnlfilt"
    }
  ],
  "install_guidance": {
    "plugin": "pnmnlfilt",
    "binary": "pnmnlfilt",
    "check": "which pnmnlfilt",
    "install_steps": [
      "apt-get install pnmnlfilt 2>/dev/null || which pnmnlfilt",
      "Verify: pnmnlfilt --version",
      "supercli plugins install ./plugins/pnmnlfilt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmnlfilt",
      "resource": "self",
      "action": "version",
      "description": "Print pnmnlfilt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmnlfilt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmnlfilt: apt-get install pnmnlfilt 2>/dev/null || which pnmnlfilt"
      },
      "args": []
    },
    {
      "namespace": "pnmnlfilt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmnlfilt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmnlfilt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmnlfilt: apt-get install pnmnlfilt 2>/dev/null || which pnmnlfilt"
      },
      "args": []
    }
  ]
}