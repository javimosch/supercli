{
  "name": "dependency-check",
  "version": "0.1.0",
  "description": "OWASP dependency-check",
  "checks": [
    {
      "type": "binary",
      "name": "dependency-check"
    }
  ],
  "install_guidance": {
    "plugin": "dependency-check",
    "binary": "dependency-check",
    "check": "which dependency-check",
    "install_steps": [
      "brew install dependency-check",
      "Verify: dependency-check --version",
      "supercli plugins install ./plugins/dependency-check --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dependency-check",
      "resource": "self",
      "action": "version",
      "description": "Print dependency-check version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dependency-check",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dependency-check: brew install dependency-check"
      },
      "args": []
    },
    {
      "namespace": "dependency-check",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dependency-check CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dependency-check",
        "passthrough": true,
        "missingDependencyHelp": "Install dependency-check"
      },
      "args": []
    }
  ]
}