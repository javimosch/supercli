{
  "name": "gtasks",
  "version": "0.1.0",
  "description": "Manage Google Tasks",
  "source": "https://github.com/BRO3886/gtasks",
  "checks": [
    {
      "type": "binary",
      "name": "gtasks"
    }
  ],
  "install_guidance": {
    "plugin": "gtasks",
    "binary": "gtasks",
    "check": "which gtasks",
    "install_steps": [
      "See https://github.com/BRO3886/gtasks",
      "Verify: gtasks --version",
      "supercli plugins install ./plugins/gtasks --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gtasks",
      "resource": "self",
      "action": "version",
      "description": "Print gtasks version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtasks",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtasks: See https://github.com/BRO3886/gtasks"
      },
      "args": []
    },
    {
      "namespace": "gtasks",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtasks CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtasks",
        "passthrough": true,
        "missingDependencyHelp": "Install gtasks"
      },
      "args": []
    }
  ]
}