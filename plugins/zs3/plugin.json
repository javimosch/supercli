{
  "name": "zs3",
  "version": "0.1.0",
  "description": "S3-compatible storage in Zig. Zero dependencies.",
  "source": "https://github.com/zs3/zs3",
  "checks": [
    {
      "type": "binary",
      "name": "zs3"
    }
  ],
  "install_guidance": {
    "plugin": "zs3",
    "binary": "zs3",
    "check": "which zs3",
    "install_steps": [
      "pip install zs3",
      "Verify: zs3 --version",
      "supercli plugins install ./plugins/zs3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zs3",
      "resource": "self",
      "action": "version",
      "description": "Print zs3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zs3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zs3: pip install zs3"
      },
      "args": []
    },
    {
      "namespace": "zs3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zs3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zs3",
        "passthrough": true,
        "missingDependencyHelp": "Install zs3: pip install zs3"
      },
      "args": []
    }
  ]
}