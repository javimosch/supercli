{
  "name": "m365_comp",
  "version": "0.1.0",
  "description": "CLI tool: m365_comp",
  "source": "https://manpages.debian.org/m365_comp",
  "checks": [
    {
      "type": "binary",
      "name": "m365_comp"
    }
  ],
  "install_guidance": {
    "plugin": "m365_comp",
    "binary": "m365_comp",
    "check": "which m365_comp",
    "install_steps": [
      "apt-get install m365_comp 2>/dev/null || which m365_comp",
      "Verify: m365_comp --version",
      "supercli plugins install ./plugins/m365_comp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "m365_comp",
      "resource": "self",
      "action": "version",
      "description": "Print m365_comp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "m365_comp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install m365_comp: apt-get install m365_comp 2>/dev/null || which m365_comp"
      },
      "args": []
    },
    {
      "namespace": "m365_comp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to m365_comp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "m365_comp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install m365_comp: apt-get install m365_comp 2>/dev/null || which m365_comp"
      },
      "args": []
    }
  ]
}