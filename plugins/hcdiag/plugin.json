{
  "name": "hcdiag",
  "version": "0.1.0",
  "description": "HashiCorp product diagnostic tool for gathering debug information",
  "source": "https://github.com/hashicorp/hcdiag",
  "checks": [{ "type": "binary", "name": "hcdiag" }],
  "install_guidance": {
    "plugin": "hcdiag",
    "binary": "hcdiag",
    "check": "which hcdiag",
    "install_steps": ["brew install hcdiag", "Verify: hcdiag --version", "supercli plugins install ./plugins/hcdiag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hcdiag",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hcdiag CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hcdiag",
      "passthrough": true,
      "missingDependencyHelp": "Install hcdiag: brew install hcdiag"
    },
    "args": []
  }]
}
