{
  "plugin": "pyrsa-sign",
  "binary": "pyrsa-sign",
  "check": "which pyrsa-sign",
  "install_steps": [
    "apt-get install pyrsa-sign 2>/dev/null || which pyrsa-sign",
    "Verify: pyrsa-sign --version",
    "supercli plugins install ./plugins/pyrsa-sign --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}