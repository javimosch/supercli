{
  "name": "livekit-cli",
  "version": "0.1.0",
  "description": "Command-line interface to LiveKit",
  "checks": [
    {
      "type": "binary",
      "name": "livekit-cli"
    }
  ],
  "install_guidance": {
    "plugin": "livekit-cli",
    "binary": "livekit-cli",
    "check": "which livekit-cli",
    "install_steps": [
      "brew install livekit-cli",
      "Verify: livekit-cli --version",
      "supercli plugins install ./plugins/livekit-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "livekit-cli",
      "resource": "self",
      "action": "version",
      "description": "Print livekit-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "livekit-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install livekit-cli: brew install livekit-cli"
      },
      "args": []
    },
    {
      "namespace": "livekit-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to livekit-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "livekit-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install livekit-cli"
      },
      "args": []
    }
  ]
}