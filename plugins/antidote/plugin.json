{
  "name": "antidote",
  "version": "0.1.0",
  "description": "Plugin manager for zsh, inspired by antigen and antibody",
  "checks": [
    {
      "type": "binary",
      "name": "antidote"
    }
  ],
  "install_guidance": {
    "plugin": "antidote",
    "binary": "antidote",
    "check": "which antidote",
    "install_steps": [
      "brew install antidote",
      "Verify: antidote --version",
      "supercli plugins install ./plugins/antidote --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "antidote",
      "resource": "self",
      "action": "version",
      "description": "Print antidote version",
      "adapter": "process",
      "adapterConfig": {
        "command": "antidote",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install antidote: brew install antidote"
      },
      "args": []
    },
    {
      "namespace": "antidote",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to antidote CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "antidote",
        "passthrough": true,
        "missingDependencyHelp": "Install antidote"
      },
      "args": []
    }
  ]
}