{
  "name": "avahi-browse",
  "version": "0.1.0",
  "description": "Browse mDNS/DNS-SD services",
  "source": "https://packages.debian.org/avahi-browse",
  "checks": [{ "type": "binary", "name": "avahi-browse" }],
  "install_guidance": {
    "plugin": "avahi-browse", "binary": "avahi-browse", "check": "which avahi-browse",
    "install_steps": ["apt-get install avahi-utils", "Verify: avahi-browse --version", "supercli plugins install ./plugins/avahi-browse --on-conflict replace --json"]
