    "description": "Passthrough to avahi-browse CLI",
    "adapter": "process", "adapterConfig": { "command": "avahi-browse", "passthrough": true, "missingDependencyHelp": "Install avahi-browse: apt-get install avahi-utils" }, "args": []
  }]
}
