{
  "name": "diffx",
  "version": "0.1.0",
  "description": "Semantic diff for structured data (JSON, YAML, TOML)",
  "source": "https://github.com/void-rilla/diffx",
  "checks": [
    {
      "type": "binary",
      "name": "diffx"
    }
  ],
  "install_guidance": {
    "plugin": "diffx",
    "binary": "diffx",
    "check": "which diffx",
    "install_steps": [
      "cargo install diffx",
      "Verify: diffx --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "diffx",
      "resource": "self",
      "action": "version",
      "description": "Print diffx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffx",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install diffx: cargo install diffx"
      },
      "args": []
    },
    {
      "namespace": "diffx",
      "resource": "file",
      "action": "diff",
      "description": "Semantic diff between two structured data files (JSON, YAML, TOML)",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffx",
        "baseArgs": ["--cwd", "invoke_cwd"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install diffx: cargo install diffx"
      },
      "args": []
    },
    {
      "namespace": "diffx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to diffx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffx",
        "passthrough": true,
        "missingDependencyHelp": "Install diffx: cargo install diffx"
      },
      "args": []
    }
  ]
}