{
  "name": "gvfs-save",
  "version": "0.1.0",
  "description": "CLI tool: gvfs-save",
  "source": "https://manpages.debian.org/gvfs-save",
  "checks": [
    {
      "type": "binary",
      "name": "gvfs-save"
    }
  ],
  "install_guidance": {
    "plugin": "gvfs-save",
    "binary": "gvfs-save",
    "check": "which gvfs-save",
    "install_steps": [
      "apt-get install gvfs-save 2>/dev/null || which gvfs-save",
      "Verify: gvfs-save --version",
      "supercli plugins install ./plugins/gvfs-save --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gvfs-save",
      "resource": "self",
      "action": "version",
      "description": "Print gvfs-save version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvfs-save",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gvfs-save: apt-get install gvfs-save 2>/dev/null || which gvfs-save"
      },
      "args": []
    },
    {
      "namespace": "gvfs-save",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gvfs-save CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvfs-save",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gvfs-save: apt-get install gvfs-save 2>/dev/null || which gvfs-save"
      },
      "args": []
    }
  ]
}