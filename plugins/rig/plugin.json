{
  "name": "rig",
  "version": "0.1.0",
  "description": "Random identity generator (name, address, etc.)",
  "source": "https",
  "checks": [{"type": "binary", "name": "rig"}],
  "install_guidance": {
    "plugin": "rig",
    "binary": "rig",
    "check": "which rig",
    "install_steps": [
      "brew install rig",
      "Verify: rig --version",
      "supercli plugins install ./plugins/rig --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "rig",
      "resource": "self",
      "action": "version",
      "description": "Print rig version",
      "adapter": "process",
      "adapterConfig": {"command": "rig", "baseArgs": ["--version"], "missingDependencyHelp": "Install rig: brew install rig"},
      "args": []
    },
    {
      "namespace": "rig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rig CLI",
      "adapter": "process",
      "adapterConfig": {"command": "rig", "passthrough": true, "missingDependencyHelp": "Install rig: brew install rig"},
      "args": []
    }
  ]
}
