{
  "name": "9arm-skills",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/9arm-skills/9arm-skills",
  "checks": [
    {
      "type": "binary",
      "name": "9arm-skills"
    }
  ],
  "install_guidance": {
    "plugin": "9arm-skills",
    "binary": "9arm-skills",
    "check": "which 9arm-skills",
    "install_steps": [
      "pip install 9arm-skills",
      "Verify: 9arm-skills --version",
      "supercli plugins install ./plugins/9arm-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "9arm-skills",
      "resource": "self",
      "action": "version",
      "description": "Print 9arm-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "9arm-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install 9arm-skills: pip install 9arm-skills"
      },
      "args": []
    },
    {
      "namespace": "9arm-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to 9arm-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "9arm-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install 9arm-skills: pip install 9arm-skills"
      },
      "args": []
    }
  ]
}