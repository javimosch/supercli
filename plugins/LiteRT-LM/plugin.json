{
  "name": "LiteRT-LM",
  "version": "0.1.0",
  "description": "LiteRT-LM is Google's production-ready, high-performance, open-source inference framework for deploy",
  "source": "https://github.com/LiteRT-LM/LiteRT-LM",
  "checks": [
    {
      "type": "binary",
      "name": "litert-lm"
    }
  ],
  "install_guidance": {
    "plugin": "LiteRT-LM",
    "binary": "litert-lm",
    "check": "which litert-lm",
    "install_steps": [
      "pip install litert-lm",
      "Verify: litert-lm --version",
      "supercli plugins install ./plugins/LiteRT-LM --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LiteRT-LM",
      "resource": "self",
      "action": "version",
      "description": "Print LiteRT-LM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "litert-lm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LiteRT-LM: pip install litert-lm"
      },
      "args": []
    },
    {
      "namespace": "LiteRT-LM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to litert-lm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "litert-lm",
        "passthrough": true,
        "missingDependencyHelp": "Install LiteRT-LM: pip install litert-lm"
      },
      "args": []
    }
  ]
}