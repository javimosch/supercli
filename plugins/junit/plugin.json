{
  "name": "junit",
  "version": "1.0.0",
  "description": "junit \u2014 Java testing framework",
  "source": "junit.org",
  "checks": [
    {
      "type": "binary",
      "name": "junit"
    }
  ],
  "install_guidance": {
    "plugin": "junit",
    "binary": "junit",
    "check": "which junit",
    "install_steps": [
      "# Install junit",
      "# See junit.org",
      "# apt: sudo apt-get install junit",
      "# brew: brew install junit",
      "# cargo: cargo install junit",
      "# npm: npm install -g junit",
      "# pip: pip install junit"
    ]
  },
  "commands": [
    {
      "namespace": "junit",
      "resource": "junit",
      "action": "run",
      "description": "Run junit",
      "adapter": "process",
      "adapterConfig": {
        "command": "junit",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install junit from junit.org"
      },
      "args": []
    }
  ]
}