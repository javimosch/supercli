{
  "name": "bib.awk",
  "version": "0.1.0",
  "description": "Bibliography manager written in awk.",
  "source": "https://github.com/huijunchen9260/bib.awk",
  "checks": [
    {
      "type": "binary",
      "name": "bib.awk"
    }
  ],
  "install_guidance": {
    "plugin": "bib.awk",
    "binary": "bib.awk",
    "check": "which bib.awk",
    "install_steps": [
      "See https://github.com/huijunchen9260/bib.awk",
      "Verify: bib.awk --version",
      "supercli plugins install ./plugins/bib.awk --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "bib.awk",
      "resource": "self",
      "action": "version",
      "description": "Print bib.awk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bib.awk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bib.awk: See https://github.com/huijunchen9260/bib.awk"
      },
      "args": []
    },
    {
      "namespace": "bib.awk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bib.awk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bib.awk",
        "passthrough": true,
        "missingDependencyHelp": "Install bib.awk"
      },
      "args": []
    }
  ]
}