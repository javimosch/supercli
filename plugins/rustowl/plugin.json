{
  "name": "rustowl",
  "version": "0.1.0",
  "description": "Visualize Ownership and Lifetimes in Rust",
  "source": "https://github.com/rustowl/rustowl",
  "checks": [
    {
      "type": "binary",
      "name": "rustowl"
    }
  ],
  "install_guidance": {
    "plugin": "rustowl",
    "binary": "rustowl",
    "check": "which rustowl",
    "install_steps": [
      "pip install rustowl",
      "Verify: rustowl --version",
      "supercli plugins install ./plugins/rustowl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rustowl",
      "resource": "self",
      "action": "version",
      "description": "Print rustowl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rustowl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rustowl: pip install rustowl"
      },
      "args": []
    },
    {
      "namespace": "rustowl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rustowl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rustowl",
        "passthrough": true,
        "missingDependencyHelp": "Install rustowl: pip install rustowl"
      },
      "args": []
    }
  ]
}