{
  "name": "kristos",
  "version": "0.1.0",
  "description": "A minimal OS implemented following \"Operating system in 1000 lines of code\"",
  "source": "https://github.com/kristos/kristos",
  "checks": [
    {
      "type": "binary",
      "name": "kristos"
    }
  ],
  "install_guidance": {
    "plugin": "kristos",
    "binary": "kristos",
    "check": "which kristos",
    "install_steps": [
      "pip install kristos",
      "Verify: kristos --version",
      "supercli plugins install ./plugins/kristos --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kristos",
      "resource": "self",
      "action": "version",
      "description": "Print kristos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kristos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kristos: pip install kristos"
      },
      "args": []
    },
    {
      "namespace": "kristos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kristos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kristos",
        "passthrough": true,
        "missingDependencyHelp": "Install kristos: pip install kristos"
      },
      "args": []
    }
  ]
}