{
  "name": "Gitea",
  "version": "0.1.0",
  "description": "Single binary self-hosted Git service.",
  "source": "https://github.com/go-gitea/gitea",
  "checks": [
    {
      "type": "binary",
      "name": "Gitea"
    }
  ],
  "install_guidance": {
    "plugin": "Gitea",
    "binary": "Gitea",
    "check": "which Gitea",
    "install_steps": [
      "brew install Gitea",
      "Verify: Gitea --version",
      "supercli plugins install ./plugins/Gitea --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Gitea",
      "resource": "self",
      "action": "version",
      "description": "Print Gitea version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Gitea",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Gitea: brew install Gitea"
      },
      "args": []
    },
    {
      "namespace": "Gitea",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Gitea CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Gitea",
        "passthrough": true,
        "missingDependencyHelp": "Install Gitea"
      },
      "args": []
    }
  ]
}