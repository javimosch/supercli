{
  "name": "dpv",
  "version": "0.1.0",
  "description": "Stream data with inline progress and ETA display",
  "source": "https://github.com/gabor-boros/dpv",
  "checks": [{ "type": "binary", "name": "dpv" }],
  "install_guidance": {
    "plugin": "dpv",
    "binary": "dpv",
    "check": "which dpv",
    "install_steps": ["cargo install dpv", "Verify: dpv --version", "supercli plugins install ./plugins/dpv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dpv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dpv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dpv",
      "passthrough": true,
      "missingDependencyHelp": "Install dpv: cargo install dpv", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
