{
  "name": "dps",
  "version": "1.0.0",
  "description": "dps \u2014 Docker ps wrapper",
  "source": "github.com/jonhadfield/dps",
  "checks": [
    {
      "type": "binary",
      "name": "dps"
    }
  ],
  "install_guidance": {
    "plugin": "dps",
    "binary": "dps",
    "check": "which dps",
    "install_steps": [
      "# Install dps",
      "# See github.com/jonhadfield/dps",
      "# apt: sudo apt-get install dps",
      "# brew: brew install dps",
      "# cargo: cargo install dps",
      "# npm: npm install -g dps",
      "# pip: pip install dps"
    ]
  },
  "commands": [
    {
      "namespace": "dps",
      "resource": "dps",
      "action": "run",
      "description": "Run dps",
      "adapter": "process",
      "adapterConfig": {
        "command": "dps",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dps from github.com/jonhadfield/dps"
      },
      "args": []
    }
  ]
}