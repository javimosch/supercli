{
  "name": "claude-octopus",
  "version": "0.1.0",
  "description": "Surface AI blindspots before you ship. Put up to 8 AI models on every research, design or coding tas",
  "source": "https://github.com/claude-octopus/claude-octopus",
  "checks": [
    {
      "type": "binary",
      "name": "claude-octopus"
    }
  ],
  "install_guidance": {
    "plugin": "claude-octopus",
    "binary": "claude-octopus",
    "check": "which claude-octopus",
    "install_steps": [
      "pip install claude-octopus",
      "Verify: claude-octopus --version",
      "supercli plugins install ./plugins/claude-octopus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-octopus",
      "resource": "self",
      "action": "version",
      "description": "Print claude-octopus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-octopus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-octopus: pip install claude-octopus"
      },
      "args": []
    },
    {
      "namespace": "claude-octopus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-octopus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-octopus",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-octopus: pip install claude-octopus"
      },
      "args": []
    }
  ]
}