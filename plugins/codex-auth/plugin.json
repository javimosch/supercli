{
  "name": "codex-auth",
  "version": "0.1.0",
  "description": "A CLI tool to switch and manage Codex accounts",
  "source": "https://github.com/codex-auth/codex-auth",
  "checks": [
    {
      "type": "binary",
      "name": "codex-auth"
    }
  ],
  "install_guidance": {
    "plugin": "codex-auth",
    "binary": "codex-auth",
    "check": "which codex-auth",
    "install_steps": [
      "pip install codex-auth",
      "Verify: codex-auth --version",
      "supercli plugins install ./plugins/codex-auth --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "codex-auth",
      "resource": "self",
      "action": "version",
      "description": "Print codex-auth version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codex-auth",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install codex-auth: pip install codex-auth"
      },
      "args": []
    },
    {
      "namespace": "codex-auth",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codex-auth CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codex-auth",
        "passthrough": true,
        "missingDependencyHelp": "Install codex-auth: pip install codex-auth"
      },
      "args": []
    }
  ]
}