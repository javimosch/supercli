{
  "name": "phar5.6",
  "version": "0.1.0",
  "description": "CLI tool: phar5.6",
  "source": "https://manpages.debian.org/phar5.6",
  "checks": [
    {
      "type": "binary",
      "name": "phar5.6"
    }
  ],
  "install_guidance": {
    "plugin": "phar5.6",
    "binary": "phar5.6",
    "check": "which phar5.6",
    "install_steps": [
      "apt-get install phar5.6 2>/dev/null || which phar5.6",
      "Verify: phar5.6 --version",
      "supercli plugins install ./plugins/phar5.6 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "phar5.6",
      "resource": "self",
      "action": "version",
      "description": "Print phar5.6 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "phar5.6",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install phar5.6: apt-get install phar5.6 2>/dev/null || which phar5.6"
      },
      "args": []
    },
    {
      "namespace": "phar5.6",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to phar5.6 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "phar5.6",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install phar5.6: apt-get install phar5.6 2>/dev/null || which phar5.6"
      },
      "args": []
    }
  ]
}