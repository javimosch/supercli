{
  "name": "DockDoor",
  "version": "0.1.0",
  "description": "Window peeking, alt-tab and other enhancements for macOS",
  "source": "https://github.com/DockDoor/DockDoor",
  "checks": [
    {
      "type": "binary",
      "name": "dockdoor"
    }
  ],
  "install_guidance": {
    "plugin": "DockDoor",
    "binary": "dockdoor",
    "check": "which dockdoor",
    "install_steps": [
      "pip install dockdoor",
      "Verify: dockdoor --version",
      "supercli plugins install ./plugins/DockDoor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DockDoor",
      "resource": "self",
      "action": "version",
      "description": "Print DockDoor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockdoor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DockDoor: pip install dockdoor"
      },
      "args": []
    },
    {
      "namespace": "DockDoor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dockdoor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockdoor",
        "passthrough": true,
        "missingDependencyHelp": "Install DockDoor: pip install dockdoor"
      },
      "args": []
    }
  ]
}