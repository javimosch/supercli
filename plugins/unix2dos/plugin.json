{
  "name": "unix2dos",
  "version": "0.1.0",
  "description": "Convert Unix line endings to DOS",
  "source": "https://github.com/coffebar/dos2unix",
  "checks": [
    {
      "type": "binary",
      "name": "unix2dos"
    }
  ],
  "install_guidance": {
    "plugin": "unix2dos",
    "binary": "unix2dos",
    "check": "which unix2dos",
    "install_steps": [
      "brew install dos2unix",
      "Verify: unix2dos --version",
      "supercli plugins install ./plugins/unix2dos --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "unix2dos",
      "resource": "self",
      "action": "version",
      "description": "Print unix2dos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unix2dos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unix2dos: brew install dos2unix"
      },
      "args": []
    },
    {
      "namespace": "unix2dos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unix2dos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unix2dos",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unix2dos: brew install dos2unix"
      },
      "args": []
    }
  ]
}
