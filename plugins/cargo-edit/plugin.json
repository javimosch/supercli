{
  "name": "cargo-edit",
  "version": "0.1.0",
  "description": "cargo-edit — Cargo extension for adding and removing crate dependencies",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-edit"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-edit",
    "binary": "cargo-edit",
    "check": "which cargo-edit",
    "install_steps": [
      "cargo install cargo-edit",
      "Verify: cargo-edit --version",
      "supercli plugins install ./plugins/cargo-edit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo-edit",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-edit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-edit"
      },
      "args": []
    }
  ]
}
