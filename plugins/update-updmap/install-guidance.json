{
  "plugin": "update-updmap",
  "binary": "update-updmap",
  "check": "which update-updmap",
  "install_steps": [
    "apt-get install update-updmap 2>/dev/null || which update-updmap",
    "Verify: update-updmap --version",
    "supercli plugins install ./plugins/update-updmap --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}