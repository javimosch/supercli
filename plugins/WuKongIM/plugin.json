{
  "name": "WuKongIM",
  "version": "0.1.0",
  "description": "More than just IM \u4e0d\u53ea\u662f\u5373\u65f6\u901a\u8baf(IM)",
  "source": "https://github.com/WuKongIM/WuKongIM",
  "checks": [
    {
      "type": "binary",
      "name": "wukongim"
    }
  ],
  "install_guidance": {
    "plugin": "WuKongIM",
    "binary": "wukongim",
    "check": "which wukongim",
    "install_steps": [
      "pip install wukongim",
      "Verify: wukongim --version",
      "supercli plugins install ./plugins/WuKongIM --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "WuKongIM",
      "resource": "self",
      "action": "version",
      "description": "Print WuKongIM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wukongim",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install WuKongIM: pip install wukongim"
      },
      "args": []
    },
    {
      "namespace": "WuKongIM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wukongim CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wukongim",
        "passthrough": true,
        "missingDependencyHelp": "Install WuKongIM: pip install wukongim"
      },
      "args": []
    }
  ]
}