{
  "name": "dhex",
  "version": "1.0.0",
  "description": "dhex \u2014 Hex editor",
  "source": "github.com/dancrossnyc/dhex",
  "checks": [
    {
      "type": "binary",
      "name": "dhex"
    }
  ],
  "install_guidance": {
    "plugin": "dhex",
    "binary": "dhex",
    "check": "which dhex",
    "install_steps": [
      "# Install dhex",
      "# See github.com/dancrossnyc/dhex",
      "# apt: sudo apt-get install dhex",
      "# brew: brew install dhex",
      "# cargo: cargo install dhex",
      "# npm: npm install -g dhex",
      "# pip: pip install dhex"
    ]
  },
  "commands": [
    {
      "namespace": "dhex",
      "resource": "dhex",
      "action": "run",
      "description": "Run dhex",
      "adapter": "process",
      "adapterConfig": {
        "command": "dhex",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dhex from github.com/dancrossnyc/dhex"
      },
      "args": []
    }
  ]
}