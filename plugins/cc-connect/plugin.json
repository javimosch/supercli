{
  "name": "cc-connect",
  "version": "0.1.0",
  "description": "Bridge local AI coding agents (Claude Code, Cursor, Gemini CLI, Codex) to messaging platforms (Feish",
  "source": "https://github.com/cc-connect/cc-connect",
  "checks": [
    {
      "type": "binary",
      "name": "cc-connect"
    }
  ],
  "install_guidance": {
    "plugin": "cc-connect",
    "binary": "cc-connect",
    "check": "which cc-connect",
    "install_steps": [
      "pip install cc-connect",
      "Verify: cc-connect --version",
      "supercli plugins install ./plugins/cc-connect --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cc-connect",
      "resource": "self",
      "action": "version",
      "description": "Print cc-connect version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cc-connect",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cc-connect: pip install cc-connect"
      },
      "args": []
    },
    {
      "namespace": "cc-connect",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cc-connect CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cc-connect",
        "passthrough": true,
        "missingDependencyHelp": "Install cc-connect: pip install cc-connect"
      },
      "args": []
    }
  ]
}