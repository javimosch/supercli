{
  "name": "pageres-cli",
  "version": "0.1.0",
  "description": "Capture website screenshots from CLI in JavaScript",
  "source": "https://github.com/nicedoc/pageres-cli",
  "checks": [
    {
      "type": "binary",
      "name": "pageres"
    }
  ],
  "install_guidance": {
    "plugin": "pageres-cli",
    "binary": "pageres",
    "check": "which pageres",
    "install_steps": [
      "npm install -g pageres-cli",
      "Verify: pageres --version",
      "supercli plugins install ./plugins/pageres-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pageres-cli",
      "resource": "self",
      "action": "version",
      "description": "Print pageres-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pageres",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pageres-cli: npm install -g pageres-cli"
      },
      "args": []
    },
    {
      "namespace": "pageres-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pageres-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pageres",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pageres-cli: npm install -g pageres-cli"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
