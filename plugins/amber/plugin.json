{
  "name": "amber",
  "version": "0.1.0",
  "description": "Code search / replace tool.",
  "source": "https://github.com/dalance/amber",
  "checks": [
    {
      "type": "binary",
      "name": "amber"
    }
  ],
  "install_guidance": {
    "plugin": "amber",
    "binary": "amber",
    "check": "which amber",
    "install_steps": [
      "cargo install amber",
      "Verify: amber --version",
      "supercli plugins install ./plugins/amber --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "amber",
      "resource": "self",
      "action": "version",
      "description": "Print amber version",
      "adapter": "process",
      "adapterConfig": {
        "command": "amber",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install amber: cargo install amber"
      },
      "args": []
    },
    {
      "namespace": "amber",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to amber CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "amber",
        "passthrough": true,
        "missingDependencyHelp": "Install amber"
      },
      "args": []
    }
  ]
}