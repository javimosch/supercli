{
  "name": "USBArmyKnife",
  "version": "0.1.0",
  "description": "USB Army Knife \u2013 the ultimate close access tool for penetration testers and red teamers.",
  "source": "https://github.com/USBArmyKnife/USBArmyKnife",
  "checks": [
    {
      "type": "binary",
      "name": "usbarmyknife"
    }
  ],
  "install_guidance": {
    "plugin": "USBArmyKnife",
    "binary": "usbarmyknife",
    "check": "which usbarmyknife",
    "install_steps": [
      "pip install usbarmyknife",
      "Verify: usbarmyknife --version",
      "supercli plugins install ./plugins/USBArmyKnife --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "USBArmyKnife",
      "resource": "self",
      "action": "version",
      "description": "Print USBArmyKnife version",
      "adapter": "process",
      "adapterConfig": {
        "command": "usbarmyknife",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install USBArmyKnife: pip install usbarmyknife"
      },
      "args": []
    },
    {
      "namespace": "USBArmyKnife",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to usbarmyknife CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "usbarmyknife",
        "passthrough": true,
        "missingDependencyHelp": "Install USBArmyKnife: pip install usbarmyknife"
      },
      "args": []
    }
  ]
}