{
  "name": "apm-bash-completion",
  "version": "0.1.0",
  "description": "Completion for Atom Package Manager",
  "source": "https://github.com/vigo/apm-bash-completion",
  "checks": [
    {
      "type": "binary",
      "name": "apm-bash-completion"
    }
  ],
  "install_guidance": {
    "plugin": "apm-bash-completion",
    "binary": "apm-bash-completion",
    "check": "which apm-bash-completion",
    "install_steps": [
      "brew install apm-bash-completion",
      "Verify: apm-bash-completion --version",
      "supercli plugins install ./plugins/apm-bash-completion --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "apm-bash-completion",
      "resource": "self",
      "action": "version",
      "description": "Print apm-bash-completion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "apm-bash-completion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install apm-bash-completion: brew install apm-bash-completion"
      },
      "args": []
    },
    {
      "namespace": "apm-bash-completion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to apm-bash-completion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "apm-bash-completion",
        "passthrough": true,
        "missingDependencyHelp": "Install apm-bash-completion"
      },
      "args": []
    }
  ]
}