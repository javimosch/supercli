{
  "name": "st4topgm",
  "version": "0.1.0",
  "description": "CLI tool: st4topgm",
  "source": "https://manpages.debian.org/st4topgm",
  "checks": [
    {
      "type": "binary",
      "name": "st4topgm"
    }
  ],
  "install_guidance": {
    "plugin": "st4topgm",
    "binary": "st4topgm",
    "check": "which st4topgm",
    "install_steps": [
      "apt-get install st4topgm 2>/dev/null || which st4topgm",
      "Verify: st4topgm --version",
      "supercli plugins install ./plugins/st4topgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "st4topgm",
      "resource": "self",
      "action": "version",
      "description": "Print st4topgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "st4topgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install st4topgm: apt-get install st4topgm 2>/dev/null || which st4topgm"
      },
      "args": []
    },
    {
      "namespace": "st4topgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to st4topgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "st4topgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install st4topgm: apt-get install st4topgm 2>/dev/null || which st4topgm"
      },
      "args": []
    }
  ]
}