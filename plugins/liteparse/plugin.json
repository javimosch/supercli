{
  "name": "liteparse",
  "version": "0.1.0",
  "description": "A fast, helpful, and open-source document parser",
  "source": "https://github.com/liteparse/liteparse",
  "checks": [
    {
      "type": "binary",
      "name": "liteparse"
    }
  ],
  "install_guidance": {
    "plugin": "liteparse",
    "binary": "liteparse",
    "check": "which liteparse",
    "install_steps": [
      "pip install liteparse",
      "Verify: liteparse --version",
      "supercli plugins install ./plugins/liteparse --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "liteparse",
      "resource": "self",
      "action": "version",
      "description": "Print liteparse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "liteparse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install liteparse: pip install liteparse"
      },
      "args": []
    },
    {
      "namespace": "liteparse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to liteparse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "liteparse",
        "passthrough": true,
        "missingDependencyHelp": "Install liteparse: pip install liteparse"
      },
      "args": []
    }
  ]
}