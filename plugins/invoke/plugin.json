{
  "name": "invoke",
  "version": "1.0.0",
  "description": "invoke \u2014 Python task runner",
  "source": "pyinvoke.org",
  "checks": [
    {
      "type": "binary",
      "name": "invoke"
    }
  ],
  "install_guidance": {
    "plugin": "invoke",
    "binary": "invoke",
    "check": "which invoke",
    "install_steps": [
      "# Install invoke:",
      "# apt: sudo apt-get install invoke",
      "# brew: brew install invoke",
      "# cargo: cargo install invoke",
      "# npm: npm install -g invoke",
      "# pip: pip install invoke",
      "# or download from pyinvoke.org"
    ]
  },
  "commands": [
    {
      "namespace": "invoke",
      "resource": "invoke",
      "action": "run",
      "description": "Run invoke",
      "adapter": "process",
      "adapterConfig": {
        "command": "invoke",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install invoke from pyinvoke.org"
      },
      "args": []
    }
  ]
}