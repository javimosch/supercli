{
  "name": "doc8",
  "version": "0.1.0",
  "description": "Style checker for Sphinx documentation",
  "source": "https://github.com/PyCQA/doc8",
  "checks": [
    {
      "type": "binary",
      "name": "doc8"
    }
  ],
  "install_guidance": {
    "plugin": "doc8",
    "binary": "doc8",
    "check": "which doc8",
    "install_steps": [
      "brew install doc8",
      "Verify: doc8 --version",
      "supercli plugins install ./plugins/doc8 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "doc8",
      "resource": "self",
      "action": "version",
      "description": "Print doc8 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doc8",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install doc8: brew install doc8"
      },
      "args": []
    },
    {
      "namespace": "doc8",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to doc8 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "doc8",
        "passthrough": true,
        "missingDependencyHelp": "Install doc8"
      },
      "args": []
    }
  ]
}