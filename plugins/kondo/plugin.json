{
  "name": "kondo",
  "version": "0.1.0",
  "description": "Cleans unneeded build artifacts and dependency directories from projects",
  "source": "https://github.com/tbillington/kondo",
  "checks": [{ "type": "binary", "name": "kondo" }],
  "install_guidance": {
    "plugin": "kondo",
    "binary": "kondo",
    "check": "which kondo",
    "install_steps": ["cargo install kondo", "Verify: kondo --version", "supercli plugins install ./plugins/kondo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kondo",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kondo CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kondo",
      "passthrough": true,
      "missingDependencyHelp": "Install kondo: cargo install kondo"
    },
    "args": []
  }]
}
