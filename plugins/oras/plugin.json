{
  "name": "oras",
  "version": "0.1.0",
  "description": "OCI Registry as Storage - push and pull OCI artifacts",
  "source": "https://github.com/oras-project/oras",
  "checks": [{ "type": "binary", "name": "oras" }],
  "install_guidance": {
    "plugin": "oras",
    "binary": "oras",
    "check": "which oras",
    "install_steps": ["brew install oras", "Verify: oras --version", "supercli plugins install ./plugins/oras --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "oras",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to oras CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "oras",
      "passthrough": true,
      "missingDependencyHelp": "Install oras: brew install oras"
    },
    "args": []
  }]
}
