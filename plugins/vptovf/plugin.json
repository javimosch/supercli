{
  "name": "vptovf",
  "version": "0.1.0",
  "description": "CLI tool: vptovf",
  "source": "https://manpages.debian.org/vptovf",
  "checks": [
    {
      "type": "binary",
      "name": "vptovf"
    }
  ],
  "install_guidance": {
    "plugin": "vptovf",
    "binary": "vptovf",
    "check": "which vptovf",
    "install_steps": [
      "apt-get install vptovf 2>/dev/null || which vptovf",
      "Verify: vptovf --version",
      "supercli plugins install ./plugins/vptovf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vptovf",
      "resource": "self",
      "action": "version",
      "description": "Print vptovf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vptovf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vptovf: apt-get install vptovf 2>/dev/null || which vptovf"
      },
      "args": []
    },
    {
      "namespace": "vptovf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vptovf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vptovf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vptovf: apt-get install vptovf 2>/dev/null || which vptovf"
      },
      "args": []
    }
  ]
}