{
  "name": "kakoune",
  "version": "0.1.0",
  "description": "Modal code editor with selection-oriented paradigm",
  "source": "https://github.com/mawww/kakoune",
  "checks": [{ "type": "binary", "name": "kak" }],
  "install_guidance": {
    "plugin": "kakoune",
    "binary": "kak",
    "check": "which kak",
    "install_steps": ["brew install kakoune", "Verify: kak --version", "supercli plugins install ./plugins/kakoune --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kakoune",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kak CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kak",
      "passthrough": true,
      "missingDependencyHelp": "Install kakoune: brew install kakoune", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
