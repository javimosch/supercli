{
  "name": "tere",
  "version": "0.1.0",
  "description": "A faster alternative to using cd and ls",
  "source": "https://github.com/mgunyho/tere",
  "checks": [
    {
      "type": "binary",
      "name": "tere"
    }
  ],
  "install_guidance": {
    "plugin": "tere",
    "binary": "tere",
    "check": "which tere",
    "install_steps": [
      "cargo install tere",
      "Verify: tere --version",
      "supercli plugins install ./plugins/tere --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "tere",
      "resource": "self",
      "action": "version",
      "description": "Print tere version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tere",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tere: cargo install tere"
      },
      "args": []
    },
    {
      "namespace": "tere",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tere CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tere",
        "passthrough": true,
        "missingDependencyHelp": "Install tere"
      },
      "args": []
    }
  ]
}