{
  "name": "getmnemo-backup",
  "version": "0.1.0",
  "description": "Backup / restore CLI for LedgerMem",
  "source": "https://github.com/getmnemo-backup/getmnemo-backup",
  "checks": [
    {
      "type": "binary",
      "name": "getmnemo-backup"
    }
  ],
  "install_guidance": {
    "plugin": "getmnemo-backup",
    "binary": "getmnemo-backup",
    "check": "which getmnemo-backup",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: getmnemo-backup --version",
      "supercli plugins install ./plugins/getmnemo-backup --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "getmnemo-backup",
      "resource": "self",
      "action": "version",
      "description": "Print getmnemo-backup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "getmnemo-backup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install getmnemo-backup from project repository"
      },
      "args": []
    },
    {
      "namespace": "getmnemo-backup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to getmnemo-backup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "getmnemo-backup",
        "passthrough": true,
        "missingDependencyHelp": "Install getmnemo-backup from project repository"
      },
      "args": []
    }
  ]
}