{
  "name": "cbor-cli",
  "version": "0.1.0",
  "description": "CLI tool to inspect and convert CBOR binary data files",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "cbor-cli" }],
  "install_guidance": {
    "plugin": "cbor-cli",
    "binary": "cbor-cli",
    "check": "which cbor-cli",
    "install_steps": ["cargo install cbor-cli", "Verify: cbor-cli --version", "supercli plugins install ./plugins/cbor-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cbor-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cbor-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cbor-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install cbor-cli: cargo install cbor-cli"
    },
    "args": []
  }]
}
