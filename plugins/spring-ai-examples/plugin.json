{
  "name": "spring-ai-examples",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/spring-ai-examples/spring-ai-examples",
  "checks": [
    {
      "type": "binary",
      "name": "spring-ai-examples"
    }
  ],
  "install_guidance": {
    "plugin": "spring-ai-examples",
    "binary": "spring-ai-examples",
    "check": "which spring-ai-examples",
    "install_steps": [
      "pip install spring-ai-examples",
      "Verify: spring-ai-examples --version",
      "supercli plugins install ./plugins/spring-ai-examples --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "spring-ai-examples",
      "resource": "self",
      "action": "version",
      "description": "Print spring-ai-examples version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spring-ai-examples",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spring-ai-examples: pip install spring-ai-examples"
      },
      "args": []
    },
    {
      "namespace": "spring-ai-examples",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spring-ai-examples CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spring-ai-examples",
        "passthrough": true,
        "missingDependencyHelp": "Install spring-ai-examples: pip install spring-ai-examples"
      },
      "args": []
    }
  ]
}