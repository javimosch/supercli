{
  "name": "imgur-uploader-cli",
  "version": "0.1.0",
  "description": "Upload images to imgur",
  "source": "https://github.com/kevva/imgur-uploader-cli",
  "checks": [
    {
      "type": "binary",
      "name": "imgur-uploader-cli"
    }
  ],
  "install_guidance": {
    "plugin": "imgur-uploader-cli",
    "binary": "imgur-uploader-cli",
    "check": "which imgur-uploader-cli",
    "install_steps": [
      "See https://github.com/kevva/imgur-uploader-cli",
      "Verify: imgur-uploader-cli --version",
      "supercli plugins install ./plugins/imgur-uploader-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "imgur-uploader-cli",
      "resource": "self",
      "action": "version",
      "description": "Print imgur-uploader-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgur-uploader-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install imgur-uploader-cli: See https://github.com/kevva/imgur-uploader-cli"
      },
      "args": []
    },
    {
      "namespace": "imgur-uploader-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to imgur-uploader-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgur-uploader-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install imgur-uploader-cli"
      },
      "args": []
    }
  ]
}