{
  "name": "ctrcli",
  "version": "0.1.0",
  "description": "CLI tool: ctrcli",
  "source": "https://packages.debian.org/ctrcli",
  "checks": [{ "type": "binary", "name": "ctrcli" }],
  "install_guidance": {
    "plugin": "ctrcli", "binary": "ctrcli", "check": "which ctrcli",
    "install_steps": ["apt-get install ctrcli 2>/dev/null || which ctrcli", "Verify: ctrcli --version", "supercli plugins install ./plugins/ctrcli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctrcli", "resource": "_", "action": "_",
    "description": "Passthrough to ctrcli CLI",
    "adapter": "process", "adapterConfig": { "command": "ctrcli", "passthrough": true, "missingDependencyHelp": "Install ctrcli: apt-get install ctrcli" }, "args": []
  }]
}
