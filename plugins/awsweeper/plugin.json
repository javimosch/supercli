{
  "name": "awsweeper",
  "version": "0.1.0",
  "description": "CLI tool for cleaning your AWS account",
  "source": "https://github.com/jckuester/awsweeper/",
  "checks": [
    {
      "type": "binary",
      "name": "awsweeper"
    }
  ],
  "install_guidance": {
    "plugin": "awsweeper",
    "binary": "awsweeper",
    "check": "which awsweeper",
    "install_steps": [
      "brew install awsweeper",
      "Verify: awsweeper --version",
      "supercli plugins install ./plugins/awsweeper --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "awsweeper",
      "resource": "self",
      "action": "version",
      "description": "Print awsweeper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsweeper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awsweeper: brew install awsweeper"
      },
      "args": []
    },
    {
      "namespace": "awsweeper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awsweeper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsweeper",
        "passthrough": true,
        "missingDependencyHelp": "Install awsweeper"
      },
      "args": []
    }
  ]
}