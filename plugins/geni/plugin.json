{
  "name": "geni",
  "version": "0.1.0",
  "description": "Standalone database migration tool",
  "source": "https://github.com/emilpriver/geni",
  "checks": [
    {
      "type": "binary",
      "name": "geni"
    }
  ],
  "install_guidance": {
    "plugin": "geni",
    "binary": "geni",
    "check": "which geni",
    "install_steps": [
      "brew install geni",
      "Verify: geni --version",
      "supercli plugins install ./plugins/geni --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "geni",
      "resource": "self",
      "action": "version",
      "description": "Print geni version",
      "adapter": "process",
      "adapterConfig": {
        "command": "geni",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install geni: brew install geni"
      },
      "args": []
    },
    {
      "namespace": "geni",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to geni CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "geni",
        "passthrough": true,
        "missingDependencyHelp": "Install geni"
      },
      "args": []
    }
  ]
}