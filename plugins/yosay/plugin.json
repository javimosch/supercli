{
  "name": "yosay",
  "version": "0.1.0",
  "description": "Like cowsay, but for yeoman",
  "source": "https://github.com/yeoman/yosay",
  "checks": [
    {
      "type": "binary",
      "name": "yosay"
    }
  ],
  "install_guidance": {
    "plugin": "yosay",
    "binary": "yosay",
    "check": "which yosay",
    "install_steps": [
      "See https://github.com/yeoman/yosay",
      "Verify: yosay --version",
      "supercli plugins install ./plugins/yosay --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "yosay",
      "resource": "self",
      "action": "version",
      "description": "Print yosay version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yosay",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yosay: See https://github.com/yeoman/yosay"
      },
      "args": []
    },
    {
      "namespace": "yosay",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yosay CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yosay",
        "passthrough": true,
        "missingDependencyHelp": "Install yosay"
      },
      "args": []
    }
  ]
}