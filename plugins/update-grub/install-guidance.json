{
  "plugin": "update-grub",
  "binary": "update-grub",
  "check": "which update-grub",
  "install_steps": [
    "apt-get install update-grub 2>/dev/null || which update-grub",
    "Verify: update-grub --version",
    "supercli plugins install ./plugins/update-grub --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}