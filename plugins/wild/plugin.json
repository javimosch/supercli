{
  "name": "wild",
  "version": "0.1.0",
  "description": "A very fast linker for Linux",
  "source": "https://github.com/wild/wild",
  "checks": [
    {
      "type": "binary",
      "name": "wild"
    }
  ],
  "install_guidance": {
    "plugin": "wild",
    "binary": "wild",
    "check": "which wild",
    "install_steps": [
      "pip install wild",
      "Verify: wild --version",
      "supercli plugins install ./plugins/wild --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wild",
      "resource": "self",
      "action": "version",
      "description": "Print wild version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wild",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wild: pip install wild"
      },
      "args": []
    },
    {
      "namespace": "wild",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wild CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wild",
        "passthrough": true,
        "missingDependencyHelp": "Install wild: pip install wild"
      },
      "args": []
    }
  ]
}