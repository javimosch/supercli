{
  "name": "release-plz",
  "version": "0.1.0",
  "description": "A semver and changelog auto-updater for Rust projects. Automates version bumping, changelog generation, and GitHub releases from conventional commits.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "release-plz"
    }
  ],
  "install_guidance": {
    "plugin": "release-plz",
    "binary": "release-plz",
    "check": "which release-plz",
    "install_steps": [
      "cargo install release-plz",
      "Verify: release-plz --version",
      "supercli plugins install ./plugins/release-plz --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "release-plz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to release-plz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "release-plz",
        "passthrough": true,
        "missingDependencyHelp": "Install release-plz: cargo install release-plz"
      },
      "args": []
    }
  ]
}
