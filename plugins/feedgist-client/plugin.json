{
  "name": "feedgist-client",
  "version": "0.1.0",
  "description": "Angular 4 front-end application of FeedGist as Progressive Web App. It contains Angular Material UI components and sw-precache, sw-toolbox tools to make application offline-ready.",
  "source": "https://www.feedgist.io",
  "checks": [
    {
      "type": "binary",
      "name": "feedgist-client"
    }
  ],
  "install_guidance": {
    "plugin": "feedgist-client",
    "binary": "feedgist-client",
    "check": "which feedgist-client",
    "install_steps": [
      "Check https://www.feedgist.io for installation instructions",
      "Verify: feedgist-client --version",
      "supercli plugins install ./plugins/feedgist-client --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "feedgist-client",
      "resource": "self",
      "action": "version",
      "description": "Print feedgist-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "feedgist-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install feedgist-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "feedgist-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to feedgist-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "feedgist-client",
        "passthrough": true,
        "missingDependencyHelp": "Install feedgist-client from project repository"
      },
      "args": []
    }
  ]
}