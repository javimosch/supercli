{
  "name": "at-spi2-registryd",
  "version": "0.1.0",
  "description": "CLI tool: at-spi2-registryd",
  "source": "https://packages.debian.org/at-spi2-registryd",
  "checks": [{ "type": "binary", "name": "at-spi2-registryd" }],
  "install_guidance": {
    "plugin": "at-spi2-registryd", "binary": "at-spi2-registryd", "check": "which at-spi2-registryd",
    "install_steps": ["apt-get install at-spi2-registryd 2>/dev/null || which at-spi2-registryd", "Verify: at-spi2-registryd --version", "supercli plugins install ./plugins/at-spi2-registryd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-spi2-registryd", "resource": "_", "action": "_",
    "description": "Passthrough to at-spi2-registryd CLI",
    "adapter": "process", "adapterConfig": { "command": "at-spi2-registryd", "passthrough": true, "missingDependencyHelp": "Install at-spi2-registryd: apt-get install at-spi2-registryd" }, "args": []
  }]
}
