{
  "name": "update-language-def",
  "version": "0.1.0",
  "description": "CLI tool: update-language-def",
  "source": "https://manpages.debian.org/update-language-def",
  "checks": [
    {
      "type": "binary",
      "name": "update-language-def"
    }
  ],
  "install_guidance": {
    "plugin": "update-language-def",
    "binary": "update-language-def",
    "check": "which update-language-def",
    "install_steps": [
      "apt-get install update-language-def 2>/dev/null || which update-language-def",
      "Verify: update-language-def --version",
      "supercli plugins install ./plugins/update-language-def --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "update-language-def",
      "resource": "self",
      "action": "version",
      "description": "Print update-language-def version",
      "adapter": "process",
      "adapterConfig": {
        "command": "update-language-def",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install update-language-def: apt-get install update-language-def 2>/dev/null || which update-language-def"
      },
      "args": []
    },
    {
      "namespace": "update-language-def",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to update-language-def CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "update-language-def",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install update-language-def: apt-get install update-language-def 2>/dev/null || which update-language-def"
      },
      "args": []
    }
  ]
}