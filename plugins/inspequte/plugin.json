{
  "name": "inspequte",
  "version": "0.1.0",
  "description": "A JVM static analysis tool for the CLI. Analyzes Java bytecode and class files to detect patterns, vulnerabilities, and code quality issues.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "inspequte"
    }
  ],
  "install_guidance": {
    "plugin": "inspequte",
    "binary": "inspequte",
    "check": "which inspequte",
    "install_steps": [
      "cargo install inspequte",
      "Verify: inspequte --version",
      "supercli plugins install ./plugins/inspequte --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "inspequte",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to inspequte CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "inspequte",
        "passthrough": true,
        "missingDependencyHelp": "Install inspequte: cargo install inspequte"
      },
      "args": []
    }
  ]
}
