{
  "name": "vidir",
  "version": "0.1.0",
  "description": "vidir \u2014 edit directory contents in your text editor.",
  "source": "https://github.com/trapd00r/vidir",
  "checks": [
    {
      "type": "binary",
      "name": "vidir"
    }
  ],
  "install_guidance": {
    "plugin": "vidir",
    "binary": "vidir",
    "check": "which vidir",
    "install_steps": [
      "cargo install vidir-rs",
      "brew install vidir"
    ],
    "note": "Rust. Directory content editor."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vidir",
      "resource": "dir",
      "action": "edit",
      "description": "Edit directory contents in editor",
      "adapter": "process",
      "adapterConfig": {
        "command": "vidir",
        "missingDependencyHelp": "Install vidir",
        "positionalArgs": [
          "directory"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "directory path"
        }
      ]
    },
    {
      "namespace": "vidir",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vidir",
        "missingDependencyHelp": "Install vidir",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
