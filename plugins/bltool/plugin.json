{
  "name": "bltool",
  "version": "0.1.0",
  "description": "Tool for command-line interaction with backloggery.com",
  "source": "https://github.com/ToxicFrog/bltool",
  "checks": [
    {
      "type": "binary",
      "name": "bltool"
    }
  ],
  "install_guidance": {
    "plugin": "bltool",
    "binary": "bltool",
    "check": "which bltool",
    "install_steps": [
      "brew install bltool",
      "Verify: bltool --version",
      "supercli plugins install ./plugins/bltool --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bltool",
      "resource": "self",
      "action": "version",
      "description": "Print bltool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bltool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bltool: brew install bltool"
      },
      "args": []
    },
    {
      "namespace": "bltool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bltool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bltool",
        "passthrough": true,
        "missingDependencyHelp": "Install bltool"
      },
      "args": []
    }
  ]
}