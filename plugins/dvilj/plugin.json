{
  "name": "dvilj",
  "version": "0.1.0",
  "description": "CLI tool: dvilj",
  "source": "https://manpages.debian.org/dvilj",
  "checks": [
    {
      "type": "binary",
      "name": "dvilj"
    }
  ],
  "install_guidance": {
    "plugin": "dvilj",
    "binary": "dvilj",
    "check": "which dvilj",
    "install_steps": [
      "apt-get install dvilj 2>/dev/null || which dvilj",
      "Verify: dvilj --version",
      "supercli plugins install ./plugins/dvilj --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvilj",
      "resource": "self",
      "action": "version",
      "description": "Print dvilj version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvilj: apt-get install dvilj 2>/dev/null || which dvilj"
      },
      "args": []
    },
    {
      "namespace": "dvilj",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvilj CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilj",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvilj: apt-get install dvilj 2>/dev/null || which dvilj"
      },
      "args": []
    }
  ]
}