{
  "plugin": "b2sum",
  "binary": "b2sum",
  "check": "which b2sum",
  "install_steps": [
    "# Install b2sum",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/b2sum-linux-amd64 -o /usr/local/bin/b2sum",
    "chmod +x /usr/local/bin/b2sum",
    "# Or via package manager, see /usr/bin/b2sum"
  ]
}