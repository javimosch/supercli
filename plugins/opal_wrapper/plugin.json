{
  "name": "opal_wrapper",
  "version": "0.1.0",
  "description": "CLI tool: opal_wrapper",
  "source": "https://manpages.debian.org/opal_wrapper",
  "checks": [
    {
      "type": "binary",
      "name": "opal_wrapper"
    }
  ],
  "install_guidance": {
    "plugin": "opal_wrapper",
    "binary": "opal_wrapper",
    "check": "which opal_wrapper",
    "install_steps": [
      "apt-get install opal_wrapper 2>/dev/null || which opal_wrapper",
      "Verify: opal_wrapper --version",
      "supercli plugins install ./plugins/opal_wrapper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "opal_wrapper",
      "resource": "self",
      "action": "version",
      "description": "Print opal_wrapper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "opal_wrapper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install opal_wrapper: apt-get install opal_wrapper 2>/dev/null || which opal_wrapper"
      },
      "args": []
    },
    {
      "namespace": "opal_wrapper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to opal_wrapper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "opal_wrapper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install opal_wrapper: apt-get install opal_wrapper 2>/dev/null || which opal_wrapper"
      },
      "args": []
    }
  ]
}