{
  "name": "tclsh",
  "version": "0.1.0",
  "description": "tclsh \u2014 simple shell containing Tcl interpreter",
  "source": "https://packages.debian.org/tclsh",
  "checks": [{ "type": "binary", "name": "tclsh" }],
  "install_guidance": {
    "plugin": "tclsh", "binary": "tclsh", "check": "which tclsh",
    "install_steps": ["apt-get install tcl", "Verify: tclsh --version", "supercli plugins install ./plugins/tclsh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tclsh", "resource": "_", "action": "_",
    "description": "Passthrough to tclsh CLI",
    "adapter": "process", "adapterConfig": { "command": "tclsh", "passthrough": true, "missingDependencyHelp": "Install tclsh: apt-get install tcl" }, "args": []
  }]
}
