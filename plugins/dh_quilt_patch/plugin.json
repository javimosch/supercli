{
  "name": "dh_quilt_patch",
  "version": "0.1.0",
  "description": "CLI tool: dh_quilt_patch",
  "source": "https://packages.debian.org/dh_quilt_patch",
  "checks": [{ "type": "binary", "name": "dh_quilt_patch" }],
  "install_guidance": {
    "plugin": "dh_quilt_patch", "binary": "dh_quilt_patch", "check": "which dh_quilt_patch",
    "install_steps": ["apt-get install dh_quilt_patch 2>/dev/null || which dh_quilt_patch", "Verify: dh_quilt_patch --version", "supercli plugins install ./plugins/dh_quilt_patch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_quilt_patch", "resource": "_", "action": "_",
    "description": "Passthrough to dh_quilt_patch CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_quilt_patch", "passthrough": true, "missingDependencyHelp": "Install dh_quilt_patch: apt-get install dh_quilt_patch" }, "args": []
  }]
}
