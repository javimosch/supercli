{
  "name": "Qalculate",
  "version": "0.1.0",
  "description": "Calculate non-trivial math expressions. Unit conversions, symbolic calculations and more",
  "source": "https://github.com/Qalculate/libqalculate",
  "checks": [
    {
      "type": "binary",
      "name": "Qalculate"
    }
  ],
  "install_guidance": {
    "plugin": "Qalculate",
    "binary": "Qalculate",
    "check": "which Qalculate",
    "install_steps": [
      "See https://github.com/Qalculate/libqalculate",
      "Verify: Qalculate --version",
      "supercli plugins install ./plugins/Qalculate --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Qalculate",
      "resource": "self",
      "action": "version",
      "description": "Print Qalculate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Qalculate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Qalculate: See https://github.com/Qalculate/libqalculate"
      },
      "args": []
    },
    {
      "namespace": "Qalculate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Qalculate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Qalculate",
        "passthrough": true,
        "missingDependencyHelp": "Install Qalculate"
      },
      "args": []
    }
  ]
}