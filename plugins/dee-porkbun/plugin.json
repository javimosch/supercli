{
  "name": "dee-porkbun",
  "version": "0.1.0",
  "description": "Manage domains via Porkbun API with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-porkbun" }],
  "install_guidance": {
    "plugin": "dee-porkbun",
    "binary": "dee-porkbun",
    "check": "which dee-porkbun",
    "install_steps": ["cargo install dee-porkbun", "Verify: dee-porkbun --version", "supercli plugins install ./plugins/dee-porkbun --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-porkbun",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-porkbun CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-porkbun",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-porkbun: cargo install dee-porkbun"
    },
    "args": []
  }]
}
