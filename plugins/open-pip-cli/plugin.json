{
  "name": "open-pip-cli",
  "version": "0.1.0",
  "description": "Watch videos in picture-in-picture player",
  "source": "https://github.com/albinekb/open-pip-cli",
  "checks": [
    {
      "type": "binary",
      "name": "open-pip-cli"
    }
  ],
  "install_guidance": {
    "plugin": "open-pip-cli",
    "binary": "open-pip-cli",
    "check": "which open-pip-cli",
    "install_steps": [
      "See https://github.com/albinekb/open-pip-cli",
      "Verify: open-pip-cli --version",
      "supercli plugins install ./plugins/open-pip-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "open-pip-cli",
      "resource": "self",
      "action": "version",
      "description": "Print open-pip-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-pip-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install open-pip-cli: See https://github.com/albinekb/open-pip-cli"
      },
      "args": []
    },
    {
      "namespace": "open-pip-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to open-pip-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-pip-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install open-pip-cli"
      },
      "args": []
    }
  ]
}