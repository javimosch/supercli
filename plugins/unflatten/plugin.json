{
  "name": "unflatten",
  "version": "0.1.0",
  "description": "CLI tool: unflatten",
  "source": "https://manpages.debian.org/unflatten",
  "checks": [
    {
      "type": "binary",
      "name": "unflatten"
    }
  ],
  "install_guidance": {
    "plugin": "unflatten",
    "binary": "unflatten",
    "check": "which unflatten",
    "install_steps": [
      "apt-get install unflatten 2>/dev/null || which unflatten",
      "Verify: unflatten --version",
      "supercli plugins install ./plugins/unflatten --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unflatten",
      "resource": "self",
      "action": "version",
      "description": "Print unflatten version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unflatten",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unflatten: apt-get install unflatten 2>/dev/null || which unflatten"
      },
      "args": []
    },
    {
      "namespace": "unflatten",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unflatten CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unflatten",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unflatten: apt-get install unflatten 2>/dev/null || which unflatten"
      },
      "args": []
    }
  ]
}