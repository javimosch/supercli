{
  "name": "dyad",
  "version": "0.1.0",
  "description": "Local, open-source AI app builder for power users \u2728 v0 / Lovable / Replit / Bolt alternative \ud83c\udf1f Star ",
  "source": "https://github.com/dyad/dyad",
  "checks": [
    {
      "type": "binary",
      "name": "dyad"
    }
  ],
  "install_guidance": {
    "plugin": "dyad",
    "binary": "dyad",
    "check": "which dyad",
    "install_steps": [
      "pip install dyad",
      "Verify: dyad --version",
      "supercli plugins install ./plugins/dyad --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dyad",
      "resource": "self",
      "action": "version",
      "description": "Print dyad version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dyad",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dyad: pip install dyad"
      },
      "args": []
    },
    {
      "namespace": "dyad",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dyad CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dyad",
        "passthrough": true,
        "missingDependencyHelp": "Install dyad: pip install dyad"
      },
      "args": []
    }
  ]
}