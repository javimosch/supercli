{
  "plugin": "kalker",
  "binary": "kalker",
  "check": "kalker --version",
  "install_steps": [
    "cargo install kalker",
    "Verify: kalker --version",
    "supercli plugins install ./plugins/kalker --on-conflict replace --json"
  ],
  "note": "Requires Rust toolchain (cargo). Also available via Homebrew: brew install kalker"
}
