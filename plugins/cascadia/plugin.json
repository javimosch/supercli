{
  "name": "cascadia",
  "version": "0.1.0",
  "description": "Go cascadia package command-line CSS selector",
  "source": "https://github.com/suntong/cascadia",
  "checks": [
    {
      "type": "binary",
      "name": "cascadia"
    }
  ],
  "install_guidance": {
    "plugin": "cascadia",
    "binary": "cascadia",
    "check": "which cascadia",
    "install_steps": [
      "brew install cascadia",
      "Verify: cascadia --version",
      "supercli plugins install ./plugins/cascadia --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cascadia",
      "resource": "self",
      "action": "version",
      "description": "Print cascadia version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cascadia",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cascadia: brew install cascadia"
      },
      "args": []
    },
    {
      "namespace": "cascadia",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cascadia CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cascadia",
        "passthrough": true,
        "missingDependencyHelp": "Install cascadia"
      },
      "args": []
    }
  ]
}