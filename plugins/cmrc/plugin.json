{
  "name": "cmrc",
  "version": "0.1.0",
  "description": "CMake Resource Compiler",
  "source": "https://github.com/vector-of-bool/cmrc",
  "checks": [
    {
      "type": "binary",
      "name": "cmrc"
    }
  ],
  "install_guidance": {
    "plugin": "cmrc",
    "binary": "cmrc",
    "check": "which cmrc",
    "install_steps": [
      "brew install cmrc",
      "Verify: cmrc --version",
      "supercli plugins install ./plugins/cmrc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cmrc",
      "resource": "self",
      "action": "version",
      "description": "Print cmrc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmrc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmrc: brew install cmrc"
      },
      "args": []
    },
    {
      "namespace": "cmrc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmrc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmrc",
        "passthrough": true,
        "missingDependencyHelp": "Install cmrc"
      },
      "args": []
    }
  ]
}