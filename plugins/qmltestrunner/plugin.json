{
  "name": "qmltestrunner",
  "version": "0.1.0",
  "description": "CLI tool: qmltestrunner",
  "source": "https://manpages.debian.org/qmltestrunner",
  "checks": [
    {
      "type": "binary",
      "name": "qmltestrunner"
    }
  ],
  "install_guidance": {
    "plugin": "qmltestrunner",
    "binary": "qmltestrunner",
    "check": "which qmltestrunner",
    "install_steps": [
      "apt-get install qmltestrunner 2>/dev/null || which qmltestrunner",
      "Verify: qmltestrunner --version",
      "supercli plugins install ./plugins/qmltestrunner --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmltestrunner",
      "resource": "self",
      "action": "version",
      "description": "Print qmltestrunner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmltestrunner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmltestrunner: apt-get install qmltestrunner 2>/dev/null || which qmltestrunner"
      },
      "args": []
    },
    {
      "namespace": "qmltestrunner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmltestrunner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmltestrunner",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmltestrunner: apt-get install qmltestrunner 2>/dev/null || which qmltestrunner"
      },
      "args": []
    }
  ]
}