{
  "name": "SuperClaude_Framework",
  "version": "0.1.0",
  "description": "A configuration framework that enhances Claude Code with specialized commands, cognitive personas, a",
  "source": "https://github.com/SuperClaude_Framework/SuperClaude_Framework",
  "checks": [
    {
      "type": "binary",
      "name": "superclaude-framework"
    }
  ],
  "install_guidance": {
    "plugin": "SuperClaude_Framework",
    "binary": "superclaude-framework",
    "check": "which superclaude-framework",
    "install_steps": [
      "pip install superclaude-framework",
      "Verify: superclaude-framework --version",
      "supercli plugins install ./plugins/SuperClaude_Framework --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SuperClaude_Framework",
      "resource": "self",
      "action": "version",
      "description": "Print SuperClaude_Framework version",
      "adapter": "process",
      "adapterConfig": {
        "command": "superclaude-framework",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SuperClaude_Framework: pip install superclaude-framework"
      },
      "args": []
    },
    {
      "namespace": "SuperClaude_Framework",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to superclaude-framework CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "superclaude-framework",
        "passthrough": true,
        "missingDependencyHelp": "Install SuperClaude_Framework: pip install superclaude-framework"
      },
      "args": []
    }
  ]
}