{
  "name": "diskus",
  "version": "0.1.0",
  "description": "A minimal, fast disk usage analyzer. A slim alternative to du -sh that computes directory sizes with maximum speed using parallel filesystem traversal.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "diskus"
    }
  ],
  "install_guidance": {
    "plugin": "diskus",
    "binary": "diskus",
    "check": "which diskus",
    "install_steps": [
      "cargo install diskus",
      "Verify: diskus --version",
      "supercli plugins install ./plugins/diskus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "diskus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to diskus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "diskus",
        "passthrough": true,
        "missingDependencyHelp": "Install diskus: cargo install diskus"
      },
      "args": []
    }
  ]
}
