{
  "name": "gtk4",
  "version": "0.1.0",
  "description": "Toolkit for creating graphical user interfaces",
  "checks": [
    {
      "type": "binary",
      "name": "gtk4"
    }
  ],
  "install_guidance": {
    "plugin": "gtk4",
    "binary": "gtk4",
    "check": "which gtk4",
    "install_steps": [
      "brew install gtk4",
      "Verify: gtk4 --version",
      "supercli plugins install ./plugins/gtk4 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gtk4",
      "resource": "self",
      "action": "version",
      "description": "Print gtk4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtk4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtk4: brew install gtk4"
      },
      "args": []
    },
    {
      "namespace": "gtk4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtk4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtk4",
        "passthrough": true,
        "missingDependencyHelp": "Install gtk4"
      },
      "args": []
    }
  ]
}