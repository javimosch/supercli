{
  "name": "postlock",
  "version": "1.0.0",
  "description": "postlock \u2014 postlock \u2014 CLI utility",
  "source": "/usr/sbin/postlock",
  "checks": [
    {
      "type": "binary",
      "name": "postlock"
    }
  ],
  "install_guidance": {
    "plugin": "postlock",
    "binary": "postlock",
    "check": "which postlock",
    "install_steps": [
      "# Install postlock:",
      "# apt: sudo apt-get install postlock",
      "# brew: brew install postlock",
      "# cargo: cargo install postlock",
      "# npm: npm install -g postlock",
      "# pip: pip install postlock",
      "# or download from /usr/sbin/postlock"
    ]
  },
  "commands": [
    {
      "namespace": "postlock",
      "resource": "postlock",
      "action": "run",
      "description": "Run postlock",
      "adapter": "process",
      "adapterConfig": {
        "command": "postlock",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postlock from /usr/sbin/postlock"
      },
      "args": []
    }
  ]
}