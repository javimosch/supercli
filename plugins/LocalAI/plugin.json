{
  "name": "LocalAI",
  "version": "0.1.0",
  "description": "LocalAI is the open-source AI engine. Run any model - LLMs, vision, voice, image, video - on any har",
  "source": "https://github.com/LocalAI/LocalAI",
  "checks": [
    {
      "type": "binary",
      "name": "localai"
    }
  ],
  "install_guidance": {
    "plugin": "LocalAI",
    "binary": "localai",
    "check": "which localai",
    "install_steps": [
      "pip install localai",
      "Verify: localai --version",
      "supercli plugins install ./plugins/LocalAI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LocalAI",
      "resource": "self",
      "action": "version",
      "description": "Print LocalAI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "localai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LocalAI: pip install localai"
      },
      "args": []
    },
    {
      "namespace": "LocalAI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to localai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "localai",
        "passthrough": true,
        "missingDependencyHelp": "Install LocalAI: pip install localai"
      },
      "args": []
    }
  ]
}