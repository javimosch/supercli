{
  "name": "crmd",
  "version": "0.1.0",
  "description": "The CRM your agent runs \u2014 server-only, API-driven, Stripe-billed",
  "source": "https://github.com/javimosch/crmd",
  "checks": [
    {
      "type": "binary",
      "name": "crmd-server"
    }
  ],
  "install_guidance": {
    "plugin": "crmd",
    "binary": "crmd-server",
    "check": "which crmd-server",
    "install_steps": [
      "Build from source: https://github.com/javimosch/crmd",
      "Verify: crmd-server version || crmd-server guide"
    ]
  },
  "commands": [
    {
      "namespace": "crmd",
      "resource": "self",
      "action": "serve",
      "description": "Start the CRM HTTP server",
      "adapter": "process",
      "adapterConfig": {
        "command": "crmd-server",
        "baseArgs": [],
        "parseJson": true,
        "missingDependencyHelp": "Install crmd-server from https://github.com/javimosch/crmd"
      },
      "args": [
        {
          "name": "port",
          "type": "integer",
          "required": false,
          "description": "Port number",
          "default": 8794
        }
      ]
    }
  ]
}