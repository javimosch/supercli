{
  "name": "text-processor-pro",
  "version": "0.1.0",
  "description": "Batch text processing CLI - find, replace, extract, count",
  "source": "https://github.com/text-processor-pro/text-processor-pro",
  "checks": [
    {
      "type": "binary",
      "name": "text-processor-pro"
    }
  ],
  "install_guidance": {
    "plugin": "text-processor-pro",
    "binary": "text-processor-pro",
    "check": "which text-processor-pro",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: text-processor-pro --version",
      "supercli plugins install ./plugins/text-processor-pro --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "text-processor-pro",
      "resource": "self",
      "action": "version",
      "description": "Print text-processor-pro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "text-processor-pro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install text-processor-pro from project repository"
      },
      "args": []
    },
    {
      "namespace": "text-processor-pro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to text-processor-pro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "text-processor-pro",
        "passthrough": true,
        "missingDependencyHelp": "Install text-processor-pro from project repository"
      },
      "args": []
    }
  ]
}