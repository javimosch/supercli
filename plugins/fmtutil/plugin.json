{
  "name": "fmtutil",
  "version": "0.1.0",
  "description": "CLI tool: fmtutil",
  "source": "https://manpages.debian.org/fmtutil",
  "checks": [
    {
      "type": "binary",
      "name": "fmtutil"
    }
  ],
  "install_guidance": {
    "plugin": "fmtutil",
    "binary": "fmtutil",
    "check": "which fmtutil",
    "install_steps": [
      "apt-get install fmtutil 2>/dev/null || which fmtutil",
      "Verify: fmtutil --version",
      "supercli plugins install ./plugins/fmtutil --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fmtutil",
      "resource": "self",
      "action": "version",
      "description": "Print fmtutil version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fmtutil",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fmtutil: apt-get install fmtutil 2>/dev/null || which fmtutil"
      },
      "args": []
    },
    {
      "namespace": "fmtutil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fmtutil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fmtutil",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fmtutil: apt-get install fmtutil 2>/dev/null || which fmtutil"
      },
      "args": []
    }
  ]
}