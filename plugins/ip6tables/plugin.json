{
  "name": "ip6tables",
  "version": "1.0.0",
  "description": "ip6tables — ip6tables — CLI utility",
  "source": "https://netfilter.org/projects/iptables/",
  "checks": [
    {
      "type": "binary",
      "name": "ip6tables"
    }
  ],
  "install_guidance": {
    "plugin": "ip6tables",
    "binary": "ip6tables",
    "check": "which ip6tables",
    "install_steps": [
      "# Install ip6tables:",
      "# apt: sudo apt-get install ip6tables",
      "# brew: brew install ip6tables",
      "# cargo: cargo install ip6tables",
      "# npm: npm install -g ip6tables",
      "# pip: pip install ip6tables",
      "# or download from /usr/sbin/ip6tables"
    ]
  },
  "commands": [
    {
      "namespace": "ip6tables",
      "resource": "ip6tables",
      "action": "run",
      "description": "Run ip6tables",
      "adapter": "process",
      "adapterConfig": {
        "command": "ip6tables",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ip6tables from /usr/sbin/ip6tables"
      },
      "args": []
    }
  ]
}
