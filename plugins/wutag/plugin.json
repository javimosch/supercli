{
  "name": "wutag",
  "version": "0.1.0",
  "description": "CLI Tool for tagging and organizing files by tags.",
  "source": "https://github.com/vv9k/wutag",
  "checks": [
    {
      "type": "binary",
      "name": "wutag"
    }
  ],
  "install_guidance": {
    "plugin": "wutag",
    "binary": "wutag",
    "check": "which wutag",
    "install_steps": [
      "See https://github.com/vv9k/wutag",
      "Verify: wutag --version",
      "supercli plugins install ./plugins/wutag --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "wutag",
      "resource": "self",
      "action": "version",
      "description": "Print wutag version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wutag",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wutag: See https://github.com/vv9k/wutag"
      },
      "args": []
    },
    {
      "namespace": "wutag",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wutag CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wutag",
        "passthrough": true,
        "missingDependencyHelp": "Install wutag"
      },
      "args": []
    }
  ]
}