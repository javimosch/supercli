{
  "name": "jello",
  "version": "0.1.0",
  "description": "A CLI tool to filter JSON and JSON Lines data using Python syntax. An alternative to jq with Python-like expressions.",
  "source": "https://github.com/kellyjonbrazil/jello",
  "checks": [{ "type": "binary", "name": "jello" }],
  "install_guidance": {
    "plugin": "jello",
    "binary": "jello",
    "check": "which jello",
    "install_steps": ["pipx install jello", "Verify: jello --version", "supercli plugins install ./plugins/jello --on-conflict replace --json"]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "jello", "resource": "self", "action": "version", "description": "Print jello version", "adapter": "process", "adapterConfig": { "command": "jello", "baseArgs": ["--version"], "missingDependencyHelp": "Install jello: pipx install jello" }, "args": [] },
    { "namespace": "jello", "resource": "_", "action": "_", "description": "Passthrough to jello CLI", "adapter": "process", "adapterConfig": { "command": "jello", "passthrough": true, "missingDependencyHelp": "Install jello: pipx install jello" }, "args": [] }
  ]
}
