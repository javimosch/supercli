{
  "name": "jello",
  "version": "0.1.0",
  "description": "jello \u2014 jq alternative in Python. Query JSON with Python syntax.",
  "source": "https://github.com/kellyjonbrazil/jello",
  "checks": [
    {
      "type": "binary",
      "name": "jello"
    }
  ],
  "install_guidance": {
    "plugin": "jello",
    "binary": "jello",
    "check": "which jello",
    "install_steps": [
      "pip install jello",
      "supercli plugins install ./plugins/jello --on-conflict replace --json"
    ],
    "note": "Python. jq alternative with Python syntax."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jello",
      "resource": "json",
      "action": "query",
      "description": "Query JSON with Python syntax",
      "adapter": "process",
      "adapterConfig": {
        "command": "jello",
        "missingDependencyHelp": "Install jello",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "jello",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jello",
        "missingDependencyHelp": "Install jello",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
