{
  "name": "tgpt",
  "version": "0.1.0",
  "description": "Ask questions with AI without leaving terminal",
  "source": "https://github.com/aandrew-me/tgpt",
  "checks": [{ "type": "binary", "name": "tgpt" }],
  "install_guidance": {
    "plugin": "tgpt",
    "binary": "tgpt",
    "check": "which tgpt",
    "install_steps": ["brew install tgpt", "Verify: tgpt --version", "supercli plugins install ./plugins/tgpt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tgpt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tgpt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tgpt",
      "passthrough": true,
      "missingDependencyHelp": "Install tgpt: brew install tgpt", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
