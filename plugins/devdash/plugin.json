{
  "name": "devdash",
  "version": "1.0.0",
  "description": "devdash \u2014 Dev dashboard",
  "source": "github.com/Phantas0s/devdash",
  "checks": [
    {
      "type": "binary",
      "name": "devdash"
    }
  ],
  "install_guidance": {
    "plugin": "devdash",
    "binary": "devdash",
    "check": "which devdash",
    "install_steps": [
      "# Install devdash",
      "# See github.com/Phantas0s/devdash",
      "# apt: sudo apt-get install devdash",
      "# brew: brew install devdash",
      "# cargo: cargo install devdash",
      "# npm: npm install -g devdash",
      "# pip: pip install devdash"
    ]
  },
  "commands": [
    {
      "namespace": "devdash",
      "resource": "devdash",
      "action": "run",
      "description": "Run devdash",
      "adapter": "process",
      "adapterConfig": {
        "command": "devdash",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install devdash from github.com/Phantas0s/devdash"
      },
      "args": []
    }
  ]
}