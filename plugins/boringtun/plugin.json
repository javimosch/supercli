{
  "name": "boringtun",
  "version": "0.1.0",
  "description": "Userspace WireGuard implementation in Rust",
  "source": "https://github.com/cloudflare/boringtun",
  "checks": [
    {
      "type": "binary",
      "name": "boringtun"
    }
  ],
  "install_guidance": {
    "plugin": "boringtun",
    "binary": "boringtun",
    "check": "which boringtun",
    "install_steps": [
      "brew install boringtun",
      "Verify: boringtun --version",
      "supercli plugins install ./plugins/boringtun --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "boringtun",
      "resource": "self",
      "action": "version",
      "description": "Print boringtun version",
      "adapter": "process",
      "adapterConfig": {
        "command": "boringtun",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install boringtun: brew install boringtun"
      },
      "args": []
    },
    {
      "namespace": "boringtun",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to boringtun CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "boringtun",
        "passthrough": true,
        "missingDependencyHelp": "Install boringtun"
      },
      "args": []
    }
  ]
}