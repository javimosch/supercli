{
  "name": "OpenGlass",
  "version": "0.1.0",
  "description": "Turn any glasses into AI-powered smart glasses",
  "source": "https://github.com/OpenGlass/OpenGlass",
  "checks": [
    {
      "type": "binary",
      "name": "openglass"
    }
  ],
  "install_guidance": {
    "plugin": "OpenGlass",
    "binary": "openglass",
    "check": "which openglass",
    "install_steps": [
      "pip install openglass",
      "Verify: openglass --version",
      "supercli plugins install ./plugins/OpenGlass --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenGlass",
      "resource": "self",
      "action": "version",
      "description": "Print OpenGlass version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openglass",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenGlass: pip install openglass"
      },
      "args": []
    },
    {
      "namespace": "OpenGlass",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openglass CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openglass",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenGlass: pip install openglass"
      },
      "args": []
    }
  ]
}