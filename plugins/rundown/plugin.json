{
  "name": "rundown",
  "version": "0.1.0",
  "description": "Run code snippets from markdown files",
  "source": "https://github.com/rundown-io/rundown",
  "checks": [{ "type": "binary", "name": "rundown" }],
  "install_guidance": {
    "plugin": "rundown",
    "binary": "rundown",
    "check": "which rundown",
    "install_steps": ["npm install -g rundown", "Verify: rundown --version", "supercli plugins install ./plugins/rundown --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rundown",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rundown CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rundown",
      "passthrough": true,
      "missingDependencyHelp": "Install rundown: npm install -g rundown", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
