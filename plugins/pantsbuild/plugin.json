{
  "name": "pantsbuild",
  "version": "0.1.0",
  "description": "Scalable build system for Python Java Go and more",
  "source": "https://github.com/pantsbuild/pants",
  "checks": [{ "type": "binary", "name": "pantsbuild" }],
  "install_guidance": {
    "plugin": "pantsbuild",
    "binary": "pantsbuild",
    "check": "which pantsbuild",
    "install_steps": ["curl install", "Verify: pantsbuild --version", "supercli plugins install ./plugins/pantsbuild --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pantsbuild",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pantsbuild CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pantsbuild",
      "passthrough": true,
      "missingDependencyHelp": "Install pantsbuild: curl install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
