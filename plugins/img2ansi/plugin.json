{
  "name": "img2ansi",
  "version": "0.1.0",
  "description": "High-performance image to ANSI terminal art converter",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "img2ansi" }],
  "install_guidance": {
    "plugin": "img2ansi",
    "binary": "img2ansi",
    "check": "which img2ansi",
    "install_steps": ["npm install && node index.js", "Verify: img2ansi --version", "supercli plugins install ./plugins/img2ansi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "img2ansi",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to img2ansi CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "img2ansi",
      "passthrough": true,
      "missingDependencyHelp": "Install img2ansi: npm install && node index.js"
    },
    "args": []
  }]
}
