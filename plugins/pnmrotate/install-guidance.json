{
  "plugin": "pnmrotate",
  "binary": "pnmrotate",
  "check": "which pnmrotate",
  "install_steps": [
    "apt-get install pnmrotate 2>/dev/null || which pnmrotate",
    "Verify: pnmrotate --version",
    "supercli plugins install ./plugins/pnmrotate --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}