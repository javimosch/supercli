{
  "name": "pnmrotate",
  "version": "0.1.0",
  "description": "CLI tool: pnmrotate",
  "source": "https://manpages.debian.org/pnmrotate",
  "checks": [
    {
      "type": "binary",
      "name": "pnmrotate"
    }
  ],
  "install_guidance": {
    "plugin": "pnmrotate",
    "binary": "pnmrotate",
    "check": "which pnmrotate",
    "install_steps": [
      "apt-get install pnmrotate 2>/dev/null || which pnmrotate",
      "Verify: pnmrotate --version",
      "supercli plugins install ./plugins/pnmrotate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmrotate",
      "resource": "self",
      "action": "version",
      "description": "Print pnmrotate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmrotate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmrotate: apt-get install pnmrotate 2>/dev/null || which pnmrotate"
      },
      "args": []
    },
    {
      "namespace": "pnmrotate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmrotate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmrotate",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmrotate: apt-get install pnmrotate 2>/dev/null || which pnmrotate"
      },
      "args": []
    }
  ]
}