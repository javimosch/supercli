{
  "name": "uncloud",
  "version": "0.1.0",
  "description": "A lightweight tool for deploying and managing containerised applications across a network of Docker ",
  "source": "https://github.com/uncloud/uncloud",
  "checks": [
    {
      "type": "binary",
      "name": "uncloud"
    }
  ],
  "install_guidance": {
    "plugin": "uncloud",
    "binary": "uncloud",
    "check": "which uncloud",
    "install_steps": [
      "pip install uncloud",
      "Verify: uncloud --version",
      "supercli plugins install ./plugins/uncloud --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uncloud",
      "resource": "self",
      "action": "version",
      "description": "Print uncloud version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uncloud",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uncloud: pip install uncloud"
      },
      "args": []
    },
    {
      "namespace": "uncloud",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uncloud CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uncloud",
        "passthrough": true,
        "missingDependencyHelp": "Install uncloud: pip install uncloud"
      },
      "args": []
    }
  ]
}