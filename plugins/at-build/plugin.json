{
  "name": "at-build",
  "version": "0.1.0",
  "description": "CLI tool: at-build",
  "source": "https://packages.debian.org/at-build",
  "checks": [{ "type": "binary", "name": "at-build" }],
  "install_guidance": {
    "plugin": "at-build", "binary": "at-build", "check": "which at-build",
    "install_steps": ["apt-get install at-build 2>/dev/null || which at-build", "Verify: at-build --version", "supercli plugins install ./plugins/at-build --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-build", "resource": "_", "action": "_",
    "description": "Passthrough to at-build CLI",
    "adapter": "process", "adapterConfig": { "command": "at-build", "passthrough": true, "missingDependencyHelp": "Install at-build: apt-get install at-build" }, "args": []
  }]
}
