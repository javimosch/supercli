{
  "name": "drgns",
  "version": "0.1.0",
  "description": "Python static analysis for code complexity hotspot detection",
  "source": "https://github.com/keithasaurus/drgns",
  "checks": [{ "type": "binary", "name": "drgns" }],
  "install_guidance": {
    "plugin": "drgns",
    "binary": "drgns",
    "check": "which drgns",
    "install_steps": ["pip install drgns", "Verify: drgns --version", "supercli plugins install ./plugins/drgns --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "drgns",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to drgns CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "drgns",
      "passthrough": true,
      "missingDependencyHelp": "Install drgns: pip install drgns", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
