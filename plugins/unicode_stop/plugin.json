{
  "name": "unicode_stop",
  "version": "0.1.0",
  "description": "CLI tool: unicode_stop",
  "source": "https://manpages.debian.org/unicode_stop",
  "checks": [
    {
      "type": "binary",
      "name": "unicode_stop"
    }
  ],
  "install_guidance": {
    "plugin": "unicode_stop",
    "binary": "unicode_stop",
    "check": "which unicode_stop",
    "install_steps": [
      "apt-get install unicode_stop 2>/dev/null || which unicode_stop",
      "Verify: unicode_stop --version",
      "supercli plugins install ./plugins/unicode_stop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unicode_stop",
      "resource": "self",
      "action": "version",
      "description": "Print unicode_stop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unicode_stop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unicode_stop: apt-get install unicode_stop 2>/dev/null || which unicode_stop"
      },
      "args": []
    },
    {
      "namespace": "unicode_stop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unicode_stop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unicode_stop",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unicode_stop: apt-get install unicode_stop 2>/dev/null || which unicode_stop"
      },
      "args": []
    }
  ]
}