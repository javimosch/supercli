{
  "name": "kissat",
  "version": "0.1.0",
  "description": "Bare metal SAT solver",
  "source": "https://github.com/arminbiere/kissat",
  "checks": [
    {
      "type": "binary",
      "name": "kissat"
    }
  ],
  "install_guidance": {
    "plugin": "kissat",
    "binary": "kissat",
    "check": "which kissat",
    "install_steps": [
      "brew install kissat",
      "Verify: kissat --version",
      "supercli plugins install ./plugins/kissat --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kissat",
      "resource": "self",
      "action": "version",
      "description": "Print kissat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kissat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kissat: brew install kissat"
      },
      "args": []
    },
    {
      "namespace": "kissat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kissat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kissat",
        "passthrough": true,
        "missingDependencyHelp": "Install kissat"
      },
      "args": []
    }
  ]
}