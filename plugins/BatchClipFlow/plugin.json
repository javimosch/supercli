{
  "name": "BatchClipFlow",
  "version": "0.1.0",
  "description": "TempleClipFlow - 专为佛教寺院与义工设计的视频批量剪辑管理系统。支持多项目管理、自动保存、断电保护与无损流式剪辑，内置法师开示、法会记录等定制分类，助力弘法素材高效处理。",
  "source": "https://github.com/BatchClipFlow/BatchClipFlow",
  "checks": [
    {
      "type": "binary",
      "name": "BatchClipFlow"
    }
  ],
  "install_guidance": {
    "plugin": "BatchClipFlow",
    "binary": "BatchClipFlow",
    "check": "which BatchClipFlow",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: BatchClipFlow --version",
      "supercli plugins install ./plugins/BatchClipFlow --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "BatchClipFlow",
      "resource": "self",
      "action": "version",
      "description": "Print BatchClipFlow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "BatchClipFlow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BatchClipFlow from project repository"
      },
      "args": []
    },
    {
      "namespace": "BatchClipFlow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to BatchClipFlow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "BatchClipFlow",
        "passthrough": true,
        "missingDependencyHelp": "Install BatchClipFlow from project repository"
      },
      "args": []
    }
  ]
}