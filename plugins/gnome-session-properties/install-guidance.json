{
  "plugin": "gnome-session-properties",
  "binary": "gnome-session-properties",
  "check": "which gnome-session-properties",
  "install_steps": [
    "apt-get install gnome-session-properties 2>/dev/null || which gnome-session-properties",
    "Verify: gnome-session-properties --version",
    "supercli plugins install ./plugins/gnome-session-properties --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}