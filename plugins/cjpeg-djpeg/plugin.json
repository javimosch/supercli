{
  "name": "cjpeg-djpeg",
  "version": "0.1.0",
  "description": "Compress and decompress JPEG images from the command line",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "cjpeg-djpeg" }],
  "install_guidance": {
    "plugin": "cjpeg-djpeg",
    "binary": "cjpeg-djpeg",
    "check": "which cjpeg-djpeg",
    "install_steps": ["sudo apt install libjpeg-turbo-progs", "Verify: cjpeg-djpeg --version", "supercli plugins install ./plugins/cjpeg-djpeg --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cjpeg-djpeg",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cjpeg-djpeg CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cjpeg-djpeg",
      "passthrough": true,
      "missingDependencyHelp": "Install cjpeg-djpeg: sudo apt install libjpeg-turbo-progs"
    },
    "args": []
  }]
}
