{
  "name": "acp",
  "version": "0.1.0",
  "description": "acp — Agent Communication Protocol CLI. List, inspect, and interact with 35+ ACP coding agents (Claude, Gemini, Cursor, Copilot, Cline, Goose, Codex, Kilo, Junie, Qwen, Mistral, Kimi, OpenCode, etc.)",
  "source": "https://github.com/agentclientprotocol/agent-client-protocol",
  "checks": [
    { "type": "binary", "name": "npx" }
  ],
  "install_guidance": {
    "plugin": "acp",
    "binary": "npx",
    "check": "which npx",
    "install_steps": [
      "npx is included with Node.js (nodejs.org)",
      "Verify: npx --version",
      "supercli plugins install ./plugins/acp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "acp",
      "resource": "registry",
      "action": "list",
      "description": "List all ACP agents from registry",
      "adapter": "process",
      "adapterConfig": {
        "command": "curl",
        "baseArgs": ["-s", "https://cdn.agentclientprotocol.com/registry/v1/latest/registry.json"],
        "timeout_ms": 10000,
        "missingDependencyHelp": "Install curl"
      },
      "args": []
    },
    {
      "namespace": "acp",
      "resource": "registry",
      "action": "info",
      "description": "Get info about a specific ACP agent",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "baseArgs": ["-c"],
        "positionalArgs": ["agent_id"],
        "timeout_ms": 10000,
        "missingDependencyHelp": "Install bash"
      },
      "args": [
        { "name": "agent_id", "type": "string", "required": true, "description": "ACP agent ID (e.g., claude-acp, gemini, cursor)" }
      ]
    },
    {
      "namespace": "acp",
      "resource": "server",
      "action": "start",
      "description": "Start an ACP agent server via npx (read-only mode)",
      "adapter": "process",
      "adapterConfig": {
        "command": "npx",
        "positionalArgs": ["package"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install Node.js to get npx"
      },
      "args": [
        { "name": "package", "type": "string", "required": true, "description": "npm package to run (e.g., @agentclientprotocol/claude-agent-acp)" },
        { "name": "args", "type": "string", "required": false, "description": "Additional args (e.g., -- --acp)" }
      ]
    },
    {
      "namespace": "acp",
      "resource": "server",
      "action": "claude",
      "description": "Start Claude Agent ACP server",
      "adapter": "process",
      "adapterConfig": {
        "command": "npx",
        "baseArgs": ["@agentclientprotocol/claude-agent-acp"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install Node.js. Requires ANTHROPIC_API_KEY"
      },
      "args": []
    },
