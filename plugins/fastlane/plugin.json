{
  "name": "fastlane",
  "version": "1.0.0",
  "description": "fastlane \u2014 Mobile release",
  "source": "fastlane.tools",
  "checks": [
    {
      "type": "binary",
      "name": "fastlane"
    }
  ],
  "install_guidance": {
    "plugin": "fastlane",
    "binary": "fastlane",
    "check": "which fastlane",
    "install_steps": [
      "# Install fastlane",
      "# See fastlane.tools",
      "# apt: sudo apt-get install fastlane",
      "# brew: brew install fastlane",
      "# cargo: cargo install fastlane",
      "# npm: npm install -g fastlane",
      "# pip: pip install fastlane"
    ]
  },
  "commands": [
    {
      "namespace": "fastlane",
      "resource": "fastlane",
      "action": "run",
      "description": "Run fastlane",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastlane",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fastlane from fastlane.tools"
      },
      "args": []
    }
  ]
}