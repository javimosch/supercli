{
  "name": "ScribaPDFParserCLI",
  "version": "0.1.0",
  "description": "Scriba - PDF Parser [CLI] | PDF parsing pipeline for Scriba",
  "source": "https://github.com/ScribaPDFParserCLI/ScribaPDFParserCLI",
  "checks": [
    {
      "type": "binary",
      "name": "ScribaPDFParserCLI"
    }
  ],
  "install_guidance": {
    "plugin": "ScribaPDFParserCLI",
    "binary": "ScribaPDFParserCLI",
    "check": "which ScribaPDFParserCLI",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: ScribaPDFParserCLI --version",
      "supercli plugins install ./plugins/ScribaPDFParserCLI --on-conflict replace --json"
    ],
    "note": "Swift language CLI tool"
  },
  "commands": [
    {
      "namespace": "ScribaPDFParserCLI",
      "resource": "self",
      "action": "version",
      "description": "Print ScribaPDFParserCLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ScribaPDFParserCLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ScribaPDFParserCLI from project repository"
      },
      "args": []
    },
    {
      "namespace": "ScribaPDFParserCLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ScribaPDFParserCLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ScribaPDFParserCLI",
        "passthrough": true,
        "missingDependencyHelp": "Install ScribaPDFParserCLI from project repository"
      },
      "args": []
    }
  ]
}