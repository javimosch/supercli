{
  "name": "Batch-audio-clips",
  "version": "0.1.0",
  "description": "批量音频剪辑，用于批量剪辑有声小说Tag（前xx秒，后xx秒）。",
  "source": "https://github.com/Batch-audio-clips/Batch-audio-clips",
  "checks": [
    {
      "type": "binary",
      "name": "Batch-audio-clips"
    }
  ],
  "install_guidance": {
    "plugin": "Batch-audio-clips",
    "binary": "Batch-audio-clips",
    "check": "which Batch-audio-clips",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Batch-audio-clips --version",
      "supercli plugins install ./plugins/Batch-audio-clips --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "Batch-audio-clips",
      "resource": "self",
      "action": "version",
      "description": "Print Batch-audio-clips version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Batch-audio-clips",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Batch-audio-clips from project repository"
      },
      "args": []
    },
    {
      "namespace": "Batch-audio-clips",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Batch-audio-clips CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Batch-audio-clips",
        "passthrough": true,
        "missingDependencyHelp": "Install Batch-audio-clips from project repository"
      },
      "args": []
    }
  ]
}