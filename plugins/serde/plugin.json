{
  "name": "serde",
  "version": "0.1.0",
  "description": "Serde — serialization framework for Rust",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "serde"
    }
  ],
  "install_guidance": {
    "plugin": "serde",
    "binary": "serde",
    "check": "which serde",
    "install_steps": [
      "cargo install serde",
      "Verify: serde --version",
      "supercli plugins install ./plugins/serde --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "serde",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "serde",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install serde"
      },
      "args": []
    }
  ]
}
