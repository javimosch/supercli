{
  "name": "pipsi",
  "version": "0.1.0",
  "description": "Install Python scripts into isolated virtualenvs",
  "source": "https://github.com/mitsuhiko/pipsi",
  "checks": [{ "type": "binary", "name": "pipsi" }],
  "install_guidance": {
    "plugin": "pipsi",
    "binary": "pipsi",
    "check": "which pipsi",
    "install_steps": ["pip install pipsi", "Verify: pipsi --version", "supercli plugins install ./plugins/pipsi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipsi",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipsi CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipsi",
      "passthrough": true,
      "missingDependencyHelp": "Install pipsi: pip install pipsi", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
