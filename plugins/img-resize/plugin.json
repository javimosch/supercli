{
  "name": "img-resize",
  "version": "0.1.0",
  "description": "Batch resize images to specified dimensions from CLI",
  "source": "https://github.com/johndoe/img-resize",
  "checks": [{ "type": "binary", "name": "img-resize" }],
  "install_guidance": {
    "plugin": "img-resize",
    "binary": "img-resize",
    "check": "which img-resize",
    "install_steps": ["pip install img-resize", "Verify: img-resize --version", "supercli plugins install ./plugins/img-resize --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "img-resize",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to img-resize CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "img-resize",
      "passthrough": true,
      "missingDependencyHelp": "Install img-resize: pip install img-resize", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
