{
  "name": "qemu",
  "version": "1.0.0",
  "description": "qemu \u2014 Machine emulator CLI",
  "source": "qemu.org",
  "checks": [
    {
      "type": "binary",
      "name": "qemu"
    }
  ],
  "install_guidance": {
    "plugin": "qemu",
    "binary": "qemu",
    "check": "which qemu",
    "install_steps": [
      "# Install qemu:",
      "# apt: sudo apt-get install qemu",
      "# brew: brew install qemu",
      "# cargo: cargo install qemu",
      "# npm: npm install -g qemu",
      "# pip: pip install qemu",
      "# or download from qemu.org"
    ]
  },
  "commands": [
    {
      "namespace": "qemu",
      "resource": "qemu",
      "action": "run",
      "description": "Run qemu",
      "adapter": "process",
      "adapterConfig": {
        "command": "qemu",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install qemu from qemu.org"
      },
      "args": []
    }
  ]
}