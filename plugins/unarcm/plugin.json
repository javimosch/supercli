{
  "name": "unarcm",
  "version": "0.1.0",
  "description": "RAR and multiple archive format extractor",
  "source": "https://github.com/MacPaw/unar",
  "checks": [
    {
      "type": "binary",
      "name": "unarcm"
    }
  ],
  "install_guidance": {
    "plugin": "unarcm",
    "binary": "unarcm",
    "check": "which unarcm",
    "install_steps": [
      "brew install unar",
      "Verify: unarcm --version",
      "supercli plugins install ./plugins/unarcm --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "unarcm",
      "resource": "self",
      "action": "version",
      "description": "Print unarcm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unarcm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unarcm: brew install unar"
      },
      "args": []
    },
    {
      "namespace": "unarcm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unarcm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unarcm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unarcm: brew install unar"
      },
      "args": []
    }
  ]
}
