      "args": []
    },
    {
      "namespace": "my-tv-0",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to my-tv-0 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "my-tv-0",
