{
  "name": "kubetail",
  "version": "0.1.0",
  "description": "Bash script to tail Kubernetes logs from multiple pods",
  "source": "https://github.com/johanhaleby/kubetail",
  "checks": [{ "type": "binary", "name": "kubetail" }],
  "install_guidance": {
    "plugin": "kubetail",
    "binary": "kubetail",
    "check": "which kubetail",
    "install_steps": ["brew install kubetail", "Verify: kubetail --version", "supercli plugins install ./plugins/kubetail --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubetail",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubetail CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubetail",
      "passthrough": true,
      "missingDependencyHelp": "Install kubetail: brew install kubetail"
    },
    "args": []
  }]
}
