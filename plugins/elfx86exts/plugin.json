{
  "name": "elfx86exts",
  "version": "0.1.0",
  "description": "Decodes x86 binaries (ELF and Mach-O) and prints out ISA extensions in use",
  "source": "https://github.com/pkgw/elfx86exts",
  "checks": [
    {
      "type": "binary",
      "name": "elfx86exts"
    }
  ],
  "install_guidance": {
    "plugin": "elfx86exts",
    "binary": "elfx86exts",
    "check": "which elfx86exts",
    "install_steps": [
      "brew install elfx86exts",
      "Verify: elfx86exts --version",
      "supercli plugins install ./plugins/elfx86exts --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "elfx86exts",
      "resource": "self",
      "action": "version",
      "description": "Print elfx86exts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "elfx86exts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install elfx86exts: brew install elfx86exts"
      },
      "args": []
    },
    {
      "namespace": "elfx86exts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to elfx86exts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "elfx86exts",
        "passthrough": true,
        "missingDependencyHelp": "Install elfx86exts"
      },
      "args": []
    }
  ]
}