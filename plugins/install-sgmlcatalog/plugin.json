{
  "name": "install-sgmlcatalog",
  "version": "0.1.0",
  "description": "CLI tool: install-sgmlcatalog",
  "source": "https://manpages.debian.org/install-sgmlcatalog",
  "checks": [
    {
      "type": "binary",
      "name": "install-sgmlcatalog"
    }
  ],
  "install_guidance": {
    "plugin": "install-sgmlcatalog",
    "binary": "install-sgmlcatalog",
    "check": "which install-sgmlcatalog",
    "install_steps": [
      "apt-get install install-sgmlcatalog 2>/dev/null || which install-sgmlcatalog",
      "Verify: install-sgmlcatalog --version",
      "supercli plugins install ./plugins/install-sgmlcatalog --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "install-sgmlcatalog",
      "resource": "self",
      "action": "version",
      "description": "Print install-sgmlcatalog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-sgmlcatalog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install install-sgmlcatalog: apt-get install install-sgmlcatalog 2>/dev/null || which install-sgmlcatalog"
      },
      "args": []
    },
    {
      "namespace": "install-sgmlcatalog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to install-sgmlcatalog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-sgmlcatalog",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install install-sgmlcatalog: apt-get install install-sgmlcatalog 2>/dev/null || which install-sgmlcatalog"
      },
      "args": []
    }
  ]
}