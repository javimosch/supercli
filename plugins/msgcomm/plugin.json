{
  "name": "msgcomm",
  "version": "0.1.0",
  "description": "CLI tool: msgcomm",
  "source": "https://manpages.debian.org/msgcomm",
  "checks": [
    {
      "type": "binary",
      "name": "msgcomm"
    }
  ],
  "install_guidance": {
    "plugin": "msgcomm",
    "binary": "msgcomm",
    "check": "which msgcomm",
    "install_steps": [
      "apt-get install msgcomm 2>/dev/null || which msgcomm",
      "Verify: msgcomm --version",
      "supercli plugins install ./plugins/msgcomm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "msgcomm",
      "resource": "self",
      "action": "version",
      "description": "Print msgcomm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "msgcomm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install msgcomm: apt-get install msgcomm 2>/dev/null || which msgcomm"
      },
      "args": []
    },
    {
      "namespace": "msgcomm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to msgcomm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "msgcomm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install msgcomm: apt-get install msgcomm 2>/dev/null || which msgcomm"
      },
      "args": []
    }
  ]
}