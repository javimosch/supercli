{
  "name": "scanopy",
  "version": "0.1.0",
  "description": "Network diagrams that update themselves",
  "source": "https://github.com/scanopy/scanopy",
  "checks": [
    {
      "type": "binary",
      "name": "scanopy"
    }
  ],
  "install_guidance": {
    "plugin": "scanopy",
    "binary": "scanopy",
    "check": "which scanopy",
    "install_steps": [
      "pip install scanopy",
      "Verify: scanopy --version",
      "supercli plugins install ./plugins/scanopy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "scanopy",
      "resource": "self",
      "action": "version",
      "description": "Print scanopy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scanopy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scanopy: pip install scanopy"
      },
      "args": []
    },
    {
      "namespace": "scanopy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scanopy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scanopy",
        "passthrough": true,
        "missingDependencyHelp": "Install scanopy: pip install scanopy"
      },
      "args": []
    }
  ]
}