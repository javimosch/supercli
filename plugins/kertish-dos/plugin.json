{
  "name": "kertish-dos",
  "version": "0.1.0",
  "description": "Kertish Object Storage and Cluster Administration CLI",
  "source": "https://github.com/freakmaxi/kertish-dos",
  "checks": [
    {
      "type": "binary",
      "name": "kertish-dos"
    }
  ],
  "install_guidance": {
    "plugin": "kertish-dos",
    "binary": "kertish-dos",
    "check": "which kertish-dos",
    "install_steps": [
      "brew install kertish-dos",
      "Verify: kertish-dos --version",
      "supercli plugins install ./plugins/kertish-dos --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kertish-dos",
      "resource": "self",
      "action": "version",
      "description": "Print kertish-dos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kertish-dos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kertish-dos: brew install kertish-dos"
      },
      "args": []
    },
    {
      "namespace": "kertish-dos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kertish-dos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kertish-dos",
        "passthrough": true,
        "missingDependencyHelp": "Install kertish-dos"
      },
      "args": []
    }
  ]
}