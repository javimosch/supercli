{
  "name": "inotify-tools",
  "version": "1.0.0",
  "description": "inotify-tools \u2014 File event monitor",
  "source": "github.com/inotify-tools/inotify-tools",
  "checks": [
    {
      "type": "binary",
      "name": "inotifywait"
    }
  ],
  "install_guidance": {
    "plugin": "inotify-tools",
    "binary": "inotifywait",
    "check": "which inotifywait",
    "install_steps": [
      "# Install inotify-tools",
      "# See github.com/inotify-tools/inotify-tools",
      "# apt: sudo apt-get install inotify-tools",
      "# brew: brew install inotify-tools",
      "# cargo: cargo install inotify-tools",
      "# npm: npm install -g inotify-tools",
      "# pip: pip install inotify-tools"
    ]
  },
  "commands": [
    {
      "namespace": "inotify",
      "resource": "tools",
      "action": "run",
      "description": "Run inotify-tools",
      "adapter": "process",
      "adapterConfig": {
        "command": "inotifywait",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install inotify-tools from github.com/inotify-tools/inotify-tools"
      },
      "args": []
    }
  ]
}