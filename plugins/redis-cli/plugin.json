{
  "name": "redis-cli",
  "version": "0.1.0",
  "description": "Redis command-line client and management tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "redis-cli"}],
  "install_guidance": {
    "plugin": "redis-cli",
    "binary": "redis-cli",
    "check": "which redis-cli",
    "install_steps": [
      "brew install redis",
      "Verify: redis-cli --version",
      "supercli plugins install ./plugins/redis-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "redis-cli",
      "resource": "self",
      "action": "version",
      "description": "Print redis-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "redis-cli", "baseArgs": ["--version"], "missingDependencyHelp": "Install redis-cli: brew install redis"},
      "args": []
    },
    {
      "namespace": "redis-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to redis-cli CLI",
      "adapter": "process",
      "adapterConfig": {"command": "redis-cli", "passthrough": true, "missingDependencyHelp": "Install redis-cli: brew install redis"},
      "args": []
    }
  ]
}
