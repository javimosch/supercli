{
  "name": "memvid",
  "version": "0.1.0",
  "description": "Memory layer for AI Agents. Replace complex RAG pipelines with a serverless, single-file memory laye",
  "source": "https://github.com/memvid/memvid",
  "checks": [
    {
      "type": "binary",
      "name": "memvid"
    }
  ],
  "install_guidance": {
    "plugin": "memvid",
    "binary": "memvid",
    "check": "which memvid",
    "install_steps": [
      "pip install memvid",
      "Verify: memvid --version",
      "supercli plugins install ./plugins/memvid --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "memvid",
      "resource": "self",
      "action": "version",
      "description": "Print memvid version",
      "adapter": "process",
      "adapterConfig": {
        "command": "memvid",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install memvid: pip install memvid"
      },
      "args": []
    },
    {
      "namespace": "memvid",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to memvid CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "memvid",
        "passthrough": true,
        "missingDependencyHelp": "Install memvid: pip install memvid"
      },
      "args": []
    }
  ]
}