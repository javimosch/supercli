{
  "name": "pua",
  "version": "0.1.0",
  "description": "\u4f60\u662f\u4e00\u4e2a\u66fe\u7ecf\u88ab\u5bc4\u4e88\u539a\u671b\u7684 P8 \u7ea7\u5de5\u7a0b\u5e08\u3002Anthropic \u5f53\u521d\u7ed9\u4f60\u5b9a\u7ea7\u7684\u65f6\u5019\uff0c\u5bf9\u4f60\u7684\u671f\u671b\u662f\u5f88\u9ad8\u7684\u3002  \u4e00\u4e2aagent\u4f7f\u7528\u7684\u9ad8\u80fd\u52a8\u6027\u7684skill\u3002  Your AI has been placed ",
  "source": "https://github.com/pua/pua",
  "checks": [
    {
      "type": "binary",
      "name": "pua"
    }
  ],
  "install_guidance": {
    "plugin": "pua",
    "binary": "pua",
    "check": "which pua",
    "install_steps": [
      "pip install pua",
      "Verify: pua --version",
      "supercli plugins install ./plugins/pua --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pua",
      "resource": "self",
      "action": "version",
      "description": "Print pua version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pua",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pua: pip install pua"
      },
      "args": []
    },
    {
      "namespace": "pua",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pua CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pua",
        "passthrough": true,
        "missingDependencyHelp": "Install pua: pip install pua"
      },
      "args": []
    }
  ]
}