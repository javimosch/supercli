{
  "name": "libb2",
  "version": "0.1.0",
  "description": "Secure hashing function",
  "checks": [
    {
      "type": "binary",
      "name": "libb2"
    }
  ],
  "install_guidance": {
    "plugin": "libb2",
    "binary": "libb2",
    "check": "which libb2",
    "install_steps": [
      "brew install libb2",
      "Verify: libb2 --version",
      "supercli plugins install ./plugins/libb2 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libb2",
      "resource": "self",
      "action": "version",
      "description": "Print libb2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libb2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libb2: brew install libb2"
      },
      "args": []
    },
    {
      "namespace": "libb2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libb2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libb2",
        "passthrough": true,
        "missingDependencyHelp": "Install libb2"
      },
      "args": []
    }
  ]
}