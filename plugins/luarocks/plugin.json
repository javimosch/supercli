{
  "name": "luarocks",
  "version": "0.1.0",
  "description": "Lua package manager",
  "source": "https://packages.debian.org/luarocks",
  "checks": [{ "type": "binary", "name": "luarocks" }],
  "install_guidance": {
    "plugin": "luarocks", "binary": "luarocks", "check": "which luarocks",
    "install_steps": ["apt-get install luarocks", "Verify: luarocks --version", "supercli plugins install ./plugins/luarocks --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "luarocks", "resource": "_", "action": "_",
    "description": "Passthrough to luarocks CLI",
    "adapter": "process", "adapterConfig": { "command": "luarocks", "passthrough": true, "missingDependencyHelp": "Install luarocks: apt-get install luarocks" }, "args": []
  }]
}
