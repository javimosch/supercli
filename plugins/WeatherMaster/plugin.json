{
  "name": "WeatherMaster",
  "version": "0.1.0",
  "description": "A Weather app for android \ud83c\udf26\ud83c\udf1e\u2614",
  "source": "https://github.com/WeatherMaster/WeatherMaster",
  "checks": [
    {
      "type": "binary",
      "name": "weathermaster"
    }
  ],
  "install_guidance": {
    "plugin": "WeatherMaster",
    "binary": "weathermaster",
    "check": "which weathermaster",
    "install_steps": [
      "pip install weathermaster",
      "Verify: weathermaster --version",
      "supercli plugins install ./plugins/WeatherMaster --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "WeatherMaster",
      "resource": "self",
      "action": "version",
      "description": "Print WeatherMaster version",
      "adapter": "process",
      "adapterConfig": {
        "command": "weathermaster",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install WeatherMaster: pip install weathermaster"
      },
      "args": []
    },
    {
      "namespace": "WeatherMaster",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to weathermaster CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "weathermaster",
        "passthrough": true,
        "missingDependencyHelp": "Install WeatherMaster: pip install weathermaster"
      },
      "args": []
    }
  ]
}