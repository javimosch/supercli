{
  "name": "glycerin",
  "version": "1.0.0",
  "description": "glycerin \u2014 CLI git helper",
  "source": "github.com/glycerin/glycerin",
  "checks": [
    {
      "type": "binary",
      "name": "glycerin"
    }
  ],
  "install_guidance": {
    "plugin": "glycerin",
    "binary": "glycerin",
    "check": "which glycerin",
    "install_steps": [
      "# Install glycerin",
      "# See github.com/glycerin/glycerin",
      "# apt: sudo apt-get install glycerin",
      "# brew: brew install glycerin",
      "# cargo: cargo install glycerin",
      "# npm: npm install -g glycerin",
      "# pip: pip install glycerin"
    ]
  },
  "commands": [
    {
      "namespace": "glycerin",
      "resource": "glycerin",
      "action": "run",
      "description": "Run glycerin",
      "adapter": "process",
      "adapterConfig": {
        "command": "glycerin",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install glycerin from github.com/glycerin/glycerin"
      },
      "args": []
    }
  ]
}