{
  "name": "llm-wiki-skill",
  "version": "0.1.0",
  "description": "\u57fa\u4e8e Karpathy llm-wiki \u65b9\u6cd5\u8bba\u7684\u4e2a\u4eba\u77e5\u8bc6\u5e93\u6784\u5efa Skill\uff0c\u652f\u6301\u591a\u5e73\u53f0\uff01",
  "source": "https://github.com/llm-wiki-skill/llm-wiki-skill",
  "checks": [
    {
      "type": "binary",
      "name": "llm-wiki-skill"
    }
  ],
  "install_guidance": {
    "plugin": "llm-wiki-skill",
    "binary": "llm-wiki-skill",
    "check": "which llm-wiki-skill",
    "install_steps": [
      "pip install llm-wiki-skill",
      "Verify: llm-wiki-skill --version",
      "supercli plugins install ./plugins/llm-wiki-skill --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "llm-wiki-skill",
      "resource": "self",
      "action": "version",
      "description": "Print llm-wiki-skill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llm-wiki-skill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llm-wiki-skill: pip install llm-wiki-skill"
      },
      "args": []
    },
    {
      "namespace": "llm-wiki-skill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llm-wiki-skill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llm-wiki-skill",
        "passthrough": true,
        "missingDependencyHelp": "Install llm-wiki-skill: pip install llm-wiki-skill"
      },
      "args": []
    }
  ]
}