{
  "plugin": "m-cli",
  "binary": "m-cli",
  "check": "which m-cli",
  "install_steps": [
    "# Install m-cli",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/m-cli-linux-amd64 -o /usr/local/bin/m-cli",
    "chmod +x /usr/local/bin/m-cli",
    "# Or via package manager, see github.com/rgcr/m-cli"
  ]
}