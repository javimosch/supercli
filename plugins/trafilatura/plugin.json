{
  "name": "trafilatura",
  "version": "0.1.0",
  "description": "Web scraping and text extraction from HTML pages",
  "source": "https://github.com/adbar/trafilatura",
  "checks": [{ "type": "binary", "name": "trafilatura" }],
  "install_guidance": {
    "plugin": "trafilatura",
    "binary": "trafilatura",
    "check": "which trafilatura",
    "install_steps": ["pip install trafilatura", "Verify: trafilatura --version", "supercli plugins install ./plugins/trafilatura --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "trafilatura",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to trafilatura CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "trafilatura",
      "passthrough": true,
      "missingDependencyHelp": "Install trafilatura: pip install trafilatura", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
