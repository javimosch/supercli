{
  "name": "agetty",
  "version": "0.1.0",
  "description": "CLI tool: agetty",
  "source": "https://packages.debian.org/agetty",
  "checks": [{ "type": "binary", "name": "agetty" }],
  "install_guidance": {
    "plugin": "agetty", "binary": "agetty", "check": "which agetty",
    "install_steps": ["apt-get install agetty 2>/dev/null || which agetty", "Verify: agetty --version", "supercli plugins install ./plugins/agetty --on-conflict replace --json"]
