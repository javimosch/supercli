{
  "name": "todotxt-machine",
  "version": "0.1.0",
  "description": "Interface for todo.txt.",
  "source": "https://github.com/AnthonyDiGirolamo/todotxt-machine",
  "checks": [
    {
      "type": "binary",
      "name": "todotxt-machine"
    }
  ],
  "install_guidance": {
    "plugin": "todotxt-machine",
    "binary": "todotxt-machine",
    "check": "which todotxt-machine",
    "install_steps": [
      "See https://github.com/AnthonyDiGirolamo/todotxt-machine",
      "Verify: todotxt-machine --version",
      "supercli plugins install ./plugins/todotxt-machine --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "todotxt-machine",
      "resource": "self",
      "action": "version",
      "description": "Print todotxt-machine version",
      "adapter": "process",
      "adapterConfig": {
        "command": "todotxt-machine",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install todotxt-machine: See https://github.com/AnthonyDiGirolamo/todotxt-machine"
      },
      "args": []
    },
    {
      "namespace": "todotxt-machine",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to todotxt-machine CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "todotxt-machine",
        "passthrough": true,
        "missingDependencyHelp": "Install todotxt-machine"
      },
      "args": []
    }
  ]
}