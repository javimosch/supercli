{
  "plugin": "qmllint",
  "binary": "qmllint",
  "check": "which qmllint",
  "install_steps": [
    "apt-get install qmllint 2>/dev/null || which qmllint",
    "Verify: qmllint --version",
    "supercli plugins install ./plugins/qmllint --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}