{
  "name": "qmllint",
  "version": "0.1.0",
  "description": "CLI tool: qmllint",
  "source": "https://manpages.debian.org/qmllint",
  "checks": [
    {
      "type": "binary",
      "name": "qmllint"
    }
  ],
  "install_guidance": {
    "plugin": "qmllint",
    "binary": "qmllint",
    "check": "which qmllint",
    "install_steps": [
      "apt-get install qmllint 2>/dev/null || which qmllint",
      "Verify: qmllint --version",
      "supercli plugins install ./plugins/qmllint --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmllint",
      "resource": "self",
      "action": "version",
      "description": "Print qmllint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmllint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmllint: apt-get install qmllint 2>/dev/null || which qmllint"
      },
      "args": []
    },
    {
      "namespace": "qmllint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmllint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmllint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmllint: apt-get install qmllint 2>/dev/null || which qmllint"
      },
      "args": []
    }
  ]
}