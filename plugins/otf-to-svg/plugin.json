{
  "name": "otf-to-svg",
  "version": "0.1.0",
  "description": "Quick command-line converter for OTF/TTF fonts to SVG format",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "otf-to-svg" }],
  "install_guidance": {
    "plugin": "otf-to-svg",
    "binary": "otf-to-svg",
    "check": "which otf-to-svg",
    "install_steps": ["npm install -g otf-to-svg", "Verify: otf-to-svg --version", "supercli plugins install ./plugins/otf-to-svg --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "otf-to-svg",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to otf-to-svg CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "otf-to-svg",
      "passthrough": true,
      "missingDependencyHelp": "Install otf-to-svg: npm install -g otf-to-svg"
    },
    "args": []
  }]
}
