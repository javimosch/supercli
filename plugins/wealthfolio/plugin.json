{
  "name": "wealthfolio",
  "version": "0.1.0",
  "description": "A beautiful, private, local-first personal finance tracker. Investments, net worth, spending, and si",
  "source": "https://github.com/wealthfolio/wealthfolio",
  "checks": [
    {
      "type": "binary",
      "name": "wealthfolio"
    }
  ],
  "install_guidance": {
    "plugin": "wealthfolio",
    "binary": "wealthfolio",
    "check": "which wealthfolio",
    "install_steps": [
      "pip install wealthfolio",
      "Verify: wealthfolio --version",
      "supercli plugins install ./plugins/wealthfolio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wealthfolio",
      "resource": "self",
      "action": "version",
      "description": "Print wealthfolio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wealthfolio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wealthfolio: pip install wealthfolio"
      },
      "args": []
    },
    {
      "namespace": "wealthfolio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wealthfolio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wealthfolio",
        "passthrough": true,
        "missingDependencyHelp": "Install wealthfolio: pip install wealthfolio"
      },
      "args": []
    }
  ]
}