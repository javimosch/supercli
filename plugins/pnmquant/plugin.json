{
  "name": "pnmquant",
  "version": "0.1.0",
  "description": "CLI tool: pnmquant",
  "source": "https://manpages.debian.org/pnmquant",
  "checks": [
    {
      "type": "binary",
      "name": "pnmquant"
    }
  ],
  "install_guidance": {
    "plugin": "pnmquant",
    "binary": "pnmquant",
    "check": "which pnmquant",
    "install_steps": [
      "apt-get install pnmquant 2>/dev/null || which pnmquant",
      "Verify: pnmquant --version",
      "supercli plugins install ./plugins/pnmquant --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmquant",
      "resource": "self",
      "action": "version",
      "description": "Print pnmquant version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmquant",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmquant: apt-get install pnmquant 2>/dev/null || which pnmquant"
      },
      "args": []
    },
    {
      "namespace": "pnmquant",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmquant CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmquant",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmquant: apt-get install pnmquant 2>/dev/null || which pnmquant"
      },
      "args": []
    }
  ]
}