{
  "name": "ppmbrighten",
  "version": "0.1.0",
  "description": "CLI tool: ppmbrighten",
  "source": "https://manpages.debian.org/ppmbrighten",
  "checks": [
    {
      "type": "binary",
      "name": "ppmbrighten"
    }
  ],
  "install_guidance": {
    "plugin": "ppmbrighten",
    "binary": "ppmbrighten",
    "check": "which ppmbrighten",
    "install_steps": [
      "apt-get install ppmbrighten 2>/dev/null || which ppmbrighten",
      "Verify: ppmbrighten --version",
      "supercli plugins install ./plugins/ppmbrighten --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmbrighten",
      "resource": "self",
      "action": "version",
      "description": "Print ppmbrighten version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmbrighten",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmbrighten: apt-get install ppmbrighten 2>/dev/null || which ppmbrighten"
      },
      "args": []
    },
    {
      "namespace": "ppmbrighten",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmbrighten CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmbrighten",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmbrighten: apt-get install ppmbrighten 2>/dev/null || which ppmbrighten"
      },
      "args": []
    }
  ]
}