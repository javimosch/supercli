{
  "name": "postalias",
  "version": "1.0.0",
  "description": "postalias \u2014 postalias \u2014 CLI utility",
  "source": "/usr/sbin/postalias",
  "checks": [
    {
      "type": "binary",
      "name": "postalias"
    }
  ],
  "install_guidance": {
    "plugin": "postalias",
    "binary": "postalias",
    "check": "which postalias",
    "install_steps": [
      "# Install postalias:",
      "# apt: sudo apt-get install postalias",
      "# brew: brew install postalias",
      "# cargo: cargo install postalias",
      "# npm: npm install -g postalias",
      "# pip: pip install postalias",
      "# or download from /usr/sbin/postalias"
    ]
  },
  "commands": [
    {
      "namespace": "postalias",
      "resource": "postalias",
      "action": "run",
      "description": "Run postalias",
      "adapter": "process",
      "adapterConfig": {
        "command": "postalias",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postalias from /usr/sbin/postalias"
      },
      "args": []
    }
  ]
}