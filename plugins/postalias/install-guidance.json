{
  "plugin": "postalias",
  "binary": "postalias",
  "check": "which postalias",
  "install_steps": [
    "# Install postalias",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/postalias-linux-amd64 -o /usr/local/bin/postalias",
    "chmod +x /usr/local/bin/postalias",
    "# Or via package manager, see /usr/sbin/postalias"
  ]
}