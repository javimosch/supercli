{
  "name": "atm",
  "version": "0.1.0",
  "description": "Personal logging and tracking CLI that does some cool things. ",
  "source": "https://github.com/atm/atm",
  "checks": [
    {
      "type": "binary",
      "name": "atm"
    }
  ],
  "install_guidance": {
    "plugin": "atm",
    "binary": "atm",
    "check": "which atm",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: atm --version",
      "supercli plugins install ./plugins/atm --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "atm",
      "resource": "self",
      "action": "version",
      "description": "Print atm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "atm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install atm from project repository"
      },
      "args": []
    },
    {
      "namespace": "atm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to atm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "atm",
        "passthrough": true,
        "missingDependencyHelp": "Install atm from project repository"
      },
      "args": []
    }
  ]
}