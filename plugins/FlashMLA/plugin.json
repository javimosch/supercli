{
  "name": "FlashMLA",
  "version": "0.1.0",
  "description": "FlashMLA: Efficient Multi-head Latent Attention Kernels",
  "source": "https://github.com/FlashMLA/FlashMLA",
  "checks": [
    {
      "type": "binary",
      "name": "flashmla"
    }
  ],
  "install_guidance": {
    "plugin": "FlashMLA",
    "binary": "flashmla",
    "check": "which flashmla",
    "install_steps": [
      "pip install flashmla",
      "Verify: flashmla --version",
      "supercli plugins install ./plugins/FlashMLA --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FlashMLA",
      "resource": "self",
      "action": "version",
      "description": "Print FlashMLA version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flashmla",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FlashMLA: pip install flashmla"
      },
      "args": []
    },
    {
      "namespace": "FlashMLA",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flashmla CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flashmla",
        "passthrough": true,
        "missingDependencyHelp": "Install FlashMLA: pip install flashmla"
      },
      "args": []
    }
  ]
}