{
  "name": "paddle-ocr-cli",
  "version": "0.1.0",
  "description": "CLI wrapper for high-performance PaddleOCR text recognition",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "paddle-ocr-cli" }],
  "install_guidance": {
    "plugin": "paddle-ocr-cli",
    "binary": "paddle-ocr-cli",
    "check": "which paddle-ocr-cli",
    "install_steps": ["pip install paddleocr", "Verify: paddle-ocr-cli --version", "supercli plugins install ./plugins/paddle-ocr-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "paddle-ocr-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to paddle-ocr-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "paddle-ocr-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install paddle-ocr-cli: pip install paddleocr"
    },
    "args": []
  }]
}
