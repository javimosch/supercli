{
  "name": "NeriPlayer",
  "version": "0.1.0",
  "description": "A unified Android player for streaming music and videos from multiple online platforms. / \u2728 \u7b80\u6613\u591a\u5e73\u53f0\u97f3\u89c6\u9891",
  "source": "https://github.com/NeriPlayer/NeriPlayer",
  "checks": [
    {
      "type": "binary",
      "name": "neriplayer"
    }
  ],
  "install_guidance": {
    "plugin": "NeriPlayer",
    "binary": "neriplayer",
    "check": "which neriplayer",
    "install_steps": [
      "pip install neriplayer",
      "Verify: neriplayer --version",
      "supercli plugins install ./plugins/NeriPlayer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NeriPlayer",
      "resource": "self",
      "action": "version",
      "description": "Print NeriPlayer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "neriplayer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NeriPlayer: pip install neriplayer"
      },
      "args": []
    },
    {
      "namespace": "NeriPlayer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to neriplayer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "neriplayer",
        "passthrough": true,
        "missingDependencyHelp": "Install NeriPlayer: pip install neriplayer"
      },
      "args": []
    }
  ]
}