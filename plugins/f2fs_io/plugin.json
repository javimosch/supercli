{
  "name": "f2fs_io",
  "version": "0.1.0",
  "description": "CLI tool: f2fs_io",
  "source": "https://manpages.debian.org/f2fs_io",
  "checks": [
    {
      "type": "binary",
      "name": "f2fs_io"
    }
  ],
  "install_guidance": {
    "plugin": "f2fs_io",
    "binary": "f2fs_io",
    "check": "which f2fs_io",
    "install_steps": [
      "apt-get install f2fs_io 2>/dev/null || which f2fs_io",
      "Verify: f2fs_io --version",
      "supercli plugins install ./plugins/f2fs_io --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "f2fs_io",
      "resource": "self",
      "action": "version",
      "description": "Print f2fs_io version",
      "adapter": "process",
      "adapterConfig": {
        "command": "f2fs_io",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install f2fs_io: apt-get install f2fs_io 2>/dev/null || which f2fs_io"
      },
      "args": []
    },
    {
      "namespace": "f2fs_io",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to f2fs_io CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "f2fs_io",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install f2fs_io: apt-get install f2fs_io 2>/dev/null || which f2fs_io"
      },
      "args": []
    }
  ]
}