{
  "name": "odvicopy",
  "version": "0.1.0",
  "description": "CLI tool: odvicopy",
  "source": "https://manpages.debian.org/odvicopy",
  "checks": [
    {
      "type": "binary",
      "name": "odvicopy"
    }
  ],
  "install_guidance": {
    "plugin": "odvicopy",
    "binary": "odvicopy",
    "check": "which odvicopy",
    "install_steps": [
      "apt-get install odvicopy 2>/dev/null || which odvicopy",
      "Verify: odvicopy --version",
      "supercli plugins install ./plugins/odvicopy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "odvicopy",
      "resource": "self",
      "action": "version",
      "description": "Print odvicopy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "odvicopy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install odvicopy: apt-get install odvicopy 2>/dev/null || which odvicopy"
      },
      "args": []
    },
    {
      "namespace": "odvicopy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to odvicopy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "odvicopy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install odvicopy: apt-get install odvicopy 2>/dev/null || which odvicopy"
      },
      "args": []
    }
  ]
}