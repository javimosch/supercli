{
  "name": "evince-thumbnailer",
  "version": "0.1.0",
  "description": "CLI tool: evince-thumbnailer",
  "source": "https://manpages.debian.org/evince-thumbnailer",
  "checks": [
    {
      "type": "binary",
      "name": "evince-thumbnailer"
    }
  ],
  "install_guidance": {
    "plugin": "evince-thumbnailer",
    "binary": "evince-thumbnailer",
    "check": "which evince-thumbnailer",
    "install_steps": [
      "apt-get install evince-thumbnailer 2>/dev/null || which evince-thumbnailer",
      "Verify: evince-thumbnailer --version",
      "supercli plugins install ./plugins/evince-thumbnailer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "evince-thumbnailer",
      "resource": "self",
      "action": "version",
      "description": "Print evince-thumbnailer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "evince-thumbnailer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install evince-thumbnailer: apt-get install evince-thumbnailer 2>/dev/null || which evince-thumbnailer"
      },
      "args": []
    },
    {
      "namespace": "evince-thumbnailer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to evince-thumbnailer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "evince-thumbnailer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install evince-thumbnailer: apt-get install evince-thumbnailer 2>/dev/null || which evince-thumbnailer"
      },
      "args": []
    }
  ]
}