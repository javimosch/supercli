{
  "name": "awscli",
  "version": "0.1.0",
  "description": "Official Amazon AWS command-line interface",
  "checks": [
    {
      "type": "binary",
      "name": "awscli"
    }
  ],
  "install_guidance": {
    "plugin": "awscli",
    "binary": "awscli",
    "check": "which awscli",
    "install_steps": [
      "brew install awscli",
      "Verify: awscli --version",
      "supercli plugins install ./plugins/awscli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "awscli",
      "resource": "self",
      "action": "version",
      "description": "Print awscli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awscli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awscli: brew install awscli"
      },
      "args": []
    },
    {
      "namespace": "awscli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awscli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awscli",
        "passthrough": true,
        "missingDependencyHelp": "Install awscli"
      },
      "args": []
    }
  ]
}