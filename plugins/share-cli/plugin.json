{
  "name": "share-cli",
  "version": "0.1.0",
  "description": "Share files with your local network",
  "source": "https://github.com/marionebl/share-cli",
  "checks": [
    {
      "type": "binary",
      "name": "share-cli"
    }
  ],
  "install_guidance": {
    "plugin": "share-cli",
    "binary": "share-cli",
    "check": "which share-cli",
    "install_steps": [
      "See https://github.com/marionebl/share-cli",
      "Verify: share-cli --version",
      "supercli plugins install ./plugins/share-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "share-cli",
      "resource": "self",
      "action": "version",
      "description": "Print share-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "share-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install share-cli: See https://github.com/marionebl/share-cli"
      },
      "args": []
    },
    {
      "namespace": "share-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to share-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "share-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install share-cli"
      },
      "args": []
    }
  ]
}