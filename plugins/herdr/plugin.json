{
  "name": "herdr",
  "version": "0.1.0",
  "description": "agent multiplexer that lives in your terminal.",
  "source": "https://github.com/herdr/herdr",
  "checks": [
    {
      "type": "binary",
      "name": "herdr"
    }
  ],
  "install_guidance": {
    "plugin": "herdr",
    "binary": "herdr",
    "check": "which herdr",
    "install_steps": [
      "pip install herdr",
      "Verify: herdr --version",
      "supercli plugins install ./plugins/herdr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "herdr",
      "resource": "self",
      "action": "version",
      "description": "Print herdr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "herdr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install herdr: pip install herdr"
      },
      "args": []
    },
    {
      "namespace": "herdr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to herdr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "herdr",
        "passthrough": true,
        "missingDependencyHelp": "Install herdr: pip install herdr"
      },
      "args": []
    }
  ]
}