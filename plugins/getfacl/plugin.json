{
  "name": "getfacl",
  "version": "1.0.0",
  "description": "getfacl \u2014 Get file ACLs",
  "source": "savannah.nongnu.org",
  "checks": [
    {
      "type": "binary",
      "name": "getfacl"
    }
  ],
  "install_guidance": {
    "plugin": "getfacl",
    "binary": "getfacl",
    "check": "which getfacl",
    "install_steps": [
      "# Install getfacl",
      "# See savannah.nongnu.org",
      "# apt: sudo apt-get install getfacl",
      "# brew: brew install getfacl",
      "# cargo: cargo install getfacl",
      "# npm: npm install -g getfacl",
      "# pip: pip install getfacl"
    ]
  },
  "commands": [
    {
      "namespace": "getfacl",
      "resource": "getfacl",
      "action": "run",
      "description": "Run getfacl",
      "adapter": "process",
      "adapterConfig": {
        "command": "getfacl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install getfacl from savannah.nongnu.org"
      },
      "args": []
    }
  ]
}