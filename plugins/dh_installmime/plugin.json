{
  "name": "dh_installmime",
  "version": "0.1.0",
  "description": "CLI tool: dh_installmime",
  "source": "https://packages.debian.org/dh_installmime",
  "checks": [{ "type": "binary", "name": "dh_installmime" }],
  "install_guidance": {
    "plugin": "dh_installmime", "binary": "dh_installmime", "check": "which dh_installmime",
    "install_steps": ["apt-get install dh_installmime 2>/dev/null || which dh_installmime", "Verify: dh_installmime --version", "supercli plugins install ./plugins/dh_installmime --on-conflict replace --json"]
