{
  "name": "rocketride-server",
  "version": "0.1.0",
  "description": "High-performance AI pipeline engine with a C++ core and 50+ Python-extensible nodes. Build, debug, a",
  "source": "https://github.com/rocketride-server/rocketride-server",
  "checks": [
    {
      "type": "binary",
      "name": "rocketride-server"
    }
  ],
  "install_guidance": {
    "plugin": "rocketride-server",
    "binary": "rocketride-server",
    "check": "which rocketride-server",
    "install_steps": [
      "pip install rocketride-server",
      "Verify: rocketride-server --version",
      "supercli plugins install ./plugins/rocketride-server --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rocketride-server",
      "resource": "self",
      "action": "version",
      "description": "Print rocketride-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rocketride-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rocketride-server: pip install rocketride-server"
      },
      "args": []
    },
    {
      "namespace": "rocketride-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rocketride-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rocketride-server",
        "passthrough": true,
        "missingDependencyHelp": "Install rocketride-server: pip install rocketride-server"
      },
      "args": []
    }
  ]
}