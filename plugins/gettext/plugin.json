      "# See gnu.org/software/gettext",
      "# apt: sudo apt-get install gettext",
      "# brew: brew install gettext",
      "# cargo: cargo install gettext",
      "# npm: npm install -g gettext",
      "# pip: pip install gettext"
    ]
  },
  "commands": [
