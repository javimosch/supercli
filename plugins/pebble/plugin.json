{
  "name": "pebble",
  "version": "0.1.0",
  "description": "This is the latest version of the internal repository from Pebble Technology providing the software ",
  "source": "https://github.com/pebble/pebble",
  "checks": [
    {
      "type": "binary",
      "name": "pebble"
    }
  ],
  "install_guidance": {
    "plugin": "pebble",
    "binary": "pebble",
    "check": "which pebble",
    "install_steps": [
      "pip install pebble",
      "Verify: pebble --version",
      "supercli plugins install ./plugins/pebble --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pebble",
      "resource": "self",
      "action": "version",
      "description": "Print pebble version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pebble",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pebble: pip install pebble"
      },
      "args": []
    },
    {
      "namespace": "pebble",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pebble CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pebble",
        "passthrough": true,
        "missingDependencyHelp": "Install pebble: pip install pebble"
      },
      "args": []
    }
  ]
}