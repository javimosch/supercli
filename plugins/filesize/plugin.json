{
  "name": "filesize",
  "version": "1.0.0",
  "description": "filesize \u2014 File size calculator",
  "source": "github.com/Filesize/filesize",
  "checks": [
    {
      "type": "binary",
      "name": "filesize"
    }
  ],
  "install_guidance": {
    "plugin": "filesize",
    "binary": "filesize",
    "check": "which filesize",
    "install_steps": [
      "# Install filesize",
      "# See github.com/Filesize/filesize",
      "# apt: sudo apt-get install filesize",
      "# brew: brew install filesize",
      "# cargo: cargo install filesize",
      "# npm: npm install -g filesize",
      "# pip: pip install filesize"
    ]
  },
  "commands": [
    {
      "namespace": "filesize",
      "resource": "filesize",
      "action": "run",
      "description": "Run filesize",
      "adapter": "process",
      "adapterConfig": {
        "command": "filesize",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install filesize from github.com/Filesize/filesize"
      },
      "args": []
    }
  ]
}