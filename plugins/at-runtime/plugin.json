{
  "name": "at-runtime",
  "version": "0.1.0",
  "description": "CLI tool: at-runtime",
  "source": "https://packages.debian.org/at-runtime",
  "checks": [{ "type": "binary", "name": "at-runtime" }],
  "install_guidance": {
    "plugin": "at-runtime", "binary": "at-runtime", "check": "which at-runtime",
    "install_steps": ["apt-get install at-runtime 2>/dev/null || which at-runtime", "Verify: at-runtime --version", "supercli plugins install ./plugins/at-runtime --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-runtime", "resource": "_", "action": "_",
    "description": "Passthrough to at-runtime CLI",
    "adapter": "process", "adapterConfig": { "command": "at-runtime", "passthrough": true, "missingDependencyHelp": "Install at-runtime: apt-get install at-runtime" }, "args": []
  }]
}
