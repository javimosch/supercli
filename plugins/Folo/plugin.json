{
  "name": "Folo",
  "version": "0.1.0",
  "description": "\ud83e\udde1 Folo is the AI RSS Reader",
  "source": "https://github.com/Folo/Folo",
  "checks": [
    {
      "type": "binary",
      "name": "folo"
    }
  ],
  "install_guidance": {
    "plugin": "Folo",
    "binary": "folo",
    "check": "which folo",
    "install_steps": [
      "pip install folo",
      "Verify: folo --version",
      "supercli plugins install ./plugins/Folo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Folo",
      "resource": "self",
      "action": "version",
      "description": "Print Folo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "folo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Folo: pip install folo"
      },
      "args": []
    },
    {
      "namespace": "Folo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to folo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "folo",
        "passthrough": true,
        "missingDependencyHelp": "Install Folo: pip install folo"
      },
      "args": []
    }
  ]
}