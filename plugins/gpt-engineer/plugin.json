{
  "name": "gpt-engineer",
  "version": "0.1.0",
  "description": "Generate codebases from natural language specs with AI",
  "source": "https://github.com/gpt-engineer-org/gpt-engineer",
  "checks": [{ "type": "binary", "name": "gpt-engineer" }],
  "install_guidance": {
    "plugin": "gpt-engineer",
    "binary": "gpt-engineer",
    "check": "which gpt-engineer",
    "install_steps": ["pip install gpt-engineer", "Verify: gpt-engineer --version", "supercli plugins install ./plugins/gpt-engineer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gpt-engineer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gpt-engineer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gpt-engineer",
      "passthrough": true,
      "missingDependencyHelp": "Install gpt-engineer: pip install gpt-engineer", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
