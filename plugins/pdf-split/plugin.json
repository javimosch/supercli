{
  "name": "pdf-split",
  "version": "0.1.0",
  "description": "Split multi-page PDFs into individual pages from CLI",
  "source": "https://github.com/timvink/pdf-split",
  "checks": [{ "type": "binary", "name": "pdf-split" }],
  "install_guidance": {
    "plugin": "pdf-split",
    "binary": "pdf-split",
    "check": "which pdf-split",
    "install_steps": ["pip install pdf-split", "Verify: pdf-split --version", "supercli plugins install ./plugins/pdf-split --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdf-split",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdf-split CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdf-split",
      "passthrough": true,
      "missingDependencyHelp": "Install pdf-split: pip install pdf-split", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
