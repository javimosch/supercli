{
  "name": "psfgettable",
  "version": "1.0.0",
  "description": "psfgettable \u2014 psfgettable \u2014 CLI utility",
  "source": "/usr/bin/psfgettable",
  "checks": [
    {
      "type": "binary",
      "name": "psfgettable"
    }
  ],
  "install_guidance": {
    "plugin": "psfgettable",
    "binary": "psfgettable",
    "check": "which psfgettable",
    "install_steps": [
      "# Install psfgettable:",
      "# apt: sudo apt-get install psfgettable",
      "# brew: brew install psfgettable",
      "# cargo: cargo install psfgettable",
      "# npm: npm install -g psfgettable",
      "# pip: pip install psfgettable",
      "# or download from /usr/bin/psfgettable"
    ]
  },
  "commands": [
    {
      "namespace": "psfgettable",
      "resource": "psfgettable",
      "action": "run",
      "description": "Run psfgettable",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfgettable",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install psfgettable from /usr/bin/psfgettable"
      },
      "args": []
    }
  ]
}