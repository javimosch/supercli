{
  "plugin": "psfgettable",
  "binary": "psfgettable",
  "check": "which psfgettable",
  "install_steps": [
    "# Install psfgettable",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/psfgettable-linux-amd64 -o /usr/local/bin/psfgettable",
    "chmod +x /usr/local/bin/psfgettable",
    "# Or via package manager, see /usr/bin/psfgettable"
  ]
}