{
  "name": "dRonin",
  "version": "0.1.0",
  "description": "The dRonin flight controller software.",
  "source": "https://github.com/dRonin/dRonin",
  "checks": [
    {
      "type": "binary",
      "name": "dronin"
    }
  ],
  "install_guidance": {
    "plugin": "dRonin",
    "binary": "dronin",
    "check": "which dronin",
    "install_steps": [
      "pip install dronin",
      "Verify: dronin --version",
      "supercli plugins install ./plugins/dRonin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dRonin",
      "resource": "self",
      "action": "version",
      "description": "Print dRonin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dronin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dRonin: pip install dronin"
      },
      "args": []
    },
    {
      "namespace": "dRonin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dronin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dronin",
        "passthrough": true,
        "missingDependencyHelp": "Install dRonin: pip install dronin"
      },
      "args": []
    }
  ]
}