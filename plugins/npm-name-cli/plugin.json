{
  "name": "npm-name-cli",
  "version": "0.1.0",
  "description": "Check whether a package name is available on npm",
  "source": "https://github.com/sindresorhus/npm-name-cli",
  "checks": [
    {
      "type": "binary",
      "name": "npm-name-cli"
    }
  ],
  "install_guidance": {
    "plugin": "npm-name-cli",
    "binary": "npm-name-cli",
    "check": "which npm-name-cli",
    "install_steps": [
      "npm install -g npm-name-cli",
      "Verify: npm-name-cli --version",
      "supercli plugins install ./plugins/npm-name-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "npm-name-cli",
      "resource": "self",
      "action": "version",
      "description": "Print npm-name-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-name-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install npm-name-cli: npm install -g npm-name-cli"
      },
      "args": []
    },
    {
      "namespace": "npm-name-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to npm-name-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-name-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install npm-name-cli"
      },
      "args": []
    }
  ]
}