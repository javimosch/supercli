{
  "name": "bibtex.original",
  "version": "0.1.0",
  "description": "CLI tool: bibtex.original",
  "source": "https://manpages.debian.org/bibtex.original",
  "checks": [
    {
      "type": "binary",
      "name": "bibtex.original"
    }
  ],
  "install_guidance": {
    "plugin": "bibtex.original",
    "binary": "bibtex.original",
    "check": "which bibtex.original",
    "install_steps": [
      "apt-get install bibtex.original 2>/dev/null || which bibtex.original",
      "Verify: bibtex.original --version",
      "supercli plugins install ./plugins/bibtex.original --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bibtex.original",
      "resource": "self",
      "action": "version",
      "description": "Print bibtex.original version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bibtex.original",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bibtex.original: apt-get install bibtex.original 2>/dev/null || which bibtex.original"
      },
      "args": []
    },
    {
      "namespace": "bibtex.original",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bibtex.original CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bibtex.original",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install bibtex.original: apt-get install bibtex.original 2>/dev/null || which bibtex.original"
      },
      "args": []
    }
  ]
}