{
  "name": "helib",
  "version": "0.1.0",
  "description": "Implementation of homomorphic encryption",
  "source": "https://github.com/homenc/HElib",
  "checks": [
    {
      "type": "binary",
      "name": "helib"
    }
  ],
  "install_guidance": {
    "plugin": "helib",
    "binary": "helib",
    "check": "which helib",
    "install_steps": [
      "brew install helib",
      "Verify: helib --version",
      "supercli plugins install ./plugins/helib --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "helib",
      "resource": "self",
      "action": "version",
      "description": "Print helib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "helib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install helib: brew install helib"
      },
      "args": []
    },
    {
      "namespace": "helib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to helib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "helib",
        "passthrough": true,
        "missingDependencyHelp": "Install helib"
      },
      "args": []
    }
  ]
}