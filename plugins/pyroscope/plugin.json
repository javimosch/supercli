{
  "name": "pyroscope",
  "version": "0.1.0",
  "description": "Continuous profiling platform for finding performance issues",
  "source": "https://github.com/grafana/pyroscope",
  "checks": [{ "type": "binary", "name": "pyroscope" }],
  "install_guidance": {
    "plugin": "pyroscope",
    "binary": "pyroscope",
    "check": "which pyroscope",
    "install_steps": ["brew install pyroscope", "Verify: pyroscope --version", "supercli plugins install ./plugins/pyroscope --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pyroscope",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pyroscope CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pyroscope",
      "passthrough": true,
      "missingDependencyHelp": "Install pyroscope: brew install pyroscope"
    },
    "args": []
  }]
}
