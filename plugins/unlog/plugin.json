{
  "name": "unlog",
  "version": "1.0.0",
  "description": "Fast CLI tool for log analysis with JSON output and optional LLM analysis",
  "source": "https://github.com/oxforge/unlog",
  "checks": [
    {
      "type": "binary",
      "name": "unlog",
      "args": [
        "version"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "unlog",
    "binary": "unlog",
    "check": "unlog version",
    "install_steps": [
      "go install github.com/oxforge/unlog@latest",
      "Or download from: https://github.com/oxforge/unlog/releases"
    ],
    "note": "unlog is a fast CLI tool for log analysis with 11 format parsers, noise removal, and optional LLM-powered root cause analysis"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze",
      "description": "Analyze log directory with JSON output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format json \"{{directory}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "Log directory path"
        }
      ]
    },
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze-file",
      "description": "Analyze single log file with JSON output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format json \"{{file}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "file",
          "type": "string",
          "required": true,
          "description": "Log file path"
        }
      ]
    },
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze-stdin",
      "description": "Analyze logs from stdin with JSON output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format json -",
        "unsafe": true
      },
      "args": []
    },
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze-level",
      "description": "Analyze logs with minimum log level filter",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format json --level \"{{level}}\" \"{{directory}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "level",
          "type": "string",
          "required": true,
          "description": "Minimum log level"
        },
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "Log directory path"
        }
      ]
    },
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze-time-range",
      "description": "Analyze logs within time range",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format json --since \"{{since}}\" --until \"{{until}}\" \"{{directory}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "since",
          "type": "string",
          "required": true,
          "description": "Start time"
        },
        {
          "name": "until",
          "type": "string",
          "required": true,
          "description": "End time"
        },
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "Log directory path"
        }
      ]
    },
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze-ai",
      "description": "Analyze logs with AI-powered root cause analysis",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format json --ai-provider \"{{provider}}\" \"{{directory}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "provider",
          "type": "string",
          "required": true,
          "description": "LLM provider"
        },
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "Log directory path"
        }
      ]
    },
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze-verbose",
      "description": "Analyze logs with detailed output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format json --verbose \"{{directory}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "Log directory path"
        }
      ]
    },
    {
      "namespace": "unlog",
      "resource": "logs",
      "action": "analyze-markdown",
      "description": "Analyze logs and output as Markdown report",
      "adapter": "shell",
      "adapterConfig": {
        "script": "unlog --format markdown \"{{directory}}\"",
        "unsafe": true
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "Log directory path"
        }
      ]
    },
    {
      "namespace": "unlog",
      "resource": "self",
      "action": "version",
      "description": "Print unlog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unlog",
        "baseArgs": [
          "version"
        ],
        "missingDependencyHelp": "Install unlog: go install github.com/oxforge/unlog@latest"
      },
      "args": []
    },
    {
      "namespace": "unlog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unlog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unlog",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unlog: go install github.com/oxforge/unlog@latest"
      },
      "args": []
    }
  ]
}
