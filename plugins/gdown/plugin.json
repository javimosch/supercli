{
  "name": "gdown",
  "version": "1.0.0",
  "description": "gdown \u2014 Google Drive download",
  "source": "github.com/wkentaro/gdown",
  "checks": [
    {
      "type": "binary",
      "name": "gdown"
    }
  ],
  "install_guidance": {
    "plugin": "gdown",
    "binary": "gdown",
    "check": "which gdown",
    "install_steps": [
      "# Install gdown:",
      "# apt: sudo apt-get install gdown",
      "# brew: brew install gdown",
      "# cargo: cargo install gdown",
      "# npm: npm install -g gdown",
      "# pip: pip install gdown",
      "# or download from github.com/wkentaro/gdown"
    ]
  },
  "commands": [
    {
      "namespace": "gdown",
      "resource": "gdown",
      "action": "run",
      "description": "Run gdown",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdown",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gdown from github.com/wkentaro/gdown"
      },
      "args": []
    }
  ]
}