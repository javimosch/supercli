{
  "plugin": "gdown",
  "binary": "gdown",
  "check": "which gdown",
  "install_steps": [
    "# Install gdown",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/gdown-linux-amd64 -o /usr/local/bin/gdown",
    "chmod +x /usr/local/bin/gdown",
    "# Or via package manager, see github.com/wkentaro/gdown"
  ]
}