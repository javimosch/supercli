{
  "name": "sha224sum",
  "version": "0.1.0",
  "description": "Compute and check SHA-224 message digest",
  "source": "https://packages.debian.org/sha224sum",
  "checks": [
    { "type": "binary", "name": "sha224sum" }
  ],
  "install_guidance": {
    "plugin": "sha224sum",
    "binary": "sha224sum",
    "check": "which sha224sum",
    "install_steps": [
      "which sha224sum",
      "Verify: sha224sum --version",
      "supercli plugins install ./plugins/sha224sum --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "sha224sum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sha224sum CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sha224sum",
        "passthrough": true,
        "missingDependencyHelp": "Install sha224sum: which sha224sum"
      },
      "args": []
    }
  ]
}
