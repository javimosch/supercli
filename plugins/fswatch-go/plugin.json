{
  "name": "fswatch-go",
  "version": "0.1.0",
  "description": "Go-based file change notification and monitoring tool",
  "source": "https://github.com/fsnotify/fsnotify",
  "checks": [{ "type": "binary", "name": "fswatch-go" }],
  "install_guidance": {
    "plugin": "fswatch-go",
    "binary": "fswatch-go",
    "check": "which fswatch-go",
    "install_steps": ["go get github.com/fsnotify/fsnotify", "Verify: fswatch-go --version", "supercli plugins install ./plugins/fswatch-go --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fswatch-go",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fswatch-go CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fswatch-go",
      "passthrough": true,
      "missingDependencyHelp": "Install fswatch-go: go get github.com/fsnotify/fsnotify", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
