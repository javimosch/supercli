{
  "name": "StikDebug",
  "version": "0.1.0",
  "description": "An on-device debugger/JIT enabler for iOS versions 17.4+, powered by idevice.",
  "source": "https://github.com/StikDebug/StikDebug",
  "checks": [
    {
      "type": "binary",
      "name": "stikdebug"
    }
  ],
  "install_guidance": {
    "plugin": "StikDebug",
    "binary": "stikdebug",
    "check": "which stikdebug",
    "install_steps": [
      "pip install stikdebug",
      "Verify: stikdebug --version",
      "supercli plugins install ./plugins/StikDebug --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "StikDebug",
      "resource": "self",
      "action": "version",
      "description": "Print StikDebug version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stikdebug",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install StikDebug: pip install stikdebug"
      },
      "args": []
    },
    {
      "namespace": "StikDebug",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stikdebug CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stikdebug",
        "passthrough": true,
        "missingDependencyHelp": "Install StikDebug: pip install stikdebug"
      },
      "args": []
    }
  ]
}