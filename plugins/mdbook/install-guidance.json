{
  "plugin": "mdbook",
  "binary": "mdbook",
  "check": "which mdbook",
  "install_steps": [
    "cargo install mdbook",
    "Verify: mdbook --version",
    "supercli plugins install ./plugins/mdbook --on-conflict replace --json"
  ],
  "note": "Also available via: brew, cargo, nix. Requires Rust toolchain."
}
