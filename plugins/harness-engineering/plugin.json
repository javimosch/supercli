{
  "name": "harness-engineering",
  "version": "0.1.0",
  "description": "Harness Engineering \u5b66\u4e60\u6307\u5357 \u2014 \u4ece\u6982\u5ff5\u7406\u89e3\u5230\u72ec\u7acb\u5b9e\u8df5\u7684\u6df1\u5ea6\u5b66\u4e60\u6863\u6848",
  "source": "https://github.com/harness-engineering/harness-engineering",
  "checks": [
    {
      "type": "binary",
      "name": "harness-engineering"
    }
  ],
  "install_guidance": {
    "plugin": "harness-engineering",
    "binary": "harness-engineering",
    "check": "which harness-engineering",
    "install_steps": [
      "pip install harness-engineering",
      "Verify: harness-engineering --version",
      "supercli plugins install ./plugins/harness-engineering --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "harness-engineering",
      "resource": "self",
      "action": "version",
      "description": "Print harness-engineering version",
      "adapter": "process",
      "adapterConfig": {
        "command": "harness-engineering",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install harness-engineering: pip install harness-engineering"
      },
      "args": []
    },
    {
      "namespace": "harness-engineering",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to harness-engineering CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "harness-engineering",
        "passthrough": true,
        "missingDependencyHelp": "Install harness-engineering: pip install harness-engineering"
      },
      "args": []
    }
  ]
}