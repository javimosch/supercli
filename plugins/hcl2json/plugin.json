{
  "name": "hcl2json",
  "version": "0.1.0",
  "description": "Convert HCL2 to JSON",
  "source": "https://github.com/tmccombs/hcl2json",
  "checks": [
    {
      "type": "binary",
      "name": "hcl2json"
    }
  ],
  "install_guidance": {
    "plugin": "hcl2json",
    "binary": "hcl2json",
    "check": "which hcl2json",
    "install_steps": [
      "brew install hcl2json",
      "Verify: hcl2json --version",
      "supercli plugins install ./plugins/hcl2json --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hcl2json",
      "resource": "self",
      "action": "version",
      "description": "Print hcl2json version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hcl2json",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hcl2json: brew install hcl2json"
      },
      "args": []
    },
    {
      "namespace": "hcl2json",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hcl2json CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hcl2json",
        "passthrough": true,
        "missingDependencyHelp": "Install hcl2json"
      },
      "args": []
    }
  ]
}