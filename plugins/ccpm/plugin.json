{
  "name": "ccpm",
  "version": "0.1.0",
  "description": "Project management skill system for Agents that uses GitHub Issues and Git worktrees for parallel ag",
  "source": "https://github.com/ccpm/ccpm",
  "checks": [
    {
      "type": "binary",
      "name": "ccpm"
    }
  ],
  "install_guidance": {
    "plugin": "ccpm",
    "binary": "ccpm",
    "check": "which ccpm",
    "install_steps": [
      "pip install ccpm",
      "Verify: ccpm --version",
      "supercli plugins install ./plugins/ccpm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ccpm",
      "resource": "self",
      "action": "version",
      "description": "Print ccpm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccpm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ccpm: pip install ccpm"
      },
      "args": []
    },
    {
      "namespace": "ccpm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ccpm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccpm",
        "passthrough": true,
        "missingDependencyHelp": "Install ccpm: pip install ccpm"
      },
      "args": []
    }
  ]
}