{
  "name": "ETL-Clinique",
  "version": "0.1.0",
  "description": "Développement d’un pipeline ETL complet avec Pentaho Data Integration pour l’extraction, la transformation et le chargement de données opérationnelles dans un entrepôt PostgreSQL.",
  "source": "https://github.com/ETL-Clinique/ETL-Clinique",
  "checks": [
    {
      "type": "binary",
      "name": "ETL-Clinique"
    }
  ],
  "install_guidance": {
    "plugin": "ETL-Clinique",
    "binary": "ETL-Clinique",
    "check": "which ETL-Clinique",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: ETL-Clinique --version",
      "supercli plugins install ./plugins/ETL-Clinique --on-conflict replace --json"
    ],
    "note": "XML language CLI tool"
  },
  "commands": [
    {
      "namespace": "ETL-Clinique",
      "resource": "self",
      "action": "version",
      "description": "Print ETL-Clinique version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ETL-Clinique",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ETL-Clinique from project repository"
      },
      "args": []
    },
    {
      "namespace": "ETL-Clinique",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ETL-Clinique CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ETL-Clinique",
        "passthrough": true,
        "missingDependencyHelp": "Install ETL-Clinique from project repository"
      },
      "args": []
    }
  ]
}