{
  "name": "rag-eval-metrics",
  "version": "0.1.0",
  "description": "Python package for evaluating RAG pipelines — measures faithfulness, relevancy, context precision & context recall with sentence-transformer embeddings. CLI + LangChain integration. 500+ monthly downloads on PyPI",
  "source": "https://github.com/rag-eval-metrics/rag-eval-metrics",
  "checks": [
    {
      "type": "binary",
      "name": "rag-eval-metrics"
    }
  ],
  "install_guidance": {
    "plugin": "rag-eval-metrics",
    "binary": "rag-eval-metrics",
    "check": "which rag-eval-metrics",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: rag-eval-metrics --version",
      "supercli plugins install ./plugins/rag-eval-metrics --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "rag-eval-metrics",
      "resource": "self",
      "action": "version",
      "description": "Print rag-eval-metrics version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rag-eval-metrics",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rag-eval-metrics from project repository"
      },
      "args": []
    },
    {
      "namespace": "rag-eval-metrics",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rag-eval-metrics CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rag-eval-metrics",
        "passthrough": true,
        "missingDependencyHelp": "Install rag-eval-metrics from project repository"
      },
      "args": []
    }
  ]
}