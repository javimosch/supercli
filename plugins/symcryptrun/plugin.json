{
  "name": "symcryptrun",
  "version": "0.1.0",
  "description": "CLI tool: symcryptrun",
  "source": "https://manpages.debian.org/symcryptrun",
  "checks": [
    {
      "type": "binary",
      "name": "symcryptrun"
    }
  ],
  "install_guidance": {
    "plugin": "symcryptrun",
    "binary": "symcryptrun",
    "check": "which symcryptrun",
    "install_steps": [
      "apt-get install symcryptrun 2>/dev/null || which symcryptrun",
      "Verify: symcryptrun --version",
      "supercli plugins install ./plugins/symcryptrun --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "symcryptrun",
      "resource": "self",
      "action": "version",
      "description": "Print symcryptrun version",
      "adapter": "process",
      "adapterConfig": {
        "command": "symcryptrun",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install symcryptrun: apt-get install symcryptrun 2>/dev/null || which symcryptrun"
      },
      "args": []
    },
    {
      "namespace": "symcryptrun",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to symcryptrun CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "symcryptrun",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install symcryptrun: apt-get install symcryptrun 2>/dev/null || which symcryptrun"
      },
      "args": []
    }
  ]
}