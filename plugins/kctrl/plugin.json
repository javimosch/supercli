{
  "name": "kctrl",
  "version": "0.1.0",
  "description": "Continuous delivery CLI for Kubernetes packages",
  "source": "https://github.com/carvel-dev/kapp-controller",
  "checks": [{ "type": "binary", "name": "kctrl" }],
  "install_guidance": {
    "plugin": "kctrl",
    "binary": "kctrl",
    "check": "which kctrl",
    "install_steps": ["brew install kctrl", "Verify: kctrl --version", "supercli plugins install ./plugins/kctrl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kctrl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kctrl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kctrl",
      "passthrough": true,
      "missingDependencyHelp": "Install kctrl: brew install kctrl"
    },
    "args": []
  }]
}
