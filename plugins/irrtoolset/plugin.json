{
  "name": "irrtoolset",
  "version": "0.1.0",
  "description": "Tools to work with Internet routing policies",
  "source": "https://github.com/irrtoolset/irrtoolset",
  "checks": [
    {
      "type": "binary",
      "name": "irrtoolset"
    }
  ],
  "install_guidance": {
    "plugin": "irrtoolset",
    "binary": "irrtoolset",
    "check": "which irrtoolset",
    "install_steps": [
      "brew install irrtoolset",
      "Verify: irrtoolset --version",
      "supercli plugins install ./plugins/irrtoolset --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "irrtoolset",
      "resource": "self",
      "action": "version",
      "description": "Print irrtoolset version",
      "adapter": "process",
      "adapterConfig": {
        "command": "irrtoolset",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install irrtoolset: brew install irrtoolset"
      },
      "args": []
    },
    {
      "namespace": "irrtoolset",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to irrtoolset CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "irrtoolset",
        "passthrough": true,
        "missingDependencyHelp": "Install irrtoolset"
      },
      "args": []
    }
  ]
}