{
  "name": "git-quick-stats",
  "version": "0.1.0",
  "description": "Quick statistics for git repositories. Shows commit stats, contributor activity, changelogs, and more.",
  "source": "https",
  "checks": [{"type": "binary", "name": "git-quick-stats"}],
  "install_guidance": {
    "plugin": "git-quick-stats",
    "binary": "git-quick-stats",
    "check": "which git-quick-stats",
    "install_steps": ["brew install git-quick-stats", "Verify: git-quick-stats --version", "supercli plugins install ./plugins/git-quick-stats --on-conflict replace --json"],
    "note": "Non-interactive CLI tool."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {"namespace": "git", "resource": "self", "action": "version", "description": "Print git-quick-stats version", "adapter": "process", "adapterConfig": {"command": "git-quick-stats", "baseArgs": ["--version"], "missingDependencyHelp": "Install git-quick-stats: brew install git-quick-stats"}, "args": []},
    {"namespace": "git", "resource": "_", "action": "_", "description": "Passthrough to git-quick-stats CLI", "adapter": "process", "adapterConfig": {"command": "git-quick-stats", "passthrough": true, "missingDependencyHelp": "Install git-quick-stats: brew install git-quick-stats"}, "args": []}
  ]
}
