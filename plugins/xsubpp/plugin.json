{
  "name": "xsubpp",
  "version": "0.1.0",
  "description": "CLI tool: xsubpp",
  "source": "https://manpages.debian.org/xsubpp",
  "checks": [
    {
      "type": "binary",
      "name": "xsubpp"
    }
  ],
  "install_guidance": {
    "plugin": "xsubpp",
    "binary": "xsubpp",
    "check": "which xsubpp",
    "install_steps": [
      "apt-get install xsubpp 2>/dev/null || which xsubpp",
      "Verify: xsubpp --version",
      "supercli plugins install ./plugins/xsubpp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xsubpp",
      "resource": "self",
      "action": "version",
      "description": "Print xsubpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsubpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xsubpp: apt-get install xsubpp 2>/dev/null || which xsubpp"
      },
      "args": []
    },
    {
      "namespace": "xsubpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xsubpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsubpp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xsubpp: apt-get install xsubpp 2>/dev/null || which xsubpp"
      },
      "args": []
    }
  ]
}