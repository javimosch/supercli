{
  "name": "CodexPlusPlus",
  "version": "0.1.0",
  "description": "An enhanced tool for CodexApp, striving to make Codex better to use and more comfortable \u4e00\u4e2aCodexApp\u7684",
  "source": "https://github.com/CodexPlusPlus/CodexPlusPlus",
  "checks": [
    {
      "type": "binary",
      "name": "codexplusplus"
    }
  ],
  "install_guidance": {
    "plugin": "CodexPlusPlus",
    "binary": "codexplusplus",
    "check": "which codexplusplus",
    "install_steps": [
      "pip install codexplusplus",
      "Verify: codexplusplus --version",
      "supercli plugins install ./plugins/CodexPlusPlus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CodexPlusPlus",
      "resource": "self",
      "action": "version",
      "description": "Print CodexPlusPlus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codexplusplus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CodexPlusPlus: pip install codexplusplus"
      },
      "args": []
    },
    {
      "namespace": "CodexPlusPlus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codexplusplus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codexplusplus",
        "passthrough": true,
        "missingDependencyHelp": "Install CodexPlusPlus: pip install codexplusplus"
      },
      "args": []
    }
  ]
}