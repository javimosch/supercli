{
  "name": "daily_stock_analysis",
  "version": "0.1.0",
  "description": "LLM\u9a71\u52a8\u7684 A/H/\u7f8e\u80a1\u667a\u80fd\u5206\u6790\uff1a\u591a\u6570\u636e\u6e90\u884c\u60c5 + \u5b9e\u65f6\u65b0\u95fb + LLM\u51b3\u7b56\u4eea\u8868\u76d8 + \u591a\u6e20\u9053\u63a8\u9001\uff0c\u96f6\u6210\u672c\u5b9a\u65f6\u8fd0\u884c\uff0c\u7eaf\u767d\u5ad6. LLM-powered stock analysis system fo",
  "source": "https://github.com/daily_stock_analysis/daily_stock_analysis",
  "checks": [
    {
      "type": "binary",
      "name": "daily-stock-analysis"
    }
  ],
  "install_guidance": {
    "plugin": "daily_stock_analysis",
    "binary": "daily-stock-analysis",
    "check": "which daily-stock-analysis",
    "install_steps": [
      "pip install daily-stock-analysis",
      "Verify: daily-stock-analysis --version",
      "supercli plugins install ./plugins/daily_stock_analysis --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "daily_stock_analysis",
      "resource": "self",
      "action": "version",
      "description": "Print daily_stock_analysis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "daily-stock-analysis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install daily_stock_analysis: pip install daily-stock-analysis"
      },
      "args": []
    },
    {
      "namespace": "daily_stock_analysis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to daily-stock-analysis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "daily-stock-analysis",
        "passthrough": true,
        "missingDependencyHelp": "Install daily_stock_analysis: pip install daily-stock-analysis"
      },
      "args": []
    }
  ]
}