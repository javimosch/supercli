{
  "name": "lkbib",
  "version": "0.1.0",
  "description": "CLI tool: lkbib",
  "source": "https://manpages.debian.org/lkbib",
  "checks": [
    {
      "type": "binary",
      "name": "lkbib"
    }
  ],
  "install_guidance": {
    "plugin": "lkbib",
    "binary": "lkbib",
    "check": "which lkbib",
    "install_steps": [
      "apt-get install lkbib 2>/dev/null || which lkbib",
      "Verify: lkbib --version",
      "supercli plugins install ./plugins/lkbib --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lkbib",
      "resource": "self",
      "action": "version",
      "description": "Print lkbib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lkbib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lkbib: apt-get install lkbib 2>/dev/null || which lkbib"
      },
      "args": []
    },
    {
      "namespace": "lkbib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lkbib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lkbib",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lkbib: apt-get install lkbib 2>/dev/null || which lkbib"
      },
      "args": []
    }
  ]
}