{
  "name": "protoc-json",
  "version": "0.1.0",
  "description": "Specialized Protobuf to JSON converter for data interchange",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "protoc-json" }],
  "install_guidance": {
    "plugin": "protoc-json",
    "binary": "protoc-json",
    "check": "which protoc-json",
    "install_steps": ["npm install -g protoc-json", "Verify: protoc-json --version", "supercli plugins install ./plugins/protoc-json --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "protoc-json",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to protoc-json CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "protoc-json",
      "passthrough": true,
      "missingDependencyHelp": "Install protoc-json: npm install -g protoc-json"
    },
    "args": []
  }]
}
