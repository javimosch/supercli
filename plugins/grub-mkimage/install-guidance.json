{
  "plugin": "grub-mkimage",
  "binary": "grub-mkimage",
  "check": "which grub-mkimage",
  "install_steps": [
    "apt-get install grub-mkimage 2>/dev/null || which grub-mkimage",
    "Verify: grub-mkimage --version",
    "supercli plugins install ./plugins/grub-mkimage --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}