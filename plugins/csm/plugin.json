{
  "name": "csm",
  "version": "0.1.0",
  "description": "Conversational Speech Generation Model by Sesame AI Labs",
  "source": "https://github.com/SesameAILabs/csm",
  "checks": [
    {
      "type": "binary",
      "name": "csm"
    }
  ],
  "install_guidance": {
    "plugin": "csm",
    "binary": "csm",
    "check": "which csm",
    "install_steps": [
      "pip install csm",
      "Verify: csm --version",
      "supercli plugins install ./plugins/csm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "csm",
    "resource": "self",
    "action": "version",
    "description": "Print csm version",
    "adapter": "process",
    "adapterConfig": {
      "command": "csm",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install csm: pip install csm"
    },
    "args": []
  },
  {
    "namespace": "csm",
    "resource": "speech",
    "action": "generate",
    "description": "Generate conversational speech",
    "adapter": "process",
    "adapterConfig": {
      "command": "csm",
      "passthrough": true,
      "missingDependencyHelp": "Install csm: pip install csm"
    },
    "args": []
  },
  {
    "namespace": "csm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to csm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "csm",
      "passthrough": true,
      "missingDependencyHelp": "Install csm"
    },
    "args": []
  }
]
}