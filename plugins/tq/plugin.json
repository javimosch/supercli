{
  "name": "tq",
  "version": "0.1.0",
  "description": "Search code with TOML and YAML expression queries",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "tq" }],
  "install_guidance": {
    "plugin": "tq",
    "binary": "tq",
    "check": "which tq",
    "install_steps": ["cargo install tq", "Verify: tq --version", "supercli plugins install ./plugins/tq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tq",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tq CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tq",
      "passthrough": true,
      "missingDependencyHelp": "Install tq: cargo install tq"
    },
    "args": []
  }]
}
