{
  "name": "acpica",
  "version": "0.1.0",
  "description": "OS-independent implementation of the ACPI specification",
  "source": "https://github.com/acpica/acpica",
  "checks": [
    {
      "type": "binary",
      "name": "acpica"
    }
  ],
  "install_guidance": {
    "plugin": "acpica",
    "binary": "acpica",
    "check": "which acpica",
    "install_steps": [
      "brew install acpica",
      "Verify: acpica --version",
      "supercli plugins install ./plugins/acpica --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "acpica",
      "resource": "self",
      "action": "version",
      "description": "Print acpica version",
      "adapter": "process",
      "adapterConfig": {
        "command": "acpica",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install acpica: brew install acpica"
      },
      "args": []
    },
    {
      "namespace": "acpica",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to acpica CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "acpica",
        "passthrough": true,
        "missingDependencyHelp": "Install acpica"
      },
      "args": []
    }
  ]
}