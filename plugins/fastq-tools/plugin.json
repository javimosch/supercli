{
  "name": "fastq-tools",
  "version": "0.1.0",
  "description": "Small utilities for working with fastq sequence files",
  "source": "https://github.com/dcjones/fastq-tools",
  "checks": [
    {
      "type": "binary",
      "name": "fastq-tools"
    }
  ],
  "install_guidance": {
    "plugin": "fastq-tools",
    "binary": "fastq-tools",
    "check": "which fastq-tools",
    "install_steps": [
      "brew install fastq-tools",
      "Verify: fastq-tools --version",
      "supercli plugins install ./plugins/fastq-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fastq-tools",
      "resource": "self",
      "action": "version",
      "description": "Print fastq-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastq-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastq-tools: brew install fastq-tools"
      },
      "args": []
    },
    {
      "namespace": "fastq-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastq-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastq-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install fastq-tools"
      },
      "args": []
    }
  ]
}