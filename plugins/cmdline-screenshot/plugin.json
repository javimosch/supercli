{
  "name": "cmdline-screenshot",
  "version": "0.1.0",
  "description": "Basic Windows command-line screenshot utility",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "cmdline-screenshot" }],
  "install_guidance": {
    "plugin": "cmdline-screenshot",
    "binary": "cmdline-screenshot",
    "check": "which cmdline-screenshot",
    "install_steps": ["MSVC build", "Verify: cmdline-screenshot --version", "supercli plugins install ./plugins/cmdline-screenshot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cmdline-screenshot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cmdline-screenshot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cmdline-screenshot",
      "passthrough": true,
      "missingDependencyHelp": "Install cmdline-screenshot: MSVC build"
    },
    "args": []
  }]
}
