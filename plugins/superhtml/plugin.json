{
  "name": "superhtml",
  "version": "0.1.0",
  "description": "HTML Validator, Formatter, LSP, and Templating Language Library",
  "source": "https://github.com/superhtml/superhtml",
  "checks": [
    {
      "type": "binary",
      "name": "superhtml"
    }
  ],
  "install_guidance": {
    "plugin": "superhtml",
    "binary": "superhtml",
    "check": "which superhtml",
    "install_steps": [
      "pip install superhtml",
      "Verify: superhtml --version",
      "supercli plugins install ./plugins/superhtml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "superhtml",
      "resource": "self",
      "action": "version",
      "description": "Print superhtml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "superhtml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install superhtml: pip install superhtml"
      },
      "args": []
    },
    {
      "namespace": "superhtml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to superhtml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "superhtml",
        "passthrough": true,
        "missingDependencyHelp": "Install superhtml: pip install superhtml"
      },
      "args": []
    }
  ]
}