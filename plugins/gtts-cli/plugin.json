{
  "name": "gtts-cli",
  "version": "0.1.0",
  "description": "CLI tool: gtts-cli",
  "source": "https://manpages.debian.org/gtts-cli",
  "checks": [
    {
      "type": "binary",
      "name": "gtts-cli"
    }
  ],
  "install_guidance": {
    "plugin": "gtts-cli",
    "binary": "gtts-cli",
    "check": "which gtts-cli",
    "install_steps": [
      "apt-get install gtts-cli 2>/dev/null || which gtts-cli",
      "Verify: gtts-cli --version",
      "supercli plugins install ./plugins/gtts-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gtts-cli",
      "resource": "self",
      "action": "version",
      "description": "Print gtts-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtts-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtts-cli: apt-get install gtts-cli 2>/dev/null || which gtts-cli"
      },
      "args": []
    },
    {
      "namespace": "gtts-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtts-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtts-cli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gtts-cli: apt-get install gtts-cli 2>/dev/null || which gtts-cli"
      },
      "args": []
    }
  ]
}