{
  "name": "hpftodit",
  "version": "0.1.0",
  "description": "CLI tool: hpftodit",
  "source": "https://manpages.debian.org/hpftodit",
  "checks": [
    {
      "type": "binary",
      "name": "hpftodit"
    }
  ],
  "install_guidance": {
    "plugin": "hpftodit",
    "binary": "hpftodit",
    "check": "which hpftodit",
    "install_steps": [
      "apt-get install hpftodit 2>/dev/null || which hpftodit",
      "Verify: hpftodit --version",
      "supercli plugins install ./plugins/hpftodit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hpftodit",
      "resource": "self",
      "action": "version",
      "description": "Print hpftodit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hpftodit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hpftodit: apt-get install hpftodit 2>/dev/null || which hpftodit"
      },
      "args": []
    },
    {
      "namespace": "hpftodit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hpftodit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hpftodit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hpftodit: apt-get install hpftodit 2>/dev/null || which hpftodit"
      },
      "args": []
    }
  ]
}