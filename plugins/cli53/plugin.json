{
  "name": "cli53",
  "version": "0.1.0",
  "description": "Command-line tool for Amazon Route 53",
  "source": "https://github.com/barnybug/cli53",
  "checks": [
    {
      "type": "binary",
      "name": "cli53"
    }
  ],
  "install_guidance": {
    "plugin": "cli53",
    "binary": "cli53",
    "check": "which cli53",
    "install_steps": [
      "brew install cli53",
      "Verify: cli53 --version",
      "supercli plugins install ./plugins/cli53 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cli53",
      "resource": "self",
      "action": "version",
      "description": "Print cli53 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli53",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli53: brew install cli53"
      },
      "args": []
    },
    {
      "namespace": "cli53",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli53 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli53",
        "passthrough": true,
        "missingDependencyHelp": "Install cli53"
      },
      "args": []
    }
  ]
}