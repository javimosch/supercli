{
  "name": "gamemode-simulate-game",
  "version": "0.1.0",
  "description": "CLI tool: gamemode-simulate-game",
  "source": "https://manpages.debian.org/gamemode-simulate-game",
  "checks": [
    {
      "type": "binary",
      "name": "gamemode-simulate-game"
    }
  ],
  "install_guidance": {
    "plugin": "gamemode-simulate-game",
    "binary": "gamemode-simulate-game",
    "check": "which gamemode-simulate-game",
    "install_steps": [
      "apt-get install gamemode-simulate-game 2>/dev/null || which gamemode-simulate-game",
      "Verify: gamemode-simulate-game --version",
      "supercli plugins install ./plugins/gamemode-simulate-game --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gamemode-simulate-game",
      "resource": "self",
      "action": "version",
      "description": "Print gamemode-simulate-game version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gamemode-simulate-game",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gamemode-simulate-game: apt-get install gamemode-simulate-game 2>/dev/null || which gamemode-simulate-game"
      },
      "args": []
    },
    {
      "namespace": "gamemode-simulate-game",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gamemode-simulate-game CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gamemode-simulate-game",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gamemode-simulate-game: apt-get install gamemode-simulate-game 2>/dev/null || which gamemode-simulate-game"
      },
      "args": []
    }
  ]
}