{
  "name": "i18n-extractor-cli",
  "version": "0.1.0",
  "description": "A tool to extract untranslated texts from React code for internationalization (i18n)",
  "source": "https://github.com/i18n-extractor-cli/i18n-extractor-cli",
  "checks": [
    {
      "type": "binary",
      "name": "i18n-extractor-cli"
    }
  ],
  "install_guidance": {
    "plugin": "i18n-extractor-cli",
    "binary": "i18n-extractor-cli",
    "check": "which i18n-extractor-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: i18n-extractor-cli --version",
      "supercli plugins install ./plugins/i18n-extractor-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "i18n-extractor-cli",
      "resource": "self",
      "action": "version",
      "description": "Print i18n-extractor-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "i18n-extractor-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install i18n-extractor-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "i18n-extractor-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to i18n-extractor-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "i18n-extractor-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install i18n-extractor-cli from project repository"
      },
      "args": []
    }
  ]
}