{
  "name": "ds4",
  "version": "0.1.0",
  "description": "DeepSeek 4 Flash local inference engine for Metal and CUDA",
  "source": "https://github.com/ds4/ds4",
  "checks": [
    {
      "type": "binary",
      "name": "ds4"
    }
  ],
  "install_guidance": {
    "plugin": "ds4",
    "binary": "ds4",
    "check": "which ds4",
    "install_steps": [
      "pip install ds4",
      "Verify: ds4 --version",
      "supercli plugins install ./plugins/ds4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ds4",
      "resource": "self",
      "action": "version",
      "description": "Print ds4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ds4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ds4: pip install ds4"
      },
      "args": []
    },
    {
      "namespace": "ds4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ds4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ds4",
        "passthrough": true,
        "missingDependencyHelp": "Install ds4: pip install ds4"
      },
      "args": []
    }
  ]
}