{
  "name": "gendiff",
  "version": "0.1.0",
  "description": "CLI tool: gendiff",
  "source": "https://packages.debian.org/gendiff",
  "checks": [{ "type": "binary", "name": "gendiff" }],
  "install_guidance": {
    "plugin": "gendiff", "binary": "gendiff", "check": "which gendiff",
    "install_steps": ["which gendiff", "Verify: gendiff --version", "supercli plugins install ./plugins/gendiff --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gendiff", "resource": "_", "action": "_",
    "description": "Passthrough to gendiff CLI",
    "adapter": "process",
    "adapterConfig": { "command": "gendiff", "passthrough": true,
    "missingDependencyHelp": "Install gendiff: which gendiff" }, "args": []
  }]
}
