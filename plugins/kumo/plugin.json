{
  "name": "kumo",
  "version": "0.1.0",
  "description": "Word Clouds in Java",
  "source": "https://github.com/kennycason/kumo",
  "checks": [
    {
      "type": "binary",
      "name": "kumo"
    }
  ],
  "install_guidance": {
    "plugin": "kumo",
    "binary": "kumo",
    "check": "which kumo",
    "install_steps": [
      "brew install kumo",
      "Verify: kumo --version",
      "supercli plugins install ./plugins/kumo --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kumo",
      "resource": "self",
      "action": "version",
      "description": "Print kumo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kumo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kumo: brew install kumo"
      },
      "args": []
    },
    {
      "namespace": "kumo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kumo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kumo",
        "passthrough": true,
        "missingDependencyHelp": "Install kumo"
      },
      "args": []
    }
  ]
}