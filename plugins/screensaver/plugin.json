{
  "name": "screensaver",
  "version": "0.1.0",
  "description": "Start the screensaver",
  "source": "https://github.com/gillstrom/screensaver",
  "checks": [
    {
      "type": "binary",
      "name": "screensaver"
    }
  ],
  "install_guidance": {
    "plugin": "screensaver",
    "binary": "screensaver",
    "check": "which screensaver",
    "install_steps": [
      "See https://github.com/gillstrom/screensaver",
      "Verify: screensaver --version",
      "supercli plugins install ./plugins/screensaver --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "screensaver",
      "resource": "self",
      "action": "version",
      "description": "Print screensaver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "screensaver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install screensaver: See https://github.com/gillstrom/screensaver"
      },
      "args": []
    },
    {
      "namespace": "screensaver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to screensaver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "screensaver",
        "passthrough": true,
        "missingDependencyHelp": "Install screensaver"
      },
      "args": []
    }
  ]
}