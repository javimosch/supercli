{
  "name": "scanr",
  "version": "0.1.0",
  "description": "A multi-platform fast port scanner for network reconnaissance. Scans TCP and UDP ports across hosts with configurable concurrency and structured output.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "scanr"
    }
  ],
  "install_guidance": {
    "plugin": "scanr",
    "binary": "scanr",
    "check": "which scanr",
    "install_steps": [
      "cargo install scanr",
      "Verify: scanr --version",
      "supercli plugins install ./plugins/scanr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "scanr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scanr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scanr",
        "passthrough": true,
        "missingDependencyHelp": "Install scanr: cargo install scanr"
      },
      "args": []
    }
  ]
}
