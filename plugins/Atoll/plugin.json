{
  "name": "Atoll",
  "version": "0.1.0",
  "description": "Dynamic Island for macOS",
  "source": "https://github.com/Atoll/Atoll",
  "checks": [
    {
      "type": "binary",
      "name": "atoll"
    }
  ],
  "install_guidance": {
    "plugin": "Atoll",
    "binary": "atoll",
    "check": "which atoll",
    "install_steps": [
      "pip install atoll",
      "Verify: atoll --version",
      "supercli plugins install ./plugins/Atoll --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Atoll",
      "resource": "self",
      "action": "version",
      "description": "Print Atoll version",
      "adapter": "process",
      "adapterConfig": {
        "command": "atoll",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Atoll: pip install atoll"
      },
      "args": []
    },
    {
      "namespace": "Atoll",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to atoll CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "atoll",
        "passthrough": true,
        "missingDependencyHelp": "Install Atoll: pip install atoll"
      },
      "args": []
    }
  ]
}