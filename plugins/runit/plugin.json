{
  "name": "runit",
  "version": "1.0.0",
  "description": "runit \u2014 Init system with service supervision",
  "source": "smarden.org/runit",
  "checks": [
    {
      "type": "binary",
      "name": "runit"
    }
  ],
  "install_guidance": {
    "plugin": "runit",
    "binary": "runit",
    "check": "which runit",
    "install_steps": [
      "# Install runit:",
      "# apt: sudo apt-get install runit",
      "# brew: brew install runit",
      "# cargo: cargo install runit",
      "# npm: npm install -g runit",
      "# pip: pip install runit",
      "# or download from smarden.org/runit"
    ]
  },
  "commands": [
    {
      "namespace": "runit",
      "resource": "runit",
      "action": "run",
      "description": "Run runit",
      "adapter": "process",
      "adapterConfig": {
        "command": "runit",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install runit from smarden.org/runit"
      },
      "args": []
    }
  ]
}