{
  "name": "resume",
  "version": "1.0.0",
  "description": "CLI tool to easily setup a new resume",
  "source": "https://github.com/jsonresume/resume-cli",
  "checks": [
    {
      "type": "binary",
      "name": "resume"
    }
  ],
  "install_guidance": {
    "plugin": "resume",
    "binary": "resume",
    "check": "resume --version",
    "install_steps": [
      "npm install -g resume-cli"
    ],
    "note": "Requires Node.js and npm. Installs globally as 'resume'."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "resume",
      "resource": "cli",
      "action": "run",
      "description": "Run resume CLI (JSON Resume tool)",
      "adapter": "process",
      "adapterConfig": {
        "command": "resume",
        "missingDependencyHelp": "Install resume: npm install -g resume-cli"
      },
      "args": []
    },
    {
      "namespace": "resume",
      "resource": "self",
      "action": "version",
      "description": "Print resume version",
      "adapter": "process",
      "adapterConfig": {
        "command": "resume",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install resume: npm install -g resume-cli"
      },
      "args": []
    },
    {
      "namespace": "resume",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to resume CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "resume",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install resume: npm install -g resume-cli"
      },
      "args": []
    }
  ]
}
