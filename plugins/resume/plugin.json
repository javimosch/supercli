{
  "name": "resume",
  "description": "CLI tool to easily setup a new resume",
  "source": "https://www.npmjs.com/package/resume-cli",
  "version": "1.0.0",
  "binary": "resume",
  "check": "resume --version",
  "install": {
    "method": "npm",
    "command": "npm install -g resume-cli"
  },
  "commands": {
    "default": {
      "command": "resume",
      "description": "CLI tool to easily setup a new resume"
    }
  }
}