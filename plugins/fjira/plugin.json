{
  "name": "fjira",
  "version": "1.0.0",
  "description": "fjira \u2014 Jira fuzzy CLI",
  "source": "github.com/mk-5/fjira",
  "checks": [
    {
      "type": "binary",
      "name": "fjira"
    }
  ],
  "install_guidance": {
    "plugin": "fjira",
    "binary": "fjira",
    "check": "which fjira",
    "install_steps": [
      "# Install fjira",
      "# See github.com/mk-5/fjira",
      "# apt: sudo apt-get install fjira",
      "# brew: brew install fjira",
      "# cargo: cargo install fjira",
      "# npm: npm install -g fjira",
      "# pip: pip install fjira"
    ]
  },
  "commands": [
    {
      "namespace": "fjira",
      "resource": "fjira",
      "action": "run",
      "description": "Run fjira",
      "adapter": "process",
      "adapterConfig": {
        "command": "fjira",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fjira from github.com/mk-5/fjira"
      },
      "args": []
    }
  ]
}