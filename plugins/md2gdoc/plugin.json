{
  "name": "md2gdoc",
  "version": "0.1.0",
  "description": "Convert local Markdown files to Google Docs format",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "md2gdoc" }],
  "install_guidance": {
    "plugin": "md2gdoc",
    "binary": "md2gdoc",
    "check": "which md2gdoc",
    "install_steps": ["npm install -g md2gdoc", "Verify: md2gdoc --version", "supercli plugins install ./plugins/md2gdoc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "md2gdoc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to md2gdoc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "md2gdoc",
      "passthrough": true,
      "missingDependencyHelp": "Install md2gdoc: npm install -g md2gdoc"
    },
    "args": []
  }]
}
