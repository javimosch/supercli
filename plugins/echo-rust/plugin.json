{
  "name": "echo-rust",
  "version": "0.1.0",
  "description": "A Rust implementation of the echo command",
  "source": "https://github.com/RustLabs/echo-rust",
  "checks": [{ "type": "binary", "name": "echo-rust" }],
  "install_guidance": {
    "plugin": "echo-rust",
    "binary": "echo-rust",
    "check": "which echo-rust",
    "install_steps": ["cargo install echo-rust", "Verify: echo-rust --version", "supercli plugins install ./plugins/echo-rust --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "echo-rust",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to echo-rust CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "echo-rust",
      "passthrough": true,
      "missingDependencyHelp": "Install echo-rust: cargo install echo-rust"
    },
    "args": []
  }]
}
