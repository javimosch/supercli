{
  "name": "multipass",
  "version": "0.1.0",
  "description": "Ubuntu VMs on demand — launch, manage, and shell into Ubuntu instances from the CLI",
  "source": "https://github.com/canonical/multipass",
  "checks": [
    { "type": "binary", "name": "multipass" }
  ],
  "install_guidance": {
    "plugin": "multipass",
    "binary": "multipass",
    "check": "which multipass",
    "install_steps": [
      "brew install multipass",
      "sudo snap install multipass",
      "Verify: multipass version",
      "supercli plugins install ./plugins/multipass --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "launch",
      "description": "Launch and create a new Ubuntu instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["launch"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "description": "Name for the instance" },
        { "name": "--cpus", "type": "string", "description": "Number of CPUs to allocate" },
        { "name": "--disk", "type": "string", "description": "Disk space to allocate (e.g. 10G)" },
        { "name": "--memory", "type": "string", "description": "Memory to allocate (e.g. 2G)" },
        { "name": "--cloud-init", "type": "string", "description": "Path to cloud-init config" },
        { "name": "--bridged", "type": "boolean", "description": "Use bridged networking" },
        { "name": "--release", "type": "string", "description": "Ubuntu release (e.g. 24.04, 22.04)" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "shell",
      "description": "Open a shell into a running instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["shell"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "required": true, "description": "Instance name" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "exec",
      "description": "Run a command on a running instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["exec"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "required": true, "description": "Instance name" },
        { "name": "--", "type": "string", "positional": true, "description": "Command to execute" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "list",
      "description": "List all instances and their status",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["list"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": []
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "info",
      "description": "Display instance information",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["info"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "description": "Instance name(s)" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "stop",
      "description": "Stop a running instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["stop"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "description": "Instance name(s)" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "start",
      "description": "Start an existing stopped instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["start"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "description": "Instance name(s)" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "delete",
      "description": "Delete an instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["delete"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "description": "Instance name(s)" },
        { "name": "--purge", "type": "boolean", "description": "Purge instances immediately" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "restart",
      "description": "Restart a running instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["restart"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "description": "Instance name(s)" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "mount",
      "description": "Mount a local directory in the instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["mount"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "source", "type": "string", "positional": true, "description": "Local source path" },
        { "name": "target", "type": "string", "positional": true, "description": "Instance:target path" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "umount",
      "description": "Unmount a mounted directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["umount"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "mount", "type": "string", "positional": true, "description": "Instance:path to unmount" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "transfer",
      "description": "Transfer files between host and instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["transfer"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "source", "type": "string", "positional": true, "description": "Source path(s)" },
        { "name": "destination", "type": "string", "positional": true, "description": "Destination path" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "recover",
      "description": "Recover a deleted instance",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["recover"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": [
        { "name": "name", "type": "string", "positional": true, "description": "Instance name(s)" }
      ]
    },
    {
      "namespace": "multipass",
      "resource": "instance",
      "action": "purge",
      "description": "Permanently delete all deleted instances",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["purge"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": []
    },
    {
      "namespace": "multipass",
      "resource": "system",
      "action": "version",
      "description": "Show multipass version information",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "baseArgs": ["version"],
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": []
    },
    {
      "namespace": "multipass",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to multipass CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "multipass",
        "passthrough": true,
        "missingDependencyHelp": "Install multipass: brew install multipass"
      },
      "args": []
    }
  ]
}
