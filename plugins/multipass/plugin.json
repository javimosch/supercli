{
  "name": "multipass",
  "version": "0.1.0",
  "description": "Orchestrate Ubuntu VMs from the command line",
  "source": "https://github.com/canonical/multipass",
  "checks": [{ "type": "binary", "name": "multipass" }],
  "install_guidance": {
    "plugin": "multipass",
    "binary": "multipass",
    "check": "which multipass",
    "install_steps": ["brew install multipass", "Verify: multipass --version", "supercli plugins install ./plugins/multipass --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "multipass",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to multipass CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "multipass",
      "passthrough": true,
      "missingDependencyHelp": "Install multipass: brew install multipass"
    },
    "args": []
  }]
}
