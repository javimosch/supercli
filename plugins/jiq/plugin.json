{
  "name": "jiq",
  "version": "0.1.0",
  "description": "jid on jq - interactive JSON query tool using jq expressions.",
  "source": "https://github.com/fiatjaf/jiq",
  "checks": [
    {
      "type": "binary",
      "name": "jiq"
    }
  ],
  "install_guidance": {
    "plugin": "jiq",
    "binary": "jiq",
    "check": "which jiq",
    "install_steps": [
      "See https://github.com/fiatjaf/jiq",
      "Verify: jiq --version",
      "supercli plugins install ./plugins/jiq --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "jiq",
      "resource": "self",
      "action": "version",
      "description": "Print jiq version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jiq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jiq: See https://github.com/fiatjaf/jiq"
      },
      "args": []
    },
    {
      "namespace": "jiq",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jiq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jiq",
        "passthrough": true,
        "missingDependencyHelp": "Install jiq"
      },
      "args": []
    }
  ]
}