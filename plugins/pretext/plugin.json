{
  "name": "pretext",
  "version": "0.1.0",
  "description": "Fast text measurement and layout engine",
  "source": "https://github.com/chenglou/pretext",
  "checks": [
    {
      "type": "binary",
      "name": "pretext"
    }
  ],
  "install_guidance": {
    "plugin": "pretext",
    "binary": "pretext",
    "check": "which pretext",
    "install_steps": [
      "npm install pretext",
      "Verify: pretext --version",
      "supercli plugins install ./plugins/pretext --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pretext",
      "resource": "self",
      "action": "version",
      "description": "Print pretext version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pretext",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pretext: npm install pretext"
      },
      "args": []
    },
    {
      "namespace": "pretext",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pretext CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pretext",
        "passthrough": true,
        "missingDependencyHelp": "Install pretext: npm install pretext"
      },
      "args": []
    }
  ]
}
