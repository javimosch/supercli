{
  "name": "castxml",
  "version": "0.1.0",
  "description": "C-family Abstract Syntax Tree XML Output",
  "source": "https://github.com/CastXML/CastXML",
  "checks": [
    {
      "type": "binary",
      "name": "castxml"
    }
  ],
  "install_guidance": {
    "plugin": "castxml",
    "binary": "castxml",
    "check": "which castxml",
    "install_steps": [
      "brew install castxml",
      "Verify: castxml --version",
      "supercli plugins install ./plugins/castxml --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "castxml",
      "resource": "self",
      "action": "version",
      "description": "Print castxml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "castxml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install castxml: brew install castxml"
      },
      "args": []
    },
    {
      "namespace": "castxml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to castxml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "castxml",
        "passthrough": true,
        "missingDependencyHelp": "Install castxml"
      },
      "args": []
    }
  ]
}