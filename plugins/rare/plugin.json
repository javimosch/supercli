{
  "name": "rare",
  "version": "0.1.0",
  "description": "Real-time regex aggregation and analysis",
  "source": "https://github.com/zix99/rare",
  "checks": [
    {
      "type": "binary",
      "name": "rare"
    }
  ],
  "install_guidance": {
    "plugin": "rare",
    "binary": "rare",
    "check": "which rare",
    "install_steps": [
      "See https://github.com/zix99/rare",
      "Verify: rare --version",
      "supercli plugins install ./plugins/rare --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "rare",
      "resource": "self",
      "action": "version",
      "description": "Print rare version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rare",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rare: See https://github.com/zix99/rare"
      },
      "args": []
    },
    {
      "namespace": "rare",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rare CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rare",
        "passthrough": true,
        "missingDependencyHelp": "Install rare"
      },
      "args": []
    }
  ]
}