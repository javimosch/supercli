{
  "name": "libcbor",
  "version": "0.1.0",
  "description": "CBOR protocol implementation for C and others",
  "source": "https://github.com/PJK/libcbor",
  "checks": [
    {
      "type": "binary",
      "name": "libcbor"
    }
  ],
  "install_guidance": {
    "plugin": "libcbor",
    "binary": "libcbor",
    "check": "which libcbor",
    "install_steps": [
      "brew install libcbor",
      "Verify: libcbor --version",
      "supercli plugins install ./plugins/libcbor --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libcbor",
      "resource": "self",
      "action": "version",
      "description": "Print libcbor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libcbor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libcbor: brew install libcbor"
      },
      "args": []
    },
    {
      "namespace": "libcbor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libcbor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libcbor",
        "passthrough": true,
        "missingDependencyHelp": "Install libcbor"
      },
      "args": []
    }
  ]
}