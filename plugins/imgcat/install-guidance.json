{
  "plugin": "imgcat",
  "binary": "imgcat",
  "check": "which imgcat",
  "install_steps": [
    "# Install imgcat",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/imgcat-linux-amd64 -o /usr/local/bin/imgcat",
    "chmod +x /usr/local/bin/imgcat",
    "# Or via package manager, see github.com/gnachman/imgcat"
  ]
}