{
  "name": "imgcat",
  "version": "1.0.0",
  "description": "imgcat \u2014 Display images in iTerm2",
  "source": "github.com/gnachman/imgcat",
  "checks": [
    {
      "type": "binary",
      "name": "imgcat"
    }
  ],
  "install_guidance": {
    "plugin": "imgcat",
    "binary": "imgcat",
    "check": "which imgcat",
    "install_steps": [
      "# Install imgcat:",
      "# apt: sudo apt-get install imgcat",
      "# brew: brew install imgcat",
      "# cargo: cargo install imgcat",
      "# npm: npm install -g imgcat",
      "# pip: pip install imgcat",
      "# or download from github.com/gnachman/imgcat"
    ]
  },
  "commands": [
    {
      "namespace": "imgcat",
      "resource": "imgcat",
      "action": "run",
      "description": "Run imgcat",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgcat",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install imgcat from github.com/gnachman/imgcat"
      },
      "args": []
    }
  ]
}