{
  "name": "Tubular",
  "version": "0.1.0",
  "description": "A fork of NewPipe that implements SponsorBlock and ReturnYouTubeDislike.",
  "source": "https://github.com/Tubular/Tubular",
  "checks": [
    {
      "type": "binary",
      "name": "tubular"
    }
  ],
  "install_guidance": {
    "plugin": "Tubular",
    "binary": "tubular",
    "check": "which tubular",
    "install_steps": [
      "pip install tubular",
      "Verify: tubular --version",
      "supercli plugins install ./plugins/Tubular --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Tubular",
      "resource": "self",
      "action": "version",
      "description": "Print Tubular version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tubular",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Tubular: pip install tubular"
      },
      "args": []
    },
    {
      "namespace": "Tubular",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tubular CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tubular",
        "passthrough": true,
        "missingDependencyHelp": "Install Tubular: pip install tubular"
      },
      "args": []
    }
  ]
}