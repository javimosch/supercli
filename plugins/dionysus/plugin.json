{
  "name": "dionysus",
  "version": "0.1.0",
  "description": "laptop ",
  "source": "https://github.com/dionysus/dionysus",
  "checks": [
    {
      "type": "binary",
      "name": "dionysus"
    }
  ],
  "install_guidance": {
    "plugin": "dionysus",
    "binary": "dionysus",
    "check": "which dionysus",
    "install_steps": [
      "pip install dionysus",
      "Verify: dionysus --version",
      "supercli plugins install ./plugins/dionysus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dionysus",
      "resource": "self",
      "action": "version",
      "description": "Print dionysus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dionysus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dionysus: pip install dionysus"
      },
      "args": []
    },
    {
      "namespace": "dionysus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dionysus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dionysus",
        "passthrough": true,
        "missingDependencyHelp": "Install dionysus: pip install dionysus"
      },
      "args": []
    }
  ]
}