{
  "name": "ppmtopj",
  "version": "0.1.0",
  "description": "CLI tool: ppmtopj",
  "source": "https://manpages.debian.org/ppmtopj",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtopj"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtopj",
    "binary": "ppmtopj",
    "check": "which ppmtopj",
    "install_steps": [
      "apt-get install ppmtopj 2>/dev/null || which ppmtopj",
      "Verify: ppmtopj --version",
      "supercli plugins install ./plugins/ppmtopj --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtopj",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtopj version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopj",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtopj: apt-get install ppmtopj 2>/dev/null || which ppmtopj"
      },
      "args": []
    },
    {
      "namespace": "ppmtopj",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtopj CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopj",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtopj: apt-get install ppmtopj 2>/dev/null || which ppmtopj"
      },
      "args": []
    }
  ]
}