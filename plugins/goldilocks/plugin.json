{
  "name": "goldilocks",
  "version": "0.1.0",
  "description": "Kubernetes resource recommendation tool for setting requests/limits",
  "source": "https://github.com/FairwindsOps/goldilocks",
  "checks": [{ "type": "binary", "name": "goldilocks" }],
  "install_guidance": {
    "plugin": "goldilocks",
    "binary": "goldilocks",
    "check": "which goldilocks",
    "install_steps": ["brew install goldilocks", "Verify: goldilocks --version", "supercli plugins install ./plugins/goldilocks --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "goldilocks",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to goldilocks CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "goldilocks",
      "passthrough": true,
      "missingDependencyHelp": "Install goldilocks: brew install goldilocks"
    },
    "args": []
  }]
}
