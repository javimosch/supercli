{
  "name": "eralchemy",
  "version": "0.1.0",
  "description": "Simple entity relation (ER) diagrams generation",
  "source": "https://github.com/eralchemy/eralchemy",
  "checks": [
    {
      "type": "binary",
      "name": "eralchemy"
    }
  ],
  "install_guidance": {
    "plugin": "eralchemy",
    "binary": "eralchemy",
    "check": "which eralchemy",
    "install_steps": [
      "brew install eralchemy",
      "Verify: eralchemy --version",
      "supercli plugins install ./plugins/eralchemy --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "eralchemy",
      "resource": "self",
      "action": "version",
      "description": "Print eralchemy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eralchemy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eralchemy: brew install eralchemy"
      },
      "args": []
    },
    {
      "namespace": "eralchemy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eralchemy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eralchemy",
        "passthrough": true,
        "missingDependencyHelp": "Install eralchemy"
      },
      "args": []
    }
  ]
}