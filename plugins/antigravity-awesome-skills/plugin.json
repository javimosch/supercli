{
  "name": "antigravity-awesome-skills",
  "version": "0.1.0",
  "description": "Installable GitHub library of 1,500+ agentic skills for Claude Code, Cursor, Codex CLI, Gemini CLI, ",
  "source": "https://github.com/antigravity-awesome-skills/antigravity-awesome-skills",
  "checks": [
    {
      "type": "binary",
      "name": "antigravity-awesome-skills"
    }
  ],
  "install_guidance": {
    "plugin": "antigravity-awesome-skills",
    "binary": "antigravity-awesome-skills",
    "check": "which antigravity-awesome-skills",
    "install_steps": [
      "pip install antigravity-awesome-skills",
      "Verify: antigravity-awesome-skills --version",
      "supercli plugins install ./plugins/antigravity-awesome-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "antigravity-awesome-skills",
      "resource": "self",
      "action": "version",
      "description": "Print antigravity-awesome-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "antigravity-awesome-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install antigravity-awesome-skills: pip install antigravity-awesome-skills"
      },
      "args": []
    },
    {
      "namespace": "antigravity-awesome-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to antigravity-awesome-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "antigravity-awesome-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install antigravity-awesome-skills: pip install antigravity-awesome-skills"
      },
      "args": []
    }
  ]
}