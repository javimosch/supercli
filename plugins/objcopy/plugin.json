{
  "name": "objcopy",
  "version": "0.1.0",
  "description": "CLI tool: objcopy",
  "source": "https://manpages.debian.org/objcopy",
  "checks": [
    {
      "type": "binary",
      "name": "objcopy"
    }
  ],
  "install_guidance": {
    "plugin": "objcopy",
    "binary": "objcopy",
    "check": "which objcopy",
    "install_steps": [
      "apt-get install objcopy 2>/dev/null || which objcopy",
      "Verify: objcopy --version",
      "supercli plugins install ./plugins/objcopy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "objcopy",
      "resource": "self",
      "action": "version",
      "description": "Print objcopy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "objcopy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install objcopy: apt-get install objcopy 2>/dev/null || which objcopy"
      },
      "args": []
    },
    {
      "namespace": "objcopy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to objcopy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "objcopy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install objcopy: apt-get install objcopy 2>/dev/null || which objcopy"
      },
      "args": []
    }
  ]
}