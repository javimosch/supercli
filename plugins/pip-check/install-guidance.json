{
  "plugin": "pip-check",
  "binary": "pip-check",
  "check": "which pip-check",
  "install_steps": [
    "pip install pip-check",
    "Or: pipx install pip-check",
    "Verify: pip-check --version",
    "supercli plugins install ./plugins/pip-check --on-conflict replace --json"
  ],
  "note": "Available via pip/pipx. Source: https://github.com/dyve/pip-check (300+ stars). Written in Python."
}
