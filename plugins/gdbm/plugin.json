{
  "name": "gdbm",
  "version": "0.1.0",
  "description": "GNU database manager",
  "checks": [
    {
      "type": "binary",
      "name": "gdbm"
    }
  ],
  "install_guidance": {
    "plugin": "gdbm",
    "binary": "gdbm",
    "check": "which gdbm",
    "install_steps": [
      "brew install gdbm",
      "Verify: gdbm --version",
      "supercli plugins install ./plugins/gdbm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gdbm",
      "resource": "self",
      "action": "version",
      "description": "Print gdbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdbm: brew install gdbm"
      },
      "args": []
    },
    {
      "namespace": "gdbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdbm",
        "passthrough": true,
        "missingDependencyHelp": "Install gdbm"
      },
      "args": []
    }
  ]
}