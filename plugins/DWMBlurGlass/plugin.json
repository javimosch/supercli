{
  "name": "DWMBlurGlass",
  "version": "0.1.0",
  "description": "Add custom effect to global system title bar, support win10 and win11.",
  "source": "https://github.com/DWMBlurGlass/DWMBlurGlass",
  "checks": [
    {
      "type": "binary",
      "name": "dwmblurglass"
    }
  ],
  "install_guidance": {
    "plugin": "DWMBlurGlass",
    "binary": "dwmblurglass",
    "check": "which dwmblurglass",
    "install_steps": [
      "pip install dwmblurglass",
      "Verify: dwmblurglass --version",
      "supercli plugins install ./plugins/DWMBlurGlass --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DWMBlurGlass",
      "resource": "self",
      "action": "version",
      "description": "Print DWMBlurGlass version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dwmblurglass",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DWMBlurGlass: pip install dwmblurglass"
      },
      "args": []
    },
    {
      "namespace": "DWMBlurGlass",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dwmblurglass CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dwmblurglass",
        "passthrough": true,
        "missingDependencyHelp": "Install DWMBlurGlass: pip install dwmblurglass"
      },
      "args": []
    }
  ]
}