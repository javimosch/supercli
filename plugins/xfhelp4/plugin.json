{
  "name": "xfhelp4",
  "version": "0.1.0",
  "description": "CLI tool: xfhelp4",
  "source": "https://manpages.debian.org/xfhelp4",
  "checks": [
    {
      "type": "binary",
      "name": "xfhelp4"
    }
  ],
  "install_guidance": {
    "plugin": "xfhelp4",
    "binary": "xfhelp4",
    "check": "which xfhelp4",
    "install_steps": [
      "apt-get install xfhelp4 2>/dev/null || which xfhelp4",
      "Verify: xfhelp4 --version",
      "supercli plugins install ./plugins/xfhelp4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfhelp4",
      "resource": "self",
      "action": "version",
      "description": "Print xfhelp4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfhelp4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfhelp4: apt-get install xfhelp4 2>/dev/null || which xfhelp4"
      },
      "args": []
    },
    {
      "namespace": "xfhelp4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfhelp4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfhelp4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfhelp4: apt-get install xfhelp4 2>/dev/null || which xfhelp4"
      },
      "args": []
    }
  ]
}