{
  "name": "purgecss",
  "version": "0.1.0",
  "description": "Remove unused CSS from your project",
  "source": "https://github.com/FullHuman/purgecss",
  "checks": [
    {
      "type": "binary",
      "name": "purgecss"
    }
  ],
  "install_guidance": {
    "plugin": "purgecss",
    "binary": "purgecss",
    "check": "which purgecss",
    "install_steps": [
      "npm install -g purgecss",
      "Verify: purgecss --version",
      "supercli plugins install ./plugins/purgecss --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "purgecss",
      "resource": "self",
      "action": "version",
      "description": "Print purgecss version",
      "adapter": "process",
      "adapterConfig": {
        "command": "purgecss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install purgecss: npm install -g purgecss"
      },
      "args": []
    },
    {
      "namespace": "purgecss",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to purgecss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "purgecss",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install purgecss: npm install -g purgecss"
      },
      "args": []
    }
  ]
}
