{
  "name": "ruoyi-ai",
  "version": "0.1.0",
  "description": "\u9762\u5411\u4f01\u4e1a\u7ea7\u5e02\u573a\u7684\u4e00\u7ad9\u5f0fAI\u5e94\u7528\u5f00\u53d1\u6846\u67b6\uff0c\u652f\u6301\u591a\u5382\u5546\u5927\u6a21\u578b\u7edf\u4e00\u63a5\u5165\u4e0e\u7ba1\u7406\uff0c\u5177\u5907\u5b89\u5168\u53ef\u63a7\u7684\u4f01\u4e1a\u77e5\u8bc6\u5e93\u4e0e\u9ad8\u7cbe\u5ea6\u68c0\u7d22\u4f18\u5316\u80fd\u529b\uff0c\u63d0\u4f9b\u53ef\u89c6\u5316\u6d41\u7a0b\u7f16\u6392\u3001\u81ea\u4e3b\u51b3\u7b56\u667a\u80fd\u4f53\u4e0e\u591a\u667a\u80fd\u4f53\u534f\u540c\u8c03\u5ea6\uff0c\u517c\u5bb9\u4e3b\u6d41 Agent Ski",
  "source": "https://github.com/ruoyi-ai/ruoyi-ai",
  "checks": [
    {
      "type": "binary",
      "name": "ruoyi-ai"
    }
  ],
  "install_guidance": {
    "plugin": "ruoyi-ai",
    "binary": "ruoyi-ai",
    "check": "which ruoyi-ai",
    "install_steps": [
      "pip install ruoyi-ai",
      "Verify: ruoyi-ai --version",
      "supercli plugins install ./plugins/ruoyi-ai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ruoyi-ai",
      "resource": "self",
      "action": "version",
      "description": "Print ruoyi-ai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruoyi-ai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ruoyi-ai: pip install ruoyi-ai"
      },
      "args": []
    },
    {
      "namespace": "ruoyi-ai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ruoyi-ai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruoyi-ai",
        "passthrough": true,
        "missingDependencyHelp": "Install ruoyi-ai: pip install ruoyi-ai"
      },
      "args": []
    }
  ]
}