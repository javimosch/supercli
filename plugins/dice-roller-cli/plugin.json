{
  "name": "dice-roller-cli",
  "version": "0.1.0",
  "description": "Command-line interface for RPG dice rolling logic",
  "source": "https://github.com/dice-roller/cli",
  "checks": [{ "type": "binary", "name": "dice-roller-cli" }],
  "install_guidance": {
    "plugin": "dice-roller-cli",
    "binary": "dice-roller-cli",
    "check": "which dice-roller-cli",
    "install_steps": ["npm install -g dice-roller-cli", "Verify: dice-roller-cli --version", "supercli plugins install ./plugins/dice-roller-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dice-roller-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dice-roller-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dice-roller-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install dice-roller-cli: npm install -g dice-roller-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
