{
  "name": "get-emails-cli",
  "version": "0.1.0",
  "description": "Get all emails in a text file or stdin",
  "source": "https://github.com/get-emails-cli/get-emails-cli",
  "checks": [
    {
      "type": "binary",
      "name": "get-emails-cli"
    }
  ],
  "install_guidance": {
    "plugin": "get-emails-cli",
    "binary": "get-emails-cli",
    "check": "which get-emails-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: get-emails-cli --version",
      "supercli plugins install ./plugins/get-emails-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "get-emails-cli",
      "resource": "self",
      "action": "version",
      "description": "Print get-emails-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-emails-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install get-emails-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "get-emails-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to get-emails-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "get-emails-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install get-emails-cli from project repository"
      },
      "args": []
    }
  ]
}