{
  "name": "agg",
  "version": "0.1.0",
  "description": "agg — Asciicast to GIF converter",
  "source": "https://github.com/asciinema/agg",
  "checks": [
    {
      "type": "binary",
      "name": "agg"
    }
  ],
  "install_guidance": {
    "plugin": "agg",
    "binary": "agg",
    "check": "which agg",
    "install_steps": [
      "cargo install agg",
      "Verify: agg --version",
      "supercli plugins install ./plugins/agg --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "agg",
      "resource": "self",
      "action": "version",
      "description": "Print agg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agg: cargo install agg"
      },
      "args": []
    },
    {
      "namespace": "agg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install agg: cargo install agg"
      },
      "args": []
    }
  ]
}
