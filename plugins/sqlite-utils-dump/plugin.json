{
  "name": "sqlite-utils-dump",
  "version": "0.1.0",
  "description": "Extremely fast SQLite schema and data dumper utility",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "sqlite-utils-dump" }],
  "install_guidance": {
    "plugin": "sqlite-utils-dump",
    "binary": "sqlite-utils-dump",
    "check": "which sqlite-utils-dump",
    "install_steps": ["pip install sqlite-utils", "Verify: sqlite-utils-dump --version", "supercli plugins install ./plugins/sqlite-utils-dump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sqlite-utils-dump",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sqlite-utils-dump CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sqlite-utils-dump",
      "passthrough": true,
      "missingDependencyHelp": "Install sqlite-utils-dump: pip install sqlite-utils"
    },
    "args": []
  }]
}
