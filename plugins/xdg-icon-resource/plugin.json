{
  "name": "xdg-icon-resource",
  "version": "0.1.0",
  "description": "CLI tool: xdg-icon-resource",
  "source": "https://manpages.debian.org/xdg-icon-resource",
  "checks": [
    {
      "type": "binary",
      "name": "xdg-icon-resource"
    }
  ],
  "install_guidance": {
    "plugin": "xdg-icon-resource",
    "binary": "xdg-icon-resource",
    "check": "which xdg-icon-resource",
    "install_steps": [
      "apt-get install xdg-icon-resource 2>/dev/null || which xdg-icon-resource",
      "Verify: xdg-icon-resource --version",
      "supercli plugins install ./plugins/xdg-icon-resource --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xdg-icon-resource",
      "resource": "self",
      "action": "version",
      "description": "Print xdg-icon-resource version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdg-icon-resource",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xdg-icon-resource: apt-get install xdg-icon-resource 2>/dev/null || which xdg-icon-resource"
      },
      "args": []
    },
    {
      "namespace": "xdg-icon-resource",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xdg-icon-resource CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdg-icon-resource",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xdg-icon-resource: apt-get install xdg-icon-resource 2>/dev/null || which xdg-icon-resource"
      },
      "args": []
    }
  ]
}