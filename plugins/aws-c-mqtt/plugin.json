{
  "name": "aws-c-mqtt",
  "version": "0.1.0",
  "description": "C99 implementation of the MQTT 3.1.1 specification",
  "source": "https://github.com/awslabs/aws-c-mqtt",
  "checks": [
    {
      "type": "binary",
      "name": "aws-c-mqtt"
    }
  ],
  "install_guidance": {
    "plugin": "aws-c-mqtt",
    "binary": "aws-c-mqtt",
    "check": "which aws-c-mqtt",
    "install_steps": [
      "brew install aws-c-mqtt",
      "Verify: aws-c-mqtt --version",
      "supercli plugins install ./plugins/aws-c-mqtt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "aws-c-mqtt",
      "resource": "self",
      "action": "version",
      "description": "Print aws-c-mqtt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-c-mqtt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aws-c-mqtt: brew install aws-c-mqtt"
      },
      "args": []
    },
    {
      "namespace": "aws-c-mqtt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aws-c-mqtt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-c-mqtt",
        "passthrough": true,
        "missingDependencyHelp": "Install aws-c-mqtt"
      },
      "args": []
    }
  ]
}