{
  "name": "basenc",
  "version": "0.1.0",
  "description": "Base encoding utility supporting multiple encodings",
  "source": "https://github.com/coreutils/coreutils",
  "checks": [
    {
      "type": "binary",
      "name": "basenc"
    }
  ],
  "install_guidance": {
    "plugin": "basenc",
    "binary": "basenc",
    "check": "which basenc",
    "install_steps": [
      "brew install coreutils",
      "Verify: basenc --version",
      "supercli plugins install ./plugins/basenc --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "basenc",
      "resource": "self",
      "action": "version",
      "description": "Print basenc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "basenc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install basenc: brew install coreutils"
      },
      "args": []
    },
    {
      "namespace": "basenc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to basenc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "basenc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install basenc: brew install coreutils"
      },
      "args": []
    }
  ]
}
