{
  "name": "Xorg",
  "version": "0.1.0",
  "description": "CLI tool: Xorg",
  "source": "https://manpages.debian.org/Xorg",
  "checks": [
    {
      "type": "binary",
      "name": "Xorg"
    }
  ],
  "install_guidance": {
    "plugin": "Xorg",
    "binary": "Xorg",
    "check": "which Xorg",
    "install_steps": [
      "apt-get install Xorg 2>/dev/null || which Xorg",
      "Verify: Xorg --version",
      "supercli plugins install ./plugins/Xorg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Xorg",
      "resource": "self",
      "action": "version",
      "description": "Print Xorg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xorg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Xorg: apt-get install Xorg 2>/dev/null || which Xorg"
      },
      "args": []
    },
    {
      "namespace": "Xorg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Xorg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xorg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install Xorg: apt-get install Xorg 2>/dev/null || which Xorg"
      },
      "args": []
    }
  ]
}