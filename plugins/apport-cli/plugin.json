{
  "name": "apport-cli",
  "version": "0.1.0",
  "description": "CLI tool: apport-cli",
  "source": "https://packages.debian.org/apport-cli",
  "checks": [{ "type": "binary", "name": "apport-cli" }],
  "install_guidance": {
    "plugin": "apport-cli", "binary": "apport-cli", "check": "which apport-cli",
    "install_steps": ["apt-get install apport-cli 2>/dev/null || which apport-cli", "Verify: apport-cli --version", "supercli plugins install ./plugins/apport-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apport-cli", "resource": "_", "action": "_",
    "description": "Passthrough to apport-cli CLI",
    "adapter": "process", "adapterConfig": { "command": "apport-cli", "passthrough": true, "missingDependencyHelp": "Install apport-cli: apt-get install apport-cli" }, "args": []
  }]
}
