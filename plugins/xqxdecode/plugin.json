{
  "name": "xqxdecode",
  "version": "0.1.0",
  "description": "CLI tool: xqxdecode",
  "source": "https://manpages.debian.org/xqxdecode",
  "checks": [
    {
      "type": "binary",
      "name": "xqxdecode"
    }
  ],
  "install_guidance": {
    "plugin": "xqxdecode",
    "binary": "xqxdecode",
    "check": "which xqxdecode",
    "install_steps": [
      "apt-get install xqxdecode 2>/dev/null || which xqxdecode",
      "Verify: xqxdecode --version",
      "supercli plugins install ./plugins/xqxdecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xqxdecode",
      "resource": "self",
      "action": "version",
      "description": "Print xqxdecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xqxdecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xqxdecode: apt-get install xqxdecode 2>/dev/null || which xqxdecode"
      },
      "args": []
    },
    {
      "namespace": "xqxdecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xqxdecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xqxdecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xqxdecode: apt-get install xqxdecode 2>/dev/null || which xqxdecode"
      },
      "args": []
    }
  ]
}