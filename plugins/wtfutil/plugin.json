{
  "name": "wtfutil",
  "version": "0.1.0",
  "description": "wtfutil — personal information dashboard for your terminal. At-a-glance access to GitHub, weather, calendar, and more.",
  "source": "https://github.com/wtfutil/wtf",
  "checks": [
    { "type": "binary", "name": "wtfutil" }
  ],
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "install_guidance": {
    "plugin": "wtfutil",
    "binary": "wtfutil",
    "check": "which wtfutil",
    "install_steps": ["go install github.com/wtfutil/wtf@latest"],
    "note": "Also available via brew: brew install wtfutil. Terminal dashboard with modules for GitHub, Google Calendar, weather, security, and more."
  },
  "commands": [
    {
      "namespace": "wtfutil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wtfutil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wtfutil",
        "passthrough": true,
        "missingDependencyHelp": "Install wtfutil: go install github.com/wtfutil/wtf@latest"
      },
      "args": []
    }
  ]
}
