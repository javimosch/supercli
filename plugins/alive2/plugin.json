{
  "name": "alive2",
  "version": "0.1.0",
  "description": "Automatic verification of LLVM optimizations",
  "source": "https://github.com/AliveToolkit/alive2",
  "checks": [
    {
      "type": "binary",
      "name": "alive2"
    }
  ],
  "install_guidance": {
    "plugin": "alive2",
    "binary": "alive2",
    "check": "which alive2",
    "install_steps": [
      "brew install alive2",
      "Verify: alive2 --version",
      "supercli plugins install ./plugins/alive2 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "alive2",
      "resource": "self",
      "action": "version",
      "description": "Print alive2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "alive2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install alive2: brew install alive2"
      },
      "args": []
    },
    {
      "namespace": "alive2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to alive2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "alive2",
        "passthrough": true,
        "missingDependencyHelp": "Install alive2"
      },
      "args": []
    }
  ]
}