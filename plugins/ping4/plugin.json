{
  "name": "ping4",
  "version": "0.1.0",
  "description": "CLI tool: ping4",
  "source": "https://manpages.debian.org/ping4",
  "checks": [
    {
      "type": "binary",
      "name": "ping4"
    }
  ],
  "install_guidance": {
    "plugin": "ping4",
    "binary": "ping4",
    "check": "which ping4",
    "install_steps": [
      "apt-get install ping4 2>/dev/null || which ping4",
      "Verify: ping4 --version",
      "supercli plugins install ./plugins/ping4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ping4",
      "resource": "self",
      "action": "version",
      "description": "Print ping4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ping4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ping4: apt-get install ping4 2>/dev/null || which ping4"
      },
      "args": []
    },
    {
      "namespace": "ping4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ping4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ping4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ping4: apt-get install ping4 2>/dev/null || which ping4"
      },
      "args": []
    }
  ]
}