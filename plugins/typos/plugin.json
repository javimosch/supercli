{
  "name": "typos",
  "version": "0.1.0",
  "description": "Source code spell checker with --write-changes",
  "source": "https://github.com/crate-ci/typos",
  "checks": [
    {
      "type": "binary",
      "name": "typos"
    }
  ],
  "install_guidance": {
    "plugin": "typos",
    "binary": "typos",
    "check": "which typos",
    "install_steps": [
      "cargo install typos-cli",
      "Verify: typos --version",
      "supercli plugins install ./plugins/typos --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "typos",
      "resource": "self",
      "action": "version",
      "description": "Print typos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "typos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install typos: cargo install typos-cli"
      },
      "args": []
    },
    {
      "namespace": "typos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to typos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "typos",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install typos: cargo install typos-cli"
      },
      "args": []
    }
  ]
}
