{
  "name": "CyberStrikeAI",
  "version": "0.1.0",
  "description": "CyberStrikeAI is an AI-native security testing platform built in Go. It integrates 100+ security too",
  "source": "https://github.com/CyberStrikeAI/CyberStrikeAI",
  "checks": [
    {
      "type": "binary",
      "name": "cyberstrikeai"
    }
  ],
  "install_guidance": {
    "plugin": "CyberStrikeAI",
    "binary": "cyberstrikeai",
    "check": "which cyberstrikeai",
    "install_steps": [
      "pip install cyberstrikeai",
      "Verify: cyberstrikeai --version",
      "supercli plugins install ./plugins/CyberStrikeAI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CyberStrikeAI",
      "resource": "self",
      "action": "version",
      "description": "Print CyberStrikeAI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cyberstrikeai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CyberStrikeAI: pip install cyberstrikeai"
      },
      "args": []
    },
    {
      "namespace": "CyberStrikeAI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cyberstrikeai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cyberstrikeai",
        "passthrough": true,
        "missingDependencyHelp": "Install CyberStrikeAI: pip install cyberstrikeai"
      },
      "args": []
    }
  ]
}