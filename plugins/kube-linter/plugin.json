{
  "name": "kube-linter",
  "version": "0.1.0",
  "description": "Kubernetes YAML validator with --json output",
  "source": "https://github.com/stackrox/kube-linter",
  "checks": [
    {
      "type": "binary",
      "name": "kube-linter"
    }
  ],
  "install_guidance": {
    "plugin": "kube-linter",
    "binary": "kube-linter",
    "check": "which kube-linter",
    "install_steps": [
      "brew install kube-linter",
      "Verify: kube-linter --version",
      "supercli plugins install ./plugins/kube-linter --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "kube-linter",
      "resource": "self",
      "action": "version",
      "description": "Print kube-linter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kube-linter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kube-linter: brew install kube-linter"
      },
      "args": []
    },
    {
      "namespace": "kube-linter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kube-linter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kube-linter",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install kube-linter: brew install kube-linter"
      },
      "args": []
    }
  ]
}
