{
  "name": "phind-cli",
  "version": "1.0.0",
  "description": "phind-cli \u2014 AI assistant from terminal",
  "source": "phind.com",
  "checks": [
    {
      "type": "binary",
      "name": "phind-cli"
    }
  ],
  "install_guidance": {
    "plugin": "phind-cli",
    "binary": "phind-cli",
    "check": "which phind-cli",
    "install_steps": [
      "# Install phind-cli:",
      "# apt: sudo apt-get install phind-cli",
      "# brew: brew install phind-cli",
      "# cargo: cargo install phind-cli",
      "# npm: npm install -g phind-cli",
      "# pip: pip install phind-cli",
      "# or download from phind.com"
    ]
  },
  "commands": [
    {
      "namespace": "phind",
      "resource": "cli",
      "action": "run",
      "description": "Run phind-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "phind-cli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install phind-cli from phind.com"
      },
      "args": []
    }
  ]
}