{
  "plugin": "phind-cli",
  "binary": "phind-cli",
  "check": "which phind-cli",
  "install_steps": [
    "# Install phind-cli",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/phind-cli-linux-amd64 -o /usr/local/bin/phind-cli",
    "chmod +x /usr/local/bin/phind-cli",
    "# Or via package manager, see phind.com"
  ]
}