{
  "name": "freewrite",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/freewrite/freewrite",
  "checks": [
    {
      "type": "binary",
      "name": "freewrite"
    }
  ],
  "install_guidance": {
    "plugin": "freewrite",
    "binary": "freewrite",
    "check": "which freewrite",
    "install_steps": [
      "pip install freewrite",
      "Verify: freewrite --version",
      "supercli plugins install ./plugins/freewrite --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "freewrite",
      "resource": "self",
      "action": "version",
      "description": "Print freewrite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freewrite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install freewrite: pip install freewrite"
      },
      "args": []
    },
    {
      "namespace": "freewrite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freewrite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freewrite",
        "passthrough": true,
        "missingDependencyHelp": "Install freewrite: pip install freewrite"
      },
      "args": []
    }
  ]
}