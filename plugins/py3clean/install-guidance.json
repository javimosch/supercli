{
  "plugin": "py3clean",
  "binary": "py3clean",
  "check": "which py3clean",
  "install_steps": [
    "# Install py3clean",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/py3clean-linux-amd64 -o /usr/local/bin/py3clean",
    "chmod +x /usr/local/bin/py3clean",
    "# Or via package manager, see /usr/bin/py3clean"
  ]
}