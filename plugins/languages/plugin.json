{
  "name": "languages",
  "version": "0.1.0",
  "description": "Compare languages",
  "source": "https://github.com/languages/languages",
  "checks": [
    {
      "type": "binary",
      "name": "languages"
    }
  ],
  "install_guidance": {
    "plugin": "languages",
    "binary": "languages",
    "check": "which languages",
    "install_steps": [
      "pip install languages",
      "Verify: languages --version",
      "supercli plugins install ./plugins/languages --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "languages",
      "resource": "self",
      "action": "version",
      "description": "Print languages version",
      "adapter": "process",
      "adapterConfig": {
        "command": "languages",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install languages: pip install languages"
      },
      "args": []
    },
    {
      "namespace": "languages",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to languages CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "languages",
        "passthrough": true,
        "missingDependencyHelp": "Install languages: pip install languages"
      },
      "args": []
    }
  ]
}