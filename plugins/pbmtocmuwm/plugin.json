{
  "name": "pbmtocmuwm",
  "version": "0.1.0",
  "description": "CLI tool: pbmtocmuwm",
  "source": "https://manpages.debian.org/pbmtocmuwm",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtocmuwm"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtocmuwm",
    "binary": "pbmtocmuwm",
    "check": "which pbmtocmuwm",
    "install_steps": [
      "apt-get install pbmtocmuwm 2>/dev/null || which pbmtocmuwm",
      "Verify: pbmtocmuwm --version",
      "supercli plugins install ./plugins/pbmtocmuwm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtocmuwm",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtocmuwm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtocmuwm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtocmuwm: apt-get install pbmtocmuwm 2>/dev/null || which pbmtocmuwm"
      },
      "args": []
    },
    {
      "namespace": "pbmtocmuwm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtocmuwm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtocmuwm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtocmuwm: apt-get install pbmtocmuwm 2>/dev/null || which pbmtocmuwm"
      },
      "args": []
    }
  ]
}