{
  "name": "oyemi-mcp",
  "version": "0.1.0",
  "description": "Deterministic semantic encoding and sentiment analysis via MCP",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "oyemi-mcp" }],
  "install_guidance": {
    "plugin": "oyemi-mcp",
    "binary": "oyemi-mcp",
    "check": "which oyemi-mcp",
    "install_steps": ["npm install -g oyemi-mcp", "Verify: oyemi-mcp --version", "supercli plugins install ./plugins/oyemi-mcp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "oyemi-mcp",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to oyemi-mcp CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "oyemi-mcp",
      "passthrough": true,
      "missingDependencyHelp": "Install oyemi-mcp: npm install -g oyemi-mcp"
    },
    "args": []
  }]
}
