{
  "name": "vgdisplay",
  "version": "0.1.0",
  "description": "Display volume group details",
  "source": "https://packages.debian.org/vgdisplay",
  "checks": [{ "type": "binary", "name": "vgdisplay" }],
  "install_guidance": {
    "plugin": "vgdisplay", "binary": "vgdisplay", "check": "which vgdisplay",
    "install_steps": ["apt-get install lvm2", "Verify: vgdisplay --version", "supercli plugins install ./plugins/vgdisplay --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vgdisplay", "resource": "_", "action": "_",
    "description": "Passthrough to vgdisplay CLI",
    "adapter": "process", "adapterConfig": { "command": "vgdisplay", "passthrough": true, "missingDependencyHelp": "Install vgdisplay: apt-get install lvm2" }, "args": []
  }]
}
