{
  "name": "pyupgrade",
  "version": "0.1.0",
  "description": "Upgrade Python syntax to newer version equivalents",
  "source": "https://github.com/asottile/pyupgrade",
  "checks": [{ "type": "binary", "name": "pyupgrade" }],
  "install_guidance": {
    "plugin": "pyupgrade",
    "binary": "pyupgrade",
    "check": "which pyupgrade",
    "install_steps": ["pip install pyupgrade", "Verify: pyupgrade --version", "supercli plugins install ./plugins/pyupgrade --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pyupgrade",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pyupgrade CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pyupgrade",
      "passthrough": true,
      "missingDependencyHelp": "Install pyupgrade: pip install pyupgrade", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
