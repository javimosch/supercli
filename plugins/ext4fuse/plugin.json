{
  "name": "ext4fuse",
  "version": "0.1.0",
  "description": "Read-only implementation of ext4 for FUSE",
  "source": "https://github.com/gerard/ext4fuse",
  "checks": [
    {
      "type": "binary",
      "name": "ext4fuse"
    }
  ],
  "install_guidance": {
    "plugin": "ext4fuse",
    "binary": "ext4fuse",
    "check": "which ext4fuse",
    "install_steps": [
      "brew install ext4fuse",
      "Verify: ext4fuse --version",
      "supercli plugins install ./plugins/ext4fuse --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ext4fuse",
      "resource": "self",
      "action": "version",
      "description": "Print ext4fuse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ext4fuse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ext4fuse: brew install ext4fuse"
      },
      "args": []
    },
    {
      "namespace": "ext4fuse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ext4fuse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ext4fuse",
        "passthrough": true,
        "missingDependencyHelp": "Install ext4fuse"
      },
      "args": []
    }
  ]
}