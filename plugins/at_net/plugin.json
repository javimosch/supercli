{
  "name": "at_net",
  "version": "0.1.0",
  "description": "CLI tool: at_net",
  "source": "https://packages.debian.org/at_net",
  "checks": [{ "type": "binary", "name": "at_net" }],
  "install_guidance": {
    "plugin": "at_net", "binary": "at_net", "check": "which at_net",
    "install_steps": ["apt-get install at_net 2>/dev/null || which at_net", "Verify: at_net --version", "supercli plugins install ./plugins/at_net --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_net", "resource": "_", "action": "_",
    "description": "Passthrough to at_net CLI",
    "adapter": "process", "adapterConfig": { "command": "at_net", "passthrough": true, "missingDependencyHelp": "Install at_net: apt-get install at_net" }, "args": []
  }]
}
