{
  "name": "wireshark",
  "version": "0.1.0",
  "description": "Network packet analyzer CLI (tshark)",
  "source": "https://packages.debian.org/wireshark",
  "checks": [{ "type": "binary", "name": "wireshark" }],
  "install_guidance": {
    "plugin": "wireshark", "binary": "wireshark", "check": "which wireshark",
    "install_steps": ["apt-get install wireshark-cli", "Verify: wireshark --version", "supercli plugins install ./plugins/wireshark --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wireshark", "resource": "_", "action": "_",
    "description": "Passthrough to wireshark CLI",
    "adapter": "process", "adapterConfig": { "command": "wireshark", "passthrough": true, "missingDependencyHelp": "Install wireshark: apt-get install wireshark-cli" }, "args": []
  }]
}
