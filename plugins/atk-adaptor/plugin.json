{
  "name": "atk-adaptor",
  "version": "0.1.0",
  "description": "CLI tool: atk-adaptor",
  "source": "https://packages.debian.org/atk-adaptor",
  "checks": [{ "type": "binary", "name": "atk-adaptor" }],
  "install_guidance": {
    "plugin": "atk-adaptor", "binary": "atk-adaptor", "check": "which atk-adaptor",
    "install_steps": ["apt-get install atk-adaptor 2>/dev/null || which atk-adaptor", "Verify: atk-adaptor --version", "supercli plugins install ./plugins/atk-adaptor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "atk-adaptor", "resource": "_", "action": "_",
    "description": "Passthrough to atk-adaptor CLI",
    "adapter": "process", "adapterConfig": { "command": "atk-adaptor", "passthrough": true, "missingDependencyHelp": "Install atk-adaptor: apt-get install atk-adaptor" }, "args": []
  }]
}
