{
  "plugin": "cmirror",
  "binary": "cmirror",
  "check": "cmirror --help",
  "install_steps": [
    "wget https://github.com/ox01024/cmirror/releases/latest/download/cmirror-linux-x64.tar.gz",
    "tar -xzf cmirror-linux-x64.tar.gz",
    "chmod +x cmirror && sudo mv cmirror /usr/local/bin/",
    "Verify: cmirror --help",
    "supercli plugins install ./plugins/cmirror --on-conflict replace --json"
  ],
  "note": "For other platforms: macOS (cmirror-macos-arm64.tar.gz or cmirror-macos-x64.tar.gz), Windows (cmirror-windows-x64.zip)"
}