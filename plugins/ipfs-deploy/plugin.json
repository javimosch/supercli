{
  "name": "ipfs-deploy",
  "version": "0.1.0",
  "description": "Deploy static websites to [IPFS](https://github.com/ipfs/ipfs#overviewhttps://github.com/ipfs/ipfs#overview)",
  "source": "https://github.com/agentofuser/ipfs-deploy",
  "checks": [
    {
      "type": "binary",
      "name": "ipfs-deploy"
    }
  ],
  "install_guidance": {
    "plugin": "ipfs-deploy",
    "binary": "ipfs-deploy",
    "check": "which ipfs-deploy",
    "install_steps": [
      "See https://github.com/agentofuser/ipfs-deploy",
      "Verify: ipfs-deploy --version",
      "supercli plugins install ./plugins/ipfs-deploy --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ipfs-deploy",
      "resource": "self",
      "action": "version",
      "description": "Print ipfs-deploy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipfs-deploy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipfs-deploy: See https://github.com/agentofuser/ipfs-deploy"
      },
      "args": []
    },
    {
      "namespace": "ipfs-deploy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipfs-deploy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipfs-deploy",
        "passthrough": true,
        "missingDependencyHelp": "Install ipfs-deploy"
      },
      "args": []
    }
  ]
}