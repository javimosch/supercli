{
  "name": "mytv-android",
  "version": "0.1.0",
  "description": "\u4f7f\u7528Android\u539f\u751f\u5f00\u53d1\u7684\u89c6\u9891\u64ad\u653e\u8f6f\u4ef6",
  "source": "https://github.com/mytv-android/mytv-android",
  "checks": [
    {
      "type": "binary",
      "name": "mytv-android"
    }
  ],
  "install_guidance": {
    "plugin": "mytv-android",
    "binary": "mytv-android",
    "check": "which mytv-android",
    "install_steps": [
      "pip install mytv-android",
      "Verify: mytv-android --version",
      "supercli plugins install ./plugins/mytv-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mytv-android",
      "resource": "self",
      "action": "version",
      "description": "Print mytv-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mytv-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mytv-android: pip install mytv-android"
      },
      "args": []
    },
    {
      "namespace": "mytv-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mytv-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mytv-android",
        "passthrough": true,
        "missingDependencyHelp": "Install mytv-android: pip install mytv-android"
      },
      "args": []
    }
  ]
}