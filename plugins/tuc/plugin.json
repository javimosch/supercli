{
  "name": "tuc",
  "version": "0.1.0",
  "description": "You want to cut on more than just a character, perhaps using negative indexes or format the selected fields as you want... Maybe you want to cut on lines (ever needed to drop first and last line?)... That's where tuc can help.",
  "source": "https://github.com/riquito/tuc",
  "checks": [
    {
      "type": "binary",
      "name": "tuc"
    }
  ],
  "install_guidance": {
    "plugin": "tuc",
    "binary": "tuc",
    "check": "which tuc",
    "install_steps": [
      "cargo install tuc",
      "Verify: tuc --version",
      "supercli plugins install ./plugins/tuc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "tuc",
      "resource": "self",
      "action": "version",
      "description": "Print tuc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tuc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tuc: cargo install tuc"
      },
      "args": []
    },
    {
      "namespace": "tuc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tuc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tuc",
        "passthrough": true,
        "missingDependencyHelp": "Install tuc"
      },
      "args": []
    }
  ]
}