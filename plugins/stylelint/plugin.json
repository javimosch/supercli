{
  "name": "stylelint",
  "version": "0.1.0",
  "description": "CSS linter industry standard with JSON output",
  "source": "https://github.com/stylelint/stylelint",
  "checks": [
    {
      "type": "binary",
      "name": "stylelint"
    }
  ],
  "install_guidance": {
    "plugin": "stylelint",
    "binary": "stylelint",
    "check": "which stylelint",
    "install_steps": [
      "npm install -g stylelint",
      "Verify: stylelint --version",
      "supercli plugins install ./plugins/stylelint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "stylelint",
      "resource": "self",
      "action": "version",
      "description": "Print stylelint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stylelint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install stylelint: npm install -g stylelint"
      },
      "args": []
    },
    {
      "namespace": "stylelint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stylelint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stylelint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install stylelint: npm install -g stylelint"
      },
      "args": []
    }
  ]
}
