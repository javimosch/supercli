{
  "name": "ll",
  "version": "0.1.0",
  "description": "ll \u2014 opinionated ls rewrite in Go \ud83e\udde6",
  "source": "https://github.com/antonmedv/ll",
  "checks": [
    {
      "type": "binary",
      "name": "ll"
    }
  ],
  "install_guidance": {
    "plugin": "ll",
    "binary": "ll",
    "check": "which ll",
    "install_steps": [
      "See https://github.com/antonmedv/ll",
      "Verify: ll --version",
      "supercli plugins install ./plugins/ll --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ll",
      "resource": "self",
      "action": "version",
      "description": "Print ll version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ll",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ll: See https://github.com/antonmedv/ll"
      },
      "args": []
    },
    {
      "namespace": "ll",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ll CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ll",
        "passthrough": true,
        "missingDependencyHelp": "Install ll"
      },
      "args": []
    }
  ]
}