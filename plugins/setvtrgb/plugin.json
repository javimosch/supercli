{
  "name": "setvtrgb",
  "version": "0.1.0",
  "description": "CLI tool: setvtrgb",
  "source": "https://manpages.debian.org/setvtrgb",
  "checks": [
    {
      "type": "binary",
      "name": "setvtrgb"
    }
  ],
  "install_guidance": {
    "plugin": "setvtrgb",
    "binary": "setvtrgb",
    "check": "which setvtrgb",
    "install_steps": [
      "apt-get install setvtrgb 2>/dev/null || which setvtrgb",
      "Verify: setvtrgb --version",
      "supercli plugins install ./plugins/setvtrgb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "setvtrgb",
      "resource": "self",
      "action": "version",
      "description": "Print setvtrgb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "setvtrgb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install setvtrgb: apt-get install setvtrgb 2>/dev/null || which setvtrgb"
      },
      "args": []
    },
    {
      "namespace": "setvtrgb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to setvtrgb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "setvtrgb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install setvtrgb: apt-get install setvtrgb 2>/dev/null || which setvtrgb"
      },
      "args": []
    }
  ]
}