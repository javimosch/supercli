{
  "name": "sj.h",
  "version": "0.1.0",
  "description": "A tiny little JSON parsing library",
  "source": "https://github.com/sj.h/sj.h",
  "checks": [
    {
      "type": "binary",
      "name": "sj.h"
    }
  ],
  "install_guidance": {
    "plugin": "sj.h",
    "binary": "sj.h",
    "check": "which sj.h",
    "install_steps": [
      "pip install sj.h",
      "Verify: sj.h --version",
      "supercli plugins install ./plugins/sj.h --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sj.h",
      "resource": "self",
      "action": "version",
      "description": "Print sj.h version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sj.h",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sj.h: pip install sj.h"
      },
      "args": []
    },
    {
      "namespace": "sj.h",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sj.h CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sj.h",
        "passthrough": true,
        "missingDependencyHelp": "Install sj.h: pip install sj.h"
      },
      "args": []
    }
  ]
}