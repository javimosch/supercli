{
  "name": "diskcache-cli",
  "version": "0.1.0",
  "description": "CLI for managing disk-based cache storage and eviction",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "diskcache-cli" }],
  "install_guidance": {
    "plugin": "diskcache-cli",
    "binary": "diskcache-cli",
    "check": "which diskcache-cli",
    "install_steps": ["pip install diskcache", "Verify: diskcache-cli --version", "supercli plugins install ./plugins/diskcache-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "diskcache-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to diskcache-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "diskcache-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install diskcache-cli: pip install diskcache"
    },
    "args": []
  }]
}
