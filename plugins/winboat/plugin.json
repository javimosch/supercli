{
  "name": "winboat",
  "version": "0.1.0",
  "description": "Run Windows apps on Linux with seamless integration",
  "source": "https://github.com/TibixDev/winboat",
  "checks": [
    {
      "type": "binary",
      "name": "winboat"
    }
  ],
  "install_guidance": {
    "plugin": "winboat",
    "binary": "winboat",
    "check": "which winboat",
    "install_steps": [
      "npm install -g winboat",
      "Verify: winboat --version",
      "supercli plugins install ./plugins/winboat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "winboat",
    "resource": "self",
    "action": "version",
    "description": "Print winboat version",
    "adapter": "process",
    "adapterConfig": {
      "command": "winboat",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install winboat: npm install -g winboat"
    },
    "args": []
  },
  {
    "namespace": "winboat",
    "resource": "app",
    "action": "run",
    "description": "Run a Windows app on Linux",
    "adapter": "process",
    "adapterConfig": {
      "command": "winboat",
      "passthrough": true,
      "missingDependencyHelp": "Install winboat: npm install -g winboat"
    },
    "args": []
  },
  {
    "namespace": "winboat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to winboat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "winboat",
      "passthrough": true,
      "missingDependencyHelp": "Install winboat"
    },
    "args": []
  }
]
}