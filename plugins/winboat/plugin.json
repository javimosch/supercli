{
  "name": "winboat",
  "version": "0.1.0",
  "description": "Run Windows apps on \ud83d\udc27 Linux with \u2728 seamless integration",
  "source": "https://github.com/winboat/winboat",
  "checks": [
    {
      "type": "binary",
      "name": "winboat"
    }
  ],
  "install_guidance": {
    "plugin": "winboat",
    "binary": "winboat",
    "check": "which winboat",
    "install_steps": [
      "pip install winboat",
      "Verify: winboat --version",
      "supercli plugins install ./plugins/winboat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "winboat",
      "resource": "self",
      "action": "version",
      "description": "Print winboat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "winboat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install winboat: pip install winboat"
      },
      "args": []
    },
    {
      "namespace": "winboat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to winboat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "winboat",
        "passthrough": true,
        "missingDependencyHelp": "Install winboat: pip install winboat"
      },
      "args": []
    }
  ]
}