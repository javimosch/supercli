{
  "name": "kreuzberg",
  "description": "Polyglot document intelligence framework for extracting text and metadata",
  "version": "1.0.0",
  "binary": "kreuzberg",
  "check": "kreuzberg --version",
  "install": {
    "method": "cargo",
    "command": "cargo install kreuzberg-cli"
  },
  "commands": {
    "extract": {
      "command": "kreuzberg extract {file}",
      "description": "Extract text from document",
      "args": ["file"]
    },
    "metadata": {
      "command": "kreuzberg metadata {file}",
      "description": "Extract metadata from document",
      "args": ["file"]
    },
    "batch": {
      "command": "kreuzberg batch {directory}",
      "description": "Process multiple documents in directory",
      "args": ["directory"]
    }
  }
}
