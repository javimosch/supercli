{
  "name": "dee-contacts",
  "version": "0.1.0",
  "description": "Personal CRM from the command line with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-contacts" }],
  "install_guidance": {
    "plugin": "dee-contacts",
    "binary": "dee-contacts",
    "check": "which dee-contacts",
    "install_steps": ["cargo install dee-contacts", "Verify: dee-contacts --version", "supercli plugins install ./plugins/dee-contacts --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-contacts",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-contacts CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-contacts",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-contacts: cargo install dee-contacts"
    },
    "args": []
  }]
}
