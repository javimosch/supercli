{
  "name": "AirBattery",
  "version": "0.1.0",
  "description": "Get the battery usage of all your devices on your Mac and put them on the Dock / Menu Bar / Widget! ",
  "source": "https://github.com/AirBattery/AirBattery",
  "checks": [
    {
      "type": "binary",
      "name": "airbattery"
    }
  ],
  "install_guidance": {
    "plugin": "AirBattery",
    "binary": "airbattery",
    "check": "which airbattery",
    "install_steps": [
      "pip install airbattery",
      "Verify: airbattery --version",
      "supercli plugins install ./plugins/AirBattery --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AirBattery",
      "resource": "self",
      "action": "version",
      "description": "Print AirBattery version",
      "adapter": "process",
      "adapterConfig": {
        "command": "airbattery",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AirBattery: pip install airbattery"
      },
      "args": []
    },
    {
      "namespace": "AirBattery",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to airbattery CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "airbattery",
        "passthrough": true,
        "missingDependencyHelp": "Install AirBattery: pip install airbattery"
      },
      "args": []
    }
  ]
}