{
  "name": "git-now",
  "version": "0.1.0",
  "description": "Light, temporary commits for git",
  "source": "https://github.com/iwata/git-now",
  "checks": [
    {
      "type": "binary",
      "name": "git-now"
    }
  ],
  "install_guidance": {
    "plugin": "git-now",
    "binary": "git-now",
    "check": "which git-now",
    "install_steps": [
      "brew install git-now",
      "Verify: git-now --version",
      "supercli plugins install ./plugins/git-now --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-now",
      "resource": "self",
      "action": "version",
      "description": "Print git-now version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-now",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-now: brew install git-now"
      },
      "args": []
    },
    {
      "namespace": "git-now",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-now CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-now",
        "passthrough": true,
        "missingDependencyHelp": "Install git-now"
      },
      "args": []
    }
  ]
}