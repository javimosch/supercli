{
  "name": "SeeIt",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/SeeIt/SeeIt",
  "checks": [
    {
      "type": "binary",
      "name": "seeit"
    }
  ],
  "install_guidance": {
    "plugin": "SeeIt",
    "binary": "seeit",
    "check": "which seeit",
    "install_steps": [
      "pip install seeit",
      "Verify: seeit --version",
      "supercli plugins install ./plugins/SeeIt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SeeIt",
      "resource": "self",
      "action": "version",
      "description": "Print SeeIt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "seeit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SeeIt: pip install seeit"
      },
      "args": []
    },
    {
      "namespace": "SeeIt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to seeit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "seeit",
        "passthrough": true,
        "missingDependencyHelp": "Install SeeIt: pip install seeit"
      },
      "args": []
    }
  ]
}