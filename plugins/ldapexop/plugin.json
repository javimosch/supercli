{
  "name": "ldapexop",
  "version": "0.1.0",
  "description": "CLI tool: ldapexop",
  "source": "https://manpages.debian.org/ldapexop",
  "checks": [
    {
      "type": "binary",
      "name": "ldapexop"
    }
  ],
  "install_guidance": {
    "plugin": "ldapexop",
    "binary": "ldapexop",
    "check": "which ldapexop",
    "install_steps": [
      "apt-get install ldapexop 2>/dev/null || which ldapexop",
      "Verify: ldapexop --version",
      "supercli plugins install ./plugins/ldapexop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ldapexop",
      "resource": "self",
      "action": "version",
      "description": "Print ldapexop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapexop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ldapexop: apt-get install ldapexop 2>/dev/null || which ldapexop"
      },
      "args": []
    },
    {
      "namespace": "ldapexop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ldapexop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapexop",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ldapexop: apt-get install ldapexop 2>/dev/null || which ldapexop"
      },
      "args": []
    }
  ]
}