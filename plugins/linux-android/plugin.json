{
  "name": "linux-android",
  "version": "0.1.0",
  "description": "A script that sets up linux on your anroid device via termux",
  "source": "https://github.com/linux-android/linux-android",
  "checks": [
    {
      "type": "binary",
      "name": "linux-android"
    }
  ],
  "install_guidance": {
    "plugin": "linux-android",
    "binary": "linux-android",
    "check": "which linux-android",
    "install_steps": [
      "pip install linux-android",
      "Verify: linux-android --version",
      "supercli plugins install ./plugins/linux-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linux-android",
      "resource": "self",
      "action": "version",
      "description": "Print linux-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install linux-android: pip install linux-android"
      },
      "args": []
    },
    {
      "namespace": "linux-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to linux-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "linux-android",
        "passthrough": true,
        "missingDependencyHelp": "Install linux-android: pip install linux-android"
      },
      "args": []
    }
  ]
}