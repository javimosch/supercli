{
  "name": "Bevel",
  "version": "0.1.0",
  "description": "Command line history in an SQLite database for effective reuse.",
  "source": "https://github.com/NorfairKing/bevel",
  "checks": [
    {
      "type": "binary",
      "name": "Bevel"
    }
  ],
  "install_guidance": {
    "plugin": "Bevel",
    "binary": "Bevel",
    "check": "which Bevel",
    "install_steps": [
      "See https://github.com/NorfairKing/bevel",
      "Verify: Bevel --version",
      "supercli plugins install ./plugins/Bevel --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Bevel",
      "resource": "self",
      "action": "version",
      "description": "Print Bevel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Bevel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Bevel: See https://github.com/NorfairKing/bevel"
      },
      "args": []
    },
    {
      "namespace": "Bevel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Bevel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Bevel",
        "passthrough": true,
        "missingDependencyHelp": "Install Bevel"
      },
      "args": []
    }
  ]
}