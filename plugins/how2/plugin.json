{
  "name": "how2",
  "version": "0.1.0",
  "description": "Node.js implementation of howdoi",
  "source": "https://github.com/santinic/how2",
  "checks": [
    {
      "type": "binary",
      "name": "how2"
    }
  ],
  "install_guidance": {
    "plugin": "how2",
    "binary": "how2",
    "check": "which how2",
    "install_steps": [
      "See https://github.com/santinic/how2",
      "Verify: how2 --version",
      "supercli plugins install ./plugins/how2 --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "how2",
      "resource": "self",
      "action": "version",
      "description": "Print how2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "how2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install how2: See https://github.com/santinic/how2"
      },
      "args": []
    },
    {
      "namespace": "how2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to how2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "how2",
        "passthrough": true,
        "missingDependencyHelp": "Install how2"
      },
      "args": []
    }
  ]
}