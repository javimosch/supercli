{
  "plugin": "mkntfs",
  "binary": "mkntfs",
  "check": "which mkntfs",
  "install_steps": [
    "# Install mkntfs",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/mkntfs-linux-amd64 -o /usr/local/bin/mkntfs",
    "chmod +x /usr/local/bin/mkntfs",
    "# Or via package manager, see /usr/sbin/mkntfs"
  ]
}