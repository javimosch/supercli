{
  "name": "pipes-sh",
  "version": "0.1.0",
  "description": "Animated pipes terminal screensaver",
  "source": "https://github.com/pipeseroni/pipes.sh",
  "checks": [{ "type": "binary", "name": "pipes-sh" }],
  "install_guidance": {
    "plugin": "pipes-sh",
    "binary": "pipes-sh",
    "check": "which pipes-sh",
    "install_steps": ["brew install pipes-sh", "Verify: pipes-sh --version", "supercli plugins install ./plugins/pipes-sh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipes-sh",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipes-sh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipes-sh",
      "passthrough": true,
      "missingDependencyHelp": "Install pipes-sh: brew install pipes-sh", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
