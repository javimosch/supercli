{
  "name": "ionic-cloud",
  "version": "0.1.0",
  "description": "CLI tool: ionic-cloud",
  "source": "https://manpages.debian.org/ionic-cloud",
  "checks": [
    {
      "type": "binary",
      "name": "ionic-cloud"
    }
  ],
  "install_guidance": {
    "plugin": "ionic-cloud",
    "binary": "ionic-cloud",
    "check": "which ionic-cloud",
    "install_steps": [
      "apt-get install ionic-cloud 2>/dev/null || which ionic-cloud",
      "Verify: ionic-cloud --version",
      "supercli plugins install ./plugins/ionic-cloud --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ionic-cloud",
      "resource": "self",
      "action": "version",
      "description": "Print ionic-cloud version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ionic-cloud",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ionic-cloud: apt-get install ionic-cloud 2>/dev/null || which ionic-cloud"
      },
      "args": []
    },
    {
      "namespace": "ionic-cloud",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ionic-cloud CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ionic-cloud",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ionic-cloud: apt-get install ionic-cloud 2>/dev/null || which ionic-cloud"
      },
      "args": []
    }
  ]
}