{
  "name": "dockviz",
  "version": "0.1.0",
  "description": "Visualizing docker data",
  "source": "https://github.com/justone/dockviz",
  "checks": [
    {
      "type": "binary",
      "name": "dockviz"
    }
  ],
  "install_guidance": {
    "plugin": "dockviz",
    "binary": "dockviz",
    "check": "which dockviz",
    "install_steps": [
      "brew install dockviz",
      "Verify: dockviz --version",
      "supercli plugins install ./plugins/dockviz --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dockviz",
      "resource": "self",
      "action": "version",
      "description": "Print dockviz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockviz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dockviz: brew install dockviz"
      },
      "args": []
    },
    {
      "namespace": "dockviz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dockviz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockviz",
        "passthrough": true,
        "missingDependencyHelp": "Install dockviz"
      },
      "args": []
    }
  ]
}