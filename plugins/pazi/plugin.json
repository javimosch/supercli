{
  "name": "pazi",
  "version": "0.1.0",
  "description": "Fast autojump alternative for directory navigation in Rust",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "pazi" }],
  "install_guidance": {
    "plugin": "pazi",
    "binary": "pazi",
    "check": "which pazi",
    "install_steps": ["cargo install pazi", "Verify: pazi --version", "supercli plugins install ./plugins/pazi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pazi",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pazi CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pazi",
      "passthrough": true,
      "missingDependencyHelp": "Install pazi: cargo install pazi"
    },
    "args": []
  }]
}
