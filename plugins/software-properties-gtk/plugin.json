{
  "name": "software-properties-gtk",
  "version": "0.1.0",
  "description": "CLI tool: software-properties-gtk",
  "source": "https://manpages.debian.org/software-properties-gtk",
  "checks": [
    {
      "type": "binary",
      "name": "software-properties-gtk"
    }
  ],
  "install_guidance": {
    "plugin": "software-properties-gtk",
    "binary": "software-properties-gtk",
    "check": "which software-properties-gtk",
    "install_steps": [
      "apt-get install software-properties-gtk 2>/dev/null || which software-properties-gtk",
      "Verify: software-properties-gtk --version",
      "supercli plugins install ./plugins/software-properties-gtk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "software-properties-gtk",
      "resource": "self",
      "action": "version",
      "description": "Print software-properties-gtk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "software-properties-gtk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install software-properties-gtk: apt-get install software-properties-gtk 2>/dev/null || which software-properties-gtk"
      },
      "args": []
    },
    {
      "namespace": "software-properties-gtk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to software-properties-gtk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "software-properties-gtk",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install software-properties-gtk: apt-get install software-properties-gtk 2>/dev/null || which software-properties-gtk"
      },
      "args": []
    }
  ]
}