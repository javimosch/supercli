{
  "name": "qt-faststart",
  "version": "0.1.0",
  "description": "CLI tool: qt-faststart",
  "source": "https://manpages.debian.org/qt-faststart",
  "checks": [
    {
      "type": "binary",
      "name": "qt-faststart"
    }
  ],
  "install_guidance": {
    "plugin": "qt-faststart",
    "binary": "qt-faststart",
    "check": "which qt-faststart",
    "install_steps": [
      "apt-get install qt-faststart 2>/dev/null || which qt-faststart",
      "Verify: qt-faststart --version",
      "supercli plugins install ./plugins/qt-faststart --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qt-faststart",
      "resource": "self",
      "action": "version",
      "description": "Print qt-faststart version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qt-faststart",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qt-faststart: apt-get install qt-faststart 2>/dev/null || which qt-faststart"
      },
      "args": []
    },
    {
      "namespace": "qt-faststart",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qt-faststart CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qt-faststart",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qt-faststart: apt-get install qt-faststart 2>/dev/null || which qt-faststart"
      },
      "args": []
    }
  ]
}