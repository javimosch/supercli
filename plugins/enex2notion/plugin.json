{
  "name": "enex2notion",
  "version": "0.1.0",
  "description": "Import Evernote ENEX files to Notion",
  "source": "https://github.com/vzhd1701/enex2notion",
  "checks": [
    {
      "type": "binary",
      "name": "enex2notion"
    }
  ],
  "install_guidance": {
    "plugin": "enex2notion",
    "binary": "enex2notion",
    "check": "which enex2notion",
    "install_steps": [
      "brew install enex2notion",
      "Verify: enex2notion --version",
      "supercli plugins install ./plugins/enex2notion --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "enex2notion",
      "resource": "self",
      "action": "version",
      "description": "Print enex2notion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "enex2notion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install enex2notion: brew install enex2notion"
      },
      "args": []
    },
    {
      "namespace": "enex2notion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enex2notion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enex2notion",
        "passthrough": true,
        "missingDependencyHelp": "Install enex2notion"
      },
      "args": []
    }
  ]
}