{
  "name": "pspg",
  "version": "0.1.0",
  "description": "Postgres pager with SQL syntax highlighting and table formatting",
  "source": "https://github.com/okbob/pspg",
  "checks": [{ "type": "binary", "name": "pspg" }],
  "install_guidance": {
    "plugin": "pspg",
    "binary": "pspg",
    "check": "which pspg",
    "install_steps": ["brew install pspg", "Verify: pspg --version", "supercli plugins install ./plugins/pspg --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pspg",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pspg CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pspg",
      "passthrough": true,
      "missingDependencyHelp": "Install pspg: brew install pspg"
    },
    "args": []
  }]
}
