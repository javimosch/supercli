{
  "name": "pspg",
  "version": "1.0.0",
  "description": "pspg \u2014 PostgreSQL pager",
  "source": "github.com/okbob/pspg",
  "checks": [
    {
      "type": "binary",
      "name": "pspg"
    }
  ],
  "install_guidance": {
    "plugin": "pspg",
    "binary": "pspg",
    "check": "which pspg",
    "install_steps": [
      "# Install pspg:",
      "# apt: sudo apt-get install pspg",
      "# brew: brew install pspg",
      "# cargo: cargo install pspg",
      "# npm: npm install -g pspg",
      "# pip: pip install pspg",
      "# or download from github.com/okbob/pspg"
    ]
  },
  "commands": [
    {
      "namespace": "pspg",
      "resource": "pspg",
      "action": "run",
      "description": "Run pspg",
      "adapter": "process",
      "adapterConfig": {
        "command": "pspg",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pspg from github.com/okbob/pspg"
      },
      "args": []
    }
  ]
}