{
  "name": "utt",
  "version": "0.1.0",
  "description": "Simple time tracking tool",
  "source": "https://github.com/larose/utt",
  "checks": [
    {
      "type": "binary",
      "name": "utt"
    }
  ],
  "install_guidance": {
    "plugin": "utt",
    "binary": "utt",
    "check": "which utt",
    "install_steps": [
      "See https://github.com/larose/utt",
      "Verify: utt --version",
      "supercli plugins install ./plugins/utt --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "utt",
      "resource": "self",
      "action": "version",
      "description": "Print utt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "utt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install utt: See https://github.com/larose/utt"
      },
      "args": []
    },
    {
      "namespace": "utt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to utt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "utt",
        "passthrough": true,
        "missingDependencyHelp": "Install utt"
      },
      "args": []
    }
  ]
}