{
  "name": "realtime-clickstream-pipeline",
  "version": "0.1.0",
  "description": "This is our first child data pipeline which segments user activities",
  "source": "https://github.com/realtime-clickstream-pipeline/realtime-clickstream-pipeline",
  "checks": [
    {
      "type": "binary",
      "name": "realtime-clickstream-pipeline"
    }
  ],
  "install_guidance": {
    "plugin": "realtime-clickstream-pipeline",
    "binary": "realtime-clickstream-pipeline",
    "check": "which realtime-clickstream-pipeline",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: realtime-clickstream-pipeline --version",
      "supercli plugins install ./plugins/realtime-clickstream-pipeline --on-conflict replace --json"
    ],
    "note": "Java language CLI tool"
  },
  "commands": [
    {
      "namespace": "realtime-clickstream-pipeline",
      "resource": "self",
      "action": "version",
      "description": "Print realtime-clickstream-pipeline version",
      "adapter": "process",
      "adapterConfig": {
        "command": "realtime-clickstream-pipeline",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install realtime-clickstream-pipeline from project repository"
      },
      "args": []
    },
    {
      "namespace": "realtime-clickstream-pipeline",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to realtime-clickstream-pipeline CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "realtime-clickstream-pipeline",
        "passthrough": true,
        "missingDependencyHelp": "Install realtime-clickstream-pipeline from project repository"
      },
      "args": []
    }
  ]
}