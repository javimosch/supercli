{
  "name": "backlog-md",
  "version": "0.1.0",
  "description": "Markdown‑native Task Manager & Kanban visualizer for any Git repository",
  "source": "https://github.com/MrLesk/Backlog.md",
  "checks": [
    {
      "type": "binary",
      "name": "backlog-md"
    }
  ],
  "install_guidance": {
    "plugin": "backlog-md",
    "binary": "backlog-md",
    "check": "which backlog-md",
    "install_steps": [
      "brew install backlog-md",
      "Verify: backlog-md --version",
      "supercli plugins install ./plugins/backlog-md --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "backlog-md",
      "resource": "self",
      "action": "version",
      "description": "Print backlog-md version",
      "adapter": "process",
      "adapterConfig": {
        "command": "backlog-md",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install backlog-md: brew install backlog-md"
      },
      "args": []
    },
    {
      "namespace": "backlog-md",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to backlog-md CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "backlog-md",
        "passthrough": true,
        "missingDependencyHelp": "Install backlog-md"
      },
      "args": []
    }
  ]
}