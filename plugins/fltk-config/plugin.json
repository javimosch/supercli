{
  "name": "fltk-config",
  "version": "1.0.0",
  "description": "fltk-config \u2014 FLTK config",
  "source": "fltk.org",
  "checks": [
    {
      "type": "binary",
      "name": "fltk-config"
    }
  ],
  "install_guidance": {
    "plugin": "fltk-config",
    "binary": "fltk-config",
    "check": "which fltk-config",
    "install_steps": [
      "# Install fltk-config",
      "# See fltk.org",
      "# apt: sudo apt-get install fltk-config",
      "# brew: brew install fltk-config",
      "# cargo: cargo install fltk-config",
      "# npm: npm install -g fltk-config",
      "# pip: pip install fltk-config"
    ]
  },
  "commands": [
    {
      "namespace": "fltk",
      "resource": "config",
      "action": "run",
      "description": "Run fltk-config",
      "adapter": "process",
      "adapterConfig": {
        "command": "fltk-config",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fltk-config from fltk.org"
      },
      "args": []
    }
  ]
}