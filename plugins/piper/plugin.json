{
  "name": "piper",
  "version": "0.1.0",
  "description": "Fast local neural text-to-speech engine with CLI interface",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "piper" }],
  "install_guidance": {
    "plugin": "piper",
    "binary": "piper",
    "check": "which piper",
    "install_steps": ["sudo apt install piper-tts", "Verify: piper --version", "supercli plugins install ./plugins/piper --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "piper",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to piper CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "piper",
      "passthrough": true,
      "missingDependencyHelp": "Install piper: sudo apt install piper-tts"
    },
    "args": []
  }]
}
