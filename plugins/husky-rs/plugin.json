{
  "name": "husky-rs",
  "version": "0.1.0",
  "description": "A fast Git hooks manager written in Rust. Manages pre-commit, pre-push, and other Git hooks with minimal overhead and native performance.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "husky-rs"
    }
  ],
  "install_guidance": {
    "plugin": "husky-rs",
    "binary": "husky-rs",
    "check": "which husky-rs",
    "install_steps": [
      "cargo install husky-rs",
      "Verify: husky-rs --version",
      "supercli plugins install ./plugins/husky-rs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "husky-rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to husky-rs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "husky-rs",
        "passthrough": true,
        "missingDependencyHelp": "Install husky-rs: cargo install husky-rs"
      },
      "args": []
    }
  ]
}
