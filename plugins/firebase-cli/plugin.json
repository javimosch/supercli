{
  "name": "firebase-cli",
  "version": "0.1.0",
  "description": "Firebase command-line tools",
  "checks": [
    {
      "type": "binary",
      "name": "firebase-cli"
    }
  ],
  "install_guidance": {
    "plugin": "firebase-cli",
    "binary": "firebase-cli",
    "check": "which firebase-cli",
    "install_steps": [
      "brew install firebase-cli",
      "Verify: firebase-cli --version",
      "supercli plugins install ./plugins/firebase-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "firebase-cli",
      "resource": "self",
      "action": "version",
      "description": "Print firebase-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "firebase-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install firebase-cli: brew install firebase-cli"
      },
      "args": []
    },
    {
      "namespace": "firebase-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to firebase-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "firebase-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install firebase-cli"
      },
      "args": []
    }
  ]
}