{
  "name": "librealsense",
  "version": "0.1.0",
  "description": "Intel RealSense D400 series and SR300 capture",
  "source": "https://github.com/IntelRealSense/librealsense",
  "checks": [
    {
      "type": "binary",
      "name": "librealsense"
    }
  ],
  "install_guidance": {
    "plugin": "librealsense",
    "binary": "librealsense",
    "check": "which librealsense",
    "install_steps": [
      "brew install librealsense",
      "Verify: librealsense --version",
      "supercli plugins install ./plugins/librealsense --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "librealsense",
      "resource": "self",
      "action": "version",
      "description": "Print librealsense version",
      "adapter": "process",
      "adapterConfig": {
        "command": "librealsense",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install librealsense: brew install librealsense"
      },
      "args": []
    },
    {
      "namespace": "librealsense",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to librealsense CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "librealsense",
        "passthrough": true,
        "missingDependencyHelp": "Install librealsense"
      },
      "args": []
    }
  ]
}