{
  "name": "sports-skills",
  "version": "0.1.0",
  "description": "Agent skills for live sports data and prediction markets — Football, F1, Kalshi, Polymarket. Zero API keys",
  "source": "https://github.com/machina-sports/sports-skills",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "sports-skills",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/machina-sports/sports-skills.git",
      "supercli plugins install ./plugins/sports-skills --on-conflict replace --json",
      "sc skills teach sports-skills:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "sports-skills", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["sports-skills v0.1.0 — Use sc skills teach sports-skills:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/machina-sports/sports-skills.git" }, "args": [] },
    { "namespace": "sports-skills", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/machina-sports/sports-skills.git then: sc skills teach sports-skills:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/machina-sports/sports-skills.git" }, "args": [] }
  ]
}
