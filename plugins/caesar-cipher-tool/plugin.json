{
  "name": "caesar-cipher-tool",
  "version": "0.1.0",
  "description": "Caesar Cipher encryption/decryption CLI",
  "source": "https://github.com/caesar-cipher-tool/caesar-cipher-tool",
  "checks": [
    {
      "type": "binary",
      "name": "caesar-cipher-tool"
    }
  ],
  "install_guidance": {
    "plugin": "caesar-cipher-tool",
    "binary": "caesar-cipher-tool",
    "check": "which caesar-cipher-tool",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: caesar-cipher-tool --version",
      "supercli plugins install ./plugins/caesar-cipher-tool --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "caesar-cipher-tool",
      "resource": "self",
      "action": "version",
      "description": "Print caesar-cipher-tool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "caesar-cipher-tool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install caesar-cipher-tool from project repository"
      },
      "args": []
    },
    {
      "namespace": "caesar-cipher-tool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to caesar-cipher-tool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "caesar-cipher-tool",
        "passthrough": true,
        "missingDependencyHelp": "Install caesar-cipher-tool from project repository"
      },
      "args": []
    }
  ]
}