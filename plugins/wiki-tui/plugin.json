{
  "name": "wiki-tui",
  "version": "0.1.0",
  "description": "wiki-tui — simple Wikipedia text user interface for browsing articles in the terminal",
  "source": "https://github.com/Builditluc/wiki-tui",
  "checks": [
    {
      "type": "binary",
      "name": "wiki-tui"
    }
  ],
  "install_guidance": {
    "plugin": "wiki-tui",
    "binary": "wiki-tui",
    "check": "which wiki-tui",
    "install_steps": [
      "cargo install wiki-tui",
      "Verify: wiki-tui --version",
      "Run: wiki-tui",
      "supercli plugins install ./plugins/wiki-tui --on-conflict replace --json"
    ],
    "note": "Also available via: brew install wiki-tui, or download from https://github.com/Builditluc/wiki-tui/releases."
  },
  "commands": [
    {
      "namespace": "wiki-tui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wiki-tui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wiki-tui",
        "passthrough": true,
        "missingDependencyHelp": "Install wiki-tui: cargo install wiki-tui"
      },
      "args": []
    }
  ]
}
