{
  "name": "bfg-repo-cleaner",
  "version": "0.1.0",
  "description": "Remove large files and secrets from Git history",
  "source": "https://github.com/rtyley/bfg-repo-cleaner",
  "checks": [{ "type": "binary", "name": "bfg" }],
  "install_guidance": {
    "plugin": "bfg-repo-cleaner",
    "binary": "bfg",
    "check": "which bfg",
    "install_steps": ["brew install bfg", "Verify: bfg --version", "supercli plugins install ./plugins/bfg-repo-cleaner --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bfg-repo-cleaner",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bfg CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bfg",
      "passthrough": true,
      "missingDependencyHelp": "Install bfg-repo-cleaner: brew install bfg", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
