{
  "plugin": "chezmoi",
  "binary": "chezmoi",
  "check": "which chezmoi",
  "install_steps": [
    "brew install chezmoi",
    "Or: sh -c \"$(curl -fsLS https://get.chezmoi.io)\"",
    "Verify: chezmoi --version",
    "supercli plugins install ./plugins/chezmoi --on-conflict replace --json"
  ],
  "note": "Also available via apt, dnf, pacman, nix, scoop, go install, and winget. See https://chezmoi.io/install/"
}
