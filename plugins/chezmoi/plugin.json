      "resource": "self",
      "action": "version",
      "description": "Print chezmoi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chezmoi",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install chezmoi: brew install chezmoi or sh -c \"$(curl -fsLS https://get.chezmoi.io)\""
      },
      "args": []
