{
  "name": "chezmoi",
  "version": "0.1.0",
  "description": "chezmoi — manage your dotfiles across multiple machines securely. Init, add, diff, apply, update, with template support, encryption, and JSON output.",
  "source": "https://chezmoi.io/reference/",
  "checks": [
    {
      "type": "binary",
      "name": "chezmoi"
    }
  ],
  "install_guidance": {
    "plugin": "chezmoi",
    "binary": "chezmoi",
    "check": "which chezmoi",
    "install_steps": [
      "brew install chezmoi",
      "Or: sh -c \"$(curl -fsLS https://get.chezmoi.io)\"",
      "Verify: chezmoi --version",
      "supercli plugins install ./plugins/chezmoi --on-conflict replace --json"
    ],
    "note": "Also available via apt, dnf, pacman, nix, scoop, and go install. See https://chezmoi.io/install/"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
