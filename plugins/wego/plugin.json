{
  "name": "wego",
  "version": "0.1.0",
  "description": "Weather client for the terminal",
  "source": "https://github.com/schachmat/wego",
  "checks": [
    {
      "type": "binary",
      "name": "wego"
    }
  ],
  "install_guidance": {
    "plugin": "wego",
    "binary": "wego",
    "check": "which wego",
    "install_steps": [
      "brew install wego",
      "Verify: wego --version",
      "supercli plugins install ./plugins/wego --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "wego",
      "resource": "self",
      "action": "version",
      "description": "Print wego version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wego",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wego: brew install wego"
      },
      "args": []
    },
    {
      "namespace": "wego",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wego CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wego",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wego: brew install wego"
      },
      "args": []
    }
  ]
}
