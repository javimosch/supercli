{
  "name": "cliclick",
  "version": "1.0.0",
  "description": "cliclick \u2014 CLI click automation",
  "source": "github.com/BlueM/cliclick",
  "checks": [
    {
      "type": "binary",
      "name": "cliclick"
    }
  ],
  "install_guidance": {
    "plugin": "cliclick",
    "binary": "cliclick",
    "check": "which cliclick",
    "install_steps": [
      "# Install cliclick",
      "# See github.com/BlueM/cliclick",
      "# apt: sudo apt-get install cliclick",
      "# brew: brew install cliclick",
      "# cargo: cargo install cliclick",
      "# npm: npm install -g cliclick",
      "# pip: pip install cliclick"
    ]
  },
  "commands": [
    {
      "namespace": "cliclick",
      "resource": "cliclick",
      "action": "run",
      "description": "Run cliclick",
      "adapter": "process",
      "adapterConfig": {
        "command": "cliclick",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cliclick from github.com/BlueM/cliclick"
      },
      "args": []
    }
  ]
}