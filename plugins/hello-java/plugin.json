{
  "name": "hello-java",
  "version": "0.1.0",
  "description": "Curso para aprender el lenguaje de programaci\u00f3n Java y Programaci\u00f3n Orientada a Objetos (POO) desde ",
  "source": "https://github.com/hello-java/hello-java",
  "checks": [
    {
      "type": "binary",
      "name": "hello-java"
    }
  ],
  "install_guidance": {
    "plugin": "hello-java",
    "binary": "hello-java",
    "check": "which hello-java",
    "install_steps": [
      "pip install hello-java",
      "Verify: hello-java --version",
      "supercli plugins install ./plugins/hello-java --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hello-java",
      "resource": "self",
      "action": "version",
      "description": "Print hello-java version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hello-java",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hello-java: pip install hello-java"
      },
      "args": []
    },
    {
      "namespace": "hello-java",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hello-java CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hello-java",
        "passthrough": true,
        "missingDependencyHelp": "Install hello-java: pip install hello-java"
      },
      "args": []
    }
  ]
}