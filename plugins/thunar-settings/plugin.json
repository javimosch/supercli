{
  "name": "thunar-settings",
  "version": "0.1.0",
  "description": "CLI tool: thunar-settings",
  "source": "https://manpages.debian.org/thunar-settings",
  "checks": [
    {
      "type": "binary",
      "name": "thunar-settings"
    }
  ],
  "install_guidance": {
    "plugin": "thunar-settings",
    "binary": "thunar-settings",
    "check": "which thunar-settings",
    "install_steps": [
      "apt-get install thunar-settings 2>/dev/null || which thunar-settings",
      "Verify: thunar-settings --version",
      "supercli plugins install ./plugins/thunar-settings --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "thunar-settings",
      "resource": "self",
      "action": "version",
      "description": "Print thunar-settings version",
      "adapter": "process",
      "adapterConfig": {
        "command": "thunar-settings",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install thunar-settings: apt-get install thunar-settings 2>/dev/null || which thunar-settings"
      },
      "args": []
    },
    {
      "namespace": "thunar-settings",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to thunar-settings CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "thunar-settings",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install thunar-settings: apt-get install thunar-settings 2>/dev/null || which thunar-settings"
      },
      "args": []
    }
  ]
}