{
  "name": "zmx",
  "version": "0.1.0",
  "description": "Session persistence for terminal processes",
  "source": "https://github.com/nickelc/zmx",
  "checks": [
    {
      "type": "binary",
      "name": "zmx"
    }
  ],
  "install_guidance": {
    "plugin": "zmx",
    "binary": "zmx",
    "check": "which zmx",
    "install_steps": [
      "cargo install zmx",
      "Verify: zmx --version",
      "supercli plugins install ./plugins/zmx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zmx",
      "resource": "self",
      "action": "version",
      "description": "Print zmx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zmx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zmx: cargo install zmx"
      },
      "args": []
    },
    {
      "namespace": "zmx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zmx",
      "adapter": "process",
      "adapterConfig": {
        "command": "zmx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install zmx: cargo install zmx"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
