{
  "name": "newsboat",
  "version": "0.1.0",
  "description": "newsboat — terminal RSS/Atom feed reader with OPML support, podcast integration, and extensible configuration",
  "source": "https://github.com/newsboat/newsboat",
  "checks": [
    { "type": "binary", "name": "newsboat" }
  ],
  "install_guidance": {
    "plugin": "newsboat",
    "binary": "newsboat",
    "check": "which newsboat",
    "install_steps": ["brew install newsboat", "Verify: newsboat --version", "supercli plugins install ./plugins/newsboat --on-conflict replace --json"]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "newsboat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to newsboat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "newsboat",
        "passthrough": true,
        "missingDependencyHelp": "Install newsboat: https://newsboat.org/#installation"
      },
      "args": []
    }
  ]
}
