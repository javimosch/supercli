{
  "name": "clustershell",
  "version": "1.0.0",
  "description": "clustershell \u2014 Cluster shell",
  "source": "github.com/cea-hpc/clustershell",
  "checks": [
    {
      "type": "binary",
      "name": "clush"
    }
  ],
  "install_guidance": {
    "plugin": "clustershell",
    "binary": "clush",
    "check": "which clush",
    "install_steps": [
      "# Install clustershell",
      "# See github.com/cea-hpc/clustershell",
      "# apt: sudo apt-get install clustershell",
      "# brew: brew install clustershell",
      "# cargo: cargo install clustershell",
      "# npm: npm install -g clustershell",
      "# pip: pip install clustershell"
    ]
  },
  "commands": [
    {
      "namespace": "clustershell",
      "resource": "clustershell",
      "action": "run",
      "description": "Run clustershell",
      "adapter": "process",
      "adapterConfig": {
        "command": "clush",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install clustershell from github.com/cea-hpc/clustershell"
      },
      "args": []
    }
  ]
}