{
  "name": "swiftformat",
  "version": "0.1.0",
  "description": "swiftformat \u2014 formatting tool for reformatting Swift code",
  "source": "https://formulae.brew.sh/formula/swiftformat",
  "checks": [
    {
      "type": "binary",
      "name": "swiftformat"
    }
  ],
  "install_guidance": {
    "plugin": "swiftformat",
    "binary": "swiftformat",
    "check": "which swiftformat",
    "install_steps": [
      "brew install swiftformat"
    ],
    "note": "Dev tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "swiftformat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough",
      "adapter": "process",
      "adapterConfig": {
        "command": "swiftformat",
        "passthrough": true,
        "missingDependencyHelp": "Install swiftformat: brew install swiftformat"
      },
      "args": []
    }
  ]
}
