{
  "name": "dua",
  "version": "0.1.0",
  "description": "dua (Disk Usage Analyzer) \u2014 a tool to conveniently learn about the usage of disk space of files.",
  "source": "https://github.com/Byron/dua-cli",
  "checks": [
    {
      "type": "binary",
      "name": "dua"
    }
  ],
  "install_guidance": {
    "plugin": "dua",
    "binary": "dua",
    "check": "which dua",
    "install_steps": [
      "cargo install dua-cli",
      "brew install dua-cli"
    ],
    "note": "Rust. Interactive disk usage analyzer with CLI mode. Binary: dua."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dua",
      "resource": "disk",
      "action": "usage",
      "description": "Show disk usage for a directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "dua",
        "missingDependencyHelp": "Install dua",
        "positionalArgs": [
          "directory"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "directory path"
        }
      ]
    },
    {
      "namespace": "dua",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dua",
        "missingDependencyHelp": "Install dua",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
