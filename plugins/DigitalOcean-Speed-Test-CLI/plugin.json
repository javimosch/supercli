{
  "name": "DigitalOcean-Speed-Test-CLI",
  "version": "0.1.0",
  "description": "A simple CLI for speed testing DigitalOcean's datacenters.",
  "source": "https://github.com/DigitalOcean-Speed-Test-CLI/DigitalOcean-Speed-Test-CLI",
  "checks": [
    {
      "type": "binary",
      "name": "DigitalOcean-Speed-Test-CLI"
    }
  ],
  "install_guidance": {
    "plugin": "DigitalOcean-Speed-Test-CLI",
    "binary": "DigitalOcean-Speed-Test-CLI",
    "check": "which DigitalOcean-Speed-Test-CLI",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: DigitalOcean-Speed-Test-CLI --version",
      "supercli plugins install ./plugins/DigitalOcean-Speed-Test-CLI --on-conflict replace --json"
    ],
    "note": "Shell language CLI tool"
  },
  "commands": [
    {
      "namespace": "DigitalOcean-Speed-Test-CLI",
      "resource": "self",
      "action": "version",
      "description": "Print DigitalOcean-Speed-Test-CLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "DigitalOcean-Speed-Test-CLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DigitalOcean-Speed-Test-CLI from project repository"
      },
      "args": []
    },
    {
      "namespace": "DigitalOcean-Speed-Test-CLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to DigitalOcean-Speed-Test-CLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "DigitalOcean-Speed-Test-CLI",
        "passthrough": true,
        "missingDependencyHelp": "Install DigitalOcean-Speed-Test-CLI from project repository"
      },
      "args": []
    }
  ]
}