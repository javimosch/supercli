{
  "name": "johnnydep",
  "version": "0.1.0",
  "description": "Display dependency tree of Python distribution",
  "source": "https://github.com/wimglenn/johnnydep",
  "checks": [
    {
      "type": "binary",
      "name": "johnnydep"
    }
  ],
  "install_guidance": {
    "plugin": "johnnydep",
    "binary": "johnnydep",
    "check": "which johnnydep",
    "install_steps": [
      "brew install johnnydep",
      "Verify: johnnydep --version",
      "supercli plugins install ./plugins/johnnydep --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "johnnydep",
      "resource": "self",
      "action": "version",
      "description": "Print johnnydep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "johnnydep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install johnnydep: brew install johnnydep"
      },
      "args": []
    },
    {
      "namespace": "johnnydep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to johnnydep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "johnnydep",
        "passthrough": true,
        "missingDependencyHelp": "Install johnnydep"
      },
      "args": []
    }
  ]
}