{
  "name": "pico-crypt",
  "version": "0.1.0",
  "description": "Simple file encryption tool with strong cryptography",
  "source": "https://github.com/mtu-agents/picocrypt",
  "checks": [{ "type": "binary", "name": "pico-crypt" }],
  "install_guidance": {
    "plugin": "pico-crypt",
    "binary": "pico-crypt",
    "check": "which pico-crypt",
    "install_steps": ["download release binaries", "Verify: pico-crypt --version", "supercli plugins install ./plugins/pico-crypt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pico-crypt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pico-crypt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pico-crypt",
      "passthrough": true,
      "missingDependencyHelp": "Install pico-crypt: download release binaries", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
