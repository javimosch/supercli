{
  "name": "fixwfwps",
  "version": "0.1.0",
  "description": "CLI tool: fixwfwps",
  "source": "https://manpages.debian.org/fixwfwps",
  "checks": [
    {
      "type": "binary",
      "name": "fixwfwps"
    }
  ],
  "install_guidance": {
    "plugin": "fixwfwps",
    "binary": "fixwfwps",
    "check": "which fixwfwps",
    "install_steps": [
      "apt-get install fixwfwps 2>/dev/null || which fixwfwps",
      "Verify: fixwfwps --version",
      "supercli plugins install ./plugins/fixwfwps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixwfwps",
      "resource": "self",
      "action": "version",
      "description": "Print fixwfwps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixwfwps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixwfwps: apt-get install fixwfwps 2>/dev/null || which fixwfwps"
      },
      "args": []
    },
    {
      "namespace": "fixwfwps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixwfwps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixwfwps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixwfwps: apt-get install fixwfwps 2>/dev/null || which fixwfwps"
      },
      "args": []
    }
  ]
}