{
  "name": "housecat",
  "version": "0.1.0",
  "description": "Static site generator written in pure C for POSIX systems",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "housecat" }],
  "install_guidance": {
    "plugin": "housecat",
    "binary": "housecat",
    "check": "which housecat",
    "install_steps": ["git clone && make && sudo make install", "Verify: housecat --version", "supercli plugins install ./plugins/housecat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "housecat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to housecat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "housecat",
      "passthrough": true,
      "missingDependencyHelp": "Install housecat: git clone && make && sudo make install"
    },
    "args": []
  }]
}
