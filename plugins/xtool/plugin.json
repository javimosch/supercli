{
  "name": "xtool",
  "version": "0.1.0",
  "description": "Cross-platform Xcode replacement. Build and deploy iOS apps with SwiftPM on Linux, Windows, macOS.",
  "source": "https://github.com/xtool/xtool",
  "checks": [
    {
      "type": "binary",
      "name": "xtool"
    }
  ],
  "install_guidance": {
    "plugin": "xtool",
    "binary": "xtool",
    "check": "which xtool",
    "install_steps": [
      "pip install xtool",
      "Verify: xtool --version",
      "supercli plugins install ./plugins/xtool --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xtool",
      "resource": "self",
      "action": "version",
      "description": "Print xtool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xtool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xtool: pip install xtool"
      },
      "args": []
    },
    {
      "namespace": "xtool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xtool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xtool",
        "passthrough": true,
        "missingDependencyHelp": "Install xtool: pip install xtool"
      },
      "args": []
    }
  ]
}