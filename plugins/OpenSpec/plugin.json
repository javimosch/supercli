{
  "name": "OpenSpec",
  "version": "0.1.0",
  "description": "Spec-driven development (SDD) for AI coding assistants.",
  "source": "https://github.com/OpenSpec/OpenSpec",
  "checks": [
    {
      "type": "binary",
      "name": "openspec"
    }
  ],
  "install_guidance": {
    "plugin": "OpenSpec",
    "binary": "openspec",
    "check": "which openspec",
    "install_steps": [
      "pip install openspec",
      "Verify: openspec --version",
      "supercli plugins install ./plugins/OpenSpec --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenSpec",
      "resource": "self",
      "action": "version",
      "description": "Print OpenSpec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openspec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenSpec: pip install openspec"
      },
      "args": []
    },
    {
      "namespace": "OpenSpec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openspec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openspec",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenSpec: pip install openspec"
      },
      "args": []
    }
  ]
}