{
  "name": "epsffit",
  "version": "0.1.0",
  "description": "CLI tool: epsffit",
  "source": "https://manpages.debian.org/epsffit",
  "checks": [
    {
      "type": "binary",
      "name": "epsffit"
    }
  ],
  "install_guidance": {
    "plugin": "epsffit",
    "binary": "epsffit",
    "check": "which epsffit",
    "install_steps": [
      "apt-get install epsffit 2>/dev/null || which epsffit",
      "Verify: epsffit --version",
      "supercli plugins install ./plugins/epsffit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "epsffit",
      "resource": "self",
      "action": "version",
      "description": "Print epsffit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "epsffit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install epsffit: apt-get install epsffit 2>/dev/null || which epsffit"
      },
      "args": []
    },
    {
      "namespace": "epsffit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to epsffit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "epsffit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install epsffit: apt-get install epsffit 2>/dev/null || which epsffit"
      },
      "args": []
    }
  ]
}