{
  "name": "protolint",
  "version": "0.1.0",
  "description": "Pluggable protocol buffer linter and formatter",
  "source": "https://github.com/yoheimuta/protolint",
  "checks": [{ "type": "binary", "name": "protolint" }],
  "install_guidance": {
    "plugin": "protolint",
    "binary": "protolint",
    "check": "which protolint",
    "install_steps": ["go install github.com/yoheimuta/protolint/cmd/protolint@latest", "Verify: protolint --version", "supercli plugins install ./plugins/protolint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "protolint",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to protolint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "protolint",
      "passthrough": true,
      "missingDependencyHelp": "Install protolint: go install github.com/yoheimuta/protolint/cmd/protolint@latest"
    },
    "args": []
  }]
}
