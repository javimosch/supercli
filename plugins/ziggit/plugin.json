{
  "name": "ziggit",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/ziggit/ziggit",
  "checks": [
    {
      "type": "binary",
      "name": "ziggit"
    }
  ],
  "install_guidance": {
    "plugin": "ziggit",
    "binary": "ziggit",
    "check": "which ziggit",
    "install_steps": [
      "pip install ziggit",
      "Verify: ziggit --version",
      "supercli plugins install ./plugins/ziggit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ziggit",
      "resource": "self",
      "action": "version",
      "description": "Print ziggit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ziggit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ziggit: pip install ziggit"
      },
      "args": []
    },
    {
      "namespace": "ziggit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ziggit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ziggit",
        "passthrough": true,
        "missingDependencyHelp": "Install ziggit: pip install ziggit"
      },
      "args": []
    }
  ]
}