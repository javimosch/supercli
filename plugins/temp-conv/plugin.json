{
  "name": "temp-conv",
  "version": "0.1.0",
  "description": "Multi-unit temperature converter for Kelvin Celsius Fahrenheit",
  "source": "https://github.com/kdy1/temp-conv",
  "checks": [{ "type": "binary", "name": "temp-conv" }],
  "install_guidance": {
    "plugin": "temp-conv",
    "binary": "temp-conv",
    "check": "which temp-conv",
    "install_steps": ["cargo install temp-conv", "Verify: temp-conv --version", "supercli plugins install ./plugins/temp-conv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "temp-conv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to temp-conv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "temp-conv",
      "passthrough": true,
      "missingDependencyHelp": "Install temp-conv: cargo install temp-conv", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
