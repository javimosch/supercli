{
  "plugin": "ip6tables-apply",
  "binary": "ip6tables-apply",
  "check": "which ip6tables-apply",
  "install_steps": [
    "# Install ip6tables-apply",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ip6tables-apply-linux-amd64 -o /usr/local/bin/ip6tables-apply",
    "chmod +x /usr/local/bin/ip6tables-apply",
    "# Or via package manager, see /usr/sbin/ip6tables-apply"
  ]
}