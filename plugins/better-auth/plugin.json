{
  "name": "better-auth",
  "version": "0.1.0",
  "description": "The most comprehensive authentication framework",
  "source": "https://github.com/better-auth/better-auth",
  "checks": [
    {
      "type": "binary",
      "name": "better-auth"
    }
  ],
  "install_guidance": {
    "plugin": "better-auth",
    "binary": "better-auth",
    "check": "which better-auth",
    "install_steps": [
      "pip install better-auth",
      "Verify: better-auth --version",
      "supercli plugins install ./plugins/better-auth --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "better-auth",
      "resource": "self",
      "action": "version",
      "description": "Print better-auth version",
      "adapter": "process",
      "adapterConfig": {
        "command": "better-auth",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install better-auth: pip install better-auth"
      },
      "args": []
    },
    {
      "namespace": "better-auth",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to better-auth CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "better-auth",
        "passthrough": true,
        "missingDependencyHelp": "Install better-auth: pip install better-auth"
      },
      "args": []
    }
  ]
}