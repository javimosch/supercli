{
  "name": "crawl4ai",
  "version": "0.1.0",
  "description": "\ud83d\ude80\ud83e\udd16 Crawl4AI: Open-source LLM Friendly Web Crawler & Scraper. Don't be shy, join here: https://discor",
  "source": "https://github.com/crawl4ai/crawl4ai",
  "checks": [
    {
      "type": "binary",
      "name": "crawl4ai"
    }
  ],
  "install_guidance": {
    "plugin": "crawl4ai",
    "binary": "crawl4ai",
    "check": "which crawl4ai",
    "install_steps": [
      "pip install crawl4ai",
      "Verify: crawl4ai --version",
      "supercli plugins install ./plugins/crawl4ai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "crawl4ai",
      "resource": "self",
      "action": "version",
      "description": "Print crawl4ai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crawl4ai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crawl4ai: pip install crawl4ai"
      },
      "args": []
    },
    {
      "namespace": "crawl4ai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crawl4ai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crawl4ai",
        "passthrough": true,
        "missingDependencyHelp": "Install crawl4ai: pip install crawl4ai"
      },
      "args": []
    }
  ]
}