{
  "name": "cursor-vip",
  "version": "0.1.0",
  "description": "cursor IDE enjoy VIP",
  "source": "https://github.com/cursor-vip/cursor-vip",
  "checks": [
    {
      "type": "binary",
      "name": "cursor-vip"
    }
  ],
  "install_guidance": {
    "plugin": "cursor-vip",
    "binary": "cursor-vip",
    "check": "which cursor-vip",
    "install_steps": [
      "pip install cursor-vip",
      "Verify: cursor-vip --version",
      "supercli plugins install ./plugins/cursor-vip --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cursor-vip",
      "resource": "self",
      "action": "version",
      "description": "Print cursor-vip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cursor-vip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cursor-vip: pip install cursor-vip"
      },
      "args": []
    },
    {
      "namespace": "cursor-vip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cursor-vip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cursor-vip",
        "passthrough": true,
        "missingDependencyHelp": "Install cursor-vip: pip install cursor-vip"
      },
      "args": []
    }
  ]
}