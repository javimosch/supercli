{
  "name": "prove",
  "version": "1.0.0",
  "description": "prove \u2014 prove \u2014 CLI utility",
  "source": "/usr/bin/prove",
  "checks": [
    {
      "type": "binary",
      "name": "prove"
    }
  ],
  "install_guidance": {
    "plugin": "prove",
    "binary": "prove",
    "check": "which prove",
    "install_steps": [
      "# Install prove:",
      "# apt: sudo apt-get install prove",
      "# brew: brew install prove",
      "# cargo: cargo install prove",
      "# npm: npm install -g prove",
      "# pip: pip install prove",
      "# or download from /usr/bin/prove"
    ]
  },
  "commands": [
    {
      "namespace": "prove",
      "resource": "prove",
      "action": "run",
      "description": "Run prove",
      "adapter": "process",
      "adapterConfig": {
        "command": "prove",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install prove from /usr/bin/prove"
      },
      "args": []
    }
  ]
}