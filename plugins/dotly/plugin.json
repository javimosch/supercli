{
  "name": "dotly",
  "version": "0.1.0",
  "description": "Framework of scripts and dotfiles for productivity",
  "source": "https://github.com/CodelyTV/dotly",
  "checks": [{ "type": "binary", "name": "dotly" }],
  "install_guidance": {
    "plugin": "dotly",
    "binary": "dotly",
    "check": "which dotly",
    "install_steps": ["git clone and install", "Verify: dotly --version", "supercli plugins install ./plugins/dotly --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dotly",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dotly CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dotly",
      "passthrough": true,
      "missingDependencyHelp": "Install dotly: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
