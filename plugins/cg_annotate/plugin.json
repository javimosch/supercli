{
  "name": "cg_annotate",
  "version": "0.1.0",
  "description": "CLI tool: cg_annotate",
  "source": "https://packages.debian.org/cg_annotate",
  "checks": [{ "type": "binary", "name": "cg_annotate" }],
  "install_guidance": {
    "plugin": "cg_annotate", "binary": "cg_annotate", "check": "which cg_annotate",
    "install_steps": ["apt-get install cg_annotate 2>/dev/null || which cg_annotate", "Verify: cg_annotate --version", "supercli plugins install ./plugins/cg_annotate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cg_annotate", "resource": "_", "action": "_",
    "description": "Passthrough to cg_annotate CLI",
    "adapter": "process", "adapterConfig": { "command": "cg_annotate", "passthrough": true, "missingDependencyHelp": "Install cg_annotate: apt-get install cg_annotate" }, "args": []
  }]
}
