{
  "name": "cglm",
  "version": "0.1.0",
  "description": "Optimized OpenGL/Graphics Math (glm) for C",
  "source": "https://github.com/recp/cglm",
  "checks": [
    {
      "type": "binary",
      "name": "cglm"
    }
  ],
  "install_guidance": {
    "plugin": "cglm",
    "binary": "cglm",
    "check": "which cglm",
    "install_steps": [
      "brew install cglm",
      "Verify: cglm --version",
      "supercli plugins install ./plugins/cglm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cglm",
      "resource": "self",
      "action": "version",
      "description": "Print cglm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cglm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cglm: brew install cglm"
      },
      "args": []
    },
    {
      "namespace": "cglm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cglm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cglm",
        "passthrough": true,
        "missingDependencyHelp": "Install cglm"
      },
      "args": []
    }
  ]
}