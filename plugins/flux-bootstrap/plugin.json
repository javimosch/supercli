{
  "name": "flux-bootstrap",
  "version": "0.1.0",
  "description": "Bootstrap Flux CD onto a Kubernetes cluster",
  "source": "https://github.com/fluxcd/flux2",
  "checks": [{ "type": "binary", "name": "flux-bootstrap" }],
  "install_guidance": {
    "plugin": "flux-bootstrap",
    "binary": "flux-bootstrap",
    "check": "which flux-bootstrap",
    "install_steps": ["brew install flux-bootstrap", "Verify: flux-bootstrap --version", "supercli plugins install ./plugins/flux-bootstrap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "flux-bootstrap",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to flux-bootstrap CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flux-bootstrap",
      "passthrough": true,
      "missingDependencyHelp": "Install flux-bootstrap: brew install flux-bootstrap"
    },
    "args": []
  }]
}
