{
  "name": "Black-Hat-Zig",
  "version": "0.1.0",
  "description": "This project provides some code examples of Zig for malwares, hacking, and red teaming. \u26a1",
  "source": "https://github.com/Black-Hat-Zig/Black-Hat-Zig",
  "checks": [
    {
      "type": "binary",
      "name": "black-hat-zig"
    }
  ],
  "install_guidance": {
    "plugin": "Black-Hat-Zig",
    "binary": "black-hat-zig",
    "check": "which black-hat-zig",
    "install_steps": [
      "pip install black-hat-zig",
      "Verify: black-hat-zig --version",
      "supercli plugins install ./plugins/Black-Hat-Zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Black-Hat-Zig",
      "resource": "self",
      "action": "version",
      "description": "Print Black-Hat-Zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "black-hat-zig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Black-Hat-Zig: pip install black-hat-zig"
      },
      "args": []
    },
    {
      "namespace": "Black-Hat-Zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to black-hat-zig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "black-hat-zig",
        "passthrough": true,
        "missingDependencyHelp": "Install Black-Hat-Zig: pip install black-hat-zig"
      },
      "args": []
    }
  ]
}