{
  "name": "pic2graph",
  "version": "0.1.0",
  "description": "CLI tool: pic2graph",
  "source": "https://manpages.debian.org/pic2graph",
  "checks": [
    {
      "type": "binary",
      "name": "pic2graph"
    }
  ],
  "install_guidance": {
    "plugin": "pic2graph",
    "binary": "pic2graph",
    "check": "which pic2graph",
    "install_steps": [
      "apt-get install pic2graph 2>/dev/null || which pic2graph",
      "Verify: pic2graph --version",
      "supercli plugins install ./plugins/pic2graph --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pic2graph",
      "resource": "self",
      "action": "version",
      "description": "Print pic2graph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pic2graph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pic2graph: apt-get install pic2graph 2>/dev/null || which pic2graph"
      },
      "args": []
    },
    {
      "namespace": "pic2graph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pic2graph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pic2graph",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pic2graph: apt-get install pic2graph 2>/dev/null || which pic2graph"
      },
      "args": []
    }
  ]
}