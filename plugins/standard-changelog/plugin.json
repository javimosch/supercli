{
  "name": "standard-changelog",
  "version": "0.1.0",
  "description": "Conventional commit-based changelog generator",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "standard-changelog" }],
  "install_guidance": {
    "plugin": "standard-changelog",
    "binary": "standard-changelog",
    "check": "which standard-changelog",
    "install_steps": ["npm install -g standard-changelog", "Verify: standard-changelog --version", "supercli plugins install ./plugins/standard-changelog --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "standard-changelog",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to standard-changelog CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "standard-changelog",
      "passthrough": true,
      "missingDependencyHelp": "Install standard-changelog: npm install -g standard-changelog"
    },
    "args": []
  }]
}
