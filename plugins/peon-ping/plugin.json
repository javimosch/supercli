{
  "name": "peon-ping",
  "version": "0.1.0",
  "description": "Warcraft III Peon voice notifications (+ more!) for Claude Code, Codex, IDEs, and any AI agent. Stop",
  "source": "https://github.com/peon-ping/peon-ping",
  "checks": [
    {
      "type": "binary",
      "name": "peon-ping"
    }
  ],
  "install_guidance": {
    "plugin": "peon-ping",
    "binary": "peon-ping",
    "check": "which peon-ping",
    "install_steps": [
      "pip install peon-ping",
      "Verify: peon-ping --version",
      "supercli plugins install ./plugins/peon-ping --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "peon-ping",
      "resource": "self",
      "action": "version",
      "description": "Print peon-ping version",
      "adapter": "process",
      "adapterConfig": {
        "command": "peon-ping",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install peon-ping: pip install peon-ping"
      },
      "args": []
    },
    {
      "namespace": "peon-ping",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to peon-ping CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "peon-ping",
        "passthrough": true,
        "missingDependencyHelp": "Install peon-ping: pip install peon-ping"
      },
      "args": []
    }
  ]
}