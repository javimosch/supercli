{
  "name": "csvjson-cli",
  "version": "0.1.0",
  "description": "CSV ↔ JSON converter with CLI, logging, tests",
  "source": "https://github.com/csvjson-cli/csvjson-cli",
  "checks": [
    {
      "type": "binary",
      "name": "csvjson-cli"
    }
  ],
  "install_guidance": {
    "plugin": "csvjson-cli",
    "binary": "csvjson-cli",
    "check": "which csvjson-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: csvjson-cli --version",
      "supercli plugins install ./plugins/csvjson-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "csvjson-cli",
      "resource": "self",
      "action": "version",
      "description": "Print csvjson-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvjson-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csvjson-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "csvjson-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csvjson-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvjson-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install csvjson-cli from project repository"
      },
      "args": []
    }
  ]
}