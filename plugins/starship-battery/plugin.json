{
  "name": "starship-battery",
  "version": "0.1.0",
  "description": "Cross-shell prompt with minimal configuration",
  "source": "https://github.com/starship/starship",
  "checks": [{ "type": "binary", "name": "starship" }],
  "install_guidance": {
    "plugin": "starship-battery",
    "binary": "starship",
    "check": "which starship",
    "install_steps": ["cargo install starship", "Verify: starship --version", "supercli plugins install ./plugins/starship-battery --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "starship-battery",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to starship CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "starship",
      "passthrough": true,
      "missingDependencyHelp": "Install starship-battery: cargo install starship"
    },
    "args": []
  }]
}
