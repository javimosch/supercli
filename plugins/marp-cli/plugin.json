{
  "name": "marp-cli",
  "version": "0.1.0",
  "description": "Convert Markdown to presentations, PDF, and HTML slides",
  "source": "https://github.com/marp-team/marp-cli",
  "checks": [
    {
      "type": "binary",
      "name": "marp"
    }
  ],
  "install_guidance": {
    "plugin": "marp-cli",
    "binary": "marp",
    "check": "which marp",
    "install_steps": [
      "npm install -g @marp-team/marp-cli",
      "Verify: marp --version",
      "supercli plugins install ./plugins/marp-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "marp-cli",
      "resource": "self",
      "action": "version",
      "description": "Print marp-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "marp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install marp-cli: npm install -g @marp-team/marp-cli"
      },
      "args": []
    },
    {
      "namespace": "marp-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to marp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "marp",
        "passthrough": true,
        "missingDependencyHelp": "Install marp-cli: npm install -g @marp-team/marp-cli"
      },
      "args": []
    }
  ]
}
