{
  "name": "snapper",
  "version": "0.1.0",
  "description": "Filesystem snapshot management",
  "source": "https://packages.debian.org/snapper",
  "checks": [{ "type": "binary", "name": "snapper" }],
  "install_guidance": {
    "plugin": "snapper", "binary": "snapper", "check": "which snapper",
    "install_steps": ["apt-get install snapper", "Verify: snapper --version", "supercli plugins install ./plugins/snapper --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "snapper", "resource": "_", "action": "_",
    "description": "Passthrough to snapper CLI",
    "adapter": "process", "adapterConfig": { "command": "snapper", "passthrough": true, "missingDependencyHelp": "Install snapper: apt-get install snapper" }, "args": []
  }]
}
