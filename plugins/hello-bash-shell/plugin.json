{
  "name": "hello-bash-shell",
  "version": "0.1.0",
  "description": "Curso para aprender a trabajar con Bash (Bourne-again shell), l\u00ednea de comandos, terminal y scriptin",
  "source": "https://github.com/hello-bash-shell/hello-bash-shell",
  "checks": [
    {
      "type": "binary",
      "name": "hello-bash-shell"
    }
  ],
  "install_guidance": {
    "plugin": "hello-bash-shell",
    "binary": "hello-bash-shell",
    "check": "which hello-bash-shell",
    "install_steps": [
      "pip install hello-bash-shell",
      "Verify: hello-bash-shell --version",
      "supercli plugins install ./plugins/hello-bash-shell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hello-bash-shell",
      "resource": "self",
      "action": "version",
      "description": "Print hello-bash-shell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hello-bash-shell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hello-bash-shell: pip install hello-bash-shell"
      },
      "args": []
    },
    {
      "namespace": "hello-bash-shell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hello-bash-shell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hello-bash-shell",
        "passthrough": true,
        "missingDependencyHelp": "Install hello-bash-shell: pip install hello-bash-shell"
      },
      "args": []
    }
  ]
}