{
  "name": "qhelpgenerator",
  "version": "0.1.0",
  "description": "CLI tool: qhelpgenerator",
  "source": "https://manpages.debian.org/qhelpgenerator",
  "checks": [
    {
      "type": "binary",
      "name": "qhelpgenerator"
    }
  ],
  "install_guidance": {
    "plugin": "qhelpgenerator",
    "binary": "qhelpgenerator",
    "check": "which qhelpgenerator",
    "install_steps": [
      "apt-get install qhelpgenerator 2>/dev/null || which qhelpgenerator",
      "Verify: qhelpgenerator --version",
      "supercli plugins install ./plugins/qhelpgenerator --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qhelpgenerator",
      "resource": "self",
      "action": "version",
      "description": "Print qhelpgenerator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qhelpgenerator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qhelpgenerator: apt-get install qhelpgenerator 2>/dev/null || which qhelpgenerator"
      },
      "args": []
    },
    {
      "namespace": "qhelpgenerator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qhelpgenerator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qhelpgenerator",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qhelpgenerator: apt-get install qhelpgenerator 2>/dev/null || which qhelpgenerator"
      },
      "args": []
    }
  ]
}