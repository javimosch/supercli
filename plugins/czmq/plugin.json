{
  "name": "czmq",
  "version": "0.1.0",
  "description": "High-level C binding for ZeroMQ",
  "checks": [
    {
      "type": "binary",
      "name": "czmq"
    }
  ],
  "install_guidance": {
    "plugin": "czmq",
    "binary": "czmq",
    "check": "which czmq",
    "install_steps": [
      "brew install czmq",
      "Verify: czmq --version",
      "supercli plugins install ./plugins/czmq --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "czmq",
      "resource": "self",
      "action": "version",
      "description": "Print czmq version",
      "adapter": "process",
      "adapterConfig": {
        "command": "czmq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install czmq: brew install czmq"
      },
      "args": []
    },
    {
      "namespace": "czmq",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to czmq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "czmq",
        "passthrough": true,
        "missingDependencyHelp": "Install czmq"
      },
      "args": []
    }
  ]
}