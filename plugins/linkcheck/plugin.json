{
  "name": "linkcheck",
  "version": "0.1.0",
  "description": "Check HTML documents for broken links",
  "source": "https://github.com/wummel/linkchecker",
  "checks": [{ "type": "binary", "name": "linkcheck" }],
  "install_guidance": {
    "plugin": "linkcheck",
    "binary": "linkcheck",
    "check": "which linkcheck",
    "install_steps": ["pip install linkcheck", "Verify: linkcheck --version", "supercli plugins install ./plugins/linkcheck --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "linkcheck",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to linkcheck CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "linkcheck",
      "passthrough": true,
      "missingDependencyHelp": "Install linkcheck: pip install linkcheck", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
