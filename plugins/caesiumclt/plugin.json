{
  "name": "caesiumclt",
  "version": "0.1.0",
  "description": "Fast and efficient lossy and/or lossless image compression tool",
  "source": "https://github.com/Lymphatus/caesium-clt",
  "checks": [
    {
      "type": "binary",
      "name": "caesiumclt"
    }
  ],
  "install_guidance": {
    "plugin": "caesiumclt",
    "binary": "caesiumclt",
    "check": "which caesiumclt",
    "install_steps": [
      "brew install caesiumclt",
      "Verify: caesiumclt --version",
      "supercli plugins install ./plugins/caesiumclt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "caesiumclt",
      "resource": "self",
      "action": "version",
      "description": "Print caesiumclt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "caesiumclt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install caesiumclt: brew install caesiumclt"
      },
      "args": []
    },
    {
      "namespace": "caesiumclt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to caesiumclt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "caesiumclt",
        "passthrough": true,
        "missingDependencyHelp": "Install caesiumclt"
      },
      "args": []
    }
  ]
}