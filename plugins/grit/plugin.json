{
  "name": "grit",
  "version": "0.1.0",
  "description": "A multitree-based personal task manager.",
  "source": "https://github.com/climech/grit",
  "checks": [
    {
      "type": "binary",
      "name": "grit"
    }
  ],
  "install_guidance": {
    "plugin": "grit",
    "binary": "grit",
    "check": "which grit",
    "install_steps": [
      "See https://github.com/climech/grit",
      "Verify: grit --version",
      "supercli plugins install ./plugins/grit --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "grit",
      "resource": "self",
      "action": "version",
      "description": "Print grit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grit: See https://github.com/climech/grit"
      },
      "args": []
    },
    {
      "namespace": "grit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grit",
        "passthrough": true,
        "missingDependencyHelp": "Install grit"
      },
      "args": []
    }
  ]
}