{
  "name": "pinact",
  "version": "0.1.0",
  "description": "Pin GitHub Actions versions to commit SHAs for security",
  "source": "https://github.com/suzuki-shunsuke/pinact",
  "checks": [{ "type": "binary", "name": "pinact" }],
  "install_guidance": {
    "plugin": "pinact",
    "binary": "pinact",
    "check": "which pinact",
    "install_steps": ["go install github.com/suzuki-shunsuke/pinact/cmd/pinact@latest", "Verify: pinact --version", "supercli plugins install ./plugins/pinact --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pinact",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pinact CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pinact",
      "passthrough": true,
      "missingDependencyHelp": "Install pinact: go install github.com/suzuki-shunsuke/pinact/cmd/pinact@latest"
    },
    "args": []
  }]
}
