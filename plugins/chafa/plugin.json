{
  "name": "chafa",
  "version": "0.1.0",
  "description": "Image-to-terminal converter with symbols support",
  "source": "https://github.com/hpjansson/chafa",
  "checks": [
    {
      "type": "binary",
      "name": "chafa"
    }
  ],
  "install_guidance": {
    "plugin": "chafa",
    "binary": "chafa",
    "check": "which chafa",
    "install_steps": [
      "brew install chafa",
      "Verify: chafa --version",
      "supercli plugins install ./plugins/chafa --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "chafa",
      "resource": "self",
      "action": "version",
      "description": "Print chafa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chafa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chafa: brew install chafa"
      },
      "args": []
    },
    {
      "namespace": "chafa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chafa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chafa",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install chafa: brew install chafa"
      },
      "args": []
    }
  ]
}
