{
  "name": "battery-level-cli",
  "version": "0.1.0",
  "description": "Get current battery level",
  "source": "https://github.com/gillstrom/battery-level-cli",
  "checks": [
    {
      "type": "binary",
      "name": "battery-level-cli"
    }
  ],
  "install_guidance": {
    "plugin": "battery-level-cli",
    "binary": "battery-level-cli",
    "check": "which battery-level-cli",
    "install_steps": [
      "See https://github.com/gillstrom/battery-level-cli",
      "Verify: battery-level-cli --version",
      "supercli plugins install ./plugins/battery-level-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "battery-level-cli",
      "resource": "self",
      "action": "version",
      "description": "Print battery-level-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "battery-level-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install battery-level-cli: See https://github.com/gillstrom/battery-level-cli"
      },
      "args": []
    },
    {
      "namespace": "battery-level-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to battery-level-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "battery-level-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install battery-level-cli"
      },
      "args": []
    }
  ]
}