{
  "name": "bencher",
  "version": "0.1.0",
  "description": "Continuous benchmarking tool for tracking performance",
  "source": "https://github.com/bencherdev/bencher",
  "checks": [{ "type": "binary", "name": "bencher" }],
  "install_guidance": {
    "plugin": "bencher",
    "binary": "bencher",
    "check": "which bencher",
    "install_steps": ["brew install bencher", "Verify: bencher --version", "supercli plugins install ./plugins/bencher --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bencher",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bencher CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bencher",
      "passthrough": true,
      "missingDependencyHelp": "Install bencher: brew install bencher", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
