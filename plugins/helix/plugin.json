{
  "name": "helix",
  "version": "0.1.0",
  "description": "A post-modern modal text editor with built-in LSP support and tree-sitter",
  "source": "https://github.com/helix-editor/helix",
  "checks": [{ "type": "binary", "name": "hx" }],
  "install_guidance": {
    "plugin": "helix",
    "binary": "hx",
    "check": "which hx",
    "install_steps": [
      "sudo pacman -S helix",
      "Or: brew install helix",
      "Or: cargo install helix --locked",
      "Or download from https://github.com/helix-editor/helix/releases",
      "Verify: hx --version",
      "supercli plugins install ./plugins/helix --on-conflict replace --json"
    ],
    "note": "Available via package managers and Cargo. Source: https://github.com/helix-editor/helix (44k+ stars). Written in Rust."
  },
  "commands": [
    {
      "namespace": "helix", "resource": "self", "action": "version",
      "description": "Print helix version",
      "adapter": "process",
      "adapterConfig": { "command": "hx", "missingDependencyHelp": "Install helix: cargo install helix --locked", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "helix", "resource": "_", "action": "_",
      "description": "Passthrough to helix CLI",
      "adapter": "process",
      "adapterConfig": { "command": "hx", "missingDependencyHelp": "Install helix: cargo install helix --locked", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
