{
  "name": "jose",
  "version": "0.1.0",
  "description": "C-language implementation of Javascript Object Signing and Encryption",
  "source": "https://github.com/latchset/jose",
  "checks": [
    {
      "type": "binary",
      "name": "jose"
    }
  ],
  "install_guidance": {
    "plugin": "jose",
    "binary": "jose",
    "check": "which jose",
    "install_steps": [
      "brew install jose",
      "Verify: jose --version",
      "supercli plugins install ./plugins/jose --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jose",
      "resource": "self",
      "action": "version",
      "description": "Print jose version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jose",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jose: brew install jose"
      },
      "args": []
    },
    {
      "namespace": "jose",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jose CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jose",
        "passthrough": true,
        "missingDependencyHelp": "Install jose"
      },
      "args": []
    }
  ]
}