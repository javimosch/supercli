{
  "name": "OpenList",
  "version": "0.1.0",
  "description": "A new AList Fork to Anti Trust Crisis",
  "source": "https://github.com/OpenList/OpenList",
  "checks": [
    {
      "type": "binary",
      "name": "openlist"
    }
  ],
  "install_guidance": {
    "plugin": "OpenList",
    "binary": "openlist",
    "check": "which openlist",
    "install_steps": [
      "pip install openlist",
      "Verify: openlist --version",
      "supercli plugins install ./plugins/OpenList --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenList",
      "resource": "self",
      "action": "version",
      "description": "Print OpenList version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openlist",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenList: pip install openlist"
      },
      "args": []
    },
    {
      "namespace": "OpenList",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openlist CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openlist",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenList: pip install openlist"
      },
      "args": []
    }
  ]
}