{
  "name": "dm-log",
  "version": "0.1.0",
  "description": "CLI tool: dm-log",
  "source": "https://packages.debian.org/dm-log",
  "checks": [{ "type": "binary", "name": "dm-log" }],
  "install_guidance": {
    "plugin": "dm-log", "binary": "dm-log", "check": "which dm-log",
    "install_steps": ["apt-get install dm-log 2>/dev/null || which dm-log", "Verify: dm-log --version", "supercli plugins install ./plugins/dm-log --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dm-log", "resource": "_", "action": "_",
    "description": "Passthrough to dm-log CLI",
    "adapter": "process", "adapterConfig": { "command": "dm-log", "passthrough": true, "missingDependencyHelp": "Install dm-log: apt-get install dm-log" }, "args": []
  }]
}
