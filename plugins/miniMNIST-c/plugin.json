{
  "name": "miniMNIST-c",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/miniMNIST-c/miniMNIST-c",
  "checks": [
    {
      "type": "binary",
      "name": "minimnist-c"
    }
  ],
  "install_guidance": {
    "plugin": "miniMNIST-c",
    "binary": "minimnist-c",
    "check": "which minimnist-c",
    "install_steps": [
      "pip install minimnist-c",
      "Verify: minimnist-c --version",
      "supercli plugins install ./plugins/miniMNIST-c --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "miniMNIST-c",
      "resource": "self",
      "action": "version",
      "description": "Print miniMNIST-c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "minimnist-c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install miniMNIST-c: pip install minimnist-c"
      },
      "args": []
    },
    {
      "namespace": "miniMNIST-c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to minimnist-c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "minimnist-c",
        "passthrough": true,
        "missingDependencyHelp": "Install miniMNIST-c: pip install minimnist-c"
      },
      "args": []
    }
  ]
}