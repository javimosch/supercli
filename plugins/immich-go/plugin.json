{
  "name": "immich-go",
  "version": "0.1.0",
  "description": "An alternative to the immich-CLI command that doesn't depend on nodejs installation. It tries its be",
  "source": "https://github.com/immich-go/immich-go",
  "checks": [
    {
      "type": "binary",
      "name": "immich-go"
    }
  ],
  "install_guidance": {
    "plugin": "immich-go",
    "binary": "immich-go",
    "check": "which immich-go",
    "install_steps": [
      "pip install immich-go",
      "Verify: immich-go --version",
      "supercli plugins install ./plugins/immich-go --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "immich-go",
      "resource": "self",
      "action": "version",
      "description": "Print immich-go version",
      "adapter": "process",
      "adapterConfig": {
        "command": "immich-go",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install immich-go: pip install immich-go"
      },
      "args": []
    },
    {
      "namespace": "immich-go",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to immich-go CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "immich-go",
        "passthrough": true,
        "missingDependencyHelp": "Install immich-go: pip install immich-go"
      },
      "args": []
    }
  ]
}