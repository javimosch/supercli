{
  "name": "sat-track",
  "version": "0.1.0",
  "description": "Simple terminal-based satellite pass predictor",
  "source": "go",
  "checks": [{ "type": "binary", "name": "sat-track" }],
  "install_guidance": {
    "plugin": "sat-track",
    "binary": "sat-track",
    "check": "which sat-track",
    "install_steps": ["go install github.com/sat-track@latest", "Verify: sat-track --version", "supercli plugins install ./plugins/sat-track --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sat-track",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sat-track CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sat-track",
      "passthrough": true,
      "missingDependencyHelp": "Install sat-track: go install github.com/sat-track@latest"
    },
    "args": []
  }]
}
