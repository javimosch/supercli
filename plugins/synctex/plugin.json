{
  "name": "synctex",
  "version": "0.1.0",
  "description": "CLI tool: synctex",
  "source": "https://manpages.debian.org/synctex",
  "checks": [
    {
      "type": "binary",
      "name": "synctex"
    }
  ],
  "install_guidance": {
    "plugin": "synctex",
    "binary": "synctex",
    "check": "which synctex",
    "install_steps": [
      "apt-get install synctex 2>/dev/null || which synctex",
      "Verify: synctex --version",
      "supercli plugins install ./plugins/synctex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "synctex",
      "resource": "self",
      "action": "version",
      "description": "Print synctex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "synctex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install synctex: apt-get install synctex 2>/dev/null || which synctex"
      },
      "args": []
    },
    {
      "namespace": "synctex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to synctex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "synctex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install synctex: apt-get install synctex 2>/dev/null || which synctex"
      },
      "args": []
    }
  ]
}