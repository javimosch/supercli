{
  "name": "gistify",
  "version": "0.1.0",
  "description": "Convert YAML/TOML/CSV/Excel to JSON in Go",
  "source": "https://github.com/gistify/gistify",
  "checks": [{"type": "binary", "name": "gistify"}],
  "install_guidance": {
    "plugin": "gistify",
    "binary": "gistify",
    "check": "which gistify",
    "install_steps": [
      "go install github.com/gistify/gistify@latest",
      "Verify: gistify --version",
      "supercli plugins install ./gistify --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "gistify",
      "resource": "self",
      "action": "version",
      "description": "Print gistify version",
      "adapter": "process",
      "adapterConfig": {"command": "gistify", "baseArgs": ["--version"], "missingDependencyHelp": "Install gistify: go install github.com/gistify/gistify@latest"},
      "args": []
    },
    {
      "namespace": "gistify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gistify CLI",
      "adapter": "process",
      "adapterConfig": {"command": "gistify", "passthrough": true, "missingDependencyHelp": "Install gistify: go install github.com/gistify/gistify@latest"},
      "args": []
    }
  ]
}
