{
  "name": "pico-args",
  "version": "0.1.0",
  "description": "pico-args — minimal argument parser for Rust",
  "source": "https://github.com/RazrFalcon/pico-args",
  "checks": [
    {
      "type": "binary",
      "name": "pico-args"
    }
  ],
  "install_guidance": {
    "plugin": "pico-args",
    "binary": "pico-args",
    "check": "which pico-args",
    "install_steps": [
      "cargo add pico-args",
      "Verify: pico-args --version",
      "supercli plugins install ./plugins/pico-args --on-conflict replace --json"
    ],
    "note": "pico-args is a Rust library — use `cargo add pico-args` inside a Rust project."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pico-args",
      "resource": "self",
      "action": "version",
      "description": "Print pico-args version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pico-args",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install pico-args: cargo add pico-args"
      },
      "args": []
    }
  ]
}
