{
  "plugin": "pico-args",
  "binary": "pico-args",
  "check": "which pico-args",
  "install_steps": [
    "cargo add pico-args",
    "Verify: pico-args --version",
    "supercli plugins install ./plugins/pico-args --on-conflict replace --json"
  ],
  "note": "pico-args is a Rust library — use `cargo add pico-args` inside a Rust project."
}
