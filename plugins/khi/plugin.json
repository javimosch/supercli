{
  "name": "khi",
  "version": "0.1.0",
  "description": "Fast Kubernetes log viewer and filter",
  "source": "https://github.com/nicholasgasior/khi",
  "checks": [
    {
      "type": "binary",
      "name": "khi"
    }
  ],
  "install_guidance": {
    "plugin": "khi",
    "binary": "khi",
    "check": "which khi",
    "install_steps": [
      "go install github.com/nicholasgasior/khi@latest",
      "Verify: khi --version",
      "supercli plugins install ./plugins/khi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "khi",
      "resource": "self",
      "action": "version",
      "description": "Print khi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "khi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install khi: go install github.com/nicholasgasior/khi@latest"
      },
      "args": []
    },
    {
      "namespace": "khi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to khi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "khi",
        "passthrough": true,
        "missingDependencyHelp": "Install khi: go install github.com/nicholasgasior/khi@latest"
      },
      "args": []
    }
  ]
}
