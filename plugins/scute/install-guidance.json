{
  "plugin": "scute",
  "binary": "scute",
  "check": "which scute",
  "install_steps": [
    "cargo install scute",
    "Verify: scute --version",
    "supercli plugins install ./plugins/scute --on-conflict replace --json"
  ],
  "note": "Requires Rust toolchain. All output is structured JSON by default."
}
