{
  "name": "jrunscript",
  "version": "0.1.0",
  "description": "CLI tool: jrunscript",
  "source": "https://manpages.debian.org/jrunscript",
  "checks": [
    {
      "type": "binary",
      "name": "jrunscript"
    }
  ],
  "install_guidance": {
    "plugin": "jrunscript",
    "binary": "jrunscript",
    "check": "which jrunscript",
    "install_steps": [
      "apt-get install jrunscript 2>/dev/null || which jrunscript",
      "Verify: jrunscript --version",
      "supercli plugins install ./plugins/jrunscript --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jrunscript",
      "resource": "self",
      "action": "version",
      "description": "Print jrunscript version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jrunscript",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jrunscript: apt-get install jrunscript 2>/dev/null || which jrunscript"
      },
      "args": []
    },
    {
      "namespace": "jrunscript",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jrunscript CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jrunscript",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jrunscript: apt-get install jrunscript 2>/dev/null || which jrunscript"
      },
      "args": []
    }
  ]
}