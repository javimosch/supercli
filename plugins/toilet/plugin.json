{
  "name": "toilet",
  "version": "0.1.0",
  "description": "Display large colorful ASCII text using FIGlet fonts",
  "source": "https",
  "checks": [{"type": "binary", "name": "toilet"}],
  "install_guidance": {
    "plugin": "toilet",
    "binary": "toilet",
    "check": "which toilet",
    "install_steps": [
      "brew install toilet",
      "Verify: toilet --version",
      "supercli plugins install ./plugins/toilet --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "toilet",
      "resource": "self",
      "action": "version",
      "description": "Print toilet version",
      "adapter": "process",
      "adapterConfig": {"command": "toilet", "baseArgs": ["--version"], "missingDependencyHelp": "Install toilet: brew install toilet"},
      "args": []
    },
    {
      "namespace": "toilet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to toilet CLI",
      "adapter": "process",
      "adapterConfig": {"command": "toilet", "passthrough": true, "missingDependencyHelp": "Install toilet: brew install toilet"},
      "args": []
    }
  ]
}
