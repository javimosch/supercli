{
  "name": "git-cal",
  "version": "0.1.0",
  "description": "GitHub-like contributions calendar but on the command-line",
  "source": "https://github.com/k4rthik/git-cal",
  "checks": [
    {
      "type": "binary",
      "name": "git-cal"
    }
  ],
  "install_guidance": {
    "plugin": "git-cal",
    "binary": "git-cal",
    "check": "which git-cal",
    "install_steps": [
      "brew install git-cal",
      "Verify: git-cal --version",
      "supercli plugins install ./plugins/git-cal --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-cal",
      "resource": "self",
      "action": "version",
      "description": "Print git-cal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-cal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-cal: brew install git-cal"
      },
      "args": []
    },
    {
      "namespace": "git-cal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-cal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-cal",
        "passthrough": true,
        "missingDependencyHelp": "Install git-cal"
      },
      "args": []
    }
  ]
}