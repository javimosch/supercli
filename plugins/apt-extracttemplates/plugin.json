{
  "name": "apt-extracttemplates",
  "version": "0.1.0",
  "description": "CLI tool: apt-extracttemplates",
  "source": "https://packages.debian.org/apt-extracttemplates",
  "checks": [{ "type": "binary", "name": "apt-extracttemplates" }],
  "install_guidance": {
    "plugin": "apt-extracttemplates", "binary": "apt-extracttemplates", "check": "which apt-extracttemplates",
    "install_steps": ["apt-get install apt-extracttemplates 2>/dev/null || which apt-extracttemplates", "Verify: apt-extracttemplates --version", "supercli plugins install ./plugins/apt-extracttemplates --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apt-extracttemplates", "resource": "_", "action": "_",
    "description": "Passthrough to apt-extracttemplates CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-extracttemplates", "passthrough": true, "missingDependencyHelp": "Install apt-extracttemplates: apt-get install apt-extracttemplates" }, "args": []
  }]
}
