{
  "name": "speedtest-net",
  "version": "0.1.0",
  "description": "Test internet connection speed and ping using speedtest.net",
  "source": "https://github.com/ddsol/speedtest.net",
  "checks": [
    {
      "type": "binary",
      "name": "speedtest-net"
    }
  ],
  "install_guidance": {
    "plugin": "speedtest-net",
    "binary": "speedtest-net",
    "check": "which speedtest-net",
    "install_steps": [
      "See https://github.com/ddsol/speedtest.net",
      "Verify: speedtest-net --version",
      "supercli plugins install ./plugins/speedtest-net --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "speedtest-net",
      "resource": "self",
      "action": "version",
      "description": "Print speedtest-net version",
      "adapter": "process",
      "adapterConfig": {
        "command": "speedtest-net",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install speedtest-net: See https://github.com/ddsol/speedtest.net"
      },
      "args": []
    },
    {
      "namespace": "speedtest-net",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to speedtest-net CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "speedtest-net",
        "passthrough": true,
        "missingDependencyHelp": "Install speedtest-net"
      },
      "args": []
    }
  ]
}