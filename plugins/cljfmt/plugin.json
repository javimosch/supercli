{
  "name": "cljfmt",
  "version": "0.1.0",
  "description": "Formatting Clojure code",
  "source": "https://github.com/weavejester/cljfmt",
  "checks": [
    {
      "type": "binary",
      "name": "cljfmt"
    }
  ],
  "install_guidance": {
    "plugin": "cljfmt",
    "binary": "cljfmt",
    "check": "which cljfmt",
    "install_steps": [
      "brew install cljfmt",
      "Verify: cljfmt --version",
      "supercli plugins install ./plugins/cljfmt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cljfmt",
      "resource": "self",
      "action": "version",
      "description": "Print cljfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cljfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cljfmt: brew install cljfmt"
      },
      "args": []
    },
    {
      "namespace": "cljfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cljfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cljfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install cljfmt"
      },
      "args": []
    }
  ]
}