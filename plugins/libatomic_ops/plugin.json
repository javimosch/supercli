{
  "name": "libatomic_ops",
  "version": "0.1.0",
  "description": "Implementations for atomic memory update operations",
  "source": "https://github.com/bdwgc/libatomic_ops/",
  "checks": [
    {
      "type": "binary",
      "name": "libatomic_ops"
    }
  ],
  "install_guidance": {
    "plugin": "libatomic_ops",
    "binary": "libatomic_ops",
    "check": "which libatomic_ops",
    "install_steps": [
      "brew install libatomic_ops",
      "Verify: libatomic_ops --version",
      "supercli plugins install ./plugins/libatomic_ops --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libatomic_ops",
      "resource": "self",
      "action": "version",
      "description": "Print libatomic_ops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libatomic_ops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libatomic_ops: brew install libatomic_ops"
      },
      "args": []
    },
    {
      "namespace": "libatomic_ops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libatomic_ops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libatomic_ops",
        "passthrough": true,
        "missingDependencyHelp": "Install libatomic_ops"
      },
      "args": []
    }
  ]
}