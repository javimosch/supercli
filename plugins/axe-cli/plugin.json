{
  "name": "axe-cli",
  "version": "0.1.0",
  "description": "Accessibility testing with aXe engine",
  "source": "https://github.com/dequelabs/axe-cli",
  "checks": [
    {
      "type": "binary",
      "name": "axe-cli"
    }
  ],
  "install_guidance": {
    "plugin": "axe-cli",
    "binary": "axe-cli",
    "check": "which axe-cli",
    "install_steps": [
      "npm install -g axe-cli",
      "Verify: axe-cli --version",
      "supercli plugins install ./plugins/axe-cli --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "axe-cli",
      "resource": "self",
      "action": "version",
      "description": "Print axe-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "axe-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install axe-cli: npm install -g axe-cli"
      },
      "args": []
    },
    {
      "namespace": "axe-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to axe-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "axe-cli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install axe-cli: npm install -g axe-cli"
      },
      "args": []
    }
  ]
}
