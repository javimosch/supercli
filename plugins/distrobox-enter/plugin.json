{
  "name": "distrobox-enter",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-enter",
  "source": "https://packages.debian.org/distrobox-enter",
  "checks": [{ "type": "binary", "name": "distrobox-enter" }],
  "install_guidance": {
    "plugin": "distrobox-enter", "binary": "distrobox-enter", "check": "which distrobox-enter",
    "install_steps": ["apt-get install distrobox-enter 2>/dev/null || which distrobox-enter", "Verify: distrobox-enter --version", "supercli plugins install ./plugins/distrobox-enter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distrobox-enter", "resource": "_", "action": "_",
    "description": "Passthrough to distrobox-enter CLI",
    "adapter": "process", "adapterConfig": { "command": "distrobox-enter", "passthrough": true, "missingDependencyHelp": "Install distrobox-enter: apt-get install distrobox-enter" }, "args": []
  }]
}
