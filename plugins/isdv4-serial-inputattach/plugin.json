{
  "name": "isdv4-serial-inputattach",
  "version": "0.1.0",
  "description": "CLI tool: isdv4-serial-inputattach",
  "source": "https://manpages.debian.org/isdv4-serial-inputattach",
  "checks": [
    {
      "type": "binary",
      "name": "isdv4-serial-inputattach"
    }
  ],
  "install_guidance": {
    "plugin": "isdv4-serial-inputattach",
    "binary": "isdv4-serial-inputattach",
    "check": "which isdv4-serial-inputattach",
    "install_steps": [
      "apt-get install isdv4-serial-inputattach 2>/dev/null || which isdv4-serial-inputattach",
      "Verify: isdv4-serial-inputattach --version",
      "supercli plugins install ./plugins/isdv4-serial-inputattach --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "isdv4-serial-inputattach",
      "resource": "self",
      "action": "version",
      "description": "Print isdv4-serial-inputattach version",
      "adapter": "process",
      "adapterConfig": {
        "command": "isdv4-serial-inputattach",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install isdv4-serial-inputattach: apt-get install isdv4-serial-inputattach 2>/dev/null || which isdv4-serial-inputattach"
      },
      "args": []
    },
    {
      "namespace": "isdv4-serial-inputattach",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to isdv4-serial-inputattach CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "isdv4-serial-inputattach",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install isdv4-serial-inputattach: apt-get install isdv4-serial-inputattach 2>/dev/null || which isdv4-serial-inputattach"
      },
      "args": []
    }
  ]
}