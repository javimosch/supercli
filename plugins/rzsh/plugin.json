{
  "name": "rzsh",
  "version": "1.0.0",
  "description": "rzsh \u2014 rzsh \u2014 CLI utility",
  "source": "/usr/bin/rzsh",
  "checks": [
    {
      "type": "binary",
      "name": "rzsh"
    }
  ],
  "install_guidance": {
    "plugin": "rzsh",
    "binary": "rzsh",
    "check": "which rzsh",
    "install_steps": [
      "# Install rzsh:",
      "# apt: sudo apt-get install rzsh",
      "# brew: brew install rzsh",
      "# cargo: cargo install rzsh",
      "# npm: npm install -g rzsh",
      "# pip: pip install rzsh",
      "# or download from /usr/bin/rzsh"
    ]
  },
  "commands": [
    {
      "namespace": "rzsh",
      "resource": "rzsh",
      "action": "run",
      "description": "Run rzsh",
      "adapter": "process",
      "adapterConfig": {
        "command": "rzsh",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rzsh from /usr/bin/rzsh"
      },
      "args": []
    }
  ]
}