{
  "plugin": "rzsh",
  "binary": "rzsh",
  "check": "which rzsh",
  "install_steps": [
    "# Install rzsh",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rzsh-linux-amd64 -o /usr/local/bin/rzsh",
    "chmod +x /usr/local/bin/rzsh",
    "# Or via package manager, see /usr/bin/rzsh"
  ]
}