{
  "name": "gvfs-monitor-file",
  "version": "0.1.0",
  "description": "CLI tool: gvfs-monitor-file",
  "source": "https://manpages.debian.org/gvfs-monitor-file",
  "checks": [
    {
      "type": "binary",
      "name": "gvfs-monitor-file"
    }
  ],
  "install_guidance": {
    "plugin": "gvfs-monitor-file",
    "binary": "gvfs-monitor-file",
    "check": "which gvfs-monitor-file",
    "install_steps": [
      "apt-get install gvfs-monitor-file 2>/dev/null || which gvfs-monitor-file",
      "Verify: gvfs-monitor-file --version",
      "supercli plugins install ./plugins/gvfs-monitor-file --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gvfs-monitor-file",
      "resource": "self",
      "action": "version",
      "description": "Print gvfs-monitor-file version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvfs-monitor-file",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gvfs-monitor-file: apt-get install gvfs-monitor-file 2>/dev/null || which gvfs-monitor-file"
      },
      "args": []
    },
    {
      "namespace": "gvfs-monitor-file",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gvfs-monitor-file CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvfs-monitor-file",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gvfs-monitor-file: apt-get install gvfs-monitor-file 2>/dev/null || which gvfs-monitor-file"
      },
      "args": []
    }
  ]
}