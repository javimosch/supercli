{
  "name": "usecomputer",
  "version": "0.1.0",
  "description": "Fast computer automation CLI for AI agents. Control any desktop with screenshots, clicks, typing, sc",
  "source": "https://github.com/usecomputer/usecomputer",
  "checks": [
    {
      "type": "binary",
      "name": "usecomputer"
    }
  ],
  "install_guidance": {
    "plugin": "usecomputer",
    "binary": "usecomputer",
    "check": "which usecomputer",
    "install_steps": [
      "pip install usecomputer",
      "Verify: usecomputer --version",
      "supercli plugins install ./plugins/usecomputer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "usecomputer",
      "resource": "self",
      "action": "version",
      "description": "Print usecomputer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "usecomputer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install usecomputer: pip install usecomputer"
      },
      "args": []
    },
    {
      "namespace": "usecomputer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to usecomputer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "usecomputer",
        "passthrough": true,
        "missingDependencyHelp": "Install usecomputer: pip install usecomputer"
      },
      "args": []
    }
  ]
}