{
  "name": "JackPaper",
  "version": "0.1.0",
  "description": "Set images from Unsplash as wallpaper",
  "source": "https://github.com/jackel27/jackpaper",
  "checks": [
    {
      "type": "binary",
      "name": "JackPaper"
    }
  ],
  "install_guidance": {
    "plugin": "JackPaper",
    "binary": "JackPaper",
    "check": "which JackPaper",
    "install_steps": [
      "See https://github.com/jackel27/jackpaper",
      "Verify: JackPaper --version",
      "supercli plugins install ./plugins/JackPaper --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "JackPaper",
      "resource": "self",
      "action": "version",
      "description": "Print JackPaper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "JackPaper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install JackPaper: See https://github.com/jackel27/jackpaper"
      },
      "args": []
    },
    {
      "namespace": "JackPaper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to JackPaper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "JackPaper",
        "passthrough": true,
        "missingDependencyHelp": "Install JackPaper"
      },
      "args": []
    }
  ]
}