{
  "name": "calm-garden-cli",
  "version": "0.1.0",
  "description": "A small, discreet terminal tool for breath exercises with progression: earn coins, buy plants, and upgrade your garden.",
  "source": "https://github.com/jaroslaw-weber/calm-garden-cli",
  "checks": [
    {
      "type": "binary",
      "name": "calm-garden-cli"
    }
  ],
  "install_guidance": {
    "plugin": "calm-garden-cli",
    "binary": "calm-garden-cli",
    "check": "which calm-garden-cli",
    "install_steps": [
      "See https://github.com/jaroslaw-weber/calm-garden-cli",
      "Verify: calm-garden-cli --version",
      "supercli plugins install ./plugins/calm-garden-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "calm-garden-cli",
      "resource": "self",
      "action": "version",
      "description": "Print calm-garden-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "calm-garden-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install calm-garden-cli: See https://github.com/jaroslaw-weber/calm-garden-cli"
      },
      "args": []
    },
    {
      "namespace": "calm-garden-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to calm-garden-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "calm-garden-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install calm-garden-cli"
      },
      "args": []
    }
  ]
}