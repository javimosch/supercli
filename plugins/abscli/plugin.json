{
  "name": "abscli",
  "version": "0.1.0",
  "description": "CLI wrapper for AudioBookShelf API operations",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "abscli" }],
  "install_guidance": {
    "plugin": "abscli",
    "binary": "abscli",
    "check": "which abscli",
    "install_steps": ["pip install abscli", "Verify: abscli --version", "supercli plugins install ./plugins/abscli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "abscli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to abscli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "abscli",
      "passthrough": true,
      "missingDependencyHelp": "Install abscli: pip install abscli"
    },
    "args": []
  }]
}
