{
  "name": "gltfpack",
  "version": "0.1.0",
  "description": "CLI tool: gltfpack",
  "source": "https://manpages.debian.org/gltfpack",
  "checks": [
    {
      "type": "binary",
      "name": "gltfpack"
    }
  ],
  "install_guidance": {
    "plugin": "gltfpack",
    "binary": "gltfpack",
    "check": "which gltfpack",
    "install_steps": [
      "apt-get install gltfpack 2>/dev/null || which gltfpack",
      "Verify: gltfpack --version",
      "supercli plugins install ./plugins/gltfpack --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gltfpack",
      "resource": "self",
      "action": "version",
      "description": "Print gltfpack version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gltfpack",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gltfpack: apt-get install gltfpack 2>/dev/null || which gltfpack"
      },
      "args": []
    },
    {
      "namespace": "gltfpack",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gltfpack CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gltfpack",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gltfpack: apt-get install gltfpack 2>/dev/null || which gltfpack"
      },
      "args": []
    }
  ]
}