{
  "name": "infrastructure-live",
  "version": "0.1.0",
  "description": "Best-practice infrastructure living documentation",
  "source": "https://github.com/gruntwork-io/infrastructure-live",
  "checks": [{ "type": "binary", "name": "infra-live" }],
  "install_guidance": {
    "plugin": "infrastructure-live",
    "binary": "infra-live",
    "check": "which infra-live",
    "install_steps": ["brew install infra-live", "Verify: infra-live --version", "supercli plugins install ./plugins/infrastructure-live --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "infrastructure-live",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to infra-live CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "infra-live",
      "passthrough": true,
      "missingDependencyHelp": "Install infrastructure-live: brew install infra-live"
    },
    "args": []
  }]
}
