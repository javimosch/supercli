{
  "name": "line-sequencer",
  "version": "0.1.0",
  "description": "Micro-sequencer language for live coding MIDI music",
  "source": "https://github.com/line-sequencer/line",
  "checks": [{ "type": "binary", "name": "line-sequencer" }],
  "install_guidance": {
    "plugin": "line-sequencer",
    "binary": "line-sequencer",
    "check": "which line-sequencer",
    "install_steps": ["cargo install line-sequencer", "Verify: line-sequencer --version", "supercli plugins install ./plugins/line-sequencer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "line-sequencer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to line-sequencer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "line-sequencer",
      "passthrough": true,
      "missingDependencyHelp": "Install line-sequencer: cargo install line-sequencer", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
