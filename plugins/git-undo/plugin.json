{
  "name": "git-undo",
  "version": "0.1.0",
  "description": "Smart git undo operations",
  "source": "https://github.com/bkrem/git-undo",
  "checks": [
    {
      "type": "binary",
      "name": "git-undo"
    }
  ],
  "install_guidance": {
    "plugin": "git-undo",
    "binary": "git-undo",
    "check": "which git-undo",
    "install_steps": [
      "npm install -g git-undo",
      "Verify: git-undo --version",
      "supercli plugins install ./plugins/git-undo --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "git-undo",
      "resource": "self",
      "action": "version",
      "description": "Print git-undo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-undo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-undo: npm install -g git-undo"
      },
      "args": []
    },
    {
      "namespace": "git-undo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-undo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-undo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install git-undo: npm install -g git-undo"
      },
      "args": []
    }
  ]
}
