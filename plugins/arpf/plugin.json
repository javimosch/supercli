{
  "name": "arpf",
  "version": "0.1.0",
  "description": "CLI tool: arpf",
  "source": "https://packages.debian.org/arpf",
  "checks": [{ "type": "binary", "name": "arpf" }],
  "install_guidance": {
    "plugin": "arpf", "binary": "arpf", "check": "which arpf",
    "install_steps": ["apt-get install arpf 2>/dev/null || which arpf", "Verify: arpf --version", "supercli plugins install ./plugins/arpf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "arpf", "resource": "_", "action": "_",
    "description": "Passthrough to arpf CLI",
    "adapter": "process", "adapterConfig": { "command": "arpf", "passthrough": true, "missingDependencyHelp": "Install arpf: apt-get install arpf" }, "args": []
  }]
}
