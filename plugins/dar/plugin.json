{
  "name": "dar",
  "version": "0.1.0",
  "description": "Disk ARchive — full-featured backup and archiving tool",
  "source": "https://dar.linux.free.fr",
  "checks": [{ "type": "binary", "name": "dar" }],
  "install_guidance": {
    "plugin": "dar",
    "binary": "dar",
    "check": "which dar",
    "install_steps": ["apt install dar", "brew install dar", "supercli plugins install ./plugins/dar --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dar",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dar CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dar",
      "passthrough": true,
      "missingDependencyHelp": "Install dar: apt install dar"
    },
    "args": []
  }]
}
