{
  "name": "xzbot",
  "version": "0.1.0",
  "description": "notes, honeypot, and exploit demo for the xz backdoor (CVE-2024-3094)",
  "source": "https://github.com/xzbot/xzbot",
  "checks": [
    {
      "type": "binary",
      "name": "xzbot"
    }
  ],
  "install_guidance": {
    "plugin": "xzbot",
    "binary": "xzbot",
    "check": "which xzbot",
    "install_steps": [
      "pip install xzbot",
      "Verify: xzbot --version",
      "supercli plugins install ./plugins/xzbot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xzbot",
      "resource": "self",
      "action": "version",
      "description": "Print xzbot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xzbot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xzbot: pip install xzbot"
      },
      "args": []
    },
    {
      "namespace": "xzbot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xzbot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xzbot",
        "passthrough": true,
        "missingDependencyHelp": "Install xzbot: pip install xzbot"
      },
      "args": []
    }
  ]
}