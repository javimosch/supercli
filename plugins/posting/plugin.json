{
  "name": "posting",
  "version": "0.1.0",
  "description": "posting — TUI HTTP client for exploring and testing APIs from the terminal",
  "source": "https://github.com/darrenburns/posting",
  "checks": [
    { "type": "binary", "name": "posting" }
  ],
  "install_guidance": {
    "plugin": "posting",
    "binary": "posting",
    "check": "which posting",
    "install_steps": [
      "pipx install posting",
      "Verify: posting --version"
    ],
    "note": "Also available via pip: pip install posting. Requires Python 3.11+. A keyboard-driven TUI HTTP client with collections, environments, and syntax highlighting."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "posting",
      "resource": "ui",
      "action": "open",
      "description": "Open the posting TUI interface",
      "adapter": "process",
      "adapterConfig": {
        "command": "posting",
        "passthrough": false,
        "missingDependencyHelp": "Install posting: pipx install posting"
      },
      "args": [
        { "name": "--collection", "type": "string", "description": "Path to collection directory" },
        { "name": "--env", "type": "string", "description": "Path to .env file for environment variables" }
      ]
    },
    {
      "namespace": "posting",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to posting CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "posting",
        "passthrough": true,
        "missingDependencyHelp": "Install posting: pipx install posting"
      },
      "args": []
    }
  ]
}
