{
  "name": "gemini-cli",
  "version": "0.1.0",
  "description": "An open-source AI agent that brings the power of Gemini directly into your terminal.",
  "source": "https://github.com/gemini-cli/gemini-cli",
  "checks": [
    {
      "type": "binary",
      "name": "gemini-cli"
    }
  ],
  "install_guidance": {
    "plugin": "gemini-cli",
    "binary": "gemini-cli",
    "check": "which gemini-cli",
    "install_steps": [
      "pip install gemini-cli",
      "Verify: gemini-cli --version",
      "supercli plugins install ./plugins/gemini-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gemini-cli",
      "resource": "self",
      "action": "version",
      "description": "Print gemini-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemini-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gemini-cli: pip install gemini-cli"
      },
      "args": []
    },
    {
      "namespace": "gemini-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gemini-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemini-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install gemini-cli: pip install gemini-cli"
      },
      "args": []
    }
  ]
}