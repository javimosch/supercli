{
  "name": "changelogen",
  "version": "0.1.0",
  "description": "Generate Beautiful Changelogs using Conventional Commits",
  "source": "https://github.com/unjs/changelogen",
  "checks": [
    {
      "type": "binary",
      "name": "changelogen"
    }
  ],
  "install_guidance": {
    "plugin": "changelogen",
    "binary": "changelogen",
    "check": "which changelogen",
    "install_steps": [
      "brew install changelogen",
      "Verify: changelogen --version",
      "supercli plugins install ./plugins/changelogen --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "changelogen",
      "resource": "self",
      "action": "version",
      "description": "Print changelogen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "changelogen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install changelogen: brew install changelogen"
      },
      "args": []
    },
    {
      "namespace": "changelogen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to changelogen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "changelogen",
        "passthrough": true,
        "missingDependencyHelp": "Install changelogen"
      },
      "args": []
    }
  ]
}