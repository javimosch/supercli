{
  "name": "meetily",
  "version": "0.1.0",
  "description": "Privacy first, AI meeting assistant with 4x faster Parakeet/Whisper live transcription, speaker diar",
  "source": "https://github.com/meetily/meetily",
  "checks": [
    {
      "type": "binary",
      "name": "meetily"
    }
  ],
  "install_guidance": {
    "plugin": "meetily",
    "binary": "meetily",
    "check": "which meetily",
    "install_steps": [
      "pip install meetily",
      "Verify: meetily --version",
      "supercli plugins install ./plugins/meetily --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "meetily",
      "resource": "self",
      "action": "version",
      "description": "Print meetily version",
      "adapter": "process",
      "adapterConfig": {
        "command": "meetily",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install meetily: pip install meetily"
      },
      "args": []
    },
    {
      "namespace": "meetily",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to meetily CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "meetily",
        "passthrough": true,
        "missingDependencyHelp": "Install meetily: pip install meetily"
      },
      "args": []
    }
  ]
}