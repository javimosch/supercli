{
  "name": "trustunnel",
  "version": "0.1.0",
  "description": "VPN tunnel protocol implementation in Rust",
  "source": "https://github.com/trustunnel/trustunnel",
  "checks": [
    {
      "type": "binary",
      "name": "trustunnel"
    }
  ],
  "install_guidance": {
    "plugin": "trustunnel",
    "binary": "trustunnel",
    "check": "which trustunnel",
    "install_steps": [
      "cargo install trustunnel",
      "Verify: trustunnel --version",
      "supercli plugins install ./plugins/trustunnel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "trustunnel",
    "resource": "self",
    "action": "version",
    "description": "Print trustunnel version",
    "adapter": "process",
    "adapterConfig": {
      "command": "trustunnel",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install trustunnel: cargo install trustunnel"
    },
    "args": []
  },
  {
    "namespace": "trustunnel",
    "resource": "tunnel",
    "action": "connect",
    "description": "Connect to a VPN tunnel",
    "adapter": "process",
    "adapterConfig": {
      "command": "trustunnel",
      "baseArgs": [
        "connect"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install trustunnel: cargo install trustunnel"
    },
    "args": []
  },
  {
    "namespace": "trustunnel",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to trustunnel CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "trustunnel",
      "passthrough": true,
      "missingDependencyHelp": "Install trustunnel"
    },
    "args": []
  }
]
}