{
  "name": "google-sparsehash",
  "version": "0.1.0",
  "description": "Extremely memory-efficient hash_map implementation",
  "source": "https://github.com/sparsehash/sparsehash",
  "checks": [
    {
      "type": "binary",
      "name": "google-sparsehash"
    }
  ],
  "install_guidance": {
    "plugin": "google-sparsehash",
    "binary": "google-sparsehash",
    "check": "which google-sparsehash",
    "install_steps": [
      "brew install google-sparsehash",
      "Verify: google-sparsehash --version",
      "supercli plugins install ./plugins/google-sparsehash --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "google-sparsehash",
      "resource": "self",
      "action": "version",
      "description": "Print google-sparsehash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-sparsehash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install google-sparsehash: brew install google-sparsehash"
      },
      "args": []
    },
    {
      "namespace": "google-sparsehash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to google-sparsehash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-sparsehash",
        "passthrough": true,
        "missingDependencyHelp": "Install google-sparsehash"
      },
      "args": []
    }
  ]
}