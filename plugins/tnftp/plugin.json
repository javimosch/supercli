{
  "name": "tnftp",
  "version": "0.1.0",
  "description": "CLI tool: tnftp",
  "source": "https://manpages.debian.org/tnftp",
  "checks": [
    {
      "type": "binary",
      "name": "tnftp"
    }
  ],
  "install_guidance": {
    "plugin": "tnftp",
    "binary": "tnftp",
    "check": "which tnftp",
    "install_steps": [
      "apt-get install tnftp 2>/dev/null || which tnftp",
      "Verify: tnftp --version",
      "supercli plugins install ./plugins/tnftp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tnftp",
      "resource": "self",
      "action": "version",
      "description": "Print tnftp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tnftp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tnftp: apt-get install tnftp 2>/dev/null || which tnftp"
      },
      "args": []
    },
    {
      "namespace": "tnftp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tnftp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tnftp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tnftp: apt-get install tnftp 2>/dev/null || which tnftp"
      },
      "args": []
    }
  ]
}