{
  "name": "wavedrom-cli",
  "version": "0.1.0",
  "description": "Digital timing diagrams from JSON descriptions via CLI",
  "source": "https://github.com/wavedrom/cli",
  "checks": [{ "type": "binary", "name": "wavedrom-cli" }],
  "install_guidance": {
    "plugin": "wavedrom-cli",
    "binary": "wavedrom-cli",
    "check": "which wavedrom-cli",
    "install_steps": ["npm install -g wavedrom-cli", "Verify: wavedrom-cli --version", "supercli plugins install ./plugins/wavedrom-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wavedrom-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wavedrom-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wavedrom-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install wavedrom-cli: npm install -g wavedrom-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
