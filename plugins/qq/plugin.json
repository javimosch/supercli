{
  "name": "qq",
  "version": "0.1.0",
  "description": "A jq-inspired interoperable format transcoder that converts between JSON, CSV, YAML, HCL, TOML, and XML. Supports interactive querying and pipeline operations.",
  "source": "https://github.com/JFryy/qq",
  "checks": [{ "type": "binary", "name": "qq" }],
