    { "namespace": "qq", "resource": "self", "action": "version", "description": "Print qq version", "adapter": "process", "adapterConfig": { "command": "qq", "baseArgs": ["--version"], "missingDependencyHelp": "Install qq: brew install qq" }, "args": [] },
    { "namespace": "qq", "resource": "_", "action": "_", "description": "Passthrough to qq CLI", "adapter": "process", "adapterConfig": { "command": "qq", "passthrough": true, "missingDependencyHelp": "Install qq: brew install qq" }, "args": [] }
  ]
}
