{
  "name": "clib",
  "version": "0.1.0",
  "description": "Package manager for C programming",
  "source": "https://github.com/clibs/clib",
  "checks": [
    {
      "type": "binary",
      "name": "clib"
    }
  ],
  "install_guidance": {
    "plugin": "clib",
    "binary": "clib",
    "check": "which clib",
    "install_steps": [
      "brew install clib",
      "Verify: clib --version",
      "supercli plugins install ./plugins/clib --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clib",
      "resource": "self",
      "action": "version",
      "description": "Print clib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clib: brew install clib"
      },
      "args": []
    },
    {
      "namespace": "clib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clib",
        "passthrough": true,
        "missingDependencyHelp": "Install clib"
      },
      "args": []
    }
  ]
}