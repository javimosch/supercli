{
  "name": "vibe-notch",
  "version": "0.1.0",
  "description": "Claude Code notifications without the context switch. A minimal, always-present session manager for ",
  "source": "https://github.com/vibe-notch/vibe-notch",
  "checks": [
    {
      "type": "binary",
      "name": "vibe-notch"
    }
  ],
  "install_guidance": {
    "plugin": "vibe-notch",
    "binary": "vibe-notch",
    "check": "which vibe-notch",
    "install_steps": [
      "pip install vibe-notch",
      "Verify: vibe-notch --version",
      "supercli plugins install ./plugins/vibe-notch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vibe-notch",
      "resource": "self",
      "action": "version",
      "description": "Print vibe-notch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibe-notch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vibe-notch: pip install vibe-notch"
      },
      "args": []
    },
    {
      "namespace": "vibe-notch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vibe-notch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibe-notch",
        "passthrough": true,
        "missingDependencyHelp": "Install vibe-notch: pip install vibe-notch"
      },
      "args": []
    }
  ]
}