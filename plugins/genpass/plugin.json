{
  "name": "genpass",
  "version": "0.1.0",
  "description": "Generate strong random passwords with configurable rules",
  "source": "https://github.com/cyplo/genpass",
  "checks": [{ "type": "binary", "name": "genpass" }],
  "install_guidance": {
    "plugin": "genpass",
    "binary": "genpass",
    "check": "which genpass",
    "install_steps": ["cargo install genpass", "Verify: genpass --version", "supercli plugins install ./plugins/genpass --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "genpass",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to genpass CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "genpass",
      "passthrough": true,
      "missingDependencyHelp": "Install genpass: cargo install genpass", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
