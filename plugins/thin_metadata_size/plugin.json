{
  "name": "thin_metadata_size",
  "version": "0.1.0",
  "description": "CLI tool: thin_metadata_size",
  "source": "https://manpages.debian.org/thin_metadata_size",
  "checks": [
    {
      "type": "binary",
      "name": "thin_metadata_size"
    }
  ],
  "install_guidance": {
    "plugin": "thin_metadata_size",
    "binary": "thin_metadata_size",
    "check": "which thin_metadata_size",
    "install_steps": [
      "apt-get install thin_metadata_size 2>/dev/null || which thin_metadata_size",
      "Verify: thin_metadata_size --version",
      "supercli plugins install ./plugins/thin_metadata_size --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "thin_metadata_size",
      "resource": "self",
      "action": "version",
      "description": "Print thin_metadata_size version",
      "adapter": "process",
      "adapterConfig": {
        "command": "thin_metadata_size",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install thin_metadata_size: apt-get install thin_metadata_size 2>/dev/null || which thin_metadata_size"
      },
      "args": []
    },
    {
      "namespace": "thin_metadata_size",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to thin_metadata_size CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "thin_metadata_size",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install thin_metadata_size: apt-get install thin_metadata_size 2>/dev/null || which thin_metadata_size"
      },
      "args": []
    }
  ]
}