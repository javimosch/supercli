{
  "name": "yap",
  "version": "0.1.0",
  "description": "\ud83d\udde3\ufe0f A CLI for on-device speech transcription using Speech.framework on macOS 26",
  "source": "https://github.com/yap/yap",
  "checks": [
    {
      "type": "binary",
      "name": "yap"
    }
  ],
  "install_guidance": {
    "plugin": "yap",
    "binary": "yap",
    "check": "which yap",
    "install_steps": [
      "pip install yap",
      "Verify: yap --version",
      "supercli plugins install ./plugins/yap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yap",
      "resource": "self",
      "action": "version",
      "description": "Print yap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yap: pip install yap"
      },
      "args": []
    },
    {
      "namespace": "yap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yap",
        "passthrough": true,
        "missingDependencyHelp": "Install yap: pip install yap"
      },
      "args": []
    }
  ]
}