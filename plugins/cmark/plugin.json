{
  "name": "cmark",
  "version": "1.0.0",
  "description": "cmark \u2014 CommonMark rendering",
  "source": "github.com/commonmark/cmark",
  "checks": [
    {
      "type": "binary",
      "name": "cmark"
    }
  ],
  "install_guidance": {
    "plugin": "cmark",
    "binary": "cmark",
    "check": "which cmark",
    "install_steps": [
      "# Install cmark",
      "# See github.com/commonmark/cmark",
      "# apt: sudo apt-get install cmark",
      "# brew: brew install cmark",
      "# cargo: cargo install cmark",
      "# npm: npm install -g cmark",
      "# pip: pip install cmark"
    ]
  },
  "commands": [
    {
      "namespace": "cmark",
      "resource": "cmark",
      "action": "run",
      "description": "Run cmark",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmark",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cmark from github.com/commonmark/cmark"
      },
      "args": []
    }
  ]
}