{
  "name": "git-recent",
  "version": "0.1.0",
  "description": "See your latest local git branches formatted as list",
  "source": "https://github.com/paulirish/git-recent",
  "checks": [{ "type": "binary", "name": "git-recent" }],
  "install_guidance": {
    "plugin": "git-recent",
    "binary": "git-recent",
    "check": "which git-recent",
    "install_steps": ["npm install -g git-recent", "Verify: git-recent --version", "supercli plugins install ./plugins/git-recent --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-recent",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-recent CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-recent",
      "passthrough": true,
      "missingDependencyHelp": "Install git-recent: npm install -g git-recent"
    },
    "args": []
  }]
}
