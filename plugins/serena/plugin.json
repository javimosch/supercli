{
  "name": "serena",
  "version": "0.1.0",
  "description": "A powerful MCP toolkit for coding, providing semantic retrieval and editing capabilities  - the IDE ",
  "source": "https://github.com/serena/serena",
  "checks": [
    {
      "type": "binary",
      "name": "serena"
    }
  ],
  "install_guidance": {
    "plugin": "serena",
    "binary": "serena",
    "check": "which serena",
    "install_steps": [
      "pip install serena",
      "Verify: serena --version",
      "supercli plugins install ./plugins/serena --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "serena",
      "resource": "self",
      "action": "version",
      "description": "Print serena version",
      "adapter": "process",
      "adapterConfig": {
        "command": "serena",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install serena: pip install serena"
      },
      "args": []
    },
    {
      "namespace": "serena",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to serena CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "serena",
        "passthrough": true,
        "missingDependencyHelp": "Install serena: pip install serena"
      },
      "args": []
    }
  ]
}