{
  "name": "slidev",
  "version": "0.1.0",
  "description": "slidev — presentation slides for developers from Markdown, with themes, code highlighting, and live coding",
  "source": "https://github.com/slidevjs/slidev",
  "checks": [
    {
      "type": "binary",
      "name": "slidev"
    }
  ],
  "install_guidance": {
    "plugin": "slidev",
    "binary": "slidev",
    "check": "which slidev",
    "install_steps": [
      "npm install -g @slidev/cli",
      "Verify: slidev --version",
      "Start a presentation: slidev",
      "supercli plugins install ./plugins/slidev --on-conflict replace --json"
    ],
    "note": "Requires Node.js >= 20.12.0. Also available via: brew install slidev, pnpm add -g @slidev/cli, or yarn global add @slidev/cli."
  },
  "commands": [
    {
      "namespace": "slidev",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to slidev CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "slidev",
        "passthrough": true,
        "missingDependencyHelp": "Install slidev: npm install -g @slidev/cli"
      },
      "args": []
    }
  ]
}
