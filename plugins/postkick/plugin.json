{
  "name": "postkick",
  "version": "1.0.0",
  "description": "postkick \u2014 postkick \u2014 CLI utility",
  "source": "/usr/sbin/postkick",
  "checks": [
    {
      "type": "binary",
      "name": "postkick"
    }
  ],
  "install_guidance": {
    "plugin": "postkick",
    "binary": "postkick",
    "check": "which postkick",
    "install_steps": [
      "# Install postkick:",
      "# apt: sudo apt-get install postkick",
      "# brew: brew install postkick",
      "# cargo: cargo install postkick",
      "# npm: npm install -g postkick",
      "# pip: pip install postkick",
      "# or download from /usr/sbin/postkick"
    ]
  },
  "commands": [
    {
      "namespace": "postkick",
      "resource": "postkick",
      "action": "run",
      "description": "Run postkick",
      "adapter": "process",
      "adapterConfig": {
        "command": "postkick",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postkick from /usr/sbin/postkick"
      },
      "args": []
    }
  ]
}