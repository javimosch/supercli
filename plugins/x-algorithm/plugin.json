{
  "name": "x-algorithm",
  "version": "0.1.0",
  "description": "Algorithm powering the For You feed on X",
  "source": "https://github.com/x-algorithm/x-algorithm",
  "checks": [
    {
      "type": "binary",
      "name": "x-algorithm"
    }
  ],
  "install_guidance": {
    "plugin": "x-algorithm",
    "binary": "x-algorithm",
    "check": "which x-algorithm",
    "install_steps": [
      "pip install x-algorithm",
      "Verify: x-algorithm --version",
      "supercli plugins install ./plugins/x-algorithm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "x-algorithm",
      "resource": "self",
      "action": "version",
      "description": "Print x-algorithm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "x-algorithm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install x-algorithm: pip install x-algorithm"
      },
      "args": []
    },
    {
      "namespace": "x-algorithm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to x-algorithm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "x-algorithm",
        "passthrough": true,
        "missingDependencyHelp": "Install x-algorithm: pip install x-algorithm"
      },
      "args": []
    }
  ]
}