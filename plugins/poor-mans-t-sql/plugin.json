{
  "name": "poor-mans-t-sql",
  "version": "0.1.0",
  "description": "Node.js command-line SQL formatter and beautifier",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "poor-mans-t-sql" }],
  "install_guidance": {
    "plugin": "poor-mans-t-sql",
    "binary": "poor-mans-t-sql",
    "check": "which poor-mans-t-sql",
    "install_steps": ["npm install -g poor-mans-t-sql-formatter-npm-cli", "Verify: poor-mans-t-sql --version", "supercli plugins install ./plugins/poor-mans-t-sql --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "poor-mans-t-sql",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to poor-mans-t-sql CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "poor-mans-t-sql",
      "passthrough": true,
      "missingDependencyHelp": "Install poor-mans-t-sql: npm install -g poor-mans-t-sql-formatter-npm-cli"
    },
    "args": []
  }]
}
