{
  "name": "pyi-set_version",
  "version": "0.1.0",
  "description": "CLI tool: pyi-set_version",
  "source": "https://manpages.debian.org/pyi-set_version",
  "checks": [
    {
      "type": "binary",
      "name": "pyi-set_version"
    }
  ],
  "install_guidance": {
    "plugin": "pyi-set_version",
    "binary": "pyi-set_version",
    "check": "which pyi-set_version",
    "install_steps": [
      "apt-get install pyi-set_version 2>/dev/null || which pyi-set_version",
      "Verify: pyi-set_version --version",
      "supercli plugins install ./plugins/pyi-set_version --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyi-set_version",
      "resource": "self",
      "action": "version",
      "description": "Print pyi-set_version version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-set_version",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyi-set_version: apt-get install pyi-set_version 2>/dev/null || which pyi-set_version"
      },
      "args": []
    },
    {
      "namespace": "pyi-set_version",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyi-set_version CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-set_version",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyi-set_version: apt-get install pyi-set_version 2>/dev/null || which pyi-set_version"
      },
      "args": []
    }
  ]
}