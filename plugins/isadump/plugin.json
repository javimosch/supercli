{
  "name": "isadump",
  "version": "0.1.0",
  "description": "CLI tool: isadump",
  "source": "https://manpages.debian.org/isadump",
  "checks": [
    {
      "type": "binary",
      "name": "isadump"
    }
  ],
  "install_guidance": {
    "plugin": "isadump",
    "binary": "isadump",
    "check": "which isadump",
    "install_steps": [
      "apt-get install isadump 2>/dev/null || which isadump",
      "Verify: isadump --version",
      "supercli plugins install ./plugins/isadump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "isadump",
      "resource": "self",
      "action": "version",
      "description": "Print isadump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "isadump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install isadump: apt-get install isadump 2>/dev/null || which isadump"
      },
      "args": []
    },
    {
      "namespace": "isadump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to isadump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "isadump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install isadump: apt-get install isadump 2>/dev/null || which isadump"
      },
      "args": []
    }
  ]
}