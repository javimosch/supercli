{
  "name": "clr",
  "version": "0.1.0",
  "description": "Checker for Lifetimes and other Refinement types",
  "source": "https://github.com/clr/clr",
  "checks": [
    {
      "type": "binary",
      "name": "clr"
    }
  ],
  "install_guidance": {
    "plugin": "clr",
    "binary": "clr",
    "check": "which clr",
    "install_steps": [
      "pip install clr",
      "Verify: clr --version",
      "supercli plugins install ./plugins/clr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clr",
      "resource": "self",
      "action": "version",
      "description": "Print clr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clr: pip install clr"
      },
      "args": []
    },
    {
      "namespace": "clr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clr",
        "passthrough": true,
        "missingDependencyHelp": "Install clr: pip install clr"
      },
      "args": []
    }
  ]
}