{
  "name": "colorly",
  "version": "0.1.0",
  "description": "Ruby CLI and DSL for generating color palettes to JSON/YAML",
  "source": "gem",
  "checks": [{ "type": "binary", "name": "colorly" }],
  "install_guidance": {
    "plugin": "colorly",
    "binary": "colorly",
    "check": "which colorly",
    "install_steps": ["gem install colorly", "Verify: colorly --version", "supercli plugins install ./plugins/colorly --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "colorly",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to colorly CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "colorly",
      "passthrough": true,
      "missingDependencyHelp": "Install colorly: gem install colorly"
    },
    "args": []
  }]
}
