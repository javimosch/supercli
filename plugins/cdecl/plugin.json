{
  "name": "cdecl",
  "version": "0.1.0",
  "description": "Turn English phrases to C or C++ declarations",
  "source": "https://github.com/paul-j-lucas/cdecl",
  "checks": [
    {
      "type": "binary",
      "name": "cdecl"
    }
  ],
  "install_guidance": {
    "plugin": "cdecl",
    "binary": "cdecl",
    "check": "which cdecl",
    "install_steps": [
      "brew install cdecl",
      "Verify: cdecl --version",
      "supercli plugins install ./plugins/cdecl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cdecl",
      "resource": "self",
      "action": "version",
      "description": "Print cdecl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdecl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cdecl: brew install cdecl"
      },
      "args": []
    },
    {
      "namespace": "cdecl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cdecl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cdecl",
        "passthrough": true,
        "missingDependencyHelp": "Install cdecl"
      },
      "args": []
    }
  ]
}