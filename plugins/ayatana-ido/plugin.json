{
  "name": "ayatana-ido",
  "version": "0.1.0",
  "description": "Ayatana Indicator Display Objects",
  "source": "https://github.com/AyatanaIndicators/ayatana-ido",
  "checks": [
    {
      "type": "binary",
      "name": "ayatana-ido"
    }
  ],
  "install_guidance": {
    "plugin": "ayatana-ido",
    "binary": "ayatana-ido",
    "check": "which ayatana-ido",
    "install_steps": [
      "brew install ayatana-ido",
      "Verify: ayatana-ido --version",
      "supercli plugins install ./plugins/ayatana-ido --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ayatana-ido",
      "resource": "self",
      "action": "version",
      "description": "Print ayatana-ido version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ayatana-ido",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ayatana-ido: brew install ayatana-ido"
      },
      "args": []
    },
    {
      "namespace": "ayatana-ido",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ayatana-ido CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ayatana-ido",
        "passthrough": true,
        "missingDependencyHelp": "Install ayatana-ido"
      },
      "args": []
    }
  ]
}