{
  "name": "dconf",
  "version": "0.1.0",
  "description": "CLI tool: dconf",
  "source": "https://packages.debian.org/dconf",
  "checks": [{ "type": "binary", "name": "dconf" }],
  "install_guidance": {
    "plugin": "dconf", "binary": "dconf", "check": "which dconf",
    "install_steps": ["apt-get install dconf 2>/dev/null || which dconf", "Verify: dconf --version", "supercli plugins install ./plugins/dconf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dconf", "resource": "_", "action": "_",
    "description": "Passthrough to dconf CLI",
    "adapter": "process", "adapterConfig": { "command": "dconf", "passthrough": true, "missingDependencyHelp": "Install dconf: apt-get install dconf" }, "args": []
  }]
}
