{
  "name": "hypopg",
  "version": "0.1.0",
  "description": "Hypothetical Indexes for PostgreSQL",
  "source": "https://github.com/HypoPG/hypopg",
  "checks": [
    {
      "type": "binary",
      "name": "hypopg"
    }
  ],
  "install_guidance": {
    "plugin": "hypopg",
    "binary": "hypopg",
    "check": "which hypopg",
    "install_steps": [
      "brew install hypopg",
      "Verify: hypopg --version",
      "supercli plugins install ./plugins/hypopg --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hypopg",
      "resource": "self",
      "action": "version",
      "description": "Print hypopg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hypopg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hypopg: brew install hypopg"
      },
      "args": []
    },
    {
      "namespace": "hypopg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hypopg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hypopg",
        "passthrough": true,
        "missingDependencyHelp": "Install hypopg"
      },
      "args": []
    }
  ]
}