{
  "name": "pbmto10x",
  "version": "0.1.0",
  "description": "CLI tool: pbmto10x",
  "source": "https://manpages.debian.org/pbmto10x",
  "checks": [
    {
      "type": "binary",
      "name": "pbmto10x"
    }
  ],
  "install_guidance": {
    "plugin": "pbmto10x",
    "binary": "pbmto10x",
    "check": "which pbmto10x",
    "install_steps": [
      "apt-get install pbmto10x 2>/dev/null || which pbmto10x",
      "Verify: pbmto10x --version",
      "supercli plugins install ./plugins/pbmto10x --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmto10x",
      "resource": "self",
      "action": "version",
      "description": "Print pbmto10x version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmto10x",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmto10x: apt-get install pbmto10x 2>/dev/null || which pbmto10x"
      },
      "args": []
    },
    {
      "namespace": "pbmto10x",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmto10x CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmto10x",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmto10x: apt-get install pbmto10x 2>/dev/null || which pbmto10x"
      },
      "args": []
    }
  ]
}