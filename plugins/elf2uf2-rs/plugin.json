{
  "name": "elf2uf2-rs",
  "version": "0.1.0",
  "description": "Convert ELF files to UF2 for USB Flashing Bootloaders",
  "source": "https://github.com/JoNil/elf2uf2-rs",
  "checks": [
    {
      "type": "binary",
      "name": "elf2uf2-rs"
    }
  ],
  "install_guidance": {
    "plugin": "elf2uf2-rs",
    "binary": "elf2uf2-rs",
    "check": "which elf2uf2-rs",
    "install_steps": [
      "brew install elf2uf2-rs",
      "Verify: elf2uf2-rs --version",
      "supercli plugins install ./plugins/elf2uf2-rs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "elf2uf2-rs",
      "resource": "self",
      "action": "version",
      "description": "Print elf2uf2-rs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "elf2uf2-rs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install elf2uf2-rs: brew install elf2uf2-rs"
      },
      "args": []
    },
    {
      "namespace": "elf2uf2-rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to elf2uf2-rs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "elf2uf2-rs",
        "passthrough": true,
        "missingDependencyHelp": "Install elf2uf2-rs"
      },
      "args": []
    }
  ]
}