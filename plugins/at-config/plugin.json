{
  "name": "at-config",
  "version": "0.1.0",
  "description": "CLI tool: at-config",
  "source": "https://packages.debian.org/at-config",
  "checks": [{ "type": "binary", "name": "at-config" }],
  "install_guidance": {
    "plugin": "at-config", "binary": "at-config", "check": "which at-config",
    "install_steps": ["apt-get install at-config 2>/dev/null || which at-config", "Verify: at-config --version", "supercli plugins install ./plugins/at-config --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-config", "resource": "_", "action": "_",
    "description": "Passthrough to at-config CLI",
    "adapter": "process", "adapterConfig": { "command": "at-config", "passthrough": true, "missingDependencyHelp": "Install at-config: apt-get install at-config" }, "args": []
  }]
}
