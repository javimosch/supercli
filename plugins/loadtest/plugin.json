{
  "name": "loadtest",
  "version": "0.1.0",
  "description": "Run load tests",
  "source": "https://github.com/alexfernandez/loadtest",
  "checks": [
    {
      "type": "binary",
      "name": "loadtest"
    }
  ],
  "install_guidance": {
    "plugin": "loadtest",
    "binary": "loadtest",
    "check": "which loadtest",
    "install_steps": [
      "See https://github.com/alexfernandez/loadtest",
      "Verify: loadtest --version",
      "supercli plugins install ./plugins/loadtest --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "loadtest",
      "resource": "self",
      "action": "version",
      "description": "Print loadtest version",
      "adapter": "process",
      "adapterConfig": {
        "command": "loadtest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install loadtest: See https://github.com/alexfernandez/loadtest"
      },
      "args": []
    },
    {
      "namespace": "loadtest",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to loadtest CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "loadtest",
        "passthrough": true,
        "missingDependencyHelp": "Install loadtest"
      },
      "args": []
    }
  ]
}