{
  "name": "devenv",
  "version": "1.0.0",
  "description": "devenv \u2014 Dev environment Nix",
  "source": "devenv.sh",
  "checks": [
    {
      "type": "binary",
      "name": "devenv"
    }
  ],
  "install_guidance": {
    "plugin": "devenv",
    "binary": "devenv",
    "check": "which devenv",
    "install_steps": [
      "# Install devenv",
      "# See devenv.sh",
      "# apt: sudo apt-get install devenv",
      "# brew: brew install devenv",
      "# cargo: cargo install devenv",
      "# npm: npm install -g devenv",
      "# pip: pip install devenv"
    ]
  },
  "commands": [
    {
      "namespace": "devenv",
      "resource": "devenv",
      "action": "run",
      "description": "Run devenv",
      "adapter": "process",
      "adapterConfig": {
        "command": "devenv",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install devenv from devenv.sh"
      },
      "args": []
    }
  ]
}