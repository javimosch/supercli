{
  "name": "MasterDnsVPN",
  "version": "0.1.0",
  "description": "Advanced DNS tunneling VPN for censorship bypass, optimized beyond DNSTT and SlipStream with low-ove",
  "source": "https://github.com/MasterDnsVPN/MasterDnsVPN",
  "checks": [
    {
      "type": "binary",
      "name": "masterdnsvpn"
    }
  ],
  "install_guidance": {
    "plugin": "MasterDnsVPN",
    "binary": "masterdnsvpn",
    "check": "which masterdnsvpn",
    "install_steps": [
      "pip install masterdnsvpn",
      "Verify: masterdnsvpn --version",
      "supercli plugins install ./plugins/MasterDnsVPN --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MasterDnsVPN",
      "resource": "self",
      "action": "version",
      "description": "Print MasterDnsVPN version",
      "adapter": "process",
      "adapterConfig": {
        "command": "masterdnsvpn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MasterDnsVPN: pip install masterdnsvpn"
      },
      "args": []
    },
    {
      "namespace": "MasterDnsVPN",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to masterdnsvpn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "masterdnsvpn",
        "passthrough": true,
        "missingDependencyHelp": "Install MasterDnsVPN: pip install masterdnsvpn"
      },
      "args": []
    }
  ]
}