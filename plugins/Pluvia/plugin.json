{
  "name": "Pluvia",
  "version": "0.1.0",
  "description": "Lightweight unofficial Steam client for Android",
  "source": "https://github.com/Pluvia/Pluvia",
  "checks": [
    {
      "type": "binary",
      "name": "pluvia"
    }
  ],
  "install_guidance": {
    "plugin": "Pluvia",
    "binary": "pluvia",
    "check": "which pluvia",
    "install_steps": [
      "pip install pluvia",
      "Verify: pluvia --version",
      "supercli plugins install ./plugins/Pluvia --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Pluvia",
      "resource": "self",
      "action": "version",
      "description": "Print Pluvia version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pluvia",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Pluvia: pip install pluvia"
      },
      "args": []
    },
    {
      "namespace": "Pluvia",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pluvia CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pluvia",
        "passthrough": true,
        "missingDependencyHelp": "Install Pluvia: pip install pluvia"
      },
      "args": []
    }
  ]
}