{
  "plugin": "ptargrep",
  "binary": "ptargrep",
  "check": "which ptargrep",
  "install_steps": [
    "# Install ptargrep",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ptargrep-linux-amd64 -o /usr/local/bin/ptargrep",
    "chmod +x /usr/local/bin/ptargrep",
    "# Or via package manager, see /usr/bin/ptargrep"
  ]
}