{
  "name": "pnmtoddif",
  "version": "0.1.0",
  "description": "CLI tool: pnmtoddif",
  "source": "https://manpages.debian.org/pnmtoddif",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtoddif"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtoddif",
    "binary": "pnmtoddif",
    "check": "which pnmtoddif",
    "install_steps": [
      "apt-get install pnmtoddif 2>/dev/null || which pnmtoddif",
      "Verify: pnmtoddif --version",
      "supercli plugins install ./plugins/pnmtoddif --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtoddif",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtoddif version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtoddif",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtoddif: apt-get install pnmtoddif 2>/dev/null || which pnmtoddif"
      },
      "args": []
    },
    {
      "namespace": "pnmtoddif",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtoddif CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtoddif",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtoddif: apt-get install pnmtoddif 2>/dev/null || which pnmtoddif"
      },
      "args": []
    }
  ]
}