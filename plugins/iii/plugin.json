{
  "name": "iii",
  "version": "0.1.0",
  "description": "Effortlessly compose, extend, and observe every service in real-time for the first time ever.",
  "source": "https://github.com/iii/iii",
  "checks": [
    {
      "type": "binary",
      "name": "iii"
    }
  ],
  "install_guidance": {
    "plugin": "iii",
    "binary": "iii",
    "check": "which iii",
    "install_steps": [
      "pip install iii",
      "Verify: iii --version",
      "supercli plugins install ./plugins/iii --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iii",
      "resource": "self",
      "action": "version",
      "description": "Print iii version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iii",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iii: pip install iii"
      },
      "args": []
    },
    {
      "namespace": "iii",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iii CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iii",
        "passthrough": true,
        "missingDependencyHelp": "Install iii: pip install iii"
      },
      "args": []
    }
  ]
}