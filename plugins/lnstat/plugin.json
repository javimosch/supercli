{
  "name": "lnstat",
  "version": "0.1.0",
  "description": "Linux network statistics",
  "source": "https://packages.debian.org/lnstat",
  "checks": [{ "type": "binary", "name": "lnstat" }],
  "install_guidance": {
    "plugin": "lnstat", "binary": "lnstat", "check": "which lnstat",
    "install_steps": ["apt-get install iproute2", "Verify: lnstat --version", "supercli plugins install ./plugins/lnstat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lnstat", "resource": "_", "action": "_",
    "description": "Passthrough to lnstat CLI",
    "adapter": "process", "adapterConfig": { "command": "lnstat", "passthrough": true, "missingDependencyHelp": "Install lnstat: apt-get install iproute2" }, "args": []
  }]
}
