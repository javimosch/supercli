{
  "plugin": "zrun",
  "binary": "zrun",
  "check": "which zrun",
  "install_steps": [
    "apt-get install zrun 2>/dev/null || which zrun",
    "Verify: zrun --version",
    "supercli plugins install ./plugins/zrun --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}