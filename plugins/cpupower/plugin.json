{
  "name": "cpupower",
  "version": "0.1.0",
  "description": "CPU power management tool",
  "source": "https://packages.debian.org/cpupower",
  "checks": [{ "type": "binary", "name": "cpupower" }],
  "install_guidance": {
    "plugin": "cpupower", "binary": "cpupower", "check": "which cpupower",
    "install_steps": ["apt-get install linux-tools-common", "Verify: cpupower --version", "supercli plugins install ./plugins/cpupower --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpupower", "resource": "_", "action": "_",
    "description": "Passthrough to cpupower CLI",
    "adapter": "process", "adapterConfig": { "command": "cpupower", "passthrough": true, "missingDependencyHelp": "Install cpupower: apt-get install linux-tools-common" }, "args": []
  }]
}
