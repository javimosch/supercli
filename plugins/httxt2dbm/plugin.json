{
  "name": "httxt2dbm",
  "version": "0.1.0",
  "description": "CLI tool: httxt2dbm",
  "source": "https://manpages.debian.org/httxt2dbm",
  "checks": [
    {
      "type": "binary",
      "name": "httxt2dbm"
    }
  ],
  "install_guidance": {
    "plugin": "httxt2dbm",
    "binary": "httxt2dbm",
    "check": "which httxt2dbm",
    "install_steps": [
      "apt-get install httxt2dbm 2>/dev/null || which httxt2dbm",
      "Verify: httxt2dbm --version",
      "supercli plugins install ./plugins/httxt2dbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "httxt2dbm",
      "resource": "self",
      "action": "version",
      "description": "Print httxt2dbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "httxt2dbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install httxt2dbm: apt-get install httxt2dbm 2>/dev/null || which httxt2dbm"
      },
      "args": []
    },
    {
      "namespace": "httxt2dbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to httxt2dbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "httxt2dbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install httxt2dbm: apt-get install httxt2dbm 2>/dev/null || which httxt2dbm"
      },
      "args": []
    }
  ]
}