{
  "plugin": "lwp-mirror",
  "binary": "lwp-mirror",
  "check": "which lwp-mirror",
  "install_steps": [
    "apt-get install lwp-mirror 2>/dev/null || which lwp-mirror",
    "Verify: lwp-mirror --version",
    "supercli plugins install ./plugins/lwp-mirror --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}