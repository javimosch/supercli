{
  "name": "ipopt",
  "version": "0.1.0",
  "description": "ipopt \u2014 interior point optimizer",
  "source": "https://formulae.brew.sh/formula/ipopt",
  "checks": [
    {
      "type": "binary",
      "name": "ipopt"
    }
  ],
  "install_guidance": {
    "plugin": "ipopt",
    "binary": "ipopt",
    "check": "which ipopt",
    "install_steps": [
      "brew install ipopt",
      "Verify: ipopt --version",
      "supercli plugins install ./plugins/ipopt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ipopt",
      "resource": "self",
      "action": "version",
      "description": "Print ipopt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipopt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipopt: brew install ipopt"
      },
      "args": []
    },
    {
      "namespace": "ipopt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipopt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipopt",
        "passthrough": true,
        "missingDependencyHelp": "Install ipopt"
      },
      "args": []
    }
  ]
}