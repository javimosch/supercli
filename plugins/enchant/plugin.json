{
  "name": "enchant",
  "version": "1.0.0",
  "description": "enchant \u2014 Spell checker",
  "source": "abisource.com/projects/enchant",
  "checks": [
    {
      "type": "binary",
      "name": "enchant"
    }
  ],
  "install_guidance": {
    "plugin": "enchant",
    "binary": "enchant",
    "check": "which enchant",
    "install_steps": [
      "# Install enchant",
      "# See abisource.com/projects/enchant",
      "# apt: sudo apt-get install enchant",
      "# brew: brew install enchant",
      "# cargo: cargo install enchant",
      "# npm: npm install -g enchant",
      "# pip: pip install enchant"
    ]
  },
  "commands": [
    {
      "namespace": "enchant",
      "resource": "enchant",
      "action": "run",
      "description": "Run enchant",
      "adapter": "process",
      "adapterConfig": {
        "command": "enchant",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install enchant from abisource.com/projects/enchant"
      },
      "args": []
    }
  ]
}