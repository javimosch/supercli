{
  "name": "nwipe",
  "version": "1.0.0",
  "description": "nwipe \u2014 Secure disk erasure",
  "source": "github.com/xa8/nwipe",
  "checks": [
    {
      "type": "binary",
      "name": "nwipe"
    }
  ],
  "install_guidance": {
    "plugin": "nwipe",
    "binary": "nwipe",
    "check": "which nwipe",
    "install_steps": [
      "# Install nwipe:",
      "# apt: sudo apt-get install nwipe",
      "# brew: brew install nwipe",
      "# cargo: cargo install nwipe",
      "# npm: npm install -g nwipe",
      "# pip: pip install nwipe",
      "# or download from github.com/xa8/nwipe"
    ]
  },
  "commands": [
    {
      "namespace": "nwipe",
      "resource": "nwipe",
      "action": "run",
      "description": "Run nwipe",
      "adapter": "process",
      "adapterConfig": {
        "command": "nwipe",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install nwipe from github.com/xa8/nwipe"
      },
      "args": []
    }
  ]
