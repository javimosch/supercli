{
  "name": "actionlint",
  "version": "0.1.0",
  "description": "GitHub Actions workflow linter with --json",
  "source": "https://github.com/rhysd/actionlint",
  "checks": [
    {
      "type": "binary",
      "name": "actionlint"
    }
  ],
  "install_guidance": {
    "plugin": "actionlint",
    "binary": "actionlint",
    "check": "which actionlint",
    "install_steps": [
      "brew install actionlint",
      "Verify: actionlint --version",
      "supercli plugins install ./plugins/actionlint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "actionlint",
      "resource": "self",
      "action": "version",
      "description": "Print actionlint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "actionlint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install actionlint: brew install actionlint"
      },
      "args": []
    },
    {
      "namespace": "actionlint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to actionlint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "actionlint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install actionlint: brew install actionlint"
      },
      "args": []
    }
  ]
}
