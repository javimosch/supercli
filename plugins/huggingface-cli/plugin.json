{
  "name": "huggingface-cli",
  "version": "0.1.0",
  "description": "CLI tool: huggingface-cli",
  "source": "https://manpages.debian.org/huggingface-cli",
  "checks": [
    {
      "type": "binary",
      "name": "huggingface-cli"
    }
  ],
  "install_guidance": {
    "plugin": "huggingface-cli",
    "binary": "huggingface-cli",
    "check": "which huggingface-cli",
    "install_steps": [
      "apt-get install huggingface-cli 2>/dev/null || which huggingface-cli",
      "Verify: huggingface-cli --version",
      "supercli plugins install ./plugins/huggingface-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "huggingface-cli",
      "resource": "self",
      "action": "version",
      "description": "Print huggingface-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "huggingface-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install huggingface-cli: apt-get install huggingface-cli 2>/dev/null || which huggingface-cli"
      },
      "args": []
    },
    {
      "namespace": "huggingface-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to huggingface-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "huggingface-cli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install huggingface-cli: apt-get install huggingface-cli 2>/dev/null || which huggingface-cli"
      },
      "args": []
    }
  ]
}