{
  "name": "cargo-diet",
  "version": "0.1.0",
  "description": "Minimize Rust crate size by finding large dependencies",
  "source": "https://github.com/the-lean-crate/cargo-diet",
  "checks": [{ "type": "binary", "name": "cargo-diet" }],
  "install_guidance": {
    "plugin": "cargo-diet",
    "binary": "cargo-diet",
    "check": "which cargo-diet",
    "install_steps": ["cargo install cargo-diet", "Verify: cargo-diet --version", "supercli plugins install ./plugins/cargo-diet --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-diet",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-diet CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-diet",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-diet: cargo install cargo-diet", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
