{
  "name": "academic-research-skills",
  "version": "0.1.0",
  "description": "Academic Research Skills for Claude Code: research \u2192 write \u2192 review \u2192 revise \u2192 finalize",
  "source": "https://github.com/academic-research-skills/academic-research-skills",
  "checks": [
    {
      "type": "binary",
      "name": "academic-research-skills"
    }
  ],
  "install_guidance": {
    "plugin": "academic-research-skills",
    "binary": "academic-research-skills",
    "check": "which academic-research-skills",
    "install_steps": [
      "pip install academic-research-skills",
      "Verify: academic-research-skills --version",
      "supercli plugins install ./plugins/academic-research-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "academic-research-skills",
      "resource": "self",
      "action": "version",
      "description": "Print academic-research-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "academic-research-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install academic-research-skills: pip install academic-research-skills"
      },
      "args": []
    },
    {
      "namespace": "academic-research-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to academic-research-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "academic-research-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install academic-research-skills: pip install academic-research-skills"
      },
      "args": []
    }
  ]
}