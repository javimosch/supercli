{
  "name": "heroshot",
  "version": "0.1.0",
  "description": "Screenshot automation for documentation and testing",
  "source": "go",
  "checks": [{ "type": "binary", "name": "heroshot" }],
  "install_guidance": {
    "plugin": "heroshot",
    "binary": "heroshot",
    "check": "which heroshot",
    "install_steps": ["go install github.com/heroshot@latest", "Verify: heroshot --version", "supercli plugins install ./plugins/heroshot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "heroshot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to heroshot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "heroshot",
      "passthrough": true,
      "missingDependencyHelp": "Install heroshot: go install github.com/heroshot@latest"
    },
    "args": []
  }]
}
