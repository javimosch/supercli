{
  "name": "essentials",
  "version": "0.1.0",
  "description": "Essential tools and mods for Android nerds",
  "source": "https://github.com/essentials/essentials",
  "checks": [
    {
      "type": "binary",
      "name": "essentials"
    }
  ],
  "install_guidance": {
    "plugin": "essentials",
    "binary": "essentials",
    "check": "which essentials",
    "install_steps": [
      "pip install essentials",
      "Verify: essentials --version",
      "supercli plugins install ./plugins/essentials --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "essentials",
      "resource": "self",
      "action": "version",
      "description": "Print essentials version",
      "adapter": "process",
      "adapterConfig": {
        "command": "essentials",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install essentials: pip install essentials"
      },
      "args": []
    },
    {
      "namespace": "essentials",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to essentials CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "essentials",
        "passthrough": true,
        "missingDependencyHelp": "Install essentials: pip install essentials"
      },
      "args": []
    }
  ]
}