{
  "name": "ESP32-Bit-Pirate",
  "version": "0.1.0",
  "description": "A Hardware Hacking Tool with Web-Based CLI That Speaks Every Protocol ",
  "source": "https://github.com/ESP32-Bit-Pirate/ESP32-Bit-Pirate",
  "checks": [
    {
      "type": "binary",
      "name": "esp32-bit-pirate"
    }
  ],
  "install_guidance": {
    "plugin": "ESP32-Bit-Pirate",
    "binary": "esp32-bit-pirate",
    "check": "which esp32-bit-pirate",
    "install_steps": [
      "pip install esp32-bit-pirate",
      "Verify: esp32-bit-pirate --version",
      "supercli plugins install ./plugins/ESP32-Bit-Pirate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ESP32-Bit-Pirate",
      "resource": "self",
      "action": "version",
      "description": "Print ESP32-Bit-Pirate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "esp32-bit-pirate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ESP32-Bit-Pirate: pip install esp32-bit-pirate"
      },
      "args": []
    },
    {
      "namespace": "ESP32-Bit-Pirate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to esp32-bit-pirate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "esp32-bit-pirate",
        "passthrough": true,
        "missingDependencyHelp": "Install ESP32-Bit-Pirate: pip install esp32-bit-pirate"
      },
      "args": []
    }
  ]
}