{
  "name": "fontget-foundry",
  "version": "0.1.0",
  "description": "Discover and manage font collections from multiple sources",
  "source": "https://github.com/Graphixa/FontGet",
  "checks": [{ "type": "binary", "name": "fontget-foundry" }],
  "install_guidance": {
    "plugin": "fontget-foundry",
    "binary": "fontget-foundry",
    "check": "which fontget-foundry",
    "install_steps": ["git clone and build", "Verify: fontget-foundry --version", "supercli plugins install ./plugins/fontget-foundry --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fontget-foundry",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fontget-foundry CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fontget-foundry",
      "passthrough": true,
      "missingDependencyHelp": "Install fontget-foundry: git clone and build", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
