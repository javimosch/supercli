{
  "name": "gimp-console-2.10",
  "version": "0.1.0",
  "description": "CLI tool: gimp-console-2.10",
  "source": "https://manpages.debian.org/gimp-console-2.10",
  "checks": [
    {
      "type": "binary",
      "name": "gimp-console-2.10"
    }
  ],
  "install_guidance": {
    "plugin": "gimp-console-2.10",
    "binary": "gimp-console-2.10",
    "check": "which gimp-console-2.10",
    "install_steps": [
      "apt-get install gimp-console-2.10 2>/dev/null || which gimp-console-2.10",
      "Verify: gimp-console-2.10 --version",
      "supercli plugins install ./plugins/gimp-console-2.10 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gimp-console-2.10",
      "resource": "self",
      "action": "version",
      "description": "Print gimp-console-2.10 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gimp-console-2.10",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gimp-console-2.10: apt-get install gimp-console-2.10 2>/dev/null || which gimp-console-2.10"
      },
      "args": []
    },
    {
      "namespace": "gimp-console-2.10",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gimp-console-2.10 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gimp-console-2.10",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gimp-console-2.10: apt-get install gimp-console-2.10 2>/dev/null || which gimp-console-2.10"
      },
      "args": []
    }
  ]
}