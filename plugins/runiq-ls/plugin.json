{
  "name": "runiq-ls",
  "version": "0.1.0",
  "description": "List directory contents with comprehensive file metadata",
  "source": "https://github.com/lsd-rs/lsd",
  "checks": [{ "type": "binary", "name": "runiq" }],
  "install_guidance": {
    "plugin": "runiq-ls",
    "binary": "runiq",
    "check": "which runiq",
    "install_steps": ["cargo install lsd", "Verify: runiq --version", "supercli plugins install ./plugins/runiq-ls --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "runiq-ls",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to runiq CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "runiq",
      "passthrough": true,
      "missingDependencyHelp": "Install runiq-ls: cargo install lsd"
    },
    "args": []
  }]
}
