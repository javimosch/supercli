{
  "name": "swiftc",
  "version": "0.1.0",
  "description": "Swift programming language compiler",
  "source": "https://packages.debian.org/swiftc",
  "checks": [{ "type": "binary", "name": "swiftc" }],
  "install_guidance": {
    "plugin": "swiftc", "binary": "swiftc", "check": "which swiftc",
    "install_steps": ["apt-get install swift", "Verify: swiftc --version", "supercli plugins install ./plugins/swiftc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "swiftc", "resource": "_", "action": "_",
    "description": "Passthrough to swiftc CLI",
    "adapter": "process", "adapterConfig": { "command": "swiftc", "passthrough": true, "missingDependencyHelp": "Install swiftc: apt-get install swift" }, "args": []
  }]
}
