{
  "name": "hugo",
  "version": "0.1.0",
  "description": "Fast static site generator",
  "source": "https",
  "checks": [{"type": "binary", "name": "hugo"}],
  "install_guidance": {
    "plugin": "hugo",
    "binary": "hugo",
    "check": "which hugo",
    "install_steps": [
      "brew install hugo",
      "Verify: hugo --version",
      "supercli plugins install ./plugins/hugo --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "hugo",
      "resource": "self",
      "action": "version",
      "description": "Print hugo version",
      "adapter": "process",
      "adapterConfig": {"command": "hugo", "baseArgs": ["--version"], "missingDependencyHelp": "Install hugo: brew install hugo"},
      "args": []
    },
    {
      "namespace": "hugo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hugo CLI",
      "adapter": "process",
      "adapterConfig": {"command": "hugo", "passthrough": true, "missingDependencyHelp": "Install hugo: brew install hugo"},
      "args": []
    }
  ]
}
