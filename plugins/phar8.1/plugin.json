{
  "name": "phar8.1",
  "version": "0.1.0",
  "description": "CLI tool: phar8.1",
  "source": "https://manpages.debian.org/phar8.1",
  "checks": [
    {
      "type": "binary",
      "name": "phar8.1"
    }
  ],
  "install_guidance": {
    "plugin": "phar8.1",
    "binary": "phar8.1",
    "check": "which phar8.1",
    "install_steps": [
      "apt-get install phar8.1 2>/dev/null || which phar8.1",
      "Verify: phar8.1 --version",
      "supercli plugins install ./plugins/phar8.1 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "phar8.1",
      "resource": "self",
      "action": "version",
      "description": "Print phar8.1 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "phar8.1",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install phar8.1: apt-get install phar8.1 2>/dev/null || which phar8.1"
      },
      "args": []
    },
    {
      "namespace": "phar8.1",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to phar8.1 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "phar8.1",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install phar8.1: apt-get install phar8.1 2>/dev/null || which phar8.1"
      },
      "args": []
    }
  ]
}