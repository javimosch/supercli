{
  "name": "Pumpkin",
  "version": "0.1.0",
  "description": "Empowering everyone to host fast and efficient Minecraft servers.",
  "source": "https://github.com/Pumpkin/Pumpkin",
  "checks": [
    {
      "type": "binary",
      "name": "pumpkin"
    }
  ],
  "install_guidance": {
    "plugin": "Pumpkin",
    "binary": "pumpkin",
    "check": "which pumpkin",
    "install_steps": [
      "pip install pumpkin",
      "Verify: pumpkin --version",
      "supercli plugins install ./plugins/Pumpkin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Pumpkin",
      "resource": "self",
      "action": "version",
      "description": "Print Pumpkin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pumpkin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Pumpkin: pip install pumpkin"
      },
      "args": []
    },
    {
      "namespace": "Pumpkin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pumpkin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pumpkin",
        "passthrough": true,
        "missingDependencyHelp": "Install Pumpkin: pip install pumpkin"
      },
      "args": []
    }
  ]
}