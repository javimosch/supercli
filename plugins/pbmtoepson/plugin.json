{
  "name": "pbmtoepson",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoepson",
  "source": "https://manpages.debian.org/pbmtoepson",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoepson"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoepson",
    "binary": "pbmtoepson",
    "check": "which pbmtoepson",
    "install_steps": [
      "apt-get install pbmtoepson 2>/dev/null || which pbmtoepson",
      "Verify: pbmtoepson --version",
      "supercli plugins install ./plugins/pbmtoepson --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoepson",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoepson version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoepson",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoepson: apt-get install pbmtoepson 2>/dev/null || which pbmtoepson"
      },
      "args": []
    },
    {
      "namespace": "pbmtoepson",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoepson CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoepson",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoepson: apt-get install pbmtoepson 2>/dev/null || which pbmtoepson"
      },
      "args": []
    }
  ]
}