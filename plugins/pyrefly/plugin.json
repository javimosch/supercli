{
  "name": "pyrefly",
  "version": "0.1.0",
  "description": "Fast Python type checker and language server from Meta - checks 1.85M+ lines/sec, production-proven on Instagram",
  "source": "https://github.com/facebook/pyrefly",
  "checks": [
    { "type": "binary", "name": "pyrefly" }
  ],
  "install_guidance": {
    "plugin": "pyrefly",
    "binary": "pyrefly",
    "check": "which pyrefly",
    "install_steps": [
      "pip install pyrefly",
      "Verify: pyrefly --version",
      "supercli plugins install ./plugins/pyrefly --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyrefly",
      "resource": "self",
      "action": "version",
      "description": "Print pyrefly version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    },
    {
      "namespace": "pyrefly",
      "resource": "check",
      "action": "run",
      "description": "Type check the project (supports --output-format json for machine-readable results)",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "baseArgs": ["check"],
        "passthrough": true,
        "timeout_ms": 120000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    },
    {
      "namespace": "pyrefly",
      "resource": "config",
      "action": "init",
      "description": "Create pyrefly config and optionally migrate from mypy/pyright",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "baseArgs": ["init"],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    },
    {
      "namespace": "pyrefly",
      "resource": "suppress",
      "action": "run",
      "description": "Add suppression comments to silence existing type errors (e.g. after upgrades)",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "baseArgs": ["suppress"],
        "passthrough": true,
        "timeout_ms": 120000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    },
    {
      "namespace": "pyrefly",
      "resource": "infer",
      "action": "run",
      "description": "Infer and insert type annotations into Python source files",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "baseArgs": ["infer"],
        "passthrough": true,
        "timeout_ms": 120000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    },
    {
      "namespace": "pyrefly",
      "resource": "config",
      "action": "dump",
      "description": "Dump the merged configuration pyrefly resolved for the project",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "baseArgs": ["dump-config"],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    },
    {
      "namespace": "pyrefly",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyrefly CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "passthrough": true,
        "timeout_ms": 120000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    }
  ]
}
