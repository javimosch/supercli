{
  "name": "pyrefly",
  "version": "0.1.0",
  "description": "A fast type checker and language server for Python",
  "source": "https://github.com/pyrefly/pyrefly",
  "checks": [
    {
      "type": "binary",
      "name": "pyrefly"
    }
  ],
  "install_guidance": {
    "plugin": "pyrefly",
    "binary": "pyrefly",
    "check": "which pyrefly",
    "install_steps": [
      "pip install pyrefly",
      "Verify: pyrefly --version",
      "supercli plugins install ./plugins/pyrefly --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyrefly",
      "resource": "self",
      "action": "version",
      "description": "Print pyrefly version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    },
    {
      "namespace": "pyrefly",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyrefly CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrefly",
        "passthrough": true,
        "missingDependencyHelp": "Install pyrefly: pip install pyrefly"
      },
      "args": []
    }
  ]
}