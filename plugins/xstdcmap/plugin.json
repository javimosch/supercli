{
  "name": "xstdcmap",
  "version": "0.1.0",
  "description": "CLI tool: xstdcmap",
  "source": "https://manpages.debian.org/xstdcmap",
  "checks": [
    {
      "type": "binary",
      "name": "xstdcmap"
    }
  ],
  "install_guidance": {
    "plugin": "xstdcmap",
    "binary": "xstdcmap",
    "check": "which xstdcmap",
    "install_steps": [
      "apt-get install xstdcmap 2>/dev/null || which xstdcmap",
      "Verify: xstdcmap --version",
      "supercli plugins install ./plugins/xstdcmap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xstdcmap",
      "resource": "self",
      "action": "version",
      "description": "Print xstdcmap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xstdcmap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xstdcmap: apt-get install xstdcmap 2>/dev/null || which xstdcmap"
      },
      "args": []
    },
    {
      "namespace": "xstdcmap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xstdcmap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xstdcmap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xstdcmap: apt-get install xstdcmap 2>/dev/null || which xstdcmap"
      },
      "args": []
    }
  ]
}