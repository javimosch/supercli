{
  "name": "jcode",
  "version": "0.1.0",
  "description": "Coding Agent Harness",
  "source": "https://github.com/jcode/jcode",
  "checks": [
    {
      "type": "binary",
      "name": "jcode"
    }
  ],
  "install_guidance": {
    "plugin": "jcode",
    "binary": "jcode",
    "check": "which jcode",
    "install_steps": [
      "pip install jcode",
      "Verify: jcode --version",
      "supercli plugins install ./plugins/jcode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jcode",
      "resource": "self",
      "action": "version",
      "description": "Print jcode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jcode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jcode: pip install jcode"
      },
      "args": []
    },
    {
      "namespace": "jcode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jcode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jcode",
        "passthrough": true,
        "missingDependencyHelp": "Install jcode: pip install jcode"
      },
      "args": []
    }
  ]
}