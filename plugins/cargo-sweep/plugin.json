{
  "name": "cargo-sweep",
  "version": "0.1.0",
  "description": "Clean up old cargo build artifacts to free disk space",
  "source": "https://github.com/LukeMathWalker/cargo-sweep",
  "checks": [{ "type": "binary", "name": "cargo-sweep" }],
  "install_guidance": {
    "plugin": "cargo-sweep",
    "binary": "cargo-sweep",
    "check": "which cargo-sweep",
    "install_steps": ["cargo install cargo-sweep", "Verify: cargo-sweep --version", "supercli plugins install ./plugins/cargo-sweep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-sweep",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-sweep CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-sweep",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-sweep: cargo install cargo-sweep", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
