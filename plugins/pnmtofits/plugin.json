{
  "name": "pnmtofits",
  "version": "0.1.0",
  "description": "CLI tool: pnmtofits",
  "source": "https://manpages.debian.org/pnmtofits",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtofits"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtofits",
    "binary": "pnmtofits",
    "check": "which pnmtofits",
    "install_steps": [
      "apt-get install pnmtofits 2>/dev/null || which pnmtofits",
      "Verify: pnmtofits --version",
      "supercli plugins install ./plugins/pnmtofits --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtofits",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtofits version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtofits",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtofits: apt-get install pnmtofits 2>/dev/null || which pnmtofits"
      },
      "args": []
    },
    {
      "namespace": "pnmtofits",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtofits CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtofits",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtofits: apt-get install pnmtofits 2>/dev/null || which pnmtofits"
      },
      "args": []
    }
  ]
}