{
  "name": "hash-cracker-rs",
  "version": "0.1.0",
  "description": "Simple dictionary-based hash cracker in Rust",
  "source": "https://github.com/aristanetworks/hash-cracker",
  "checks": [{ "type": "binary", "name": "hash-cracker-rs" }],
  "install_guidance": {
    "plugin": "hash-cracker-rs",
    "binary": "hash-cracker-rs",
    "check": "which hash-cracker-rs",
    "install_steps": ["cargo install hash-cracker", "Verify: hash-cracker-rs --version", "supercli plugins install ./plugins/hash-cracker-rs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hash-cracker-rs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hash-cracker-rs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hash-cracker-rs",
      "passthrough": true,
      "missingDependencyHelp": "Install hash-cracker-rs: cargo install hash-cracker", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
