{
  "name": "bee",
  "version": "0.1.0",
  "description": "Tool for managing database changes",
  "source": "https://github.com/bluesoft/bee",
  "checks": [
    {
      "type": "binary",
      "name": "bee"
    }
  ],
  "install_guidance": {
    "plugin": "bee",
    "binary": "bee",
    "check": "which bee",
    "install_steps": [
      "brew install bee",
      "Verify: bee --version",
      "supercli plugins install ./plugins/bee --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bee",
      "resource": "self",
      "action": "version",
      "description": "Print bee version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bee",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bee: brew install bee"
      },
      "args": []
    },
    {
      "namespace": "bee",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bee CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bee",
        "passthrough": true,
        "missingDependencyHelp": "Install bee"
      },
      "args": []
    }
  ]
}