{
  "name": "lexido",
  "version": "0.1.0",
  "description": "Innovative assistant for the command-line",
  "source": "https://github.com/micr0-dev/lexido",
  "checks": [
    {
      "type": "binary",
      "name": "lexido"
    }
  ],
  "install_guidance": {
    "plugin": "lexido",
    "binary": "lexido",
    "check": "which lexido",
    "install_steps": [
      "brew install lexido",
      "Verify: lexido --version",
      "supercli plugins install ./plugins/lexido --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lexido",
      "resource": "self",
      "action": "version",
      "description": "Print lexido version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lexido",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lexido: brew install lexido"
      },
      "args": []
    },
    {
      "namespace": "lexido",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lexido CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lexido",
        "passthrough": true,
        "missingDependencyHelp": "Install lexido"
      },
      "args": []
    }
  ]
}