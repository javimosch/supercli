{
  "name": "at-pkg",
  "version": "0.1.0",
  "description": "CLI tool: at-pkg",
  "source": "https://packages.debian.org/at-pkg",
  "checks": [{ "type": "binary", "name": "at-pkg" }],
  "install_guidance": {
    "plugin": "at-pkg", "binary": "at-pkg", "check": "which at-pkg",
    "install_steps": ["apt-get install at-pkg 2>/dev/null || which at-pkg", "Verify: at-pkg --version", "supercli plugins install ./plugins/at-pkg --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-pkg", "resource": "_", "action": "_",
    "description": "Passthrough to at-pkg CLI",
    "adapter": "process", "adapterConfig": { "command": "at-pkg", "passthrough": true, "missingDependencyHelp": "Install at-pkg: apt-get install at-pkg" }, "args": []
  }]
}
