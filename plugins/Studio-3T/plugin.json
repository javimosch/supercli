{
  "name": "Studio-3T",
  "version": "0.1.0",
  "description": "CLI tool: Studio-3T",
  "source": "https://manpages.debian.org/Studio-3T",
  "checks": [
    {
      "type": "binary",
      "name": "Studio-3T"
    }
  ],
  "install_guidance": {
    "plugin": "Studio-3T",
    "binary": "Studio-3T",
    "check": "which Studio-3T",
    "install_steps": [
      "apt-get install Studio-3T 2>/dev/null || which Studio-3T",
      "Verify: Studio-3T --version",
      "supercli plugins install ./plugins/Studio-3T --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Studio-3T",
      "resource": "self",
      "action": "version",
      "description": "Print Studio-3T version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Studio-3T",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Studio-3T: apt-get install Studio-3T 2>/dev/null || which Studio-3T"
      },
      "args": []
    },
    {
      "namespace": "Studio-3T",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Studio-3T CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Studio-3T",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install Studio-3T: apt-get install Studio-3T 2>/dev/null || which Studio-3T"
      },
      "args": []
    }
  ]
}