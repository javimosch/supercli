{
  "name": "xdvi-xaw",
  "version": "0.1.0",
  "description": "CLI tool: xdvi-xaw",
  "source": "https://manpages.debian.org/xdvi-xaw",
  "checks": [
    {
      "type": "binary",
      "name": "xdvi-xaw"
    }
  ],
  "install_guidance": {
    "plugin": "xdvi-xaw",
    "binary": "xdvi-xaw",
    "check": "which xdvi-xaw",
    "install_steps": [
      "apt-get install xdvi-xaw 2>/dev/null || which xdvi-xaw",
      "Verify: xdvi-xaw --version",
      "supercli plugins install ./plugins/xdvi-xaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xdvi-xaw",
      "resource": "self",
      "action": "version",
      "description": "Print xdvi-xaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdvi-xaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xdvi-xaw: apt-get install xdvi-xaw 2>/dev/null || which xdvi-xaw"
      },
      "args": []
    },
    {
      "namespace": "xdvi-xaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xdvi-xaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdvi-xaw",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xdvi-xaw: apt-get install xdvi-xaw 2>/dev/null || which xdvi-xaw"
      },
      "args": []
    }
  ]
}