{
  "name": "sh-task",
  "version": "0.1.0",
  "description": "Shell-only task runner for POSIX systems",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "sh-task" }],
  "install_guidance": {
    "plugin": "sh-task",
    "binary": "sh-task",
    "check": "which sh-task",
    "install_steps": ["curl -sSLO url/sh-task", "Verify: sh-task --version", "supercli plugins install ./plugins/sh-task --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sh-task",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sh-task CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sh-task",
      "passthrough": true,
      "missingDependencyHelp": "Install sh-task: curl -sSLO url/sh-task"
    },
    "args": []
  }]
}
