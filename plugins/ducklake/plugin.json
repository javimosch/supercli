{
  "name": "ducklake",
  "version": "0.1.0",
  "description": "DuckLake is an integrated data lake and catalog format",
  "source": "https://github.com/ducklake/ducklake",
  "checks": [
    {
      "type": "binary",
      "name": "ducklake"
    }
  ],
  "install_guidance": {
    "plugin": "ducklake",
    "binary": "ducklake",
    "check": "which ducklake",
    "install_steps": [
      "pip install ducklake",
      "Verify: ducklake --version",
      "supercli plugins install ./plugins/ducklake --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ducklake",
      "resource": "self",
      "action": "version",
      "description": "Print ducklake version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ducklake",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ducklake: pip install ducklake"
      },
      "args": []
    },
    {
      "namespace": "ducklake",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ducklake CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ducklake",
        "passthrough": true,
        "missingDependencyHelp": "Install ducklake: pip install ducklake"
      },
      "args": []
    }
  ]
}