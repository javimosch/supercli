{
  "name": "frankenmermaid",
  "version": "0.1.0",
  "description": "Rust-based engine for rendering Mermaid diagrams",
  "source": "https://github.com/Dicklesworthstone/frankenmermaid",
  "checks": [{ "type": "binary", "name": "frankenmermaid" }],
  "install_guidance": {
    "plugin": "frankenmermaid",
    "binary": "frankenmermaid",
    "check": "which frankenmermaid",
    "install_steps": ["cargo install frankenmermaid", "Verify: frankenmermaid --version", "supercli plugins install ./plugins/frankenmermaid --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "frankenmermaid",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to frankenmermaid CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "frankenmermaid",
      "passthrough": true,
      "missingDependencyHelp": "Install frankenmermaid: cargo install frankenmermaid", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
