{
  "name": "nexa-sdk",
  "version": "0.1.0",
  "description": "Run frontier LLMs and VLMs with day-0 model support across GPU, NPU, and CPU, with comprehensive run",
  "source": "https://github.com/nexa-sdk/nexa-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "nexa-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "nexa-sdk",
    "binary": "nexa-sdk",
    "check": "which nexa-sdk",
    "install_steps": [
      "pip install nexa-sdk",
      "Verify: nexa-sdk --version",
      "supercli plugins install ./plugins/nexa-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nexa-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print nexa-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nexa-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nexa-sdk: pip install nexa-sdk"
      },
      "args": []
    },
    {
      "namespace": "nexa-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nexa-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nexa-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install nexa-sdk: pip install nexa-sdk"
      },
      "args": []
    }
  ]
}