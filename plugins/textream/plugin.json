{
  "name": "textream",
  "version": "0.1.0",
  "description": "Textream is a free macOS teleprompter app for streamers, interviewers, and presenters. It highlights",
  "source": "https://github.com/textream/textream",
  "checks": [
    {
      "type": "binary",
      "name": "textream"
    }
  ],
  "install_guidance": {
    "plugin": "textream",
    "binary": "textream",
    "check": "which textream",
    "install_steps": [
      "pip install textream",
      "Verify: textream --version",
      "supercli plugins install ./plugins/textream --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "textream",
      "resource": "self",
      "action": "version",
      "description": "Print textream version",
      "adapter": "process",
      "adapterConfig": {
        "command": "textream",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install textream: pip install textream"
      },
      "args": []
    },
    {
      "namespace": "textream",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to textream CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "textream",
        "passthrough": true,
        "missingDependencyHelp": "Install textream: pip install textream"
      },
      "args": []
    }
  ]
}