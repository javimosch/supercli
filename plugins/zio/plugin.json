{
  "name": "zio",
  "version": "0.1.0",
  "description": "Async I/O framework for Zig",
  "source": "https://github.com/nickelc/zio",
  "checks": [
    {
      "type": "binary",
      "name": "zio"
    }
  ],
  "install_guidance": {
    "plugin": "zio",
    "binary": "zio",
    "check": "which zio",
    "install_steps": [
      "cargo install zio",
      "Verify: zio --version",
      "supercli plugins install ./plugins/zio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zio",
      "resource": "self",
      "action": "version",
      "description": "Print zio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zio: cargo install zio"
      },
      "args": []
    },
    {
      "namespace": "zio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zio",
      "adapter": "process",
      "adapterConfig": {
        "command": "zio",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install zio: cargo install zio"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
