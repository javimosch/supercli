{
  "name": "zio",
  "version": "0.1.0",
  "description": "Async I/O framework for Zig",
  "source": "https://github.com/zio/zio",
  "checks": [
    {
      "type": "binary",
      "name": "zio"
    }
  ],
  "install_guidance": {
    "plugin": "zio",
    "binary": "zio",
    "check": "which zio",
    "install_steps": [
      "pip install zio",
      "Verify: zio --version",
      "supercli plugins install ./plugins/zio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zio",
      "resource": "self",
      "action": "version",
      "description": "Print zio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zio: pip install zio"
      },
      "args": []
    },
    {
      "namespace": "zio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zio",
        "passthrough": true,
        "missingDependencyHelp": "Install zio: pip install zio"
      },
      "args": []
    }
  ]
}