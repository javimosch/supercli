{
  "name": "ctapi-util",
  "version": "0.1.0",
  "description": "CLI tool: ctapi-util",
  "source": "https://packages.debian.org/ctapi-util",
  "checks": [{ "type": "binary", "name": "ctapi-util" }],
  "install_guidance": {
    "plugin": "ctapi-util", "binary": "ctapi-util", "check": "which ctapi-util",
    "install_steps": ["apt-get install ctapi-util 2>/dev/null || which ctapi-util", "Verify: ctapi-util --version", "supercli plugins install ./plugins/ctapi-util --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctapi-util", "resource": "_", "action": "_",
    "description": "Passthrough to ctapi-util CLI",
    "adapter": "process", "adapterConfig": { "command": "ctapi-util", "passthrough": true, "missingDependencyHelp": "Install ctapi-util: apt-get install ctapi-util" }, "args": []
  }]
}
