{
  "name": "keep-sorted",
  "version": "0.1.0",
  "description": "Language-agnostic formatter that sorts selected lines",
  "source": "https://github.com/google/keep-sorted",
  "checks": [
    {
      "type": "binary",
      "name": "keep-sorted"
    }
  ],
  "install_guidance": {
    "plugin": "keep-sorted",
    "binary": "keep-sorted",
    "check": "which keep-sorted",
    "install_steps": [
      "brew install keep-sorted",
      "Verify: keep-sorted --version",
      "supercli plugins install ./plugins/keep-sorted --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "keep-sorted",
      "resource": "self",
      "action": "version",
      "description": "Print keep-sorted version",
      "adapter": "process",
      "adapterConfig": {
        "command": "keep-sorted",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install keep-sorted: brew install keep-sorted"
      },
      "args": []
    },
    {
      "namespace": "keep-sorted",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to keep-sorted CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "keep-sorted",
        "passthrough": true,
        "missingDependencyHelp": "Install keep-sorted"
      },
      "args": []
    }
  ]
}