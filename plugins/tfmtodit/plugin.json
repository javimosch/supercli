{
  "name": "tfmtodit",
  "version": "0.1.0",
  "description": "CLI tool: tfmtodit",
  "source": "https://manpages.debian.org/tfmtodit",
  "checks": [
    {
      "type": "binary",
      "name": "tfmtodit"
    }
  ],
  "install_guidance": {
    "plugin": "tfmtodit",
    "binary": "tfmtodit",
    "check": "which tfmtodit",
    "install_steps": [
      "apt-get install tfmtodit 2>/dev/null || which tfmtodit",
      "Verify: tfmtodit --version",
      "supercli plugins install ./plugins/tfmtodit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tfmtodit",
      "resource": "self",
      "action": "version",
      "description": "Print tfmtodit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tfmtodit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tfmtodit: apt-get install tfmtodit 2>/dev/null || which tfmtodit"
      },
      "args": []
    },
    {
      "namespace": "tfmtodit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tfmtodit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tfmtodit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tfmtodit: apt-get install tfmtodit 2>/dev/null || which tfmtodit"
      },
      "args": []
    }
  ]
}