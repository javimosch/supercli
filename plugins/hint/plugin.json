{
  "name": "hint",
  "version": "0.1.0",
  "description": "Webhint \u2014 web best practices linter",
  "source": "https://github.com/webhintio/hint",
  "checks": [
    {
      "type": "binary",
      "name": "hint"
    }
  ],
  "install_guidance": {
    "plugin": "hint",
    "binary": "hint",
    "check": "which hint",
    "install_steps": [
      "npm install -g hint",
      "Verify: hint --version",
      "supercli plugins install ./plugins/hint --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "hint",
      "resource": "self",
      "action": "version",
      "description": "Print hint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hint: npm install -g hint"
      },
      "args": []
    },
    {
      "namespace": "hint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hint: npm install -g hint"
      },
      "args": []
    }
  ]
}
