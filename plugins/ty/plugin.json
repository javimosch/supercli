{
  "name": "ty",
  "version": "0.1.0",
  "description": "Extremely fast Python type checker",
  "source": "https://github.com/nickelc/ty",
  "checks": [
    {
      "type": "binary",
      "name": "ty"
    }
  ],
  "install_guidance": {
    "plugin": "ty",
    "binary": "ty",
    "check": "which ty",
    "install_steps": [
      "pip install ty",
      "Verify: ty --version",
      "supercli plugins install ./plugins/ty --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ty",
      "resource": "self",
      "action": "version",
      "description": "Print ty version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ty",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ty: pip install ty"
      },
      "args": []
    },
    {
      "namespace": "ty",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ty",
      "adapter": "process",
      "adapterConfig": {
        "command": "ty",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ty: pip install ty"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
