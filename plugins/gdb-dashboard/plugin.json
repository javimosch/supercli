{
  "name": "gdb-dashboard",
  "version": "0.1.0",
  "description": "Modular visual interface for GDB",
  "source": "https://github.com/cyrus-and/gdb-dashboard",
  "checks": [
    {
      "type": "binary",
      "name": "gdb-dashboard"
    }
  ],
  "install_guidance": {
    "plugin": "gdb-dashboard",
    "binary": "gdb-dashboard",
    "check": "which gdb-dashboard",
    "install_steps": [
      "See https://github.com/cyrus-and/gdb-dashboard",
      "Verify: gdb-dashboard --version",
      "supercli plugins install ./plugins/gdb-dashboard --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gdb-dashboard",
      "resource": "self",
      "action": "version",
      "description": "Print gdb-dashboard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdb-dashboard",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdb-dashboard: See https://github.com/cyrus-and/gdb-dashboard"
      },
      "args": []
    },
    {
      "namespace": "gdb-dashboard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdb-dashboard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdb-dashboard",
        "passthrough": true,
        "missingDependencyHelp": "Install gdb-dashboard"
      },
      "args": []
    }
  ]
}