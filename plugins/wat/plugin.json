{
  "name": "wat",
  "version": "0.1.0",
  "description": "Instant, central, community-built docs",
  "source": "https://github.com/dthree/wat",
  "checks": [
    {
      "type": "binary",
      "name": "wat"
    }
  ],
  "install_guidance": {
    "plugin": "wat",
    "binary": "wat",
    "check": "which wat",
    "install_steps": [
      "See https://github.com/dthree/wat",
      "Verify: wat --version",
      "supercli plugins install ./plugins/wat --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "wat",
      "resource": "self",
      "action": "version",
      "description": "Print wat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wat: See https://github.com/dthree/wat"
      },
      "args": []
    },
    {
      "namespace": "wat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wat",
        "passthrough": true,
        "missingDependencyHelp": "Install wat"
      },
      "args": []
    }
  ]
}