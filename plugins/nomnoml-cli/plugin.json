{
  "name": "nomnoml-cli",
  "version": "0.1.0",
  "description": "Render UML diagrams from plain text descriptions",
  "source": "https://github.com/nomnoml/nomnoml-cli",
  "checks": [{ "type": "binary", "name": "nomnoml-cli" }],
  "install_guidance": {
    "plugin": "nomnoml-cli",
    "binary": "nomnoml-cli",
    "check": "which nomnoml-cli",
    "install_steps": ["npm install -g nomnoml-cli", "Verify: nomnoml-cli --version", "supercli plugins install ./plugins/nomnoml-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nomnoml-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nomnoml-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nomnoml-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install nomnoml-cli: npm install -g nomnoml-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
