{
  "name": "kubesec",
  "version": "0.1.0",
  "description": "Security risk analysis for Kubernetes resources",
  "source": "https://github.com/controlplaneio/kubesec",
  "checks": [{ "type": "binary", "name": "kubesec" }],
  "install_guidance": {
    "plugin": "kubesec",
    "binary": "kubesec",
    "check": "which kubesec",
    "install_steps": ["brew install kubesec", "Verify: kubesec --version", "supercli plugins install ./plugins/kubesec --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubesec",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubesec CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubesec",
      "passthrough": true,
      "missingDependencyHelp": "Install kubesec: brew install kubesec"
    },
    "args": []
  }]
}
