{
  "name": "iPlay",
  "version": "0.1.0",
  "description": "Enjoy Media Everywhere, On Every Platform \ud83d\udc40",
  "source": "https://github.com/iPlay/iPlay",
  "checks": [
    {
      "type": "binary",
      "name": "iplay"
    }
  ],
  "install_guidance": {
    "plugin": "iPlay",
    "binary": "iplay",
    "check": "which iplay",
    "install_steps": [
      "pip install iplay",
      "Verify: iplay --version",
      "supercli plugins install ./plugins/iPlay --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iPlay",
      "resource": "self",
      "action": "version",
      "description": "Print iPlay version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iplay",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iPlay: pip install iplay"
      },
      "args": []
    },
    {
      "namespace": "iPlay",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iplay CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iplay",
        "passthrough": true,
        "missingDependencyHelp": "Install iPlay: pip install iplay"
      },
      "args": []
    }
  ]
}