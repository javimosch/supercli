{
  "name": "wish",
  "version": "0.1.0",
  "description": "CLI tool: wish",
  "source": "https://manpages.debian.org/wish",
  "checks": [
    {
      "type": "binary",
      "name": "wish"
    }
  ],
  "install_guidance": {
    "plugin": "wish",
    "binary": "wish",
    "check": "which wish",
    "install_steps": [
      "apt-get install wish 2>/dev/null || which wish",
      "Verify: wish --version",
      "supercli plugins install ./plugins/wish --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wish",
      "resource": "self",
      "action": "version",
      "description": "Print wish version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wish",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wish: apt-get install wish 2>/dev/null || which wish"
      },
      "args": []
    },
    {
      "namespace": "wish",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wish CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wish",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wish: apt-get install wish 2>/dev/null || which wish"
      },
      "args": []
    }
  ]
}