{
  "name": "caracal",
  "version": "0.1.0",
  "description": "Static analyzer for Starknet smart contracts",
  "source": "https://github.com/crytic/caracal",
  "checks": [
    {
      "type": "binary",
      "name": "caracal"
    }
  ],
  "install_guidance": {
    "plugin": "caracal",
    "binary": "caracal",
    "check": "which caracal",
    "install_steps": [
      "brew install caracal",
      "Verify: caracal --version",
      "supercli plugins install ./plugins/caracal --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "caracal",
      "resource": "self",
      "action": "version",
      "description": "Print caracal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "caracal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install caracal: brew install caracal"
      },
      "args": []
    },
    {
      "namespace": "caracal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to caracal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "caracal",
        "passthrough": true,
        "missingDependencyHelp": "Install caracal"
      },
      "args": []
    }
  ]
}