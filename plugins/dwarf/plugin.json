{
  "name": "dwarf",
  "version": "0.1.0",
  "description": "Object file manipulation tool",
  "source": "https://github.com/elboza/dwarf-ng/",
  "checks": [
    {
      "type": "binary",
      "name": "dwarf"
    }
  ],
  "install_guidance": {
    "plugin": "dwarf",
    "binary": "dwarf",
    "check": "which dwarf",
    "install_steps": [
      "brew install dwarf",
      "Verify: dwarf --version",
      "supercli plugins install ./plugins/dwarf --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dwarf",
      "resource": "self",
      "action": "version",
      "description": "Print dwarf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dwarf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dwarf: brew install dwarf"
      },
      "args": []
    },
    {
      "namespace": "dwarf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dwarf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dwarf",
        "passthrough": true,
        "missingDependencyHelp": "Install dwarf"
      },
      "args": []
    }
  ]
}