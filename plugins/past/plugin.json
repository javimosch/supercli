{
  "name": "past",
  "version": "0.1.0",
  "description": "past \u2014 a pastebin CLI tool.",
  "source": "https://github.com/junhyuk0801/past",
  "checks": [
    {
      "type": "binary",
      "name": "past"
    }
  ],
  "install_guidance": {
    "plugin": "past",
    "binary": "past",
    "check": "which past",
    "install_steps": [
      "cargo install past",
      "supercli plugins install ./plugins/past --on-conflict replace --json"
    ],
    "note": "Rust. Pastebin CLI."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "past",
      "resource": "paste",
      "action": "send",
      "description": "Upload text to pastebin",
      "adapter": "process",
      "adapterConfig": {
        "command": "past",
        "missingDependencyHelp": "Install past",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "past",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "past",
        "missingDependencyHelp": "Install past",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
