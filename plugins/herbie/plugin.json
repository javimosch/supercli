{
  "name": "herbie",
  "version": "0.1.0",
  "description": "Advanced CLI for downloading numerical weather model data",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "herbie" }],
  "install_guidance": {
    "plugin": "herbie",
    "binary": "herbie",
    "check": "which herbie",
    "install_steps": ["pip install herbie-data", "Verify: herbie --version", "supercli plugins install ./plugins/herbie --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "herbie",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to herbie CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "herbie",
      "passthrough": true,
      "missingDependencyHelp": "Install herbie: pip install herbie-data"
    },
    "args": []
  }]
}
