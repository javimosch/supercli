{
  "name": "blockhash",
  "version": "0.1.0",
  "description": "Perceptual image hash calculation tool",
  "source": "https://github.com/commonsmachinery/blockhash",
  "checks": [
    {
      "type": "binary",
      "name": "blockhash"
    }
  ],
  "install_guidance": {
    "plugin": "blockhash",
    "binary": "blockhash",
    "check": "which blockhash",
    "install_steps": [
      "brew install blockhash",
      "Verify: blockhash --version",
      "supercli plugins install ./plugins/blockhash --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "blockhash",
      "resource": "self",
      "action": "version",
      "description": "Print blockhash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "blockhash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install blockhash: brew install blockhash"
      },
      "args": []
    },
    {
      "namespace": "blockhash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to blockhash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "blockhash",
        "passthrough": true,
        "missingDependencyHelp": "Install blockhash"
      },
      "args": []
    }
  ]
}