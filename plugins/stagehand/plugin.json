{
  "name": "stagehand",
  "version": "0.1.0",
  "description": "The SDK For Browser Agents",
  "source": "https://github.com/stagehand/stagehand",
  "checks": [
    {
      "type": "binary",
      "name": "stagehand"
    }
  ],
  "install_guidance": {
    "plugin": "stagehand",
    "binary": "stagehand",
    "check": "which stagehand",
    "install_steps": [
      "pip install stagehand",
      "Verify: stagehand --version",
      "supercli plugins install ./plugins/stagehand --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "stagehand",
      "resource": "self",
      "action": "version",
      "description": "Print stagehand version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stagehand",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install stagehand: pip install stagehand"
      },
      "args": []
    },
    {
      "namespace": "stagehand",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stagehand CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stagehand",
        "passthrough": true,
        "missingDependencyHelp": "Install stagehand: pip install stagehand"
      },
      "args": []
    }
  ]
}