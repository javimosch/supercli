{
  "name": "leaf-proxy",
  "version": "0.1.0",
  "description": "Lightweight and fast proxy utility",
  "source": "https://github.com/eycorsican/leaf",
  "checks": [
    {
      "type": "binary",
      "name": "leaf-proxy"
    }
  ],
  "install_guidance": {
    "plugin": "leaf-proxy",
    "binary": "leaf-proxy",
    "check": "which leaf-proxy",
    "install_steps": [
      "brew install leaf-proxy",
      "Verify: leaf-proxy --version",
      "supercli plugins install ./plugins/leaf-proxy --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "leaf-proxy",
      "resource": "self",
      "action": "version",
      "description": "Print leaf-proxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leaf-proxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install leaf-proxy: brew install leaf-proxy"
      },
      "args": []
    },
    {
      "namespace": "leaf-proxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leaf-proxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leaf-proxy",
        "passthrough": true,
        "missingDependencyHelp": "Install leaf-proxy"
      },
      "args": []
    }
  ]
}