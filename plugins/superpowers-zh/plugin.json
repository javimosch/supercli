{
  "name": "superpowers-zh",
  "version": "0.1.0",
  "description": "\ud83e\uddb8 AI \u7f16\u7a0b\u8d85\u80fd\u529b \u00b7 \u4e2d\u6587\u589e\u5f3a\u7248 \u2014 superpowers\uff08116k+ \u2b50\uff09\u5b8c\u6574\u6c49\u5316 + 6 \u4e2a\u4e2d\u56fd\u539f\u521b skills\uff0c\u8ba9 Claude Code / Copilot CLI / Hermes ",
  "source": "https://github.com/superpowers-zh/superpowers-zh",
  "checks": [
    {
      "type": "binary",
      "name": "superpowers-zh"
    }
  ],
  "install_guidance": {
    "plugin": "superpowers-zh",
    "binary": "superpowers-zh",
    "check": "which superpowers-zh",
    "install_steps": [
      "pip install superpowers-zh",
      "Verify: superpowers-zh --version",
      "supercli plugins install ./plugins/superpowers-zh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "superpowers-zh",
      "resource": "self",
      "action": "version",
      "description": "Print superpowers-zh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "superpowers-zh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install superpowers-zh: pip install superpowers-zh"
      },
      "args": []
    },
    {
      "namespace": "superpowers-zh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to superpowers-zh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "superpowers-zh",
        "passthrough": true,
        "missingDependencyHelp": "Install superpowers-zh: pip install superpowers-zh"
      },
      "args": []
    }
  ]
}