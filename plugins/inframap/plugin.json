{
  "name": "inframap",
  "version": "0.1.0",
  "description": "Read your tfstate or HCL to generate a graph",
  "source": "https://github.com/cycloidio/inframap",
  "checks": [
    {
      "type": "binary",
      "name": "inframap"
    }
  ],
  "install_guidance": {
    "plugin": "inframap",
    "binary": "inframap",
    "check": "which inframap",
    "install_steps": [
      "brew install inframap",
      "Verify: inframap --version",
      "supercli plugins install ./plugins/inframap --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "inframap",
      "resource": "self",
      "action": "version",
      "description": "Print inframap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "inframap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install inframap: brew install inframap"
      },
      "args": []
    },
    {
      "namespace": "inframap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to inframap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "inframap",
        "passthrough": true,
        "missingDependencyHelp": "Install inframap"
      },
      "args": []
    }
  ]
}