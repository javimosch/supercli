{
  "name": "embabel-agent",
  "version": "0.1.0",
  "description": "Agent framework for the JVM. Pronounced Em-BAY-bel /\u025bm\u02c8be\u026ab\u0259l/",
  "source": "https://github.com/embabel-agent/embabel-agent",
  "checks": [
    {
      "type": "binary",
      "name": "embabel-agent"
    }
  ],
  "install_guidance": {
    "plugin": "embabel-agent",
    "binary": "embabel-agent",
    "check": "which embabel-agent",
    "install_steps": [
      "pip install embabel-agent",
      "Verify: embabel-agent --version",
      "supercli plugins install ./plugins/embabel-agent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "embabel-agent",
      "resource": "self",
      "action": "version",
      "description": "Print embabel-agent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "embabel-agent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install embabel-agent: pip install embabel-agent"
      },
      "args": []
    },
    {
      "namespace": "embabel-agent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to embabel-agent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "embabel-agent",
        "passthrough": true,
        "missingDependencyHelp": "Install embabel-agent: pip install embabel-agent"
      },
      "args": []
    }
  ]
}