{
  "name": "helmfile",
  "version": "0.1.0",
  "description": "Declarative spec for deploying Helm charts",
  "source": "https://github.com/helmfile/helmfile",
  "checks": [{ "type": "binary", "name": "helmfile" }],
  "install_guidance": {
    "plugin": "helmfile",
    "binary": "helmfile",
    "check": "which helmfile",
    "install_steps": ["brew install helmfile", "Verify: helmfile --version", "supercli plugins install ./plugins/helmfile --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "helmfile",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to helmfile CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "helmfile",
      "passthrough": true,
      "missingDependencyHelp": "Install helmfile: brew install helmfile"
    },
    "args": []
  }]
}
