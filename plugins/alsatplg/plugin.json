  "checks": [{ "type": "binary", "name": "alsatplg" }],
  "install_guidance": {
    "plugin": "alsatplg", "binary": "alsatplg", "check": "which alsatplg",
    "install_steps": ["apt-get install alsatplg 2>/dev/null || which alsatplg", "Verify: alsatplg --version", "supercli plugins install ./plugins/alsatplg --on-conflict replace --json"]
