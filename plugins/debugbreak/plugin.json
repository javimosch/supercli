{
  "name": "debugbreak",
  "version": "0.1.0",
  "description": "Break into the debugger programmatically",
  "source": "https://github.com/scottt/debugbreak",
  "checks": [
    {
      "type": "binary",
      "name": "debugbreak"
    }
  ],
  "install_guidance": {
    "plugin": "debugbreak",
    "binary": "debugbreak",
    "check": "which debugbreak",
    "install_steps": [
      "brew install debugbreak",
      "Verify: debugbreak --version",
      "supercli plugins install ./plugins/debugbreak --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "debugbreak",
      "resource": "self",
      "action": "version",
      "description": "Print debugbreak version",
      "adapter": "process",
      "adapterConfig": {
        "command": "debugbreak",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install debugbreak: brew install debugbreak"
      },
      "args": []
    },
    {
      "namespace": "debugbreak",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to debugbreak CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "debugbreak",
        "passthrough": true,
        "missingDependencyHelp": "Install debugbreak"
      },
      "args": []
    }
  ]
}