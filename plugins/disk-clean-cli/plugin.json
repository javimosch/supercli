{
  "name": "disk-clean-cli",
  "version": "0.1.0",
  "description": "A disk cleanup and optimization tool. Identifies and removes temporary files, caches, and unused packages to free up disk space across systems.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "disk-clean-cli"
    }
  ],
  "install_guidance": {
    "plugin": "disk-clean-cli",
    "binary": "disk-clean-cli",
    "check": "which disk-clean-cli",
    "install_steps": [
      "cargo install disk-clean-cli",
      "Verify: disk-clean-cli --version",
      "supercli plugins install ./plugins/disk-clean-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "disk-clean-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to disk-clean-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "disk-clean-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install disk-clean-cli: cargo install disk-clean-cli"
      },
      "args": []
    }
  ]
}
