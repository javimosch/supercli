{
  "plugin": "mongotop",
  "binary": "mongotop",
  "check": "which mongotop",
  "install_steps": [
    "apt-get install mongotop 2>/dev/null || which mongotop",
    "Verify: mongotop --version",
    "supercli plugins install ./plugins/mongotop --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}