{
  "name": "rsimg",
  "version": "0.1.0",
  "description": "Batch image processing CLI tool built with Rust.",
  "source": "https://github.com/rsimg/rsimg",
  "checks": [
    {
      "type": "binary",
      "name": "rsimg"
    }
  ],
  "install_guidance": {
    "plugin": "rsimg",
    "binary": "rsimg",
    "check": "which rsimg",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: rsimg --version",
      "supercli plugins install ./plugins/rsimg --on-conflict replace --json"
    ],
    "note": "Rust language CLI tool"
  },
  "commands": [
    {
      "namespace": "rsimg",
      "resource": "self",
      "action": "version",
      "description": "Print rsimg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rsimg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rsimg from project repository"
      },
      "args": []
    },
    {
      "namespace": "rsimg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rsimg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rsimg",
        "passthrough": true,
        "missingDependencyHelp": "Install rsimg from project repository"
      },
      "args": []
    }
  ]
}