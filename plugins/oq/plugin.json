{
  "name": "oq",
  "version": "1.0.0",
  "description": "oq \u2014 jq but for yaml and toml",
  "source": "github.com/Blacksmoke16/oq",
  "checks": [
    {
      "type": "binary",
      "name": "oq"
    }
  ],
  "install_guidance": {
    "plugin": "oq",
    "binary": "oq",
    "check": "which oq",
    "install_steps": [
      "# Install oq:",
      "# apt: sudo apt-get install oq",
      "# brew: brew install oq",
      "# cargo: cargo install oq",
      "# npm: npm install -g oq",
      "# pip: pip install oq",
      "# or download from github.com/Blacksmoke16/oq"
    ]
  },
  "commands": [
    {
      "namespace": "oq",
      "resource": "oq",
      "action": "run",
      "description": "Run oq",
      "adapter": "process",
      "adapterConfig": {
        "command": "oq",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install oq from github.com/Blacksmoke16/oq"
      },
      "args": []
    }
  ]
}