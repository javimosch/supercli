{
  "name": "fastfec",
  "version": "0.1.0",
  "description": "Extremely fast FEC filing parser written in C",
  "source": "https://github.com/washingtonpost/FastFEC",
  "checks": [
    {
      "type": "binary",
      "name": "fastfec"
    }
  ],
  "install_guidance": {
    "plugin": "fastfec",
    "binary": "fastfec",
    "check": "which fastfec",
    "install_steps": [
      "brew install fastfec",
      "Verify: fastfec --version",
      "supercli plugins install ./plugins/fastfec --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fastfec",
      "resource": "self",
      "action": "version",
      "description": "Print fastfec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastfec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastfec: brew install fastfec"
      },
      "args": []
    },
    {
      "namespace": "fastfec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastfec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastfec",
        "passthrough": true,
        "missingDependencyHelp": "Install fastfec"
      },
      "args": []
    }
  ]
}