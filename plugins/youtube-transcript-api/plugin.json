{
  "name": "youtube-transcript-api",
  "version": "0.1.0",
  "description": "Get YouTube video transcripts in Python",
  "source": "https://github.com/nicedoc/youtube-transcript-api",
  "checks": [
    {
      "type": "binary",
      "name": "youtube-transcript-api"
    }
  ],
  "install_guidance": {
    "plugin": "youtube-transcript-api",
    "binary": "youtube-transcript-api",
    "check": "which youtube-transcript-api",
    "install_steps": [
      "pip install youtube-transcript-api",
      "Verify: youtube-transcript-api --version",
      "supercli plugins install ./plugins/youtube-transcript-api --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "youtube-transcript-api",
      "resource": "self",
      "action": "version",
      "description": "Print youtube-transcript-api version",
      "adapter": "process",
      "adapterConfig": {
        "command": "youtube-transcript-api",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install youtube-transcript-api: pip install youtube-transcript-api"
      },
      "args": []
    },
    {
      "namespace": "youtube-transcript-api",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to youtube-transcript-api CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "youtube-transcript-api",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install youtube-transcript-api: pip install youtube-transcript-api"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
