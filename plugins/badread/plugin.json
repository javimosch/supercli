{
  "name": "badread",
  "version": "0.1.0",
  "description": "Long read simulator that can imitate many types of read problems",
  "source": "https://github.com/rrwick/Badread",
  "checks": [
    {
      "type": "binary",
      "name": "badread"
    }
  ],
  "install_guidance": {
    "plugin": "badread",
    "binary": "badread",
    "check": "which badread",
    "install_steps": [
      "brew install badread",
      "Verify: badread --version",
      "supercli plugins install ./plugins/badread --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "badread",
      "resource": "self",
      "action": "version",
      "description": "Print badread version",
      "adapter": "process",
      "adapterConfig": {
        "command": "badread",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install badread: brew install badread"
      },
      "args": []
    },
    {
      "namespace": "badread",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to badread CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "badread",
        "passthrough": true,
        "missingDependencyHelp": "Install badread"
      },
      "args": []
    }
  ]
}