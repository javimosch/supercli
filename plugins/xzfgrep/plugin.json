{
  "name": "xzfgrep",
  "version": "0.1.0",
  "description": "CLI tool: xzfgrep",
  "source": "https://manpages.debian.org/xzfgrep",
  "checks": [
    {
      "type": "binary",
      "name": "xzfgrep"
    }
  ],
  "install_guidance": {
    "plugin": "xzfgrep",
    "binary": "xzfgrep",
    "check": "which xzfgrep",
    "install_steps": [
      "apt-get install xzfgrep 2>/dev/null || which xzfgrep",
      "Verify: xzfgrep --version",
      "supercli plugins install ./plugins/xzfgrep --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xzfgrep",
      "resource": "self",
      "action": "version",
      "description": "Print xzfgrep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xzfgrep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xzfgrep: apt-get install xzfgrep 2>/dev/null || which xzfgrep"
      },
      "args": []
    },
    {
      "namespace": "xzfgrep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xzfgrep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xzfgrep",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xzfgrep: apt-get install xzfgrep 2>/dev/null || which xzfgrep"
      },
      "args": []
    }
  ]
}