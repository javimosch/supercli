{
  "name": "free-claude-code",
  "version": "0.1.0",
  "description": "Use claude-code for free in the terminal, VSCode extension or discord like OpenClaw (voice supported",
  "source": "https://github.com/free-claude-code/free-claude-code",
  "checks": [
    {
      "type": "binary",
      "name": "free-claude-code"
    }
  ],
  "install_guidance": {
    "plugin": "free-claude-code",
    "binary": "free-claude-code",
    "check": "which free-claude-code",
    "install_steps": [
      "pip install free-claude-code",
      "Verify: free-claude-code --version",
      "supercli plugins install ./plugins/free-claude-code --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "free-claude-code",
      "resource": "self",
      "action": "version",
      "description": "Print free-claude-code version",
      "adapter": "process",
      "adapterConfig": {
        "command": "free-claude-code",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install free-claude-code: pip install free-claude-code"
      },
      "args": []
    },
    {
      "namespace": "free-claude-code",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to free-claude-code CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "free-claude-code",
        "passthrough": true,
        "missingDependencyHelp": "Install free-claude-code: pip install free-claude-code"
      },
      "args": []
    }
  ]
}