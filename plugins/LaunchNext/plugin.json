{
  "name": "LaunchNext",
  "version": "0.1.0",
  "description": "Bring your Launchpad back in MacOS26+ ,highly customizable, powerful, free.",
  "source": "https://github.com/LaunchNext/LaunchNext",
  "checks": [
    {
      "type": "binary",
      "name": "launchnext"
    }
  ],
  "install_guidance": {
    "plugin": "LaunchNext",
    "binary": "launchnext",
    "check": "which launchnext",
    "install_steps": [
      "pip install launchnext",
      "Verify: launchnext --version",
      "supercli plugins install ./plugins/LaunchNext --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LaunchNext",
      "resource": "self",
      "action": "version",
      "description": "Print LaunchNext version",
      "adapter": "process",
      "adapterConfig": {
        "command": "launchnext",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LaunchNext: pip install launchnext"
      },
      "args": []
    },
    {
      "namespace": "LaunchNext",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to launchnext CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "launchnext",
        "passthrough": true,
        "missingDependencyHelp": "Install LaunchNext: pip install launchnext"
      },
      "args": []
    }
  ]
}