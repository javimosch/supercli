{
  "name": "plop",
  "version": "0.1.0",
  "description": "Micro-generator framework for consistent project files",
  "source": "https://github.com/plopjs/plop",
  "checks": [
    {
      "type": "binary",
      "name": "plop"
    }
  ],
  "install_guidance": {
    "plugin": "plop",
    "binary": "plop",
    "check": "which plop",
    "install_steps": [
      "npm install -g plop",
      "Verify: plop --version",
      "supercli plugins install ./plugins/plop --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "plop",
      "resource": "self",
      "action": "version",
      "description": "Print plop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "plop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install plop: npm install -g plop"
      },
      "args": []
    },
    {
      "namespace": "plop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to plop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "plop",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install plop: npm install -g plop"
      },
      "args": []
    }
  ]
}
