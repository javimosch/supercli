{
  "name": "bashbug",
  "version": "0.1.0",
  "description": "CLI tool: bashbug",
  "source": "https://packages.debian.org/bashbug",
  "checks": [{ "type": "binary", "name": "bashbug" }],
  "install_guidance": {
    "plugin": "bashbug", "binary": "bashbug", "check": "which bashbug",
    "install_steps": ["apt-get install bashbug 2>/dev/null || which bashbug", "Verify: bashbug --version", "supercli plugins install ./plugins/bashbug --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bashbug", "resource": "_", "action": "_",
    "description": "Passthrough to bashbug CLI",
    "adapter": "process", "adapterConfig": { "command": "bashbug", "passthrough": true, "missingDependencyHelp": "Install bashbug: apt-get install bashbug" }, "args": []
  }]
}
