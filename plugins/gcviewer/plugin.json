{
  "name": "gcviewer",
  "version": "0.1.0",
  "description": "Java garbage collection visualization tool",
  "source": "https://github.com/chewiebug/GCViewer",
  "checks": [
    {
      "type": "binary",
      "name": "gcviewer"
    }
  ],
  "install_guidance": {
    "plugin": "gcviewer",
    "binary": "gcviewer",
    "check": "which gcviewer",
    "install_steps": [
      "brew install gcviewer",
      "Verify: gcviewer --version",
      "supercli plugins install ./plugins/gcviewer --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gcviewer",
      "resource": "self",
      "action": "version",
      "description": "Print gcviewer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcviewer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcviewer: brew install gcviewer"
      },
      "args": []
    },
    {
      "namespace": "gcviewer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcviewer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcviewer",
        "passthrough": true,
        "missingDependencyHelp": "Install gcviewer"
      },
      "args": []
    }
  ]
}