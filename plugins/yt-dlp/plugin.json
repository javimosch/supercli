{
  "name": "yt-dlp",
  "version": "0.1.0",
  "description": "Feature-rich video downloader supporting 1000+ sites",
  "source": "https://github.com/yt-dlp/yt-dlp",
  "checks": [{"type": "binary", "name": "yt-dlp"}],
  "install_guidance": {
    "plugin": "yt-dlp",
    "binary": "yt-dlp",
    "check": "which yt-dlp",
    "install_steps": [
      "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp",
      "chmod +x /usr/local/bin/yt-dlp",
      "Verify: yt-dlp --version",
      "supercli plugins install ./plugins/yt-dlp --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "yt-dlp",
      "resource": "self",
      "action": "version",
      "description": "Print yt-dlp version",
      "adapter": "process",
      "adapterConfig": {"command": "yt-dlp", "baseArgs": ["--version"], "missingDependencyHelp": "Install yt-dlp: curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && chmod +x /usr/local/bin/yt-dlp"},
      "args": []
    },
    {
      "namespace": "yt-dlp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yt-dlp CLI",
      "adapter": "process",
      "adapterConfig": {"command": "yt-dlp", "passthrough": true, "missingDependencyHelp": "Install yt-dlp: curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && chmod +x /usr/local/bin/yt-dlp"},
      "args": []
    }
  ]
}
