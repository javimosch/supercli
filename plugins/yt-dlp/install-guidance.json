{
  "plugin": "yt-dlp",
  "binary": "yt-dlp",
  "check": "which yt-dlp",
  "install_steps": [
    "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp",
    "chmod +x /usr/local/bin/yt-dlp",
    "Verify: yt-dlp --version",
    "supercli plugins install ./plugins/yt-dlp --on-conflict replace --json"
  ],
  "note": "Alternative installation methods: pip install yt-dlp, brew install yt-dlp, or download platform-specific binaries from GitHub releases"
}
