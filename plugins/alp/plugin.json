{
  "name": "alp",
  "version": "0.1.0",
  "description": "Access Log Profiler",
  "source": "https://github.com/tkuchiki/alp",
  "checks": [
    {
      "type": "binary",
      "name": "alp"
    }
  ],
  "install_guidance": {
    "plugin": "alp",
    "binary": "alp",
    "check": "which alp",
    "install_steps": [
      "brew install alp",
      "Verify: alp --version",
      "supercli plugins install ./plugins/alp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "alp",
      "resource": "self",
      "action": "version",
      "description": "Print alp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "alp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install alp: brew install alp"
      },
      "args": []
    },
    {
      "namespace": "alp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to alp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "alp",
        "passthrough": true,
        "missingDependencyHelp": "Install alp"
      },
      "args": []
    }
  ]
}