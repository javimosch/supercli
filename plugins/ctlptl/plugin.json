{
  "name": "ctlptl",
  "version": "0.1.0",
  "description": "Making local Kubernetes clusters fun and easy to set up",
  "source": "https://github.com/tilt-dev/ctlptl",
  "checks": [
    {
      "type": "binary",
      "name": "ctlptl"
    }
  ],
  "install_guidance": {
    "plugin": "ctlptl",
    "binary": "ctlptl",
    "check": "which ctlptl",
    "install_steps": [
      "brew install ctlptl",
      "Verify: ctlptl --version",
      "supercli plugins install ./plugins/ctlptl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ctlptl",
      "resource": "self",
      "action": "version",
      "description": "Print ctlptl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ctlptl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ctlptl: brew install ctlptl"
      },
      "args": []
    },
    {
      "namespace": "ctlptl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ctlptl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ctlptl",
        "passthrough": true,
        "missingDependencyHelp": "Install ctlptl"
      },
      "args": []
    }
  ]
}