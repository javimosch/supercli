{
  "name": "make-ssl-cert",
  "version": "0.1.0",
  "description": "CLI tool: make-ssl-cert",
  "source": "https://manpages.debian.org/make-ssl-cert",
  "checks": [
    {
      "type": "binary",
      "name": "make-ssl-cert"
    }
  ],
  "install_guidance": {
    "plugin": "make-ssl-cert",
    "binary": "make-ssl-cert",
    "check": "which make-ssl-cert",
    "install_steps": [
      "apt-get install make-ssl-cert 2>/dev/null || which make-ssl-cert",
      "Verify: make-ssl-cert --version",
      "supercli plugins install ./plugins/make-ssl-cert --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "make-ssl-cert",
      "resource": "self",
      "action": "version",
      "description": "Print make-ssl-cert version",
      "adapter": "process",
      "adapterConfig": {
        "command": "make-ssl-cert",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install make-ssl-cert: apt-get install make-ssl-cert 2>/dev/null || which make-ssl-cert"
      },
      "args": []
    },
    {
      "namespace": "make-ssl-cert",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to make-ssl-cert CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "make-ssl-cert",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install make-ssl-cert: apt-get install make-ssl-cert 2>/dev/null || which make-ssl-cert"
      },
      "args": []
    }
  ]
}