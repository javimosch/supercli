{
  "name": "trmnl-firmware",
  "version": "0.1.0",
  "description": "TRMNL ePaper device firmware",
  "source": "https://github.com/trmnl-firmware/trmnl-firmware",
  "checks": [
    {
      "type": "binary",
      "name": "trmnl-firmware"
    }
  ],
  "install_guidance": {
    "plugin": "trmnl-firmware",
    "binary": "trmnl-firmware",
    "check": "which trmnl-firmware",
    "install_steps": [
      "pip install trmnl-firmware",
      "Verify: trmnl-firmware --version",
      "supercli plugins install ./plugins/trmnl-firmware --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "trmnl-firmware",
      "resource": "self",
      "action": "version",
      "description": "Print trmnl-firmware version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trmnl-firmware",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install trmnl-firmware: pip install trmnl-firmware"
      },
      "args": []
    },
    {
      "namespace": "trmnl-firmware",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trmnl-firmware CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trmnl-firmware",
        "passthrough": true,
        "missingDependencyHelp": "Install trmnl-firmware: pip install trmnl-firmware"
      },
      "args": []
    }
  ]
}