{
  "name": "ipod-time-sync",
  "version": "0.1.0",
  "description": "CLI tool: ipod-time-sync",
  "source": "https://manpages.debian.org/ipod-time-sync",
  "checks": [
    {
      "type": "binary",
      "name": "ipod-time-sync"
    }
  ],
  "install_guidance": {
    "plugin": "ipod-time-sync",
    "binary": "ipod-time-sync",
    "check": "which ipod-time-sync",
    "install_steps": [
      "apt-get install ipod-time-sync 2>/dev/null || which ipod-time-sync",
      "Verify: ipod-time-sync --version",
      "supercli plugins install ./plugins/ipod-time-sync --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ipod-time-sync",
      "resource": "self",
      "action": "version",
      "description": "Print ipod-time-sync version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipod-time-sync",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ipod-time-sync: apt-get install ipod-time-sync 2>/dev/null || which ipod-time-sync"
      },
      "args": []
    },
    {
      "namespace": "ipod-time-sync",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipod-time-sync CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ipod-time-sync",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ipod-time-sync: apt-get install ipod-time-sync 2>/dev/null || which ipod-time-sync"
      },
      "args": []
    }
  ]
}