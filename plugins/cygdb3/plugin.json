{
  "name": "cygdb3",
  "version": "0.1.0",
  "description": "CLI tool: cygdb3",
  "source": "https://packages.debian.org/cygdb3",
  "checks": [{ "type": "binary", "name": "cygdb3" }],
  "install_guidance": {
