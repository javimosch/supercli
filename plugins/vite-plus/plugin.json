{
  "name": "vite-plus",
  "version": "0.1.0",
  "description": "Vite+ is the unified toolchain and entry point for web development. It manages your runtime, package",
  "source": "https://github.com/vite-plus/vite-plus",
  "checks": [
    {
      "type": "binary",
      "name": "vite-plus"
    }
  ],
  "install_guidance": {
    "plugin": "vite-plus",
    "binary": "vite-plus",
    "check": "which vite-plus",
    "install_steps": [
      "pip install vite-plus",
      "Verify: vite-plus --version",
      "supercli plugins install ./plugins/vite-plus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vite-plus",
      "resource": "self",
      "action": "version",
      "description": "Print vite-plus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vite-plus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vite-plus: pip install vite-plus"
      },
      "args": []
    },
    {
      "namespace": "vite-plus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vite-plus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vite-plus",
        "passthrough": true,
        "missingDependencyHelp": "Install vite-plus: pip install vite-plus"
      },
      "args": []
    }
  ]
}