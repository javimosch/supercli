{
  "name": "autoreconf",
  "version": "0.1.0",
  "description": "CLI tool: autoreconf",
  "source": "https://packages.debian.org/autoreconf",
  "checks": [{ "type": "binary", "name": "autoreconf" }],
  "install_guidance": {
    "plugin": "autoreconf", "binary": "autoreconf", "check": "which autoreconf",
    "install_steps": ["apt-get install autoreconf 2>/dev/null || which autoreconf", "Verify: autoreconf --version", "supercli plugins install ./plugins/autoreconf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "autoreconf", "resource": "_", "action": "_",
    "description": "Passthrough to autoreconf CLI",
    "adapter": "process", "adapterConfig": { "command": "autoreconf", "passthrough": true, "missingDependencyHelp": "Install autoreconf: apt-get install autoreconf" }, "args": []
  }]
}
