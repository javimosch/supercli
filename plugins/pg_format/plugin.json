{
  "name": "pg_format",
  "version": "0.1.0",
  "description": "PostgreSQL SQL formatter and beautifier",
  "source": "https://github.com/darold/pgFormatter",
  "checks": [{ "type": "binary", "name": "pg_format" }],
  "install_guidance": {
    "plugin": "pg_format",
    "binary": "pg_format",
    "check": "which pg_format",
    "install_steps": ["npm install -g pg-formatter", "Verify: pg_format --version", "supercli plugins install ./plugins/pg_format --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pg_format",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pg_format CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pg_format",
      "passthrough": true,
      "missingDependencyHelp": "Install pg_format: npm install -g pg-formatter"
    },
    "args": []
  }]
}
