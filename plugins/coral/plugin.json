{
  "name": "coral",
  "version": "0.1.0",
  "description": "One SQL interface over APIs, files, and live sources \u2014 built for agents.",
  "source": "https://github.com/coral/coral",
  "checks": [
    {
      "type": "binary",
      "name": "coral"
    }
  ],
  "install_guidance": {
    "plugin": "coral",
    "binary": "coral",
    "check": "which coral",
    "install_steps": [
      "pip install coral",
      "Verify: coral --version",
      "supercli plugins install ./plugins/coral --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "coral",
      "resource": "self",
      "action": "version",
      "description": "Print coral version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coral",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coral: pip install coral"
      },
      "args": []
    },
    {
      "namespace": "coral",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coral CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coral",
        "passthrough": true,
        "missingDependencyHelp": "Install coral: pip install coral"
      },
      "args": []
    }
  ]
}