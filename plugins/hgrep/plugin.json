{
  "name": "hgrep",
  "version": "0.1.0",
  "description": "Grep with human-friendly search results",
  "source": "https://github.com/rhysd/hgrep",
  "checks": [
    {
      "type": "binary",
      "name": "hgrep"
    }
  ],
  "install_guidance": {
    "plugin": "hgrep",
    "binary": "hgrep",
    "check": "which hgrep",
    "install_steps": [
      "brew install hgrep",
      "Verify: hgrep --version",
      "supercli plugins install ./plugins/hgrep --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hgrep",
      "resource": "self",
      "action": "version",
      "description": "Print hgrep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hgrep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hgrep: brew install hgrep"
      },
      "args": []
    },
    {
      "namespace": "hgrep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hgrep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hgrep",
        "passthrough": true,
        "missingDependencyHelp": "Install hgrep"
      },
      "args": []
    }
  ]
}