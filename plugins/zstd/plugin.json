{
  "name": "zstd",
  "version": "0.1.0",
  "description": "Zstandard fast compression algorithm",
  "source": "https",
  "checks": [{"type": "binary", "name": "zstd"}],
  "install_guidance": {
    "plugin": "zstd",
    "binary": "zstd",
    "check": "which zstd",
    "install_steps": [
      "brew install zstd",
      "Verify: zstd --version",
      "supercli plugins install ./plugins/zstd --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "zstd",
      "resource": "self",
      "action": "version",
      "description": "Print zstd version",
      "adapter": "process",
      "adapterConfig": {"command": "zstd", "baseArgs": ["--version"], "missingDependencyHelp": "Install zstd: brew install zstd"},
      "args": []
    },
    {
      "namespace": "zstd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zstd CLI",
      "adapter": "process",
      "adapterConfig": {"command": "zstd", "passthrough": true, "missingDependencyHelp": "Install zstd: brew install zstd"},
      "args": []
    }
  ]
}
