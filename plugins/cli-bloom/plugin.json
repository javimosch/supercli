{
  "name": "cli-bloom",
  "version": "0.1.0",
  "description": "Some bloom filter cli tools",
  "source": "https://github.com/cli-bloom/cli-bloom",
  "checks": [
    {
      "type": "binary",
      "name": "cli-bloom"
    }
  ],
  "install_guidance": {
    "plugin": "cli-bloom",
    "binary": "cli-bloom",
    "check": "which cli-bloom",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cli-bloom --version",
      "supercli plugins install ./plugins/cli-bloom --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "cli-bloom",
      "resource": "self",
      "action": "version",
      "description": "Print cli-bloom version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-bloom",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-bloom from project repository"
      },
      "args": []
    },
    {
      "namespace": "cli-bloom",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-bloom CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-bloom",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-bloom from project repository"
      },
      "args": []
    }
  ]
}