{
  "name": "crispy-doom",
  "version": "0.1.0",
  "description": "Limit-removing enhanced-resolution Doom source port based on Chocolate Doom",
  "source": "https://github.com/fabiangreffrath/crispy-doom",
  "checks": [
    {
      "type": "binary",
      "name": "crispy-doom"
    }
  ],
  "install_guidance": {
    "plugin": "crispy-doom",
    "binary": "crispy-doom",
    "check": "which crispy-doom",
    "install_steps": [
      "brew install crispy-doom",
      "Verify: crispy-doom --version",
      "supercli plugins install ./plugins/crispy-doom --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "crispy-doom",
      "resource": "self",
      "action": "version",
      "description": "Print crispy-doom version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crispy-doom",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crispy-doom: brew install crispy-doom"
      },
      "args": []
    },
    {
      "namespace": "crispy-doom",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crispy-doom CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crispy-doom",
        "passthrough": true,
        "missingDependencyHelp": "Install crispy-doom"
      },
      "args": []
    }
  ]
}