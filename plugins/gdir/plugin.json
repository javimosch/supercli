{
  "name": "gdir",
  "version": "0.1.0",
  "description": "A command line tool which queries Google Directions. The tool displays results as human-readable text.",
  "source": "https://github.com/pafoster/gdir",
  "checks": [
    {
      "type": "binary",
      "name": "gdir"
    }
  ],
  "install_guidance": {
    "plugin": "gdir",
    "binary": "gdir",
    "check": "which gdir",
    "install_steps": [
      "See https://github.com/pafoster/gdir",
      "Verify: gdir --version",
      "supercli plugins install ./plugins/gdir --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gdir",
      "resource": "self",
      "action": "version",
      "description": "Print gdir version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdir",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdir: See https://github.com/pafoster/gdir"
      },
      "args": []
    },
    {
      "namespace": "gdir",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdir CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdir",
        "passthrough": true,
        "missingDependencyHelp": "Install gdir"
      },
      "args": []
    }
  ]
}