{
  "name": "git-fame",
  "version": "0.1.0",
  "description": "Git repository contributor statistics. Shows lines added/deleted per author with optional JSON output.",
  "source": "https",
  "checks": [{"type": "binary", "name": "git-fame"}],
  "install_guidance": {
    "plugin": "git-fame",
    "binary": "git-fame",
    "check": "which git-fame",
    "install_steps": ["brew install git-fame", "Verify: git-fame --version", "supercli plugins install ./plugins/git-fame --on-conflict replace --json"],
    "note": "Non-interactive CLI tool."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {"namespace": "git", "resource": "self", "action": "version", "description": "Print git-fame version", "adapter": "process", "adapterConfig": {"command": "git-fame", "baseArgs": ["--version"], "missingDependencyHelp": "Install git-fame: brew install git-fame"}, "args": []},
    {"namespace": "git", "resource": "_", "action": "_", "description": "Passthrough to git-fame CLI", "adapter": "process", "adapterConfig": {"command": "git-fame", "passthrough": true, "missingDependencyHelp": "Install git-fame: brew install git-fame"}, "args": []}
  ]
}
