{
  "name": "revanced-patches",
  "version": "0.1.0",
  "description": "\ud83e\udde9 Patches for ReVanced",
  "source": "https://github.com/revanced-patches/revanced-patches",
  "checks": [
    {
      "type": "binary",
      "name": "revanced-patches"
    }
  ],
  "install_guidance": {
    "plugin": "revanced-patches",
    "binary": "revanced-patches",
    "check": "which revanced-patches",
    "install_steps": [
      "pip install revanced-patches",
      "Verify: revanced-patches --version",
      "supercli plugins install ./plugins/revanced-patches --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "revanced-patches",
      "resource": "self",
      "action": "version",
      "description": "Print revanced-patches version",
      "adapter": "process",
      "adapterConfig": {
        "command": "revanced-patches",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install revanced-patches: pip install revanced-patches"
      },
      "args": []
    },
    {
      "namespace": "revanced-patches",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to revanced-patches CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "revanced-patches",
        "passthrough": true,
        "missingDependencyHelp": "Install revanced-patches: pip install revanced-patches"
      },
      "args": []
    }
  ]
}