{
  "name": "octelium",
  "version": "0.1.0",
  "description": "A next-gen FOSS self-hosted unified zero trust secure access platform that can operate as a remote a",
  "source": "https://github.com/octelium/octelium",
  "checks": [
    {
      "type": "binary",
      "name": "octelium"
    }
  ],
  "install_guidance": {
    "plugin": "octelium",
    "binary": "octelium",
    "check": "which octelium",
    "install_steps": [
      "pip install octelium",
      "Verify: octelium --version",
      "supercli plugins install ./plugins/octelium --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "octelium",
      "resource": "self",
      "action": "version",
      "description": "Print octelium version",
      "adapter": "process",
      "adapterConfig": {
        "command": "octelium",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install octelium: pip install octelium"
      },
      "args": []
    },
    {
      "namespace": "octelium",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to octelium CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "octelium",
        "passthrough": true,
        "missingDependencyHelp": "Install octelium: pip install octelium"
      },
      "args": []
    }
  ]
}