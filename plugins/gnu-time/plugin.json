{
  "name": "gnu-time",
  "version": "0.1.0",
  "description": "GNU implementation of time utility",
  "checks": [
    {
      "type": "binary",
      "name": "gnu-time"
    }
  ],
  "install_guidance": {
    "plugin": "gnu-time",
    "binary": "gnu-time",
    "check": "which gnu-time",
    "install_steps": [
      "brew install gnu-time",
      "Verify: gnu-time --version",
      "supercli plugins install ./plugins/gnu-time --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gnu-time",
      "resource": "self",
      "action": "version",
      "description": "Print gnu-time version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnu-time",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gnu-time: brew install gnu-time"
      },
      "args": []
    },
    {
      "namespace": "gnu-time",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gnu-time CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnu-time",
        "passthrough": true,
        "missingDependencyHelp": "Install gnu-time"
      },
      "args": []
    }
  ]
}