{
  "name": "csvtool",
  "version": "0.1.0",
  "description": "CSV manipulation utility",
  "source": "https://github.com/pauldes/ocaml-csv",
  "checks": [
    {
      "type": "binary",
      "name": "csvtool"
    }
  ],
  "install_guidance": {
    "plugin": "csvtool",
    "binary": "csvtool",
    "check": "which csvtool",
    "install_steps": [
      "brew install csvtool",
      "Verify: csvtool --version",
      "supercli plugins install ./plugins/csvtool --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "csvtool",
      "resource": "self",
      "action": "version",
      "description": "Print csvtool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvtool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csvtool: brew install csvtool"
      },
      "args": []
    },
    {
      "namespace": "csvtool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csvtool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvtool",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install csvtool: brew install csvtool"
      },
      "args": []
    }
  ]
}
