{
  "name": "nmtui-edit",
  "version": "0.1.0",
  "description": "CLI tool: nmtui-edit",
  "source": "https://manpages.debian.org/nmtui-edit",
  "checks": [
    {
      "type": "binary",
      "name": "nmtui-edit"
    }
  ],
  "install_guidance": {
    "plugin": "nmtui-edit",
    "binary": "nmtui-edit",
    "check": "which nmtui-edit",
    "install_steps": [
      "apt-get install nmtui-edit 2>/dev/null || which nmtui-edit",
      "Verify: nmtui-edit --version",
      "supercli plugins install ./plugins/nmtui-edit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nmtui-edit",
      "resource": "self",
      "action": "version",
      "description": "Print nmtui-edit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nmtui-edit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nmtui-edit: apt-get install nmtui-edit 2>/dev/null || which nmtui-edit"
      },
      "args": []
    },
    {
      "namespace": "nmtui-edit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nmtui-edit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nmtui-edit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nmtui-edit: apt-get install nmtui-edit 2>/dev/null || which nmtui-edit"
      },
      "args": []
    }
  ]
}