{
  "plugin": "ntfssecaudit",
  "binary": "ntfssecaudit",
  "check": "which ntfssecaudit",
  "install_steps": [
    "# Install ntfssecaudit",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ntfssecaudit-linux-amd64 -o /usr/local/bin/ntfssecaudit",
