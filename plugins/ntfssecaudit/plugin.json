{
  "name": "ntfssecaudit",
  "version": "1.0.0",
  "description": "ntfssecaudit \u2014 ntfssecaudit \u2014 CLI utility",
  "source": "/usr/bin/ntfssecaudit",
  "checks": [
    {
      "type": "binary",
      "name": "ntfssecaudit"
    }
  ],
  "install_guidance": {
    "plugin": "ntfssecaudit",
    "binary": "ntfssecaudit",
    "check": "which ntfssecaudit",
    "install_steps": [
      "# Install ntfssecaudit:",
      "# apt: sudo apt-get install ntfssecaudit",
      "# brew: brew install ntfssecaudit",
      "# cargo: cargo install ntfssecaudit",
      "# npm: npm install -g ntfssecaudit",
      "# pip: pip install ntfssecaudit",
      "# or download from /usr/bin/ntfssecaudit"
    ]
  },
  "commands": [
    {
      "namespace": "ntfssecaudit",
      "resource": "ntfssecaudit",
      "action": "run",
      "description": "Run ntfssecaudit",
      "adapter": "process",
      "adapterConfig": {
        "command": "ntfssecaudit",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ntfssecaudit from /usr/bin/ntfssecaudit"
      },
      "args": []
    }
  ]
}