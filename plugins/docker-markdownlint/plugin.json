{
  "name": "docker-markdownlint",
  "version": "0.1.0",
  "description": "🐳 Dockerized markdown-cli with proper versioning, a command line lint tool for Markdown/CommonMark files.",
  "source": "https://hub.docker.com/r/peterdavehello/markdownlint/",
  "checks": [
    {
      "type": "binary",
      "name": "docker-markdownlint"
    }
  ],
  "install_guidance": {
    "plugin": "docker-markdownlint",
    "binary": "docker-markdownlint",
    "check": "which docker-markdownlint",
    "install_steps": [
      "Check https://hub.docker.com/r/peterdavehello/markdownlint/ for installation instructions",
      "Verify: docker-markdownlint --version",
      "supercli plugins install ./plugins/docker-markdownlint --on-conflict replace --json"
    ],
    "note": "Shell language CLI tool"
  },
  "commands": [
    {
      "namespace": "docker-markdownlint",
      "resource": "self",
      "action": "version",
      "description": "Print docker-markdownlint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-markdownlint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-markdownlint from project repository"
      },
      "args": []
    },
    {
      "namespace": "docker-markdownlint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-markdownlint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-markdownlint",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-markdownlint from project repository"
      },
      "args": []
    }
  ]
}