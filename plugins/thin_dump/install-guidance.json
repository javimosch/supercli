{
  "plugin": "thin_dump",
  "binary": "thin_dump",
  "check": "which thin_dump",
  "install_steps": [
    "apt-get install thin_dump 2>/dev/null || which thin_dump",
    "Verify: thin_dump --version",
    "supercli plugins install ./plugins/thin_dump --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}