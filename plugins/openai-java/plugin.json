{
  "name": "openai-java",
  "version": "0.1.0",
  "description": "The official Java library for the OpenAI API",
  "source": "https://github.com/openai-java/openai-java",
  "checks": [
    {
      "type": "binary",
      "name": "openai-java"
    }
  ],
  "install_guidance": {
    "plugin": "openai-java",
    "binary": "openai-java",
    "check": "which openai-java",
    "install_steps": [
      "pip install openai-java",
      "Verify: openai-java --version",
      "supercli plugins install ./plugins/openai-java --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openai-java",
      "resource": "self",
      "action": "version",
      "description": "Print openai-java version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openai-java",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openai-java: pip install openai-java"
      },
      "args": []
    },
    {
      "namespace": "openai-java",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openai-java CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openai-java",
        "passthrough": true,
        "missingDependencyHelp": "Install openai-java: pip install openai-java"
      },
      "args": []
    }
  ]
}