{
  "name": "CnC_Red_Alert",
  "version": "0.1.0",
  "description": "Command and Conquer: Red Alert",
  "source": "https://github.com/CnC_Red_Alert/CnC_Red_Alert",
  "checks": [
    {
      "type": "binary",
      "name": "cnc-red-alert"
    }
  ],
  "install_guidance": {
    "plugin": "CnC_Red_Alert",
    "binary": "cnc-red-alert",
    "check": "which cnc-red-alert",
    "install_steps": [
      "pip install cnc-red-alert",
      "Verify: cnc-red-alert --version",
      "supercli plugins install ./plugins/CnC_Red_Alert --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CnC_Red_Alert",
      "resource": "self",
      "action": "version",
      "description": "Print CnC_Red_Alert version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-red-alert",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CnC_Red_Alert: pip install cnc-red-alert"
      },
      "args": []
    },
    {
      "namespace": "CnC_Red_Alert",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cnc-red-alert CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-red-alert",
        "passthrough": true,
        "missingDependencyHelp": "Install CnC_Red_Alert: pip install cnc-red-alert"
      },
      "args": []
    }
  ]
}