{
  "name": "rulesync",
  "version": "0.1.0",
  "description": "Rules Sync CLI",
  "source": "https://github.com/dyoshikawa/rulesync",
  "checks": [
    { "type": "binary", "name": "rulesync" }
  ],
  "install_guidance": {
    "plugin": "rulesync",
    "binary": "rulesync",
    "check": "which rulesync",
    "install_steps": [
      "npm install -g rulesync",
      "Verify: rulesync --version",
      "supercli plugins install ./plugins/rulesync --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rulesync",
      "resource": "self",
      "action": "version",
      "description": "Print rulesync version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rulesync",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install rulesync: npm install -g rulesync"
      },
      "args": []
    },
    {
      "namespace": "rulesync",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rulesync CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rulesync",
        "passthrough": true,
        "missingDependencyHelp": "Install rulesync"
      },
      "args": []
    }
  ]
}
