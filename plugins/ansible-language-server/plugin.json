{
  "name": "ansible-language-server",
  "version": "0.1.0",
  "description": "Language Server for Ansible Files",
  "source": "https://github.com/ansible/vscode-ansible",
  "checks": [
    {
      "type": "binary",
      "name": "ansible-language-server"
    }
  ],
  "install_guidance": {
    "plugin": "ansible-language-server",
    "binary": "ansible-language-server",
    "check": "which ansible-language-server",
    "install_steps": [
      "brew install ansible-language-server",
      "Verify: ansible-language-server --version",
      "supercli plugins install ./plugins/ansible-language-server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ansible-language-server",
      "resource": "self",
      "action": "version",
      "description": "Print ansible-language-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ansible-language-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ansible-language-server: brew install ansible-language-server"
      },
      "args": []
    },
    {
      "namespace": "ansible-language-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ansible-language-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ansible-language-server",
        "passthrough": true,
        "missingDependencyHelp": "Install ansible-language-server"
      },
      "args": []
    }
  ]
}