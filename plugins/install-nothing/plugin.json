{
  "name": "install-nothing",
  "version": "0.1.0",
  "description": "Simulates installing things but doesn't actually install anything",
  "source": "https://github.com/buyukakyuz/install-nothing",
  "checks": [
    {
      "type": "binary",
      "name": "install-nothing"
    }
  ],
  "install_guidance": {
    "plugin": "install-nothing",
    "binary": "install-nothing",
    "check": "which install-nothing",
    "install_steps": [
      "brew install install-nothing",
      "Verify: install-nothing --version",
      "supercli plugins install ./plugins/install-nothing --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "install-nothing",
      "resource": "self",
      "action": "version",
      "description": "Print install-nothing version",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-nothing",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install install-nothing: brew install install-nothing"
      },
      "args": []
    },
    {
      "namespace": "install-nothing",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to install-nothing CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-nothing",
        "passthrough": true,
        "missingDependencyHelp": "Install install-nothing"
      },
      "args": []
    }
  ]
}