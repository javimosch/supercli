{
  "name": "litellm",
  "version": "0.1.0",
  "description": "litellm — LLM API proxy server for calling 100+ providers with OpenAI format",
  "source": "https://github.com/BerriAI/litellm",
  "checks": [
    {
      "type": "binary",
      "name": "litellm"
    }
  ],
  "install_guidance": {
    "plugin": "litellm",
    "binary": "litellm",
    "check": "which litellm",
    "install_steps": [
      "pip install litellm"
    ],
    "note": "AI/LLM tool. Requires Python 3.8+."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "litellm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to litellm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "litellm",
        "passthrough": true,
        "missingDependencyHelp": "Install litellm: pip install litellm"
      },
      "args": []
    }
  ]
}
