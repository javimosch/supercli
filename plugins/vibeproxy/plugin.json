{
  "name": "vibeproxy",
  "version": "0.1.0",
  "description": "Native macOS menu bar app to use your Claude Code & ChatGPT subscriptions with AI coding tools - no ",
  "source": "https://github.com/vibeproxy/vibeproxy",
  "checks": [
    {
      "type": "binary",
      "name": "vibeproxy"
    }
  ],
  "install_guidance": {
    "plugin": "vibeproxy",
    "binary": "vibeproxy",
    "check": "which vibeproxy",
    "install_steps": [
      "pip install vibeproxy",
      "Verify: vibeproxy --version",
      "supercli plugins install ./plugins/vibeproxy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vibeproxy",
      "resource": "self",
      "action": "version",
      "description": "Print vibeproxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibeproxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vibeproxy: pip install vibeproxy"
      },
      "args": []
    },
    {
      "namespace": "vibeproxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vibeproxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibeproxy",
        "passthrough": true,
        "missingDependencyHelp": "Install vibeproxy: pip install vibeproxy"
      },
      "args": []
    }
  ]
}