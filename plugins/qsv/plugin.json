{
  "name": "qsv",
  "version": "0.1.0",
  "description": "A fast CSV command line toolkit for slicing, dicing, analyzing, splitting, joining, indexing, and enriching CSV data. Supports JSON output and pipeline operations.",
  "source": "https://github.com/dathere/qsv",
  "checks": [
    { "type": "binary", "name": "qsv" }
  ],
  "install_guidance": {
    "plugin": "qsv",
    "binary": "qsv",
    "check": "which qsv",
    "install_steps": [
      "cargo install qsv",
      "Verify: qsv --version",
      "supercli plugins install ./plugins/qsv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qsv",
      "resource": "self",
      "action": "version",
      "description": "Print qsv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qsv",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install qsv: cargo install qsv"
      },
      "args": []
    },
    {
      "namespace": "qsv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qsv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qsv",
        "passthrough": true,
        "missingDependencyHelp": "Install qsv: cargo install qsv"
      },
      "args": []
    }
  ]
}
