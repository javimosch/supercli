{
  "name": "termpair",
  "version": "0.1.0",
  "description": "Share your terminal sessions with end-to-end encryption",
  "source": "https://github.com/cs01/termpair",
  "checks": [{ "type": "binary", "name": "termpair" }],
  "install_guidance": {
    "plugin": "termpair",
    "binary": "termpair",
    "check": "which termpair",
    "install_steps": ["pip install termpair", "Verify: termpair --version", "supercli plugins install ./plugins/termpair --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "termpair",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to termpair CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "termpair",
      "passthrough": true,
      "missingDependencyHelp": "Install termpair: pip install termpair", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
