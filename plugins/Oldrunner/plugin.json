{
  "name": "Oldrunner",
  "version": "0.1.0",
  "description": "Character-based remake of Lode Runner, includes all the original 150 levels.",
  "source": "https://github.com/culot/oldrunner",
  "checks": [
    {
      "type": "binary",
      "name": "Oldrunner"
    }
  ],
  "install_guidance": {
    "plugin": "Oldrunner",
    "binary": "Oldrunner",
    "check": "which Oldrunner",
    "install_steps": [
      "See https://github.com/culot/oldrunner",
      "Verify: Oldrunner --version",
      "supercli plugins install ./plugins/Oldrunner --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Oldrunner",
      "resource": "self",
      "action": "version",
      "description": "Print Oldrunner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Oldrunner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Oldrunner: See https://github.com/culot/oldrunner"
      },
      "args": []
    },
    {
      "namespace": "Oldrunner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Oldrunner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Oldrunner",
        "passthrough": true,
        "missingDependencyHelp": "Install Oldrunner"
      },
      "args": []
    }
  ]
}