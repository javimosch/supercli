{
  "name": "easeprobe",
  "version": "0.1.0",
  "description": "Simple, standalone, and lightWeight tool that can do health/status checking",
  "source": "https://github.com/megaease/easeprobe",
  "checks": [
    {
      "type": "binary",
      "name": "easeprobe"
    }
  ],
  "install_guidance": {
    "plugin": "easeprobe",
    "binary": "easeprobe",
    "check": "which easeprobe",
    "install_steps": [
      "brew install easeprobe",
      "Verify: easeprobe --version",
      "supercli plugins install ./plugins/easeprobe --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "easeprobe",
      "resource": "self",
      "action": "version",
      "description": "Print easeprobe version",
      "adapter": "process",
      "adapterConfig": {
        "command": "easeprobe",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install easeprobe: brew install easeprobe"
      },
      "args": []
    },
    {
      "namespace": "easeprobe",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to easeprobe CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "easeprobe",
        "passthrough": true,
        "missingDependencyHelp": "Install easeprobe"
      },
      "args": []
    }
  ]
}