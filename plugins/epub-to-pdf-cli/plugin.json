{
  "name": "epub-to-pdf-cli",
  "version": "0.1.0",
  "description": "Node.js wrapper to convert ebooks to PDF via Calibre",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "epub-to-pdf-cli" }],
  "install_guidance": {
    "plugin": "epub-to-pdf-cli",
    "binary": "epub-to-pdf-cli",
    "check": "which epub-to-pdf-cli",
    "install_steps": ["npm install -g epub-to-pdf-cli", "Verify: epub-to-pdf-cli --version", "supercli plugins install ./plugins/epub-to-pdf-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epub-to-pdf-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epub-to-pdf-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epub-to-pdf-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install epub-to-pdf-cli: npm install -g epub-to-pdf-cli"
    },
    "args": []
  }]
}
