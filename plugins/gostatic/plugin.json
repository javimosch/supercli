{
  "name": "gostatic",
  "version": "0.1.0",
  "description": "Fast static site generator",
  "source": "https://github.com/piranha/gostatic",
  "checks": [
    {
      "type": "binary",
      "name": "gostatic"
    }
  ],
  "install_guidance": {
    "plugin": "gostatic",
    "binary": "gostatic",
    "check": "which gostatic",
    "install_steps": [
      "brew install gostatic",
      "Verify: gostatic --version",
      "supercli plugins install ./plugins/gostatic --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gostatic",
      "resource": "self",
      "action": "version",
      "description": "Print gostatic version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gostatic",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gostatic: brew install gostatic"
      },
      "args": []
    },
    {
      "namespace": "gostatic",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gostatic CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gostatic",
        "passthrough": true,
        "missingDependencyHelp": "Install gostatic"
      },
      "args": []
    }
  ]
}