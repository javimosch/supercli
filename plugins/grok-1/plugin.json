{
  "name": "grok-1",
  "version": "0.1.0",
  "description": "Grok open release",
  "source": "https://github.com/grok-1/grok-1",
  "checks": [
    {
      "type": "binary",
      "name": "grok-1"
    }
  ],
  "install_guidance": {
    "plugin": "grok-1",
    "binary": "grok-1",
    "check": "which grok-1",
    "install_steps": [
      "pip install grok-1",
      "Verify: grok-1 --version",
      "supercli plugins install ./plugins/grok-1 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grok-1",
      "resource": "self",
      "action": "version",
      "description": "Print grok-1 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grok-1",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grok-1: pip install grok-1"
      },
      "args": []
    },
    {
      "namespace": "grok-1",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grok-1 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grok-1",
        "passthrough": true,
        "missingDependencyHelp": "Install grok-1: pip install grok-1"
      },
      "args": []
    }
  ]
}