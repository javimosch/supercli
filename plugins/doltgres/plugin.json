{
  "name": "doltgres",
  "version": "0.1.0",
  "description": "Dolt for Postgres",
  "source": "https://github.com/dolthub/doltgresql",
  "checks": [
    {
      "type": "binary",
      "name": "doltgres"
    }
  ],
  "install_guidance": {
    "plugin": "doltgres",
    "binary": "doltgres",
    "check": "which doltgres",
    "install_steps": [
      "brew install doltgres",
      "Verify: doltgres --version",
      "supercli plugins install ./plugins/doltgres --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "doltgres",
      "resource": "self",
      "action": "version",
      "description": "Print doltgres version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doltgres",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install doltgres: brew install doltgres"
      },
      "args": []
    },
    {
      "namespace": "doltgres",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to doltgres CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "doltgres",
        "passthrough": true,
        "missingDependencyHelp": "Install doltgres"
      },
      "args": []
    }
  ]
}