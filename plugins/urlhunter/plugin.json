{
  "name": "urlhunter",
  "version": "0.1.0",
  "description": "Hunt and extract URLs from file sources",
  "source": "https://github.com/utkusen/urlhunter",
  "checks": [{ "type": "binary", "name": "urlhunter" }],
  "install_guidance": {
    "plugin": "urlhunter",
    "binary": "urlhunter",
    "check": "which urlhunter",
    "install_steps": ["go install github.com/utkusen/urlhunter@latest", "Verify: urlhunter --version", "supercli plugins install ./plugins/urlhunter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "urlhunter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to urlhunter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "urlhunter",
      "passthrough": true,
      "missingDependencyHelp": "Install urlhunter: go install github.com/utkusen/urlhunter@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
