{
  "name": "ijs_pxljr",
  "version": "0.1.0",
  "description": "CLI tool: ijs_pxljr",
  "source": "https://manpages.debian.org/ijs_pxljr",
  "checks": [
    {
      "type": "binary",
      "name": "ijs_pxljr"
    }
  ],
  "install_guidance": {
    "plugin": "ijs_pxljr",
    "binary": "ijs_pxljr",
    "check": "which ijs_pxljr",
    "install_steps": [
      "apt-get install ijs_pxljr 2>/dev/null || which ijs_pxljr",
      "Verify: ijs_pxljr --version",
      "supercli plugins install ./plugins/ijs_pxljr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ijs_pxljr",
      "resource": "self",
      "action": "version",
      "description": "Print ijs_pxljr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ijs_pxljr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ijs_pxljr: apt-get install ijs_pxljr 2>/dev/null || which ijs_pxljr"
      },
      "args": []
    },
    {
      "namespace": "ijs_pxljr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ijs_pxljr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ijs_pxljr",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ijs_pxljr: apt-get install ijs_pxljr 2>/dev/null || which ijs_pxljr"
      },
      "args": []
    }
  ]
}