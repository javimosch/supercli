{
  "name": "bender",
  "version": "0.1.0",
  "description": "Dependency management tool for hardware projects",
  "source": "https://github.com/pulp-platform/bender",
  "checks": [
    {
      "type": "binary",
      "name": "bender"
    }
  ],
  "install_guidance": {
    "plugin": "bender",
    "binary": "bender",
    "check": "which bender",
    "install_steps": [
      "brew install bender",
      "Verify: bender --version",
      "supercli plugins install ./plugins/bender --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bender",
      "resource": "self",
      "action": "version",
      "description": "Print bender version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bender",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bender: brew install bender"
      },
      "args": []
    },
    {
      "namespace": "bender",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bender CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bender",
        "passthrough": true,
        "missingDependencyHelp": "Install bender"
      },
      "args": []
    }
  ]
}