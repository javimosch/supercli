{
  "name": "loco",
  "version": "0.1.0",
  "description": "\ud83d\ude82 \ud83e\udd80 The one-person framework for Rust for side-projects and startups",
  "source": "https://github.com/loco/loco",
  "checks": [
    {
      "type": "binary",
      "name": "loco"
    }
  ],
  "install_guidance": {
    "plugin": "loco",
    "binary": "loco",
    "check": "which loco",
    "install_steps": [
      "pip install loco",
      "Verify: loco --version",
      "supercli plugins install ./plugins/loco --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "loco",
      "resource": "self",
      "action": "version",
      "description": "Print loco version",
      "adapter": "process",
      "adapterConfig": {
        "command": "loco",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install loco: pip install loco"
      },
      "args": []
    },
    {
      "namespace": "loco",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to loco CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "loco",
        "passthrough": true,
        "missingDependencyHelp": "Install loco: pip install loco"
      },
      "args": []
    }
  ]
}