{
  "name": "unshare",
  "version": "0.1.0",
  "description": "Run program in new Linux namespaces",
  "source": "https://packages.debian.org/unshare",
  "checks": [
    { "type": "binary", "name": "unshare" }
  ],
  "install_guidance": {
    "plugin": "unshare",
    "binary": "unshare",
    "check": "which unshare",
    "install_steps": [
      "apt-get install util-linux",
      "Verify: unshare --version",
      "supercli plugins install ./plugins/unshare --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "unshare",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unshare CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unshare",
        "passthrough": true,
        "missingDependencyHelp": "Install unshare: apt-get install util-linux"
      },
      "args": []
    }
  ]
}
