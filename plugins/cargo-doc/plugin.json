{
  "name": "cargo-doc",
  "version": "0.1.0",
  "description": "cargo-doc — generate Rust crate documentation from doc comments",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-doc"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-doc",
    "binary": "cargo-doc",
    "check": "which cargo-doc",
    "install_steps": [
      "brew install rust",
      "supercli plugins install ./plugins/cargo-doc --on-conflict replace --json"
    ],
    "note": "Development tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cargo-doc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-doc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-doc",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-doc: brew install rust"
      },
      "args": []
    }
  ]
}
