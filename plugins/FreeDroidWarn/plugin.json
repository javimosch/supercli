{
  "name": "FreeDroidWarn",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/FreeDroidWarn/FreeDroidWarn",
  "checks": [
    {
      "type": "binary",
      "name": "freedroidwarn"
    }
  ],
  "install_guidance": {
    "plugin": "FreeDroidWarn",
    "binary": "freedroidwarn",
    "check": "which freedroidwarn",
    "install_steps": [
      "pip install freedroidwarn",
      "Verify: freedroidwarn --version",
      "supercli plugins install ./plugins/FreeDroidWarn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FreeDroidWarn",
      "resource": "self",
      "action": "version",
      "description": "Print FreeDroidWarn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freedroidwarn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FreeDroidWarn: pip install freedroidwarn"
      },
      "args": []
    },
    {
      "namespace": "FreeDroidWarn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freedroidwarn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freedroidwarn",
        "passthrough": true,
        "missingDependencyHelp": "Install FreeDroidWarn: pip install freedroidwarn"
      },
      "args": []
    }
  ]
}