{
  "name": "epy",
  "version": "0.1.0",
  "description": "Terminal reader for epub fb2 mobi azw3 formats",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "epy" }],
  "install_guidance": {
    "plugin": "epy",
    "binary": "epy",
    "check": "which epy",
    "install_steps": ["pip install epy-reader", "Verify: epy --version", "supercli plugins install ./plugins/epy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epy",
      "passthrough": true,
      "missingDependencyHelp": "Install epy: pip install epy-reader"
    },
    "args": []
  }]
}
