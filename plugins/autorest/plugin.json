{
  "name": "autorest",
  "version": "0.1.0",
  "description": "Swagger (OpenAPI) Specification code generator",
  "source": "https://github.com/Azure/autorest",
  "checks": [
    {
      "type": "binary",
      "name": "autorest"
    }
  ],
  "install_guidance": {
    "plugin": "autorest",
    "binary": "autorest",
    "check": "which autorest",
    "install_steps": [
      "brew install autorest",
      "Verify: autorest --version",
      "supercli plugins install ./plugins/autorest --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "autorest",
      "resource": "self",
      "action": "version",
      "description": "Print autorest version",
      "adapter": "process",
      "adapterConfig": {
        "command": "autorest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install autorest: brew install autorest"
      },
      "args": []
    },
    {
      "namespace": "autorest",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to autorest CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "autorest",
        "passthrough": true,
        "missingDependencyHelp": "Install autorest"
      },
      "args": []
    }
  ]
}