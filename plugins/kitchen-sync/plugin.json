{
  "name": "kitchen-sync",
  "version": "0.1.0",
  "description": "Fast efficiently sync database without dumping & reloading",
  "source": "https://github.com/willbryant/kitchen_sync",
  "checks": [
    {
      "type": "binary",
      "name": "kitchen-sync"
    }
  ],
  "install_guidance": {
    "plugin": "kitchen-sync",
    "binary": "kitchen-sync",
    "check": "which kitchen-sync",
    "install_steps": [
      "brew install kitchen-sync",
      "Verify: kitchen-sync --version",
      "supercli plugins install ./plugins/kitchen-sync --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kitchen-sync",
      "resource": "self",
      "action": "version",
      "description": "Print kitchen-sync version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kitchen-sync",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kitchen-sync: brew install kitchen-sync"
      },
      "args": []
    },
    {
      "namespace": "kitchen-sync",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kitchen-sync CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kitchen-sync",
        "passthrough": true,
        "missingDependencyHelp": "Install kitchen-sync"
      },
      "args": []
    }
  ]
}