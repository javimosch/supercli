{
  "name": "clifm",
  "version": "1.0.0",
  "description": "clifm \u2014 Command-line file manager",
  "source": "github.com/leo-arch/clifm",
  "checks": [
    {
      "type": "binary",
      "name": "clifm"
    }
  ],
  "install_guidance": {
    "plugin": "clifm",
    "binary": "clifm",
    "check": "which clifm",
    "install_steps": [
      "# Install clifm:",
      "# apt: sudo apt-get install clifm",
      "# brew: brew install clifm",
      "# cargo: cargo install clifm",
      "# npm: npm install -g clifm",
      "# pip: pip install clifm",
      "# or download from github.com/leo-arch/clifm"
    ]
  },
  "commands": [
    {
      "namespace": "clifm",
      "resource": "clifm",
      "action": "run",
      "description": "Run clifm",
      "adapter": "process",
      "adapterConfig": {
        "command": "clifm",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install clifm from github.com/leo-arch/clifm"
      },
      "args": []
    }
  ]
}