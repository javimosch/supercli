{
  "name": "QuickRecorder",
  "version": "0.1.0",
  "description": "A lightweight screen recorder based on ScreenCapture Kit for macOS / \u57fa\u4e8e ScreenCapture Kit \u7684\u8f7b\u91cf\u5316\u591a\u529f\u80fd ma",
  "source": "https://github.com/QuickRecorder/QuickRecorder",
  "checks": [
    {
      "type": "binary",
      "name": "quickrecorder"
    }
  ],
  "install_guidance": {
    "plugin": "QuickRecorder",
    "binary": "quickrecorder",
    "check": "which quickrecorder",
    "install_steps": [
      "pip install quickrecorder",
      "Verify: quickrecorder --version",
      "supercli plugins install ./plugins/QuickRecorder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "QuickRecorder",
      "resource": "self",
      "action": "version",
      "description": "Print QuickRecorder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quickrecorder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install QuickRecorder: pip install quickrecorder"
      },
      "args": []
    },
    {
      "namespace": "QuickRecorder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to quickrecorder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "quickrecorder",
        "passthrough": true,
        "missingDependencyHelp": "Install QuickRecorder: pip install quickrecorder"
      },
      "args": []
    }
  ]
}