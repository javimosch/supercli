{
  "name": "seqdiag",
  "version": "0.1.0",
  "description": "Generate sequence diagrams from simple text descriptions",
  "source": "https://github.com/blockdiag/seqdiag",
  "checks": [{ "type": "binary", "name": "seqdiag" }],
  "install_guidance": {
    "plugin": "seqdiag",
    "binary": "seqdiag",
    "check": "which seqdiag",
    "install_steps": ["pip install seqdiag", "Verify: seqdiag --version", "supercli plugins install ./plugins/seqdiag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "seqdiag",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to seqdiag CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "seqdiag",
      "passthrough": true,
      "missingDependencyHelp": "Install seqdiag: pip install seqdiag", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
