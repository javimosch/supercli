{
  "name": "FlowBot",
  "version": "0.1.0",
  "description": "\u5fae\u4fe1\uff0c\u4f01\u5fae\uff0c\u4f01\u5fae\u673a\u5668\u4eba\uff0c\u5fae\u4fe1\u673a\u5668\u4eba\uff0cworkbot\uff0cworktool\uff0cwetool\uff0cRPA\uff0c\u534f\u8bae\uff0cvbot\uff0c\u9006\u5411\uff0chook\uff0c\u5b89\u5168\u7a33\u5b9a\u96f6\u5c01\u53f7\u7684RPA\u673a\u5668\u4eba\uff0c\u652f\u6301\u901a\u8fc7API\u63a7\u5236\u4f01\u4e1a\u5fae\u4fe1\u6765\u5b9e\u73b0\u805a\u5408\u804a\u5929\u3001\u81ea\u52a8",
  "source": "https://github.com/FlowBot/FlowBot",
  "checks": [
    {
      "type": "binary",
      "name": "flowbot"
    }
  ],
  "install_guidance": {
    "plugin": "FlowBot",
    "binary": "flowbot",
    "check": "which flowbot",
    "install_steps": [
      "pip install flowbot",
      "Verify: flowbot --version",
      "supercli plugins install ./plugins/FlowBot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FlowBot",
      "resource": "self",
      "action": "version",
      "description": "Print FlowBot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flowbot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FlowBot: pip install flowbot"
      },
      "args": []
    },
    {
      "namespace": "FlowBot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flowbot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flowbot",
        "passthrough": true,
        "missingDependencyHelp": "Install FlowBot: pip install flowbot"
      },
      "args": []
    }
  ]
}