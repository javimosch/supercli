{
  "name": "asciicam",
  "version": "0.1.0",
  "description": "Record your terminal as ASCII art video",
  "source": "https://github.com/asciicam/asciicam",
  "checks": [{ "type": "binary", "name": "asciicam" }],
  "install_guidance": {
    "plugin": "asciicam",
    "binary": "asciicam",
    "check": "which asciicam",
    "install_steps": ["npm install -g asciicam", "Verify: asciicam --version", "supercli plugins install ./plugins/asciicam --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "asciicam",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to asciicam CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "asciicam",
      "passthrough": true,
      "missingDependencyHelp": "Install asciicam: npm install -g asciicam", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
