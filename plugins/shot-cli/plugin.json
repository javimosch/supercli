{
  "name": "shot-cli",
  "version": "0.1.0",
  "description": "Simple CLI screenshot tool for Linux and macOS",
  "source": "https://github.com/shot-cli/shot-cli",
  "checks": [{ "type": "binary", "name": "shot-cli" }],
  "install_guidance": {
    "plugin": "shot-cli",
    "binary": "shot-cli",
    "check": "which shot-cli",
    "install_steps": ["brew install shot-cli", "Verify: shot-cli --version", "supercli plugins install ./plugins/shot-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "shot-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to shot-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "shot-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install shot-cli: brew install shot-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
