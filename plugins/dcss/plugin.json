{
  "name": "dcss",
  "version": "0.1.0",
  "description": "CLI tool: dcss",
  "source": "https://packages.debian.org/dcss",
  "checks": [{ "type": "binary", "name": "dcss" }],
  "install_guidance": {
    "plugin": "dcss", "binary": "dcss", "check": "which dcss",
    "install_steps": ["apt-get install dcss 2>/dev/null || which dcss", "Verify: dcss --version", "supercli plugins install ./plugins/dcss --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dcss", "resource": "_", "action": "_",
    "description": "Passthrough to dcss CLI",
    "adapter": "process", "adapterConfig": { "command": "dcss", "passthrough": true, "missingDependencyHelp": "Install dcss: apt-get install dcss" }, "args": []
  }]
}
