{
  "plugin": "gnome-extensions",
  "binary": "gnome-extensions",
  "check": "which gnome-extensions",
  "install_steps": [
    "apt-get install gnome-extensions 2>/dev/null || which gnome-extensions",
    "Verify: gnome-extensions --version",
    "supercli plugins install ./plugins/gnome-extensions --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
