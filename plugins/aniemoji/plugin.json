{
  "name": "aniemoji",
  "version": "0.1.0",
  "description": "Lightweight cross-platform emoji list fetcher and viewer",
  "source": "https://github.com/iamovi/aniemoji",
  "checks": [{ "type": "binary", "name": "aniemoji" }],
  "install_guidance": {
    "plugin": "aniemoji",
    "binary": "aniemoji",
    "check": "which aniemoji",
    "install_steps": ["npm install -g aniemoji", "Verify: aniemoji --version", "supercli plugins install ./plugins/aniemoji --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aniemoji",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to aniemoji CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "aniemoji",
      "passthrough": true,
      "missingDependencyHelp": "Install aniemoji: npm install -g aniemoji", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
