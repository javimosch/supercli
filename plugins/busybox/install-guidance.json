{
  "plugin": "busybox",
  "binary": "busybox",
  "check": "which busybox",
  "install_steps": [
    "# Install busybox",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/busybox-linux-amd64 -o /usr/local/bin/busybox",
    "chmod +x /usr/local/bin/busybox",
    "# Or via package manager, see /usr/bin/busybox"
  ]
}