{
  "name": "openssl",
  "version": "0.1.0",
  "description": "OpenSSL cryptography toolkit for TLS/SSL and crypto operations",
  "source": "https",
  "checks": [{"type": "binary", "name": "openssl"}],
  "install_guidance": {
    "plugin": "openssl",
    "binary": "openssl",
    "check": "which openssl",
    "install_steps": [
      "brew install openssl",
      "Verify: openssl --version",
      "supercli plugins install ./plugins/openssl --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "openssl",
      "resource": "self",
      "action": "version",
      "description": "Print openssl version",
      "adapter": "process",
      "adapterConfig": {"command": "openssl", "baseArgs": ["--version"], "missingDependencyHelp": "Install openssl: brew install openssl"},
      "args": []
    },
    {
      "namespace": "openssl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openssl CLI",
      "adapter": "process",
      "adapterConfig": {"command": "openssl", "passthrough": true, "missingDependencyHelp": "Install openssl: brew install openssl"},
      "args": []
    }
  ]
}
