{
  "name": "tdx",
  "version": "0.1.0",
  "description": "Simple plain-text todo manager focused on minimalism",
  "source": "https://github.com/nheer/tdx",
  "checks": [{ "type": "binary", "name": "tdx" }],
  "install_guidance": {
    "plugin": "tdx",
    "binary": "tdx",
    "check": "which tdx",
    "install_steps": ["cargo install tdx", "Verify: tdx --version", "supercli plugins install ./plugins/tdx --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tdx",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tdx CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tdx",
      "passthrough": true,
      "missingDependencyHelp": "Install tdx: cargo install tdx", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
