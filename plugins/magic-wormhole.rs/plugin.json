{
  "name": "magic-wormhole.rs",
  "version": "0.1.0",
  "description": "Rust implementation of Magic Wormhole, with new features and enhancements",
  "source": "https://github.com/magic-wormhole/magic-wormhole.rs",
  "checks": [
    {
      "type": "binary",
      "name": "magic-wormhole.rs"
    }
  ],
  "install_guidance": {
    "plugin": "magic-wormhole.rs",
    "binary": "magic-wormhole.rs",
    "check": "which magic-wormhole.rs",
    "install_steps": [
      "brew install magic-wormhole.rs",
      "Verify: magic-wormhole.rs --version",
      "supercli plugins install ./plugins/magic-wormhole.rs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "magic-wormhole.rs",
      "resource": "self",
      "action": "version",
      "description": "Print magic-wormhole.rs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "magic-wormhole.rs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install magic-wormhole.rs: brew install magic-wormhole.rs"
      },
      "args": []
    },
    {
      "namespace": "magic-wormhole.rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to magic-wormhole.rs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "magic-wormhole.rs",
        "passthrough": true,
        "missingDependencyHelp": "Install magic-wormhole.rs"
      },
      "args": []
    }
  ]
}