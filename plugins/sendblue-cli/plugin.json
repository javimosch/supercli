{
  "name": "sendblue-cli",
  "version": "0.1.0",
  "description": "iMessage integration for agents — send and receive iMessages programmatically from the terminal via Sendblue.",
  "source": "https://sendblue.co",
  "checks": [
    { "type": "binary", "name": "sendblue" }
  ],
  "install_guidance": {
    "plugin": "sendblue-cli",
    "binary": "sendblue",
    "check": "which sendblue",
    "install_steps": [
      "npm i -g @sendblue/cli",
      "Verify: sendblue --version",
      "supercli plugins install ./plugins/sendblue-cli --on-conflict replace --json"
    ],
    "note": "Requires SENDBLUE_API_KEY env var. Get key at https://sendblue.co"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sendblue-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sendblue CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sendblue",
        "passthrough": true,
        "missingDependencyHelp": "Install sendblue: npm i -g @sendblue/cli"
      },
      "args": []
    }
  ]
}
