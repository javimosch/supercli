{
  "name": "depotdir5",
  "version": "0.1.0",
  "description": "CLI tool: depotdir5",
  "source": "https://packages.debian.org/depotdir5",
  "checks": [{ "type": "binary", "name": "depotdir5" }],
  "install_guidance": {
    "plugin": "depotdir5", "binary": "depotdir5", "check": "which depotdir5",
    "install_steps": ["apt-get install depotdir5 2>/dev/null || which depotdir5", "Verify: depotdir5 --version", "supercli plugins install ./plugins/depotdir5 --on-conflict replace --json"]
