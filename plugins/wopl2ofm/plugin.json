{
  "name": "wopl2ofm",
  "version": "0.1.0",
  "description": "CLI tool: wopl2ofm",
  "source": "https://manpages.debian.org/wopl2ofm",
  "checks": [
    {
      "type": "binary",
      "name": "wopl2ofm"
    }
  ],
  "install_guidance": {
    "plugin": "wopl2ofm",
    "binary": "wopl2ofm",
    "check": "which wopl2ofm",
    "install_steps": [
      "apt-get install wopl2ofm 2>/dev/null || which wopl2ofm",
      "Verify: wopl2ofm --version",
      "supercli plugins install ./plugins/wopl2ofm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wopl2ofm",
      "resource": "self",
      "action": "version",
      "description": "Print wopl2ofm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wopl2ofm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wopl2ofm: apt-get install wopl2ofm 2>/dev/null || which wopl2ofm"
      },
      "args": []
    },
    {
      "namespace": "wopl2ofm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wopl2ofm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wopl2ofm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wopl2ofm: apt-get install wopl2ofm 2>/dev/null || which wopl2ofm"
      },
      "args": []
    }
  ]
}