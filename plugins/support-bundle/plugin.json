{
  "name": "support-bundle",
  "version": "0.1.0",
  "description": "Kubernetes troubleshooting and diagnostics bundle",
  "source": "https://github.com/replicatedhq/troubleshoot",
  "checks": [{ "type": "binary", "name": "support-bundle" }],
  "install_guidance": {
    "plugin": "support-bundle",
    "binary": "support-bundle",
    "check": "which support-bundle",
    "install_steps": ["brew install support-bundle", "Verify: support-bundle --version", "supercli plugins install ./plugins/support-bundle --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "support-bundle",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to support-bundle CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "support-bundle",
      "passthrough": true,
      "missingDependencyHelp": "Install support-bundle: brew install support-bundle"
    },
    "args": []
  }]
}
