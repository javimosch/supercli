{
  "name": "hermes-agent",
  "version": "0.1.0",
  "description": "The agent that grows with you",
  "source": "https://github.com/hermes-agent/hermes-agent",
  "checks": [
    {
      "type": "binary",
      "name": "hermes-agent"
    }
  ],
  "install_guidance": {
    "plugin": "hermes-agent",
    "binary": "hermes-agent",
    "check": "which hermes-agent",
    "install_steps": [
      "pip install hermes-agent",
      "Verify: hermes-agent --version",
      "supercli plugins install ./plugins/hermes-agent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hermes-agent",
      "resource": "self",
      "action": "version",
      "description": "Print hermes-agent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hermes-agent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hermes-agent: pip install hermes-agent"
      },
      "args": []
    },
    {
      "namespace": "hermes-agent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hermes-agent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hermes-agent",
        "passthrough": true,
        "missingDependencyHelp": "Install hermes-agent: pip install hermes-agent"
      },
      "args": []
    }
  ]
}