{
  "name": "tolerance",
  "version": "0.1.0",
  "description": "Desktop app to manage markdown knowledge bases",
  "source": "https://github.com/refactoringhq/tolaria",
  "checks": [
    {
      "type": "binary",
      "name": "tolaria"
    }
  ],
  "install_guidance": {
    "plugin": "tolerance",
    "binary": "tolaria",
    "check": "which tolaria",
    "install_steps": [
      "npm install -g tolaria",
      "Verify: tolaria --version",
      "supercli plugins install ./plugins/tolerance --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "tolerance",
    "resource": "self",
    "action": "version",
    "description": "Print tolerance version",
    "adapter": "process",
    "adapterConfig": {
      "command": "tolaria",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install tolerance: npm install -g tolaria"
    },
    "args": []
  },
  {
    "namespace": "tolerance",
    "resource": "kb",
    "action": "open",
    "description": "Open a knowledge base",
    "adapter": "process",
    "adapterConfig": {
      "command": "tolaria",
      "passthrough": true,
      "missingDependencyHelp": "Install tolerance: npm install -g tolaria"
    },
    "args": []
  },
  {
    "namespace": "tolerance",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tolaria CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tolaria",
      "passthrough": true,
      "missingDependencyHelp": "Install tolerance"
    },
    "args": []
  }
]
}