{
  "name": "webbrowser-rs",
  "version": "0.1.0",
  "description": "Open URLs in browser from the CLI (Rust)",
  "source": "https://github.com/amodm/webbrowser-rs",
  "checks": [{ "type": "binary", "name": "webbrowser-rs" }],
  "install_guidance": {
    "plugin": "webbrowser-rs",
    "binary": "webbrowser-rs",
    "check": "which webbrowser-rs",
    "install_steps": ["cargo install webbrowser", "Verify: webbrowser-rs --version", "supercli plugins install ./plugins/webbrowser-rs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "webbrowser-rs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to webbrowser-rs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "webbrowser-rs",
      "passthrough": true,
      "missingDependencyHelp": "Install webbrowser-rs: cargo install webbrowser"
    },
    "args": []
  }]
}
