{
  "name": "hindent",
  "version": "0.1.0",
  "description": "Haskell pretty printer",
  "source": "https://github.com/mihaimaruseac/hindent",
  "checks": [
    {
      "type": "binary",
      "name": "hindent"
    }
  ],
  "install_guidance": {
    "plugin": "hindent",
    "binary": "hindent",
    "check": "which hindent",
    "install_steps": [
      "brew install hindent",
      "Verify: hindent --version",
      "supercli plugins install ./plugins/hindent --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hindent",
      "resource": "self",
      "action": "version",
      "description": "Print hindent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hindent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hindent: brew install hindent"
      },
      "args": []
    },
    {
      "namespace": "hindent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hindent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hindent",
        "passthrough": true,
        "missingDependencyHelp": "Install hindent"
      },
      "args": []
    }
  ]
}