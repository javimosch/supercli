{
  "name": "qpdldecode",
  "version": "0.1.0",
  "description": "CLI tool: qpdldecode",
  "source": "https://manpages.debian.org/qpdldecode",
  "checks": [
    {
      "type": "binary",
      "name": "qpdldecode"
    }
  ],
  "install_guidance": {
    "plugin": "qpdldecode",
    "binary": "qpdldecode",
    "check": "which qpdldecode",
    "install_steps": [
      "apt-get install qpdldecode 2>/dev/null || which qpdldecode",
      "Verify: qpdldecode --version",
      "supercli plugins install ./plugins/qpdldecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qpdldecode",
      "resource": "self",
      "action": "version",
      "description": "Print qpdldecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qpdldecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qpdldecode: apt-get install qpdldecode 2>/dev/null || which qpdldecode"
      },
      "args": []
    },
    {
      "namespace": "qpdldecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qpdldecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qpdldecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qpdldecode: apt-get install qpdldecode 2>/dev/null || which qpdldecode"
      },
      "args": []
    }
  ]
}