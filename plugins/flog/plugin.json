{
  "name": "flog",
  "version": "0.1.0",
  "description": "A fake log generator for log formats such as apache-common, apache error and RFC3164 syslog",
  "source": "https://github.com/mingrammer/flog",
  "checks": [
    {
      "type": "binary",
      "name": "flog"
    }
  ],
  "install_guidance": {
    "plugin": "flog",
    "binary": "flog",
    "check": "which flog",
    "install_steps": [
      "See https://github.com/mingrammer/flog",
      "Verify: flog --version",
      "supercli plugins install ./plugins/flog --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "flog",
      "resource": "self",
      "action": "version",
      "description": "Print flog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flog: See https://github.com/mingrammer/flog"
      },
      "args": []
    },
    {
      "namespace": "flog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flog",
        "passthrough": true,
        "missingDependencyHelp": "Install flog"
      },
      "args": []
    }
  ]
}