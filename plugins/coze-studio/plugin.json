{
  "name": "coze-studio",
  "version": "0.1.0",
  "description": "An AI agent development platform with all-in-one visual tools, simplifying agent creation, debugging",
  "source": "https://github.com/coze-studio/coze-studio",
  "checks": [
    {
      "type": "binary",
      "name": "coze-studio"
    }
  ],
  "install_guidance": {
    "plugin": "coze-studio",
    "binary": "coze-studio",
    "check": "which coze-studio",
    "install_steps": [
      "pip install coze-studio",
      "Verify: coze-studio --version",
      "supercli plugins install ./plugins/coze-studio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "coze-studio",
      "resource": "self",
      "action": "version",
      "description": "Print coze-studio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coze-studio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coze-studio: pip install coze-studio"
      },
      "args": []
    },
    {
      "namespace": "coze-studio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coze-studio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coze-studio",
        "passthrough": true,
        "missingDependencyHelp": "Install coze-studio: pip install coze-studio"
      },
      "args": []
    }
  ]
}