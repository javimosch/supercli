{
  "name": "tfa",
  "version": "0.1.0",
  "description": "tfa is a 2fa cli tool that aims to help you to generate 2fa code on CI/CD pipelines.",
  "source": "https://github.com/tfa/tfa",
  "checks": [
    {
      "type": "binary",
      "name": "tfa"
    }
  ],
  "install_guidance": {
    "plugin": "tfa",
    "binary": "tfa",
    "check": "which tfa",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: tfa --version",
      "supercli plugins install ./plugins/tfa --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "tfa",
      "resource": "self",
      "action": "version",
      "description": "Print tfa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tfa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tfa from project repository"
      },
      "args": []
    },
    {
      "namespace": "tfa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tfa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tfa",
        "passthrough": true,
        "missingDependencyHelp": "Install tfa from project repository"
      },
      "args": []
    }
  ]
}