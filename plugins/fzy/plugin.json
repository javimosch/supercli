{
  "name": "fzy",
  "version": "0.1.0",
  "description": "fzy \u2014 a fast, simple fuzzy text selector for the terminal.",
  "source": "https://github.com/jhawthorn/fzy",
  "checks": [
    {
      "type": "binary",
      "name": "fzy"
    }
  ],
  "install_guidance": {
    "plugin": "fzy",
    "binary": "fzy",
    "check": "which fzy",
    "install_steps": [
      "brew install fzy",
      "sudo apt-get install fzy",
      "cargo install fzy",
      "supercli plugins install ./plugins/fzy --on-conflict replace --json"
    ],
    "note": "C. Fuzzy finder for terminal."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fzy",
      "resource": "search",
      "action": "run",
      "description": "Fuzzy filter stdin lines",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzy",
        "missingDependencyHelp": "Install fzy",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "fzy",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzy",
        "missingDependencyHelp": "Install fzy",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
