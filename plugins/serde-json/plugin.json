{
  "name": "serde-json",
  "version": "0.1.0",
  "description": "serde-json — JSON serialization for Rust",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "serde-json"
    }
  ],
  "install_guidance": {
    "plugin": "serde-json",
    "binary": "serde-json",
    "check": "which serde-json",
    "install_steps": [
      "cargo install serde-json",
      "Verify: serde-json --version",
      "supercli plugins install ./plugins/serde-json --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "serde-json",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "serde-json",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install serde-json"
      },
      "args": []
    }
  ]
}
