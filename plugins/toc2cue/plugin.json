{
  "name": "toc2cue",
  "version": "0.1.0",
  "description": "CLI tool: toc2cue",
  "source": "https://manpages.debian.org/toc2cue",
  "checks": [
    {
      "type": "binary",
      "name": "toc2cue"
    }
  ],
  "install_guidance": {
    "plugin": "toc2cue",
    "binary": "toc2cue",
    "check": "which toc2cue",
    "install_steps": [
      "apt-get install toc2cue 2>/dev/null || which toc2cue",
      "Verify: toc2cue --version",
      "supercli plugins install ./plugins/toc2cue --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "toc2cue",
      "resource": "self",
      "action": "version",
      "description": "Print toc2cue version",
      "adapter": "process",
      "adapterConfig": {
        "command": "toc2cue",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install toc2cue: apt-get install toc2cue 2>/dev/null || which toc2cue"
      },
      "args": []
    },
    {
      "namespace": "toc2cue",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to toc2cue CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "toc2cue",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install toc2cue: apt-get install toc2cue 2>/dev/null || which toc2cue"
      },
      "args": []
    }
  ]
}