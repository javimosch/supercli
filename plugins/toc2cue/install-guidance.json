{
  "plugin": "toc2cue",
  "binary": "toc2cue",
  "check": "which toc2cue",
  "install_steps": [
    "apt-get install toc2cue 2>/dev/null || which toc2cue",
    "Verify: toc2cue --version",
    "supercli plugins install ./plugins/toc2cue --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}