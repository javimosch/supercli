{
  "plugin": "pyrsa-verify",
  "binary": "pyrsa-verify",
  "check": "which pyrsa-verify",
  "install_steps": [
    "apt-get install pyrsa-verify 2>/dev/null || which pyrsa-verify",
    "Verify: pyrsa-verify --version",
    "supercli plugins install ./plugins/pyrsa-verify --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}