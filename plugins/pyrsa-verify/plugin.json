{
  "name": "pyrsa-verify",
  "version": "0.1.0",
  "description": "CLI tool: pyrsa-verify",
  "source": "https://manpages.debian.org/pyrsa-verify",
  "checks": [
    {
      "type": "binary",
      "name": "pyrsa-verify"
    }
  ],
  "install_guidance": {
    "plugin": "pyrsa-verify",
    "binary": "pyrsa-verify",
    "check": "which pyrsa-verify",
    "install_steps": [
      "apt-get install pyrsa-verify 2>/dev/null || which pyrsa-verify",
      "Verify: pyrsa-verify --version",
      "supercli plugins install ./plugins/pyrsa-verify --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyrsa-verify",
      "resource": "self",
      "action": "version",
      "description": "Print pyrsa-verify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrsa-verify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyrsa-verify: apt-get install pyrsa-verify 2>/dev/null || which pyrsa-verify"
      },
      "args": []
    },
    {
      "namespace": "pyrsa-verify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyrsa-verify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrsa-verify",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrsa-verify: apt-get install pyrsa-verify 2>/dev/null || which pyrsa-verify"
      },
      "args": []
    }
  ]
}