{
  "name": "sbcl",
  "version": "0.1.0",
  "description": "Steel Bank Common Lisp compiler",
  "source": "https://packages.debian.org/sbcl",
  "checks": [{ "type": "binary", "name": "sbcl" }],
  "install_guidance": {
    "plugin": "sbcl", "binary": "sbcl", "check": "which sbcl",
    "install_steps": ["apt-get install sbcl", "Verify: sbcl --version", "supercli plugins install ./plugins/sbcl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sbcl", "resource": "_", "action": "_",
    "description": "Passthrough to sbcl CLI",
    "adapter": "process", "adapterConfig": { "command": "sbcl", "passthrough": true, "missingDependencyHelp": "Install sbcl: apt-get install sbcl" }, "args": []
  }]
}
