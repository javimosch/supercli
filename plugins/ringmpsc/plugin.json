{
  "name": "ringmpsc",
  "version": "0.1.0",
  "description": "Lock-free MPSC channel in Zig achieving 180+ billion messages/second via ring-decomposed architectur",
  "source": "https://github.com/ringmpsc/ringmpsc",
  "checks": [
    {
      "type": "binary",
      "name": "ringmpsc"
    }
  ],
  "install_guidance": {
    "plugin": "ringmpsc",
    "binary": "ringmpsc",
    "check": "which ringmpsc",
    "install_steps": [
      "pip install ringmpsc",
      "Verify: ringmpsc --version",
      "supercli plugins install ./plugins/ringmpsc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ringmpsc",
      "resource": "self",
      "action": "version",
      "description": "Print ringmpsc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ringmpsc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ringmpsc: pip install ringmpsc"
      },
      "args": []
    },
    {
      "namespace": "ringmpsc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ringmpsc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ringmpsc",
        "passthrough": true,
        "missingDependencyHelp": "Install ringmpsc: pip install ringmpsc"
      },
      "args": []
    }
  ]
}