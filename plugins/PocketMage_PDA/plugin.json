{
  "name": "PocketMage_PDA",
  "version": "0.1.0",
  "description": "An E-Ink PDA device using the ESP32 S3.",
  "source": "https://github.com/PocketMage_PDA/PocketMage_PDA",
  "checks": [
    {
      "type": "binary",
      "name": "pocketmage-pda"
    }
  ],
  "install_guidance": {
    "plugin": "PocketMage_PDA",
    "binary": "pocketmage-pda",
    "check": "which pocketmage-pda",
    "install_steps": [
      "pip install pocketmage-pda",
      "Verify: pocketmage-pda --version",
      "supercli plugins install ./plugins/PocketMage_PDA --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PocketMage_PDA",
      "resource": "self",
      "action": "version",
      "description": "Print PocketMage_PDA version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pocketmage-pda",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PocketMage_PDA: pip install pocketmage-pda"
      },
      "args": []
    },
    {
      "namespace": "PocketMage_PDA",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pocketmage-pda CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pocketmage-pda",
        "passthrough": true,
        "missingDependencyHelp": "Install PocketMage_PDA: pip install pocketmage-pda"
      },
      "args": []
    }
  ]
}