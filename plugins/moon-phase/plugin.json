{
  "name": "moon-phase",
  "version": "0.1.0",
  "description": "Display current moon phase and illumination in the terminal",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "moon-phase" }],
  "install_guidance": {
    "plugin": "moon-phase",
    "binary": "moon-phase",
    "check": "which moon-phase",
    "install_steps": ["npm install -g moon-phase-cli", "Verify: moon-phase --version", "supercli plugins install ./plugins/moon-phase --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "moon-phase",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to moon-phase CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "moon-phase",
      "passthrough": true,
      "missingDependencyHelp": "Install moon-phase: npm install -g moon-phase-cli"
    },
    "args": []
  }]
}
