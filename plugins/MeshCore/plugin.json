{
  "name": "MeshCore",
  "version": "0.1.0",
  "description": "A new lightweight, hybrid routing mesh protocol for packet radios",
  "source": "https://github.com/MeshCore/MeshCore",
  "checks": [
    {
      "type": "binary",
      "name": "meshcore"
    }
  ],
  "install_guidance": {
    "plugin": "MeshCore",
    "binary": "meshcore",
    "check": "which meshcore",
    "install_steps": [
      "pip install meshcore",
      "Verify: meshcore --version",
      "supercli plugins install ./plugins/MeshCore --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MeshCore",
      "resource": "self",
      "action": "version",
      "description": "Print MeshCore version",
      "adapter": "process",
      "adapterConfig": {
        "command": "meshcore",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MeshCore: pip install meshcore"
      },
      "args": []
    },
    {
      "namespace": "MeshCore",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to meshcore CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "meshcore",
        "passthrough": true,
        "missingDependencyHelp": "Install MeshCore: pip install meshcore"
      },
      "args": []
    }
  ]
}