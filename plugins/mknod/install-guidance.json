{
  "plugin": "mknod",
  "binary": "mknod",
  "check": "which mknod",
  "install_steps": [
    "# Install mknod",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/mknod-linux-amd64 -o /usr/local/bin/mknod",
    "chmod +x /usr/local/bin/mknod",
    "# Or via package manager, see /usr/bin/mknod"
  ]
}