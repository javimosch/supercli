{
  "name": "pcb-stackup",
  "version": "0.1.0",
  "description": "Generate stackup diagrams from PCB manufacturing files",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "pcb-stackup" }],
  "install_guidance": {
    "plugin": "pcb-stackup",
    "binary": "pcb-stackup",
    "check": "which pcb-stackup",
    "install_steps": ["pip install pcb-stackup", "Verify: pcb-stackup --version", "supercli plugins install ./plugins/pcb-stackup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pcb-stackup",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pcb-stackup CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pcb-stackup",
      "passthrough": true,
      "missingDependencyHelp": "Install pcb-stackup: pip install pcb-stackup"
    },
    "args": []
  }]
}
