{
  "name": "atool",
  "version": "0.1.0",
  "description": "Unified archive management frontend",
  "source": "https://github.com/svendahlstrand/atool",
  "checks": [
    {
      "type": "binary",
      "name": "atool"
    }
  ],
  "install_guidance": {
    "plugin": "atool",
    "binary": "atool",
    "check": "which atool",
    "install_steps": [
      "brew install atool",
      "Verify: atool --version",
      "supercli plugins install ./plugins/atool --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "atool",
      "resource": "self",
      "action": "version",
      "description": "Print atool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "atool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install atool: brew install atool"
      },
      "args": []
    },
    {
      "namespace": "atool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to atool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "atool",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install atool: brew install atool"
      },
      "args": []
    }
  ]
}
