{
  "name": "container",
  "version": "0.1.0",
  "description": "A tool for creating and running Linux containers using lightweight virtual machines on a Mac. It is ",
  "source": "https://github.com/container/container",
  "checks": [
    {
      "type": "binary",
      "name": "container"
    }
  ],
  "install_guidance": {
    "plugin": "container",
    "binary": "container",
    "check": "which container",
    "install_steps": [
      "pip install container",
      "Verify: container --version",
      "supercli plugins install ./plugins/container --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "container",
      "resource": "self",
      "action": "version",
      "description": "Print container version",
      "adapter": "process",
      "adapterConfig": {
        "command": "container",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install container: pip install container"
      },
      "args": []
    },
    {
      "namespace": "container",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to container CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "container",
        "passthrough": true,
        "missingDependencyHelp": "Install container: pip install container"
      },
      "args": []
    }
  ]
}