{
  "name": "link-grammar",
  "version": "0.1.0",
  "description": "Carnegie Mellon University's link grammar parser",
  "source": "https://github.com/opencog/link-grammar",
  "checks": [
    {
      "type": "binary",
      "name": "link-grammar"
    }
  ],
  "install_guidance": {
    "plugin": "link-grammar",
    "binary": "link-grammar",
    "check": "which link-grammar",
    "install_steps": [
      "brew install link-grammar",
      "Verify: link-grammar --version",
      "supercli plugins install ./plugins/link-grammar --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "link-grammar",
      "resource": "self",
      "action": "version",
      "description": "Print link-grammar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "link-grammar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install link-grammar: brew install link-grammar"
      },
      "args": []
    },
    {
      "namespace": "link-grammar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to link-grammar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "link-grammar",
        "passthrough": true,
        "missingDependencyHelp": "Install link-grammar"
      },
      "args": []
    }
  ]
}