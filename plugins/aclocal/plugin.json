{
  "name": "aclocal",
  "version": "0.1.0",
  "description": "CLI tool: aclocal",
  "source": "https://packages.debian.org/aclocal",
  "checks": [{ "type": "binary", "name": "aclocal" }],
  "install_guidance": {
    "plugin": "aclocal", "binary": "aclocal", "check": "which aclocal",
    "install_steps": ["apt-get install aclocal 2>/dev/null || which aclocal", "Verify: aclocal --version", "supercli plugins install ./plugins/aclocal --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aclocal", "resource": "_", "action": "_",
    "description": "Passthrough to aclocal CLI",
    "adapter": "process", "adapterConfig": { "command": "aclocal", "passthrough": true, "missingDependencyHelp": "Install aclocal: apt-get install aclocal" }, "args": []
  }]
}
