{
  "name": "lue",
  "version": "0.1.0",
  "description": "Terminal eBook reader emphasizing simplicity in Rust",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "lue" }],
  "install_guidance": {
    "plugin": "lue",
    "binary": "lue",
    "check": "which lue",
    "install_steps": ["cargo install lue", "Verify: lue --version", "supercli plugins install ./plugins/lue --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lue",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lue CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lue",
      "passthrough": true,
      "missingDependencyHelp": "Install lue: cargo install lue"
    },
    "args": []
  }]
}
