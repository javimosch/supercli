{
  "name": "polystate",
  "version": "0.1.0",
  "description": "Build type-safe finite state machines with higher-order states.",
  "source": "https://github.com/polystate/polystate",
  "checks": [
    {
      "type": "binary",
      "name": "polystate"
    }
  ],
  "install_guidance": {
    "plugin": "polystate",
    "binary": "polystate",
    "check": "which polystate",
    "install_steps": [
      "pip install polystate",
      "Verify: polystate --version",
      "supercli plugins install ./plugins/polystate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "polystate",
      "resource": "self",
      "action": "version",
      "description": "Print polystate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "polystate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install polystate: pip install polystate"
      },
      "args": []
    },
    {
      "namespace": "polystate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to polystate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "polystate",
        "passthrough": true,
        "missingDependencyHelp": "Install polystate: pip install polystate"
      },
      "args": []
    }
  ]
}