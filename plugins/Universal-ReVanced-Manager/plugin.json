{
  "name": "Universal-ReVanced-Manager",
  "version": "0.1.0",
  "description": "\ud83d\udc8a An Android application to use ReVanced, Morphe and AmpleReVanced on that has extra features the of",
  "source": "https://github.com/Universal-ReVanced-Manager/Universal-ReVanced-Manager",
  "checks": [
    {
      "type": "binary",
      "name": "universal-revanced-manager"
    }
  ],
  "install_guidance": {
    "plugin": "Universal-ReVanced-Manager",
    "binary": "universal-revanced-manager",
    "check": "which universal-revanced-manager",
    "install_steps": [
      "pip install universal-revanced-manager",
      "Verify: universal-revanced-manager --version",
      "supercli plugins install ./plugins/Universal-ReVanced-Manager --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Universal-ReVanced-Manager",
      "resource": "self",
      "action": "version",
      "description": "Print Universal-ReVanced-Manager version",
      "adapter": "process",
      "adapterConfig": {
        "command": "universal-revanced-manager",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Universal-ReVanced-Manager: pip install universal-revanced-manager"
      },
      "args": []
    },
    {
      "namespace": "Universal-ReVanced-Manager",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to universal-revanced-manager CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "universal-revanced-manager",
        "passthrough": true,
        "missingDependencyHelp": "Install Universal-ReVanced-Manager: pip install universal-revanced-manager"
      },
      "args": []
    }
  ]
}