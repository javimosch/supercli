{
  "name": "ebook-convert",
  "version": "1.0.0",
  "description": "ebook-convert \u2014 E-book converter",
  "source": "calibre-ebook.com",
  "checks": [
    {
      "type": "binary",
      "name": "ebook-convert"
    }
  ],
  "install_guidance": {
    "plugin": "ebook-convert",
    "binary": "ebook-convert",
    "check": "which ebook-convert",
    "install_steps": [
      "# Install ebook-convert",
      "# See calibre-ebook.com",
      "# apt: sudo apt-get install ebook-convert",
      "# brew: brew install ebook-convert",
      "# cargo: cargo install ebook-convert",
      "# npm: npm install -g ebook-convert",
      "# pip: pip install ebook-convert"
    ]
  },
  "commands": [
    {
      "namespace": "ebook",
      "resource": "convert",
      "action": "run",
      "description": "Run ebook-convert",
      "adapter": "process",
      "adapterConfig": {
        "command": "ebook-convert",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ebook-convert from calibre-ebook.com"
      },
      "args": []
    }
  ]
}