{
  "name": "dive",
  "version": "0.1.0",
  "description": "Tool for exploring each layer in a Docker image",
  "source": "https://github.com/wagoodman/dive",
  "checks": [{ "type": "binary", "name": "dive" }],
  "install_guidance": {
    "plugin": "dive",
    "binary": "dive",
    "check": "which dive",
    "install_steps": ["brew install dive", "Verify: dive --version", "supercli plugins install ./plugins/dive --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dive",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dive CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dive",
      "passthrough": true,
      "missingDependencyHelp": "Install dive: brew install dive"
    },
    "args": []
  }]
}
