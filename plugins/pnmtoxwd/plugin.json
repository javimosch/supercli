{
  "name": "pnmtoxwd",
  "version": "0.1.0",
  "description": "CLI tool: pnmtoxwd",
  "source": "https://manpages.debian.org/pnmtoxwd",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtoxwd"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtoxwd",
    "binary": "pnmtoxwd",
    "check": "which pnmtoxwd",
    "install_steps": [
      "apt-get install pnmtoxwd 2>/dev/null || which pnmtoxwd",
      "Verify: pnmtoxwd --version",
      "supercli plugins install ./plugins/pnmtoxwd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtoxwd",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtoxwd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtoxwd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtoxwd: apt-get install pnmtoxwd 2>/dev/null || which pnmtoxwd"
      },
      "args": []
    },
    {
      "namespace": "pnmtoxwd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtoxwd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtoxwd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtoxwd: apt-get install pnmtoxwd 2>/dev/null || which pnmtoxwd"
      },
      "args": []
    }
  ]
}