{
  "name": "gpg-connect-agent",
  "version": "0.1.0",
  "description": "GnuPG agent communication",
  "source": "https://packages.debian.org/gpg-connect-agent",
  "checks": [{ "type": "binary", "name": "gpg-connect-agent" }],
  "install_guidance": {
    "plugin": "gpg-connect-agent", "binary": "gpg-connect-agent", "check": "which gpg-connect-agent",
    "install_steps": ["apt-get install gnupg-agent", "Verify: gpg-connect-agent --version", "supercli plugins install ./plugins/gpg-connect-agent --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gpg-connect-agent", "resource": "_", "action": "_",
    "description": "Passthrough to gpg-connect-agent CLI",
    "adapter": "process", "adapterConfig": { "command": "gpg-connect-agent", "passthrough": true, "missingDependencyHelp": "Install gpg-connect-agent: apt-get install gnupg-agent" }, "args": []
  }]
}
