{
  "name": "mpicxx.openmpi",
  "version": "0.1.0",
  "description": "CLI tool: mpicxx.openmpi",
  "source": "https://manpages.debian.org/mpicxx.openmpi",
  "checks": [
    {
      "type": "binary",
      "name": "mpicxx.openmpi"
    }
  ],
  "install_guidance": {
    "plugin": "mpicxx.openmpi",
    "binary": "mpicxx.openmpi",
    "check": "which mpicxx.openmpi",
    "install_steps": [
      "apt-get install mpicxx.openmpi 2>/dev/null || which mpicxx.openmpi",
      "Verify: mpicxx.openmpi --version",
      "supercli plugins install ./plugins/mpicxx.openmpi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpicxx.openmpi",
      "resource": "self",
      "action": "version",
      "description": "Print mpicxx.openmpi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpicxx.openmpi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpicxx.openmpi: apt-get install mpicxx.openmpi 2>/dev/null || which mpicxx.openmpi"
      },
      "args": []
    },
    {
      "namespace": "mpicxx.openmpi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpicxx.openmpi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpicxx.openmpi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mpicxx.openmpi: apt-get install mpicxx.openmpi 2>/dev/null || which mpicxx.openmpi"
      },
      "args": []
    }
  ]
}