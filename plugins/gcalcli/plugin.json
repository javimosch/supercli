{
  "name": "gcalcli",
  "version": "1.0.0",
  "description": "gcalcli \u2014 Google Calendar CLI",
  "source": "github.com/insanum/gcalcli",
  "checks": [
    {
      "type": "binary",
      "name": "gcalcli"
    }
  ],
  "install_guidance": {
    "plugin": "gcalcli",
    "binary": "gcalcli",
    "check": "which gcalcli",
    "install_steps": [
      "# Install gcalcli",
      "# See github.com/insanum/gcalcli",
      "# apt: sudo apt-get install gcalcli",
      "# brew: brew install gcalcli",
      "# cargo: cargo install gcalcli",
      "# npm: npm install -g gcalcli",
      "# pip: pip install gcalcli"
    ]
  },
  "commands": [
    {
      "namespace": "gcalcli",
      "resource": "gcalcli",
      "action": "run",
      "description": "Run gcalcli",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcalcli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gcalcli from github.com/insanum/gcalcli"
      },
      "args": []
    }
  ]
}