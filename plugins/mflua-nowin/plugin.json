{
  "name": "mflua-nowin",
  "version": "0.1.0",
  "description": "CLI tool: mflua-nowin",
  "source": "https://manpages.debian.org/mflua-nowin",
  "checks": [
    {
      "type": "binary",
      "name": "mflua-nowin"
    }
  ],
  "install_guidance": {
    "plugin": "mflua-nowin",
    "binary": "mflua-nowin",
    "check": "which mflua-nowin",
    "install_steps": [
      "apt-get install mflua-nowin 2>/dev/null || which mflua-nowin",
      "Verify: mflua-nowin --version",
      "supercli plugins install ./plugins/mflua-nowin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mflua-nowin",
      "resource": "self",
      "action": "version",
      "description": "Print mflua-nowin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mflua-nowin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mflua-nowin: apt-get install mflua-nowin 2>/dev/null || which mflua-nowin"
      },
      "args": []
    },
    {
      "namespace": "mflua-nowin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mflua-nowin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mflua-nowin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mflua-nowin: apt-get install mflua-nowin 2>/dev/null || which mflua-nowin"
      },
      "args": []
    }
  ]
}