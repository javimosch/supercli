{
  "name": "m365_chili",
  "version": "0.1.0",
  "description": "CLI tool: m365_chili",
  "source": "https://manpages.debian.org/m365_chili",
  "checks": [
    {
      "type": "binary",
      "name": "m365_chili"
    }
  ],
  "install_guidance": {
    "plugin": "m365_chili",
    "binary": "m365_chili",
    "check": "which m365_chili",
    "install_steps": [
      "apt-get install m365_chili 2>/dev/null || which m365_chili",
      "Verify: m365_chili --version",
      "supercli plugins install ./plugins/m365_chili --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "m365_chili",
      "resource": "self",
      "action": "version",
      "description": "Print m365_chili version",
      "adapter": "process",
      "adapterConfig": {
        "command": "m365_chili",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install m365_chili: apt-get install m365_chili 2>/dev/null || which m365_chili"
      },
      "args": []
    },
    {
      "namespace": "m365_chili",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to m365_chili CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "m365_chili",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install m365_chili: apt-get install m365_chili 2>/dev/null || which m365_chili"
      },
      "args": []
    }
  ]
}