{
  "name": "gftype",
  "version": "0.1.0",
  "description": "CLI tool: gftype",
  "source": "https://manpages.debian.org/gftype",
  "checks": [
    {
      "type": "binary",
      "name": "gftype"
    }
  ],
  "install_guidance": {
    "plugin": "gftype",
    "binary": "gftype",
    "check": "which gftype",
    "install_steps": [
      "apt-get install gftype 2>/dev/null || which gftype",
      "Verify: gftype --version",
      "supercli plugins install ./plugins/gftype --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gftype",
      "resource": "self",
      "action": "version",
      "description": "Print gftype version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gftype",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gftype: apt-get install gftype 2>/dev/null || which gftype"
      },
      "args": []
    },
    {
      "namespace": "gftype",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gftype CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gftype",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gftype: apt-get install gftype 2>/dev/null || which gftype"
      },
      "args": []
    }
  ]
}