{
  "name": "quickserve",
  "version": "0.1.0",
  "description": "Very simple HTTP server written in Python for quickly sharing files on an ad-hoc basis. Aside from opening a port in your firewall if you have one, it requires no setup and should work with no hassle.",
  "source": "https://github.com/haileys/quickserve",
  "checks": [
    {
      "type": "binary",
      "name": "quickserve"
    }
  ],
  "install_guidance": {
    "plugin": "quickserve",
    "binary": "quickserve",
    "check": "which quickserve",
    "install_steps": [
      "See https://github.com/haileys/quickserve",
      "Verify: quickserve --version",
      "supercli plugins install ./plugins/quickserve --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "quickserve",
      "resource": "self",
      "action": "version",
      "description": "Print quickserve version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quickserve",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install quickserve: See https://github.com/haileys/quickserve"
      },
      "args": []
    },
    {
      "namespace": "quickserve",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to quickserve CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "quickserve",
        "passthrough": true,
        "missingDependencyHelp": "Install quickserve"
      },
      "args": []
    }
  ]
}