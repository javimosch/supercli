{
  "name": "aa-remove-unknown",
  "version": "0.1.0",
  "description": "CLI tool: aa-remove-unknown",
  "source": "https://manpages.debian.org/aa-remove-unknown",
  "checks": [
    {
      "type": "binary",
      "name": "aa-remove-unknown"
    }
  ],
  "install_guidance": {
    "plugin": "aa-remove-unknown",
    "binary": "aa-remove-unknown",
    "check": "which aa-remove-unknown",
    "install_steps": [
      "apt-get install aa-remove-unknown 2>/dev/null || which aa-remove-unknown",
      "Verify: aa-remove-unknown --version",
      "supercli plugins install ./plugins/aa-remove-unknown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aa-remove-unknown",
      "resource": "self",
      "action": "version",
      "description": "Print aa-remove-unknown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aa-remove-unknown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aa-remove-unknown: apt-get install aa-remove-unknown 2>/dev/null || which aa-remove-unknown"
      },
      "args": []
    },
    {
      "namespace": "aa-remove-unknown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aa-remove-unknown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aa-remove-unknown",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install aa-remove-unknown: apt-get install aa-remove-unknown 2>/dev/null || which aa-remove-unknown"
      },
      "args": []
    }
  ]
}