{
  "name": "scrot",
  "version": "0.1.0",
  "description": "Screenshot capture utility",
  "source": "https://github.com/resurrecting-open-source-projects/scrot",
  "checks": [
    {
      "type": "binary",
      "name": "scrot"
    }
  ],
  "install_guidance": {
    "plugin": "scrot",
    "binary": "scrot",
    "check": "which scrot",
    "install_steps": [
      "brew install scrot",
      "Verify: scrot --version",
      "supercli plugins install ./plugins/scrot --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "scrot",
      "resource": "self",
      "action": "version",
      "description": "Print scrot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scrot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scrot: brew install scrot"
      },
      "args": []
    },
    {
      "namespace": "scrot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scrot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scrot",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install scrot: brew install scrot"
      },
      "args": []
    }
  ]
}
