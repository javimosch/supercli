{
  "name": "uniq",
  "version": "0.1.0",
  "description": "uniq — report or omit repeated lines from sorted input",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "uniq"
    }
  ],
  "install_guidance": {
    "plugin": "uniq",
    "binary": "uniq",
    "check": "which uniq",
    "install_steps": [
      "base system",
      "Verify: uniq --version 2>/dev/null || uniq --help",
      "supercli plugins install ./plugins/uniq --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uniq",
      "resource": "self",
      "action": "version",
      "description": "Print uniq version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uniq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uniq: base system"
      },
      "args": []
    },
    {
      "namespace": "uniq",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uniq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uniq",
        "passthrough": true,
        "missingDependencyHelp": "Install uniq: base system"
      },
      "args": []
    }
  ]
}
