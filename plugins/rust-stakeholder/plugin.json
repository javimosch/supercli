{
  "name": "rust-stakeholder",
  "version": "0.1.0",
  "description": "Generate impressive fake terminal output for demos",
  "source": "https://github.com/nicholasgasior/rust-stakeholder",
  "checks": [
    {
      "type": "binary",
      "name": "rust-stakeholder"
    }
  ],
  "install_guidance": {
    "plugin": "rust-stakeholder",
    "binary": "rust-stakeholder",
    "check": "which rust-stakeholder",
    "install_steps": [
      "cargo install rust-stakeholder",
      "Verify: rust-stakeholder --version",
      "supercli plugins install ./plugins/rust-stakeholder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rust-stakeholder",
      "resource": "self",
      "action": "version",
      "description": "Print rust-stakeholder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-stakeholder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rust-stakeholder: cargo install rust-stakeholder"
      },
      "args": []
    },
    {
      "namespace": "rust-stakeholder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rust-stakeholder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-stakeholder",
        "passthrough": true,
        "missingDependencyHelp": "Install rust-stakeholder: cargo install rust-stakeholder"
      },
      "args": []
    }
  ]
}
