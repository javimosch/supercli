{
  "plugin": "resize2fs",
  "binary": "resize2fs",
  "check": "which resize2fs",
  "install_steps": [
    "# Install resize2fs",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/resize2fs-linux-amd64 -o /usr/local/bin/resize2fs",
    "chmod +x /usr/local/bin/resize2fs",
    "# Or via package manager, see /usr/sbin/resize2fs"
  ]
}