{
  "name": "hf-mount",
  "version": "0.1.0",
  "description": "Mount Hugging Face Buckets and repos as local filesystems",
  "source": "https://github.com/huggingface/hf-mount",
  "checks": [
    {
      "type": "binary",
      "name": "hf-mount"
    }
  ],
  "install_guidance": {
    "plugin": "hf-mount",
    "binary": "hf-mount",
    "check": "which hf-mount",
    "install_steps": [
      "brew install hf-mount",
      "Verify: hf-mount --version",
      "supercli plugins install ./plugins/hf-mount --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hf-mount",
      "resource": "self",
      "action": "version",
      "description": "Print hf-mount version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hf-mount",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hf-mount: brew install hf-mount"
      },
      "args": []
    },
    {
      "namespace": "hf-mount",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hf-mount CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hf-mount",
        "passthrough": true,
        "missingDependencyHelp": "Install hf-mount"
      },
      "args": []
    }
  ]
}