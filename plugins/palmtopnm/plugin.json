{
  "name": "palmtopnm",
  "version": "0.1.0",
  "description": "CLI tool: palmtopnm",
  "source": "https://manpages.debian.org/palmtopnm",
  "checks": [
    {
      "type": "binary",
      "name": "palmtopnm"
    }
  ],
  "install_guidance": {
    "plugin": "palmtopnm",
    "binary": "palmtopnm",
    "check": "which palmtopnm",
    "install_steps": [
      "apt-get install palmtopnm 2>/dev/null || which palmtopnm",
      "Verify: palmtopnm --version",
      "supercli plugins install ./plugins/palmtopnm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "palmtopnm",
      "resource": "self",
      "action": "version",
      "description": "Print palmtopnm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "palmtopnm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install palmtopnm: apt-get install palmtopnm 2>/dev/null || which palmtopnm"
      },
      "args": []
    },
    {
      "namespace": "palmtopnm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to palmtopnm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "palmtopnm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install palmtopnm: apt-get install palmtopnm 2>/dev/null || which palmtopnm"
      },
      "args": []
    }
  ]
}