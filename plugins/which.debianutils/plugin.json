{
  "name": "which.debianutils",
  "version": "0.1.0",
  "description": "CLI tool: which.debianutils",
  "source": "https://manpages.debian.org/which.debianutils",
  "checks": [
    {
      "type": "binary",
      "name": "which.debianutils"
    }
  ],
  "install_guidance": {
    "plugin": "which.debianutils",
