      "adapter": "process",
      "adapterConfig": {
        "command": "which.debianutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install which.debianutils: apt-get install which.debianutils 2>/dev/null || which which.debianutils"
      },
      "args": []
    },
    {
      "namespace": "which.debianutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to which.debianutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "which.debianutils",
