{
  "name": "agency-agents-zh",
  "version": "0.1.0",
  "description": "\ud83c\udfad 211 \u4e2a\u5373\u63d2\u5373\u7528\u7684 AI \u4e13\u5bb6\u89d2\u8272 \u2014 \u652f\u6301 Hermes Agent/Claude Code/Cursor/Copilot \u7b49 16 \u79cd\u5de5\u5177\uff0c\u8986\u76d6\u5de5\u7a0b/\u8bbe\u8ba1/\u8425\u9500/\u91d1\u878d\u7b49 18 \u4e2a\u90e8\u95e8\u3002\u542b 4",
  "source": "https://github.com/agency-agents-zh/agency-agents-zh",
  "checks": [
    {
      "type": "binary",
      "name": "agency-agents-zh"
    }
  ],
  "install_guidance": {
    "plugin": "agency-agents-zh",
    "binary": "agency-agents-zh",
    "check": "which agency-agents-zh",
    "install_steps": [
      "pip install agency-agents-zh",
      "Verify: agency-agents-zh --version",
      "supercli plugins install ./plugins/agency-agents-zh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agency-agents-zh",
      "resource": "self",
      "action": "version",
      "description": "Print agency-agents-zh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agency-agents-zh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agency-agents-zh: pip install agency-agents-zh"
      },
      "args": []
    },
    {
      "namespace": "agency-agents-zh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agency-agents-zh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agency-agents-zh",
        "passthrough": true,
        "missingDependencyHelp": "Install agency-agents-zh: pip install agency-agents-zh"
      },
      "args": []
    }
  ]
}