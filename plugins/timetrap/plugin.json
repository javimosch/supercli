      "description": "Start tracking time on a sheet",
      "adapter": "process",
      "adapterConfig": {
        "command": "timetrap",
        "baseArgs": ["in"],
        "missingDependencyHelp": "Install timetrap: gem install timetrap",
        "passthrough": true
      },
      "args": [
        {
          "name": "sheet",
          "type": "string",
          "required": true,
          "description": "Sheet name to track time against"
        },
        {
          "name": "at",
          "type": "string",
          "required": false,
          "description": "Start time (e.g. '09:00', '1 hour ago')"
        },
        {
          "name": "note",
          "type": "string",
          "required": false,
          "description": "Note for this entry"
        }
      ]
    },
    {
      "namespace": "timetrap",
      "resource": "entry",
      "action": "out",
