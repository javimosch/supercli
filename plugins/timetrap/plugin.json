{
  "name": "timetrap",
  "version": "0.1.0",
  "description": "Simple command-line time tracker with sheet-based organization, reporting, and CSV/JSON export",
  "source": "https://github.com/samg/timetrap",
  "checks": [
    {
      "type": "binary",
      "name": "timetrap"
    }
