{
  "name": "prompt-optimizer",
  "version": "0.1.0",
  "description": "An AI prompt optimizer for writing better prompts and getting better AI results",
  "source": "https://github.com/linshenkx/prompt-optimizer",
  "checks": [
    {
      "type": "binary",
      "name": "prompt-optimizer"
    }
  ],
  "install_guidance": {
    "plugin": "prompt-optimizer",
    "binary": "prompt-optimizer",
    "check": "which prompt-optimizer",
    "install_steps": [
      "npm install -g prompt-optimizer",
      "Verify: prompt-optimizer --version",
      "supercli plugins install ./plugins/prompt-optimizer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "prompt-optimizer",
    "resource": "self",
    "action": "version",
    "description": "Print prompt-optimizer version",
    "adapter": "process",
    "adapterConfig": {
      "command": "prompt-optimizer",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install prompt-optimizer: npm install -g prompt-optimizer"
    },
    "args": []
  },
  {
    "namespace": "prompt-optimizer",
    "resource": "prompt",
    "action": "optimize",
    "description": "Optimize a prompt for better AI results",
    "adapter": "process",
    "adapterConfig": {
      "command": "prompt-optimizer",
      "passthrough": true,
      "missingDependencyHelp": "Install prompt-optimizer: npm install -g prompt-optimizer"
    },
    "args": []
  },
  {
    "namespace": "prompt-optimizer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to prompt-optimizer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "prompt-optimizer",
      "passthrough": true,
      "missingDependencyHelp": "Install prompt-optimizer"
    },
    "args": []
  }
]
}