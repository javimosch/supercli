{
  "name": "NavRL",
  "version": "0.1.0",
  "description": "[IEEE RA-L'25] NavRL: Learning Safe Flight in Dynamic Environments (NVIDIA Isaac/Python/ROS1/ROS2)",
  "source": "https://github.com/NavRL/NavRL",
  "checks": [
    {
      "type": "binary",
      "name": "navrl"
    }
  ],
  "install_guidance": {
    "plugin": "NavRL",
    "binary": "navrl",
    "check": "which navrl",
    "install_steps": [
      "pip install navrl",
      "Verify: navrl --version",
      "supercli plugins install ./plugins/NavRL --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NavRL",
      "resource": "self",
      "action": "version",
      "description": "Print NavRL version",
      "adapter": "process",
      "adapterConfig": {
        "command": "navrl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NavRL: pip install navrl"
      },
      "args": []
    },
    {
      "namespace": "NavRL",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to navrl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "navrl",
        "passthrough": true,
        "missingDependencyHelp": "Install NavRL: pip install navrl"
      },
      "args": []
    }
  ]
}