{
  "name": "mdatopbm",
  "version": "0.1.0",
  "description": "CLI tool: mdatopbm",
  "source": "https://manpages.debian.org/mdatopbm",
  "checks": [
    {
      "type": "binary",
      "name": "mdatopbm"
    }
  ],
  "install_guidance": {
    "plugin": "mdatopbm",
    "binary": "mdatopbm",
    "check": "which mdatopbm",
    "install_steps": [
      "apt-get install mdatopbm 2>/dev/null || which mdatopbm",
      "Verify: mdatopbm --version",
      "supercli plugins install ./plugins/mdatopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mdatopbm",
      "resource": "self",
      "action": "version",
      "description": "Print mdatopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdatopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mdatopbm: apt-get install mdatopbm 2>/dev/null || which mdatopbm"
      },
      "args": []
    },
    {
      "namespace": "mdatopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mdatopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdatopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mdatopbm: apt-get install mdatopbm 2>/dev/null || which mdatopbm"
      },
      "args": []
    }
  ]
}