{
  "name": "ladder",
  "version": "0.1.0",
  "description": "Selfhosted alternative to 12ft.io. and 1ft.io. Proxy to remove CORS headers and modify HTML",
  "source": "https://github.com/ladder/ladder",
  "checks": [
    {
      "type": "binary",
      "name": "ladder"
    }
  ],
  "install_guidance": {
    "plugin": "ladder",
    "binary": "ladder",
    "check": "which ladder",
    "install_steps": [
      "pip install ladder",
      "Verify: ladder --version",
      "supercli plugins install ./plugins/ladder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ladder",
      "resource": "self",
      "action": "version",
      "description": "Print ladder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ladder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ladder: pip install ladder"
      },
      "args": []
    },
    {
      "namespace": "ladder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ladder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ladder",
        "passthrough": true,
        "missingDependencyHelp": "Install ladder: pip install ladder"
      },
      "args": []
    }
  ]
}