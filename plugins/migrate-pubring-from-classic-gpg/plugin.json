{
  "name": "migrate-pubring-from-classic-gpg",
  "version": "0.1.0",
  "description": "CLI tool: migrate-pubring-from-classic-gpg",
  "source": "https://manpages.debian.org/migrate-pubring-from-classic-gpg",
  "checks": [
    {
      "type": "binary",
      "name": "migrate-pubring-from-classic-gpg"
    }
  ],
  "install_guidance": {
    "plugin": "migrate-pubring-from-classic-gpg",
    "binary": "migrate-pubring-from-classic-gpg",
    "check": "which migrate-pubring-from-classic-gpg",
    "install_steps": [
      "apt-get install migrate-pubring-from-classic-gpg 2>/dev/null || which migrate-pubring-from-classic-gpg",
      "Verify: migrate-pubring-from-classic-gpg --version",
      "supercli plugins install ./plugins/migrate-pubring-from-classic-gpg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "migrate-pubring-from-classic-gpg",
      "resource": "self",
      "action": "version",
      "description": "Print migrate-pubring-from-classic-gpg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "migrate-pubring-from-classic-gpg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install migrate-pubring-from-classic-gpg: apt-get install migrate-pubring-from-classic-gpg 2>/dev/null || which migrate-pubring-from-classic-gpg"
      },
      "args": []
    },
    {
      "namespace": "migrate-pubring-from-classic-gpg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to migrate-pubring-from-classic-gpg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "migrate-pubring-from-classic-gpg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install migrate-pubring-from-classic-gpg: apt-get install migrate-pubring-from-classic-gpg 2>/dev/null || which migrate-pubring-from-classic-gpg"
      },
      "args": []
    }
  ]
}