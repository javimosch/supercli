{
  "name": "susfs4ksu-module",
  "version": "0.1.0",
  "description": "An addon root hiding service for KernelSU",
  "source": "https://github.com/susfs4ksu-module/susfs4ksu-module",
  "checks": [
    {
      "type": "binary",
      "name": "susfs4ksu-module"
    }
  ],
  "install_guidance": {
    "plugin": "susfs4ksu-module",
    "binary": "susfs4ksu-module",
    "check": "which susfs4ksu-module",
    "install_steps": [
      "pip install susfs4ksu-module",
      "Verify: susfs4ksu-module --version",
      "supercli plugins install ./plugins/susfs4ksu-module --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "susfs4ksu-module",
      "resource": "self",
      "action": "version",
      "description": "Print susfs4ksu-module version",
      "adapter": "process",
      "adapterConfig": {
        "command": "susfs4ksu-module",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install susfs4ksu-module: pip install susfs4ksu-module"
      },
      "args": []
    },
    {
      "namespace": "susfs4ksu-module",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to susfs4ksu-module CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "susfs4ksu-module",
        "passthrough": true,
        "missingDependencyHelp": "Install susfs4ksu-module: pip install susfs4ksu-module"
      },
      "args": []
    }
  ]
}