{
  "name": "macvendors",
  "version": "0.1.0",
  "description": "macvendors \u2014 lookup MAC address vendor information.",
  "source": "https://github.com/macvendors/macvendors-cli",
  "checks": [
    {
      "type": "binary",
      "name": "macvendors"
    }
  ],
  "install_guidance": {
    "plugin": "macvendors",
    "binary": "macvendors",
    "check": "which macvendors",
    "install_steps": [
      "npm install -g macvendors",
      "supercli plugins install ./plugins/macvendors --on-conflict replace --json"
    ],
    "note": "Node.js. MAC address vendor lookup."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "macvendors",
      "resource": "mac",
      "action": "lookup",
      "description": "Lookup MAC address vendor",
      "adapter": "process",
      "adapterConfig": {
        "command": "macvendors",
        "missingDependencyHelp": "Install macvendors",
        "positionalArgs": [
          "mac"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "mac",
          "type": "string",
          "required": true,
          "description": "mac path"
        }
      ]
    },
    {
      "namespace": "macvendors",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "macvendors",
        "missingDependencyHelp": "Install macvendors",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
