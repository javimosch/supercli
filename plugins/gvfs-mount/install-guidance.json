{
  "plugin": "gvfs-mount",
  "binary": "gvfs-mount",
  "check": "which gvfs-mount",
  "install_steps": [
    "apt-get install gvfs-mount 2>/dev/null || which gvfs-mount",
    "Verify: gvfs-mount --version",
    "supercli plugins install ./plugins/gvfs-mount --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}