{
  "name": "cloudiscovery",
  "version": "0.1.0",
  "description": "Help you discover resources in the cloud environment",
  "source": "https://github.com/Cloud-Architects/cloudiscovery",
  "checks": [
    {
      "type": "binary",
      "name": "cloudiscovery"
    }
  ],
  "install_guidance": {
    "plugin": "cloudiscovery",
    "binary": "cloudiscovery",
    "check": "which cloudiscovery",
    "install_steps": [
      "brew install cloudiscovery",
      "Verify: cloudiscovery --version",
      "supercli plugins install ./plugins/cloudiscovery --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cloudiscovery",
      "resource": "self",
      "action": "version",
      "description": "Print cloudiscovery version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudiscovery",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cloudiscovery: brew install cloudiscovery"
      },
      "args": []
    },
    {
      "namespace": "cloudiscovery",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cloudiscovery CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudiscovery",
        "passthrough": true,
        "missingDependencyHelp": "Install cloudiscovery"
      },
      "args": []
    }
  ]
}