{
  "name": "java-sdk",
  "version": "0.1.0",
  "description": "The official Java SDK for Model Context Protocol servers and clients. Maintained in collaboration wi",
  "source": "https://github.com/java-sdk/java-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "java-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "java-sdk",
    "binary": "java-sdk",
    "check": "which java-sdk",
    "install_steps": [
      "pip install java-sdk",
      "Verify: java-sdk --version",
      "supercli plugins install ./plugins/java-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "java-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print java-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "java-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install java-sdk: pip install java-sdk"
      },
      "args": []
    },
    {
      "namespace": "java-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to java-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "java-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install java-sdk: pip install java-sdk"
      },
      "args": []
    }
  ]
}