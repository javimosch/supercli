{
  "name": "libusrsctp",
  "version": "0.1.0",
  "description": "Portable SCTP userland stack",
  "source": "https://github.com/sctplab/usrsctp",
  "checks": [
    {
      "type": "binary",
      "name": "libusrsctp"
    }
  ],
  "install_guidance": {
    "plugin": "libusrsctp",
    "binary": "libusrsctp",
    "check": "which libusrsctp",
    "install_steps": [
      "brew install libusrsctp",
      "Verify: libusrsctp --version",
      "supercli plugins install ./plugins/libusrsctp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libusrsctp",
      "resource": "self",
      "action": "version",
      "description": "Print libusrsctp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libusrsctp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libusrsctp: brew install libusrsctp"
      },
      "args": []
    },
    {
      "namespace": "libusrsctp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libusrsctp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libusrsctp",
        "passthrough": true,
        "missingDependencyHelp": "Install libusrsctp"
      },
      "args": []
    }
  ]
}