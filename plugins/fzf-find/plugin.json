{
  "name": "fzf-find",
  "version": "0.1.0",
  "description": "Wrapper for finding files with FZF selector interface",
  "source": "https://github.com/sxyazi/fzf-find",
  "checks": [{ "type": "binary", "name": "fzf-find" }],
  "install_guidance": {
    "plugin": "fzf-find",
    "binary": "fzf-find",
    "check": "which fzf-find",
    "install_steps": ["brew install fzf-find", "Verify: fzf-find --version", "supercli plugins install ./plugins/fzf-find --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fzf-find",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fzf-find CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fzf-find",
      "passthrough": true,
      "missingDependencyHelp": "Install fzf-find: brew install fzf-find", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
