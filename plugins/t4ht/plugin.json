{
  "name": "t4ht",
  "version": "0.1.0",
  "description": "CLI tool: t4ht",
  "source": "https://manpages.debian.org/t4ht",
  "checks": [
    {
      "type": "binary",
      "name": "t4ht"
    }
  ],
  "install_guidance": {
    "plugin": "t4ht",
    "binary": "t4ht",
    "check": "which t4ht",
    "install_steps": [
      "apt-get install t4ht 2>/dev/null || which t4ht",
      "Verify: t4ht --version",
      "supercli plugins install ./plugins/t4ht --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "t4ht",
      "resource": "self",
      "action": "version",
      "description": "Print t4ht version",
      "adapter": "process",
      "adapterConfig": {
        "command": "t4ht",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install t4ht: apt-get install t4ht 2>/dev/null || which t4ht"
      },
      "args": []
    },
    {
      "namespace": "t4ht",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to t4ht CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "t4ht",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install t4ht: apt-get install t4ht 2>/dev/null || which t4ht"
      },
      "args": []
    }
  ]
}