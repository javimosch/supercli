{
  "name": "arm2hpdl",
  "version": "0.1.0",
  "description": "arm2hpdl — printer driver for ZjStream-based printers",
  "source": "http://foo2zjs.rkkda.com/",
  "checks": [{ "type": "binary", "name": "arm2hpdl" }],
  "install_guidance": {
    "plugin": "arm2hpdl", "binary": "arm2hpdl", "check": "which arm2hpdl",
    "install_steps": ["apt-get install printer-driver-foo2zjs 2>/dev/null || which arm2hpdl", "Verify: arm2hpdl --version", "supercli plugins install ./plugins/arm2hpdl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "arm2hpdl", "resource": "_", "action": "_",
    "description": "Passthrough to arm2hpdl CLI",
    "adapter": "process", "adapterConfig": { "command": "arm2hpdl", "passthrough": true, "missingDependencyHelp": "Install arm2hpdl: apt-get install arm2hpdl" }, "args": []
  }]
}
