  "commands": [{
    "namespace": "arm2hpdl", "resource": "_", "action": "_",
    "description": "Passthrough to arm2hpdl CLI",
    "adapter": "process", "adapterConfig": { "command": "arm2hpdl", "passthrough": true, "missingDependencyHelp": "Install arm2hpdl: apt-get install arm2hpdl" }, "args": []
  }]
}
