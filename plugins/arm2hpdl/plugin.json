{
  "name": "arm2hpdl",
  "version": "0.1.0",
  "description": "CLI tool: arm2hpdl",
  "source": "https://packages.debian.org/arm2hpdl",
  "checks": [{ "type": "binary", "name": "arm2hpdl" }],
  "install_guidance": {
    "plugin": "arm2hpdl", "binary": "arm2hpdl", "check": "which arm2hpdl",
    "install_steps": ["apt-get install arm2hpdl 2>/dev/null || which arm2hpdl", "Verify: arm2hpdl --version", "supercli plugins install ./plugins/arm2hpdl --on-conflict replace --json"]
