{
  "name": "pyrsa-decrypt",
  "version": "0.1.0",
  "description": "CLI tool: pyrsa-decrypt",
  "source": "https://manpages.debian.org/pyrsa-decrypt",
  "checks": [
    {
      "type": "binary",
      "name": "pyrsa-decrypt"
    }
  ],
  "install_guidance": {
    "plugin": "pyrsa-decrypt",
    "binary": "pyrsa-decrypt",
    "check": "which pyrsa-decrypt",
    "install_steps": [
      "apt-get install pyrsa-decrypt 2>/dev/null || which pyrsa-decrypt",
      "Verify: pyrsa-decrypt --version",
      "supercli plugins install ./plugins/pyrsa-decrypt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyrsa-decrypt",
      "resource": "self",
      "action": "version",
      "description": "Print pyrsa-decrypt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrsa-decrypt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyrsa-decrypt: apt-get install pyrsa-decrypt 2>/dev/null || which pyrsa-decrypt"
      },
      "args": []
    },
    {
      "namespace": "pyrsa-decrypt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyrsa-decrypt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrsa-decrypt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyrsa-decrypt: apt-get install pyrsa-decrypt 2>/dev/null || which pyrsa-decrypt"
      },
      "args": []
    }
  ]
}