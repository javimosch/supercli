{
  "name": "textlint-rule-preset",
  "version": "0.1.0",
  "description": "Preset of textlint rules for technical writing",
  "source": "https://github.com/textlint-ja/textlint-rule-preset-ja-technical-writing",
  "checks": [{ "type": "binary", "name": "textlint-rule-preset" }],
  "install_guidance": {
    "plugin": "textlint-rule-preset",
    "binary": "textlint-rule-preset",
    "check": "which textlint-rule-preset",
    "install_steps": ["npm install -g textlint-rule-preset-ja-technical-writing", "Verify: textlint-rule-preset --version", "supercli plugins install ./plugins/textlint-rule-preset --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "textlint-rule-preset",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to textlint-rule-preset CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "textlint-rule-preset",
      "passthrough": true,
      "missingDependencyHelp": "Install textlint-rule-preset: npm install -g textlint-rule-preset-ja-technical-writing", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
