{
  "name": "sherif",
  "version": "0.1.0",
  "description": "Opinionated monorepo linter",
  "source": "https://github.com/QuiiBz/sherif",
  "checks": [
    {
      "type": "binary",
      "name": "sherif"
    }
  ],
  "install_guidance": {
    "plugin": "sherif",
    "binary": "sherif",
    "check": "which sherif",
    "install_steps": [
      "npm install -g sherif",
      "Verify: sherif --version",
      "supercli plugins install ./plugins/sherif --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "sherif",
      "resource": "self",
      "action": "version",
      "description": "Print sherif version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sherif",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sherif: npm install -g sherif"
      },
      "args": []
    },
    {
      "namespace": "sherif",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sherif CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sherif",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sherif: npm install -g sherif"
      },
      "args": []
    }
  ]
}
