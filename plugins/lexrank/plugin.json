{
  "name": "lexrank",
  "version": "0.1.0",
  "description": "Extractive text summarization using LexRank",
  "source": "https://github.com/crabcamp/lexrank",
  "checks": [{ "type": "binary", "name": "lexrank" }],
  "install_guidance": {
    "plugin": "lexrank",
    "binary": "lexrank",
    "check": "which lexrank",
    "install_steps": ["pip install lexrank", "Verify: lexrank --version", "supercli plugins install ./plugins/lexrank --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lexrank",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lexrank CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lexrank",
      "passthrough": true,
      "missingDependencyHelp": "Install lexrank: pip install lexrank", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
