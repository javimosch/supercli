{
  "name": "epub-wordcount",
  "version": "0.1.0",
  "description": "Quick word count utility for EPUB files",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "epub-wordcount" }],
  "install_guidance": {
    "plugin": "epub-wordcount",
    "binary": "epub-wordcount",
    "check": "which epub-wordcount",
    "install_steps": ["npm install -g epub-wordcount", "Verify: epub-wordcount --version", "supercli plugins install ./plugins/epub-wordcount --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epub-wordcount",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epub-wordcount CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epub-wordcount",
      "passthrough": true,
      "missingDependencyHelp": "Install epub-wordcount: npm install -g epub-wordcount"
    },
    "args": []
  }]
}
