{
  "name": "apport-bug",
  "version": "0.1.0",
  "description": "CLI tool: apport-bug",
  "source": "https://packages.debian.org/apport-bug",
  "checks": [{ "type": "binary", "name": "apport-bug" }],
  "install_guidance": {
    "plugin": "apport-bug", "binary": "apport-bug", "check": "which apport-bug",
    "install_steps": ["apt-get install apport-bug 2>/dev/null || which apport-bug", "Verify: apport-bug --version", "supercli plugins install ./plugins/apport-bug --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apport-bug", "resource": "_", "action": "_",
    "description": "Passthrough to apport-bug CLI",
    "adapter": "process", "adapterConfig": { "command": "apport-bug", "passthrough": true, "missingDependencyHelp": "Install apport-bug: apt-get install apport-bug" }, "args": []
  }]
}
