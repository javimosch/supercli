{
  "name": "dirname",
  "version": "0.1.0",
  "description": "dirname — Strip filename from path",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "dirname"
    }
  ],
  "install_guidance": {
    "plugin": "dirname",
    "binary": "dirname",
    "check": "which dirname",
    "install_steps": [
      "base system",
      "Verify: dirname --version 2>/dev/null || dirname --help",
      "supercli plugins install ./plugins/dirname --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dirname",
      "resource": "self",
      "action": "version",
      "description": "Print dirname version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dirname",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dirname: base system"
      },
      "args": []
    },
    {
      "namespace": "dirname",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dirname CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dirname",
        "passthrough": true,
        "missingDependencyHelp": "Install dirname: base system"
      },
      "args": []
    }
  ]
}
