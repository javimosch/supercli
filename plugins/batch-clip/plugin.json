{
  "name": "batch-clip",
  "version": "0.1.0",
  "description": "基于JavaScript的批量图片裁剪插件，支持功能：图片裁剪、批量图片载入、文件（File）加载、远程资源加载（URL）、图片缩放、原图载入。钩子函数：图片加载失败、程序中断、裁剪完毕。",
  "source": "https://github.com/batch-clip/batch-clip",
  "checks": [
    {
      "type": "binary",
      "name": "batch-clip"
    }
  ],
  "install_guidance": {
    "plugin": "batch-clip",
    "binary": "batch-clip",
    "check": "which batch-clip",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: batch-clip --version",
      "supercli plugins install ./plugins/batch-clip --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "batch-clip",
      "resource": "self",
      "action": "version",
      "description": "Print batch-clip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "batch-clip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install batch-clip from project repository"
      },
      "args": []
    },
    {
      "namespace": "batch-clip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to batch-clip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "batch-clip",
        "passthrough": true,
        "missingDependencyHelp": "Install batch-clip from project repository"
      },
      "args": []
    }
  ]
}