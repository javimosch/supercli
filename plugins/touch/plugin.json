{
  "name": "touch",
  "version": "0.1.0",
  "description": "touch — create empty files and modify file timestamps",
  "source": "https://www.gnu.org/software/coreutils/touch",
  "checks": [
    {
      "type": "binary",
      "name": "touch"
    }
  ],
  "commands": [
    {
      "namespace": "touch",
      "resource": "file",
      "action": "create",
      "description": "Create an empty file or update its timestamp",
      "adapter": "process",
      "adapterConfig": {
        "command": "touch",
        "baseArgs": [],
        "parseJson": false,
        "missingDependencyHelp": "touch is part of GNU coreutils, install: brew install coreutils"
      },
      "args": [
        {
          "name": "files",
          "type": "string",
          "description": "File(s) to create or update",
          "required": true,
          "positional": true
        }
      ]
    },
    {
      "namespace": "touch",
      "resource": "file",
      "action": "set-timestamp",
      "description": "Set a specific timestamp on a file (-t)",
      "adapter": "process",
      "adapterConfig": {
        "command": "touch",
        "baseArgs": [],
        "parseJson": false,
        "missingDependencyHelp": "touch is part of GNU coreutils, install: brew install coreutils"
      },
      "args": [
        {
          "name": "timestamp",
          "type": "string",
          "description": "Timestamp in [[CC]YY]MMDDhhmm[.ss] format",
          "required": true,
          "flag": "-t"
        },
        {
          "name": "files",
          "type": "string",
          "description": "File(s) to update",
          "required": true,
          "positional": true
        }
      ]
    },
    {
      "namespace": "touch",
      "resource": "file",
      "action": "set-date",
      "description": "Use a reference file's timestamp (-r)",
      "adapter": "process",
      "adapterConfig": {
        "command": "touch",
        "baseArgs": [],
        "parseJson": false,
        "missingDependencyHelp": "touch is part of GNU coreutils, install: brew install coreutils"
      },
      "args": [
        {
          "name": "reference",
          "type": "string",
          "description": "Reference file to copy timestamp from",
          "required": true,
          "flag": "-r"
        },
        {
          "name": "files",
          "type": "string",
          "description": "File(s) to update",
          "required": true,
          "positional": true
        }
      ]
    },
    {
      "namespace": "touch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to touch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "touch",
        "passthrough": true,
        "missingDependencyHelp": "touch is part of GNU coreutils, install: brew install coreutils"
      },
      "args": []
    }
  ]
}
