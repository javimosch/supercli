{
  "name": "jsonxf",
  "version": "0.1.0",
  "description": "Fast JSON pretty-printer and minifier",
  "source": "https://github.com/gamache/jsonxf",
  "checks": [{ "type": "binary", "name": "jsonxf" }],
  "install_guidance": {
    "plugin": "jsonxf",
    "binary": "jsonxf",
    "check": "which jsonxf",
    "install_steps": ["cargo install jsonxf", "Verify: jsonxf --version", "supercli plugins install ./plugins/jsonxf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jsonxf",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jsonxf CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jsonxf",
      "passthrough": true,
      "missingDependencyHelp": "Install jsonxf: cargo install jsonxf", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
