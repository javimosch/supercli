{
  "name": "nikto",
  "version": "0.1.0",
  "description": "Web server scanner for vulnerabilities",
  "source": "https",
  "checks": [{"type": "binary", "name": "nikto"}],
  "install_guidance": {
    "plugin": "nikto",
    "binary": "nikto",
    "check": "which nikto",
    "install_steps": [
      "brew install nikto",
      "Verify: nikto --version",
      "supercli plugins install ./plugins/nikto --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "nikto",
      "resource": "self",
      "action": "version",
      "description": "Print nikto version",
      "adapter": "process",
      "adapterConfig": {"command": "nikto", "baseArgs": ["--version"], "missingDependencyHelp": "Install nikto: brew install nikto"},
      "args": []
    },
    {
      "namespace": "nikto",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nikto CLI",
      "adapter": "process",
      "adapterConfig": {"command": "nikto", "passthrough": true, "missingDependencyHelp": "Install nikto: brew install nikto"},
      "args": []
    }
  ]
}
