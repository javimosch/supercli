{
  "name": "kubebench",
  "version": "0.1.0",
  "description": "Checks if Kubernetes is deployed securely per CIS benchmarks",
  "source": "https://github.com/aquasecurity/kube-bench",
  "checks": [{ "type": "binary", "name": "kubebench" }],
  "install_guidance": {
    "plugin": "kubebench",
    "binary": "kubebench",
    "check": "which kubebench",
    "install_steps": ["brew install kube-bench", "Verify: kubebench --version", "supercli plugins install ./plugins/kubebench --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubebench",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubebench CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubebench",
      "passthrough": true,
      "missingDependencyHelp": "Install kubebench: brew install kube-bench"
    },
    "args": []
  }]
}
