{
  "plugin": "pod2html",
  "binary": "pod2html",
  "check": "which pod2html",
  "install_steps": [
    "# Install pod2html",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pod2html-linux-amd64 -o /usr/local/bin/pod2html",
    "chmod +x /usr/local/bin/pod2html",
    "# Or via package manager, see /usr/bin/pod2html"
  ]
}