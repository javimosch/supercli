{
  "name": "pod2html",
  "version": "1.0.0",
  "description": "pod2html \u2014 pod2html \u2014 CLI utility",
  "source": "/usr/bin/pod2html",
  "checks": [
    {
      "type": "binary",
      "name": "pod2html"
    }
  ],
  "install_guidance": {
    "plugin": "pod2html",
    "binary": "pod2html",
    "check": "which pod2html",
    "install_steps": [
      "# Install pod2html:",
      "# apt: sudo apt-get install pod2html",
      "# brew: brew install pod2html",
      "# cargo: cargo install pod2html",
      "# npm: npm install -g pod2html",
      "# pip: pip install pod2html",
      "# or download from /usr/bin/pod2html"
    ]
  },
  "commands": [
    {
      "namespace": "pod2html",
      "resource": "pod2html",
      "action": "run",
      "description": "Run pod2html",
      "adapter": "process",
      "adapterConfig": {
        "command": "pod2html",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pod2html from /usr/bin/pod2html"
      },
      "args": []
    }
  ]
}