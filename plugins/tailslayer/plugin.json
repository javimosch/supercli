{
  "name": "tailslayer",
  "version": "0.1.0",
  "description": "Library for reducing tail latency in RAM reads",
  "source": "https://github.com/tailslayer/tailslayer",
  "checks": [
    {
      "type": "binary",
      "name": "tailslayer"
    }
  ],
  "install_guidance": {
    "plugin": "tailslayer",
    "binary": "tailslayer",
    "check": "which tailslayer",
    "install_steps": [
      "pip install tailslayer",
      "Verify: tailslayer --version",
      "supercli plugins install ./plugins/tailslayer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tailslayer",
      "resource": "self",
      "action": "version",
      "description": "Print tailslayer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tailslayer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tailslayer: pip install tailslayer"
      },
      "args": []
    },
    {
      "namespace": "tailslayer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tailslayer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tailslayer",
        "passthrough": true,
        "missingDependencyHelp": "Install tailslayer: pip install tailslayer"
      },
      "args": []
    }
  ]
}