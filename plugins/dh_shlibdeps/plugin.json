  "commands": [{
    "namespace": "dh_shlibdeps", "resource": "_", "action": "_",
    "description": "Passthrough to dh_shlibdeps CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_shlibdeps", "passthrough": true, "missingDependencyHelp": "Install dh_shlibdeps: apt-get install dh_shlibdeps" }, "args": []
  }]
}
