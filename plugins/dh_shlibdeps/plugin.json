{
  "name": "dh_shlibdeps",
  "version": "0.1.0",
  "description": "CLI tool: dh_shlibdeps",
  "source": "https://packages.debian.org/dh_shlibdeps",
  "checks": [{ "type": "binary", "name": "dh_shlibdeps" }],
  "install_guidance": {
    "plugin": "dh_shlibdeps", "binary": "dh_shlibdeps", "check": "which dh_shlibdeps",
    "install_steps": ["apt-get install dh_shlibdeps 2>/dev/null || which dh_shlibdeps", "Verify: dh_shlibdeps --version", "supercli plugins install ./plugins/dh_shlibdeps --on-conflict replace --json"]
