{
  "name": "pinentry-x11",
  "version": "0.1.0",
  "description": "CLI tool: pinentry-x11",
  "source": "https://manpages.debian.org/pinentry-x11",
  "checks": [
    {
      "type": "binary",
      "name": "pinentry-x11"
    }
  ],
  "install_guidance": {
    "plugin": "pinentry-x11",
    "binary": "pinentry-x11",
    "check": "which pinentry-x11",
    "install_steps": [
      "apt-get install pinentry-x11 2>/dev/null || which pinentry-x11",
      "Verify: pinentry-x11 --version",
      "supercli plugins install ./plugins/pinentry-x11 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pinentry-x11",
      "resource": "self",
      "action": "version",
      "description": "Print pinentry-x11 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pinentry-x11",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pinentry-x11: apt-get install pinentry-x11 2>/dev/null || which pinentry-x11"
      },
      "args": []
    },
    {
      "namespace": "pinentry-x11",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pinentry-x11 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pinentry-x11",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pinentry-x11: apt-get install pinentry-x11 2>/dev/null || which pinentry-x11"
      },
      "args": []
    }
  ]
}