{
  "name": "poetry2setup",
  "version": "0.1.0",
  "description": "Convert Poetry pyproject toml to setup py",
  "source": "https://github.com/abersheeran/poetry2setup",
  "checks": [{ "type": "binary", "name": "poetry2setup" }],
  "install_guidance": {
    "plugin": "poetry2setup",
    "binary": "poetry2setup",
    "check": "which poetry2setup",
    "install_steps": ["pip install poetry2setup", "Verify: poetry2setup --version", "supercli plugins install ./plugins/poetry2setup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "poetry2setup",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to poetry2setup CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "poetry2setup",
      "passthrough": true,
      "missingDependencyHelp": "Install poetry2setup: pip install poetry2setup", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
