{
  "name": "pbcopy",
  "version": "1.0.0",
  "description": "pbcopy \u2014 Clipboard copy (macOS/Linux)",
  "source": "github.com/skottok/shortcut",
  "checks": [
    {
      "type": "binary",
      "name": "pbcopy"
    }
  ],
  "install_guidance": {
    "plugin": "pbcopy",
    "binary": "pbcopy",
    "check": "which pbcopy",
    "install_steps": [
      "# Install pbcopy:",
      "# apt: sudo apt-get install pbcopy",
      "# brew: brew install pbcopy",
      "# cargo: cargo install pbcopy",
      "# npm: npm install -g pbcopy",
      "# pip: pip install pbcopy",
      "# or download from github.com/skottok/shortcut"
    ]
  },
  "commands": [
    {
      "namespace": "pbcopy",
      "resource": "pbcopy",
      "action": "run",
      "description": "Run pbcopy",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbcopy",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pbcopy from github.com/skottok/shortcut"
      },
      "args": []
    }
  ]
}