{
  "name": "slxdecode",
  "version": "0.1.0",
  "description": "CLI tool: slxdecode",
  "source": "https://manpages.debian.org/slxdecode",
  "checks": [
    {
      "type": "binary",
      "name": "slxdecode"
    }
  ],
  "install_guidance": {
    "plugin": "slxdecode",
    "binary": "slxdecode",
    "check": "which slxdecode",
    "install_steps": [
      "apt-get install slxdecode 2>/dev/null || which slxdecode",
      "Verify: slxdecode --version",
      "supercli plugins install ./plugins/slxdecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "slxdecode",
      "resource": "self",
      "action": "version",
      "description": "Print slxdecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "slxdecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install slxdecode: apt-get install slxdecode 2>/dev/null || which slxdecode"
      },
      "args": []
    },
    {
      "namespace": "slxdecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to slxdecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "slxdecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install slxdecode: apt-get install slxdecode 2>/dev/null || which slxdecode"
      },
      "args": []
    }
  ]
}