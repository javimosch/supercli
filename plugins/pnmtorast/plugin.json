{
  "name": "pnmtorast",
  "version": "0.1.0",
  "description": "CLI tool: pnmtorast",
  "source": "https://manpages.debian.org/pnmtorast",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtorast"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtorast",
    "binary": "pnmtorast",
    "check": "which pnmtorast",
    "install_steps": [
      "apt-get install pnmtorast 2>/dev/null || which pnmtorast",
      "Verify: pnmtorast --version",
      "supercli plugins install ./plugins/pnmtorast --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtorast",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtorast version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtorast",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtorast: apt-get install pnmtorast 2>/dev/null || which pnmtorast"
      },
      "args": []
    },
    {
      "namespace": "pnmtorast",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtorast CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtorast",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtorast: apt-get install pnmtorast 2>/dev/null || which pnmtorast"
      },
      "args": []
    }
  ]
}