{
  "name": "mailcoach-cli",
  "version": "0.1.0",
  "description": "Email campaigns and transactional email management from the terminal via Mailcoach.",
  "source": "https://mailcoach.app",
  "checks": [
    { "type": "binary", "name": "mailcoach" }
  ],
  "install_guidance": {
    "plugin": "mailcoach-cli",
    "binary": "mailcoach",
    "check": "which mailcoach",
    "install_steps": [
      "npm i -g @mailcoach/cli",
      "Verify: mailcoach --version",
      "supercli plugins install ./plugins/mailcoach-cli --on-conflict replace --json"
    ],
    "note": "Requires MAILCOACH_API_KEY env var. Get key at https://mailcoach.app"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mailcoach-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mailcoach CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mailcoach",
        "passthrough": true,
        "missingDependencyHelp": "Install mailcoach: npm i -g @mailcoach/cli"
      },
      "args": []
    }
  ]
}
