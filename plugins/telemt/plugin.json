{
  "name": "telemt",
  "version": "0.1.0",
  "description": "MTProxy for Telegram on Rust + Tokio",
  "source": "https://github.com/telemt/telemt",
  "checks": [
    {
      "type": "binary",
      "name": "telemt"
    }
  ],
  "install_guidance": {
    "plugin": "telemt",
    "binary": "telemt",
    "check": "which telemt",
    "install_steps": [
      "pip install telemt",
      "Verify: telemt --version",
      "supercli plugins install ./plugins/telemt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "telemt",
      "resource": "self",
      "action": "version",
      "description": "Print telemt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "telemt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install telemt: pip install telemt"
      },
      "args": []
    },
    {
      "namespace": "telemt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to telemt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "telemt",
        "passthrough": true,
        "missingDependencyHelp": "Install telemt: pip install telemt"
      },
      "args": []
    }
  ]
}