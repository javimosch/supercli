{
  "name": "profiles",
  "version": "0.1.0",
  "description": "Manage and apply Kubernetes cluster profiles",
  "source": "https://github.com/weaveworks/profiles",
  "checks": [{ "type": "binary", "name": "profiles-cli" }],
  "install_guidance": {
    "plugin": "profiles",
    "binary": "profiles-cli",
    "check": "which profiles-cli",
    "install_steps": ["brew install profiles-cli", "Verify: profiles-cli --version", "supercli plugins install ./plugins/profiles --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "profiles",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to profiles-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "profiles-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install profiles: brew install profiles-cli"
    },
    "args": []
  }]
}
