{
  "name": "xlsatoms",
  "version": "0.1.0",
  "description": "CLI tool: xlsatoms",
  "source": "https://manpages.debian.org/xlsatoms",
  "checks": [
    {
      "type": "binary",
      "name": "xlsatoms"
    }
  ],
  "install_guidance": {
    "plugin": "xlsatoms",
    "binary": "xlsatoms",
    "check": "which xlsatoms",
    "install_steps": [
      "apt-get install xlsatoms 2>/dev/null || which xlsatoms",
      "Verify: xlsatoms --version",
      "supercli plugins install ./plugins/xlsatoms --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xlsatoms",
      "resource": "self",
      "action": "version",
      "description": "Print xlsatoms version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xlsatoms",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xlsatoms: apt-get install xlsatoms 2>/dev/null || which xlsatoms"
      },
      "args": []
    },
    {
      "namespace": "xlsatoms",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xlsatoms CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xlsatoms",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xlsatoms: apt-get install xlsatoms 2>/dev/null || which xlsatoms"
      },
      "args": []
    }
  ]
}