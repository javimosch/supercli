{
  "name": "amp",
  "version": "0.1.0",
  "description": "Complete text editor for your terminal",
  "source": "https://github.com/jmacdonald/amp",
  "checks": [{ "type": "binary", "name": "amp" }],
  "install_guidance": {
    "plugin": "amp",
    "binary": "amp",
    "check": "which amp",
    "install_steps": ["cargo install amp", "Verify: amp --version", "supercli plugins install ./plugins/amp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "amp",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to amp CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "amp",
      "passthrough": true,
      "missingDependencyHelp": "Install amp: cargo install amp", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
