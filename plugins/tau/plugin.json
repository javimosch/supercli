{
  "name": "tau",
  "version": "0.1.0",
  "description": "Fullstack Workspace for Humans & Machines",
  "source": "https://github.com/tau/tau",
  "checks": [
    {
      "type": "binary",
      "name": "tau"
    }
  ],
  "install_guidance": {
    "plugin": "tau",
    "binary": "tau",
    "check": "which tau",
    "install_steps": [
      "pip install tau",
      "Verify: tau --version",
      "supercli plugins install ./plugins/tau --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tau",
      "resource": "self",
      "action": "version",
      "description": "Print tau version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tau",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tau: pip install tau"
      },
      "args": []
    },
    {
      "namespace": "tau",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tau CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tau",
        "passthrough": true,
        "missingDependencyHelp": "Install tau: pip install tau"
      },
      "args": []
    }
  ]
}