{
  "name": "bump-my-version",
  "version": "0.1.0",
  "description": "Modern Python version bumper with rich configuration",
  "source": "https://github.com/callowayproject/bump-my-version",
  "checks": [{ "type": "binary", "name": "bump-my-version" }],
  "install_guidance": {
    "plugin": "bump-my-version",
    "binary": "bump-my-version",
    "check": "which bump-my-version",
    "install_steps": ["pip install bump-my-version", "Verify: bump-my-version --version", "supercli plugins install ./plugins/bump-my-version --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bump-my-version",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bump-my-version CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bump-my-version",
      "passthrough": true,
      "missingDependencyHelp": "Install bump-my-version: pip install bump-my-version", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
