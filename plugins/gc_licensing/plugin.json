{
  "name": "gc_licensing",
  "version": "0.1.0",
  "description": "Scan pip/APT dependencies for license compliance",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "gc_licensing" }],
  "install_guidance": {
    "plugin": "gc_licensing",
    "binary": "gc_licensing",
    "check": "which gc_licensing",
    "install_steps": ["pip install gc-licensing", "Verify: gc_licensing --version", "supercli plugins install ./plugins/gc_licensing --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gc_licensing",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gc_licensing CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gc_licensing",
      "passthrough": true,
      "missingDependencyHelp": "Install gc_licensing: pip install gc-licensing"
    },
    "args": []
  }]
}
