{
  "name": "Bartib",
  "version": "0.1.0",
  "description": "Easy to use time tracking tool",
  "source": "https://github.com/nikolassv/bartib",
  "checks": [
    {
      "type": "binary",
      "name": "Bartib"
    }
  ],
  "install_guidance": {
    "plugin": "Bartib",
    "binary": "Bartib",
    "check": "which Bartib",
    "install_steps": [
      "cargo install Bartib",
      "Verify: Bartib --version",
      "supercli plugins install ./plugins/Bartib --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Bartib",
      "resource": "self",
      "action": "version",
      "description": "Print Bartib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Bartib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Bartib: cargo install Bartib"
      },
      "args": []
    },
    {
      "namespace": "Bartib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Bartib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Bartib",
        "passthrough": true,
        "missingDependencyHelp": "Install Bartib"
      },
      "args": []
    }
  ]
}