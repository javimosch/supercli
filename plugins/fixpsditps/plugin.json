{
  "name": "fixpsditps",
  "version": "0.1.0",
  "description": "CLI tool: fixpsditps",
  "source": "https://manpages.debian.org/fixpsditps",
  "checks": [
    {
      "type": "binary",
      "name": "fixpsditps"
    }
  ],
  "install_guidance": {
    "plugin": "fixpsditps",
    "binary": "fixpsditps",
    "check": "which fixpsditps",
    "install_steps": [
      "apt-get install fixpsditps 2>/dev/null || which fixpsditps",
      "Verify: fixpsditps --version",
      "supercli plugins install ./plugins/fixpsditps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixpsditps",
      "resource": "self",
      "action": "version",
      "description": "Print fixpsditps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixpsditps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixpsditps: apt-get install fixpsditps 2>/dev/null || which fixpsditps"
      },
      "args": []
    },
    {
      "namespace": "fixpsditps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixpsditps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixpsditps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixpsditps: apt-get install fixpsditps 2>/dev/null || which fixpsditps"
      },
      "args": []
    }
  ]
}