{
  "plugin": "hp-check",
  "binary": "hp-check",
  "check": "which hp-check",
  "install_steps": [
    "apt-get install hp-check 2>/dev/null || which hp-check",
    "Verify: hp-check --version",
    "supercli plugins install ./plugins/hp-check --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}