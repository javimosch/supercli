{
  "name": "balatro-gba",
  "version": "0.1.0",
  "description": "A demake of Balatro for the GBA",
  "source": "https://github.com/balatro-gba/balatro-gba",
  "checks": [
    {
      "type": "binary",
      "name": "balatro-gba"
    }
  ],
  "install_guidance": {
    "plugin": "balatro-gba",
    "binary": "balatro-gba",
    "check": "which balatro-gba",
    "install_steps": [
      "pip install balatro-gba",
      "Verify: balatro-gba --version",
      "supercli plugins install ./plugins/balatro-gba --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "balatro-gba",
      "resource": "self",
      "action": "version",
      "description": "Print balatro-gba version",
      "adapter": "process",
      "adapterConfig": {
        "command": "balatro-gba",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install balatro-gba: pip install balatro-gba"
      },
      "args": []
    },
    {
      "namespace": "balatro-gba",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to balatro-gba CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "balatro-gba",
        "passthrough": true,
        "missingDependencyHelp": "Install balatro-gba: pip install balatro-gba"
      },
      "args": []
    }
  ]
}