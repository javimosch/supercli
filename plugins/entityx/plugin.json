{
  "name": "entityx",
  "version": "0.1.0",
  "description": "Fast, type-safe C++ Entity Component System",
  "source": "https://github.com/alecthomas/entityx",
  "checks": [
    {
      "type": "binary",
      "name": "entityx"
    }
  ],
  "install_guidance": {
    "plugin": "entityx",
    "binary": "entityx",
    "check": "which entityx",
    "install_steps": [
      "brew install entityx",
      "Verify: entityx --version",
      "supercli plugins install ./plugins/entityx --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "entityx",
      "resource": "self",
      "action": "version",
      "description": "Print entityx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "entityx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install entityx: brew install entityx"
      },
      "args": []
    },
    {
      "namespace": "entityx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to entityx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "entityx",
        "passthrough": true,
        "missingDependencyHelp": "Install entityx"
      },
      "args": []
    }
  ]
}