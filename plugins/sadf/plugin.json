{
  "name": "sadf",
  "version": "1.0.0",
  "description": "sadf \u2014 sadf \u2014 CLI utility",
  "source": "/usr/bin/sadf",
  "checks": [
    {
      "type": "binary",
      "name": "sadf"
    }
  ],
  "install_guidance": {
    "plugin": "sadf",
    "binary": "sadf",
    "check": "which sadf",
    "install_steps": [
      "# Install sadf:",
      "# apt: sudo apt-get install sadf",
      "# brew: brew install sadf",
      "# cargo: cargo install sadf",
      "# npm: npm install -g sadf",
      "# pip: pip install sadf",
      "# or download from /usr/bin/sadf"
    ]
  },
  "commands": [
    {
      "namespace": "sadf",
      "resource": "sadf",
      "action": "run",
      "description": "Run sadf",
      "adapter": "process",
      "adapterConfig": {
        "command": "sadf",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install sadf from /usr/bin/sadf"
      },
      "args": []
    }
  ]
}