{
  "name": "gdmflexiserver",
  "version": "0.1.0",
  "description": "CLI tool: gdmflexiserver",
  "source": "https://manpages.debian.org/gdmflexiserver",
  "checks": [
    {
      "type": "binary",
      "name": "gdmflexiserver"
    }
  ],
  "install_guidance": {
    "plugin": "gdmflexiserver",
    "binary": "gdmflexiserver",
    "check": "which gdmflexiserver",
    "install_steps": [
      "apt-get install gdmflexiserver 2>/dev/null || which gdmflexiserver",
      "Verify: gdmflexiserver --version",
      "supercli plugins install ./plugins/gdmflexiserver --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdmflexiserver",
      "resource": "self",
      "action": "version",
      "description": "Print gdmflexiserver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdmflexiserver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdmflexiserver: apt-get install gdmflexiserver 2>/dev/null || which gdmflexiserver"
      },
      "args": []
    },
    {
      "namespace": "gdmflexiserver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdmflexiserver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdmflexiserver",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gdmflexiserver: apt-get install gdmflexiserver 2>/dev/null || which gdmflexiserver"
      },
      "args": []
    }
  ]
}