{
  "name": "fullmoon-ios",
  "version": "0.1.0",
  "description": "chat with private and local large language models",
  "source": "https://github.com/fullmoon-ios/fullmoon-ios",
  "checks": [
    {
      "type": "binary",
      "name": "fullmoon-ios"
    }
  ],
  "install_guidance": {
    "plugin": "fullmoon-ios",
    "binary": "fullmoon-ios",
    "check": "which fullmoon-ios",
    "install_steps": [
      "pip install fullmoon-ios",
      "Verify: fullmoon-ios --version",
      "supercli plugins install ./plugins/fullmoon-ios --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fullmoon-ios",
      "resource": "self",
      "action": "version",
      "description": "Print fullmoon-ios version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fullmoon-ios",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fullmoon-ios: pip install fullmoon-ios"
      },
      "args": []
    },
    {
      "namespace": "fullmoon-ios",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fullmoon-ios CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fullmoon-ios",
        "passthrough": true,
        "missingDependencyHelp": "Install fullmoon-ios: pip install fullmoon-ios"
      },
      "args": []
    }
  ]
}