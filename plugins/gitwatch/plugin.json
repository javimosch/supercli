{
  "name": "gitwatch",
  "version": "0.1.0",
  "description": "Watch a file or folder and automatically commit changes to a git repo easily",
  "source": "https://github.com/gitwatch/gitwatch",
  "checks": [
    {
      "type": "binary",
      "name": "gitwatch"
    }
  ],
  "install_guidance": {
    "plugin": "gitwatch",
    "binary": "gitwatch",
    "check": "which gitwatch",
    "install_steps": [
      "brew install gitwatch",
      "Verify: gitwatch --version",
      "supercli plugins install ./plugins/gitwatch --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitwatch",
      "resource": "self",
      "action": "version",
      "description": "Print gitwatch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitwatch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitwatch: brew install gitwatch"
      },
      "args": []
    },
    {
      "namespace": "gitwatch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitwatch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitwatch",
        "passthrough": true,
        "missingDependencyHelp": "Install gitwatch"
      },
      "args": []
    }
  ]
}