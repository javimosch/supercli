{
  "name": "coverage-3.11",
  "version": "0.1.0",
  "description": "CLI tool: coverage-3.11",
  "source": "https://manpages.debian.org/coverage-3.11",
  "checks": [
    {
      "type": "binary",
      "name": "coverage-3.11"
    }
  ],
  "install_guidance": {
    "plugin": "coverage-3.11",
    "binary": "coverage-3.11",
    "check": "which coverage-3.11",
    "install_steps": [
      "apt-get install coverage-3.11 2>/dev/null || which coverage-3.11",
      "Verify: coverage-3.11 --version",
      "supercli plugins install ./plugins/coverage-3.11 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "coverage-3.11",
      "resource": "self",
      "action": "version",
      "description": "Print coverage-3.11 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coverage-3.11",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coverage-3.11: apt-get install coverage-3.11 2>/dev/null || which coverage-3.11"
      },
      "args": []
    },
    {
      "namespace": "coverage-3.11",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coverage-3.11 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coverage-3.11",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install coverage-3.11: apt-get install coverage-3.11 2>/dev/null || which coverage-3.11"
      },
      "args": []
    }
  ]
}