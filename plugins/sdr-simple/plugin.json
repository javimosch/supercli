{
  "name": "sdr-simple",
  "version": "0.1.0",
  "description": "Minimalist software-defined radio receiver interface for terminal",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "sdr-simple" }],
  "install_guidance": {
    "plugin": "sdr-simple",
    "binary": "sdr-simple",
    "check": "which sdr-simple",
    "install_steps": ["cargo install sdr-simple", "Verify: sdr-simple --version", "supercli plugins install ./plugins/sdr-simple --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sdr-simple",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sdr-simple CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sdr-simple",
      "passthrough": true,
      "missingDependencyHelp": "Install sdr-simple: cargo install sdr-simple"
    },
    "args": []
  }]
}
