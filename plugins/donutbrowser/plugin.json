{
  "name": "donutbrowser",
  "version": "0.1.0",
  "description": "Simple yet powerful anti-detect browser",
  "source": "https://github.com/zhom/donutbrowser",
  "checks": [
    {
      "type": "binary",
      "name": "donutbrowser"
    }
  ],
  "install_guidance": {
    "plugin": "donutbrowser",
    "binary": "donutbrowser",
    "check": "which donutbrowser",
    "install_steps": [
      "cargo install donutbrowser",
      "Verify: donutbrowser --version",
      "supercli plugins install ./plugins/donutbrowser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "donutbrowser",
    "resource": "self",
    "action": "version",
    "description": "Print donutbrowser version",
    "adapter": "process",
    "adapterConfig": {
      "command": "donutbrowser",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install donutbrowser: cargo install donutbrowser"
    },
    "args": []
  },
  {
    "namespace": "donutbrowser",
    "resource": "browser",
    "action": "launch",
    "description": "Launch the anti-detect browser",
    "adapter": "process",
    "adapterConfig": {
      "command": "donutbrowser",
      "passthrough": true,
      "missingDependencyHelp": "Install donutbrowser: cargo install donutbrowser"
    },
    "args": []
  },
  {
    "namespace": "donutbrowser",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to donutbrowser CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "donutbrowser",
      "passthrough": true,
      "missingDependencyHelp": "Install donutbrowser"
    },
    "args": []
  }
]
}