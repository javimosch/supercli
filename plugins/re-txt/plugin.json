{
  "name": "re-txt",
  "version": "0.1.0",
  "description": "Convert text formats in Go",
  "source": "https://github.com/re-txt/re-txt",
  "checks": [{"type": "binary", "name": "re-txt"}],
  "install_guidance": {
    "plugin": "re-txt",
    "binary": "re-txt",
    "check": "which re-txt",
    "install_steps": [
      "go install github.com/re-txt/re-txt@latest",
      "Verify: re-txt --version",
      "supercli plugins install ./re-txt --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "re-txt",
      "resource": "self",
      "action": "version",
      "description": "Print re-txt version",
      "adapter": "process",
      "adapterConfig": {"command": "re-txt", "baseArgs": ["--version"], "missingDependencyHelp": "Install re-txt: go install github.com/re-txt/re-txt@latest"},
      "args": []
    },
    {
      "namespace": "re-txt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to re-txt CLI",
      "adapter": "process",
      "adapterConfig": {"command": "re-txt", "passthrough": true, "missingDependencyHelp": "Install re-txt: go install github.com/re-txt/re-txt@latest"},
      "args": []
    }
  ]
}
