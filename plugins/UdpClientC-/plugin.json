{
  "name": "UdpClientC-",
  "version": "0.1.0",
  "description": "Receiving and sending data with udp using C#",
  "source": "https://github.com/UdpClientC-/UdpClientC-",
  "checks": [
    {
      "type": "binary",
      "name": "UdpClientC-"
    }
  ],
  "install_guidance": {
    "plugin": "UdpClientC-",
    "binary": "UdpClientC-",
    "check": "which UdpClientC-",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: UdpClientC- --version",
      "supercli plugins install ./plugins/UdpClientC- --on-conflict replace --json"
    ],
    "note": "C# language CLI tool"
  },
  "commands": [
    {
      "namespace": "UdpClientC-",
      "resource": "self",
      "action": "version",
      "description": "Print UdpClientC- version",
      "adapter": "process",
      "adapterConfig": {
        "command": "UdpClientC-",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install UdpClientC- from project repository"
      },
      "args": []
    },
    {
      "namespace": "UdpClientC-",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to UdpClientC- CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "UdpClientC-",
        "passthrough": true,
        "missingDependencyHelp": "Install UdpClientC- from project repository"
      },
      "args": []
    }
  ]
}