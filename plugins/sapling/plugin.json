{
  "name": "sapling",
  "version": "0.1.0",
  "description": "Meta's source control CLI compatible with Git repositories",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "sapling" }],
  "install_guidance": {
    "plugin": "sapling",
    "binary": "sapling",
    "check": "which sapling",
    "install_steps": ["brew install sapling", "Verify: sapling --version", "supercli plugins install ./plugins/sapling --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sapling",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sapling CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sapling",
      "passthrough": true,
      "missingDependencyHelp": "Install sapling: brew install sapling"
    },
    "args": []
  }]
}
