{
  "plugin": "x86_64-linux-gnu-ld",
  "binary": "x86_64-linux-gnu-ld",
  "check": "which x86_64-linux-gnu-ld",
  "install_steps": [
    "apt-get install x86_64-linux-gnu-ld 2>/dev/null || which x86_64-linux-gnu-ld",
