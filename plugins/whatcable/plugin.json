{
  "name": "whatcable",
  "version": "0.1.0",
  "description": "macOS menu bar app that tells you, in plain English, what each USB-C cable plugged into your Mac can",
  "source": "https://github.com/whatcable/whatcable",
  "checks": [
    {
      "type": "binary",
      "name": "whatcable"
    }
  ],
  "install_guidance": {
    "plugin": "whatcable",
    "binary": "whatcable",
    "check": "which whatcable",
    "install_steps": [
      "pip install whatcable",
      "Verify: whatcable --version",
      "supercli plugins install ./plugins/whatcable --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "whatcable",
      "resource": "self",
      "action": "version",
      "description": "Print whatcable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatcable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install whatcable: pip install whatcable"
      },
      "args": []
    },
    {
      "namespace": "whatcable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to whatcable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatcable",
        "passthrough": true,
        "missingDependencyHelp": "Install whatcable: pip install whatcable"
      },
      "args": []
    }
  ]
}