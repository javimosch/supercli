{
  "name": "coraza",
  "version": "0.1.0",
  "description": "Go WAF CLI — ModSecurity-compatible web application firewall for reverse proxies",
  "source": "https://github.com/corazawaf/coraza",
  "checks": [
    {
      "type": "binary",
      "name": "coraza"
    }
  ],
  "install_guidance": {
    "plugin": "coraza",
    "binary": "coraza",
    "check": "which coraza",
    "install_steps": [
      "go install github.com/corazawaf/coraza@latest",
      "Verify: coraza --version",
      "supercli plugins install ./plugins/coraza --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "coraza",
      "resource": "self",
      "action": "version",
      "description": "Print coraza version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coraza",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coraza: go install github.com/corazawaf/coraza@latest"
      },
      "args": []
    },
    {
      "namespace": "coraza",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coraza CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coraza",
        "passthrough": true,
        "missingDependencyHelp": "Install coraza: go install github.com/corazawaf/coraza@latest"
      },
      "args": []
    }
  ]
}
