{
  "name": "wofm2opl",
  "version": "0.1.0",
  "description": "CLI tool: wofm2opl",
  "source": "https://manpages.debian.org/wofm2opl",
  "checks": [
    {
      "type": "binary",
      "name": "wofm2opl"
    }
  ],
  "install_guidance": {
    "plugin": "wofm2opl",
    "binary": "wofm2opl",
    "check": "which wofm2opl",
    "install_steps": [
      "apt-get install wofm2opl 2>/dev/null || which wofm2opl",
      "Verify: wofm2opl --version",
      "supercli plugins install ./plugins/wofm2opl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wofm2opl",
      "resource": "self",
      "action": "version",
      "description": "Print wofm2opl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wofm2opl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wofm2opl: apt-get install wofm2opl 2>/dev/null || which wofm2opl"
      },
      "args": []
    },
    {
      "namespace": "wofm2opl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wofm2opl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wofm2opl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wofm2opl: apt-get install wofm2opl 2>/dev/null || which wofm2opl"
      },
      "args": []
    }
  ]
}