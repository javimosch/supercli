{
  "name": "nestedtextto",
  "version": "0.1.0",
  "description": "NestedText format converter to JSON, YAML, TOML, and other data formats",
  "source": "https://github.com/nicm/nestedtextto",
  "checks": [
    {
      "type": "binary",
      "name": "nestedtextto"
    }
  ],
  "install_guidance": {
    "plugin": "nestedtextto",
    "binary": "nestedtextto",
    "check": "which nestedtextto",
    "install_steps": [
      "pip install nestedtextto",
      "Verify: nestedtextto --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nestedtextto",
      "resource": "self",
      "action": "version",
      "description": "Print nestedtextto version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nestedtextto",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install nestedtextto: pip install nestedtextto"
      },
      "args": []
    },
    {
      "namespace": "nestedtextto",
      "resource": "file",
      "action": "convert",
      "description": "Convert NestedText files to JSON, YAML, or TOML",
      "adapter": "process",
      "adapterConfig": {
        "command": "nestedtextto",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install nestedtextto: pip install nestedtextto"
      },
      "args": []
    },
    {
      "namespace": "nestedtextto",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nestedtextto CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nestedtextto",
        "passthrough": true,
        "missingDependencyHelp": "Install nestedtextto: pip install nestedtextto"
      },
      "args": []
    }
  ]
}