{
  "name": "enchant-lsmod-2",
  "version": "0.1.0",
  "description": "CLI tool: enchant-lsmod-2",
  "source": "https://manpages.debian.org/enchant-lsmod-2",
  "checks": [
    {
      "type": "binary",
      "name": "enchant-lsmod-2"
    }
  ],
  "install_guidance": {
    "plugin": "enchant-lsmod-2",
    "binary": "enchant-lsmod-2",
    "check": "which enchant-lsmod-2",
    "install_steps": [
      "apt-get install enchant-lsmod-2 2>/dev/null || which enchant-lsmod-2",
      "Verify: enchant-lsmod-2 --version",
      "supercli plugins install ./plugins/enchant-lsmod-2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "enchant-lsmod-2",
      "resource": "self",
      "action": "version",
      "description": "Print enchant-lsmod-2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "enchant-lsmod-2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install enchant-lsmod-2: apt-get install enchant-lsmod-2 2>/dev/null || which enchant-lsmod-2"
      },
      "args": []
    },
    {
      "namespace": "enchant-lsmod-2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enchant-lsmod-2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enchant-lsmod-2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install enchant-lsmod-2: apt-get install enchant-lsmod-2 2>/dev/null || which enchant-lsmod-2"
      },
      "args": []
    }
  ]
}