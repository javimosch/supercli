{
  "name": "pfb2pfa",
  "version": "0.1.0",
  "description": "CLI tool: pfb2pfa",
  "source": "https://manpages.debian.org/pfb2pfa",
  "checks": [
    {
      "type": "binary",
      "name": "pfb2pfa"
    }
  ],
  "install_guidance": {
    "plugin": "pfb2pfa",
    "binary": "pfb2pfa",
    "check": "which pfb2pfa",
    "install_steps": [
      "apt-get install pfb2pfa 2>/dev/null || which pfb2pfa",
      "Verify: pfb2pfa --version",
      "supercli plugins install ./plugins/pfb2pfa --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pfb2pfa",
      "resource": "self",
      "action": "version",
      "description": "Print pfb2pfa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pfb2pfa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pfb2pfa: apt-get install pfb2pfa 2>/dev/null || which pfb2pfa"
      },
      "args": []
    },
    {
      "namespace": "pfb2pfa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pfb2pfa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pfb2pfa",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pfb2pfa: apt-get install pfb2pfa 2>/dev/null || which pfb2pfa"
      },
      "args": []
    }
  ]
}