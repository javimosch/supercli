{
  "name": "mox",
  "version": "0.1.0",
  "description": "modern full-featured open source secure mail server for low-maintenance self-hosted email",
  "source": "https://github.com/mox/mox",
  "checks": [
    {
      "type": "binary",
      "name": "mox"
    }
  ],
  "install_guidance": {
    "plugin": "mox",
    "binary": "mox",
    "check": "which mox",
    "install_steps": [
      "pip install mox",
      "Verify: mox --version",
      "supercli plugins install ./plugins/mox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mox",
      "resource": "self",
      "action": "version",
      "description": "Print mox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mox: pip install mox"
      },
      "args": []
    },
    {
      "namespace": "mox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mox",
        "passthrough": true,
        "missingDependencyHelp": "Install mox: pip install mox"
      },
      "args": []
    }
  ]
}