{
  "name": "arjun",
  "version": "0.1.0",
  "description": "HTTP parameter discovery tool with --json",
  "source": "https://github.com/s0md3v/Arjun",
  "checks": [
    {
      "type": "binary",
      "name": "arjun"
    }
  ],
  "install_guidance": {
    "plugin": "arjun",
    "binary": "arjun",
    "check": "which arjun",
    "install_steps": [
      "pip install arjun",
      "Verify: arjun --version",
      "supercli plugins install ./plugins/arjun --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "arjun",
      "resource": "self",
      "action": "version",
      "description": "Print arjun version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arjun",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arjun: pip install arjun"
      },
      "args": []
    },
    {
      "namespace": "arjun",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arjun CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "arjun",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install arjun: pip install arjun"
      },
      "args": []
    }
  ]
}
