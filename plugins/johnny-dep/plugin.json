{
  "name": "johnny-dep",
  "version": "0.1.0",
  "description": "Display Python project dependency tree",
  "source": "https://github.com/wimglenn/johnny-dep",
  "checks": [{ "type": "binary", "name": "johnny-dep" }],
  "install_guidance": {
    "plugin": "johnny-dep",
    "binary": "johnny-dep",
    "check": "which johnny-dep",
    "install_steps": ["pip install johnny-dep", "Verify: johnny-dep --version", "supercli plugins install ./plugins/johnny-dep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "johnny-dep",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to johnny-dep CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "johnny-dep",
      "passthrough": true,
      "missingDependencyHelp": "Install johnny-dep: pip install johnny-dep", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
