{
  "name": "llmfit",
  "version": "0.1.0",
  "description": "Hundreds of models & providers. One command to find what runs on your hardware.",
  "source": "https://github.com/llmfit/llmfit",
  "checks": [
    {
      "type": "binary",
      "name": "llmfit"
    }
  ],
  "install_guidance": {
    "plugin": "llmfit",
    "binary": "llmfit",
    "check": "which llmfit",
    "install_steps": [
      "pip install llmfit",
      "Verify: llmfit --version",
      "supercli plugins install ./plugins/llmfit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "llmfit",
      "resource": "self",
      "action": "version",
      "description": "Print llmfit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llmfit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llmfit: pip install llmfit"
      },
      "args": []
    },
    {
      "namespace": "llmfit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llmfit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llmfit",
        "passthrough": true,
        "missingDependencyHelp": "Install llmfit: pip install llmfit"
      },
      "args": []
    }
  ]
}