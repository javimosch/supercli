{
  "name": "descopecli",
  "version": "0.1.0",
  "description": "Descope CLI",
  "source": "https://github.com/descope/descopecli",
  "checks": [
    { "type": "binary", "name": "descope" }
  ],
  "install_guidance": {
    "plugin": "descopecli",
    "binary": "descope",
    "check": "which descope",
    "install_steps": [
      "sudo apt-key adv --keyserver keyserver.ubuntu.com --recv-keys e8365d8513142909 && ...",
      "Verify: descope --version",
      "supercli plugins install ./plugins/descopecli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "descopecli",
      "resource": "self",
      "action": "version",
      "description": "Print descope version",
      "adapter": "process",
      "adapterConfig": {
        "command": "descope",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install descopecli: sudo apt-key adv --keyserver keyserver.ubuntu.com --recv-keys e8365d8513142909 && ..."
      },
      "args": []
    },
    {
      "namespace": "descopecli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to descope CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "descope",
        "passthrough": true,
        "missingDependencyHelp": "Install descopecli"
      },
      "args": []
    }
  ]
}
