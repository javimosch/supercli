{
  "name": "shardeum",
  "version": "0.1.0",
  "description": "Shardeum is an EVM based autoscaling blockchain",
  "source": "https://github.com/shardeum/shardeum",
  "checks": [
    {
      "type": "binary",
      "name": "shardeum"
    }
  ],
  "install_guidance": {
    "plugin": "shardeum",
    "binary": "shardeum",
    "check": "which shardeum",
    "install_steps": [
      "pip install shardeum",
      "Verify: shardeum --version",
      "supercli plugins install ./plugins/shardeum --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "shardeum",
      "resource": "self",
      "action": "version",
      "description": "Print shardeum version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shardeum",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shardeum: pip install shardeum"
      },
      "args": []
    },
    {
      "namespace": "shardeum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shardeum CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shardeum",
        "passthrough": true,
        "missingDependencyHelp": "Install shardeum: pip install shardeum"
      },
      "args": []
    }
  ]
}