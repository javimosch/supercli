{
  "name": "kb",
  "version": "0.1.0",
  "description": "kb single-header C/C++ libraries",
  "source": "https://github.com/kb/kb",
  "checks": [
    {
      "type": "binary",
      "name": "kb"
    }
  ],
  "install_guidance": {
    "plugin": "kb",
    "binary": "kb",
    "check": "which kb",
    "install_steps": [
      "pip install kb",
      "Verify: kb --version",
      "supercli plugins install ./plugins/kb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kb",
      "resource": "self",
      "action": "version",
      "description": "Print kb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kb: pip install kb"
      },
      "args": []
    },
    {
      "namespace": "kb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kb",
        "passthrough": true,
        "missingDependencyHelp": "Install kb: pip install kb"
      },
      "args": []
    }
  ]
}