{
  "name": "legit",
  "version": "0.1.0",
  "description": "Generate Open Source licences as files or file headers",
  "source": "https://github.com/captainsafia/legit",
  "checks": [
    {
      "type": "binary",
      "name": "legit"
    }
  ],
  "install_guidance": {
    "plugin": "legit",
    "binary": "legit",
    "check": "which legit",
    "install_steps": [
      "brew install legit",
      "Verify: legit --version",
      "supercli plugins install ./plugins/legit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "legit",
      "resource": "self",
      "action": "version",
      "description": "Print legit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "legit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install legit: brew install legit"
      },
      "args": []
    },
    {
      "namespace": "legit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to legit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "legit",
        "passthrough": true,
        "missingDependencyHelp": "Install legit"
      },
      "args": []
    }
  ]
}