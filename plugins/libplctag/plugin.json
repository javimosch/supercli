{
  "name": "libplctag",
  "version": "0.1.0",
  "description": "Portable and simple API for accessing AB PLC data over Ethernet",
  "source": "https://github.com/libplctag/libplctag",
  "checks": [
    {
      "type": "binary",
      "name": "libplctag"
    }
  ],
  "install_guidance": {
    "plugin": "libplctag",
    "binary": "libplctag",
    "check": "which libplctag",
    "install_steps": [
      "brew install libplctag",
      "Verify: libplctag --version",
      "supercli plugins install ./plugins/libplctag --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libplctag",
      "resource": "self",
      "action": "version",
      "description": "Print libplctag version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libplctag",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libplctag: brew install libplctag"
      },
      "args": []
    },
    {
      "namespace": "libplctag",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libplctag CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libplctag",
        "passthrough": true,
        "missingDependencyHelp": "Install libplctag"
      },
      "args": []
    }
  ]
}