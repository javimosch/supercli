{
  "name": "pw-loopback",
  "version": "0.1.0",
  "description": "CLI tool: pw-loopback",
  "source": "https://manpages.debian.org/pw-loopback",
  "checks": [
    {
      "type": "binary",
      "name": "pw-loopback"
    }
  ],
  "install_guidance": {
    "plugin": "pw-loopback",
    "binary": "pw-loopback",
    "check": "which pw-loopback",
    "install_steps": [
      "apt-get install pw-loopback 2>/dev/null || which pw-loopback",
      "Verify: pw-loopback --version",
      "supercli plugins install ./plugins/pw-loopback --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pw-loopback",
      "resource": "self",
      "action": "version",
      "description": "Print pw-loopback version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pw-loopback",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pw-loopback: apt-get install pw-loopback 2>/dev/null || which pw-loopback"
      },
      "args": []
    },
    {
      "namespace": "pw-loopback",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pw-loopback CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pw-loopback",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pw-loopback: apt-get install pw-loopback 2>/dev/null || which pw-loopback"
      },
      "args": []
    }
  ]
}