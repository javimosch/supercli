{
  "name": "SpamBlocker",
  "version": "0.1.0",
  "description": "Android Call/SMS blocker.",
  "source": "https://github.com/SpamBlocker/SpamBlocker",
  "checks": [
    {
      "type": "binary",
      "name": "spamblocker"
    }
  ],
  "install_guidance": {
    "plugin": "SpamBlocker",
    "binary": "spamblocker",
    "check": "which spamblocker",
    "install_steps": [
      "pip install spamblocker",
      "Verify: spamblocker --version",
      "supercli plugins install ./plugins/SpamBlocker --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SpamBlocker",
      "resource": "self",
      "action": "version",
      "description": "Print SpamBlocker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spamblocker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SpamBlocker: pip install spamblocker"
      },
      "args": []
    },
    {
      "namespace": "SpamBlocker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spamblocker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spamblocker",
        "passthrough": true,
        "missingDependencyHelp": "Install SpamBlocker: pip install spamblocker"
      },
      "args": []
    }
  ]
}