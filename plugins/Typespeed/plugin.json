{
  "name": "Typespeed",
  "version": "0.1.0",
  "description": "Type words that are flying by from left to right as fast as you can; features different word sets, e.g., UNIX commands, English words, Non-English words.",
  "checks": [
    {
      "type": "binary",
      "name": "Typespeed"
    }
  ],
  "install_guidance": {
    "plugin": "Typespeed",
    "binary": "Typespeed",
    "check": "which Typespeed",
    "install_steps": [
      "brew install Typespeed",
      "Verify: Typespeed --version",
      "supercli plugins install ./plugins/Typespeed --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Typespeed",
      "resource": "self",
      "action": "version",
      "description": "Print Typespeed version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Typespeed",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Typespeed: brew install Typespeed"
      },
      "args": []
    },
    {
      "namespace": "Typespeed",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Typespeed CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Typespeed",
        "passthrough": true,
        "missingDependencyHelp": "Install Typespeed"
      },
      "args": []
    }
  ]
}