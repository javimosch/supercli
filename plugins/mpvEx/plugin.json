{
  "name": "mpvEx",
  "version": "0.1.0",
  "description": "A beautiful media player for android, based on mpv-android and built with Jetpack Compose. Forked fr",
  "source": "https://github.com/mpvEx/mpvEx",
  "checks": [
    {
      "type": "binary",
      "name": "mpvex"
    }
  ],
  "install_guidance": {
    "plugin": "mpvEx",
    "binary": "mpvex",
    "check": "which mpvex",
    "install_steps": [
      "pip install mpvex",
      "Verify: mpvex --version",
      "supercli plugins install ./plugins/mpvEx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpvEx",
      "resource": "self",
      "action": "version",
      "description": "Print mpvEx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpvex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpvEx: pip install mpvex"
      },
      "args": []
    },
    {
      "namespace": "mpvEx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpvex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpvex",
        "passthrough": true,
        "missingDependencyHelp": "Install mpvEx: pip install mpvex"
      },
      "args": []
    }
  ]
}