{
  "name": "marksman",
  "version": "0.1.0",
  "description": "Language Server Protocol for Markdown",
  "source": "https://github.com/artempyanykh/marksman",
  "checks": [
    {
      "type": "binary",
      "name": "marksman"
    }
  ],
  "install_guidance": {
    "plugin": "marksman",
    "binary": "marksman",
    "check": "which marksman",
    "install_steps": [
      "brew install marksman",
      "Verify: marksman --version",
      "supercli plugins install ./plugins/marksman --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "marksman",
      "resource": "self",
      "action": "version",
      "description": "Print marksman version",
      "adapter": "process",
      "adapterConfig": {
        "command": "marksman",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install marksman: brew install marksman"
      },
      "args": []
    },
    {
      "namespace": "marksman",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to marksman CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "marksman",
        "passthrough": true,
        "missingDependencyHelp": "Install marksman"
      },
      "args": []
    }
  ]
}