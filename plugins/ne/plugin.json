{
  "name": "ne",
  "version": "0.1.0",
  "description": "Nice editor for the terminal with menus and shortcuts",
  "source": "https://github.com/vigna/ne",
  "checks": [{ "type": "binary", "name": "ne" }],
  "install_guidance": {
    "plugin": "ne",
    "binary": "ne",
    "check": "which ne",
    "install_steps": ["brew install ne", "Verify: ne --version", "supercli plugins install ./plugins/ne --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ne",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ne CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ne",
      "passthrough": true,
      "missingDependencyHelp": "Install ne: brew install ne", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
