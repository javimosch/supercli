{
  "name": "hwe-support-status",
  "version": "0.1.0",
  "description": "CLI tool: hwe-support-status",
  "source": "https://manpages.debian.org/hwe-support-status",
  "checks": [
    {
      "type": "binary",
      "name": "hwe-support-status"
    }
  ],
  "install_guidance": {
    "plugin": "hwe-support-status",
    "binary": "hwe-support-status",
    "check": "which hwe-support-status",
    "install_steps": [
      "apt-get install hwe-support-status 2>/dev/null || which hwe-support-status",
      "Verify: hwe-support-status --version",
      "supercli plugins install ./plugins/hwe-support-status --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hwe-support-status",
      "resource": "self",
      "action": "version",
      "description": "Print hwe-support-status version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwe-support-status",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hwe-support-status: apt-get install hwe-support-status 2>/dev/null || which hwe-support-status"
      },
      "args": []
    },
    {
      "namespace": "hwe-support-status",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hwe-support-status CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwe-support-status",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hwe-support-status: apt-get install hwe-support-status 2>/dev/null || which hwe-support-status"
      },
      "args": []
    }
  ]
}