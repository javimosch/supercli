{
  "name": "ppmrainbow",
  "version": "0.1.0",
  "description": "CLI tool: ppmrainbow",
  "source": "https://manpages.debian.org/ppmrainbow",
  "checks": [
    {
      "type": "binary",
      "name": "ppmrainbow"
    }
  ],
  "install_guidance": {
    "plugin": "ppmrainbow",
    "binary": "ppmrainbow",
    "check": "which ppmrainbow",
    "install_steps": [
      "apt-get install ppmrainbow 2>/dev/null || which ppmrainbow",
      "Verify: ppmrainbow --version",
      "supercli plugins install ./plugins/ppmrainbow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmrainbow",
      "resource": "self",
      "action": "version",
      "description": "Print ppmrainbow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmrainbow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmrainbow: apt-get install ppmrainbow 2>/dev/null || which ppmrainbow"
      },
      "args": []
    },
    {
      "namespace": "ppmrainbow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmrainbow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmrainbow",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmrainbow: apt-get install ppmrainbow 2>/dev/null || which ppmrainbow"
      },
      "args": []
    }
  ]
}