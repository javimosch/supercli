{
  "name": "shipjs",
  "version": "0.1.0",
  "description": "Automated release workflow for JavaScript projects",
  "source": "https://github.com/algolia/shipjs",
  "checks": [{ "type": "binary", "name": "shipjs" }],
  "install_guidance": {
    "plugin": "shipjs",
    "binary": "shipjs",
    "check": "which shipjs",
    "install_steps": ["npm install -g shipjs", "Verify: shipjs --version", "supercli plugins install ./plugins/shipjs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "shipjs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to shipjs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "shipjs",
      "passthrough": true,
      "missingDependencyHelp": "Install shipjs: npm install -g shipjs", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
