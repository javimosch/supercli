{
  "name": "apturl-gtk",
  "version": "0.1.0",
  "description": "CLI tool: apturl-gtk",
  "source": "https://packages.debian.org/apturl-gtk",
  "checks": [{ "type": "binary", "name": "apturl-gtk" }],
  "install_guidance": {
    "plugin": "apturl-gtk", "binary": "apturl-gtk", "check": "which apturl-gtk",
    "install_steps": ["apt-get install apturl-gtk 2>/dev/null || which apturl-gtk", "Verify: apturl-gtk --version", "supercli plugins install ./plugins/apturl-gtk --on-conflict replace --json"]
