{
  "name": "fxor",
  "version": "0.1.0",
  "description": "File encryption CLI using XOR cipher",
  "source": "https://github.com/nicm/fxor",
  "checks": [
    {
      "type": "binary",
      "name": "fxor"
    }
  ],
  "install_guidance": {
    "plugin": "fxor",
    "binary": "fxor",
    "check": "which fxor",
    "install_steps": [
      "cargo install fxor",
      "Verify: fxor --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fxor",
      "resource": "self",
      "action": "version",
      "description": "Print fxor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fxor",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install fxor: cargo install fxor"
      },
      "args": []
    },
    {
      "namespace": "fxor",
      "resource": "file",
      "action": "encrypt",
      "description": "Encrypt files using XOR cipher with a key",
      "adapter": "process",
      "adapterConfig": {
        "command": "fxor",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fxor: cargo install fxor"
      },
      "args": []
    },
    {
      "namespace": "fxor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fxor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fxor",
        "passthrough": true,
        "missingDependencyHelp": "Install fxor: cargo install fxor"
      },
      "args": []
    }
  ]
}