{
  "name": "cg_diff",
  "version": "0.1.0",
  "description": "CLI tool: cg_diff",
  "source": "https://packages.debian.org/cg_diff",
  "checks": [{ "type": "binary", "name": "cg_diff" }],
  "install_guidance": {
    "plugin": "cg_diff", "binary": "cg_diff", "check": "which cg_diff",
    "install_steps": ["apt-get install cg_diff 2>/dev/null || which cg_diff", "Verify: cg_diff --version", "supercli plugins install ./plugins/cg_diff --on-conflict replace --json"]
