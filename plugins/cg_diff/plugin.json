  "commands": [{
    "namespace": "cg_diff", "resource": "_", "action": "_",
    "description": "Passthrough to cg_diff CLI",
    "adapter": "process", "adapterConfig": { "command": "cg_diff", "passthrough": true, "missingDependencyHelp": "Install cg_diff: apt-get install cg_diff" }, "args": []
  }]
}
