{
  "name": "NuvioTV",
  "version": "0.1.0",
  "description": "Official Nuvio Android TV Repository",
  "source": "https://github.com/NuvioTV/NuvioTV",
  "checks": [
    {
      "type": "binary",
      "name": "nuviotv"
    }
  ],
  "install_guidance": {
    "plugin": "NuvioTV",
    "binary": "nuviotv",
    "check": "which nuviotv",
    "install_steps": [
      "pip install nuviotv",
      "Verify: nuviotv --version",
      "supercli plugins install ./plugins/NuvioTV --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NuvioTV",
      "resource": "self",
      "action": "version",
      "description": "Print NuvioTV version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nuviotv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NuvioTV: pip install nuviotv"
      },
      "args": []
    },
    {
      "namespace": "NuvioTV",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nuviotv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nuviotv",
        "passthrough": true,
        "missingDependencyHelp": "Install NuvioTV: pip install nuviotv"
      },
      "args": []
    }
  ]
}