{
  "name": "libgpg-error",
  "version": "0.1.0",
  "description": "Common error values for all GnuPG components",
  "checks": [
    {
      "type": "binary",
      "name": "libgpg-error"
    }
  ],
  "install_guidance": {
    "plugin": "libgpg-error",
    "binary": "libgpg-error",
    "check": "which libgpg-error",
    "install_steps": [
      "brew install libgpg-error",
      "Verify: libgpg-error --version",
      "supercli plugins install ./plugins/libgpg-error --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libgpg-error",
      "resource": "self",
      "action": "version",
      "description": "Print libgpg-error version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libgpg-error",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libgpg-error: brew install libgpg-error"
      },
      "args": []
    },
    {
      "namespace": "libgpg-error",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libgpg-error CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libgpg-error",
        "passthrough": true,
        "missingDependencyHelp": "Install libgpg-error"
      },
      "args": []
    }
  ]
}