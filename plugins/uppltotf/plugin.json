{
  "name": "uppltotf",
  "version": "0.1.0",
  "description": "CLI tool: uppltotf",
  "source": "https://manpages.debian.org/uppltotf",
  "checks": [
    {
      "type": "binary",
      "name": "uppltotf"
    }
  ],
  "install_guidance": {
    "plugin": "uppltotf",
    "binary": "uppltotf",
    "check": "which uppltotf",
    "install_steps": [
      "apt-get install uppltotf 2>/dev/null || which uppltotf",
      "Verify: uppltotf --version",
      "supercli plugins install ./plugins/uppltotf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uppltotf",
      "resource": "self",
      "action": "version",
      "description": "Print uppltotf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uppltotf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uppltotf: apt-get install uppltotf 2>/dev/null || which uppltotf"
      },
      "args": []
    },
    {
      "namespace": "uppltotf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uppltotf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uppltotf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uppltotf: apt-get install uppltotf 2>/dev/null || which uppltotf"
      },
      "args": []
    }
  ]
}