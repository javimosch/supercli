{
  "name": "hey",
  "version": "0.1.0",
  "description": "Tiny program that sends load to a web application",
  "source": "https://github.com/rakyll/hey",
  "checks": [{ "type": "binary", "name": "hey" }],
  "install_guidance": {
    "plugin": "hey",
    "binary": "hey",
    "check": "which hey",
    "install_steps": ["go install github.com/rakyll/hey@latest", "Verify: hey --version", "supercli plugins install ./plugins/hey --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hey",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hey CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hey",
      "passthrough": true,
      "missingDependencyHelp": "Install hey: go install github.com/rakyll/hey@latest"
    },
    "args": []
  }]
}
