{
  "name": "plz-cli",
  "version": "0.1.0",
  "description": "Copilot for your terminal - AI command suggestions",
  "source": "https://github.com/m1guelpf/plz-cli",
  "checks": [{ "type": "binary", "name": "plz-cli" }],
  "install_guidance": {
    "plugin": "plz-cli",
    "binary": "plz-cli",
    "check": "which plz-cli",
    "install_steps": ["npm install -g plz-cli", "Verify: plz-cli --version", "supercli plugins install ./plugins/plz-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "plz-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to plz-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "plz-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install plz-cli: npm install -g plz-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
