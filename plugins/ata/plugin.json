{
  "name": "ata",
  "version": "0.1.0",
  "description": "CLI tool: ata",
  "source": "https://packages.debian.org/ata",
  "checks": [{ "type": "binary", "name": "ata" }],
  "install_guidance": {
    "plugin": "ata", "binary": "ata", "check": "which ata",
    "install_steps": ["apt-get install ata 2>/dev/null || which ata", "Verify: ata --version", "supercli plugins install ./plugins/ata --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ata", "resource": "_", "action": "_",
    "description": "Passthrough to ata CLI",
    "adapter": "process", "adapterConfig": { "command": "ata", "passthrough": true, "missingDependencyHelp": "Install ata: apt-get install ata" }, "args": []
  }]
}
