{
  "name": "active-win-cli",
  "version": "0.1.0",
  "description": "Get the title/id/etc of the active window",
  "source": "https://github.com/sindresorhus/active-win-cli",
  "checks": [
    {
      "type": "binary",
      "name": "active-win-cli"
    }
  ],
  "install_guidance": {
    "plugin": "active-win-cli",
    "binary": "active-win-cli",
    "check": "which active-win-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/active-win-cli",
      "Verify: active-win-cli --version",
      "supercli plugins install ./plugins/active-win-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "active-win-cli",
      "resource": "self",
      "action": "version",
      "description": "Print active-win-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "active-win-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install active-win-cli: See https://github.com/sindresorhus/active-win-cli"
      },
      "args": []
    },
    {
      "namespace": "active-win-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to active-win-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "active-win-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install active-win-cli"
      },
      "args": []
    }
  ]
}