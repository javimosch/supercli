{
  "name": "vhs",
  "version": "0.1.0",
  "description": "Terminal GIF generator where you write terminal sessions as code",
  "source": "https://github.com/charmbracelet/vhs",
  "checks": [{ "type": "binary", "name": "vhs" }],
  "install_guidance": {
    "plugin": "vhs",
    "binary": "vhs",
    "check": "which vhs",
    "install_steps": ["brew install vhs", "Verify: vhs --version", "supercli plugins install ./plugins/vhs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vhs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vhs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vhs",
      "passthrough": true,
      "missingDependencyHelp": "Install vhs: brew install vhs"
    },
    "args": []
  }]
}
