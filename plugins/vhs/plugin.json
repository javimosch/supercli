{
  "name": "vhs",
  "version": "0.1.0",
  "description": "Terminal GIF creator using tape-based automation",
  "source": "https://github.com/charmbracelet/vhs",
  "checks": [
    {
      "type": "binary",
      "name": "vhs"
    }
  ],
  "install_guidance": {
    "plugin": "vhs",
    "binary": "vhs",
    "check": "which vhs",
    "install_steps": [
      "brew install vhs",
      "Verify: vhs --version",
      "supercli plugins install ./plugins/vhs --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "vhs",
      "resource": "self",
      "action": "version",
      "description": "Print vhs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vhs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vhs: brew install vhs"
      },
      "args": []
    },
    {
      "namespace": "vhs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vhs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vhs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vhs: brew install vhs"
      },
      "args": []
    }
  ]
}
