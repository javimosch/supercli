{
  "name": "facad",
  "version": "0.1.0",
  "description": "Modern fast directory jumper and cd alternative in Rust",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "facad" }],
  "install_guidance": {
    "plugin": "facad",
    "binary": "facad",
    "check": "which facad",
    "install_steps": ["cargo install facad", "Verify: facad --version", "supercli plugins install ./plugins/facad --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "facad",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to facad CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "facad",
      "passthrough": true,
      "missingDependencyHelp": "Install facad: cargo install facad"
    },
    "args": []
  }]
}
