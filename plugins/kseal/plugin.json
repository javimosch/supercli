{
  "name": "kseal",
  "version": "0.1.0",
  "description": "Kubernetes secrets viewer and decoder for encrypted and base64-encoded data",
  "source": "https://github.com/nicm/kseal",
  "checks": [
    {
      "type": "binary",
      "name": "kseal"
    }
  ],
  "install_guidance": {
    "plugin": "kseal",
    "binary": "kseal",
    "check": "which kseal",
    "install_steps": [
      "pip install kseal",
      "Verify: kseal --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kseal",
      "resource": "self",
      "action": "version",
      "description": "Print kseal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kseal",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install kseal: pip install kseal"
      },
      "args": []
    },
    {
      "namespace": "kseal",
      "resource": "secret",
      "action": "view",
      "description": "View and decode Kubernetes secrets",
      "adapter": "process",
      "adapterConfig": {
        "command": "kseal",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install kseal: pip install kseal"
      },
      "args": []
    },
    {
      "namespace": "kseal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kseal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kseal",
        "passthrough": true,
        "missingDependencyHelp": "Install kseal: pip install kseal"
      },
      "args": []
    }
  ]
}