{
  "name": "actix",
  "version": "0.1.0",
  "description": "Actix — Rust actor framework for building concurrent applications",
  "source": "https://github.com/actix/actix",
  "checks": [
    {
      "type": "binary",
      "name": "actix"
    }
  ],
  "install_guidance": {
    "plugin": "actix",
    "binary": "actix",
    "check": "which actix",
    "install_steps": [
      "cargo install actix",
      "Verify: actix --version",
      "supercli plugins install ./plugins/actix --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "actix",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "actix",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install actix"
      },
      "args": []
    }
  ]
}
