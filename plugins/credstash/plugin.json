{
  "name": "credstash",
  "version": "0.1.0",
  "description": "Use AWS KMS to manage credentials securely",
  "source": "https://github.com/fugue/credstash",
  "checks": [{ "type": "binary", "name": "credstash" }],
  "install_guidance": {
    "plugin": "credstash",
    "binary": "credstash",
    "check": "which credstash",
    "install_steps": ["pip install credstash", "Verify: credstash --version", "supercli plugins install ./plugins/credstash --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "credstash",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to credstash CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "credstash",
      "passthrough": true,
      "missingDependencyHelp": "Install credstash: pip install credstash", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
