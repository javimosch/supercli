{
  "name": "gofumpt",
  "version": "1.0.0",
  "description": "gofumpt \u2014 Stricter gofmt",
  "source": "github.com/mvdan/gofumpt",
  "checks": [
    {
      "type": "binary",
      "name": "gofumpt"
    }
  ],
  "install_guidance": {
    "plugin": "gofumpt",
    "binary": "gofumpt",
    "check": "which gofumpt",
    "install_steps": [
      "# Install gofumpt:",
      "# apt: sudo apt-get install gofumpt",
      "# brew: brew install gofumpt",
      "# cargo: cargo install gofumpt",
      "# npm: npm install -g gofumpt",
      "# pip: pip install gofumpt",
      "# or download from github.com/mvdan/gofumpt"
    ]
  },
  "commands": [
    {
      "namespace": "gofumpt",
      "resource": "gofumpt",
      "action": "run",
      "description": "Run gofumpt",
      "adapter": "process",
      "adapterConfig": {
        "command": "gofumpt",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gofumpt from github.com/mvdan/gofumpt"
      },
      "args": []
    }
  ]
}