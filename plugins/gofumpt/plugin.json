{
  "name": "gofumpt",
  "version": "0.1.0",
  "description": "Stricter Go code formatter that enforces additional rules",
  "source": "https://github.com/mvdan/gofumpt",
  "checks": [{ "type": "binary", "name": "gofumpt" }],
  "install_guidance": {
    "plugin": "gofumpt",
    "binary": "gofumpt",
    "check": "which gofumpt",
    "install_steps": ["go install mvdan.cc/gofumpt@latest", "Verify: gofumpt --version", "supercli plugins install ./plugins/gofumpt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gofumpt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gofumpt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gofumpt",
      "passthrough": true,
      "missingDependencyHelp": "Install gofumpt: go install mvdan.cc/gofumpt@latest"
    },
    "args": []
  }]
}
