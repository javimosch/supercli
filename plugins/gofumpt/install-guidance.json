{
  "plugin": "gofumpt",
  "binary": "gofumpt",
  "check": "which gofumpt",
  "install_steps": [
    "# Install gofumpt",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/gofumpt-linux-amd64 -o /usr/local/bin/gofumpt",
    "chmod +x /usr/local/bin/gofumpt",
    "# Or via package manager, see github.com/mvdan/gofumpt"
  ]
}