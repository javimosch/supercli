    "namespace": "arp-scan", "resource": "_", "action": "_",
    "description": "Passthrough to arp-scan CLI",
    "adapter": "process", "adapterConfig": { "command": "arp-scan", "passthrough": true, "missingDependencyHelp": "Install arp-scan: apt-get install arp-scan" }, "args": []
  }]
}
