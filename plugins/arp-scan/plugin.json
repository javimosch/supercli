{
  "name": "arp-scan",
  "version": "0.1.0",
  "description": "ARP scanning tool",
  "source": "https://packages.debian.org/arp-scan",
  "checks": [{ "type": "binary", "name": "arp-scan" }],
  "install_guidance": {
    "plugin": "arp-scan", "binary": "arp-scan", "check": "which arp-scan",
    "install_steps": ["apt-get install arp-scan", "Verify: arp-scan --version", "supercli plugins install ./plugins/arp-scan --on-conflict replace --json"]
