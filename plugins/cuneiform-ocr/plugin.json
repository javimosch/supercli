{
  "name": "cuneiform-ocr",
  "version": "0.1.0",
  "description": "Open-source OCR system with command-line interface",
  "source": "https://github.com/OCR-cuneiform/cuneiform",
  "checks": [{ "type": "binary", "name": "cuneiform-ocr" }],
  "install_guidance": {
    "plugin": "cuneiform-ocr",
    "binary": "cuneiform-ocr",
    "check": "which cuneiform-ocr",
    "install_steps": ["brew install cuneiform", "Verify: cuneiform-ocr --version", "supercli plugins install ./plugins/cuneiform-ocr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cuneiform-ocr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cuneiform-ocr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cuneiform-ocr",
      "passthrough": true,
      "missingDependencyHelp": "Install cuneiform-ocr: brew install cuneiform", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
