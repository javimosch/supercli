{
  "name": "clicker-cli",
  "version": "0.1.0",
  "description": "Terminal-based cookie clicker game for developers",
  "source": "https://github.com/the-compiler/clicker-cli",
  "checks": [{ "type": "binary", "name": "clicker-cli" }],
  "install_guidance": {
    "plugin": "clicker-cli",
    "binary": "clicker-cli",
    "check": "which clicker-cli",
    "install_steps": ["pip install clicker-cli", "Verify: clicker-cli --version", "supercli plugins install ./plugins/clicker-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clicker-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clicker-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clicker-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install clicker-cli: pip install clicker-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
