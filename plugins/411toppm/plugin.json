{
  "name": "411toppm",
  "version": "0.1.0",
  "description": "CLI tool: 411toppm",
  "source": "https://manpages.debian.org/411toppm",
  "checks": [
    {
      "type": "binary",
      "name": "411toppm"
    }
  ],
  "install_guidance": {
    "plugin": "411toppm",
    "binary": "411toppm",
    "check": "which 411toppm",
    "install_steps": [
      "apt-get install 411toppm 2>/dev/null || which 411toppm",
      "Verify: 411toppm --version",
      "supercli plugins install ./plugins/411toppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "411toppm",
      "resource": "self",
      "action": "version",
      "description": "Print 411toppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "411toppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install 411toppm: apt-get install 411toppm 2>/dev/null || which 411toppm"
      },
      "args": []
    },
    {
      "namespace": "411toppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to 411toppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "411toppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install 411toppm: apt-get install 411toppm 2>/dev/null || which 411toppm"
      },
      "args": []
    }
  ]
}