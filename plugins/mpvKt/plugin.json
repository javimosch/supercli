{
  "name": "mpvKt",
  "version": "0.1.0",
  "description": "A media player for android, based on mpv-android and built with Jetpack Compose.",
  "source": "https://github.com/mpvKt/mpvKt",
  "checks": [
    {
      "type": "binary",
      "name": "mpvkt"
    }
  ],
  "install_guidance": {
    "plugin": "mpvKt",
    "binary": "mpvkt",
    "check": "which mpvkt",
    "install_steps": [
      "pip install mpvkt",
      "Verify: mpvkt --version",
      "supercli plugins install ./plugins/mpvKt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpvKt",
      "resource": "self",
      "action": "version",
      "description": "Print mpvKt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpvkt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpvKt: pip install mpvkt"
      },
      "args": []
    },
    {
      "namespace": "mpvKt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpvkt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpvkt",
        "passthrough": true,
        "missingDependencyHelp": "Install mpvKt: pip install mpvkt"
      },
      "args": []
    }
  ]
}