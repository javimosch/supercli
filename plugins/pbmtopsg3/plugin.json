{
  "name": "pbmtopsg3",
  "version": "0.1.0",
  "description": "CLI tool: pbmtopsg3",
  "source": "https://manpages.debian.org/pbmtopsg3",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtopsg3"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtopsg3",
    "binary": "pbmtopsg3",
    "check": "which pbmtopsg3",
    "install_steps": [
      "apt-get install pbmtopsg3 2>/dev/null || which pbmtopsg3",
      "Verify: pbmtopsg3 --version",
      "supercli plugins install ./plugins/pbmtopsg3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtopsg3",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtopsg3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtopsg3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtopsg3: apt-get install pbmtopsg3 2>/dev/null || which pbmtopsg3"
      },
      "args": []
    },
    {
      "namespace": "pbmtopsg3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtopsg3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtopsg3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtopsg3: apt-get install pbmtopsg3 2>/dev/null || which pbmtopsg3"
      },
      "args": []
    }
  ]
}