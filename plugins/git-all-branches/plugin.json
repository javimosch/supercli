{
  "name": "git-all-branches",
  "version": "0.1.0",
  "description": "Improved `git branch -a`",
  "source": "https://github.com/zacanger/git-all-branches",
  "checks": [
    {
      "type": "binary",
      "name": "git-all-branches"
    }
  ],
  "install_guidance": {
    "plugin": "git-all-branches",
    "binary": "git-all-branches",
    "check": "which git-all-branches",
    "install_steps": [
      "See https://github.com/zacanger/git-all-branches",
      "Verify: git-all-branches --version",
      "supercli plugins install ./plugins/git-all-branches --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "git-all-branches",
      "resource": "self",
      "action": "version",
      "description": "Print git-all-branches version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-all-branches",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-all-branches: See https://github.com/zacanger/git-all-branches"
      },
      "args": []
    },
    {
      "namespace": "git-all-branches",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-all-branches CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-all-branches",
        "passthrough": true,
        "missingDependencyHelp": "Install git-all-branches"
      },
      "args": []
    }
  ]
}