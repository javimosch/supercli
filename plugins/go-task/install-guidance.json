{
  "plugin": "go-task",
  "binary": "task",
  "check": "task --version",
  "install_steps": [
    "brew install go-task",
    "Verify: task --version",
    "supercli plugins install ./plugins/go-task --on-conflict replace --json"
  ],
  "note": "Install from package manager. Also via: go install github.com/go-task/task/v3/cmd/task@latest"
}
