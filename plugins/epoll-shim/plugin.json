{
  "name": "epoll-shim",
  "version": "0.1.0",
  "description": "Small epoll implementation using kqueue",
  "source": "https://github.com/jiixyj/epoll-shim",
  "checks": [
    {
      "type": "binary",
      "name": "epoll-shim"
    }
  ],
  "install_guidance": {
    "plugin": "epoll-shim",
    "binary": "epoll-shim",
    "check": "which epoll-shim",
    "install_steps": [
      "brew install epoll-shim",
      "Verify: epoll-shim --version",
      "supercli plugins install ./plugins/epoll-shim --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "epoll-shim",
      "resource": "self",
      "action": "version",
      "description": "Print epoll-shim version",
      "adapter": "process",
      "adapterConfig": {
        "command": "epoll-shim",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install epoll-shim: brew install epoll-shim"
      },
      "args": []
    },
    {
      "namespace": "epoll-shim",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to epoll-shim CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "epoll-shim",
        "passthrough": true,
        "missingDependencyHelp": "Install epoll-shim"
      },
      "args": []
    }
  ]
}