{
  "name": "dateutils",
  "version": "0.1.0",
  "description": "Date/time calculation and conversion tools",
  "source": "https://github.com/hroptatyr/dateutils",
  "checks": [
    {
      "type": "binary",
      "name": "dateutils"
    }
  ],
  "install_guidance": {
    "plugin": "dateutils",
    "binary": "dateutils",
    "check": "which dateutils",
    "install_steps": [
      "brew install dateutils",
      "Verify: dateutils --version",
      "supercli plugins install ./plugins/dateutils --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "dateutils",
      "resource": "self",
      "action": "version",
      "description": "Print dateutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dateutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dateutils: brew install dateutils"
      },
      "args": []
    },
    {
      "namespace": "dateutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dateutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dateutils",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dateutils: brew install dateutils"
      },
      "args": []
    }
  ]
}
