{
  "name": "runlevel",
  "version": "1.0.0",
  "description": "runlevel \u2014 runlevel \u2014 CLI utility",
  "source": "/usr/sbin/runlevel",
  "checks": [
    {
      "type": "binary",
      "name": "runlevel"
    }
  ],
  "install_guidance": {
    "plugin": "runlevel",
    "binary": "runlevel",
    "check": "which runlevel",
    "install_steps": [
      "# Install runlevel:",
      "# apt: sudo apt-get install runlevel",
      "# brew: brew install runlevel",
      "# cargo: cargo install runlevel",
      "# npm: npm install -g runlevel",
      "# pip: pip install runlevel",
      "# or download from /usr/sbin/runlevel"
    ]
  },
  "commands": [
    {
      "namespace": "runlevel",
      "resource": "runlevel",
      "action": "run",
      "description": "Run runlevel",
      "adapter": "process",
      "adapterConfig": {
        "command": "runlevel",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install runlevel from /usr/sbin/runlevel"
      },
      "args": []
    }
  ]
}