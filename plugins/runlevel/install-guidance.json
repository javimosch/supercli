{
  "plugin": "runlevel",
  "binary": "runlevel",
  "check": "which runlevel",
  "install_steps": [
    "# Install runlevel",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/runlevel-linux-amd64 -o /usr/local/bin/runlevel",
    "chmod +x /usr/local/bin/runlevel",
    "# Or via package manager, see /usr/sbin/runlevel"
  ]
}