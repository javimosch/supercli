{
  "name": "rgb3toppm",
  "version": "0.1.0",
  "description": "CLI tool: rgb3toppm",
  "source": "https://manpages.debian.org/rgb3toppm",
  "checks": [
    {
      "type": "binary",
      "name": "rgb3toppm"
    }
  ],
  "install_guidance": {
    "plugin": "rgb3toppm",
    "binary": "rgb3toppm",
    "check": "which rgb3toppm",
    "install_steps": [
      "apt-get install rgb3toppm 2>/dev/null || which rgb3toppm",
      "Verify: rgb3toppm --version",
      "supercli plugins install ./plugins/rgb3toppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rgb3toppm",
      "resource": "self",
      "action": "version",
      "description": "Print rgb3toppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rgb3toppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rgb3toppm: apt-get install rgb3toppm 2>/dev/null || which rgb3toppm"
      },
      "args": []
    },
    {
      "namespace": "rgb3toppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rgb3toppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rgb3toppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rgb3toppm: apt-get install rgb3toppm 2>/dev/null || which rgb3toppm"
      },
      "args": []
    }
  ]
}