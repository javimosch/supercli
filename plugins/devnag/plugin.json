{
  "name": "devnag",
  "version": "0.1.0",
  "description": "CLI tool: devnag",
  "source": "https://packages.debian.org/devnag",
  "checks": [{ "type": "binary", "name": "devnag" }],
  "install_guidance": {
    "plugin": "devnag", "binary": "devnag", "check": "which devnag",
    "install_steps": ["apt-get install devnag 2>/dev/null || which devnag", "Verify: devnag --version", "supercli plugins install ./plugins/devnag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "devnag", "resource": "_", "action": "_",
    "description": "Passthrough to devnag CLI",
    "adapter": "process", "adapterConfig": { "command": "devnag", "passthrough": true, "missingDependencyHelp": "Install devnag: apt-get install devnag" }, "args": []
  }]
}
