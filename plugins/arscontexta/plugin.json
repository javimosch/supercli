{
  "name": "arscontexta",
  "version": "0.1.0",
  "description": "Claude Code plugin that generates individualized knowledge systems from conversation. You describe h",
  "source": "https://github.com/arscontexta/arscontexta",
  "checks": [
    {
      "type": "binary",
      "name": "arscontexta"
    }
  ],
  "install_guidance": {
    "plugin": "arscontexta",
    "binary": "arscontexta",
    "check": "which arscontexta",
    "install_steps": [
      "pip install arscontexta",
      "Verify: arscontexta --version",
      "supercli plugins install ./plugins/arscontexta --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "arscontexta",
      "resource": "self",
      "action": "version",
      "description": "Print arscontexta version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arscontexta",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arscontexta: pip install arscontexta"
      },
      "args": []
    },
    {
      "namespace": "arscontexta",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arscontexta CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "arscontexta",
        "passthrough": true,
        "missingDependencyHelp": "Install arscontexta: pip install arscontexta"
      },
      "args": []
    }
  ]
}