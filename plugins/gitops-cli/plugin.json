{
  "name": "gitops-cli",
  "version": "0.1.0",
  "description": "Weave GitOps CLI for continuous delivery on Kubernetes",
  "source": "https://github.com/weaveworks/weave-gitops",
  "checks": [{ "type": "binary", "name": "gitops" }],
  "install_guidance": {
    "plugin": "gitops-cli",
    "binary": "gitops",
    "check": "which gitops",
    "install_steps": ["brew install gitops", "Verify: gitops --version", "supercli plugins install ./plugins/gitops-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gitops-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gitops CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gitops",
      "passthrough": true,
      "missingDependencyHelp": "Install gitops-cli: brew install gitops"
    },
    "args": []
  }]
}
