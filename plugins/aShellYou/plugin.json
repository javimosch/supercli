{
  "name": "aShellYou",
  "version": "0.1.0",
  "description": "A material you designed app for your ADB needs",
  "source": "https://github.com/aShellYou/aShellYou",
  "checks": [
    {
      "type": "binary",
      "name": "ashellyou"
    }
  ],
  "install_guidance": {
    "plugin": "aShellYou",
    "binary": "ashellyou",
    "check": "which ashellyou",
    "install_steps": [
      "pip install ashellyou",
      "Verify: ashellyou --version",
      "supercli plugins install ./plugins/aShellYou --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aShellYou",
      "resource": "self",
      "action": "version",
      "description": "Print aShellYou version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ashellyou",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aShellYou: pip install ashellyou"
      },
      "args": []
    },
    {
      "namespace": "aShellYou",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ashellyou CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ashellyou",
        "passthrough": true,
        "missingDependencyHelp": "Install aShellYou: pip install ashellyou"
      },
      "args": []
    }
  ]
}