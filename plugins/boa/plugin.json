{
  "name": "boa",
  "version": "0.1.0",
  "description": "Embeddable and experimental Javascript engine written in Rust",
  "source": "https://github.com/boa-dev/boa",
  "checks": [
    {
      "type": "binary",
      "name": "boa"
    }
  ],
  "install_guidance": {
    "plugin": "boa",
    "binary": "boa",
    "check": "which boa",
    "install_steps": [
      "cargo install boa",
      "Verify: boa --version",
      "supercli plugins install ./plugins/boa --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "boa",
      "resource": "self",
      "action": "version",
      "description": "Print boa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "boa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install boa: cargo install boa"
      },
      "args": []
    },
    {
      "namespace": "boa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to boa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "boa",
        "passthrough": true,
        "missingDependencyHelp": "Install boa"
      },
      "args": []
    }
  ]
}