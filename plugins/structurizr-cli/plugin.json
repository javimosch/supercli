{
  "name": "structurizr-cli",
  "version": "0.1.0",
  "description": "Software architecture modeling as code with C4 model",
  "source": "https://github.com/structurizr/cli",
  "checks": [{ "type": "binary", "name": "structurizr-cli" }],
  "install_guidance": {
    "plugin": "structurizr-cli",
    "binary": "structurizr-cli",
    "check": "which structurizr-cli",
    "install_steps": ["brew install structurizr-cli", "Verify: structurizr-cli --version", "supercli plugins install ./plugins/structurizr-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "structurizr-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to structurizr-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "structurizr-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install structurizr-cli: brew install structurizr-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
