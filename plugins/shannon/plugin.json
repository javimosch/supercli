{
  "name": "shannon",
  "version": "0.1.0",
  "description": "Shannon Lite is an autonomous, white-box AI pentester for web applications and APIs. It analyzes you",
  "source": "https://github.com/shannon/shannon",
  "checks": [
    {
      "type": "binary",
      "name": "shannon"
    }
  ],
  "install_guidance": {
    "plugin": "shannon",
    "binary": "shannon",
    "check": "which shannon",
    "install_steps": [
      "pip install shannon",
      "Verify: shannon --version",
      "supercli plugins install ./plugins/shannon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "shannon",
      "resource": "self",
      "action": "version",
      "description": "Print shannon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shannon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shannon: pip install shannon"
      },
      "args": []
    },
    {
      "namespace": "shannon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shannon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shannon",
        "passthrough": true,
        "missingDependencyHelp": "Install shannon: pip install shannon"
      },
      "args": []
    }
  ]
}