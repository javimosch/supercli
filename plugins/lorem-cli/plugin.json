{
  "name": "lorem-cli",
  "version": "0.1.0",
  "description": "Generate Lorem Ipsum placeholder text for templates",
  "source": "https://github.com/mrmlnc/lorem-cli",
  "checks": [{ "type": "binary", "name": "lorem-cli" }],
  "install_guidance": {
    "plugin": "lorem-cli",
    "binary": "lorem-cli",
    "check": "which lorem-cli",
    "install_steps": ["npm install -g lorem-cli", "Verify: lorem-cli --version", "supercli plugins install ./plugins/lorem-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lorem-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lorem-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lorem-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install lorem-cli: npm install -g lorem-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
