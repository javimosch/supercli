{
  "name": "OpenOats",
  "version": "0.1.0",
  "description": "A meeting note-taker that talks back.",
  "source": "https://github.com/OpenOats/OpenOats",
  "checks": [
    {
      "type": "binary",
      "name": "openoats"
    }
  ],
  "install_guidance": {
    "plugin": "OpenOats",
    "binary": "openoats",
    "check": "which openoats",
    "install_steps": [
      "pip install openoats",
      "Verify: openoats --version",
      "supercli plugins install ./plugins/OpenOats --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenOats",
      "resource": "self",
      "action": "version",
      "description": "Print OpenOats version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openoats",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenOats: pip install openoats"
      },
      "args": []
    },
    {
      "namespace": "OpenOats",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openoats CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openoats",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenOats: pip install openoats"
      },
      "args": []
    }
  ]
}