{
  "name": "oakdecode",
  "version": "0.1.0",
  "description": "CLI tool: oakdecode",
  "source": "https://manpages.debian.org/oakdecode",
  "checks": [
    {
      "type": "binary",
      "name": "oakdecode"
    }
  ],
  "install_guidance": {
    "plugin": "oakdecode",
    "binary": "oakdecode",
    "check": "which oakdecode",
    "install_steps": [
      "apt-get install oakdecode 2>/dev/null || which oakdecode",
      "Verify: oakdecode --version",
      "supercli plugins install ./plugins/oakdecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oakdecode",
      "resource": "self",
      "action": "version",
      "description": "Print oakdecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oakdecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oakdecode: apt-get install oakdecode 2>/dev/null || which oakdecode"
      },
      "args": []
    },
    {
      "namespace": "oakdecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oakdecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oakdecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install oakdecode: apt-get install oakdecode 2>/dev/null || which oakdecode"
      },
      "args": []
    }
  ]
}