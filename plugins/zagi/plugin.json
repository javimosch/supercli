{
  "name": "zagi",
  "version": "0.1.0",
  "description": "Better Git CLI",
  "source": "https://github.com/mattzcarey/zagi",
  "checks": [
    { "type": "binary", "name": "zagi" }
  ],
  "install_guidance": {
    "plugin": "zagi",
    "binary": "zagi",
    "check": "which zagi",
    "install_steps": [
      "curl -fsSL zagi.sh/install | sh",
      "Verify: zagi --version",
      "supercli plugins install ./plugins/zagi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zagi",
      "resource": "self",
      "action": "version",
      "description": "Print zagi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zagi",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install zagi: curl -fsSL zagi.sh/install | sh"
      },
      "args": []
    },
    {
      "namespace": "zagi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zagi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zagi",
        "passthrough": true,
        "missingDependencyHelp": "Install zagi"
      },
      "args": []
    }
  ]
}
