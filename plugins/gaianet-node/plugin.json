{
  "name": "gaianet-node",
  "version": "0.1.0",
  "description": "Install, run and deploy your own decentralized AI agent service",
  "source": "https://github.com/gaianet-node/gaianet-node",
  "checks": [
    {
      "type": "binary",
      "name": "gaianet-node"
    }
  ],
  "install_guidance": {
    "plugin": "gaianet-node",
    "binary": "gaianet-node",
    "check": "which gaianet-node",
    "install_steps": [
      "pip install gaianet-node",
      "Verify: gaianet-node --version",
      "supercli plugins install ./plugins/gaianet-node --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gaianet-node",
      "resource": "self",
      "action": "version",
      "description": "Print gaianet-node version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gaianet-node",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gaianet-node: pip install gaianet-node"
      },
      "args": []
    },
    {
      "namespace": "gaianet-node",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gaianet-node CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gaianet-node",
        "passthrough": true,
        "missingDependencyHelp": "Install gaianet-node: pip install gaianet-node"
      },
      "args": []
    }
  ]
}