{
  "name": "rr",
  "version": "0.1.0",
  "description": "Debug the recording, deterministically, as many times as you want.",
  "source": "https://github.com/rr-debugger/rr",
  "checks": [
    {
      "type": "binary",
      "name": "rr"
    }
  ],
  "install_guidance": {
    "plugin": "rr",
    "binary": "rr",
    "check": "which rr",
    "install_steps": [
      "See https://github.com/rr-debugger/rr",
      "Verify: rr --version",
      "supercli plugins install ./plugins/rr --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "rr",
      "resource": "self",
      "action": "version",
      "description": "Print rr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rr: See https://github.com/rr-debugger/rr"
      },
      "args": []
    },
    {
      "namespace": "rr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rr",
        "passthrough": true,
        "missingDependencyHelp": "Install rr"
      },
      "args": []
    }
  ]
}