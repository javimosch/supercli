{
  "name": "timg",
  "version": "0.1.0",
  "description": "Terminal image viewer with grid output",
  "source": "https://github.com/hzeller/timg",
  "checks": [
    {
      "type": "binary",
      "name": "timg"
    }
  ],
  "install_guidance": {
    "plugin": "timg",
    "binary": "timg",
    "check": "which timg",
    "install_steps": [
      "brew install timg",
      "Verify: timg --version",
      "supercli plugins install ./plugins/timg --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "timg",
      "resource": "self",
      "action": "version",
      "description": "Print timg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "timg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install timg: brew install timg"
      },
      "args": []
    },
    {
      "namespace": "timg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to timg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "timg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install timg: brew install timg"
      },
      "args": []
    }
  ]
}
