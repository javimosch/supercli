{
  "name": "at-remote",
  "version": "0.1.0",
  "description": "CLI tool: at-remote",
  "source": "https://packages.debian.org/at-remote",
  "checks": [{ "type": "binary", "name": "at-remote" }],
  "install_guidance": {
    "plugin": "at-remote", "binary": "at-remote", "check": "which at-remote",
    "install_steps": ["apt-get install at-remote 2>/dev/null || which at-remote", "Verify: at-remote --version", "supercli plugins install ./plugins/at-remote --on-conflict replace --json"]
