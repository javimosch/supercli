  "commands": [{
    "namespace": "at-remote", "resource": "_", "action": "_",
    "description": "Passthrough to at-remote CLI",
    "adapter": "process", "adapterConfig": { "command": "at-remote", "passthrough": true, "missingDependencyHelp": "Install at-remote: apt-get install at-remote" }, "args": []
  }]
}
