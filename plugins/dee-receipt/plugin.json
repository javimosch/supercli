{
  "name": "dee-receipt",
  "version": "0.1.0",
  "description": "Extract data from receipts via CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-receipt" }],
  "install_guidance": {
    "plugin": "dee-receipt",
    "binary": "dee-receipt",
    "check": "which dee-receipt",
    "install_steps": ["cargo install dee-receipt", "Verify: dee-receipt --version", "supercli plugins install ./plugins/dee-receipt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-receipt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-receipt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-receipt",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-receipt: cargo install dee-receipt"
    },
    "args": []
  }]
}
