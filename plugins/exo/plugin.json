{
  "name": "exo",
  "version": "0.1.0",
  "description": "Run frontier AI locally.",
  "source": "https://github.com/exo/exo",
  "checks": [
    {
      "type": "binary",
      "name": "exo"
    }
  ],
  "install_guidance": {
    "plugin": "exo",
    "binary": "exo",
    "check": "which exo",
    "install_steps": [
      "pip install exo",
      "Verify: exo --version",
      "supercli plugins install ./plugins/exo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "exo",
      "resource": "self",
      "action": "version",
      "description": "Print exo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "exo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install exo: pip install exo"
      },
      "args": []
    },
    {
      "namespace": "exo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to exo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "exo",
        "passthrough": true,
        "missingDependencyHelp": "Install exo: pip install exo"
      },
      "args": []
    }
  ]
}