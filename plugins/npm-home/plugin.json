{
  "name": "npm-home",
  "version": "0.1.0",
  "description": "Open the npm page of the package in the current directory",
  "source": "https://github.com/sindresorhus/npm-home",
  "checks": [
    {
      "type": "binary",
      "name": "npm-home"
    }
  ],
  "install_guidance": {
    "plugin": "npm-home",
    "binary": "npm-home",
    "check": "which npm-home",
    "install_steps": [
      "See https://github.com/sindresorhus/npm-home",
      "Verify: npm-home --version",
      "supercli plugins install ./plugins/npm-home --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "npm-home",
      "resource": "self",
      "action": "version",
      "description": "Print npm-home version",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-home",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install npm-home: See https://github.com/sindresorhus/npm-home"
      },
      "args": []
    },
    {
      "namespace": "npm-home",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to npm-home CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "npm-home",
        "passthrough": true,
        "missingDependencyHelp": "Install npm-home"
      },
      "args": []
    }
  ]
}