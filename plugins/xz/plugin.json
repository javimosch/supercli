{
  "name": "xz",
  "version": "0.1.0",
  "description": "LZO file compression utility",
  "source": "https",
  "checks": [{"type": "binary", "name": "xz"}],
  "install_guidance": {
    "plugin": "xz",
    "binary": "xz",
    "check": "which xz",
    "install_steps": [
      "brew install xz",
      "Verify: xz --version",
      "supercli plugins install ./plugins/xz --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "xz",
      "resource": "self",
      "action": "version",
      "description": "Print xz version",
      "adapter": "process",
      "adapterConfig": {"command": "xz", "baseArgs": ["--version"], "missingDependencyHelp": "Install xz: brew install xz"},
      "args": []
    },
    {
      "namespace": "xz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xz CLI",
      "adapter": "process",
      "adapterConfig": {"command": "xz", "passthrough": true, "missingDependencyHelp": "Install xz: brew install xz"},
      "args": []
    }
  ]
}
