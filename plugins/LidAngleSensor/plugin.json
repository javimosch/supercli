{
  "name": "LidAngleSensor",
  "version": "0.1.0",
  "description": "tfw when you when your lid when uhh angle your lid sensor",
  "source": "https://github.com/LidAngleSensor/LidAngleSensor",
  "checks": [
    {
      "type": "binary",
      "name": "lidanglesensor"
    }
  ],
  "install_guidance": {
    "plugin": "LidAngleSensor",
    "binary": "lidanglesensor",
    "check": "which lidanglesensor",
    "install_steps": [
      "pip install lidanglesensor",
      "Verify: lidanglesensor --version",
      "supercli plugins install ./plugins/LidAngleSensor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LidAngleSensor",
      "resource": "self",
      "action": "version",
      "description": "Print LidAngleSensor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lidanglesensor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LidAngleSensor: pip install lidanglesensor"
      },
      "args": []
    },
    {
      "namespace": "LidAngleSensor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lidanglesensor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lidanglesensor",
        "passthrough": true,
        "missingDependencyHelp": "Install LidAngleSensor: pip install lidanglesensor"
      },
      "args": []
    }
  ]
}