{
  "name": "bytefield-cli",
  "version": "0.1.0",
  "description": "Generate bytefield and register diagrams from text specs",
  "source": "https://github.com/cknitt/bytefield-svg",
  "checks": [{ "type": "binary", "name": "bytefield-cli" }],
  "install_guidance": {
    "plugin": "bytefield-cli",
    "binary": "bytefield-cli",
    "check": "which bytefield-cli",
    "install_steps": ["npm install -g bytefield-cli", "Verify: bytefield-cli --version", "supercli plugins install ./plugins/bytefield-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bytefield-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bytefield-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bytefield-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install bytefield-cli: npm install -g bytefield-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
