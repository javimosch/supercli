{
  "name": "mihon",
  "version": "0.1.0",
  "description": "Free and open source manga reader for Android",
  "source": "https://github.com/mihon/mihon",
  "checks": [
    {
      "type": "binary",
      "name": "mihon"
    }
  ],
  "install_guidance": {
    "plugin": "mihon",
    "binary": "mihon",
    "check": "which mihon",
    "install_steps": [
      "pip install mihon",
      "Verify: mihon --version",
      "supercli plugins install ./plugins/mihon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mihon",
      "resource": "self",
      "action": "version",
      "description": "Print mihon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mihon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mihon: pip install mihon"
      },
      "args": []
    },
    {
      "namespace": "mihon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mihon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mihon",
        "passthrough": true,
        "missingDependencyHelp": "Install mihon: pip install mihon"
      },
      "args": []
    }
  ]
}