{
  "name": "clj",
  "version": "0.1.0",
  "description": "Clojure CLI tool",
  "source": "https://packages.debian.org/clj",
  "checks": [{ "type": "binary", "name": "clj" }],
  "install_guidance": {
    "plugin": "clj", "binary": "clj", "check": "which clj",
    "install_steps": ["apt-get install clojure", "Verify: clj --version", "supercli plugins install ./plugins/clj --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clj", "resource": "_", "action": "_",
    "description": "Passthrough to clj CLI",
    "adapter": "process", "adapterConfig": { "command": "clj", "passthrough": true, "missingDependencyHelp": "Install clj: apt-get install clojure" }, "args": []
  }]
}
