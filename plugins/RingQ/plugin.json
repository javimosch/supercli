{
  "name": "RingQ",
  "version": "0.1.0",
  "description": "\u4e00\u6b3e\u540e\u6e17\u900f\u514d\u6740\u5de5\u5177\uff0c\u52a9\u529b\u6bcf\u4e00\u4f4d\u50cf\u6211\u8fd9\u6837\u7684\u811a\u672c\u5c0f\u5b50\u5feb\u901f\u5b9e\u73b0\u514d\u6740\uff0c\u652f\u6301bypass AV/EDR 360 \u706b\u7ed2 Windows Defender Shellcode Loader",
  "source": "https://github.com/RingQ/RingQ",
  "checks": [
    {
      "type": "binary",
      "name": "ringq"
    }
  ],
  "install_guidance": {
    "plugin": "RingQ",
    "binary": "ringq",
    "check": "which ringq",
    "install_steps": [
      "pip install ringq",
      "Verify: ringq --version",
      "supercli plugins install ./plugins/RingQ --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RingQ",
      "resource": "self",
      "action": "version",
      "description": "Print RingQ version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ringq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RingQ: pip install ringq"
      },
      "args": []
    },
    {
      "namespace": "RingQ",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ringq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ringq",
        "passthrough": true,
        "missingDependencyHelp": "Install RingQ: pip install ringq"
      },
      "args": []
    }
  ]
}