{
  "name": "hlint",
  "version": "1.0.0",
  "description": "hlint \u2014 Haskell linter",
  "source": "github.com/ndmitchell/hlint",
  "checks": [
    {
      "type": "binary",
      "name": "hlint"
    }
  ],
  "install_guidance": {
    "plugin": "hlint",
    "binary": "hlint",
    "check": "which hlint",
    "install_steps": [
      "# Install hlint",
      "# See github.com/ndmitchell/hlint",
      "# apt: sudo apt-get install hlint",
      "# brew: brew install hlint",
      "# cargo: cargo install hlint",
      "# npm: npm install -g hlint",
      "# pip: pip install hlint"
    ]
  },
  "commands": [
    {
      "namespace": "hlint",
      "resource": "hlint",
      "action": "run",
      "description": "Run hlint",
      "adapter": "process",
      "adapterConfig": {
        "command": "hlint",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install hlint from github.com/ndmitchell/hlint"
      },
      "args": []
    }
  ]
}