{
  "name": "blbl",
  "version": "0.1.0",
  "description": "\u4e00\u4e2a\u4f7f\u7528\u539f\u751fAndroid\u5f00\u53d1\u7684\u54d4\u54e9\u54d4\u54e9\u5b89\u5353\u5ba2\u6237\u7aef\uff0c\u652f\u6301\u89e6\u6478\u3001\u9065\u63a7\uff0c\u4ee5\u53ca\u5b89\u53535",
  "source": "https://github.com/blbl/blbl",
  "checks": [
    {
      "type": "binary",
      "name": "blbl"
    }
  ],
  "install_guidance": {
    "plugin": "blbl",
    "binary": "blbl",
    "check": "which blbl",
    "install_steps": [
      "pip install blbl",
      "Verify: blbl --version",
      "supercli plugins install ./plugins/blbl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "blbl",
      "resource": "self",
      "action": "version",
      "description": "Print blbl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "blbl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install blbl: pip install blbl"
      },
      "args": []
    },
    {
      "namespace": "blbl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to blbl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "blbl",
        "passthrough": true,
        "missingDependencyHelp": "Install blbl: pip install blbl"
      },
      "args": []
    }
  ]
}