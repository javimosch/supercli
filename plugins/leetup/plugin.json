{
  "name": "leetup",
  "version": "0.1.0",
  "description": "Command-line tool to solve Leetcode problems",
  "source": "https://github.com/dragfire/leetup",
  "checks": [
    {
      "type": "binary",
      "name": "leetup"
    }
  ],
  "install_guidance": {
    "plugin": "leetup",
    "binary": "leetup",
    "check": "which leetup",
    "install_steps": [
      "brew install leetup",
      "Verify: leetup --version",
      "supercli plugins install ./plugins/leetup --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "leetup",
      "resource": "self",
      "action": "version",
      "description": "Print leetup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install leetup: brew install leetup"
      },
      "args": []
    },
    {
      "namespace": "leetup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leetup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetup",
        "passthrough": true,
        "missingDependencyHelp": "Install leetup"
      },
      "args": []
    }
  ]
}