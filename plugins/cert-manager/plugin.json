{
  "name": "cert-manager",
  "version": "0.1.0",
  "description": "Manage cert-manager resources on your Kubernetes cluster",
  "source": "https://github.com/cert-manager/cert-manager",
  "checks": [{ "type": "binary", "name": "cmctl" }],
  "install_guidance": {
    "plugin": "cert-manager",
    "binary": "cmctl",
    "check": "which cmctl",
    "install_steps": ["brew install cert-manager", "Verify: cmctl --version", "supercli plugins install ./plugins/cert-manager --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cert-manager",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cmctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cmctl",
      "passthrough": true,
      "missingDependencyHelp": "Install cert-manager: brew install cert-manager"
    },
    "args": []
  }]
}
