{
  "name": "mango",
  "version": "0.1.0",
  "description": "Practical and Powerful wayland compositor (dwm but wayland)",
  "source": "https://github.com/mango/mango",
  "checks": [
    {
      "type": "binary",
      "name": "mango"
    }
  ],
  "install_guidance": {
    "plugin": "mango",
    "binary": "mango",
    "check": "which mango",
    "install_steps": [
      "pip install mango",
      "Verify: mango --version",
      "supercli plugins install ./plugins/mango --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mango",
      "resource": "self",
      "action": "version",
      "description": "Print mango version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mango",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mango: pip install mango"
      },
      "args": []
    },
    {
      "namespace": "mango",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mango CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mango",
        "passthrough": true,
        "missingDependencyHelp": "Install mango: pip install mango"
      },
      "args": []
    }
  ]
}