{
  "name": "runst",
  "version": "1.0.0",
  "description": "runst \u2014 Notification daemon",
  "source": "crates.io/crates/runst",
  "checks": [
    {
      "type": "binary",
      "name": "runst"
    }
  ],
  "install_guidance": {
    "plugin": "runst",
    "binary": "runst",
    "check": "which runst",
    "install_steps": [
      "# Install runst:",
      "# apt: sudo apt-get install runst",
      "# brew: brew install runst",
      "# cargo: cargo install runst",
      "# npm: npm install -g runst",
      "# pip: pip install runst",
      "# or download from crates.io/crates/runst"
    ]
  },
  "commands": [
    {
      "namespace": "runst",
      "resource": "runst",
      "action": "run",
      "description": "Run runst",
      "adapter": "process",
      "adapterConfig": {
        "command": "runst",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install runst from crates.io/crates/runst"
      },
      "args": []
    }
  ]
}