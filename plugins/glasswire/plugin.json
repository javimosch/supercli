{
  "name": "glasswire",
  "version": "1.0.0",
  "description": "glasswire \u2014 Network monitor",
  "source": "glasswire.com",
  "checks": [
    {
      "type": "binary",
      "name": "glasswire"
    }
  ],
  "install_guidance": {
    "plugin": "glasswire",
    "binary": "glasswire",
    "check": "which glasswire",
    "install_steps": [
      "# Install glasswire",
      "# See glasswire.com",
      "# apt: sudo apt-get install glasswire",
      "# brew: brew install glasswire",
      "# cargo: cargo install glasswire",
      "# npm: npm install -g glasswire",
      "# pip: pip install glasswire"
    ]
  },
  "commands": [
    {
      "namespace": "glasswire",
      "resource": "glasswire",
      "action": "run",
      "description": "Run glasswire",
      "adapter": "process",
      "adapterConfig": {
        "command": "glasswire",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install glasswire from glasswire.com"
      },
      "args": []
    }
  ]
}