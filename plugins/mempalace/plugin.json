{
  "name": "mempalace",
  "version": "0.1.0",
  "description": "The best-benchmarked open-source AI memory system. And it's free.",
  "source": "https://github.com/mempalace/mempalace",
  "checks": [
    {
      "type": "binary",
      "name": "mempalace"
    }
  ],
  "install_guidance": {
    "plugin": "mempalace",
    "binary": "mempalace",
    "check": "which mempalace",
    "install_steps": [
      "pip install mempalace",
      "Verify: mempalace --version",
      "supercli plugins install ./plugins/mempalace --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mempalace",
      "resource": "self",
      "action": "version",
      "description": "Print mempalace version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mempalace",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mempalace: pip install mempalace"
      },
      "args": []
    },
    {
      "namespace": "mempalace",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mempalace CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mempalace",
        "passthrough": true,
        "missingDependencyHelp": "Install mempalace: pip install mempalace"
      },
      "args": []
    }
  ]
}