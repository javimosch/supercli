{
  "name": "doubledown",
  "version": "0.1.0",
  "description": "Sync local changes to a remote directory",
  "source": "https://github.com/devstructure/doubledown",
  "checks": [
    {
      "type": "binary",
      "name": "doubledown"
    }
  ],
  "install_guidance": {
    "plugin": "doubledown",
    "binary": "doubledown",
    "check": "which doubledown",
    "install_steps": [
      "brew install doubledown",
      "Verify: doubledown --version",
      "supercli plugins install ./plugins/doubledown --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "doubledown",
      "resource": "self",
      "action": "version",
      "description": "Print doubledown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doubledown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install doubledown: brew install doubledown"
      },
      "args": []
    },
    {
      "namespace": "doubledown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to doubledown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "doubledown",
        "passthrough": true,
        "missingDependencyHelp": "Install doubledown"
      },
      "args": []
    }
  ]
}