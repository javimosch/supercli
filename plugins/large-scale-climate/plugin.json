{
  "name": "large-scale-climate",
  "version": "0.1.0",
  "description": "Compute EOFS for 3D climate data",
  "source": "https://github.com/large-scale-climate/large-scale-climate",
  "checks": [
    {
      "type": "binary",
      "name": "large-scale-climate"
    }
  ],
  "install_guidance": {
    "plugin": "large-scale-climate",
    "binary": "large-scale-climate",
    "check": "which large-scale-climate",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: large-scale-climate --version",
      "supercli plugins install ./plugins/large-scale-climate --on-conflict replace --json"
    ],
    "note": "Jupyter Notebook language CLI tool"
  },
  "commands": [
    {
      "namespace": "large-scale-climate",
      "resource": "self",
      "action": "version",
      "description": "Print large-scale-climate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "large-scale-climate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install large-scale-climate from project repository"
      },
      "args": []
    },
    {
      "namespace": "large-scale-climate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to large-scale-climate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "large-scale-climate",
        "passthrough": true,
        "missingDependencyHelp": "Install large-scale-climate from project repository"
      },
      "args": []
    }
  ]
}