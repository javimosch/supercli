{
  "name": "nomad",
  "version": "0.1.0",
  "description": "Nomad — workload orchestrator across datacenters",
  "source": "https://github.com/hashicorp/nomad",
  "checks": [
    {
      "type": "binary",
      "name": "nomad"
    }
  ],
  "install_guidance": {
    "plugin": "nomad",
    "binary": "nomad",
    "check": "which nomad",
    "install_steps": [
      "brew tap hashicorp/tap && brew install hashicorp/tap/nomad",
      "Verify: nomad --version",
      "supercli plugins install ./plugins/nomad --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nomad",
      "resource": "self",
      "action": "version",
      "description": "Print nomad version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nomad",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install nomad: brew tap hashicorp/tap && brew install hashicorp/tap/nomad"
      },
      "args": []
    },
    {
      "namespace": "nomad",
      "resource": "cli",
      "action": "run",
      "description": "Nomad — workload orchestrator across datacenters",
      "adapter": "process",
      "adapterConfig": {
        "command": "nomad",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install nomad: brew tap hashicorp/tap && brew install hashicorp/tap/nomad"
      },
      "args": []
    }
  ]
}
