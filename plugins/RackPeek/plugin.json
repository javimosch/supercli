{
  "name": "RackPeek",
  "version": "0.1.0",
  "description": "CLI tool to discover, manage, and document your IT infrastructure",
  "source": "https://github.com/RackPeek/RackPeek",
  "checks": [
    {
      "type": "binary",
      "name": "rackpeek"
    }
  ],
  "install_guidance": {
    "plugin": "RackPeek",
    "binary": "rackpeek",
    "check": "which rackpeek",
    "install_steps": [
      "go install github.com/RackPeek/RackPeek@latest",
      "Verify: rackpeek --version",
      "supercli plugins install ./plugins/RackPeek --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RackPeek",
      "resource": "self",
      "action": "version",
      "description": "Print RackPeek version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rackpeek",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RackPeek: go install github.com/RackPeek/RackPeek@latest"
      },
      "args": []
    },
    {
      "namespace": "RackPeek",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rackpeek CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rackpeek",
        "passthrough": true,
        "missingDependencyHelp": "Install RackPeek: go install github.com/RackPeek/RackPeek@latest"
      },
      "args": []
    }
  ]
}