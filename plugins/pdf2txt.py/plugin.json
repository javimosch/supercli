{
  "name": "pdf2txt.py",
  "version": "0.1.0",
  "description": "CLI tool: pdf2txt.py",
  "source": "https://manpages.debian.org/pdf2txt.py",
  "checks": [
    {
      "type": "binary",
      "name": "pdf2txt.py"
    }
  ],
  "install_guidance": {
    "plugin": "pdf2txt.py",
    "binary": "pdf2txt.py",
    "check": "which pdf2txt.py",
    "install_steps": [
      "apt-get install pdf2txt.py 2>/dev/null || which pdf2txt.py",
      "Verify: pdf2txt.py --version",
      "supercli plugins install ./plugins/pdf2txt.py --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdf2txt.py",
      "resource": "self",
      "action": "version",
      "description": "Print pdf2txt.py version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdf2txt.py",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdf2txt.py: apt-get install pdf2txt.py 2>/dev/null || which pdf2txt.py"
      },
      "args": []
    },
    {
      "namespace": "pdf2txt.py",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdf2txt.py CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdf2txt.py",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdf2txt.py: apt-get install pdf2txt.py 2>/dev/null || which pdf2txt.py"
      },
      "args": []
    }
  ]
}