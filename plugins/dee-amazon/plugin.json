{
  "name": "dee-amazon",
  "version": "0.1.0",
  "description": "Search Amazon products via CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-amazon" }],
  "install_guidance": {
    "plugin": "dee-amazon",
    "binary": "dee-amazon",
    "check": "which dee-amazon",
    "install_steps": ["cargo install dee-amazon", "Verify: dee-amazon --version", "supercli plugins install ./plugins/dee-amazon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-amazon",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-amazon CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-amazon",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-amazon: cargo install dee-amazon"
    },
    "args": []
  }]
}
