{
  "name": "enjarify",
  "version": "0.1.0",
  "description": "Dalvik bytecode to Java bytecode converter",
  "source": "https://github.com/Storyyeller/enjarify",
  "checks": [
    {
      "type": "binary",
      "name": "enjarify"
    }
  ],
  "install_guidance": {
    "plugin": "enjarify",
    "binary": "enjarify",
    "check": "which enjarify",
    "install_steps": [
      "pip install enjarify",
      "Verify: enjarify --version",
      "supercli plugins install ./plugins/enjarify --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "enjarify",
      "resource": "self",
      "action": "version",
      "description": "Print enjarify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "enjarify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install enjarify: pip install enjarify"
      },
      "args": []
    },
    {
      "namespace": "enjarify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enjarify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enjarify",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install enjarify: pip install enjarify"
      },
      "args": []
    }
  ]
}
