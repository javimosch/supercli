{
  "name": "enjarify",
  "version": "0.1.0",
  "description": "enjarify — Java bytecode decompiler and analysis tool for Android APKs. Converts Dalvik bytecode (DEX) to Java bytecode (JAR) for easier analysis with standard Java decompilation tools. Supports multiple DEX files and obfuscated code.",
  "source": "https://github.com/Storyyeller/enjarify",
  "checks": [
    {
      "type": "binary",
      "name": "enjarify"
    }
  ],
  "install_guidance": {
    "plugin": "enjarify",
    "binary": "enjarify",
    "check": "which enjarify",
    "install_steps": [
      "pip install enjarify",
      "Verify: enjarify --version",
      "supercli plugins install ./plugins/enjarify --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "enjarify",
      "resource": "self",
      "action": "version",
      "description": "Print enjarify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "enjarify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install enjarify: pip install enjarify"
      },
      "args": []
    },
    {
      "namespace": "enjarify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enjarify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enjarify",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install enjarify: pip install enjarify"
      },
      "args": []
    }
  ]
}
