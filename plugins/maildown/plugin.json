{
  "name": "maildown",
  "version": "0.1.0",
  "description": "Super simple CLI for sending emails in Python",
  "source": "https://github.com/nicedoc/maildown",
  "checks": [
    {
      "type": "binary",
      "name": "maildown"
    }
  ],
  "install_guidance": {
    "plugin": "maildown",
    "binary": "maildown",
    "check": "which maildown",
    "install_steps": [
      "pip install maildown",
      "Verify: maildown --version",
      "supercli plugins install ./plugins/maildown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "maildown",
      "resource": "self",
      "action": "version",
      "description": "Print maildown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "maildown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install maildown: pip install maildown"
      },
      "args": []
    },
    {
      "namespace": "maildown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to maildown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "maildown",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install maildown: pip install maildown"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
