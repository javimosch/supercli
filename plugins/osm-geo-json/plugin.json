{
  "name": "osm-geo-json",
  "version": "0.1.0",
  "description": "Convert OpenStreetMap XML data to GeoJSON format",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "osm-geo-json" }],
  "install_guidance": {
    "plugin": "osm-geo-json",
    "binary": "osm-geo-json",
    "check": "which osm-geo-json",
    "install_steps": ["npm install -g osm-geo-json", "Verify: osm-geo-json --version", "supercli plugins install ./plugins/osm-geo-json --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "osm-geo-json",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to osm-geo-json CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "osm-geo-json",
      "passthrough": true,
      "missingDependencyHelp": "Install osm-geo-json: npm install -g osm-geo-json"
    },
    "args": []
  }]
}
