{
  "name": "at_spi",
  "version": "0.1.0",
  "description": "CLI tool: at_spi",
  "source": "https://packages.debian.org/at_spi",
  "checks": [{ "type": "binary", "name": "at_spi" }],
  "install_guidance": {
    "plugin": "at_spi", "binary": "at_spi", "check": "which at_spi",
    "install_steps": ["apt-get install at_spi 2>/dev/null || which at_spi", "Verify: at_spi --version", "supercli plugins install ./plugins/at_spi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_spi", "resource": "_", "action": "_",
    "description": "Passthrough to at_spi CLI",
    "adapter": "process", "adapterConfig": { "command": "at_spi", "passthrough": true, "missingDependencyHelp": "Install at_spi: apt-get install at_spi" }, "args": []
  }]
}
