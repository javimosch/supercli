{
  "name": "pkg-dir-cli",
  "version": "0.1.0",
  "description": "Find the root directory of a Node.js project",
  "source": "https://github.com/sindresorhus/pkg-dir-cli",
  "checks": [{ "type": "binary", "name": "pkg-dir-cli" }],
  "install_guidance": {
    "plugin": "pkg-dir-cli",
    "binary": "pkg-dir-cli",
    "check": "which pkg-dir-cli",
    "install_steps": ["npm install -g pkg-dir-cli", "Verify: pkg-dir-cli --version", "supercli plugins install ./plugins/pkg-dir-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pkg-dir-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pkg-dir-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pkg-dir-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install pkg-dir-cli: npm install -g pkg-dir-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
