{
  "name": "zensical",
  "version": "0.1.0",
  "description": "A modern static site generator by the Material for MkDocs team",
  "source": "https://github.com/zensical/zensical",
  "checks": [
    {
      "type": "binary",
      "name": "zensical"
    }
  ],
  "install_guidance": {
    "plugin": "zensical",
    "binary": "zensical",
    "check": "which zensical",
    "install_steps": [
      "pip install zensical",
      "Verify: zensical --version",
      "supercli plugins install ./plugins/zensical --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zensical",
      "resource": "self",
      "action": "version",
      "description": "Print zensical version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zensical",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zensical: pip install zensical"
      },
      "args": []
    },
    {
      "namespace": "zensical",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zensical CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zensical",
        "passthrough": true,
        "missingDependencyHelp": "Install zensical: pip install zensical"
      },
      "args": []
    }
  ]
}