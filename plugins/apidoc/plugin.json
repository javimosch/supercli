{
  "name": "apidoc",
  "version": "0.1.0",
  "description": "RESTful API documentation generator",
  "source": "https://github.com/apidoc/apidoc",
  "checks": [
    {
      "type": "binary",
      "name": "apidoc"
    }
  ],
  "install_guidance": {
    "plugin": "apidoc",
    "binary": "apidoc",
    "check": "which apidoc",
    "install_steps": [
      "npm install -g apidoc",
      "Verify: apidoc --version",
      "supercli plugins install ./plugins/apidoc --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "apidoc",
      "resource": "self",
      "action": "version",
      "description": "Print apidoc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "apidoc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install apidoc: npm install -g apidoc"
      },
      "args": []
    },
    {
      "namespace": "apidoc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to apidoc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "apidoc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install apidoc: npm install -g apidoc"
      },
      "args": []
    }
  ]
}
