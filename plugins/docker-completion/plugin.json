{
  "name": "docker-completion",
  "version": "0.1.0",
  "description": "Bash, Zsh and Fish completion for Docker",
  "checks": [
    {
      "type": "binary",
      "name": "docker-completion"
    }
  ],
  "install_guidance": {
    "plugin": "docker-completion",
    "binary": "docker-completion",
    "check": "which docker-completion",
    "install_steps": [
      "brew install docker-completion",
      "Verify: docker-completion --version",
      "supercli plugins install ./plugins/docker-completion --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "docker-completion",
      "resource": "self",
      "action": "version",
      "description": "Print docker-completion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-completion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-completion: brew install docker-completion"
      },
      "args": []
    },
    {
      "namespace": "docker-completion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-completion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-completion",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-completion"
      },
      "args": []
    }
  ]
}