{
  "name": "diatom",
  "version": "0.1.0",
  "description": "Text editor with the spirit of Acme and Sam",
  "source": "https://github.com/BillyDM/diatom",
  "checks": [{ "type": "binary", "name": "diatom" }],
  "install_guidance": {
    "plugin": "diatom",
    "binary": "diatom",
    "check": "which diatom",
    "install_steps": ["cargo install diatom", "Verify: diatom --version", "supercli plugins install ./plugins/diatom --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "diatom",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to diatom CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "diatom",
      "passthrough": true,
      "missingDependencyHelp": "Install diatom: cargo install diatom", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
