{
  "name": "vile",
  "version": "0.1.0",
  "description": "Vi-like Emacs-compatible text editor",
  "source": "https://invisible-island.net/vile/",
  "checks": [{ "type": "binary", "name": "vile" }],
  "install_guidance": {
    "plugin": "vile",
    "binary": "vile",
    "check": "which vile",
    "install_steps": ["brew install vile", "Verify: vile --version", "supercli plugins install ./plugins/vile --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vile",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vile CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vile",
      "passthrough": true,
      "missingDependencyHelp": "Install vile: brew install vile", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
