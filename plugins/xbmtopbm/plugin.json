      "description": "Print xbmtopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbmtopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xbmtopbm: apt-get install xbmtopbm 2>/dev/null || which xbmtopbm"
      },
      "args": []
    },
    {
      "namespace": "xbmtopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xbmtopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbmtopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xbmtopbm: apt-get install xbmtopbm 2>/dev/null || which xbmtopbm"
      },
      "args": []
    }
  ]
