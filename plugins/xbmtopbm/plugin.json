{
  "name": "xbmtopbm",
  "version": "0.1.0",
  "description": "CLI tool: xbmtopbm",
  "source": "https://manpages.debian.org/xbmtopbm",
  "checks": [
    {
      "type": "binary",
      "name": "xbmtopbm"
    }
  ],
  "install_guidance": {
    "plugin": "xbmtopbm",
    "binary": "xbmtopbm",
    "check": "which xbmtopbm",
    "install_steps": [
      "apt-get install xbmtopbm 2>/dev/null || which xbmtopbm",
      "Verify: xbmtopbm --version",
      "supercli plugins install ./plugins/xbmtopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
