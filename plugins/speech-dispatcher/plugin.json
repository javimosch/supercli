{
  "name": "speech-dispatcher",
  "version": "0.1.0",
  "description": "CLI tool: speech-dispatcher",
  "source": "https://manpages.debian.org/speech-dispatcher",
  "checks": [
    {
      "type": "binary",
      "name": "speech-dispatcher"
    }
  ],
  "install_guidance": {
    "plugin": "speech-dispatcher",
    "binary": "speech-dispatcher",
    "check": "which speech-dispatcher",
    "install_steps": [
      "apt-get install speech-dispatcher 2>/dev/null || which speech-dispatcher",
      "Verify: speech-dispatcher --version",
      "supercli plugins install ./plugins/speech-dispatcher --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "speech-dispatcher",
      "resource": "self",
      "action": "version",
      "description": "Print speech-dispatcher version",
      "adapter": "process",
      "adapterConfig": {
        "command": "speech-dispatcher",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install speech-dispatcher: apt-get install speech-dispatcher 2>/dev/null || which speech-dispatcher"
      },
      "args": []
    },
    {
      "namespace": "speech-dispatcher",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to speech-dispatcher CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "speech-dispatcher",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install speech-dispatcher: apt-get install speech-dispatcher 2>/dev/null || which speech-dispatcher"
      },
      "args": []
    }
  ]
}