{
  "name": "topnfiles",
  "version": "0.1.0",
  "description": "A CLI tool to find the newest or largest files in a directory tree. Quickly identifies space hogs and recently modified files for cleanup and auditing.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "topnfiles"
    }
  ],
  "install_guidance": {
    "plugin": "topnfiles",
    "binary": "topnfiles",
    "check": "which topnfiles",
    "install_steps": [
      "cargo install topnfiles",
      "Verify: topnfiles --version",
      "supercli plugins install ./plugins/topnfiles --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "topnfiles",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to topnfiles CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "topnfiles",
        "passthrough": true,
        "missingDependencyHelp": "Install topnfiles: cargo install topnfiles"
      },
      "args": []
    }
  ]
}
