{
  "name": "pg-migrate",
  "version": "0.1.0",
  "description": "A database migration CLI tool for Postgres",
  "source": "https://github.com/pg-migrate/pg-migrate",
  "checks": [
    {
      "type": "binary",
      "name": "pg-migrate"
    }
  ],
  "install_guidance": {
    "plugin": "pg-migrate",
    "binary": "pg-migrate",
    "check": "which pg-migrate",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: pg-migrate --version",
      "supercli plugins install ./plugins/pg-migrate --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "pg-migrate",
      "resource": "self",
      "action": "version",
      "description": "Print pg-migrate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg-migrate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pg-migrate from project repository"
      },
      "args": []
    },
    {
      "namespace": "pg-migrate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pg-migrate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg-migrate",
        "passthrough": true,
        "missingDependencyHelp": "Install pg-migrate from project repository"
      },
      "args": []
    }
  ]
}