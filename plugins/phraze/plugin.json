{
  "name": "phraze",
  "version": "0.1.0",
  "description": "Generate high-entropy random passphrases from the CLI",
  "source": "https://github.com/sts10/phraze",
  "checks": [{ "type": "binary", "name": "phraze" }],
  "install_guidance": {
    "plugin": "phraze",
    "binary": "phraze",
    "check": "which phraze",
    "install_steps": ["cargo install phraze", "Verify: phraze --version", "supercli plugins install ./plugins/phraze --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "phraze",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to phraze CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "phraze",
      "passthrough": true,
      "missingDependencyHelp": "Install phraze: cargo install phraze"
    },
    "args": []
  }]
}
