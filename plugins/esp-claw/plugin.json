{
  "name": "esp-claw",
  "version": "0.1.0",
  "description": "ESP-Claw, a \"Chat Coding\" AI agent framework for IoT devices",
  "source": "https://github.com/esp-claw/esp-claw",
  "checks": [
    {
      "type": "binary",
      "name": "esp-claw"
    }
  ],
  "install_guidance": {
    "plugin": "esp-claw",
    "binary": "esp-claw",
    "check": "which esp-claw",
    "install_steps": [
      "pip install esp-claw",
      "Verify: esp-claw --version",
      "supercli plugins install ./plugins/esp-claw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "esp-claw",
      "resource": "self",
      "action": "version",
      "description": "Print esp-claw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "esp-claw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install esp-claw: pip install esp-claw"
      },
      "args": []
    },
    {
      "namespace": "esp-claw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to esp-claw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "esp-claw",
        "passthrough": true,
        "missingDependencyHelp": "Install esp-claw: pip install esp-claw"
      },
      "args": []
    }
  ]
}