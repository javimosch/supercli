{
  "name": "OpenShell",
  "version": "0.1.0",
  "description": "OpenShell is the safe, private runtime for autonomous AI agents.",
  "source": "https://github.com/OpenShell/OpenShell",
  "checks": [
    {
      "type": "binary",
      "name": "openshell"
    }
  ],
  "install_guidance": {
    "plugin": "OpenShell",
    "binary": "openshell",
    "check": "which openshell",
    "install_steps": [
      "pip install openshell",
      "Verify: openshell --version",
      "supercli plugins install ./plugins/OpenShell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenShell",
      "resource": "self",
      "action": "version",
      "description": "Print OpenShell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openshell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenShell: pip install openshell"
      },
      "args": []
    },
    {
      "namespace": "OpenShell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openshell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openshell",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenShell: pip install openshell"
      },
      "args": []
    }
  ]
}