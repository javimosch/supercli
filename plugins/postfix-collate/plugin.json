{
  "name": "postfix-collate",
  "version": "1.0.0",
  "description": "postfix-collate \u2014 postfix-collate \u2014 CLI utility",
  "source": "/usr/sbin/postfix-collate",
  "checks": [
    {
      "type": "binary",
      "name": "postfix-collate"
    }
  ],
  "install_guidance": {
    "plugin": "postfix-collate",
    "binary": "postfix-collate",
    "check": "which postfix-collate",
    "install_steps": [
      "# Install postfix-collate:",
      "# apt: sudo apt-get install postfix-collate",
      "# brew: brew install postfix-collate",
      "# cargo: cargo install postfix-collate",
      "# npm: npm install -g postfix-collate",
      "# pip: pip install postfix-collate",
      "# or download from /usr/sbin/postfix-collate"
    ]
  },
  "commands": [
    {
      "namespace": "postfix",
      "resource": "collate",
      "action": "run",
      "description": "Run postfix-collate",
      "adapter": "process",
      "adapterConfig": {
        "command": "postfix-collate",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postfix-collate from /usr/sbin/postfix-collate"
      },
      "args": []
    }
  ]
}