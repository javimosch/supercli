{
  "plugin": "postfix-collate",
  "binary": "postfix-collate",
  "check": "which postfix-collate",
  "install_steps": [
    "# Install postfix-collate",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/postfix-collate-linux-amd64 -o /usr/local/bin/postfix-collate",
