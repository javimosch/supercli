{
  "name": "escapesrc",
  "version": "0.1.0",
  "description": "CLI tool: escapesrc",
  "source": "https://manpages.debian.org/escapesrc",
  "checks": [
    {
      "type": "binary",
      "name": "escapesrc"
    }
  ],
  "install_guidance": {
    "plugin": "escapesrc",
    "binary": "escapesrc",
    "check": "which escapesrc",
    "install_steps": [
      "apt-get install escapesrc 2>/dev/null || which escapesrc",
      "Verify: escapesrc --version",
      "supercli plugins install ./plugins/escapesrc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "escapesrc",
      "resource": "self",
      "action": "version",
      "description": "Print escapesrc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "escapesrc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install escapesrc: apt-get install escapesrc 2>/dev/null || which escapesrc"
      },
      "args": []
    },
    {
      "namespace": "escapesrc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to escapesrc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "escapesrc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install escapesrc: apt-get install escapesrc 2>/dev/null || which escapesrc"
      },
      "args": []
    }
  ]
}