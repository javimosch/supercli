{
  "name": "zig2nix",
  "version": "0.1.0",
  "description": "Flake for packaging, building and running Zig projects.",
  "source": "https://github.com/zig2nix/zig2nix",
  "checks": [
    {
      "type": "binary",
      "name": "zig2nix"
    }
  ],
  "install_guidance": {
    "plugin": "zig2nix",
    "binary": "zig2nix",
    "check": "which zig2nix",
    "install_steps": [
      "pip install zig2nix",
      "Verify: zig2nix --version",
      "supercli plugins install ./plugins/zig2nix --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig2nix",
      "resource": "self",
      "action": "version",
      "description": "Print zig2nix version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig2nix",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig2nix: pip install zig2nix"
      },
      "args": []
    },
    {
      "namespace": "zig2nix",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig2nix CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig2nix",
        "passthrough": true,
        "missingDependencyHelp": "Install zig2nix: pip install zig2nix"
      },
      "args": []
    }
  ]
}