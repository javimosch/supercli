{
  "name": "prime-rs",
  "version": "0.1.0",
  "description": "Find prime numbers up to a specified limit",
  "source": "https://github.com/phil-opp/prime-rs",
  "checks": [{ "type": "binary", "name": "prime-rs" }],
  "install_guidance": {
    "plugin": "prime-rs",
    "binary": "prime-rs",
    "check": "which prime-rs",
    "install_steps": ["cargo install prime-rs", "Verify: prime-rs --version", "supercli plugins install ./plugins/prime-rs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "prime-rs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to prime-rs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "prime-rs",
      "passthrough": true,
      "missingDependencyHelp": "Install prime-rs: cargo install prime-rs", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
