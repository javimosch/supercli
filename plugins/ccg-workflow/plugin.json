{
  "name": "ccg-workflow",
  "version": "0.1.0",
  "description": "\u591a\u6a21\u578b\u534f\u4f5c\u5de5\u4f5c\u6d41\u5f15\u64ce \u2014 /ccg:go \u4e00\u4e2a\u547d\u4ee4\uff0cAI \u81ea\u52a8\u5206\u6790\u610f\u56fe\u3001\u9009\u62e9\u7b56\u7565\u3001\u7f16\u6392 Codex + Gemini + Claude \u534f\u4f5c\u6267\u884c",
  "source": "https://github.com/ccg-workflow/ccg-workflow",
  "checks": [
    {
      "type": "binary",
      "name": "ccg-workflow"
    }
  ],
  "install_guidance": {
    "plugin": "ccg-workflow",
    "binary": "ccg-workflow",
    "check": "which ccg-workflow",
    "install_steps": [
      "pip install ccg-workflow",
      "Verify: ccg-workflow --version",
      "supercli plugins install ./plugins/ccg-workflow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ccg-workflow",
      "resource": "self",
      "action": "version",
      "description": "Print ccg-workflow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccg-workflow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ccg-workflow: pip install ccg-workflow"
      },
      "args": []
    },
    {
      "namespace": "ccg-workflow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ccg-workflow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ccg-workflow",
        "passthrough": true,
        "missingDependencyHelp": "Install ccg-workflow: pip install ccg-workflow"
      },
      "args": []
    }
  ]
}