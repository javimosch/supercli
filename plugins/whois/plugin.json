{
  "name": "whois",
  "version": "0.1.0",
  "description": "Domain registration lookup and ownership information",
  "source": "https",
  "checks": [{"type": "binary", "name": "whois"}],
  "install_guidance": {
    "plugin": "whois",
    "binary": "whois",
    "check": "which whois",
    "install_steps": [
      "brew install whois",
      "Verify: whois --version",
      "supercli plugins install ./plugins/whois --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "whois",
      "resource": "self",
      "action": "version",
      "description": "Print whois version",
      "adapter": "process",
      "adapterConfig": {"command": "whois", "baseArgs": ["--version"], "missingDependencyHelp": "Install whois: brew install whois"},
      "args": []
    },
    {
      "namespace": "whois",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to whois CLI",
      "adapter": "process",
      "adapterConfig": {"command": "whois", "passthrough": true, "missingDependencyHelp": "Install whois: brew install whois"},
      "args": []
    }
  ]
}
