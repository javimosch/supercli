{
  "name": "dv2dt",
  "version": "0.1.0",
  "description": "CLI tool: dv2dt",
  "source": "https://manpages.debian.org/dv2dt",
  "checks": [
    {
      "type": "binary",
      "name": "dv2dt"
    }
  ],
  "install_guidance": {
    "plugin": "dv2dt",
    "binary": "dv2dt",
    "check": "which dv2dt",
    "install_steps": [
      "apt-get install dv2dt 2>/dev/null || which dv2dt",
      "Verify: dv2dt --version",
      "supercli plugins install ./plugins/dv2dt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dv2dt",
      "resource": "self",
      "action": "version",
      "description": "Print dv2dt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dv2dt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dv2dt: apt-get install dv2dt 2>/dev/null || which dv2dt"
      },
      "args": []
    },
    {
      "namespace": "dv2dt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dv2dt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dv2dt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dv2dt: apt-get install dv2dt 2>/dev/null || which dv2dt"
      },
      "args": []
    }
  ]
}