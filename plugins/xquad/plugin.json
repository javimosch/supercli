{
  "name": "xquad",
  "version": "0.1.0",
  "description": "A rust implementation of the Quip Network's quantum virtual machine.",
  "source": "https://github.com/xquad/xquad",
  "checks": [
    {
      "type": "binary",
      "name": "xquad"
    }
  ],
  "install_guidance": {
    "plugin": "xquad",
    "binary": "xquad",
    "check": "which xquad",
    "install_steps": [
      "pip install xquad",
      "Verify: xquad --version",
      "supercli plugins install ./plugins/xquad --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xquad",
      "resource": "self",
      "action": "version",
      "description": "Print xquad version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xquad",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xquad: pip install xquad"
      },
      "args": []
    },
    {
      "namespace": "xquad",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xquad CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xquad",
        "passthrough": true,
        "missingDependencyHelp": "Install xquad: pip install xquad"
      },
      "args": []
    }
  ]
}