{
  "name": "event-stream-client",
  "version": "0.1.0",
  "description": "Deprecated! Use the rdf-connect/ldes-client instead",
  "source": "https://github.com/rdf-connect/ldes-client",
  "checks": [
    {
      "type": "binary",
      "name": "event-stream-client"
    }
  ],
  "install_guidance": {
    "plugin": "event-stream-client",
    "binary": "event-stream-client",
    "check": "which event-stream-client",
    "install_steps": [
      "Check https://github.com/rdf-connect/ldes-client for installation instructions",
      "Verify: event-stream-client --version",
      "supercli plugins install ./plugins/event-stream-client --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "event-stream-client",
      "resource": "self",
      "action": "version",
      "description": "Print event-stream-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "event-stream-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install event-stream-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "event-stream-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to event-stream-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "event-stream-client",
        "passthrough": true,
        "missingDependencyHelp": "Install event-stream-client from project repository"
      },
      "args": []
    }
  ]
}