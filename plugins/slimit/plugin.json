{
  "name": "slimit",
  "version": "0.1.0",
  "description": "JavaScript minifier written in pure Python",
  "source": "https://github.com/rspivak/slimit",
  "checks": [{ "type": "binary", "name": "slimit" }],
  "install_guidance": {
    "plugin": "slimit",
    "binary": "slimit",
    "check": "which slimit",
    "install_steps": ["pip install slimit", "Verify: slimit --version", "supercli plugins install ./plugins/slimit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "slimit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to slimit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "slimit",
      "passthrough": true,
      "missingDependencyHelp": "Install slimit: pip install slimit", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
