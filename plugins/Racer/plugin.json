{
  "name": "Racer",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/Racer/Racer",
  "checks": [
    {
      "type": "binary",
      "name": "racer"
    }
  ],
  "install_guidance": {
    "plugin": "Racer",
    "binary": "racer",
    "check": "which racer",
    "install_steps": [
      "pip install racer",
      "Verify: racer --version",
      "supercli plugins install ./plugins/Racer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Racer",
      "resource": "self",
      "action": "version",
      "description": "Print Racer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "racer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Racer: pip install racer"
      },
      "args": []
    },
    {
      "namespace": "Racer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to racer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "racer",
        "passthrough": true,
        "missingDependencyHelp": "Install Racer: pip install racer"
      },
      "args": []
    }
  ]
}