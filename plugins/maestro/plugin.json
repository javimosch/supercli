{
  "name": "maestro",
  "version": "0.1.0",
  "description": "Maestro: Netflix\u2019s Workflow Orchestrator",
  "source": "https://github.com/maestro/maestro",
  "checks": [
    {
      "type": "binary",
      "name": "maestro"
    }
  ],
  "install_guidance": {
    "plugin": "maestro",
    "binary": "maestro",
    "check": "which maestro",
    "install_steps": [
      "pip install maestro",
      "Verify: maestro --version",
      "supercli plugins install ./plugins/maestro --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "maestro",
      "resource": "self",
      "action": "version",
      "description": "Print maestro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "maestro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install maestro: pip install maestro"
      },
      "args": []
    },
    {
      "namespace": "maestro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to maestro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "maestro",
        "passthrough": true,
        "missingDependencyHelp": "Install maestro: pip install maestro"
      },
      "args": []
    }
  ]
}