{
  "name": "kuttl",
  "version": "0.1.0",
  "description": "KUbernetes Test TooL",
  "source": "https://github.com/kudobuilder/kuttl",
  "checks": [
    {
      "type": "binary",
      "name": "kuttl"
    }
  ],
  "install_guidance": {
    "plugin": "kuttl",
    "binary": "kuttl",
    "check": "which kuttl",
    "install_steps": [
      "brew install kuttl",
      "Verify: kuttl --version",
      "supercli plugins install ./plugins/kuttl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kuttl",
      "resource": "self",
      "action": "version",
      "description": "Print kuttl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuttl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kuttl: brew install kuttl"
      },
      "args": []
    },
    {
      "namespace": "kuttl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kuttl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuttl",
        "passthrough": true,
        "missingDependencyHelp": "Install kuttl"
      },
      "args": []
    }
  ]
}