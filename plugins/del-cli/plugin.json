{
  "name": "del-cli",
  "version": "0.1.0",
  "description": "Delete files and folders",
  "source": "https://github.com/sindresorhus/del-cli",
  "checks": [
    {
      "type": "binary",
      "name": "del-cli"
    }
  ],
  "install_guidance": {
    "plugin": "del-cli",
    "binary": "del-cli",
    "check": "which del-cli",
    "install_steps": [
      "See https://github.com/sindresorhus/del-cli",
      "Verify: del-cli --version",
      "supercli plugins install ./plugins/del-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "del-cli",
      "resource": "self",
      "action": "version",
      "description": "Print del-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "del-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install del-cli: See https://github.com/sindresorhus/del-cli"
      },
      "args": []
    },
    {
      "namespace": "del-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to del-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "del-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install del-cli"
      },
      "args": []
    }
  ]
}