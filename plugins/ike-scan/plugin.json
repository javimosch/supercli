{
  "name": "ike-scan",
  "version": "0.1.0",
  "description": "Discover and fingerprint IKE hosts",
  "source": "https://github.com/royhills/ike-scan",
  "checks": [
    {
      "type": "binary",
      "name": "ike-scan"
    }
  ],
  "install_guidance": {
    "plugin": "ike-scan",
    "binary": "ike-scan",
    "check": "which ike-scan",
    "install_steps": [
      "brew install ike-scan",
      "Verify: ike-scan --version",
      "supercli plugins install ./plugins/ike-scan --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ike-scan",
      "resource": "self",
      "action": "version",
      "description": "Print ike-scan version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ike-scan",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ike-scan: brew install ike-scan"
      },
      "args": []
    },
    {
      "namespace": "ike-scan",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ike-scan CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ike-scan",
        "passthrough": true,
        "missingDependencyHelp": "Install ike-scan"
      },
      "args": []
    }
  ]
}