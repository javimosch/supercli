{
  "name": "litt",
  "version": "0.1.0",
  "description": "Low-intrusion time tracking in Python",
  "source": "https://github.com/nicedoc/litt",
  "checks": [
    {
      "type": "binary",
      "name": "litt"
    }
  ],
  "install_guidance": {
    "plugin": "litt",
    "binary": "litt",
    "check": "which litt",
    "install_steps": [
      "pip install litt",
      "Verify: litt --version",
      "supercli plugins install ./plugins/litt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "litt",
      "resource": "self",
      "action": "version",
      "description": "Print litt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "litt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install litt: pip install litt"
      },
      "args": []
    },
    {
      "namespace": "litt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to litt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "litt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install litt: pip install litt"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
