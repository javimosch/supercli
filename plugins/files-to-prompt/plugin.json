{
  "name": "files-to-prompt",
  "version": "0.1.0",
  "description": "Concatenate files into a single prompt",
  "source": "https://github.com/simonw/files-to-prompt",
  "checks": [{ "type": "binary", "name": "files-to-prompt" }],
  "install_guidance": {
    "plugin": "files-to-prompt",
    "binary": "files-to-prompt",
    "check": "which files-to-prompt",
    "install_steps": ["pip install files-to-prompt", "Verify: files-to-prompt --version", "supercli plugins install ./plugins/files-to-prompt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "files-to-prompt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to files-to-prompt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "files-to-prompt",
      "passthrough": true,
      "missingDependencyHelp": "Install files-to-prompt: pip install files-to-prompt", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
