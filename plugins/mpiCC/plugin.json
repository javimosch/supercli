{
  "name": "mpiCC",
  "version": "0.1.0",
  "description": "CLI tool: mpiCC",
  "source": "https://manpages.debian.org/mpiCC",
  "checks": [
    {
      "type": "binary",
      "name": "mpiCC"
    }
  ],
  "install_guidance": {
    "plugin": "mpiCC",
    "binary": "mpiCC",
    "check": "which mpiCC",
    "install_steps": [
      "apt-get install mpiCC 2>/dev/null || which mpiCC",
      "Verify: mpiCC --version",
      "supercli plugins install ./plugins/mpiCC --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpiCC",
      "resource": "self",
      "action": "version",
      "description": "Print mpiCC version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpiCC",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpiCC: apt-get install mpiCC 2>/dev/null || which mpiCC"
      },
      "args": []
    },
    {
      "namespace": "mpiCC",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpiCC CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpiCC",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mpiCC: apt-get install mpiCC 2>/dev/null || which mpiCC"
      },
      "args": []
    }
  ]
}