{
  "name": "gstack",
  "version": "0.1.0",
  "description": "Use Garry Tan's exact Claude Code setup: 23 opinionated tools that serve as CEO, Designer, Eng Manag",
  "source": "https://github.com/gstack/gstack",
  "checks": [
    {
      "type": "binary",
      "name": "gstack"
    }
  ],
  "install_guidance": {
    "plugin": "gstack",
    "binary": "gstack",
    "check": "which gstack",
    "install_steps": [
      "pip install gstack",
      "Verify: gstack --version",
      "supercli plugins install ./plugins/gstack --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gstack",
      "resource": "self",
      "action": "version",
      "description": "Print gstack version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gstack",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gstack: pip install gstack"
      },
      "args": []
    },
    {
      "namespace": "gstack",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gstack CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gstack",
        "passthrough": true,
        "missingDependencyHelp": "Install gstack: pip install gstack"
      },
      "args": []
    }
  ]
}