{
  "name": "amqp-client.cr",
  "version": "0.1.0",
  "description": "An AMQP 0-9-1 client for Crystal",
  "source": "https://cloudamqp.github.io/amqp-client.cr/",
  "checks": [
    {
      "type": "binary",
      "name": "amqp-client.cr"
    }
  ],
  "install_guidance": {
    "plugin": "amqp-client.cr",
    "binary": "amqp-client.cr",
    "check": "which amqp-client.cr",
    "install_steps": [
      "Check https://cloudamqp.github.io/amqp-client.cr/ for installation instructions",
      "Verify: amqp-client.cr --version",
      "supercli plugins install ./plugins/amqp-client.cr --on-conflict replace --json"
    ],
    "note": "Crystal language CLI tool"
  },
  "commands": [
    {
      "namespace": "amqp-client.cr",
      "resource": "self",
      "action": "version",
      "description": "Print amqp-client.cr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "amqp-client.cr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install amqp-client.cr from project repository"
      },
      "args": []
    },
    {
      "namespace": "amqp-client.cr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to amqp-client.cr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "amqp-client.cr",
        "passthrough": true,
        "missingDependencyHelp": "Install amqp-client.cr from project repository"
      },
      "args": []
    }
  ]
}