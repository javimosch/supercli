{
  "name": "dockutil",
  "version": "0.1.0",
  "description": "Tool for managing dock items",
  "source": "https://github.com/kcrawford/dockutil",
  "checks": [
    {
      "type": "binary",
      "name": "dockutil"
    }
  ],
  "install_guidance": {
    "plugin": "dockutil",
    "binary": "dockutil",
    "check": "which dockutil",
    "install_steps": [
      "brew install dockutil",
      "Verify: dockutil --version",
      "supercli plugins install ./plugins/dockutil --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dockutil",
      "resource": "self",
      "action": "version",
      "description": "Print dockutil version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockutil",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dockutil: brew install dockutil"
      },
      "args": []
    },
    {
      "namespace": "dockutil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dockutil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockutil",
        "passthrough": true,
        "missingDependencyHelp": "Install dockutil"
      },
      "args": []
    }
  ]
}