{
  "name": "setfacl",
  "version": "0.1.0",
  "description": "CLI tool: setfacl",
  "source": "https://manpages.debian.org/setfacl",
  "checks": [
    {
      "type": "binary",
      "name": "setfacl"
    }
  ],
  "install_guidance": {
    "plugin": "setfacl",
    "binary": "setfacl",
    "check": "which setfacl",
    "install_steps": [
      "apt-get install setfacl 2>/dev/null || which setfacl",
      "Verify: setfacl --version",
      "supercli plugins install ./plugins/setfacl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "setfacl",
      "resource": "self",
      "action": "version",
      "description": "Print setfacl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "setfacl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install setfacl: apt-get install setfacl 2>/dev/null || which setfacl"
      },
      "args": []
    },
    {
      "namespace": "setfacl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to setfacl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "setfacl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install setfacl: apt-get install setfacl 2>/dev/null || which setfacl"
      },
      "args": []
    }
  ]
}