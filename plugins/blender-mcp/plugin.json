{
  "name": "blender-mcp",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/blender-mcp/blender-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "blender-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "blender-mcp",
    "binary": "blender-mcp",
    "check": "which blender-mcp",
    "install_steps": [
      "pip install blender-mcp",
      "Verify: blender-mcp --version",
      "supercli plugins install ./plugins/blender-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "blender-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print blender-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "blender-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install blender-mcp: pip install blender-mcp"
      },
      "args": []
    },
    {
      "namespace": "blender-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to blender-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "blender-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install blender-mcp: pip install blender-mcp"
      },
      "args": []
    }
  ]
}