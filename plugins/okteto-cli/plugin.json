{
  "name": "okteto-cli",
  "version": "0.1.0",
  "description": "Cloud-native development environments CLI for Kubernetes",
  "source": " sh",
  "checks": [{ "type": "binary", "name": "okteto-cli" }],
  "install_guidance": {
    "plugin": "okteto-cli",
    "binary": "okteto-cli",
    "check": "which okteto-cli",
    "install_steps": ["curl https://get.okteto.com -sSfL ", "Verify: okteto-cli --version", "supercli plugins install ./plugins/okteto-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "okteto-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to okteto-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "okteto-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install okteto-cli: curl https://get.okteto.com -sSfL "
    },
    "args": []
  }]
}
