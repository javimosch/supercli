{
  "name": "glyphance",
  "version": "0.1.0",
  "description": "Generate font subsets based on specific Unicode ranges",
  "source": "https://github.com/cupcakearmy/glyphance",
  "checks": [{ "type": "binary", "name": "glyphance" }],
  "install_guidance": {
    "plugin": "glyphance",
    "binary": "glyphance",
    "check": "which glyphance",
    "install_steps": ["npm install glyphance", "Verify: glyphance --version", "supercli plugins install ./plugins/glyphance --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "glyphance",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to glyphance CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "glyphance",
      "passthrough": true,
      "missingDependencyHelp": "Install glyphance: npm install glyphance", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
