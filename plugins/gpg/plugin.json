{
  "name": "gpg",
  "version": "0.1.0",
  "description": "GNU Privacy Guard encryption and signing tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "gpg"}],
  "install_guidance": {
    "plugin": "gpg",
    "binary": "gpg",
    "check": "which gpg",
    "install_steps": [
      "brew install gpg",
      "Verify: gpg --version",
      "supercli plugins install ./plugins/gpg --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "gpg",
      "resource": "self",
      "action": "version",
      "description": "Print gpg version",
      "adapter": "process",
      "adapterConfig": {"command": "gpg", "baseArgs": ["--version"], "missingDependencyHelp": "Install gpg: brew install gpg"},
      "args": []
    },
    {
      "namespace": "gpg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpg CLI",
      "adapter": "process",
      "adapterConfig": {"command": "gpg", "passthrough": true, "missingDependencyHelp": "Install gpg: brew install gpg"},
      "args": []
    }
  ]
}
