{
  "name": "datetime-mate",
  "version": "0.1.0",
  "description": "Golang CLI to compute differences between dates, times, or durations",
  "source": "https://github.com/datetime-mate/datetime-mate",
  "checks": [
    {
      "type": "binary",
      "name": "datetime-mate"
    }
  ],
  "install_guidance": {
    "plugin": "datetime-mate",
    "binary": "datetime-mate",
    "check": "which datetime-mate",
    "install_steps": [
      "go install github.com/datetime-mate/datetime-mate@latest",
      "Verify: datetime-mate --version",
      "supercli plugins install ./plugins/datetime-mate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "datetime-mate",
      "resource": "self",
      "action": "version",
      "description": "Print datetime-mate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "datetime-mate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install datetime-mate: go install github.com/datetime-mate/datetime-mate@latest"
      },
      "args": []
    },
    {
      "namespace": "datetime-mate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to datetime-mate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "datetime-mate",
        "passthrough": true,
        "missingDependencyHelp": "Install datetime-mate: go install github.com/datetime-mate/datetime-mate@latest"
      },
      "args": []
    }
  ]
}
