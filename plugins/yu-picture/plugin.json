{
  "name": "yu-picture",
  "version": "0.1.0",
  "description": "\u7f16\u7a0b\u5bfc\u822a\u7684\u65b0\u9879\u76ee\uff0c\u57fa\u4e8e Vue 3 + Spring Boot + COS + WebSocket \u7684\u4f01\u4e1a\u7ea7\u667a\u80fd\u534f\u540c\u4e91\u56fe\u5e93\u5e73\u53f0\u3002\u9879\u76ee\u5e94\u7528\u573a\u666f\u5e7f\u6cdb\uff0c\u53ef\u4f5c\u4e3a\u8868\u60c5\u5305\u7f51\u7ad9\u3001\u8bbe\u8ba1\u7d20\u6750\u7f51\u7ad9\u3001\u58c1\u7eb8\u7f51\u7ad9\u3001\u4e2a\u4eba\u4e91\u76d8\u3001\u4f01",
  "source": "https://github.com/yu-picture/yu-picture",
  "checks": [
    {
      "type": "binary",
      "name": "yu-picture"
    }
  ],
  "install_guidance": {
    "plugin": "yu-picture",
    "binary": "yu-picture",
    "check": "which yu-picture",
    "install_steps": [
      "pip install yu-picture",
      "Verify: yu-picture --version",
      "supercli plugins install ./plugins/yu-picture --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yu-picture",
      "resource": "self",
      "action": "version",
      "description": "Print yu-picture version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yu-picture",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yu-picture: pip install yu-picture"
      },
      "args": []
    },
    {
      "namespace": "yu-picture",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yu-picture CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yu-picture",
        "passthrough": true,
        "missingDependencyHelp": "Install yu-picture: pip install yu-picture"
      },
      "args": []
    }
  ]
}