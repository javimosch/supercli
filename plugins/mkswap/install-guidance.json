{
  "plugin": "mkswap",
  "binary": "mkswap",
  "check": "which mkswap",
  "install_steps": [
    "# Install mkswap",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/mkswap-linux-amd64 -o /usr/local/bin/mkswap",
    "chmod +x /usr/local/bin/mkswap",
    "# Or via package manager, see /usr/sbin/mkswap"
  ]
}