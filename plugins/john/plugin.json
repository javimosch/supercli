{
  "name": "john",
  "version": "0.1.0",
  "description": "Password cracking and security auditing",
  "source": "https",
  "checks": [{"type": "binary", "name": "john"}],
  "install_guidance": {
    "plugin": "john",
    "binary": "john",
    "check": "which john",
    "install_steps": [
      "brew install john",
      "Verify: john --version",
      "supercli plugins install ./plugins/john --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "john",
      "resource": "self",
      "action": "version",
      "description": "Print john version",
      "adapter": "process",
      "adapterConfig": {"command": "john", "baseArgs": ["--version"], "missingDependencyHelp": "Install john: brew install john"},
      "args": []
    },
    {
      "namespace": "john",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to john CLI",
      "adapter": "process",
      "adapterConfig": {"command": "john", "passthrough": true, "missingDependencyHelp": "Install john: brew install john"},
      "args": []
    }
  ]
}
