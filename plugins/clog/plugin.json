{
  "name": "clog",
  "version": "0.1.0",
  "description": "Changelog generator from git metadata with conventional commits",
  "source": "https://github.com/clog-tool/clog-cli",
  "checks": [{ "type": "binary", "name": "clog" }],
  "install_guidance": {
    "plugin": "clog",
    "binary": "clog",
    "check": "which clog",
    "install_steps": ["cargo install clog-cli", "Verify: clog --version", "supercli plugins install ./plugins/clog --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clog",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clog CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clog",
      "passthrough": true,
      "missingDependencyHelp": "Install clog: cargo install clog-cli"
    },
    "args": []
  }]
}
