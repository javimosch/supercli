{
  "name": "digdag",
  "version": "0.1.0",
  "description": "CLI tool: digdag",
  "source": "https://packages.debian.org/digdag",
  "checks": [{ "type": "binary", "name": "digdag" }],
  "install_guidance": {
    "plugin": "digdag", "binary": "digdag", "check": "which digdag",
    "install_steps": ["apt-get install digdag 2>/dev/null || which digdag", "Verify: digdag --version", "supercli plugins install ./plugins/digdag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "digdag", "resource": "_", "action": "_",
    "description": "Passthrough to digdag CLI",
    "adapter": "process", "adapterConfig": { "command": "digdag", "passthrough": true, "missingDependencyHelp": "Install digdag: apt-get install digdag" }, "args": []
  }]
}
