{
  "name": "protonvpn-app",
  "version": "0.1.0",
  "description": "CLI tool: protonvpn-app",
  "source": "https://manpages.debian.org/protonvpn-app",
  "checks": [
    {
      "type": "binary",
      "name": "protonvpn-app"
    }
  ],
  "install_guidance": {
    "plugin": "protonvpn-app",
    "binary": "protonvpn-app",
    "check": "which protonvpn-app",
    "install_steps": [
      "apt-get install protonvpn-app 2>/dev/null || which protonvpn-app",
      "Verify: protonvpn-app --version",
      "supercli plugins install ./plugins/protonvpn-app --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "protonvpn-app",
      "resource": "self",
      "action": "version",
      "description": "Print protonvpn-app version",
      "adapter": "process",
      "adapterConfig": {
        "command": "protonvpn-app",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install protonvpn-app: apt-get install protonvpn-app 2>/dev/null || which protonvpn-app"
      },
      "args": []
    },
    {
      "namespace": "protonvpn-app",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to protonvpn-app CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "protonvpn-app",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install protonvpn-app: apt-get install protonvpn-app 2>/dev/null || which protonvpn-app"
      },
      "args": []
    }
  ]
}