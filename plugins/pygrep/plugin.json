{
  "name": "pygrep",
  "version": "0.1.0",
  "description": "Grep for Python code patterns using AST matching",
  "source": "https://github.com/asottile/pygrep",
  "checks": [{ "type": "binary", "name": "pygrep" }],
  "install_guidance": {
    "plugin": "pygrep",
    "binary": "pygrep",
    "check": "which pygrep",
    "install_steps": ["pip install pygrep", "Verify: pygrep --version", "supercli plugins install ./plugins/pygrep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pygrep",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pygrep CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pygrep",
      "passthrough": true,
      "missingDependencyHelp": "Install pygrep: pip install pygrep", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
