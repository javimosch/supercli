{
  "name": "rcm",
  "version": "0.1.0",
  "description": "Rc file management suite for dotfiles",
  "source": "https://github.com/thoughtbot/rcm",
  "checks": [{ "type": "binary", "name": "rcm" }],
  "install_guidance": {
    "plugin": "rcm",
    "binary": "rcm",
    "check": "which rcm",
    "install_steps": ["brew install rcm", "Verify: rcm --version", "supercli plugins install ./plugins/rcm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rcm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rcm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rcm",
      "passthrough": true,
      "missingDependencyHelp": "Install rcm: brew install rcm", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
