{
  "name": "georock",
  "version": "0.1.0",
  "description": "Geospatial CLI integrating AWS Bedrock with generative AI",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "georock" }],
  "install_guidance": {
    "plugin": "georock",
    "binary": "georock",
    "check": "which georock",
    "install_steps": ["npm install -g georock", "Verify: georock --version", "supercli plugins install ./plugins/georock --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "georock",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to georock CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "georock",
      "passthrough": true,
      "missingDependencyHelp": "Install georock: npm install -g georock"
    },
    "args": []
  }]
}
