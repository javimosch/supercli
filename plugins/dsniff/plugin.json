{
  "name": "dsniff",
  "version": "1.0.0",
  "description": "dsniff \u2014 Network audit",
  "source": "github.com/teacupx/dsniff",
  "checks": [
    {
      "type": "binary",
      "name": "dsniff"
    }
  ],
  "install_guidance": {
    "plugin": "dsniff",
    "binary": "dsniff",
    "check": "which dsniff",
    "install_steps": [
      "# Install dsniff",
      "# See github.com/teacupx/dsniff",
      "# apt: sudo apt-get install dsniff",
      "# brew: brew install dsniff",
      "# cargo: cargo install dsniff",
      "# npm: npm install -g dsniff",
      "# pip: pip install dsniff"
    ]
  },
  "commands": [
    {
      "namespace": "dsniff",
      "resource": "dsniff",
      "action": "run",
      "description": "Run dsniff",
      "adapter": "process",
      "adapterConfig": {
        "command": "dsniff",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dsniff from github.com/teacupx/dsniff"
      },
      "args": []
    }
  ]
}