{
  "name": "ppmquantall",
  "version": "0.1.0",
  "description": "CLI tool: ppmquantall",
  "source": "https://manpages.debian.org/ppmquantall",
  "checks": [
    {
      "type": "binary",
      "name": "ppmquantall"
    }
  ],
  "install_guidance": {
    "plugin": "ppmquantall",
    "binary": "ppmquantall",
    "check": "which ppmquantall",
    "install_steps": [
      "apt-get install ppmquantall 2>/dev/null || which ppmquantall",
      "Verify: ppmquantall --version",
      "supercli plugins install ./plugins/ppmquantall --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmquantall",
      "resource": "self",
      "action": "version",
      "description": "Print ppmquantall version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmquantall",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmquantall: apt-get install ppmquantall 2>/dev/null || which ppmquantall"
      },
      "args": []
    },
    {
      "namespace": "ppmquantall",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmquantall CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmquantall",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmquantall: apt-get install ppmquantall 2>/dev/null || which ppmquantall"
      },
      "args": []
    }
  ]
}