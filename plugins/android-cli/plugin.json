{
  "name": "android-cli",
  "version": "0.1.0",
  "description": "Build and release Android apps without full Android Studio",
  "source": "https://github.com/SyedAhkam/android-cli",
  "checks": [{ "type": "binary", "name": "android-cli" }],
  "install_guidance": {
    "plugin": "android-cli",
    "binary": "android-cli",
    "check": "which android-cli",
    "install_steps": ["go install github.com/SyedAhkam/android-cli@latest", "Verify: android-cli --version", "supercli plugins install ./plugins/android-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "android-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to android-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "android-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install android-cli: go install github.com/SyedAhkam/android-cli@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
