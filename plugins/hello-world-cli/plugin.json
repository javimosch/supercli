{
  "name": "hello-world-cli",
  "version": "0.1.0",
  "description": "Simple hello world CLI tool",
  "source": "https://github.com/example/hello-world-cli",
  "checks": [
    {
      "type": "binary",
      "name": "hello-world-cli"
    }
  ],
  "install_guidance": {
    "plugin": "hello-world-cli",
    "binary": "hello-world-cli",
    "check": "which hello-world-cli",
    "install_steps": [
      "See project repository",
      "Verify: hello-world-cli --version",
      "supercli plugins install ./plugins/hello-world-cli --on-conflict replace --json"
    ],
    "note": "Example tool"
  },
  "commands": [
    {
      "namespace": "hello-world-cli",
      "resource": "self",
      "action": "version",
      "description": "Print hello-world-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": [
          "1.0.0"
        ],
        "missingDependencyHelp": "Install hello-world-cli"
      },
      "args": []
    },
    {
      "namespace": "hello-world-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hello-world-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": [
          "Hello World"
        ],
        "missingDependencyHelp": "Install hello-world-cli"
      },
      "args": []
    }
  ]
}