{
  "name": "boltctl",
  "version": "0.1.0",
  "description": "CLI tool: boltctl",
  "source": "https://packages.debian.org/boltctl",
  "checks": [{ "type": "binary", "name": "boltctl" }],
  "install_guidance": {
    "plugin": "boltctl", "binary": "boltctl", "check": "which boltctl",
    "install_steps": ["apt-get install boltctl 2>/dev/null || which boltctl", "Verify: boltctl --version", "supercli plugins install ./plugins/boltctl --on-conflict replace --json"]
