{
  "name": "tea",
  "version": "0.1.0",
  "description": "Gitea command line interface for issues and PRs",
  "source": "https://github.com/go-gitea/tea",
  "checks": [{ "type": "binary", "name": "tea" }],
  "install_guidance": {
    "plugin": "tea",
    "binary": "tea",
    "check": "which tea",
    "install_steps": ["brew install tea", "Verify: tea --version", "supercli plugins install ./plugins/tea --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tea",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tea CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tea",
      "passthrough": true,
      "missingDependencyHelp": "Install tea: brew install tea", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
