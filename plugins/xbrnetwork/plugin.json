{
  "name": "xbrnetwork",
  "version": "0.1.0",
  "description": "CLI tool: xbrnetwork",
  "source": "https://manpages.debian.org/xbrnetwork",
  "checks": [
    {
      "type": "binary",
      "name": "xbrnetwork"
    }
  ],
  "install_guidance": {
    "plugin": "xbrnetwork",
    "binary": "xbrnetwork",
    "check": "which xbrnetwork",
    "install_steps": [
      "apt-get install xbrnetwork 2>/dev/null || which xbrnetwork",
      "Verify: xbrnetwork --version",
      "supercli plugins install ./plugins/xbrnetwork --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xbrnetwork",
      "resource": "self",
      "action": "version",
      "description": "Print xbrnetwork version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbrnetwork",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xbrnetwork: apt-get install xbrnetwork 2>/dev/null || which xbrnetwork"
      },
      "args": []
    },
    {
      "namespace": "xbrnetwork",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xbrnetwork CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbrnetwork",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xbrnetwork: apt-get install xbrnetwork 2>/dev/null || which xbrnetwork"
      },
      "args": []
    }
  ]
}