{
  "name": "FluidAudio",
  "version": "0.1.0",
  "description": "Frontier CoreML audio models in your apps \u2014 text-to-speech, speech-to-text, voice activity detection",
  "source": "https://github.com/FluidAudio/FluidAudio",
  "checks": [
    {
      "type": "binary",
      "name": "fluidaudio"
    }
  ],
  "install_guidance": {
    "plugin": "FluidAudio",
    "binary": "fluidaudio",
    "check": "which fluidaudio",
    "install_steps": [
      "pip install fluidaudio",
      "Verify: fluidaudio --version",
      "supercli plugins install ./plugins/FluidAudio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FluidAudio",
      "resource": "self",
      "action": "version",
      "description": "Print FluidAudio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fluidaudio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FluidAudio: pip install fluidaudio"
      },
      "args": []
    },
    {
      "namespace": "FluidAudio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fluidaudio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fluidaudio",
        "passthrough": true,
        "missingDependencyHelp": "Install FluidAudio: pip install fluidaudio"
      },
      "args": []
    }
  ]
}