{
  "name": "word-cli",
  "version": "0.1.0",
  "description": "Look up word definitions from the command line",
  "source": "https://github.com/dave-wasmer/word-cli",
  "checks": [{ "type": "binary", "name": "word-cli" }],
  "install_guidance": {
    "plugin": "word-cli",
    "binary": "word-cli",
    "check": "which word-cli",
    "install_steps": ["npm install -g word-cli", "Verify: word-cli --version", "supercli plugins install ./plugins/word-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "word-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to word-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "word-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install word-cli: npm install -g word-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
