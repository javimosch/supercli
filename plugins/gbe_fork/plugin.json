{
  "name": "gbe_fork",
  "version": "0.1.0",
  "description": "Fork of https://gitlab.com/Mr_Goldberg/goldberg_emulator",
  "source": "https://github.com/gbe_fork/gbe_fork",
  "checks": [
    {
      "type": "binary",
      "name": "gbe-fork"
    }
  ],
  "install_guidance": {
    "plugin": "gbe_fork",
    "binary": "gbe-fork",
    "check": "which gbe-fork",
    "install_steps": [
      "pip install gbe-fork",
      "Verify: gbe-fork --version",
      "supercli plugins install ./plugins/gbe_fork --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gbe_fork",
      "resource": "self",
      "action": "version",
      "description": "Print gbe_fork version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gbe-fork",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gbe_fork: pip install gbe-fork"
      },
      "args": []
    },
    {
      "namespace": "gbe_fork",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gbe-fork CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gbe-fork",
        "passthrough": true,
        "missingDependencyHelp": "Install gbe_fork: pip install gbe-fork"
      },
      "args": []
    }
  ]
}