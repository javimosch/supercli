{
  "name": "pnmnoraw",
  "version": "0.1.0",
  "description": "CLI tool: pnmnoraw",
  "source": "https://manpages.debian.org/pnmnoraw",
  "checks": [
    {
      "type": "binary",
      "name": "pnmnoraw"
    }
  ],
  "install_guidance": {
    "plugin": "pnmnoraw",
    "binary": "pnmnoraw",
    "check": "which pnmnoraw",
    "install_steps": [
      "apt-get install pnmnoraw 2>/dev/null || which pnmnoraw",
      "Verify: pnmnoraw --version",
      "supercli plugins install ./plugins/pnmnoraw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmnoraw",
      "resource": "self",
      "action": "version",
      "description": "Print pnmnoraw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmnoraw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmnoraw: apt-get install pnmnoraw 2>/dev/null || which pnmnoraw"
      },
      "args": []
    },
    {
      "namespace": "pnmnoraw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmnoraw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmnoraw",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmnoraw: apt-get install pnmnoraw 2>/dev/null || which pnmnoraw"
      },
      "args": []
    }
  ]
}