{
  "name": "ghost-os",
  "version": "0.1.0",
  "description": "Full computer-use for AI agents. Self-learning workflows. Native macOS. No screenshots required.",
  "source": "https://github.com/ghost-os/ghost-os",
  "checks": [
    {
      "type": "binary",
      "name": "ghost-os"
    }
  ],
  "install_guidance": {
    "plugin": "ghost-os",
    "binary": "ghost-os",
    "check": "which ghost-os",
    "install_steps": [
      "pip install ghost-os",
      "Verify: ghost-os --version",
      "supercli plugins install ./plugins/ghost-os --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ghost-os",
      "resource": "self",
      "action": "version",
      "description": "Print ghost-os version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghost-os",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ghost-os: pip install ghost-os"
      },
      "args": []
    },
    {
      "namespace": "ghost-os",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghost-os CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghost-os",
        "passthrough": true,
        "missingDependencyHelp": "Install ghost-os: pip install ghost-os"
      },
      "args": []
    }
  ]
}