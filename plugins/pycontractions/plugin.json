{
  "name": "pycontractions",
  "version": "0.1.0",
  "description": "Expand English contractions in text",
  "source": "https://github.com/ianyc/pycontractions",
  "checks": [{ "type": "binary", "name": "pycontractions" }],
  "install_guidance": {
    "plugin": "pycontractions",
    "binary": "pycontractions",
    "check": "which pycontractions",
    "install_steps": ["pip install pycontractions", "Verify: pycontractions --version", "supercli plugins install ./plugins/pycontractions --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pycontractions",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pycontractions CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pycontractions",
      "passthrough": true,
      "missingDependencyHelp": "Install pycontractions: pip install pycontractions", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
