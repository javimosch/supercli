{
  "name": "gitanimals",
  "version": "0.1.0",
  "description": "\ud83d\udc23 \uae43\ud5c8\ube0c \ud65c\ub3d9\uc73c\ub85c \ud3ab\uc744 \ud0a4\uc6b0\uc138\uc694 / Have pet in your github ",
  "source": "https://github.com/gitanimals/gitanimals",
  "checks": [
    {
      "type": "binary",
      "name": "gitanimals"
    }
  ],
  "install_guidance": {
    "plugin": "gitanimals",
    "binary": "gitanimals",
    "check": "which gitanimals",
    "install_steps": [
      "pip install gitanimals",
      "Verify: gitanimals --version",
      "supercli plugins install ./plugins/gitanimals --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gitanimals",
      "resource": "self",
      "action": "version",
      "description": "Print gitanimals version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitanimals",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitanimals: pip install gitanimals"
      },
      "args": []
    },
    {
      "namespace": "gitanimals",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitanimals CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitanimals",
        "passthrough": true,
        "missingDependencyHelp": "Install gitanimals: pip install gitanimals"
      },
      "args": []
    }
  ]
}