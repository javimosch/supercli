{
  "name": "mimir-cli",
  "version": "0.1.0",
  "description": "Command line tool for Grafana Mimir metrics backend",
  "source": "https://github.com/grafana/mimir",
  "checks": [{ "type": "binary", "name": "mimir-cli" }],
  "install_guidance": {
    "plugin": "mimir-cli",
    "binary": "mimir-cli",
    "check": "which mimir-cli",
    "install_steps": ["brew install mimir-cli", "Verify: mimir-cli --version", "supercli plugins install ./plugins/mimir-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mimir-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mimir-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mimir-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install mimir-cli: brew install mimir-cli"
    },
    "args": []
  }]
}
