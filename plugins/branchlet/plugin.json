{
  "name": "branchlet",
  "version": "0.1.0",
  "description": "Simple CLI git worktree manager",
  "source": "https://github.com/branchlet/branchlet",
  "checks": [
    {
      "type": "binary",
      "name": "branchlet"
    }
  ],
  "install_guidance": {
    "plugin": "branchlet",
    "binary": "branchlet",
    "check": "which branchlet",
    "install_steps": [
      "npm install -g branchlet",
      "Verify: branchlet --version",
      "supercli plugins install ./plugins/branchlet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "branchlet",
      "resource": "self",
      "action": "version",
      "description": "Print branchlet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "branchlet",
        "missingDependencyHelp": "Install branchlet: npm install -g branchlet",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "branchlet",
      "resource": "worktree",
      "action": "add",
      "description": "Add a new git worktree",
      "adapter": "process",
      "adapterConfig": {
        "command": "branchlet",
        "missingDependencyHelp": "Install branchlet: npm install -g branchlet",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "branchlet",
      "resource": "worktree",
      "action": "list",
      "description": "List git worktrees",
      "adapter": "process",
      "adapterConfig": {
        "command": "branchlet",
        "missingDependencyHelp": "Install branchlet: npm install -g branchlet",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "branchlet",
      "resource": "worktree",
      "action": "remove",
      "description": "Remove a git worktree",
      "adapter": "process",
      "adapterConfig": {
        "command": "branchlet",
        "missingDependencyHelp": "Install branchlet: npm install -g branchlet",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "branchlet",
      "resource": "worktree",
      "action": "prune",
      "description": "Prune stale worktrees",
      "adapter": "process",
      "adapterConfig": {
        "command": "branchlet",
        "missingDependencyHelp": "Install branchlet: npm install -g branchlet",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "branchlet",
      "resource": "_",
      "action": "_",
      "description": "_ _ via branchlet",
      "adapter": "process",
      "adapterConfig": {
        "command": "branchlet",
        "missingDependencyHelp": "Install branchlet: npm install -g branchlet",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
