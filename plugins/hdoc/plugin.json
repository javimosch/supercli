{
  "name": "hdoc",
  "version": "0.1.0",
  "description": "Modern robust C++ documentation generator",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "hdoc" }],
  "install_guidance": {
    "plugin": "hdoc",
    "binary": "hdoc",
    "check": "which hdoc",
    "install_steps": ["cmake -B build && cmake --build build", "Verify: hdoc --version", "supercli plugins install ./plugins/hdoc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hdoc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hdoc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hdoc",
      "passthrough": true,
      "missingDependencyHelp": "Install hdoc: cmake -B build && cmake --build build"
    },
    "args": []
  }]
}
