{
  "name": "Quoter",
  "version": "0.1.0",
  "description": "The console based stock quote tool.",
  "source": "https://github.com/frossm/quoter",
  "checks": [
    {
      "type": "binary",
      "name": "Quoter"
    }
  ],
  "install_guidance": {
    "plugin": "Quoter",
    "binary": "Quoter",
    "check": "which Quoter",
    "install_steps": [
      "See https://github.com/frossm/quoter",
      "Verify: Quoter --version",
      "supercli plugins install ./plugins/Quoter --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Quoter",
      "resource": "self",
      "action": "version",
      "description": "Print Quoter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Quoter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Quoter: See https://github.com/frossm/quoter"
      },
      "args": []
    },
    {
      "namespace": "Quoter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Quoter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Quoter",
        "passthrough": true,
        "missingDependencyHelp": "Install Quoter"
      },
      "args": []
    }
  ]
}