{
  "name": "clockwork",
  "version": "1.0.0",
  "description": "clockwork \u2014 Time tracking CLI",
  "source": "github.com/clockwork/clockwork",
  "checks": [
    {
      "type": "binary",
      "name": "clockwork"
    }
  ],
  "install_guidance": {
    "plugin": "clockwork",
    "binary": "clockwork",
    "check": "which clockwork",
    "install_steps": [
      "# Install clockwork",
      "# See github.com/clockwork/clockwork",
      "# apt: sudo apt-get install clockwork",
      "# brew: brew install clockwork",
      "# cargo: cargo install clockwork",
      "# npm: npm install -g clockwork",
      "# pip: pip install clockwork"
    ]
  },
  "commands": [
    {
      "namespace": "clockwork",
      "resource": "clockwork",
      "action": "run",
      "description": "Run clockwork",
      "adapter": "process",
      "adapterConfig": {
        "command": "clockwork",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install clockwork from github.com/clockwork/clockwork"
      },
      "args": []
    }
  ]
}