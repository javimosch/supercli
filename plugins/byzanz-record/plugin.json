{
  "name": "byzanz-record",
  "version": "0.1.0",
  "description": "CLI tool: byzanz-record",
  "source": "https://packages.debian.org/byzanz-record",
  "checks": [{ "type": "binary", "name": "byzanz-record" }],
  "install_guidance": {
    "plugin": "byzanz-record", "binary": "byzanz-record", "check": "which byzanz-record",
    "install_steps": ["apt-get install byzanz-record 2>/dev/null || which byzanz-record", "Verify: byzanz-record --version", "supercli plugins install ./plugins/byzanz-record --on-conflict replace --json"]
