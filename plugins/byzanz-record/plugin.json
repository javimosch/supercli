  "commands": [{
    "namespace": "byzanz-record", "resource": "_", "action": "_",
    "description": "Passthrough to byzanz-record CLI",
    "adapter": "process", "adapterConfig": { "command": "byzanz-record", "passthrough": true, "missingDependencyHelp": "Install byzanz-record: apt-get install byzanz-record" }, "args": []
  }]
}
