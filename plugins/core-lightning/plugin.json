{
  "name": "core-lightning",
  "version": "0.1.0",
  "description": "Lightning Network implementation focusing on spec compliance and performance",
  "source": "https://github.com/ElementsProject/lightning",
  "checks": [
    {
      "type": "binary",
      "name": "core-lightning"
    }
  ],
  "install_guidance": {
    "plugin": "core-lightning",
    "binary": "core-lightning",
    "check": "which core-lightning",
    "install_steps": [
      "brew install core-lightning",
      "Verify: core-lightning --version",
      "supercli plugins install ./plugins/core-lightning --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "core-lightning",
      "resource": "self",
      "action": "version",
      "description": "Print core-lightning version",
      "adapter": "process",
      "adapterConfig": {
        "command": "core-lightning",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install core-lightning: brew install core-lightning"
      },
      "args": []
    },
    {
      "namespace": "core-lightning",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to core-lightning CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "core-lightning",
        "passthrough": true,
        "missingDependencyHelp": "Install core-lightning"
      },
      "args": []
    }
  ]
}