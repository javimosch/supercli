{
  "name": "yolk",
  "version": "0.1.0",
  "description": "Minimalist dotfile manager with simple symlink logic",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "yolk" }],
  "install_guidance": {
    "plugin": "yolk",
    "binary": "yolk",
    "check": "which yolk",
    "install_steps": ["git clone && make install", "Verify: yolk --version", "supercli plugins install ./plugins/yolk --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yolk",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yolk CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yolk",
      "passthrough": true,
      "missingDependencyHelp": "Install yolk: git clone && make install"
    },
    "args": []
  }]
}
