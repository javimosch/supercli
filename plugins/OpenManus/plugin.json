{
  "name": "OpenManus",
  "version": "0.1.0",
  "description": "No fortress, purely open ground.  OpenManus is Coming.",
  "source": "https://github.com/OpenManus/OpenManus",
  "checks": [
    {
      "type": "binary",
      "name": "openmanus"
    }
  ],
  "install_guidance": {
    "plugin": "OpenManus",
    "binary": "openmanus",
    "check": "which openmanus",
    "install_steps": [
      "pip install openmanus",
      "Verify: openmanus --version",
      "supercli plugins install ./plugins/OpenManus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenManus",
      "resource": "self",
      "action": "version",
      "description": "Print OpenManus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openmanus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenManus: pip install openmanus"
      },
      "args": []
    },
    {
      "namespace": "OpenManus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openmanus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openmanus",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenManus: pip install openmanus"
      },
      "args": []
    }
  ]
}