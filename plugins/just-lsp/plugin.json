{
  "name": "just-lsp",
  "version": "0.1.0",
  "description": "Language server for just",
  "source": "https://github.com/terror/just-lsp",
  "checks": [
    {
      "type": "binary",
      "name": "just-lsp"
    }
  ],
  "install_guidance": {
    "plugin": "just-lsp",
    "binary": "just-lsp",
    "check": "which just-lsp",
    "install_steps": [
      "brew install just-lsp",
      "Verify: just-lsp --version",
      "supercli plugins install ./plugins/just-lsp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "just-lsp",
      "resource": "self",
      "action": "version",
      "description": "Print just-lsp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "just-lsp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install just-lsp: brew install just-lsp"
      },
      "args": []
    },
    {
      "namespace": "just-lsp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to just-lsp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "just-lsp",
        "passthrough": true,
        "missingDependencyHelp": "Install just-lsp"
      },
      "args": []
    }
  ]
}