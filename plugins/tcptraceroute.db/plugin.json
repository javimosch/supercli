{
  "name": "tcptraceroute.db",
  "version": "0.1.0",
  "description": "CLI tool: tcptraceroute.db",
  "source": "https://manpages.debian.org/tcptraceroute.db",
  "checks": [
    {
      "type": "binary",
      "name": "tcptraceroute.db"
    }
  ],
  "install_guidance": {
    "plugin": "tcptraceroute.db",
    "binary": "tcptraceroute.db",
    "check": "which tcptraceroute.db",
    "install_steps": [
      "apt-get install tcptraceroute.db 2>/dev/null || which tcptraceroute.db",
      "Verify: tcptraceroute.db --version",
      "supercli plugins install ./plugins/tcptraceroute.db --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tcptraceroute.db",
      "resource": "self",
      "action": "version",
      "description": "Print tcptraceroute.db version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tcptraceroute.db",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tcptraceroute.db: apt-get install tcptraceroute.db 2>/dev/null || which tcptraceroute.db"
      },
      "args": []
    },
    {
      "namespace": "tcptraceroute.db",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tcptraceroute.db CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tcptraceroute.db",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tcptraceroute.db: apt-get install tcptraceroute.db 2>/dev/null || which tcptraceroute.db"
      },
      "args": []
    }
  ]
}