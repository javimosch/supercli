{
  "name": "cli-arxiv",
  "version": "0.1.0",
  "description": "CLI tool for exploring arXiv.",
  "source": "https://github.com/knguyenanhoa/cli-arxiv",
  "checks": [
    {
      "type": "binary",
      "name": "cli-arxiv"
    }
  ],
  "install_guidance": {
    "plugin": "cli-arxiv",
    "binary": "cli-arxiv",
    "check": "which cli-arxiv",
    "install_steps": [
      "See https://github.com/knguyenanhoa/cli-arxiv",
      "Verify: cli-arxiv --version",
      "supercli plugins install ./plugins/cli-arxiv --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "cli-arxiv",
      "resource": "self",
      "action": "version",
      "description": "Print cli-arxiv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-arxiv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-arxiv: See https://github.com/knguyenanhoa/cli-arxiv"
      },
      "args": []
    },
    {
      "namespace": "cli-arxiv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-arxiv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-arxiv",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-arxiv"
      },
      "args": []
    }
  ]
}