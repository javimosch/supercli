{
  "name": "jetzig",
  "version": "0.1.0",
  "description": "Jetzig is a web framework written in Zig",
  "source": "https://github.com/jetzig/jetzig",
  "checks": [
    {
      "type": "binary",
      "name": "jetzig"
    }
  ],
  "install_guidance": {
    "plugin": "jetzig",
    "binary": "jetzig",
    "check": "which jetzig",
    "install_steps": [
      "pip install jetzig",
      "Verify: jetzig --version",
      "supercli plugins install ./plugins/jetzig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jetzig",
      "resource": "self",
      "action": "version",
      "description": "Print jetzig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jetzig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jetzig: pip install jetzig"
      },
      "args": []
    },
    {
      "namespace": "jetzig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jetzig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jetzig",
        "passthrough": true,
        "missingDependencyHelp": "Install jetzig: pip install jetzig"
      },
      "args": []
    }
  ]
}