{
  "name": "curlx",
  "version": "0.1.0",
  "description": "Extended curl with JSON response formatting and request chaining",
  "source": "https://github.com/curlx/curlx",
  "checks": [
    {
      "type": "binary",
      "name": "curlx"
    }
  ],
  "install_guidance": {
    "plugin": "curlx",
    "binary": "curlx",
    "check": "which curlx",
    "install_steps": [
      "go install github.com/curlx/curlx@latest",
      "Verify: curlx --version",
      "supercli plugins install ./plugins/curlx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "curlx",
      "resource": "self",
      "action": "version",
      "description": "Print curlx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "curlx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install curlx: go install github.com/curlx/curlx@latest"
      },
      "args": []
    },
    {
      "namespace": "curlx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to curlx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "curlx",
        "passthrough": true,
        "missingDependencyHelp": "Install curlx: go install github.com/curlx/curlx@latest"
      },
      "args": []
    }
  ]
}
