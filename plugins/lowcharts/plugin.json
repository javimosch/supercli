{
  "name": "lowcharts",
  "version": "0.1.0",
  "description": "lowcharts \u2014 tool to draw low-resolution graphs in terminal",
  "source": "https://github.com/juan-leon/lowcharts",
  "checks": [
    {
      "type": "binary",
      "name": "lowcharts"
    }
  ],
  "install_guidance": {
    "plugin": "lowcharts",
    "binary": "lowcharts",
    "check": "which lowcharts",
    "install_steps": [
      "cargo install lowcharts",
      "Verify: lowcharts --version",
      "supercli plugins install ./plugins/lowcharts --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lowcharts",
      "resource": "self",
      "action": "version",
      "description": "Print lowcharts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lowcharts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lowcharts: cargo install lowcharts"
      },
      "args": []
    },
    {
      "namespace": "lowcharts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lowcharts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lowcharts",
        "passthrough": true,
        "missingDependencyHelp": "Install lowcharts"
      },
      "args": []
    }
  ]
}