{
  "name": "nomino",
  "version": "0.1.0",
  "description": "Batch rename utility for developers",
  "source": "https://github.com/yaa110/nomino",
  "checks": [
    {
      "type": "binary",
      "name": "nomino"
    }
  ],
  "install_guidance": {
    "plugin": "nomino",
    "binary": "nomino",
    "check": "which nomino",
    "install_steps": [
      "cargo install nomino",
      "Verify: nomino --version",
      "supercli plugins install ./plugins/nomino --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "nomino",
      "resource": "self",
      "action": "version",
      "description": "Print nomino version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nomino",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nomino: cargo install nomino"
      },
      "args": []
    },
    {
      "namespace": "nomino",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nomino CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nomino",
        "passthrough": true,
        "missingDependencyHelp": "Install nomino"
      },
      "args": []
    }
  ]
}