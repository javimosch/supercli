      "args": [
        {
          "name": "session_id",
          "type": "string",
          "required": true,
          "description": "Session ID to unlock"
        }
      ]
    },
    {
      "namespace": "loginctl",
      "resource": "session",
      "action": "terminate",
      "description": "Terminate one or more sessions",
      "adapter": "process",
      "adapterConfig": {
        "command": "loginctl",
        "baseArgs": ["terminate-session"],
        "positionalArgs": ["session_id"],
        "missingDependencyHelp": "Install loginctl: apt-get install systemd-container"
