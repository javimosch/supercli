{
  "name": "claude-osint",
  "version": "0.1.0",
  "description": "2 paired Claude skills for OSINT recon — 90+ modules, 48 secret-regex patterns, 80+ dorks, 9 credential validators, 27 attack-path templates",
  "source": "https://github.com/elementalsouls/Claude-OSINT",
  "checks": [
    { "type": "binary", "name": "git" }
  ],
  "install_guidance": {
    "plugin": "claude-osint",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/elementalsouls/Claude-OSINT.git",
      "supercli plugins install ./plugins/claude-osint --on-conflict replace --json",
      "sc skills teach claude-osint:quickstart"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-osint",
      "resource": "self",
      "action": "version",
      "description": "Print claude-osint info",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": ["claude-osint v0.1.0 — 2 paired OSINT skills. Use sc skills teach claude-osint:quickstart"],
        "missingDependencyHelp": "Clone: git clone https://github.com/elementalsouls/Claude-OSINT.git"
      },
      "args": []
    },
    {
      "namespace": "claude-osint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough — clone and teach",
      "adapter": "process",
      "adapterConfig": {
        "command": "echo",
        "baseArgs": ["claude-osint is 2 SKILL.md files. Clone https://github.com/elementalsouls/Claude-OSINT.git then: sc skills teach claude-osint:quickstart"],
        "passthrough": true,
        "missingDependencyHelp": "Install: git clone https://github.com/elementalsouls/Claude-OSINT.git"
      },
      "args": []
    }
  ]
}
