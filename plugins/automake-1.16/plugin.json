{
  "name": "automake-1.16",
  "version": "0.1.0",
  "description": "CLI tool: automake-1.16",
  "source": "https://manpages.debian.org/automake-1.16",
  "checks": [
    {
      "type": "binary",
      "name": "automake-1.16"
    }
  ],
  "install_guidance": {
    "plugin": "automake-1.16",
    "binary": "automake-1.16",
    "check": "which automake-1.16",
    "install_steps": [
      "apt-get install automake-1.16 2>/dev/null || which automake-1.16",
      "Verify: automake-1.16 --version",
      "supercli plugins install ./plugins/automake-1.16 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "automake-1.16",
      "resource": "self",
      "action": "version",
      "description": "Print automake-1.16 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "automake-1.16",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install automake-1.16: apt-get install automake-1.16 2>/dev/null || which automake-1.16"
      },
      "args": []
    },
    {
      "namespace": "automake-1.16",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to automake-1.16 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "automake-1.16",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install automake-1.16: apt-get install automake-1.16 2>/dev/null || which automake-1.16"
      },
      "args": []
    }
  ]
}