{
  "name": "minfo",
  "version": "0.1.0",
  "description": "CLI tool: minfo",
  "source": "https://manpages.debian.org/minfo",
  "checks": [
    {
      "type": "binary",
      "name": "minfo"
    }
  ],
  "install_guidance": {
    "plugin": "minfo",
    "binary": "minfo",
    "check": "which minfo",
    "install_steps": [
      "apt-get install minfo 2>/dev/null || which minfo",
      "Verify: minfo --version",
      "supercli plugins install ./plugins/minfo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "minfo",
      "resource": "self",
      "action": "version",
      "description": "Print minfo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "minfo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install minfo: apt-get install minfo 2>/dev/null || which minfo"
      },
      "args": []
    },
    {
      "namespace": "minfo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to minfo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "minfo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install minfo: apt-get install minfo 2>/dev/null || which minfo"
      },
      "args": []
    }
  ]
}