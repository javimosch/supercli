{
  "name": "pybabel-python3",
  "version": "0.1.0",
  "description": "CLI tool: pybabel-python3",
  "source": "https://manpages.debian.org/pybabel-python3",
  "checks": [
    {
      "type": "binary",
      "name": "pybabel-python3"
    }
  ],
  "install_guidance": {
    "plugin": "pybabel-python3",
    "binary": "pybabel-python3",
    "check": "which pybabel-python3",
    "install_steps": [
      "apt-get install pybabel-python3 2>/dev/null || which pybabel-python3",
      "Verify: pybabel-python3 --version",
      "supercli plugins install ./plugins/pybabel-python3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pybabel-python3",
      "resource": "self",
      "action": "version",
      "description": "Print pybabel-python3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pybabel-python3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pybabel-python3: apt-get install pybabel-python3 2>/dev/null || which pybabel-python3"
      },
      "args": []
    },
    {
      "namespace": "pybabel-python3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pybabel-python3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pybabel-python3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pybabel-python3: apt-get install pybabel-python3 2>/dev/null || which pybabel-python3"
      },
      "args": []
    }
  ]
}