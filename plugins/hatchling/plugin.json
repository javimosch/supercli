{
  "name": "hatchling",
  "version": "0.1.0",
  "description": "Build backend for Hatch Python project manager",
  "source": "https://github.com/pypa/hatch",
  "checks": [{ "type": "binary", "name": "hatchling" }],
  "install_guidance": {
    "plugin": "hatchling",
    "binary": "hatchling",
    "check": "which hatchling",
    "install_steps": ["pip install hatchling", "Verify: hatchling --version", "supercli plugins install ./plugins/hatchling --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hatchling",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hatchling CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hatchling",
      "passthrough": true,
      "missingDependencyHelp": "Install hatchling: pip install hatchling", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
