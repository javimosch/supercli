{
  "name": "pwd",
  "version": "1.0.0",
  "description": "pwd \u2014 pwd \u2014 CLI utility",
  "source": "/usr/bin/pwd",
  "checks": [
    {
      "type": "binary",
      "name": "pwd"
    }
  ],
  "install_guidance": {
    "plugin": "pwd",
    "binary": "pwd",
    "check": "which pwd",
    "install_steps": [
      "# Install pwd:",
      "# apt: sudo apt-get install pwd",
      "# brew: brew install pwd",
      "# cargo: cargo install pwd",
      "# npm: npm install -g pwd",
      "# pip: pip install pwd",
      "# or download from /usr/bin/pwd"
    ]
  },
  "commands": [
    {
      "namespace": "pwd",
      "resource": "pwd",
      "action": "run",
      "description": "Run pwd",
      "adapter": "process",
      "adapterConfig": {
        "command": "pwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pwd from /usr/bin/pwd"
      },
      "args": []
    }
  ]
}