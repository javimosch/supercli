{
  "name": "csv-sanitizer-cli",
  "version": "0.1.0",
  "description": "Sanitize sensitive data from CSV files via a blazing-fast Node.js CLI tool — mask emails & phone numbers using streams.",
  "source": "https://github.com/csv-sanitizer-cli/csv-sanitizer-cli",
  "checks": [
    {
      "type": "binary",
      "name": "csv-sanitizer-cli"
    }
  ],
  "install_guidance": {
    "plugin": "csv-sanitizer-cli",
    "binary": "csv-sanitizer-cli",
    "check": "which csv-sanitizer-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: csv-sanitizer-cli --version",
      "supercli plugins install ./plugins/csv-sanitizer-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "csv-sanitizer-cli",
      "resource": "self",
      "action": "version",
      "description": "Print csv-sanitizer-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csv-sanitizer-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csv-sanitizer-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "csv-sanitizer-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csv-sanitizer-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csv-sanitizer-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install csv-sanitizer-cli from project repository"
      },
      "args": []
    }
  ]
}