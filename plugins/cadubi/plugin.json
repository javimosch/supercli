{
  "name": "cadubi",
  "version": "0.1.0",
  "description": "Creative ASCII drawing utility",
  "source": "https://github.com/statico/cadubi/",
  "checks": [
    {
      "type": "binary",
      "name": "cadubi"
    }
  ],
  "install_guidance": {
    "plugin": "cadubi",
    "binary": "cadubi",
    "check": "which cadubi",
    "install_steps": [
      "brew install cadubi",
      "Verify: cadubi --version",
      "supercli plugins install ./plugins/cadubi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cadubi",
      "resource": "self",
      "action": "version",
      "description": "Print cadubi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cadubi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cadubi: brew install cadubi"
      },
      "args": []
    },
    {
      "namespace": "cadubi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cadubi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cadubi",
        "passthrough": true,
        "missingDependencyHelp": "Install cadubi"
      },
      "args": []
    }
  ]
}