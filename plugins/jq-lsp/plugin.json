{
  "name": "jq-lsp",
  "version": "0.1.0",
  "description": "Jq language server",
  "source": "https://github.com/wader/jq-lsp",
  "checks": [
    {
      "type": "binary",
      "name": "jq-lsp"
    }
  ],
  "install_guidance": {
    "plugin": "jq-lsp",
    "binary": "jq-lsp",
    "check": "which jq-lsp",
    "install_steps": [
      "brew install jq-lsp",
      "Verify: jq-lsp --version",
      "supercli plugins install ./plugins/jq-lsp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jq-lsp",
      "resource": "self",
      "action": "version",
      "description": "Print jq-lsp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jq-lsp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jq-lsp: brew install jq-lsp"
      },
      "args": []
    },
    {
      "namespace": "jq-lsp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jq-lsp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jq-lsp",
        "passthrough": true,
        "missingDependencyHelp": "Install jq-lsp"
      },
      "args": []
    }
  ]
}