{
  "name": "git-shot",
  "version": "0.1.0",
  "description": "CLI tool to upload screenshots and images to GitHub issues",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "git-shot" }],
  "install_guidance": {
    "plugin": "git-shot",
    "binary": "git-shot",
    "check": "which git-shot",
    "install_steps": ["npm install -g git-shot", "Verify: git-shot --version", "supercli plugins install ./plugins/git-shot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-shot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-shot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-shot",
      "passthrough": true,
      "missingDependencyHelp": "Install git-shot: npm install -g git-shot"
    },
    "args": []
  }]
}
