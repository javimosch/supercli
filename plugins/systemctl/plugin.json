{
  "name": "systemctl",
  "version": "1.0.0",
  "description": "systemctl \u2014 CLI CLI utility",
  "source": "https://packages.debian.org/stable/systemctl",
  "checks": [
    {
      "type": "binary",
      "name": "systemctl"
    }
  ],
  "install_guidance": {
    "plugin": "systemctl",
    "binary": "systemctl",
