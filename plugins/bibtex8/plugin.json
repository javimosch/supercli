{
  "name": "bibtex8",
  "version": "0.1.0",
  "description": "CLI tool: bibtex8",
  "source": "https://packages.debian.org/bibtex8",
  "checks": [{ "type": "binary", "name": "bibtex8" }],
  "install_guidance": {
    "plugin": "bibtex8", "binary": "bibtex8", "check": "which bibtex8",
    "install_steps": ["apt-get install bibtex8 2>/dev/null || which bibtex8", "Verify: bibtex8 --version", "supercli plugins install ./plugins/bibtex8 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bibtex8", "resource": "_", "action": "_",
    "description": "Passthrough to bibtex8 CLI",
    "adapter": "process", "adapterConfig": { "command": "bibtex8", "passthrough": true, "missingDependencyHelp": "Install bibtex8: apt-get install bibtex8" }, "args": []
  }]
}
