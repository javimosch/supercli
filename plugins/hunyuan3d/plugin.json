{
  "name": "hunyuan3d",
  "version": "0.1.0",
  "description": "High-resolution 3D assets generation with Hunyuan3D diffusion models by Tencent",
  "source": "https://github.com/Tencent-Hunyuan/Hunyuan3D-2",
  "checks": [
    {
      "type": "binary",
      "name": "hunyuan3d"
    }
  ],
  "install_guidance": {
    "plugin": "hunyuan3d",
    "binary": "hunyuan3d",
    "check": "which hunyuan3d",
    "install_steps": [
      "pip install hunyuan3d",
      "Verify: hunyuan3d --version",
      "supercli plugins install ./plugins/hunyuan3d --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "hunyuan3d",
    "resource": "self",
    "action": "version",
    "description": "Print hunyuan3d version",
    "adapter": "process",
    "adapterConfig": {
      "command": "hunyuan3d",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install hunyuan3d: pip install hunyuan3d"
    },
    "args": []
  },
  {
    "namespace": "hunyuan3d",
    "resource": "model",
    "action": "generate",
    "description": "Generate 3D assets",
    "adapter": "process",
    "adapterConfig": {
      "command": "hunyuan3d",
      "passthrough": true,
      "missingDependencyHelp": "Install hunyuan3d: pip install hunyuan3d"
    },
    "args": []
  },
  {
    "namespace": "hunyuan3d",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hunyuan3d CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hunyuan3d",
      "passthrough": true,
      "missingDependencyHelp": "Install hunyuan3d"
    },
    "args": []
  }
]
}