{
  "name": "zls",
  "version": "0.1.0",
  "description": "Zig Language Server for IDE integration",
  "source": "https://github.com/zigtools/zls",
  "checks": [{ "type": "binary", "name": "zls" }],
  "install_guidance": {
    "plugin": "zls",
    "binary": "zls",
    "check": "which zls",
    "install_steps": ["zig build -Doptimize=ReleaseSafe", "Verify: zls --version", "supercli plugins install ./plugins/zls --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zls",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zls CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zls",
      "passthrough": true,
      "missingDependencyHelp": "Install zls: zig build -Doptimize=ReleaseSafe", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
