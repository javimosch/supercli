{
  "name": "tomlyre",
  "version": "0.1.0",
  "description": "TOML manipulation, query, and editing tool",
  "source": "https://github.com/nicm/tomlyre",
  "checks": [
    {
      "type": "binary",
      "name": "tomlyre"
    }
  ],
  "install_guidance": {
    "plugin": "tomlyre",
    "binary": "tomlyre",
    "check": "which tomlyre",
    "install_steps": [
      "cargo install tomlyre",
      "Verify: tomlyre --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tomlyre",
      "resource": "self",
      "action": "version",
      "description": "Print tomlyre version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tomlyre",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install tomlyre: cargo install tomlyre"
      },
      "args": []
    },
    {
      "namespace": "tomlyre",
      "resource": "file",
      "action": "edit",
      "description": "Query and edit TOML files with dot-path notation",
      "adapter": "process",
      "adapterConfig": {
        "command": "tomlyre",
        "baseArgs": ["--cwd", "invoke_cwd"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tomlyre: cargo install tomlyre"
      },
      "args": []
    },
    {
      "namespace": "tomlyre",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tomlyre CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tomlyre",
        "passthrough": true,
        "missingDependencyHelp": "Install tomlyre: cargo install tomlyre"
      },
      "args": []
    }
  ]
}