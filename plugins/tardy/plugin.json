{
  "name": "tardy",
  "version": "0.1.0",
  "description": "An asynchronous runtime for writing applications and services. Supports io_uring, epoll, kqueue, and",
  "source": "https://github.com/tardy/tardy",
  "checks": [
    {
      "type": "binary",
      "name": "tardy"
    }
  ],
  "install_guidance": {
    "plugin": "tardy",
    "binary": "tardy",
    "check": "which tardy",
    "install_steps": [
      "pip install tardy",
      "Verify: tardy --version",
      "supercli plugins install ./plugins/tardy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tardy",
      "resource": "self",
      "action": "version",
      "description": "Print tardy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tardy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tardy: pip install tardy"
      },
      "args": []
    },
    {
      "namespace": "tardy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tardy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tardy",
        "passthrough": true,
        "missingDependencyHelp": "Install tardy: pip install tardy"
      },
      "args": []
    }
  ]
}