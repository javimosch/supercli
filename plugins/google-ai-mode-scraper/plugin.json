{
  "name": "google-ai-mode-scraper",
  "version": "0.1.0",
  "description": "Scrape Google AI Mode responses without blocks on a large scale.",
  "source": "https://github.com/google-ai-mode-scraper/google-ai-mode-scraper",
  "checks": [
    {
      "type": "binary",
      "name": "google-ai-mode-scraper"
    }
  ],
  "install_guidance": {
    "plugin": "google-ai-mode-scraper",
    "binary": "google-ai-mode-scraper",
    "check": "which google-ai-mode-scraper",
    "install_steps": [
      "pip install google-ai-mode-scraper",
      "Verify: google-ai-mode-scraper --version",
      "supercli plugins install ./plugins/google-ai-mode-scraper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "google-ai-mode-scraper",
      "resource": "self",
      "action": "version",
      "description": "Print google-ai-mode-scraper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-ai-mode-scraper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install google-ai-mode-scraper: pip install google-ai-mode-scraper"
      },
      "args": []
    },
    {
      "namespace": "google-ai-mode-scraper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to google-ai-mode-scraper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-ai-mode-scraper",
        "passthrough": true,
        "missingDependencyHelp": "Install google-ai-mode-scraper: pip install google-ai-mode-scraper"
      },
      "args": []
    }
  ]
}