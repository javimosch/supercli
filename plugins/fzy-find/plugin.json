{
  "name": "fzy-find",
  "version": "0.1.0",
  "description": "Lightweight and fast fuzzy finder alternative for the terminal",
  "source": "https://github.com/jhawthorn/fzy",
  "checks": [{ "type": "binary", "name": "fzy-find" }],
  "install_guidance": {
    "plugin": "fzy-find",
    "binary": "fzy-find",
    "check": "which fzy-find",
    "install_steps": ["make install", "Verify: fzy-find --version", "supercli plugins install ./plugins/fzy-find --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fzy-find",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fzy-find CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fzy-find",
      "passthrough": true,
      "missingDependencyHelp": "Install fzy-find: make install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
