{
  "name": "moxide",
  "version": "0.1.0",
  "description": "Minimalist Markdown documentation indexer",
  "source": "go",
  "checks": [{ "type": "binary", "name": "moxide" }],
  "install_guidance": {
    "plugin": "moxide",
    "binary": "moxide",
    "check": "which moxide",
    "install_steps": ["go install github.com/moxide/cmd/moxide@latest", "Verify: moxide --version", "supercli plugins install ./plugins/moxide --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "moxide",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to moxide CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "moxide",
      "passthrough": true,
      "missingDependencyHelp": "Install moxide: go install github.com/moxide/cmd/moxide@latest"
    },
    "args": []
  }]
}
