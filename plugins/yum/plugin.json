{
  "name": "yum",
  "version": "0.1.0",
  "description": "Yellowdog Updater Modified package manager",
  "source": "https://packages.debian.org/yum",
  "checks": [{ "type": "binary", "name": "yum" }],
  "install_guidance": {
    "plugin": "yum", "binary": "yum", "check": "which yum",
    "install_steps": ["apt-get install yum", "Verify: yum --version", "supercli plugins install ./plugins/yum --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yum", "resource": "_", "action": "_",
    "description": "Passthrough to yum CLI",
    "adapter": "process", "adapterConfig": { "command": "yum", "passthrough": true, "missingDependencyHelp": "Install yum: apt-get install yum" }, "args": []
  }]
}
