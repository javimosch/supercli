{
  "name": "svg-term-cli",
  "description": "Share terminal sessions as razor-sharp animated SVG everywhere",
  "version": "1.0.0",
  "binary": "svg-term",
  "check": "svg-term --version",
  "install": {
    "method": "npm",
    "command": "npm install -g svg-term-cli"
  },
  "commands": {
    "record-cast": {
      "command": "svg-term --cast {cast_id} --out {output}",
      "description": "Generate SVG from asciinema cast",
      "args": ["cast_id", "output"]
    },
    "record-window": {
      "command": "svg-term --cast {cast_id} --out {output} --window",
      "description": "Generate SVG with window frame",
      "args": ["cast_id", "output"]
    },
    "record-no-cursor": {
      "command": "svg-term --cast {cast_id} --out {output} --no-cursor",
      "description": "Generate SVG without cursor",
      "args": ["cast_id", "output"]
    }
  }
}
