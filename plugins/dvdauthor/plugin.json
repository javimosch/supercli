{
  "name": "dvdauthor",
  "version": "0.1.0",
  "description": "DVD authoring tools",
  "source": "https://github.com/xtingray/dvdauthor",
  "checks": [
    {
      "type": "binary",
      "name": "dvdauthor"
    }
  ],
  "install_guidance": {
    "plugin": "dvdauthor",
    "binary": "dvdauthor",
    "check": "which dvdauthor",
    "install_steps": [
      "brew install dvdauthor",
      "Verify: dvdauthor --version",
      "supercli plugins install ./plugins/dvdauthor --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "dvdauthor",
      "resource": "self",
      "action": "version",
      "description": "Print dvdauthor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvdauthor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvdauthor: brew install dvdauthor"
      },
      "args": []
    },
    {
      "namespace": "dvdauthor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvdauthor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvdauthor",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvdauthor: brew install dvdauthor"
      },
      "args": []
    }
  ]
}
