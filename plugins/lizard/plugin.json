{
  "name": "lizard",
  "version": "0.1.0",
  "description": "Efficient compressor with very fast decompression",
  "source": "https://github.com/inikep/lizard",
  "checks": [
    {
      "type": "binary",
      "name": "lizard"
    }
  ],
  "install_guidance": {
    "plugin": "lizard",
    "binary": "lizard",
    "check": "which lizard",
    "install_steps": [
      "brew install lizard",
      "Verify: lizard --version",
      "supercli plugins install ./plugins/lizard --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lizard",
      "resource": "self",
      "action": "version",
      "description": "Print lizard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lizard",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lizard: brew install lizard"
      },
      "args": []
    },
    {
      "namespace": "lizard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lizard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lizard",
        "passthrough": true,
        "missingDependencyHelp": "Install lizard"
      },
      "args": []
    }
  ]
}