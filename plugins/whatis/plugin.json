{
  "name": "whatis",
  "version": "0.1.0",
  "description": "whatis — display one-line manual page descriptions",
  "source": "https://man7.org/linux/man-pages/man1/whatis.1.html",
  "checks": [
    {
      "type": "binary",
      "name": "whatis"
    }
  ],
  "install_guidance": {
    "plugin": "whatis",
    "binary": "whatis",
    "check": "which whatis",
    "install_steps": [
      "base system (man-db)",
      "Verify: whatis --version"
    ],
    "note": "Standard Unix utility from man-db. Pre-installed on most Linux distributions."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "whatis",
      "resource": "self",
      "action": "version",
      "description": "Print whatis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatis",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "whatis is part of man-db (base system)"
      },
      "args": []
    },
    {
      "namespace": "whatis",
      "resource": "name",
      "action": "lookup",
      "description": "Display one-line description for a command or topic",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatis",
        "positionalArgs": ["name"],
        "missingDependencyHelp": "whatis is part of man-db (base system)"
      },
      "args": [
        { "name": "name", "type": "string", "required": true, "description": "Command or topic name to describe" }
      ]
    },
    {
      "namespace": "whatis",
      "resource": "name",
      "action": "lookup-all",
      "description": "Display all matching man page descriptions (all sections)",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatis",
        "baseArgs": ["-l"],
        "positionalArgs": ["name"],
        "missingDependencyHelp": "whatis is part of man-db (base system)"
      },
      "args": [
        { "name": "name", "type": "string", "required": true, "description": "Name to search in all sections" }
      ]
    },
    {
      "namespace": "whatis",
      "resource": "name",
      "action": "lookup-section",
      "description": "Display man page description for a specific section",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatis",
        "baseArgs": ["-s"],
        "positionalArgs": ["section", "name"],
        "missingDependencyHelp": "whatis is part of man-db (base system)"
      },
      "args": [
        { "name": "section", "type": "string", "required": true, "description": "Man page section number (e.g. 1, 2, 3, 5, 7, 8)" },
        { "name": "name", "type": "string", "required": true, "description": "Command or topic name" }
      ]
    },
    {
      "namespace": "whatis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to whatis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatis",
        "passthrough": true,
        "missingDependencyHelp": "whatis is part of man-db (base system)"
      },
      "args": []
    }
  ]
}
