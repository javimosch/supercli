{
  "name": "codepack",
  "version": "0.1.0",
  "description": "Extract folder structures and file contents into compact outputs optimized for LLM processing pipelines. Creates AI-friendly code representations.",
  "source": "https://github.com/toolleeo/awesome-cli-apps-in-a-csv",
  "checks": [{ "type": "binary", "name": "codepack" }],
  "install_guidance": {
    "plugin": "codepack",
    "binary": "codepack",
    "check": "which codepack",
    "install_steps": ["npm install -g codepack", "Verify: codepack --version", "supercli plugins install ./plugins/codepack --on-conflict replace --json"]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "codepack", "resource": "self", "action": "version", "description": "Print codepack version", "adapter": "process", "adapterConfig": { "command": "codepack", "baseArgs": ["--version"], "missingDependencyHelp": "Install codepack: npm install -g codepack" }, "args": [] },
    { "namespace": "codepack", "resource": "_", "action": "_", "description": "Passthrough to codepack CLI", "adapter": "process", "adapterConfig": { "command": "codepack", "passthrough": true, "missingDependencyHelp": "Install codepack: npm install -g codepack" }, "args": [] }
  ]
}
