{
  "name": "catimg",
  "version": "0.1.0",
  "description": "Image rendering in terminal with resize support",
  "source": "https://github.com/posva/catimg",
  "checks": [
    {
      "type": "binary",
      "name": "catimg"
    }
  ],
  "install_guidance": {
    "plugin": "catimg",
    "binary": "catimg",
    "check": "which catimg",
    "install_steps": [
      "brew install catimg",
      "Verify: catimg --version",
      "supercli plugins install ./plugins/catimg --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "catimg",
      "resource": "self",
      "action": "version",
      "description": "Print catimg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "catimg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install catimg: brew install catimg"
      },
      "args": []
    },
    {
      "namespace": "catimg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to catimg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "catimg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install catimg: brew install catimg"
      },
      "args": []
    }
  ]
}
