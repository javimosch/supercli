{
  "name": "catimg",
  "version": "0.1.0",
  "description": "catimg — display images in the terminal using ANSI colors, Unicode blocks, or sixel graphics. Renders images directly in terminal output with resize, thumbnail, color depth, and alignment options for previewing images without leaving the CLI.",
  "source": "https://github.com/posva/catimg",
  "checks": [
    {
      "type": "binary",
      "name": "catimg"
    }
  ],
  "install_guidance": {
    "plugin": "catimg",
    "binary": "catimg",
    "check": "which catimg",
    "install_steps": [
      "brew install catimg",
      "Verify: catimg --version",
      "supercli plugins install ./plugins/catimg --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "catimg",
      "resource": "self",
      "action": "version",
      "description": "Print catimg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "catimg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install catimg: brew install catimg"
      },
      "args": []
    },
    {
      "namespace": "catimg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to catimg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "catimg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install catimg: brew install catimg"
      },
      "args": []
    }
  ]
}
