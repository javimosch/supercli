{
  "name": "cmdshelf",
  "version": "0.1.0",
  "description": "Better scripting life with cmdshelf",
  "source": "https://github.com/toshi0383/cmdshelf",
  "checks": [
    {
      "type": "binary",
      "name": "cmdshelf"
    }
  ],
  "install_guidance": {
    "plugin": "cmdshelf",
    "binary": "cmdshelf",
    "check": "which cmdshelf",
    "install_steps": [
      "brew install cmdshelf",
      "Verify: cmdshelf --version",
      "supercli plugins install ./plugins/cmdshelf --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cmdshelf",
      "resource": "self",
      "action": "version",
      "description": "Print cmdshelf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmdshelf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmdshelf: brew install cmdshelf"
      },
      "args": []
    },
    {
      "namespace": "cmdshelf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmdshelf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmdshelf",
        "passthrough": true,
        "missingDependencyHelp": "Install cmdshelf"
      },
      "args": []
    }
  ]
}