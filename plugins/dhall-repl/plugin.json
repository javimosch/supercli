{
  "name": "dhall-repl",
  "version": "0.1.0",
  "description": "CLI tool: dhall-repl",
  "source": "https://packages.debian.org/dhall-repl",
  "checks": [{ "type": "binary", "name": "dhall-repl" }],
  "install_guidance": {
    "plugin": "dhall-repl", "binary": "dhall-repl", "check": "which dhall-repl",
    "install_steps": ["apt-get install dhall-repl 2>/dev/null || which dhall-repl", "Verify: dhall-repl --version", "supercli plugins install ./plugins/dhall-repl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-repl", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-repl CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-repl", "passthrough": true, "missingDependencyHelp": "Install dhall-repl: apt-get install dhall-repl" }, "args": []
  }]
}
