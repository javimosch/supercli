{
  "name": "commitmsgfmt",
  "version": "0.1.0",
  "description": "Format git commit messages to conventional style",
  "source": "https://github.com/romkatv/commitmsgfmt",
  "checks": [{ "type": "binary", "name": "commitmsgfmt" }],
  "install_guidance": {
    "plugin": "commitmsgfmt",
    "binary": "commitmsgfmt",
    "check": "which commitmsgfmt",
    "install_steps": ["cargo install commitmsgfmt", "Verify: commitmsgfmt --version", "supercli plugins install ./plugins/commitmsgfmt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "commitmsgfmt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to commitmsgfmt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "commitmsgfmt",
      "passthrough": true,
      "missingDependencyHelp": "Install commitmsgfmt: cargo install commitmsgfmt", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
