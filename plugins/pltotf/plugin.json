{
  "name": "pltotf",
  "version": "0.1.0",
  "description": "CLI tool: pltotf",
  "source": "https://manpages.debian.org/pltotf",
  "checks": [
    {
      "type": "binary",
      "name": "pltotf"
    }
  ],
  "install_guidance": {
    "plugin": "pltotf",
    "binary": "pltotf",
    "check": "which pltotf",
    "install_steps": [
      "apt-get install pltotf 2>/dev/null || which pltotf",
      "Verify: pltotf --version",
      "supercli plugins install ./plugins/pltotf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pltotf",
      "resource": "self",
      "action": "version",
      "description": "Print pltotf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pltotf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pltotf: apt-get install pltotf 2>/dev/null || which pltotf"
      },
      "args": []
    },
    {
      "namespace": "pltotf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pltotf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pltotf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pltotf: apt-get install pltotf 2>/dev/null || which pltotf"
      },
      "args": []
    }
  ]
}