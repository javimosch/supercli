{
  "name": "blueutil",
  "version": "0.1.0",
  "description": "Get/set bluetooth power and discoverable state",
  "source": "https://github.com/toy/blueutil",
  "checks": [
    {
      "type": "binary",
      "name": "blueutil"
    }
  ],
  "install_guidance": {
    "plugin": "blueutil",
    "binary": "blueutil",
    "check": "which blueutil",
    "install_steps": [
      "brew install blueutil",
      "Verify: blueutil --version",
      "supercli plugins install ./plugins/blueutil --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "blueutil",
      "resource": "self",
      "action": "version",
      "description": "Print blueutil version",
      "adapter": "process",
      "adapterConfig": {
        "command": "blueutil",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install blueutil: brew install blueutil"
      },
      "args": []
    },
    {
      "namespace": "blueutil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to blueutil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "blueutil",
        "passthrough": true,
        "missingDependencyHelp": "Install blueutil"
      },
      "args": []
    }
  ]
}