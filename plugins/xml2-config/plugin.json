{
  "name": "xml2-config",
  "version": "0.1.0",
  "description": "CLI tool: xml2-config",
  "source": "https://manpages.debian.org/xml2-config",
  "checks": [
    {
      "type": "binary",
      "name": "xml2-config"
    }
  ],
  "install_guidance": {
    "plugin": "xml2-config",
    "binary": "xml2-config",
    "check": "which xml2-config",
    "install_steps": [
      "apt-get install xml2-config 2>/dev/null || which xml2-config",
      "Verify: xml2-config --version",
      "supercli plugins install ./plugins/xml2-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xml2-config",
      "resource": "self",
      "action": "version",
      "description": "Print xml2-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xml2-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xml2-config: apt-get install xml2-config 2>/dev/null || which xml2-config"
      },
      "args": []
    },
    {
      "namespace": "xml2-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xml2-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xml2-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xml2-config: apt-get install xml2-config 2>/dev/null || which xml2-config"
      },
      "args": []
    }
  ]
}