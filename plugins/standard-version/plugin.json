{
  "name": "standard-version",
  "version": "0.1.0",
  "description": "Automate versioning and CHANGELOG generation with semver",
  "source": "https://github.com/conventional-changelog/standard-version",
  "checks": [{ "type": "binary", "name": "standard-version" }],
  "install_guidance": {
    "plugin": "standard-version",
    "binary": "standard-version",
    "check": "which standard-version",
    "install_steps": ["npm install -g standard-version", "Verify: standard-version --version", "supercli plugins install ./plugins/standard-version --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "standard-version",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to standard-version CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "standard-version",
      "passthrough": true,
      "missingDependencyHelp": "Install standard-version: npm install -g standard-version"
    },
    "args": []
  }]
}
