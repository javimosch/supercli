{
  "name": "Append-CLIP-Interrogation",
  "version": "0.1.0",
  "description": "Simple python script to automatically append caption generated by CLIP interrogator to an image file",
  "source": "https://github.com/Append-CLIP-Interrogation/Append-CLIP-Interrogation",
  "checks": [
    {
      "type": "binary",
      "name": "Append-CLIP-Interrogation"
    }
  ],
  "install_guidance": {
    "plugin": "Append-CLIP-Interrogation",
    "binary": "Append-CLIP-Interrogation",
    "check": "which Append-CLIP-Interrogation",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Append-CLIP-Interrogation --version",
      "supercli plugins install ./plugins/Append-CLIP-Interrogation --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "Append-CLIP-Interrogation",
      "resource": "self",
      "action": "version",
      "description": "Print Append-CLIP-Interrogation version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Append-CLIP-Interrogation",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Append-CLIP-Interrogation from project repository"
      },
      "args": []
    },
    {
      "namespace": "Append-CLIP-Interrogation",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Append-CLIP-Interrogation CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Append-CLIP-Interrogation",
        "passthrough": true,
        "missingDependencyHelp": "Install Append-CLIP-Interrogation from project repository"
      },
      "args": []
    }
  ]
}