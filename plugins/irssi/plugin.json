{
  "name": "irssi",
  "version": "1.0.0",
  "description": "irssi \u2014 IRC client",
  "source": "irssi.org",
  "checks": [
    {
      "type": "binary",
      "name": "irssi"
    }
  ],
  "install_guidance": {
    "plugin": "irssi",
    "binary": "irssi",
    "check": "which irssi",
    "install_steps": [
      "# Install irssi",
      "# See irssi.org",
      "# apt: sudo apt-get install irssi",
      "# brew: brew install irssi",
      "# cargo: cargo install irssi",
      "# npm: npm install -g irssi",
      "# pip: pip install irssi"
    ]
  },
  "commands": [
    {
      "namespace": "irssi",
      "resource": "irssi",
      "action": "run",
      "description": "Run irssi",
      "adapter": "process",
      "adapterConfig": {
        "command": "irssi",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install irssi from irssi.org"
      },
      "args": []
    }
  ]
}