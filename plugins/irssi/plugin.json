{
  "name": "irssi",
  "version": "0.1.0",
  "description": "Terminal IRC client — modular, lightweight, scriptable with Perl",
  "source": "https://irssi.org",
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "checks": [{ "type": "binary", "name": "irssi" }],
  "install_guidance": {
    "plugin": "irssi",
    "binary": "irssi",
    "check": "which irssi",
    "install_steps": ["apt install irssi", "brew install irssi", "supercli plugins install ./plugins/irssi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "irssi",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to irssi CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "irssi",
      "passthrough": true,
      "missingDependencyHelp": "Install irssi: apt install irssi"
    },
    "args": []
  }]
}
