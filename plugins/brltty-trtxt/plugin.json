{
  "name": "brltty-trtxt",
  "version": "0.1.0",
  "description": "CLI tool: brltty-trtxt",
  "source": "https://packages.debian.org/brltty-trtxt",
  "checks": [{ "type": "binary", "name": "brltty-trtxt" }],
  "install_guidance": {
    "plugin": "brltty-trtxt", "binary": "brltty-trtxt", "check": "which brltty-trtxt",
    "install_steps": ["apt-get install brltty-trtxt 2>/dev/null || which brltty-trtxt", "Verify: brltty-trtxt --version", "supercli plugins install ./plugins/brltty-trtxt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "brltty-trtxt", "resource": "_", "action": "_",
    "description": "Passthrough to brltty-trtxt CLI",
    "adapter": "process", "adapterConfig": { "command": "brltty-trtxt", "passthrough": true, "missingDependencyHelp": "Install brltty-trtxt: apt-get install brltty-trtxt" }, "args": []
  }]
}
