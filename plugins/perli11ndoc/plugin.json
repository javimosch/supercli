{
  "name": "perli11ndoc",
  "version": "0.1.0",
  "description": "CLI tool: perli11ndoc",
  "source": "https://manpages.debian.org/perli11ndoc",
  "checks": [
    {
      "type": "binary",
      "name": "perli11ndoc"
    }
  ],
  "install_guidance": {
    "plugin": "perli11ndoc",
    "binary": "perli11ndoc",
    "check": "which perli11ndoc",
    "install_steps": [
      "apt-get install perli11ndoc 2>/dev/null || which perli11ndoc",
      "Verify: perli11ndoc --version",
      "supercli plugins install ./plugins/perli11ndoc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "perli11ndoc",
      "resource": "self",
      "action": "version",
      "description": "Print perli11ndoc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "perli11ndoc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install perli11ndoc: apt-get install perli11ndoc 2>/dev/null || which perli11ndoc"
      },
      "args": []
    },
    {
      "namespace": "perli11ndoc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to perli11ndoc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "perli11ndoc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install perli11ndoc: apt-get install perli11ndoc 2>/dev/null || which perli11ndoc"
      },
      "args": []
    }
  ]
}