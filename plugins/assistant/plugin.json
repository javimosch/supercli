{
  "name": "assistant",
  "version": "0.1.0",
  "description": "CLI tool: assistant",
  "source": "https://packages.debian.org/assistant",
  "checks": [{ "type": "binary", "name": "assistant" }],
  "install_guidance": {
    "plugin": "assistant", "binary": "assistant", "check": "which assistant",
    "install_steps": ["apt-get install assistant 2>/dev/null || which assistant", "Verify: assistant --version", "supercli plugins install ./plugins/assistant --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "assistant", "resource": "_", "action": "_",
    "description": "Passthrough to assistant CLI",
    "adapter": "process", "adapterConfig": { "command": "assistant", "passthrough": true, "missingDependencyHelp": "Install assistant: apt-get install assistant" }, "args": []
  }]
}
