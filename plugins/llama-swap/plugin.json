{
  "name": "llama-swap",
  "version": "0.1.0",
  "description": "Reliable model swapping for any local OpenAI/Anthropic compatible server - llama.cpp, vllm, etc",
  "source": "https://github.com/llama-swap/llama-swap",
  "checks": [
    {
      "type": "binary",
      "name": "llama-swap"
    }
  ],
  "install_guidance": {
    "plugin": "llama-swap",
    "binary": "llama-swap",
    "check": "which llama-swap",
    "install_steps": [
      "pip install llama-swap",
      "Verify: llama-swap --version",
      "supercli plugins install ./plugins/llama-swap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "llama-swap",
      "resource": "self",
      "action": "version",
      "description": "Print llama-swap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llama-swap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llama-swap: pip install llama-swap"
      },
      "args": []
    },
    {
      "namespace": "llama-swap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llama-swap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llama-swap",
        "passthrough": true,
        "missingDependencyHelp": "Install llama-swap: pip install llama-swap"
      },
      "args": []
    }
  ]
}