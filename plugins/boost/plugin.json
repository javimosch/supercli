{
  "name": "boost",
  "version": "0.1.0",
  "description": "Collection of portable C++ source libraries",
  "checks": [
    {
      "type": "binary",
      "name": "boost"
    }
  ],
  "install_guidance": {
    "plugin": "boost",
    "binary": "boost",
    "check": "which boost",
    "install_steps": [
      "brew install boost",
      "Verify: boost --version",
      "supercli plugins install ./plugins/boost --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "boost",
      "resource": "self",
      "action": "version",
      "description": "Print boost version",
      "adapter": "process",
      "adapterConfig": {
        "command": "boost",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install boost: brew install boost"
      },
      "args": []
    },
    {
      "namespace": "boost",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to boost CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "boost",
        "passthrough": true,
        "missingDependencyHelp": "Install boost"
      },
      "args": []
    }
  ]
}