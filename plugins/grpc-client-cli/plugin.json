{
  "name": "grpc-client-cli",
  "version": "0.1.0",
  "description": "Generic gRPC CLI client with server reflection support",
  "source": "go",
  "checks": [{ "type": "binary", "name": "grpc-client-cli" }],
  "install_guidance": {
    "plugin": "grpc-client-cli",
    "binary": "grpc-client-cli",
    "check": "which grpc-client-cli",
    "install_steps": ["go install github.com/vadimi/grpc-client-cli/cmd/grpc-client-cli@latest", "Verify: grpc-client-cli --version", "supercli plugins install ./plugins/grpc-client-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "grpc-client-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to grpc-client-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "grpc-client-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install grpc-client-cli: go install github.com/vadimi/grpc-client-cli/cmd/grpc-client-cli@latest"
    },
    "args": []
  }]
}
