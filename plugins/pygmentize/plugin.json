{
  "name": "pygmentize",
  "version": "0.1.0",
  "description": "pygmentize — Syntax highlighter for source code, powered by Pygments",
  "source": "https://github.com/pygments/pygments",
  "checks": [
    {
      "type": "binary",
      "name": "pygmentize"
    }
  ],
  "install_guidance": {
    "plugin": "pygmentize",
    "binary": "pygmentize",
    "check": "which pygmentize",
    "install_steps": [
      "pip install pygments",
      "Verify: pygmentize -V",
      "supercli plugins install ./plugins/pygmentize --on-conflict replace --json"
    ],
    "note": "Part of the Pygments package. Install via pip."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pygmentize",
      "resource": "self",
      "action": "version",
      "description": "Print pygmentize version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pygmentize",
        "baseArgs": [
          "-V"
        ],
        "missingDependencyHelp": "Install pygmentize: pip install pygments"
      },
      "args": []
    },
    {
      "namespace": "pygmentize",
      "resource": "self",
      "action": "list-lexers",
      "description": "List available lexers (languages)",
      "adapter": "process",
      "adapterConfig": {
        "command": "pygmentize",
        "baseArgs": [
          "-L",
          "lexers"
        ],
        "missingDependencyHelp": "Install pygmentize: pip install pygments"
      },
      "args": []
    },
    {
      "namespace": "pygmentize",
      "resource": "self",
      "action": "list-styles",
      "description": "List available styles",
      "adapter": "process",
      "adapterConfig": {
        "command": "pygmentize",
        "baseArgs": [
          "-L",
          "styles"
        ],
        "missingDependencyHelp": "Install pygmentize: pip install pygments"
      },
      "args": []
    },
    {
      "namespace": "pygmentize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pygmentize CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pygmentize",
        "passthrough": true,
        "missingDependencyHelp": "Install pygmentize: pip install pygments"
      },
      "args": []
    }
  ]
}
