{
  "plugin": "grub-script-check",
  "binary": "grub-script-check",
  "check": "which grub-script-check",
  "install_steps": [
    "apt-get install grub-script-check 2>/dev/null || which grub-script-check",
    "Verify: grub-script-check --version",
    "supercli plugins install ./plugins/grub-script-check --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}