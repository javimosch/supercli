{
  "name": "xgrammar",
  "version": "0.1.0",
  "description": "Fast, Flexible and Portable Structured Generation",
  "source": "https://github.com/xgrammar/xgrammar",
  "checks": [
    {
      "type": "binary",
      "name": "xgrammar"
    }
  ],
  "install_guidance": {
    "plugin": "xgrammar",
    "binary": "xgrammar",
    "check": "which xgrammar",
    "install_steps": [
      "pip install xgrammar",
      "Verify: xgrammar --version",
      "supercli plugins install ./plugins/xgrammar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xgrammar",
      "resource": "self",
      "action": "version",
      "description": "Print xgrammar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xgrammar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xgrammar: pip install xgrammar"
      },
      "args": []
    },
    {
      "namespace": "xgrammar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xgrammar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xgrammar",
        "passthrough": true,
        "missingDependencyHelp": "Install xgrammar: pip install xgrammar"
      },
      "args": []
    }
  ]
}