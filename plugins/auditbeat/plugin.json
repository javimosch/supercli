{
  "name": "auditbeat",
  "version": "0.1.0",
  "description": "Lightweight shipper for audit data to Elasticsearch",
  "source": "https://github.com/elastic/beats",
  "checks": [{ "type": "binary", "name": "auditbeat" }],
  "install_guidance": {
    "plugin": "auditbeat",
    "binary": "auditbeat",
    "check": "which auditbeat",
    "install_steps": ["brew install auditbeat", "Verify: auditbeat --version", "supercli plugins install ./plugins/auditbeat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "auditbeat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to auditbeat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "auditbeat",
      "passthrough": true,
      "missingDependencyHelp": "Install auditbeat: brew install auditbeat"
    },
    "args": []
  }]
}
