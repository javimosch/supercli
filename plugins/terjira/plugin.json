{
  "name": "terjira",
  "version": "0.1.0",
  "description": "terjira \u2014 terjira is a very interactive and easy to use CLI tool for Jira",
  "source": "https://github.com/keepcosmos/terjira",
  "checks": [
    {
      "type": "binary",
      "name": "terjira"
    }
  ],
  "install_guidance": {
    "plugin": "terjira",
    "binary": "terjira",
    "check": "which terjira",
    "install_steps": [
      "See https://github.com/keepcosmos/terjira",
      "Verify: terjira --version",
      "supercli plugins install ./plugins/terjira --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "terjira",
      "resource": "self",
      "action": "version",
      "description": "Print terjira version",
      "adapter": "process",
      "adapterConfig": {
        "command": "terjira",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install terjira: See https://github.com/keepcosmos/terjira"
      },
      "args": []
    },
    {
      "namespace": "terjira",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to terjira CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "terjira",
        "passthrough": true,
        "missingDependencyHelp": "Install terjira"
      },
      "args": []
    }
  ]
}