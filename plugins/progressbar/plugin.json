{
  "name": "progressbar",
  "version": "0.1.0",
  "description": "Python progress bar library with CLI interface",
  "source": "https://github.com/WoLpH/python-progressbar",
  "checks": [{ "type": "binary", "name": "progressbar" }],
  "install_guidance": {
    "plugin": "progressbar",
    "binary": "progressbar",
    "check": "which progressbar",
    "install_steps": ["pip install progressbar2", "Verify: progressbar --version", "supercli plugins install ./plugins/progressbar --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "progressbar",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to progressbar CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "progressbar",
      "passthrough": true,
      "missingDependencyHelp": "Install progressbar: pip install progressbar2", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
