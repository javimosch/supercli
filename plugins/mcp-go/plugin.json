{
  "name": "mcp-go",
  "version": "0.1.0",
  "description": "A Go implementation of the Model Context Protocol (MCP), enabling seamless integration between LLM a",
  "source": "https://github.com/mcp-go/mcp-go",
  "checks": [
    {
      "type": "binary",
      "name": "mcp-go"
    }
  ],
  "install_guidance": {
    "plugin": "mcp-go",
    "binary": "mcp-go",
    "check": "which mcp-go",
    "install_steps": [
      "pip install mcp-go",
      "Verify: mcp-go --version",
      "supercli plugins install ./plugins/mcp-go --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mcp-go",
      "resource": "self",
      "action": "version",
      "description": "Print mcp-go version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcp-go",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mcp-go: pip install mcp-go"
      },
      "args": []
    },
    {
      "namespace": "mcp-go",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mcp-go CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mcp-go",
        "passthrough": true,
        "missingDependencyHelp": "Install mcp-go: pip install mcp-go"
      },
      "args": []
    }
  ]
}