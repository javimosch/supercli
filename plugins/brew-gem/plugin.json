{
  "name": "brew-gem",
  "version": "0.1.0",
  "description": "Install RubyGems as Homebrew formulae",
  "source": "https://github.com/sportngin/brew-gem",
  "checks": [
    {
      "type": "binary",
      "name": "brew-gem"
    }
  ],
  "install_guidance": {
    "plugin": "brew-gem",
    "binary": "brew-gem",
    "check": "which brew-gem",
    "install_steps": [
      "brew install brew-gem",
      "Verify: brew-gem --version",
      "supercli plugins install ./plugins/brew-gem --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "brew-gem",
      "resource": "self",
      "action": "version",
      "description": "Print brew-gem version",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew-gem",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install brew-gem: brew install brew-gem"
      },
      "args": []
    },
    {
      "namespace": "brew-gem",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to brew-gem CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "brew-gem",
        "passthrough": true,
        "missingDependencyHelp": "Install brew-gem"
      },
      "args": []
    }
  ]
}