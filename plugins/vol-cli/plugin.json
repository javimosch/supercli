{
  "name": "vol-cli",
  "version": "0.1.0",
  "description": "Simple ALSA/Pulse audio volume control from scripts",
  "source": "https://github.com/n1474335/vol-cli",
  "checks": [{ "type": "binary", "name": "vol-cli" }],
  "install_guidance": {
    "plugin": "vol-cli",
    "binary": "vol-cli",
    "check": "which vol-cli",
    "install_steps": ["git clone and install", "Verify: vol-cli --version", "supercli plugins install ./plugins/vol-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vol-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vol-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vol-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install vol-cli: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
