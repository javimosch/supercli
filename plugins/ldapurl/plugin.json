{
  "name": "ldapurl",
  "version": "0.1.0",
  "description": "CLI tool: ldapurl",
  "source": "https://manpages.debian.org/ldapurl",
  "checks": [
    {
      "type": "binary",
      "name": "ldapurl"
    }
  ],
  "install_guidance": {
    "plugin": "ldapurl",
    "binary": "ldapurl",
    "check": "which ldapurl",
    "install_steps": [
      "apt-get install ldapurl 2>/dev/null || which ldapurl",
      "Verify: ldapurl --version",
      "supercli plugins install ./plugins/ldapurl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ldapurl",
      "resource": "self",
      "action": "version",
      "description": "Print ldapurl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapurl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ldapurl: apt-get install ldapurl 2>/dev/null || which ldapurl"
      },
      "args": []
    },
    {
      "namespace": "ldapurl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ldapurl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapurl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ldapurl: apt-get install ldapurl 2>/dev/null || which ldapurl"
      },
      "args": []
    }
  ]
}