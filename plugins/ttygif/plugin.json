{
  "name": "ttygif",
  "version": "0.1.0",
  "description": "Convert terminal recordings to animated gifs",
  "source": "https://github.com/icholy/ttygif",
  "checks": [
    {
      "type": "binary",
      "name": "ttygif"
    }
  ],
  "install_guidance": {
    "plugin": "ttygif",
    "binary": "ttygif",
    "check": "which ttygif",
    "install_steps": [
      "brew install ttygif",
      "Verify: ttygif --version",
      "supercli plugins install ./plugins/ttygif --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ttygif",
      "resource": "self",
      "action": "version",
      "description": "Print ttygif version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttygif",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ttygif: brew install ttygif"
      },
      "args": []
    },
    {
      "namespace": "ttygif",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ttygif CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttygif",
        "passthrough": true,
        "missingDependencyHelp": "Install ttygif"
      },
      "args": []
    }
  ]
}