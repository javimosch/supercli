{
  "name": "ComicEater",
  "version": "0.1.0",
  "description": "CLI for maintaining comic book archives with validation and conversion",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "ComicEater" }],
  "install_guidance": {
    "plugin": "ComicEater",
    "binary": "ComicEater",
    "check": "which ComicEater",
    "install_steps": ["pip install comic-eater", "Verify: ComicEater --version", "supercli plugins install ./plugins/ComicEater --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ComicEater",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ComicEater CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ComicEater",
      "passthrough": true,
      "missingDependencyHelp": "Install ComicEater: pip install comic-eater"
    },
    "args": []
  }]
}
