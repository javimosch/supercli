{
  "name": "seekdb",
  "version": "0.1.0",
  "description": "The AI-native state store for agents. MySQL-compatible, embedded or server, hybrid vector + full-tex",
  "source": "https://github.com/seekdb/seekdb",
  "checks": [
    {
      "type": "binary",
      "name": "seekdb"
    }
  ],
  "install_guidance": {
    "plugin": "seekdb",
    "binary": "seekdb",
    "check": "which seekdb",
    "install_steps": [
      "pip install seekdb",
      "Verify: seekdb --version",
      "supercli plugins install ./plugins/seekdb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "seekdb",
      "resource": "self",
      "action": "version",
      "description": "Print seekdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "seekdb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install seekdb: pip install seekdb"
      },
      "args": []
    },
    {
      "namespace": "seekdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to seekdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "seekdb",
        "passthrough": true,
        "missingDependencyHelp": "Install seekdb: pip install seekdb"
      },
      "args": []
    }
  ]
}