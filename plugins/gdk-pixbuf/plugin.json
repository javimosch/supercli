{
  "name": "gdk-pixbuf",
  "version": "0.1.0",
  "description": "Toolkit for image loading and pixel buffer manipulation",
  "checks": [
    {
      "type": "binary",
      "name": "gdk-pixbuf"
    }
  ],
  "install_guidance": {
    "plugin": "gdk-pixbuf",
    "binary": "gdk-pixbuf",
    "check": "which gdk-pixbuf",
    "install_steps": [
      "brew install gdk-pixbuf",
      "Verify: gdk-pixbuf --version",
      "supercli plugins install ./plugins/gdk-pixbuf --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gdk-pixbuf",
      "resource": "self",
      "action": "version",
      "description": "Print gdk-pixbuf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdk-pixbuf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdk-pixbuf: brew install gdk-pixbuf"
      },
      "args": []
    },
    {
      "namespace": "gdk-pixbuf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdk-pixbuf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdk-pixbuf",
        "passthrough": true,
        "missingDependencyHelp": "Install gdk-pixbuf"
      },
      "args": []
    }
  ]
}