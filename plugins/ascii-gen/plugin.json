{
  "name": "ascii-gen",
  "version": "0.1.0",
  "description": "Convert images to ASCII art in Rust",
  "source": "https://github.com/nicholasgasior/ascii-gen",
  "checks": [{"type": "binary", "name": "ascii-gen"}],
  "install_guidance": {
    "plugin": "ascii-gen",
    "binary": "ascii-gen",
    "check": "which ascii-gen",
    "install_steps": [
      "cargo install ascii-gen",
      "Verify: ascii-gen --version",
      "supercli plugins install ./ascii-gen --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "ascii-gen",
      "resource": "self",
      "action": "version",
      "description": "Print ascii-gen version",
      "adapter": "process",
      "adapterConfig": {"command": "ascii-gen", "baseArgs": ["--version"], "missingDependencyHelp": "Install ascii-gen: cargo install ascii-gen"},
      "args": []
    },
    {
      "namespace": "ascii-gen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ascii-gen CLI",
      "adapter": "process",
      "adapterConfig": {"command": "ascii-gen", "passthrough": true, "missingDependencyHelp": "Install ascii-gen: cargo install ascii-gen"},
      "args": []
    }
  ]
}
