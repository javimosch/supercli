{
  "name": "langchaingo",
  "version": "0.1.0",
  "description": "LangChain for Go, the easiest way to write LLM-based programs in Go",
  "source": "https://github.com/langchaingo/langchaingo",
  "checks": [
    {
      "type": "binary",
      "name": "langchaingo"
    }
  ],
  "install_guidance": {
    "plugin": "langchaingo",
    "binary": "langchaingo",
    "check": "which langchaingo",
    "install_steps": [
      "pip install langchaingo",
      "Verify: langchaingo --version",
      "supercli plugins install ./plugins/langchaingo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "langchaingo",
      "resource": "self",
      "action": "version",
      "description": "Print langchaingo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "langchaingo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install langchaingo: pip install langchaingo"
      },
      "args": []
    },
    {
      "namespace": "langchaingo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to langchaingo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "langchaingo",
        "passthrough": true,
        "missingDependencyHelp": "Install langchaingo: pip install langchaingo"
      },
      "args": []
    }
  ]
}