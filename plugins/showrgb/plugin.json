{
  "name": "showrgb",
  "version": "0.1.0",
  "description": "CLI tool: showrgb",
  "source": "https://manpages.debian.org/showrgb",
  "checks": [
    {
      "type": "binary",
      "name": "showrgb"
    }
  ],
  "install_guidance": {
    "plugin": "showrgb",
    "binary": "showrgb",
    "check": "which showrgb",
    "install_steps": [
      "apt-get install showrgb 2>/dev/null || which showrgb",
      "Verify: showrgb --version",
      "supercli plugins install ./plugins/showrgb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "showrgb",
      "resource": "self",
      "action": "version",
      "description": "Print showrgb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "showrgb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install showrgb: apt-get install showrgb 2>/dev/null || which showrgb"
      },
      "args": []
    },
    {
      "namespace": "showrgb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to showrgb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "showrgb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install showrgb: apt-get install showrgb 2>/dev/null || which showrgb"
      },
      "args": []
    }
  ]
}