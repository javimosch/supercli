{
  "name": "vphone-cli",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/vphone-cli/vphone-cli",
  "checks": [
    {
      "type": "binary",
      "name": "vphone-cli"
    }
  ],
  "install_guidance": {
    "plugin": "vphone-cli",
    "binary": "vphone-cli",
    "check": "which vphone-cli",
    "install_steps": [
      "pip install vphone-cli",
      "Verify: vphone-cli --version",
      "supercli plugins install ./plugins/vphone-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vphone-cli",
      "resource": "self",
      "action": "version",
      "description": "Print vphone-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vphone-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vphone-cli: pip install vphone-cli"
      },
      "args": []
    },
    {
      "namespace": "vphone-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vphone-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vphone-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install vphone-cli: pip install vphone-cli"
      },
      "args": []
    }
  ]
}