{
  "name": "lxc-checkconfig",
  "version": "0.1.0",
  "description": "CLI tool: lxc-checkconfig",
  "source": "https://manpages.debian.org/lxc-checkconfig",
  "checks": [
    {
      "type": "binary",
      "name": "lxc-checkconfig"
    }
  ],
  "install_guidance": {
    "plugin": "lxc-checkconfig",
    "binary": "lxc-checkconfig",
    "check": "which lxc-checkconfig",
    "install_steps": [
      "apt-get install lxc-checkconfig 2>/dev/null || which lxc-checkconfig",
      "Verify: lxc-checkconfig --version",
      "supercli plugins install ./plugins/lxc-checkconfig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lxc-checkconfig",
      "resource": "self",
      "action": "version",
      "description": "Print lxc-checkconfig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lxc-checkconfig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lxc-checkconfig: apt-get install lxc-checkconfig 2>/dev/null || which lxc-checkconfig"
      },
      "args": []
    },
    {
      "namespace": "lxc-checkconfig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lxc-checkconfig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lxc-checkconfig",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lxc-checkconfig: apt-get install lxc-checkconfig 2>/dev/null || which lxc-checkconfig"
      },
      "args": []
    }
  ]
}