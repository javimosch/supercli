{
  "name": "httptap",
  "version": "0.1.0",
  "description": "View HTTP/HTTPS requests made by any Linux program",
  "source": "https://github.com/httptap/httptap",
  "checks": [
    {
      "type": "binary",
      "name": "httptap"
    }
  ],
  "install_guidance": {
    "plugin": "httptap",
    "binary": "httptap",
    "check": "which httptap",
    "install_steps": [
      "pip install httptap",
      "Verify: httptap --version",
      "supercli plugins install ./plugins/httptap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "httptap",
      "resource": "self",
      "action": "version",
      "description": "Print httptap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "httptap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install httptap: pip install httptap"
      },
      "args": []
    },
    {
      "namespace": "httptap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to httptap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "httptap",
        "passthrough": true,
        "missingDependencyHelp": "Install httptap: pip install httptap"
      },
      "args": []
    }
  ]
}