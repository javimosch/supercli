{
  "name": "robotics_essentials_ros2",
  "version": "0.1.0",
  "description": "Learn the basics of robotics through hands-on experience using ROS 2 and Gazebo simulation.",
  "source": "https://github.com/robotics_essentials_ros2/robotics_essentials_ros2",
  "checks": [
    {
      "type": "binary",
      "name": "robotics-essentials-ros2"
    }
  ],
  "install_guidance": {
    "plugin": "robotics_essentials_ros2",
    "binary": "robotics-essentials-ros2",
    "check": "which robotics-essentials-ros2",
    "install_steps": [
      "pip install robotics-essentials-ros2",
      "Verify: robotics-essentials-ros2 --version",
      "supercli plugins install ./plugins/robotics_essentials_ros2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "robotics_essentials_ros2",
      "resource": "self",
      "action": "version",
      "description": "Print robotics_essentials_ros2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "robotics-essentials-ros2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install robotics_essentials_ros2: pip install robotics-essentials-ros2"
      },
      "args": []
    },
    {
      "namespace": "robotics_essentials_ros2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to robotics-essentials-ros2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "robotics-essentials-ros2",
        "passthrough": true,
        "missingDependencyHelp": "Install robotics_essentials_ros2: pip install robotics-essentials-ros2"
      },
      "args": []
    }
  ]
}