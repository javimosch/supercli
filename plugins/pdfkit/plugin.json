{
  "name": "pdfkit",
  "version": "0.1.0",
  "description": "PDF generation library with CLI",
  "source": "https://github.com/foliojs/pdfkit",
  "checks": [
    {
      "type": "binary",
      "name": "pdfkit"
    }
  ],
  "install_guidance": {
    "plugin": "pdfkit",
    "binary": "pdfkit",
    "check": "which pdfkit",
    "install_steps": [
      "npm install -g pdfkit",
      "Verify: pdfkit --version",
      "supercli plugins install ./plugins/pdfkit --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "pdfkit",
      "resource": "self",
      "action": "version",
      "description": "Print pdfkit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdfkit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdfkit: npm install -g pdfkit"
      },
      "args": []
    },
    {
      "namespace": "pdfkit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdfkit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdfkit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdfkit: npm install -g pdfkit"
      },
      "args": []
    }
  ]
}
