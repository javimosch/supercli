{
  "name": "serie",
  "version": "0.1.0",
  "description": "serie - Rich git commit graph in terminal",
  "source": "github.com/lunaryorn/serie",
  "checks": [
    {
      "type": "binary",
      "name": "serie"
    }
  ],
  "install_guidance": {
    "plugin": "serie",
    "binary": "serie",
    "check": "which serie",
    "install_steps": [
      "cargo install serie"
    ]
  },
  "commands": [
    {
      "namespace": "serie",
      "resource": "graph",
      "action": "show",
      "description": "Show rich git commit graph in terminal",
      "adapter": "process",
      "adapterConfig": {
        "command": "serie",
        "passthrough": true,
        "invoke_cwd": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install serie from github.com/lunaryorn/serie"
      },
      "args": []
    }
  ]
}