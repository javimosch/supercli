{
  "name": "WaEnhancer",
  "version": "0.1.0",
  "description": "WhatsApp tools for Android",
  "source": "https://github.com/WaEnhancer/WaEnhancer",
  "checks": [
    {
      "type": "binary",
      "name": "waenhancer"
    }
  ],
  "install_guidance": {
    "plugin": "WaEnhancer",
    "binary": "waenhancer",
    "check": "which waenhancer",
    "install_steps": [
      "pip install waenhancer",
      "Verify: waenhancer --version",
      "supercli plugins install ./plugins/WaEnhancer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "WaEnhancer",
      "resource": "self",
      "action": "version",
      "description": "Print WaEnhancer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "waenhancer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install WaEnhancer: pip install waenhancer"
      },
      "args": []
    },
    {
      "namespace": "WaEnhancer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to waenhancer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "waenhancer",
        "passthrough": true,
        "missingDependencyHelp": "Install WaEnhancer: pip install waenhancer"
      },
      "args": []
    }
  ]
}