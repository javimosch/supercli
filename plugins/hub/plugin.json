{
  "name": "hub",
  "version": "1.0.0",
  "description": "hub \u2014 GitHub CLI wrapper",
  "source": "hub.github.com",
  "checks": [
    {
      "type": "binary",
      "name": "hub"
    }
  ],
  "install_guidance": {
    "plugin": "hub",
    "binary": "hub",
    "check": "which hub",
    "install_steps": [
      "# Install hub:",
      "# apt: sudo apt-get install hub",
      "# brew: brew install hub",
      "# cargo: cargo install hub",
      "# npm: npm install -g hub",
      "# pip: pip install hub",
      "# or download from hub.github.com"
    ]
  },
  "commands": [
    {
      "namespace": "hub",
      "resource": "hub",
      "action": "run",
      "description": "Run hub",
      "adapter": "process",
      "adapterConfig": {
        "command": "hub",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install hub from hub.github.com"
      },
      "args": []
    }
  ]
}