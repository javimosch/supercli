{
  "name": "redis-client-benchmarks",
  "version": "0.1.0",
  "description": "A benchmark for Redis client libraries in various programming languages.",
  "source": "https://www.stefanwille.com/2015/05/redis-clients-crystal-vs-ruby-vs-c-vs-go/",
  "checks": [
    {
      "type": "binary",
      "name": "redis-client-benchmarks"
    }
  ],
  "install_guidance": {
    "plugin": "redis-client-benchmarks",
    "binary": "redis-client-benchmarks",
    "check": "which redis-client-benchmarks",
    "install_steps": [
      "Check https://www.stefanwille.com/2015/05/redis-clients-crystal-vs-ruby-vs-c-vs-go/ for installation instructions",
      "Verify: redis-client-benchmarks --version",
      "supercli plugins install ./plugins/redis-client-benchmarks --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "redis-client-benchmarks",
      "resource": "self",
      "action": "version",
      "description": "Print redis-client-benchmarks version",
      "adapter": "process",
      "adapterConfig": {
        "command": "redis-client-benchmarks",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install redis-client-benchmarks from project repository"
      },
      "args": []
    },
    {
      "namespace": "redis-client-benchmarks",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to redis-client-benchmarks CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "redis-client-benchmarks",
        "passthrough": true,
        "missingDependencyHelp": "Install redis-client-benchmarks from project repository"
      },
      "args": []
    }
  ]
}