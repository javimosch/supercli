{
  "name": "gpt-cli",
  "version": "0.1.0",
  "description": "Command-line interface to ChatGPT models",
  "source": "https://github.com/kharvd/gpt-cli",
  "checks": [{ "type": "binary", "name": "gpt-cli" }],
  "install_guidance": {
    "plugin": "gpt-cli",
    "binary": "gpt-cli",
    "check": "which gpt-cli",
    "install_steps": ["npm install -g gpt-cli", "Verify: gpt-cli --version", "supercli plugins install ./plugins/gpt-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gpt-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gpt-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gpt-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install gpt-cli: npm install -g gpt-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
