{
  "name": "gdiffmk",
  "version": "0.1.0",
  "description": "CLI tool: gdiffmk",
  "source": "https://manpages.debian.org/gdiffmk",
  "checks": [
    {
      "type": "binary",
      "name": "gdiffmk"
    }
  ],
  "install_guidance": {
    "plugin": "gdiffmk",
    "binary": "gdiffmk",
    "check": "which gdiffmk",
    "install_steps": [
      "apt-get install gdiffmk 2>/dev/null || which gdiffmk",
      "Verify: gdiffmk --version",
      "supercli plugins install ./plugins/gdiffmk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdiffmk",
      "resource": "self",
      "action": "version",
      "description": "Print gdiffmk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdiffmk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdiffmk: apt-get install gdiffmk 2>/dev/null || which gdiffmk"
      },
      "args": []
    },
    {
      "namespace": "gdiffmk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdiffmk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdiffmk",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gdiffmk: apt-get install gdiffmk 2>/dev/null || which gdiffmk"
      },
      "args": []
    }
  ]
}