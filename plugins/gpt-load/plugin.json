{
  "name": "gpt-load",
  "version": "0.1.0",
  "description": "Multi-channel AI proxy with intelligent key rotation. \u667a\u80fd\u5bc6\u94a5\u8f6e\u8be2\u7684\u591a\u6e20\u9053 AI \u4ee3\u7406\u3002",
  "source": "https://github.com/gpt-load/gpt-load",
  "checks": [
    {
      "type": "binary",
      "name": "gpt-load"
    }
  ],
  "install_guidance": {
    "plugin": "gpt-load",
    "binary": "gpt-load",
    "check": "which gpt-load",
    "install_steps": [
      "pip install gpt-load",
      "Verify: gpt-load --version",
      "supercli plugins install ./plugins/gpt-load --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gpt-load",
      "resource": "self",
      "action": "version",
      "description": "Print gpt-load version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpt-load",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gpt-load: pip install gpt-load"
      },
      "args": []
    },
    {
      "namespace": "gpt-load",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpt-load CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpt-load",
        "passthrough": true,
        "missingDependencyHelp": "Install gpt-load: pip install gpt-load"
      },
      "args": []
    }
  ]
}