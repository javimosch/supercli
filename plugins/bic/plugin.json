{
  "name": "bic",
  "version": "0.1.0",
  "description": "C interpreter and API explorer",
  "source": "https://github.com/hexagonal-sun/bic",
  "checks": [
    {
      "type": "binary",
      "name": "bic"
    }
  ],
  "install_guidance": {
    "plugin": "bic",
    "binary": "bic",
    "check": "which bic",
    "install_steps": [
      "brew install bic",
      "Verify: bic --version",
      "supercli plugins install ./plugins/bic --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bic",
      "resource": "self",
      "action": "version",
      "description": "Print bic version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bic",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bic: brew install bic"
      },
      "args": []
    },
    {
      "namespace": "bic",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bic CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bic",
        "passthrough": true,
        "missingDependencyHelp": "Install bic"
      },
      "args": []
    }
  ]
}