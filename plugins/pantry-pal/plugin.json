{
  "name": "pantry-pal",
  "version": "0.1.0",
  "description": "Simple CLI for inventory management of kitchen staples",
  "source": "go",
  "checks": [{ "type": "binary", "name": "pantry-pal" }],
  "install_guidance": {
    "plugin": "pantry-pal",
    "binary": "pantry-pal",
    "check": "which pantry-pal",
    "install_steps": ["go install github.com/pantry-pal@latest", "Verify: pantry-pal --version", "supercli plugins install ./plugins/pantry-pal --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pantry-pal",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pantry-pal CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pantry-pal",
      "passthrough": true,
      "missingDependencyHelp": "Install pantry-pal: go install github.com/pantry-pal@latest"
    },
    "args": []
  }]
}
