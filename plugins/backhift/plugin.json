{
  "name": "backhift",
  "version": "0.1.0",
  "description": "Simple command-line directory backup tool with scheduling",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "backhift" }],
  "install_guidance": {
    "plugin": "backhift",
    "binary": "backhift",
    "check": "which backhift",
    "install_steps": ["git clone && pip install .", "Verify: backhift --version", "supercli plugins install ./plugins/backhift --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "backhift",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to backhift CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "backhift",
      "passthrough": true,
      "missingDependencyHelp": "Install backhift: git clone && pip install ."
    },
    "args": []
  }]
}
