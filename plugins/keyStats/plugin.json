{
  "name": "keyStats",
  "version": "0.1.0",
  "description": "Keyboard & Mouse Stats for macOS/Windows",
  "source": "https://github.com/keyStats/keyStats",
  "checks": [
    {
      "type": "binary",
      "name": "keystats"
    }
  ],
  "install_guidance": {
    "plugin": "keyStats",
    "binary": "keystats",
    "check": "which keystats",
    "install_steps": [
      "pip install keystats",
      "Verify: keystats --version",
      "supercli plugins install ./plugins/keyStats --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "keyStats",
      "resource": "self",
      "action": "version",
      "description": "Print keyStats version",
      "adapter": "process",
      "adapterConfig": {
        "command": "keystats",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install keyStats: pip install keystats"
      },
      "args": []
    },
    {
      "namespace": "keyStats",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to keystats CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "keystats",
        "passthrough": true,
        "missingDependencyHelp": "Install keyStats: pip install keystats"
      },
      "args": []
    }
  ]
}