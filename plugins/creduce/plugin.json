{
  "name": "creduce",
  "version": "0.1.0",
  "description": "Reduce a C/C++ program while keeping a property of interest",
  "source": "https://github.com/csmith-project/creduce",
  "checks": [
    {
      "type": "binary",
      "name": "creduce"
    }
  ],
  "install_guidance": {
    "plugin": "creduce",
    "binary": "creduce",
    "check": "which creduce",
    "install_steps": [
      "brew install creduce",
      "Verify: creduce --version",
      "supercli plugins install ./plugins/creduce --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "creduce",
      "resource": "self",
      "action": "version",
      "description": "Print creduce version",
      "adapter": "process",
      "adapterConfig": {
        "command": "creduce",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install creduce: brew install creduce"
      },
      "args": []
    },
    {
      "namespace": "creduce",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to creduce CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "creduce",
        "passthrough": true,
        "missingDependencyHelp": "Install creduce"
      },
      "args": []
    }
  ]
}