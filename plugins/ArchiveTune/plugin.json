{
  "name": "ArchiveTune",
  "version": "0.1.0",
  "description": "The Cutest Material 3 Expressive Music Player With Support Local File and Youtube Music for Android.",
  "source": "https://github.com/ArchiveTune/ArchiveTune",
  "checks": [
    {
      "type": "binary",
      "name": "archivetune"
    }
  ],
  "install_guidance": {
    "plugin": "ArchiveTune",
    "binary": "archivetune",
    "check": "which archivetune",
    "install_steps": [
      "pip install archivetune",
      "Verify: archivetune --version",
      "supercli plugins install ./plugins/ArchiveTune --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ArchiveTune",
      "resource": "self",
      "action": "version",
      "description": "Print ArchiveTune version",
      "adapter": "process",
      "adapterConfig": {
        "command": "archivetune",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ArchiveTune: pip install archivetune"
      },
      "args": []
    },
    {
      "namespace": "ArchiveTune",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to archivetune CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "archivetune",
        "passthrough": true,
        "missingDependencyHelp": "Install ArchiveTune: pip install archivetune"
      },
      "args": []
    }
  ]
}