{
  "name": "My-Brain-Is-Full-Crew",
  "version": "0.1.0",
  "description": "Built by a PhD whose memory was failing, whose diet was a mess, and whose anxiety had its own agenda",
  "source": "https://github.com/My-Brain-Is-Full-Crew/My-Brain-Is-Full-Crew",
  "checks": [
    {
      "type": "binary",
      "name": "my-brain-is-full-crew"
    }
  ],
  "install_guidance": {
    "plugin": "My-Brain-Is-Full-Crew",
    "binary": "my-brain-is-full-crew",
    "check": "which my-brain-is-full-crew",
    "install_steps": [
      "pip install my-brain-is-full-crew",
      "Verify: my-brain-is-full-crew --version",
      "supercli plugins install ./plugins/My-Brain-Is-Full-Crew --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "My-Brain-Is-Full-Crew",
      "resource": "self",
      "action": "version",
      "description": "Print My-Brain-Is-Full-Crew version",
      "adapter": "process",
      "adapterConfig": {
        "command": "my-brain-is-full-crew",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install My-Brain-Is-Full-Crew: pip install my-brain-is-full-crew"
      },
      "args": []
    },
    {
      "namespace": "My-Brain-Is-Full-Crew",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to my-brain-is-full-crew CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "my-brain-is-full-crew",
        "passthrough": true,
        "missingDependencyHelp": "Install My-Brain-Is-Full-Crew: pip install my-brain-is-full-crew"
      },
      "args": []
    }
  ]
}