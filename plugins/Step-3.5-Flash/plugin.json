{
  "name": "Step-3.5-Flash",
  "version": "0.1.0",
  "description": "Fast, Sharp & Reliable Agentic Intelligence",
  "source": "https://github.com/Step-3.5-Flash/Step-3.5-Flash",
  "checks": [
    {
      "type": "binary",
      "name": "step-3.5-flash"
    }
  ],
  "install_guidance": {
    "plugin": "Step-3.5-Flash",
    "binary": "step-3.5-flash",
    "check": "which step-3.5-flash",
    "install_steps": [
      "pip install step-3.5-flash",
      "Verify: step-3.5-flash --version",
      "supercli plugins install ./plugins/Step-3.5-Flash --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Step-3.5-Flash",
      "resource": "self",
      "action": "version",
      "description": "Print Step-3.5-Flash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "step-3.5-flash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Step-3.5-Flash: pip install step-3.5-flash"
      },
      "args": []
    },
    {
      "namespace": "Step-3.5-Flash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to step-3.5-flash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "step-3.5-flash",
        "passthrough": true,
        "missingDependencyHelp": "Install Step-3.5-Flash: pip install step-3.5-flash"
      },
      "args": []
    }
  ]
}