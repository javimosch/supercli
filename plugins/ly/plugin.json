{
  "name": "ly",
  "version": "0.1.0",
  "description": "Parse, manipulate or create documents in LilyPond format",
  "source": "https://github.com/frescobaldi/python-ly",
  "checks": [
    {
      "type": "binary",
      "name": "ly"
    }
  ],
  "install_guidance": {
    "plugin": "ly",
    "binary": "ly",
    "check": "which ly",
    "install_steps": [
      "brew install ly",
      "Verify: ly --version",
      "supercli plugins install ./plugins/ly --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ly",
      "resource": "self",
      "action": "version",
      "description": "Print ly version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ly",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ly: brew install ly"
      },
      "args": []
    },
    {
      "namespace": "ly",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ly CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ly",
        "passthrough": true,
        "missingDependencyHelp": "Install ly"
      },
      "args": []
    }
  ]
}