{
  "name": "git-delete-merged-branches",
  "version": "0.1.0",
  "description": "Delete merged git branches",
  "source": "https://github.com/hartwork/git-delete-merged-branches",
  "checks": [
    {
      "type": "binary",
      "name": "git-delete-merged-branches"
    }
  ],
  "install_guidance": {
    "plugin": "git-delete-merged-branches",
    "binary": "git-delete-merged-branches",
    "check": "which git-delete-merged-branches",
    "install_steps": [
      "npm install -g git-delete-merged-branches",
      "Verify: git-delete-merged-branches --version",
      "supercli plugins install ./plugins/git-delete-merged-branches --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "git-delete-merged-branches",
      "resource": "self",
      "action": "version",
      "description": "Print git-delete-merged-branches version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-delete-merged-branches",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-delete-merged-branches: npm install -g git-delete-merged-branches"
      },
      "args": []
    },
    {
      "namespace": "git-delete-merged-branches",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-delete-merged-branches CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-delete-merged-branches",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install git-delete-merged-branches: npm install -g git-delete-merged-branches"
      },
      "args": []
    }
  ]
}
