{
  "name": "infracost",
  "version": "0.1.0",
  "description": "Cloud cost estimates for Terraform infrastructure changes",
  "source": "https://github.com/infracost/infracost",
  "checks": [{ "type": "binary", "name": "infracost" }],
  "install_guidance": {
    "plugin": "infracost",
    "binary": "infracost",
    "check": "which infracost",
    "install_steps": ["brew install infracost", "Verify: infracost --version", "supercli plugins install ./plugins/infracost --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "infracost",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to infracost CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "infracost",
      "passthrough": true,
      "missingDependencyHelp": "Install infracost: brew install infracost"
    },
    "args": []
  }]
}
