{
  "name": "pacu",
  "version": "0.1.0",
  "description": "The AWS exploitation framework designed for testing AWS environment security",
  "source": "https://github.com/RhinoSecurityLabs/pacu",
  "checks": [{ "type": "binary", "name": "pacu" }],
  "install_guidance": {
    "plugin": "pacu",
    "binary": "pacu",
    "check": "which pacu",
    "install_steps": [
      "pip install pacu",
      "Or: pipx install pacu",
      "Verify: pacu --version",
      "supercli plugins install ./plugins/pacu --on-conflict replace --json"
    ],
    "note": "Available via pip/pipx. Source: https://github.com/RhinoSecurityLabs/pacu (5.2k+ stars). Written in Python."
  },
  "commands": [
    {
      "namespace": "pacu", "resource": "self", "action": "version",
      "description": "Print pacu version",
      "adapter": "process",
      "adapterConfig": { "command": "pacu", "missingDependencyHelp": "Install pacu: pip install pacu", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "pacu", "resource": "_", "action": "_",
      "description": "Passthrough to pacu CLI",
      "adapter": "process",
      "adapterConfig": { "command": "pacu", "missingDependencyHelp": "Install pacu: pip install pacu", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
