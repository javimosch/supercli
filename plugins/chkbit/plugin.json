{
  "name": "chkbit",
  "version": "0.1.0",
  "description": "Check your files for data corruption",
  "checks": [
    {
      "type": "binary",
      "name": "chkbit"
    }
  ],
  "install_guidance": {
    "plugin": "chkbit",
    "binary": "chkbit",
    "check": "which chkbit",
    "install_steps": [
      "brew install chkbit",
      "Verify: chkbit --version",
      "supercli plugins install ./plugins/chkbit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chkbit",
      "resource": "self",
      "action": "version",
      "description": "Print chkbit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chkbit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chkbit: brew install chkbit"
      },
      "args": []
    },
    {
      "namespace": "chkbit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chkbit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chkbit",
        "passthrough": true,
        "missingDependencyHelp": "Install chkbit"
      },
      "args": []
    }
  ]
}