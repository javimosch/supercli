{
  "name": "helmify",
  "version": "0.1.0",
  "description": "Create Helm chart from Kubernetes yaml",
  "source": "https://github.com/arttor/helmify",
  "checks": [
    {
      "type": "binary",
      "name": "helmify"
    }
  ],
  "install_guidance": {
    "plugin": "helmify",
    "binary": "helmify",
    "check": "which helmify",
    "install_steps": [
      "brew install helmify",
      "Verify: helmify --version",
      "supercli plugins install ./plugins/helmify --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "helmify",
      "resource": "self",
      "action": "version",
      "description": "Print helmify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "helmify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install helmify: brew install helmify"
      },
      "args": []
    },
    {
      "namespace": "helmify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to helmify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "helmify",
        "passthrough": true,
        "missingDependencyHelp": "Install helmify"
      },
      "args": []
    }
  ]
}