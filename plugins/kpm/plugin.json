{
  "name": "kpm",
  "version": "0.1.0",
  "description": "Minimal CLI password manager using GPG encryption",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "kpm" }],
  "install_guidance": {
    "plugin": "kpm",
    "binary": "kpm",
    "check": "which kpm",
    "install_steps": ["git clone && make", "Verify: kpm --version", "supercli plugins install ./plugins/kpm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kpm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kpm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kpm",
      "passthrough": true,
      "missingDependencyHelp": "Install kpm: git clone && make"
    },
    "args": []
  }]
}
