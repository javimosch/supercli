{
  "name": "mdbook-katex",
  "version": "0.1.0",
  "description": "Math typesetting with KaTeX preprocessor for mdBook",
  "source": "https://github.com/lzanini/mdbook-katex",
  "checks": [{ "type": "binary", "name": "mdbook-katex" }],
  "install_guidance": {
    "plugin": "mdbook-katex",
    "binary": "mdbook-katex",
    "check": "which mdbook-katex",
    "install_steps": ["cargo install mdbook-katex", "Verify: mdbook-katex --version", "supercli plugins install ./plugins/mdbook-katex --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdbook-katex",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdbook-katex CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdbook-katex",
      "passthrough": true,
      "missingDependencyHelp": "Install mdbook-katex: cargo install mdbook-katex", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
