{
  "name": "l2test",
  "version": "0.1.0",
  "description": "CLI tool: l2test",
  "source": "https://manpages.debian.org/l2test",
  "checks": [
    {
      "type": "binary",
      "name": "l2test"
    }
  ],
  "install_guidance": {
    "plugin": "l2test",
    "binary": "l2test",
    "check": "which l2test",
    "install_steps": [
      "apt-get install l2test 2>/dev/null || which l2test",
      "Verify: l2test --version",
      "supercli plugins install ./plugins/l2test --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "l2test",
      "resource": "self",
      "action": "version",
      "description": "Print l2test version",
      "adapter": "process",
      "adapterConfig": {
        "command": "l2test",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install l2test: apt-get install l2test 2>/dev/null || which l2test"
      },
      "args": []
    },
    {
      "namespace": "l2test",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to l2test CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "l2test",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install l2test: apt-get install l2test 2>/dev/null || which l2test"
      },
      "args": []
    }
  ]
}