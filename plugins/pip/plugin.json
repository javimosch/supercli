{
  "name": "pip",
  "version": "1.0.0",
  "description": "pip \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=pip+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "pip"
    }
  ],
  "install_guidance": {
    "plugin": "pip",
    "binary": "pip",
    "check": "which pip",
    "install_steps": [
      "Install pip via package manager: apt install pip or brew install pip"
    ]
  },
  "commands": [
    {
      "namespace": "pip",
      "resource": "run",
      "action": "exec",
      "description": "pip \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "pip",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pip via your package manager"
      },
      "args": []
    }
  ]
}