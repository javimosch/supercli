{
  "name": "cli-pipe",
  "version": "0.1.0",
  "description": "Accept piped data as an argument to your CLI app",
  "source": "https://github.com/cli-pipe/cli-pipe",
  "checks": [
    {
      "type": "binary",
      "name": "cli-pipe"
    }
  ],
  "install_guidance": {
    "plugin": "cli-pipe",
    "binary": "cli-pipe",
    "check": "which cli-pipe",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cli-pipe --version",
      "supercli plugins install ./plugins/cli-pipe --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "cli-pipe",
      "resource": "self",
      "action": "version",
      "description": "Print cli-pipe version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-pipe",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-pipe from project repository"
      },
      "args": []
    },
    {
      "namespace": "cli-pipe",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-pipe CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-pipe",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-pipe from project repository"
      },
      "args": []
    }
  ]
}