{
  "name": "launch_socket_server",
  "version": "0.1.0",
  "description": "Bind to privileged ports without running a server as root",
  "source": "https://github.com/mistydemeo/launch_socket_server",
  "checks": [
    {
      "type": "binary",
      "name": "launch_socket_server"
    }
  ],
  "install_guidance": {
    "plugin": "launch_socket_server",
    "binary": "launch_socket_server",
    "check": "which launch_socket_server",
    "install_steps": [
      "brew install launch_socket_server",
      "Verify: launch_socket_server --version",
      "supercli plugins install ./plugins/launch_socket_server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "launch_socket_server",
      "resource": "self",
      "action": "version",
      "description": "Print launch_socket_server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "launch_socket_server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install launch_socket_server: brew install launch_socket_server"
      },
      "args": []
    },
    {
      "namespace": "launch_socket_server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to launch_socket_server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "launch_socket_server",
        "passthrough": true,
        "missingDependencyHelp": "Install launch_socket_server"
      },
      "args": []
    }
  ]
}