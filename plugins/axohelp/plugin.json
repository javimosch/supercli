{
  "name": "axohelp",
  "version": "0.1.0",
  "description": "CLI tool: axohelp",
  "source": "https://packages.debian.org/axohelp",
  "checks": [{ "type": "binary", "name": "axohelp" }],
  "install_guidance": {
    "plugin": "axohelp", "binary": "axohelp", "check": "which axohelp",
    "install_steps": ["apt-get install axohelp 2>/dev/null || which axohelp", "Verify: axohelp --version", "supercli plugins install ./plugins/axohelp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "axohelp", "resource": "_", "action": "_",
    "description": "Passthrough to axohelp CLI",
    "adapter": "process", "adapterConfig": { "command": "axohelp", "passthrough": true, "missingDependencyHelp": "Install axohelp: apt-get install axohelp" }, "args": []
  }]
}
