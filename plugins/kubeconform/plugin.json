{
  "name": "kubeconform",
  "version": "0.1.0",
  "description": "Fast Kubernetes manifest validator with support for custom resources",
  "source": "https://github.com/yannh/kubeconform",
  "checks": [{ "type": "binary", "name": "kubeconform" }],
  "install_guidance": {
    "plugin": "kubeconform",
    "binary": "kubeconform",
    "check": "which kubeconform",
    "install_steps": ["brew install kubeconform", "Verify: kubeconform --version", "supercli plugins install ./plugins/kubeconform --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubeconform",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubeconform CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubeconform",
      "passthrough": true,
      "missingDependencyHelp": "Install kubeconform: brew install kubeconform"
    },
    "args": []
  }]
}
