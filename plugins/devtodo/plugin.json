{
  "name": "devtodo",
  "version": "0.1.0",
  "description": "CLI tool: devtodo",
  "source": "https://packages.debian.org/devtodo",
  "checks": [{ "type": "binary", "name": "devtodo" }],
  "install_guidance": {
    "plugin": "devtodo", "binary": "devtodo", "check": "which devtodo",
    "install_steps": ["apt-get install devtodo 2>/dev/null || which devtodo", "Verify: devtodo --version", "supercli plugins install ./plugins/devtodo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "devtodo", "resource": "_", "action": "_",
    "description": "Passthrough to devtodo CLI",
    "adapter": "process", "adapterConfig": { "command": "devtodo", "passthrough": true, "missingDependencyHelp": "Install devtodo: apt-get install devtodo" }, "args": []
  }]
}
