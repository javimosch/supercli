{
  "name": "bootctl",
  "version": "0.1.0",
  "description": "CLI tool: bootctl",
  "source": "https://packages.debian.org/bootctl",
  "checks": [{ "type": "binary", "name": "bootctl" }],
  "install_guidance": {
    "plugin": "bootctl", "binary": "bootctl", "check": "which bootctl",
    "install_steps": ["apt-get install bootctl 2>/dev/null || which bootctl", "Verify: bootctl --version", "supercli plugins install ./plugins/bootctl --on-conflict replace --json"]
