{
  "name": "frege-repl",
  "version": "0.1.0",
  "description": "REPL (read-eval-print loop) for Frege",
  "source": "https://github.com/Frege/frege-repl",
  "checks": [
    {
      "type": "binary",
      "name": "frege-repl"
    }
  ],
  "install_guidance": {
    "plugin": "frege-repl",
    "binary": "frege-repl",
    "check": "which frege-repl",
    "install_steps": [
      "brew install frege-repl",
      "Verify: frege-repl --version",
      "supercli plugins install ./plugins/frege-repl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "frege-repl",
      "resource": "self",
      "action": "version",
      "description": "Print frege-repl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "frege-repl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install frege-repl: brew install frege-repl"
      },
      "args": []
    },
    {
      "namespace": "frege-repl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to frege-repl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "frege-repl",
        "passthrough": true,
        "missingDependencyHelp": "Install frege-repl"
      },
      "args": []
    }
  ]
}