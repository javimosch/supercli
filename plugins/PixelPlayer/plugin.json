{
  "name": "PixelPlayer",
  "version": "0.1.0",
  "description": "privacy-first Android music player built with Material 3 Expressive. Play offline, sync lyrics, fine",
  "source": "https://github.com/PixelPlayer/PixelPlayer",
  "checks": [
    {
      "type": "binary",
      "name": "pixelplayer"
    }
  ],
  "install_guidance": {
    "plugin": "PixelPlayer",
    "binary": "pixelplayer",
    "check": "which pixelplayer",
    "install_steps": [
      "pip install pixelplayer",
      "Verify: pixelplayer --version",
      "supercli plugins install ./plugins/PixelPlayer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PixelPlayer",
      "resource": "self",
      "action": "version",
      "description": "Print PixelPlayer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pixelplayer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PixelPlayer: pip install pixelplayer"
      },
      "args": []
    },
    {
      "namespace": "PixelPlayer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pixelplayer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pixelplayer",
        "passthrough": true,
        "missingDependencyHelp": "Install PixelPlayer: pip install pixelplayer"
      },
      "args": []
    }
  ]
}