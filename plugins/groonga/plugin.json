{
  "name": "groonga",
  "version": "0.1.0",
  "description": "Fulltext search engine and column store",
  "checks": [
    {
      "type": "binary",
      "name": "groonga"
    }
  ],
  "install_guidance": {
    "plugin": "groonga",
    "binary": "groonga",
    "check": "which groonga",
    "install_steps": [
      "brew install groonga",
      "Verify: groonga --version",
      "supercli plugins install ./plugins/groonga --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "groonga",
      "resource": "self",
      "action": "version",
      "description": "Print groonga version",
      "adapter": "process",
      "adapterConfig": {
        "command": "groonga",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install groonga: brew install groonga"
      },
      "args": []
    },
    {
      "namespace": "groonga",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to groonga CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "groonga",
        "passthrough": true,
        "missingDependencyHelp": "Install groonga"
      },
      "args": []
    }
  ]
}