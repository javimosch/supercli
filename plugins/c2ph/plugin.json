{
  "name": "c2ph",
  "version": "0.1.0",
  "description": "CLI tool: c2ph",
  "source": "https://packages.debian.org/c2ph",
  "checks": [{ "type": "binary", "name": "c2ph" }],
  "install_guidance": {
    "plugin": "c2ph", "binary": "c2ph", "check": "which c2ph",
    "install_steps": ["apt-get install c2ph 2>/dev/null || which c2ph", "Verify: c2ph --version", "supercli plugins install ./plugins/c2ph --on-conflict replace --json"]
