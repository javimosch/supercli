  "commands": [{
    "namespace": "c2ph", "resource": "_", "action": "_",
    "description": "Passthrough to c2ph CLI",
    "adapter": "process", "adapterConfig": { "command": "c2ph", "passthrough": true, "missingDependencyHelp": "Install c2ph: apt-get install c2ph" }, "args": []
  }]
}
