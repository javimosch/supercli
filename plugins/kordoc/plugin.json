{
  "name": "kordoc",
  "version": "0.1.0",
  "description": "Parse Korean documents (HWP, HWPX, PDF, Office) to Markdown with CLI and MCP Server",
  "source": "https://github.com/chrisryugj/kordoc",
  "checks": [
    {
      "type": "binary",
      "name": "kordoc"
    }
  ],
  "install_guidance": {
    "plugin": "kordoc",
    "binary": "kordoc",
    "check": "which kordoc",
    "install_steps": [
      "npm install -g kordoc",
      "Verify: kordoc --version",
      "supercli plugins install ./plugins/kordoc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "kordoc",
    "resource": "self",
    "action": "version",
    "description": "Print kordoc version",
    "adapter": "process",
    "adapterConfig": {
      "command": "kordoc",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install kordoc: npm install -g kordoc"
    },
    "args": []
  },
  {
    "namespace": "kordoc",
    "resource": "doc",
    "action": "parse",
    "description": "Parse a document to Markdown",
    "adapter": "process",
    "adapterConfig": {
      "command": "kordoc",
      "baseArgs": [
        "parse"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install kordoc: npm install -g kordoc"
    },
    "args": []
  },
  {
    "namespace": "kordoc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kordoc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kordoc",
      "passthrough": true,
      "missingDependencyHelp": "Install kordoc"
    },
    "args": []
  }
]
}