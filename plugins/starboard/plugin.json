{
  "name": "starboard",
  "version": "0.1.0",
  "description": "Kubernetes-native security toolkit",
  "source": "https://github.com/aquasecurity/starboard",
  "checks": [{ "type": "binary", "name": "starboard" }],
  "install_guidance": {
    "plugin": "starboard",
    "binary": "starboard",
    "check": "which starboard",
    "install_steps": ["brew install starboard", "Verify: starboard --version", "supercli plugins install ./plugins/starboard --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "starboard",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to starboard CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "starboard",
      "passthrough": true,
      "missingDependencyHelp": "Install starboard: brew install starboard"
    },
    "args": []
  }]
}
