{
  "name": "json-c",
  "version": "0.1.0",
  "description": "JSON parser for C",
  "source": "https://github.com/json-c/json-c/wiki",
  "checks": [
    {
      "type": "binary",
      "name": "json-c"
    }
  ],
  "install_guidance": {
    "plugin": "json-c",
    "binary": "json-c",
    "check": "which json-c",
    "install_steps": [
      "brew install json-c",
      "Verify: json-c --version",
      "supercli plugins install ./plugins/json-c --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "json-c",
      "resource": "self",
      "action": "version",
      "description": "Print json-c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "json-c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install json-c: brew install json-c"
      },
      "args": []
    },
    {
      "namespace": "json-c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to json-c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "json-c",
        "passthrough": true,
        "missingDependencyHelp": "Install json-c"
      },
      "args": []
    }
  ]
}