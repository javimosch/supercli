{
  "name": "CnC_Tiberian_Dawn",
  "version": "0.1.0",
  "description": "Command and Conquer Tiberian Dawn",
  "source": "https://github.com/CnC_Tiberian_Dawn/CnC_Tiberian_Dawn",
  "checks": [
    {
      "type": "binary",
      "name": "cnc-tiberian-dawn"
    }
  ],
  "install_guidance": {
    "plugin": "CnC_Tiberian_Dawn",
    "binary": "cnc-tiberian-dawn",
    "check": "which cnc-tiberian-dawn",
    "install_steps": [
      "pip install cnc-tiberian-dawn",
      "Verify: cnc-tiberian-dawn --version",
      "supercli plugins install ./plugins/CnC_Tiberian_Dawn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CnC_Tiberian_Dawn",
      "resource": "self",
      "action": "version",
      "description": "Print CnC_Tiberian_Dawn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-tiberian-dawn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CnC_Tiberian_Dawn: pip install cnc-tiberian-dawn"
      },
      "args": []
    },
    {
      "namespace": "CnC_Tiberian_Dawn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cnc-tiberian-dawn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-tiberian-dawn",
        "passthrough": true,
        "missingDependencyHelp": "Install CnC_Tiberian_Dawn: pip install cnc-tiberian-dawn"
      },
      "args": []
    }
  ]
}