{
  "name": "diff-so-fancy",
  "version": "0.1.0",
  "description": "Human-readable diff output formatter. Transforms unified diffs into easier-to-read, colorized output.",
  "source": "https",
  "checks": [{"type": "binary", "name": "diff-so-fancy"}],
  "install_guidance": {
    "plugin": "diff-so-fancy",
    "binary": "diff-so-fancy",
    "check": "which diff-so-fancy",
    "install_steps": [
      "brew install diff-so-fancy",
      "Verify: diff-so-fancy --version",
      "supercli plugins install ./plugins/diff-so-fancy --on-conflict replace --json"
    ],
    "note": "Non-interactive CLI tool."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "diff",
      "resource": "self",
      "action": "version",
      "description": "Print diff-so-fancy version",
      "adapter": "process",
      "adapterConfig": {"command": "diff-so-fancy", "baseArgs": ["--version"], "missingDependencyHelp": "Install diff-so-fancy: brew install diff-so-fancy"},
      "args": []
    },
    {
      "namespace": "diff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to diff-so-fancy CLI",
      "adapter": "process",
      "adapterConfig": {"command": "diff-so-fancy", "passthrough": true, "missingDependencyHelp": "Install diff-so-fancy: brew install diff-so-fancy"},
      "args": []
    }
  ]
}
