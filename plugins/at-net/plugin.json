{
  "name": "at-net",
  "version": "0.1.0",
  "description": "CLI tool: at-net",
  "source": "https://packages.debian.org/at-net",
  "checks": [{ "type": "binary", "name": "at-net" }],
  "install_guidance": {
    "plugin": "at-net", "binary": "at-net", "check": "which at-net",
    "install_steps": ["apt-get install at-net 2>/dev/null || which at-net", "Verify: at-net --version", "supercli plugins install ./plugins/at-net --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-net", "resource": "_", "action": "_",
    "description": "Passthrough to at-net CLI",
    "adapter": "process", "adapterConfig": { "command": "at-net", "passthrough": true, "missingDependencyHelp": "Install at-net: apt-get install at-net" }, "args": []
  }]
}
