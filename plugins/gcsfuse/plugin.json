{
  "name": "gcsfuse",
  "version": "0.1.0",
  "description": "User-space file system for interacting with Google Cloud",
  "source": "https://github.com/googlecloudplatform/gcsfuse",
  "checks": [
    {
      "type": "binary",
      "name": "gcsfuse"
    }
  ],
  "install_guidance": {
    "plugin": "gcsfuse",
    "binary": "gcsfuse",
    "check": "which gcsfuse",
    "install_steps": [
      "brew install gcsfuse",
      "Verify: gcsfuse --version",
      "supercli plugins install ./plugins/gcsfuse --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gcsfuse",
      "resource": "self",
      "action": "version",
      "description": "Print gcsfuse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcsfuse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcsfuse: brew install gcsfuse"
      },
      "args": []
    },
    {
      "namespace": "gcsfuse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcsfuse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcsfuse",
        "passthrough": true,
        "missingDependencyHelp": "Install gcsfuse"
      },
      "args": []
    }
  ]
}