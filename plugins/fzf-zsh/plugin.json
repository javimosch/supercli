{
  "name": "fzf-zsh",
  "version": "0.1.0",
  "description": "Fzf integration for zsh — fuzzy search shell history and completions",
  "source": "https://github.com/fzf-zsh/fzf-zsh",
  "checks": [
    {
      "type": "binary",
      "name": "fzf-zsh"
    }
  ],
  "install_guidance": {
    "plugin": "fzf-zsh",
    "binary": "fzf-zsh",
    "check": "which fzf-zsh",
    "install_steps": [
      "cargo install fzf-zsh",
      "Verify: fzf-zsh --version",
      "supercli plugins install ./plugins/fzf-zsh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fzf-zsh",
      "resource": "self",
      "action": "version",
      "description": "Print fzf-zsh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzf-zsh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fzf-zsh: cargo install fzf-zsh"
      },
      "args": []
    },
    {
      "namespace": "fzf-zsh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fzf-zsh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzf-zsh",
        "passthrough": true,
        "missingDependencyHelp": "Install fzf-zsh: cargo install fzf-zsh"
      },
      "args": []
    }
  ]
}
