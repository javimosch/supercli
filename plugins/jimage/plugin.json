{
  "name": "jimage",
  "version": "0.1.0",
  "description": "CLI tool: jimage",
  "source": "https://manpages.debian.org/jimage",
  "checks": [
    {
      "type": "binary",
      "name": "jimage"
    }
  ],
  "install_guidance": {
    "plugin": "jimage",
    "binary": "jimage",
    "check": "which jimage",
    "install_steps": [
      "apt-get install jimage 2>/dev/null || which jimage",
      "Verify: jimage --version",
      "supercli plugins install ./plugins/jimage --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jimage",
      "resource": "self",
      "action": "version",
      "description": "Print jimage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jimage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jimage: apt-get install jimage 2>/dev/null || which jimage"
      },
      "args": []
    },
    {
      "namespace": "jimage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jimage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jimage",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jimage: apt-get install jimage 2>/dev/null || which jimage"
      },
      "args": []
    }
  ]
}