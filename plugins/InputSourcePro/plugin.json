{
  "name": "InputSourcePro",
  "version": "0.1.0",
  "description": "Switch and track your input sources with ease \u2728",
  "source": "https://github.com/InputSourcePro/InputSourcePro",
  "checks": [
    {
      "type": "binary",
      "name": "inputsourcepro"
    }
  ],
  "install_guidance": {
    "plugin": "InputSourcePro",
    "binary": "inputsourcepro",
    "check": "which inputsourcepro",
    "install_steps": [
      "pip install inputsourcepro",
      "Verify: inputsourcepro --version",
      "supercli plugins install ./plugins/InputSourcePro --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "InputSourcePro",
      "resource": "self",
      "action": "version",
      "description": "Print InputSourcePro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "inputsourcepro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install InputSourcePro: pip install inputsourcepro"
      },
      "args": []
    },
    {
      "namespace": "InputSourcePro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to inputsourcepro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "inputsourcepro",
        "passthrough": true,
        "missingDependencyHelp": "Install InputSourcePro: pip install inputsourcepro"
      },
      "args": []
    }
  ]
}