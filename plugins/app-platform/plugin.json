{
  "name": "app-platform",
  "version": "0.1.0",
  "description": "AppPlatform \u662f\u4e00\u4e2a\u524d\u6cbf\u7684\u5927\u6a21\u578b\u5e94\u7528\u5de5\u7a0b\uff0c\u65e8\u5728\u901a\u8fc7\u96c6\u6210\u7684\u58f0\u660e\u5f0f\u7f16\u7a0b\u548c\u4f4e\u4ee3\u7801\u914d\u7f6e\u5de5\u5177\uff0c\u7b80\u5316\u548c\u4f18\u5316\u5927\u6a21\u578b\u7684\u8bad\u7ec3\u4e0e\u63a8\u7406\u5e94\u7528\u7684\u5f00\u53d1\u8fc7\u7a0b\u3002\u672c\u5de5\u7a0b\u4e3a\u8f6f\u4ef6\u5de5\u7a0b\u5e08\u548c\u4ea7\u54c1\u7ecf\u7406\u63d0\u4f9b\u4e00\u4e2a\u5f3a\u5927\u7684\u3001\u53ef\u6269\u5c55\u7684\u73af\u5883\uff0c\u4ee5\u652f",
  "source": "https://github.com/app-platform/app-platform",
  "checks": [
    {
      "type": "binary",
      "name": "app-platform"
    }
  ],
  "install_guidance": {
    "plugin": "app-platform",
    "binary": "app-platform",
    "check": "which app-platform",
    "install_steps": [
      "pip install app-platform",
      "Verify: app-platform --version",
      "supercli plugins install ./plugins/app-platform --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "app-platform",
      "resource": "self",
      "action": "version",
      "description": "Print app-platform version",
      "adapter": "process",
      "adapterConfig": {
        "command": "app-platform",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install app-platform: pip install app-platform"
      },
      "args": []
    },
    {
      "namespace": "app-platform",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to app-platform CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "app-platform",
        "passthrough": true,
        "missingDependencyHelp": "Install app-platform: pip install app-platform"
      },
      "args": []
    }
  ]
}