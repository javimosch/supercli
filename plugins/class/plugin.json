{
  "name": "class",
  "version": "0.1.0",
  "description": "CLI tool: class",
  "source": "https://packages.debian.org/class",
  "checks": [{ "type": "binary", "name": "class" }],
  "install_guidance": {
    "plugin": "class", "binary": "class", "check": "which class",
    "install_steps": ["apt-get install class 2>/dev/null || which class", "Verify: class --version", "supercli plugins install ./plugins/class --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "class", "resource": "_", "action": "_",
    "description": "Passthrough to class CLI",
    "adapter": "process", "adapterConfig": { "command": "class", "passthrough": true, "missingDependencyHelp": "Install class: apt-get install class" }, "args": []
  }]
}
