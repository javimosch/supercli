{
  "name": "secretkeeper",
  "version": "0.1.0",
  "description": "Text protection tool for hiding and managing secrets in text",
  "source": "https://github.com/nicm/secretkeeper",
  "checks": [
    {
      "type": "binary",
      "name": "secretkeeper"
    }
  ],
  "install_guidance": {
    "plugin": "secretkeeper",
    "binary": "secretkeeper",
    "check": "which secretkeeper",
    "install_steps": [
      "cargo install secretkeeper",
      "Verify: secretkeeper --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "secretkeeper",
      "resource": "self",
      "action": "version",
      "description": "Print secretkeeper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "secretkeeper",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install secretkeeper: cargo install secretkeeper"
      },
      "args": []
    },
    {
      "namespace": "secretkeeper",
      "resource": "secret",
      "action": "protect",
      "description": "Protect and manage secrets in text content",
      "adapter": "process",
      "adapterConfig": {
        "command": "secretkeeper",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install secretkeeper: cargo install secretkeeper"
      },
      "args": []
    },
    {
      "namespace": "secretkeeper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to secretkeeper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "secretkeeper",
        "passthrough": true,
        "missingDependencyHelp": "Install secretkeeper: cargo install secretkeeper"
      },
      "args": []
    }
  ]
}