{
  "name": "NeoZygisk",
  "version": "0.1.0",
  "description": "Zygote injection with ptrace",
  "source": "https://github.com/NeoZygisk/NeoZygisk",
  "checks": [
    {
      "type": "binary",
      "name": "neozygisk"
    }
  ],
  "install_guidance": {
    "plugin": "NeoZygisk",
    "binary": "neozygisk",
    "check": "which neozygisk",
    "install_steps": [
      "pip install neozygisk",
      "Verify: neozygisk --version",
      "supercli plugins install ./plugins/NeoZygisk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NeoZygisk",
      "resource": "self",
      "action": "version",
      "description": "Print NeoZygisk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "neozygisk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NeoZygisk: pip install neozygisk"
      },
      "args": []
    },
    {
      "namespace": "NeoZygisk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to neozygisk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "neozygisk",
        "passthrough": true,
        "missingDependencyHelp": "Install NeoZygisk: pip install neozygisk"
      },
      "args": []
    }
  ]
}