{
  "name": "ferrules",
  "version": "0.1.0",
  "description": "Modern fast document parser in Rust — generates LLM-ready documents from PDFs",
  "source": "https://github.com/ferrules/ferrules",
  "checks": [
    {
      "type": "binary",
      "name": "ferrules"
    }
  ],
  "install_guidance": {
    "plugin": "ferrules",
    "binary": "ferrules",
    "check": "which ferrules",
    "install_steps": [
      "cargo install ferrules",
      "Verify: ferrules --version",
      "supercli plugins install ./plugins/ferrules --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ferrules",
      "resource": "self",
      "action": "version",
      "description": "Print ferrules version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ferrules",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ferrules: cargo install ferrules"
      },
      "args": []
    },
    {
      "namespace": "ferrules",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ferrules CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ferrules",
        "passthrough": true,
        "missingDependencyHelp": "Install ferrules: cargo install ferrules"
      },
      "args": []
    }
  ]
}
