{
  "name": "criterion",
  "version": "0.1.0",
  "description": "criterion — benchmarking library for Rust",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "criterion"
    }
  ],
  "install_guidance": {
    "plugin": "criterion",
    "binary": "criterion",
    "check": "which criterion",
    "install_steps": [
      "cargo install criterion",
      "Verify: criterion --version",
      "supercli plugins install ./plugins/criterion --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "criterion",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "criterion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install criterion"
      },
      "args": []
    }
  ]
}
