{
  "name": "askai",
  "version": "0.1.0",
  "description": "AI assistant directly in your command line",
  "source": "https://github.com/mritd/askai",
  "checks": [{ "type": "binary", "name": "askai" }],
  "install_guidance": {
    "plugin": "askai",
    "binary": "askai",
    "check": "which askai",
    "install_steps": ["npm install -g askai", "Verify: askai --version", "supercli plugins install ./plugins/askai --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "askai",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to askai CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "askai",
      "passthrough": true,
      "missingDependencyHelp": "Install askai: npm install -g askai", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
