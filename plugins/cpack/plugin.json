{
  "name": "cpack",
  "version": "0.1.0",
  "description": "CLI tool: cpack",
  "source": "https://packages.debian.org/cpack",
  "checks": [{ "type": "binary", "name": "cpack" }],
  "install_guidance": {
    "plugin": "cpack", "binary": "cpack", "check": "which cpack",
    "install_steps": ["apt-get install cpack 2>/dev/null || which cpack", "Verify: cpack --version", "supercli plugins install ./plugins/cpack --on-conflict replace --json"]
