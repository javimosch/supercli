{
  "name": "xclip-cutfile",
  "version": "0.1.0",
  "description": "CLI tool: xclip-cutfile",
  "source": "https://manpages.debian.org/xclip-cutfile",
  "checks": [
    {
      "type": "binary",
      "name": "xclip-cutfile"
    }
  ],
  "install_guidance": {
    "plugin": "xclip-cutfile",
    "binary": "xclip-cutfile",
    "check": "which xclip-cutfile",
    "install_steps": [
      "apt-get install xclip-cutfile 2>/dev/null || which xclip-cutfile",
      "Verify: xclip-cutfile --version",
      "supercli plugins install ./plugins/xclip-cutfile --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xclip-cutfile",
      "resource": "self",
      "action": "version",
      "description": "Print xclip-cutfile version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xclip-cutfile",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xclip-cutfile: apt-get install xclip-cutfile 2>/dev/null || which xclip-cutfile"
      },
      "args": []
    },
    {
      "namespace": "xclip-cutfile",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xclip-cutfile CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xclip-cutfile",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xclip-cutfile: apt-get install xclip-cutfile 2>/dev/null || which xclip-cutfile"
      },
      "args": []
    }
  ]
}