{
  "name": "csvprintf",
  "version": "0.1.0",
  "description": "Command-line utility for parsing CSV files",
  "source": "https://github.com/archiecobbs/csvprintf",
  "checks": [
    {
      "type": "binary",
      "name": "csvprintf"
    }
  ],
  "install_guidance": {
    "plugin": "csvprintf",
    "binary": "csvprintf",
    "check": "which csvprintf",
    "install_steps": [
      "brew install csvprintf",
      "Verify: csvprintf --version",
      "supercli plugins install ./plugins/csvprintf --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "csvprintf",
      "resource": "self",
      "action": "version",
      "description": "Print csvprintf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvprintf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csvprintf: brew install csvprintf"
      },
      "args": []
    },
    {
      "namespace": "csvprintf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csvprintf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvprintf",
        "passthrough": true,
        "missingDependencyHelp": "Install csvprintf"
      },
      "args": []
    }
  ]
}