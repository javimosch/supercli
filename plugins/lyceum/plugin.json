{
  "name": "lyceum",
  "version": "0.1.0",
  "description": "An MMO game written in Erlang + PostgreSQL (+ Omnigres) + Zig (+ Raylib), powered by a Nix-based dev",
  "source": "https://github.com/lyceum/lyceum",
  "checks": [
    {
      "type": "binary",
      "name": "lyceum"
    }
  ],
  "install_guidance": {
    "plugin": "lyceum",
    "binary": "lyceum",
    "check": "which lyceum",
    "install_steps": [
      "pip install lyceum",
      "Verify: lyceum --version",
      "supercli plugins install ./plugins/lyceum --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lyceum",
      "resource": "self",
      "action": "version",
      "description": "Print lyceum version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lyceum",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lyceum: pip install lyceum"
      },
      "args": []
    },
    {
      "namespace": "lyceum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lyceum CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lyceum",
        "passthrough": true,
        "missingDependencyHelp": "Install lyceum: pip install lyceum"
      },
      "args": []
    }
  ]
}