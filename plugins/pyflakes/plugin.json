{
  "name": "pyflakes",
  "version": "0.1.0",
  "description": "CLI tool: pyflakes",
  "source": "https://manpages.debian.org/pyflakes",
  "checks": [
    {
      "type": "binary",
      "name": "pyflakes"
    }
  ],
  "install_guidance": {
    "plugin": "pyflakes",
    "binary": "pyflakes",
    "check": "which pyflakes",
    "install_steps": [
      "apt-get install pyflakes 2>/dev/null || which pyflakes",
      "Verify: pyflakes --version",
      "supercli plugins install ./plugins/pyflakes --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyflakes",
      "resource": "self",
      "action": "version",
      "description": "Print pyflakes version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyflakes",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyflakes: apt-get install pyflakes 2>/dev/null || which pyflakes"
      },
      "args": []
    },
    {
      "namespace": "pyflakes",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyflakes CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyflakes",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyflakes: apt-get install pyflakes 2>/dev/null || which pyflakes"
      },
      "args": []
    }
  ]
}