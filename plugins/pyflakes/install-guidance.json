{
  "plugin": "pyflakes",
  "binary": "pyflakes",
  "check": "which pyflakes",
  "install_steps": [
    "apt-get install pyflakes 2>/dev/null || which pyflakes",
    "Verify: pyflakes --version",
    "supercli plugins install ./plugins/pyflakes --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}