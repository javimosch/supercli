{
  "name": "ppmtolj",
  "version": "0.1.0",
  "description": "CLI tool: ppmtolj",
  "source": "https://manpages.debian.org/ppmtolj",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtolj"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtolj",
    "binary": "ppmtolj",
    "check": "which ppmtolj",
    "install_steps": [
      "apt-get install ppmtolj 2>/dev/null || which ppmtolj",
      "Verify: ppmtolj --version",
      "supercli plugins install ./plugins/ppmtolj --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtolj",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtolj version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtolj",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtolj: apt-get install ppmtolj 2>/dev/null || which ppmtolj"
      },
      "args": []
    },
    {
      "namespace": "ppmtolj",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtolj CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtolj",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtolj: apt-get install ppmtolj 2>/dev/null || which ppmtolj"
      },
      "args": []
    }
  ]
}