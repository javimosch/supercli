{
  "name": "gx",
  "version": "0.1.0",
  "description": "Language-agnostic, universal package manager",
  "source": "https://github.com/whyrusleeping/gx",
  "checks": [
    {
      "type": "binary",
      "name": "gx"
    }
  ],
  "install_guidance": {
    "plugin": "gx",
    "binary": "gx",
    "check": "which gx",
    "install_steps": [
      "brew install gx",
      "Verify: gx --version",
      "supercli plugins install ./plugins/gx --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gx",
      "resource": "self",
      "action": "version",
      "description": "Print gx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gx: brew install gx"
      },
      "args": []
    },
    {
      "namespace": "gx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gx",
        "passthrough": true,
        "missingDependencyHelp": "Install gx"
      },
      "args": []
    }
  ]
}