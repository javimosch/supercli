{
  "name": "em-keyboard",
  "version": "0.1.0",
  "description": "CLI emoji keyboard in Python",
  "source": "https://github.com/nicedoc/em-keyboard",
  "checks": [
    {
      "type": "binary",
      "name": "em"
    }
  ],
  "install_guidance": {
    "plugin": "em-keyboard",
    "binary": "em",
    "check": "which em",
    "install_steps": [
      "pip install em-keyboard",
      "Verify: em --version",
      "supercli plugins install ./plugins/em-keyboard --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "em-keyboard",
      "resource": "self",
      "action": "version",
      "description": "Print em-keyboard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "em",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install em-keyboard: pip install em-keyboard"
      },
      "args": []
    },
    {
      "namespace": "em-keyboard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to em-keyboard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "em",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install em-keyboard: pip install em-keyboard"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
