{
  "name": "giti",
  "version": "0.1.0",
  "description": "Interactive gitignore generator with search",
  "source": "https://github.com/ahmadawais/giti",
  "checks": [{ "type": "binary", "name": "giti" }],
  "install_guidance": {
    "plugin": "giti",
    "binary": "giti",
    "check": "which giti",
    "install_steps": ["npm install -g giti", "Verify: giti --version", "supercli plugins install ./plugins/giti --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "giti",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to giti CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "giti",
      "passthrough": true,
      "missingDependencyHelp": "Install giti: npm install -g giti", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
