{
  "name": "ticker",
  "version": "0.1.0",
  "description": "Stock ticker",
  "source": "https://github.com/achannarasappa/ticker",
  "checks": [
    {
      "type": "binary",
      "name": "ticker"
    }
  ],
  "install_guidance": {
    "plugin": "ticker",
    "binary": "ticker",
    "check": "which ticker",
    "install_steps": [
      "See https://github.com/achannarasappa/ticker",
      "Verify: ticker --version",
      "supercli plugins install ./plugins/ticker --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ticker",
      "resource": "self",
      "action": "version",
      "description": "Print ticker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ticker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ticker: See https://github.com/achannarasappa/ticker"
      },
      "args": []
    },
    {
      "namespace": "ticker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ticker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ticker",
        "passthrough": true,
        "missingDependencyHelp": "Install ticker"
      },
      "args": []
    }
  ]
}