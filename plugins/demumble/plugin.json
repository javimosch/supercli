{
  "name": "demumble",
  "version": "0.1.0",
  "description": "More powerful symbol demangler (a la c++filt)",
  "source": "https://github.com/nico/demumble",
  "checks": [
    {
      "type": "binary",
      "name": "demumble"
    }
  ],
  "install_guidance": {
    "plugin": "demumble",
    "binary": "demumble",
    "check": "which demumble",
    "install_steps": [
      "brew install demumble",
      "Verify: demumble --version",
      "supercli plugins install ./plugins/demumble --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "demumble",
      "resource": "self",
      "action": "version",
      "description": "Print demumble version",
      "adapter": "process",
      "adapterConfig": {
        "command": "demumble",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install demumble: brew install demumble"
      },
      "args": []
    },
    {
      "namespace": "demumble",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to demumble CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "demumble",
        "passthrough": true,
        "missingDependencyHelp": "Install demumble"
      },
      "args": []
    }
  ]
}