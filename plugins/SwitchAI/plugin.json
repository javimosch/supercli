{
  "name": "SwitchAI",
  "version": "0.1.0",
  "description": "Easily select and manage your preferred AI digital assistants on Android.",
  "source": "https://github.com/SwitchAI/SwitchAI",
  "checks": [
    {
      "type": "binary",
      "name": "switchai"
    }
  ],
  "install_guidance": {
    "plugin": "SwitchAI",
    "binary": "switchai",
    "check": "which switchai",
    "install_steps": [
      "pip install switchai",
      "Verify: switchai --version",
      "supercli plugins install ./plugins/SwitchAI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SwitchAI",
      "resource": "self",
      "action": "version",
      "description": "Print SwitchAI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "switchai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SwitchAI: pip install switchai"
      },
      "args": []
    },
    {
      "namespace": "SwitchAI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to switchai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "switchai",
        "passthrough": true,
        "missingDependencyHelp": "Install SwitchAI: pip install switchai"
      },
      "args": []
    }
  ]
}