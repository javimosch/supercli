{
  "name": "freebayes",
  "version": "0.1.0",
  "description": "Bayesian haplotype-based genetic polymorphism discovery and genotyping",
  "source": "https://github.com/freebayes/freebayes",
  "checks": [
    {
      "type": "binary",
      "name": "freebayes"
    }
  ],
  "install_guidance": {
    "plugin": "freebayes",
    "binary": "freebayes",
    "check": "which freebayes",
    "install_steps": [
      "brew install freebayes",
      "Verify: freebayes --version",
      "supercli plugins install ./plugins/freebayes --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "freebayes",
      "resource": "self",
      "action": "version",
      "description": "Print freebayes version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freebayes",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install freebayes: brew install freebayes"
      },
      "args": []
    },
    {
      "namespace": "freebayes",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freebayes CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freebayes",
        "passthrough": true,
        "missingDependencyHelp": "Install freebayes"
      },
      "args": []
    }
  ]
}