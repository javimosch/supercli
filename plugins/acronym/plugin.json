{
  "name": "acronym",
  "version": "0.1.0",
  "description": "Python-based tool for creating English-ish acronyms from your fancy project",
  "source": "https://github.com/bacook17/acronym",
  "checks": [
    {
      "type": "binary",
      "name": "acronym"
    }
  ],
  "install_guidance": {
    "plugin": "acronym",
    "binary": "acronym",
    "check": "which acronym",
    "install_steps": [
      "brew install acronym",
      "Verify: acronym --version",
      "supercli plugins install ./plugins/acronym --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "acronym",
      "resource": "self",
      "action": "version",
      "description": "Print acronym version",
      "adapter": "process",
      "adapterConfig": {
        "command": "acronym",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install acronym: brew install acronym"
      },
      "args": []
    },
    {
      "namespace": "acronym",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to acronym CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "acronym",
        "passthrough": true,
        "missingDependencyHelp": "Install acronym"
      },
      "args": []
    }
  ]
}