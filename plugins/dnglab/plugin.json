{
  "name": "dnglab",
  "version": "0.1.0",
  "description": "Camera RAW to DNG file format converter",
  "source": "https://github.com/dnglab/dnglab",
  "checks": [
    {
      "type": "binary",
      "name": "dnglab"
    }
  ],
  "install_guidance": {
    "plugin": "dnglab",
    "binary": "dnglab",
    "check": "which dnglab",
    "install_steps": [
      "brew install dnglab",
      "Verify: dnglab --version",
      "supercli plugins install ./plugins/dnglab --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dnglab",
      "resource": "self",
      "action": "version",
      "description": "Print dnglab version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnglab",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dnglab: brew install dnglab"
      },
      "args": []
    },
    {
      "namespace": "dnglab",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dnglab CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnglab",
        "passthrough": true,
        "missingDependencyHelp": "Install dnglab"
      },
      "args": []
    }
  ]
}