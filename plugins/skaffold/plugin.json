{
  "name": "skaffold",
  "version": "0.1.0",
  "description": "Easy and repeatable Kubernetes development",
  "source": "https://github.com/GoogleContainerTools/skaffold",
  "checks": [{ "type": "binary", "name": "skaffold" }],
  "install_guidance": {
    "plugin": "skaffold",
    "binary": "skaffold",
    "check": "which skaffold",
    "install_steps": ["brew install skaffold", "Verify: skaffold --version", "supercli plugins install ./plugins/skaffold --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "skaffold",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to skaffold CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "skaffold",
      "passthrough": true,
      "missingDependencyHelp": "Install skaffold: brew install skaffold"
    },
    "args": []
  }]
}
