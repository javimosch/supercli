{
  "name": "forge",
  "version": "0.1.0",
  "description": "forge - Git forges CLI (GitLab, Gitea, Forgejo)",
  "source": "github.com/charmbracelet/forge",
  "checks": [
    {
      "type": "binary",
      "name": "forge"
    }
  ],
  "install_guidance": {
    "plugin": "forge",
    "binary": "forge",
    "check": "which forge",
    "install_steps": [
      "go install github.com/charmbracelet/forge@latest"
    ]
  },
  "commands": [
    {
      "namespace": "forge",
      "resource": "repo",
      "action": "run",
      "description": "Run Git forges CLI (GitLab, Gitea, Forgejo)",
      "adapter": "process",
      "adapterConfig": {
        "command": "forge",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install forge from github.com/charmbracelet/forge"
      },
      "args": []
    }
  ]
}