{
  "name": "passforge",
  "version": "0.1.0",
  "description": "Robust flexible CLI password generator in Rust",
  "source": "https://crates.io/crates/passforge",
  "checks": [{ "type": "binary", "name": "passforge" }],
  "install_guidance": {
    "plugin": "passforge",
    "binary": "passforge",
    "check": "which passforge",
    "install_steps": ["cargo install passforge", "Verify: passforge --version", "supercli plugins install ./plugins/passforge --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "passforge",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to passforge CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "passforge",
      "passthrough": true,
      "missingDependencyHelp": "Install passforge: cargo install passforge", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
