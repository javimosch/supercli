{
  "name": "libdeflate",
  "version": "0.1.0",
  "description": "Heavily optimized DEFLATE/zlib/gzip compression and decompression",
  "source": "https://github.com/ebiggers/libdeflate",
  "checks": [
    {
      "type": "binary",
      "name": "libdeflate"
    }
  ],
  "install_guidance": {
    "plugin": "libdeflate",
    "binary": "libdeflate",
    "check": "which libdeflate",
    "install_steps": [
      "brew install libdeflate",
      "Verify: libdeflate --version",
      "supercli plugins install ./plugins/libdeflate --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libdeflate",
      "resource": "self",
      "action": "version",
      "description": "Print libdeflate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libdeflate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libdeflate: brew install libdeflate"
      },
      "args": []
    },
    {
      "namespace": "libdeflate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libdeflate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libdeflate",
        "passthrough": true,
        "missingDependencyHelp": "Install libdeflate"
      },
      "args": []
    }
  ]
}