{
  "name": "Vifm",
  "version": "0.1.0",
  "description": "VI influenced file manager",
  "checks": [
    {
      "type": "binary",
      "name": "Vifm"
    }
  ],
  "install_guidance": {
    "plugin": "Vifm",
    "binary": "Vifm",
    "check": "which Vifm",
    "install_steps": [
      "brew install Vifm",
      "Verify: Vifm --version",
      "supercli plugins install ./plugins/Vifm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Vifm",
      "resource": "self",
      "action": "version",
      "description": "Print Vifm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Vifm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Vifm: brew install Vifm"
      },
      "args": []
    },
    {
      "namespace": "Vifm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Vifm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Vifm",
        "passthrough": true,
        "missingDependencyHelp": "Install Vifm"
      },
      "args": []
    }
  ]
}