{
  "name": "OwnDroid",
  "version": "0.1.0",
  "description": "\u4f7f\u7528\u5b89\u5353Device owner\u7279\u6743\u7ba1\u7406\u4f60\u7684\u8bbe\u5907\u3002Use Android Device owner privilege to manage your device.",
  "source": "https://github.com/OwnDroid/OwnDroid",
  "checks": [
    {
      "type": "binary",
      "name": "owndroid"
    }
  ],
  "install_guidance": {
    "plugin": "OwnDroid",
    "binary": "owndroid",
    "check": "which owndroid",
    "install_steps": [
      "pip install owndroid",
      "Verify: owndroid --version",
      "supercli plugins install ./plugins/OwnDroid --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OwnDroid",
      "resource": "self",
      "action": "version",
      "description": "Print OwnDroid version",
      "adapter": "process",
      "adapterConfig": {
        "command": "owndroid",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OwnDroid: pip install owndroid"
      },
      "args": []
    },
    {
      "namespace": "OwnDroid",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to owndroid CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "owndroid",
        "passthrough": true,
        "missingDependencyHelp": "Install OwnDroid: pip install owndroid"
      },
      "args": []
    }
  ]
}