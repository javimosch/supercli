{
  "name": "go-critic",
  "version": "0.1.0",
  "description": "go-critic \u2014 opinionated Go source code linter",
  "source": "https://formulae.brew.sh/formula/go-critic",
  "checks": [
    {
      "type": "binary",
      "name": "go-critic"
    }
  ],
  "install_guidance": {
    "plugin": "go-critic",
    "binary": "go-critic",
    "check": "which go-critic",
    "install_steps": [
      "brew install go-critic"
    ],
    "note": "Dev tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-critic",
      "resource": "_",
      "action": "_",
      "description": "Passthrough",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-critic",
        "passthrough": true,
        "missingDependencyHelp": "Install go-critic: brew install go-critic"
      },
      "args": []
    }
  ]
}
