{
  "name": "SpaghettiKart",
  "version": "0.1.0",
  "description": "I have spaghetti, now i just need a kart",
  "source": "https://github.com/SpaghettiKart/SpaghettiKart",
  "checks": [
    {
      "type": "binary",
      "name": "spaghettikart"
    }
  ],
  "install_guidance": {
    "plugin": "SpaghettiKart",
    "binary": "spaghettikart",
    "check": "which spaghettikart",
    "install_steps": [
      "pip install spaghettikart",
      "Verify: spaghettikart --version",
      "supercli plugins install ./plugins/SpaghettiKart --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SpaghettiKart",
      "resource": "self",
      "action": "version",
      "description": "Print SpaghettiKart version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spaghettikart",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SpaghettiKart: pip install spaghettikart"
      },
      "args": []
    },
    {
      "namespace": "SpaghettiKart",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spaghettikart CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spaghettikart",
        "passthrough": true,
        "missingDependencyHelp": "Install SpaghettiKart: pip install spaghettikart"
      },
      "args": []
    }
  ]
}