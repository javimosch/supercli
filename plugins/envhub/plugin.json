{
  "name": "envhub",
  "version": "0.1.0",
  "description": "Zero-knowledge secret and environment variable manager",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "envhub" }],
  "install_guidance": {
    "plugin": "envhub",
    "binary": "envhub",
    "check": "which envhub",
    "install_steps": ["git clone && python3 setup.py", "Verify: envhub --version", "supercli plugins install ./plugins/envhub --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "envhub",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to envhub CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "envhub",
      "passthrough": true,
      "missingDependencyHelp": "Install envhub: git clone && python3 setup.py"
    },
    "args": []
  }]
}
