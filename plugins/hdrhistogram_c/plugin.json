{
  "name": "hdrhistogram_c",
  "version": "0.1.0",
  "description": "C port of the HdrHistogram",
  "source": "https://github.com/HdrHistogram/HdrHistogram_c",
  "checks": [
    {
      "type": "binary",
      "name": "hdrhistogram_c"
    }
  ],
  "install_guidance": {
    "plugin": "hdrhistogram_c",
    "binary": "hdrhistogram_c",
    "check": "which hdrhistogram_c",
    "install_steps": [
      "brew install hdrhistogram_c",
      "Verify: hdrhistogram_c --version",
      "supercli plugins install ./plugins/hdrhistogram_c --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hdrhistogram_c",
      "resource": "self",
      "action": "version",
      "description": "Print hdrhistogram_c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdrhistogram_c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hdrhistogram_c: brew install hdrhistogram_c"
      },
      "args": []
    },
    {
      "namespace": "hdrhistogram_c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hdrhistogram_c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdrhistogram_c",
        "passthrough": true,
        "missingDependencyHelp": "Install hdrhistogram_c"
      },
      "args": []
    }
  ]
}