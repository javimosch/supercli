{
  "name": "Radiance",
  "version": "0.1.0",
  "description": "Radiance is rebuilt of Minecraft renderer on a Vulkan C++ backend, featuring native Hardware Ray Tra",
  "source": "https://github.com/Radiance/Radiance",
  "checks": [
    {
      "type": "binary",
      "name": "radiance"
    }
  ],
  "install_guidance": {
    "plugin": "Radiance",
    "binary": "radiance",
    "check": "which radiance",
    "install_steps": [
      "pip install radiance",
      "Verify: radiance --version",
      "supercli plugins install ./plugins/Radiance --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Radiance",
      "resource": "self",
      "action": "version",
      "description": "Print Radiance version",
      "adapter": "process",
      "adapterConfig": {
        "command": "radiance",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Radiance: pip install radiance"
      },
      "args": []
    },
    {
      "namespace": "Radiance",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to radiance CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "radiance",
        "passthrough": true,
        "missingDependencyHelp": "Install Radiance: pip install radiance"
      },
      "args": []
    }
  ]
}