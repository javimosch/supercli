{
  "name": "crane",
  "version": "0.1.0",
  "description": "Tool for interacting with container images and registries",
  "source": "https://github.com/google/go-containerregistry",
  "checks": [{ "type": "binary", "name": "crane" }],
  "install_guidance": {
    "plugin": "crane",
    "binary": "crane",
    "check": "which crane",
    "install_steps": ["go install github.com/google/go-containerregistry/cmd/crane@latest", "Verify: crane --version", "supercli plugins install ./plugins/crane --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "crane",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to crane CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "crane",
      "passthrough": true,
      "missingDependencyHelp": "Install crane: go install github.com/google/go-containerregistry/cmd/crane@latest"
    },
    "args": []
  }]
}
