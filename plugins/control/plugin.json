{
  "name": "control",
  "version": "0.1.0",
  "description": "CLI tool: control",
  "source": "https://packages.debian.org/control",
  "checks": [{ "type": "binary", "name": "control" }],
  "install_guidance": {
    "plugin": "control", "binary": "control", "check": "which control",
    "install_steps": ["apt-get install control 2>/dev/null || which control", "Verify: control --version", "supercli plugins install ./plugins/control --on-conflict replace --json"]
