{
  "name": "dash-el",
  "version": "1.0.0",
  "description": "dash-el \u2014 Dash documentation",
  "source": "kapeli.com/dash",
  "checks": [
    {
      "type": "binary",
      "name": "dash"
    }
  ],
  "install_guidance": {
    "plugin": "dash-el",
    "binary": "dash",
    "check": "which dash",
    "install_steps": [
      "# Install dash-el",
      "# See kapeli.com/dash",
      "# apt: sudo apt-get install dash-el",
      "# brew: brew install dash-el",
      "# cargo: cargo install dash-el",
      "# npm: npm install -g dash-el",
      "# pip: pip install dash-el"
    ]
  },
  "commands": [
    {
      "namespace": "dash",
      "resource": "el",
      "action": "run",
      "description": "Run dash-el",
      "adapter": "process",
      "adapterConfig": {
        "command": "dash",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dash-el from kapeli.com/dash"
      },
      "args": []
    }
  ]
}