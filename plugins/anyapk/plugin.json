{
  "name": "anyapk",
  "version": "0.1.0",
  "description": "Install any apk on the device you own. ",
  "source": "https://github.com/anyapk/anyapk",
  "checks": [
    {
      "type": "binary",
      "name": "anyapk"
    }
  ],
  "install_guidance": {
    "plugin": "anyapk",
    "binary": "anyapk",
    "check": "which anyapk",
    "install_steps": [
      "pip install anyapk",
      "Verify: anyapk --version",
      "supercli plugins install ./plugins/anyapk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "anyapk",
      "resource": "self",
      "action": "version",
      "description": "Print anyapk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "anyapk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install anyapk: pip install anyapk"
      },
      "args": []
    },
    {
      "namespace": "anyapk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to anyapk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "anyapk",
        "passthrough": true,
        "missingDependencyHelp": "Install anyapk: pip install anyapk"
      },
      "args": []
    }
  ]
}