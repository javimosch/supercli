{
  "name": "explodeview",
  "version": "0.1.0",
  "description": "Tool chain for converting STEP/CAD files to JSON/3D browser views",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "explodeview" }],
  "install_guidance": {
    "plugin": "explodeview",
    "binary": "explodeview",
    "check": "which explodeview",
    "install_steps": ["npm install -g explodeview", "Verify: explodeview --version", "supercli plugins install ./plugins/explodeview --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "explodeview",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to explodeview CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "explodeview",
      "passthrough": true,
      "missingDependencyHelp": "Install explodeview: npm install -g explodeview"
    },
    "args": []
  }]
}
