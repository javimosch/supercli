{
  "name": "tree-climb",
  "version": "0.1.0",
  "description": "tree-climb — recursively search directory tree",
  "source": "https://formulae.brew.sh/formula/tree-climb",
  "checks": [
    {
      "type": "binary",
      "name": "tree-climb"
    }
  ],
  "install_guidance": {
    "plugin": "tree-climb",
    "binary": "tree-climb",
    "check": "which tree-climb",
    "install_steps": [
      "cargo add tree-climb",
      "Verify: tree-climb --version",
      "supercli plugins install ./plugins/tree-climb --on-conflict replace --json"
    ],
    "note": "tree-climb is a Rust library — use `cargo add tree-climb` inside a Rust project."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tree-climb",
      "resource": "self",
      "action": "version",
      "description": "Print tree-climb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tree-climb",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install tree-climb: cargo add tree-climb"
      },
      "args": []
    }
  ]
}
