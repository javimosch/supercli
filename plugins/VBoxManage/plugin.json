{
  "name": "VBoxManage",
  "version": "0.1.0",
  "description": "CLI tool: VBoxManage",
  "source": "https://manpages.debian.org/VBoxManage",
  "checks": [
    {
      "type": "binary",
      "name": "VBoxManage"
    }
  ],
  "install_guidance": {
    "plugin": "VBoxManage",
    "binary": "VBoxManage",
    "check": "which VBoxManage",
    "install_steps": [
      "apt-get install VBoxManage 2>/dev/null || which VBoxManage",
      "Verify: VBoxManage --version",
      "supercli plugins install ./plugins/VBoxManage --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VBoxManage",
      "resource": "self",
      "action": "version",
      "description": "Print VBoxManage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "VBoxManage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VBoxManage: apt-get install VBoxManage 2>/dev/null || which VBoxManage"
      },
      "args": []
    },
    {
      "namespace": "VBoxManage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to VBoxManage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "VBoxManage",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install VBoxManage: apt-get install VBoxManage 2>/dev/null || which VBoxManage"
      },
      "args": []
    }
  ]
}