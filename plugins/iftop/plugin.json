{
  "name": "iftop",
  "version": "0.1.0",
  "description": "Network bandwidth monitoring tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "iftop"}],
  "install_guidance": {
    "plugin": "iftop",
    "binary": "iftop",
    "check": "which iftop",
    "install_steps": [
      "brew install iftop",
      "Verify: iftop --version",
      "supercli plugins install ./plugins/iftop --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "iftop",
      "resource": "self",
      "action": "version",
      "description": "Print iftop version",
      "adapter": "process",
      "adapterConfig": {"command": "iftop", "baseArgs": ["--version"], "missingDependencyHelp": "Install iftop: brew install iftop"},
      "args": []
    },
    {
      "namespace": "iftop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iftop CLI",
      "adapter": "process",
      "adapterConfig": {"command": "iftop", "passthrough": true, "missingDependencyHelp": "Install iftop: brew install iftop"},
      "args": []
    }
  ]
}
