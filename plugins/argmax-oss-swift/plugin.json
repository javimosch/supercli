{
  "name": "argmax-oss-swift",
  "version": "0.1.0",
  "description": "On-device Speech AI for Apple Silicon",
  "source": "https://github.com/argmax-oss-swift/argmax-oss-swift",
  "checks": [
    {
      "type": "binary",
      "name": "argmax-oss-swift"
    }
  ],
  "install_guidance": {
    "plugin": "argmax-oss-swift",
    "binary": "argmax-oss-swift",
    "check": "which argmax-oss-swift",
    "install_steps": [
      "pip install argmax-oss-swift",
      "Verify: argmax-oss-swift --version",
      "supercli plugins install ./plugins/argmax-oss-swift --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "argmax-oss-swift",
      "resource": "self",
      "action": "version",
      "description": "Print argmax-oss-swift version",
      "adapter": "process",
      "adapterConfig": {
        "command": "argmax-oss-swift",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install argmax-oss-swift: pip install argmax-oss-swift"
      },
      "args": []
    },
    {
      "namespace": "argmax-oss-swift",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to argmax-oss-swift CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "argmax-oss-swift",
        "passthrough": true,
        "missingDependencyHelp": "Install argmax-oss-swift: pip install argmax-oss-swift"
      },
      "args": []
    }
  ]
}