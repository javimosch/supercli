{
  "name": "Difftastic",
  "version": "0.1.0",
  "description": "Syntax-aware structured diff tool.",
  "source": "https://github.com/Wilfred/difftastic",
  "checks": [
    {
      "type": "binary",
      "name": "Difftastic"
    }
  ],
  "install_guidance": {
    "plugin": "Difftastic",
    "binary": "Difftastic",
    "check": "which Difftastic",
    "install_steps": [
      "cargo install Difftastic",
      "Verify: Difftastic --version",
      "supercli plugins install ./plugins/Difftastic --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Difftastic",
      "resource": "self",
      "action": "version",
      "description": "Print Difftastic version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Difftastic",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Difftastic: cargo install Difftastic"
      },
      "args": []
    },
    {
      "namespace": "Difftastic",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Difftastic CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Difftastic",
        "passthrough": true,
        "missingDependencyHelp": "Install Difftastic"
      },
      "args": []
    }
  ]
}