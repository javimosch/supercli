{
  "name": "video-to-ascii",
  "version": "0.1.0",
  "description": "Play videos as ASCII art in the terminal",
  "source": "https://github.com/leonmav/video-to-ascii",
  "checks": [{ "type": "binary", "name": "video-to-ascii" }],
  "install_guidance": {
    "plugin": "video-to-ascii",
    "binary": "video-to-ascii",
    "check": "which video-to-ascii",
    "install_steps": ["npm install -g video-to-ascii", "Verify: video-to-ascii --version", "supercli plugins install ./plugins/video-to-ascii --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "video-to-ascii",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to video-to-ascii CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "video-to-ascii",
      "passthrough": true,
      "missingDependencyHelp": "Install video-to-ascii: npm install -g video-to-ascii", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
