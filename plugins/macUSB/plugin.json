{
  "name": "macUSB",
  "version": "0.1.0",
  "description": "Download. Flash. Boot. The all-in-one USB creator for Mac",
  "source": "https://github.com/macUSB/macUSB",
  "checks": [
    {
      "type": "binary",
      "name": "macusb"
    }
  ],
  "install_guidance": {
    "plugin": "macUSB",
    "binary": "macusb",
    "check": "which macusb",
    "install_steps": [
      "pip install macusb",
      "Verify: macusb --version",
      "supercli plugins install ./plugins/macUSB --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "macUSB",
      "resource": "self",
      "action": "version",
      "description": "Print macUSB version",
      "adapter": "process",
      "adapterConfig": {
        "command": "macusb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install macUSB: pip install macusb"
      },
      "args": []
    },
    {
      "namespace": "macUSB",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to macusb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "macusb",
        "passthrough": true,
        "missingDependencyHelp": "Install macUSB: pip install macusb"
      },
      "args": []
    }
  ]
}