{
  "name": "zgrep",
  "version": "0.1.0",
  "description": "Fast text search through gzip-compressed files",
  "source": "https://github.com/zgrep/zgrep",
  "checks": [{ "type": "binary", "name": "zgrep" }],
  "install_guidance": {
    "plugin": "zgrep",
    "binary": "zgrep",
    "check": "which zgrep",
    "install_steps": ["system package", "Verify: zgrep --version", "supercli plugins install ./plugins/zgrep --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zgrep",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zgrep CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zgrep",
      "passthrough": true,
      "missingDependencyHelp": "Install zgrep: system package", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
