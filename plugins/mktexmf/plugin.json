{
  "name": "mktexmf",
  "version": "0.1.0",
  "description": "CLI tool: mktexmf",
  "source": "https://manpages.debian.org/mktexmf",
  "checks": [
    {
      "type": "binary",
      "name": "mktexmf"
    }
  ],
  "install_guidance": {
    "plugin": "mktexmf",
    "binary": "mktexmf",
    "check": "which mktexmf",
    "install_steps": [
      "apt-get install mktexmf 2>/dev/null || which mktexmf",
      "Verify: mktexmf --version",
      "supercli plugins install ./plugins/mktexmf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mktexmf",
      "resource": "self",
      "action": "version",
      "description": "Print mktexmf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mktexmf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mktexmf: apt-get install mktexmf 2>/dev/null || which mktexmf"
      },
      "args": []
    },
    {
      "namespace": "mktexmf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mktexmf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mktexmf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mktexmf: apt-get install mktexmf 2>/dev/null || which mktexmf"
      },
      "args": []
    }
  ]
}