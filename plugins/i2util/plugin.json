{
  "name": "i2util",
  "version": "0.1.0",
  "description": "Internet2 utility tools",
  "source": "https://github.com/perfsonar/i2util",
  "checks": [
    {
      "type": "binary",
      "name": "i2util"
    }
  ],
  "install_guidance": {
    "plugin": "i2util",
    "binary": "i2util",
    "check": "which i2util",
    "install_steps": [
      "brew install i2util",
      "Verify: i2util --version",
      "supercli plugins install ./plugins/i2util --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "i2util",
      "resource": "self",
      "action": "version",
      "description": "Print i2util version",
      "adapter": "process",
      "adapterConfig": {
        "command": "i2util",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install i2util: brew install i2util"
      },
      "args": []
    },
    {
      "namespace": "i2util",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to i2util CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "i2util",
        "passthrough": true,
        "missingDependencyHelp": "Install i2util"
      },
      "args": []
    }
  ]
}