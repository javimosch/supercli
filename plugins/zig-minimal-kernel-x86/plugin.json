{
  "name": "zig-minimal-kernel-x86",
  "version": "0.1.0",
  "description": "Minimal x86 Kernel - built in Zig",
  "source": "https://github.com/zig-minimal-kernel-x86/zig-minimal-kernel-x86",
  "checks": [
    {
      "type": "binary",
      "name": "zig-minimal-kernel-x86"
    }
  ],
  "install_guidance": {
    "plugin": "zig-minimal-kernel-x86",
    "binary": "zig-minimal-kernel-x86",
    "check": "which zig-minimal-kernel-x86",
    "install_steps": [
      "pip install zig-minimal-kernel-x86",
      "Verify: zig-minimal-kernel-x86 --version",
      "supercli plugins install ./plugins/zig-minimal-kernel-x86 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig-minimal-kernel-x86",
      "resource": "self",
      "action": "version",
      "description": "Print zig-minimal-kernel-x86 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-minimal-kernel-x86",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig-minimal-kernel-x86: pip install zig-minimal-kernel-x86"
      },
      "args": []
    },
    {
      "namespace": "zig-minimal-kernel-x86",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig-minimal-kernel-x86 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-minimal-kernel-x86",
        "passthrough": true,
        "missingDependencyHelp": "Install zig-minimal-kernel-x86: pip install zig-minimal-kernel-x86"
      },
      "args": []
    }
  ]
}