{
  "plugin": "httprobe",
  "binary": "httprobe",
  "check": "which httprobe || echo 'httprobe not installed'",
  "install_steps": [
    "go install github.com/tomnomnom/httprobe@latest",
    "Verify: httprobe -h",
    "supercli plugins install ./plugins/httprobe --on-conflict replace --json"
  ],
  "note": "Requires Go. Pipe line-delimited domains via stdin: cat domains.txt | httprobe"
}
