{
  "name": "diffutils",
  "version": "0.1.0",
  "description": "File comparison utilities",
  "checks": [
    {
      "type": "binary",
      "name": "diffutils"
    }
  ],
  "install_guidance": {
    "plugin": "diffutils",
    "binary": "diffutils",
    "check": "which diffutils",
    "install_steps": [
      "brew install diffutils",
      "Verify: diffutils --version",
      "supercli plugins install ./plugins/diffutils --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "diffutils",
      "resource": "self",
      "action": "version",
      "description": "Print diffutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install diffutils: brew install diffutils"
      },
      "args": []
    },
    {
      "namespace": "diffutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to diffutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffutils",
        "passthrough": true,
        "missingDependencyHelp": "Install diffutils"
      },
      "args": []
    }
  ]
}