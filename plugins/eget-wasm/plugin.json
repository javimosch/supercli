{
  "name": "eget-wasm",
  "version": "0.1.0",
  "description": "WASI-compiled binary downloader for sandboxed environments",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "eget-wasm" }],
  "install_guidance": {
    "plugin": "eget-wasm",
    "binary": "eget-wasm",
    "check": "which eget-wasm",
    "install_steps": ["npm install -g eget-wasm", "Verify: eget-wasm --version", "supercli plugins install ./plugins/eget-wasm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "eget-wasm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to eget-wasm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "eget-wasm",
      "passthrough": true,
      "missingDependencyHelp": "Install eget-wasm: npm install -g eget-wasm"
    },
    "args": []
  }]
}
