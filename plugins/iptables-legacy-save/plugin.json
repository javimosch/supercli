{
  "name": "iptables-legacy-save",
  "version": "0.1.0",
  "description": "CLI tool: iptables-legacy-save",
  "source": "https://manpages.debian.org/iptables-legacy-save",
  "checks": [
    {
      "type": "binary",
      "name": "iptables-legacy-save"
    }
  ],
  "install_guidance": {
    "plugin": "iptables-legacy-save",
    "binary": "iptables-legacy-save",
    "check": "which iptables-legacy-save",
    "install_steps": [
      "apt-get install iptables-legacy-save 2>/dev/null || which iptables-legacy-save",
      "Verify: iptables-legacy-save --version",
      "supercli plugins install ./plugins/iptables-legacy-save --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iptables-legacy-save",
      "resource": "self",
      "action": "version",
      "description": "Print iptables-legacy-save version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iptables-legacy-save",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iptables-legacy-save: apt-get install iptables-legacy-save 2>/dev/null || which iptables-legacy-save"
      },
      "args": []
    },
    {
      "namespace": "iptables-legacy-save",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iptables-legacy-save CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iptables-legacy-save",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install iptables-legacy-save: apt-get install iptables-legacy-save 2>/dev/null || which iptables-legacy-save"
      },
      "args": []
    }
  ]
}