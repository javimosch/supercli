{
  "name": "lldb",
  "version": "0.1.0",
  "description": "lldb — LLVM debugger",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "lldb"
    }
  ],
  "install_guidance": {
    "plugin": "lldb",
    "binary": "lldb",
    "check": "which lldb",
    "install_steps": [
      "brew install llvm",
      "supercli plugins install ./plugins/lldb --on-conflict replace --json"
    ],
    "note": "Development tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lldb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lldb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lldb",
        "passthrough": true,
        "missingDependencyHelp": "Install lldb: brew install llvm"
      },
      "args": []
    }
  ]
}
