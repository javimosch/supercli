{
  "name": "NexAlloy",
  "version": "0.1.0",
  "description": "ChsBuffer's LSPosed module, powered by Morphe, ReVanced, and beyond. (formerly ReVanced Xposed)",
  "source": "https://github.com/NexAlloy/NexAlloy",
  "checks": [
    {
      "type": "binary",
      "name": "nexalloy"
    }
  ],
  "install_guidance": {
    "plugin": "NexAlloy",
    "binary": "nexalloy",
    "check": "which nexalloy",
    "install_steps": [
      "pip install nexalloy",
      "Verify: nexalloy --version",
      "supercli plugins install ./plugins/NexAlloy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NexAlloy",
      "resource": "self",
      "action": "version",
      "description": "Print NexAlloy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nexalloy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NexAlloy: pip install nexalloy"
      },
      "args": []
    },
    {
      "namespace": "NexAlloy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nexalloy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nexalloy",
        "passthrough": true,
        "missingDependencyHelp": "Install NexAlloy: pip install nexalloy"
      },
      "args": []
    }
  ]
}