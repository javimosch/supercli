{
  "name": "double-entry",
  "version": "1.0.0",
  "description": "double-entry \u2014 Accounting CLI",
  "source": "github.com/double-entry/double-entry",
  "checks": [
    {
      "type": "binary",
      "name": "double-entry"
    }
  ],
  "install_guidance": {
    "plugin": "double-entry",
    "binary": "double-entry",
    "check": "which double-entry",
    "install_steps": [
      "# Install double-entry",
      "# See github.com/double-entry/double-entry",
      "# apt: sudo apt-get install double-entry",
      "# brew: brew install double-entry",
      "# cargo: cargo install double-entry",
      "# npm: npm install -g double-entry",
      "# pip: pip install double-entry"
    ]
  },
  "commands": [
    {
      "namespace": "double",
      "resource": "entry",
      "action": "run",
      "description": "Run double-entry",
      "adapter": "process",
      "adapterConfig": {
        "command": "double-entry",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install double-entry from github.com/double-entry/double-entry"
      },
      "args": []
    }
  ]
}