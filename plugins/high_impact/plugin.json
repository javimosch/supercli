{
  "name": "high_impact",
  "version": "0.1.0",
  "description": "A 2d game engine written in C",
  "source": "https://github.com/high_impact/high_impact",
  "checks": [
    {
      "type": "binary",
      "name": "high-impact"
    }
  ],
  "install_guidance": {
    "plugin": "high_impact",
    "binary": "high-impact",
    "check": "which high-impact",
    "install_steps": [
      "pip install high-impact",
      "Verify: high-impact --version",
      "supercli plugins install ./plugins/high_impact --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "high_impact",
      "resource": "self",
      "action": "version",
      "description": "Print high_impact version",
      "adapter": "process",
      "adapterConfig": {
        "command": "high-impact",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install high_impact: pip install high-impact"
      },
      "args": []
    },
    {
      "namespace": "high_impact",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to high-impact CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "high-impact",
        "passthrough": true,
        "missingDependencyHelp": "Install high_impact: pip install high-impact"
      },
      "args": []
    }
  ]
}