{
  "name": "pick",
  "version": "0.1.0",
  "description": "pick \u2014 a fuzzy picker for the terminal.",
  "source": "https://github.com/calleerlandsson/pick",
  "checks": [
    {
      "type": "binary",
      "name": "pick"
    }
  ],
  "install_guidance": {
    "plugin": "pick",
    "binary": "pick",
    "check": "which pick",
    "install_steps": [
      "brew install pick",
      "cargo install pick",
      "supercli plugins install ./plugins/pick --on-conflict replace --json"
    ],
    "note": "Rust. Fuzzy picker for terminal."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pick",
      "resource": "filter",
      "action": "run",
      "description": "Fuzzy filter stdin lines",
      "adapter": "process",
      "adapterConfig": {
        "command": "pick",
        "missingDependencyHelp": "Install pick",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "pick",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pick",
        "missingDependencyHelp": "Install pick",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
