{
  "name": "gray-matter",
  "version": "0.1.0",
  "description": "Parse front matter from strings and files",
  "source": "https://github.com/jonschlinkert/gray-matter",
  "checks": [{ "type": "binary", "name": "gray-matter" }],
  "install_guidance": {
    "plugin": "gray-matter",
    "binary": "gray-matter",
    "check": "which gray-matter",
    "install_steps": ["npm install -g gray-matter", "Verify: gray-matter --version", "supercli plugins install ./plugins/gray-matter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gray-matter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gray-matter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gray-matter",
      "passthrough": true,
      "missingDependencyHelp": "Install gray-matter: npm install -g gray-matter", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
