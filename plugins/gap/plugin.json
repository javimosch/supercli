{
  "name": "gap",
  "version": "0.1.0",
  "description": "Groups, Algorithms, Programming system",
  "source": "https://github.com/gap-system/gap",
  "checks": [
    {
      "type": "binary",
      "name": "gap"
    }
  ],
  "install_guidance": {
    "plugin": "gap",
    "binary": "gap",
    "check": "which gap",
    "install_steps": [
      "brew install gap",
      "Verify: gap --version",
      "supercli plugins install ./plugins/gap --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "gap",
      "resource": "self",
      "action": "version",
      "description": "Print gap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gap: brew install gap"
      },
      "args": []
    },
    {
      "namespace": "gap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gap: brew install gap"
      },
      "args": []
    }
  ]
}
