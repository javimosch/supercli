{
  "name": "scacit",
  "version": "0.1.0",
  "description": "Minimal Markdown-based static site generator with custom templating",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "scacit" }],
  "install_guidance": {
    "plugin": "scacit",
    "binary": "scacit",
    "check": "which scacit",
    "install_steps": ["git clone && make", "Verify: scacit --version", "supercli plugins install ./plugins/scacit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "scacit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to scacit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "scacit",
      "passthrough": true,
      "missingDependencyHelp": "Install scacit: git clone && make"
    },
    "args": []
  }]
}
