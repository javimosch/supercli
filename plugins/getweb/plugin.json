{
  "name": "getweb",
  "version": "0.1.0",
  "description": "CLI tool: getweb",
  "source": "https://manpages.debian.org/getweb",
  "checks": [
    {
      "type": "binary",
      "name": "getweb"
    }
  ],
  "install_guidance": {
    "plugin": "getweb",
    "binary": "getweb",
    "check": "which getweb",
    "install_steps": [
      "apt-get install getweb 2>/dev/null || which getweb",
      "Verify: getweb --version",
      "supercli plugins install ./plugins/getweb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "getweb",
      "resource": "self",
      "action": "version",
      "description": "Print getweb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "getweb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install getweb: apt-get install getweb 2>/dev/null || which getweb"
      },
      "args": []
    },
    {
      "namespace": "getweb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to getweb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "getweb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install getweb: apt-get install getweb 2>/dev/null || which getweb"
      },
      "args": []
    }
  ]
}