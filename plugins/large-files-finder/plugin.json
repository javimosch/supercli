{
  "name": "large-files-finder",
  "version": "0.1.0",
  "description": "CLI tool: large-files-finder",
  "source": "https://manpages.debian.org/large-files-finder",
  "checks": [
    {
      "type": "binary",
      "name": "large-files-finder"
    }
  ],
  "install_guidance": {
    "plugin": "large-files-finder",
    "binary": "large-files-finder",
    "check": "which large-files-finder",
    "install_steps": [
      "apt-get install large-files-finder 2>/dev/null || which large-files-finder",
      "Verify: large-files-finder --version",
      "supercli plugins install ./plugins/large-files-finder --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "large-files-finder",
      "resource": "self",
      "action": "version",
      "description": "Print large-files-finder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "large-files-finder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install large-files-finder: apt-get install large-files-finder 2>/dev/null || which large-files-finder"
      },
      "args": []
    },
    {
      "namespace": "large-files-finder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to large-files-finder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "large-files-finder",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install large-files-finder: apt-get install large-files-finder 2>/dev/null || which large-files-finder"
      },
      "args": []
    }
  ]
}