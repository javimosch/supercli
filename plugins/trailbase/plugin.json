{
  "name": "trailbase",
  "version": "0.1.0",
  "description": "An open, sub-millisecond, single-executable Firebase alternative with type-safe APIs, built-in WebAs",
  "source": "https://github.com/trailbase/trailbase",
  "checks": [
    {
      "type": "binary",
      "name": "trailbase"
    }
  ],
  "install_guidance": {
    "plugin": "trailbase",
    "binary": "trailbase",
    "check": "which trailbase",
    "install_steps": [
      "pip install trailbase",
      "Verify: trailbase --version",
      "supercli plugins install ./plugins/trailbase --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "trailbase",
      "resource": "self",
      "action": "version",
      "description": "Print trailbase version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trailbase",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install trailbase: pip install trailbase"
      },
      "args": []
    },
    {
      "namespace": "trailbase",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trailbase CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trailbase",
        "passthrough": true,
        "missingDependencyHelp": "Install trailbase: pip install trailbase"
      },
      "args": []
    }
  ]
}