{
  "name": "kanister",
  "version": "0.1.0",
  "description": "Framework for application-level data management on Kubernetes",
  "source": "https://github.com/kanisterio/kanister",
  "checks": [{ "type": "binary", "name": "kanctl" }],
  "install_guidance": {
    "plugin": "kanister",
    "binary": "kanctl",
    "check": "which kanctl",
    "install_steps": ["brew install kanister", "Verify: kanctl --version", "supercli plugins install ./plugins/kanister --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kanister",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kanctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kanctl",
      "passthrough": true,
      "missingDependencyHelp": "Install kanister: brew install kanister"
    },
    "args": []
  }]
}
