{
  "name": "at-ansify",
  "version": "0.1.0",
  "description": "CLI tool: at-ansify",
  "source": "https://packages.debian.org/at-ansify",
  "checks": [{ "type": "binary", "name": "at-ansify" }],
  "install_guidance": {
    "plugin": "at-ansify", "binary": "at-ansify", "check": "which at-ansify",
    "install_steps": ["apt-get install at-ansify 2>/dev/null || which at-ansify", "Verify: at-ansify --version", "supercli plugins install ./plugins/at-ansify --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-ansify", "resource": "_", "action": "_",
    "description": "Passthrough to at-ansify CLI",
    "adapter": "process", "adapterConfig": { "command": "at-ansify", "passthrough": true, "missingDependencyHelp": "Install at-ansify: apt-get install at-ansify" }, "args": []
  }]
}
