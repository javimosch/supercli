{
  "name": "map-tiles-downloader",
  "version": "0.1.0",
  "description": "Download map tiles for offline usage based on bounding box",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "map-tiles-downloader" }],
  "install_guidance": {
    "plugin": "map-tiles-downloader",
    "binary": "map-tiles-downloader",
    "check": "which map-tiles-downloader",
    "install_steps": ["pip install map-tiles-downloader", "Verify: map-tiles-downloader --version", "supercli plugins install ./plugins/map-tiles-downloader --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "map-tiles-downloader",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to map-tiles-downloader CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "map-tiles-downloader",
      "passthrough": true,
      "missingDependencyHelp": "Install map-tiles-downloader: pip install map-tiles-downloader"
    },
    "args": []
  }]
}
