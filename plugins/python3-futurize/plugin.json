{
  "name": "python3-futurize",
  "version": "0.1.0",
  "description": "Tool to convert Python 2 code to Python 2/3 compatible code",
  "source": "https://manpages.debian.org/python3-futurize",
  "checks": [{ "type": "binary", "name": "python3-futurize" }],
  "install_guidance": {
    "plugin": "python3-futurize",
    "binary": "python3-futurize",
    "check": "which python3-futurize",
    "install_steps": [
      "pip install future",
      "Verify: python3-futurize --version",
      "supercli plugins install ./plugins/python3-futurize --on-conflict replace --json"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [{
    "namespace": "python3-futurize",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to python3-futurize CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "python3-futurize",
      "passthrough": true,
      "missingDependencyHelp": "Install python3-futurize: pip install future"
    },
    "args": []
  }]
}
