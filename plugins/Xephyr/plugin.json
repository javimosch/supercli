{
  "name": "Xephyr",
  "version": "0.1.0",
  "description": "CLI tool: Xephyr",
  "source": "https://manpages.debian.org/Xephyr",
  "checks": [
    {
      "type": "binary",
      "name": "Xephyr"
    }
  ],
  "install_guidance": {
    "plugin": "Xephyr",
    "binary": "Xephyr",
    "check": "which Xephyr",
    "install_steps": [
      "apt-get install Xephyr 2>/dev/null || which Xephyr",
      "Verify: Xephyr --version",
      "supercli plugins install ./plugins/Xephyr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Xephyr",
      "resource": "self",
      "action": "version",
      "description": "Print Xephyr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xephyr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Xephyr: apt-get install Xephyr 2>/dev/null || which Xephyr"
      },
      "args": []
    },
    {
      "namespace": "Xephyr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Xephyr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xephyr",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install Xephyr: apt-get install Xephyr 2>/dev/null || which Xephyr"
      },
      "args": []
    }
  ]
}