{
  "name": "pathchk",
  "version": "0.1.0",
  "description": "pathchk — Check filename portability",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "pathchk"
    }
  ],
  "install_guidance": {
    "plugin": "pathchk",
    "binary": "pathchk",
    "check": "which pathchk",
    "install_steps": [
      "brew install coreutils",
      "supercli plugins install ./plugins/pathchk --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pathchk",
      "resource": "self",
      "action": "version",
      "description": "Print pathchk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pathchk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pathchk: brew install coreutils"
      },
      "args": []
    },
    {
      "namespace": "pathchk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pathchk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pathchk",
        "passthrough": true,
        "missingDependencyHelp": "Install pathchk: brew install coreutils"
      },
      "args": []
    }
  ]
}
