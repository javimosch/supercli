{
  "name": "pdata_tools",
  "version": "0.1.0",
  "description": "CLI tool: pdata_tools",
  "source": "https://manpages.debian.org/pdata_tools",
  "checks": [
    {
      "type": "binary",
      "name": "pdata_tools"
    }
  ],
  "install_guidance": {
    "plugin": "pdata_tools",
    "binary": "pdata_tools",
    "check": "which pdata_tools",
    "install_steps": [
      "apt-get install pdata_tools 2>/dev/null || which pdata_tools",
      "Verify: pdata_tools --version",
      "supercli plugins install ./plugins/pdata_tools --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdata_tools",
      "resource": "self",
      "action": "version",
      "description": "Print pdata_tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdata_tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdata_tools: apt-get install pdata_tools 2>/dev/null || which pdata_tools"
      },
      "args": []
    },
    {
      "namespace": "pdata_tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdata_tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdata_tools",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdata_tools: apt-get install pdata_tools 2>/dev/null || which pdata_tools"
      },
      "args": []
    }
  ]
}