{
  "name": "godoc",
  "version": "0.1.0",
  "description": "godoc — Go documentation server",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "godoc"
    }
  ],
  "install_guidance": {
    "plugin": "godoc",
    "binary": "godoc",
    "check": "which godoc",
    "install_steps": [
