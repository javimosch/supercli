      "description": "Passthrough to godoc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "godoc",
        "passthrough": true,
        "missingDependencyHelp": "Install godoc: brew install go"
      },
      "args": []
    }
  ]
}
