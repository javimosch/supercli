{
  "name": "twist3",
  "version": "0.1.0",
  "description": "CLI tool: twist3",
  "source": "https://manpages.debian.org/twist3",
  "checks": [
    {
      "type": "binary",
      "name": "twist3"
    }
  ],
  "install_guidance": {
    "plugin": "twist3",
    "binary": "twist3",
    "check": "which twist3",
    "install_steps": [
      "apt-get install twist3 2>/dev/null || which twist3",
      "Verify: twist3 --version",
      "supercli plugins install ./plugins/twist3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "twist3",
      "resource": "self",
      "action": "version",
      "description": "Print twist3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "twist3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install twist3: apt-get install twist3 2>/dev/null || which twist3"
      },
      "args": []
    },
    {
      "namespace": "twist3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to twist3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "twist3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install twist3: apt-get install twist3 2>/dev/null || which twist3"
      },
      "args": []
    }
  ]
}