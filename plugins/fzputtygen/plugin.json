{
  "name": "fzputtygen",
  "version": "0.1.0",
  "description": "CLI tool: fzputtygen",
  "source": "https://manpages.debian.org/fzputtygen",
  "checks": [
    {
      "type": "binary",
      "name": "fzputtygen"
    }
  ],
  "install_guidance": {
    "plugin": "fzputtygen",
    "binary": "fzputtygen",
    "check": "which fzputtygen",
    "install_steps": [
      "apt-get install fzputtygen 2>/dev/null || which fzputtygen",
      "Verify: fzputtygen --version",
      "supercli plugins install ./plugins/fzputtygen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fzputtygen",
      "resource": "self",
      "action": "version",
      "description": "Print fzputtygen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzputtygen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fzputtygen: apt-get install fzputtygen 2>/dev/null || which fzputtygen"
      },
      "args": []
    },
    {
      "namespace": "fzputtygen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fzputtygen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzputtygen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fzputtygen: apt-get install fzputtygen 2>/dev/null || which fzputtygen"
      },
      "args": []
    }
  ]
}