{
  "name": "dfu-util",
  "version": "0.1.0",
  "description": "CLI tool: dfu-util",
  "source": "https://packages.debian.org/dfu-util",
  "checks": [{ "type": "binary", "name": "dfu-util" }],
  "install_guidance": {
    "plugin": "dfu-util", "binary": "dfu-util", "check": "which dfu-util",
    "install_steps": ["apt-get install dfu-util 2>/dev/null || which dfu-util", "Verify: dfu-util --version", "supercli plugins install ./plugins/dfu-util --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dfu-util", "resource": "_", "action": "_",
    "description": "Passthrough to dfu-util CLI",
    "adapter": "process", "adapterConfig": { "command": "dfu-util", "passthrough": true, "missingDependencyHelp": "Install dfu-util: apt-get install dfu-util" }, "args": []
  }]
}
