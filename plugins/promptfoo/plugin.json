{
  "name": "promptfoo",
  "version": "0.1.0",
  "description": "promptfoo is the standard open-source CLI for testing and evaluating LLM apps. It runs prompt matrices across providers with YAML configs, grades outputs with assertions and model-graded rubrics, compares evals, and includes a full red-teaming suite that generates and fires adversarial attacks at your app.",
  "source": "https://github.com/promptfoo/promptfoo",
  "checks": [
    { "type": "binary", "name": "promptfoo" }
  ],
  "install_guidance": {
    "plugin": "promptfoo",
    "binary": "promptfoo",
    "check": "which promptfoo",
    "install_steps": [
      "npm install -g promptfoo  # or: npx promptfoo@latest",
      "Verify: promptfoo --version",
      "supercli plugins install ./plugins/promptfoo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "promptfoo",
      "resource": "self",
      "action": "version",
      "description": "Print promptfoo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    },
    {
      "namespace": "promptfoo",
      "resource": "project",
      "action": "init",
      "description": "Scaffold a promptfooconfig.yaml eval project (promptfoo init)",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "baseArgs": ["init"],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    },
    {
      "namespace": "promptfoo",
      "resource": "eval",
      "action": "run",
      "description": "Run evaluations from promptfooconfig.yaml (promptfoo eval --output results.json --no-cache)",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "baseArgs": ["eval"],
        "passthrough": true,
        "timeout_ms": 600000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    },
    {
      "namespace": "promptfoo",
      "resource": "eval",
      "action": "list",
      "description": "List previous evaluation runs (promptfoo list evals)",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "baseArgs": ["list", "evals"],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    },
    {
      "namespace": "promptfoo",
      "resource": "redteam",
      "action": "init",
      "description": "Scaffold a redteam configuration (promptfoo redteam init)",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "baseArgs": ["redteam", "init"],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    },
    {
      "namespace": "promptfoo",
      "resource": "redteam",
      "action": "run",
      "description": "Run a redteam scan against a target (promptfoo redteam run --target <app>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "baseArgs": ["redteam", "run"],
        "passthrough": true,
        "timeout_ms": 600000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    },
    {
      "namespace": "promptfoo",
      "resource": "cache",
      "action": "clear",
      "description": "Clear the promptfoo cache (promptfoo cache clear)",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "baseArgs": ["cache", "clear"],
        "passthrough": true,
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    },
    {
      "namespace": "promptfoo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to promptfoo CLI (promptfoo view, promptfoo show, promptfoo export, promptfoo generate, etc.)",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptfoo",
        "passthrough": true,
        "timeout_ms": 600000,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install promptfoo: npm install -g promptfoo"
      },
      "args": []
    }
  ]
}
