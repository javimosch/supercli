{
  "name": "langdetect-cli",
  "version": "0.1.0",
  "description": "Command line wrapper for Google language detection library",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "langdetect-cli" }],
  "install_guidance": {
    "plugin": "langdetect-cli",
    "binary": "langdetect-cli",
    "check": "which langdetect-cli",
    "install_steps": ["pip install langdetect", "Verify: langdetect-cli --version", "supercli plugins install ./plugins/langdetect-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "langdetect-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to langdetect-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "langdetect-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install langdetect-cli: pip install langdetect"
    },
    "args": []
  }]
}
