{
  "name": "broadwayd",
  "version": "0.1.0",
  "description": "CLI tool: broadwayd",
  "source": "https://packages.debian.org/broadwayd",
  "checks": [{ "type": "binary", "name": "broadwayd" }],
  "install_guidance": {
    "plugin": "broadwayd", "binary": "broadwayd", "check": "which broadwayd",
    "install_steps": ["apt-get install broadwayd 2>/dev/null || which broadwayd", "Verify: broadwayd --version", "supercli plugins install ./plugins/broadwayd --on-conflict replace --json"]
