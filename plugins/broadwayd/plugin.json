  "commands": [{
    "namespace": "broadwayd", "resource": "_", "action": "_",
    "description": "Passthrough to broadwayd CLI",
    "adapter": "process", "adapterConfig": { "command": "broadwayd", "passthrough": true, "missingDependencyHelp": "Install broadwayd: apt-get install broadwayd" }, "args": []
  }]
}
