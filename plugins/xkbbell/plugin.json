{
  "name": "xkbbell",
  "version": "0.1.0",
  "description": "CLI tool: xkbbell",
  "source": "https://manpages.debian.org/xkbbell",
  "checks": [
    {
      "type": "binary",
      "name": "xkbbell"
    }
  ],
  "install_guidance": {
    "plugin": "xkbbell",
    "binary": "xkbbell",
    "check": "which xkbbell",
    "install_steps": [
      "apt-get install xkbbell 2>/dev/null || which xkbbell",
      "Verify: xkbbell --version",
      "supercli plugins install ./plugins/xkbbell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xkbbell",
      "resource": "self",
      "action": "version",
      "description": "Print xkbbell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkbbell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xkbbell: apt-get install xkbbell 2>/dev/null || which xkbbell"
      },
      "args": []
    },
    {
      "namespace": "xkbbell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xkbbell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkbbell",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xkbbell: apt-get install xkbbell 2>/dev/null || which xkbbell"
      },
      "args": []
    }
  ]
}