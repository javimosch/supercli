{
  "name": "scaffold-static",
  "version": "0.1.0",
  "description": "Scaffolding utility for vanilla JS",
  "source": "https://github.com/jamesgeorge007/scaffold-static",
  "checks": [
    {
      "type": "binary",
      "name": "scaffold-static"
    }
  ],
  "install_guidance": {
    "plugin": "scaffold-static",
    "binary": "scaffold-static",
    "check": "which scaffold-static",
    "install_steps": [
      "npm install -g scaffold-static",
      "Verify: scaffold-static --version",
      "supercli plugins install ./plugins/scaffold-static --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "scaffold-static",
      "resource": "self",
      "action": "version",
      "description": "Print scaffold-static version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scaffold-static",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scaffold-static: npm install -g scaffold-static"
      },
      "args": []
    },
    {
      "namespace": "scaffold-static",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scaffold-static CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scaffold-static",
        "passthrough": true,
        "missingDependencyHelp": "Install scaffold-static"
      },
      "args": []
    }
  ]
}