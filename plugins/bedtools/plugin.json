{
  "name": "bedtools",
  "version": "0.1.0",
  "description": "Tools for genome arithmetic (set theory on the genome)",
  "source": "https://github.com/arq5x/bedtools2",
  "checks": [
    {
      "type": "binary",
      "name": "bedtools"
    }
  ],
  "install_guidance": {
    "plugin": "bedtools",
    "binary": "bedtools",
    "check": "which bedtools",
    "install_steps": [
      "brew install bedtools",
      "Verify: bedtools --version",
      "supercli plugins install ./plugins/bedtools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bedtools",
      "resource": "self",
      "action": "version",
      "description": "Print bedtools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bedtools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bedtools: brew install bedtools"
      },
      "args": []
    },
    {
      "namespace": "bedtools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bedtools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bedtools",
        "passthrough": true,
        "missingDependencyHelp": "Install bedtools"
      },
      "args": []
    }
  ]
}