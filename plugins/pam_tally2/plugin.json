{
  "name": "pam_tally2",
  "version": "0.1.0",
  "description": "CLI tool: pam_tally2",
  "source": "https://manpages.debian.org/pam_tally2",
  "checks": [
    {
      "type": "binary",
      "name": "pam_tally2"
    }
  ],
  "install_guidance": {
    "plugin": "pam_tally2",
    "binary": "pam_tally2",
    "check": "which pam_tally2",
    "install_steps": [
      "apt-get install pam_tally2 2>/dev/null || which pam_tally2",
      "Verify: pam_tally2 --version",
      "supercli plugins install ./plugins/pam_tally2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pam_tally2",
      "resource": "self",
      "action": "version",
      "description": "Print pam_tally2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pam_tally2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pam_tally2: apt-get install pam_tally2 2>/dev/null || which pam_tally2"
      },
      "args": []
    },
    {
      "namespace": "pam_tally2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pam_tally2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pam_tally2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pam_tally2: apt-get install pam_tally2 2>/dev/null || which pam_tally2"
      },
      "args": []
    }
  ]
}