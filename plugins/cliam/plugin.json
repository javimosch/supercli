{
  "name": "cliam",
  "version": "0.1.0",
  "description": "Cloud agnostic IAM permissions enumerator",
  "source": "https://github.com/securisec/cliam",
  "checks": [
    {
      "type": "binary",
      "name": "cliam"
    }
  ],
  "install_guidance": {
    "plugin": "cliam",
    "binary": "cliam",
    "check": "which cliam",
    "install_steps": [
      "brew install cliam",
      "Verify: cliam --version",
      "supercli plugins install ./plugins/cliam --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cliam",
      "resource": "self",
      "action": "version",
      "description": "Print cliam version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cliam",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cliam: brew install cliam"
      },
      "args": []
    },
    {
      "namespace": "cliam",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cliam CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cliam",
        "passthrough": true,
        "missingDependencyHelp": "Install cliam"
      },
      "args": []
    }
  ]
}