{
  "name": "bison.yacc",
  "version": "0.1.0",
  "description": "CLI tool: bison.yacc",
  "source": "https://manpages.debian.org/bison.yacc",
  "checks": [
    {
      "type": "binary",
      "name": "bison.yacc"
    }
  ],
  "install_guidance": {
    "plugin": "bison.yacc",
    "binary": "bison.yacc",
    "check": "which bison.yacc",
    "install_steps": [
      "apt-get install bison.yacc 2>/dev/null || which bison.yacc",
      "Verify: bison.yacc --version",
      "supercli plugins install ./plugins/bison.yacc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bison.yacc",
      "resource": "self",
      "action": "version",
      "description": "Print bison.yacc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bison.yacc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bison.yacc: apt-get install bison.yacc 2>/dev/null || which bison.yacc"
      },
      "args": []
    },
    {
      "namespace": "bison.yacc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bison.yacc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bison.yacc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install bison.yacc: apt-get install bison.yacc 2>/dev/null || which bison.yacc"
      },
      "args": []
    }
  ]
}