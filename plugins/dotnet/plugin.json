{
  "name": "dotnet",
  "version": "0.1.0",
  "description": ".NET — cross-platform framework CLI for building applications",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "dotnet"
    }
  ],
  "install_guidance": {
    "plugin": "dotnet",
    "binary": "dotnet",
    "check": "which dotnet",
    "install_steps": [
      "brew install dotnet"
    ],
    "note": "Development tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dotnet",
      "resource": "_",
      "action": "_",
