{
  "name": "irqbalance-ui",
  "version": "0.1.0",
  "description": "CLI tool: irqbalance-ui",
  "source": "https://manpages.debian.org/irqbalance-ui",
  "checks": [
    {
      "type": "binary",
      "name": "irqbalance-ui"
    }
  ],
  "install_guidance": {
    "plugin": "irqbalance-ui",
    "binary": "irqbalance-ui",
    "check": "which irqbalance-ui",
    "install_steps": [
      "apt-get install irqbalance-ui 2>/dev/null || which irqbalance-ui",
      "Verify: irqbalance-ui --version",
      "supercli plugins install ./plugins/irqbalance-ui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "irqbalance-ui",
      "resource": "self",
      "action": "version",
      "description": "Print irqbalance-ui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "irqbalance-ui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install irqbalance-ui: apt-get install irqbalance-ui 2>/dev/null || which irqbalance-ui"
      },
      "args": []
    },
    {
      "namespace": "irqbalance-ui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to irqbalance-ui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "irqbalance-ui",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install irqbalance-ui: apt-get install irqbalance-ui 2>/dev/null || which irqbalance-ui"
      },
      "args": []
    }
  ]
}