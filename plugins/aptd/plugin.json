{
  "name": "aptd",
  "version": "0.1.0",
  "description": "CLI tool: aptd",
  "source": "https://packages.debian.org/aptd",
  "checks": [{ "type": "binary", "name": "aptd" }],
  "install_guidance": {
    "plugin": "aptd", "binary": "aptd", "check": "which aptd",
    "install_steps": ["apt-get install aptd 2>/dev/null || which aptd", "Verify: aptd --version", "supercli plugins install ./plugins/aptd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aptd", "resource": "_", "action": "_",
    "description": "Passthrough to aptd CLI",
    "adapter": "process", "adapterConfig": { "command": "aptd", "passthrough": true, "missingDependencyHelp": "Install aptd: apt-get install aptd" }, "args": []
  }]
}
