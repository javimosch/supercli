{
  "name": "crnch",
  "version": "0.1.0",
  "description": "Lightning-fast tool to compress PNGs JPGs and PDFs to exact target sizes",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "crnch" }],
  "install_guidance": {
    "plugin": "crnch",
    "binary": "crnch",
    "check": "which crnch",
    "install_steps": ["cargo build --release", "Verify: crnch --version", "supercli plugins install ./plugins/crnch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "crnch",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to crnch CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "crnch",
      "passthrough": true,
      "missingDependencyHelp": "Install crnch: cargo build --release"
    },
    "args": []
  }]
}
