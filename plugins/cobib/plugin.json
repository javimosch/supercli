{
  "name": "cobib",
  "version": "0.1.0",
  "description": "Simple, command-line based bibliography management tool.",
  "checks": [
    {
      "type": "binary",
      "name": "cobib"
    }
  ],
  "install_guidance": {
    "plugin": "cobib",
    "binary": "cobib",
    "check": "which cobib",
    "install_steps": [
      "See undefined",
      "Verify: cobib --version",
      "supercli plugins install ./plugins/cobib --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "cobib",
      "resource": "self",
      "action": "version",
      "description": "Print cobib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cobib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cobib: See undefined"
      },
      "args": []
    },
    {
      "namespace": "cobib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cobib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cobib",
        "passthrough": true,
        "missingDependencyHelp": "Install cobib"
      },
      "args": []
    }
  ]
}