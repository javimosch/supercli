{
  "name": "coturn",
  "version": "0.1.0",
  "description": "Free open source implementation of TURN and STUN Server",
  "source": "https://github.com/coturn/coturn",
  "checks": [
    {
      "type": "binary",
      "name": "coturn"
    }
  ],
  "install_guidance": {
    "plugin": "coturn",
    "binary": "coturn",
    "check": "which coturn",
    "install_steps": [
      "brew install coturn",
      "Verify: coturn --version",
      "supercli plugins install ./plugins/coturn --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "coturn",
      "resource": "self",
      "action": "version",
      "description": "Print coturn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "coturn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install coturn: brew install coturn"
      },
      "args": []
    },
    {
      "namespace": "coturn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to coturn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "coturn",
        "passthrough": true,
        "missingDependencyHelp": "Install coturn"
      },
      "args": []
    }
  ]
}