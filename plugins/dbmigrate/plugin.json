{
  "name": "dbmigrate",
  "version": "0.1.0",
  "description": "Rust-based CLI for simple Up/Down SQL migration files",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "dbmigrate" }],
  "install_guidance": {
    "plugin": "dbmigrate",
    "binary": "dbmigrate",
    "check": "which dbmigrate",
    "install_steps": ["cargo install dbmigrate", "Verify: dbmigrate --version", "supercli plugins install ./plugins/dbmigrate --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dbmigrate",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dbmigrate CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dbmigrate",
      "passthrough": true,
      "missingDependencyHelp": "Install dbmigrate: cargo install dbmigrate"
    },
    "args": []
  }]
}
