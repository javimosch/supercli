{
  "name": "bully",
  "version": "0.1.0",
  "description": "WPS brute-force tool for wireless audit",
  "source": "https://github.com/aanarchyy/bully",
  "checks": [
    {
      "type": "binary",
      "name": "bully"
    }
  ],
  "install_guidance": {
    "plugin": "bully",
    "binary": "bully",
    "check": "which bully",
    "install_steps": [
      "brew install bully",
      "Verify: bully --version",
      "supercli plugins install ./plugins/bully --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "bully",
      "resource": "self",
      "action": "version",
      "description": "Print bully version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bully",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bully: brew install bully"
      },
      "args": []
    },
    {
      "namespace": "bully",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bully CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bully",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install bully: brew install bully"
      },
      "args": []
    }
  ]
}
