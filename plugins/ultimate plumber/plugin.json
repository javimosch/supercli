{
  "name": "ultimate plumber",
  "version": "0.1.0",
  "description": "Tool for writing command-line pipes with instant live preview",
  "source": "https://github.com/akavel/up",
  "checks": [
    {
      "type": "binary",
      "name": "ultimate plumber"
    }
  ],
  "install_guidance": {
    "plugin": "ultimate plumber",
    "binary": "ultimate plumber",
    "check": "which ultimate plumber",
    "install_steps": [
      "brew install ultimate plumber",
      "Verify: ultimate plumber --version",
      "supercli plugins install ./plugins/ultimate plumber --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ultimate plumber",
      "resource": "self",
      "action": "version",
      "description": "Print ultimate plumber version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ultimate plumber",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ultimate plumber: brew install ultimate plumber"
      },
      "args": []
    },
    {
      "namespace": "ultimate plumber",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ultimate plumber CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ultimate plumber",
        "passthrough": true,
        "missingDependencyHelp": "Install ultimate plumber"
      },
      "args": []
    }
  ]
}