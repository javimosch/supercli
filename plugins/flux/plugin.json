{
  "name": "flux",
  "version": "1.0.0",
  "description": "flux \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=flux+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "flux"
    }
  ],
  "install_guidance": {
    "plugin": "flux",
    "binary": "flux",
    "check": "which flux",
    "install_steps": [
      "Install flux via package manager: apt install flux or brew install flux"
    ]
  },
  "commands": [
    {
      "namespace": "flux",
      "resource": "run",
      "action": "exec",
      "description": "flux \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "flux",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install flux via your package manager"
      },
      "args": []
    }
  ]
}