{
  "name": "markdownlint-cli",
  "version": "0.1.0",
  "description": "Markdown file linter with --json output",
  "source": "https://github.com/igorshubovych/markdownlint-cli",
  "checks": [
    {
      "type": "binary",
      "name": "markdownlint"
    }
  ],
  "install_guidance": {
    "plugin": "markdownlint-cli",
    "binary": "markdownlint",
    "check": "which markdownlint",
    "install_steps": [
      "npm install -g markdownlint-cli",
      "Verify: markdownlint --version",
      "supercli plugins install ./plugins/markdownlint-cli --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "markdownlint-cli",
      "resource": "self",
      "action": "version",
      "description": "Print markdownlint-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdownlint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install markdownlint-cli: npm install -g markdownlint-cli"
      },
      "args": []
    },
    {
      "namespace": "markdownlint-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to markdownlint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdownlint",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install markdownlint-cli: npm install -g markdownlint-cli"
      },
      "args": []
    }
  ]
}
