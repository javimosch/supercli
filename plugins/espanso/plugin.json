{
  "name": "espanso",
  "version": "0.1.0",
  "description": "espanso — privacy-first, cross-platform text expander written in Rust",
  "source": "https://github.com/espanso/espanso",
  "checks": [
    {
      "type": "binary",
      "name": "espanso"
    }
  ],
  "install_guidance": {
    "plugin": "espanso",
    "binary": "espanso",
    "check": "which espanso",
    "install_steps": [
      "brew install espanso",
      "Verify: espanso --version",
      "Start the service: espanso start",
      "supercli plugins install ./plugins/espanso --on-conflict replace --json"
    ],
    "note": "Also available via: cargo install espanso, or download from https://github.com/espanso/espanso/releases. Supports Windows, macOS, and Linux."
  },
  "commands": [
    {
      "namespace": "espanso",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to espanso CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "espanso",
        "passthrough": true,
        "missingDependencyHelp": "Install espanso: brew install espanso"
      },
      "args": []
    }
  ]
}
