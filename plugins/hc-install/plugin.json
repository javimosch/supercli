{
  "name": "hc-install",
  "version": "0.1.0",
  "description": "Automated installation and version management for HC products",
  "source": "https://github.com/hashicorp/hc-install",
  "checks": [{ "type": "binary", "name": "hc-install" }],
  "install_guidance": {
    "plugin": "hc-install",
    "binary": "hc-install",
    "check": "which hc-install",
    "install_steps": ["brew install hc-install", "Verify: hc-install --version", "supercli plugins install ./plugins/hc-install --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "hc-install",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hc-install CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hc-install",
      "passthrough": true,
      "missingDependencyHelp": "Install hc-install: brew install hc-install"
    },
    "args": []
  }]
}
