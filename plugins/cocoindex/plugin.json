{
  "name": "cocoindex",
  "version": "0.1.0",
  "description": "Incremental engine for long horizon agents \ud83c\udf1f Star if you like it!",
  "source": "https://github.com/cocoindex/cocoindex",
  "checks": [
    {
      "type": "binary",
      "name": "cocoindex"
    }
  ],
  "install_guidance": {
    "plugin": "cocoindex",
    "binary": "cocoindex",
    "check": "which cocoindex",
    "install_steps": [
      "pip install cocoindex",
      "Verify: cocoindex --version",
      "supercli plugins install ./plugins/cocoindex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cocoindex",
      "resource": "self",
      "action": "version",
      "description": "Print cocoindex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cocoindex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cocoindex: pip install cocoindex"
      },
      "args": []
    },
    {
      "namespace": "cocoindex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cocoindex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cocoindex",
        "passthrough": true,
        "missingDependencyHelp": "Install cocoindex: pip install cocoindex"
      },
      "args": []
    }
  ]
}