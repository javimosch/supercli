{
  "name": "dee-invoice",
  "version": "0.1.0",
  "description": "Generate PDF invoices from the command line",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-invoice" }],
  "install_guidance": {
    "plugin": "dee-invoice",
    "binary": "dee-invoice",
    "check": "which dee-invoice",
    "install_steps": ["cargo install dee-invoice", "Verify: dee-invoice --version", "supercli plugins install ./plugins/dee-invoice --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-invoice",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-invoice CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-invoice",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-invoice: cargo install dee-invoice"
    },
    "args": []
  }]
}
