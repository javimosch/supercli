{
  "name": "termpix",
  "version": "0.1.0",
  "description": "Display images in the terminal using half blocks",
  "source": "https://github.com/hopey-dc/termpix",
  "checks": [{ "type": "binary", "name": "termpix" }],
  "install_guidance": {
    "plugin": "termpix",
    "binary": "termpix",
    "check": "which termpix",
    "install_steps": ["cargo install termpix", "Verify: termpix --version", "supercli plugins install ./plugins/termpix --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "termpix",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to termpix CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "termpix",
      "passthrough": true,
      "missingDependencyHelp": "Install termpix: cargo install termpix", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
