{
  "name": "lsfg-vk",
  "version": "0.1.0",
  "description": "Lossless Scaling Frame Generation on Linux",
  "source": "https://github.com/lsfg-vk/lsfg-vk",
  "checks": [
    {
      "type": "binary",
      "name": "lsfg-vk"
    }
  ],
  "install_guidance": {
    "plugin": "lsfg-vk",
    "binary": "lsfg-vk",
    "check": "which lsfg-vk",
    "install_steps": [
      "pip install lsfg-vk",
      "Verify: lsfg-vk --version",
      "supercli plugins install ./plugins/lsfg-vk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lsfg-vk",
      "resource": "self",
      "action": "version",
      "description": "Print lsfg-vk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lsfg-vk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lsfg-vk: pip install lsfg-vk"
      },
      "args": []
    },
    {
      "namespace": "lsfg-vk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lsfg-vk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lsfg-vk",
        "passthrough": true,
        "missingDependencyHelp": "Install lsfg-vk: pip install lsfg-vk"
      },
      "args": []
    }
  ]
}