{
  "name": "universe-agent-acp-client",
  "version": "0.1.0",
  "description": "CLI tool: universe-agent-acp-client",
  "source": "https://manpages.debian.org/universe-agent-acp-client",
  "checks": [
    {
      "type": "binary",
      "name": "universe-agent-acp-client"
    }
  ],
  "install_guidance": {
    "plugin": "universe-agent-acp-client",
    "binary": "universe-agent-acp-client",
    "check": "which universe-agent-acp-client",
    "install_steps": [
      "apt-get install universe-agent-acp-client 2>/dev/null || which universe-agent-acp-client",
      "Verify: universe-agent-acp-client --version",
      "supercli plugins install ./plugins/universe-agent-acp-client --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "universe-agent-acp-client",
      "resource": "self",
      "action": "version",
      "description": "Print universe-agent-acp-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "universe-agent-acp-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install universe-agent-acp-client: apt-get install universe-agent-acp-client 2>/dev/null || which universe-agent-acp-client"
      },
      "args": []
    },
    {
      "namespace": "universe-agent-acp-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to universe-agent-acp-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "universe-agent-acp-client",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install universe-agent-acp-client: apt-get install universe-agent-acp-client 2>/dev/null || which universe-agent-acp-client"
      },
      "args": []
    }
  ]
}