{
  "name": "ClaraVerse",
  "version": "0.1.0",
  "description": "Claraverse is a opesource privacy focused ecosystem to replace ChatGPT, Claude, N8N, ImageGen with y",
  "source": "https://github.com/ClaraVerse/ClaraVerse",
  "checks": [
    {
      "type": "binary",
      "name": "claraverse"
    }
  ],
  "install_guidance": {
    "plugin": "ClaraVerse",
    "binary": "claraverse",
    "check": "which claraverse",
    "install_steps": [
      "pip install claraverse",
      "Verify: claraverse --version",
      "supercli plugins install ./plugins/ClaraVerse --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ClaraVerse",
      "resource": "self",
      "action": "version",
      "description": "Print ClaraVerse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claraverse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ClaraVerse: pip install claraverse"
      },
      "args": []
    },
    {
      "namespace": "ClaraVerse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claraverse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claraverse",
        "passthrough": true,
        "missingDependencyHelp": "Install ClaraVerse: pip install claraverse"
      },
      "args": []
    }
  ]
}