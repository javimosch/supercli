{
  "name": "tcpulse",
  "version": "0.1.0",
  "description": "High-precision TCP and UDP load generator for infrastructure validation",
  "source": "go",
  "checks": [{ "type": "binary", "name": "tcpulse" }],
  "install_guidance": {
    "plugin": "tcpulse",
    "binary": "tcpulse",
    "check": "which tcpulse",
    "install_steps": ["go install github.com/tcpulse@latest", "Verify: tcpulse --version", "supercli plugins install ./plugins/tcpulse --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tcpulse",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tcpulse CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tcpulse",
      "passthrough": true,
      "missingDependencyHelp": "Install tcpulse: go install github.com/tcpulse@latest"
    },
    "args": []
  }]
}
