{
  "name": "yaml-diff-patch",
  "version": "0.1.0",
  "description": "Patch YAML files using JSON Patch RFC 6902 format",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "yaml-diff-patch" }],
  "install_guidance": {
    "plugin": "yaml-diff-patch",
    "binary": "yaml-diff-patch",
    "check": "which yaml-diff-patch",
    "install_steps": ["npm install -g yaml-diff-patch", "Verify: yaml-diff-patch --version", "supercli plugins install ./plugins/yaml-diff-patch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yaml-diff-patch",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yaml-diff-patch CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yaml-diff-patch",
      "passthrough": true,
      "missingDependencyHelp": "Install yaml-diff-patch: npm install -g yaml-diff-patch"
    },
    "args": []
  }]
}
