{
  "name": "hbpldecode",
  "version": "0.1.0",
  "description": "CLI tool: hbpldecode",
  "source": "https://manpages.debian.org/hbpldecode",
  "checks": [
    {
      "type": "binary",
      "name": "hbpldecode"
    }
  ],
  "install_guidance": {
    "plugin": "hbpldecode",
    "binary": "hbpldecode",
    "check": "which hbpldecode",
    "install_steps": [
      "apt-get install hbpldecode 2>/dev/null || which hbpldecode",
      "Verify: hbpldecode --version",
      "supercli plugins install ./plugins/hbpldecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hbpldecode",
      "resource": "self",
      "action": "version",
      "description": "Print hbpldecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hbpldecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hbpldecode: apt-get install hbpldecode 2>/dev/null || which hbpldecode"
      },
      "args": []
    },
    {
      "namespace": "hbpldecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hbpldecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hbpldecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hbpldecode: apt-get install hbpldecode 2>/dev/null || which hbpldecode"
      },
      "args": []
    }
  ]
}