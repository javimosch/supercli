{
  "name": "base64",
  "version": "0.1.0",
  "description": "Base64 encode/decode utility",
  "source": "https://github.com/coreutils/coreutils",
  "checks": [
    {
      "type": "binary",
      "name": "base64"
    }
  ],
  "install_guidance": {
    "plugin": "base64",
    "binary": "base64",
    "check": "which base64",
    "install_steps": [
      "brew install coreutils",
      "Verify: base64 --version",
      "supercli plugins install ./plugins/base64 --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "base64",
      "resource": "self",
      "action": "version",
      "description": "Print base64 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "base64",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install base64: brew install coreutils"
      },
      "args": []
    },
    {
      "namespace": "base64",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to base64 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "base64",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install base64: brew install coreutils"
      },
      "args": []
    }
  ]
}
