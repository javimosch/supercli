{
  "name": "crcany",
  "version": "0.1.0",
  "description": "Compute any CRC, a bit at a time, a byte at a time, and a word at a time",
  "source": "https://github.com/madler/crcany",
  "checks": [
    {
      "type": "binary",
      "name": "crcany"
    }
  ],
  "install_guidance": {
    "plugin": "crcany",
    "binary": "crcany",
    "check": "which crcany",
    "install_steps": [
      "brew install crcany",
      "Verify: crcany --version",
      "supercli plugins install ./plugins/crcany --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "crcany",
      "resource": "self",
      "action": "version",
      "description": "Print crcany version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crcany",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crcany: brew install crcany"
      },
      "args": []
    },
    {
      "namespace": "crcany",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crcany CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crcany",
        "passthrough": true,
        "missingDependencyHelp": "Install crcany"
      },
      "args": []
    }
  ]
}