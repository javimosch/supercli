{
  "plugin": "claude-session-optimizer",
  "binary": "compress-claude-session",
  "check": "which compress-claude-session 2>/dev/null || echo 'not installed'",
  "install_steps": [
    "mkdir -p ~/.local/bin",
    "curl -sL https://raw.githubusercontent.com/javimosch/claude-session-optimizer/main/compress-claude-session.py -o ~/.local/bin/compress-claude-session",
    "chmod +x ~/.local/bin/compress-claude-session",
    "Verify: compress-claude-session --list",
    "Or just use: python3 <(curl -sL https://raw.githubusercontent.com/javimosch/claude-session-optimizer/main/compress-claude-session.py) --list",
    "Full docs: https://github.com/javimosch/claude-session-optimizer"
  ],
  "note": "Requires Python 3.6+. Script is self-contained (stdlib only). If ~/.local/bin is not on PATH, use: export PATH=$PATH:~/.local/bin"
}
