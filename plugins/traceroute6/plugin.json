{
  "name": "traceroute6",
  "version": "0.1.0",
  "description": "CLI tool: traceroute6",
  "source": "https://manpages.debian.org/traceroute6",
  "checks": [
    {
      "type": "binary",
      "name": "traceroute6"
    }
  ],
  "install_guidance": {
    "plugin": "traceroute6",
    "binary": "traceroute6",
    "check": "which traceroute6",
    "install_steps": [
      "apt-get install traceroute6 2>/dev/null || which traceroute6",
      "Verify: traceroute6 --version",
      "supercli plugins install ./plugins/traceroute6 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "traceroute6",
      "resource": "self",
      "action": "version",
      "description": "Print traceroute6 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceroute6",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install traceroute6: apt-get install traceroute6 2>/dev/null || which traceroute6"
      },
      "args": []
    },
    {
      "namespace": "traceroute6",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to traceroute6 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "traceroute6",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install traceroute6: apt-get install traceroute6 2>/dev/null || which traceroute6"
      },
      "args": []
    }
  ]
}