{
  "name": "md5sum",
  "version": "0.1.0",
  "description": "MD5 hash computation and verification",
  "source": "https",
  "checks": [{"type": "binary", "name": "md5sum"}],
  "install_guidance": {
    "plugin": "md5sum",
    "binary": "md5sum",
    "check": "which md5sum",
    "install_steps": [
      "brew install coreutils",
      "Verify: md5sum --version",
      "supercli plugins install ./plugins/md5sum --on-conflict replace --json"
