      "adapterConfig": {"command": "md5sum", "baseArgs": ["--version"], "missingDependencyHelp": "Install md5sum: brew install coreutils"},
      "args": []
    },
    {
      "namespace": "md5sum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to md5sum CLI",
      "adapter": "process",
      "adapterConfig": {"command": "md5sum", "passthrough": true, "missingDependencyHelp": "Install md5sum: brew install coreutils"},
      "args": []
    }
  ]
}
