{
  "name": "rpg-cli",
  "version": "0.1.0",
  "description": "Your filesystem as a dungeon!",
  "source": "https://github.com/facundoolano/rpg-cli",
  "checks": [
    {
      "type": "binary",
      "name": "rpg-cli"
    }
  ],
  "install_guidance": {
    "plugin": "rpg-cli",
    "binary": "rpg-cli",
    "check": "which rpg-cli",
    "install_steps": [
      "brew install rpg-cli",
      "Verify: rpg-cli --version",
      "supercli plugins install ./plugins/rpg-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "rpg-cli",
      "resource": "self",
      "action": "version",
      "description": "Print rpg-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rpg-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rpg-cli: brew install rpg-cli"
      },
      "args": []
    },
    {
      "namespace": "rpg-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rpg-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rpg-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install rpg-cli"
      },
      "args": []
    }
  ]
}