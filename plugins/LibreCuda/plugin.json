{
  "name": "LibreCuda",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/LibreCuda/LibreCuda",
  "checks": [
    {
      "type": "binary",
      "name": "librecuda"
    }
  ],
  "install_guidance": {
    "plugin": "LibreCuda",
    "binary": "librecuda",
    "check": "which librecuda",
    "install_steps": [
      "pip install librecuda",
      "Verify: librecuda --version",
      "supercli plugins install ./plugins/LibreCuda --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LibreCuda",
      "resource": "self",
      "action": "version",
      "description": "Print LibreCuda version",
      "adapter": "process",
      "adapterConfig": {
        "command": "librecuda",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LibreCuda: pip install librecuda"
      },
      "args": []
    },
    {
      "namespace": "LibreCuda",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to librecuda CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "librecuda",
        "passthrough": true,
        "missingDependencyHelp": "Install LibreCuda: pip install librecuda"
      },
      "args": []
    }
  ]
}