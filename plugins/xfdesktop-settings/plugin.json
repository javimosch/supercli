{
  "name": "xfdesktop-settings",
  "version": "0.1.0",
  "description": "CLI tool: xfdesktop-settings",
  "source": "https://manpages.debian.org/xfdesktop-settings",
  "checks": [
    {
      "type": "binary",
      "name": "xfdesktop-settings"
    }
  ],
  "install_guidance": {
    "plugin": "xfdesktop-settings",
    "binary": "xfdesktop-settings",
    "check": "which xfdesktop-settings",
    "install_steps": [
      "apt-get install xfdesktop-settings 2>/dev/null || which xfdesktop-settings",
      "Verify: xfdesktop-settings --version",
      "supercli plugins install ./plugins/xfdesktop-settings --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfdesktop-settings",
      "resource": "self",
      "action": "version",
      "description": "Print xfdesktop-settings version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfdesktop-settings",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfdesktop-settings: apt-get install xfdesktop-settings 2>/dev/null || which xfdesktop-settings"
      },
      "args": []
    },
    {
      "namespace": "xfdesktop-settings",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfdesktop-settings CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfdesktop-settings",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfdesktop-settings: apt-get install xfdesktop-settings 2>/dev/null || which xfdesktop-settings"
      },
      "args": []
    }
  ]
}