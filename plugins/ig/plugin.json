{
  "name": "ig",
  "version": "0.1.0",
  "description": "Instant grep — token-efficient CLI search for AI agents, mmap index, JSON output",
  "source": "https://github.com/MakFly/instant-grep",
  "checks": [
    {
      "type": "binary",
      "name": "ig"
    }
  ],
  "install_guidance": {
    "plugin": "ig",
    "binary": "ig",
    "check": "which ig",
    "install_steps": [
      "curl -fsSL https://raw.githubusercontent.com/MakFly/instant-grep/main/install.sh | bash",
      "Verify: ig --version",
      "supercli plugins install ./plugins/ig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ig",
      "resource": "self",
      "action": "version",
      "description": "Print ig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ig: curl -fsSL https://raw.githubusercontent.com/MakFly/instant-grep/main/install.sh | bash"
      },
      "args": []
    },
    {
      "namespace": "ig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ig",
        "passthrough": true,
        "missingDependencyHelp": "Install ig: curl -fsSL https://raw.githubusercontent.com/MakFly/instant-grep/main/install.sh | bash"
      },
      "args": []
    }
  ]
}
