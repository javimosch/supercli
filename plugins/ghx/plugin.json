{
  "name": "ghx",
  "version": "0.1.0",
  "description": "Agent-first GitHub code exploration — GraphQL batching, code maps, 92% token reduction",
  "source": "https://github.com/gkoreli/ghx",
  "checks": [
    {
      "type": "binary",
      "name": "ghx"
    }
  ],
  "install_guidance": {
    "plugin": "ghx",
    "binary": "ghx",
    "check": "which ghx",
    "install_steps": [
      "go install github.com/gkoreli/ghx/v2/cmd/ghx@latest",
      "Verify: ghx --version",
      "supercli plugins install ./plugins/ghx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ghx",
      "resource": "self",
      "action": "version",
      "description": "Print ghx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ghx: go install github.com/gkoreli/ghx/v2/cmd/ghx@latest"
      },
      "args": []
    },
    {
      "namespace": "ghx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghx",
        "passthrough": true,
        "missingDependencyHelp": "Install ghx: go install github.com/gkoreli/ghx/v2/cmd/ghx@latest"
      },
      "args": []
    }
  ]
}
