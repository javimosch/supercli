{
  "name": "dfu-tool",
  "version": "0.1.0",
  "description": "CLI tool: dfu-tool",
  "source": "https://packages.debian.org/dfu-tool",
  "checks": [{ "type": "binary", "name": "dfu-tool" }],
  "install_guidance": {
    "plugin": "dfu-tool", "binary": "dfu-tool", "check": "which dfu-tool",
    "install_steps": ["apt-get install dfu-tool 2>/dev/null || which dfu-tool", "Verify: dfu-tool --version", "supercli plugins install ./plugins/dfu-tool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dfu-tool", "resource": "_", "action": "_",
    "description": "Passthrough to dfu-tool CLI",
    "adapter": "process", "adapterConfig": { "command": "dfu-tool", "passthrough": true, "missingDependencyHelp": "Install dfu-tool: apt-get install dfu-tool" }, "args": []
  }]
}
