{
  "name": "lunarml",
  "version": "0.1.0",
  "description": "Standard ML compiler that produces Lua/JavaScript",
  "source": "https://github.com/minoki/LunarML",
  "checks": [
    {
      "type": "binary",
      "name": "lunarml"
    }
  ],
  "install_guidance": {
    "plugin": "lunarml",
    "binary": "lunarml",
    "check": "which lunarml",
    "install_steps": [
      "brew install lunarml",
      "Verify: lunarml --version",
      "supercli plugins install ./plugins/lunarml --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lunarml",
      "resource": "self",
      "action": "version",
      "description": "Print lunarml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lunarml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lunarml: brew install lunarml"
      },
      "args": []
    },
    {
      "namespace": "lunarml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lunarml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lunarml",
        "passthrough": true,
        "missingDependencyHelp": "Install lunarml"
      },
      "args": []
    }
  ]
}