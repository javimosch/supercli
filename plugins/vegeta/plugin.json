{
  "name": "vegeta",
  "version": "0.1.0",
  "description": "HTTP load testing tool and library with constant request rate",
  "source": "https://github.com/tsenart/vegeta",
  "checks": [{ "type": "binary", "name": "vegeta" }],
  "install_guidance": {
    "plugin": "vegeta",
    "binary": "vegeta",
    "check": "which vegeta",
    "install_steps": ["brew install vegeta", "Verify: vegeta --version", "supercli plugins install ./plugins/vegeta --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vegeta",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vegeta CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vegeta",
      "passthrough": true,
      "missingDependencyHelp": "Install vegeta: brew install vegeta"
    },
    "args": []
  }]
}
