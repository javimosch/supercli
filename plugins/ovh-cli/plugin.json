{
  "name": "ovh-cli",
  "version": "0.1.0",
  "description": "OVHcloud CLI for managing cloud resources",
  "source": "https",
  "checks": [{"type": "binary", "name": "ovh"}],
  "install_guidance": {
    "plugin": "ovh-cli",
    "binary": "ovh",
    "check": "which ovh",
    "install_steps": [
      "npm install -g @ovh-api/cli",
      "Verify: ovh --version",
      "supercli plugins install ./plugins/ovh-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "ovh-cli",
      "resource": "self",
      "action": "version",
      "description": "Print ovh-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "ovh", "baseArgs": ["--version"], "missingDependencyHelp": "Install ovh-cli: npm install -g @ovh-api/cli"},
      "args": []
    },
    {
      "namespace": "ovh-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ovh CLI",
      "adapter": "process",
      "adapterConfig": {"command": "ovh", "passthrough": true, "missingDependencyHelp": "Install ovh-cli: npm install -g @ovh-api/cli"},
      "args": []
    }
  ]
}
