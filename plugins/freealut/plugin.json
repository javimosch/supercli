{
  "name": "freealut",
  "version": "0.1.0",
  "description": "Implementation of OpenAL's ALUT standard",
  "source": "https://github.com/vancegroup/freealut",
  "checks": [
    {
      "type": "binary",
      "name": "freealut"
    }
  ],
  "install_guidance": {
    "plugin": "freealut",
    "binary": "freealut",
    "check": "which freealut",
    "install_steps": [
      "brew install freealut",
      "Verify: freealut --version",
      "supercli plugins install ./plugins/freealut --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "freealut",
      "resource": "self",
      "action": "version",
      "description": "Print freealut version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freealut",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install freealut: brew install freealut"
      },
      "args": []
    },
    {
      "namespace": "freealut",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freealut CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freealut",
        "passthrough": true,
        "missingDependencyHelp": "Install freealut"
      },
      "args": []
    }
  ]
}