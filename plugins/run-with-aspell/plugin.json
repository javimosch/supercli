{
  "name": "run-with-aspell",
  "version": "0.1.0",
  "description": "CLI tool: run-with-aspell",
  "source": "https://manpages.debian.org/run-with-aspell",
  "checks": [
    {
      "type": "binary",
      "name": "run-with-aspell"
    }
  ],
  "install_guidance": {
    "plugin": "run-with-aspell",
    "binary": "run-with-aspell",
    "check": "which run-with-aspell",
    "install_steps": [
      "apt-get install run-with-aspell 2>/dev/null || which run-with-aspell",
      "Verify: run-with-aspell --version",
      "supercli plugins install ./plugins/run-with-aspell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "run-with-aspell",
      "resource": "self",
      "action": "version",
      "description": "Print run-with-aspell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "run-with-aspell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install run-with-aspell: apt-get install run-with-aspell 2>/dev/null || which run-with-aspell"
      },
      "args": []
    },
    {
      "namespace": "run-with-aspell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to run-with-aspell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "run-with-aspell",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install run-with-aspell: apt-get install run-with-aspell 2>/dev/null || which run-with-aspell"
      },
      "args": []
    }
  ]
}