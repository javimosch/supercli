{
  "name": "gdelt-cli",
  "version": "0.1.0",
  "description": "CLI for GDELT global event trend and sentiment analytics",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "gdelt-cli" }],
  "install_guidance": {
    "plugin": "gdelt-cli",
    "binary": "gdelt-cli",
    "check": "which gdelt-cli",
    "install_steps": ["pip install gdelt-cli", "Verify: gdelt-cli --version", "supercli plugins install ./plugins/gdelt-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gdelt-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gdelt-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gdelt-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install gdelt-cli: pip install gdelt-cli"
    },
    "args": []
  }]
}
