{
  "name": "tree-sitter",
  "version": "0.1.0",
  "description": "Tree-sitter — incremental parsing system for programming languages",
  "source": "https://github.com/tree-sitter/tree-sitter",
  "checks": [
    {
      "type": "binary",
      "name": "tree-sitter"
    }
  ],
  "install_guidance": {
    "plugin": "tree-sitter",
    "binary": "tree-sitter",
    "check": "which tree-sitter",
    "install_steps": [
      "brew install tree-sitter",
      "cargo install tree-sitter-cli",
      "Verify: tree-sitter --version",
      "supercli plugins install ./plugins/tree-sitter --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tree-sitter",
      "resource": "self",
      "action": "version",
      "description": "Print tree-sitter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tree-sitter",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install tree-sitter: brew install tree-sitter"
      },
      "args": []
    },
    {
      "namespace": "tree-sitter",
      "resource": "cli",
      "action": "run",
      "description": "Tree-sitter — incremental parsing system for programming languages",
      "adapter": "process",
      "adapterConfig": {
        "command": "tree-sitter",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tree-sitter: brew install tree-sitter"
      },
      "args": []
    }
  ]
}
