{
  "name": "cvto",
  "version": "0.1.0",
  "description": "Convert between structured formats JSON/TOML/YAML via CLI",
  "source": "https://github.com/yozhgoor/cvto",
  "checks": [{ "type": "binary", "name": "cvto" }],
  "install_guidance": {
    "plugin": "cvto",
    "binary": "cvto",
    "check": "which cvto",
    "install_steps": ["cargo install cvto", "Verify: cvto --version", "supercli plugins install ./plugins/cvto --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cvto",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cvto CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cvto",
      "passthrough": true,
      "missingDependencyHelp": "Install cvto: cargo install cvto"
    },
    "args": []
  }]
}
