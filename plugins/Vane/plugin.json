{
  "name": "Vane",
  "version": "0.1.0",
  "description": "Vane is an AI-powered answering engine.",
  "source": "https://github.com/Vane/Vane",
  "checks": [
    {
      "type": "binary",
      "name": "vane"
    }
  ],
  "install_guidance": {
    "plugin": "Vane",
    "binary": "vane",
    "check": "which vane",
    "install_steps": [
      "pip install vane",
      "Verify: vane --version",
      "supercli plugins install ./plugins/Vane --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Vane",
      "resource": "self",
      "action": "version",
      "description": "Print Vane version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vane",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Vane: pip install vane"
      },
      "args": []
    },
    {
      "namespace": "Vane",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vane CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vane",
        "passthrough": true,
        "missingDependencyHelp": "Install Vane: pip install vane"
      },
      "args": []
    }
  ]
}