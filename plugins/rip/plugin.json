{
  "name": "rip",
  "version": "1.0.0",
  "description": "rip \u2014 Safe rm alternative",
  "source": "crates.io/crates/rip",
  "checks": [
    {
      "type": "binary",
      "name": "rip"
    }
  ],
  "install_guidance": {
    "plugin": "rip",
    "binary": "rip",
    "check": "which rip",
    "install_steps": [
      "# Install rip:",
      "# apt: sudo apt-get install rip",
      "# brew: brew install rip",
      "# cargo: cargo install rip",
      "# npm: npm install -g rip",
      "# pip: pip install rip",
      "# or download from crates.io/crates/rip"
    ]
  },
  "commands": [
    {
      "namespace": "rip",
      "resource": "rip",
      "action": "run",
      "description": "Run rip",
      "adapter": "process",
      "adapterConfig": {
        "command": "rip",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rip from crates.io/crates/rip"
      },
      "args": []
    }
  ]
}