{
  "name": "slides",
  "version": "0.1.0",
  "description": "slides — Terminal slides from markdown",
  "source": "https://github.com/slides/slides",
  "checks": [
    {
      "type": "binary",
      "name": "slides"
    }
  ],
  "install_guidance": {
    "plugin": "slides",
    "binary": "slides",
    "check": "which slides",
    "install_steps": [
      "npm install -g slides",
      "Verify: slides --version",
      "supercli plugins install ./plugins/slides --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "slides",
      "resource": "self",
      "action": "version",
      "description": "Print slides version",
      "adapter": "process",
      "adapterConfig": {
        "command": "slides",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install slides: npm install -g slides"
      },
      "args": []
    },
    {
      "namespace": "slides",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to slides CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "slides",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install slides: npm install -g slides"
      },
      "args": []
    }
  ]
}
