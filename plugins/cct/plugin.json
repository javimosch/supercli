{
  "name": "cct",
  "version": "0.1.0",
  "description": "CLI tool: cct",
  "source": "https://packages.debian.org/cct",
  "checks": [{ "type": "binary", "name": "cct" }],
  "install_guidance": {
    "plugin": "cct", "binary": "cct", "check": "which cct",
    "install_steps": ["apt-get install cct 2>/dev/null || which cct", "Verify: cct --version", "supercli plugins install ./plugins/cct --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cct", "resource": "_", "action": "_",
    "description": "Passthrough to cct CLI",
    "adapter": "process", "adapterConfig": { "command": "cct", "passthrough": true, "missingDependencyHelp": "Install cct: apt-get install cct" }, "args": []
  }]
}
