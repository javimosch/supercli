{
  "name": "xpmtoppm",
  "version": "0.1.0",
  "description": "CLI tool: xpmtoppm",
  "source": "https://manpages.debian.org/xpmtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "xpmtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "xpmtoppm",
    "binary": "xpmtoppm",
    "check": "which xpmtoppm",
    "install_steps": [
      "apt-get install xpmtoppm 2>/dev/null || which xpmtoppm",
      "Verify: xpmtoppm --version",
      "supercli plugins install ./plugins/xpmtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xpmtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print xpmtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xpmtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xpmtoppm: apt-get install xpmtoppm 2>/dev/null || which xpmtoppm"
      },
      "args": []
    },
    {
      "namespace": "xpmtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xpmtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xpmtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xpmtoppm: apt-get install xpmtoppm 2>/dev/null || which xpmtoppm"
      },
      "args": []
    }
  ]
}