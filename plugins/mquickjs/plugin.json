{
  "name": "mquickjs",
  "version": "0.1.0",
  "description": "Public repository of the Micro QuickJS Javascript Engine",
  "source": "https://github.com/mquickjs/mquickjs",
  "checks": [
    {
      "type": "binary",
      "name": "mquickjs"
    }
  ],
  "install_guidance": {
    "plugin": "mquickjs",
    "binary": "mquickjs",
    "check": "which mquickjs",
    "install_steps": [
      "pip install mquickjs",
      "Verify: mquickjs --version",
      "supercli plugins install ./plugins/mquickjs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mquickjs",
      "resource": "self",
      "action": "version",
      "description": "Print mquickjs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mquickjs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mquickjs: pip install mquickjs"
      },
      "args": []
    },
    {
      "namespace": "mquickjs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mquickjs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mquickjs",
        "passthrough": true,
        "missingDependencyHelp": "Install mquickjs: pip install mquickjs"
      },
      "args": []
    }
  ]
}