{
  "name": "minikube",
  "version": "0.1.0",
  "description": "Local Kubernetes cluster for development",
  "source": "https",
  "checks": [{"type": "binary", "name": "minikube"}],
  "install_guidance": {
    "plugin": "minikube",
    "binary": "minikube",
    "check": "which minikube",
    "install_steps": [
      "brew install minikube",
      "Verify: minikube --version",
      "supercli plugins install ./plugins/minikube --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "minikube",
      "resource": "self",
      "action": "version",
      "description": "Print minikube version",
      "adapter": "process",
      "adapterConfig": {"command": "minikube", "baseArgs": ["--version"], "missingDependencyHelp": "Install minikube: brew install minikube"},
      "args": []
    },
    {
      "namespace": "minikube",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to minikube CLI",
      "adapter": "process",
      "adapterConfig": {"command": "minikube", "passthrough": true, "missingDependencyHelp": "Install minikube: brew install minikube"},
      "args": []
    }
  ]
}
