{
  "name": "docker-ls",
  "version": "0.1.0",
  "description": "Tools for browsing and manipulating docker registries",
  "source": "https://github.com/mayflower/docker-ls",
  "checks": [
    {
      "type": "binary",
      "name": "docker-ls"
    }
  ],
  "install_guidance": {
    "plugin": "docker-ls",
    "binary": "docker-ls",
    "check": "which docker-ls",
    "install_steps": [
      "brew install docker-ls",
      "Verify: docker-ls --version",
      "supercli plugins install ./plugins/docker-ls --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "docker-ls",
      "resource": "self",
      "action": "version",
      "description": "Print docker-ls version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-ls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-ls: brew install docker-ls"
      },
      "args": []
    },
    {
      "namespace": "docker-ls",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-ls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-ls",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-ls"
      },
      "args": []
    }
  ]
}