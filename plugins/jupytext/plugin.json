{
  "name": "jupytext",
  "version": "0.1.0",
  "description": "Jupyter notebooks as Markdown or scripts",
  "source": "https://github.com/mwouts/jupytext",
  "checks": [{ "type": "binary", "name": "jupytext" }],
  "install_guidance": {
    "plugin": "jupytext",
    "binary": "jupytext",
    "check": "which jupytext",
    "install_steps": ["pip install jupytext", "Verify: jupytext --version", "supercli plugins install ./plugins/jupytext --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jupytext",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jupytext CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jupytext",
      "passthrough": true,
      "missingDependencyHelp": "Install jupytext: pip install jupytext", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
