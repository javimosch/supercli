{
  "name": "xsetmode",
  "version": "0.1.0",
  "description": "set the mode for an X Input device (x11-xserver-utils)",
  "source": "https://manpages.debian.org/xsetmode",
  "checks": [
    {
      "type": "binary",
      "name": "xsetmode"
    }
  ],
  "install_guidance": {
    "plugin": "xsetmode",
    "binary": "xsetmode",
    "check": "which xsetmode",
    "install_steps": [
      "apt-get install xsetmode 2>/dev/null || which xsetmode",
      "Verify: xsetmode --version",
      "supercli plugins install ./plugins/xsetmode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xsetmode",
      "resource": "self",
      "action": "version",
      "description": "Print xsetmode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsetmode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xsetmode: apt-get install xsetmode 2>/dev/null || which xsetmode"
      },
      "args": []
    },
    {
      "namespace": "xsetmode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xsetmode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsetmode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xsetmode: apt-get install xsetmode 2>/dev/null || which xsetmode"
      },
      "args": []
    }
  ]
}