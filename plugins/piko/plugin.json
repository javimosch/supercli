{
  "name": "piko",
  "version": "0.1.0",
  "description": "morphe patches for twitter",
  "source": "https://github.com/piko/piko",
  "checks": [
    {
      "type": "binary",
      "name": "piko"
    }
  ],
  "install_guidance": {
    "plugin": "piko",
    "binary": "piko",
    "check": "which piko",
    "install_steps": [
      "pip install piko",
      "Verify: piko --version",
      "supercli plugins install ./plugins/piko --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "piko",
      "resource": "self",
      "action": "version",
      "description": "Print piko version",
      "adapter": "process",
      "adapterConfig": {
        "command": "piko",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install piko: pip install piko"
      },
      "args": []
    },
    {
      "namespace": "piko",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to piko CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "piko",
        "passthrough": true,
        "missingDependencyHelp": "Install piko: pip install piko"
      },
      "args": []
    }
  ]
}