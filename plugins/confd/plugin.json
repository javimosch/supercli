{
  "name": "confd",
  "version": "0.1.0",
  "description": "Lightweight configuration management tool using template and backend data",
  "source": "go",
  "checks": [{ "type": "binary", "name": "confd" }],
  "install_guidance": {
    "plugin": "confd",
    "binary": "confd",
    "check": "which confd",
    "install_steps": ["go install github.com/kelseyhightower/confd@latest", "Verify: confd --version", "supercli plugins install ./plugins/confd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "confd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to confd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "confd",
      "passthrough": true,
      "missingDependencyHelp": "Install confd: go install github.com/kelseyhightower/confd@latest"
    },
    "args": []
  }]
}
