{
  "name": "dvi2tty",
  "version": "0.1.0",
  "description": "CLI tool: dvi2tty",
  "source": "https://manpages.debian.org/dvi2tty",
  "checks": [
    {
      "type": "binary",
      "name": "dvi2tty"
    }
  ],
  "install_guidance": {
    "plugin": "dvi2tty",
    "binary": "dvi2tty",
    "check": "which dvi2tty",
    "install_steps": [
      "apt-get install dvi2tty 2>/dev/null || which dvi2tty",
      "Verify: dvi2tty --version",
      "supercli plugins install ./plugins/dvi2tty --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvi2tty",
      "resource": "self",
      "action": "version",
      "description": "Print dvi2tty version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvi2tty",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvi2tty: apt-get install dvi2tty 2>/dev/null || which dvi2tty"
      },
      "args": []
    },
    {
      "namespace": "dvi2tty",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvi2tty CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvi2tty",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvi2tty: apt-get install dvi2tty 2>/dev/null || which dvi2tty"
      },
      "args": []
    }
  ]
}