{
  "name": "hydra",
  "version": "0.1.0",
  "description": "Network login brute-force testing tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "hydra"}],
  "install_guidance": {
    "plugin": "hydra",
    "binary": "hydra",
    "check": "which hydra",
    "install_steps": [
      "brew install hydra",
      "Verify: hydra --version",
      "supercli plugins install ./plugins/hydra --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "hydra",
      "resource": "self",
      "action": "version",
      "description": "Print hydra version",
      "adapter": "process",
      "adapterConfig": {"command": "hydra", "baseArgs": ["--version"], "missingDependencyHelp": "Install hydra: brew install hydra"},
      "args": []
    },
    {
      "namespace": "hydra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hydra CLI",
      "adapter": "process",
      "adapterConfig": {"command": "hydra", "passthrough": true, "missingDependencyHelp": "Install hydra: brew install hydra"},
      "args": []
    }
  ]
}
