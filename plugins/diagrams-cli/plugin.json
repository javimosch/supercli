{
  "name": "diagrams-cli",
  "version": "0.1.0",
  "description": "Render Python Diagrams-as-Code to images via CLI",
  "source": "https://github.com/mingrammer/diagrams",
  "checks": [{ "type": "binary", "name": "diagrams-cli" }],
  "install_guidance": {
    "plugin": "diagrams-cli",
    "binary": "diagrams-cli",
    "check": "which diagrams-cli",
    "install_steps": ["pip install diagrams", "Verify: diagrams-cli --version", "supercli plugins install ./plugins/diagrams-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "diagrams-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to diagrams-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "diagrams-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install diagrams-cli: pip install diagrams", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
