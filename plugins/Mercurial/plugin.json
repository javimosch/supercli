{
  "name": "Mercurial",
  "version": "0.1.0",
  "description": "Free, distributed source control management tool.",
  "checks": [
    {
      "type": "binary",
      "name": "Mercurial"
    }
  ],
  "install_guidance": {
    "plugin": "Mercurial",
    "binary": "Mercurial",
    "check": "which Mercurial",
    "install_steps": [
      "brew install Mercurial",
      "Verify: Mercurial --version",
      "supercli plugins install ./plugins/Mercurial --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Mercurial",
      "resource": "self",
      "action": "version",
      "description": "Print Mercurial version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Mercurial",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Mercurial: brew install Mercurial"
      },
      "args": []
    },
    {
      "namespace": "Mercurial",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Mercurial CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Mercurial",
        "passthrough": true,
        "missingDependencyHelp": "Install Mercurial"
      },
      "args": []
    }
  ]
}