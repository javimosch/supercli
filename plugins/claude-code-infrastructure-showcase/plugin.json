{
  "name": "claude-code-infrastructure-showcase",
  "version": "0.1.0",
  "description": "Examples of my Claude Code infrastructure with skill auto-activation, hooks, and agents",
  "source": "https://github.com/claude-code-infrastructure-showcase/claude-code-infrastructure-showcase",
  "checks": [
    {
      "type": "binary",
      "name": "claude-code-infrastructure-showcase"
    }
  ],
  "install_guidance": {
    "plugin": "claude-code-infrastructure-showcase",
    "binary": "claude-code-infrastructure-showcase",
    "check": "which claude-code-infrastructure-showcase",
    "install_steps": [
      "pip install claude-code-infrastructure-showcase",
      "Verify: claude-code-infrastructure-showcase --version",
      "supercli plugins install ./plugins/claude-code-infrastructure-showcase --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-code-infrastructure-showcase",
      "resource": "self",
      "action": "version",
      "description": "Print claude-code-infrastructure-showcase version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-infrastructure-showcase",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-code-infrastructure-showcase: pip install claude-code-infrastructure-showcase"
      },
      "args": []
    },
    {
      "namespace": "claude-code-infrastructure-showcase",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-code-infrastructure-showcase CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-infrastructure-showcase",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-code-infrastructure-showcase: pip install claude-code-infrastructure-showcase"
      },
      "args": []
    }
  ]
}