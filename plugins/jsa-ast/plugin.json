{
  "name": "jsa-ast",
  "version": "0.1.0",
  "description": "CLI tool: jsa-ast",
  "source": "https://manpages.debian.org/jsa-ast",
  "checks": [
    {
      "type": "binary",
      "name": "jsa-ast"
    }
  ],
  "install_guidance": {
    "plugin": "jsa-ast",
    "binary": "jsa-ast",
    "check": "which jsa-ast",
    "install_steps": [
      "apt-get install jsa-ast 2>/dev/null || which jsa-ast",
      "Verify: jsa-ast --version",
      "supercli plugins install ./plugins/jsa-ast --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jsa-ast",
      "resource": "self",
      "action": "version",
      "description": "Print jsa-ast version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsa-ast",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jsa-ast: apt-get install jsa-ast 2>/dev/null || which jsa-ast"
      },
      "args": []
    },
    {
      "namespace": "jsa-ast",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jsa-ast CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsa-ast",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jsa-ast: apt-get install jsa-ast 2>/dev/null || which jsa-ast"
      },
      "args": []
    }
  ]
}