{
  "name": "brush",
  "version": "0.1.0",
  "description": "3D Reconstruction for all",
  "source": "https://github.com/brush/brush",
  "checks": [
    {
      "type": "binary",
      "name": "brush"
    }
  ],
  "install_guidance": {
    "plugin": "brush",
    "binary": "brush",
    "check": "which brush",
    "install_steps": [
      "pip install brush",
      "Verify: brush --version",
      "supercli plugins install ./plugins/brush --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "brush",
      "resource": "self",
      "action": "version",
      "description": "Print brush version",
      "adapter": "process",
      "adapterConfig": {
        "command": "brush",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install brush: pip install brush"
      },
      "args": []
    },
    {
      "namespace": "brush",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to brush CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "brush",
        "passthrough": true,
        "missingDependencyHelp": "Install brush: pip install brush"
      },
      "args": []
    }
  ]
}