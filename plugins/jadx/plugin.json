{
  "name": "jadx",
  "version": "0.1.0",
  "description": "Dex to Java decompiler with --output-dir",
  "source": "https://github.com/skylot/jadx",
  "checks": [
    {
      "type": "binary",
      "name": "jadx"
    }
  ],
  "install_guidance": {
    "plugin": "jadx",
    "binary": "jadx",
    "check": "which jadx",
    "install_steps": [
      "brew install jadx",
      "Verify: jadx --version",
      "supercli plugins install ./plugins/jadx --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "jadx",
      "resource": "self",
      "action": "version",
      "description": "Print jadx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jadx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jadx: brew install jadx"
      },
      "args": []
    },
    {
      "namespace": "jadx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jadx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jadx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jadx: brew install jadx"
      },
      "args": []
    }
  ]
}
