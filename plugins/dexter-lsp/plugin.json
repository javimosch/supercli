{
  "name": "dexter-lsp",
  "version": "0.1.0",
  "description": "Elixir LSP optimized for large codebases",
  "source": "https://github.com/remoteoss/dexter",
  "checks": [
    {
      "type": "binary",
      "name": "dexter-lsp"
    }
  ],
  "install_guidance": {
    "plugin": "dexter-lsp",
    "binary": "dexter-lsp",
    "check": "which dexter-lsp",
    "install_steps": [
      "brew install dexter-lsp",
      "Verify: dexter-lsp --version",
      "supercli plugins install ./plugins/dexter-lsp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dexter-lsp",
      "resource": "self",
      "action": "version",
      "description": "Print dexter-lsp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dexter-lsp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dexter-lsp: brew install dexter-lsp"
      },
      "args": []
    },
    {
      "namespace": "dexter-lsp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dexter-lsp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dexter-lsp",
        "passthrough": true,
        "missingDependencyHelp": "Install dexter-lsp"
      },
      "args": []
    }
  ]
}