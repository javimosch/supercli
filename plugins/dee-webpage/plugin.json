{
  "name": "dee-webpage",
  "version": "0.1.0",
  "description": "Extract metadata and content from webpages with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-webpage" }],
  "install_guidance": {
    "plugin": "dee-webpage",
    "binary": "dee-webpage",
    "check": "which dee-webpage",
    "install_steps": ["cargo install dee-webpage", "Verify: dee-webpage --version", "supercli plugins install ./plugins/dee-webpage --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-webpage",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-webpage CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-webpage",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-webpage: cargo install dee-webpage"
    },
    "args": []
  }]
}
