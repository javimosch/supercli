{
  "name": "cups.ippeveprinter",
  "version": "0.1.0",
  "description": "CLI tool: cups.ippeveprinter",
  "source": "https://manpages.debian.org/cups.ippeveprinter",
  "checks": [
    {
      "type": "binary",
      "name": "cups.ippeveprinter"
    }
  ],
  "install_guidance": {
    "plugin": "cups.ippeveprinter",
    "binary": "cups.ippeveprinter",
    "check": "which cups.ippeveprinter",
    "install_steps": [
      "apt-get install cups.ippeveprinter 2>/dev/null || which cups.ippeveprinter",
      "Verify: cups.ippeveprinter --version",
      "supercli plugins install ./plugins/cups.ippeveprinter --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cups.ippeveprinter",
      "resource": "self",
      "action": "version",
      "description": "Print cups.ippeveprinter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cups.ippeveprinter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cups.ippeveprinter: apt-get install cups.ippeveprinter 2>/dev/null || which cups.ippeveprinter"
      },
      "args": []
    },
    {
      "namespace": "cups.ippeveprinter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cups.ippeveprinter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cups.ippeveprinter",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install cups.ippeveprinter: apt-get install cups.ippeveprinter 2>/dev/null || which cups.ippeveprinter"
      },
      "args": []
    }
  ]
}