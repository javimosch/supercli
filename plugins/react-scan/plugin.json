{
  "name": "react-scan",
  "version": "0.1.0",
  "description": "Scan and fix React performance issues",
  "source": "https://github.com/react-scan/react-scan",
  "checks": [
    {
      "type": "binary",
      "name": "react-scan"
    }
  ],
  "install_guidance": {
    "plugin": "react-scan",
    "binary": "react-scan",
    "check": "which react-scan",
    "install_steps": [
      "pip install react-scan",
      "Verify: react-scan --version",
      "supercli plugins install ./plugins/react-scan --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "react-scan",
      "resource": "self",
      "action": "version",
      "description": "Print react-scan version",
      "adapter": "process",
      "adapterConfig": {
        "command": "react-scan",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install react-scan: pip install react-scan"
      },
      "args": []
    },
    {
      "namespace": "react-scan",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to react-scan CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "react-scan",
        "passthrough": true,
        "missingDependencyHelp": "Install react-scan: pip install react-scan"
      },
      "args": []
    }
  ]
}