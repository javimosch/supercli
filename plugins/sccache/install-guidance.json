{
  "plugin": "sccache",
  "binary": "sccache",
  "check": "which sccache",
  "install_steps": [
    "cargo install sccache",
    "brew install sccache",
    "Verify: sccache --version",
    "supercli plugins install ./plugins/sccache --on-conflict replace --json"
  ],
  "note": "Source: https://github.com/mozilla/sccache (7323 stars). Written in Rust."
}
