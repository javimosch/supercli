{
  "name": "cpupower-gui",
  "version": "0.1.0",
  "description": "CLI tool: cpupower-gui",
  "source": "https://packages.debian.org/cpupower-gui",
  "checks": [{ "type": "binary", "name": "cpupower-gui" }],
  "install_guidance": {
    "plugin": "cpupower-gui", "binary": "cpupower-gui", "check": "which cpupower-gui",
    "install_steps": ["apt-get install cpupower-gui 2>/dev/null || which cpupower-gui", "Verify: cpupower-gui --version", "supercli plugins install ./plugins/cpupower-gui --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpupower-gui", "resource": "_", "action": "_",
    "description": "Passthrough to cpupower-gui CLI",
    "adapter": "process", "adapterConfig": { "command": "cpupower-gui", "passthrough": true, "missingDependencyHelp": "Install cpupower-gui: apt-get install cpupower-gui" }, "args": []
  }]
}
