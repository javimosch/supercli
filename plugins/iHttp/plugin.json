{
  "name": "iHttp",
  "version": "0.1.0",
  "description": "Asynchronous http request php tool with curl(发送HTTP/HTTPS请求的类[支持批量异步GET(POST)请求,支持服务器代理,支持自定义RequestHeader])",
  "source": "https://github.com/iHttp/iHttp",
  "checks": [
    {
      "type": "binary",
      "name": "iHttp"
    }
  ],
  "install_guidance": {
    "plugin": "iHttp",
    "binary": "iHttp",
    "check": "which iHttp",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: iHttp --version",
      "supercli plugins install ./plugins/iHttp --on-conflict replace --json"
    ],
    "note": "PHP language CLI tool"
  },
  "commands": [
    {
      "namespace": "iHttp",
      "resource": "self",
      "action": "version",
      "description": "Print iHttp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iHttp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iHttp from project repository"
      },
      "args": []
    },
    {
      "namespace": "iHttp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iHttp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iHttp",
        "passthrough": true,
        "missingDependencyHelp": "Install iHttp from project repository"
      },
      "args": []
    }
  ]
}