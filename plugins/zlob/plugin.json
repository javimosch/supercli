{
  "name": "zlob",
  "version": "0.1.0",
  "description": "100% POSIX and glibc compatible globbing library for C, Zig, and Rust that is faster and supports al",
  "source": "https://github.com/zlob/zlob",
  "checks": [
    {
      "type": "binary",
      "name": "zlob"
    }
  ],
  "install_guidance": {
    "plugin": "zlob",
    "binary": "zlob",
    "check": "which zlob",
    "install_steps": [
      "pip install zlob",
      "Verify: zlob --version",
      "supercli plugins install ./plugins/zlob --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zlob",
      "resource": "self",
      "action": "version",
      "description": "Print zlob version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zlob",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zlob: pip install zlob"
      },
      "args": []
    },
    {
      "namespace": "zlob",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zlob CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zlob",
        "passthrough": true,
        "missingDependencyHelp": "Install zlob: pip install zlob"
      },
      "args": []
    }
  ]
}