{
  "name": "upgrade-from-grub-legacy",
  "version": "0.1.0",
  "description": "CLI tool: upgrade-from-grub-legacy",
  "source": "https://manpages.debian.org/upgrade-from-grub-legacy",
  "checks": [
    {
      "type": "binary",
      "name": "upgrade-from-grub-legacy"
    }
  ],
  "install_guidance": {
    "plugin": "upgrade-from-grub-legacy",
    "binary": "upgrade-from-grub-legacy",
    "check": "which upgrade-from-grub-legacy",
    "install_steps": [
      "apt-get install upgrade-from-grub-legacy 2>/dev/null || which upgrade-from-grub-legacy",
      "Verify: upgrade-from-grub-legacy --version",
      "supercli plugins install ./plugins/upgrade-from-grub-legacy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "upgrade-from-grub-legacy",
      "resource": "self",
      "action": "version",
      "description": "Print upgrade-from-grub-legacy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "upgrade-from-grub-legacy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install upgrade-from-grub-legacy: apt-get install upgrade-from-grub-legacy 2>/dev/null || which upgrade-from-grub-legacy"
      },
      "args": []
    },
    {
      "namespace": "upgrade-from-grub-legacy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to upgrade-from-grub-legacy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "upgrade-from-grub-legacy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install upgrade-from-grub-legacy: apt-get install upgrade-from-grub-legacy 2>/dev/null || which upgrade-from-grub-legacy"
      },
      "args": []
    }
  ]
}