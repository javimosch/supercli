{
  "name": "flyctl",
  "version": "0.1.0",
  "description": "Fly.io CLI for deploying and managing apps",
  "source": "https",
  "checks": [{"type": "binary", "name": "flyctl"}],
  "install_guidance": {
    "plugin": "flyctl",
    "binary": "flyctl",
    "check": "which flyctl",
    "install_steps": [
      "brew install flyctl",
      "Verify: flyctl --version",
      "supercli plugins install ./plugins/flyctl --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "flyctl",
      "resource": "self",
      "action": "version",
      "description": "Print flyctl version",
      "adapter": "process",
      "adapterConfig": {"command": "flyctl", "baseArgs": ["--version"], "missingDependencyHelp": "Install flyctl: brew install flyctl"},
      "args": []
    },
    {
      "namespace": "flyctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flyctl CLI",
      "adapter": "process",
      "adapterConfig": {"command": "flyctl", "passthrough": true, "missingDependencyHelp": "Install flyctl: brew install flyctl"},
      "args": []
    }
  ]
}
