{
  "name": "wovp2ovf",
  "version": "0.1.0",
  "description": "CLI tool: wovp2ovf",
  "source": "https://manpages.debian.org/wovp2ovf",
  "checks": [
    {
      "type": "binary",
      "name": "wovp2ovf"
    }
  ],
  "install_guidance": {
    "plugin": "wovp2ovf",
    "binary": "wovp2ovf",
    "check": "which wovp2ovf",
    "install_steps": [
      "apt-get install wovp2ovf 2>/dev/null || which wovp2ovf",
      "Verify: wovp2ovf --version",
      "supercli plugins install ./plugins/wovp2ovf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wovp2ovf",
      "resource": "self",
      "action": "version",
      "description": "Print wovp2ovf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wovp2ovf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wovp2ovf: apt-get install wovp2ovf 2>/dev/null || which wovp2ovf"
      },
      "args": []
    },
    {
      "namespace": "wovp2ovf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wovp2ovf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wovp2ovf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wovp2ovf: apt-get install wovp2ovf 2>/dev/null || which wovp2ovf"
      },
      "args": []
    }
  ]
}