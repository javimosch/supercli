{
  "name": "pgdog",
  "version": "0.1.0",
  "description": "PostgreSQL connection pooler, load balancer and database sharder.",
  "source": "https://github.com/pgdog/pgdog",
  "checks": [
    {
      "type": "binary",
      "name": "pgdog"
    }
  ],
  "install_guidance": {
    "plugin": "pgdog",
    "binary": "pgdog",
    "check": "which pgdog",
    "install_steps": [
      "pip install pgdog",
      "Verify: pgdog --version",
      "supercli plugins install ./plugins/pgdog --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgdog",
      "resource": "self",
      "action": "version",
      "description": "Print pgdog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgdog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgdog: pip install pgdog"
      },
      "args": []
    },
    {
      "namespace": "pgdog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgdog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgdog",
        "passthrough": true,
        "missingDependencyHelp": "Install pgdog: pip install pgdog"
      },
      "args": []
    }
  ]
}