{
  "name": "ossgofragel",
  "version": "0.1.0",
  "description": "Open source security vulnerability scanner for Go projects",
  "source": "https://github.com/ossgofragel/ossgofragel",
  "checks": [
    {
      "type": "binary",
      "name": "ossgofragel"
    }
  ],
  "install_guidance": {
    "plugin": "ossgofragel",
    "binary": "ossgofragel",
    "check": "which ossgofragel",
    "install_steps": [
      "go install github.com/ossgofragel/ossgofragel@latest",
      "Verify: ossgofragel --version",
      "supercli plugins install ./plugins/ossgofragel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ossgofragel",
      "resource": "self",
      "action": "version",
      "description": "Print ossgofragel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ossgofragel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ossgofragel: go install github.com/ossgofragel/ossgofragel@latest"
      },
      "args": []
    },
    {
      "namespace": "ossgofragel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ossgofragel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ossgofragel",
        "passthrough": true,
        "missingDependencyHelp": "Install ossgofragel: go install github.com/ossgofragel/ossgofragel@latest"
      },
      "args": []
    }
  ]
}
