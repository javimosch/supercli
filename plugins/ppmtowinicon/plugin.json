{
  "name": "ppmtowinicon",
  "version": "0.1.0",
  "description": "CLI tool: ppmtowinicon",
  "source": "https://manpages.debian.org/ppmtowinicon",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtowinicon"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtowinicon",
    "binary": "ppmtowinicon",
    "check": "which ppmtowinicon",
    "install_steps": [
      "apt-get install ppmtowinicon 2>/dev/null || which ppmtowinicon",
      "Verify: ppmtowinicon --version",
      "supercli plugins install ./plugins/ppmtowinicon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtowinicon",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtowinicon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtowinicon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtowinicon: apt-get install ppmtowinicon 2>/dev/null || which ppmtowinicon"
      },
      "args": []
    },
    {
      "namespace": "ppmtowinicon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtowinicon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtowinicon",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtowinicon: apt-get install ppmtowinicon 2>/dev/null || which ppmtowinicon"
      },
      "args": []
    }
  ]
}