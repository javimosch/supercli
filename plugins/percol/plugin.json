{
  "name": "percol",
  "version": "1.0.0",
  "description": "percol \u2014 Interactive grep tool",
  "source": "github.com/mooz/percol",
  "checks": [
    {
      "type": "binary",
      "name": "percol"
    }
  ],
  "install_guidance": {
    "plugin": "percol",
    "binary": "percol",
    "check": "which percol",
    "install_steps": [
      "# Install percol:",
      "# apt: sudo apt-get install percol",
      "# brew: brew install percol",
      "# cargo: cargo install percol",
      "# npm: npm install -g percol",
      "# pip: pip install percol",
      "# or download from github.com/mooz/percol"
    ]
  },
  "commands": [
    {
      "namespace": "percol",
      "resource": "percol",
      "action": "run",
      "description": "Run percol",
      "adapter": "process",
      "adapterConfig": {
        "command": "percol",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install percol from github.com/mooz/percol"
      },
      "args": []
    }
  ]
}