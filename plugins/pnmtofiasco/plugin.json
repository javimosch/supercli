{
  "name": "pnmtofiasco",
  "version": "0.1.0",
  "description": "CLI tool: pnmtofiasco",
  "source": "https://manpages.debian.org/pnmtofiasco",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtofiasco"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtofiasco",
    "binary": "pnmtofiasco",
    "check": "which pnmtofiasco",
    "install_steps": [
      "apt-get install pnmtofiasco 2>/dev/null || which pnmtofiasco",
      "Verify: pnmtofiasco --version",
      "supercli plugins install ./plugins/pnmtofiasco --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtofiasco",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtofiasco version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtofiasco",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtofiasco: apt-get install pnmtofiasco 2>/dev/null || which pnmtofiasco"
      },
      "args": []
    },
    {
      "namespace": "pnmtofiasco",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtofiasco CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtofiasco",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtofiasco: apt-get install pnmtofiasco 2>/dev/null || which pnmtofiasco"
      },
      "args": []
    }
  ]
}