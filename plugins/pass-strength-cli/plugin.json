{
  "name": "pass-strength-cli",
  "version": "0.1.0",
  "description": "Validate password entropy and strength in the shell",
  "source": "https://github.com/karanjthakkar/pass-strength-cli",
  "checks": [{ "type": "binary", "name": "pass-strength-cli" }],
  "install_guidance": {
    "plugin": "pass-strength-cli",
    "binary": "pass-strength-cli",
    "check": "which pass-strength-cli",
    "install_steps": ["npm install -g pass-strength-cli", "Verify: pass-strength-cli --version", "supercli plugins install ./plugins/pass-strength-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pass-strength-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pass-strength-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pass-strength-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install pass-strength-cli: npm install -g pass-strength-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
