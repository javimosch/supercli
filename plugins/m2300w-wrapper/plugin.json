{
  "name": "m2300w-wrapper",
  "version": "0.1.0",
  "description": "CLI tool: m2300w-wrapper",
  "source": "https://manpages.debian.org/m2300w-wrapper",
  "checks": [
    {
      "type": "binary",
      "name": "m2300w-wrapper"
    }
  ],
  "install_guidance": {
    "plugin": "m2300w-wrapper",
    "binary": "m2300w-wrapper",
    "check": "which m2300w-wrapper",
    "install_steps": [
      "apt-get install m2300w-wrapper 2>/dev/null || which m2300w-wrapper",
      "Verify: m2300w-wrapper --version",
      "supercli plugins install ./plugins/m2300w-wrapper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "m2300w-wrapper",
      "resource": "self",
      "action": "version",
      "description": "Print m2300w-wrapper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "m2300w-wrapper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install m2300w-wrapper: apt-get install m2300w-wrapper 2>/dev/null || which m2300w-wrapper"
      },
      "args": []
    },
    {
      "namespace": "m2300w-wrapper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to m2300w-wrapper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "m2300w-wrapper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install m2300w-wrapper: apt-get install m2300w-wrapper 2>/dev/null || which m2300w-wrapper"
      },
      "args": []
    }
  ]
}