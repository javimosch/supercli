{
  "name": "Hiro",
  "version": "0.1.0",
  "description": "MacOS Niri and Hyprland inspired tiling window manager that's developer signed and notorized (safe f",
  "source": "https://github.com/Hiro/Hiro",
  "checks": [
    {
      "type": "binary",
      "name": "hiro"
    }
  ],
  "install_guidance": {
    "plugin": "Hiro",
    "binary": "hiro",
    "check": "which hiro",
    "install_steps": [
      "pip install hiro",
      "Verify: hiro --version",
      "supercli plugins install ./plugins/Hiro --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Hiro",
      "resource": "self",
      "action": "version",
      "description": "Print Hiro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hiro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Hiro: pip install hiro"
      },
      "args": []
    },
    {
      "namespace": "Hiro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hiro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hiro",
        "passthrough": true,
        "missingDependencyHelp": "Install Hiro: pip install hiro"
      },
      "args": []
    }
  ]
}