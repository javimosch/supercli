{
  "name": "VibeOS",
  "version": "0.1.0",
  "description": "A completely vibecoded operating system targeting Aarch64",
  "source": "https://github.com/VibeOS/VibeOS",
  "checks": [
    {
      "type": "binary",
      "name": "vibeos"
    }
  ],
  "install_guidance": {
    "plugin": "VibeOS",
    "binary": "vibeos",
    "check": "which vibeos",
    "install_steps": [
      "pip install vibeos",
      "Verify: vibeos --version",
      "supercli plugins install ./plugins/VibeOS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VibeOS",
      "resource": "self",
      "action": "version",
      "description": "Print VibeOS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibeos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VibeOS: pip install vibeos"
      },
      "args": []
    },
    {
      "namespace": "VibeOS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vibeos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibeos",
        "passthrough": true,
        "missingDependencyHelp": "Install VibeOS: pip install vibeos"
      },
      "args": []
    }
  ]
}