{
  "name": "hopscotch-map",
  "version": "0.1.0",
  "description": "C++ implementation of a fast hash map and hash set using hopscotch hashing",
  "source": "https://github.com/Tessil/hopscotch-map",
  "checks": [
    {
      "type": "binary",
      "name": "hopscotch-map"
    }
  ],
  "install_guidance": {
    "plugin": "hopscotch-map",
    "binary": "hopscotch-map",
    "check": "which hopscotch-map",
    "install_steps": [
      "brew install hopscotch-map",
      "Verify: hopscotch-map --version",
      "supercli plugins install ./plugins/hopscotch-map --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hopscotch-map",
      "resource": "self",
      "action": "version",
      "description": "Print hopscotch-map version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hopscotch-map",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hopscotch-map: brew install hopscotch-map"
      },
      "args": []
    },
    {
      "namespace": "hopscotch-map",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hopscotch-map CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hopscotch-map",
        "passthrough": true,
        "missingDependencyHelp": "Install hopscotch-map"
      },
      "args": []
    }
  ]
}