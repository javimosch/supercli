{
  "name": "hashcat",
  "version": "0.1.0",
  "description": "Advanced password recovery tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "hashcat"}],
  "install_guidance": {
    "plugin": "hashcat",
    "binary": "hashcat",
    "check": "which hashcat",
    "install_steps": [
      "brew install hashcat",
      "Verify: hashcat --version",
      "supercli plugins install ./plugins/hashcat --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "hashcat",
      "resource": "self",
      "action": "version",
      "description": "Print hashcat version",
      "adapter": "process",
      "adapterConfig": {"command": "hashcat", "baseArgs": ["--version"], "missingDependencyHelp": "Install hashcat: brew install hashcat"},
      "args": []
    },
    {
      "namespace": "hashcat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hashcat CLI",
      "adapter": "process",
      "adapterConfig": {"command": "hashcat", "passthrough": true, "missingDependencyHelp": "Install hashcat: brew install hashcat"},
      "args": []
    }
  ]
}
