{
  "name": "uTag",
  "version": "0.1.0",
  "description": "Use Samsung Galaxy SmartTags on any Android device",
  "source": "https://github.com/uTag/uTag",
  "checks": [
    {
      "type": "binary",
      "name": "utag"
    }
  ],
  "install_guidance": {
    "plugin": "uTag",
    "binary": "utag",
    "check": "which utag",
    "install_steps": [
      "pip install utag",
      "Verify: utag --version",
      "supercli plugins install ./plugins/uTag --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uTag",
      "resource": "self",
      "action": "version",
      "description": "Print uTag version",
      "adapter": "process",
      "adapterConfig": {
        "command": "utag",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uTag: pip install utag"
      },
      "args": []
    },
    {
      "namespace": "uTag",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to utag CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "utag",
        "passthrough": true,
        "missingDependencyHelp": "Install uTag: pip install utag"
      },
      "args": []
    }
  ]
}