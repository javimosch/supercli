{
  "name": "lvdisplay",
  "version": "0.1.0",
  "description": "Display logical volume details",
  "source": "https://packages.debian.org/lvdisplay",
  "checks": [{ "type": "binary", "name": "lvdisplay" }],
  "install_guidance": {
    "plugin": "lvdisplay", "binary": "lvdisplay", "check": "which lvdisplay",
    "install_steps": ["apt-get install lvm2", "Verify: lvdisplay --version", "supercli plugins install ./plugins/lvdisplay --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lvdisplay", "resource": "_", "action": "_",
    "description": "Passthrough to lvdisplay CLI",
    "adapter": "process", "adapterConfig": { "command": "lvdisplay", "passthrough": true, "missingDependencyHelp": "Install lvdisplay: apt-get install lvm2" }, "args": []
  }]
}
