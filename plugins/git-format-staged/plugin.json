{
  "name": "git-format-staged",
  "version": "0.1.0",
  "description": "Git command to transform staged files using a formatting command",
  "source": "https://github.com/hallettj/git-format-staged",
  "checks": [
    {
      "type": "binary",
      "name": "git-format-staged"
    }
  ],
  "install_guidance": {
    "plugin": "git-format-staged",
    "binary": "git-format-staged",
    "check": "which git-format-staged",
    "install_steps": [
      "brew install git-format-staged",
      "Verify: git-format-staged --version",
      "supercli plugins install ./plugins/git-format-staged --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-format-staged",
      "resource": "self",
      "action": "version",
      "description": "Print git-format-staged version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-format-staged",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-format-staged: brew install git-format-staged"
      },
      "args": []
    },
    {
      "namespace": "git-format-staged",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-format-staged CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-format-staged",
        "passthrough": true,
        "missingDependencyHelp": "Install git-format-staged"
      },
      "args": []
    }
  ]
}