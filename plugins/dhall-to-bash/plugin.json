{
  "name": "dhall-to-bash",
  "version": "0.1.0",
  "description": "CLI tool: dhall-to-bash",
  "source": "https://packages.debian.org/dhall-to-bash",
  "checks": [{ "type": "binary", "name": "dhall-to-bash" }],
  "install_guidance": {
    "plugin": "dhall-to-bash", "binary": "dhall-to-bash", "check": "which dhall-to-bash",
    "install_steps": ["apt-get install dhall-to-bash 2>/dev/null || which dhall-to-bash", "Verify: dhall-to-bash --version", "supercli plugins install ./plugins/dhall-to-bash --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-to-bash", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-to-bash CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-to-bash", "passthrough": true, "missingDependencyHelp": "Install dhall-to-bash: apt-get install dhall-to-bash" }, "args": []
  }]
}
