{
  "name": "svg2sixel",
  "version": "0.1.0",
  "description": "Render SVG images as SIXEL graphics in terminals",
  "source": "https://github.com/saitoha/svg2sixel",
  "checks": [{ "type": "binary", "name": "svg2sixel" }],
  "install_guidance": {
    "plugin": "svg2sixel",
    "binary": "svg2sixel",
    "check": "which svg2sixel",
    "install_steps": ["brew install svg2sixel", "Verify: svg2sixel --version", "supercli plugins install ./plugins/svg2sixel --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "svg2sixel",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to svg2sixel CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "svg2sixel",
      "passthrough": true,
      "missingDependencyHelp": "Install svg2sixel: brew install svg2sixel", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
