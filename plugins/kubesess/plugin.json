{
  "name": "kubesess",
  "version": "0.1.0",
  "description": "Manage multiple kubernetes cluster at the same time",
  "source": "https://github.com/Ramilito/kubesess",
  "checks": [
    {
      "type": "binary",
      "name": "kubesess"
    }
  ],
  "install_guidance": {
    "plugin": "kubesess",
    "binary": "kubesess",
    "check": "which kubesess",
    "install_steps": [
      "brew install kubesess",
      "Verify: kubesess --version",
      "supercli plugins install ./plugins/kubesess --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kubesess",
      "resource": "self",
      "action": "version",
      "description": "Print kubesess version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubesess",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kubesess: brew install kubesess"
      },
      "args": []
    },
    {
      "namespace": "kubesess",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kubesess CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubesess",
        "passthrough": true,
        "missingDependencyHelp": "Install kubesess"
      },
      "args": []
    }
  ]
}