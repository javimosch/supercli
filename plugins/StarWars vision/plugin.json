{
  "name": "StarWars vision",
  "version": "0.1.0",
  "description": "See Star Wars in ASCII with ``telnet towel.blinkenlights.nl`` (server seems down recently - I leave the link in the hope that it will be resumed in the future).",
  "checks": [
    {
      "type": "binary",
      "name": "StarWars vision"
    }
  ],
  "install_guidance": {
    "plugin": "StarWars vision",
    "binary": "StarWars vision",
    "check": "which StarWars vision",
    "install_steps": [
      "See undefined",
      "Verify: StarWars vision --version",
      "supercli plugins install ./plugins/StarWars vision --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "StarWars vision",
      "resource": "self",
      "action": "version",
      "description": "Print StarWars vision version",
      "adapter": "process",
      "adapterConfig": {
        "command": "StarWars vision",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install StarWars vision: See undefined"
      },
      "args": []
    },
    {
      "namespace": "StarWars vision",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to StarWars vision CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "StarWars vision",
        "passthrough": true,
        "missingDependencyHelp": "Install StarWars vision"
      },
      "args": []
    }
  ]
}