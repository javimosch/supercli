{
  "name": "free-llm-api-resources",
  "version": "0.1.0",
  "description": "A list of free LLM inference resources accessible via API.",
  "source": "https://github.com/free-llm-api-resources/free-llm-api-resources",
  "checks": [
    {
      "type": "binary",
      "name": "free-llm-api-resources"
    }
  ],
  "install_guidance": {
    "plugin": "free-llm-api-resources",
    "binary": "free-llm-api-resources",
    "check": "which free-llm-api-resources",
    "install_steps": [
      "pip install free-llm-api-resources",
      "Verify: free-llm-api-resources --version",
      "supercli plugins install ./plugins/free-llm-api-resources --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "free-llm-api-resources",
      "resource": "self",
      "action": "version",
      "description": "Print free-llm-api-resources version",
      "adapter": "process",
      "adapterConfig": {
        "command": "free-llm-api-resources",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install free-llm-api-resources: pip install free-llm-api-resources"
      },
      "args": []
    },
    {
      "namespace": "free-llm-api-resources",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to free-llm-api-resources CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "free-llm-api-resources",
        "passthrough": true,
        "missingDependencyHelp": "Install free-llm-api-resources: pip install free-llm-api-resources"
      },
      "args": []
    }
  ]
}