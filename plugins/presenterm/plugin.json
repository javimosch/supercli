{
  "name": "presenterm",
  "version": "0.1.0",
  "description": "Markdown terminal slideshow tool",
  "source": "https://github.com/mfontanini/presenterm",
  "checks": [
    {
      "type": "binary",
      "name": "presenterm"
    }
  ],
  "install_guidance": {
    "plugin": "presenterm",
    "binary": "presenterm",
    "check": "which presenterm",
    "install_steps": [
      "cargo install presenterm",
      "Verify: presenterm --version",
      "supercli plugins install ./plugins/presenterm --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "presenterm",
      "resource": "self",
      "action": "version",
      "description": "Print presenterm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "presenterm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install presenterm: cargo install presenterm"
      },
      "args": []
    },
    {
      "namespace": "presenterm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to presenterm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "presenterm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install presenterm: cargo install presenterm"
      },
      "args": []
    }
  ]
}
