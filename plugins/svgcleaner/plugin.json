{
  "name": "svgcleaner",
  "version": "0.1.0",
  "description": "SVG optimization and cleaning tool",
  "source": "https://github.com/RazrFalcon/svgcleaner",
  "checks": [
    {
      "type": "binary",
      "name": "svgcleaner"
    }
  ],
  "install_guidance": {
    "plugin": "svgcleaner",
    "binary": "svgcleaner",
    "check": "which svgcleaner",
    "install_steps": [
      "cargo install svgcleaner",
      "Verify: svgcleaner --version",
      "supercli plugins install ./plugins/svgcleaner --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "svgcleaner",
      "resource": "self",
      "action": "version",
      "description": "Print svgcleaner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "svgcleaner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install svgcleaner: cargo install svgcleaner"
      },
      "args": []
    },
    {
      "namespace": "svgcleaner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to svgcleaner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "svgcleaner",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install svgcleaner: cargo install svgcleaner"
      },
      "args": []
    }
  ]
}
