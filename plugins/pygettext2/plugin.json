{
  "name": "pygettext2",
  "version": "0.1.0",
  "description": "CLI tool: pygettext2",
  "source": "https://manpages.debian.org/pygettext2",
  "checks": [
    {
      "type": "binary",
      "name": "pygettext2"
    }
  ],
  "install_guidance": {
    "plugin": "pygettext2",
    "binary": "pygettext2",
    "check": "which pygettext2",
    "install_steps": [
      "apt-get install pygettext2 2>/dev/null || which pygettext2",
      "Verify: pygettext2 --version",
      "supercli plugins install ./plugins/pygettext2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pygettext2",
      "resource": "self",
      "action": "version",
      "description": "Print pygettext2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pygettext2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pygettext2: apt-get install pygettext2 2>/dev/null || which pygettext2"
      },
      "args": []
    },
    {
      "namespace": "pygettext2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pygettext2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pygettext2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pygettext2: apt-get install pygettext2 2>/dev/null || which pygettext2"
      },
      "args": []
    }
  ]
}