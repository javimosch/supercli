{
  "name": "maven",
  "version": "0.1.0",
  "description": "Java-based project management",
  "checks": [
    {
      "type": "binary",
      "name": "maven"
    }
  ],
  "install_guidance": {
    "plugin": "maven",
    "binary": "maven",
    "check": "which maven",
    "install_steps": [
      "brew install maven",
      "Verify: maven --version",
      "supercli plugins install ./plugins/maven --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "maven",
      "resource": "self",
      "action": "version",
      "description": "Print maven version",
      "adapter": "process",
      "adapterConfig": {
        "command": "maven",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install maven: brew install maven"
      },
      "args": []
    },
    {
      "namespace": "maven",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to maven CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "maven",
        "passthrough": true,
        "missingDependencyHelp": "Install maven"
      },
      "args": []
    }
  ]
}