{
  "name": "uvx",
  "version": "0.1.0",
  "description": "uvx — UV package runner for executing Python tools without installation",
  "source": "https://docs.astral.sh/uv/guides/tools/",
  "checks": [
    {
      "type": "binary",
      "name": "uvx"
    }
  ],
  "install_guidance": {
    "plugin": "uvx",
    "binary": "uvx",
    "check": "which uvx",
    "install_steps": [
      "curl -LsSf https://astral.sh/uv/install.sh | sh",
      "Verify: uvx --version",
      "supercli plugins install ./plugins/uvx --on-conflict replace --json"
    ],
    "note": "Development tool."
  },
  "commands": [
    {
      "namespace": "uvx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uvx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uvx",
        "passthrough": true,
        "missingDependencyHelp": "Install uvx: curl -LsSf https://astral.sh/uv/install.sh | sh"
      },
      "args": []
    }
  ]
}
