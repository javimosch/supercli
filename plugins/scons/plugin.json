{
  "name": "scons",
  "version": "0.1.0",
  "description": "Software construction tool.",
  "source": "https://github.com/SCons/scons",
  "checks": [
    {
      "type": "binary",
      "name": "scons"
    }
  ],
  "install_guidance": {
    "plugin": "scons",
    "binary": "scons",
    "check": "which scons",
    "install_steps": [
      "brew install scons",
      "Verify: scons --version",
      "supercli plugins install ./plugins/scons --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "scons",
      "resource": "self",
      "action": "version",
      "description": "Print scons version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scons",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scons: brew install scons"
      },
      "args": []
    },
    {
      "namespace": "scons",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scons CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scons",
        "passthrough": true,
        "missingDependencyHelp": "Install scons"
      },
      "args": []
    }
  ]
}