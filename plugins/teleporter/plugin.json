{
  "name": "teleporter",
  "version": "0.1.0",
  "description": "Delta-based secure file transfer utility in Rust",
  "source": "https://github.com/genonullfree/teleporter",
  "checks": [{ "type": "binary", "name": "teleporter" }],
  "install_guidance": {
    "plugin": "teleporter",
    "binary": "teleporter",
    "check": "which teleporter",
    "install_steps": ["cargo install teleporter", "Verify: teleporter --version", "supercli plugins install ./plugins/teleporter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "teleporter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to teleporter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "teleporter",
      "passthrough": true,
      "missingDependencyHelp": "Install teleporter: cargo install teleporter", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
