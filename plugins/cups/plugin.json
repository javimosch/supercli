{
  "name": "cups",
  "version": "0.1.0",
  "description": "CLI tool: cups",
  "source": "https://packages.debian.org/cups",
  "checks": [{ "type": "binary", "name": "cups" }],
  "install_guidance": {
    "plugin": "cups", "binary": "cups", "check": "which cups",
    "install_steps": ["apt-get install cups 2>/dev/null || which cups", "Verify: cups --version", "supercli plugins install ./plugins/cups --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cups", "resource": "_", "action": "_",
    "description": "Passthrough to cups CLI",
    "adapter": "process", "adapterConfig": { "command": "cups", "passthrough": true, "missingDependencyHelp": "Install cups: apt-get install cups" }, "args": []
  }]
}
