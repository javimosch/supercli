{
  "name": "h-m-m",
  "version": "0.1.0",
  "description": "Simple fast keyboard-centric terminal mind map tool — file-based, non-interactive mode",
  "source": "https://github.com/nadrad/h-m-m",
  "checks": [
    {
      "type": "binary",
      "name": "h-m-m"
    }
  ],
  "install_guidance": {
    "plugin": "h-m-m",
    "binary": "h-m-m",
    "check": "which h-m-m",
    "install_steps": [
      "npm install -g h-m-m",
      "Verify: h-m-m --version",
      "supercli plugins install ./plugins/h-m-m --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "h-m-m",
      "resource": "self",
      "action": "version",
      "description": "Print h-m-m version",
      "adapter": "process",
      "adapterConfig": {
        "command": "h-m-m",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install h-m-m: npm install -g h-m-m"
      },
      "args": []
    },
    {
      "namespace": "h-m-m",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to h-m-m CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "h-m-m",
        "passthrough": true,
        "missingDependencyHelp": "Install h-m-m: npm install -g h-m-m"
      },
      "args": []
    }
  ]
}
