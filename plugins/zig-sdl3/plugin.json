{
  "name": "zig-sdl3",
  "version": "0.1.0",
  "description": "Zig wrapper for SDL3.",
  "source": "https://github.com/zig-sdl3/zig-sdl3",
  "checks": [
    {
      "type": "binary",
      "name": "zig-sdl3"
    }
  ],
  "install_guidance": {
    "plugin": "zig-sdl3",
    "binary": "zig-sdl3",
    "check": "which zig-sdl3",
    "install_steps": [
      "pip install zig-sdl3",
      "Verify: zig-sdl3 --version",
      "supercli plugins install ./plugins/zig-sdl3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig-sdl3",
      "resource": "self",
      "action": "version",
      "description": "Print zig-sdl3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-sdl3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig-sdl3: pip install zig-sdl3"
      },
      "args": []
    },
    {
      "namespace": "zig-sdl3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig-sdl3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-sdl3",
        "passthrough": true,
        "missingDependencyHelp": "Install zig-sdl3: pip install zig-sdl3"
      },
      "args": []
    }
  ]
}