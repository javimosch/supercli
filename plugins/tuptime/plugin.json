{
  "name": "tuptime",
  "version": "0.1.0",
  "description": "tuptime \u2014 report historical and statistical system uptime.",
  "source": "https://github.com/rfrail3/tuptime",
  "checks": [
    {
      "type": "binary",
      "name": "tuptime"
    }
  ],
  "install_guidance": {
    "plugin": "tuptime",
    "binary": "tuptime",
    "check": "which tuptime",
    "install_steps": [
      "sudo apt-get install tuptime",
      "supercli plugins install ./plugins/tuptime --on-conflict replace --json"
    ],
    "note": "Python/PyPI. System uptime reporting."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tuptime",
      "resource": "report",
      "action": "show",
      "description": "Show system uptime history",
      "adapter": "process",
      "adapterConfig": {
        "command": "tuptime",
        "missingDependencyHelp": "Install tuptime",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "tuptime",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tuptime",
        "missingDependencyHelp": "Install tuptime",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
