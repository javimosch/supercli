{
  "name": "brotli",
  "version": "0.1.0",
  "description": "Brotli compression utility",
  "source": "https",
  "checks": [{"type": "binary", "name": "brotli"}],
  "install_guidance": {
    "plugin": "brotli",
    "binary": "brotli",
    "check": "which brotli",
    "install_steps": [
      "brew install brotli",
      "Verify: brotli --version",
      "supercli plugins install ./plugins/brotli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "brotli",
      "resource": "self",
      "action": "version",
      "description": "Print brotli version",
      "adapter": "process",
      "adapterConfig": {"command": "brotli", "baseArgs": ["--version"], "missingDependencyHelp": "Install brotli: brew install brotli"},
      "args": []
    },
    {
      "namespace": "brotli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to brotli CLI",
      "adapter": "process",
      "adapterConfig": {"command": "brotli", "passthrough": true, "missingDependencyHelp": "Install brotli: brew install brotli"},
      "args": []
    }
  ]
}
