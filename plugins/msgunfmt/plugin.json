{
  "name": "msgunfmt",
  "version": "0.1.0",
  "description": "CLI tool: msgunfmt",
  "source": "https://manpages.debian.org/msgunfmt",
  "checks": [
    {
      "type": "binary",
      "name": "msgunfmt"
    }
  ],
  "install_guidance": {
    "plugin": "msgunfmt",
    "binary": "msgunfmt",
    "check": "which msgunfmt",
    "install_steps": [
      "apt-get install msgunfmt 2>/dev/null || which msgunfmt",
      "Verify: msgunfmt --version",
      "supercli plugins install ./plugins/msgunfmt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "msgunfmt",
      "resource": "self",
      "action": "version",
      "description": "Print msgunfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "msgunfmt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install msgunfmt: apt-get install msgunfmt 2>/dev/null || which msgunfmt"
      },
      "args": []
    },
    {
      "namespace": "msgunfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to msgunfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "msgunfmt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install msgunfmt: apt-get install msgunfmt 2>/dev/null || which msgunfmt"
      },
      "args": []
    }
  ]
}