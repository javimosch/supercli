{
  "name": "py3rsa-keygen",
  "version": "0.1.0",
  "description": "CLI tool: py3rsa-keygen",
  "source": "https://manpages.debian.org/py3rsa-keygen",
  "checks": [
    {
      "type": "binary",
      "name": "py3rsa-keygen"
    }
  ],
  "install_guidance": {
    "plugin": "py3rsa-keygen",
    "binary": "py3rsa-keygen",
    "check": "which py3rsa-keygen",
    "install_steps": [
      "apt-get install py3rsa-keygen 2>/dev/null || which py3rsa-keygen",
      "Verify: py3rsa-keygen --version",
      "supercli plugins install ./plugins/py3rsa-keygen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "py3rsa-keygen",
      "resource": "self",
      "action": "version",
      "description": "Print py3rsa-keygen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "py3rsa-keygen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install py3rsa-keygen: apt-get install py3rsa-keygen 2>/dev/null || which py3rsa-keygen"
      },
      "args": []
    },
    {
      "namespace": "py3rsa-keygen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to py3rsa-keygen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "py3rsa-keygen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install py3rsa-keygen: apt-get install py3rsa-keygen 2>/dev/null || which py3rsa-keygen"
      },
      "args": []
    }
  ]
}