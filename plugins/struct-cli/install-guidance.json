{
  "plugin": "struct-cli",
  "binary": "struct-cli",
  "check": "which struct-cli",
  "install_steps": [
    "cargo install struct-cli",
    "Verify: struct-cli --version",
    "supercli plugins install ./plugins/struct-cli --on-conflict replace --json"
  ],
  "note": "Requires Rust toolchain (cargo)"
}
