{
  "name": "struct-cli",
  "version": "0.1.0",
  "description": "Smarter tree command",
  "source": "https://github.com/struct-cli/struct-cli",
  "checks": [
    {
      "type": "binary",
      "name": "struct-cli"
    }
  ],
  "install_guidance": {
    "plugin": "struct-cli",
    "binary": "struct-cli",
    "check": "which struct-cli",
    "install_steps": [
      "cargo install struct-cli",
      "Verify: struct-cli --version",
      "supercli plugins install ./plugins/struct-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "struct-cli",
      "resource": "self",
      "action": "version",
      "description": "Print struct-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "struct-cli",
        "missingDependencyHelp": "Install struct-cli: cargo install struct-cli",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "struct-cli",
      "resource": "tree",
      "action": "show",
      "description": "Show directory tree structure",
      "adapter": "process",
      "adapterConfig": {
        "command": "struct-cli",
        "missingDependencyHelp": "Install struct-cli: cargo install struct-cli",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "struct-cli",
      "resource": "tree",
      "action": "stats",
      "description": "Show directory statistics",
      "adapter": "process",
      "adapterConfig": {
        "command": "struct-cli",
        "missingDependencyHelp": "Install struct-cli: cargo install struct-cli",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "struct-cli",
      "resource": "_",
      "action": "_",
      "description": "_ _ via struct-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "struct-cli",
        "missingDependencyHelp": "Install struct-cli: cargo install struct-cli",
        "passthrough": true,
        "cwd": "invoke_cwd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
