{
  "name": "devops-tools",
  "version": "0.1.0",
  "description": "Collection of 80+ DevOps CLI tools for cloud, containers, and infrastructure",
  "source": "https://github.com/nicm/DevOps-Python-tools",
  "checks": [
    {
      "type": "binary",
      "name": "devops-tools"
    }
  ],
  "install_guidance": {
    "plugin": "devops-tools",
    "binary": "devops-tools",
    "check": "which devops-tools",
    "install_steps": [
      "pip install devops-python-tools",
      "Verify: devops-tools --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "devops-tools",
      "resource": "self",
      "action": "version",
      "description": "Print devops-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "devops-tools",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install devops-tools: pip install devops-python-tools"
      },
      "args": []
    },
    {
      "namespace": "devops-tools",
      "resource": "tool",
      "action": "run",
      "description": "Run a specific DevOps tool from the collection",
      "adapter": "process",
      "adapterConfig": {
        "command": "devops-tools",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install devops-tools: pip install devops-python-tools"
      },
      "args": []
    },
    {
      "namespace": "devops-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to devops-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "devops-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install devops-tools: pip install devops-python-tools"
      },
      "args": []
    }
  ]
}