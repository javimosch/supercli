{
  "name": "mytimer",
  "version": "0.1.0",
  "description": "Geeky timer for terminal enthusiasts in Python",
  "source": "https://github.com/nicedoc/mytimer",
  "checks": [
    {
      "type": "binary",
      "name": "mytimer"
    }
  ],
  "install_guidance": {
    "plugin": "mytimer",
    "binary": "mytimer",
    "check": "which mytimer",
    "install_steps": [
      "pip install mytimer",
      "Verify: mytimer --version",
      "supercli plugins install ./plugins/mytimer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mytimer",
      "resource": "self",
      "action": "version",
      "description": "Print mytimer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mytimer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mytimer: pip install mytimer"
      },
      "args": []
    },
    {
      "namespace": "mytimer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mytimer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mytimer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mytimer: pip install mytimer"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
