{
  "name": "organize-cli",
  "version": "0.1.0",
  "description": "Organize your files automatically",
  "source": "https://github.com/ManrajGrover/organize-cli",
  "checks": [
    {
      "type": "binary",
      "name": "organize-cli"
    }
  ],
  "install_guidance": {
    "plugin": "organize-cli",
    "binary": "organize-cli",
    "check": "which organize-cli",
    "install_steps": [
      "See https://github.com/ManrajGrover/organize-cli",
      "Verify: organize-cli --version",
      "supercli plugins install ./plugins/organize-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "organize-cli",
      "resource": "self",
      "action": "version",
      "description": "Print organize-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "organize-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install organize-cli: See https://github.com/ManrajGrover/organize-cli"
      },
      "args": []
    },
    {
      "namespace": "organize-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to organize-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "organize-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install organize-cli"
      },
      "args": []
    }
  ]
}