{
  "name": "newsgoat",
  "version": "0.1.0",
  "description": "TUI RSS reader in Go with vi-like keybindings",
  "source": "https://github.com/jarv/newsgoat",
  "checks": [{ "type": "binary", "name": "newsgoat" }],
  "install_guidance": {
    "plugin": "newsgoat",
    "binary": "newsgoat",
    "check": "which newsgoat",
    "install_steps": ["curl/bash install", "Verify: newsgoat --version", "supercli plugins install ./plugins/newsgoat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "newsgoat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to newsgoat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "newsgoat",
      "passthrough": true,
      "missingDependencyHelp": "Install newsgoat: curl/bash install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
