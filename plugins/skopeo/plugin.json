{
  "name": "skopeo",
  "version": "0.1.0",
  "description": "Work with remote container images and registries",
  "source": "https://github.com/containers/skopeo",
  "checks": [{ "type": "binary", "name": "skopeo" }],
  "install_guidance": {
    "plugin": "skopeo",
    "binary": "skopeo",
    "check": "which skopeo",
    "install_steps": ["brew install skopeo", "Verify: skopeo --version", "supercli plugins install ./plugins/skopeo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "skopeo",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to skopeo CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "skopeo",
      "passthrough": true,
      "missingDependencyHelp": "Install skopeo: brew install skopeo"
    },
    "args": []
  }]
}
