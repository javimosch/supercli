{
  "name": "gnomon",
  "version": "0.1.0",
  "description": "Prefix command output with timestamp information for profiling",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "gnomon" }],
  "install_guidance": {
    "plugin": "gnomon",
    "binary": "gnomon",
    "check": "which gnomon",
    "install_steps": ["npm install -g gnomon", "Verify: gnomon --version", "supercli plugins install ./plugins/gnomon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gnomon",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gnomon CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gnomon",
      "passthrough": true,
      "missingDependencyHelp": "Install gnomon: npm install -g gnomon"
    },
    "args": []
  }]
}
