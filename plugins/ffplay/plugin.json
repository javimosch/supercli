{
  "name": "ffplay",
  "version": "0.1.0",
  "description": "FFmpeg media player",
  "source": "https://packages.debian.org/ffplay",
  "checks": [{ "type": "binary", "name": "ffplay" }],
  "install_guidance": {
    "plugin": "ffplay", "binary": "ffplay", "check": "which ffplay",
    "install_steps": ["apt-get install ffmpeg", "Verify: ffplay --version", "supercli plugins install ./plugins/ffplay --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ffplay", "resource": "_", "action": "_",
    "description": "Passthrough to ffplay CLI",
    "adapter": "process", "adapterConfig": { "command": "ffplay", "passthrough": true, "missingDependencyHelp": "Install ffplay: apt-get install ffmpeg" }, "args": []
  }]
}
