{
  "name": "jar-skills",
  "version": "1.1.0",
  "author": "Javier Arancibia",
  "description": "Token Optimization Quad: rtk + context-mode + memory + graphify for efficient codebase analysis and knowledge management",
  "source": "https://github.com/javimosch/supercli",
  "type": "skills",
  "skills": [
    "rtk-context-memory-graph"
  ],
  "learn": {
    "file": "SKILL.md"
  },
  "commands": [
    {
      "namespace": "jar-skills",
      "resource": "self",
      "action": "install",
      "description": "Install the rtk-context-memory-graph skill bundle",
      "adapter": "shell",
      "adapterConfig": {
        "script": "bash \"$SUPERCLI_PLUGIN_DIR/install.sh\"",
        "unsafe": true,
        "parseJson": false,
        "timeout_ms": 60000
      },
      "args": []
    },
    {
      "namespace": "jar-skills",
      "resource": "self",
      "action": "uninstall",
      "description": "Uninstall the rtk-context-memory-graph skill bundle",
      "adapter": "shell",
      "adapterConfig": {
        "script": "bash \"$SUPERCLI_PLUGIN_DIR/uninstall.sh\"",
        "unsafe": true,
        "parseJson": false,
        "timeout_ms": 60000
      },
      "args": []
    }
  ],
  "files": [
    "SKILL.md",
    "AGENTS.md.template",
    "install.sh",
    "uninstall.sh",
    "README.md"
  ],
  "requirements": {
    "supercli": ">=1.0.0"
  }
}
