{
  "name": "jar-skills",
  "version": "1.1.0",
  "author": "Javier Arancibia",
  "description": "Token Optimization Quad: rtk + context-mode + memory + graphify for efficient codebase analysis and knowledge management",
  "type": "skills",
  "skills": [
    "rtk-context-memory-graph"
  ],
  "files": [
    "SKILL.md",
    "AGENTS.md.template",
    "install.sh",
    "uninstall.sh",
    "README.md"
  ],
  "requirements": {
    "supercli": ">=1.0.0"
  },
  "learn": {
    "file": "SKILL.md"
  },
  "install_guidance": {
    "plugin": "jar-skills",
    "binary": "jar-skills",
    "check": "which jar-skills || ls $HOME/.agents/skills/rtk-context-memory-graph/SKILL.md",
    "install_steps": [
      "cd plugins/jar-skills && ./install.sh --global",
      "Or for local project: cd plugins/jar-skills && ./install.sh --local --project /path/to/project"
    ],
    "note": "Installs rtk-context-memory-graph skill. Use --force to overwrite local modifications."
  },
  "commands": [
    {
      "namespace": "jar-skills",
      "resource": "self",
      "action": "install",
      "description": "Install rtk-context-memory-graph skill (install.sh)",
      "adapter": "shell",
      "adapterConfig": {
        "script": "./install.sh --global",
        "unsafe": true,
        "cwd": "plugin_dir"
      },
      "args": []
    },
    {
      "namespace": "jar-skills",
      "resource": "self",
      "action": "uninstall",
      "description": "Uninstall rtk-context-memory-graph skill (uninstall.sh)",
      "adapter": "shell",
      "adapterConfig": {
        "script": "./uninstall.sh",
        "unsafe": true,
        "cwd": "plugin_dir"
      },
      "args": []
    }
  ]
}
