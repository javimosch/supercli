{
  "name": "copilot-sdk",
  "version": "0.1.0",
  "description": "Multi-platform SDK for integrating GitHub Copilot Agent into apps and services",
  "source": "https://github.com/copilot-sdk/copilot-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "copilot-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "copilot-sdk",
    "binary": "copilot-sdk",
    "check": "which copilot-sdk",
    "install_steps": [
      "pip install copilot-sdk",
      "Verify: copilot-sdk --version",
      "supercli plugins install ./plugins/copilot-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "copilot-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print copilot-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "copilot-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install copilot-sdk: pip install copilot-sdk"
      },
      "args": []
    },
    {
      "namespace": "copilot-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to copilot-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "copilot-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install copilot-sdk: pip install copilot-sdk"
      },
      "args": []
    }
  ]
}