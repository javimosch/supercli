{
  "name": "mysqlshow",
  "version": "0.1.0",
  "description": "MySQL database/table display tool",
  "source": "https://packages.debian.org/mysqlshow",
  "checks": [{ "type": "binary", "name": "mysqlshow" }],
  "install_guidance": {
    "plugin": "mysqlshow", "binary": "mysqlshow", "check": "which mysqlshow",
    "install_steps": ["apt-get install mysql-client", "Verify: mysqlshow --version", "supercli plugins install ./plugins/mysqlshow --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mysqlshow", "resource": "_", "action": "_",
    "description": "Passthrough to mysqlshow CLI",
    "adapter": "process", "adapterConfig": { "command": "mysqlshow", "passthrough": true, "missingDependencyHelp": "Install mysqlshow: apt-get install mysql-client" }, "args": []
  }]
}
