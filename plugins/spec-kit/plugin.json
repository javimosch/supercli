{
  "name": "spec-kit",
  "version": "0.1.0",
  "description": "\ud83d\udcab Toolkit to help you get started with Spec-Driven Development",
  "source": "https://github.com/spec-kit/spec-kit",
  "checks": [
    {
      "type": "binary",
      "name": "spec-kit"
    }
  ],
  "install_guidance": {
    "plugin": "spec-kit",
    "binary": "spec-kit",
    "check": "which spec-kit",
    "install_steps": [
      "pip install spec-kit",
      "Verify: spec-kit --version",
      "supercli plugins install ./plugins/spec-kit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "spec-kit",
      "resource": "self",
      "action": "version",
      "description": "Print spec-kit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spec-kit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spec-kit: pip install spec-kit"
      },
      "args": []
    },
    {
      "namespace": "spec-kit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spec-kit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spec-kit",
        "passthrough": true,
        "missingDependencyHelp": "Install spec-kit: pip install spec-kit"
      },
      "args": []
    }
  ]
}