{
  "name": "awesome-openclaw-tutorial",
  "version": "0.1.0",
  "description": "\u4ece\u96f6\u5f00\u59cb\u73a9\u8f6cOpenClaw\uff1a\u6700\u5168\u9762\u7684\u4e2d\u6587\u6559\u7a0b\uff0c\u6db5\u76d6\u5b89\u88c5\u3001\u914d\u7f6e\u3001\u5b9e\u6218\u6848\u4f8b\u548c\u907f\u5751\u6307\u5357\uff08github\u7248\uff09",
  "source": "https://github.com/awesome-openclaw-tutorial/awesome-openclaw-tutorial",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-openclaw-tutorial"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-openclaw-tutorial",
    "binary": "awesome-openclaw-tutorial",
    "check": "which awesome-openclaw-tutorial",
    "install_steps": [
      "pip install awesome-openclaw-tutorial",
      "Verify: awesome-openclaw-tutorial --version",
      "supercli plugins install ./plugins/awesome-openclaw-tutorial --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-openclaw-tutorial",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-openclaw-tutorial version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-openclaw-tutorial",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-openclaw-tutorial: pip install awesome-openclaw-tutorial"
      },
      "args": []
    },
    {
      "namespace": "awesome-openclaw-tutorial",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-openclaw-tutorial CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-openclaw-tutorial",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-openclaw-tutorial: pip install awesome-openclaw-tutorial"
      },
      "args": []
    }
  ]
}