{
  "name": "pls",
  "version": "0.1.0",
  "description": "`ls` for the pros",
  "source": "https://github.com/pls-rs/pls",
  "checks": [
    {
      "type": "binary",
      "name": "pls"
    }
  ],
  "install_guidance": {
    "plugin": "pls",
    "binary": "pls",
    "check": "which pls",
    "install_steps": [
      "See https://github.com/pls-rs/pls",
      "Verify: pls --version",
      "supercli plugins install ./plugins/pls --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "pls",
      "resource": "self",
      "action": "version",
      "description": "Print pls version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pls",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pls: See https://github.com/pls-rs/pls"
      },
      "args": []
    },
    {
      "namespace": "pls",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pls CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pls",
        "passthrough": true,
        "missingDependencyHelp": "Install pls"
      },
      "args": []
    }
  ]
}