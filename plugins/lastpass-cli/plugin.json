{
  "name": "lastpass-cli",
  "version": "0.1.0",
  "description": "LastPass command-line interface tool",
  "source": "https://github.com/lastpass/lastpass-cli",
  "checks": [
    {
      "type": "binary",
      "name": "lastpass-cli"
    }
  ],
  "install_guidance": {
    "plugin": "lastpass-cli",
    "binary": "lastpass-cli",
    "check": "which lastpass-cli",
    "install_steps": [
      "brew install lastpass-cli",
      "Verify: lastpass-cli --version",
      "supercli plugins install ./plugins/lastpass-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lastpass-cli",
      "resource": "self",
      "action": "version",
      "description": "Print lastpass-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lastpass-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lastpass-cli: brew install lastpass-cli"
      },
      "args": []
    },
    {
      "namespace": "lastpass-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lastpass-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lastpass-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install lastpass-cli"
      },
      "args": []
    }
  ]
}