{
  "plugin": "thin_restore",
  "binary": "thin_restore",
  "check": "which thin_restore",
  "install_steps": [
    "apt-get install thin_restore 2>/dev/null || which thin_restore",
    "Verify: thin_restore --version",
    "supercli plugins install ./plugins/thin_restore --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}