{
  "name": "awesome-copilot",
  "version": "0.1.0",
  "description": "Community-contributed instructions, agents, skills, and configurations to help you make the most of ",
  "source": "https://github.com/awesome-copilot/awesome-copilot",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-copilot"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-copilot",
    "binary": "awesome-copilot",
    "check": "which awesome-copilot",
    "install_steps": [
      "pip install awesome-copilot",
      "Verify: awesome-copilot --version",
      "supercli plugins install ./plugins/awesome-copilot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-copilot",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-copilot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-copilot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-copilot: pip install awesome-copilot"
      },
      "args": []
    },
    {
      "namespace": "awesome-copilot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-copilot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-copilot",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-copilot: pip install awesome-copilot"
      },
      "args": []
    }
  ]
}