{
  "name": "termux-desktop",
  "version": "0.1.0",
  "description": "Install a full Linux desktop environment on your Android device with Termux X11 ( VNC optional) and ",
  "source": "https://github.com/termux-desktop/termux-desktop",
  "checks": [
    {
      "type": "binary",
      "name": "termux-desktop"
    }
  ],
  "install_guidance": {
    "plugin": "termux-desktop",
    "binary": "termux-desktop",
    "check": "which termux-desktop",
    "install_steps": [
      "pip install termux-desktop",
      "Verify: termux-desktop --version",
      "supercli plugins install ./plugins/termux-desktop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "termux-desktop",
      "resource": "self",
      "action": "version",
      "description": "Print termux-desktop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "termux-desktop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install termux-desktop: pip install termux-desktop"
      },
      "args": []
    },
    {
      "namespace": "termux-desktop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to termux-desktop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "termux-desktop",
        "passthrough": true,
        "missingDependencyHelp": "Install termux-desktop: pip install termux-desktop"
      },
      "args": []
    }
  ]
}