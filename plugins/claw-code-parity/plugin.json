{
  "name": "claw-code-parity",
  "version": "0.1.0",
  "description": "Join Discord: https://discord.gg/5TUQKqFWd /  claw-code Rust port parity work - it is temporary work",
  "source": "https://github.com/claw-code-parity/claw-code-parity",
  "checks": [
    {
      "type": "binary",
      "name": "claw-code-parity"
    }
  ],
  "install_guidance": {
    "plugin": "claw-code-parity",
    "binary": "claw-code-parity",
    "check": "which claw-code-parity",
    "install_steps": [
      "pip install claw-code-parity",
      "Verify: claw-code-parity --version",
      "supercli plugins install ./plugins/claw-code-parity --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claw-code-parity",
      "resource": "self",
      "action": "version",
      "description": "Print claw-code-parity version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claw-code-parity",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claw-code-parity: pip install claw-code-parity"
      },
      "args": []
    },
    {
      "namespace": "claw-code-parity",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claw-code-parity CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claw-code-parity",
        "passthrough": true,
        "missingDependencyHelp": "Install claw-code-parity: pip install claw-code-parity"
      },
      "args": []
    }
  ]
}