{
  "name": "goresym",
  "version": "0.1.0",
  "description": "Go symbol recovery tool",
  "source": "https://github.com/mandiant/GoReSym",
  "checks": [
    {
      "type": "binary",
      "name": "goresym"
    }
  ],
  "install_guidance": {
    "plugin": "goresym",
    "binary": "goresym",
    "check": "which goresym",
    "install_steps": [
      "brew install goresym",
      "Verify: goresym --version",
      "supercli plugins install ./plugins/goresym --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "goresym",
      "resource": "self",
      "action": "version",
      "description": "Print goresym version",
      "adapter": "process",
      "adapterConfig": {
        "command": "goresym",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install goresym: brew install goresym"
      },
      "args": []
    },
    {
      "namespace": "goresym",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to goresym CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "goresym",
        "passthrough": true,
        "missingDependencyHelp": "Install goresym"
      },
      "args": []
    }
  ]
}