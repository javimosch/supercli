{
  "name": "ghtoken",
  "version": "0.1.0",
  "description": "GitHub token manager CLI — generate, list, revoke tokens via GitHub API",
  "source": "https://github.com/nobe4/ghtoken",
  "checks": [
    {
      "type": "binary",
      "name": "ghtoken"
    }
  ],
  "install_guidance": {
    "plugin": "ghtoken",
    "binary": "ghtoken",
    "check": "which ghtoken",
    "install_steps": [
      "go install github.com/nobe4/ghtoken@latest",
      "Verify: ghtoken --version",
      "supercli plugins install ./plugins/ghtoken --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ghtoken",
      "resource": "self",
      "action": "version",
      "description": "Print ghtoken version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghtoken",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ghtoken: go install github.com/nobe4/ghtoken@latest"
      },
      "args": []
    },
    {
      "namespace": "ghtoken",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghtoken CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghtoken",
        "passthrough": true,
        "missingDependencyHelp": "Install ghtoken: go install github.com/nobe4/ghtoken@latest"
      },
      "args": []
    }
  ]
}
