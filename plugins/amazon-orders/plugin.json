{
  "name": "amazon-orders",
  "version": "0.1.0",
  "description": "Retrieve Amazon order history",
  "source": "https://github.com/alexdlaird/amazon-orders",
  "checks": [
    {
      "type": "binary",
      "name": "amazon-orders"
    }
  ],
  "install_guidance": {
    "plugin": "amazon-orders",
    "binary": "amazon-orders",
    "check": "which amazon-orders",
    "install_steps": [
      "See https://github.com/alexdlaird/amazon-orders",
      "Verify: amazon-orders --version",
      "supercli plugins install ./plugins/amazon-orders --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "amazon-orders",
      "resource": "self",
      "action": "version",
      "description": "Print amazon-orders version",
      "adapter": "process",
      "adapterConfig": {
        "command": "amazon-orders",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install amazon-orders: See https://github.com/alexdlaird/amazon-orders"
      },
      "args": []
    },
    {
      "namespace": "amazon-orders",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to amazon-orders CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "amazon-orders",
        "passthrough": true,
        "missingDependencyHelp": "Install amazon-orders"
      },
      "args": []
    }
  ]
}