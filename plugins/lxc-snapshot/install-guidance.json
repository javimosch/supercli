{
  "plugin": "lxc-snapshot",
  "binary": "lxc-snapshot",
  "check": "which lxc-snapshot",
  "install_steps": [
    "apt-get install lxc-snapshot 2>/dev/null || which lxc-snapshot",
    "Verify: lxc-snapshot --version",
    "supercli plugins install ./plugins/lxc-snapshot --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}