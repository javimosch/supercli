{
  "name": "p10k",
  "version": "0.1.0",
  "description": "Powerlevel10k configuration CLI — manage zsh theme settings with JSON export",
  "source": "https://github.com/romkatv/powerlevel10k",
  "checks": [
    {
      "type": "binary",
      "name": "p10k"
    }
  ],
  "install_guidance": {
    "plugin": "p10k",
    "binary": "p10k",
    "check": "which p10k",
    "install_steps": [
      "git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k",
      "Verify: p10k --version",
      "supercli plugins install ./plugins/p10k --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "p10k",
      "resource": "self",
      "action": "version",
      "description": "Print p10k version",
      "adapter": "process",
      "adapterConfig": {
        "command": "p10k",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install p10k: git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k"
      },
      "args": []
    },
    {
      "namespace": "p10k",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to p10k CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "p10k",
        "passthrough": true,
        "missingDependencyHelp": "Install p10k: git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k"
      },
      "args": []
    }
  ]
}
