{
  "name": "jp2a",
  "version": "0.1.0",
  "description": "Convert JPEG images to ASCII art in the terminal",
  "source": "https://github.com/Talinx/jp2a",
  "checks": [{ "type": "binary", "name": "jp2a" }],
  "install_guidance": {
    "plugin": "jp2a",
    "binary": "jp2a",
    "check": "which jp2a",
    "install_steps": ["brew install jp2a", "Verify: jp2a --version", "supercli plugins install ./plugins/jp2a --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jp2a",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jp2a CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jp2a",
      "passthrough": true,
      "missingDependencyHelp": "Install jp2a: brew install jp2a", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
