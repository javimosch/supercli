{
  "name": "imgdiff",
  "version": "0.1.0",
  "description": "Pixel-by-pixel image difference tool",
  "source": "https://github.com/n7olkachev/imgdiff",
  "checks": [
    {
      "type": "binary",
      "name": "imgdiff"
    }
  ],
  "install_guidance": {
    "plugin": "imgdiff",
    "binary": "imgdiff",
    "check": "which imgdiff",
    "install_steps": [
      "brew install imgdiff",
      "Verify: imgdiff --version",
      "supercli plugins install ./plugins/imgdiff --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "imgdiff",
      "resource": "self",
      "action": "version",
      "description": "Print imgdiff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgdiff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install imgdiff: brew install imgdiff"
      },
      "args": []
    },
    {
      "namespace": "imgdiff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to imgdiff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgdiff",
        "passthrough": true,
        "missingDependencyHelp": "Install imgdiff"
      },
      "args": []
    }
  ]
}