{
  "plugin": "update-default-ispell",
  "binary": "update-default-ispell",
  "check": "which update-default-ispell",
  "install_steps": [
    "apt-get install update-default-ispell 2>/dev/null || which update-default-ispell",
    "Verify: update-default-ispell --version",
    "supercli plugins install ./plugins/update-default-ispell --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}