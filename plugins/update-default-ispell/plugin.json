{
  "name": "update-default-ispell",
  "version": "0.1.0",
  "description": "CLI tool: update-default-ispell",
  "source": "https://manpages.debian.org/update-default-ispell",
  "checks": [
    {
      "type": "binary",
      "name": "update-default-ispell"
    }
  ],
  "install_guidance": {
    "plugin": "update-default-ispell",
    "binary": "update-default-ispell",
    "check": "which update-default-ispell",
    "install_steps": [
      "apt-get install update-default-ispell 2>/dev/null || which update-default-ispell",
      "Verify: update-default-ispell --version",
      "supercli plugins install ./plugins/update-default-ispell --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "update-default-ispell",
      "resource": "self",
      "action": "version",
      "description": "Print update-default-ispell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "update-default-ispell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install update-default-ispell: apt-get install update-default-ispell 2>/dev/null || which update-default-ispell"
      },
      "args": []
    },
    {
      "namespace": "update-default-ispell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to update-default-ispell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "update-default-ispell",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install update-default-ispell: apt-get install update-default-ispell 2>/dev/null || which update-default-ispell"
      },
      "args": []
    }
  ]
}