{
  "name": "file-splitter",
  "version": "0.1.0",
  "description": "Split massive files into smaller chunks from CLI",
  "source": "https://github.com/gokulkrishh/file-splitter",
  "checks": [{ "type": "binary", "name": "file-splitter" }],
  "install_guidance": {
    "plugin": "file-splitter",
    "binary": "file-splitter",
    "check": "which file-splitter",
    "install_steps": ["pip install file-splitter", "Verify: file-splitter --version", "supercli plugins install ./plugins/file-splitter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "file-splitter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to file-splitter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "file-splitter",
      "passthrough": true,
      "missingDependencyHelp": "Install file-splitter: pip install file-splitter", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
