{
  "name": "ts-prune",
  "version": "0.1.0",
  "description": "Find unused exports in TypeScript",
  "source": "https://github.com/nadeesha/ts-prune",
  "checks": [
    {
      "type": "binary",
      "name": "ts-prune"
    }
  ],
  "install_guidance": {
    "plugin": "ts-prune",
    "binary": "ts-prune",
    "check": "which ts-prune",
    "install_steps": [
      "npm install -g ts-prune",
      "Verify: ts-prune --version",
      "supercli plugins install ./plugins/ts-prune --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "ts-prune",
      "resource": "self",
      "action": "version",
      "description": "Print ts-prune version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ts-prune",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ts-prune: npm install -g ts-prune"
      },
      "args": []
    },
    {
      "namespace": "ts-prune",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ts-prune CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ts-prune",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ts-prune: npm install -g ts-prune"
      },
      "args": []
    }
  ]
}
