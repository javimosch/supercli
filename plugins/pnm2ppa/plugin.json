{
  "name": "pnm2ppa",
  "version": "0.1.0",
  "description": "CLI tool: pnm2ppa",
  "source": "https://manpages.debian.org/pnm2ppa",
  "checks": [
    {
      "type": "binary",
      "name": "pnm2ppa"
    }
  ],
  "install_guidance": {
    "plugin": "pnm2ppa",
    "binary": "pnm2ppa",
    "check": "which pnm2ppa",
    "install_steps": [
      "apt-get install pnm2ppa 2>/dev/null || which pnm2ppa",
      "Verify: pnm2ppa --version",
      "supercli plugins install ./plugins/pnm2ppa --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnm2ppa",
      "resource": "self",
      "action": "version",
      "description": "Print pnm2ppa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnm2ppa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnm2ppa: apt-get install pnm2ppa 2>/dev/null || which pnm2ppa"
      },
      "args": []
    },
    {
      "namespace": "pnm2ppa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnm2ppa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnm2ppa",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnm2ppa: apt-get install pnm2ppa 2>/dev/null || which pnm2ppa"
      },
      "args": []
    }
  ]
}