{
  "name": "compose-farm",
  "version": "0.1.0",
  "description": "compose-farm - Docker compose across multiple hosts",
  "source": "github.com/compose-farm/compose-farm",
  "checks": [
    {
      "type": "binary",
      "name": "compose-farm"
    }
  ],
  "install_guidance": {
    "plugin": "compose-farm",
    "binary": "compose-farm",
    "check": "which compose-farm",
    "install_steps": [
      "pip install compose-farm"
    ]
  },
  "commands": [
    {
      "namespace": "compose",
      "resource": "farm",
      "action": "run",
      "description": "Run Docker compose across multiple hosts",
      "adapter": "process",
      "adapterConfig": {
        "command": "compose-farm",
        "passthrough": true,
        "invoke_cwd": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install compose-farm from github.com/compose-farm/compose-farm"
      },
      "args": []
    }
  ]
}