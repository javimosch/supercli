{
  "name": "ddrescue",
  "version": "0.1.0",
  "description": "Data recovery tool that copies data from one file to another",
  "source": "https://github.com/search/ddrescue",
  "checks": [{ "type": "binary", "name": "ddrescue" }],
  "install_guidance": {
    "plugin": "ddrescue",
    "binary": "ddrescue",
    "check": "which ddrescue",
    "install_steps": ["brew install ddrescue", "Verify: ddrescue --version", "supercli plugins install ./plugins/ddrescue --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ddrescue",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ddrescue CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ddrescue",
      "passthrough": true,
      "missingDependencyHelp": "Install ddrescue: brew install ddrescue"
    },
    "args": []
  }]
}
