{
  "name": "nullboiler",
  "version": "0.1.0",
  "description": "Orchestrates multi-step AI agent workflows \u2014 defines execution graphs, manages shared state, dispatc",
  "source": "https://github.com/nullboiler/nullboiler",
  "checks": [
    {
      "type": "binary",
      "name": "nullboiler"
    }
  ],
  "install_guidance": {
    "plugin": "nullboiler",
    "binary": "nullboiler",
    "check": "which nullboiler",
    "install_steps": [
      "pip install nullboiler",
      "Verify: nullboiler --version",
      "supercli plugins install ./plugins/nullboiler --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nullboiler",
      "resource": "self",
      "action": "version",
      "description": "Print nullboiler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nullboiler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nullboiler: pip install nullboiler"
      },
      "args": []
    },
    {
      "namespace": "nullboiler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nullboiler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nullboiler",
        "passthrough": true,
        "missingDependencyHelp": "Install nullboiler: pip install nullboiler"
      },
      "args": []
    }
  ]
}