{
  "name": "cxxopts",
  "version": "0.1.0",
  "description": "Lightweight C++ command-line option parser",
  "source": "https://github.com/jarro2783/cxxopts",
  "checks": [
    {
      "type": "binary",
      "name": "cxxopts"
    }
  ],
  "install_guidance": {
    "plugin": "cxxopts",
    "binary": "cxxopts",
    "check": "which cxxopts",
    "install_steps": [
      "brew install cxxopts",
      "Verify: cxxopts --version",
      "supercli plugins install ./plugins/cxxopts --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cxxopts",
      "resource": "self",
      "action": "version",
      "description": "Print cxxopts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cxxopts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cxxopts: brew install cxxopts"
      },
      "args": []
    },
    {
      "namespace": "cxxopts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cxxopts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cxxopts",
        "passthrough": true,
        "missingDependencyHelp": "Install cxxopts"
      },
      "args": []
    }
  ]
}