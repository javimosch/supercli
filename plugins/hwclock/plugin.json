{
  "name": "hwclock",
  "version": "0.1.0",
  "description": "CLI tool: hwclock",
  "source": "https://manpages.debian.org/hwclock",
  "checks": [
    {
      "type": "binary",
      "name": "hwclock"
    }
  ],
  "install_guidance": {
    "plugin": "hwclock",
    "binary": "hwclock",
    "check": "which hwclock",
    "install_steps": [
      "apt-get install hwclock 2>/dev/null || which hwclock",
      "Verify: hwclock --version",
      "supercli plugins install ./plugins/hwclock --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hwclock",
      "resource": "self",
      "action": "version",
      "description": "Print hwclock version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwclock",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hwclock: apt-get install hwclock 2>/dev/null || which hwclock"
      },
      "args": []
    },
    {
      "namespace": "hwclock",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hwclock CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hwclock",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hwclock: apt-get install hwclock 2>/dev/null || which hwclock"
      },
      "args": []
    }
  ]
}