{
  "name": "official-client-portable",
  "version": "0.1.0",
  "description": "Cross-platform, portable, official Old School RuneScape client",
  "source": "http://discord.runestar.org",
  "checks": [
    {
      "type": "binary",
      "name": "official-client-portable"
    }
  ],
  "install_guidance": {
    "plugin": "official-client-portable",
    "binary": "official-client-portable",
    "check": "which official-client-portable",
    "install_steps": [
      "Check http://discord.runestar.org for installation instructions",
      "Verify: official-client-portable --version",
      "supercli plugins install ./plugins/official-client-portable --on-conflict replace --json"
    ],
    "note": "PowerShell language CLI tool"
  },
  "commands": [
    {
      "namespace": "official-client-portable",
      "resource": "self",
      "action": "version",
      "description": "Print official-client-portable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "official-client-portable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install official-client-portable from project repository"
      },
      "args": []
    },
    {
      "namespace": "official-client-portable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to official-client-portable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "official-client-portable",
        "passthrough": true,
        "missingDependencyHelp": "Install official-client-portable from project repository"
      },
      "args": []
    }
  ]
}