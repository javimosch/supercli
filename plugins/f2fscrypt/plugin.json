{
  "name": "f2fscrypt",
  "version": "0.1.0",
  "description": "CLI tool: f2fscrypt",
  "source": "https://manpages.debian.org/f2fscrypt",
  "checks": [
    {
      "type": "binary",
      "name": "f2fscrypt"
    }
  ],
  "install_guidance": {
    "plugin": "f2fscrypt",
    "binary": "f2fscrypt",
    "check": "which f2fscrypt",
    "install_steps": [
      "apt-get install f2fscrypt 2>/dev/null || which f2fscrypt",
      "Verify: f2fscrypt --version",
      "supercli plugins install ./plugins/f2fscrypt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "f2fscrypt",
      "resource": "self",
      "action": "version",
      "description": "Print f2fscrypt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "f2fscrypt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install f2fscrypt: apt-get install f2fscrypt 2>/dev/null || which f2fscrypt"
      },
      "args": []
    },
    {
      "namespace": "f2fscrypt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to f2fscrypt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "f2fscrypt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install f2fscrypt: apt-get install f2fscrypt 2>/dev/null || which f2fscrypt"
      },
      "args": []
    }
  ]
}