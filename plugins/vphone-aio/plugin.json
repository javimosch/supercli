{
  "name": "vphone-aio",
  "version": "0.1.0",
  "description": "1 script run the vphone",
  "source": "https://github.com/vphone-aio/vphone-aio",
  "checks": [
    {
      "type": "binary",
      "name": "vphone-aio"
    }
  ],
  "install_guidance": {
    "plugin": "vphone-aio",
    "binary": "vphone-aio",
    "check": "which vphone-aio",
    "install_steps": [
      "pip install vphone-aio",
      "Verify: vphone-aio --version",
      "supercli plugins install ./plugins/vphone-aio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vphone-aio",
      "resource": "self",
      "action": "version",
      "description": "Print vphone-aio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vphone-aio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vphone-aio: pip install vphone-aio"
      },
      "args": []
    },
    {
      "namespace": "vphone-aio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vphone-aio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vphone-aio",
        "passthrough": true,
        "missingDependencyHelp": "Install vphone-aio: pip install vphone-aio"
      },
      "args": []
    }
  ]
}