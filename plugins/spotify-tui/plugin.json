{
  "name": "spotify-tui",
  "version": "0.1.0",
  "description": "spotify-tui — Spotify terminal client",
  "source": "https://github.com/Rigellute/spotify-tui",
  "checks": [
    {
      "type": "binary",
      "name": "spotify-tui"
    }
  ],
  "install_guidance": {
    "plugin": "spotify-tui",
    "binary": "spotify-tui",
    "check": "which spotify-tui",
    "install_steps": [
      "cargo install spotify-tui",
      "Verify: spotify-tui --version",
      "supercli plugins install ./plugins/spotify-tui --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "spotify-tui",
      "resource": "self",
      "action": "version",
      "description": "Print spotify-tui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spotify-tui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spotify-tui: cargo install spotify-tui"
      },
      "args": []
    },
    {
      "namespace": "spotify-tui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spotify-tui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spotify-tui",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install spotify-tui: cargo install spotify-tui"
      },
      "args": []
    }
  ]
}
