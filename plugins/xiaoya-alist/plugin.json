{
  "name": "xiaoya-alist",
  "version": "0.1.0",
  "description": "\u5c0f\u96c5Alist\u7684\u76f8\u5173\u5468\u8fb9",
  "source": "https://github.com/xiaoya-alist/xiaoya-alist",
  "checks": [
    {
      "type": "binary",
      "name": "xiaoya-alist"
    }
  ],
  "install_guidance": {
    "plugin": "xiaoya-alist",
    "binary": "xiaoya-alist",
    "check": "which xiaoya-alist",
    "install_steps": [
      "pip install xiaoya-alist",
      "Verify: xiaoya-alist --version",
      "supercli plugins install ./plugins/xiaoya-alist --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xiaoya-alist",
      "resource": "self",
      "action": "version",
      "description": "Print xiaoya-alist version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaoya-alist",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xiaoya-alist: pip install xiaoya-alist"
      },
      "args": []
    },
    {
      "namespace": "xiaoya-alist",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xiaoya-alist CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaoya-alist",
        "passthrough": true,
        "missingDependencyHelp": "Install xiaoya-alist: pip install xiaoya-alist"
      },
      "args": []
    }
  ]
}