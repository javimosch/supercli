{
  "name": "updatecli",
  "version": "0.1.0",
  "description": "Declarative dependency management and update tool",
  "source": "https://github.com/updatecli/updatecli",
  "checks": [{ "type": "binary", "name": "updatecli" }],
  "install_guidance": {
    "plugin": "updatecli",
    "binary": "updatecli",
    "check": "which updatecli",
    "install_steps": ["brew install updatecli", "Verify: updatecli --version", "supercli plugins install ./plugins/updatecli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "updatecli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to updatecli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "updatecli",
      "passthrough": true,
      "missingDependencyHelp": "Install updatecli: brew install updatecli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
