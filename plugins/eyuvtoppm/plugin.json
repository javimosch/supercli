{
  "name": "eyuvtoppm",
  "version": "0.1.0",
  "description": "CLI tool: eyuvtoppm",
  "source": "https://manpages.debian.org/eyuvtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "eyuvtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "eyuvtoppm",
    "binary": "eyuvtoppm",
    "check": "which eyuvtoppm",
    "install_steps": [
      "apt-get install eyuvtoppm 2>/dev/null || which eyuvtoppm",
      "Verify: eyuvtoppm --version",
      "supercli plugins install ./plugins/eyuvtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "eyuvtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print eyuvtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eyuvtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eyuvtoppm: apt-get install eyuvtoppm 2>/dev/null || which eyuvtoppm"
      },
      "args": []
    },
    {
      "namespace": "eyuvtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eyuvtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eyuvtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install eyuvtoppm: apt-get install eyuvtoppm 2>/dev/null || which eyuvtoppm"
      },
      "args": []
    }
  ]
}