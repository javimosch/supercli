{
  "name": "upbibtex",
  "version": "0.1.0",
  "description": "CLI tool: upbibtex",
  "source": "https://manpages.debian.org/upbibtex",
  "checks": [
    {
      "type": "binary",
      "name": "upbibtex"
    }
  ],
  "install_guidance": {
    "plugin": "upbibtex",
    "binary": "upbibtex",
    "check": "which upbibtex",
    "install_steps": [
      "apt-get install upbibtex 2>/dev/null || which upbibtex",
      "Verify: upbibtex --version",
      "supercli plugins install ./plugins/upbibtex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "upbibtex",
      "resource": "self",
      "action": "version",
      "description": "Print upbibtex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "upbibtex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install upbibtex: apt-get install upbibtex 2>/dev/null || which upbibtex"
      },
      "args": []
    },
    {
      "namespace": "upbibtex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to upbibtex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "upbibtex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install upbibtex: apt-get install upbibtex 2>/dev/null || which upbibtex"
      },
      "args": []
    }
  ]
}