{
  "name": "email-verify-cli",
  "version": "0.1.0",
  "description": "Simple CLI check for email address syntax validation",
  "source": "https://github.com/manoj-kumar-1/email-verify-cli",
  "checks": [{ "type": "binary", "name": "email-verify-cli" }],
  "install_guidance": {
    "plugin": "email-verify-cli",
    "binary": "email-verify-cli",
    "check": "which email-verify-cli",
    "install_steps": ["npm install -g email-verify-cli", "Verify: email-verify-cli --version", "supercli plugins install ./plugins/email-verify-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "email-verify-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to email-verify-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "email-verify-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install email-verify-cli: npm install -g email-verify-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
