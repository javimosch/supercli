{
  "name": "graphqurl",
  "version": "0.1.0",
  "description": "Curl-like CLI tool for making GraphQL queries and mutations",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "graphqurl" }],
  "install_guidance": {
    "plugin": "graphqurl",
    "binary": "graphqurl",
    "check": "which graphqurl",
    "install_steps": ["npm install -g graphqurl", "Verify: graphqurl --version", "supercli plugins install ./plugins/graphqurl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "graphqurl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to graphqurl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "graphqurl",
      "passthrough": true,
      "missingDependencyHelp": "Install graphqurl: npm install -g graphqurl"
    },
    "args": []
  }]
}
