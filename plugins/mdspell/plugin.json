{
  "name": "mdspell",
  "version": "0.1.0",
  "description": "Markdown spell checker with interactive fixing",
  "source": "https://github.com/supervacuus/mdspell",
  "checks": [{ "type": "binary", "name": "mdspell" }],
  "install_guidance": {
    "plugin": "mdspell",
    "binary": "mdspell",
    "check": "which mdspell",
    "install_steps": ["npm install -g mdspell", "Verify: mdspell --version", "supercli plugins install ./plugins/mdspell --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdspell",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdspell CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdspell",
      "passthrough": true,
      "missingDependencyHelp": "Install mdspell: npm install -g mdspell", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
