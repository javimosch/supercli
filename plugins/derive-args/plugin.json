{
  "name": "derive-args",
  "version": "0.1.0",
  "description": "derive-args — Rust derive macro for command-line argument parsing",
  "source": "https://formulae.brew.sh/formula/derive-args",
  "checks": [
    {
      "type": "binary",
      "name": "derive-args"
    }
  ],
  "install_guidance": {
    "plugin": "derive-args",
    "binary": "derive-args",
    "check": "which derive-args",
    "install_steps": [
      "cargo add derive-args",
      "Verify: derive-args --version",
      "supercli plugins install ./plugins/derive-args --on-conflict replace --json"
    ],
    "note": "derive-args is a Rust derive macro library — use `cargo add derive-args` inside a Rust project."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "derive-args",
      "resource": "self",
      "action": "version",
      "description": "Print derive-args version",
      "adapter": "process",
      "adapterConfig": {
        "command": "derive-args",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install derive-args: cargo add derive-args"
      },
      "args": []
    }
  ]
}
