{
  "plugin": "derive-args",
  "binary": "derive-args",
  "check": "which derive-args",
  "install_steps": [
    "cargo add derive-args",
    "Verify: derive-args --version",
    "supercli plugins install ./plugins/derive-args --on-conflict replace --json"
  ],
  "note": "derive-args is a Rust derive macro library — use `cargo add derive-args` inside a Rust project."
}
