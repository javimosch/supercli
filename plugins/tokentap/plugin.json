{
  "name": "tokentap",
  "version": "0.1.0",
  "description": "Token Usage Monitor",
  "source": "https://github.com/jmuncor/tokentap",
  "checks": [
    { "type": "binary", "name": "tokentap" }
  ],
  "install_guidance": {
    "plugin": "tokentap",
    "binary": "tokentap",
    "check": "which tokentap",
    "install_steps": [
      "pip install tokentap",
      "Verify: pip show tokentap",
      "supercli plugins install ./plugins/tokentap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tokentap",
      "resource": "self",
      "action": "version",
      "description": "Print tokentap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tokentap",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install tokentap: pip install tokentap"
      },
      "args": []
    },
    {
      "namespace": "tokentap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tokentap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tokentap",
        "passthrough": true,
        "missingDependencyHelp": "Install tokentap"
      },
      "args": []
    }
  ]
}
