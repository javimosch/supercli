{
  "name": "is-up-cli",
  "version": "0.1.0",
  "description": "Check whether a website is up or down via the isitup.org API",
  "source": "https://github.com/sindresorhus/is-up-cli",
  "checks": [
    {
      "type": "binary",
      "name": "is-up"
    }
  ],
  "install_guidance": {
    "plugin": "is-up-cli",
    "binary": "is-up",
    "check": "which is-up",
    "install_steps": [
      "npm install -g is-up-cli",
      "Verify: is-up --help"
    ]
  },
  "commands": [
    {
      "namespace": "is-up",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to is-up",
      "adapter": "process",
      "adapterConfig": {
        "command": "is-up",
        "passthrough": true,
        "missingDependencyHelp": "Install is-up-cli: npm install -g is-up-cli"
      },
      "args": []
    }
  ]
}
