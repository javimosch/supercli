{
  "name": "libcdio-paranoia",
  "version": "0.1.0",
  "description": "CD paranoia on top of libcdio",
  "source": "https://github.com/libcdio/libcdio-paranoia",
  "checks": [
    {
      "type": "binary",
      "name": "libcdio-paranoia"
    }
  ],
  "install_guidance": {
    "plugin": "libcdio-paranoia",
    "binary": "libcdio-paranoia",
    "check": "which libcdio-paranoia",
    "install_steps": [
      "brew install libcdio-paranoia",
      "Verify: libcdio-paranoia --version",
      "supercli plugins install ./plugins/libcdio-paranoia --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libcdio-paranoia",
      "resource": "self",
      "action": "version",
      "description": "Print libcdio-paranoia version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libcdio-paranoia",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libcdio-paranoia: brew install libcdio-paranoia"
      },
      "args": []
    },
    {
      "namespace": "libcdio-paranoia",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libcdio-paranoia CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libcdio-paranoia",
        "passthrough": true,
        "missingDependencyHelp": "Install libcdio-paranoia"
      },
      "args": []
    }
  ]
}