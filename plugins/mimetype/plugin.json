{
  "name": "mimetype",
  "version": "0.1.0",
  "description": "CLI tool: mimetype",
  "source": "https://manpages.debian.org/mimetype",
  "checks": [
    {
      "type": "binary",
      "name": "mimetype"
    }
  ],
  "install_guidance": {
    "plugin": "mimetype",
    "binary": "mimetype",
    "check": "which mimetype",
    "install_steps": [
      "apt-get install mimetype 2>/dev/null || which mimetype",
      "Verify: mimetype --version",
      "supercli plugins install ./plugins/mimetype --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mimetype",
      "resource": "self",
      "action": "version",
      "description": "Print mimetype version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mimetype",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mimetype: apt-get install mimetype 2>/dev/null || which mimetype"
      },
      "args": []
    },
    {
      "namespace": "mimetype",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mimetype CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mimetype",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mimetype: apt-get install mimetype 2>/dev/null || which mimetype"
      },
      "args": []
    }
  ]
}