{
  "name": "pyi-makespec",
  "version": "0.1.0",
  "description": "CLI tool: pyi-makespec",
  "source": "https://manpages.debian.org/pyi-makespec",
  "checks": [
    {
      "type": "binary",
      "name": "pyi-makespec"
    }
  ],
  "install_guidance": {
    "plugin": "pyi-makespec",
    "binary": "pyi-makespec",
    "check": "which pyi-makespec",
    "install_steps": [
      "apt-get install pyi-makespec 2>/dev/null || which pyi-makespec",
      "Verify: pyi-makespec --version",
      "supercli plugins install ./plugins/pyi-makespec --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyi-makespec",
      "resource": "self",
      "action": "version",
      "description": "Print pyi-makespec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-makespec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyi-makespec: apt-get install pyi-makespec 2>/dev/null || which pyi-makespec"
      },
      "args": []
    },
    {
      "namespace": "pyi-makespec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyi-makespec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyi-makespec",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pyi-makespec: apt-get install pyi-makespec 2>/dev/null || which pyi-makespec"
      },
      "args": []
    }
  ]
}