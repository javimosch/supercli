{
  "name": "gie",
  "version": "0.1.0",
  "description": "CLI tool: gie",
  "source": "https://manpages.debian.org/gie",
  "checks": [
    {
      "type": "binary",
      "name": "gie"
    }
  ],
  "install_guidance": {
    "plugin": "gie",
    "binary": "gie",
    "check": "which gie",
    "install_steps": [
      "apt-get install gie 2>/dev/null || which gie",
      "Verify: gie --version",
      "supercli plugins install ./plugins/gie --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gie",
      "resource": "self",
      "action": "version",
      "description": "Print gie version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gie",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gie: apt-get install gie 2>/dev/null || which gie"
      },
      "args": []
    },
    {
      "namespace": "gie",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gie CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gie",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gie: apt-get install gie 2>/dev/null || which gie"
      },
      "args": []
    }
  ]
}