{
  "name": "rook",
  "version": "0.1.0",
  "description": "Storage orchestration for Kubernetes",
  "source": "https://github.com/rook/rook",
  "checks": [{ "type": "binary", "name": "rook" }],
  "install_guidance": {
    "plugin": "rook",
    "binary": "rook",
    "check": "which rook",
    "install_steps": ["brew install rook", "Verify: rook --version", "supercli plugins install ./plugins/rook --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rook",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rook CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rook",
      "passthrough": true,
      "missingDependencyHelp": "Install rook: brew install rook"
    },
    "args": []
  }]
}
