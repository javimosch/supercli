{
  "name": "md2pdf",
  "version": "0.1.0",
  "description": "Simple Go-based Markdown to PDF converter",
  "source": "https://github.com/alexhokl/markdown-to-pdf",
  "checks": [{ "type": "binary", "name": "md2pdf" }],
  "install_guidance": {
    "plugin": "md2pdf",
    "binary": "md2pdf",
    "check": "which md2pdf",
    "install_steps": ["go install github.com/alexhokl/markdown-to-pdf@latest", "Verify: md2pdf --version", "supercli plugins install ./plugins/md2pdf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "md2pdf",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to md2pdf CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "md2pdf",
      "passthrough": true,
      "missingDependencyHelp": "Install md2pdf: go install github.com/alexhokl/markdown-to-pdf@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
