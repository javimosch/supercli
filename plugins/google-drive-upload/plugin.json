{
  "name": "google-drive-upload",
  "version": "0.1.0",
  "description": "Upload/sync with Google Drive",
  "source": "https://github.com/labbots/google-drive-upload",
  "checks": [
    {
      "type": "binary",
      "name": "google-drive-upload"
    }
  ],
  "install_guidance": {
    "plugin": "google-drive-upload",
    "binary": "google-drive-upload",
    "check": "which google-drive-upload",
    "install_steps": [
      "See https://github.com/labbots/google-drive-upload",
      "Verify: google-drive-upload --version",
      "supercli plugins install ./plugins/google-drive-upload --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "google-drive-upload",
      "resource": "self",
      "action": "version",
      "description": "Print google-drive-upload version",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-drive-upload",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install google-drive-upload: See https://github.com/labbots/google-drive-upload"
      },
      "args": []
    },
    {
      "namespace": "google-drive-upload",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to google-drive-upload CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-drive-upload",
        "passthrough": true,
        "missingDependencyHelp": "Install google-drive-upload"
      },
      "args": []
    }
  ]
}