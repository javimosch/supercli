{
  "name": "OpenCut",
  "version": "0.1.0",
  "description": "The open-source CapCut alternative",
  "source": "https://github.com/OpenCut/OpenCut",
  "checks": [
    {
      "type": "binary",
      "name": "opencut"
    }
  ],
  "install_guidance": {
    "plugin": "OpenCut",
    "binary": "opencut",
    "check": "which opencut",
    "install_steps": [
      "pip install opencut",
      "Verify: opencut --version",
      "supercli plugins install ./plugins/OpenCut --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenCut",
      "resource": "self",
      "action": "version",
      "description": "Print OpenCut version",
      "adapter": "process",
      "adapterConfig": {
        "command": "opencut",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenCut: pip install opencut"
      },
      "args": []
    },
    {
      "namespace": "OpenCut",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to opencut CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "opencut",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenCut: pip install opencut"
      },
      "args": []
    }
  ]
}