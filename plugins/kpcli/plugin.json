{
  "name": "kpcli",
  "version": "0.1.0",
  "description": "A command line interface for KeePass databases.",
  "source": "https://github.com/rebkwok/kpcli",
  "checks": [
    {
      "type": "binary",
      "name": "kpcli"
    }
  ],
  "install_guidance": {
    "plugin": "kpcli",
    "binary": "kpcli",
    "check": "which kpcli",
    "install_steps": [
      "brew install kpcli",
      "Verify: kpcli --version",
      "supercli plugins install ./plugins/kpcli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kpcli",
      "resource": "self",
      "action": "version",
      "description": "Print kpcli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kpcli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kpcli: brew install kpcli"
      },
      "args": []
    },
    {
      "namespace": "kpcli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kpcli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kpcli",
        "passthrough": true,
        "missingDependencyHelp": "Install kpcli"
      },
      "args": []
    }
  ]
}