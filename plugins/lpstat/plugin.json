{
  "name": "lpstat",
  "version": "0.1.0",
  "description": "CUPS printer status display",
  "source": "https://packages.debian.org/lpstat",
  "checks": [{ "type": "binary", "name": "lpstat" }],
  "install_guidance": {
    "plugin": "lpstat", "binary": "lpstat", "check": "which lpstat",
    "install_steps": ["apt-get install cups", "Verify: lpstat --version", "supercli plugins install ./plugins/lpstat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lpstat", "resource": "_", "action": "_",
    "description": "Passthrough to lpstat CLI",
    "adapter": "process", "adapterConfig": { "command": "lpstat", "passthrough": true, "missingDependencyHelp": "Install lpstat: apt-get install cups" }, "args": []
  }]
}
