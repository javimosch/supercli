{
  "name": "tool-sync",
  "version": "0.1.0",
  "description": "Batch download binary releases to a sync directory",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "tool-sync" }],
  "install_guidance": {
    "plugin": "tool-sync",
    "binary": "tool-sync",
    "check": "which tool-sync",
    "install_steps": ["cargo install tool-sync", "Verify: tool-sync --version", "supercli plugins install ./plugins/tool-sync --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tool-sync",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tool-sync CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tool-sync",
      "passthrough": true,
      "missingDependencyHelp": "Install tool-sync: cargo install tool-sync"
    },
    "args": []
  }]
}
