{
  "name": "tensor.h",
  "version": "0.1.0",
  "description": "creating a tiny tensor library in raw C",
  "source": "https://github.com/tensor.h/tensor.h",
  "checks": [
    {
      "type": "binary",
      "name": "tensor.h"
    }
  ],
  "install_guidance": {
    "plugin": "tensor.h",
    "binary": "tensor.h",
    "check": "which tensor.h",
    "install_steps": [
      "pip install tensor.h",
      "Verify: tensor.h --version",
      "supercli plugins install ./plugins/tensor.h --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tensor.h",
      "resource": "self",
      "action": "version",
      "description": "Print tensor.h version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tensor.h",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tensor.h: pip install tensor.h"
      },
      "args": []
    },
    {
      "namespace": "tensor.h",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tensor.h CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tensor.h",
        "passthrough": true,
        "missingDependencyHelp": "Install tensor.h: pip install tensor.h"
      },
      "args": []
    }
  ]
}