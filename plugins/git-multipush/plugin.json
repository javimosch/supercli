{
  "name": "git-multipush",
  "version": "0.1.0",
  "description": "Push a branch to multiple remotes in one command",
  "source": "https://github.com/gavinbeatty/git-multipush",
  "checks": [
    {
      "type": "binary",
      "name": "git-multipush"
    }
  ],
  "install_guidance": {
    "plugin": "git-multipush",
    "binary": "git-multipush",
    "check": "which git-multipush",
    "install_steps": [
      "brew install git-multipush",
      "Verify: git-multipush --version",
      "supercli plugins install ./plugins/git-multipush --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-multipush",
      "resource": "self",
      "action": "version",
      "description": "Print git-multipush version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-multipush",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-multipush: brew install git-multipush"
      },
      "args": []
    },
    {
      "namespace": "git-multipush",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-multipush CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-multipush",
        "passthrough": true,
        "missingDependencyHelp": "Install git-multipush"
      },
      "args": []
    }
  ]
}