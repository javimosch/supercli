{
  "name": "ReZygisk",
  "version": "0.1.0",
  "description": "Transparent implementation of Zygisk.",
  "source": "https://github.com/ReZygisk/ReZygisk",
  "checks": [
    {
      "type": "binary",
      "name": "rezygisk"
    }
  ],
  "install_guidance": {
    "plugin": "ReZygisk",
    "binary": "rezygisk",
    "check": "which rezygisk",
    "install_steps": [
      "pip install rezygisk",
      "Verify: rezygisk --version",
      "supercli plugins install ./plugins/ReZygisk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ReZygisk",
      "resource": "self",
      "action": "version",
      "description": "Print ReZygisk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rezygisk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ReZygisk: pip install rezygisk"
      },
      "args": []
    },
    {
      "namespace": "ReZygisk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rezygisk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rezygisk",
        "passthrough": true,
        "missingDependencyHelp": "Install ReZygisk: pip install rezygisk"
      },
      "args": []
    }
  ]
}