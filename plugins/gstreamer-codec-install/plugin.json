{
  "name": "gstreamer-codec-install",
  "version": "0.1.0",
  "description": "CLI tool: gstreamer-codec-install",
  "source": "https://manpages.debian.org/gstreamer-codec-install",
  "checks": [
    {
      "type": "binary",
      "name": "gstreamer-codec-install"
    }
  ],
  "install_guidance": {
    "plugin": "gstreamer-codec-install",
    "binary": "gstreamer-codec-install",
    "check": "which gstreamer-codec-install",
    "install_steps": [
      "apt-get install gstreamer-codec-install 2>/dev/null || which gstreamer-codec-install",
      "Verify: gstreamer-codec-install --version",
      "supercli plugins install ./plugins/gstreamer-codec-install --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gstreamer-codec-install",
      "resource": "self",
      "action": "version",
      "description": "Print gstreamer-codec-install version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gstreamer-codec-install",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gstreamer-codec-install: apt-get install gstreamer-codec-install 2>/dev/null || which gstreamer-codec-install"
      },
      "args": []
    },
    {
      "namespace": "gstreamer-codec-install",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gstreamer-codec-install CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gstreamer-codec-install",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gstreamer-codec-install: apt-get install gstreamer-codec-install 2>/dev/null || which gstreamer-codec-install"
      },
      "args": []
    }
  ]
}