{
  "name": "instafel",
  "version": "0.1.0",
  "description": "Instafel provides fast & up-to-date Instagram Alpha experience for everyone!",
  "source": "https://github.com/instafel/instafel",
  "checks": [
    {
      "type": "binary",
      "name": "instafel"
    }
  ],
  "install_guidance": {
    "plugin": "instafel",
    "binary": "instafel",
    "check": "which instafel",
    "install_steps": [
      "pip install instafel",
      "Verify: instafel --version",
      "supercli plugins install ./plugins/instafel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "instafel",
      "resource": "self",
      "action": "version",
      "description": "Print instafel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "instafel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install instafel: pip install instafel"
      },
      "args": []
    },
    {
      "namespace": "instafel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to instafel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "instafel",
        "passthrough": true,
        "missingDependencyHelp": "Install instafel: pip install instafel"
      },
      "args": []
    }
  ]
}