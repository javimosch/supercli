{
  "name": "pnmtopalm",
  "version": "0.1.0",
  "description": "CLI tool: pnmtopalm",
  "source": "https://manpages.debian.org/pnmtopalm",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtopalm"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtopalm",
    "binary": "pnmtopalm",
    "check": "which pnmtopalm",
    "install_steps": [
      "apt-get install pnmtopalm 2>/dev/null || which pnmtopalm",
      "Verify: pnmtopalm --version",
      "supercli plugins install ./plugins/pnmtopalm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtopalm",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtopalm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtopalm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtopalm: apt-get install pnmtopalm 2>/dev/null || which pnmtopalm"
      },
      "args": []
    },
    {
      "namespace": "pnmtopalm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtopalm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtopalm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtopalm: apt-get install pnmtopalm 2>/dev/null || which pnmtopalm"
      },
      "args": []
    }
  ]
}