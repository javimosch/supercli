{
  "name": "tmate",
  "version": "0.1.0",
  "description": "Instant terminal sharing with tmux integration and SSH-based connections",
  "source": "https://github.com/tmate-io/tmate",
  "checks": [{ "type": "binary", "name": "tmate" }],
  "install_guidance": {
    "plugin": "tmate",
    "binary": "tmate",
    "check": "which tmate",
    "install_steps": [
      "sudo apt install tmate",
      "Or: brew install tmate",
      "Or: sudo pacman -S tmate",
      "Verify: tmate --version",
      "supercli plugins install ./plugins/tmate --on-conflict replace --json"
    ],
    "note": "Available via all major package managers. Source: https://github.com/tmate-io/tmate (6.1k+ stars). Written in C."
  },
  "commands": [
    {
      "namespace": "tmate", "resource": "self", "action": "version",
      "description": "Print tmate version",
      "adapter": "process",
      "adapterConfig": { "command": "tmate", "missingDependencyHelp": "Install tmate: sudo apt install tmate", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "tmate", "resource": "_", "action": "_",
      "description": "Passthrough to tmate CLI",
      "adapter": "process",
      "adapterConfig": { "command": "tmate", "missingDependencyHelp": "Install tmate: sudo apt install tmate", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
