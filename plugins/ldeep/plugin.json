{
  "name": "ldeep",
  "version": "0.1.0",
  "description": "LDAP enumeration utility",
  "source": "https://github.com/franc-pentest/ldeep",
  "checks": [
    {
      "type": "binary",
      "name": "ldeep"
    }
  ],
  "install_guidance": {
    "plugin": "ldeep",
    "binary": "ldeep",
    "check": "which ldeep",
    "install_steps": [
      "brew install ldeep",
      "Verify: ldeep --version",
      "supercli plugins install ./plugins/ldeep --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ldeep",
      "resource": "self",
      "action": "version",
      "description": "Print ldeep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldeep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ldeep: brew install ldeep"
      },
      "args": []
    },
    {
      "namespace": "ldeep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ldeep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldeep",
        "passthrough": true,
        "missingDependencyHelp": "Install ldeep"
      },
      "args": []
    }
  ]
}