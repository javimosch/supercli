{
  "name": "vlc",
  "version": "0.1.0",
  "description": "VLC media player CLI interface",
  "source": "https://packages.debian.org/vlc",
  "checks": [{ "type": "binary", "name": "vlc" }],
  "install_guidance": {
    "plugin": "vlc", "binary": "vlc", "check": "which vlc",
    "install_steps": ["apt-get install vlc-bin", "Verify: vlc --version", "supercli plugins install ./plugins/vlc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vlc", "resource": "_", "action": "_",
    "description": "Passthrough to vlc CLI",
    "adapter": "process", "adapterConfig": { "command": "vlc", "passthrough": true, "missingDependencyHelp": "Install vlc: apt-get install vlc-bin" }, "args": []
  }]
}
