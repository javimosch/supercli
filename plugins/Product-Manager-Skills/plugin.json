{
  "name": "Product-Manager-Skills",
  "version": "0.1.0",
  "description": "Product Management skills framework built on battle-tested methods for Claude Code, Cowork, Codex, a",
  "source": "https://github.com/Product-Manager-Skills/Product-Manager-Skills",
  "checks": [
    {
      "type": "binary",
      "name": "product-manager-skills"
    }
  ],
  "install_guidance": {
    "plugin": "Product-Manager-Skills",
    "binary": "product-manager-skills",
    "check": "which product-manager-skills",
    "install_steps": [
      "pip install product-manager-skills",
      "Verify: product-manager-skills --version",
      "supercli plugins install ./plugins/Product-Manager-Skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Product-Manager-Skills",
      "resource": "self",
      "action": "version",
      "description": "Print Product-Manager-Skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "product-manager-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Product-Manager-Skills: pip install product-manager-skills"
      },
      "args": []
    },
    {
      "namespace": "Product-Manager-Skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to product-manager-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "product-manager-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install Product-Manager-Skills: pip install product-manager-skills"
      },
      "args": []
    }
  ]
}