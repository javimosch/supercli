{
  "name": "copyparty",
  "version": "0.1.0",
  "description": "Portable file server",
  "source": "https://github.com/9001/copyparty",
  "checks": [
    {
      "type": "binary",
      "name": "copyparty"
    }
  ],
  "install_guidance": {
    "plugin": "copyparty",
    "binary": "copyparty",
    "check": "which copyparty",
    "install_steps": [
      "brew install copyparty",
      "Verify: copyparty --version",
      "supercli plugins install ./plugins/copyparty --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "copyparty",
      "resource": "self",
      "action": "version",
      "description": "Print copyparty version",
      "adapter": "process",
      "adapterConfig": {
        "command": "copyparty",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install copyparty: brew install copyparty"
      },
      "args": []
    },
    {
      "namespace": "copyparty",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to copyparty CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "copyparty",
        "passthrough": true,
        "missingDependencyHelp": "Install copyparty"
      },
      "args": []
    }
  ]
}