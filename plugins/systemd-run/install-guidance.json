{
  "plugin": "systemd-run",
  "binary": "systemd-run",
  "check": "which systemd-run",
  "install_steps": [
    "apt-get install systemd-run 2>/dev/null || which systemd-run",
    "Verify: systemd-run --version",
    "supercli plugins install ./plugins/systemd-run --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}