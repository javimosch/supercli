{
  "name": "clang++",
  "version": "0.1.0",
  "description": "CLI tool: clang++",
  "source": "https://packages.debian.org/clang++",
  "checks": [{ "type": "binary", "name": "clang++" }],
  "install_guidance": {
    "plugin": "clang++", "binary": "clang++", "check": "which clang++",
    "install_steps": ["apt-get install clang++ 2>/dev/null || which clang++", "Verify: clang++ --version", "supercli plugins install ./plugins/clang++ --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clang++", "resource": "_", "action": "_",
    "description": "Passthrough to clang++ CLI",
    "adapter": "process", "adapterConfig": { "command": "clang++", "passthrough": true, "missingDependencyHelp": "Install clang++: apt-get install clang++" }, "args": []
  }]
}
