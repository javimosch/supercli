{
  "name": "libspatialite",
  "version": "0.1.0",
  "description": "Adds spatial SQL capabilities to SQLite",
  "checks": [
    {
      "type": "binary",
      "name": "libspatialite"
    }
  ],
  "install_guidance": {
    "plugin": "libspatialite",
    "binary": "libspatialite",
    "check": "which libspatialite",
    "install_steps": [
      "brew install libspatialite",
      "Verify: libspatialite --version",
      "supercli plugins install ./plugins/libspatialite --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libspatialite",
      "resource": "self",
      "action": "version",
      "description": "Print libspatialite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libspatialite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libspatialite: brew install libspatialite"
      },
      "args": []
    },
    {
      "namespace": "libspatialite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libspatialite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libspatialite",
        "passthrough": true,
        "missingDependencyHelp": "Install libspatialite"
      },
      "args": []
    }
  ]
}