{
  "name": "ghz",
  "version": "0.1.0",
  "description": "Simple gRPC benchmarking and load testing tool",
  "source": "https://github.com/bojand/ghz",
  "checks": [{ "type": "binary", "name": "ghz" }],
  "install_guidance": {
    "plugin": "ghz",
    "binary": "ghz",
    "check": "which ghz",
    "install_steps": ["go install github.com/bojand/ghz/cmd/ghz@latest", "Verify: ghz --version", "supercli plugins install ./plugins/ghz --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ghz",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ghz CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ghz",
      "passthrough": true,
      "missingDependencyHelp": "Install ghz: go install github.com/bojand/ghz/cmd/ghz@latest"
    },
    "args": []
  }]
}
