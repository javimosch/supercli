{
  "name": "db_dump",
  "version": "0.1.0",
  "description": "CLI tool: db_dump",
  "source": "https://packages.debian.org/db_dump",
  "checks": [{ "type": "binary", "name": "db_dump" }],
  "install_guidance": {
    "plugin": "db_dump", "binary": "db_dump", "check": "which db_dump",
    "install_steps": ["apt-get install db_dump 2>/dev/null || which db_dump", "Verify: db_dump --version", "supercli plugins install ./plugins/db_dump --on-conflict replace --json"]
