{
  "name": "gremlin.zig",
  "version": "0.1.0",
  "description": "A zero-dependency Google Protocol Buffers implementation in pure Zig. Single allocation encode and l",
  "source": "https://github.com/gremlin.zig/gremlin.zig",
  "checks": [
    {
      "type": "binary",
      "name": "gremlin.zig"
    }
  ],
  "install_guidance": {
    "plugin": "gremlin.zig",
    "binary": "gremlin.zig",
    "check": "which gremlin.zig",
    "install_steps": [
      "pip install gremlin.zig",
      "Verify: gremlin.zig --version",
      "supercli plugins install ./plugins/gremlin.zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gremlin.zig",
      "resource": "self",
      "action": "version",
      "description": "Print gremlin.zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gremlin.zig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gremlin.zig: pip install gremlin.zig"
      },
      "args": []
    },
    {
      "namespace": "gremlin.zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gremlin.zig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gremlin.zig",
        "passthrough": true,
        "missingDependencyHelp": "Install gremlin.zig: pip install gremlin.zig"
      },
      "args": []
    }
  ]
}