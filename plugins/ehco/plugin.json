{
  "name": "ehco",
  "version": "0.1.0",
  "description": "Network relay tool and a typo :)",
  "source": "https://github.com/Ehco1996/ehco",
  "checks": [
    {
      "type": "binary",
      "name": "ehco"
    }
  ],
  "install_guidance": {
    "plugin": "ehco",
    "binary": "ehco",
    "check": "which ehco",
    "install_steps": [
      "brew install ehco",
      "Verify: ehco --version",
      "supercli plugins install ./plugins/ehco --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ehco",
      "resource": "self",
      "action": "version",
      "description": "Print ehco version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ehco",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ehco: brew install ehco"
      },
      "args": []
    },
    {
      "namespace": "ehco",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ehco CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ehco",
        "passthrough": true,
        "missingDependencyHelp": "Install ehco"
      },
      "args": []
    }
  ]
}