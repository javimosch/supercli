{
  "name": "biodiff",
  "version": "0.1.0",
  "description": "Hex diff viewer using alignment algorithms from biology",
  "source": "https://github.com/8051Enthusiast/biodiff",
  "checks": [
    {
      "type": "binary",
      "name": "biodiff"
    }
  ],
  "install_guidance": {
    "plugin": "biodiff",
    "binary": "biodiff",
    "check": "which biodiff",
    "install_steps": [
      "brew install biodiff",
      "Verify: biodiff --version",
      "supercli plugins install ./plugins/biodiff --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "biodiff",
      "resource": "self",
      "action": "version",
      "description": "Print biodiff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "biodiff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install biodiff: brew install biodiff"
      },
      "args": []
    },
    {
      "namespace": "biodiff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to biodiff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "biodiff",
        "passthrough": true,
        "missingDependencyHelp": "Install biodiff"
      },
      "args": []
    }
  ]
}