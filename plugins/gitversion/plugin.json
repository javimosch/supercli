{
  "name": "gitversion",
  "version": "0.1.0",
  "description": "Easy semantic versioning for projects using Git",
  "checks": [
    {
      "type": "binary",
      "name": "gitversion"
    }
  ],
  "install_guidance": {
    "plugin": "gitversion",
    "binary": "gitversion",
    "check": "which gitversion",
    "install_steps": [
      "brew install gitversion",
      "Verify: gitversion --version",
      "supercli plugins install ./plugins/gitversion --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitversion",
      "resource": "self",
      "action": "version",
      "description": "Print gitversion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitversion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitversion: brew install gitversion"
      },
      "args": []
    },
    {
      "namespace": "gitversion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitversion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitversion",
        "passthrough": true,
        "missingDependencyHelp": "Install gitversion"
      },
      "args": []
    }
  ]
}