{
  "name": "markdown-it",
  "version": "0.1.0",
  "description": "CLI tool: markdown-it",
  "source": "https://manpages.debian.org/markdown-it",
  "checks": [
    {
      "type": "binary",
      "name": "markdown-it"
    }
  ],
  "install_guidance": {
    "plugin": "markdown-it",
    "binary": "markdown-it",
    "check": "which markdown-it",
    "install_steps": [
      "apt-get install markdown-it 2>/dev/null || which markdown-it",
      "Verify: markdown-it --version",
      "supercli plugins install ./plugins/markdown-it --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "markdown-it",
      "resource": "self",
      "action": "version",
      "description": "Print markdown-it version",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdown-it",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install markdown-it: apt-get install markdown-it 2>/dev/null || which markdown-it"
      },
      "args": []
    },
    {
      "namespace": "markdown-it",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to markdown-it CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdown-it",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install markdown-it: apt-get install markdown-it 2>/dev/null || which markdown-it"
      },
      "args": []
    }
  ]
}