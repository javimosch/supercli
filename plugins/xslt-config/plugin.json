{
  "name": "xslt-config",
  "version": "0.1.0",
  "description": "CLI tool: xslt-config",
  "source": "https://manpages.debian.org/xslt-config",
  "checks": [
    {
      "type": "binary",
      "name": "xslt-config"
    }
  ],
  "install_guidance": {
    "plugin": "xslt-config",
    "binary": "xslt-config",
    "check": "which xslt-config",
    "install_steps": [
      "apt-get install xslt-config 2>/dev/null || which xslt-config",
      "Verify: xslt-config --version",
      "supercli plugins install ./plugins/xslt-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xslt-config",
      "resource": "self",
      "action": "version",
      "description": "Print xslt-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xslt-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xslt-config: apt-get install xslt-config 2>/dev/null || which xslt-config"
      },
      "args": []
    },
    {
      "namespace": "xslt-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xslt-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xslt-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xslt-config: apt-get install xslt-config 2>/dev/null || which xslt-config"
      },
      "args": []
    }
  ]
}