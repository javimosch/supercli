{
  "name": "sql-studio",
  "version": "0.1.0",
  "description": "SQL Database Explorer [SQLite, libSQL, PostgreSQL, MySQL/MariaDB, ClickHouse, DuckDB, Microsoft SQL ",
  "source": "https://github.com/sql-studio/sql-studio",
  "checks": [
    {
      "type": "binary",
      "name": "sql-studio"
    }
  ],
  "install_guidance": {
    "plugin": "sql-studio",
    "binary": "sql-studio",
    "check": "which sql-studio",
    "install_steps": [
      "pip install sql-studio",
      "Verify: sql-studio --version",
      "supercli plugins install ./plugins/sql-studio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sql-studio",
      "resource": "self",
      "action": "version",
      "description": "Print sql-studio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sql-studio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sql-studio: pip install sql-studio"
      },
      "args": []
    },
    {
      "namespace": "sql-studio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sql-studio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sql-studio",
        "passthrough": true,
        "missingDependencyHelp": "Install sql-studio: pip install sql-studio"
      },
      "args": []
    }
  ]
}