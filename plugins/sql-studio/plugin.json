{
  "name": "sql-studio",
  "version": "0.1.0",
  "description": "Single-file SQLite database browser with JSON export",
  "source": "https://github.com/frectonz/sql-studio",
  "checks": [{ "type": "binary", "name": "sql-studio" }],
  "install_guidance": {
    "plugin": "sql-studio",
    "binary": "sql-studio",
    "check": "which sql-studio",
    "install_steps": ["cargo install sql-studio", "Verify: sql-studio --version", "supercli plugins install ./plugins/sql-studio --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sql-studio",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sql-studio CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sql-studio",
      "passthrough": true,
      "missingDependencyHelp": "Install sql-studio: cargo install sql-studio"
    },
    "args": []
  }]
}
