{
  "name": "mapshaper",
  "version": "0.1.0",
  "description": "Topology-aware shapefile editor",
  "source": "https://github.com/mbloch/mapshaper",
  "checks": [
    {
      "type": "binary",
      "name": "mapshaper"
    }
  ],
  "install_guidance": {
    "plugin": "mapshaper",
    "binary": "mapshaper",
    "check": "which mapshaper",
    "install_steps": [
      "npm install -g mapshaper",
      "Verify: mapshaper --version",
      "supercli plugins install ./plugins/mapshaper --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "mapshaper",
      "resource": "self",
      "action": "version",
      "description": "Print mapshaper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mapshaper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mapshaper: npm install -g mapshaper"
      },
      "args": []
    },
    {
      "namespace": "mapshaper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mapshaper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mapshaper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mapshaper: npm install -g mapshaper"
      },
      "args": []
    }
  ]
}
