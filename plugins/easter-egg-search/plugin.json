{
  "name": "easter-egg-search",
  "version": "0.1.0",
  "description": "Search files for hidden developer easter eggs",
  "source": "https://github.com/mrzv/easter-egg-search",
  "checks": [{ "type": "binary", "name": "easter-egg-search" }],
  "install_guidance": {
    "plugin": "easter-egg-search",
    "binary": "easter-egg-search",
    "check": "which easter-egg-search",
    "install_steps": ["pip install easter-egg-search", "Verify: easter-egg-search --version", "supercli plugins install ./plugins/easter-egg-search --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "easter-egg-search",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to easter-egg-search CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "easter-egg-search",
      "passthrough": true,
      "missingDependencyHelp": "Install easter-egg-search: pip install easter-egg-search", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
