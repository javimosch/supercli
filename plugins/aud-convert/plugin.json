{
  "name": "aud-convert",
  "version": "0.1.0",
  "description": "Batch convert audio files between formats via CLI",
  "source": "https://github.com/johndoe/aud-convert",
  "checks": [{ "type": "binary", "name": "aud-convert" }],
  "install_guidance": {
    "plugin": "aud-convert",
    "binary": "aud-convert",
    "check": "which aud-convert",
    "install_steps": ["pip install aud-convert", "Verify: aud-convert --version", "supercli plugins install ./plugins/aud-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aud-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to aud-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "aud-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install aud-convert: pip install aud-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
