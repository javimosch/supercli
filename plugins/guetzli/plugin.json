{
  "name": "guetzli",
  "version": "0.1.0",
  "description": "Google's perceptual JPEG encoder",
  "source": "https://github.com/google/guetzli",
  "checks": [
    {
      "type": "binary",
      "name": "guetzli"
    }
  ],
  "install_guidance": {
    "plugin": "guetzli",
    "binary": "guetzli",
    "check": "which guetzli",
    "install_steps": [
      "brew install guetzli",
      "Verify: guetzli --version",
      "supercli plugins install ./plugins/guetzli --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "guetzli",
      "resource": "self",
      "action": "version",
      "description": "Print guetzli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "guetzli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install guetzli: brew install guetzli"
      },
      "args": []
    },
    {
      "namespace": "guetzli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to guetzli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "guetzli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install guetzli: brew install guetzli"
      },
      "args": []
    }
  ]
}
