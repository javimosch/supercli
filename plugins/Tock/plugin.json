{
  "name": "Tock",
  "version": "0.1.0",
  "description": "Powerful time tracking tool",
  "source": "https://github.com/kriuchkov/tock",
  "checks": [
    {
      "type": "binary",
      "name": "Tock"
    }
  ],
  "install_guidance": {
    "plugin": "Tock",
    "binary": "Tock",
    "check": "which Tock",
    "install_steps": [
      "brew install Tock",
      "Verify: Tock --version",
      "supercli plugins install ./plugins/Tock --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Tock",
      "resource": "self",
      "action": "version",
      "description": "Print Tock version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Tock",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Tock: brew install Tock"
      },
      "args": []
    },
    {
      "namespace": "Tock",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Tock CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Tock",
        "passthrough": true,
        "missingDependencyHelp": "Install Tock"
      },
      "args": []
    }
  ]
}