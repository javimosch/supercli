{
  "name": "zig-aio",
  "version": "0.1.0",
  "description": "io_uring like asynchronous API and coroutine powered IO tasks for zig",
  "source": "https://github.com/zig-aio/zig-aio",
  "checks": [
    {
      "type": "binary",
      "name": "zig-aio"
    }
  ],
  "install_guidance": {
    "plugin": "zig-aio",
    "binary": "zig-aio",
    "check": "which zig-aio",
    "install_steps": [
      "pip install zig-aio",
      "Verify: zig-aio --version",
      "supercli plugins install ./plugins/zig-aio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig-aio",
      "resource": "self",
      "action": "version",
      "description": "Print zig-aio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-aio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig-aio: pip install zig-aio"
      },
      "args": []
    },
    {
      "namespace": "zig-aio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig-aio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-aio",
        "passthrough": true,
        "missingDependencyHelp": "Install zig-aio: pip install zig-aio"
      },
      "args": []
    }
  ]
}