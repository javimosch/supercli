{
  "name": "calibre-ebook-convert-helper",
  "version": "0.1.0",
  "description": "A helper CLI for calibre's ebook-convert CLI which is used to convert all files in an directory into another format.",
  "source": "https://github.com/calibre-ebook-convert-helper/calibre-ebook-convert-helper",
  "checks": [
    {
      "type": "binary",
      "name": "calibre-ebook-convert-helper"
    }
  ],
  "install_guidance": {
    "plugin": "calibre-ebook-convert-helper",
    "binary": "calibre-ebook-convert-helper",
    "check": "which calibre-ebook-convert-helper",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: calibre-ebook-convert-helper --version",
      "supercli plugins install ./plugins/calibre-ebook-convert-helper --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "calibre-ebook-convert-helper",
      "resource": "self",
      "action": "version",
      "description": "Print calibre-ebook-convert-helper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "calibre-ebook-convert-helper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install calibre-ebook-convert-helper from project repository"
      },
      "args": []
    },
    {
      "namespace": "calibre-ebook-convert-helper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to calibre-ebook-convert-helper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "calibre-ebook-convert-helper",
        "passthrough": true,
        "missingDependencyHelp": "Install calibre-ebook-convert-helper from project repository"
      },
      "args": []
    }
  ]
}