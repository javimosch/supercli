{
  "name": "local-dream",
  "version": "0.1.0",
  "description": "Run Stable Diffusion on Android Devices with Snapdragon NPU acceleration. Also supports CPU/GPU infe",
  "source": "https://github.com/local-dream/local-dream",
  "checks": [
    {
      "type": "binary",
      "name": "local-dream"
    }
  ],
  "install_guidance": {
    "plugin": "local-dream",
    "binary": "local-dream",
    "check": "which local-dream",
    "install_steps": [
      "pip install local-dream",
      "Verify: local-dream --version",
      "supercli plugins install ./plugins/local-dream --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "local-dream",
      "resource": "self",
      "action": "version",
      "description": "Print local-dream version",
      "adapter": "process",
      "adapterConfig": {
        "command": "local-dream",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install local-dream: pip install local-dream"
      },
      "args": []
    },
    {
      "namespace": "local-dream",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to local-dream CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "local-dream",
        "passthrough": true,
        "missingDependencyHelp": "Install local-dream: pip install local-dream"
      },
      "args": []
    }
  ]
}