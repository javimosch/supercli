      "adapterConfig": {
        "command": "tmuxinator",
        "baseArgs": ["start"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install tmuxinator: gem install tmuxinator"
      },
      "args": []
    },
    {
      "namespace": "tmuxinator",
      "resource": "project",
      "action": "stop",
      "description": "Stop a project's tmux session (tmuxinator stop <name>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxinator",
        "baseArgs": ["stop"],
