{
  "name": "tmuxinator",
  "version": "0.1.0",
  "description": "Create and manage complex tmux sessions with YAML project files: windows, panes, layouts, and per-pane commands",
  "source": "https://github.com/tmuxinator/tmuxinator",
  "checks": [
    { "type": "binary", "name": "tmuxinator" }
  ],
  "install_guidance": {
    "plugin": "tmuxinator",
    "binary": "tmuxinator",
    "check": "which tmuxinator",
    "install_steps": [
      "gem install tmuxinator",
      "Verify: tmuxinator version",
      "supercli plugins install ./plugins/tmuxinator --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tmuxinator",
      "resource": "self",
      "action": "version",
      "description": "Print tmuxinator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxinator",
        "baseArgs": ["version"],
        "missingDependencyHelp": "Install tmuxinator: gem install tmuxinator"
      },
      "args": []
    },
    {
      "namespace": "tmuxinator",
      "resource": "project",
      "action": "list",
      "description": "List all tmuxinator projects",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxinator",
        "baseArgs": ["list"],
        "passthrough": true,
        "missingDependencyHelp": "Install tmuxinator: gem install tmuxinator"
      },
      "args": []
    },
    {
      "namespace": "tmuxinator",
      "resource": "project",
      "action": "new",
      "description": "Create a new project YAML (tmuxinator new <name>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "tmuxinator",
        "baseArgs": ["new"],
        "passthrough": true,
        "missingDependencyHelp": "Install tmuxinator: gem install tmuxinator"
      },
      "args": []
    },
    {
      "namespace": "tmuxinator",
      "resource": "project",
      "action": "start",
