{
  "name": "tar",
  "version": "0.1.0",
  "description": "tar — GNU tape archiver for creating and extracting file archives",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "tar"
    }
  ],
  "install_guidance": {
    "plugin": "tar",
    "binary": "tar",
    "check": "which tar",
    "install_steps": [
      "brew install gnu-tar",
      "Verify: tar --version",
      "supercli plugins install ./plugins/tar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tar",
      "resource": "self",
      "action": "version",
      "description": "Print tar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tar: brew install gnu-tar"
      },
      "args": []
    },
    {
      "namespace": "tar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tar",
        "passthrough": true,
        "missingDependencyHelp": "Install tar: brew install gnu-tar"
      },
      "args": []
    }
  ]
}
