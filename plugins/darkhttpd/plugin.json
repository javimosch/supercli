{
  "name": "darkhttpd",
  "version": "1.0.0",
  "description": "darkhttpd \u2014 Simple HTTP server",
  "source": "unix4lyfe.org/darkhttpd",
  "checks": [
    {
      "type": "binary",
      "name": "darkhttpd"
    }
  ],
  "install_guidance": {
    "plugin": "darkhttpd",
    "binary": "darkhttpd",
    "check": "which darkhttpd",
    "install_steps": [
      "# Install darkhttpd",
      "# See unix4lyfe.org/darkhttpd",
      "# apt: sudo apt-get install darkhttpd",
      "# brew: brew install darkhttpd",
      "# cargo: cargo install darkhttpd",
      "# npm: npm install -g darkhttpd",
      "# pip: pip install darkhttpd"
    ]
  },
  "commands": [
    {
      "namespace": "darkhttpd",
      "resource": "darkhttpd",
      "action": "run",
      "description": "Run darkhttpd",
      "adapter": "process",
      "adapterConfig": {
        "command": "darkhttpd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install darkhttpd from unix4lyfe.org/darkhttpd"
      },
      "args": []
    }
  ]
}