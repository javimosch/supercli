{
  "name": "dh_compress",
  "version": "0.1.0",
  "description": "CLI tool: dh_compress",
  "source": "https://packages.debian.org/dh_compress",
  "checks": [{ "type": "binary", "name": "dh_compress" }],
  "install_guidance": {
    "plugin": "dh_compress", "binary": "dh_compress", "check": "which dh_compress",
    "install_steps": ["apt-get install dh_compress 2>/dev/null || which dh_compress", "Verify: dh_compress --version", "supercli plugins install ./plugins/dh_compress --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_compress", "resource": "_", "action": "_",
    "description": "Passthrough to dh_compress CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_compress", "passthrough": true, "missingDependencyHelp": "Install dh_compress: apt-get install dh_compress" }, "args": []
  }]
}
