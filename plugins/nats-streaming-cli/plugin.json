{
  "name": "nats-streaming-cli",
  "version": "0.1.0",
  "description": "Publish & subscribe to NATS Streaming channels.",
  "source": "https://github.com/derhuerst/nats-streaming-cli#nats-streaming-cli",
  "checks": [
    {
      "type": "binary",
      "name": "nats-streaming-cli"
    }
  ],
  "install_guidance": {
    "plugin": "nats-streaming-cli",
    "binary": "nats-streaming-cli",
    "check": "which nats-streaming-cli",
    "install_steps": [
      "Check https://github.com/derhuerst/nats-streaming-cli#nats-streaming-cli for installation instructions",
      "Verify: nats-streaming-cli --version",
      "supercli plugins install ./plugins/nats-streaming-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "nats-streaming-cli",
      "resource": "self",
      "action": "version",
      "description": "Print nats-streaming-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nats-streaming-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nats-streaming-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "nats-streaming-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nats-streaming-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nats-streaming-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install nats-streaming-cli from project repository"
      },
      "args": []
    }
  ]
}