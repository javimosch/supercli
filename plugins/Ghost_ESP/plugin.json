{
  "name": "Ghost_ESP",
  "version": "0.1.0",
  "description": "Ghost ESP is a ESP32 Firmware that Revolutionizes the way we use ESP32 devices in a Pen Testing aspe",
  "source": "https://github.com/Ghost_ESP/Ghost_ESP",
  "checks": [
    {
      "type": "binary",
      "name": "ghost-esp"
    }
  ],
  "install_guidance": {
    "plugin": "Ghost_ESP",
    "binary": "ghost-esp",
    "check": "which ghost-esp",
    "install_steps": [
      "pip install ghost-esp",
      "Verify: ghost-esp --version",
      "supercli plugins install ./plugins/Ghost_ESP --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Ghost_ESP",
      "resource": "self",
      "action": "version",
      "description": "Print Ghost_ESP version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghost-esp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Ghost_ESP: pip install ghost-esp"
      },
      "args": []
    },
    {
      "namespace": "Ghost_ESP",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghost-esp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghost-esp",
        "passthrough": true,
        "missingDependencyHelp": "Install Ghost_ESP: pip install ghost-esp"
      },
      "args": []
    }
  ]
}