{
  "name": "streamlit_paste_clipboard",
  "version": "0.1.0",
  "description": "streamlit component for pasting clipboard images",
  "source": "https://github.com/streamlit_paste_clipboard/streamlit_paste_clipboard",
  "checks": [
    {
      "type": "binary",
      "name": "streamlit_paste_clipboard"
    }
  ],
  "install_guidance": {
    "plugin": "streamlit_paste_clipboard",
    "binary": "streamlit_paste_clipboard",
    "check": "which streamlit_paste_clipboard",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: streamlit_paste_clipboard --version",
      "supercli plugins install ./plugins/streamlit_paste_clipboard --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "streamlit_paste_clipboard",
      "resource": "self",
      "action": "version",
      "description": "Print streamlit_paste_clipboard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "streamlit_paste_clipboard",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install streamlit_paste_clipboard from project repository"
      },
      "args": []
    },
    {
      "namespace": "streamlit_paste_clipboard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to streamlit_paste_clipboard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "streamlit_paste_clipboard",
        "passthrough": true,
        "missingDependencyHelp": "Install streamlit_paste_clipboard from project repository"
      },
      "args": []
    }
  ]
}