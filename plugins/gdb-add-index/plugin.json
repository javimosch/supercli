{
  "name": "gdb-add-index",
  "version": "0.1.0",
  "description": "CLI tool: gdb-add-index",
  "source": "https://manpages.debian.org/gdb-add-index",
  "checks": [
    {
      "type": "binary",
      "name": "gdb-add-index"
    }
  ],
  "install_guidance": {
    "plugin": "gdb-add-index",
    "binary": "gdb-add-index",
    "check": "which gdb-add-index",
    "install_steps": [
      "apt-get install gdb-add-index 2>/dev/null || which gdb-add-index",
      "Verify: gdb-add-index --version",
      "supercli plugins install ./plugins/gdb-add-index --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdb-add-index",
      "resource": "self",
      "action": "version",
      "description": "Print gdb-add-index version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdb-add-index",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdb-add-index: apt-get install gdb-add-index 2>/dev/null || which gdb-add-index"
      },
      "args": []
    },
    {
      "namespace": "gdb-add-index",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdb-add-index CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdb-add-index",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gdb-add-index: apt-get install gdb-add-index 2>/dev/null || which gdb-add-index"
      },
      "args": []
    }
  ]
}