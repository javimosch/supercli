{
  "name": "git",
  "version": "1.0.0",
  "description": "git \u2014 CLI git \u2014 Command-line utility for system administration",
  "source": "https://github.com/search?q=git+cli",
  "checks": [
    {
      "type": "binary",
      "name": "git"
    }
  ],
  "install_guidance": {
    "plugin": "git",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "Install via package manager: apt install git or brew install git"
    ]
  },
  "commands": [
    {
      "namespace": "git",
      "resource": "run",
      "action": "exec",
      "description": "git \u2014 Command-line utility for system administration",
      "adapter": "process",
      "adapterConfig": {
        "command": "git",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install git via package manager"
      },
      "args": []
    }
  ]
}