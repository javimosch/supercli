{
  "name": "htop",
  "version": "0.1.0",
  "description": "Interactive process viewer and system monitor",
  "source": "https://github.com/htop-dev/htop",
  "checks": [{"type": "binary", "name": "htop"}],
  "install_guidance": {
    "plugin": "htop",
    "binary": "htop",
    "check": "which htop",
    "install_steps": [
      "brew install htop",
      "Verify: htop --version",
      "supercli plugins install ./plugins/htop --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "htop",
      "resource": "self",
      "action": "version",
      "description": "Print htop version",
      "adapter": "process",
      "adapterConfig": {"command": "htop", "baseArgs": ["--version"], "missingDependencyHelp": "Install htop: brew install htop"},
      "args": []
    },
    {
      "namespace": "htop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to htop CLI",
      "adapter": "process",
      "adapterConfig": {"command": "htop", "passthrough": true, "missingDependencyHelp": "Install htop: brew install htop"},
      "args": []
    }
  ]
}
