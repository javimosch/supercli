{
  "name": "epubgen",
  "version": "0.1.0",
  "description": "Swift-based generator to create EPUBs from Markdown and CSS",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "epubgen" }],
  "install_guidance": {
    "plugin": "epubgen",
    "binary": "epubgen",
    "check": "which epubgen",
    "install_steps": ["swift build -c release", "Verify: epubgen --version", "supercli plugins install ./plugins/epubgen --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epubgen",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epubgen CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epubgen",
      "passthrough": true,
      "missingDependencyHelp": "Install epubgen: swift build -c release"
    },
    "args": []
  }]
}
