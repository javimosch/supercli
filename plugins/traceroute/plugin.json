{
  "name": "traceroute",
  "version": "0.1.0",
  "description": "Network path tracing and latency measurement",
  "source": "https",
  "checks": [{"type": "binary", "name": "traceroute"}],
  "install_guidance": {
    "plugin": "traceroute",
    "binary": "traceroute",
    "check": "which traceroute",
    "install_steps": [
      "brew install traceroute",
      "Verify: traceroute --version",
      "supercli plugins install ./plugins/traceroute --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "traceroute",
      "resource": "self",
      "action": "version",
      "description": "Print traceroute version",
      "adapter": "process",
      "adapterConfig": {"command": "traceroute", "baseArgs": ["--version"], "missingDependencyHelp": "Install traceroute: brew install traceroute"},
      "args": []
    },
    {
      "namespace": "traceroute",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to traceroute CLI",
      "adapter": "process",
      "adapterConfig": {"command": "traceroute", "passthrough": true, "missingDependencyHelp": "Install traceroute: brew install traceroute"},
      "args": []
    }
  ]
}
