{
  "name": "massdns",
  "version": "0.1.0",
  "description": "High-performance DNS stub resolver",
  "source": "https://github.com/blechschmidt/massdns",
  "checks": [
    {
      "type": "binary",
      "name": "massdns"
    }
  ],
  "install_guidance": {
    "plugin": "massdns",
    "binary": "massdns",
    "check": "which massdns",
    "install_steps": [
      "brew install massdns",
      "Verify: massdns --version",
      "supercli plugins install ./plugins/massdns --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "massdns",
      "resource": "self",
      "action": "version",
      "description": "Print massdns version",
      "adapter": "process",
      "adapterConfig": {
        "command": "massdns",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install massdns: brew install massdns"
      },
      "args": []
    },
    {
      "namespace": "massdns",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to massdns CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "massdns",
        "passthrough": true,
        "missingDependencyHelp": "Install massdns"
      },
      "args": []
    }
  ]
}