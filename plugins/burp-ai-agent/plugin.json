{
  "name": "burp-ai-agent",
  "version": "0.1.0",
  "description": "Burp Suite extension that adds built-in MCP tooling, AI-assisted analysis, privacy controls, passive",
  "source": "https://github.com/burp-ai-agent/burp-ai-agent",
  "checks": [
    {
      "type": "binary",
      "name": "burp-ai-agent"
    }
  ],
  "install_guidance": {
    "plugin": "burp-ai-agent",
    "binary": "burp-ai-agent",
    "check": "which burp-ai-agent",
    "install_steps": [
      "pip install burp-ai-agent",
      "Verify: burp-ai-agent --version",
      "supercli plugins install ./plugins/burp-ai-agent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "burp-ai-agent",
      "resource": "self",
      "action": "version",
      "description": "Print burp-ai-agent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "burp-ai-agent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install burp-ai-agent: pip install burp-ai-agent"
      },
      "args": []
    },
    {
      "namespace": "burp-ai-agent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to burp-ai-agent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "burp-ai-agent",
        "passthrough": true,
        "missingDependencyHelp": "Install burp-ai-agent: pip install burp-ai-agent"
      },
      "args": []
    }
  ]
}