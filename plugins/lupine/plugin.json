{
  "name": "lupine",
  "version": "0.1.0",
  "description": "LUPINE is a GPU over IP bridge allowing GPUs on remote machines to be attached to CPU-only machines.",
  "source": "https://github.com/lupine/lupine",
  "checks": [
    {
      "type": "binary",
      "name": "lupine"
    }
  ],
  "install_guidance": {
    "plugin": "lupine",
    "binary": "lupine",
    "check": "which lupine",
    "install_steps": [
      "pip install lupine",
      "Verify: lupine --version",
      "supercli plugins install ./plugins/lupine --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lupine",
      "resource": "self",
      "action": "version",
      "description": "Print lupine version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lupine",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lupine: pip install lupine"
      },
      "args": []
    },
    {
      "namespace": "lupine",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lupine CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lupine",
        "passthrough": true,
        "missingDependencyHelp": "Install lupine: pip install lupine"
      },
      "args": []
    }
  ]
}