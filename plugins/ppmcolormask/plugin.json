{
  "name": "ppmcolormask",
  "version": "0.1.0",
  "description": "CLI tool: ppmcolormask",
  "source": "https://manpages.debian.org/ppmcolormask",
  "checks": [
    {
      "type": "binary",
      "name": "ppmcolormask"
    }
  ],
  "install_guidance": {
    "plugin": "ppmcolormask",
    "binary": "ppmcolormask",
    "check": "which ppmcolormask",
    "install_steps": [
      "apt-get install ppmcolormask 2>/dev/null || which ppmcolormask",
      "Verify: ppmcolormask --version",
      "supercli plugins install ./plugins/ppmcolormask --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmcolormask",
      "resource": "self",
      "action": "version",
      "description": "Print ppmcolormask version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmcolormask",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmcolormask: apt-get install ppmcolormask 2>/dev/null || which ppmcolormask"
      },
      "args": []
    },
    {
      "namespace": "ppmcolormask",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmcolormask CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmcolormask",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmcolormask: apt-get install ppmcolormask 2>/dev/null || which ppmcolormask"
      },
      "args": []
    }
  ]
}