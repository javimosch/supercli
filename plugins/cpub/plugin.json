{
  "name": "cpub",
  "version": "0.1.0",
  "description": "Lightweight CLI utility for creating EPUB book structures",
  "source": "go",
  "checks": [{ "type": "binary", "name": "cpub" }],
  "install_guidance": {
    "plugin": "cpub",
    "binary": "cpub",
    "check": "which cpub",
    "install_steps": ["go install github.com/udiboy1209/cpub@latest", "Verify: cpub --version", "supercli plugins install ./plugins/cpub --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpub",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cpub CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cpub",
      "passthrough": true,
      "missingDependencyHelp": "Install cpub: go install github.com/udiboy1209/cpub@latest"
    },
    "args": []
  }]
}
