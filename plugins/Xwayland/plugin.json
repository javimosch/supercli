{
  "name": "Xwayland",
  "version": "0.1.0",
  "description": "CLI tool: Xwayland",
  "source": "https://manpages.debian.org/Xwayland",
  "checks": [
    {
      "type": "binary",
      "name": "Xwayland"
    }
  ],
  "install_guidance": {
    "plugin": "Xwayland",
    "binary": "Xwayland",
    "check": "which Xwayland",
    "install_steps": [
      "apt-get install Xwayland 2>/dev/null || which Xwayland",
      "Verify: Xwayland --version",
      "supercli plugins install ./plugins/Xwayland --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Xwayland",
      "resource": "self",
      "action": "version",
      "description": "Print Xwayland version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xwayland",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Xwayland: apt-get install Xwayland 2>/dev/null || which Xwayland"
      },
      "args": []
    },
    {
      "namespace": "Xwayland",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Xwayland CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Xwayland",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install Xwayland: apt-get install Xwayland 2>/dev/null || which Xwayland"
      },
      "args": []
    }
  ]
}