{
  "name": "blame",
  "version": "0.1.0",
  "description": "CLI tool: blame",
  "source": "https://packages.debian.org/blame",
  "checks": [{ "type": "binary", "name": "blame" }],
  "install_guidance": {
    "plugin": "blame", "binary": "blame", "check": "which blame",
    "install_steps": ["apt-get install blame 2>/dev/null || which blame", "Verify: blame --version", "supercli plugins install ./plugins/blame --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "blame", "resource": "_", "action": "_",
    "description": "Passthrough to blame CLI",
    "adapter": "process", "adapterConfig": { "command": "blame", "passthrough": true, "missingDependencyHelp": "Install blame: apt-get install blame" }, "args": []
  }]
}
