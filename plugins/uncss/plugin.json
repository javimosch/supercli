{
  "name": "uncss",
  "version": "0.1.0",
  "description": "Remove unused CSS from stylesheets",
  "source": "https://github.com/uncss/uncss",
  "checks": [
    {
      "type": "binary",
      "name": "uncss"
    }
  ],
  "install_guidance": {
    "plugin": "uncss",
    "binary": "uncss",
    "check": "which uncss",
    "install_steps": [
      "npm install -g uncss",
      "Verify: uncss --version",
      "supercli plugins install ./plugins/uncss --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "uncss",
      "resource": "self",
      "action": "version",
      "description": "Print uncss version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uncss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uncss: npm install -g uncss"
      },
      "args": []
    },
    {
      "namespace": "uncss",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uncss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uncss",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uncss: npm install -g uncss"
      },
      "args": []
    }
  ]
}
