{
  "name": "bf_compact",
  "version": "0.1.0",
  "description": "CLI tool: bf_compact",
  "source": "https://packages.debian.org/bf_compact",
  "checks": [{ "type": "binary", "name": "bf_compact" }],
  "install_guidance": {
    "plugin": "bf_compact", "binary": "bf_compact", "check": "which bf_compact",
    "install_steps": ["apt-get install bf_compact 2>/dev/null || which bf_compact", "Verify: bf_compact --version", "supercli plugins install ./plugins/bf_compact --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bf_compact", "resource": "_", "action": "_",
    "description": "Passthrough to bf_compact CLI",
    "adapter": "process", "adapterConfig": { "command": "bf_compact", "passthrough": true, "missingDependencyHelp": "Install bf_compact: apt-get install bf_compact" }, "args": []
  }]
}
