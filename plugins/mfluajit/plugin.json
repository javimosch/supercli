{
  "name": "mfluajit",
  "version": "0.1.0",
  "description": "CLI tool: mfluajit",
  "source": "https://manpages.debian.org/mfluajit",
  "checks": [
    {
      "type": "binary",
      "name": "mfluajit"
    }
  ],
  "install_guidance": {
    "plugin": "mfluajit",
    "binary": "mfluajit",
    "check": "which mfluajit",
    "install_steps": [
      "apt-get install mfluajit 2>/dev/null || which mfluajit",
      "Verify: mfluajit --version",
      "supercli plugins install ./plugins/mfluajit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mfluajit",
      "resource": "self",
      "action": "version",
      "description": "Print mfluajit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mfluajit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mfluajit: apt-get install mfluajit 2>/dev/null || which mfluajit"
      },
      "args": []
    },
    {
      "namespace": "mfluajit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mfluajit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mfluajit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mfluajit: apt-get install mfluajit 2>/dev/null || which mfluajit"
      },
      "args": []
    }
  ]
}