{
  "name": "pipenv-setup",
  "version": "0.1.0",
  "description": "Sync setup.py dependencies with Pipfile",
  "source": "https://github.com/Madoshakalaka/pipenv-setup",
  "checks": [{ "type": "binary", "name": "pipenv-setup" }],
  "install_guidance": {
    "plugin": "pipenv-setup",
    "binary": "pipenv-setup",
    "check": "which pipenv-setup",
    "install_steps": ["pip install pipenv-setup", "Verify: pipenv-setup --version", "supercli plugins install ./plugins/pipenv-setup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipenv-setup",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipenv-setup CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipenv-setup",
      "passthrough": true,
      "missingDependencyHelp": "Install pipenv-setup: pip install pipenv-setup", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
