{
  "name": "cli-agent-lint",
  "version": "0.1.0",
  "description": "Lint CLI tools for AI agent compatibility — non-interactive auth, JSON output, exit codes",
  "source": "https://github.com/Camil-H/cli-agent-lint",
  "checks": [
    {
      "type": "binary",
      "name": "cli-agent-lint"
    }
  ],
  "install_guidance": {
    "plugin": "cli-agent-lint",
    "binary": "cli-agent-lint",
    "check": "which cli-agent-lint",
    "install_steps": [
      "go install github.com/Camil-H/cli-agent-lint@latest",
      "Verify: cli-agent-lint --version",
      "supercli plugins install ./plugins/cli-agent-lint --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cli-agent-lint",
      "resource": "self",
      "action": "version",
      "description": "Print cli-agent-lint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-agent-lint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-agent-lint: go install github.com/Camil-H/cli-agent-lint@latest"
      },
      "args": []
    },
    {
      "namespace": "cli-agent-lint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-agent-lint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-agent-lint",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-agent-lint: go install github.com/Camil-H/cli-agent-lint@latest"
      },
      "args": []
    }
  ]
}
