{
  "name": "emoji-cli",
  "version": "0.1.0",
  "description": "Emoji completion on command line in Shell",
  "source": "https://github.com/bucchio/emoji-cli",
  "checks": [
    {
      "type": "binary",
      "name": "emoji"
    }
  ],
  "install_guidance": {
    "plugin": "emoji-cli",
    "binary": "emoji",
    "check": "which emoji",
    "install_steps": [
      "npm install -g emoji-cli",
      "Verify: emoji --version",
      "supercli plugins install ./plugins/emoji-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "emoji-cli",
      "resource": "self",
      "action": "version",
      "description": "Print emoji-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "emoji",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install emoji-cli: npm install -g emoji-cli"
      },
      "args": []
    },
    {
      "namespace": "emoji-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to emoji-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "emoji",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install emoji-cli: npm install -g emoji-cli"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
