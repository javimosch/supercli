{
  "name": "m4",
  "version": "0.1.0",
  "description": "CLI tool: m4",
  "source": "https://manpages.debian.org/m4",
  "checks": [
    {
      "type": "binary",
      "name": "m4"
    }
  ],
  "install_guidance": {
    "plugin": "m4",
    "binary": "m4",
    "check": "which m4",
    "install_steps": [
      "apt-get install m4 2>/dev/null || which m4",
      "Verify: m4 --version",
      "supercli plugins install ./plugins/m4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "m4",
      "resource": "self",
      "action": "version",
      "description": "Print m4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "m4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install m4: apt-get install m4 2>/dev/null || which m4"
      },
      "args": []
    },
    {
      "namespace": "m4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to m4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "m4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install m4: apt-get install m4 2>/dev/null || which m4"
      },
      "args": []
    }
  ]
}