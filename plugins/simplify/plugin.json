{
  "name": "simplify",
  "version": "0.1.0",
  "description": "simplify — Android APK deobfuscator",
  "source": "https://github.com/CalebFenton/simplify",
  "checks": [
    {
      "type": "binary",
      "name": "simplify"
    }
  ],
  "install_guidance": {
    "plugin": "simplify",
    "binary": "simplify",
    "check": "which simplify",
    "install_steps": [
      "pip install simplify",
      "Verify: simplify --version",
      "supercli plugins install ./plugins/simplify --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "simplify",
      "resource": "self",
      "action": "version",
      "description": "Print simplify version",
      "adapter": "process",
      "adapterConfig": {
        "command": "simplify",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install simplify: pip install simplify"
      },
      "args": []
    },
    {
      "namespace": "simplify",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to simplify CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "simplify",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install simplify: pip install simplify"
      },
      "args": []
    }
  ]
}
