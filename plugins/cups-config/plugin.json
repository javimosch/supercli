{
  "name": "cups-config",
  "version": "0.1.0",
  "description": "CLI tool: cups-config",
  "source": "https://packages.debian.org/cups-config",
  "checks": [{ "type": "binary", "name": "cups-config" }],
  "install_guidance": {
    "plugin": "cups-config", "binary": "cups-config", "check": "which cups-config",
    "install_steps": ["apt-get install cups-config 2>/dev/null || which cups-config", "Verify: cups-config --version", "supercli plugins install ./plugins/cups-config --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cups-config", "resource": "_", "action": "_",
    "description": "Passthrough to cups-config CLI",
    "adapter": "process", "adapterConfig": { "command": "cups-config", "passthrough": true, "missingDependencyHelp": "Install cups-config: apt-get install cups-config" }, "args": []
  }]
}
