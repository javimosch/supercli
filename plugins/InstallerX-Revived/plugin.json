{
  "name": "InstallerX-Revived",
  "version": "0.1.0",
  "description": "More Expressive InstallerX !",
  "source": "https://github.com/InstallerX-Revived/InstallerX-Revived",
  "checks": [
    {
      "type": "binary",
      "name": "installerx-revived"
    }
  ],
  "install_guidance": {
    "plugin": "InstallerX-Revived",
    "binary": "installerx-revived",
    "check": "which installerx-revived",
    "install_steps": [
      "pip install installerx-revived",
      "Verify: installerx-revived --version",
      "supercli plugins install ./plugins/InstallerX-Revived --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "InstallerX-Revived",
      "resource": "self",
      "action": "version",
      "description": "Print InstallerX-Revived version",
      "adapter": "process",
      "adapterConfig": {
        "command": "installerx-revived",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install InstallerX-Revived: pip install installerx-revived"
      },
      "args": []
    },
    {
      "namespace": "InstallerX-Revived",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to installerx-revived CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "installerx-revived",
        "passthrough": true,
        "missingDependencyHelp": "Install InstallerX-Revived: pip install installerx-revived"
      },
      "args": []
    }
  ]
}