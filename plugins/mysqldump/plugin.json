{
  "name": "mysqldump",
  "version": "0.1.0",
  "description": "mysqldump \u2014 a database backup program (mysqldump is now a symlink to mariadb-dump)",
  "source": "https://packages.debian.org/mysqldump",
  "checks": [{ "type": "binary", "name": "mysqldump" }],
  "install_guidance": {
    "plugin": "mysqldump", "binary": "mysqldump", "check": "which mysqldump",
    "install_steps": ["apt-get install mysql-client", "Verify: mysqldump --version", "supercli plugins install ./plugins/mysqldump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mysqldump", "resource": "_", "action": "_",
    "description": "Passthrough to mysqldump CLI",
    "adapter": "process", "adapterConfig": { "command": "mysqldump", "passthrough": true, "missingDependencyHelp": "Install mysqldump: apt-get install mysql-client" }, "args": []
  }]
}
