{
  "name": "lpr",
  "version": "0.1.0",
  "description": "Submit print jobs",
  "source": "https://packages.debian.org/lpr",
  "checks": [{ "type": "binary", "name": "lpr" }],
  "install_guidance": {
    "plugin": "lpr", "binary": "lpr", "check": "which lpr",
    "install_steps": ["apt-get install cups-bsd", "Verify: lpr --version", "supercli plugins install ./plugins/lpr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lpr", "resource": "_", "action": "_",
    "description": "Passthrough to lpr CLI",
    "adapter": "process", "adapterConfig": { "command": "lpr", "passthrough": true, "missingDependencyHelp": "Install lpr: apt-get install cups-bsd" }, "args": []
  }]
}
