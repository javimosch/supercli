{
  "name": "pk1sign",
  "version": "0.1.0",
  "description": "CLI tool: pk1sign",
  "source": "https://manpages.debian.org/pk1sign",
  "checks": [
    {
      "type": "binary",
      "name": "pk1sign"
    }
  ],
  "install_guidance": {
    "plugin": "pk1sign",
    "binary": "pk1sign",
    "check": "which pk1sign",
    "install_steps": [
      "apt-get install pk1sign 2>/dev/null || which pk1sign",
      "Verify: pk1sign --version",
      "supercli plugins install ./plugins/pk1sign --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pk1sign",
      "resource": "self",
      "action": "version",
      "description": "Print pk1sign version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pk1sign",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pk1sign: apt-get install pk1sign 2>/dev/null || which pk1sign"
      },
      "args": []
    },
    {
      "namespace": "pk1sign",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pk1sign CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pk1sign",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pk1sign: apt-get install pk1sign 2>/dev/null || which pk1sign"
      },
      "args": []
    }
  ]
}