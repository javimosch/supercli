{
  "name": "phxqueue",
  "version": "0.1.0",
  "description": "High-availability distributed queue based on Paxos protocol",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "phxqueue" }],
  "install_guidance": {
    "plugin": "phxqueue",
    "binary": "phxqueue",
    "check": "which phxqueue",
    "install_steps": ["cmake . && make", "Verify: phxqueue --version", "supercli plugins install ./plugins/phxqueue --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "phxqueue",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to phxqueue CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "phxqueue",
      "passthrough": true,
      "missingDependencyHelp": "Install phxqueue: cmake . && make"
    },
    "args": []
  }]
}
