{
  "name": "bluetoothctl",
  "version": "0.1.0",
  "description": "CLI tool: bluetoothctl",
  "source": "https://packages.debian.org/bluetoothctl",
  "checks": [{ "type": "binary", "name": "bluetoothctl" }],
  "install_guidance": {
    "plugin": "bluetoothctl", "binary": "bluetoothctl", "check": "which bluetoothctl",
    "install_steps": ["apt-get install bluetoothctl 2>/dev/null || which bluetoothctl", "Verify: bluetoothctl --version", "supercli plugins install ./plugins/bluetoothctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bluetoothctl", "resource": "_", "action": "_",
    "description": "Passthrough to bluetoothctl CLI",
    "adapter": "process", "adapterConfig": { "command": "bluetoothctl", "passthrough": true, "missingDependencyHelp": "Install bluetoothctl: apt-get install bluetoothctl" }, "args": []
  }]
}
