{
  "name": "mda-spec",
  "version": "0.1.0",
  "description": "MDA Open Spec — Markdown superset for agent-facing documents, compiles to SKILL.md, AGENTS.md, MCP-SERVER.md, CLAUDE.md",
  "source": "https://github.com/sno-ai/mda",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "mda-spec",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/sno-ai/mda.git",
      "supercli plugins install ./plugins/mda-spec --on-conflict replace --json",
      "sc skills teach mda-spec:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "mda-spec", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["mda-spec v0.1.0 — Use sc skills teach mda-spec:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/sno-ai/mda.git" }, "args": [] },
    { "namespace": "mda-spec", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/sno-ai/mda.git then: sc skills teach mda-spec:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/sno-ai/mda.git" }, "args": [] }
  ]
}
