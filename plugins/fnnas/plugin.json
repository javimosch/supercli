{
  "name": "fnnas",
  "version": "0.1.0",
  "description": "Supports running FnNAS on Amlogic, Allwinner, and Rockchip devices. Support a311d, s922x, s905x3, s9",
  "source": "https://github.com/fnnas/fnnas",
  "checks": [
    {
      "type": "binary",
      "name": "fnnas"
    }
  ],
  "install_guidance": {
    "plugin": "fnnas",
    "binary": "fnnas",
    "check": "which fnnas",
    "install_steps": [
      "pip install fnnas",
      "Verify: fnnas --version",
      "supercli plugins install ./plugins/fnnas --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fnnas",
      "resource": "self",
      "action": "version",
      "description": "Print fnnas version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fnnas",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fnnas: pip install fnnas"
      },
      "args": []
    },
    {
      "namespace": "fnnas",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fnnas CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fnnas",
        "passthrough": true,
        "missingDependencyHelp": "Install fnnas: pip install fnnas"
      },
      "args": []
    }
  ]
}