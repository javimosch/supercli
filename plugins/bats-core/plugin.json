{
  "name": "bats-core",
  "version": "0.1.0",
  "description": "Bash Automated Testing System",
  "source": "https://github.com/bats-core/bats-core",
  "checks": [
    {
      "type": "binary",
      "name": "bats-core"
    }
  ],
  "install_guidance": {
    "plugin": "bats-core",
    "binary": "bats-core",
    "check": "which bats-core",
    "install_steps": [
      "brew install bats-core",
      "Verify: bats-core --version",
      "supercli plugins install ./plugins/bats-core --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bats-core",
      "resource": "self",
      "action": "version",
      "description": "Print bats-core version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bats-core",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bats-core: brew install bats-core"
      },
      "args": []
    },
    {
      "namespace": "bats-core",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bats-core CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bats-core",
        "passthrough": true,
        "missingDependencyHelp": "Install bats-core"
      },
      "args": []
    }
  ]
}