{
  "name": "weaver",
  "version": "0.1.0",
  "description": "Programming framework for writing and deploying cloud applications.",
  "source": "https://github.com/weaver/weaver",
  "checks": [
    {
      "type": "binary",
      "name": "weaver"
    }
  ],
  "install_guidance": {
    "plugin": "weaver",
    "binary": "weaver",
    "check": "which weaver",
    "install_steps": [
      "pip install weaver",
      "Verify: weaver --version",
      "supercli plugins install ./plugins/weaver --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "weaver",
      "resource": "self",
      "action": "version",
      "description": "Print weaver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "weaver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install weaver: pip install weaver"
      },
      "args": []
    },
    {
      "namespace": "weaver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to weaver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "weaver",
        "passthrough": true,
        "missingDependencyHelp": "Install weaver: pip install weaver"
      },
      "args": []
    }
  ]
}