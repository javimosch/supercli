{
  "name": "py-spy",
  "version": "0.1.0",
  "description": "Sampling profiler for Python programs. Generate flame graphs, speedscope, and raw JSON output. Non-interactive, scriptable.",
  "source": "https",
  "checks": [{"type": "binary", "name": "py-spy"}],
  "install_guidance": {
    "plugin": "py-spy",
    "binary": "py-spy",
    "check": "which py-spy",
    "install_steps": [
      "brew install py-spy",
      "Verify: py-spy --version",
      "supercli plugins install ./plugins/py-spy --on-conflict replace --json"
    ],
    "note": "Non-interactive CLI tool."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "py",
      "resource": "self",
      "action": "version",
      "description": "Print py-spy version",
      "adapter": "process",
      "adapterConfig": {"command": "py-spy", "baseArgs": ["--version"], "missingDependencyHelp": "Install py-spy: brew install py-spy"},
      "args": []
    },
    {
      "namespace": "py",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to py-spy CLI",
      "adapter": "process",
      "adapterConfig": {"command": "py-spy", "passthrough": true, "missingDependencyHelp": "Install py-spy: brew install py-spy"},
      "args": []
    }
  ]
}
