{
  "name": "pokete",
  "version": "0.1.0",
  "description": "Terminal-based Pokemon-like adventure game with catching, battles, quests, and an explorable ASCII world",
  "source": "https://github.com/lxgr-linux/pokete",
  "checks": [
    { "type": "binary", "name": "pokete" }
  ],
  "install_guidance": {
    "plugin": "pokete",
    "binary": "pokete",
    "check": "which pokete",
    "install_steps": [
      "pip install pokete (or: pipx install pokete)",
      "Verify: pokete --help",
      "supercli plugins install ./plugins/pokete --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pokete",
      "resource": "self",
      "action": "help",
      "description": "Show pokete CLI options (--no_audio, --load_mods, etc.)",
      "adapter": "process",
      "adapterConfig": {
        "command": "pokete",
        "baseArgs": ["--help"],
        "missingDependencyHelp": "Install pokete: pip install pokete or pipx install pokete"
      },
      "args": []
    },
    {
      "namespace": "pokete",
      "resource": "game",
      "action": "play",
      "description": "Start the game (interactive TUI). Pass --no_audio to disable sound; needs a real terminal, not a pipe",
      "adapter": "process",
      "adapterConfig": {
        "command": "pokete",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install pokete: pip install pokete or pipx install pokete"
      },
      "args": []
    },
    {
      "namespace": "pokete",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pokete CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pokete",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install pokete: pip install pokete or pipx install pokete"
      },
      "args": []
    }
  ]
}
