{
  "plugin": "gcov-dump-8",
  "binary": "gcov-dump-8",
  "check": "which gcov-dump-8",
  "install_steps": [
    "apt-get install gcov-dump-8 2>/dev/null || which gcov-dump-8",
    "Verify: gcov-dump-8 --version",
    "supercli plugins install ./plugins/gcov-dump-8 --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}