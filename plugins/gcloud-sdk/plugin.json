{
  "name": "gcloud-sdk",
  "version": "0.1.0",
  "description": "Google Cloud SDK — command-line tools for Google Cloud Platform",
  "source": "https://cloud.google.com/sdk",
  "checks": [
    {
      "type": "binary",
      "name": "gcloud"
    }
  ],
  "install_guidance": {
    "plugin": "gcloud-sdk",
    "binary": "gcloud",
    "check": "which gcloud",
    "install_steps": [
      "brew install --cask google-cloud-sdk",
      "Verify: gcloud --version",
      "supercli plugins install ./plugins/gcloud-sdk --on-conflict replace --json"
    ],
    "note": "The Google Cloud SDK binary is `gcloud` (also installs `gsutil` and `bq`)."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gcloud-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print gcloud-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcloud",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install gcloud-sdk: brew install --cask google-cloud-sdk"
      },
      "args": []
    },
    {
      "namespace": "gcloud-sdk",
      "resource": "cli",
      "action": "run",
      "description": "Google Cloud SDK — command-line tools for Google Cloud Platform",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcloud",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gcloud-sdk: brew install --cask google-cloud-sdk"
      },
      "args": []
    }
  ]
}
