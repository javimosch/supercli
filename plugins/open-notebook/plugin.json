{
  "name": "open-notebook",
  "version": "0.1.0",
  "description": "An Open Source implementation of Notebook LM with more flexibility and features",
  "source": "https://github.com/open-notebook/open-notebook",
  "checks": [
    {
      "type": "binary",
      "name": "open-notebook"
    }
  ],
  "install_guidance": {
    "plugin": "open-notebook",
    "binary": "open-notebook",
    "check": "which open-notebook",
    "install_steps": [
      "pip install open-notebook",
      "Verify: open-notebook --version",
      "supercli plugins install ./plugins/open-notebook --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "open-notebook",
      "resource": "self",
      "action": "version",
      "description": "Print open-notebook version",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-notebook",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install open-notebook: pip install open-notebook"
      },
      "args": []
    },
    {
      "namespace": "open-notebook",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to open-notebook CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-notebook",
        "passthrough": true,
        "missingDependencyHelp": "Install open-notebook: pip install open-notebook"
      },
      "args": []
    }
  ]
}