{
  "name": "wmctrl",
  "version": "0.1.0",
  "description": "Window manager control CLI",
  "source": "https://packages.debian.org/wmctrl",
  "checks": [{ "type": "binary", "name": "wmctrl" }],
  "install_guidance": {
    "plugin": "wmctrl", "binary": "wmctrl", "check": "which wmctrl",
    "install_steps": ["apt-get install wmctrl", "Verify: wmctrl --version", "supercli plugins install ./plugins/wmctrl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wmctrl", "resource": "_", "action": "_",
    "description": "Passthrough to wmctrl CLI",
    "adapter": "process", "adapterConfig": { "command": "wmctrl", "passthrough": true, "missingDependencyHelp": "Install wmctrl: apt-get install wmctrl" }, "args": []
  }]
}
