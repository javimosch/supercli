{
  "name": "batt-stat",
  "version": "0.1.0",
  "description": "Display detailed battery status and health information",
  "source": "https://github.com/batt-stat/batt-stat",
  "checks": [{ "type": "binary", "name": "batt-stat" }],
  "install_guidance": {
    "plugin": "batt-stat",
    "binary": "batt-stat",
    "check": "which batt-stat",
    "install_steps": ["brew install batt-stat", "Verify: batt-stat --version", "supercli plugins install ./plugins/batt-stat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "batt-stat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to batt-stat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "batt-stat",
      "passthrough": true,
      "missingDependencyHelp": "Install batt-stat: brew install batt-stat", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
