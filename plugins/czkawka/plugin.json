{
  "name": "czkawka",
  "version": "0.1.0",
  "description": "czkawka \u2014 duplicate file finder, empty folders, similar images, and more.",
  "source": "https://github.com/qarmin/czkawka",
  "checks": [
    {
      "type": "binary",
      "name": "czkawka"
    }
  ],
  "install_guidance": {
    "plugin": "czkawka",
    "binary": "czkawka",
    "check": "which czkawka",
    "install_steps": [
      "cargo install czkawka",
      "sudo snap install czkawka",
      "brew install czkawka",
      "supercli plugins install ./plugins/czkawka --on-conflict replace --json"
    ],
    "note": "Rust. Duplicate file finder."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "czkawka",
      "resource": "dup",
      "action": "find",
      "description": "Find duplicate files in directory",
      "adapter": "process",
      "adapterConfig": {
        "command": "czkawka",
        "missingDependencyHelp": "Install czkawka",
        "baseArgs": [
          "dup"
        ],
        "positionalArgs": [
          "directory"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "directory path"
        }
      ]
    },
    {
      "namespace": "czkawka",
      "resource": "empty",
      "action": "find",
      "description": "Find empty folders",
      "adapter": "process",
      "adapterConfig": {
        "command": "czkawka",
        "missingDependencyHelp": "Install czkawka",
        "baseArgs": [
          "empty"
        ],
        "positionalArgs": [
          "directory"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "directory path"
        }
      ]
    },
    {
      "namespace": "czkawka",
      "resource": "image",
      "action": "similar",
      "description": "Find similar images",
      "adapter": "process",
      "adapterConfig": {
        "command": "czkawka",
        "missingDependencyHelp": "Install czkawka",
        "baseArgs": [
          "image"
        ],
        "positionalArgs": [
          "directory"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "directory",
          "type": "string",
          "required": true,
          "description": "directory path"
        }
      ]
    },
    {
      "namespace": "czkawka",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "czkawka",
        "missingDependencyHelp": "Install czkawka",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
