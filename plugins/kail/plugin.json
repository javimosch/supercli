{
  "name": "kail",
  "version": "0.1.0",
  "description": "Kubernetes log viewer with pod and container filtering",
  "source": "https://github.com/boz/kail",
  "checks": [{ "type": "binary", "name": "kail" }],
  "install_guidance": {
    "plugin": "kail",
    "binary": "kail",
    "check": "which kail",
    "install_steps": ["brew install kail", "Verify: kail --version", "supercli plugins install ./plugins/kail --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kail",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kail CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kail",
      "passthrough": true,
      "missingDependencyHelp": "Install kail: brew install kail"
    },
    "args": []
  }]
}
