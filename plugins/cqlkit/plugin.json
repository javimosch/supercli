{
  "name": "cqlkit",
  "version": "0.1.0",
  "description": "CLI tool to export Cassandra query as CSV and JSON format",
  "source": "https://github.com/tenmax/cqlkit",
  "checks": [
    {
      "type": "binary",
      "name": "cqlkit"
    }
  ],
  "install_guidance": {
    "plugin": "cqlkit",
    "binary": "cqlkit",
    "check": "which cqlkit",
    "install_steps": [
      "brew install cqlkit",
      "Verify: cqlkit --version",
      "supercli plugins install ./plugins/cqlkit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cqlkit",
      "resource": "self",
      "action": "version",
      "description": "Print cqlkit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cqlkit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cqlkit: brew install cqlkit"
      },
      "args": []
    },
    {
      "namespace": "cqlkit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cqlkit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cqlkit",
        "passthrough": true,
        "missingDependencyHelp": "Install cqlkit"
      },
      "args": []
    }
  ]
}