{
  "name": "gtstemplate",
  "version": "0.1.0",
  "description": "CLI tool: gtstemplate",
  "source": "https://manpages.debian.org/gtstemplate",
  "checks": [
    {
      "type": "binary",
      "name": "gtstemplate"
    }
  ],
  "install_guidance": {
    "plugin": "gtstemplate",
    "binary": "gtstemplate",
    "check": "which gtstemplate",
    "install_steps": [
      "apt-get install gtstemplate 2>/dev/null || which gtstemplate",
      "Verify: gtstemplate --version",
      "supercli plugins install ./plugins/gtstemplate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gtstemplate",
      "resource": "self",
      "action": "version",
      "description": "Print gtstemplate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtstemplate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtstemplate: apt-get install gtstemplate 2>/dev/null || which gtstemplate"
      },
      "args": []
    },
    {
      "namespace": "gtstemplate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtstemplate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtstemplate",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gtstemplate: apt-get install gtstemplate 2>/dev/null || which gtstemplate"
      },
      "args": []
    }
  ]
}