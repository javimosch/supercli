{
  "name": "xorriso",
  "version": "0.1.0",
  "description": "Create, manipulate, and burn ISO 9660 filesystem images",
  "source": "https://github.com/search/xorriso",
  "checks": [{ "type": "binary", "name": "xorriso" }],
  "install_guidance": {
    "plugin": "xorriso",
    "binary": "xorriso",
    "check": "which xorriso",
    "install_steps": ["brew install xorriso", "Verify: xorriso --version", "supercli plugins install ./plugins/xorriso --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "xorriso",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to xorriso CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "xorriso",
      "passthrough": true,
      "missingDependencyHelp": "Install xorriso: brew install xorriso"
    },
    "args": []
  }]
}
