{
  "name": "xorriso",
  "version": "0.1.0",
  "description": "ISO/CD image creation and manipulation tool",
  "source": "https://github.com/ktemkin/xorriso",
  "checks": [
    {
      "type": "binary",
      "name": "xorriso"
    }
  ],
  "install_guidance": {
    "plugin": "xorriso",
    "binary": "xorriso",
    "check": "which xorriso",
    "install_steps": [
      "brew install xorriso",
      "Verify: xorriso --version",
      "supercli plugins install ./plugins/xorriso --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "xorriso",
      "resource": "self",
      "action": "version",
      "description": "Print xorriso version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xorriso",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xorriso: brew install xorriso"
      },
      "args": []
    },
    {
      "namespace": "xorriso",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xorriso CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xorriso",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xorriso: brew install xorriso"
      },
      "args": []
    }
  ]
}
