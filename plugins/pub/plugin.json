{
  "name": "pub",
  "version": "0.1.0",
  "description": "Dart package manager",
  "source": "https://packages.debian.org/pub",
  "checks": [{ "type": "binary", "name": "pub" }],
  "install_guidance": {
    "plugin": "pub", "binary": "pub", "check": "which pub",
    "install_steps": ["apt-get install dart", "Verify: pub --version", "supercli plugins install ./plugins/pub --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pub", "resource": "_", "action": "_",
    "description": "Passthrough to pub CLI",
    "adapter": "process", "adapterConfig": { "command": "pub", "passthrough": true, "missingDependencyHelp": "Install pub: apt-get install dart" }, "args": []
  }]
}
