{
  "name": "papis",
  "version": "0.1.0",
  "description": "Extensible document and bibliography manager",
  "source": "https://github.com/papis/papis",
  "checks": [
    {
      "type": "binary",
      "name": "papis"
    }
  ],
  "install_guidance": {
    "plugin": "papis",
    "binary": "papis",
    "check": "which papis",
    "install_steps": [
      "brew install papis",
      "Verify: papis --version",
      "supercli plugins install ./plugins/papis --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "papis",
      "resource": "self",
      "action": "version",
      "description": "Print papis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "papis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install papis: brew install papis"
      },
      "args": []
    },
    {
      "namespace": "papis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to papis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "papis",
        "passthrough": true,
        "missingDependencyHelp": "Install papis"
      },
      "args": []
    }
  ]
}