{
  "name": "javap",
  "version": "0.1.0",
  "description": "CLI tool: javap",
  "source": "https://manpages.debian.org/javap",
  "checks": [
    {
      "type": "binary",
      "name": "javap"
    }
  ],
  "install_guidance": {
    "plugin": "javap",
    "binary": "javap",
    "check": "which javap",
    "install_steps": [
      "apt-get install javap 2>/dev/null || which javap",
      "Verify: javap --version",
      "supercli plugins install ./plugins/javap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "javap",
      "resource": "self",
      "action": "version",
      "description": "Print javap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "javap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install javap: apt-get install javap 2>/dev/null || which javap"
      },
      "args": []
    },
    {
      "namespace": "javap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to javap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "javap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install javap: apt-get install javap 2>/dev/null || which javap"
      },
      "args": []
    }
  ]
}