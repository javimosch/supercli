{
  "name": "inetutils",
  "version": "0.1.0",
  "description": "GNU utilities for networking",
  "checks": [
    {
      "type": "binary",
      "name": "inetutils"
    }
  ],
  "install_guidance": {
    "plugin": "inetutils",
    "binary": "inetutils",
    "check": "which inetutils",
    "install_steps": [
      "brew install inetutils",
      "Verify: inetutils --version",
      "supercli plugins install ./plugins/inetutils --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "inetutils",
      "resource": "self",
      "action": "version",
      "description": "Print inetutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "inetutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install inetutils: brew install inetutils"
      },
      "args": []
    },
    {
      "namespace": "inetutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to inetutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "inetutils",
        "passthrough": true,
        "missingDependencyHelp": "Install inetutils"
      },
      "args": []
    }
  ]
}