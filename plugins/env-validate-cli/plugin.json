{
  "name": "env-validate-cli",
  "version": "0.1.0",
  "description": "A .env file validator and linter. Checks environment variable files for duplicates, missing values, and formatting issues in CI/CD pipelines.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "env-validate-cli"
    }
  ],
  "install_guidance": {
    "plugin": "env-validate-cli",
    "binary": "env-validate-cli",
    "check": "which env-validate-cli",
    "install_steps": [
      "cargo install env-validate-cli",
      "Verify: env-validate-cli --version",
      "supercli plugins install ./plugins/env-validate-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "env-validate-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to env-validate-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "env-validate-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install env-validate-cli: cargo install env-validate-cli"
      },
      "args": []
    }
  ]
}
