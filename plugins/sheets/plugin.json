{
  "name": "sheets",
  "version": "0.1.0",
  "description": "Terminal-based spreadsheet viewer and editor",
  "source": "https://github.com/nicholasgasior/sheets",
  "checks": [
    {
      "type": "binary",
      "name": "sheets"
    }
  ],
  "install_guidance": {
    "plugin": "sheets",
    "binary": "sheets",
    "check": "which sheets",
    "install_steps": [
      "go install github.com/nicholasgasior/sheets@latest",
      "Verify: sheets --version",
      "supercli plugins install ./plugins/sheets --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sheets",
      "resource": "self",
      "action": "version",
      "description": "Print sheets version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sheets",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sheets: go install github.com/nicholasgasior/sheets@latest"
      },
      "args": []
    },
    {
      "namespace": "sheets",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sheets CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sheets",
        "passthrough": true,
        "missingDependencyHelp": "Install sheets: go install github.com/nicholasgasior/sheets@latest"
      },
      "args": []
    }
  ]
}
