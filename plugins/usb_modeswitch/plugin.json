{
  "name": "usb_modeswitch",
  "version": "0.1.0",
  "description": "CLI tool: usb_modeswitch",
  "source": "https://manpages.debian.org/usb_modeswitch",
  "checks": [
    {
      "type": "binary",
      "name": "usb_modeswitch"
    }
  ],
  "install_guidance": {
    "plugin": "usb_modeswitch",
    "binary": "usb_modeswitch",
    "check": "which usb_modeswitch",
    "install_steps": [
      "apt-get install usb_modeswitch 2>/dev/null || which usb_modeswitch",
      "Verify: usb_modeswitch --version",
      "supercli plugins install ./plugins/usb_modeswitch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "usb_modeswitch",
      "resource": "self",
      "action": "version",
      "description": "Print usb_modeswitch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "usb_modeswitch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install usb_modeswitch: apt-get install usb_modeswitch 2>/dev/null || which usb_modeswitch"
      },
      "args": []
    },
    {
      "namespace": "usb_modeswitch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to usb_modeswitch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "usb_modeswitch",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install usb_modeswitch: apt-get install usb_modeswitch 2>/dev/null || which usb_modeswitch"
      },
      "args": []
    }
  ]
}