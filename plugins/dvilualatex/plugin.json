{
  "name": "dvilualatex",
  "version": "0.1.0",
  "description": "CLI tool: dvilualatex",
  "source": "https://manpages.debian.org/dvilualatex",
  "checks": [
    {
      "type": "binary",
      "name": "dvilualatex"
    }
  ],
  "install_guidance": {
    "plugin": "dvilualatex",
    "binary": "dvilualatex",
    "check": "which dvilualatex",
    "install_steps": [
      "apt-get install dvilualatex 2>/dev/null || which dvilualatex",
      "Verify: dvilualatex --version",
      "supercli plugins install ./plugins/dvilualatex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvilualatex",
      "resource": "self",
      "action": "version",
      "description": "Print dvilualatex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilualatex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvilualatex: apt-get install dvilualatex 2>/dev/null || which dvilualatex"
      },
      "args": []
    },
    {
      "namespace": "dvilualatex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvilualatex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvilualatex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvilualatex: apt-get install dvilualatex 2>/dev/null || which dvilualatex"
      },
      "args": []
    }
  ]
}