{
  "name": "repo-radar",
  "version": "0.1.0",
  "description": "Real-time GitHub trend detector in Rust — monitors trending repos and detects exposed secrets",
  "source": "https://github.com/verysleepylemon/repo-radar",
  "checks": [
    {
      "type": "binary",
      "name": "repo-radar"
    }
  ],
  "install_guidance": {
    "plugin": "repo-radar",
    "binary": "repo-radar",
    "check": "which repo-radar",
    "install_steps": [
      "cargo install repo-radar",
      "Verify: repo-radar --version",
      "supercli plugins install ./plugins/repo-radar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "repo-radar",
      "resource": "self",
      "action": "version",
      "description": "Print repo-radar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "repo-radar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install repo-radar: cargo install repo-radar"
      },
      "args": []
    },
    {
      "namespace": "repo-radar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to repo-radar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "repo-radar",
        "passthrough": true,
        "missingDependencyHelp": "Install repo-radar: cargo install repo-radar"
      },
      "args": []
    }
  ]
}
