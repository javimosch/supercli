{
  "name": "apngasm",
  "version": "0.1.0",
  "description": "Assemble animated PNG files from individual image frames",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "apngasm" }],
  "install_guidance": {
    "plugin": "apngasm",
    "binary": "apngasm",
    "check": "which apngasm",
    "install_steps": ["git clone && make", "Verify: apngasm --version", "supercli plugins install ./plugins/apngasm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apngasm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to apngasm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "apngasm",
      "passthrough": true,
      "missingDependencyHelp": "Install apngasm: git clone && make"
    },
    "args": []
  }]
}
