  "commands": [{
    "namespace": "at_decompress", "resource": "_", "action": "_",
    "description": "Passthrough to at_decompress CLI",
    "adapter": "process", "adapterConfig": { "command": "at_decompress", "passthrough": true, "missingDependencyHelp": "Install at_decompress: apt-get install at_decompress" }, "args": []
  }]
}
