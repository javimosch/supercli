{
  "name": "at_decompress",
  "version": "0.1.0",
  "description": "CLI tool: at_decompress",
  "source": "https://packages.debian.org/at_decompress",
  "checks": [{ "type": "binary", "name": "at_decompress" }],
  "install_guidance": {
    "plugin": "at_decompress", "binary": "at_decompress", "check": "which at_decompress",
    "install_steps": ["apt-get install at_decompress 2>/dev/null || which at_decompress", "Verify: at_decompress --version", "supercli plugins install ./plugins/at_decompress --on-conflict replace --json"]
