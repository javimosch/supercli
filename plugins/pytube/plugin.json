{
  "name": "pytube",
  "version": "0.1.0",
  "description": "Lightweight YouTube downloader in Python",
  "source": "https://github.com/nicedoc/pytube",
  "checks": [
    {
      "type": "binary",
      "name": "pytube"
    }
  ],
  "install_guidance": {
    "plugin": "pytube",
    "binary": "pytube",
    "check": "which pytube",
    "install_steps": [
      "pip install pytube",
      "Verify: pytube --version",
      "supercli plugins install ./plugins/pytube --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pytube",
      "resource": "self",
      "action": "version",
      "description": "Print pytube version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pytube",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pytube: pip install pytube"
      },
      "args": []
    },
    {
      "namespace": "pytube",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pytube CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pytube",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pytube: pip install pytube"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
