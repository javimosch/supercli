{
  "name": "3FS",
  "version": "0.1.0",
  "description": " A high-performance distributed file system designed to address the challenges of AI training and in",
  "source": "https://github.com/3FS/3FS",
  "checks": [
    {
      "type": "binary",
      "name": "3fs"
    }
  ],
  "install_guidance": {
    "plugin": "3FS",
    "binary": "3fs",
    "check": "which 3fs",
    "install_steps": [
      "pip install 3fs",
      "Verify: 3fs --version",
      "supercli plugins install ./plugins/3FS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "3FS",
      "resource": "self",
      "action": "version",
      "description": "Print 3FS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "3fs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install 3FS: pip install 3fs"
      },
      "args": []
    },
    {
      "namespace": "3FS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to 3fs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "3fs",
        "passthrough": true,
        "missingDependencyHelp": "Install 3FS: pip install 3fs"
      },
      "args": []
    }
  ]
}