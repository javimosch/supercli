{
  "name": "pure",
  "version": "0.1.0",
  "description": "Very minimal aesthetic prompt customization for Zsh",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "pure" }],
  "install_guidance": {
    "plugin": "pure",
    "binary": "pure",
    "check": "which pure",
    "install_steps": ["npm install --global pure-prompt", "Verify: pure --version", "supercli plugins install ./plugins/pure --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pure",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pure CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pure",
      "passthrough": true,
      "missingDependencyHelp": "Install pure: npm install --global pure-prompt"
    },
    "args": []
  }]
}
