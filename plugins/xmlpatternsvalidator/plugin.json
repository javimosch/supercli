{
  "name": "xmlpatternsvalidator",
  "version": "0.1.0",
  "description": "CLI tool: xmlpatternsvalidator",
  "source": "https://manpages.debian.org/xmlpatternsvalidator",
  "checks": [
    {
      "type": "binary",
      "name": "xmlpatternsvalidator"
    }
  ],
  "install_guidance": {
    "plugin": "xmlpatternsvalidator",
    "binary": "xmlpatternsvalidator",
    "check": "which xmlpatternsvalidator",
    "install_steps": [
      "apt-get install xmlpatternsvalidator 2>/dev/null || which xmlpatternsvalidator",
      "Verify: xmlpatternsvalidator --version",
      "supercli plugins install ./plugins/xmlpatternsvalidator --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xmlpatternsvalidator",
      "resource": "self",
      "action": "version",
      "description": "Print xmlpatternsvalidator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlpatternsvalidator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xmlpatternsvalidator: apt-get install xmlpatternsvalidator 2>/dev/null || which xmlpatternsvalidator"
      },
      "args": []
    },
    {
      "namespace": "xmlpatternsvalidator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xmlpatternsvalidator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlpatternsvalidator",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xmlpatternsvalidator: apt-get install xmlpatternsvalidator 2>/dev/null || which xmlpatternsvalidator"
      },
      "args": []
    }
  ]
}