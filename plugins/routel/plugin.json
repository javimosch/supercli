{
  "name": "routel",
  "version": "1.0.0",
  "description": "routel \u2014 routel \u2014 CLI utility",
  "source": "/usr/bin/routel",
  "checks": [
    {
      "type": "binary",
      "name": "routel"
    }
  ],
  "install_guidance": {
    "plugin": "routel",
    "binary": "routel",
    "check": "which routel",
    "install_steps": [
      "# Install routel:",
      "# apt: sudo apt-get install routel",
      "# brew: brew install routel",
      "# cargo: cargo install routel",
      "# npm: npm install -g routel",
      "# pip: pip install routel",
      "# or download from /usr/bin/routel"
    ]
  },
  "commands": [
    {
      "namespace": "routel",
      "resource": "routel",
      "action": "run",
      "description": "Run routel",
      "adapter": "process",
      "adapterConfig": {
        "command": "routel",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install routel from /usr/bin/routel"
      },
      "args": []
    }
  ]
}