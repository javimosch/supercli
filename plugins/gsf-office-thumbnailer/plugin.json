{
  "name": "gsf-office-thumbnailer",
  "version": "0.1.0",
  "description": "CLI tool: gsf-office-thumbnailer",
  "source": "https://manpages.debian.org/gsf-office-thumbnailer",
  "checks": [
    {
      "type": "binary",
      "name": "gsf-office-thumbnailer"
    }
  ],
  "install_guidance": {
    "plugin": "gsf-office-thumbnailer",
    "binary": "gsf-office-thumbnailer",
    "check": "which gsf-office-thumbnailer",
    "install_steps": [
      "apt-get install gsf-office-thumbnailer 2>/dev/null || which gsf-office-thumbnailer",
      "Verify: gsf-office-thumbnailer --version",
      "supercli plugins install ./plugins/gsf-office-thumbnailer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gsf-office-thumbnailer",
      "resource": "self",
      "action": "version",
      "description": "Print gsf-office-thumbnailer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gsf-office-thumbnailer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gsf-office-thumbnailer: apt-get install gsf-office-thumbnailer 2>/dev/null || which gsf-office-thumbnailer"
      },
      "args": []
    },
    {
      "namespace": "gsf-office-thumbnailer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gsf-office-thumbnailer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gsf-office-thumbnailer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gsf-office-thumbnailer: apt-get install gsf-office-thumbnailer 2>/dev/null || which gsf-office-thumbnailer"
      },
      "args": []
    }
  ]
}