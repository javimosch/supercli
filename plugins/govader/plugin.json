{
  "name": "govader",
  "version": "0.1.0",
  "description": "Go implementation of VADER sentiment analysis",
  "source": "go",
  "checks": [{ "type": "binary", "name": "govader" }],
  "install_guidance": {
    "plugin": "govader",
    "binary": "govader",
    "check": "which govader",
    "install_steps": ["go get github.com/jonreiter/govader", "Verify: govader --version", "supercli plugins install ./plugins/govader --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "govader",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to govader CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "govader",
      "passthrough": true,
      "missingDependencyHelp": "Install govader: go get github.com/jonreiter/govader"
    },
    "args": []
  }]
}
