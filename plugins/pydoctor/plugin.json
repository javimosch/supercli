{
  "name": "pydoctor",
  "version": "0.1.0",
  "description": "Python-focused API documentation generator",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "pydoctor" }],
  "install_guidance": {
    "plugin": "pydoctor",
    "binary": "pydoctor",
    "check": "which pydoctor",
    "install_steps": ["pip install pydoctor", "Verify: pydoctor --version", "supercli plugins install ./plugins/pydoctor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pydoctor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pydoctor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pydoctor",
      "passthrough": true,
      "missingDependencyHelp": "Install pydoctor: pip install pydoctor"
    },
    "args": []
  }]
}
