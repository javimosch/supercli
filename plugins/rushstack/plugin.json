{
  "name": "rushstack",
  "version": "0.1.0",
  "description": "Scalable monorepo manager for large projects",
  "source": "https://github.com/microsoft/rushstack",
  "checks": [{ "type": "binary", "name": "rush" }],
  "install_guidance": {
    "plugin": "rushstack",
    "binary": "rush",
    "check": "which rush",
    "install_steps": ["npm install -g @microsoft/rush", "Verify: rush --version", "supercli plugins install ./plugins/rushstack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rushstack",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rush CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rush",
      "passthrough": true,
      "missingDependencyHelp": "Install rushstack: npm install -g @microsoft/rush", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
