{
  "name": "rcvboxautostart-service",
  "version": "0.1.0",
  "description": "CLI tool: rcvboxautostart-service",
  "source": "https://manpages.debian.org/rcvboxautostart-service",
  "checks": [
    {
      "type": "binary",
      "name": "rcvboxautostart-service"
    }
  ],
  "install_guidance": {
    "plugin": "rcvboxautostart-service",
    "binary": "rcvboxautostart-service",
    "check": "which rcvboxautostart-service",
    "install_steps": [
      "apt-get install rcvboxautostart-service 2>/dev/null || which rcvboxautostart-service",
      "Verify: rcvboxautostart-service --version",
      "supercli plugins install ./plugins/rcvboxautostart-service --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rcvboxautostart-service",
      "resource": "self",
      "action": "version",
      "description": "Print rcvboxautostart-service version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcvboxautostart-service",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rcvboxautostart-service: apt-get install rcvboxautostart-service 2>/dev/null || which rcvboxautostart-service"
      },
      "args": []
    },
    {
      "namespace": "rcvboxautostart-service",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rcvboxautostart-service CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcvboxautostart-service",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rcvboxautostart-service: apt-get install rcvboxautostart-service 2>/dev/null || which rcvboxautostart-service"
      },
      "args": []
    }
  ]
}