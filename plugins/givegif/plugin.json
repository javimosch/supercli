{
  "name": "givegif",
  "version": "0.1.0",
  "description": "GIFs on the command line",
  "source": "https://github.com/passy/givegif",
  "checks": [
    {
      "type": "binary",
      "name": "givegif"
    }
  ],
  "install_guidance": {
    "plugin": "givegif",
    "binary": "givegif",
    "check": "which givegif",
    "install_steps": [
      "See https://github.com/passy/givegif",
      "Verify: givegif --version",
      "supercli plugins install ./plugins/givegif --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "givegif",
      "resource": "self",
      "action": "version",
      "description": "Print givegif version",
      "adapter": "process",
      "adapterConfig": {
        "command": "givegif",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install givegif: See https://github.com/passy/givegif"
      },
      "args": []
    },
    {
      "namespace": "givegif",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to givegif CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "givegif",
        "passthrough": true,
        "missingDependencyHelp": "Install givegif"
      },
      "args": []
    }
  ]
}