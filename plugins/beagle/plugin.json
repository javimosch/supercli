{
  "name": "beagle",
  "version": "0.1.0",
  "description": "Evaluate the likelihood of sequence evolution on trees",
  "source": "https://github.com/beagle-dev/beagle-lib",
  "checks": [
    {
      "type": "binary",
      "name": "beagle"
    }
  ],
  "install_guidance": {
    "plugin": "beagle",
    "binary": "beagle",
    "check": "which beagle",
    "install_steps": [
      "brew install beagle",
      "Verify: beagle --version",
      "supercli plugins install ./plugins/beagle --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "beagle",
      "resource": "self",
      "action": "version",
      "description": "Print beagle version",
      "adapter": "process",
      "adapterConfig": {
        "command": "beagle",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install beagle: brew install beagle"
      },
      "args": []
    },
    {
      "namespace": "beagle",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to beagle CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "beagle",
        "passthrough": true,
        "missingDependencyHelp": "Install beagle"
      },
      "args": []
    }
  ]
}