{
  "name": "InstallWithOptions",
  "version": "0.1.0",
  "description": "Simple-ish app using Shizuku to install APKs on-device with advanced options",
  "source": "https://github.com/InstallWithOptions/InstallWithOptions",
  "checks": [
    {
      "type": "binary",
      "name": "installwithoptions"
    }
  ],
  "install_guidance": {
    "plugin": "InstallWithOptions",
    "binary": "installwithoptions",
    "check": "which installwithoptions",
    "install_steps": [
      "pip install installwithoptions",
      "Verify: installwithoptions --version",
      "supercli plugins install ./plugins/InstallWithOptions --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "InstallWithOptions",
      "resource": "self",
      "action": "version",
      "description": "Print InstallWithOptions version",
      "adapter": "process",
      "adapterConfig": {
        "command": "installwithoptions",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install InstallWithOptions: pip install installwithoptions"
      },
      "args": []
    },
    {
      "namespace": "InstallWithOptions",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to installwithoptions CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "installwithoptions",
        "passthrough": true,
        "missingDependencyHelp": "Install InstallWithOptions: pip install installwithoptions"
      },
      "args": []
    }
  ]
}