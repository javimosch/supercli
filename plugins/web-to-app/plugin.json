{
  "name": "web-to-app",
  "version": "0.1.0",
  "description": "A native Android application that converts any website URL into a standalone Android App.",
  "source": "https://github.com/web-to-app/web-to-app",
  "checks": [
    {
      "type": "binary",
      "name": "web-to-app"
    }
  ],
  "install_guidance": {
    "plugin": "web-to-app",
    "binary": "web-to-app",
    "check": "which web-to-app",
    "install_steps": [
      "pip install web-to-app",
      "Verify: web-to-app --version",
      "supercli plugins install ./plugins/web-to-app --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "web-to-app",
      "resource": "self",
      "action": "version",
      "description": "Print web-to-app version",
      "adapter": "process",
      "adapterConfig": {
        "command": "web-to-app",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install web-to-app: pip install web-to-app"
      },
      "args": []
    },
    {
      "namespace": "web-to-app",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to web-to-app CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "web-to-app",
        "passthrough": true,
        "missingDependencyHelp": "Install web-to-app: pip install web-to-app"
      },
      "args": []
    }
  ]
}