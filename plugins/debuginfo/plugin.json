{
  "name": "debuginfo",
  "version": "0.1.0",
  "description": "CLI tool: debuginfo",
  "source": "https://packages.debian.org/debuginfo",
  "checks": [{ "type": "binary", "name": "debuginfo" }],
  "install_guidance": {
    "plugin": "debuginfo", "binary": "debuginfo", "check": "which debuginfo",
    "install_steps": ["apt-get install debuginfo 2>/dev/null || which debuginfo", "Verify: debuginfo --version", "supercli plugins install ./plugins/debuginfo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "debuginfo", "resource": "_", "action": "_",
    "description": "Passthrough to debuginfo CLI",
    "adapter": "process", "adapterConfig": { "command": "debuginfo", "passthrough": true, "missingDependencyHelp": "Install debuginfo: apt-get install debuginfo" }, "args": []
  }]
}
