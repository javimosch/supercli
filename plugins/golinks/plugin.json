{
  "name": "golinks",
  "version": "0.1.0",
  "description": "Command-line short link manager and resolver",
  "source": "https://github.com/xav-b/golinks",
  "checks": [{ "type": "binary", "name": "golinks" }],
  "install_guidance": {
    "plugin": "golinks",
    "binary": "golinks",
    "check": "which golinks",
    "install_steps": ["npm install -g golinks", "Verify: golinks --version", "supercli plugins install ./plugins/golinks --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "golinks",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to golinks CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "golinks",
      "passthrough": true,
      "missingDependencyHelp": "Install golinks: npm install -g golinks", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
