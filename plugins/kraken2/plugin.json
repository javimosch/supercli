{
  "name": "kraken2",
  "version": "0.1.0",
  "description": "Taxonomic sequence classification system",
  "source": "https://github.com/DerrickWood/kraken2",
  "checks": [
    {
      "type": "binary",
      "name": "kraken2"
    }
  ],
  "install_guidance": {
    "plugin": "kraken2",
    "binary": "kraken2",
    "check": "which kraken2",
    "install_steps": [
      "brew install kraken2",
      "Verify: kraken2 --version",
      "supercli plugins install ./plugins/kraken2 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kraken2",
      "resource": "self",
      "action": "version",
      "description": "Print kraken2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kraken2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kraken2: brew install kraken2"
      },
      "args": []
    },
    {
      "namespace": "kraken2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kraken2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kraken2",
        "passthrough": true,
        "missingDependencyHelp": "Install kraken2"
      },
      "args": []
    }
  ]
}