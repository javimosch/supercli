{
  "name": "cargo-clone",
  "version": "0.1.0",
  "description": "Cargo subcommand to fetch the source code of a Rust crate",
  "source": "https://github.com/JanLikar/cargo-clone",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-clone"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-clone",
    "binary": "cargo-clone",
    "check": "which cargo-clone",
    "install_steps": [
      "brew install cargo-clone",
      "Verify: cargo-clone --version",
      "supercli plugins install ./plugins/cargo-clone --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cargo-clone",
      "resource": "self",
      "action": "version",
      "description": "Print cargo-clone version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-clone",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-clone: brew install cargo-clone"
      },
      "args": []
    },
    {
      "namespace": "cargo-clone",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-clone CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-clone",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-clone"
      },
      "args": []
    }
  ]
}