{
  "name": "mount.fuse3",
  "version": "0.1.0",
  "description": "CLI tool: mount.fuse3",
  "source": "https://manpages.debian.org/mount.fuse3",
  "checks": [
    {
      "type": "binary",
      "name": "mount.fuse3"
    }
  ],
  "install_guidance": {
    "plugin": "mount.fuse3",
    "binary": "mount.fuse3",
    "check": "which mount.fuse3",
    "install_steps": [
      "apt-get install mount.fuse3 2>/dev/null || which mount.fuse3",
      "Verify: mount.fuse3 --version",
      "supercli plugins install ./plugins/mount.fuse3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mount.fuse3",
      "resource": "self",
      "action": "version",
      "description": "Print mount.fuse3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mount.fuse3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mount.fuse3: apt-get install mount.fuse3 2>/dev/null || which mount.fuse3"
      },
      "args": []
    },
    {
      "namespace": "mount.fuse3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mount.fuse3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mount.fuse3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mount.fuse3: apt-get install mount.fuse3 2>/dev/null || which mount.fuse3"
      },
      "args": []
    }
  ]
}