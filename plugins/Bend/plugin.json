{
  "name": "Bend",
  "version": "0.1.0",
  "description": "A massively parallel, high-level programming language",
  "source": "https://github.com/Bend/Bend",
  "checks": [
    {
      "type": "binary",
      "name": "bend"
    }
  ],
  "install_guidance": {
    "plugin": "Bend",
    "binary": "bend",
    "check": "which bend",
    "install_steps": [
      "pip install bend",
      "Verify: bend --version",
      "supercli plugins install ./plugins/Bend --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Bend",
      "resource": "self",
      "action": "version",
      "description": "Print Bend version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bend",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Bend: pip install bend"
      },
      "args": []
    },
    {
      "namespace": "Bend",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bend CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bend",
        "passthrough": true,
        "missingDependencyHelp": "Install Bend: pip install bend"
      },
      "args": []
    }
  ]
}