{
  "name": "gprof2dot",
  "version": "0.1.0",
  "description": "Convert the output from many profilers into a Graphviz dot graph",
  "source": "https://github.com/jrfonseca/gprof2dot",
  "checks": [
    {
      "type": "binary",
      "name": "gprof2dot"
    }
  ],
  "install_guidance": {
    "plugin": "gprof2dot",
    "binary": "gprof2dot",
    "check": "which gprof2dot",
    "install_steps": [
      "brew install gprof2dot",
      "Verify: gprof2dot --version",
      "supercli plugins install ./plugins/gprof2dot --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gprof2dot",
      "resource": "self",
      "action": "version",
      "description": "Print gprof2dot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gprof2dot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gprof2dot: brew install gprof2dot"
      },
      "args": []
    },
    {
      "namespace": "gprof2dot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gprof2dot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gprof2dot",
        "passthrough": true,
        "missingDependencyHelp": "Install gprof2dot"
      },
      "args": []
    }
  ]
}