{
  "name": "clang-uml",
  "version": "0.1.0",
  "description": "Customizable automatic UML diagram generator for C++ based on Clang",
  "source": "https://github.com/bkryza/clang-uml",
  "checks": [
    {
      "type": "binary",
      "name": "clang-uml"
    }
  ],
  "install_guidance": {
    "plugin": "clang-uml",
    "binary": "clang-uml",
    "check": "which clang-uml",
    "install_steps": [
      "brew install clang-uml",
      "Verify: clang-uml --version",
      "supercli plugins install ./plugins/clang-uml --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clang-uml",
      "resource": "self",
      "action": "version",
      "description": "Print clang-uml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clang-uml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clang-uml: brew install clang-uml"
      },
      "args": []
    },
    {
      "namespace": "clang-uml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clang-uml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clang-uml",
        "passthrough": true,
        "missingDependencyHelp": "Install clang-uml"
      },
      "args": []
    }
  ]
}