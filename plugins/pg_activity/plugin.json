{
  "name": "pg_activity",
  "version": "0.1.0",
  "description": "A top-like application for PostgreSQL server activity monitoring",
  "source": "https://github.com/dalibo/pg_activity",
  "checks": [{ "type": "binary", "name": "pg_activity" }],
  "install_guidance": {
    "plugin": "pg_activity",
    "binary": "pg_activity",
    "check": "which pg_activity",
    "install_steps": [
      "pip install pg_activity",
      "Or: pipx install pg_activity",
      "Or: sudo apt install pg-activity (Debian/Ubuntu)",
      "Verify: pg_activity --version",
      "supercli plugins install ./plugins/pg_activity --on-conflict replace --json"
    ],
    "note": "Available via pip and package managers. Source: https://github.com/dalibo/pg_activity (3k+ stars). Written in Python."
  },
  "commands": [
    {
      "namespace": "pg_activity", "resource": "self", "action": "version",
      "description": "Print pg_activity version",
      "adapter": "process",
      "adapterConfig": { "command": "pg_activity", "missingDependencyHelp": "Install pg_activity: pip install pg_activity", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "pg_activity", "resource": "_", "action": "_",
      "description": "Passthrough to pg_activity CLI",
      "adapter": "process",
      "adapterConfig": { "command": "pg_activity", "missingDependencyHelp": "Install pg_activity: pip install pg_activity", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
