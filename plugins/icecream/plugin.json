{
  "name": "icecream",
  "version": "1.0.0",
  "description": "icecream \u2014 Icecream distributed compiler",
  "source": "github.com/icecc/icecream",
  "checks": [
    {
      "type": "binary",
      "name": "icemon"
    }
  ],
  "install_guidance": {
    "plugin": "icecream",
    "binary": "icemon",
    "check": "which icemon",
    "install_steps": [
      "# Install icecream",
      "# See github.com/icecc/icecream",
      "# apt: sudo apt-get install icecream",
      "# brew: brew install icecream",
      "# cargo: cargo install icecream",
      "# npm: npm install -g icecream",
      "# pip: pip install icecream"
    ]
  },
  "commands": [
    {
      "namespace": "icecream",
      "resource": "icecream",
      "action": "run",
      "description": "Run icecream",
      "adapter": "process",
      "adapterConfig": {
        "command": "icemon",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install icecream from github.com/icecc/icecream"
      },
      "args": []
    }
  ]
}