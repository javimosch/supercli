{
  "name": "mackup",
  "version": "0.1.0",
  "description": "Keep application settings in sync via symlinks",
  "source": "https://github.com/lra/mackup",
  "checks": [{ "type": "binary", "name": "mackup" }],
  "install_guidance": {
    "plugin": "mackup",
    "binary": "mackup",
    "check": "which mackup",
    "install_steps": ["pip install mackup", "Verify: mackup --version", "supercli plugins install ./plugins/mackup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mackup",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mackup CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mackup",
      "passthrough": true,
      "missingDependencyHelp": "Install mackup: pip install mackup", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
