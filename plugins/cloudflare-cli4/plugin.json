{
  "name": "cloudflare-cli4",
  "version": "0.1.0",
  "description": "CLI for Cloudflare API v4",
  "source": "https://github.com/cloudflare/python-cloudflare-cli4",
  "checks": [
    {
      "type": "binary",
      "name": "cloudflare-cli4"
    }
  ],
  "install_guidance": {
    "plugin": "cloudflare-cli4",
    "binary": "cloudflare-cli4",
    "check": "which cloudflare-cli4",
    "install_steps": [
      "brew install cloudflare-cli4",
      "Verify: cloudflare-cli4 --version",
      "supercli plugins install ./plugins/cloudflare-cli4 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cloudflare-cli4",
      "resource": "self",
      "action": "version",
      "description": "Print cloudflare-cli4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudflare-cli4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cloudflare-cli4: brew install cloudflare-cli4"
      },
      "args": []
    },
    {
      "namespace": "cloudflare-cli4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cloudflare-cli4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudflare-cli4",
        "passthrough": true,
        "missingDependencyHelp": "Install cloudflare-cli4"
      },
      "args": []
    }
  ]
}