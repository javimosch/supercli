{
  "name": "zdb",
  "version": "0.1.0",
  "description": "ZFS debug and inspection tool",
  "source": "https://packages.debian.org/zdb",
  "checks": [{ "type": "binary", "name": "zdb" }],
  "install_guidance": {
    "plugin": "zdb", "binary": "zdb", "check": "which zdb",
    "install_steps": ["apt-get install zfsutils-linux", "Verify: zdb --version", "supercli plugins install ./plugins/zdb --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zdb", "resource": "_", "action": "_",
    "description": "Passthrough to zdb CLI",
    "adapter": "process", "adapterConfig": { "command": "zdb", "passthrough": true, "missingDependencyHelp": "Install zdb: apt-get install zfsutils-linux" }, "args": []
  }]
}
