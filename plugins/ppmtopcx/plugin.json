{
  "name": "ppmtopcx",
  "version": "0.1.0",
  "description": "CLI tool: ppmtopcx",
  "source": "https://manpages.debian.org/ppmtopcx",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtopcx"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtopcx",
    "binary": "ppmtopcx",
    "check": "which ppmtopcx",
    "install_steps": [
      "apt-get install ppmtopcx 2>/dev/null || which ppmtopcx",
      "Verify: ppmtopcx --version",
      "supercli plugins install ./plugins/ppmtopcx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtopcx",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtopcx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopcx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtopcx: apt-get install ppmtopcx 2>/dev/null || which ppmtopcx"
      },
      "args": []
    },
    {
      "namespace": "ppmtopcx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtopcx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtopcx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtopcx: apt-get install ppmtopcx 2>/dev/null || which ppmtopcx"
      },
      "args": []
    }
  ]
}