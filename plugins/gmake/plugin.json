{
  "name": "gmake",
  "version": "1.0.0",
  "description": "gmake \u2014 CLI gmake \u2014 Command-line utility for system administration",
  "source": "https://github.com/search?q=gmake+cli",
  "checks": [
    {
      "type": "binary",
      "name": "gmake"
    }
  ],
  "install_guidance": {
    "plugin": "gmake",
    "binary": "gmake",
    "check": "which gmake",
    "install_steps": [
      "Install via package manager: apt install gmake or brew install gmake"
    ]
  },
  "commands": [
    {
      "namespace": "gmake",
      "resource": "run",
      "action": "exec",
      "description": "gmake \u2014 Command-line utility for system administration",
      "adapter": "process",
      "adapterConfig": {
        "command": "gmake",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gmake via package manager"
      },
      "args": []
    }
  ]
}