{
  "name": "truncate",
  "version": "0.1.0",
  "description": "truncate \u2014 shrink or extend the size of a file to the specified size",
  "source": "https://packages.debian.org/truncate",
  "checks": [
    { "type": "binary", "name": "truncate" }
  ],
  "install_guidance": {
    "plugin": "truncate",
    "binary": "truncate",
    "check": "which truncate",
    "install_steps": [
      "which truncate",
      "Verify: truncate --version",
      "supercli plugins install ./plugins/truncate --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "truncate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to truncate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "truncate",
        "passthrough": true,
        "missingDependencyHelp": "Install truncate: which truncate"
      },
      "args": []
    }
  ]
}
