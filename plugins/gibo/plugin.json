{
  "name": "gibo",
  "version": "1.0.0",
  "description": "gibo \u2014 Gitignore boilerplates",
  "source": "github.com/simonwhitaker/gibo",
  "checks": [
    {
      "type": "binary",
      "name": "gibo"
    }
  ],
  "install_guidance": {
    "plugin": "gibo",
    "binary": "gibo",
    "check": "which gibo",
    "install_steps": [
      "# Install gibo",
      "# See github.com/simonwhitaker/gibo",
      "# apt: sudo apt-get install gibo",
      "# brew: brew install gibo",
      "# cargo: cargo install gibo",
      "# npm: npm install -g gibo",
      "# pip: pip install gibo"
    ]
  },
  "commands": [
    {
      "namespace": "gibo",
      "resource": "gibo",
      "action": "run",
      "description": "Run gibo",
      "adapter": "process",
      "adapterConfig": {
        "command": "gibo",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gibo from github.com/simonwhitaker/gibo"
      },
      "args": []
    }
  ]
}