{
  "name": "morse-cli",
  "version": "0.1.0",
  "description": "Translate text to and from Morse code in the terminal",
  "source": "https://github.com/joerick/morse-cli",
  "checks": [{ "type": "binary", "name": "morse-cli" }],
  "install_guidance": {
    "plugin": "morse-cli",
    "binary": "morse-cli",
    "check": "which morse-cli",
    "install_steps": ["pip install morse-cli", "Verify: morse-cli --version", "supercli plugins install ./plugins/morse-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "morse-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to morse-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "morse-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install morse-cli: pip install morse-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
