{
  "name": "shipa-cli",
  "version": "0.1.0",
  "description": "Application platform for Kubernetes with developer self-service",
  "source": "https://github.com/shipa-corp/shipa",
  "checks": [{ "type": "binary", "name": "shipa" }],
  "install_guidance": {
    "plugin": "shipa-cli",
    "binary": "shipa",
    "check": "which shipa",
    "install_steps": ["brew install shipa", "Verify: shipa --version", "supercli plugins install ./plugins/shipa-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "shipa-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to shipa CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "shipa",
      "passthrough": true,
      "missingDependencyHelp": "Install shipa-cli: brew install shipa"
    },
    "args": []
  }]
}
