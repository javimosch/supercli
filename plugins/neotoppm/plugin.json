{
  "name": "neotoppm",
  "version": "0.1.0",
  "description": "CLI tool: neotoppm",
  "source": "https://manpages.debian.org/neotoppm",
  "checks": [
    {
      "type": "binary",
      "name": "neotoppm"
    }
  ],
  "install_guidance": {
    "plugin": "neotoppm",
    "binary": "neotoppm",
    "check": "which neotoppm",
    "install_steps": [
      "apt-get install neotoppm 2>/dev/null || which neotoppm",
      "Verify: neotoppm --version",
      "supercli plugins install ./plugins/neotoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "neotoppm",
      "resource": "self",
      "action": "version",
      "description": "Print neotoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "neotoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install neotoppm: apt-get install neotoppm 2>/dev/null || which neotoppm"
      },
      "args": []
    },
    {
      "namespace": "neotoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to neotoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "neotoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install neotoppm: apt-get install neotoppm 2>/dev/null || which neotoppm"
      },
      "args": []
    }
  ]
}