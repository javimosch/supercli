{
  "name": "browsertap-cli",
  "version": "0.1.0",
  "description": "CLI for browser automation with WebDriver BiDi and WASM plugins",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "browsertap-cli" }],
  "install_guidance": {
    "plugin": "browsertap-cli",
    "binary": "browsertap-cli",
    "check": "which browsertap-cli",
    "install_steps": ["cargo install browsertap-cli", "Verify: browsertap-cli --version", "supercli plugins install ./plugins/browsertap-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "browsertap-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to browsertap-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "browsertap-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install browsertap-cli: cargo install browsertap-cli"
    },
    "args": []
  }]
}
