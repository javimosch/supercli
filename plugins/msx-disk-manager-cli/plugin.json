{
  "name": "msx-disk-manager-cli",
  "version": "0.1.0",
  "description": "[WIP] MSX Disk Manager for CLI",
  "source": "https://github.com/msx-disk-manager-cli/msx-disk-manager-cli",
  "checks": [
    {
      "type": "binary",
      "name": "msx-disk-manager-cli"
    }
