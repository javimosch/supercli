        "missingDependencyHelp": "Install msx-disk-manager-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "msx-disk-manager-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to msx-disk-manager-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "msx-disk-manager-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install msx-disk-manager-cli from project repository"
      },
      "args": []
    }
  ]
