    "check": "which msx-disk-manager-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: msx-disk-manager-cli --version",
      "supercli plugins install ./plugins/msx-disk-manager-cli --on-conflict replace --json"
    ],
    "note": "C++ language CLI tool"
  },
  "commands": [
    {
      "namespace": "msx-disk-manager-cli",
      "resource": "self",
