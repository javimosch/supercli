{
  "name": "doc-convert",
  "version": "0.1.0",
  "description": "Convert between document formats using Pandoc wrapper",
  "source": "https://github.com/johndoe/doc-convert",
  "checks": [{ "type": "binary", "name": "doc-convert" }],
  "install_guidance": {
    "plugin": "doc-convert",
    "binary": "doc-convert",
    "check": "which doc-convert",
    "install_steps": ["pip install doc-convert", "Verify: doc-convert --version", "supercli plugins install ./plugins/doc-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "doc-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to doc-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "doc-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install doc-convert: pip install doc-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
