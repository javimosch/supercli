{
  "name": "kin",
  "version": "0.1.0",
  "description": "Sane PBXProj files",
  "source": "https://github.com/Serchinastico/Kin",
  "checks": [
    {
      "type": "binary",
      "name": "kin"
    }
  ],
  "install_guidance": {
    "plugin": "kin",
    "binary": "kin",
    "check": "which kin",
    "install_steps": [
      "brew install kin",
      "Verify: kin --version",
      "supercli plugins install ./plugins/kin --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kin",
      "resource": "self",
      "action": "version",
      "description": "Print kin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kin: brew install kin"
      },
      "args": []
    },
    {
      "namespace": "kin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kin",
        "passthrough": true,
        "missingDependencyHelp": "Install kin"
      },
      "args": []
    }
  ]
}