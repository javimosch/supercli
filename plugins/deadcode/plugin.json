{
  "name": "deadcode",
  "version": "0.1.0",
  "description": "Detect dead Python code and unused variables",
  "source": "https://github.com/jendrikseipp/deadcode",
  "checks": [{ "type": "binary", "name": "deadcode" }],
  "install_guidance": {
    "plugin": "deadcode",
    "binary": "deadcode",
    "check": "which deadcode",
    "install_steps": ["pip install deadcode", "Verify: deadcode --version", "supercli plugins install ./plugins/deadcode --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "deadcode",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to deadcode CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "deadcode",
      "passthrough": true,
      "missingDependencyHelp": "Install deadcode: pip install deadcode", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
