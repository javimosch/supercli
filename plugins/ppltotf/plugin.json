{
  "name": "ppltotf",
  "version": "0.1.0",
  "description": "CLI tool: ppltotf",
  "source": "https://manpages.debian.org/ppltotf",
  "checks": [
    {
      "type": "binary",
      "name": "ppltotf"
    }
  ],
  "install_guidance": {
    "plugin": "ppltotf",
    "binary": "ppltotf",
    "check": "which ppltotf",
    "install_steps": [
      "apt-get install ppltotf 2>/dev/null || which ppltotf",
      "Verify: ppltotf --version",
      "supercli plugins install ./plugins/ppltotf --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppltotf",
      "resource": "self",
      "action": "version",
      "description": "Print ppltotf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppltotf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppltotf: apt-get install ppltotf 2>/dev/null || which ppltotf"
      },
      "args": []
    },
    {
      "namespace": "ppltotf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppltotf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppltotf",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppltotf: apt-get install ppltotf 2>/dev/null || which ppltotf"
      },
      "args": []
    }
  ]
}