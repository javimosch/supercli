{
  "name": "email-link-checker",
  "version": "0.1.0",
  "description": "Detect dead links in HTML email files from CLI",
  "source": "https://github.com/ierika/email-link-checker",
  "checks": [{ "type": "binary", "name": "email-link-checker" }],
  "install_guidance": {
    "plugin": "email-link-checker",
    "binary": "email-link-checker",
    "check": "which email-link-checker",
    "install_steps": ["pip install email-link-checker", "Verify: email-link-checker --version", "supercli plugins install ./plugins/email-link-checker --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "email-link-checker",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to email-link-checker CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "email-link-checker",
      "passthrough": true,
      "missingDependencyHelp": "Install email-link-checker: pip install email-link-checker", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
