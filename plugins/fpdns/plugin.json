{
  "name": "fpdns",
  "version": "0.1.0",
  "description": "Fingerprint DNS server versions",
  "source": "https://github.com/kirei/fpdns",
  "checks": [
    {
      "type": "binary",
      "name": "fpdns"
    }
  ],
  "install_guidance": {
    "plugin": "fpdns",
    "binary": "fpdns",
    "check": "which fpdns",
    "install_steps": [
      "brew install fpdns",
      "Verify: fpdns --version",
      "supercli plugins install ./plugins/fpdns --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fpdns",
      "resource": "self",
      "action": "version",
      "description": "Print fpdns version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fpdns",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fpdns: brew install fpdns"
      },
      "args": []
    },
    {
      "namespace": "fpdns",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fpdns CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fpdns",
        "passthrough": true,
        "missingDependencyHelp": "Install fpdns"
      },
      "args": []
    }
  ]
}