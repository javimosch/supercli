{
  "name": "git-removed-branches",
  "version": "0.1.0",
  "description": "List and prune remote-tracking branches",
  "source": "https://github.com/search/git-removed-branches",
  "checks": [{ "type": "binary", "name": "git-removed-branches" }],
  "install_guidance": {
    "plugin": "git-removed-branches",
    "binary": "git-removed-branches",
    "check": "which git-removed-branches",
    "install_steps": ["npm install -g git-removed-branches", "Verify: git-removed-branches --version", "supercli plugins install ./plugins/git-removed-branches --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-removed-branches",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-removed-branches CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-removed-branches",
      "passthrough": true,
      "missingDependencyHelp": "Install git-removed-branches: npm install -g git-removed-branches"
    },
    "args": []
  }]
}
