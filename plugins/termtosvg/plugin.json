{
  "name": "termtosvg",
  "version": "0.1.0",
  "description": "Record terminal sessions as SVG animations",
  "source": "https://github.com/nbedos/termtosvg",
  "checks": [
    {
      "type": "binary",
      "name": "termtosvg"
    }
  ],
  "install_guidance": {
    "plugin": "termtosvg",
    "binary": "termtosvg",
    "check": "which termtosvg",
    "install_steps": [
      "pip install termtosvg",
      "Verify: termtosvg --version",
      "supercli plugins install ./plugins/termtosvg --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "termtosvg",
      "resource": "self",
      "action": "version",
      "description": "Print termtosvg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "termtosvg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install termtosvg: pip install termtosvg"
      },
      "args": []
    },
    {
      "namespace": "termtosvg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to termtosvg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "termtosvg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install termtosvg: pip install termtosvg"
      },
      "args": []
    }
  ]
}
