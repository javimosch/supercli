{
  "name": "etl-pipeline-cli",
  "version": "0.1.0",
  "description": "Simple ETL pipeline CLI tool built with Python",
  "source": "https://github.com/etl-pipeline-cli/etl-pipeline-cli",
  "checks": [
    {
      "type": "binary",
      "name": "etl-pipeline-cli"
    }
  ],
  "install_guidance": {
    "plugin": "etl-pipeline-cli",
    "binary": "etl-pipeline-cli",
    "check": "which etl-pipeline-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: etl-pipeline-cli --version",
      "supercli plugins install ./plugins/etl-pipeline-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "etl-pipeline-cli",
      "resource": "self",
      "action": "version",
      "description": "Print etl-pipeline-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "etl-pipeline-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install etl-pipeline-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "etl-pipeline-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to etl-pipeline-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "etl-pipeline-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install etl-pipeline-cli from project repository"
      },
      "args": []
    }
  ]
}