{
  "name": "docopt",
  "version": "0.1.0",
  "description": "Docopt — command-line interface description language parser",
  "source": "https://github.com/docopt/docopt.rs",
  "checks": [
    {
      "type": "binary",
      "name": "docopt"
    }
  ],
  "install_guidance": {
    "plugin": "docopt",
    "binary": "docopt",
    "check": "which docopt",
    "install_steps": [
      "pip install docopt",
      "Verify: docopt --version",
      "supercli plugins install ./plugins/docopt --on-conflict replace --json"
    ],
    "note": "docopt is a parsing library/spec — the Python package provides no standalone binary."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "docopt",
      "resource": "self",
      "action": "version",
      "description": "Print docopt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docopt",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install docopt: pip install docopt"
      },
      "args": []
    }
  ]
}
