{
  "plugin": "docopt",
  "binary": "docopt",
  "check": "which docopt",
  "install_steps": [
    "pip install docopt",
    "Verify: docopt --version",
    "supercli plugins install ./plugins/docopt --on-conflict replace --json"
  ],
  "note": "docopt is a parsing library/spec — the Python package provides no standalone binary."
}
