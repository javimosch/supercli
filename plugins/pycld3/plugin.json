{
  "name": "pycld3",
  "version": "0.1.0",
  "description": "Python bindings for Google Compact Language Detector v3",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "pycld3" }],
  "install_guidance": {
    "plugin": "pycld3",
    "binary": "pycld3",
    "check": "which pycld3",
    "install_steps": ["pip install pycld3", "Verify: pycld3 --version", "supercli plugins install ./plugins/pycld3 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pycld3",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pycld3 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pycld3",
      "passthrough": true,
      "missingDependencyHelp": "Install pycld3: pip install pycld3"
    },
    "args": []
  }]
}
