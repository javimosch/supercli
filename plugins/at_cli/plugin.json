{
  "name": "at_cli",
  "version": "0.1.0",
  "description": "CLI tool: at_cli",
  "source": "https://packages.debian.org/at_cli",
  "checks": [{ "type": "binary", "name": "at_cli" }],
  "install_guidance": {
    "plugin": "at_cli", "binary": "at_cli", "check": "which at_cli",
    "install_steps": ["apt-get install at_cli 2>/dev/null || which at_cli", "Verify: at_cli --version", "supercli plugins install ./plugins/at_cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_cli", "resource": "_", "action": "_",
    "description": "Passthrough to at_cli CLI",
    "adapter": "process", "adapterConfig": { "command": "at_cli", "passthrough": true, "missingDependencyHelp": "Install at_cli: apt-get install at_cli" }, "args": []
  }]
}
