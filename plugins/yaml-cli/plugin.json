{
  "name": "yaml-cli",
  "version": "0.1.0",
  "description": "yaml-cli \u2014 YAML CLI processor, like jq but for YAML.",
  "source": "https://github.com/dualface/yaml-cli",
  "checks": [
    {
      "type": "binary",
      "name": "yaml-cli"
    }
  ],
  "install_guidance": {
    "plugin": "yaml-cli",
    "binary": "yaml-cli",
    "check": "which yaml-cli",
    "install_steps": [
      "npm install -g yaml-cli",
      "supercli plugins install ./plugins/yaml-cli --on-conflict replace --json"
    ],
    "note": "Node.js. YAML processor CLI."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yaml-cli",
      "resource": "yaml",
      "action": "process",
      "description": "Process YAML from stdin or file",
      "adapter": "process",
      "adapterConfig": {
        "command": "yaml-cli",
        "missingDependencyHelp": "Install yaml-cli",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "yaml-cli",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yaml-cli",
        "missingDependencyHelp": "Install yaml-cli",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
