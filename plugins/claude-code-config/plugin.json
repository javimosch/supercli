{
  "name": "claude-code-config",
  "version": "0.1.0",
  "description": "Opinionated defaults, documentation, and workflows for Claude Code at Trail of Bits",
  "source": "https://github.com/claude-code-config/claude-code-config",
  "checks": [
    {
      "type": "binary",
      "name": "claude-code-config"
    }
  ],
  "install_guidance": {
    "plugin": "claude-code-config",
    "binary": "claude-code-config",
    "check": "which claude-code-config",
    "install_steps": [
      "pip install claude-code-config",
      "Verify: claude-code-config --version",
      "supercli plugins install ./plugins/claude-code-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-code-config",
      "resource": "self",
      "action": "version",
      "description": "Print claude-code-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-code-config: pip install claude-code-config"
      },
      "args": []
    },
    {
      "namespace": "claude-code-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-code-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-config",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-code-config: pip install claude-code-config"
      },
      "args": []
    }
  ]
}