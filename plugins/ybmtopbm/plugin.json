{
  "name": "ybmtopbm",
  "version": "0.1.0",
  "description": "CLI tool: ybmtopbm",
  "source": "https://manpages.debian.org/ybmtopbm",
  "checks": [
    {
      "type": "binary",
      "name": "ybmtopbm"
    }
  ],
  "install_guidance": {
    "plugin": "ybmtopbm",
    "binary": "ybmtopbm",
    "check": "which ybmtopbm",
    "install_steps": [
      "apt-get install ybmtopbm 2>/dev/null || which ybmtopbm",
      "Verify: ybmtopbm --version",
      "supercli plugins install ./plugins/ybmtopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ybmtopbm",
      "resource": "self",
      "action": "version",
      "description": "Print ybmtopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ybmtopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ybmtopbm: apt-get install ybmtopbm 2>/dev/null || which ybmtopbm"
      },
      "args": []
    },
    {
      "namespace": "ybmtopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ybmtopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ybmtopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ybmtopbm: apt-get install ybmtopbm 2>/dev/null || which ybmtopbm"
      },
      "args": []
    }
  ]
}