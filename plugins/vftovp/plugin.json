{
  "name": "vftovp",
  "version": "0.1.0",
  "description": "CLI tool: vftovp",
  "source": "https://manpages.debian.org/vftovp",
  "checks": [
    {
      "type": "binary",
      "name": "vftovp"
    }
  ],
  "install_guidance": {
    "plugin": "vftovp",
    "binary": "vftovp",
    "check": "which vftovp",
    "install_steps": [
      "apt-get install vftovp 2>/dev/null || which vftovp",
      "Verify: vftovp --version",
      "supercli plugins install ./plugins/vftovp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vftovp",
      "resource": "self",
      "action": "version",
      "description": "Print vftovp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vftovp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vftovp: apt-get install vftovp 2>/dev/null || which vftovp"
      },
      "args": []
    },
    {
      "namespace": "vftovp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vftovp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vftovp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vftovp: apt-get install vftovp 2>/dev/null || which vftovp"
      },
      "args": []
    }
  ]
}