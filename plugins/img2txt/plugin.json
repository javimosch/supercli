{
  "name": "img2txt",
  "version": "0.1.0",
  "description": "Convert images to colored text with ANSI codes",
  "source": "https://github.com/hit9/img2txt",
  "checks": [{ "type": "binary", "name": "img2txt" }],
  "install_guidance": {
    "plugin": "img2txt",
    "binary": "img2txt",
    "check": "which img2txt",
    "install_steps": ["pip install img2txt", "Verify: img2txt --version", "supercli plugins install ./plugins/img2txt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "img2txt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to img2txt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "img2txt",
      "passthrough": true,
      "missingDependencyHelp": "Install img2txt: pip install img2txt", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
