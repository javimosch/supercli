{
  "name": "man",
  "version": "1.0.0",
  "description": "man — man — CLI utility",
  "source": "https://gitlab.com/man-db/man-db",
  "checks": [
    {
      "type": "binary",
      "name": "man"
    }
  ],
  "install_guidance": {
    "plugin": "man",
    "binary": "man",
    "check": "which man",
    "install_steps": [
      "# Install man:",
      "# apt: sudo apt-get install man",
      "# brew: brew install man",
      "# cargo: cargo install man",
      "# npm: npm install -g man",
      "# pip: pip install man",
      "# or download from /usr/bin/man"
    ]
  },
  "commands": [
    {
      "namespace": "man",
      "resource": "man",
      "action": "run",
      "description": "Run man",
      "adapter": "process",
      "adapterConfig": {
        "command": "man",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install man from /usr/bin/man"
      },
      "args": []
    }
  ]
}
