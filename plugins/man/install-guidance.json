{
  "plugin": "man",
  "binary": "man",
  "check": "which man",
  "install_steps": [
    "# Install man",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/man-linux-amd64 -o /usr/local/bin/man",
    "chmod +x /usr/local/bin/man",
    "# Or via package manager, see /usr/bin/man"
  ]
}