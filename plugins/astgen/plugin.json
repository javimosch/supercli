{
  "name": "astgen",
  "version": "0.1.0",
  "description": "Generate AST in json format for JS/TS",
  "source": "https://github.com/joernio/astgen",
  "checks": [
    {
      "type": "binary",
      "name": "astgen"
    }
  ],
  "install_guidance": {
    "plugin": "astgen",
    "binary": "astgen",
    "check": "which astgen",
    "install_steps": [
      "brew install astgen",
      "Verify: astgen --version",
      "supercli plugins install ./plugins/astgen --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "astgen",
      "resource": "self",
      "action": "version",
      "description": "Print astgen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "astgen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install astgen: brew install astgen"
      },
      "args": []
    },
    {
      "namespace": "astgen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to astgen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "astgen",
        "passthrough": true,
        "missingDependencyHelp": "Install astgen"
      },
      "args": []
    }
  ]
}