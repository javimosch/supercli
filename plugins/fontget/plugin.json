{
  "name": "fontget",
  "version": "0.1.0",
  "description": "Tiny CLI manager to discover and install fonts on Linux/macOS",
  "source": "https://github.com/Graphixa/FontGet",
  "checks": [{ "type": "binary", "name": "fontget" }],
  "install_guidance": {
    "plugin": "fontget",
    "binary": "fontget",
    "check": "which fontget",
    "install_steps": ["binary release", "Verify: fontget --version", "supercli plugins install ./plugins/fontget --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fontget",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fontget CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fontget",
      "passthrough": true,
      "missingDependencyHelp": "Install fontget: binary release", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
