{
  "plugin": "mitmproxy",
  "binary": "mitmproxy",
  "check": "which mitmproxy",
  "install_steps": [
    "pip install mitmproxy",
    "brew install mitmproxy",
    "Verify: mitmproxy --version",
    "supercli plugins install ./plugins/mitmproxy --on-conflict replace --json"
  ],
  "note": "Also includes mitmdump (CLI) and mitmweb (web interface)."
}
