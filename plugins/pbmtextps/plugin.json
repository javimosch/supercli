{
  "name": "pbmtextps",
  "version": "0.1.0",
  "description": "CLI tool: pbmtextps",
  "source": "https://manpages.debian.org/pbmtextps",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtextps"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtextps",
    "binary": "pbmtextps",
    "check": "which pbmtextps",
    "install_steps": [
      "apt-get install pbmtextps 2>/dev/null || which pbmtextps",
      "Verify: pbmtextps --version",
      "supercli plugins install ./plugins/pbmtextps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtextps",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtextps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtextps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtextps: apt-get install pbmtextps 2>/dev/null || which pbmtextps"
      },
      "args": []
    },
    {
      "namespace": "pbmtextps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtextps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtextps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtextps: apt-get install pbmtextps 2>/dev/null || which pbmtextps"
      },
      "args": []
    }
  ]
}