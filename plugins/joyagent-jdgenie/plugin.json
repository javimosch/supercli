{
  "name": "joyagent-jdgenie",
  "version": "0.1.0",
  "description": "\u5f00\u6e90\u7684\u7aef\u5230\u7aef\u4ea7\u54c1\u7ea7\u901a\u7528\u667a\u80fd\u4f53",
  "source": "https://github.com/joyagent-jdgenie/joyagent-jdgenie",
  "checks": [
    {
      "type": "binary",
      "name": "joyagent-jdgenie"
    }
  ],
  "install_guidance": {
    "plugin": "joyagent-jdgenie",
    "binary": "joyagent-jdgenie",
    "check": "which joyagent-jdgenie",
    "install_steps": [
      "pip install joyagent-jdgenie",
      "Verify: joyagent-jdgenie --version",
      "supercli plugins install ./plugins/joyagent-jdgenie --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "joyagent-jdgenie",
      "resource": "self",
      "action": "version",
      "description": "Print joyagent-jdgenie version",
      "adapter": "process",
      "adapterConfig": {
        "command": "joyagent-jdgenie",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install joyagent-jdgenie: pip install joyagent-jdgenie"
      },
      "args": []
    },
    {
      "namespace": "joyagent-jdgenie",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to joyagent-jdgenie CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "joyagent-jdgenie",
        "passthrough": true,
        "missingDependencyHelp": "Install joyagent-jdgenie: pip install joyagent-jdgenie"
      },
      "args": []
    }
  ]
}