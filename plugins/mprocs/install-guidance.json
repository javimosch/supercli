{
  "plugin": "mprocs",
  "binary": "mprocs",
  "check": "which mprocs",
  "install_steps": [
    "cargo install mprocs",
    "brew install mprocs",
    "npm install -g mprocs",
    "scoop install mprocs",
    "Verify: mprocs --version",
    "supercli plugins install ./plugins/mprocs --on-conflict replace --json"
  ],
  "note": "Also available as binary download from GitHub releases."
}
