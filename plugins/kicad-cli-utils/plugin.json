{
  "name": "kicad-cli-utils",
  "version": "0.1.0",
  "description": "Miscellaneous helpers for automating KiCad PCB design tasks",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "kicad-cli-utils" }],
  "install_guidance": {
    "plugin": "kicad-cli-utils",
    "binary": "kicad-cli-utils",
    "check": "which kicad-cli-utils",
    "install_steps": ["git clone && pip install .", "Verify: kicad-cli-utils --version", "supercli plugins install ./plugins/kicad-cli-utils --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kicad-cli-utils",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kicad-cli-utils CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kicad-cli-utils",
      "passthrough": true,
      "missingDependencyHelp": "Install kicad-cli-utils: git clone && pip install ."
    },
    "args": []
  }]
}
