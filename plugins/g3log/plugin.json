{
  "name": "g3log",
  "version": "0.1.0",
  "description": "Asynchronous, 'crash safe', logger that is easy to use",
  "source": "https://github.com/KjellKod/g3log",
  "checks": [
    {
      "type": "binary",
      "name": "g3log"
    }
  ],
  "install_guidance": {
    "plugin": "g3log",
    "binary": "g3log",
    "check": "which g3log",
    "install_steps": [
      "brew install g3log",
      "Verify: g3log --version",
      "supercli plugins install ./plugins/g3log --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "g3log",
      "resource": "self",
      "action": "version",
      "description": "Print g3log version",
      "adapter": "process",
      "adapterConfig": {
        "command": "g3log",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install g3log: brew install g3log"
      },
      "args": []
    },
    {
      "namespace": "g3log",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to g3log CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "g3log",
        "passthrough": true,
        "missingDependencyHelp": "Install g3log"
      },
      "args": []
    }
  ]
}