{
  "name": "dee-rates",
  "version": "0.1.0",
  "description": "Real-time currency exchange rates from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-rates" }],
  "install_guidance": {
    "plugin": "dee-rates",
    "binary": "dee-rates",
    "check": "which dee-rates",
    "install_steps": ["cargo install dee-rates", "Verify: dee-rates --version", "supercli plugins install ./plugins/dee-rates --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-rates",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-rates CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-rates",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-rates: cargo install dee-rates"
    },
    "args": []
  }]
}
