{
  "name": "header-echo",
  "version": "0.1.0",
  "description": "Echo HTTP headers for debugging and testing",
  "source": "https://github.com/nicknisi/header-echo",
  "checks": [{ "type": "binary", "name": "header-echo" }],
  "install_guidance": {
    "plugin": "header-echo",
    "binary": "header-echo",
    "check": "which header-echo",
    "install_steps": ["cargo install header-echo", "Verify: header-echo --version", "supercli plugins install ./plugins/header-echo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "header-echo",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to header-echo CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "header-echo",
      "passthrough": true,
      "missingDependencyHelp": "Install header-echo: cargo install header-echo"
    },
    "args": []
  }]
}
