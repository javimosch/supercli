{
  "name": "code-minimap",
  "version": "0.1.0",
  "description": "High performance code minimap generator",
  "source": "https://github.com/wfxr/code-minimap",
  "checks": [
    {
      "type": "binary",
      "name": "code-minimap"
    }
  ],
  "install_guidance": {
    "plugin": "code-minimap",
    "binary": "code-minimap",
    "check": "which code-minimap",
    "install_steps": [
      "brew install code-minimap",
      "Verify: code-minimap --version",
      "supercli plugins install ./plugins/code-minimap --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "code-minimap",
      "resource": "self",
      "action": "version",
      "description": "Print code-minimap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "code-minimap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install code-minimap: brew install code-minimap"
      },
      "args": []
    },
    {
      "namespace": "code-minimap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to code-minimap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "code-minimap",
        "passthrough": true,
        "missingDependencyHelp": "Install code-minimap"
      },
      "args": []
    }
  ]
}