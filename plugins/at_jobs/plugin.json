{
  "name": "at_jobs",
  "version": "0.1.0",
  "description": "CLI tool: at_jobs",
  "source": "https://packages.debian.org/at_jobs",
  "checks": [{ "type": "binary", "name": "at_jobs" }],
  "install_guidance": {
    "plugin": "at_jobs", "binary": "at_jobs", "check": "which at_jobs",
    "install_steps": ["apt-get install at_jobs 2>/dev/null || which at_jobs", "Verify: at_jobs --version", "supercli plugins install ./plugins/at_jobs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_jobs", "resource": "_", "action": "_",
    "description": "Passthrough to at_jobs CLI",
    "adapter": "process", "adapterConfig": { "command": "at_jobs", "passthrough": true, "missingDependencyHelp": "Install at_jobs: apt-get install at_jobs" }, "args": []
  }]
}
