{
  "name": "TSV Utilities",
  "version": "0.1.0",
  "description": "Command line tools for large, tabular data files.",
  "source": "https://github.com/eBay/tsv-utils",
  "checks": [
    {
      "type": "binary",
      "name": "TSV Utilities"
    }
  ],
  "install_guidance": {
    "plugin": "TSV Utilities",
    "binary": "TSV Utilities",
    "check": "which TSV Utilities",
    "install_steps": [
      "See https://github.com/eBay/tsv-utils",
      "Verify: TSV Utilities --version",
      "supercli plugins install ./plugins/TSV Utilities --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "TSV Utilities",
      "resource": "self",
      "action": "version",
      "description": "Print TSV Utilities version",
      "adapter": "process",
      "adapterConfig": {
        "command": "TSV Utilities",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TSV Utilities: See https://github.com/eBay/tsv-utils"
      },
      "args": []
    },
    {
      "namespace": "TSV Utilities",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to TSV Utilities CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "TSV Utilities",
        "passthrough": true,
        "missingDependencyHelp": "Install TSV Utilities"
      },
      "args": []
    }
  ]
}