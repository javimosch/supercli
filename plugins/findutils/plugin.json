{
  "name": "findutils",
  "version": "0.1.0",
  "description": "Collection of GNU find, xargs, and locate",
  "checks": [
    {
      "type": "binary",
      "name": "findutils"
    }
  ],
  "install_guidance": {
    "plugin": "findutils",
    "binary": "findutils",
    "check": "which findutils",
    "install_steps": [
      "brew install findutils",
      "Verify: findutils --version",
      "supercli plugins install ./plugins/findutils --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "findutils",
      "resource": "self",
      "action": "version",
      "description": "Print findutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "findutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install findutils: brew install findutils"
      },
      "args": []
    },
    {
      "namespace": "findutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to findutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "findutils",
        "passthrough": true,
        "missingDependencyHelp": "Install findutils"
      },
      "args": []
    }
  ]
}