{
  "name": "isort-identify-imports",
  "version": "0.1.0",
  "description": "CLI tool: isort-identify-imports",
  "source": "https://manpages.debian.org/isort-identify-imports",
  "checks": [
    {
      "type": "binary",
      "name": "isort-identify-imports"
    }
  ],
  "install_guidance": {
    "plugin": "isort-identify-imports",
    "binary": "isort-identify-imports",
    "check": "which isort-identify-imports",
    "install_steps": [
      "apt-get install isort-identify-imports 2>/dev/null || which isort-identify-imports",
      "Verify: isort-identify-imports --version",
      "supercli plugins install ./plugins/isort-identify-imports --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "isort-identify-imports",
      "resource": "self",
      "action": "version",
      "description": "Print isort-identify-imports version",
      "adapter": "process",
      "adapterConfig": {
        "command": "isort-identify-imports",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install isort-identify-imports: apt-get install isort-identify-imports 2>/dev/null || which isort-identify-imports"
      },
      "args": []
    },
    {
      "namespace": "isort-identify-imports",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to isort-identify-imports CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "isort-identify-imports",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install isort-identify-imports: apt-get install isort-identify-imports 2>/dev/null || which isort-identify-imports"
      },
      "args": []
    }
  ]
}