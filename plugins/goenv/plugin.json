{
  "name": "goenv",
  "version": "0.1.0",
  "description": "Go version management",
  "source": "https://github.com/go-nv/goenv",
  "checks": [
    {
      "type": "binary",
      "name": "goenv"
    }
  ],
  "install_guidance": {
    "plugin": "goenv",
    "binary": "goenv",
    "check": "which goenv",
    "install_steps": [
      "brew install goenv",
      "Verify: goenv --version",
      "supercli plugins install ./plugins/goenv --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "goenv",
      "resource": "self",
      "action": "version",
      "description": "Print goenv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "goenv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install goenv: brew install goenv"
      },
      "args": []
    },
    {
      "namespace": "goenv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to goenv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "goenv",
        "passthrough": true,
        "missingDependencyHelp": "Install goenv"
      },
      "args": []
    }
  ]
}