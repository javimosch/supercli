{
  "name": "WeKnora",
  "version": "0.1.0",
  "description": "Open-source LLM knowledge platform: turn raw documents into a queryable RAG, an autonomous reasoning",
  "source": "https://github.com/WeKnora/WeKnora",
  "checks": [
    {
      "type": "binary",
      "name": "weknora"
    }
  ],
  "install_guidance": {
    "plugin": "WeKnora",
    "binary": "weknora",
    "check": "which weknora",
    "install_steps": [
      "pip install weknora",
      "Verify: weknora --version",
      "supercli plugins install ./plugins/WeKnora --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "WeKnora",
      "resource": "self",
      "action": "version",
      "description": "Print WeKnora version",
      "adapter": "process",
      "adapterConfig": {
        "command": "weknora",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install WeKnora: pip install weknora"
      },
      "args": []
    },
    {
      "namespace": "WeKnora",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to weknora CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "weknora",
        "passthrough": true,
        "missingDependencyHelp": "Install WeKnora: pip install weknora"
      },
      "args": []
    }
  ]
}