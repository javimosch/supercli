{
  "name": "docker-machine-driver-vultr",
  "version": "0.1.0",
  "description": "Docker Machine driver plugin for Vultr Cloud",
  "source": "https://github.com/vultr/docker-machine-driver-vultr",
  "checks": [
    {
      "type": "binary",
      "name": "docker-machine-driver-vultr"
    }
  ],
  "install_guidance": {
    "plugin": "docker-machine-driver-vultr",
    "binary": "docker-machine-driver-vultr",
    "check": "which docker-machine-driver-vultr",
    "install_steps": [
      "brew install docker-machine-driver-vultr",
      "Verify: docker-machine-driver-vultr --version",
      "supercli plugins install ./plugins/docker-machine-driver-vultr --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "docker-machine-driver-vultr",
      "resource": "self",
      "action": "version",
      "description": "Print docker-machine-driver-vultr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-machine-driver-vultr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-machine-driver-vultr: brew install docker-machine-driver-vultr"
      },
      "args": []
    },
    {
      "namespace": "docker-machine-driver-vultr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-machine-driver-vultr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-machine-driver-vultr",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-machine-driver-vultr"
      },
      "args": []
    }
  ]
}