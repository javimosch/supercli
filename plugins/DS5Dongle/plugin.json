{
  "name": "DS5Dongle",
  "version": "0.1.0",
  "description": "Turn your Pico 2 W into a DualSense 5 dongle.",
  "source": "https://github.com/DS5Dongle/DS5Dongle",
  "checks": [
    {
      "type": "binary",
      "name": "ds5dongle"
    }
  ],
  "install_guidance": {
    "plugin": "DS5Dongle",
    "binary": "ds5dongle",
    "check": "which ds5dongle",
    "install_steps": [
      "pip install ds5dongle",
      "Verify: ds5dongle --version",
      "supercli plugins install ./plugins/DS5Dongle --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DS5Dongle",
      "resource": "self",
      "action": "version",
      "description": "Print DS5Dongle version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ds5dongle",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DS5Dongle: pip install ds5dongle"
      },
      "args": []
    },
    {
      "namespace": "DS5Dongle",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ds5dongle CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ds5dongle",
        "passthrough": true,
        "missingDependencyHelp": "Install DS5Dongle: pip install ds5dongle"
      },
      "args": []
    }
  ]
}