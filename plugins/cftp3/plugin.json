{
  "name": "cftp3",
  "version": "0.1.0",
  "description": "CLI tool: cftp3",
  "source": "https://packages.debian.org/cftp3",
  "checks": [{ "type": "binary", "name": "cftp3" }],
  "install_guidance": {
    "plugin": "cftp3", "binary": "cftp3", "check": "which cftp3",
    "install_steps": ["apt-get install cftp3 2>/dev/null || which cftp3", "Verify: cftp3 --version", "supercli plugins install ./plugins/cftp3 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cftp3", "resource": "_", "action": "_",
    "description": "Passthrough to cftp3 CLI",
    "adapter": "process", "adapterConfig": { "command": "cftp3", "passthrough": true, "missingDependencyHelp": "Install cftp3: apt-get install cftp3" }, "args": []
  }]
}
