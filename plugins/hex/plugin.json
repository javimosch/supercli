{
  "name": "hex",
  "version": "0.1.0",
  "description": "Futuristic take on hexdump",
  "source": "https://github.com/sitkevij/hex",
  "checks": [
    {
      "type": "binary",
      "name": "hex"
    }
  ],
  "install_guidance": {
    "plugin": "hex",
    "binary": "hex",
    "check": "which hex",
    "install_steps": [
      "brew install hex",
      "Verify: hex --version",
      "supercli plugins install ./plugins/hex --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hex",
      "resource": "self",
      "action": "version",
      "description": "Print hex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hex: brew install hex"
      },
      "args": []
    },
    {
      "namespace": "hex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hex",
        "passthrough": true,
        "missingDependencyHelp": "Install hex"
      },
      "args": []
    }
  ]
}