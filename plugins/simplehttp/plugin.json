{
  "name": "simplehttp",
  "version": "0.1.0",
  "description": "Easily serve a local directory over HTTP",
  "source": "https://github.com/snwfdhmp/simplehttp",
  "checks": [
    {
      "type": "binary",
      "name": "simplehttp"
    }
  ],
  "install_guidance": {
    "plugin": "simplehttp",
    "binary": "simplehttp",
    "check": "which simplehttp",
    "install_steps": [
      "See https://github.com/snwfdhmp/simplehttp",
      "Verify: simplehttp --version",
      "supercli plugins install ./plugins/simplehttp --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "simplehttp",
      "resource": "self",
      "action": "version",
      "description": "Print simplehttp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "simplehttp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install simplehttp: See https://github.com/snwfdhmp/simplehttp"
      },
      "args": []
    },
    {
      "namespace": "simplehttp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to simplehttp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "simplehttp",
        "passthrough": true,
        "missingDependencyHelp": "Install simplehttp"
      },
      "args": []
    }
  ]
}