{
  "name": "client-pipeline",
  "version": "0.1.0",
  "description": "Best practices to avoid bad things from happening",
  "source": "https://github.com/client-pipeline/client-pipeline",
  "checks": [
    {
      "type": "binary",
      "name": "client-pipeline"
    }
  ],
  "install_guidance": {
    "plugin": "client-pipeline",
    "binary": "client-pipeline",
    "check": "which client-pipeline",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: client-pipeline --version",
      "supercli plugins install ./plugins/client-pipeline --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "client-pipeline",
      "resource": "self",
      "action": "version",
      "description": "Print client-pipeline version",
      "adapter": "process",
      "adapterConfig": {
        "command": "client-pipeline",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install client-pipeline from project repository"
      },
      "args": []
    },
    {
      "namespace": "client-pipeline",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to client-pipeline CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "client-pipeline",
        "passthrough": true,
        "missingDependencyHelp": "Install client-pipeline from project repository"
      },
      "args": []
    }
  ]
}