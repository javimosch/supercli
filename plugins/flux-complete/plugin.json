{
  "name": "flux-complete",
  "version": "0.1.0",
  "description": "Shell completion generator for the Flux CLI",
  "source": "https://github.com/fluxcd/flux2",
  "checks": [{ "type": "binary", "name": "flux-complete" }],
  "install_guidance": {
    "plugin": "flux-complete",
    "binary": "flux-complete",
    "check": "which flux-complete",
    "install_steps": ["brew install flux-complete", "Verify: flux-complete --version", "supercli plugins install ./plugins/flux-complete --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "flux-complete",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to flux-complete CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flux-complete",
      "passthrough": true,
      "missingDependencyHelp": "Install flux-complete: brew install flux-complete"
    },
    "args": []
  }]
}
