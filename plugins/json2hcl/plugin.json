{
  "name": "json2hcl",
  "version": "0.1.0",
  "description": "Convert JSON to HCL, and vice versa",
  "source": "https://github.com/kvz/json2hcl",
  "checks": [
    {
      "type": "binary",
      "name": "json2hcl"
    }
  ],
  "install_guidance": {
    "plugin": "json2hcl",
    "binary": "json2hcl",
    "check": "which json2hcl",
    "install_steps": [
      "brew install json2hcl",
      "Verify: json2hcl --version",
      "supercli plugins install ./plugins/json2hcl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "json2hcl",
      "resource": "self",
      "action": "version",
      "description": "Print json2hcl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "json2hcl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install json2hcl: brew install json2hcl"
      },
      "args": []
    },
    {
      "namespace": "json2hcl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to json2hcl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "json2hcl",
        "passthrough": true,
        "missingDependencyHelp": "Install json2hcl"
      },
      "args": []
    }
  ]
}