{
  "name": "s",
  "version": "0.1.0",
  "description": "Open a web search in your terminal",
  "source": "https://github.com/zquestz/s",
  "checks": [
    {
      "type": "binary",
      "name": "s"
    }
  ],
  "install_guidance": {
    "plugin": "s",
    "binary": "s",
    "check": "which s",
    "install_steps": [
      "brew install s",
      "Verify: s --version",
      "supercli plugins install ./plugins/s --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "s",
      "resource": "self",
      "action": "version",
      "description": "Print s version",
      "adapter": "process",
      "adapterConfig": {
        "command": "s",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install s: brew install s"
      },
      "args": []
    },
    {
      "namespace": "s",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to s CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "s",
        "passthrough": true,
        "missingDependencyHelp": "Install s"
      },
      "args": []
    }
  ]
}