{
  "name": "kodus",
  "version": "0.1.0",
  "description": "AI code review CLI that integrates with IDE agents for change review",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "kodus" }],
  "install_guidance": {
    "plugin": "kodus",
    "binary": "kodus",
    "check": "which kodus",
    "install_steps": ["yarn global add @kodus/cli", "Verify: kodus --version", "supercli plugins install ./plugins/kodus --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kodus",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kodus CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kodus",
      "passthrough": true,
      "missingDependencyHelp": "Install kodus: yarn global add @kodus/cli"
    },
    "args": []
  }]
}
