{
  "name": "go-swagger",
  "version": "1.0.0",
  "description": "go-swagger \u2014 Swagger API tooling",
  "source": "goswagger.io",
  "checks": [
    {
      "type": "binary",
      "name": "swagger"
    }
  ],
  "install_guidance": {
    "plugin": "go-swagger",
    "binary": "swagger",
    "check": "which swagger",
    "install_steps": [
      "# Install go-swagger",
      "# See goswagger.io",
      "# apt: sudo apt-get install go-swagger",
      "# brew: brew install go-swagger",
      "# cargo: cargo install go-swagger",
      "# npm: npm install -g go-swagger",
      "# pip: pip install go-swagger"
    ]
  },
  "commands": [
    {
      "namespace": "go",
      "resource": "swagger",
      "action": "run",
      "description": "Run go-swagger",
      "adapter": "process",
      "adapterConfig": {
        "command": "swagger",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install go-swagger from goswagger.io"
      },
      "args": []
    }
  ]
}