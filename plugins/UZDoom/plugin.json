{
  "name": "UZDoom",
  "version": "0.1.0",
  "description": "UZDoom is a feature centric port for all Doom engine games, based on GZDoom, adding an advanced rend",
  "source": "https://github.com/UZDoom/UZDoom",
  "checks": [
    {
      "type": "binary",
      "name": "uzdoom"
    }
  ],
  "install_guidance": {
    "plugin": "UZDoom",
    "binary": "uzdoom",
    "check": "which uzdoom",
    "install_steps": [
      "pip install uzdoom",
      "Verify: uzdoom --version",
      "supercli plugins install ./plugins/UZDoom --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "UZDoom",
      "resource": "self",
      "action": "version",
      "description": "Print UZDoom version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uzdoom",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install UZDoom: pip install uzdoom"
      },
      "args": []
    },
    {
      "namespace": "UZDoom",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uzdoom CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uzdoom",
        "passthrough": true,
        "missingDependencyHelp": "Install UZDoom: pip install uzdoom"
      },
      "args": []
    }
  ]
}