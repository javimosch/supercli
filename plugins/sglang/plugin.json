{
  "name": "sglang",
  "version": "0.1.0",
  "description": "SGLang is a high-performance serving framework for large language models and multimodal models.",
  "source": "https://github.com/sglang/sglang",
  "checks": [
    {
      "type": "binary",
      "name": "sglang"
    }
  ],
  "install_guidance": {
    "plugin": "sglang",
    "binary": "sglang",
    "check": "which sglang",
    "install_steps": [
      "pip install sglang",
      "Verify: sglang --version",
      "supercli plugins install ./plugins/sglang --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sglang",
      "resource": "self",
      "action": "version",
      "description": "Print sglang version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sglang",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sglang: pip install sglang"
      },
      "args": []
    },
    {
      "namespace": "sglang",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sglang CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sglang",
        "passthrough": true,
        "missingDependencyHelp": "Install sglang: pip install sglang"
      },
      "args": []
    }
  ]
}