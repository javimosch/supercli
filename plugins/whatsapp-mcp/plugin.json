{
  "name": "whatsapp-mcp",
  "version": "0.1.0",
  "description": "WhatsApp MCP server",
  "source": "https://github.com/whatsapp-mcp/whatsapp-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "whatsapp-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "whatsapp-mcp",
    "binary": "whatsapp-mcp",
    "check": "which whatsapp-mcp",
    "install_steps": [
      "pip install whatsapp-mcp",
      "Verify: whatsapp-mcp --version",
      "supercli plugins install ./plugins/whatsapp-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "whatsapp-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print whatsapp-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatsapp-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install whatsapp-mcp: pip install whatsapp-mcp"
      },
      "args": []
    },
    {
      "namespace": "whatsapp-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to whatsapp-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatsapp-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install whatsapp-mcp: pip install whatsapp-mcp"
      },
      "args": []
    }
  ]
}