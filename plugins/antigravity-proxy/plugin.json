{
  "name": "antigravity-proxy",
  "version": "0.1.0",
  "description": "\ud83d\ude80 Transparent proxy injector for Antigravity. Force SOCKS5/HTTP proxy without TUN mode on Windows. |",
  "source": "https://github.com/antigravity-proxy/antigravity-proxy",
  "checks": [
    {
      "type": "binary",
      "name": "antigravity-proxy"
    }
  ],
  "install_guidance": {
    "plugin": "antigravity-proxy",
    "binary": "antigravity-proxy",
    "check": "which antigravity-proxy",
    "install_steps": [
      "pip install antigravity-proxy",
      "Verify: antigravity-proxy --version",
      "supercli plugins install ./plugins/antigravity-proxy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "antigravity-proxy",
      "resource": "self",
      "action": "version",
      "description": "Print antigravity-proxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "antigravity-proxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install antigravity-proxy: pip install antigravity-proxy"
      },
      "args": []
    },
    {
      "namespace": "antigravity-proxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to antigravity-proxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "antigravity-proxy",
        "passthrough": true,
        "missingDependencyHelp": "Install antigravity-proxy: pip install antigravity-proxy"
      },
      "args": []
    }
  ]
}