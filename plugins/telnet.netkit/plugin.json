{
  "name": "telnet.netkit",
  "version": "0.1.0",
  "description": "CLI tool: telnet.netkit",
  "source": "https://manpages.debian.org/telnet.netkit",
  "checks": [
    {
      "type": "binary",
      "name": "telnet.netkit"
    }
  ],
  "install_guidance": {
    "plugin": "telnet.netkit",
    "binary": "telnet.netkit",
    "check": "which telnet.netkit",
    "install_steps": [
      "apt-get install telnet.netkit 2>/dev/null || which telnet.netkit",
      "Verify: telnet.netkit --version",
      "supercli plugins install ./plugins/telnet.netkit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "telnet.netkit",
      "resource": "self",
      "action": "version",
      "description": "Print telnet.netkit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "telnet.netkit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install telnet.netkit: apt-get install telnet.netkit 2>/dev/null || which telnet.netkit"
      },
      "args": []
    },
    {
      "namespace": "telnet.netkit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to telnet.netkit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "telnet.netkit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install telnet.netkit: apt-get install telnet.netkit 2>/dev/null || which telnet.netkit"
      },
      "args": []
    }
  ]
}