{
  "name": "gtscompare",
  "version": "0.1.0",
  "description": "CLI tool: gtscompare",
  "source": "https://manpages.debian.org/gtscompare",
  "checks": [
    {
      "type": "binary",
      "name": "gtscompare"
    }
  ],
  "install_guidance": {
    "plugin": "gtscompare",
    "binary": "gtscompare",
    "check": "which gtscompare",
    "install_steps": [
      "apt-get install gtscompare 2>/dev/null || which gtscompare",
      "Verify: gtscompare --version",
      "supercli plugins install ./plugins/gtscompare --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gtscompare",
      "resource": "self",
      "action": "version",
      "description": "Print gtscompare version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtscompare",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtscompare: apt-get install gtscompare 2>/dev/null || which gtscompare"
      },
      "args": []
    },
    {
      "namespace": "gtscompare",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtscompare CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtscompare",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gtscompare: apt-get install gtscompare 2>/dev/null || which gtscompare"
      },
      "args": []
    }
  ]
}