{
  "name": "ddh",
  "version": "0.1.0",
  "description": "Fast duplicate file finder",
  "source": "https://github.com/darakian/ddh",
  "checks": [
    {
      "type": "binary",
      "name": "ddh"
    }
  ],
  "install_guidance": {
    "plugin": "ddh",
    "binary": "ddh",
    "check": "which ddh",
    "install_steps": [
      "brew install ddh",
      "Verify: ddh --version",
      "supercli plugins install ./plugins/ddh --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ddh",
      "resource": "self",
      "action": "version",
      "description": "Print ddh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ddh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ddh: brew install ddh"
      },
      "args": []
    },
    {
      "namespace": "ddh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ddh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ddh",
        "passthrough": true,
        "missingDependencyHelp": "Install ddh"
      },
      "args": []
    }
  ]
}