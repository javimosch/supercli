{
  "name": "cityhash",
  "version": "0.1.0",
  "description": "Hash functions for strings",
  "source": "https://github.com/google/cityhash",
  "checks": [
    {
      "type": "binary",
      "name": "cityhash"
    }
  ],
  "install_guidance": {
    "plugin": "cityhash",
    "binary": "cityhash",
    "check": "which cityhash",
    "install_steps": [
      "brew install cityhash",
      "Verify: cityhash --version",
      "supercli plugins install ./plugins/cityhash --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cityhash",
      "resource": "self",
      "action": "version",
      "description": "Print cityhash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cityhash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cityhash: brew install cityhash"
      },
      "args": []
    },
    {
      "namespace": "cityhash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cityhash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cityhash",
        "passthrough": true,
        "missingDependencyHelp": "Install cityhash"
      },
      "args": []
    }
  ]
}