{
  "name": "ytdl",
  "version": "0.1.0",
  "description": "youtube download cli in rust.",
  "source": "https://github.com/ytdl/ytdl",
  "checks": [
    {
      "type": "binary",
      "name": "ytdl"
    }
  ],
  "install_guidance": {
    "plugin": "ytdl",
    "binary": "ytdl",
    "check": "which ytdl",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: ytdl --version",
      "supercli plugins install ./plugins/ytdl --on-conflict replace --json"
    ],
    "note": "Rust language CLI tool"
  },
  "commands": [
    {
      "namespace": "ytdl",
      "resource": "self",
      "action": "version",
      "description": "Print ytdl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ytdl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ytdl from project repository"
      },
      "args": []
    },
    {
      "namespace": "ytdl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ytdl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ytdl",
        "passthrough": true,
        "missingDependencyHelp": "Install ytdl from project repository"
      },
      "args": []
    }
  ]
}