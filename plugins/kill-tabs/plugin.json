{
  "name": "kill-tabs",
  "version": "0.1.0",
  "description": "Kill all Chrome tabs",
  "source": "https://github.com/sindresorhus/kill-tabs",
  "checks": [
    {
      "type": "binary",
      "name": "kill-tabs"
    }
  ],
  "install_guidance": {
    "plugin": "kill-tabs",
    "binary": "kill-tabs",
    "check": "which kill-tabs",
    "install_steps": [
      "See https://github.com/sindresorhus/kill-tabs",
      "Verify: kill-tabs --version",
      "supercli plugins install ./plugins/kill-tabs --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "kill-tabs",
      "resource": "self",
      "action": "version",
      "description": "Print kill-tabs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kill-tabs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kill-tabs: See https://github.com/sindresorhus/kill-tabs"
      },
      "args": []
    },
    {
      "namespace": "kill-tabs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kill-tabs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kill-tabs",
        "passthrough": true,
        "missingDependencyHelp": "Install kill-tabs"
      },
      "args": []
    }
  ]
}