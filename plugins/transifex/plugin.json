{
  "name": "transifex",
  "version": "0.1.0",
  "description": "Transifex localization CLI for ownCloud CI",
  "source": "https://github.com/transifex/transifex",
  "checks": [
    {
      "type": "binary",
      "name": "transifex"
    }
  ],
  "install_guidance": {
    "plugin": "transifex",
    "binary": "transifex",
    "check": "which transifex",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: transifex --version",
      "supercli plugins install ./plugins/transifex --on-conflict replace --json"
    ],
    "note": "Perl language CLI tool"
  },
  "commands": [
    {
      "namespace": "transifex",
      "resource": "self",
      "action": "version",
      "description": "Print transifex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "transifex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install transifex from project repository"
      },
      "args": []
    },
    {
      "namespace": "transifex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to transifex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "transifex",
        "passthrough": true,
        "missingDependencyHelp": "Install transifex from project repository"
      },
      "args": []
    }
  ]
}