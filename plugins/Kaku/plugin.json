{
  "name": "Kaku",
  "version": "0.1.0",
  "description": "\ud83c\udf83 A fast, out-of-the-box terminal built for AI coding.",
  "source": "https://github.com/Kaku/Kaku",
  "checks": [
    {
      "type": "binary",
      "name": "kaku"
    }
  ],
  "install_guidance": {
    "plugin": "Kaku",
    "binary": "kaku",
    "check": "which kaku",
    "install_steps": [
      "pip install kaku",
      "Verify: kaku --version",
      "supercli plugins install ./plugins/Kaku --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Kaku",
      "resource": "self",
      "action": "version",
      "description": "Print Kaku version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kaku",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Kaku: pip install kaku"
      },
      "args": []
    },
    {
      "namespace": "Kaku",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kaku CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kaku",
        "passthrough": true,
        "missingDependencyHelp": "Install Kaku: pip install kaku"
      },
      "args": []
    }
  ]
}