{
  "name": "qrgo",
  "version": "0.1.0",
  "description": "Fast QR code generator CLI in Go",
  "source": "https://github.com/qrgo/qrgo",
  "checks": [{"type": "binary", "name": "qrgo"}],
  "install_guidance": {
    "plugin": "qrgo",
    "binary": "qrgo",
    "check": "which qrgo",
    "install_steps": [
      "go install github.com/qrgo/qrgo@latest",
      "Verify: qrgo --version",
      "supercli plugins install ./qrgo --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "qrgo",
      "resource": "self",
      "action": "version",
      "description": "Print qrgo version",
      "adapter": "process",
      "adapterConfig": {"command": "qrgo", "baseArgs": ["--version"], "missingDependencyHelp": "Install qrgo: go install github.com/qrgo/qrgo@latest"},
      "args": []
    },
    {
      "namespace": "qrgo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qrgo CLI",
      "adapter": "process",
      "adapterConfig": {"command": "qrgo", "passthrough": true, "missingDependencyHelp": "Install qrgo: go install github.com/qrgo/qrgo@latest"},
      "args": []
    }
  ]
}
