{
  "name": "karpor",
  "version": "0.1.0",
  "description": "Kubernetes visibility and insight platform",
  "source": "https://github.com/KusionStack/karpor",
  "checks": [{ "type": "binary", "name": "karpor" }],
  "install_guidance": {
    "plugin": "karpor",
    "binary": "karpor",
    "check": "which karpor",
    "install_steps": ["brew install karpor", "Verify: karpor --version", "supercli plugins install ./plugins/karpor --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "karpor",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to karpor CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "karpor",
      "passthrough": true,
      "missingDependencyHelp": "Install karpor: brew install karpor"
    },
    "args": []
  }]
}
