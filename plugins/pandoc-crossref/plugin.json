{
  "name": "pandoc-crossref",
  "version": "0.1.0",
  "description": "Pandoc filter for cross-references",
  "source": "https://github.com/lierdakil/pandoc-crossref",
  "checks": [
    {
      "type": "binary",
      "name": "pandoc-crossref"
    }
  ],
  "install_guidance": {
    "plugin": "pandoc-crossref",
    "binary": "pandoc-crossref",
    "check": "which pandoc-crossref",
    "install_steps": [
      "brew install pandoc-crossref",
      "Verify: pandoc-crossref --version",
      "supercli plugins install ./plugins/pandoc-crossref --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "pandoc-crossref",
      "resource": "self",
      "action": "version",
      "description": "Print pandoc-crossref version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pandoc-crossref",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pandoc-crossref: brew install pandoc-crossref"
      },
      "args": []
    },
    {
      "namespace": "pandoc-crossref",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pandoc-crossref CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pandoc-crossref",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pandoc-crossref: brew install pandoc-crossref"
      },
      "args": []
    }
  ]
}
