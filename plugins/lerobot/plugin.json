{
  "name": "lerobot",
  "version": "0.1.0",
  "description": "\ud83e\udd17 LeRobot: Making AI for Robotics more accessible with end-to-end learning",
  "source": "https://github.com/lerobot/lerobot",
  "checks": [
    {
      "type": "binary",
      "name": "lerobot"
    }
  ],
  "install_guidance": {
    "plugin": "lerobot",
    "binary": "lerobot",
    "check": "which lerobot",
    "install_steps": [
      "pip install lerobot",
      "Verify: lerobot --version",
      "supercli plugins install ./plugins/lerobot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lerobot",
      "resource": "self",
      "action": "version",
      "description": "Print lerobot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lerobot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lerobot: pip install lerobot"
      },
      "args": []
    },
    {
      "namespace": "lerobot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lerobot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lerobot",
        "passthrough": true,
        "missingDependencyHelp": "Install lerobot: pip install lerobot"
      },
      "args": []
    }
  ]
}