{
  "name": "css-to-radium",
  "version": "0.1.0",
  "description": "Radium migration CLI, converts CSS to Radium-compatible JS objects.",
  "source": "https://github.com/css-to-radium/css-to-radium",
  "checks": [
    {
      "type": "binary",
      "name": "css-to-radium"
    }
  ],
  "install_guidance": {
    "plugin": "css-to-radium",
    "binary": "css-to-radium",
    "check": "which css-to-radium",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: css-to-radium --version",
      "supercli plugins install ./plugins/css-to-radium --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "css-to-radium",
      "resource": "self",
      "action": "version",
      "description": "Print css-to-radium version",
      "adapter": "process",
      "adapterConfig": {
        "command": "css-to-radium",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install css-to-radium from project repository"
      },
      "args": []
    },
    {
      "namespace": "css-to-radium",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to css-to-radium CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "css-to-radium",
        "passthrough": true,
        "missingDependencyHelp": "Install css-to-radium from project repository"
      },
      "args": []
    }
  ]
}