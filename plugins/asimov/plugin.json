{
  "name": "asimov",
  "version": "0.1.0",
  "description": "Python package release automation from CI",
  "source": "https://github.com/LSSTDESC/asimov",
  "checks": [{ "type": "binary", "name": "asimov" }],
  "install_guidance": {
    "plugin": "asimov",
    "binary": "asimov",
    "check": "which asimov",
    "install_steps": ["pip install asimov", "Verify: asimov --version", "supercli plugins install ./plugins/asimov --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "asimov",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to asimov CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "asimov",
      "passthrough": true,
      "missingDependencyHelp": "Install asimov: pip install asimov", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
