{
  "name": "doing",
  "version": "0.1.0",
  "description": "Keep track of what you’re doing and track what you’ve done",
  "source": "https://github.com/ttscoff/doing/",
  "checks": [
    {
      "type": "binary",
      "name": "doing"
    }
  ],
  "install_guidance": {
    "plugin": "doing",
    "binary": "doing",
    "check": "which doing",
    "install_steps": [
      "See https://github.com/ttscoff/doing/",
      "Verify: doing --version",
      "supercli plugins install ./plugins/doing --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "doing",
      "resource": "self",
      "action": "version",
      "description": "Print doing version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doing",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install doing: See https://github.com/ttscoff/doing/"
      },
      "args": []
    },
    {
      "namespace": "doing",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to doing CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "doing",
        "passthrough": true,
        "missingDependencyHelp": "Install doing"
      },
      "args": []
    }
  ]
}