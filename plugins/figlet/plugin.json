{
  "name": "figlet",
  "version": "0.1.0",
  "description": "Create ASCII art banners from text",
  "source": "https",
  "checks": [{"type": "binary", "name": "figlet"}],
  "install_guidance": {
    "plugin": "figlet",
    "binary": "figlet",
    "check": "which figlet",
    "install_steps": [
      "brew install figlet",
      "Verify: figlet --version",
      "supercli plugins install ./plugins/figlet --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "figlet",
      "resource": "self",
      "action": "version",
      "description": "Print figlet version",
      "adapter": "process",
      "adapterConfig": {"command": "figlet", "baseArgs": ["--version"], "missingDependencyHelp": "Install figlet: brew install figlet"},
      "args": []
    },
    {
      "namespace": "figlet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to figlet CLI",
      "adapter": "process",
      "adapterConfig": {"command": "figlet", "passthrough": true, "missingDependencyHelp": "Install figlet: brew install figlet"},
      "args": []
    }
  ]
}
