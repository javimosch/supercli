{
  "name": "daft",
  "version": "0.1.0",
  "description": "High-performance data engine",
  "source": "https://github.com/nickelc/daft",
  "checks": [
    {
      "type": "binary",
      "name": "daft"
    }
  ],
  "install_guidance": {
    "plugin": "daft",
    "binary": "daft",
    "check": "which daft",
    "install_steps": [
      "pip install daft",
      "Verify: daft --version",
      "supercli plugins install ./plugins/daft --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "daft",
      "resource": "self",
      "action": "version",
      "description": "Print daft version",
      "adapter": "process",
      "adapterConfig": {
        "command": "daft",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install daft: pip install daft"
      },
      "args": []
    },
    {
      "namespace": "daft",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to daft",
      "adapter": "process",
      "adapterConfig": {
        "command": "daft",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install daft: pip install daft"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
