{
  "name": "pnmdepth",
  "version": "0.1.0",
  "description": "CLI tool: pnmdepth",
  "source": "https://manpages.debian.org/pnmdepth",
  "checks": [
    {
      "type": "binary",
      "name": "pnmdepth"
    }
  ],
  "install_guidance": {
    "plugin": "pnmdepth",
    "binary": "pnmdepth",
    "check": "which pnmdepth",
    "install_steps": [
      "apt-get install pnmdepth 2>/dev/null || which pnmdepth",
      "Verify: pnmdepth --version",
      "supercli plugins install ./plugins/pnmdepth --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmdepth",
      "resource": "self",
      "action": "version",
      "description": "Print pnmdepth version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmdepth",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmdepth: apt-get install pnmdepth 2>/dev/null || which pnmdepth"
      },
      "args": []
    },
    {
      "namespace": "pnmdepth",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmdepth CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmdepth",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmdepth: apt-get install pnmdepth 2>/dev/null || which pnmdepth"
      },
      "args": []
    }
  ]
}