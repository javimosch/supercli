{
  "name": "git-ignore",
  "version": "0.1.0",
  "description": "Quickly fetch gitignore templates from the CLI",
  "source": "https://github.com/matthiasbeyer/git-ignore",
  "checks": [{ "type": "binary", "name": "git-ignore" }],
  "install_guidance": {
    "plugin": "git-ignore",
    "binary": "git-ignore",
    "check": "which git-ignore",
    "install_steps": ["npm install -g git-ignore", "Verify: git-ignore --version", "supercli plugins install ./plugins/git-ignore --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-ignore",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-ignore CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-ignore",
      "passthrough": true,
      "missingDependencyHelp": "Install git-ignore: npm install -g git-ignore", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
