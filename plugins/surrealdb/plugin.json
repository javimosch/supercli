{
  "name": "surrealdb",
  "version": "0.1.0",
  "description": "SurrealDB — scalable multi-model database CLI for document-graph, relational, and vector workloads",
  "source": "https://github.com/surrealdb/surrealdb",
  "checks": [
    {
      "type": "binary",
      "name": "surreal"
    }
  ],
  "install_guidance": {
    "plugin": "surrealdb",
    "binary": "surreal",
    "check": "which surreal",
    "install_steps": [
      "brew install surrealdb/tap/surreal",
      "Verify: surreal version",
      "Start a server: surreal start memory",
      "supercli plugins install ./plugins/surrealdb --on-conflict replace --json"
    ],
    "note": "Also available via: curl -fsSL https://install.surrealdb.com | sh, or docker pull surrealdb/surrealdb."
  },
  "commands": [
    {
      "namespace": "surrealdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to surreal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "surreal",
        "passthrough": true,
        "missingDependencyHelp": "Install SurrealDB: brew install surrealdb/tap/surreal"
      },
      "args": []
    }
  ]
}
