{
  "name": "cpuinfo",
  "version": "0.1.0",
  "description": "CLI tool: cpuinfo",
  "source": "https://packages.debian.org/cpuinfo",
  "checks": [{ "type": "binary", "name": "cpuinfo" }],
  "install_guidance": {
    "plugin": "cpuinfo", "binary": "cpuinfo", "check": "which cpuinfo",
    "install_steps": ["apt-get install cpuinfo 2>/dev/null || which cpuinfo", "Verify: cpuinfo --version", "supercli plugins install ./plugins/cpuinfo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpuinfo", "resource": "_", "action": "_",
    "description": "Passthrough to cpuinfo CLI",
    "adapter": "process", "adapterConfig": { "command": "cpuinfo", "passthrough": true, "missingDependencyHelp": "Install cpuinfo: apt-get install cpuinfo" }, "args": []
  }]
}
