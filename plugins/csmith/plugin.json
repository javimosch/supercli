{
  "name": "csmith",
  "version": "0.1.0",
  "description": "Generates random C programs conforming to the C99 standard",
  "source": "https://github.com/csmith-project/csmith",
  "checks": [
    {
      "type": "binary",
      "name": "csmith"
    }
  ],
  "install_guidance": {
    "plugin": "csmith",
    "binary": "csmith",
    "check": "which csmith",
    "install_steps": [
      "brew install csmith",
      "Verify: csmith --version",
      "supercli plugins install ./plugins/csmith --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "csmith",
      "resource": "self",
      "action": "version",
      "description": "Print csmith version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csmith",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csmith: brew install csmith"
      },
      "args": []
    },
    {
      "namespace": "csmith",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csmith CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csmith",
        "passthrough": true,
        "missingDependencyHelp": "Install csmith"
      },
      "args": []
    }
  ]
}