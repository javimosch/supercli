{
  "name": "psidtopgm",
  "version": "0.1.0",
  "description": "CLI tool: psidtopgm",
  "source": "https://manpages.debian.org/psidtopgm",
  "checks": [
    {
      "type": "binary",
      "name": "psidtopgm"
    }
  ],
  "install_guidance": {
    "plugin": "psidtopgm",
    "binary": "psidtopgm",
    "check": "which psidtopgm",
    "install_steps": [
      "apt-get install psidtopgm 2>/dev/null || which psidtopgm",
      "Verify: psidtopgm --version",
      "supercli plugins install ./plugins/psidtopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "psidtopgm",
      "resource": "self",
      "action": "version",
      "description": "Print psidtopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "psidtopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install psidtopgm: apt-get install psidtopgm 2>/dev/null || which psidtopgm"
      },
      "args": []
    },
    {
      "namespace": "psidtopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to psidtopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "psidtopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install psidtopgm: apt-get install psidtopgm 2>/dev/null || which psidtopgm"
      },
      "args": []
    }
  ]
}