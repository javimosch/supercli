{
  "name": "fkill-cli",
  "description": "Fabulously kill processes - cross-platform process killer",
  "version": "1.0.0",
  "binary": "fkill",
  "check": "fkill --version",
  "install": {
    "method": "npm",
    "command": "npm install -g fkill-cli"
  },
  "commands": {
    "kill": {
      "command": "fkill {process}",
      "description": "Kill a process by name or PID",
      "args": ["process"]
    },
    "kill-force": {
      "command": "fkill -f {process}",
      "description": "Force kill a process",
      "args": ["process"]
    },
    "interactive": {
      "command": "fkill",
      "description": "Interactively select and kill processes"
    }
  }
}
