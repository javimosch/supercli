{
  "name": "cf2tf",
  "version": "0.1.0",
  "description": "Cloudformation templates to Terraform HCL converter",
  "source": "https://github.com/DontShaveTheYak/cf2tf",
  "checks": [
    {
      "type": "binary",
      "name": "cf2tf"
    }
  ],
  "install_guidance": {
    "plugin": "cf2tf",
    "binary": "cf2tf",
    "check": "which cf2tf",
    "install_steps": [
      "brew install cf2tf",
      "Verify: cf2tf --version",
      "supercli plugins install ./plugins/cf2tf --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cf2tf",
      "resource": "self",
      "action": "version",
      "description": "Print cf2tf version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cf2tf",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cf2tf: brew install cf2tf"
      },
      "args": []
    },
    {
      "namespace": "cf2tf",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cf2tf CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cf2tf",
        "passthrough": true,
        "missingDependencyHelp": "Install cf2tf"
      },
      "args": []
    }
  ]
}