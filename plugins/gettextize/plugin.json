{
  "name": "gettextize",
  "version": "0.1.0",
  "description": "CLI tool: gettextize",
  "source": "https://manpages.debian.org/gettextize",
  "checks": [
    {
      "type": "binary",
      "name": "gettextize"
    }
  ],
  "install_guidance": {
    "plugin": "gettextize",
    "binary": "gettextize",
    "check": "which gettextize",
    "install_steps": [
      "apt-get install gettextize 2>/dev/null || which gettextize",
      "Verify: gettextize --version",
      "supercli plugins install ./plugins/gettextize --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gettextize",
      "resource": "self",
      "action": "version",
      "description": "Print gettextize version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gettextize",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gettextize: apt-get install gettextize 2>/dev/null || which gettextize"
      },
      "args": []
    },
    {
      "namespace": "gettextize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gettextize CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gettextize",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gettextize: apt-get install gettextize 2>/dev/null || which gettextize"
      },
      "args": []
    }
  ]
}