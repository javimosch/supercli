{
  "name": "ElaWidgetTools",
  "version": "0.1.0",
  "description": "Fluent-UI For QT-Widget",
  "source": "https://github.com/ElaWidgetTools/ElaWidgetTools",
  "checks": [
    {
      "type": "binary",
      "name": "elawidgettools"
    }
  ],
  "install_guidance": {
    "plugin": "ElaWidgetTools",
    "binary": "elawidgettools",
    "check": "which elawidgettools",
    "install_steps": [
      "pip install elawidgettools",
      "Verify: elawidgettools --version",
      "supercli plugins install ./plugins/ElaWidgetTools --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ElaWidgetTools",
      "resource": "self",
      "action": "version",
      "description": "Print ElaWidgetTools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "elawidgettools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ElaWidgetTools: pip install elawidgettools"
      },
      "args": []
    },
    {
      "namespace": "ElaWidgetTools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to elawidgettools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "elawidgettools",
        "passthrough": true,
        "missingDependencyHelp": "Install ElaWidgetTools: pip install elawidgettools"
      },
      "args": []
    }
  ]
}