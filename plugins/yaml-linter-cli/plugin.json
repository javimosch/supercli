{
  "name": "yaml-linter-cli",
  "version": "0.1.0",
  "description": "A CLI tool to validate YAML files for syntax errors, duplicate keys, and common anti-patterns with CI-friendly exit codes.",
  "source": "https://github.com/yaml-linter-cli/yaml-linter-cli",
  "checks": [
    {
      "type": "binary",
      "name": "yaml-linter-cli"
    }
  ],
  "install_guidance": {
    "plugin": "yaml-linter-cli",
    "binary": "yaml-linter-cli",
    "check": "which yaml-linter-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: yaml-linter-cli --version",
      "supercli plugins install ./plugins/yaml-linter-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "yaml-linter-cli",
      "resource": "self",
      "action": "version",
      "description": "Print yaml-linter-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yaml-linter-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yaml-linter-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "yaml-linter-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yaml-linter-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yaml-linter-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install yaml-linter-cli from project repository"
      },
      "args": []
    }
  ]
}