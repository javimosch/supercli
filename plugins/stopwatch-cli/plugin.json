{
  "name": "stopwatch-cli",
  "version": "0.1.0",
  "description": "Precision stopwatch with lap timing from the command line",
  "source": "https://github.com/nickcoutsos/stopwatch-cli",
  "checks": [{ "type": "binary", "name": "stopwatch-cli" }],
  "install_guidance": {
    "plugin": "stopwatch-cli",
    "binary": "stopwatch-cli",
    "check": "which stopwatch-cli",
    "install_steps": ["npm install -g stopwatch-cli", "Verify: stopwatch-cli --version", "supercli plugins install ./plugins/stopwatch-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "stopwatch-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to stopwatch-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "stopwatch-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install stopwatch-cli: npm install -g stopwatch-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
