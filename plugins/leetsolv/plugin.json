{
  "name": "leetsolv",
  "version": "0.1.0",
  "description": "CLI tool for DSA problem revision with spaced repetition",
  "source": "https://github.com/eannchen/leetsolv",
  "checks": [
    {
      "type": "binary",
      "name": "leetsolv"
    }
  ],
  "install_guidance": {
    "plugin": "leetsolv",
    "binary": "leetsolv",
    "check": "which leetsolv",
    "install_steps": [
      "brew install leetsolv",
      "Verify: leetsolv --version",
      "supercli plugins install ./plugins/leetsolv --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "leetsolv",
      "resource": "self",
      "action": "version",
      "description": "Print leetsolv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetsolv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install leetsolv: brew install leetsolv"
      },
      "args": []
    },
    {
      "namespace": "leetsolv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leetsolv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leetsolv",
        "passthrough": true,
        "missingDependencyHelp": "Install leetsolv"
      },
      "args": []
    }
  ]
}