{
  "name": "Notebooks-client",
  "version": "0.1.0",
  "description": "Proyecto con Angular.",
  "source": "https://yailin-notebooks.herokuapp.com/",
  "checks": [
    {
      "type": "binary",
      "name": "Notebooks-client"
    }
  ],
  "install_guidance": {
    "plugin": "Notebooks-client",
    "binary": "Notebooks-client",
    "check": "which Notebooks-client",
    "install_steps": [
      "Check https://yailin-notebooks.herokuapp.com/ for installation instructions",
      "Verify: Notebooks-client --version",
      "supercli plugins install ./plugins/Notebooks-client --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "Notebooks-client",
      "resource": "self",
      "action": "version",
      "description": "Print Notebooks-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Notebooks-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Notebooks-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "Notebooks-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Notebooks-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Notebooks-client",
        "passthrough": true,
        "missingDependencyHelp": "Install Notebooks-client from project repository"
      },
      "args": []
    }
  ]
}