{
  "name": "watchgnupg",
  "version": "0.1.0",
  "description": "CLI tool: watchgnupg",
  "source": "https://manpages.debian.org/watchgnupg",
  "checks": [
    {
      "type": "binary",
      "name": "watchgnupg"
    }
  ],
  "install_guidance": {
    "plugin": "watchgnupg",
    "binary": "watchgnupg",
    "check": "which watchgnupg",
    "install_steps": [
      "apt-get install watchgnupg 2>/dev/null || which watchgnupg",
      "Verify: watchgnupg --version",
      "supercli plugins install ./plugins/watchgnupg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "watchgnupg",
      "resource": "self",
      "action": "version",
      "description": "Print watchgnupg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "watchgnupg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install watchgnupg: apt-get install watchgnupg 2>/dev/null || which watchgnupg"
      },
      "args": []
    },
    {
      "namespace": "watchgnupg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to watchgnupg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "watchgnupg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install watchgnupg: apt-get install watchgnupg 2>/dev/null || which watchgnupg"
      },
      "args": []
    }
  ]
}