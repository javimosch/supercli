{
  "name": "agent-list",
  "version": "0.1.0",
  "description": "CLI tool: agent-list",
  "source": "https://packages.debian.org/agent-list",
  "checks": [{ "type": "binary", "name": "agent-list" }],
  "install_guidance": {
    "plugin": "agent-list", "binary": "agent-list", "check": "which agent-list",
    "install_steps": ["apt-get install agent-list 2>/dev/null || which agent-list", "Verify: agent-list --version", "supercli plugins install ./plugins/agent-list --on-conflict replace --json"]
