{
  "name": "gokart",
  "version": "0.1.0",
  "description": "Static code analysis for securing Go code",
  "source": "https://github.com/praetorian-inc/gokart",
  "checks": [
    {
      "type": "binary",
      "name": "gokart"
    }
  ],
  "install_guidance": {
    "plugin": "gokart",
    "binary": "gokart",
    "check": "which gokart",
    "install_steps": [
      "brew install gokart",
      "Verify: gokart --version",
      "supercli plugins install ./plugins/gokart --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gokart",
      "resource": "self",
      "action": "version",
      "description": "Print gokart version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gokart",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gokart: brew install gokart"
      },
      "args": []
    },
    {
      "namespace": "gokart",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gokart CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gokart",
        "passthrough": true,
        "missingDependencyHelp": "Install gokart"
      },
      "args": []
    }
  ]
}