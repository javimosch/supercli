{
  "name": "clangd",
  "version": "0.1.0",
  "description": "CLI tool: clangd",
  "source": "https://packages.debian.org/clangd",
  "checks": [{ "type": "binary", "name": "clangd" }],
  "install_guidance": {
    "plugin": "clangd", "binary": "clangd", "check": "which clangd",
    "install_steps": ["apt-get install clangd 2>/dev/null || which clangd", "Verify: clangd --version", "supercli plugins install ./plugins/clangd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clangd", "resource": "_", "action": "_",
    "description": "Passthrough to clangd CLI",
    "adapter": "process", "adapterConfig": { "command": "clangd", "passthrough": true, "missingDependencyHelp": "Install clangd: apt-get install clangd" }, "args": []
  }]
}
