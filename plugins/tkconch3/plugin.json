{
  "name": "tkconch3",
  "version": "0.1.0",
  "description": "CLI tool: tkconch3",
  "source": "https://manpages.debian.org/tkconch3",
  "checks": [
    {
      "type": "binary",
      "name": "tkconch3"
    }
  ],
  "install_guidance": {
    "plugin": "tkconch3",
    "binary": "tkconch3",
    "check": "which tkconch3",
    "install_steps": [
      "apt-get install tkconch3 2>/dev/null || which tkconch3",
      "Verify: tkconch3 --version",
      "supercli plugins install ./plugins/tkconch3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tkconch3",
      "resource": "self",
      "action": "version",
      "description": "Print tkconch3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tkconch3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tkconch3: apt-get install tkconch3 2>/dev/null || which tkconch3"
      },
      "args": []
    },
    {
      "namespace": "tkconch3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tkconch3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tkconch3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tkconch3: apt-get install tkconch3 2>/dev/null || which tkconch3"
      },
      "args": []
    }
  ]
}