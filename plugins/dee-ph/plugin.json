{
  "name": "dee-ph",
  "version": "0.1.0",
  "description": "Browse Product Hunt from the command line with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-ph" }],
  "install_guidance": {
    "plugin": "dee-ph",
    "binary": "dee-ph",
    "check": "which dee-ph",
    "install_steps": ["cargo install dee-ph", "Verify: dee-ph --version", "supercli plugins install ./plugins/dee-ph --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-ph",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-ph CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-ph",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-ph: cargo install dee-ph"
    },
    "args": []
  }]
}
