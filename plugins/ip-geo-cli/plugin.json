{
  "name": "ip-geo-cli",
  "version": "0.1.0",
  "description": "Fetch geolocation data for IP addresses via CLI",
  "source": "https://github.com/roryrjb/ip-geo-cli",
  "checks": [{ "type": "binary", "name": "ip-geo-cli" }],
  "install_guidance": {
    "plugin": "ip-geo-cli",
    "binary": "ip-geo-cli",
    "check": "which ip-geo-cli",
    "install_steps": ["npm install -g ip-geo-cli", "Verify: ip-geo-cli --version", "supercli plugins install ./plugins/ip-geo-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ip-geo-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ip-geo-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ip-geo-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install ip-geo-cli: npm install -g ip-geo-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
