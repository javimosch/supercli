{
  "name": "filebrowser",
  "version": "0.1.0",
  "description": "\ud83d\udcc2 Web File Browser",
  "source": "https://github.com/filebrowser/filebrowser",
  "checks": [
    {
      "type": "binary",
      "name": "filebrowser"
    }
  ],
  "install_guidance": {
    "plugin": "filebrowser",
    "binary": "filebrowser",
    "check": "which filebrowser",
    "install_steps": [
      "pip install filebrowser",
      "Verify: filebrowser --version",
      "supercli plugins install ./plugins/filebrowser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "filebrowser",
      "resource": "self",
      "action": "version",
      "description": "Print filebrowser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "filebrowser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install filebrowser: pip install filebrowser"
      },
      "args": []
    },
    {
      "namespace": "filebrowser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to filebrowser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "filebrowser",
        "passthrough": true,
        "missingDependencyHelp": "Install filebrowser: pip install filebrowser"
      },
      "args": []
    }
  ]
}