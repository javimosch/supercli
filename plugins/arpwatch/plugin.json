  "commands": [{
    "namespace": "arpwatch", "resource": "_", "action": "_",
    "description": "Passthrough to arpwatch CLI",
    "adapter": "process", "adapterConfig": { "command": "arpwatch", "passthrough": true, "missingDependencyHelp": "Install arpwatch: apt-get install arpwatch" }, "args": []
  }]
}
