{
  "name": "arpwatch",
  "version": "0.1.0",
  "description": "CLI tool: arpwatch",
  "source": "https://packages.debian.org/arpwatch",
  "checks": [{ "type": "binary", "name": "arpwatch" }],
  "install_guidance": {
    "plugin": "arpwatch", "binary": "arpwatch", "check": "which arpwatch",
    "install_steps": ["apt-get install arpwatch 2>/dev/null || which arpwatch", "Verify: arpwatch --version", "supercli plugins install ./plugins/arpwatch --on-conflict replace --json"]
