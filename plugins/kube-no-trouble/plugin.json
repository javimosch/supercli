{
  "name": "kube-no-trouble",
  "version": "0.1.0",
  "description": "Easily check your cluster for deprecated APIs",
  "source": "https://github.com/doitintl/kube-no-trouble",
  "checks": [{ "type": "binary", "name": "kubent" }],
  "install_guidance": {
    "plugin": "kube-no-trouble",
    "binary": "kubent",
    "check": "which kubent",
    "install_steps": ["brew install kubent", "Verify: kubent --version", "supercli plugins install ./plugins/kube-no-trouble --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kube-no-trouble",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubent CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubent",
      "passthrough": true,
      "missingDependencyHelp": "Install kube-no-trouble: brew install kubent"
    },
    "args": []
  }]
}
