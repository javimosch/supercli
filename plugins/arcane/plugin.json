{
  "name": "arcane",
  "version": "0.1.0",
  "description": "Modern Docker Management, Designed for Everyone",
  "source": "https://github.com/arcane/arcane",
  "checks": [
    {
      "type": "binary",
      "name": "arcane"
    }
  ],
  "install_guidance": {
    "plugin": "arcane",
    "binary": "arcane",
    "check": "which arcane",
    "install_steps": [
      "pip install arcane",
      "Verify: arcane --version",
      "supercli plugins install ./plugins/arcane --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "arcane",
      "resource": "self",
      "action": "version",
      "description": "Print arcane version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arcane",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arcane: pip install arcane"
      },
      "args": []
    },
    {
      "namespace": "arcane",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arcane CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "arcane",
        "passthrough": true,
        "missingDependencyHelp": "Install arcane: pip install arcane"
      },
      "args": []
    }
  ]
}