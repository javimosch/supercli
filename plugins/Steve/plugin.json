{
  "name": "Steve",
  "version": "0.1.0",
  "description": "Cursor for Minecraft",
  "source": "https://github.com/Steve/Steve",
  "checks": [
    {
      "type": "binary",
      "name": "steve"
    }
  ],
  "install_guidance": {
    "plugin": "Steve",
    "binary": "steve",
    "check": "which steve",
    "install_steps": [
      "pip install steve",
      "Verify: steve --version",
      "supercli plugins install ./plugins/Steve --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Steve",
      "resource": "self",
      "action": "version",
      "description": "Print Steve version",
      "adapter": "process",
      "adapterConfig": {
        "command": "steve",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Steve: pip install steve"
      },
      "args": []
    },
    {
      "namespace": "Steve",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to steve CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "steve",
        "passthrough": true,
        "missingDependencyHelp": "Install Steve: pip install steve"
      },
      "args": []
    }
  ]
}