{
  "name": "hotify",
  "version": "2.8.1",
  "description": "Traefik/Cloudflare app management CLI with Docker Compose support and external reverse proxy — deploy web apps with SSL, DNS, reverse proxy, and container management",
  "source": "https://github.com/javimosch/hotify-cli",
  "checks": [
    { "type": "binary", "name": "hotify-cli" }
  ],
  "install_guidance": {
    "plugin": "hotify",
    "binary": "hotify-cli",
    "check": "hotify-cli version",
    "install_steps": [
      "curl -LO https://github.com/javimosch/hotify-cli/releases/latest/download/hotify-cli-linux-amd64",
      "chmod +x hotify-cli-linux-amd64",
      "sudo mv hotify-cli-linux-amd64 /usr/local/bin/hotify-cli",
      "Verify: hotify-cli --help",
      "supercli plugins install ./plugins/hotify --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
