{
  "name": "mktexpk",
  "version": "0.1.0",
  "description": "CLI tool: mktexpk",
  "source": "https://manpages.debian.org/mktexpk",
  "checks": [
    {
      "type": "binary",
      "name": "mktexpk"
    }
  ],
  "install_guidance": {
    "plugin": "mktexpk",
    "binary": "mktexpk",
    "check": "which mktexpk",
    "install_steps": [
      "apt-get install mktexpk 2>/dev/null || which mktexpk",
      "Verify: mktexpk --version",
      "supercli plugins install ./plugins/mktexpk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mktexpk",
      "resource": "self",
      "action": "version",
      "description": "Print mktexpk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mktexpk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mktexpk: apt-get install mktexpk 2>/dev/null || which mktexpk"
      },
      "args": []
    },
    {
      "namespace": "mktexpk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mktexpk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mktexpk",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mktexpk: apt-get install mktexpk 2>/dev/null || which mktexpk"
      },
      "args": []
    }
  ]
}