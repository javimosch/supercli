{
  "name": "nom-derive",
  "version": "0.1.0",
  "description": "nom-derive — derive macros for nom parsers",
  "source": "https://github.com/rust-bakery/nom-derive",
  "checks": [
    {
      "type": "binary",
      "name": "nom-derive"
    }
  ],
  "install_guidance": {
    "plugin": "nom-derive",
    "binary": "nom-derive",
    "check": "which nom-derive",
    "install_steps": [
      "cargo add nom-derive",
      "Verify: nom-derive --version",
      "supercli plugins install ./plugins/nom-derive --on-conflict replace --json"
    ],
    "note": "nom-derive is a Rust derive macro library — use `cargo add nom-derive` inside a Rust project."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nom-derive",
      "resource": "self",
      "action": "version",
      "description": "Print nom-derive version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nom-derive",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install nom-derive: cargo add nom-derive"
      },
      "args": []
    }
  ]
}
