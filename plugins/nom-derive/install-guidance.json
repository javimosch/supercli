{
  "plugin": "nom-derive",
  "binary": "nom-derive",
  "check": "which nom-derive",
  "install_steps": [
    "cargo add nom-derive",
    "Verify: nom-derive --version",
    "supercli plugins install ./plugins/nom-derive --on-conflict replace --json"
  ],
  "note": "nom-derive is a Rust derive macro library — use `cargo add nom-derive` inside a Rust project."
}
