{
  "name": "dish",
  "version": "0.1.0",
  "description": "Lightweight monitoring service that efficiently checks socket connections",
  "source": "https://github.com/thevxn/dish",
  "checks": [
    {
      "type": "binary",
      "name": "dish"
    }
  ],
  "install_guidance": {
    "plugin": "dish",
    "binary": "dish",
    "check": "which dish",
    "install_steps": [
      "brew install dish",
      "Verify: dish --version",
      "supercli plugins install ./plugins/dish --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dish",
      "resource": "self",
      "action": "version",
      "description": "Print dish version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dish",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dish: brew install dish"
      },
      "args": []
    },
    {
      "namespace": "dish",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dish CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dish",
        "passthrough": true,
        "missingDependencyHelp": "Install dish"
      },
      "args": []
    }
  ]
}