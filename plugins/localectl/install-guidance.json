{
  "plugin": "localectl",
  "binary": "localectl",
  "check": "which localectl",
  "install_steps": [
    "apt-get install localectl 2>/dev/null || which localectl",
    "Verify: localectl --version",
    "supercli plugins install ./plugins/localectl --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}