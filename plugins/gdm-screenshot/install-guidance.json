{
  "plugin": "gdm-screenshot",
  "binary": "gdm-screenshot",
  "check": "which gdm-screenshot",
  "install_steps": [
    "apt-get install gdm-screenshot 2>/dev/null || which gdm-screenshot",
    "Verify: gdm-screenshot --version",
    "supercli plugins install ./plugins/gdm-screenshot --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}