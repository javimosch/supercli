{
  "name": "gdm-screenshot",
  "version": "0.1.0",
  "description": "CLI tool: gdm-screenshot",
  "source": "https://manpages.debian.org/gdm-screenshot",
  "checks": [
    {
      "type": "binary",
      "name": "gdm-screenshot"
    }
  ],
  "install_guidance": {
    "plugin": "gdm-screenshot",
    "binary": "gdm-screenshot",
    "check": "which gdm-screenshot",
    "install_steps": [
      "apt-get install gdm-screenshot 2>/dev/null || which gdm-screenshot",
      "Verify: gdm-screenshot --version",
      "supercli plugins install ./plugins/gdm-screenshot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdm-screenshot",
      "resource": "self",
      "action": "version",
      "description": "Print gdm-screenshot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdm-screenshot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdm-screenshot: apt-get install gdm-screenshot 2>/dev/null || which gdm-screenshot"
      },
      "args": []
    },
    {
      "namespace": "gdm-screenshot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdm-screenshot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdm-screenshot",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gdm-screenshot: apt-get install gdm-screenshot 2>/dev/null || which gdm-screenshot"
      },
      "args": []
    }
  ]
}