{
  "name": "luneta",
  "version": "0.1.0",
  "description": "Interactive filter that can be easily composed within any script.",
  "source": "https://github.com/fbeline/luneta",
  "checks": [
    {
      "type": "binary",
      "name": "luneta"
    }
  ],
  "install_guidance": {
    "plugin": "luneta",
    "binary": "luneta",
    "check": "which luneta",
    "install_steps": [
      "See https://github.com/fbeline/luneta",
      "Verify: luneta --version",
      "supercli plugins install ./plugins/luneta --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "luneta",
      "resource": "self",
      "action": "version",
      "description": "Print luneta version",
      "adapter": "process",
      "adapterConfig": {
        "command": "luneta",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install luneta: See https://github.com/fbeline/luneta"
      },
      "args": []
    },
    {
      "namespace": "luneta",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to luneta CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "luneta",
        "passthrough": true,
        "missingDependencyHelp": "Install luneta"
      },
      "args": []
    }
  ]
}