{
  "name": "dbdocs",
  "version": "0.1.0",
  "description": "Database documentation generator from schema files",
  "source": "https://github.com/dbdocs/dbdocs-cli",
  "checks": [{ "type": "binary", "name": "dbdocs" }],
  "install_guidance": {
    "plugin": "dbdocs",
    "binary": "dbdocs",
    "check": "which dbdocs",
    "install_steps": ["npm install -g dbdocs", "Verify: dbdocs --version", "supercli plugins install ./plugins/dbdocs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dbdocs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dbdocs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dbdocs",
      "passthrough": true,
      "missingDependencyHelp": "Install dbdocs: npm install -g dbdocs"
    },
    "args": []
  }]
}
