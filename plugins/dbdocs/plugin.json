{
  "name": "dbdocs",
  "version": "1.0.0",
  "description": "dbdocs \u2014 Database documentation",
  "source": "dbdocs.xyz",
  "checks": [
    {
      "type": "binary",
      "name": "dbdocs"
    }
  ],
  "install_guidance": {
    "plugin": "dbdocs",
    "binary": "dbdocs",
    "check": "which dbdocs",
    "install_steps": [
      "# Install dbdocs",
      "# See dbdocs.xyz",
      "# apt: sudo apt-get install dbdocs",
      "# brew: brew install dbdocs",
      "# cargo: cargo install dbdocs",
      "# npm: npm install -g dbdocs",
      "# pip: pip install dbdocs"
    ]
  },
  "commands": [
    {
      "namespace": "dbdocs",
      "resource": "dbdocs",
      "action": "run",
      "description": "Run dbdocs",
      "adapter": "process",
      "adapterConfig": {
        "command": "dbdocs",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dbdocs from dbdocs.xyz"
      },
      "args": []
    }
  ]
}