{
  "name": "class-dump",
  "version": "0.1.0",
  "description": "CLI tool: class-dump",
  "source": "https://packages.debian.org/class-dump",
  "checks": [{ "type": "binary", "name": "class-dump" }],
  "install_guidance": {
    "plugin": "class-dump", "binary": "class-dump", "check": "which class-dump",
    "install_steps": ["apt-get install class-dump 2>/dev/null || which class-dump", "Verify: class-dump --version", "supercli plugins install ./plugins/class-dump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "class-dump", "resource": "_", "action": "_",
    "description": "Passthrough to class-dump CLI",
    "adapter": "process", "adapterConfig": { "command": "class-dump", "passthrough": true, "missingDependencyHelp": "Install class-dump: apt-get install class-dump" }, "args": []
  }]
}
