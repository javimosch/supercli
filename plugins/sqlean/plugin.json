{
  "name": "sqlean",
  "version": "0.1.0",
  "description": "SQLite extensions pack for advanced database functionality",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "sqlean" }],
  "install_guidance": {
    "plugin": "sqlean",
    "binary": "sqlean",
    "check": "which sqlean",
    "install_steps": ["curl -sSL https://github.com/nalgeon/sqlean/releases/latest", "Verify: sqlean --version", "supercli plugins install ./plugins/sqlean --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sqlean",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sqlean CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sqlean",
      "passthrough": true,
      "missingDependencyHelp": "Install sqlean: curl -sSL https://github.com/nalgeon/sqlean/releases/latest"
    },
    "args": []
  }]
}
