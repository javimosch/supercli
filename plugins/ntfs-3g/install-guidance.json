{
  "plugin": "ntfs-3g",
  "binary": "ntfs-3g",
  "check": "which ntfs-3g",
  "install_steps": [
    "# Install ntfs-3g",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ntfs-3g-linux-amd64 -o /usr/local/bin/ntfs-3g",
    "chmod +x /usr/local/bin/ntfs-3g",
    "# Or via package manager, see /usr/bin/ntfs-3g"
  ]
}