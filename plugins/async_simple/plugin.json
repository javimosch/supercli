{
  "name": "async_simple",
  "version": "0.1.0",
  "description": "Simple, light-weight and easy-to-use asynchronous components",
  "source": "https://github.com/alibaba/async_simple",
  "checks": [
    {
      "type": "binary",
      "name": "async_simple"
    }
  ],
  "install_guidance": {
    "plugin": "async_simple",
    "binary": "async_simple",
    "check": "which async_simple",
    "install_steps": [
      "brew install async_simple",
      "Verify: async_simple --version",
      "supercli plugins install ./plugins/async_simple --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "async_simple",
      "resource": "self",
      "action": "version",
      "description": "Print async_simple version",
      "adapter": "process",
      "adapterConfig": {
        "command": "async_simple",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install async_simple: brew install async_simple"
      },
      "args": []
    },
    {
      "namespace": "async_simple",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to async_simple CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "async_simple",
        "passthrough": true,
        "missingDependencyHelp": "Install async_simple"
      },
      "args": []
    }
  ]
}