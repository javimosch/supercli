{
  "name": "unity-scope-loader",
  "version": "0.1.0",
  "description": "CLI tool: unity-scope-loader",
  "source": "https://manpages.debian.org/unity-scope-loader",
  "checks": [
    {
      "type": "binary",
      "name": "unity-scope-loader"
    }
  ],
  "install_guidance": {
    "plugin": "unity-scope-loader",
    "binary": "unity-scope-loader",
    "check": "which unity-scope-loader",
    "install_steps": [
      "apt-get install unity-scope-loader 2>/dev/null || which unity-scope-loader",
      "Verify: unity-scope-loader --version",
      "supercli plugins install ./plugins/unity-scope-loader --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unity-scope-loader",
      "resource": "self",
      "action": "version",
      "description": "Print unity-scope-loader version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unity-scope-loader",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unity-scope-loader: apt-get install unity-scope-loader 2>/dev/null || which unity-scope-loader"
      },
      "args": []
    },
    {
      "namespace": "unity-scope-loader",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unity-scope-loader CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unity-scope-loader",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unity-scope-loader: apt-get install unity-scope-loader 2>/dev/null || which unity-scope-loader"
      },
      "args": []
    }
  ]
}