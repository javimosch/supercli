{
  "name": "k0s",
  "version": "0.1.0",
  "description": "Zero-friction Kubernetes distribution",
  "source": "https://github.com/k0sproject/k0s",
  "checks": [{"type": "binary", "name": "k0s"}],
  "install_guidance": {
    "plugin": "k0s",
    "binary": "k0s",
    "check": "which k0s",
    "install_steps": [
      "curl -sSLf https",
      "Verify: k0s --version",
      "supercli plugins install ./plugins/k0s --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "k0s",
      "resource": "self",
      "action": "version",
      "description": "Print k0s version",
      "adapter": "process",
      "adapterConfig": {"command": "k0s", "baseArgs": ["--version"], "missingDependencyHelp": "Install k0s: curl -sSLf https"},
      "args": []
    },
    {
      "namespace": "k0s",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to k0s CLI",
      "adapter": "process",
      "adapterConfig": {"command": "k0s", "passthrough": true, "missingDependencyHelp": "Install k0s: curl -sSLf https"},
      "args": []
    }
  ]
}
