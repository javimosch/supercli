{
  "name": "perforator",
  "version": "0.1.0",
  "description": "Perforator is a cluster-wide continuous profiling tool designed for large data centers",
  "source": "https://github.com/perforator/perforator",
  "checks": [
    {
      "type": "binary",
      "name": "perforator"
    }
  ],
  "install_guidance": {
    "plugin": "perforator",
    "binary": "perforator",
    "check": "which perforator",
    "install_steps": [
      "pip install perforator",
      "Verify: perforator --version",
      "supercli plugins install ./plugins/perforator --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "perforator",
      "resource": "self",
      "action": "version",
      "description": "Print perforator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "perforator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install perforator: pip install perforator"
      },
      "args": []
    },
    {
      "namespace": "perforator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to perforator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "perforator",
        "passthrough": true,
        "missingDependencyHelp": "Install perforator: pip install perforator"
      },
      "args": []
    }
  ]
}