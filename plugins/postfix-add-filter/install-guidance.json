{
  "plugin": "postfix-add-filter",
  "binary": "postfix-add-filter",
  "check": "which postfix-add-filter",
  "install_steps": [
    "# Install postfix-add-filter",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/postfix-add-filter-linux-amd64 -o /usr/local/bin/postfix-add-filter",
    "chmod +x /usr/local/bin/postfix-add-filter",
    "# Or via package manager, see /usr/sbin/postfix-add-filter"
  ]
}