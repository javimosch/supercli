{
  "name": "postfix-add-filter",
  "version": "1.0.0",
  "description": "postfix-add-filter \u2014 postfix-add-filter \u2014 CLI utility",
  "source": "/usr/sbin/postfix-add-filter",
  "checks": [
    {
      "type": "binary",
      "name": "postfix-add-filter"
    }
  ],
  "install_guidance": {
    "plugin": "postfix-add-filter",
    "binary": "postfix-add-filter",
    "check": "which postfix-add-filter",
    "install_steps": [
      "# Install postfix-add-filter:",
      "# apt: sudo apt-get install postfix-add-filter",
      "# brew: brew install postfix-add-filter",
      "# cargo: cargo install postfix-add-filter",
      "# npm: npm install -g postfix-add-filter",
      "# pip: pip install postfix-add-filter",
      "# or download from /usr/sbin/postfix-add-filter"
    ]
  },
  "commands": [
    {
      "namespace": "postfix",
      "resource": "filter",
      "action": "run",
      "description": "Run postfix-add-filter",
      "adapter": "process",
      "adapterConfig": {
        "command": "postfix-add-filter",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postfix-add-filter from /usr/sbin/postfix-add-filter"
      },
      "args": []
    }
  ]
}