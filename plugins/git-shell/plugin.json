{
  "name": "git-shell",
  "version": "1.0.0",
  "description": "git-shell \u2014 CLI git-shell \u2014 Command-line utility for system administration",
  "source": "https://github.com/search?q=git-shell+cli",
  "checks": [
    {
      "type": "binary",
      "name": "git-shell"
    }
  ],
  "install_guidance": {
    "plugin": "git-shell",
    "binary": "git-shell",
    "check": "which git-shell",
    "install_steps": [
      "Install via package manager: apt install git-shell or brew install git-shell"
    ]
  },
  "commands": [
    {
      "namespace": "gitshell",
      "resource": "run",
      "action": "exec",
      "description": "git-shell \u2014 Command-line utility for system administration",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-shell",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install git-shell via package manager"
      },
      "args": []
    }
  ]
}