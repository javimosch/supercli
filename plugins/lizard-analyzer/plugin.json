{
  "name": "lizard-analyzer",
  "version": "0.1.0",
  "description": "Extensible Cyclomatic Complexity Analyzer",
  "source": "https://github.com/terryyin/lizard",
  "checks": [
    {
      "type": "binary",
      "name": "lizard-analyzer"
    }
  ],
  "install_guidance": {
    "plugin": "lizard-analyzer",
    "binary": "lizard-analyzer",
    "check": "which lizard-analyzer",
    "install_steps": [
      "brew install lizard-analyzer",
      "Verify: lizard-analyzer --version",
      "supercli plugins install ./plugins/lizard-analyzer --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lizard-analyzer",
      "resource": "self",
      "action": "version",
      "description": "Print lizard-analyzer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lizard-analyzer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lizard-analyzer: brew install lizard-analyzer"
      },
      "args": []
    },
    {
      "namespace": "lizard-analyzer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lizard-analyzer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lizard-analyzer",
        "passthrough": true,
        "missingDependencyHelp": "Install lizard-analyzer"
      },
      "args": []
    }
  ]
}