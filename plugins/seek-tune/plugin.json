{
  "name": "seek-tune",
  "version": "0.1.0",
  "description": "An implementation of Shazam's song recognition algorithm.",
  "source": "https://github.com/seek-tune/seek-tune",
  "checks": [
    {
      "type": "binary",
      "name": "seek-tune"
    }
  ],
  "install_guidance": {
    "plugin": "seek-tune",
    "binary": "seek-tune",
    "check": "which seek-tune",
    "install_steps": [
      "pip install seek-tune",
      "Verify: seek-tune --version",
      "supercli plugins install ./plugins/seek-tune --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "seek-tune",
      "resource": "self",
      "action": "version",
      "description": "Print seek-tune version",
      "adapter": "process",
      "adapterConfig": {
        "command": "seek-tune",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install seek-tune: pip install seek-tune"
      },
      "args": []
    },
    {
      "namespace": "seek-tune",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to seek-tune CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "seek-tune",
        "passthrough": true,
        "missingDependencyHelp": "Install seek-tune: pip install seek-tune"
      },
      "args": []
    }
  ]
}