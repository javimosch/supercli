{
  "name": "coloredlogs",
  "version": "0.1.0",
  "description": "CLI tool: coloredlogs",
  "source": "https://packages.debian.org/coloredlogs",
  "checks": [{ "type": "binary", "name": "coloredlogs" }],
  "install_guidance": {
    "plugin": "coloredlogs", "binary": "coloredlogs", "check": "which coloredlogs",
    "install_steps": ["apt-get install coloredlogs 2>/dev/null || which coloredlogs", "Verify: coloredlogs --version", "supercli plugins install ./plugins/coloredlogs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "coloredlogs", "resource": "_", "action": "_",
    "description": "Passthrough to coloredlogs CLI",
    "adapter": "process", "adapterConfig": { "command": "coloredlogs", "passthrough": true, "missingDependencyHelp": "Install coloredlogs: apt-get install coloredlogs" }, "args": []
  }]
}
