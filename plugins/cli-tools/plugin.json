{
  "name": "cli-tools",
  "version": "0.1.0",
  "description": "Docker image builds for Unified Streaming CLI tools (mp4split, unified_capture, etc)",
  "source": "https://github.com/cli-tools/cli-tools",
  "checks": [
    {
      "type": "binary",
      "name": "cli-tools"
    }
  ],
  "install_guidance": {
    "plugin": "cli-tools",
    "binary": "cli-tools",
    "check": "which cli-tools",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cli-tools --version",
      "supercli plugins install ./plugins/cli-tools --on-conflict replace --json"
    ],
    "note": "Dockerfile language CLI tool"
  },
  "commands": [
    {
      "namespace": "cli-tools",
      "resource": "self",
      "action": "version",
      "description": "Print cli-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-tools from project repository"
      },
      "args": []
    },
    {
      "namespace": "cli-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-tools from project repository"
      },
      "args": []
    }
  ]
}