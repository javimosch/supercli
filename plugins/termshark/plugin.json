{
  "name": "termshark",
  "version": "0.1.0",
  "description": "termshark \u2014 a terminal UI for tshark, inspired by Wireshark.",
  "source": "https://github.com/gcla/termshark",
  "checks": [
    {
      "type": "binary",
      "name": "termshark"
    }
  ],
  "install_guidance": {
    "plugin": "termshark",
    "binary": "termshark",
    "check": "which termshark",
    "install_steps": [
      "go install github.com/gcla/termshark@latest",
      "brew install termshark"
    ],
    "note": "Go. Terminal UI for tshark."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "termshark",
      "resource": "capture",
      "action": "run",
      "description": "Capture and analyze network traffic",
      "adapter": "process",
      "adapterConfig": {
        "command": "termshark",
        "missingDependencyHelp": "Install termshark",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "termshark",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "termshark",
        "missingDependencyHelp": "Install termshark",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
