{
  "name": "sam",
  "version": "0.1.0",
  "description": "Plan 9 text editor with structural regular expressions",
  "source": "https://github.com/deadpixi/sam",
  "checks": [{ "type": "binary", "name": "sam" }],
  "install_guidance": {
    "plugin": "sam",
    "binary": "sam",
    "check": "which sam",
    "install_steps": ["brew install sam", "Verify: sam --version", "supercli plugins install ./plugins/sam --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sam",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sam CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sam",
      "passthrough": true,
      "missingDependencyHelp": "Install sam: brew install sam", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
