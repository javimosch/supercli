{
  "name": "arpd",
  "version": "0.1.0",
  "description": "CLI tool: arpd",
  "source": "https://packages.debian.org/arpd",
  "checks": [{ "type": "binary", "name": "arpd" }],
  "install_guidance": {
    "plugin": "arpd", "binary": "arpd", "check": "which arpd",
    "install_steps": ["apt-get install arpd 2>/dev/null || which arpd", "Verify: arpd --version", "supercli plugins install ./plugins/arpd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "arpd", "resource": "_", "action": "_",
    "description": "Passthrough to arpd CLI",
    "adapter": "process", "adapterConfig": { "command": "arpd", "passthrough": true, "missingDependencyHelp": "Install arpd: apt-get install arpd" }, "args": []
  }]
}
