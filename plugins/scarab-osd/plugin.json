{
  "name": "scarab-osd",
  "version": "0.1.0",
  "description": "MWOSD - UAV HUD",
  "source": "https://github.com/scarab-osd/scarab-osd",
  "checks": [
    {
      "type": "binary",
      "name": "scarab-osd"
    }
  ],
  "install_guidance": {
    "plugin": "scarab-osd",
    "binary": "scarab-osd",
    "check": "which scarab-osd",
    "install_steps": [
      "pip install scarab-osd",
      "Verify: scarab-osd --version",
      "supercli plugins install ./plugins/scarab-osd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "scarab-osd",
      "resource": "self",
      "action": "version",
      "description": "Print scarab-osd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scarab-osd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scarab-osd: pip install scarab-osd"
      },
      "args": []
    },
    {
      "namespace": "scarab-osd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scarab-osd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scarab-osd",
        "passthrough": true,
        "missingDependencyHelp": "Install scarab-osd: pip install scarab-osd"
      },
      "args": []
    }
  ]
}