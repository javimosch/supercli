{
  "name": "Kronos",
  "version": "0.1.0",
  "description": "Kronos: A Foundation Model for the Language of Financial Markets",
  "source": "https://github.com/Kronos/Kronos",
  "checks": [
    {
      "type": "binary",
      "name": "kronos"
    }
  ],
  "install_guidance": {
    "plugin": "Kronos",
    "binary": "kronos",
    "check": "which kronos",
    "install_steps": [
      "pip install kronos",
      "Verify: kronos --version",
      "supercli plugins install ./plugins/Kronos --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Kronos",
      "resource": "self",
      "action": "version",
      "description": "Print Kronos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kronos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Kronos: pip install kronos"
      },
      "args": []
    },
    {
      "namespace": "Kronos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kronos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kronos",
        "passthrough": true,
        "missingDependencyHelp": "Install Kronos: pip install kronos"
      },
      "args": []
    }
  ]
}