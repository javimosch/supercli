{
  "name": "ic-wasm",
  "version": "0.1.0",
  "description": "CLI tool for performing Wasm transformations specific to ICP canisters",
  "source": "https://github.com/dfinity/ic-wasm",
  "checks": [
    {
      "type": "binary",
      "name": "ic-wasm"
    }
  ],
  "install_guidance": {
    "plugin": "ic-wasm",
    "binary": "ic-wasm",
    "check": "which ic-wasm",
    "install_steps": [
      "brew install ic-wasm",
      "Verify: ic-wasm --version",
      "supercli plugins install ./plugins/ic-wasm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ic-wasm",
      "resource": "self",
      "action": "version",
      "description": "Print ic-wasm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ic-wasm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ic-wasm: brew install ic-wasm"
      },
      "args": []
    },
    {
      "namespace": "ic-wasm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ic-wasm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ic-wasm",
        "passthrough": true,
        "missingDependencyHelp": "Install ic-wasm"
      },
      "args": []
    }
  ]
}