{
  "name": "dragonscript",
  "version": "1.0.0",
  "description": "dragonscript \u2014 DragonScript language",
  "source": "github.com/dragonscript/dragonscript",
  "checks": [
    {
      "type": "binary",
      "name": "dragonscript"
    }
  ],
  "install_guidance": {
    "plugin": "dragonscript",
    "binary": "dragonscript",
    "check": "which dragonscript",
    "install_steps": [
      "# Install dragonscript",
      "# See github.com/dragonscript/dragonscript",
      "# apt: sudo apt-get install dragonscript",
      "# brew: brew install dragonscript",
      "# cargo: cargo install dragonscript",
      "# npm: npm install -g dragonscript",
      "# pip: pip install dragonscript"
    ]
  },
  "commands": [
    {
      "namespace": "dragonscript",
      "resource": "dragonscript",
      "action": "run",
      "description": "Run dragonscript",
      "adapter": "process",
      "adapterConfig": {
        "command": "dragonscript",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dragonscript from github.com/dragonscript/dragonscript"
      },
      "args": []
    }
  ]
}