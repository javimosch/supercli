{
  "name": "cargo-mutants",
  "version": "0.1.0",
  "description": "Mutation testing for Rust projects to verify test suite quality",
  "source": "https://github.com/sourcefrog/cargo-mutants",
  "checks": [{ "type": "binary", "name": "cargo-mutants" }],
  "install_guidance": {
    "plugin": "cargo-mutants",
    "binary": "cargo-mutants",
    "check": "which cargo-mutants",
    "install_steps": ["cargo install cargo-mutants", "Verify: cargo-mutants --version", "supercli plugins install ./plugins/cargo-mutants --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-mutants",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-mutants CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-mutants",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-mutants: cargo install cargo-mutants"
    },
    "args": []
  }]
}
