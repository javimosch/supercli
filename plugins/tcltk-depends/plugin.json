{
  "name": "tcltk-depends",
  "version": "0.1.0",
  "description": "CLI tool: tcltk-depends",
  "source": "https://manpages.debian.org/tcltk-depends",
  "checks": [
    {
      "type": "binary",
      "name": "tcltk-depends"
    }
  ],
  "install_guidance": {
    "plugin": "tcltk-depends",
    "binary": "tcltk-depends",
    "check": "which tcltk-depends",
    "install_steps": [
      "apt-get install tcltk-depends 2>/dev/null || which tcltk-depends",
      "Verify: tcltk-depends --version",
      "supercli plugins install ./plugins/tcltk-depends --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tcltk-depends",
      "resource": "self",
      "action": "version",
      "description": "Print tcltk-depends version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tcltk-depends",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tcltk-depends: apt-get install tcltk-depends 2>/dev/null || which tcltk-depends"
      },
      "args": []
    },
    {
      "namespace": "tcltk-depends",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tcltk-depends CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tcltk-depends",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tcltk-depends: apt-get install tcltk-depends 2>/dev/null || which tcltk-depends"
      },
      "args": []
    }
  ]
}