{
  "name": "terminaltexteffects",
  "version": "0.1.0",
  "description": "Plays elaborate animations of text input",
  "source": "https://github.com/ChrisBuilds/terminaltexteffects",
  "checks": [
    {
      "type": "binary",
      "name": "terminaltexteffects"
    }
  ],
  "install_guidance": {
    "plugin": "terminaltexteffects",
    "binary": "terminaltexteffects",
    "check": "which terminaltexteffects",
    "install_steps": [
      "See https://github.com/ChrisBuilds/terminaltexteffects",
      "Verify: terminaltexteffects --version",
      "supercli plugins install ./plugins/terminaltexteffects --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "terminaltexteffects",
      "resource": "self",
      "action": "version",
      "description": "Print terminaltexteffects version",
      "adapter": "process",
      "adapterConfig": {
        "command": "terminaltexteffects",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install terminaltexteffects: See https://github.com/ChrisBuilds/terminaltexteffects"
      },
      "args": []
    },
    {
      "namespace": "terminaltexteffects",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to terminaltexteffects CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "terminaltexteffects",
        "passthrough": true,
        "missingDependencyHelp": "Install terminaltexteffects"
      },
      "args": []
    }
  ]
}