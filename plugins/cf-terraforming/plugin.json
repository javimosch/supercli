{
  "name": "cf-terraforming",
  "version": "0.1.0",
  "description": "CLI to facilitate terraforming your existing Cloudflare resources",
  "source": "https://github.com/cloudflare/cf-terraforming",
  "checks": [
    {
      "type": "binary",
      "name": "cf-terraforming"
    }
  ],
  "install_guidance": {
    "plugin": "cf-terraforming",
    "binary": "cf-terraforming",
    "check": "which cf-terraforming",
    "install_steps": [
      "brew install cf-terraforming",
      "Verify: cf-terraforming --version",
      "supercli plugins install ./plugins/cf-terraforming --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cf-terraforming",
      "resource": "self",
      "action": "version",
      "description": "Print cf-terraforming version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cf-terraforming",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cf-terraforming: brew install cf-terraforming"
      },
      "args": []
    },
    {
      "namespace": "cf-terraforming",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cf-terraforming CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cf-terraforming",
        "passthrough": true,
        "missingDependencyHelp": "Install cf-terraforming"
      },
      "args": []
    }
  ]
}