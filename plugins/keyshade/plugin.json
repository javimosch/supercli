{
  "name": "keyshade",
  "version": "0.1.0",
  "description": "Secret management tool with environment support",
  "source": "https://github.com/keyshade-dot/keyshade",
  "checks": [
    {
      "type": "binary",
      "name": "keyshade"
    }
  ],
  "install_guidance": {
    "plugin": "keyshade",
    "binary": "keyshade",
    "check": "which keyshade",
    "install_steps": [
      "npm install -g keyshade",
      "Verify: keyshade --version",
      "supercli plugins install ./plugins/keyshade --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "keyshade",
      "resource": "self",
      "action": "version",
      "description": "Print keyshade version",
      "adapter": "process",
      "adapterConfig": {
        "command": "keyshade",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install keyshade: npm install -g keyshade"
      },
      "args": []
    },
    {
      "namespace": "keyshade",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to keyshade CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "keyshade",
        "passthrough": true,
        "missingDependencyHelp": "Install keyshade: npm install -g keyshade"
      },
      "args": []
    }
  ]
}
