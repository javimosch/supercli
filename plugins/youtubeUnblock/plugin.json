{
  "name": "youtubeUnblock",
  "version": "0.1.0",
  "description": "Bypasses YouTube detection systems that rely on SNI.",
  "source": "https://github.com/youtubeUnblock/youtubeUnblock",
  "checks": [
    {
      "type": "binary",
      "name": "youtubeunblock"
    }
  ],
  "install_guidance": {
    "plugin": "youtubeUnblock",
    "binary": "youtubeunblock",
    "check": "which youtubeunblock",
    "install_steps": [
      "pip install youtubeunblock",
      "Verify: youtubeunblock --version",
      "supercli plugins install ./plugins/youtubeUnblock --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "youtubeUnblock",
      "resource": "self",
      "action": "version",
      "description": "Print youtubeUnblock version",
      "adapter": "process",
      "adapterConfig": {
        "command": "youtubeunblock",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install youtubeUnblock: pip install youtubeunblock"
      },
      "args": []
    },
    {
      "namespace": "youtubeUnblock",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to youtubeunblock CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "youtubeunblock",
        "passthrough": true,
        "missingDependencyHelp": "Install youtubeUnblock: pip install youtubeunblock"
      },
      "args": []
    }
  ]
}