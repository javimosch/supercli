{
  "name": "apt-mark",
  "version": "0.1.0",
  "description": "CLI tool: apt-mark",
  "source": "https://packages.debian.org/apt-mark",
  "checks": [{ "type": "binary", "name": "apt-mark" }],
  "install_guidance": {
    "plugin": "apt-mark", "binary": "apt-mark", "check": "which apt-mark",
    "install_steps": ["apt-get install apt-mark 2>/dev/null || which apt-mark", "Verify: apt-mark --version", "supercli plugins install ./plugins/apt-mark --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apt-mark", "resource": "_", "action": "_",
    "description": "Passthrough to apt-mark CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-mark", "passthrough": true, "missingDependencyHelp": "Install apt-mark: apt-get install apt-mark" }, "args": []
  }]
}
