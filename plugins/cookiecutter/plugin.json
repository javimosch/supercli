{
  "name": "cookiecutter",
  "version": "0.1.0",
  "description": "Create projects from templates",
  "source": "https://github.com/audreyr/cookiecutter",
  "checks": [
    {
      "type": "binary",
      "name": "cookiecutter"
    }
  ],
  "install_guidance": {
    "plugin": "cookiecutter",
    "binary": "cookiecutter",
    "check": "which cookiecutter",
    "install_steps": [
      "brew install cookiecutter",
      "Verify: cookiecutter --version",
      "supercli plugins install ./plugins/cookiecutter --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cookiecutter",
      "resource": "self",
      "action": "version",
      "description": "Print cookiecutter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cookiecutter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cookiecutter: brew install cookiecutter"
      },
      "args": []
    },
    {
      "namespace": "cookiecutter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cookiecutter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cookiecutter",
        "passthrough": true,
        "missingDependencyHelp": "Install cookiecutter"
      },
      "args": []
    }
  ]
}