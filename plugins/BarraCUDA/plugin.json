{
  "name": "BarraCUDA",
  "version": "0.1.0",
  "description": "Open-source CUDA, Triton and HIP compiler targeting multiple GPU architectures. ",
  "source": "https://github.com/BarraCUDA/BarraCUDA",
  "checks": [
    {
      "type": "binary",
      "name": "barracuda"
    }
  ],
  "install_guidance": {
    "plugin": "BarraCUDA",
    "binary": "barracuda",
    "check": "which barracuda",
    "install_steps": [
      "pip install barracuda",
      "Verify: barracuda --version",
      "supercli plugins install ./plugins/BarraCUDA --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BarraCUDA",
      "resource": "self",
      "action": "version",
      "description": "Print BarraCUDA version",
      "adapter": "process",
      "adapterConfig": {
        "command": "barracuda",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BarraCUDA: pip install barracuda"
      },
      "args": []
    },
    {
      "namespace": "BarraCUDA",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to barracuda CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "barracuda",
        "passthrough": true,
        "missingDependencyHelp": "Install BarraCUDA: pip install barracuda"
      },
      "args": []
    }
  ]
}