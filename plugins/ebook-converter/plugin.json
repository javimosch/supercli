{
  "name": "ebook-converter",
  "version": "0.1.0",
  "description": "CLI utility for ebook format conversion based on Calibre components",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "ebook-converter" }],
  "install_guidance": {
    "plugin": "ebook-converter",
    "binary": "ebook-converter",
    "check": "which ebook-converter",
    "install_steps": ["git clone && python3 ebook-converter.py", "Verify: ebook-converter --version", "supercli plugins install ./plugins/ebook-converter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ebook-converter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ebook-converter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ebook-converter",
      "passthrough": true,
      "missingDependencyHelp": "Install ebook-converter: git clone && python3 ebook-converter.py"
    },
    "args": []
  }]
}
