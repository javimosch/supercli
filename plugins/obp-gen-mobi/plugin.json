{
  "name": "obp-gen-mobi",
  "version": "0.1.0",
  "description": "Tool dedicated to converting EPUB files to AZW3 Kindle format",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "obp-gen-mobi" }],
  "install_guidance": {
    "plugin": "obp-gen-mobi",
    "binary": "obp-gen-mobi",
    "check": "which obp-gen-mobi",
    "install_steps": ["git clone && python3 setup.py", "Verify: obp-gen-mobi --version", "supercli plugins install ./plugins/obp-gen-mobi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "obp-gen-mobi",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to obp-gen-mobi CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "obp-gen-mobi",
      "passthrough": true,
      "missingDependencyHelp": "Install obp-gen-mobi: git clone && python3 setup.py"
    },
    "args": []
  }]
}
