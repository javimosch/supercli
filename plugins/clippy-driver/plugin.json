{
  "name": "clippy-driver",
  "version": "0.1.0",
  "description": "CLI tool: clippy-driver",
  "source": "https://packages.debian.org/clippy-driver",
  "checks": [{ "type": "binary", "name": "clippy-driver" }],
  "install_guidance": {
    "plugin": "clippy-driver", "binary": "clippy-driver", "check": "which clippy-driver",
    "install_steps": ["apt-get install clippy-driver 2>/dev/null || which clippy-driver", "Verify: clippy-driver --version", "supercli plugins install ./plugins/clippy-driver --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clippy-driver", "resource": "_", "action": "_",
    "description": "Passthrough to clippy-driver CLI",
    "adapter": "process", "adapterConfig": { "command": "clippy-driver", "passthrough": true, "missingDependencyHelp": "Install clippy-driver: apt-get install clippy-driver" }, "args": []
  }]
}
