{
  "name": "harper",
  "version": "0.1.0",
  "description": "Offline, privacy-first grammar checker. Fast, open-source, Rust-powered",
  "source": "https://github.com/harper/harper",
  "checks": [
    {
      "type": "binary",
      "name": "harper"
    }
  ],
  "install_guidance": {
    "plugin": "harper",
    "binary": "harper",
    "check": "which harper",
    "install_steps": [
      "pip install harper",
      "Verify: harper --version",
      "supercli plugins install ./plugins/harper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "harper",
      "resource": "self",
      "action": "version",
      "description": "Print harper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "harper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install harper: pip install harper"
      },
      "args": []
    },
    {
      "namespace": "harper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to harper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "harper",
        "passthrough": true,
        "missingDependencyHelp": "Install harper: pip install harper"
      },
      "args": []
    }
  ]
}