{
  "plugin": "gocryptfs",
  "binary": "gocryptfs",
  "check": "which gocryptfs",
  "install_steps": [
    "# Install gocryptfs",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/gocryptfs-linux-amd64 -o /usr/local/bin/gocryptfs",
    "chmod +x /usr/local/bin/gocryptfs",
    "# Or via package manager, see github.com/rfjakob/gocryptfs"
  ]
}