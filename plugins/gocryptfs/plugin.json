{
  "name": "gocryptfs",
  "version": "1.0.0",
  "description": "gocryptfs \u2014 Encrypted overlay filesystem",
  "source": "github.com/rfjakob/gocryptfs",
  "checks": [
    {
      "type": "binary",
      "name": "gocryptfs"
    }
  ],
  "install_guidance": {
    "plugin": "gocryptfs",
    "binary": "gocryptfs",
    "check": "which gocryptfs",
    "install_steps": [
      "# Install gocryptfs:",
      "# apt: sudo apt-get install gocryptfs",
      "# brew: brew install gocryptfs",
      "# cargo: cargo install gocryptfs",
      "# npm: npm install -g gocryptfs",
      "# pip: pip install gocryptfs",
      "# or download from github.com/rfjakob/gocryptfs"
    ]
  },
  "commands": [
    {
      "namespace": "gocryptfs",
      "resource": "gocryptfs",
      "action": "run",
      "description": "Run gocryptfs",
      "adapter": "process",
      "adapterConfig": {
        "command": "gocryptfs",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gocryptfs from github.com/rfjakob/gocryptfs"
      },
      "args": []
    }
  ]
}