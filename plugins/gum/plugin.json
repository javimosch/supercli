{
  "name": "gum",
  "version": "0.1.0",
  "description": "Glamorous shell scripts with interactive terminal components",
  "source": "https://github.com/charmbracelet/gum",
  "checks": [{ "type": "binary", "name": "gum" }],
  "install_guidance": {
    "plugin": "gum",
    "binary": "gum",
    "check": "which gum",
    "install_steps": ["brew install gum", "Verify: gum --version", "supercli plugins install ./plugins/gum --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gum",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gum CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gum",
      "passthrough": true,
      "missingDependencyHelp": "Install gum: brew install gum"
    },
    "args": []
  }]
}
