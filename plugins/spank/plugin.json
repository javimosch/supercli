{
  "name": "spank",
  "version": "0.1.0",
  "description": "Slap your MacBook, it yells back. Uses Apple Silicon accelerometer via IOKit HID.",
  "source": "https://github.com/spank/spank",
  "checks": [
    {
      "type": "binary",
      "name": "spank"
    }
  ],
  "install_guidance": {
    "plugin": "spank",
    "binary": "spank",
    "check": "which spank",
    "install_steps": [
      "pip install spank",
      "Verify: spank --version",
      "supercli plugins install ./plugins/spank --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "spank",
      "resource": "self",
      "action": "version",
      "description": "Print spank version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spank",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spank: pip install spank"
      },
      "args": []
    },
    {
      "namespace": "spank",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spank CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spank",
        "passthrough": true,
        "missingDependencyHelp": "Install spank: pip install spank"
      },
      "args": []
    }
  ]
}