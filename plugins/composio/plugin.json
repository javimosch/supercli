{
  "name": "composio",
  "version": "0.1.0",
  "description": "Composio powers 1000+ toolkits, tool search, context management, authentication, and a sandboxed wor",
  "source": "https://github.com/composio/composio",
  "checks": [
    {
      "type": "binary",
      "name": "composio"
    }
  ],
  "install_guidance": {
    "plugin": "composio",
    "binary": "composio",
    "check": "which composio",
    "install_steps": [
      "pip install composio",
      "Verify: composio --version",
      "supercli plugins install ./plugins/composio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "composio",
      "resource": "self",
      "action": "version",
      "description": "Print composio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "composio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install composio: pip install composio"
      },
      "args": []
    },
    {
      "namespace": "composio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to composio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "composio",
        "passthrough": true,
        "missingDependencyHelp": "Install composio: pip install composio"
      },
      "args": []
    }
  ]
}