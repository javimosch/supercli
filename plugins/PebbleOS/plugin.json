{
  "name": "PebbleOS",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/PebbleOS/PebbleOS",
  "checks": [
    {
      "type": "binary",
      "name": "pebbleos"
    }
  ],
  "install_guidance": {
    "plugin": "PebbleOS",
    "binary": "pebbleos",
    "check": "which pebbleos",
    "install_steps": [
      "pip install pebbleos",
      "Verify: pebbleos --version",
      "supercli plugins install ./plugins/PebbleOS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PebbleOS",
      "resource": "self",
      "action": "version",
      "description": "Print PebbleOS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pebbleos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PebbleOS: pip install pebbleos"
      },
      "args": []
    },
    {
      "namespace": "PebbleOS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pebbleos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pebbleos",
        "passthrough": true,
        "missingDependencyHelp": "Install PebbleOS: pip install pebbleos"
      },
      "args": []
    }
  ]
}