{
  "name": "findfs",
  "version": "0.1.0",
  "description": "CLI tool: findfs",
  "source": "https://manpages.debian.org/findfs",
  "checks": [
    {
      "type": "binary",
      "name": "findfs"
    }
  ],
  "install_guidance": {
    "plugin": "findfs",
    "binary": "findfs",
    "check": "which findfs",
    "install_steps": [
      "apt-get install findfs 2>/dev/null || which findfs",
      "Verify: findfs --version",
      "supercli plugins install ./plugins/findfs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "findfs",
      "resource": "self",
      "action": "version",
      "description": "Print findfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "findfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install findfs: apt-get install findfs 2>/dev/null || which findfs"
      },
      "args": []
    },
    {
      "namespace": "findfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to findfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "findfs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install findfs: apt-get install findfs 2>/dev/null || which findfs"
      },
      "args": []
    }
  ]
}