{
  "name": "iflow-cli",
  "version": "0.1.0",
  "description": "iFlow cli is a comprehensive command-line intelligence that embeds in your terminal, analyzes your r",
  "source": "https://github.com/iflow-cli/iflow-cli",
  "checks": [
    {
      "type": "binary",
      "name": "iflow-cli"
    }
  ],
  "install_guidance": {
    "plugin": "iflow-cli",
    "binary": "iflow-cli",
    "check": "which iflow-cli",
    "install_steps": [
      "pip install iflow-cli",
      "Verify: iflow-cli --version",
      "supercli plugins install ./plugins/iflow-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "iflow-cli",
      "resource": "self",
      "action": "version",
      "description": "Print iflow-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iflow-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iflow-cli: pip install iflow-cli"
      },
      "args": []
    },
    {
      "namespace": "iflow-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iflow-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iflow-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install iflow-cli: pip install iflow-cli"
      },
      "args": []
    }
  ]
}