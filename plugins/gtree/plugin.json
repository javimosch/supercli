{
  "name": "gtree",
  "version": "0.1.0",
  "description": "Use markdown to generate directory trees and the directories itself",
  "source": "https://github.com/ddddddO/gtree",
  "checks": [
    {
      "type": "binary",
      "name": "gtree"
    }
  ],
  "install_guidance": {
    "plugin": "gtree",
    "binary": "gtree",
    "check": "which gtree",
    "install_steps": [
      "brew install gtree",
      "Verify: gtree --version",
      "supercli plugins install ./plugins/gtree --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gtree",
      "resource": "self",
      "action": "version",
      "description": "Print gtree version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtree",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtree: brew install gtree"
      },
      "args": []
    },
    {
      "namespace": "gtree",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtree CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtree",
        "passthrough": true,
        "missingDependencyHelp": "Install gtree"
      },
      "args": []
    }
  ]
}