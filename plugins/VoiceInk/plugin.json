{
  "name": "VoiceInk",
  "version": "0.1.0",
  "description": "The best open-source alternative to Superwhisper & Wispr Flow. Voice-to-text app for macOS with no s",
  "source": "https://github.com/VoiceInk/VoiceInk",
  "checks": [
    {
      "type": "binary",
      "name": "voiceink"
    }
  ],
  "install_guidance": {
    "plugin": "VoiceInk",
    "binary": "voiceink",
    "check": "which voiceink",
    "install_steps": [
      "pip install voiceink",
      "Verify: voiceink --version",
      "supercli plugins install ./plugins/VoiceInk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VoiceInk",
      "resource": "self",
      "action": "version",
      "description": "Print VoiceInk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "voiceink",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VoiceInk: pip install voiceink"
      },
      "args": []
    },
    {
      "namespace": "VoiceInk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to voiceink CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "voiceink",
        "passthrough": true,
        "missingDependencyHelp": "Install VoiceInk: pip install voiceink"
      },
      "args": []
    }
  ]
}