{
  "name": "bazaar",
  "version": "0.1.0",
  "description": "New App Store for GNOME",
  "source": "https://github.com/bazaar/bazaar",
  "checks": [
    {
      "type": "binary",
      "name": "bazaar"
    }
  ],
  "install_guidance": {
    "plugin": "bazaar",
    "binary": "bazaar",
    "check": "which bazaar",
    "install_steps": [
      "pip install bazaar",
      "Verify: bazaar --version",
      "supercli plugins install ./plugins/bazaar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bazaar",
      "resource": "self",
      "action": "version",
      "description": "Print bazaar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bazaar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bazaar: pip install bazaar"
      },
      "args": []
    },
    {
      "namespace": "bazaar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bazaar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bazaar",
        "passthrough": true,
        "missingDependencyHelp": "Install bazaar: pip install bazaar"
      },
      "args": []
    }
  ]
}