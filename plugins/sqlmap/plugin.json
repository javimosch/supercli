{
  "name": "sqlmap",
  "version": "0.1.0",
  "description": "SQL injection detection and exploitation tool",
  "source": "https",
  "checks": [{"type": "binary", "name": "sqlmap"}],
  "install_guidance": {
    "plugin": "sqlmap",
    "binary": "sqlmap",
    "check": "which sqlmap",
    "install_steps": [
      "brew install sqlmap",
      "Verify: sqlmap --version",
      "supercli plugins install ./plugins/sqlmap --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "sqlmap",
      "resource": "self",
      "action": "version",
      "description": "Print sqlmap version",
      "adapter": "process",
      "adapterConfig": {"command": "sqlmap", "baseArgs": ["--version"], "missingDependencyHelp": "Install sqlmap: brew install sqlmap"},
      "args": []
    },
    {
      "namespace": "sqlmap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sqlmap CLI",
      "adapter": "process",
      "adapterConfig": {"command": "sqlmap", "passthrough": true, "missingDependencyHelp": "Install sqlmap: brew install sqlmap"},
      "args": []
    }
  ]
}
