{
  "name": "express-cli",
  "version": "0.1.0",
  "description": "A command line tool that scaffolds express application code in both javscript and typescript to speed up development experience. Inspired by nest js cli  ",
  "source": "https://github.com/express-cli/express-cli",
  "checks": [
    {
      "type": "binary",
      "name": "express-cli"
    }
  ],
  "install_guidance": {
    "plugin": "express-cli",
    "binary": "express-cli",
    "check": "which express-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: express-cli --version",
      "supercli plugins install ./plugins/express-cli --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "express-cli",
      "resource": "self",
      "action": "version",
      "description": "Print express-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "express-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install express-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "express-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to express-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "express-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install express-cli from project repository"
      },
      "args": []
    }
  ]
}