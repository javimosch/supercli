{
  "name": "iwd",
  "version": "1.0.0",
  "description": "iwd \u2014 Wireless daemon",
  "source": "iwd.wiki.kernel.org",
  "checks": [
    {
      "type": "binary",
      "name": "iwd"
    }
  ],
  "install_guidance": {
    "plugin": "iwd",
    "binary": "iwd",
    "check": "which iwd",
    "install_steps": [
      "# Install iwd",
      "# See iwd.wiki.kernel.org",
      "# apt: sudo apt-get install iwd",
      "# brew: brew install iwd",
      "# cargo: cargo install iwd",
      "# npm: npm install -g iwd",
      "# pip: pip install iwd"
    ]
  },
  "commands": [
    {
      "namespace": "iwd",
      "resource": "iwd",
      "action": "run",
      "description": "Run iwd",
      "adapter": "process",
      "adapterConfig": {
        "command": "iwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install iwd from iwd.wiki.kernel.org"
      },
      "args": []
    }
  ]
}