{
  "name": "webtorrent-cli",
  "version": "0.1.0",
  "description": "Streaming torrent client",
  "source": "https://github.com/feross/webtorrent-cli",
  "checks": [
    {
      "type": "binary",
      "name": "webtorrent-cli"
    }
  ],
  "install_guidance": {
    "plugin": "webtorrent-cli",
    "binary": "webtorrent-cli",
    "check": "which webtorrent-cli",
    "install_steps": [
      "brew install webtorrent-cli",
      "Verify: webtorrent-cli --version",
      "supercli plugins install ./plugins/webtorrent-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "webtorrent-cli",
      "resource": "self",
      "action": "version",
      "description": "Print webtorrent-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "webtorrent-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install webtorrent-cli: brew install webtorrent-cli"
      },
      "args": []
    },
    {
      "namespace": "webtorrent-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to webtorrent-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "webtorrent-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install webtorrent-cli"
      },
      "args": []
    }
  ]
}