{
  "name": "websocket-client-simple",
  "version": "0.1.0",
  "description": "Simple WebSocket Client on Ruby",
  "source": "https://rubygems.org/gems/websocket-client-simple",
  "checks": [
    {
      "type": "binary",
      "name": "websocket-client-simple"
    }
  ],
  "install_guidance": {
    "plugin": "websocket-client-simple",
    "binary": "websocket-client-simple",
    "check": "which websocket-client-simple",
    "install_steps": [
      "Check https://rubygems.org/gems/websocket-client-simple for installation instructions",
      "Verify: websocket-client-simple --version",
      "supercli plugins install ./plugins/websocket-client-simple --on-conflict replace --json"
    ],
    "note": "Ruby language CLI tool"
  },
  "commands": [
    {
      "namespace": "websocket-client-simple",
      "resource": "self",
      "action": "version",
      "description": "Print websocket-client-simple version",
      "adapter": "process",
      "adapterConfig": {
        "command": "websocket-client-simple",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install websocket-client-simple from project repository"
      },
      "args": []
    },
    {
      "namespace": "websocket-client-simple",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to websocket-client-simple CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "websocket-client-simple",
        "passthrough": true,
        "missingDependencyHelp": "Install websocket-client-simple from project repository"
      },
      "args": []
    }
  ]
}