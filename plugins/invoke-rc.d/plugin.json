{
  "name": "invoke-rc.d",
  "version": "0.1.0",
  "description": "CLI tool: invoke-rc.d",
  "source": "https://manpages.debian.org/invoke-rc.d",
  "checks": [
    {
      "type": "binary",
      "name": "invoke-rc.d"
    }
  ],
  "install_guidance": {
    "plugin": "invoke-rc.d",
    "binary": "invoke-rc.d",
    "check": "which invoke-rc.d",
    "install_steps": [
      "apt-get install invoke-rc.d 2>/dev/null || which invoke-rc.d",
      "Verify: invoke-rc.d --version",
      "supercli plugins install ./plugins/invoke-rc.d --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "invoke-rc.d",
      "resource": "self",
      "action": "version",
      "description": "Print invoke-rc.d version",
      "adapter": "process",
      "adapterConfig": {
        "command": "invoke-rc.d",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install invoke-rc.d: apt-get install invoke-rc.d 2>/dev/null || which invoke-rc.d"
      },
      "args": []
    },
    {
      "namespace": "invoke-rc.d",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to invoke-rc.d CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "invoke-rc.d",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install invoke-rc.d: apt-get install invoke-rc.d 2>/dev/null || which invoke-rc.d"
      },
      "args": []
    }
  ]
}