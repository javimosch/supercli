{
  "name": "dh_installppp",
  "version": "0.1.0",
  "description": "CLI tool: dh_installppp",
  "source": "https://packages.debian.org/dh_installppp",
  "checks": [{ "type": "binary", "name": "dh_installppp" }],
  "install_guidance": {
    "plugin": "dh_installppp", "binary": "dh_installppp", "check": "which dh_installppp",
    "install_steps": ["apt-get install dh_installppp 2>/dev/null || which dh_installppp", "Verify: dh_installppp --version", "supercli plugins install ./plugins/dh_installppp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_installppp", "resource": "_", "action": "_",
    "description": "Passthrough to dh_installppp CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_installppp", "passthrough": true, "missingDependencyHelp": "Install dh_installppp: apt-get install dh_installppp" }, "args": []
  }]
}
