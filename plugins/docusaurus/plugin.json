{
  "name": "docusaurus",
  "version": "0.1.0",
  "description": "Build optimized documentation websites",
  "source": "https",
  "checks": [{"type": "binary", "name": "docusaurus"}],
  "install_guidance": {
    "plugin": "docusaurus",
    "binary": "docusaurus",
    "check": "which docusaurus",
    "install_steps": [
      "npm install -g docusaurus",
      "Verify: docusaurus --version",
      "supercli plugins install ./plugins/docusaurus --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "docusaurus",
      "resource": "self",
      "action": "version",
      "description": "Print docusaurus version",
      "adapter": "process",
      "adapterConfig": {"command": "docusaurus", "baseArgs": ["--version"], "missingDependencyHelp": "Install docusaurus: npm install -g docusaurus"},
      "args": []
    },
    {
      "namespace": "docusaurus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docusaurus CLI",
      "adapter": "process",
      "adapterConfig": {"command": "docusaurus", "passthrough": true, "missingDependencyHelp": "Install docusaurus: npm install -g docusaurus"},
      "args": []
    }
  ]
}
