{
  "name": "aptitude-changelog-parser",
  "version": "0.1.0",
  "description": "CLI tool: aptitude-changelog-parser",
  "source": "https://packages.debian.org/aptitude-changelog-parser",
  "checks": [{ "type": "binary", "name": "aptitude-changelog-parser" }],
  "install_guidance": {
    "plugin": "aptitude-changelog-parser", "binary": "aptitude-changelog-parser", "check": "which aptitude-changelog-parser",
    "install_steps": ["apt-get install aptitude-changelog-parser 2>/dev/null || which aptitude-changelog-parser", "Verify: aptitude-changelog-parser --version", "supercli plugins install ./plugins/aptitude-changelog-parser --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aptitude-changelog-parser", "resource": "_", "action": "_",
    "description": "Passthrough to aptitude-changelog-parser CLI",
    "adapter": "process", "adapterConfig": { "command": "aptitude-changelog-parser", "passthrough": true, "missingDependencyHelp": "Install aptitude-changelog-parser: apt-get install aptitude-changelog-parser" }, "args": []
  }]
}
