{
  "name": "aha",
  "version": "1.0.0",
  "description": "aha \u2014 ANSI to HTML converter",
  "source": "github.com/theZiz/aha",
  "checks": [
    {
      "type": "binary",
      "name": "aha"
    }
  ],
  "install_guidance": {
    "plugin": "aha",
    "binary": "aha",
    "check": "which aha",
    "install_steps": [
      "# Install aha:",
      "# apt: sudo apt-get install aha",
      "# brew: brew install aha",
      "# cargo: cargo install aha",
      "# npm: npm install -g aha",
      "# pip: pip install aha",
      "# or download from github.com/theZiz/aha"
    ]
  },
  "commands": [
    {
      "namespace": "aha",
      "resource": "aha",
      "action": "run",
      "description": "Run aha",
      "adapter": "process",
      "adapterConfig": {
        "command": "aha",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install aha from github.com/theZiz/aha"
      },
      "args": []
    }
  ]
}