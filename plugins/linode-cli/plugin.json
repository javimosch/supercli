{
  "name": "linode-cli",
  "version": "0.1.0",
  "description": "Linode CLI — command-line tool for Linode cloud",
  "source": "https://github.com/linode/linode-cli",
  "checks": [
    {
      "type": "binary",
      "name": "linode-cli"
    }
  ],
  "install_guidance": {
    "plugin": "linode-cli",
    "binary": "linode-cli",
    "check": "which linode-cli",
    "install_steps": [
      "pip install linode-cli",
      "brew install linode-cli",
      "Verify: linode-cli --version",
      "supercli plugins install ./plugins/linode-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linode-cli",
      "resource": "self",
      "action": "version",
      "description": "Print linode-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linode-cli",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install linode-cli: pip install linode-cli"
      },
      "args": []
    },
    {
      "namespace": "linode-cli",
      "resource": "cli",
      "action": "run",
      "description": "Linode CLI — command-line tool for Linode cloud",
      "adapter": "process",
      "adapterConfig": {
        "command": "linode-cli",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install linode-cli: pip install linode-cli"
      },
      "args": []
    }
  ]
}
