{
  "name": "cupsdisable",
  "version": "0.1.0",
  "description": "Disable CUPS printers/classes",
  "source": "https://packages.debian.org/cupsdisable",
  "checks": [{ "type": "binary", "name": "cupsdisable" }],
  "install_guidance": {
    "plugin": "cupsdisable", "binary": "cupsdisable", "check": "which cupsdisable",
    "install_steps": ["apt-get install cups", "Verify: cupsdisable --version", "supercli plugins install ./plugins/cupsdisable --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cupsdisable", "resource": "_", "action": "_",
    "description": "Passthrough to cupsdisable CLI",
    "adapter": "process", "adapterConfig": { "command": "cupsdisable", "passthrough": true, "missingDependencyHelp": "Install cupsdisable: apt-get install cups" }, "args": []
  }]
}
