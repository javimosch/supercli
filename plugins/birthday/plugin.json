{
  "name": "birthday",
  "version": "0.1.0",
  "description": "Know when a friend's birthday is coming",
  "source": "https://github.com/IonicaBizau/birthday",
  "checks": [
    {
      "type": "binary",
      "name": "birthday"
    }
  ],
  "install_guidance": {
    "plugin": "birthday",
    "binary": "birthday",
    "check": "which birthday",
    "install_steps": [
      "See https://github.com/IonicaBizau/birthday",
      "Verify: birthday --version",
      "supercli plugins install ./plugins/birthday --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "birthday",
      "resource": "self",
      "action": "version",
      "description": "Print birthday version",
      "adapter": "process",
      "adapterConfig": {
        "command": "birthday",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install birthday: See https://github.com/IonicaBizau/birthday"
      },
      "args": []
    },
    {
      "namespace": "birthday",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to birthday CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "birthday",
        "passthrough": true,
        "missingDependencyHelp": "Install birthday"
      },
      "args": []
    }
  ]
}