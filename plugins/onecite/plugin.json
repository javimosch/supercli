{
  "name": "onecite",
  "version": "0.1.0",
  "description": "Universal toolkit to generate citations",
  "source": "https://github.com/HzaCode/OneCite",
  "checks": [
    {
      "type": "binary",
      "name": "onecite"
    }
  ],
  "install_guidance": {
    "plugin": "onecite",
    "binary": "onecite",
    "check": "which onecite",
    "install_steps": [
      "See https://github.com/HzaCode/OneCite",
      "Verify: onecite --version",
      "supercli plugins install ./plugins/onecite --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "onecite",
      "resource": "self",
      "action": "version",
      "description": "Print onecite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "onecite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install onecite: See https://github.com/HzaCode/OneCite"
      },
      "args": []
    },
    {
      "namespace": "onecite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to onecite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "onecite",
        "passthrough": true,
        "missingDependencyHelp": "Install onecite"
      },
      "args": []
    }
  ]
}