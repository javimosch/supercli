{
  "name": "incus",
  "version": "0.1.0",
  "description": "Powerful system container and virtual machine manager ",
  "source": "https://github.com/incus/incus",
  "checks": [
    {
      "type": "binary",
      "name": "incus"
    }
  ],
  "install_guidance": {
    "plugin": "incus",
    "binary": "incus",
    "check": "which incus",
    "install_steps": [
      "pip install incus",
      "Verify: incus --version",
      "supercli plugins install ./plugins/incus --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "incus",
      "resource": "self",
      "action": "version",
      "description": "Print incus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "incus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install incus: pip install incus"
      },
      "args": []
    },
    {
      "namespace": "incus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to incus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "incus",
        "passthrough": true,
        "missingDependencyHelp": "Install incus: pip install incus"
      },
      "args": []
    }
  ]
}