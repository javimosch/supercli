{
  "name": "lspgpot",
  "version": "0.1.0",
  "description": "CLI tool: lspgpot",
  "source": "https://manpages.debian.org/lspgpot",
  "checks": [
    {
      "type": "binary",
      "name": "lspgpot"
    }
  ],
  "install_guidance": {
    "plugin": "lspgpot",
    "binary": "lspgpot",
    "check": "which lspgpot",
    "install_steps": [
      "apt-get install lspgpot 2>/dev/null || which lspgpot",
      "Verify: lspgpot --version",
      "supercli plugins install ./plugins/lspgpot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lspgpot",
      "resource": "self",
      "action": "version",
      "description": "Print lspgpot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lspgpot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lspgpot: apt-get install lspgpot 2>/dev/null || which lspgpot"
      },
      "args": []
    },
    {
      "namespace": "lspgpot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lspgpot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lspgpot",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lspgpot: apt-get install lspgpot 2>/dev/null || which lspgpot"
      },
      "args": []
    }
  ]
}