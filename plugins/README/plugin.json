{
  "name": "README",
  "version": "0.1.0",
  "description": "CLI tool: README",
  "source": "https://manpages.debian.org/README",
  "checks": [
    {
      "type": "binary",
      "name": "README"
    }
  ],
  "install_guidance": {
    "plugin": "README",
    "binary": "README",
    "check": "which README",
    "install_steps": [
      "apt-get install README 2>/dev/null || which README",
      "Verify: README --version",
      "supercli plugins install ./plugins/README --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "README",
      "resource": "self",
      "action": "version",
      "description": "Print README version",
      "adapter": "process",
      "adapterConfig": {
        "command": "README",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install README: apt-get install README 2>/dev/null || which README"
      },
      "args": []
    },
    {
      "namespace": "README",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to README CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "README",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install README: apt-get install README 2>/dev/null || which README"
      },
      "args": []
    }
  ]
}