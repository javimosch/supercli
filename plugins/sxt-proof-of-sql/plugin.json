{
  "name": "sxt-proof-of-sql",
  "version": "0.1.0",
  "description": "Space and Time | Proof of SQL",
  "source": "https://github.com/sxt-proof-of-sql/sxt-proof-of-sql",
  "checks": [
    {
      "type": "binary",
      "name": "sxt-proof-of-sql"
    }
  ],
  "install_guidance": {
    "plugin": "sxt-proof-of-sql",
    "binary": "sxt-proof-of-sql",
    "check": "which sxt-proof-of-sql",
    "install_steps": [
      "pip install sxt-proof-of-sql",
      "Verify: sxt-proof-of-sql --version",
      "supercli plugins install ./plugins/sxt-proof-of-sql --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sxt-proof-of-sql",
      "resource": "self",
      "action": "version",
      "description": "Print sxt-proof-of-sql version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sxt-proof-of-sql",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sxt-proof-of-sql: pip install sxt-proof-of-sql"
      },
      "args": []
    },
    {
      "namespace": "sxt-proof-of-sql",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sxt-proof-of-sql CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sxt-proof-of-sql",
        "passthrough": true,
        "missingDependencyHelp": "Install sxt-proof-of-sql: pip install sxt-proof-of-sql"
      },
      "args": []
    }
  ]
}