{
  "name": "glow-ext",
  "version": "0.1.0",
  "description": "Terminal markdown reader with word-wrapping and dark mode",
  "source": "https://github.com/charmbracelet/glow",
  "checks": [{ "type": "binary", "name": "glow" }],
  "install_guidance": {
    "plugin": "glow-ext",
    "binary": "glow",
    "check": "which glow",
    "install_steps": ["brew install glow", "Verify: glow --version", "supercli plugins install ./plugins/glow-ext --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "glow-ext",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to glow CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "glow",
      "passthrough": true,
      "missingDependencyHelp": "Install glow-ext: brew install glow"
    },
    "args": []
  }]
}
