{
  "name": "containerd-shim",
  "version": "0.1.0",
  "description": "CLI tool: containerd-shim",
  "source": "https://packages.debian.org/containerd-shim",
  "checks": [{ "type": "binary", "name": "containerd-shim" }],
  "install_guidance": {
    "plugin": "containerd-shim", "binary": "containerd-shim", "check": "which containerd-shim",
    "install_steps": ["apt-get install containerd-shim 2>/dev/null || which containerd-shim", "Verify: containerd-shim --version", "supercli plugins install ./plugins/containerd-shim --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "containerd-shim", "resource": "_", "action": "_",
    "description": "Passthrough to containerd-shim CLI",
    "adapter": "process", "adapterConfig": { "command": "containerd-shim", "passthrough": true, "missingDependencyHelp": "Install containerd-shim: apt-get install containerd-shim" }, "args": []
  }]
}
