{
  "name": "dsh",
  "version": "1.0.0",
  "description": "dsh \u2014 Distributed shell",
  "source": "github.com/dsh/dsh",
  "checks": [
    {
      "type": "binary",
      "name": "dsh"
    }
  ],
  "install_guidance": {
    "plugin": "dsh",
    "binary": "dsh",
    "check": "which dsh",
    "install_steps": [
      "# Install dsh",
      "# See github.com/dsh/dsh",
      "# apt: sudo apt-get install dsh",
      "# brew: brew install dsh",
      "# cargo: cargo install dsh",
      "# npm: npm install -g dsh",
      "# pip: pip install dsh"
    ]
  },
  "commands": [
    {
      "namespace": "dsh",
      "resource": "dsh",
      "action": "run",
      "description": "Run dsh",
      "adapter": "process",
      "adapterConfig": {
        "command": "dsh",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dsh from github.com/dsh/dsh"
      },
      "args": []
    }
  ]
}