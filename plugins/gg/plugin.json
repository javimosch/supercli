{
  "name": "gg",
  "version": "0.1.0",
  "description": "One-click proxy without installing v2ray or anything else",
  "source": "https://github.com/mzz2017/gg",
  "checks": [
    {
      "type": "binary",
      "name": "gg"
    }
  ],
  "install_guidance": {
    "plugin": "gg",
    "binary": "gg",
    "check": "which gg",
    "install_steps": [
      "See https://github.com/mzz2017/gg",
      "Verify: gg --version",
      "supercli plugins install ./plugins/gg --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "gg",
      "resource": "self",
      "action": "version",
      "description": "Print gg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gg: See https://github.com/mzz2017/gg"
      },
      "args": []
    },
    {
      "namespace": "gg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gg",
        "passthrough": true,
        "missingDependencyHelp": "Install gg"
      },
      "args": []
    }
  ]
}