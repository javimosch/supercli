{
  "name": "SafeLine",
  "version": "0.1.0",
  "description": "SafeLine is a self-hosted WAF(Web Application Firewall) / reverse proxy to protect your web apps fro",
  "source": "https://github.com/SafeLine/SafeLine",
  "checks": [
    {
      "type": "binary",
      "name": "safeline"
    }
  ],
  "install_guidance": {
    "plugin": "SafeLine",
    "binary": "safeline",
    "check": "which safeline",
    "install_steps": [
      "pip install safeline",
      "Verify: safeline --version",
      "supercli plugins install ./plugins/SafeLine --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SafeLine",
      "resource": "self",
      "action": "version",
      "description": "Print SafeLine version",
      "adapter": "process",
      "adapterConfig": {
        "command": "safeline",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SafeLine: pip install safeline"
      },
      "args": []
    },
    {
      "namespace": "SafeLine",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to safeline CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "safeline",
        "passthrough": true,
        "missingDependencyHelp": "Install SafeLine: pip install safeline"
      },
      "args": []
    }
  ]
}