{
  "name": "pbmtolj",
  "version": "0.1.0",
  "description": "CLI tool: pbmtolj",
  "source": "https://manpages.debian.org/pbmtolj",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtolj"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtolj",
    "binary": "pbmtolj",
    "check": "which pbmtolj",
    "install_steps": [
      "apt-get install pbmtolj 2>/dev/null || which pbmtolj",
      "Verify: pbmtolj --version",
      "supercli plugins install ./plugins/pbmtolj --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtolj",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtolj version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtolj",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtolj: apt-get install pbmtolj 2>/dev/null || which pbmtolj"
      },
      "args": []
    },
    {
      "namespace": "pbmtolj",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtolj CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtolj",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtolj: apt-get install pbmtolj 2>/dev/null || which pbmtolj"
      },
      "args": []
    }
  ]
}