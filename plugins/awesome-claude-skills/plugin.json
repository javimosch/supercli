{
  "name": "awesome-claude-skills",
  "version": "0.1.0",
  "description": "A curated list of awesome Claude Skills, resources, and tools for customizing Claude AI workflows",
  "source": "https://github.com/awesome-claude-skills/awesome-claude-skills",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-claude-skills"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-claude-skills",
    "binary": "awesome-claude-skills",
    "check": "which awesome-claude-skills",
    "install_steps": [
      "pip install awesome-claude-skills",
      "Verify: awesome-claude-skills --version",
      "supercli plugins install ./plugins/awesome-claude-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-claude-skills",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-claude-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-claude-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-claude-skills: pip install awesome-claude-skills"
      },
      "args": []
    },
    {
      "namespace": "awesome-claude-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-claude-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-claude-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-claude-skills: pip install awesome-claude-skills"
      },
      "args": []
    }
  ]
}