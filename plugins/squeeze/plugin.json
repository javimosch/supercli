{
  "name": "squeeze",
  "version": "0.1.0",
  "description": "Huffman encoder - decoder CLI tool, to compress and decompress text files. Written in Go.",
  "source": "https://github.com/squeeze/squeeze",
  "checks": [
    {
      "type": "binary",
      "name": "squeeze"
    }
  ],
  "install_guidance": {
    "plugin": "squeeze",
    "binary": "squeeze",
    "check": "which squeeze",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: squeeze --version",
      "supercli plugins install ./plugins/squeeze --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "squeeze",
      "resource": "self",
      "action": "version",
      "description": "Print squeeze version",
      "adapter": "process",
      "adapterConfig": {
        "command": "squeeze",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install squeeze from project repository"
      },
      "args": []
    },
    {
      "namespace": "squeeze",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to squeeze CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "squeeze",
        "passthrough": true,
        "missingDependencyHelp": "Install squeeze from project repository"
      },
      "args": []
    }
  ]
}