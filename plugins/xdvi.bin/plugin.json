{
  "name": "xdvi.bin",
  "version": "0.1.0",
  "description": "CLI tool: xdvi.bin",
  "source": "https://manpages.debian.org/xdvi.bin",
  "checks": [
    {
      "type": "binary",
      "name": "xdvi.bin"
    }
  ],
  "install_guidance": {
    "plugin": "xdvi.bin",
    "binary": "xdvi.bin",
    "check": "which xdvi.bin",
    "install_steps": [
      "apt-get install xdvi.bin 2>/dev/null || which xdvi.bin",
      "Verify: xdvi.bin --version",
      "supercli plugins install ./plugins/xdvi.bin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xdvi.bin",
      "resource": "self",
      "action": "version",
      "description": "Print xdvi.bin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdvi.bin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xdvi.bin: apt-get install xdvi.bin 2>/dev/null || which xdvi.bin"
      },
      "args": []
    },
    {
      "namespace": "xdvi.bin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xdvi.bin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdvi.bin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xdvi.bin: apt-get install xdvi.bin 2>/dev/null || which xdvi.bin"
      },
      "args": []
    }
  ]
}