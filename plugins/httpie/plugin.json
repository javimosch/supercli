{
  "name": "httpie",
  "version": "0.1.0",
  "description": "httpie — user-friendly HTTP client with intuitive JSON support, syntax highlighting, and persistent sessions",
  "source": "https://github.com/httpie/cli",
  "checks": [
    { "type": "binary", "name": "http" }
  ],
  "install_guidance": {
    "plugin": "httpie",
    "binary": "http",
    "check": "which http",
    "install_steps": ["brew install httpie", "Verify: http --version", "supercli plugins install ./plugins/httpie --on-conflict replace --json"]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "httpie",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to httpie CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "http",
        "passthrough": true,
        "missingDependencyHelp": "Install httpie: https://httpie.io/docs#installation"
      },
      "args": []
    }
  ]
}
