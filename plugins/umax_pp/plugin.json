{
  "name": "umax_pp",
  "version": "0.1.0",
  "description": "CLI tool: umax_pp",
  "source": "https://manpages.debian.org/umax_pp",
  "checks": [
    {
      "type": "binary",
      "name": "umax_pp"
    }
  ],
  "install_guidance": {
    "plugin": "umax_pp",
    "binary": "umax_pp",
    "check": "which umax_pp",
    "install_steps": [
      "apt-get install umax_pp 2>/dev/null || which umax_pp",
      "Verify: umax_pp --version",
      "supercli plugins install ./plugins/umax_pp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "umax_pp",
      "resource": "self",
      "action": "version",
      "description": "Print umax_pp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "umax_pp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install umax_pp: apt-get install umax_pp 2>/dev/null || which umax_pp"
      },
      "args": []
    },
    {
      "namespace": "umax_pp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to umax_pp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "umax_pp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install umax_pp: apt-get install umax_pp 2>/dev/null || which umax_pp"
      },
      "args": []
    }
  ]
}