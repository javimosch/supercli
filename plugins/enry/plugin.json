{
  "name": "enry",
  "version": "0.1.0",
  "description": "Fast file programming language detector in Go",
  "source": "go",
  "checks": [{ "type": "binary", "name": "enry" }],
  "install_guidance": {
    "plugin": "enry",
    "binary": "enry",
    "check": "which enry",
    "install_steps": ["go get github.com/go-enry/go-enry/v2/cmd/enry", "Verify: enry --version", "supercli plugins install ./plugins/enry --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "enry",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to enry CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "enry",
      "passthrough": true,
      "missingDependencyHelp": "Install enry: go get github.com/go-enry/go-enry/v2/cmd/enry"
    },
    "args": []
  }]
}
