{
  "name": "imgpkg",
  "version": "0.1.0",
  "description": "Store and distribute Kubernetes config as OCI images",
  "source": "https://github.com/carvel-dev/imgpkg",
  "checks": [{ "type": "binary", "name": "imgpkg" }],
  "install_guidance": {
    "plugin": "imgpkg",
    "binary": "imgpkg",
    "check": "which imgpkg",
    "install_steps": ["brew install imgpkg", "Verify: imgpkg --version", "supercli plugins install ./plugins/imgpkg --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "imgpkg",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to imgpkg CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "imgpkg",
      "passthrough": true,
      "missingDependencyHelp": "Install imgpkg: brew install imgpkg"
    },
    "args": []
  }]
}
