{
  "name": "qmljs",
  "version": "0.1.0",
  "description": "CLI tool: qmljs",
  "source": "https://manpages.debian.org/qmljs",
  "checks": [
    {
      "type": "binary",
      "name": "qmljs"
    }
  ],
  "install_guidance": {
    "plugin": "qmljs",
    "binary": "qmljs",
    "check": "which qmljs",
    "install_steps": [
      "apt-get install qmljs 2>/dev/null || which qmljs",
      "Verify: qmljs --version",
      "supercli plugins install ./plugins/qmljs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmljs",
      "resource": "self",
      "action": "version",
      "description": "Print qmljs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmljs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmljs: apt-get install qmljs 2>/dev/null || which qmljs"
      },
      "args": []
    },
    {
      "namespace": "qmljs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmljs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmljs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmljs: apt-get install qmljs 2>/dev/null || which qmljs"
      },
      "args": []
    }
  ]
}