{
  "name": "crush",
  "version": "0.1.0",
  "description": "Glamourous agentic coding for all \ud83d\udc98",
  "source": "https://github.com/crush/crush",
  "checks": [
    {
      "type": "binary",
      "name": "crush"
    }
  ],
  "install_guidance": {
    "plugin": "crush",
    "binary": "crush",
    "check": "which crush",
    "install_steps": [
      "pip install crush",
      "Verify: crush --version",
      "supercli plugins install ./plugins/crush --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "crush",
      "resource": "self",
      "action": "version",
      "description": "Print crush version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crush",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crush: pip install crush"
      },
      "args": []
    },
    {
      "namespace": "crush",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crush CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crush",
        "passthrough": true,
        "missingDependencyHelp": "Install crush: pip install crush"
      },
      "args": []
    }
  ]
}