{
  "name": "registry",
  "version": "0.1.0",
  "description": "A community driven registry service for Model Context Protocol (MCP) servers.",
  "source": "https://github.com/registry/registry",
  "checks": [
    {
      "type": "binary",
      "name": "registry"
    }
  ],
  "install_guidance": {
    "plugin": "registry",
    "binary": "registry",
    "check": "which registry",
    "install_steps": [
      "pip install registry",
      "Verify: registry --version",
      "supercli plugins install ./plugins/registry --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "registry",
      "resource": "self",
      "action": "version",
      "description": "Print registry version",
      "adapter": "process",
      "adapterConfig": {
        "command": "registry",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install registry: pip install registry"
      },
      "args": []
    },
    {
      "namespace": "registry",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to registry CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "registry",
        "passthrough": true,
        "missingDependencyHelp": "Install registry: pip install registry"
      },
      "args": []
    }
  ]
}