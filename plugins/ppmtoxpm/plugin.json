{
  "name": "ppmtoxpm",
  "version": "0.1.0",
  "description": "CLI tool: ppmtoxpm",
  "source": "https://manpages.debian.org/ppmtoxpm",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtoxpm"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtoxpm",
    "binary": "ppmtoxpm",
    "check": "which ppmtoxpm",
    "install_steps": [
      "apt-get install ppmtoxpm 2>/dev/null || which ppmtoxpm",
      "Verify: ppmtoxpm --version",
      "supercli plugins install ./plugins/ppmtoxpm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtoxpm",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtoxpm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoxpm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtoxpm: apt-get install ppmtoxpm 2>/dev/null || which ppmtoxpm"
      },
      "args": []
    },
    {
      "namespace": "ppmtoxpm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtoxpm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoxpm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtoxpm: apt-get install ppmtoxpm 2>/dev/null || which ppmtoxpm"
      },
      "args": []
    }
  ]
}