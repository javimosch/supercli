{
  "name": "claude-mem",
  "version": "0.1.0",
  "description": "Persistent Context Across Sessions for Every Agent \u2013  Captures everything your agent does during ses",
  "source": "https://github.com/claude-mem/claude-mem",
  "checks": [
    {
      "type": "binary",
      "name": "claude-mem"
    }
  ],
  "install_guidance": {
    "plugin": "claude-mem",
    "binary": "claude-mem",
    "check": "which claude-mem",
    "install_steps": [
      "pip install claude-mem",
      "Verify: claude-mem --version",
      "supercli plugins install ./plugins/claude-mem --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-mem",
      "resource": "self",
      "action": "version",
      "description": "Print claude-mem version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-mem",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-mem: pip install claude-mem"
      },
      "args": []
    },
    {
      "namespace": "claude-mem",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-mem CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-mem",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-mem: pip install claude-mem"
      },
      "args": []
    }
  ]
}