{
  "name": "smoke",
  "version": "0.1.0",
  "description": "Lightweight smoke testing tool for HTTP services",
  "source": "https://github.com/skx/smoke",
  "checks": [{ "type": "binary", "name": "smoke" }],
  "install_guidance": {
    "plugin": "smoke",
    "binary": "smoke",
    "check": "which smoke",
    "install_steps": ["go install github.com/skx/smoke@latest", "Verify: smoke --version", "supercli plugins install ./plugins/smoke --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "smoke",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to smoke CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "smoke",
      "passthrough": true,
      "missingDependencyHelp": "Install smoke: go install github.com/skx/smoke@latest"
    },
    "args": []
  }]
}
