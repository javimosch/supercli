{
  "name": "gbrain",
  "version": "0.1.0",
  "description": "Garry's Opinionated OpenClaw/Hermes Agent Brain",
  "source": "https://github.com/gbrain/gbrain",
  "checks": [
    {
      "type": "binary",
      "name": "gbrain"
    }
  ],
  "install_guidance": {
    "plugin": "gbrain",
    "binary": "gbrain",
    "check": "which gbrain",
    "install_steps": [
      "pip install gbrain",
      "Verify: gbrain --version",
      "supercli plugins install ./plugins/gbrain --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gbrain",
      "resource": "self",
      "action": "version",
      "description": "Print gbrain version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gbrain",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gbrain: pip install gbrain"
      },
      "args": []
    },
    {
      "namespace": "gbrain",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gbrain CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gbrain",
        "passthrough": true,
        "missingDependencyHelp": "Install gbrain: pip install gbrain"
      },
      "args": []
    }
  ]
}