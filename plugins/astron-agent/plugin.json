{
  "name": "astron-agent",
  "version": "0.1.0",
  "description": "Enterprise-grade, commercial-friendly agentic workflow platform for building next-generation SuperAg",
  "source": "https://github.com/astron-agent/astron-agent",
  "checks": [
    {
      "type": "binary",
      "name": "astron-agent"
    }
  ],
  "install_guidance": {
    "plugin": "astron-agent",
    "binary": "astron-agent",
    "check": "which astron-agent",
    "install_steps": [
      "pip install astron-agent",
      "Verify: astron-agent --version",
      "supercli plugins install ./plugins/astron-agent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "astron-agent",
      "resource": "self",
      "action": "version",
      "description": "Print astron-agent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "astron-agent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install astron-agent: pip install astron-agent"
      },
      "args": []
    },
    {
      "namespace": "astron-agent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to astron-agent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "astron-agent",
        "passthrough": true,
        "missingDependencyHelp": "Install astron-agent: pip install astron-agent"
      },
      "args": []
    }
  ]
}