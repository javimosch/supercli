{
  "name": "devprop",
  "version": "0.1.0",
  "description": "CLI tool: devprop",
  "source": "https://packages.debian.org/devprop",
  "checks": [{ "type": "binary", "name": "devprop" }],
  "install_guidance": {
    "plugin": "devprop", "binary": "devprop", "check": "which devprop",
    "install_steps": ["apt-get install devprop 2>/dev/null || which devprop", "Verify: devprop --version", "supercli plugins install ./plugins/devprop --on-conflict replace --json"]
