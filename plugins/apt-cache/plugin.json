{
  "name": "apt-cache",
  "version": "0.1.0",
  "description": "CLI tool: apt-cache",
  "source": "https://packages.debian.org/apt-cache",
  "checks": [{ "type": "binary", "name": "apt-cache" }],
  "install_guidance": {
    "plugin": "apt-cache", "binary": "apt-cache", "check": "which apt-cache",
    "install_steps": ["apt-get install apt-cache 2>/dev/null || which apt-cache", "Verify: apt-cache --version", "supercli plugins install ./plugins/apt-cache --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apt-cache", "resource": "_", "action": "_",
    "description": "Passthrough to apt-cache CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-cache", "passthrough": true, "missingDependencyHelp": "Install apt-cache: apt-get install apt-cache" }, "args": []
  }]
}
