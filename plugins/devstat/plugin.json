{
  "name": "devstat",
  "version": "0.1.0",
  "description": "CLI tool: devstat",
  "source": "https://packages.debian.org/devstat",
  "checks": [{ "type": "binary", "name": "devstat" }],
  "install_guidance": {
    "plugin": "devstat", "binary": "devstat", "check": "which devstat",
    "install_steps": ["apt-get install devstat 2>/dev/null || which devstat", "Verify: devstat --version", "supercli plugins install ./plugins/devstat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "devstat", "resource": "_", "action": "_",
    "description": "Passthrough to devstat CLI",
    "adapter": "process", "adapterConfig": { "command": "devstat", "passthrough": true, "missingDependencyHelp": "Install devstat: apt-get install devstat" }, "args": []
  }]
}
