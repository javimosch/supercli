{
  "name": "distrobox-init",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-init",
  "source": "https://packages.debian.org/distrobox-init",
  "checks": [{ "type": "binary", "name": "distrobox-init" }],
  "install_guidance": {
    "plugin": "distrobox-init", "binary": "distrobox-init", "check": "which distrobox-init",
    "install_steps": ["apt-get install distrobox-init 2>/dev/null || which distrobox-init", "Verify: distrobox-init --version", "supercli plugins install ./plugins/distrobox-init --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distrobox-init", "resource": "_", "action": "_",
    "description": "Passthrough to distrobox-init CLI",
    "adapter": "process", "adapterConfig": { "command": "distrobox-init", "passthrough": true, "missingDependencyHelp": "Install distrobox-init: apt-get install distrobox-init" }, "args": []
  }]
}
