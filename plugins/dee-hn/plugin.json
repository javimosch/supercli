{
  "name": "dee-hn",
  "version": "0.1.0",
  "description": "Browse Hacker News from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-hn" }],
  "install_guidance": {
    "plugin": "dee-hn",
    "binary": "dee-hn",
    "check": "which dee-hn",
    "install_steps": ["cargo install dee-hn", "Verify: dee-hn --version", "supercli plugins install ./plugins/dee-hn --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-hn",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-hn CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-hn",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-hn: cargo install dee-hn"
    },
    "args": []
  }]
}
