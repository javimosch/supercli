{
  "name": "jsmin",
  "version": "0.1.0",
  "description": "JavaScript minifier for command-line use",
  "source": "https://github.com/tikitu/jsmin",
  "checks": [{ "type": "binary", "name": "jsmin" }],
  "install_guidance": {
    "plugin": "jsmin",
    "binary": "jsmin",
    "check": "which jsmin",
    "install_steps": ["pip install jsmin", "Verify: jsmin --version", "supercli plugins install ./plugins/jsmin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jsmin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jsmin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jsmin",
      "passthrough": true,
      "missingDependencyHelp": "Install jsmin: pip install jsmin", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
