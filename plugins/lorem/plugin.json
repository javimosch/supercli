{
  "name": "lorem",
  "version": "0.1.0",
  "description": "Simple CLI for generating Lorem Ipsum placeholder text",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "lorem" }],
  "install_guidance": {
    "plugin": "lorem",
    "binary": "lorem",
    "check": "which lorem",
    "install_steps": ["npm install -g lorem-cli", "Verify: lorem --version", "supercli plugins install ./plugins/lorem --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lorem",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lorem CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lorem",
      "passthrough": true,
      "missingDependencyHelp": "Install lorem: npm install -g lorem-cli"
    },
    "args": []
  }]
}
