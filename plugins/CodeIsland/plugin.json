{
  "name": "CodeIsland",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/CodeIsland/CodeIsland",
  "checks": [
    {
      "type": "binary",
      "name": "codeisland"
    }
  ],
  "install_guidance": {
    "plugin": "CodeIsland",
    "binary": "codeisland",
    "check": "which codeisland",
    "install_steps": [
      "pip install codeisland",
      "Verify: codeisland --version",
      "supercli plugins install ./plugins/CodeIsland --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CodeIsland",
      "resource": "self",
      "action": "version",
      "description": "Print CodeIsland version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codeisland",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CodeIsland: pip install codeisland"
      },
      "args": []
    },
    {
      "namespace": "CodeIsland",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codeisland CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codeisland",
        "passthrough": true,
        "missingDependencyHelp": "Install CodeIsland: pip install codeisland"
      },
      "args": []
    }
  ]
}