{
  "plugin": "gvfs-info",
  "binary": "gvfs-info",
  "check": "which gvfs-info",
  "install_steps": [
    "apt-get install gvfs-info 2>/dev/null || which gvfs-info",
    "Verify: gvfs-info --version",
    "supercli plugins install ./plugins/gvfs-info --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}