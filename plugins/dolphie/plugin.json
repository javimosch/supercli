{
  "name": "dolphie",
  "version": "0.1.0",
  "description": "Feature-rich top tool for monitoring MySQL",
  "source": "https://github.com/charles-001/dolphie",
  "checks": [
    {
      "type": "binary",
      "name": "dolphie"
    }
  ],
  "install_guidance": {
    "plugin": "dolphie",
    "binary": "dolphie",
    "check": "which dolphie",
    "install_steps": [
      "brew install dolphie",
      "Verify: dolphie --version",
      "supercli plugins install ./plugins/dolphie --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dolphie",
      "resource": "self",
      "action": "version",
      "description": "Print dolphie version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dolphie",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dolphie: brew install dolphie"
      },
      "args": []
    },
    {
      "namespace": "dolphie",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dolphie CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dolphie",
        "passthrough": true,
        "missingDependencyHelp": "Install dolphie"
      },
      "args": []
    }
  ]
}