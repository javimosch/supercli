{
  "name": "floci",
  "version": "0.1.0",
  "description": "Light, fluffy, and always free - The AWS Local Emulator alternative",
  "source": "https://github.com/floci/floci",
  "checks": [
    {
      "type": "binary",
      "name": "floci"
    }
  ],
  "install_guidance": {
    "plugin": "floci",
    "binary": "floci",
    "check": "which floci",
    "install_steps": [
      "pip install floci",
      "Verify: floci --version",
      "supercli plugins install ./plugins/floci --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "floci",
      "resource": "self",
      "action": "version",
      "description": "Print floci version",
      "adapter": "process",
      "adapterConfig": {
        "command": "floci",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install floci: pip install floci"
      },
      "args": []
    },
    {
      "namespace": "floci",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to floci CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "floci",
        "passthrough": true,
        "missingDependencyHelp": "Install floci: pip install floci"
      },
      "args": []
    }
  ]
}