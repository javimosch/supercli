{
  "name": "kotaemon",
  "version": "0.1.0",
  "description": "An open-source RAG-based tool for chatting with your documents.",
  "source": "https://github.com/kotaemon/kotaemon",
  "checks": [
    {
      "type": "binary",
      "name": "kotaemon"
    }
  ],
  "install_guidance": {
    "plugin": "kotaemon",
    "binary": "kotaemon",
    "check": "which kotaemon",
    "install_steps": [
      "pip install kotaemon",
      "Verify: kotaemon --version",
      "supercli plugins install ./plugins/kotaemon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kotaemon",
      "resource": "self",
      "action": "version",
      "description": "Print kotaemon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kotaemon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kotaemon: pip install kotaemon"
      },
      "args": []
    },
    {
      "namespace": "kotaemon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kotaemon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kotaemon",
        "passthrough": true,
        "missingDependencyHelp": "Install kotaemon: pip install kotaemon"
      },
      "args": []
    }
  ]
}