{
  "name": "at_bat",
  "version": "0.1.0",
  "description": "CLI tool: at_bat",
  "source": "https://packages.debian.org/at_bat",
  "checks": [{ "type": "binary", "name": "at_bat" }],
  "install_guidance": {
    "plugin": "at_bat", "binary": "at_bat", "check": "which at_bat",
    "install_steps": ["apt-get install at_bat 2>/dev/null || which at_bat", "Verify: at_bat --version", "supercli plugins install ./plugins/at_bat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_bat", "resource": "_", "action": "_",
    "description": "Passthrough to at_bat CLI",
    "adapter": "process", "adapterConfig": { "command": "at_bat", "passthrough": true, "missingDependencyHelp": "Install at_bat: apt-get install at_bat" }, "args": []
  }]
}
