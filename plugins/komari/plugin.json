{
  "name": "komari",
  "version": "0.1.0",
  "description": "A simple server monitor tool.",
  "source": "https://github.com/komari/komari",
  "checks": [
    {
      "type": "binary",
      "name": "komari"
    }
  ],
  "install_guidance": {
    "plugin": "komari",
    "binary": "komari",
    "check": "which komari",
    "install_steps": [
      "pip install komari",
      "Verify: komari --version",
      "supercli plugins install ./plugins/komari --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "komari",
      "resource": "self",
      "action": "version",
      "description": "Print komari version",
      "adapter": "process",
      "adapterConfig": {
        "command": "komari",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install komari: pip install komari"
      },
      "args": []
    },
    {
      "namespace": "komari",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to komari CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "komari",
        "passthrough": true,
        "missingDependencyHelp": "Install komari: pip install komari"
      },
      "args": []
    }
  ]
}