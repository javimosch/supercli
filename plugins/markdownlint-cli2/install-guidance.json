{
  "plugin": "markdownlint-cli2",
  "binary": "markdownlint-cli2",
  "check": "which markdownlint-cli2",
  "install_steps": [
    "npm install -g markdownlint-cli2",
    "Verify: markdownlint-cli2 --version",
    "supercli plugins install ./plugins/markdownlint-cli2 --on-conflict replace --json"
  ],
  "note": "Requires Node.js. Config via .markdownlint-cli2.jsonc or .markdownlint.jsonc."
}
