{
  "name": "markdownlint-cli2",
  "version": "0.1.0",
  "description": "markdownlint-cli2 — Markdown linter with rule configuration and fix support",
  "source": "https://github.com/DavidAnson/markdownlint-cli2",
  "checks": [
    { "type": "binary", "name": "markdownlint-cli2" }
  ],
  "install_guidance": {
    "plugin": "markdownlint-cli2",
    "binary": "markdownlint-cli2",
    "check": "which markdownlint-cli2",
    "install_steps": [
      "npm install -g markdownlint-cli2",
      "Verify: markdownlint-cli2 --version",
      "supercli plugins install ./plugins/markdownlint-cli2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "markdownlint-cli2",
      "resource": "self",
      "action": "version",
      "description": "Print markdownlint-cli2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdownlint-cli2",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install markdownlint-cli2: npm install -g markdownlint-cli2"
      },
      "args": []
    },
    {
      "namespace": "markdownlint-cli2",
      "resource": "lint",
      "action": "run",
      "description": "Lint Markdown files",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdownlint-cli2",
        "positionalArgs": ["glob"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install markdownlint-cli2"
      },
      "args": [
        { "name": "glob", "type": "string", "required": false, "description": "Glob pattern for files (e.g., '*.md', 'docs/**/*.md')" }
      ]
    },
    {
      "namespace": "markdownlint-cli2",
      "resource": "lint",
      "action": "fix",
      "description": "Lint and auto-fix Markdown files",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdownlint-cli2",
        "baseArgs": ["--fix"],
        "positionalArgs": ["glob"],
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install markdownlint-cli2"
      },
      "args": [
        { "name": "glob", "type": "string", "required": false, "description": "Glob pattern for files" }
      ]
    },
    {
      "namespace": "markdownlint-cli2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to markdownlint-cli2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "markdownlint-cli2",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "missingDependencyHelp": "Install markdownlint-cli2"
      },
      "args": []
    }
  ]
}
