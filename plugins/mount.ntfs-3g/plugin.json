{
  "name": "mount.ntfs-3g",
  "version": "0.1.0",
  "description": "CLI tool: mount.ntfs-3g",
  "source": "https://manpages.debian.org/mount.ntfs-3g",
  "checks": [
    {
      "type": "binary",
      "name": "mount.ntfs-3g"
    }
  ],
  "install_guidance": {
    "plugin": "mount.ntfs-3g",
    "binary": "mount.ntfs-3g",
    "check": "which mount.ntfs-3g",
    "install_steps": [
      "apt-get install mount.ntfs-3g 2>/dev/null || which mount.ntfs-3g",
      "Verify: mount.ntfs-3g --version",
      "supercli plugins install ./plugins/mount.ntfs-3g --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mount.ntfs-3g",
      "resource": "self",
      "action": "version",
      "description": "Print mount.ntfs-3g version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mount.ntfs-3g",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mount.ntfs-3g: apt-get install mount.ntfs-3g 2>/dev/null || which mount.ntfs-3g"
      },
      "args": []
    },
    {
      "namespace": "mount.ntfs-3g",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mount.ntfs-3g CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mount.ntfs-3g",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mount.ntfs-3g: apt-get install mount.ntfs-3g 2>/dev/null || which mount.ntfs-3g"
      },
      "args": []
    }
  ]
}