{
  "name": "licensed",
  "version": "0.1.0",
  "description": "Cache and verify the licenses of dependencies",
  "source": "https://github.com/licensee/licensed",
  "checks": [
    {
      "type": "binary",
      "name": "licensed"
    }
  ],
  "install_guidance": {
    "plugin": "licensed",
    "binary": "licensed",
    "check": "which licensed",
    "install_steps": [
      "brew install licensed",
      "Verify: licensed --version",
      "supercli plugins install ./plugins/licensed --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "licensed",
      "resource": "self",
      "action": "version",
      "description": "Print licensed version",
      "adapter": "process",
      "adapterConfig": {
        "command": "licensed",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install licensed: brew install licensed"
      },
      "args": []
    },
    {
      "namespace": "licensed",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to licensed CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "licensed",
        "passthrough": true,
        "missingDependencyHelp": "Install licensed"
      },
      "args": []
    }
  ]
}