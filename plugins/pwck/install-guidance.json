{
  "plugin": "pwck",
  "binary": "pwck",
  "check": "which pwck",
  "install_steps": [
    "# Install pwck",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pwck-linux-amd64 -o /usr/local/bin/pwck",
    "chmod +x /usr/local/bin/pwck",
    "# Or via package manager, see /usr/sbin/pwck"
  ]
}