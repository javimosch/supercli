{
  "name": "timberjack",
  "version": "0.1.0",
  "description": "Fast Rust-based log analyzer for pattern extraction",
  "source": "https://github.com/donaldc24/timberjack",
  "checks": [{ "type": "binary", "name": "timberjack" }],
  "install_guidance": {
    "plugin": "timberjack",
    "binary": "timberjack",
    "check": "which timberjack",
    "install_steps": ["cargo install timberjack", "Verify: timberjack --version", "supercli plugins install ./plugins/timberjack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "timberjack",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to timberjack CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "timberjack",
      "passthrough": true,
      "missingDependencyHelp": "Install timberjack: cargo install timberjack", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
