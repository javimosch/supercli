{
  "name": "anubis",
  "version": "0.1.0",
  "description": "HTTP reverse proxy that blocks AI web crawlers and scrapers",
  "source": "https://github.com/jechol/anubis",
  "checks": [
    {
      "type": "binary",
      "name": "anubis"
    }
  ],
  "install_guidance": {
    "plugin": "anubis",
    "binary": "anubis",
    "check": "which anubis",
    "install_steps": [
      "go install github.com/jechol/anubis@latest",
      "Verify: anubis --version",
      "supercli plugins install ./plugins/anubis --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "anubis",
      "resource": "self",
      "action": "version",
      "description": "Print anubis version",
      "adapter": "process",
      "adapterConfig": {
        "command": "anubis",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install anubis: go install github.com/jechol/anubis@latest"
      },
      "args": []
    },
    {
      "namespace": "anubis",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to anubis CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "anubis",
        "passthrough": true,
        "missingDependencyHelp": "Install anubis: go install github.com/jechol/anubis@latest"
      },
      "args": []
    }
  ]
}
