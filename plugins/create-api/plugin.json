{
  "name": "create-api",
  "version": "0.1.0",
  "description": "Delightful code generator for OpenAPI specs",
  "source": "https://github.com/CreateAPI/CreateAPI",
  "checks": [
    {
      "type": "binary",
      "name": "create-api"
    }
  ],
  "install_guidance": {
    "plugin": "create-api",
    "binary": "create-api",
    "check": "which create-api",
    "install_steps": [
      "brew install create-api",
      "Verify: create-api --version",
      "supercli plugins install ./plugins/create-api --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "create-api",
      "resource": "self",
      "action": "version",
      "description": "Print create-api version",
      "adapter": "process",
      "adapterConfig": {
        "command": "create-api",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install create-api: brew install create-api"
      },
      "args": []
    },
    {
      "namespace": "create-api",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to create-api CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "create-api",
        "passthrough": true,
        "missingDependencyHelp": "Install create-api"
      },
      "args": []
    }
  ]
}