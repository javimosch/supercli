{
  "name": "cargo-miri",
  "version": "0.1.0",
  "description": "CLI tool: cargo-miri",
  "source": "https://packages.debian.org/cargo-miri",
  "checks": [{ "type": "binary", "name": "cargo-miri" }],
  "install_guidance": {
    "plugin": "cargo-miri", "binary": "cargo-miri", "check": "which cargo-miri",
    "install_steps": ["apt-get install cargo-miri 2>/dev/null || which cargo-miri", "Verify: cargo-miri --version", "supercli plugins install ./plugins/cargo-miri --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-miri", "resource": "_", "action": "_",
    "description": "Passthrough to cargo-miri CLI",
    "adapter": "process", "adapterConfig": { "command": "cargo-miri", "passthrough": true, "missingDependencyHelp": "Install cargo-miri: apt-get install cargo-miri" }, "args": []
  }]
}
