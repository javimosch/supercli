{
  "name": "neoss",
  "version": "0.1.0",
  "description": "User-friendly and detailed socket statistics",
  "source": "https://github.com/PabloLec/neoss",
  "checks": [
    {
      "type": "binary",
      "name": "neoss"
    }
  ],
  "install_guidance": {
    "plugin": "neoss",
    "binary": "neoss",
    "check": "which neoss",
    "install_steps": [
      "See https://github.com/PabloLec/neoss",
      "Verify: neoss --version",
      "supercli plugins install ./plugins/neoss --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "neoss",
      "resource": "self",
      "action": "version",
      "description": "Print neoss version",
      "adapter": "process",
      "adapterConfig": {
        "command": "neoss",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install neoss: See https://github.com/PabloLec/neoss"
      },
      "args": []
    },
    {
      "namespace": "neoss",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to neoss CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "neoss",
        "passthrough": true,
        "missingDependencyHelp": "Install neoss"
      },
      "args": []
    }
  ]
}