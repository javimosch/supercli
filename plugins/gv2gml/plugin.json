{
  "name": "gv2gml",
  "version": "0.1.0",
  "description": "CLI tool: gv2gml",
  "source": "https://manpages.debian.org/gv2gml",
  "checks": [
    {
      "type": "binary",
      "name": "gv2gml"
    }
  ],
  "install_guidance": {
    "plugin": "gv2gml",
    "binary": "gv2gml",
    "check": "which gv2gml",
    "install_steps": [
      "apt-get install gv2gml 2>/dev/null || which gv2gml",
      "Verify: gv2gml --version",
      "supercli plugins install ./plugins/gv2gml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gv2gml",
      "resource": "self",
      "action": "version",
      "description": "Print gv2gml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gv2gml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gv2gml: apt-get install gv2gml 2>/dev/null || which gv2gml"
      },
      "args": []
    },
    {
      "namespace": "gv2gml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gv2gml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gv2gml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gv2gml: apt-get install gv2gml 2>/dev/null || which gv2gml"
      },
      "args": []
    }
  ]
}