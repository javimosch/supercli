{
  "name": "xbrlapi",
  "version": "0.1.0",
  "description": "CLI tool: xbrlapi",
  "source": "https://manpages.debian.org/xbrlapi",
  "checks": [
    {
      "type": "binary",
      "name": "xbrlapi"
    }
  ],
  "install_guidance": {
    "plugin": "xbrlapi",
    "binary": "xbrlapi",
    "check": "which xbrlapi",
    "install_steps": [
      "apt-get install xbrlapi 2>/dev/null || which xbrlapi",
      "Verify: xbrlapi --version",
      "supercli plugins install ./plugins/xbrlapi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xbrlapi",
      "resource": "self",
      "action": "version",
      "description": "Print xbrlapi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbrlapi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xbrlapi: apt-get install xbrlapi 2>/dev/null || which xbrlapi"
      },
      "args": []
    },
    {
      "namespace": "xbrlapi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xbrlapi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xbrlapi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xbrlapi: apt-get install xbrlapi 2>/dev/null || which xbrlapi"
      },
      "args": []
    }
  ]
}