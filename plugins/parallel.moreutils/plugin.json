{
  "name": "parallel.moreutils",
  "version": "0.1.0",
  "description": "CLI tool: parallel.moreutils",
  "source": "https://manpages.debian.org/parallel.moreutils",
  "checks": [
    {
      "type": "binary",
      "name": "parallel.moreutils"
    }
  ],
  "install_guidance": {
    "plugin": "parallel.moreutils",
    "binary": "parallel.moreutils",
    "check": "which parallel.moreutils",
    "install_steps": [
      "apt-get install parallel.moreutils 2>/dev/null || which parallel.moreutils",
      "Verify: parallel.moreutils --version",
      "supercli plugins install ./plugins/parallel.moreutils --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "parallel.moreutils",
      "resource": "self",
      "action": "version",
      "description": "Print parallel.moreutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "parallel.moreutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install parallel.moreutils: apt-get install parallel.moreutils 2>/dev/null || which parallel.moreutils"
      },
      "args": []
    },
    {
      "namespace": "parallel.moreutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to parallel.moreutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "parallel.moreutils",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install parallel.moreutils: apt-get install parallel.moreutils 2>/dev/null || which parallel.moreutils"
      },
      "args": []
    }
  ]
}