{
  "name": "mdp",
  "version": "0.1.0",
  "description": "Markdown presentation tool with themes",
  "source": "https://github.com/visit1985/mdp",
  "checks": [
    {
      "type": "binary",
      "name": "mdp"
    }
  ],
  "install_guidance": {
    "plugin": "mdp",
    "binary": "mdp",
    "check": "which mdp",
    "install_steps": [
      "brew install mdp",
      "Verify: mdp --version",
      "supercli plugins install ./plugins/mdp --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "mdp",
      "resource": "self",
      "action": "version",
      "description": "Print mdp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mdp: brew install mdp"
      },
      "args": []
    },
    {
      "namespace": "mdp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mdp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mdp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mdp: brew install mdp"
      },
      "args": []
    }
  ]
}
