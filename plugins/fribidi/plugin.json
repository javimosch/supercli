{
  "name": "fribidi",
  "version": "0.1.0",
  "description": "Implementation of the Unicode BiDi algorithm",
  "source": "https://github.com/fribidi/fribidi",
  "checks": [
    {
      "type": "binary",
      "name": "fribidi"
    }
  ],
  "install_guidance": {
    "plugin": "fribidi",
    "binary": "fribidi",
    "check": "which fribidi",
    "install_steps": [
      "brew install fribidi",
      "Verify: fribidi --version",
      "supercli plugins install ./plugins/fribidi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fribidi",
      "resource": "self",
      "action": "version",
      "description": "Print fribidi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fribidi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fribidi: brew install fribidi"
      },
      "args": []
    },
    {
      "namespace": "fribidi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fribidi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fribidi",
        "passthrough": true,
        "missingDependencyHelp": "Install fribidi"
      },
      "args": []
    }
  ]
}