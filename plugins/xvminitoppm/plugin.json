{
  "name": "xvminitoppm",
  "version": "0.1.0",
  "description": "CLI tool: xvminitoppm",
  "source": "https://manpages.debian.org/xvminitoppm",
  "checks": [
    {
      "type": "binary",
      "name": "xvminitoppm"
    }
  ],
  "install_guidance": {
    "plugin": "xvminitoppm",
    "binary": "xvminitoppm",
    "check": "which xvminitoppm",
    "install_steps": [
      "apt-get install xvminitoppm 2>/dev/null || which xvminitoppm",
      "Verify: xvminitoppm --version",
      "supercli plugins install ./plugins/xvminitoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xvminitoppm",
      "resource": "self",
      "action": "version",
      "description": "Print xvminitoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xvminitoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xvminitoppm: apt-get install xvminitoppm 2>/dev/null || which xvminitoppm"
      },
      "args": []
    },
    {
      "namespace": "xvminitoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xvminitoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xvminitoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xvminitoppm: apt-get install xvminitoppm 2>/dev/null || which xvminitoppm"
      },
      "args": []
    }
  ]
}