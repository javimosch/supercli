{
  "name": "gistit",
  "version": "0.1.0",
  "description": "Command-line utility for creating Gists",
  "source": "https://github.com/jrbasso/gistit",
  "checks": [
    {
      "type": "binary",
      "name": "gistit"
    }
  ],
  "install_guidance": {
    "plugin": "gistit",
    "binary": "gistit",
    "check": "which gistit",
    "install_steps": [
      "brew install gistit",
      "Verify: gistit --version",
      "supercli plugins install ./plugins/gistit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gistit",
      "resource": "self",
      "action": "version",
      "description": "Print gistit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gistit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gistit: brew install gistit"
      },
      "args": []
    },
    {
      "namespace": "gistit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gistit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gistit",
        "passthrough": true,
        "missingDependencyHelp": "Install gistit"
      },
      "args": []
    }
  ]
}