{
  "name": "qsvlite",
  "version": "0.1.0",
  "description": "CLI tool: qsvlite",
  "source": "https://manpages.debian.org/qsvlite",
  "checks": [
    {
      "type": "binary",
      "name": "qsvlite"
    }
  ],
  "install_guidance": {
    "plugin": "qsvlite",
    "binary": "qsvlite",
    "check": "which qsvlite",
    "install_steps": [
      "apt-get install qsvlite 2>/dev/null || which qsvlite",
      "Verify: qsvlite --version",
      "supercli plugins install ./plugins/qsvlite --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qsvlite",
      "resource": "self",
      "action": "version",
      "description": "Print qsvlite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qsvlite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qsvlite: apt-get install qsvlite 2>/dev/null || which qsvlite"
      },
      "args": []
    },
    {
      "namespace": "qsvlite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qsvlite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qsvlite",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qsvlite: apt-get install qsvlite 2>/dev/null || which qsvlite"
      },
      "args": []
    }
  ]
}