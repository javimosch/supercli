{
  "name": "gio-querymodules",
  "version": "0.1.0",
  "description": "CLI tool: gio-querymodules",
  "source": "https://manpages.debian.org/gio-querymodules",
  "checks": [
    {
      "type": "binary",
      "name": "gio-querymodules"
    }
  ],
  "install_guidance": {
    "plugin": "gio-querymodules",
    "binary": "gio-querymodules",
    "check": "which gio-querymodules",
    "install_steps": [
      "apt-get install gio-querymodules 2>/dev/null || which gio-querymodules",
      "Verify: gio-querymodules --version",
      "supercli plugins install ./plugins/gio-querymodules --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gio-querymodules",
      "resource": "self",
      "action": "version",
      "description": "Print gio-querymodules version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gio-querymodules",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gio-querymodules: apt-get install gio-querymodules 2>/dev/null || which gio-querymodules"
      },
      "args": []
    },
    {
      "namespace": "gio-querymodules",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gio-querymodules CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gio-querymodules",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gio-querymodules: apt-get install gio-querymodules 2>/dev/null || which gio-querymodules"
      },
      "args": []
    }
  ]
}