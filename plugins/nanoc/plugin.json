{
  "name": "nanoc",
  "version": "0.1.0",
  "description": "Static site generator written in Ruby, extremely powerful and customizable, support many formats to generate HTML content.",
  "source": "https://github.com/nanoc/nanoc",
  "checks": [
    {
      "type": "binary",
      "name": "nanoc"
    }
  ],
  "install_guidance": {
    "plugin": "nanoc",
    "binary": "nanoc",
    "check": "which nanoc",
    "install_steps": [
      "See https://github.com/nanoc/nanoc",
      "Verify: nanoc --version",
      "supercli plugins install ./plugins/nanoc --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "nanoc",
      "resource": "self",
      "action": "version",
      "description": "Print nanoc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanoc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nanoc: See https://github.com/nanoc/nanoc"
      },
      "args": []
    },
    {
      "namespace": "nanoc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nanoc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanoc",
        "passthrough": true,
        "missingDependencyHelp": "Install nanoc"
      },
      "args": []
    }
  ]
}