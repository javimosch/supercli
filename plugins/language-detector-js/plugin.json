{
  "name": "language-detector-js",
  "version": "0.1.0",
  "description": "Universal language detector for JavaScript and Node.js",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "language-detector-js" }],
  "install_guidance": {
    "plugin": "language-detector-js",
    "binary": "language-detector-js",
    "check": "which language-detector-js",
    "install_steps": ["npm install -g language-detector-js", "Verify: language-detector-js --version", "supercli plugins install ./plugins/language-detector-js --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "language-detector-js",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to language-detector-js CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "language-detector-js",
      "passthrough": true,
      "missingDependencyHelp": "Install language-detector-js: npm install -g language-detector-js"
    },
    "args": []
  }]
}
