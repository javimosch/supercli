{
  "name": "that-vercel-cli",
  "version": "0.1.0",
  "description": "Simple cli for running batch processes against Vercel's cli",
  "source": "https://github.com/that-vercel-cli/that-vercel-cli",
  "checks": [
    {
      "type": "binary",
      "name": "that-vercel-cli"
    }
  ],
  "install_guidance": {
    "plugin": "that-vercel-cli",
    "binary": "that-vercel-cli",
    "check": "which that-vercel-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: that-vercel-cli --version",
      "supercli plugins install ./plugins/that-vercel-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "that-vercel-cli",
      "resource": "self",
      "action": "version",
      "description": "Print that-vercel-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "that-vercel-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install that-vercel-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "that-vercel-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to that-vercel-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "that-vercel-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install that-vercel-cli from project repository"
      },
      "args": []
    }
  ]
}