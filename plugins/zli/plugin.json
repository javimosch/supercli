{
  "name": "zli",
  "version": "0.1.0",
  "description": "\ud83d\udcdf Build ergonomic, high-performance command-line tools (CLI) with zig.",
  "source": "https://github.com/zli/zli",
  "checks": [
    {
      "type": "binary",
      "name": "zli"
    }
  ],
  "install_guidance": {
    "plugin": "zli",
    "binary": "zli",
    "check": "which zli",
    "install_steps": [
      "pip install zli",
      "Verify: zli --version",
      "supercli plugins install ./plugins/zli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zli",
      "resource": "self",
      "action": "version",
      "description": "Print zli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zli: pip install zli"
      },
      "args": []
    },
    {
      "namespace": "zli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zli",
        "passthrough": true,
        "missingDependencyHelp": "Install zli: pip install zli"
      },
      "args": []
    }
  ]
}