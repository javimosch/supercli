{
  "name": "zli",
  "version": "0.1.0",
  "description": "Build ergonomic CLI tools in Zig",
  "source": "https://github.com/nickelc/zli",
  "checks": [
    {
      "type": "binary",
      "name": "zli"
    }
  ],
  "install_guidance": {
    "plugin": "zli",
    "binary": "zli",
    "check": "which zli",
    "install_steps": [
      "cargo install zli",
      "Verify: zli --version",
      "supercli plugins install ./plugins/zli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zli",
      "resource": "self",
      "action": "version",
      "description": "Print zli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zli: cargo install zli"
      },
      "args": []
    },
    {
      "namespace": "zli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zli",
      "adapter": "process",
      "adapterConfig": {
        "command": "zli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install zli: cargo install zli"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
