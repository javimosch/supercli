{
  "name": "KillWxapkg",
  "version": "0.1.0",
  "description": "\u81ea\u52a8\u5316\u53cd\u7f16\u8bd1\u5fae\u4fe1\u5c0f\u7a0b\u5e8f\uff0c\u5c0f\u7a0b\u5e8f\u5b89\u5168\u8bc4\u4f30\u5de5\u5177\uff0c\u53d1\u73b0\u5c0f\u7a0b\u5e8f\u5b89\u5168\u95ee\u9898\uff0c\u81ea\u52a8\u89e3\u5bc6\uff0c\u89e3\u5305\uff0c\u53ef\u8fd8\u539f\u5de5\u7a0b\u76ee\u5f55\uff0c\u652f\u6301Hook\uff0c\u5c0f\u7a0b\u5e8f\u4fee\u6539",
  "source": "https://github.com/KillWxapkg/KillWxapkg",
  "checks": [
    {
      "type": "binary",
      "name": "killwxapkg"
    }
  ],
  "install_guidance": {
    "plugin": "KillWxapkg",
    "binary": "killwxapkg",
    "check": "which killwxapkg",
    "install_steps": [
      "pip install killwxapkg",
      "Verify: killwxapkg --version",
      "supercli plugins install ./plugins/KillWxapkg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "KillWxapkg",
      "resource": "self",
      "action": "version",
      "description": "Print KillWxapkg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "killwxapkg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install KillWxapkg: pip install killwxapkg"
      },
      "args": []
    },
    {
      "namespace": "KillWxapkg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to killwxapkg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "killwxapkg",
        "passthrough": true,
        "missingDependencyHelp": "Install KillWxapkg: pip install killwxapkg"
      },
      "args": []
    }
  ]
}