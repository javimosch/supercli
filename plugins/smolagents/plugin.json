{
  "name": "smolagents",
  "version": "0.1.0",
  "description": "\ud83e\udd17 smolagents: a barebones library for agents that think in code.",
  "source": "https://github.com/smolagents/smolagents",
  "checks": [
    {
      "type": "binary",
      "name": "smolagents"
    }
  ],
  "install_guidance": {
    "plugin": "smolagents",
    "binary": "smolagents",
    "check": "which smolagents",
    "install_steps": [
      "pip install smolagents",
      "Verify: smolagents --version",
      "supercli plugins install ./plugins/smolagents --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "smolagents",
      "resource": "self",
      "action": "version",
      "description": "Print smolagents version",
      "adapter": "process",
      "adapterConfig": {
        "command": "smolagents",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install smolagents: pip install smolagents"
      },
      "args": []
    },
    {
      "namespace": "smolagents",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to smolagents CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "smolagents",
        "passthrough": true,
        "missingDependencyHelp": "Install smolagents: pip install smolagents"
      },
      "args": []
    }
  ]
}