{
  "name": "go-interview-practice",
  "version": "0.1.0",
  "description": "Interactive Go interview platform with 30+ coding challenges and AI simulation",
  "source": "https://github.com/RezaSi/go-interview-practice",
  "checks": [
    {
      "type": "binary",
      "name": "go-interview-practice"
    }
  ],
  "install_guidance": {
    "plugin": "go-interview-practice",
    "binary": "go-interview-practice",
    "check": "which go-interview-practice",
    "install_steps": [
      "go install github.com/RezaSi/go-interview-practice@latest",
      "Verify: go-interview-practice --version",
      "supercli plugins install ./plugins/go-interview-practice --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "go-interview-practice",
    "resource": "self",
    "action": "version",
    "description": "Print go-interview-practice version",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-interview-practice",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install go-interview-practice: go install github.com/RezaSi/go-interview-practice@latest"
    },
    "args": []
  },
  {
    "namespace": "go-interview-practice",
    "resource": "challenge",
    "action": "list",
    "description": "List available coding challenges",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-interview-practice",
      "baseArgs": [
        "list"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install go-interview-practice: go install github.com/RezaSi/go-interview-practice@latest"
    },
    "args": []
  },
  {
    "namespace": "go-interview-practice",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to go-interview-practice CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-interview-practice",
      "passthrough": true,
      "missingDependencyHelp": "Install go-interview-practice"
    },
    "args": []
  }
]
}