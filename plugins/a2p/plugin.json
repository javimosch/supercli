{
  "name": "a2p",
  "version": "0.1.0",
  "description": "CLI tool: a2p",
  "source": "https://packages.debian.org/a2p",
  "checks": [{ "type": "binary", "name": "a2p" }],
  "install_guidance": {
    "plugin": "a2p", "binary": "a2p", "check": "which a2p",
    "install_steps": ["apt-get install a2p 2>/dev/null || which a2p", "Verify: a2p --version", "supercli plugins install ./plugins/a2p --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "a2p", "resource": "_", "action": "_",
    "description": "Passthrough to a2p CLI",
    "adapter": "process", "adapterConfig": { "command": "a2p", "passthrough": true, "missingDependencyHelp": "Install a2p: apt-get install a2p" }, "args": []
  }]
}
