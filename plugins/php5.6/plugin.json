{
  "name": "php5.6",
  "version": "0.1.0",
  "description": "CLI tool: php5.6",
  "source": "https://manpages.debian.org/php5.6",
  "checks": [
    {
      "type": "binary",
      "name": "php5.6"
    }
  ],
  "install_guidance": {
    "plugin": "php5.6",
    "binary": "php5.6",
    "check": "which php5.6",
    "install_steps": [
      "apt-get install php5.6 2>/dev/null || which php5.6",
      "Verify: php5.6 --version",
      "supercli plugins install ./plugins/php5.6 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "php5.6",
      "resource": "self",
      "action": "version",
      "description": "Print php5.6 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "php5.6",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install php5.6: apt-get install php5.6 2>/dev/null || which php5.6"
      },
      "args": []
    },
    {
      "namespace": "php5.6",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to php5.6 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "php5.6",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install php5.6: apt-get install php5.6 2>/dev/null || which php5.6"
      },
      "args": []
    }
  ]
}