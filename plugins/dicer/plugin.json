{
  "name": "dicer",
  "version": "0.1.0",
  "description": "Bash-based dice roller with support for multiple dice types",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "dicer" }],
  "install_guidance": {
    "plugin": "dicer",
