{
  "name": "JoySafety",
  "version": "0.1.0",
  "description": "JoySafety",
  "source": "https://github.com/JoySafety/JoySafety",
  "checks": [
    {
      "type": "binary",
      "name": "joysafety"
    }
  ],
  "install_guidance": {
    "plugin": "JoySafety",
    "binary": "joysafety",
    "check": "which joysafety",
    "install_steps": [
      "pip install joysafety",
      "Verify: joysafety --version",
      "supercli plugins install ./plugins/JoySafety --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "JoySafety",
      "resource": "self",
      "action": "version",
      "description": "Print JoySafety version",
      "adapter": "process",
      "adapterConfig": {
        "command": "joysafety",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install JoySafety: pip install joysafety"
      },
      "args": []
    },
    {
      "namespace": "JoySafety",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to joysafety CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "joysafety",
        "passthrough": true,
        "missingDependencyHelp": "Install JoySafety: pip install joysafety"
      },
      "args": []
    }
  ]
}