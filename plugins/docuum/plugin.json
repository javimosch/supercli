{
  "name": "docuum",
  "version": "0.1.0",
  "description": "LRU eviction of Docker images with space management",
  "source": "https://github.com/stepchowfun/docuum",
  "checks": [{ "type": "binary", "name": "docuum" }],
  "install_guidance": {
    "plugin": "docuum",
    "binary": "docuum",
    "check": "which docuum",
    "install_steps": ["brew install docuum", "Verify: docuum --version", "supercli plugins install ./plugins/docuum --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "docuum",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to docuum CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "docuum",
      "passthrough": true,
      "missingDependencyHelp": "Install docuum: brew install docuum", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
