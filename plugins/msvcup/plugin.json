{
  "name": "msvcup",
  "version": "0.1.0",
  "description": "Hermetic install of MSVC/SDK from the CLI",
  "source": "https://github.com/msvcup/msvcup",
  "checks": [
    {
      "type": "binary",
      "name": "msvcup"
    }
  ],
  "install_guidance": {
    "plugin": "msvcup",
    "binary": "msvcup",
    "check": "which msvcup",
    "install_steps": [
      "pip install msvcup",
      "Verify: msvcup --version",
      "supercli plugins install ./plugins/msvcup --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "msvcup",
      "resource": "self",
      "action": "version",
      "description": "Print msvcup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "msvcup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install msvcup: pip install msvcup"
      },
      "args": []
    },
    {
      "namespace": "msvcup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to msvcup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "msvcup",
        "passthrough": true,
        "missingDependencyHelp": "Install msvcup: pip install msvcup"
      },
      "args": []
    }
  ]
}