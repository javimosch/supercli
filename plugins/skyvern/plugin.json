{
  "name": "skyvern",
  "version": "0.1.0",
  "description": "Automate browser based workflows with AI",
  "source": "https://github.com/skyvern/skyvern",
  "checks": [
    {
      "type": "binary",
      "name": "skyvern"
    }
  ],
  "install_guidance": {
    "plugin": "skyvern",
    "binary": "skyvern",
    "check": "which skyvern",
    "install_steps": [
      "pip install skyvern",
      "Verify: skyvern --version",
      "supercli plugins install ./plugins/skyvern --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "skyvern",
      "resource": "self",
      "action": "version",
      "description": "Print skyvern version",
      "adapter": "process",
      "adapterConfig": {
        "command": "skyvern",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install skyvern: pip install skyvern"
      },
      "args": []
    },
    {
      "namespace": "skyvern",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to skyvern CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "skyvern",
        "passthrough": true,
        "missingDependencyHelp": "Install skyvern: pip install skyvern"
      },
      "args": []
    }
  ]
}