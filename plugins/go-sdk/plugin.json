{
  "name": "go-sdk",
  "version": "0.1.0",
  "description": "The official Go SDK for Model Context Protocol servers and clients. Maintained in collaboration with",
  "source": "https://github.com/go-sdk/go-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "go-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "go-sdk",
    "binary": "go-sdk",
    "check": "which go-sdk",
    "install_steps": [
      "pip install go-sdk",
      "Verify: go-sdk --version",
      "supercli plugins install ./plugins/go-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print go-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-sdk: pip install go-sdk"
      },
      "args": []
    },
    {
      "namespace": "go-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install go-sdk: pip install go-sdk"
      },
      "args": []
    }
  ]
}