{
  "name": "ui-ux-pro-max-skill",
  "version": "0.1.0",
  "description": "An AI SKILL that provide design intelligence for building professional UI/UX multiple platforms",
  "source": "https://github.com/ui-ux-pro-max-skill/ui-ux-pro-max-skill",
  "checks": [
    {
      "type": "binary",
      "name": "ui-ux-pro-max-skill"
    }
  ],
  "install_guidance": {
    "plugin": "ui-ux-pro-max-skill",
    "binary": "ui-ux-pro-max-skill",
    "check": "which ui-ux-pro-max-skill",
    "install_steps": [
      "pip install ui-ux-pro-max-skill",
      "Verify: ui-ux-pro-max-skill --version",
      "supercli plugins install ./plugins/ui-ux-pro-max-skill --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ui-ux-pro-max-skill",
      "resource": "self",
      "action": "version",
      "description": "Print ui-ux-pro-max-skill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ui-ux-pro-max-skill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ui-ux-pro-max-skill: pip install ui-ux-pro-max-skill"
      },
      "args": []
    },
    {
      "namespace": "ui-ux-pro-max-skill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ui-ux-pro-max-skill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ui-ux-pro-max-skill",
        "passthrough": true,
        "missingDependencyHelp": "Install ui-ux-pro-max-skill: pip install ui-ux-pro-max-skill"
      },
      "args": []
    }
  ]
}