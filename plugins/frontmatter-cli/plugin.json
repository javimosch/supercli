{
  "name": "frontmatter-cli",
  "version": "0.1.0",
  "description": "Extract and parse frontmatter from markdown files",
  "source": "https://github.com/metayeti/frontmatter-cli",
  "checks": [{ "type": "binary", "name": "frontmatter-cli" }],
  "install_guidance": {
    "plugin": "frontmatter-cli",
    "binary": "frontmatter-cli",
    "check": "which frontmatter-cli",
    "install_steps": ["npm install -g frontmatter-cli", "Verify: frontmatter-cli --version", "supercli plugins install ./plugins/frontmatter-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "frontmatter-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to frontmatter-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "frontmatter-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install frontmatter-cli: npm install -g frontmatter-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
