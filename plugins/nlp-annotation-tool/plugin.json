{
  "name": "nlp-annotation-tool",
  "version": "0.1.0",
  "description": "Local CLI for NLP text annotation and labeling",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "nlp-annotation-tool" }],
  "install_guidance": {
    "plugin": "nlp-annotation-tool",
    "binary": "nlp-annotation-tool",
    "check": "which nlp-annotation-tool",
    "install_steps": ["pip install nlp-annotation-tool", "Verify: nlp-annotation-tool --version", "supercli plugins install ./plugins/nlp-annotation-tool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nlp-annotation-tool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nlp-annotation-tool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nlp-annotation-tool",
      "passthrough": true,
      "missingDependencyHelp": "Install nlp-annotation-tool: pip install nlp-annotation-tool"
    },
    "args": []
  }]
}
