{
  "name": "httpflow",
  "version": "0.1.0",
  "description": "Packet capture and analysis utility similar to tcpdump for HTTP",
  "source": "https://github.com/six-ddc/httpflow",
  "checks": [
    {
      "type": "binary",
      "name": "httpflow"
    }
  ],
  "install_guidance": {
    "plugin": "httpflow",
    "binary": "httpflow",
    "check": "which httpflow",
    "install_steps": [
      "brew install httpflow",
      "Verify: httpflow --version",
      "supercli plugins install ./plugins/httpflow --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "httpflow",
      "resource": "self",
      "action": "version",
      "description": "Print httpflow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "httpflow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install httpflow: brew install httpflow"
      },
      "args": []
    },
    {
      "namespace": "httpflow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to httpflow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "httpflow",
        "passthrough": true,
        "missingDependencyHelp": "Install httpflow"
      },
      "args": []
    }
  ]
}