{
  "name": "amfora",
  "version": "0.1.0",
  "description": "A fancy terminal browser for the Gemini protocol",
  "source": "https://github.com/makeworld-the-better-one/amfora",
  "checks": [
    {
      "type": "binary",
      "name": "amfora"
    }
  ],
  "install_guidance": {
    "plugin": "amfora",
    "binary": "amfora",
    "check": "which amfora",
    "install_steps": [
      "go install github.com/makeworld-the-better-one/amfora@latest",
      "Verify: amfora --version",
      "supercli plugins install ./plugins/amfora --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "amfora",
      "resource": "self",
      "action": "version",
      "description": "Print amfora version",
      "adapter": "process",
      "adapterConfig": {
        "command": "amfora",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install amfora: go install github.com/makeworld-the-better-one/amfora@latest"
      },
      "args": []
    },
    {
      "namespace": "amfora",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to amfora CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "amfora",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install amfora: go install github.com/makeworld-the-better-one/amfora@latest"
      },
      "args": []
    }
  ]
}