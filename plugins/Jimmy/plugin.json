{
  "name": "Jimmy",
  "version": "0.1.0",
  "description": "Convert various note formats to markdown",
  "source": "https://github.com/marph91/jimmy",
  "checks": [
    {
      "type": "binary",
      "name": "Jimmy"
    }
  ],
  "install_guidance": {
    "plugin": "Jimmy",
    "binary": "Jimmy",
    "check": "which Jimmy",
    "install_steps": [
      "See https://github.com/marph91/jimmy",
      "Verify: Jimmy --version",
      "supercli plugins install ./plugins/Jimmy --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Jimmy",
      "resource": "self",
      "action": "version",
      "description": "Print Jimmy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Jimmy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Jimmy: See https://github.com/marph91/jimmy"
      },
      "args": []
    },
    {
      "namespace": "Jimmy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Jimmy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Jimmy",
        "passthrough": true,
        "missingDependencyHelp": "Install Jimmy"
      },
      "args": []
    }
  ]
}