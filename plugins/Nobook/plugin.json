{
  "name": "Nobook",
  "version": "0.1.0",
  "description": "Ad-free facebook lite for Android.",
  "source": "https://github.com/Nobook/Nobook",
  "checks": [
    {
      "type": "binary",
      "name": "nobook"
    }
  ],
  "install_guidance": {
    "plugin": "Nobook",
    "binary": "nobook",
    "check": "which nobook",
    "install_steps": [
      "pip install nobook",
      "Verify: nobook --version",
      "supercli plugins install ./plugins/Nobook --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Nobook",
      "resource": "self",
      "action": "version",
      "description": "Print Nobook version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nobook",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Nobook: pip install nobook"
      },
      "args": []
    },
    {
      "namespace": "Nobook",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nobook CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nobook",
        "passthrough": true,
        "missingDependencyHelp": "Install Nobook: pip install nobook"
      },
      "args": []
    }
  ]
}