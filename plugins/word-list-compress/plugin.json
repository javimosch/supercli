{
  "name": "word-list-compress",
  "version": "0.1.0",
  "description": "CLI tool: word-list-compress",
  "source": "https://manpages.debian.org/word-list-compress",
  "checks": [
    {
      "type": "binary",
      "name": "word-list-compress"
    }
  ],
  "install_guidance": {
    "plugin": "word-list-compress",
    "binary": "word-list-compress",
    "check": "which word-list-compress",
    "install_steps": [
      "apt-get install word-list-compress 2>/dev/null || which word-list-compress",
      "Verify: word-list-compress --version",
      "supercli plugins install ./plugins/word-list-compress --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "word-list-compress",
      "resource": "self",
      "action": "version",
      "description": "Print word-list-compress version",
      "adapter": "process",
      "adapterConfig": {
        "command": "word-list-compress",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install word-list-compress: apt-get install word-list-compress 2>/dev/null || which word-list-compress"
      },
      "args": []
    },
    {
      "namespace": "word-list-compress",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to word-list-compress CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "word-list-compress",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install word-list-compress: apt-get install word-list-compress 2>/dev/null || which word-list-compress"
      },
      "args": []
    }
  ]
}