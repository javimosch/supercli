{
  "name": "jdnssec-tools",
  "version": "0.1.0",
  "description": "Java command-line tools for DNSSEC",
  "source": "https://github.com/dblacka/jdnssec-tools",
  "checks": [
    {
      "type": "binary",
      "name": "jdnssec-tools"
    }
  ],
  "install_guidance": {
    "plugin": "jdnssec-tools",
    "binary": "jdnssec-tools",
    "check": "which jdnssec-tools",
    "install_steps": [
      "brew install jdnssec-tools",
      "Verify: jdnssec-tools --version",
      "supercli plugins install ./plugins/jdnssec-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jdnssec-tools",
      "resource": "self",
      "action": "version",
      "description": "Print jdnssec-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jdnssec-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jdnssec-tools: brew install jdnssec-tools"
      },
      "args": []
    },
    {
      "namespace": "jdnssec-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jdnssec-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jdnssec-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install jdnssec-tools"
      },
      "args": []
    }
  ]
}