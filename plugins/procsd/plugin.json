{
  "name": "procsd",
  "version": "0.1.0",
  "description": "Manage processes in production without heavy init systems",
  "source": "gem",
  "checks": [{ "type": "binary", "name": "procsd" }],
  "install_guidance": {
    "plugin": "procsd",
    "binary": "procsd",
    "check": "which procsd",
    "install_steps": ["gem install procsd", "Verify: procsd --version", "supercli plugins install ./plugins/procsd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "procsd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to procsd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "procsd",
      "passthrough": true,
      "missingDependencyHelp": "Install procsd: gem install procsd"
    },
    "args": []
  }]
}
