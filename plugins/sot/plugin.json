{
  "name": "sot",
  "version": "0.1.0",
  "description": "CLI system observation tool for quick diagnostics",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "sot" }],
  "install_guidance": {
    "plugin": "sot",
    "binary": "sot",
    "check": "which sot",
    "install_steps": ["git clone && cargo build", "Verify: sot --version", "supercli plugins install ./plugins/sot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sot",
      "passthrough": true,
      "missingDependencyHelp": "Install sot: git clone && cargo build"
    },
    "args": []
  }]
}
