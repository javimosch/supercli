{
  "name": "mysqladmin",
  "version": "0.1.0",
  "description": "MySQL/MariaDB administration tool",
  "source": "https://packages.debian.org/mysqladmin",
  "checks": [{ "type": "binary", "name": "mysqladmin" }],
  "install_guidance": {
    "plugin": "mysqladmin", "binary": "mysqladmin", "check": "which mysqladmin",
    "install_steps": ["apt-get install mysql-client", "Verify: mysqladmin --version", "supercli plugins install ./plugins/mysqladmin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mysqladmin", "resource": "_", "action": "_",
    "description": "Passthrough to mysqladmin CLI",
    "adapter": "process", "adapterConfig": { "command": "mysqladmin", "passthrough": true, "missingDependencyHelp": "Install mysqladmin: apt-get install mysql-client" }, "args": []
  }]
}
