{
  "name": "osx-wifi-cli",
  "version": "0.1.0",
  "description": "Manage wifi connections",
  "source": "https://github.com/danyshaanan/osx-wifi-cli",
  "checks": [
    {
      "type": "binary",
      "name": "osx-wifi-cli"
    }
  ],
  "install_guidance": {
    "plugin": "osx-wifi-cli",
    "binary": "osx-wifi-cli",
    "check": "which osx-wifi-cli",
    "install_steps": [
      "See https://github.com/danyshaanan/osx-wifi-cli",
      "Verify: osx-wifi-cli --version",
      "supercli plugins install ./plugins/osx-wifi-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "osx-wifi-cli",
      "resource": "self",
      "action": "version",
      "description": "Print osx-wifi-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "osx-wifi-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install osx-wifi-cli: See https://github.com/danyshaanan/osx-wifi-cli"
      },
      "args": []
    },
    {
      "namespace": "osx-wifi-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to osx-wifi-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "osx-wifi-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install osx-wifi-cli"
      },
      "args": []
    }
  ]
}