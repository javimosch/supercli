{
  "name": "backrest",
  "version": "0.1.0",
  "description": "Backrest is a web UI and orchestrator for restic backup.",
  "source": "https://github.com/backrest/backrest",
  "checks": [
    {
      "type": "binary",
      "name": "backrest"
    }
  ],
  "install_guidance": {
    "plugin": "backrest",
    "binary": "backrest",
    "check": "which backrest",
    "install_steps": [
      "pip install backrest",
      "Verify: backrest --version",
      "supercli plugins install ./plugins/backrest --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "backrest",
      "resource": "self",
      "action": "version",
      "description": "Print backrest version",
      "adapter": "process",
      "adapterConfig": {
        "command": "backrest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install backrest: pip install backrest"
      },
      "args": []
    },
    {
      "namespace": "backrest",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to backrest CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "backrest",
        "passthrough": true,
        "missingDependencyHelp": "Install backrest: pip install backrest"
      },
      "args": []
    }
  ]
}