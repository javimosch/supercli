{
  "name": "ppmtoilbm",
  "version": "0.1.0",
  "description": "CLI tool: ppmtoilbm",
  "source": "https://manpages.debian.org/ppmtoilbm",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtoilbm"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtoilbm",
    "binary": "ppmtoilbm",
    "check": "which ppmtoilbm",
    "install_steps": [
      "apt-get install ppmtoilbm 2>/dev/null || which ppmtoilbm",
      "Verify: ppmtoilbm --version",
      "supercli plugins install ./plugins/ppmtoilbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtoilbm",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtoilbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoilbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtoilbm: apt-get install ppmtoilbm 2>/dev/null || which ppmtoilbm"
      },
      "args": []
    },
    {
      "namespace": "ppmtoilbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtoilbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoilbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtoilbm: apt-get install ppmtoilbm 2>/dev/null || which ppmtoilbm"
      },
      "args": []
    }
  ]
}