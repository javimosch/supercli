{
  "name": "o",
  "version": "0.1.0",
  "description": "Small configurable text editor in Go",
  "source": "https://github.com/zyedidia/o",
  "checks": [{ "type": "binary", "name": "o" }],
  "install_guidance": {
    "plugin": "o",
    "binary": "o",
    "check": "which o",
    "install_steps": ["go install github.com/zyedidia/o@latest", "Verify: o --version", "supercli plugins install ./plugins/o --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "o",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to o CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "o",
      "passthrough": true,
      "missingDependencyHelp": "Install o: go install github.com/zyedidia/o@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
