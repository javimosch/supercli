{
  "name": "glow-yaml",
  "version": "0.1.0",
  "description": "Render YAML as highlighted terminal output",
  "source": "https://github.com/charmbracelet/glow",
  "checks": [{ "type": "binary", "name": "glow" }],
  "install_guidance": {
    "plugin": "glow-yaml",
    "binary": "glow",
    "check": "which glow",
    "install_steps": ["go install github.com/charmbracelet/glow@latest", "Verify: glow --version", "supercli plugins install ./plugins/glow-yaml --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "glow-yaml",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to glow CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "glow",
      "passthrough": true,
      "missingDependencyHelp": "Install glow-yaml: go install github.com/charmbracelet/glow@latest"
    },
    "args": []
  }]
}
