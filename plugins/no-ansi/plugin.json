{
  "name": "no-ansi",
  "version": "0.1.0",
  "description": "A single-function CLI tool to strip escape codes from input",
  "source": "https://github.com/no-ansi/no-ansi",
  "checks": [
    {
      "type": "binary",
      "name": "no-ansi"
    }
  ],
  "install_guidance": {
    "plugin": "no-ansi",
    "binary": "no-ansi",
    "check": "which no-ansi",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: no-ansi --version",
      "supercli plugins install ./plugins/no-ansi --on-conflict replace --json"
    ],
    "note": "Rust language CLI tool"
  },
  "commands": [
    {
      "namespace": "no-ansi",
      "resource": "self",
      "action": "version",
      "description": "Print no-ansi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "no-ansi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install no-ansi from project repository"
      },
      "args": []
    },
    {
      "namespace": "no-ansi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to no-ansi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "no-ansi",
        "passthrough": true,
        "missingDependencyHelp": "Install no-ansi from project repository"
      },
      "args": []
    }
  ]
}