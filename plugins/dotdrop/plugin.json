{
  "name": "dotdrop",
  "version": "1.0.0",
  "description": "dotdrop \u2014 Dotfile manager",
  "source": "github.com/deadc0de6/dotdrop",
  "checks": [
    {
      "type": "binary",
      "name": "dotdrop"
    }
  ],
  "install_guidance": {
    "plugin": "dotdrop",
    "binary": "dotdrop",
    "check": "which dotdrop",
    "install_steps": [
      "# Install dotdrop",
      "# See github.com/deadc0de6/dotdrop",
      "# apt: sudo apt-get install dotdrop",
      "# brew: brew install dotdrop",
      "# cargo: cargo install dotdrop",
      "# npm: npm install -g dotdrop",
      "# pip: pip install dotdrop"
    ]
  },
  "commands": [
    {
      "namespace": "dotdrop",
      "resource": "dotdrop",
      "action": "run",
      "description": "Run dotdrop",
      "adapter": "process",
      "adapterConfig": {
        "command": "dotdrop",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dotdrop from github.com/deadc0de6/dotdrop"
      },
      "args": []
    }
  ]
}