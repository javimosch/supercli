{
  "name": "d2mcpp",
  "version": "0.1.0",
  "description": "D2X | Modern C++ Core Language Features - \"A C++ tutorial project focused on practical\"",
  "source": "https://github.com/d2mcpp/d2mcpp",
  "checks": [
    {
      "type": "binary",
      "name": "d2mcpp"
    }
  ],
  "install_guidance": {
    "plugin": "d2mcpp",
    "binary": "d2mcpp",
    "check": "which d2mcpp",
    "install_steps": [
      "pip install d2mcpp",
      "Verify: d2mcpp --version",
      "supercli plugins install ./plugins/d2mcpp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "d2mcpp",
      "resource": "self",
      "action": "version",
      "description": "Print d2mcpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "d2mcpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install d2mcpp: pip install d2mcpp"
      },
      "args": []
    },
    {
      "namespace": "d2mcpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to d2mcpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "d2mcpp",
        "passthrough": true,
        "missingDependencyHelp": "Install d2mcpp: pip install d2mcpp"
      },
      "args": []
    }
  ]
}