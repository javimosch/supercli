{
  "name": "Micro-Wheeled_leg-Robot",
  "version": "0.1.0",
  "description": "\u5168\u7403\u6700\u5c0f\u7684\u684c\u9762\u7ea7\u53cc\u8f6e\u817f\u673a\u5668\u4eba\uff01",
  "source": "https://github.com/Micro-Wheeled_leg-Robot/Micro-Wheeled_leg-Robot",
  "checks": [
    {
      "type": "binary",
      "name": "micro-wheeled-leg-robot"
    }
  ],
  "install_guidance": {
    "plugin": "Micro-Wheeled_leg-Robot",
    "binary": "micro-wheeled-leg-robot",
    "check": "which micro-wheeled-leg-robot",
    "install_steps": [
      "pip install micro-wheeled-leg-robot",
      "Verify: micro-wheeled-leg-robot --version",
      "supercli plugins install ./plugins/Micro-Wheeled_leg-Robot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Micro-Wheeled_leg-Robot",
      "resource": "self",
      "action": "version",
      "description": "Print Micro-Wheeled_leg-Robot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "micro-wheeled-leg-robot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Micro-Wheeled_leg-Robot: pip install micro-wheeled-leg-robot"
      },
      "args": []
    },
    {
      "namespace": "Micro-Wheeled_leg-Robot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to micro-wheeled-leg-robot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "micro-wheeled-leg-robot",
        "passthrough": true,
        "missingDependencyHelp": "Install Micro-Wheeled_leg-Robot: pip install micro-wheeled-leg-robot"
      },
      "args": []
    }
  ]
}