{
  "name": "dirtyfrag",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/dirtyfrag/dirtyfrag",
  "checks": [
    {
      "type": "binary",
      "name": "dirtyfrag"
    }
  ],
  "install_guidance": {
    "plugin": "dirtyfrag",
    "binary": "dirtyfrag",
    "check": "which dirtyfrag",
    "install_steps": [
      "pip install dirtyfrag",
      "Verify: dirtyfrag --version",
      "supercli plugins install ./plugins/dirtyfrag --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dirtyfrag",
      "resource": "self",
      "action": "version",
      "description": "Print dirtyfrag version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dirtyfrag",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dirtyfrag: pip install dirtyfrag"
      },
      "args": []
    },
    {
      "namespace": "dirtyfrag",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dirtyfrag CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dirtyfrag",
        "passthrough": true,
        "missingDependencyHelp": "Install dirtyfrag: pip install dirtyfrag"
      },
      "args": []
    }
  ]
}