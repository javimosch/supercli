{
  "name": "pnmflip",
  "version": "0.1.0",
  "description": "CLI tool: pnmflip",
  "source": "https://manpages.debian.org/pnmflip",
  "checks": [
    {
      "type": "binary",
      "name": "pnmflip"
    }
  ],
  "install_guidance": {
    "plugin": "pnmflip",
    "binary": "pnmflip",
    "check": "which pnmflip",
    "install_steps": [
      "apt-get install pnmflip 2>/dev/null || which pnmflip",
      "Verify: pnmflip --version",
      "supercli plugins install ./plugins/pnmflip --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmflip",
      "resource": "self",
      "action": "version",
      "description": "Print pnmflip version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmflip",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmflip: apt-get install pnmflip 2>/dev/null || which pnmflip"
      },
      "args": []
    },
    {
      "namespace": "pnmflip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmflip CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmflip",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmflip: apt-get install pnmflip 2>/dev/null || which pnmflip"
      },
      "args": []
    }
  ]
}