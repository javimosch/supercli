{
  "name": "icu4c",
  "version": "0.1.0",
  "description": "Internationalization utilities",
  "source": "https://github.com/unicode-org/icu",
  "checks": [
    {
      "type": "binary",
      "name": "icu4c"
    }
  ],
  "install_guidance": {
    "plugin": "icu4c",
    "binary": "icu4c",
    "check": "which icu4c",
    "install_steps": [
      "brew install icu4c",
      "Verify: icu4c --version",
      "supercli plugins install ./plugins/icu4c --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "icu4c",
      "resource": "self",
      "action": "version",
      "description": "Print icu4c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "icu4c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install icu4c: brew install icu4c"
      },
      "args": []
    },
    {
      "namespace": "icu4c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to icu4c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "icu4c",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install icu4c: brew install icu4c"
      },
      "args": []
    }
  ]
}
