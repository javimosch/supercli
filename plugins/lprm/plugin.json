{
  "name": "lprm",
  "version": "0.1.0",
  "description": "Cancel print jobs in queue",
  "source": "https://packages.debian.org/lprm",
  "checks": [{ "type": "binary", "name": "lprm" }],
  "install_guidance": {
    "plugin": "lprm", "binary": "lprm", "check": "which lprm",
    "install_steps": ["apt-get install cups-bsd", "Verify: lprm --version", "supercli plugins install ./plugins/lprm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lprm", "resource": "_", "action": "_",
    "description": "Passthrough to lprm CLI",
    "adapter": "process", "adapterConfig": { "command": "lprm", "passthrough": true, "missingDependencyHelp": "Install lprm: apt-get install cups-bsd" }, "args": []
  }]
}
