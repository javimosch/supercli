{
  "name": "thinkjettopbm",
  "version": "0.1.0",
  "description": "CLI tool: thinkjettopbm",
  "source": "https://manpages.debian.org/thinkjettopbm",
  "checks": [
    {
      "type": "binary",
      "name": "thinkjettopbm"
    }
  ],
  "install_guidance": {
    "plugin": "thinkjettopbm",
    "binary": "thinkjettopbm",
    "check": "which thinkjettopbm",
    "install_steps": [
      "apt-get install thinkjettopbm 2>/dev/null || which thinkjettopbm",
      "Verify: thinkjettopbm --version",
      "supercli plugins install ./plugins/thinkjettopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "thinkjettopbm",
      "resource": "self",
      "action": "version",
      "description": "Print thinkjettopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "thinkjettopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install thinkjettopbm: apt-get install thinkjettopbm 2>/dev/null || which thinkjettopbm"
      },
      "args": []
    },
    {
      "namespace": "thinkjettopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to thinkjettopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "thinkjettopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install thinkjettopbm: apt-get install thinkjettopbm 2>/dev/null || which thinkjettopbm"
      },
      "args": []
    }
  ]
}