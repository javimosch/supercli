{
  "name": "erg",
  "version": "0.1.0",
  "description": "Statically typed language that can deeply improve the Python ecosystem",
  "source": "https://github.com/erg-lang/erg",
  "checks": [
    {
      "type": "binary",
      "name": "erg"
    }
  ],
  "install_guidance": {
    "plugin": "erg",
    "binary": "erg",
    "check": "which erg",
    "install_steps": [
      "brew install erg",
      "Verify: erg --version",
      "supercli plugins install ./plugins/erg --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "erg",
      "resource": "self",
      "action": "version",
      "description": "Print erg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "erg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install erg: brew install erg"
      },
      "args": []
    },
    {
      "namespace": "erg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to erg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "erg",
        "passthrough": true,
        "missingDependencyHelp": "Install erg"
      },
      "args": []
    }
  ]
}