{
  "name": "gerrit-tools",
  "version": "0.1.0",
  "description": "Tools to ease Gerrit code review",
  "source": "https://github.com/indirect/gerrit-tools",
  "checks": [
    {
      "type": "binary",
      "name": "gerrit-tools"
    }
  ],
  "install_guidance": {
    "plugin": "gerrit-tools",
    "binary": "gerrit-tools",
    "check": "which gerrit-tools",
    "install_steps": [
      "brew install gerrit-tools",
      "Verify: gerrit-tools --version",
      "supercli plugins install ./plugins/gerrit-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gerrit-tools",
      "resource": "self",
      "action": "version",
      "description": "Print gerrit-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gerrit-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gerrit-tools: brew install gerrit-tools"
      },
      "args": []
    },
    {
      "namespace": "gerrit-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gerrit-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gerrit-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install gerrit-tools"
      },
      "args": []
    }
  ]
}