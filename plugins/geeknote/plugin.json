{
  "name": "geeknote",
  "version": "0.1.0",
  "description": "Command-line client for Evernote",
  "source": "https://github.com/jeffkowalski/geeknote",
  "checks": [{ "type": "binary", "name": "geeknote" }],
  "install_guidance": {
    "plugin": "geeknote",
    "binary": "geeknote",
    "check": "which geeknote",
    "install_steps": ["pip install geeknote", "Verify: geeknote --version", "supercli plugins install ./plugins/geeknote --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "geeknote",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to geeknote CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "geeknote",
      "passthrough": true,
      "missingDependencyHelp": "Install geeknote: pip install geeknote", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
