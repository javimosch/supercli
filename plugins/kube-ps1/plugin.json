{
  "name": "kube-ps1",
  "version": "0.1.0",
  "description": "Kubernetes prompt helper for bash and zsh",
  "source": "https://github.com/jonmosco/kube-ps1",
  "checks": [{ "type": "binary", "name": "kube-ps1" }],
  "install_guidance": {
    "plugin": "kube-ps1",
    "binary": "kube-ps1",
    "check": "which kube-ps1",
    "install_steps": ["brew install kube-ps1", "Verify: kube-ps1 --version", "supercli plugins install ./plugins/kube-ps1 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kube-ps1",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kube-ps1 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kube-ps1",
      "passthrough": true,
      "missingDependencyHelp": "Install kube-ps1: brew install kube-ps1"
    },
    "args": []
  }]
}
