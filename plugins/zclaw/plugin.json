{
  "name": "zclaw",
  "version": "0.1.0",
  "description": "Your personal AI assistant at all-in 888KiB (~35KB in app code). Running on an ESP32. GPIO, cron, cu",
  "source": "https://github.com/zclaw/zclaw",
  "checks": [
    {
      "type": "binary",
      "name": "zclaw"
    }
  ],
  "install_guidance": {
    "plugin": "zclaw",
    "binary": "zclaw",
    "check": "which zclaw",
    "install_steps": [
      "pip install zclaw",
      "Verify: zclaw --version",
      "supercli plugins install ./plugins/zclaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zclaw",
      "resource": "self",
      "action": "version",
      "description": "Print zclaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zclaw: pip install zclaw"
      },
      "args": []
    },
    {
      "namespace": "zclaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install zclaw: pip install zclaw"
      },
      "args": []
    }
  ]
}