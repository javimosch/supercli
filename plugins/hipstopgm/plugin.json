{
  "name": "hipstopgm",
  "version": "0.1.0",
  "description": "CLI tool: hipstopgm",
  "source": "https://manpages.debian.org/hipstopgm",
  "checks": [
    {
      "type": "binary",
      "name": "hipstopgm"
    }
  ],
  "install_guidance": {
    "plugin": "hipstopgm",
    "binary": "hipstopgm",
    "check": "which hipstopgm",
    "install_steps": [
      "apt-get install hipstopgm 2>/dev/null || which hipstopgm",
      "Verify: hipstopgm --version",
      "supercli plugins install ./plugins/hipstopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hipstopgm",
      "resource": "self",
      "action": "version",
      "description": "Print hipstopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hipstopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hipstopgm: apt-get install hipstopgm 2>/dev/null || which hipstopgm"
      },
      "args": []
    },
    {
      "namespace": "hipstopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hipstopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hipstopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hipstopgm: apt-get install hipstopgm 2>/dev/null || which hipstopgm"
      },
      "args": []
    }
  ]
}