{
  "name": "xarchiver",
  "version": "0.1.0",
  "description": "Lightweight archive manager with batch extract",
  "source": "https://github.com/ib/xarchiver",
  "checks": [
    {
      "type": "binary",
      "name": "xarchiver"
    }
  ],
  "install_guidance": {
    "plugin": "xarchiver",
    "binary": "xarchiver",
    "check": "which xarchiver",
    "install_steps": [
      "brew install xarchiver",
      "Verify: xarchiver --version",
      "supercli plugins install ./plugins/xarchiver --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "xarchiver",
      "resource": "self",
      "action": "version",
      "description": "Print xarchiver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xarchiver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xarchiver: brew install xarchiver"
      },
      "args": []
    },
    {
      "namespace": "xarchiver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xarchiver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xarchiver",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xarchiver: brew install xarchiver"
      },
      "args": []
    }
  ]
}
