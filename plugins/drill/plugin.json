{
  "name": "drill",
  "version": "0.1.0",
  "description": "HTTP load testing application in Rust with ansi terminal output",
  "source": "https://github.com/fcsonline/drill",
  "checks": [{ "type": "binary", "name": "drill" }],
  "install_guidance": {
    "plugin": "drill",
    "binary": "drill",
    "check": "which drill",
    "install_steps": ["cargo install drill", "Verify: drill --version", "supercli plugins install ./plugins/drill --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "drill",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to drill CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "drill",
      "passthrough": true,
      "missingDependencyHelp": "Install drill: cargo install drill"
    },
    "args": []
  }]
}
