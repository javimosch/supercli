{
  "name": "CLI-Anything-Civil3D",
  "version": "0.1.0",
  "description": "Civil 3D CLI harness - alignments, corridors, surfaces, pipe networks via Windows COM",
  "source": "https://github.com/CLI-Anything-Civil3D/CLI-Anything-Civil3D",
  "checks": [
    {
      "type": "binary",
      "name": "CLI-Anything-Civil3D"
    }
  ],
  "install_guidance": {
    "plugin": "CLI-Anything-Civil3D",
    "binary": "CLI-Anything-Civil3D",
    "check": "which CLI-Anything-Civil3D",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: CLI-Anything-Civil3D --version",
      "supercli plugins install ./plugins/CLI-Anything-Civil3D --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "CLI-Anything-Civil3D",
      "resource": "self",
      "action": "version",
      "description": "Print CLI-Anything-Civil3D version",
      "adapter": "process",
      "adapterConfig": {
        "command": "CLI-Anything-Civil3D",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CLI-Anything-Civil3D from project repository"
      },
      "args": []
    },
    {
      "namespace": "CLI-Anything-Civil3D",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to CLI-Anything-Civil3D CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "CLI-Anything-Civil3D",
        "passthrough": true,
        "missingDependencyHelp": "Install CLI-Anything-Civil3D from project repository"
      },
      "args": []
    }
  ]
}