{
  "name": "release-it",
  "version": "0.1.0",
  "description": "Automate version bumps, changelog generation, git tags, and publishing to npm/GitHub/GitLab — all from one CLI command.",
  "source": "https://github.com/release-it/release-it",
  "checks": [
    {
      "type": "binary",
      "name": "release-it"
    }
  ],
  "install_guidance": {
    "plugin": "release-it",
    "binary": "release-it",
    "check": "release-it --version",
    "install_steps": [
      "npm install -g release-it",
      "release-it --version"
    ],
    "note": "Requires Node.js 18+. Also install @release-it/XXX plugins for extended functionality (e.g., @release-it/conventional-changelog for conventional commits)."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "release-it",
      "resource": "release",
      "action": "create",
      "description": "Create a new release (bump version, tag, push, publish)",
      "adapter": "process",
      "adapterConfig": {
        "command": "release-it",
        "passthrough": true,
        "missingDependencyHelp": "Install release-it: npm install -g release-it"
      },
      "args": [
        {
          "name": "--dry-run",
          "type": "boolean",
          "description": "Show what would happen without making changes"
        },
        {
          "name": "--ci",
          "type": "boolean",
          "description": "Run in CI mode (non-interactive)"
        },
        {
          "name": "--config",
          "type": "string",
          "description": "Path to config file"
        },
        {
          "name": "--no-git",
          "type": "boolean",
          "description": "Skip git steps"
        },
        {
          "name": "--no-npm",
          "type": "boolean",
          "description": "Skip npm publish"
        },
        {
          "name": "--no-github",
          "type": "boolean",
          "description": "Skip GitHub release"
        },
        {
          "name": "--no-gitlab",
          "type": "boolean",
          "description": "Skip GitLab release"
        },
        {
          "name": "--increment",
          "type": "string",
          "description": "Version increment (major, minor, patch, premajor, preminor, prepatch, prerelease)"
        },
        {
          "name": "--preReleaseId",
          "type": "string",
          "description": "Pre-release identifier (e.g., beta, alpha, rc)"
        },
        {
          "name": "--npm.tag",
          "type": "string",
          "description": "npm dist-tag (e.g., next, latest)"
        },
        {
          "name": "--github.release",
          "type": "boolean",
          "description": "Create GitHub release"
        }
      ]
    },
    {
      "namespace": "release-it",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to release-it CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "release-it",
        "passthrough": true,
        "missingDependencyHelp": "Install release-it: npm install -g release-it"
      },
      "args": []
    }
  ]
}
