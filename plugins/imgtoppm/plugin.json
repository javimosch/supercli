{
  "name": "imgtoppm",
  "version": "0.1.0",
  "description": "CLI tool: imgtoppm",
  "source": "https://manpages.debian.org/imgtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "imgtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "imgtoppm",
    "binary": "imgtoppm",
    "check": "which imgtoppm",
    "install_steps": [
      "apt-get install imgtoppm 2>/dev/null || which imgtoppm",
      "Verify: imgtoppm --version",
      "supercli plugins install ./plugins/imgtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "imgtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print imgtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install imgtoppm: apt-get install imgtoppm 2>/dev/null || which imgtoppm"
      },
      "args": []
    },
    {
      "namespace": "imgtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to imgtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "imgtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install imgtoppm: apt-get install imgtoppm 2>/dev/null || which imgtoppm"
      },
      "args": []
    }
  ]
}