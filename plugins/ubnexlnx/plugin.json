{
  "name": "ubnexlnx",
  "version": "0.1.0",
  "description": "CLI tool: ubnexlnx",
  "source": "https://manpages.debian.org/ubnexlnx",
  "checks": [
    {
      "type": "binary",
      "name": "ubnexlnx"
    }
  ],
  "install_guidance": {
    "plugin": "ubnexlnx",
    "binary": "ubnexlnx",
    "check": "which ubnexlnx",
    "install_steps": [
      "apt-get install ubnexlnx 2>/dev/null || which ubnexlnx",
      "Verify: ubnexlnx --version",
      "supercli plugins install ./plugins/ubnexlnx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ubnexlnx",
      "resource": "self",
      "action": "version",
      "description": "Print ubnexlnx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ubnexlnx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ubnexlnx: apt-get install ubnexlnx 2>/dev/null || which ubnexlnx"
      },
      "args": []
    },
    {
      "namespace": "ubnexlnx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ubnexlnx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ubnexlnx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ubnexlnx: apt-get install ubnexlnx 2>/dev/null || which ubnexlnx"
      },
      "args": []
    }
  ]
}