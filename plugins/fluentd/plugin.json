{
  "name": "fluentd",
  "version": "1.0.0",
  "description": "fluentd \u2014 Log collector",
  "source": "fluentd.org",
  "checks": [
    {
      "type": "binary",
      "name": "fluentd"
    }
  ],
  "install_guidance": {
    "plugin": "fluentd",
    "binary": "fluentd",
    "check": "which fluentd",
    "install_steps": [
      "# Install fluentd",
      "# See fluentd.org",
      "# apt: sudo apt-get install fluentd",
      "# brew: brew install fluentd",
      "# cargo: cargo install fluentd",
      "# npm: npm install -g fluentd",
      "# pip: pip install fluentd"
    ]
  },
  "commands": [
    {
      "namespace": "fluentd",
      "resource": "fluentd",
      "action": "run",
      "description": "Run fluentd",
      "adapter": "process",
      "adapterConfig": {
        "command": "fluentd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fluentd from fluentd.org"
      },
      "args": []
    }
  ]
}