{
  "name": "wordgrinder",
  "version": "0.1.0",
  "description": "From the website: \"WordGrinder is a word processor for processing words. It is not WYSIWYG. It is not point and click. It is not a desktop publisher. It is not a text editor. It does not do fonts and it barely does styles. What it does do is words. It's designed for writing text. It gets out of your way and lets you type.\"",
  "source": "https://github.com/davidgiven/wordgrinder",
  "checks": [
    {
      "type": "binary",
      "name": "wordgrinder"
    }
  ],
  "install_guidance": {
    "plugin": "wordgrinder",
    "binary": "wordgrinder",
    "check": "which wordgrinder",
    "install_steps": [
      "brew install wordgrinder",
      "Verify: wordgrinder --version",
      "supercli plugins install ./plugins/wordgrinder --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "wordgrinder",
      "resource": "self",
      "action": "version",
      "description": "Print wordgrinder version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wordgrinder",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wordgrinder: brew install wordgrinder"
      },
      "args": []
    },
    {
      "namespace": "wordgrinder",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wordgrinder CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wordgrinder",
        "passthrough": true,
        "missingDependencyHelp": "Install wordgrinder"
      },
      "args": []
    }
  ]
}