  "commands": [{
    "namespace": "check_udp", "resource": "_", "action": "_",
    "description": "Passthrough to check_udp CLI",
    "adapter": "process", "adapterConfig": { "command": "check_udp", "passthrough": true, "missingDependencyHelp": "Install check_udp: apt-get install check_udp" }, "args": []
  }]
}
