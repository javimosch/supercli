{
  "name": "check_udp",
  "version": "0.1.0",
  "description": "CLI tool: check_udp",
  "source": "https://packages.debian.org/check_udp",
  "checks": [{ "type": "binary", "name": "check_udp" }],
  "install_guidance": {
    "plugin": "check_udp", "binary": "check_udp", "check": "which check_udp",
    "install_steps": ["apt-get install check_udp 2>/dev/null || which check_udp", "Verify: check_udp --version", "supercli plugins install ./plugins/check_udp --on-conflict replace --json"]
