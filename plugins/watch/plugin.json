{
  "name": "watch",
  "version": "0.1.0",
  "description": "Execute commands periodically and show output",
  "source": "https",
  "checks": [{"type": "binary", "name": "watch"}],
  "install_guidance": {
    "plugin": "watch",
    "binary": "watch",
    "check": "which watch",
    "install_steps": [
      "brew install watch",
      "Verify: watch --version",
      "supercli plugins install ./plugins/watch --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "watch",
      "resource": "self",
      "action": "version",
      "description": "Print watch version",
      "adapter": "process",
      "adapterConfig": {"command": "watch", "baseArgs": ["--version"], "missingDependencyHelp": "Install watch: brew install watch"},
      "args": []
    },
    {
      "namespace": "watch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to watch CLI",
      "adapter": "process",
      "adapterConfig": {"command": "watch", "passthrough": true, "missingDependencyHelp": "Install watch: brew install watch"},
      "args": []
    }
  ]
}
