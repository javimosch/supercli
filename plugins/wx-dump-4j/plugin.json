{
  "name": "wx-dump-4j",
  "version": "0.1.0",
  "description": "\u4e00\u6b3e\u57fa\u4e8eJava\u5f00\u53d1\u7684\u5fae\u4fe1\u6570\u636e\u5206\u6790\u5de5\u5177\u3002",
  "source": "https://github.com/wx-dump-4j/wx-dump-4j",
  "checks": [
    {
      "type": "binary",
      "name": "wx-dump-4j"
    }
  ],
  "install_guidance": {
    "plugin": "wx-dump-4j",
    "binary": "wx-dump-4j",
    "check": "which wx-dump-4j",
    "install_steps": [
      "pip install wx-dump-4j",
      "Verify: wx-dump-4j --version",
      "supercli plugins install ./plugins/wx-dump-4j --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wx-dump-4j",
      "resource": "self",
      "action": "version",
      "description": "Print wx-dump-4j version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wx-dump-4j",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wx-dump-4j: pip install wx-dump-4j"
      },
      "args": []
    },
    {
      "namespace": "wx-dump-4j",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wx-dump-4j CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wx-dump-4j",
        "passthrough": true,
        "missingDependencyHelp": "Install wx-dump-4j: pip install wx-dump-4j"
      },
      "args": []
    }
  ]
}