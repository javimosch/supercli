{
  "name": "red-cli",
  "version": "0.1.0",
  "description": "Simple community-driven Redis CLI alternative client",
  "source": "go",
  "checks": [{ "type": "binary", "name": "red-cli" }],
  "install_guidance": {
    "plugin": "red-cli",
    "binary": "red-cli",
    "check": "which red-cli",
    "install_steps": ["go install github.com/red-cli@latest", "Verify: red-cli --version", "supercli plugins install ./plugins/red-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "red-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to red-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "red-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install red-cli: go install github.com/red-cli@latest"
    },
    "args": []
  }]
}
