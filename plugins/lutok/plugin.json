{
  "name": "lutok",
  "version": "0.1.0",
  "description": "Lightweight C++ API for Lua",
  "source": "https://github.com/freebsd/lutok",
  "checks": [
    {
      "type": "binary",
      "name": "lutok"
    }
  ],
  "install_guidance": {
    "plugin": "lutok",
    "binary": "lutok",
    "check": "which lutok",
    "install_steps": [
      "brew install lutok",
      "Verify: lutok --version",
      "supercli plugins install ./plugins/lutok --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lutok",
      "resource": "self",
      "action": "version",
      "description": "Print lutok version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lutok",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lutok: brew install lutok"
      },
      "args": []
    },
    {
      "namespace": "lutok",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lutok CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lutok",
        "passthrough": true,
        "missingDependencyHelp": "Install lutok"
      },
      "args": []
    }
  ]
}