{
  "name": "at-cli",
  "version": "0.1.0",
  "description": "CLI tool: at-cli",
  "source": "https://packages.debian.org/at-cli",
  "checks": [{ "type": "binary", "name": "at-cli" }],
  "install_guidance": {
    "plugin": "at-cli", "binary": "at-cli", "check": "which at-cli",
    "install_steps": ["apt-get install at-cli 2>/dev/null || which at-cli", "Verify: at-cli --version", "supercli plugins install ./plugins/at-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-cli", "resource": "_", "action": "_",
    "description": "Passthrough to at-cli CLI",
    "adapter": "process", "adapterConfig": { "command": "at-cli", "passthrough": true, "missingDependencyHelp": "Install at-cli: apt-get install at-cli" }, "args": []
  }]
}
