{
  "name": "gamma4scanimage",
  "version": "0.1.0",
  "description": "CLI tool: gamma4scanimage",
  "source": "https://manpages.debian.org/gamma4scanimage",
  "checks": [
    {
      "type": "binary",
      "name": "gamma4scanimage"
    }
  ],
  "install_guidance": {
    "plugin": "gamma4scanimage",
    "binary": "gamma4scanimage",
    "check": "which gamma4scanimage",
    "install_steps": [
      "apt-get install gamma4scanimage 2>/dev/null || which gamma4scanimage",
      "Verify: gamma4scanimage --version",
      "supercli plugins install ./plugins/gamma4scanimage --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gamma4scanimage",
      "resource": "self",
      "action": "version",
      "description": "Print gamma4scanimage version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gamma4scanimage",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gamma4scanimage: apt-get install gamma4scanimage 2>/dev/null || which gamma4scanimage"
      },
      "args": []
    },
    {
      "namespace": "gamma4scanimage",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gamma4scanimage CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gamma4scanimage",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gamma4scanimage: apt-get install gamma4scanimage 2>/dev/null || which gamma4scanimage"
      },
      "args": []
    }
  ]
}