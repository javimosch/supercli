{
  "name": "TMSU",
  "version": "0.1.0",
  "description": "A simple tool for tagging files, providing a virtual filesystem for a tag-based view of your files from within any other program.",
  "source": "https://github.com/oniony/TMSU",
  "checks": [
    {
      "type": "binary",
      "name": "TMSU"
    }
  ],
  "install_guidance": {
    "plugin": "TMSU",
    "binary": "TMSU",
    "check": "which TMSU",
    "install_steps": [
      "See https://github.com/oniony/TMSU",
      "Verify: TMSU --version",
      "supercli plugins install ./plugins/TMSU --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "TMSU",
      "resource": "self",
      "action": "version",
      "description": "Print TMSU version",
      "adapter": "process",
      "adapterConfig": {
        "command": "TMSU",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TMSU: See https://github.com/oniony/TMSU"
      },
      "args": []
    },
    {
      "namespace": "TMSU",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to TMSU CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "TMSU",
        "passthrough": true,
        "missingDependencyHelp": "Install TMSU"
      },
      "args": []
    }
  ]
}