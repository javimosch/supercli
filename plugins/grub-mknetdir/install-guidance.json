{
  "plugin": "grub-mknetdir",
  "binary": "grub-mknetdir",
  "check": "which grub-mknetdir",
  "install_steps": [
    "apt-get install grub-mknetdir 2>/dev/null || which grub-mknetdir",
    "Verify: grub-mknetdir --version",
    "supercli plugins install ./plugins/grub-mknetdir --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}