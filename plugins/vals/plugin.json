{
  "name": "vals",
  "version": "0.1.0",
  "description": "Helm-like configuration values management with secret backends",
  "source": "https://github.com/helmfile/vals",
  "checks": [{ "type": "binary", "name": "vals" }],
  "install_guidance": {
    "plugin": "vals",
    "binary": "vals",
    "check": "which vals",
    "install_steps": ["brew install vals", "Verify: vals --version", "supercli plugins install ./plugins/vals --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vals",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vals CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vals",
      "passthrough": true,
      "missingDependencyHelp": "Install vals: brew install vals"
    },
    "args": []
  }]
}
