    "namespace": "depotdir4", "resource": "_", "action": "_",
    "description": "Passthrough to depotdir4 CLI",
    "adapter": "process", "adapterConfig": { "command": "depotdir4", "passthrough": true, "missingDependencyHelp": "Install depotdir4: apt-get install depotdir4" }, "args": []
  }]
}
