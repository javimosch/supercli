{
  "name": "depotdir4",
  "version": "0.1.0",
  "description": "CLI tool: depotdir4",
  "source": "https://packages.debian.org/depotdir4",
  "checks": [{ "type": "binary", "name": "depotdir4" }],
  "install_guidance": {
    "plugin": "depotdir4", "binary": "depotdir4", "check": "which depotdir4",
    "install_steps": ["apt-get install depotdir4 2>/dev/null || which depotdir4", "Verify: depotdir4 --version", "supercli plugins install ./plugins/depotdir4 --on-conflict replace --json"]
