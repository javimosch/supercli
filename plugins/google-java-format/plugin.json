{
  "name": "google-java-format",
  "version": "0.1.0",
  "description": "Reformats Java source code to comply with Google Java Style",
  "source": "https://github.com/google/google-java-format",
  "checks": [
    {
      "type": "binary",
      "name": "google-java-format"
    }
  ],
  "install_guidance": {
    "plugin": "google-java-format",
    "binary": "google-java-format",
    "check": "which google-java-format",
    "install_steps": [
      "brew install google-java-format",
      "Verify: google-java-format --version",
      "supercli plugins install ./plugins/google-java-format --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "google-java-format",
      "resource": "self",
      "action": "version",
      "description": "Print google-java-format version",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-java-format",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install google-java-format: brew install google-java-format"
      },
      "args": []
    },
    {
      "namespace": "google-java-format",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to google-java-format CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "google-java-format",
        "passthrough": true,
        "missingDependencyHelp": "Install google-java-format"
      },
      "args": []
    }
  ]
}