{
  "name": "xls-convert",
  "version": "0.1.0",
  "description": "Convert Excel and spreadsheet files between formats",
  "source": "https://github.com/johndoe/xls-convert",
  "checks": [{ "type": "binary", "name": "xls-convert" }],
  "install_guidance": {
    "plugin": "xls-convert",
    "binary": "xls-convert",
    "check": "which xls-convert",
    "install_steps": ["pip install xls-convert", "Verify: xls-convert --version", "supercli plugins install ./plugins/xls-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "xls-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to xls-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "xls-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install xls-convert: pip install xls-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
