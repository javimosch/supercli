{
  "name": "cpp-8",
  "version": "0.1.0",
  "description": "CLI tool: cpp-8",
  "source": "https://packages.debian.org/cpp-8",
  "checks": [{ "type": "binary", "name": "cpp-8" }],
  "install_guidance": {
    "plugin": "cpp-8", "binary": "cpp-8", "check": "which cpp-8",
    "install_steps": ["apt-get install cpp-8 2>/dev/null || which cpp-8", "Verify: cpp-8 --version", "supercli plugins install ./plugins/cpp-8 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpp-8", "resource": "_", "action": "_",
    "description": "Passthrough to cpp-8 CLI",
    "adapter": "process", "adapterConfig": { "command": "cpp-8", "passthrough": true, "missingDependencyHelp": "Install cpp-8: apt-get install cpp-8" }, "args": []
  }]
}
