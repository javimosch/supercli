{
  "name": "Directory-Client",
  "version": "0.1.0",
  "description": "CLI tool: Directory-Client",
  "source": "https://kappa-phi.com",
  "checks": [
    {
      "type": "binary",
      "name": "Directory-Client"
    }
  ],
  "install_guidance": {
    "plugin": "Directory-Client",
    "binary": "Directory-Client",
    "check": "which Directory-Client",
    "install_steps": [
      "Check https://kappa-phi.com for installation instructions",
      "Verify: Directory-Client --version",
      "supercli plugins install ./plugins/Directory-Client --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "Directory-Client",
      "resource": "self",
      "action": "version",
      "description": "Print Directory-Client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Directory-Client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Directory-Client from project repository"
      },
      "args": []
    },
    {
      "namespace": "Directory-Client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Directory-Client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Directory-Client",
        "passthrough": true,
        "missingDependencyHelp": "Install Directory-Client from project repository"
      },
      "args": []
    }
  ]
}