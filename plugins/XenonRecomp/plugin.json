{
  "name": "XenonRecomp",
  "version": "0.1.0",
  "description": "A tool for recompiling Xbox 360 games to native executables.",
  "source": "https://github.com/XenonRecomp/XenonRecomp",
  "checks": [
    {
      "type": "binary",
      "name": "xenonrecomp"
    }
  ],
  "install_guidance": {
    "plugin": "XenonRecomp",
    "binary": "xenonrecomp",
    "check": "which xenonrecomp",
    "install_steps": [
      "pip install xenonrecomp",
      "Verify: xenonrecomp --version",
      "supercli plugins install ./plugins/XenonRecomp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "XenonRecomp",
      "resource": "self",
      "action": "version",
      "description": "Print XenonRecomp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xenonrecomp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install XenonRecomp: pip install xenonrecomp"
      },
      "args": []
    },
    {
      "namespace": "XenonRecomp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xenonrecomp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xenonrecomp",
        "passthrough": true,
        "missingDependencyHelp": "Install XenonRecomp: pip install xenonrecomp"
      },
      "args": []
    }
  ]
}