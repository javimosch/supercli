{
  "name": "termfu",
  "version": "0.1.0",
  "description": "A multi-language debugger frontend that allows users to create and switch between custom layouts.",
  "source": "https://github.com/jvalcher/termfu",
  "checks": [
    {
      "type": "binary",
      "name": "termfu"
    }
  ],
  "install_guidance": {
    "plugin": "termfu",
    "binary": "termfu",
    "check": "which termfu",
    "install_steps": [
      "See https://github.com/jvalcher/termfu",
      "Verify: termfu --version",
      "supercli plugins install ./plugins/termfu --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "termfu",
      "resource": "self",
      "action": "version",
      "description": "Print termfu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "termfu",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install termfu: See https://github.com/jvalcher/termfu"
      },
      "args": []
    },
    {
      "namespace": "termfu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to termfu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "termfu",
        "passthrough": true,
        "missingDependencyHelp": "Install termfu"
      },
      "args": []
    }
  ]
}