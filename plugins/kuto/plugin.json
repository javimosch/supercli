{
  "name": "kuto",
  "version": "0.1.0",
  "description": "Reverse JS bundler",
  "source": "https://github.com/samthor/kuto",
  "checks": [
    {
      "type": "binary",
      "name": "kuto"
    }
  ],
  "install_guidance": {
    "plugin": "kuto",
    "binary": "kuto",
    "check": "which kuto",
    "install_steps": [
      "brew install kuto",
      "Verify: kuto --version",
      "supercli plugins install ./plugins/kuto --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kuto",
      "resource": "self",
      "action": "version",
      "description": "Print kuto version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuto",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kuto: brew install kuto"
      },
      "args": []
    },
    {
      "namespace": "kuto",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kuto CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuto",
        "passthrough": true,
        "missingDependencyHelp": "Install kuto"
      },
      "args": []
    }
  ]
}