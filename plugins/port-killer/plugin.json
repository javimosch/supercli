{
  "name": "port-killer",
  "version": "0.1.0",
  "description": "A powerful cross-platform port management tool for developers. Monitor ports, manage Kubernetes port",
  "source": "https://github.com/port-killer/port-killer",
  "checks": [
    {
      "type": "binary",
      "name": "port-killer"
    }
  ],
  "install_guidance": {
    "plugin": "port-killer",
    "binary": "port-killer",
    "check": "which port-killer",
    "install_steps": [
      "pip install port-killer",
      "Verify: port-killer --version",
      "supercli plugins install ./plugins/port-killer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "port-killer",
      "resource": "self",
      "action": "version",
      "description": "Print port-killer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "port-killer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install port-killer: pip install port-killer"
      },
      "args": []
    },
    {
      "namespace": "port-killer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to port-killer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "port-killer",
        "passthrough": true,
        "missingDependencyHelp": "Install port-killer: pip install port-killer"
      },
      "args": []
    }
  ]
}