{
  "name": "spice",
  "version": "0.1.0",
  "description": "Fine-grained parallelism with sub-nanosecond overhead in Zig",
  "source": "https://github.com/spice/spice",
  "checks": [
    {
      "type": "binary",
      "name": "spice"
    }
  ],
  "install_guidance": {
    "plugin": "spice",
    "binary": "spice",
    "check": "which spice",
    "install_steps": [
      "pip install spice",
      "Verify: spice --version",
      "supercli plugins install ./plugins/spice --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "spice",
      "resource": "self",
      "action": "version",
      "description": "Print spice version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spice",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spice: pip install spice"
      },
      "args": []
    },
    {
      "namespace": "spice",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spice CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spice",
        "passthrough": true,
        "missingDependencyHelp": "Install spice: pip install spice"
      },
      "args": []
    }
  ]
}