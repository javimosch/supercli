{
  "name": "CLI-Manager",
  "version": "0.1.0",
  "description": "Command Line Interface for managing tasks locally on the fly.",
  "source": "https://github.com/MikyStar/CLI-Manager",
  "checks": [
    {
      "type": "binary",
      "name": "CLI-Manager"
    }
  ],
  "install_guidance": {
    "plugin": "CLI-Manager",
    "binary": "CLI-Manager",
    "check": "which CLI-Manager",
    "install_steps": [
      "See https://github.com/MikyStar/CLI-Manager",
      "Verify: CLI-Manager --version",
      "supercli plugins install ./plugins/CLI-Manager --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "CLI-Manager",
      "resource": "self",
      "action": "version",
      "description": "Print CLI-Manager version",
      "adapter": "process",
      "adapterConfig": {
        "command": "CLI-Manager",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CLI-Manager: See https://github.com/MikyStar/CLI-Manager"
      },
      "args": []
    },
    {
      "namespace": "CLI-Manager",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to CLI-Manager CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "CLI-Manager",
        "passthrough": true,
        "missingDependencyHelp": "Install CLI-Manager"
      },
      "args": []
    }
  ]
}