{
  "name": "updates",
  "version": "0.1.0",
  "description": "Flexible npm dependency update tool",
  "source": "https://github.com/silverwind/updates",
  "checks": [
    {
      "type": "binary",
      "name": "updates"
    }
  ],
  "install_guidance": {
    "plugin": "updates",
    "binary": "updates",
    "check": "which updates",
    "install_steps": [
      "See https://github.com/silverwind/updates",
      "Verify: updates --version",
      "supercli plugins install ./plugins/updates --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "updates",
      "resource": "self",
      "action": "version",
      "description": "Print updates version",
      "adapter": "process",
      "adapterConfig": {
        "command": "updates",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install updates: See https://github.com/silverwind/updates"
      },
      "args": []
    },
    {
      "namespace": "updates",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to updates CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "updates",
        "passthrough": true,
        "missingDependencyHelp": "Install updates"
      },
      "args": []
    }
  ]
}