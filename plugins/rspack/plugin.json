{
  "name": "rspack",
  "version": "0.1.0",
  "description": "Fast Rust-based web bundler compatible with webpack",
  "source": "https://github.com/web-infra-dev/rspack",
  "checks": [{ "type": "binary", "name": "rspack" }],
  "install_guidance": {
    "plugin": "rspack",
    "binary": "rspack",
    "check": "which rspack",
    "install_steps": ["npm install -g @rspack/cli", "Verify: rspack --version", "supercli plugins install ./plugins/rspack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rspack",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rspack CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rspack",
      "passthrough": true,
      "missingDependencyHelp": "Install rspack: npm install -g @rspack/cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
