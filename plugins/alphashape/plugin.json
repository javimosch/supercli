{
  "name": "alphashape",
  "version": "0.1.0",
  "description": "CLI tool: alphashape",
  "source": "https://packages.debian.org/alphashape",
  "checks": [{ "type": "binary", "name": "alphashape" }],
  "install_guidance": {
    "plugin": "alphashape", "binary": "alphashape", "check": "which alphashape",
    "install_steps": ["apt-get install alphashape 2>/dev/null || which alphashape", "Verify: alphashape --version", "supercli plugins install ./plugins/alphashape --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "alphashape", "resource": "_", "action": "_",
    "description": "Passthrough to alphashape CLI",
    "adapter": "process", "adapterConfig": { "command": "alphashape", "passthrough": true, "missingDependencyHelp": "Install alphashape: apt-get install alphashape" }, "args": []
  }]
}
