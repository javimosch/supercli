{
  "name": "bogofilter",
  "version": "0.1.0",
  "description": "CLI tool: bogofilter",
  "source": "https://packages.debian.org/bogofilter",
  "checks": [{ "type": "binary", "name": "bogofilter" }],
  "install_guidance": {
    "plugin": "bogofilter", "binary": "bogofilter", "check": "which bogofilter",
    "install_steps": ["apt-get install bogofilter 2>/dev/null || which bogofilter", "Verify: bogofilter --version", "supercli plugins install ./plugins/bogofilter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bogofilter", "resource": "_", "action": "_",
    "description": "Passthrough to bogofilter CLI",
    "adapter": "process", "adapterConfig": { "command": "bogofilter", "passthrough": true, "missingDependencyHelp": "Install bogofilter: apt-get install bogofilter" }, "args": []
  }]
}
