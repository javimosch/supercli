{
  "name": "pdfx",
  "version": "0.1.0",
  "description": "React PDF component library with pre-built components and CLI for PDF creation",
  "source": "https://github.com/akii09/pdfx",
  "checks": [
    {
      "type": "binary",
      "name": "pdfx"
    }
  ],
  "install_guidance": {
    "plugin": "pdfx",
    "binary": "pdfx",
    "check": "which pdfx",
    "install_steps": [
      "npm install -g pdfx",
      "Verify: pdfx --version",
      "supercli plugins install ./plugins/pdfx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "pdfx",
    "resource": "self",
    "action": "version",
    "description": "Print pdfx version",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdfx",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install pdfx: npm install -g pdfx"
    },
    "args": []
  },
  {
    "namespace": "pdfx",
    "resource": "pdf",
    "action": "create",
    "description": "Create a PDF document",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdfx",
      "baseArgs": [
        "create"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install pdfx: npm install -g pdfx"
    },
    "args": []
  },
  {
    "namespace": "pdfx",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdfx CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdfx",
      "passthrough": true,
      "missingDependencyHelp": "Install pdfx"
    },
    "args": []
  }
]
}