{
  "name": "xerox",
  "version": "0.1.0",
  "description": "CLI tool: xerox",
  "source": "https://manpages.debian.org/xerox",
  "checks": [
    {
      "type": "binary",
      "name": "xerox"
    }
  ],
  "install_guidance": {
    "plugin": "xerox",
    "binary": "xerox",
    "check": "which xerox",
    "install_steps": [
      "apt-get install xerox 2>/dev/null || which xerox",
      "Verify: xerox --version",
      "supercli plugins install ./plugins/xerox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xerox",
      "resource": "self",
      "action": "version",
      "description": "Print xerox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xerox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xerox: apt-get install xerox 2>/dev/null || which xerox"
      },
      "args": []
    },
    {
      "namespace": "xerox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xerox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xerox",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xerox: apt-get install xerox 2>/dev/null || which xerox"
      },
      "args": []
    }
  ]
}