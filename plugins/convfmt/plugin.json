{
  "name": "convfmt",
  "version": "0.1.0",
  "description": "Format converter CLI for JSON, YAML, TOML, and other data formats",
  "source": "https://github.com/void-rilla/convfmt",
  "checks": [
    {
      "type": "binary",
      "name": "convfmt"
    }
  ],
  "install_guidance": {
    "plugin": "convfmt",
    "binary": "convfmt",
    "check": "which convfmt",
    "install_steps": [
      "cargo install convfmt",
      "Verify: convfmt --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "convfmt",
      "resource": "self",
      "action": "version",
      "description": "Print convfmt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "convfmt",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install convfmt: cargo install convfmt"
      },
      "args": []
    },
    {
      "namespace": "convfmt",
      "resource": "file",
      "action": "convert",
      "description": "Convert data files between JSON, YAML, TOML, and other formats",
      "adapter": "process",
      "adapterConfig": {
        "command": "convfmt",
        "baseArgs": ["--cwd", "invoke_cwd"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install convfmt: cargo install convfmt"
      },
      "args": []
    },
    {
      "namespace": "convfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to convfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "convfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install convfmt: cargo install convfmt"
      },
      "args": []
    }
  ]
}