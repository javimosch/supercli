{
  "plugin": "gnome-shell-extension-tool",
  "binary": "gnome-shell-extension-tool",
  "check": "which gnome-shell-extension-tool",
  "install_steps": [
    "apt-get install gnome-shell-extension-tool 2>/dev/null || which gnome-shell-extension-tool",
    "Verify: gnome-shell-extension-tool --version",
    "supercli plugins install ./plugins/gnome-shell-extension-tool --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}