{
  "name": "kill-proc",
  "version": "0.1.0",
  "description": "Advanced process filtering and selective termination",
  "source": "https://github.com/kill-proc/kill-proc",
  "checks": [{ "type": "binary", "name": "kill-proc" }],
  "install_guidance": {
    "plugin": "kill-proc",
    "binary": "kill-proc",
    "check": "which kill-proc",
    "install_steps": ["brew install kill-proc", "Verify: kill-proc --version", "supercli plugins install ./plugins/kill-proc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kill-proc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kill-proc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kill-proc",
      "passthrough": true,
      "missingDependencyHelp": "Install kill-proc: brew install kill-proc", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
