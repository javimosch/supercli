{
  "name": "python3-pasteurize",
  "version": "0.1.0",
  "description": "Tool to convert Python 3 code to Python 2/3 compatible code",
  "source": "https://manpages.debian.org/python3-pasteurize",
  "checks": [{ "type": "binary", "name": "python3-pasteurize" }],
  "install_guidance": {
    "plugin": "python3-pasteurize",
    "binary": "python3-pasteurize",
    "check": "which python3-pasteurize",
    "install_steps": [
      "pip install future",
      "Verify: python3-pasteurize --version",
      "supercli plugins install ./plugins/python3-pasteurize --on-conflict replace --json"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [{
    "namespace": "python3-pasteurize",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to python3-pasteurize CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "python3-pasteurize",
      "passthrough": true,
      "missingDependencyHelp": "Install python3-pasteurize: pip install future"
    },
    "args": []
  }]
}
