{
  "name": "abrtd",
  "version": "0.1.0",
  "description": "CLI tool: abrtd",
  "source": "https://packages.debian.org/abrtd",
  "checks": [{ "type": "binary", "name": "abrtd" }],
  "install_guidance": {
    "plugin": "abrtd", "binary": "abrtd", "check": "which abrtd",
    "install_steps": ["apt-get install abrtd 2>/dev/null || which abrtd", "Verify: abrtd --version", "supercli plugins install ./plugins/abrtd --on-conflict replace --json"]
