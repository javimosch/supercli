  "commands": [{
    "namespace": "abrtd", "resource": "_", "action": "_",
    "description": "Passthrough to abrtd CLI",
    "adapter": "process", "adapterConfig": { "command": "abrtd", "passthrough": true, "missingDependencyHelp": "Install abrtd: apt-get install abrtd" }, "args": []
  }]
}
