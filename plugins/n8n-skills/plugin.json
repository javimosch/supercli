{
  "name": "n8n-skills",
  "version": "0.1.0",
  "description": "n8n skillset for Claude Code to build flawless n8n workflows",
  "source": "https://github.com/n8n-skills/n8n-skills",
  "checks": [
    {
      "type": "binary",
      "name": "n8n-skills"
    }
  ],
  "install_guidance": {
    "plugin": "n8n-skills",
    "binary": "n8n-skills",
    "check": "which n8n-skills",
    "install_steps": [
      "pip install n8n-skills",
      "Verify: n8n-skills --version",
      "supercli plugins install ./plugins/n8n-skills --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "n8n-skills",
      "resource": "self",
      "action": "version",
      "description": "Print n8n-skills version",
      "adapter": "process",
      "adapterConfig": {
        "command": "n8n-skills",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install n8n-skills: pip install n8n-skills"
      },
      "args": []
    },
    {
      "namespace": "n8n-skills",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to n8n-skills CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "n8n-skills",
        "passthrough": true,
        "missingDependencyHelp": "Install n8n-skills: pip install n8n-skills"
      },
      "args": []
    }
  ]
}