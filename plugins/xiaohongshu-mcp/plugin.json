{
  "name": "xiaohongshu-mcp",
  "version": "0.1.0",
  "description": "MCP for xiaohongshu.com",
  "source": "https://github.com/xiaohongshu-mcp/xiaohongshu-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "xiaohongshu-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "xiaohongshu-mcp",
    "binary": "xiaohongshu-mcp",
    "check": "which xiaohongshu-mcp",
    "install_steps": [
      "pip install xiaohongshu-mcp",
      "Verify: xiaohongshu-mcp --version",
      "supercli plugins install ./plugins/xiaohongshu-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xiaohongshu-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print xiaohongshu-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaohongshu-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xiaohongshu-mcp: pip install xiaohongshu-mcp"
      },
      "args": []
    },
    {
      "namespace": "xiaohongshu-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xiaohongshu-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xiaohongshu-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install xiaohongshu-mcp: pip install xiaohongshu-mcp"
      },
      "args": []
    }
  ]
}