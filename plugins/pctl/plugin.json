{
  "name": "pctl",
  "version": "0.1.0",
  "description": "Profile CLI tool for managing Kubernetes cluster profiles",
  "source": "https://github.com/weaveworks/pctl",
  "checks": [{ "type": "binary", "name": "pctl" }],
  "install_guidance": {
    "plugin": "pctl",
    "binary": "pctl",
    "check": "which pctl",
    "install_steps": ["brew install pctl", "Verify: pctl --version", "supercli plugins install ./plugins/pctl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pctl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pctl",
      "passthrough": true,
      "missingDependencyHelp": "Install pctl: brew install pctl"
    },
    "args": []
  }]
}
