{
  "name": "start-pulseaudio-x11",
  "version": "0.1.0",
  "description": "CLI tool: start-pulseaudio-x11",
  "source": "https://manpages.debian.org/start-pulseaudio-x11",
  "checks": [
    {
      "type": "binary",
      "name": "start-pulseaudio-x11"
    }
  ],
  "install_guidance": {
    "plugin": "start-pulseaudio-x11",
    "binary": "start-pulseaudio-x11",
    "check": "which start-pulseaudio-x11",
    "install_steps": [
      "apt-get install start-pulseaudio-x11 2>/dev/null || which start-pulseaudio-x11",
      "Verify: start-pulseaudio-x11 --version",
      "supercli plugins install ./plugins/start-pulseaudio-x11 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "start-pulseaudio-x11",
      "resource": "self",
      "action": "version",
      "description": "Print start-pulseaudio-x11 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "start-pulseaudio-x11",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install start-pulseaudio-x11: apt-get install start-pulseaudio-x11 2>/dev/null || which start-pulseaudio-x11"
      },
      "args": []
    },
    {
      "namespace": "start-pulseaudio-x11",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to start-pulseaudio-x11 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "start-pulseaudio-x11",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install start-pulseaudio-x11: apt-get install start-pulseaudio-x11 2>/dev/null || which start-pulseaudio-x11"
      },
      "args": []
    }
  ]
}