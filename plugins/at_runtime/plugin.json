{
  "name": "at_runtime",
  "version": "0.1.0",
  "description": "CLI tool: at_runtime",
  "source": "https://packages.debian.org/at_runtime",
  "checks": [{ "type": "binary", "name": "at_runtime" }],
  "install_guidance": {
    "plugin": "at_runtime", "binary": "at_runtime", "check": "which at_runtime",
    "install_steps": ["apt-get install at_runtime 2>/dev/null || which at_runtime", "Verify: at_runtime --version", "supercli plugins install ./plugins/at_runtime --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_runtime", "resource": "_", "action": "_",
    "description": "Passthrough to at_runtime CLI",
    "adapter": "process", "adapterConfig": { "command": "at_runtime", "passthrough": true, "missingDependencyHelp": "Install at_runtime: apt-get install at_runtime" }, "args": []
  }]
}
