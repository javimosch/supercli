{
  "name": "fzf-make",
  "version": "0.1.0",
  "description": "Fuzzy finder with preview window for various command runners including make",
  "source": "https://github.com/kyu08/fzf-make",
  "checks": [
    {
      "type": "binary",
      "name": "fzf-make"
    }
  ],
  "install_guidance": {
    "plugin": "fzf-make",
    "binary": "fzf-make",
    "check": "which fzf-make",
    "install_steps": [
      "brew install fzf-make",
      "Verify: fzf-make --version",
      "supercli plugins install ./plugins/fzf-make --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fzf-make",
      "resource": "self",
      "action": "version",
      "description": "Print fzf-make version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzf-make",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fzf-make: brew install fzf-make"
      },
      "args": []
    },
    {
      "namespace": "fzf-make",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fzf-make CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fzf-make",
        "passthrough": true,
        "missingDependencyHelp": "Install fzf-make"
      },
      "args": []
    }
  ]
}