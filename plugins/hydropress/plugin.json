{
  "name": "hydropress",
  "version": "0.1.0",
  "description": "A fast, lightweight file compression CLI tool using Huffman coding",
  "source": "https://github.com/hydropress/hydropress",
  "checks": [
    {
      "type": "binary",
      "name": "hydropress"
    }
  ],
  "install_guidance": {
    "plugin": "hydropress",
    "binary": "hydropress",
    "check": "which hydropress",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: hydropress --version",
      "supercli plugins install ./plugins/hydropress --on-conflict replace --json"
    ],
    "note": "Rust language CLI tool"
  },
  "commands": [
    {
      "namespace": "hydropress",
      "resource": "self",
      "action": "version",
      "description": "Print hydropress version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hydropress",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hydropress from project repository"
      },
      "args": []
    },
    {
      "namespace": "hydropress",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hydropress CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hydropress",
        "passthrough": true,
        "missingDependencyHelp": "Install hydropress from project repository"
      },
      "args": []
    }
  ]
}