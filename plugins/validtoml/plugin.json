{
  "name": "validtoml",
  "version": "0.1.0",
  "description": "Simple CLI validator for TOML configuration files",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "validtoml" }],
  "install_guidance": {
    "plugin": "validtoml",
    "binary": "validtoml",
    "check": "which validtoml",
    "install_steps": ["pip install validtoml", "Verify: validtoml --version", "supercli plugins install ./plugins/validtoml --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "validtoml",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to validtoml CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "validtoml",
      "passthrough": true,
      "missingDependencyHelp": "Install validtoml: pip install validtoml"
    },
    "args": []
  }]
}
