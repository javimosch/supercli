{
  "name": "NextChat",
  "version": "0.1.0",
  "description": "\u2728 Light and Fast AI Assistant. Support: Web | iOS | MacOS | Android |  Linux | Windows",
  "source": "https://github.com/NextChat/NextChat",
  "checks": [
    {
      "type": "binary",
      "name": "nextchat"
    }
  ],
  "install_guidance": {
    "plugin": "NextChat",
    "binary": "nextchat",
    "check": "which nextchat",
    "install_steps": [
      "pip install nextchat",
      "Verify: nextchat --version",
      "supercli plugins install ./plugins/NextChat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NextChat",
      "resource": "self",
      "action": "version",
      "description": "Print NextChat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nextchat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NextChat: pip install nextchat"
      },
      "args": []
    },
    {
      "namespace": "NextChat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nextchat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nextchat",
        "passthrough": true,
        "missingDependencyHelp": "Install NextChat: pip install nextchat"
      },
      "args": []
    }
  ]
}