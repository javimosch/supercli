{
  "name": "ppdhtml",
  "version": "0.1.0",
  "description": "CLI tool: ppdhtml",
  "source": "https://manpages.debian.org/ppdhtml",
  "checks": [
    {
      "type": "binary",
      "name": "ppdhtml"
    }
  ],
  "install_guidance": {
    "plugin": "ppdhtml",
    "binary": "ppdhtml",
    "check": "which ppdhtml",
    "install_steps": [
      "apt-get install ppdhtml 2>/dev/null || which ppdhtml",
      "Verify: ppdhtml --version",
      "supercli plugins install ./plugins/ppdhtml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppdhtml",
      "resource": "self",
      "action": "version",
      "description": "Print ppdhtml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppdhtml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppdhtml: apt-get install ppdhtml 2>/dev/null || which ppdhtml"
      },
      "args": []
    },
    {
      "namespace": "ppdhtml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppdhtml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppdhtml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppdhtml: apt-get install ppdhtml 2>/dev/null || which ppdhtml"
      },
      "args": []
    }
  ]
}