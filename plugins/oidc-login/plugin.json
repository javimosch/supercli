{
  "name": "oidc-login",
  "version": "0.1.0",
  "description": "OpenID Connect login plugin for kubectl",
  "source": "https://github.com/int128/kubelogin",
  "checks": [{ "type": "binary", "name": "oidc-login" }],
  "install_guidance": {
    "plugin": "oidc-login",
    "binary": "oidc-login",
    "check": "which oidc-login",
    "install_steps": ["brew install oidc-login", "Verify: oidc-login --version", "supercli plugins install ./plugins/oidc-login --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "oidc-login",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to oidc-login CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "oidc-login",
      "passthrough": true,
      "missingDependencyHelp": "Install oidc-login: brew install oidc-login"
    },
    "args": []
  }]
}
