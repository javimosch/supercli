{
  "name": "fizz",
  "version": "0.1.0",
  "description": "C++14 implementation of the TLS-1.3 standard",
  "source": "https://github.com/facebookincubator/fizz",
  "checks": [
    {
      "type": "binary",
      "name": "fizz"
    }
  ],
  "install_guidance": {
    "plugin": "fizz",
    "binary": "fizz",
    "check": "which fizz",
    "install_steps": [
      "brew install fizz",
      "Verify: fizz --version",
      "supercli plugins install ./plugins/fizz --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fizz",
      "resource": "self",
      "action": "version",
      "description": "Print fizz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fizz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fizz: brew install fizz"
      },
      "args": []
    },
    {
      "namespace": "fizz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fizz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fizz",
        "passthrough": true,
        "missingDependencyHelp": "Install fizz"
      },
      "args": []
    }
  ]
}