{
  "name": "dee-trends",
  "version": "0.1.0",
  "description": "Look up Google Trends data from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-trends" }],
  "install_guidance": {
    "plugin": "dee-trends",
    "binary": "dee-trends",
    "check": "which dee-trends",
    "install_steps": ["cargo install dee-trends", "Verify: dee-trends --version", "supercli plugins install ./plugins/dee-trends --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-trends",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-trends CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-trends",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-trends: cargo install dee-trends"
    },
    "args": []
  }]
}
