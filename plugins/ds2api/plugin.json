{
  "name": "ds2api",
  "version": "0.1.0",
  "description": "DeepSeek-Compatible Middleware Interface: A technical exploration project in Go, focusing on high-co",
  "source": "https://github.com/ds2api/ds2api",
  "checks": [
    {
      "type": "binary",
      "name": "ds2api"
    }
  ],
  "install_guidance": {
    "plugin": "ds2api",
    "binary": "ds2api",
    "check": "which ds2api",
    "install_steps": [
      "pip install ds2api",
      "Verify: ds2api --version",
      "supercli plugins install ./plugins/ds2api --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ds2api",
      "resource": "self",
      "action": "version",
      "description": "Print ds2api version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ds2api",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ds2api: pip install ds2api"
      },
      "args": []
    },
    {
      "namespace": "ds2api",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ds2api CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ds2api",
        "passthrough": true,
        "missingDependencyHelp": "Install ds2api: pip install ds2api"
      },
      "args": []
    }
  ]
}