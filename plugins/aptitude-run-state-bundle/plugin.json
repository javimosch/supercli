{
  "name": "aptitude-run-state-bundle",
  "version": "0.1.0",
  "description": "CLI tool: aptitude-run-state-bundle",
  "source": "https://packages.debian.org/aptitude-run-state-bundle",
  "checks": [{ "type": "binary", "name": "aptitude-run-state-bundle" }],
  "install_guidance": {
    "plugin": "aptitude-run-state-bundle", "binary": "aptitude-run-state-bundle", "check": "which aptitude-run-state-bundle",
    "install_steps": ["apt-get install aptitude-run-state-bundle 2>/dev/null || which aptitude-run-state-bundle", "Verify: aptitude-run-state-bundle --version", "supercli plugins install ./plugins/aptitude-run-state-bundle --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aptitude-run-state-bundle", "resource": "_", "action": "_",
    "description": "Passthrough to aptitude-run-state-bundle CLI",
    "adapter": "process", "adapterConfig": { "command": "aptitude-run-state-bundle", "passthrough": true, "missingDependencyHelp": "Install aptitude-run-state-bundle: apt-get install aptitude-run-state-bundle" }, "args": []
  }]
}
