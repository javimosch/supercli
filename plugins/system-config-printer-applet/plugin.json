{
  "name": "system-config-printer-applet",
  "version": "0.1.0",
  "description": "CLI tool: system-config-printer-applet",
  "source": "https://manpages.debian.org/system-config-printer-applet",
  "checks": [
    {
      "type": "binary",
      "name": "system-config-printer-applet"
    }
  ],
  "install_guidance": {
    "plugin": "system-config-printer-applet",
    "binary": "system-config-printer-applet",
    "check": "which system-config-printer-applet",
    "install_steps": [
      "apt-get install system-config-printer-applet 2>/dev/null || which system-config-printer-applet",
      "Verify: system-config-printer-applet --version",
      "supercli plugins install ./plugins/system-config-printer-applet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "system-config-printer-applet",
      "resource": "self",
      "action": "version",
      "description": "Print system-config-printer-applet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "system-config-printer-applet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install system-config-printer-applet: apt-get install system-config-printer-applet 2>/dev/null || which system-config-printer-applet"
      },
      "args": []
    },
    {
      "namespace": "system-config-printer-applet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to system-config-printer-applet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "system-config-printer-applet",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install system-config-printer-applet: apt-get install system-config-printer-applet 2>/dev/null || which system-config-printer-applet"
      },
      "args": []
    }
  ]
}