{
  "name": "dnsgen",
  "version": "1.0.0",
  "description": "dnsgen \u2014 DNS wordlist generator",
  "source": "github.com/ProjectAnte/dnsgen",
  "checks": [
    {
      "type": "binary",
      "name": "dnsgen"
    }
  ],
  "install_guidance": {
    "plugin": "dnsgen",
    "binary": "dnsgen",
    "check": "which dnsgen",
    "install_steps": [
      "# Install dnsgen",
      "# See github.com/ProjectAnte/dnsgen",
      "# apt: sudo apt-get install dnsgen",
      "# brew: brew install dnsgen",
      "# cargo: cargo install dnsgen",
      "# npm: npm install -g dnsgen",
      "# pip: pip install dnsgen"
    ]
  },
  "commands": [
    {
      "namespace": "dnsgen",
      "resource": "dnsgen",
      "action": "run",
      "description": "Run dnsgen",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnsgen",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dnsgen from github.com/ProjectAnte/dnsgen"
      },
      "args": []
    }
  ]
}