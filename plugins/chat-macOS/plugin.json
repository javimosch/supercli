{
  "name": "chat-macOS",
  "version": "0.1.0",
  "description": "Making the community's best AI chat models available to everyone.",
  "source": "https://github.com/chat-macOS/chat-macOS",
  "checks": [
    {
      "type": "binary",
      "name": "chat-macos"
    }
  ],
  "install_guidance": {
    "plugin": "chat-macOS",
    "binary": "chat-macos",
    "check": "which chat-macos",
    "install_steps": [
      "pip install chat-macos",
      "Verify: chat-macos --version",
      "supercli plugins install ./plugins/chat-macOS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "chat-macOS",
      "resource": "self",
      "action": "version",
      "description": "Print chat-macOS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chat-macos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chat-macOS: pip install chat-macos"
      },
      "args": []
    },
    {
      "namespace": "chat-macOS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chat-macos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chat-macos",
        "passthrough": true,
        "missingDependencyHelp": "Install chat-macOS: pip install chat-macos"
      },
      "args": []
    }
  ]
}