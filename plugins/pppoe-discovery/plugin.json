{
  "name": "pppoe-discovery",
  "version": "0.1.0",
  "description": "CLI tool: pppoe-discovery",
  "source": "https://manpages.debian.org/pppoe-discovery",
  "checks": [
    {
      "type": "binary",
      "name": "pppoe-discovery"
    }
  ],
  "install_guidance": {
    "plugin": "pppoe-discovery",
    "binary": "pppoe-discovery",
    "check": "which pppoe-discovery",
    "install_steps": [
      "apt-get install pppoe-discovery 2>/dev/null || which pppoe-discovery",
      "Verify: pppoe-discovery --version",
      "supercli plugins install ./plugins/pppoe-discovery --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pppoe-discovery",
      "resource": "self",
      "action": "version",
      "description": "Print pppoe-discovery version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pppoe-discovery",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pppoe-discovery: apt-get install pppoe-discovery 2>/dev/null || which pppoe-discovery"
      },
      "args": []
    },
    {
      "namespace": "pppoe-discovery",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pppoe-discovery CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pppoe-discovery",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pppoe-discovery: apt-get install pppoe-discovery 2>/dev/null || which pppoe-discovery"
      },
      "args": []
    }
  ]
}