{
  "name": "ghi",
  "version": "0.1.0",
  "description": "Work on GitHub issues on the command-line",
  "source": "https://github.com/drazisil/ghi",
  "checks": [
    {
      "type": "binary",
      "name": "ghi"
    }
  ],
  "install_guidance": {
    "plugin": "ghi",
    "binary": "ghi",
    "check": "which ghi",
    "install_steps": [
      "brew install ghi",
      "Verify: ghi --version",
      "supercli plugins install ./plugins/ghi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ghi",
      "resource": "self",
      "action": "version",
      "description": "Print ghi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ghi: brew install ghi"
      },
      "args": []
    },
    {
      "namespace": "ghi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghi",
        "passthrough": true,
        "missingDependencyHelp": "Install ghi"
      },
      "args": []
    }
  ]
}