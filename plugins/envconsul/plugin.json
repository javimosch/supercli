{
  "name": "envconsul",
  "version": "0.1.0",
  "description": "Read environment variables from Consul and launch child processes",
  "source": "https://github.com/hashicorp/envconsul",
  "checks": [{ "type": "binary", "name": "envconsul" }],
  "install_guidance": {
    "plugin": "envconsul",
    "binary": "envconsul",
    "check": "which envconsul",
    "install_steps": ["brew install envconsul", "Verify: envconsul --version", "supercli plugins install ./plugins/envconsul --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "envconsul",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to envconsul CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "envconsul",
      "passthrough": true,
      "missingDependencyHelp": "Install envconsul: brew install envconsul"
    },
    "args": []
  }]
}
