{
  "name": "mdv",
  "version": "0.1.0",
  "description": "Styled terminal markdown viewer with syntax highlighting and table support",
  "source": "https://github.com/axiros/terminal_markdown_viewer",
  "checks": [{ "type": "binary", "name": "mdv" }],
  "install_guidance": {
    "plugin": "mdv",
    "binary": "mdv",
    "check": "which mdv",
    "install_steps": [
      "pip install mdv",
      "Or: pipx install mdv",
      "Verify: mdv --version",
      "supercli plugins install ./plugins/mdv --on-conflict replace --json"
    ],
    "note": "Available via pip/pipx. Source: https://github.com/axiros/terminal_markdown_viewer (2.6k+ stars). Written in Python."
  },
  "commands": [
    {
      "namespace": "mdv", "resource": "self", "action": "version",
      "description": "Print mdv version",
      "adapter": "process",
      "adapterConfig": { "command": "mdv", "missingDependencyHelp": "Install mdv: pip install mdv", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "mdv", "resource": "render", "action": "file",
      "description": "Render a markdown file in the terminal",
      "adapter": "process",
      "adapterConfig": { "command": "mdv", "missingDependencyHelp": "Install mdv: pip install mdv", "passthrough": true },
      "args": []
    },
    {
      "namespace": "mdv", "resource": "_", "action": "_",
      "description": "Passthrough to mdv CLI",
      "adapter": "process",
      "adapterConfig": { "command": "mdv", "missingDependencyHelp": "Install mdv: pip install mdv", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
