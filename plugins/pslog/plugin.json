{
  "name": "pslog",
  "version": "1.0.0",
  "description": "pslog \u2014 pslog \u2014 CLI utility",
  "source": "/usr/bin/pslog",
  "checks": [
    {
      "type": "binary",
      "name": "pslog"
    }
  ],
  "install_guidance": {
    "plugin": "pslog",
    "binary": "pslog",
    "check": "which pslog",
    "install_steps": [
      "# Install pslog:",
      "# apt: sudo apt-get install pslog",
      "# brew: brew install pslog",
      "# cargo: cargo install pslog",
      "# npm: npm install -g pslog",
      "# pip: pip install pslog",
      "# or download from /usr/bin/pslog"
    ]
  },
  "commands": [
    {
      "namespace": "pslog",
      "resource": "pslog",
      "action": "run",
      "description": "Run pslog",
      "adapter": "process",
      "adapterConfig": {
        "command": "pslog",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pslog from /usr/bin/pslog"
      },
      "args": []
    }
  ]
}