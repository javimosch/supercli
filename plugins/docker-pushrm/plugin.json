{
  "name": "docker-pushrm",
  "version": "0.1.0",
  "description": "Push a readme to container registries",
  "source": "https://github.com/christian-korneck/docker-pushrm",
  "checks": [
    {
      "type": "binary",
      "name": "docker-pushrm"
    }
  ],
  "install_guidance": {
    "plugin": "docker-pushrm",
    "binary": "docker-pushrm",
    "check": "which docker-pushrm",
    "install_steps": [
      "See https://github.com/christian-korneck/docker-pushrm",
      "Verify: docker-pushrm --version",
      "supercli plugins install ./plugins/docker-pushrm --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "docker-pushrm",
      "resource": "self",
      "action": "version",
      "description": "Print docker-pushrm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-pushrm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-pushrm: See https://github.com/christian-korneck/docker-pushrm"
      },
      "args": []
    },
    {
      "namespace": "docker-pushrm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-pushrm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-pushrm",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-pushrm"
      },
      "args": []
    }
  ]
}