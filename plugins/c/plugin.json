{
  "name": "c",
  "version": "0.1.0",
  "description": "Compile and execute C \"scripts\" in one go",
  "source": "https://github.com/ryanmjacobs/c",
  "checks": [
    {
      "type": "binary",
      "name": "c"
    }
  ],
  "install_guidance": {
    "plugin": "c",
    "binary": "c",
    "check": "which c",
    "install_steps": [
      "brew install c",
      "Verify: c --version",
      "supercli plugins install ./plugins/c --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "c",
      "resource": "self",
      "action": "version",
      "description": "Print c version",
      "adapter": "process",
      "adapterConfig": {
        "command": "c",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install c: brew install c"
      },
      "args": []
    },
    {
      "namespace": "c",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to c CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "c",
        "passthrough": true,
        "missingDependencyHelp": "Install c"
      },
      "args": []
    }
  ]
}