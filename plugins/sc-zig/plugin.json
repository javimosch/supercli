{
  "name": "sc-zig",
  "version": "0.1.0",
  "description": "CLI tool: sc-zig",
  "source": "https://manpages.debian.org/sc-zig",
  "checks": [
    {
      "type": "binary",
      "name": "sc-zig"
    }
  ],
  "install_guidance": {
    "plugin": "sc-zig",
    "binary": "sc-zig",
    "check": "which sc-zig",
    "install_steps": [
      "apt-get install sc-zig 2>/dev/null || which sc-zig",
      "Verify: sc-zig --version",
      "supercli plugins install ./plugins/sc-zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sc-zig",
      "resource": "self",
      "action": "version",
      "description": "Print sc-zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sc-zig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sc-zig: apt-get install sc-zig 2>/dev/null || which sc-zig"
      },
      "args": []
    },
    {
      "namespace": "sc-zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sc-zig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sc-zig",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sc-zig: apt-get install sc-zig 2>/dev/null || which sc-zig"
      },
      "args": []
    }
  ]
}