{
  "name": "scdoc",
  "version": "1.0.0",
  "description": "scdoc \u2014 Man page generator",
  "source": "git.sr.ht/~sircmpwn/scdoc",
  "checks": [
    {
      "type": "binary",
      "name": "scdoc"
    }
  ],
  "install_guidance": {
    "plugin": "scdoc",
    "binary": "scdoc",
    "check": "which scdoc",
    "install_steps": [
      "# Install scdoc:",
      "# apt: sudo apt-get install scdoc",
      "# brew: brew install scdoc",
      "# cargo: cargo install scdoc",
      "# npm: npm install -g scdoc",
      "# pip: pip install scdoc",
      "# or download from git.sr.ht/~sircmpwn/scdoc"
    ]
  },
  "commands": [
    {
      "namespace": "scdoc",
      "resource": "scdoc",
      "action": "run",
      "description": "Run scdoc",
      "adapter": "process",
      "adapterConfig": {
        "command": "scdoc",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install scdoc from git.sr.ht/~sircmpwn/scdoc"
      },
      "args": []
    }
  ]
}