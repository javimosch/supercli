{
  "plugin": "scdoc",
  "binary": "scdoc",
  "check": "which scdoc",
  "install_steps": [
    "# Install scdoc",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/scdoc-linux-amd64 -o /usr/local/bin/scdoc",
    "chmod +x /usr/local/bin/scdoc",
    "# Or via package manager, see git.sr.ht/~sircmpwn/scdoc"
  ]
}