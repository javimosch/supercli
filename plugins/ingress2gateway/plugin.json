{
  "name": "ingress2gateway",
  "version": "0.1.0",
  "description": "Convert Kubernetes Ingress resources to Kubernetes Gateway API resources",
  "source": "https://github.com/kubernetes-sigs/ingress2gateway",
  "checks": [
    {
      "type": "binary",
      "name": "ingress2gateway"
    }
  ],
  "install_guidance": {
    "plugin": "ingress2gateway",
    "binary": "ingress2gateway",
    "check": "which ingress2gateway",
    "install_steps": [
      "brew install ingress2gateway",
      "Verify: ingress2gateway --version",
      "supercli plugins install ./plugins/ingress2gateway --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ingress2gateway",
      "resource": "self",
      "action": "version",
      "description": "Print ingress2gateway version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ingress2gateway",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ingress2gateway: brew install ingress2gateway"
      },
      "args": []
    },
    {
      "namespace": "ingress2gateway",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ingress2gateway CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ingress2gateway",
        "passthrough": true,
        "missingDependencyHelp": "Install ingress2gateway"
      },
      "args": []
    }
  ]
}