{
  "name": "bumpver",
  "version": "0.1.0",
  "description": "Automated calendar and semver version bumping with Git tags",
  "source": "https://github.com/mbarkhau/bumpver",
  "checks": [{ "type": "binary", "name": "bumpver" }],
  "install_guidance": {
    "plugin": "bumpver",
    "binary": "bumpver",
    "check": "which bumpver",
    "install_steps": ["pip install bumpver", "Verify: bumpver --version", "supercli plugins install ./plugins/bumpver --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bumpver",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bumpver CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bumpver",
      "passthrough": true,
      "missingDependencyHelp": "Install bumpver: pip install bumpver", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
