{
  "name": "dhall-to-nix",
  "version": "0.1.0",
  "description": "CLI tool: dhall-to-nix",
  "source": "https://packages.debian.org/dhall-to-nix",
  "checks": [{ "type": "binary", "name": "dhall-to-nix" }],
  "install_guidance": {
    "plugin": "dhall-to-nix", "binary": "dhall-to-nix", "check": "which dhall-to-nix",
    "install_steps": ["apt-get install dhall-to-nix 2>/dev/null || which dhall-to-nix", "Verify: dhall-to-nix --version", "supercli plugins install ./plugins/dhall-to-nix --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-to-nix", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-to-nix CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-to-nix", "passthrough": true, "missingDependencyHelp": "Install dhall-to-nix: apt-get install dhall-to-nix" }, "args": []
  }]
}
