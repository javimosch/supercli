{
  "name": "sad",
  "version": "1.0.0",
  "description": "sad \u2014 System metric viewer",
  "source": "crates.io/crates/sad",
  "checks": [
    {
      "type": "binary",
      "name": "sad"
    }
  ],
  "install_guidance": {
    "plugin": "sad",
    "binary": "sad",
    "check": "which sad",
    "install_steps": [
      "# Install sad:",
      "# apt: sudo apt-get install sad",
      "# brew: brew install sad",
      "# cargo: cargo install sad",
      "# npm: npm install -g sad",
      "# pip: pip install sad",
      "# or download from crates.io/crates/sad"
    ]
  },
  "commands": [
    {
      "namespace": "sad",
      "resource": "sad",
      "action": "run",
      "description": "Run sad",
      "adapter": "process",
      "adapterConfig": {
        "command": "sad",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install sad from crates.io/crates/sad"
      },
      "args": []
    }
  ]
}