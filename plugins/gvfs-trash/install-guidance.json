{
  "plugin": "gvfs-trash",
  "binary": "gvfs-trash",
  "check": "which gvfs-trash",
  "install_steps": [
    "apt-get install gvfs-trash 2>/dev/null || which gvfs-trash",
    "Verify: gvfs-trash --version",
    "supercli plugins install ./plugins/gvfs-trash --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}