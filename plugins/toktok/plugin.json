{
  "name": "toktok",
  "version": "0.1.0",
  "description": "Simple clock generator and timer utility",
  "source": "https://github.com/vts/toktok",
  "checks": [{ "type": "binary", "name": "toktok" }],
  "install_guidance": {
    "plugin": "toktok",
    "binary": "toktok",
    "check": "which toktok",
    "install_steps": ["cargo install toktok", "Verify: toktok --version", "supercli plugins install ./plugins/toktok --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "toktok",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to toktok CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "toktok",
      "passthrough": true,
      "missingDependencyHelp": "Install toktok: cargo install toktok", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
