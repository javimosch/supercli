{
  "name": "assert",
  "version": "0.1.0",
  "description": "assert \u2014 abort the program if assertion is false",
  "source": "https://packages.debian.org/assert",
  "checks": [{ "type": "binary", "name": "assert" }],
  "install_guidance": {
    "plugin": "assert", "binary": "assert", "check": "which assert",
    "install_steps": ["apt-get install assert 2>/dev/null || which assert", "Verify: assert --version", "supercli plugins install ./plugins/assert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "assert", "resource": "_", "action": "_",
    "description": "Passthrough to assert CLI",
    "adapter": "process", "adapterConfig": { "command": "assert", "passthrough": true, "missingDependencyHelp": "Install assert: apt-get install assert" }, "args": []
  }]
}
