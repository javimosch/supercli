{
  "name": "emacs-clang-complete-async",
  "version": "0.1.0",
  "description": "Emacs plugin using libclang to complete C/C++ code",
  "source": "https://github.com/Golevka/emacs-clang-complete-async",
  "checks": [
    {
      "type": "binary",
      "name": "emacs-clang-complete-async"
    }
  ],
  "install_guidance": {
    "plugin": "emacs-clang-complete-async",
    "binary": "emacs-clang-complete-async",
    "check": "which emacs-clang-complete-async",
    "install_steps": [
      "brew install emacs-clang-complete-async",
      "Verify: emacs-clang-complete-async --version",
      "supercli plugins install ./plugins/emacs-clang-complete-async --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "emacs-clang-complete-async",
      "resource": "self",
      "action": "version",
      "description": "Print emacs-clang-complete-async version",
      "adapter": "process",
      "adapterConfig": {
        "command": "emacs-clang-complete-async",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install emacs-clang-complete-async: brew install emacs-clang-complete-async"
      },
      "args": []
    },
    {
      "namespace": "emacs-clang-complete-async",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to emacs-clang-complete-async CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "emacs-clang-complete-async",
        "passthrough": true,
        "missingDependencyHelp": "Install emacs-clang-complete-async"
      },
      "args": []
    }
  ]
}