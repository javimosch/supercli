{
  "name": "ufw",
  "version": "1.0.0",
  "description": "ufw \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=ufw+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "ufw"
    }
  ],
  "install_guidance": {
    "plugin": "ufw",
    "binary": "ufw",
    "check": "which ufw",
    "install_steps": [
      "Install ufw via package manager: apt install ufw or brew install ufw"
    ]
  },
  "commands": [
    {
      "namespace": "ufw",
      "resource": "run",
      "action": "exec",
      "description": "ufw \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "ufw",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ufw via your package manager"
      },
      "args": []
    }
  ]
}