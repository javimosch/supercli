{
  "name": "segment-geospatial",
  "version": "0.1.0",
  "description": "CLI harness for geospatial imagery segmentation with SAM",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "segment-geospatial" }],
  "install_guidance": {
    "plugin": "segment-geospatial",
    "binary": "segment-geospatial",
    "check": "which segment-geospatial",
    "install_steps": ["pip install segment-geospatial", "Verify: segment-geospatial --version", "supercli plugins install ./plugins/segment-geospatial --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "segment-geospatial",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to segment-geospatial CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "segment-geospatial",
      "passthrough": true,
      "missingDependencyHelp": "Install segment-geospatial: pip install segment-geospatial"
    },
    "args": []
  }]
}
