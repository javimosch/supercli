{
  "name": "conftest",
  "version": "0.1.0",
  "description": "Configuration file testing using OPA policies",
  "source": "https://github.com/open-policy-agent/conftest",
  "checks": [
    {
      "type": "binary",
      "name": "conftest"
    }
  ],
  "install_guidance": {
    "plugin": "conftest",
    "binary": "conftest",
    "check": "which conftest",
    "install_steps": [
      "brew install conftest",
      "Verify: conftest --version",
      "supercli plugins install ./plugins/conftest --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "conftest",
      "resource": "self",
      "action": "version",
      "description": "Print conftest version",
      "adapter": "process",
      "adapterConfig": {
        "command": "conftest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install conftest: brew install conftest"
      },
      "args": []
    },
    {
      "namespace": "conftest",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to conftest CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "conftest",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install conftest: brew install conftest"
      },
      "args": []
    }
  ]
}
