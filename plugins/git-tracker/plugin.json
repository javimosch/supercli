{
  "name": "git-tracker",
  "version": "0.1.0",
  "description": "Integrate Pivotal Tracker into your Git workflow",
  "source": "https://github.com/stevenharman/git_tracker",
  "checks": [
    {
      "type": "binary",
      "name": "git-tracker"
    }
  ],
  "install_guidance": {
    "plugin": "git-tracker",
    "binary": "git-tracker",
    "check": "which git-tracker",
    "install_steps": [
      "brew install git-tracker",
      "Verify: git-tracker --version",
      "supercli plugins install ./plugins/git-tracker --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-tracker",
      "resource": "self",
      "action": "version",
      "description": "Print git-tracker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-tracker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-tracker: brew install git-tracker"
      },
      "args": []
    },
    {
      "namespace": "git-tracker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-tracker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-tracker",
        "passthrough": true,
        "missingDependencyHelp": "Install git-tracker"
      },
      "args": []
    }
  ]
}