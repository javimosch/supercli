{
  "name": "filedb",
  "version": "0.1.0",
  "description": "Disk Based Key-Value Store Inspired by Bitcask ",
  "source": "https://github.com/filedb/filedb",
  "checks": [
    {
      "type": "binary",
      "name": "filedb"
    }
  ],
  "install_guidance": {
    "plugin": "filedb",
    "binary": "filedb",
    "check": "which filedb",
    "install_steps": [
      "pip install filedb",
      "Verify: filedb --version",
      "supercli plugins install ./plugins/filedb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "filedb",
      "resource": "self",
      "action": "version",
      "description": "Print filedb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "filedb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install filedb: pip install filedb"
      },
      "args": []
    },
    {
      "namespace": "filedb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to filedb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "filedb",
        "passthrough": true,
        "missingDependencyHelp": "Install filedb: pip install filedb"
      },
      "args": []
    }
  ]
}