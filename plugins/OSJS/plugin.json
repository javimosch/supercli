{
  "name": "OSJS",
  "version": "0.1.0",
  "description": "A mock CLI OS written entirely in javascript. Doesn't mock up real computer memory, but mimics the basic functions.",
  "source": "osjs.otiummusic.com/OSJS.html",
  "checks": [
    {
      "type": "binary",
      "name": "OSJS"
    }
  ],
  "install_guidance": {
    "plugin": "OSJS",
    "binary": "OSJS",
    "check": "which OSJS",
    "install_steps": [
      "Check osjs.otiummusic.com/OSJS.html for installation instructions",
      "Verify: OSJS --version",
      "supercli plugins install ./plugins/OSJS --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "OSJS",
      "resource": "self",
      "action": "version",
      "description": "Print OSJS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "OSJS",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OSJS from project repository"
      },
      "args": []
    },
    {
      "namespace": "OSJS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to OSJS CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "OSJS",
        "passthrough": true,
        "missingDependencyHelp": "Install OSJS from project repository"
      },
      "args": []
    }
  ]
}