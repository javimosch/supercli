{
  "name": "remmina-gnome",
  "version": "0.1.0",
  "description": "CLI tool: remmina-gnome",
  "source": "https://manpages.debian.org/remmina-gnome",
  "checks": [
    {
      "type": "binary",
      "name": "remmina-gnome"
    }
  ],
  "install_guidance": {
    "plugin": "remmina-gnome",
    "binary": "remmina-gnome",
    "check": "which remmina-gnome",
    "install_steps": [
      "apt-get install remmina-gnome 2>/dev/null || which remmina-gnome",
      "Verify: remmina-gnome --version",
      "supercli plugins install ./plugins/remmina-gnome --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "remmina-gnome",
      "resource": "self",
      "action": "version",
      "description": "Print remmina-gnome version",
      "adapter": "process",
      "adapterConfig": {
        "command": "remmina-gnome",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install remmina-gnome: apt-get install remmina-gnome 2>/dev/null || which remmina-gnome"
      },
      "args": []
    },
    {
      "namespace": "remmina-gnome",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to remmina-gnome CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "remmina-gnome",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install remmina-gnome: apt-get install remmina-gnome 2>/dev/null || which remmina-gnome"
      },
      "args": []
    }
  ]
}