{
  "name": "timelinize",
  "version": "0.1.0",
  "description": "Store your data from all your accounts and devices in a single cohesive timeline on your own compute",
  "source": "https://github.com/timelinize/timelinize",
  "checks": [
    {
      "type": "binary",
      "name": "timelinize"
    }
  ],
  "install_guidance": {
    "plugin": "timelinize",
    "binary": "timelinize",
    "check": "which timelinize",
    "install_steps": [
      "pip install timelinize",
      "Verify: timelinize --version",
      "supercli plugins install ./plugins/timelinize --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "timelinize",
      "resource": "self",
      "action": "version",
      "description": "Print timelinize version",
      "adapter": "process",
      "adapterConfig": {
        "command": "timelinize",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install timelinize: pip install timelinize"
      },
      "args": []
    },
    {
      "namespace": "timelinize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to timelinize CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "timelinize",
        "passthrough": true,
        "missingDependencyHelp": "Install timelinize: pip install timelinize"
      },
      "args": []
    }
  ]
}