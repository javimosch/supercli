{
  "name": "mongofiles",
  "version": "0.1.0",
  "description": "CLI tool: mongofiles",
  "source": "https://manpages.debian.org/mongofiles",
  "checks": [
    {
      "type": "binary",
      "name": "mongofiles"
    }
  ],
  "install_guidance": {
    "plugin": "mongofiles",
    "binary": "mongofiles",
    "check": "which mongofiles",
    "install_steps": [
      "apt-get install mongofiles 2>/dev/null || which mongofiles",
      "Verify: mongofiles --version",
      "supercli plugins install ./plugins/mongofiles --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mongofiles",
      "resource": "self",
      "action": "version",
      "description": "Print mongofiles version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mongofiles",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mongofiles: apt-get install mongofiles 2>/dev/null || which mongofiles"
      },
      "args": []
    },
    {
      "namespace": "mongofiles",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mongofiles CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mongofiles",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mongofiles: apt-get install mongofiles 2>/dev/null || which mongofiles"
      },
      "args": []
    }
  ]
}