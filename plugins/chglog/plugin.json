{
  "name": "chglog",
  "version": "0.1.0",
  "description": "Minimalist Go-based changelog formatter",
  "source": "go",
  "checks": [{ "type": "binary", "name": "chglog" }],
  "install_guidance": {
    "plugin": "chglog",
    "binary": "chglog",
    "check": "which chglog",
    "install_steps": ["go install github.com/goreleaser/chglog/cmd/chglog@latest", "Verify: chglog --version", "supercli plugins install ./plugins/chglog --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "chglog",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to chglog CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "chglog",
      "passthrough": true,
      "missingDependencyHelp": "Install chglog: go install github.com/goreleaser/chglog/cmd/chglog@latest"
    },
    "args": []
  }]
}
