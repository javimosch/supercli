{
  "name": "d2-cli",
  "version": "0.1.0",
  "description": "Declarative diagramming language compiler and renderer",
  "source": "https://github.com/terrastruct/d2",
  "checks": [{ "type": "binary", "name": "d2-cli" }],
  "install_guidance": {
    "plugin": "d2-cli",
    "binary": "d2-cli",
    "check": "which d2-cli",
    "install_steps": ["brew install d2", "Verify: d2-cli --version", "supercli plugins install ./plugins/d2-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "d2-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to d2-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "d2-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install d2-cli: brew install d2", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
