{
  "name": "cli-calc",
  "version": "0.1.0",
  "description": "A simple, powerful, scriptable, CLI calculator.",
  "source": "https://github.com/cli-calc/cli-calc",
  "checks": [
    {
      "type": "binary",
      "name": "cli-calc"
    }
  ],
  "install_guidance": {
    "plugin": "cli-calc",
    "binary": "cli-calc",
    "check": "which cli-calc",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: cli-calc --version",
      "supercli plugins install ./plugins/cli-calc --on-conflict replace --json"
    ],
    "note": "C++ language CLI tool"
  },
  "commands": [
    {
      "namespace": "cli-calc",
      "resource": "self",
      "action": "version",
      "description": "Print cli-calc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-calc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli-calc from project repository"
      },
      "args": []
    },
    {
      "namespace": "cli-calc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-calc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-calc",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-calc from project repository"
      },
      "args": []
    }
  ]
}