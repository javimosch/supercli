{
  "name": "pnmhisteq",
  "version": "0.1.0",
  "description": "CLI tool: pnmhisteq",
  "source": "https://manpages.debian.org/pnmhisteq",
  "checks": [
    {
      "type": "binary",
      "name": "pnmhisteq"
    }
  ],
  "install_guidance": {
    "plugin": "pnmhisteq",
    "binary": "pnmhisteq",
    "check": "which pnmhisteq",
    "install_steps": [
      "apt-get install pnmhisteq 2>/dev/null || which pnmhisteq",
      "Verify: pnmhisteq --version",
      "supercli plugins install ./plugins/pnmhisteq --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmhisteq",
      "resource": "self",
      "action": "version",
      "description": "Print pnmhisteq version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmhisteq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmhisteq: apt-get install pnmhisteq 2>/dev/null || which pnmhisteq"
      },
      "args": []
    },
    {
      "namespace": "pnmhisteq",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmhisteq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmhisteq",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmhisteq: apt-get install pnmhisteq 2>/dev/null || which pnmhisteq"
      },
      "args": []
    }
  ]
}