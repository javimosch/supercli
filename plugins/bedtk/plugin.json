{
  "name": "bedtk",
  "version": "0.1.0",
  "description": "Simple toolset for BED files",
  "source": "https://github.com/lh3/bedtk",
  "checks": [
    {
      "type": "binary",
      "name": "bedtk"
    }
  ],
  "install_guidance": {
    "plugin": "bedtk",
    "binary": "bedtk",
    "check": "which bedtk",
    "install_steps": [
      "brew install bedtk",
      "Verify: bedtk --version",
      "supercli plugins install ./plugins/bedtk --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bedtk",
      "resource": "self",
      "action": "version",
      "description": "Print bedtk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bedtk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bedtk: brew install bedtk"
      },
      "args": []
    },
    {
      "namespace": "bedtk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bedtk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bedtk",
        "passthrough": true,
        "missingDependencyHelp": "Install bedtk"
      },
      "args": []
    }
  ]
}