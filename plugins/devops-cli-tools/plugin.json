{
  "name": "devops-cli-tools",
  "version": "0.1.0",
  "description": "DevOps pipeline tasks to log in to a tenant and run commandline scripts using the CLI for Microsoft 365",
  "source": "https://github.com/devops-cli-tools/devops-cli-tools",
  "checks": [
    {
      "type": "binary",
      "name": "devops-cli-tools"
    }
  ],
  "install_guidance": {
    "plugin": "devops-cli-tools",
    "binary": "devops-cli-tools",
    "check": "which devops-cli-tools",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: devops-cli-tools --version",
      "supercli plugins install ./plugins/devops-cli-tools --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "devops-cli-tools",
      "resource": "self",
      "action": "version",
      "description": "Print devops-cli-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "devops-cli-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install devops-cli-tools from project repository"
      },
      "args": []
    },
    {
      "namespace": "devops-cli-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to devops-cli-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "devops-cli-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install devops-cli-tools from project repository"
      },
      "args": []
    }
  ]
}