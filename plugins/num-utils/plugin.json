{
  "name": "num-utils",
  "version": "0.1.0",
  "description": "Collection of numeric processing tools",
  "source": "https://github.com/num-utils/num-utils",
  "checks": [
    {
      "type": "binary",
      "name": "num-utils"
    }
  ],
  "install_guidance": {
    "plugin": "num-utils",
    "binary": "num-utils",
    "check": "which num-utils",
    "install_steps": [
      "brew install num-utils",
      "Verify: num-utils --version",
      "supercli plugins install ./plugins/num-utils --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "num-utils",
      "resource": "self",
      "action": "version",
      "description": "Print num-utils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "num-utils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install num-utils: brew install num-utils"
      },
      "args": []
    },
    {
      "namespace": "num-utils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to num-utils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "num-utils",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install num-utils: brew install num-utils"
      },
      "args": []
    }
  ]
}
