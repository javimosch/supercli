{
  "name": "asn",
  "version": "0.1.0",
  "description": "Organization lookup and server tool (ASN / IPv4 / IPv6 / Prefix / AS Path)",
  "source": "https://github.com/nitefood/asn",
  "checks": [
    {
      "type": "binary",
      "name": "asn"
    }
  ],
  "install_guidance": {
    "plugin": "asn",
    "binary": "asn",
    "check": "which asn",
    "install_steps": [
      "brew install asn",
      "Verify: asn --version",
      "supercli plugins install ./plugins/asn --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "asn",
      "resource": "self",
      "action": "version",
      "description": "Print asn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "asn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install asn: brew install asn"
      },
      "args": []
    },
    {
      "namespace": "asn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to asn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "asn",
        "passthrough": true,
        "missingDependencyHelp": "Install asn"
      },
      "args": []
    }
  ]
}