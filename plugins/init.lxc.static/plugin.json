{
  "name": "init.lxc.static",
  "version": "0.1.0",
  "description": "CLI tool: init.lxc.static",
  "source": "https://manpages.debian.org/init.lxc.static",
  "checks": [
    {
      "type": "binary",
      "name": "init.lxc.static"
    }
  ],
  "install_guidance": {
    "plugin": "init.lxc.static",
    "binary": "init.lxc.static",
    "check": "which init.lxc.static",
    "install_steps": [
      "apt-get install init.lxc.static 2>/dev/null || which init.lxc.static",
      "Verify: init.lxc.static --version",
      "supercli plugins install ./plugins/init.lxc.static --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "init.lxc.static",
      "resource": "self",
      "action": "version",
      "description": "Print init.lxc.static version",
      "adapter": "process",
      "adapterConfig": {
        "command": "init.lxc.static",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install init.lxc.static: apt-get install init.lxc.static 2>/dev/null || which init.lxc.static"
      },
      "args": []
    },
    {
      "namespace": "init.lxc.static",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to init.lxc.static CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "init.lxc.static",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install init.lxc.static: apt-get install init.lxc.static 2>/dev/null || which init.lxc.static"
      },
      "args": []
    }
  ]
}