{
  "name": "opl2ofm",
  "version": "0.1.0",
  "description": "CLI tool: opl2ofm",
  "source": "https://manpages.debian.org/opl2ofm",
  "checks": [
    {
      "type": "binary",
      "name": "opl2ofm"
    }
  ],
  "install_guidance": {
    "plugin": "opl2ofm",
    "binary": "opl2ofm",
    "check": "which opl2ofm",
    "install_steps": [
      "apt-get install opl2ofm 2>/dev/null || which opl2ofm",
      "Verify: opl2ofm --version",
      "supercli plugins install ./plugins/opl2ofm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "opl2ofm",
      "resource": "self",
      "action": "version",
      "description": "Print opl2ofm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "opl2ofm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install opl2ofm: apt-get install opl2ofm 2>/dev/null || which opl2ofm"
      },
      "args": []
    },
    {
      "namespace": "opl2ofm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to opl2ofm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "opl2ofm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install opl2ofm: apt-get install opl2ofm 2>/dev/null || which opl2ofm"
      },
      "args": []
    }
  ]
}