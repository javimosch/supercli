{
  "plugin": "update-fonts-dir",
  "binary": "update-fonts-dir",
  "check": "which update-fonts-dir",
  "install_steps": [
    "apt-get install update-fonts-dir 2>/dev/null || which update-fonts-dir",
    "Verify: update-fonts-dir --version",
    "supercli plugins install ./plugins/update-fonts-dir --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}