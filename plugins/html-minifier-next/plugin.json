{
  "name": "html-minifier-next",
  "version": "1.0.0",
  "description": "Super-configurable and well-tested web page minifier (enhanced successor of HTML Minifier). Handles HTML, CSS, JS, and SVG minification.",
  "source": "https://www.npmjs.com/package/html-minifier-next",
  "checks": [
    {
      "type": "binary",
      "name": "html-minifier-next"
    }
  ],
  "install_guidance": {
    "plugin": "html-minifier-next",
    "binary": "html-minifier-next",
    "check": "html-minifier-next --version",
    "install_steps": [
      "npm install -g html-minifier-next"
    ],
    "note": "Requires Node.js to be installed."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "html-minifier-next",
      "resource": "html",
      "action": "minify",
      "description": "Minify HTML, CSS, JS, and SVG files",
      "adapter": "process",
      "adapterConfig": {
        "command": "html-minifier-next",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install html-minifier-next: npm install -g html-minifier-next"
      },
      "args": []
    },
    {
      "namespace": "html-minifier-next",
      "resource": "self",
      "action": "version",
      "description": "Print html-minifier-next version",
      "adapter": "process",
      "adapterConfig": {
        "command": "html-minifier-next",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install html-minifier-next: npm install -g html-minifier-next"
      },
      "args": []
    },
    {
      "namespace": "html-minifier-next",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to html-minifier-next CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "html-minifier-next",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install html-minifier-next: npm install -g html-minifier-next"
      },
      "args": []
    }
  ]
}
