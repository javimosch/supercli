{
  "name": "cursor-free-everyday",
  "version": "0.1.0",
  "description": "\u5b8c\u5168\u514d\u8d39, \u81ea\u52a8\u83b7\u53d6\u65b0\u8d26\u53f7,\u4e00\u952e\u91cd\u7f6e\u65b0\u989d\u5ea6,  \u89e3\u51b3\u673a\u5668\u7801\u95ee\u9898, \u81ea\u52a8\u6ee1\u989d\u5ea6",
  "source": "https://github.com/cursor-free-everyday/cursor-free-everyday",
  "checks": [
    {
      "type": "binary",
      "name": "cursor-free-everyday"
    }
  ],
  "install_guidance": {
    "plugin": "cursor-free-everyday",
    "binary": "cursor-free-everyday",
    "check": "which cursor-free-everyday",
    "install_steps": [
      "pip install cursor-free-everyday",
      "Verify: cursor-free-everyday --version",
      "supercli plugins install ./plugins/cursor-free-everyday --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cursor-free-everyday",
      "resource": "self",
      "action": "version",
      "description": "Print cursor-free-everyday version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cursor-free-everyday",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cursor-free-everyday: pip install cursor-free-everyday"
      },
      "args": []
    },
    {
      "namespace": "cursor-free-everyday",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cursor-free-everyday CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cursor-free-everyday",
        "passthrough": true,
        "missingDependencyHelp": "Install cursor-free-everyday: pip install cursor-free-everyday"
      },
      "args": []
    }
  ]
}