{
  "name": "pdftosrc",
  "version": "0.1.0",
  "description": "CLI tool: pdftosrc",
  "source": "https://manpages.debian.org/pdftosrc",
  "checks": [
    {
      "type": "binary",
      "name": "pdftosrc"
    }
  ],
  "install_guidance": {
    "plugin": "pdftosrc",
    "binary": "pdftosrc",
    "check": "which pdftosrc",
    "install_steps": [
      "apt-get install pdftosrc 2>/dev/null || which pdftosrc",
      "Verify: pdftosrc --version",
      "supercli plugins install ./plugins/pdftosrc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdftosrc",
      "resource": "self",
      "action": "version",
      "description": "Print pdftosrc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdftosrc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdftosrc: apt-get install pdftosrc 2>/dev/null || which pdftosrc"
      },
      "args": []
    },
    {
      "namespace": "pdftosrc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdftosrc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdftosrc",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdftosrc: apt-get install pdftosrc 2>/dev/null || which pdftosrc"
      },
      "args": []
    }
  ]
}