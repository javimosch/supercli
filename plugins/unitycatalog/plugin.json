{
  "name": "unitycatalog",
  "version": "0.1.0",
  "description": "Open, Multi-modal Catalog for Data & AI",
  "source": "https://github.com/unitycatalog/unitycatalog",
  "checks": [
    {
      "type": "binary",
      "name": "unitycatalog"
    }
  ],
  "install_guidance": {
    "plugin": "unitycatalog",
    "binary": "unitycatalog",
    "check": "which unitycatalog",
    "install_steps": [
      "pip install unitycatalog",
      "Verify: unitycatalog --version",
      "supercli plugins install ./plugins/unitycatalog --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unitycatalog",
      "resource": "self",
      "action": "version",
      "description": "Print unitycatalog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unitycatalog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unitycatalog: pip install unitycatalog"
      },
      "args": []
    },
    {
      "namespace": "unitycatalog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unitycatalog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unitycatalog",
        "passthrough": true,
        "missingDependencyHelp": "Install unitycatalog: pip install unitycatalog"
      },
      "args": []
    }
  ]
}