{
  "name": "vgextend",
  "version": "0.1.0",
  "description": "CLI tool: vgextend",
  "source": "https://manpages.debian.org/vgextend",
  "checks": [
    {
      "type": "binary",
      "name": "vgextend"
    }
  ],
  "install_guidance": {
    "plugin": "vgextend",
    "binary": "vgextend",
    "check": "which vgextend",
    "install_steps": [
      "apt-get install vgextend 2>/dev/null || which vgextend",
      "Verify: vgextend --version",
      "supercli plugins install ./plugins/vgextend --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vgextend",
      "resource": "self",
      "action": "version",
      "description": "Print vgextend version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgextend",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vgextend: apt-get install vgextend 2>/dev/null || which vgextend"
      },
      "args": []
    },
    {
      "namespace": "vgextend",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vgextend CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgextend",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vgextend: apt-get install vgextend 2>/dev/null || which vgextend"
      },
      "args": []
    }
  ]
}