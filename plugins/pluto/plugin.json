{
  "name": "pluto",
  "version": "0.1.0",
  "description": "Detect deprecated Kubernetes API versions in your manifests",
  "source": "https://github.com/FairwindsOps/pluto",
  "checks": [{ "type": "binary", "name": "pluto" }],
  "install_guidance": {
    "plugin": "pluto",
    "binary": "pluto",
    "check": "which pluto",
    "install_steps": ["brew install pluto", "Verify: pluto --version", "supercli plugins install ./plugins/pluto --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pluto",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pluto CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pluto",
      "passthrough": true,
      "missingDependencyHelp": "Install pluto: brew install pluto"
    },
    "args": []
  }]
}
