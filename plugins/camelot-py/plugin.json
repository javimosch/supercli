{
  "name": "camelot-py",
  "version": "0.1.0",
  "description": "Extract tables from PDFs with high accuracy CLI",
  "source": "https://github.com/camelot-dev/camelot",
  "checks": [{ "type": "binary", "name": "camelot-py" }],
  "install_guidance": {
    "plugin": "camelot-py",
    "binary": "camelot-py",
    "check": "which camelot-py",
    "install_steps": ["pip install camelot-py", "Verify: camelot-py --version", "supercli plugins install ./plugins/camelot-py --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "camelot-py",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to camelot-py CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "camelot-py",
      "passthrough": true,
      "missingDependencyHelp": "Install camelot-py: pip install camelot-py", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
