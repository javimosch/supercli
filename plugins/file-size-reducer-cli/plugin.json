{
  "name": "file-size-reducer-cli",
  "version": "0.1.0",
  "description": "A lightweight CLI to compress images, iPhone HEIC photos, and PDFs while preserving originals.",
  "source": "https://github.com/file-size-reducer-cli/file-size-reducer-cli",
  "checks": [
    {
      "type": "binary",
      "name": "file-size-reducer-cli"
    }
  ],
  "install_guidance": {
    "plugin": "file-size-reducer-cli",
    "binary": "file-size-reducer-cli",
    "check": "which file-size-reducer-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: file-size-reducer-cli --version",
      "supercli plugins install ./plugins/file-size-reducer-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "file-size-reducer-cli",
      "resource": "self",
      "action": "version",
      "description": "Print file-size-reducer-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "file-size-reducer-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install file-size-reducer-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "file-size-reducer-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to file-size-reducer-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "file-size-reducer-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install file-size-reducer-cli from project repository"
      },
      "args": []
    }
  ]
}