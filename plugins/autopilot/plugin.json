{
  "name": "autopilot",
  "version": "0.1.0",
  "description": "AI-powered code generation from instructions",
  "source": "https://github.com/fauxpilot/autopilot",
  "checks": [{ "type": "binary", "name": "autopilot" }],
  "install_guidance": {
    "plugin": "autopilot",
    "binary": "autopilot",
    "check": "which autopilot",
    "install_steps": ["npm install -g autopilot-cli", "Verify: autopilot --version", "supercli plugins install ./plugins/autopilot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "autopilot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to autopilot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "autopilot",
      "passthrough": true,
      "missingDependencyHelp": "Install autopilot: npm install -g autopilot-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
