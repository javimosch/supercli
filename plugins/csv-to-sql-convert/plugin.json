{
  "name": "csv-to-sql-convert",
  "version": "0.1.0",
  "description": "Simple script for piping CSV files into SQL INSERT statements",
  "source": "https://github.com/shaopengxu/csv-to-sql",
  "checks": [{ "type": "binary", "name": "csv-to-sql-convert" }],
  "install_guidance": {
    "plugin": "csv-to-sql-convert",
    "binary": "csv-to-sql-convert",
    "check": "which csv-to-sql-convert",
    "install_steps": ["pip install csv-to-sql-convert", "Verify: csv-to-sql-convert --version", "supercli plugins install ./plugins/csv-to-sql-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "csv-to-sql-convert",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to csv-to-sql-convert CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "csv-to-sql-convert",
      "passthrough": true,
      "missingDependencyHelp": "Install csv-to-sql-convert: pip install csv-to-sql-convert", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
