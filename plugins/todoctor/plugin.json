{
  "name": "todoctor",
  "version": "0.1.0",
  "description": "Analyze and report TODO comments in JS/TS in Svelte",
  "source": "https://github.com/nicedoc/todoctor",
  "checks": [
    {
      "type": "binary",
      "name": "todoctor"
    }
  ],
  "install_guidance": {
    "plugin": "todoctor",
    "binary": "todoctor",
    "check": "which todoctor",
    "install_steps": [
      "npm install -g todoctor",
      "Verify: todoctor --version",
      "supercli plugins install ./plugins/todoctor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "todoctor",
      "resource": "self",
      "action": "version",
      "description": "Print todoctor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "todoctor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install todoctor: npm install -g todoctor"
      },
      "args": []
    },
    {
      "namespace": "todoctor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to todoctor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "todoctor",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install todoctor: npm install -g todoctor"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
