{
  "name": "dccifd",
  "version": "0.1.0",
  "description": "CLI tool: dccifd",
  "source": "https://packages.debian.org/dccifd",
  "checks": [{ "type": "binary", "name": "dccifd" }],
  "install_guidance": {
    "plugin": "dccifd", "binary": "dccifd", "check": "which dccifd",
    "install_steps": ["apt-get install dccifd 2>/dev/null || which dccifd", "Verify: dccifd --version", "supercli plugins install ./plugins/dccifd --on-conflict replace --json"]
