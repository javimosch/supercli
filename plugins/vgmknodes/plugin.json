{
  "name": "vgmknodes",
  "version": "0.1.0",
  "description": "CLI tool: vgmknodes",
  "source": "https://manpages.debian.org/vgmknodes",
  "checks": [
    {
      "type": "binary",
      "name": "vgmknodes"
    }
  ],
  "install_guidance": {
    "plugin": "vgmknodes",
    "binary": "vgmknodes",
    "check": "which vgmknodes",
    "install_steps": [
      "apt-get install vgmknodes 2>/dev/null || which vgmknodes",
      "Verify: vgmknodes --version",
      "supercli plugins install ./plugins/vgmknodes --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vgmknodes",
      "resource": "self",
      "action": "version",
      "description": "Print vgmknodes version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgmknodes",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vgmknodes: apt-get install vgmknodes 2>/dev/null || which vgmknodes"
      },
      "args": []
    },
    {
      "namespace": "vgmknodes",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vgmknodes CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgmknodes",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vgmknodes: apt-get install vgmknodes 2>/dev/null || which vgmknodes"
      },
      "args": []
    }
  ]
}