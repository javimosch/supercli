{
  "name": "shell-gpt",
  "version": "0.1.0",
  "description": "CLI productivity tool powered by AI/LLMs for shell commands and text processing",
  "source": "https://github.com/TheR1D/shell_gpt",
  "checks": [
    {
      "type": "binary",
      "name": "shell-gpt"
    }
  ],
  "install_guidance": {
    "plugin": "shell-gpt",
    "binary": "shell-gpt",
    "check": "which shell-gpt",
    "install_steps": [
      "pip install shell-gpt",
      "Verify: shell-gpt --version",
      "supercli plugins install ./plugins/shell-gpt --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "shell-gpt",
      "resource": "self",
      "action": "version",
      "description": "Print shell-gpt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shell-gpt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shell-gpt: pip install shell-gpt"
      },
      "args": []
    },
    {
      "namespace": "shell-gpt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shell-gpt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shell-gpt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install shell-gpt: pip install shell-gpt"
      },
      "args": []
    }
  ]
}
