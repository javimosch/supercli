{
  "name": "pbmtoptx",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoptx",
  "source": "https://manpages.debian.org/pbmtoptx",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoptx"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoptx",
    "binary": "pbmtoptx",
    "check": "which pbmtoptx",
    "install_steps": [
      "apt-get install pbmtoptx 2>/dev/null || which pbmtoptx",
      "Verify: pbmtoptx --version",
      "supercli plugins install ./plugins/pbmtoptx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoptx",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoptx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoptx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoptx: apt-get install pbmtoptx 2>/dev/null || which pbmtoptx"
      },
      "args": []
    },
    {
      "namespace": "pbmtoptx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoptx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoptx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoptx: apt-get install pbmtoptx 2>/dev/null || which pbmtoptx"
      },
      "args": []
    }
  ]
}