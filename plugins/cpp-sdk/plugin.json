{
  "name": "cpp-sdk",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/cpp-sdk/cpp-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "cpp-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "cpp-sdk",
    "binary": "cpp-sdk",
    "check": "which cpp-sdk",
    "install_steps": [
      "pip install cpp-sdk",
      "Verify: cpp-sdk --version",
      "supercli plugins install ./plugins/cpp-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cpp-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print cpp-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cpp-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cpp-sdk: pip install cpp-sdk"
      },
      "args": []
    },
    {
      "namespace": "cpp-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cpp-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cpp-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install cpp-sdk: pip install cpp-sdk"
      },
      "args": []
    }
  ]
}