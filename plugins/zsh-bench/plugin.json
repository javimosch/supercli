{
  "name": "zsh-bench",
  "version": "0.1.0",
  "description": "Benchmark your ZSH configuration performance",
  "source": "https://github.com/romkatv/zsh-bench",
  "checks": [{ "type": "binary", "name": "zsh-bench" }],
  "install_guidance": {
    "plugin": "zsh-bench",
    "binary": "zsh-bench",
    "check": "which zsh-bench",
    "install_steps": ["cargo install zsh-bench", "Verify: zsh-bench --version", "supercli plugins install ./plugins/zsh-bench --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "zsh-bench",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to zsh-bench CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "zsh-bench",
      "passthrough": true,
      "missingDependencyHelp": "Install zsh-bench: cargo install zsh-bench", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
