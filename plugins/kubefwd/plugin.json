{
  "name": "kubefwd",
  "version": "0.1.0",
  "description": "Bulk port forwarding for Kubernetes services",
  "source": "https://github.com/txn2/kubefwd",
  "checks": [{ "type": "binary", "name": "kubefwd" }],
  "install_guidance": {
    "plugin": "kubefwd",
    "binary": "kubefwd",
    "check": "which kubefwd",
    "install_steps": ["brew install kubefwd", "Verify: kubefwd --version", "supercli plugins install ./plugins/kubefwd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubefwd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubefwd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubefwd",
      "passthrough": true,
      "missingDependencyHelp": "Install kubefwd: brew install kubefwd"
    },
    "args": []
  }]
}
