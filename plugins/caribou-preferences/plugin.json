{
  "name": "caribou-preferences",
  "version": "0.1.0",
  "description": "CLI tool: caribou-preferences",
  "source": "https://packages.debian.org/caribou-preferences",
  "checks": [{ "type": "binary", "name": "caribou-preferences" }],
  "install_guidance": {
    "plugin": "caribou-preferences", "binary": "caribou-preferences", "check": "which caribou-preferences",
    "install_steps": ["apt-get install caribou-preferences 2>/dev/null || which caribou-preferences", "Verify: caribou-preferences --version", "supercli plugins install ./plugins/caribou-preferences --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "caribou-preferences", "resource": "_", "action": "_",
    "description": "Passthrough to caribou-preferences CLI",
    "adapter": "process", "adapterConfig": { "command": "caribou-preferences", "passthrough": true, "missingDependencyHelp": "Install caribou-preferences: apt-get install caribou-preferences" }, "args": []
  }]
}
