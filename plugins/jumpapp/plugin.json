{
  "name": "jumpapp",
  "version": "0.1.0",
  "description": "Run or raise desktop applications from the command line",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "jumpapp" }],
  "install_guidance": {
    "plugin": "jumpapp",
    "binary": "jumpapp",
    "check": "which jumpapp",
    "install_steps": ["sudo apt install jumpapp", "Verify: jumpapp --version", "supercli plugins install ./plugins/jumpapp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jumpapp",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jumpapp CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jumpapp",
      "passthrough": true,
      "missingDependencyHelp": "Install jumpapp: sudo apt install jumpapp"
    },
    "args": []
  }]
}
