{
  "name": "showconsolefont",
  "version": "0.1.0",
  "description": "CLI tool: showconsolefont",
  "source": "https://manpages.debian.org/showconsolefont",
  "checks": [
    {
      "type": "binary",
      "name": "showconsolefont"
    }
  ],
  "install_guidance": {
    "plugin": "showconsolefont",
    "binary": "showconsolefont",
    "check": "which showconsolefont",
    "install_steps": [
      "apt-get install showconsolefont 2>/dev/null || which showconsolefont",
      "Verify: showconsolefont --version",
      "supercli plugins install ./plugins/showconsolefont --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "showconsolefont",
      "resource": "self",
      "action": "version",
      "description": "Print showconsolefont version",
      "adapter": "process",
      "adapterConfig": {
        "command": "showconsolefont",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install showconsolefont: apt-get install showconsolefont 2>/dev/null || which showconsolefont"
      },
      "args": []
    },
    {
      "namespace": "showconsolefont",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to showconsolefont CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "showconsolefont",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install showconsolefont: apt-get install showconsolefont 2>/dev/null || which showconsolefont"
      },
      "args": []
    }
  ]
}