{
  "name": "dropbox-cli",
  "version": "1.0.0",
  "description": "dropbox-cli \u2014 Dropbox CLI",
  "source": "dropbox.com",
  "checks": [
    {
      "type": "binary",
      "name": "dropbox"
    }
  ],
  "install_guidance": {
    "plugin": "dropbox-cli",
    "binary": "dropbox",
    "check": "which dropbox",
    "install_steps": [
      "# Install dropbox-cli",
      "# See dropbox.com",
      "# apt: sudo apt-get install dropbox-cli",
      "# brew: brew install dropbox-cli",
      "# cargo: cargo install dropbox-cli",
      "# npm: npm install -g dropbox-cli",
      "# pip: pip install dropbox-cli"
    ]
  },
  "commands": [
    {
      "namespace": "dropbox",
      "resource": "cli",
      "action": "run",
      "description": "Run dropbox-cli",
      "adapter": "process",
      "adapterConfig": {
        "command": "dropbox",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dropbox-cli from dropbox.com"
      },
      "args": []
    }
  ]
}