{
  "name": "cromwell",
  "version": "0.1.0",
  "description": "Workflow Execution Engine using Workflow Description Language",
  "source": "https://github.com/broadinstitute/cromwell",
  "checks": [
    {
      "type": "binary",
      "name": "cromwell"
    }
  ],
  "install_guidance": {
    "plugin": "cromwell",
    "binary": "cromwell",
    "check": "which cromwell",
    "install_steps": [
      "brew install cromwell",
      "Verify: cromwell --version",
      "supercli plugins install ./plugins/cromwell --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cromwell",
      "resource": "self",
      "action": "version",
      "description": "Print cromwell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cromwell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cromwell: brew install cromwell"
      },
      "args": []
    },
    {
      "namespace": "cromwell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cromwell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cromwell",
        "passthrough": true,
        "missingDependencyHelp": "Install cromwell"
      },
      "args": []
    }
  ]
}