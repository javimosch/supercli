{
  "name": "py3rsa-sign",
  "version": "0.1.0",
  "description": "CLI tool: py3rsa-sign",
  "source": "https://manpages.debian.org/py3rsa-sign",
  "checks": [
    {
      "type": "binary",
      "name": "py3rsa-sign"
    }
  ],
  "install_guidance": {
    "plugin": "py3rsa-sign",
    "binary": "py3rsa-sign",
    "check": "which py3rsa-sign",
    "install_steps": [
      "apt-get install py3rsa-sign 2>/dev/null || which py3rsa-sign",
      "Verify: py3rsa-sign --version",
      "supercli plugins install ./plugins/py3rsa-sign --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "py3rsa-sign",
      "resource": "self",
      "action": "version",
      "description": "Print py3rsa-sign version",
      "adapter": "process",
      "adapterConfig": {
        "command": "py3rsa-sign",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install py3rsa-sign: apt-get install py3rsa-sign 2>/dev/null || which py3rsa-sign"
      },
      "args": []
    },
    {
      "namespace": "py3rsa-sign",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to py3rsa-sign CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "py3rsa-sign",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install py3rsa-sign: apt-get install py3rsa-sign 2>/dev/null || which py3rsa-sign"
      },
      "args": []
    }
  ]
}