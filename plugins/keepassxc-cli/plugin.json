{
  "name": "keepassxc-cli",
  "version": "0.1.0",
  "description": "CLI tool: keepassxc-cli",
  "source": "https://manpages.debian.org/keepassxc-cli",
  "checks": [
    {
      "type": "binary",
      "name": "keepassxc-cli"
    }
  ],
  "install_guidance": {
    "plugin": "keepassxc-cli",
    "binary": "keepassxc-cli",
    "check": "which keepassxc-cli",
    "install_steps": [
      "apt-get install keepassxc-cli 2>/dev/null || which keepassxc-cli",
      "Verify: keepassxc-cli --version",
      "supercli plugins install ./plugins/keepassxc-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "keepassxc-cli",
      "resource": "self",
      "action": "version",
      "description": "Print keepassxc-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "keepassxc-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install keepassxc-cli: apt-get install keepassxc-cli 2>/dev/null || which keepassxc-cli"
      },
      "args": []
    },
    {
      "namespace": "keepassxc-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to keepassxc-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "keepassxc-cli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install keepassxc-cli: apt-get install keepassxc-cli 2>/dev/null || which keepassxc-cli"
      },
      "args": []
    }
  ]
}