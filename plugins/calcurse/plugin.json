{
  "name": "calcurse",
  "version": "0.1.0",
  "description": "Calendar and scheduler with CLI",
  "source": "https://github.com/lfos/calcurse",
  "checks": [
    {
      "type": "binary",
      "name": "calcurse"
    }
  ],
  "install_guidance": {
    "plugin": "calcurse",
    "binary": "calcurse",
    "check": "which calcurse",
    "install_steps": [
      "brew install calcurse",
      "Verify: calcurse --version",
      "supercli plugins install ./plugins/calcurse --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "calcurse",
      "resource": "self",
      "action": "version",
      "description": "Print calcurse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "calcurse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install calcurse: brew install calcurse"
      },
      "args": []
    },
    {
      "namespace": "calcurse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to calcurse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "calcurse",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install calcurse: brew install calcurse"
      },
      "args": []
    }
  ]
}
