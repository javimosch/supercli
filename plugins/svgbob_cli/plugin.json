{
  "name": "svgbob_cli",
  "version": "0.1.0",
  "description": "CLI tool: svgbob_cli",
  "source": "https://manpages.debian.org/svgbob_cli",
  "checks": [
    {
      "type": "binary",
      "name": "svgbob_cli"
    }
  ],
  "install_guidance": {
    "plugin": "svgbob_cli",
    "binary": "svgbob_cli",
    "check": "which svgbob_cli",
    "install_steps": [
      "apt-get install svgbob_cli 2>/dev/null || which svgbob_cli",
      "Verify: svgbob_cli --version",
      "supercli plugins install ./plugins/svgbob_cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "svgbob_cli",
      "resource": "self",
      "action": "version",
      "description": "Print svgbob_cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "svgbob_cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install svgbob_cli: apt-get install svgbob_cli 2>/dev/null || which svgbob_cli"
      },
      "args": []
    },
    {
      "namespace": "svgbob_cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to svgbob_cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "svgbob_cli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install svgbob_cli: apt-get install svgbob_cli 2>/dev/null || which svgbob_cli"
      },
      "args": []
    }
  ]
}