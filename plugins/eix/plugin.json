{
  "name": "eix",
  "version": "1.0.0",
  "description": "eix \u2014 Gentoo package search",
  "source": "github.com/vaeth/eix",
  "checks": [
    {
      "type": "binary",
      "name": "eix"
    }
  ],
  "install_guidance": {
    "plugin": "eix",
    "binary": "eix",
    "check": "which eix",
    "install_steps": [
      "# Install eix",
      "# See github.com/vaeth/eix",
      "# apt: sudo apt-get install eix",
      "# brew: brew install eix",
      "# cargo: cargo install eix",
      "# npm: npm install -g eix",
      "# pip: pip install eix"
    ]
  },
  "commands": [
    {
      "namespace": "eix",
      "resource": "eix",
      "action": "run",
      "description": "Run eix",
      "adapter": "process",
      "adapterConfig": {
        "command": "eix",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install eix from github.com/vaeth/eix"
      },
      "args": []
    }
  ]
}