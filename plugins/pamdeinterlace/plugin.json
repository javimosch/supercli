{
  "name": "pamdeinterlace",
  "version": "0.1.0",
  "description": "CLI tool: pamdeinterlace",
  "source": "https://manpages.debian.org/pamdeinterlace",
  "checks": [
    {
      "type": "binary",
      "name": "pamdeinterlace"
    }
  ],
  "install_guidance": {
    "plugin": "pamdeinterlace",
    "binary": "pamdeinterlace",
    "check": "which pamdeinterlace",
    "install_steps": [
      "apt-get install pamdeinterlace 2>/dev/null || which pamdeinterlace",
      "Verify: pamdeinterlace --version",
      "supercli plugins install ./plugins/pamdeinterlace --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pamdeinterlace",
      "resource": "self",
      "action": "version",
      "description": "Print pamdeinterlace version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pamdeinterlace",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pamdeinterlace: apt-get install pamdeinterlace 2>/dev/null || which pamdeinterlace"
      },
      "args": []
    },
    {
      "namespace": "pamdeinterlace",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pamdeinterlace CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pamdeinterlace",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pamdeinterlace: apt-get install pamdeinterlace 2>/dev/null || which pamdeinterlace"
      },
      "args": []
    }
  ]
}