{
  "name": "jqn",
  "version": "0.1.0",
  "description": "Node-based alternative for JSON data processing and querying",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "jqn" }],
  "install_guidance": {
    "plugin": "jqn",
    "binary": "jqn",
    "check": "which jqn",
    "install_steps": ["npm install -g jqn", "Verify: jqn --version", "supercli plugins install ./plugins/jqn --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "jqn",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to jqn CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "jqn",
      "passthrough": true,
      "missingDependencyHelp": "Install jqn: npm install -g jqn"
    },
    "args": []
  }]
}
