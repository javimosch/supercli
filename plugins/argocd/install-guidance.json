{
  "plugin": "argocd",
  "binary": "argocd",
  "check": "which argocd",
  "install_steps": [
    "brew install argocd",
    "Or download: curl -sSL -o /usr/local/bin/argocd https://github.com/argoproj/argo-cd/releases/latest/download/argocd-linux-amd64 && chmod +x /usr/local/bin/argocd",
    "Verify: argocd version --client --short",
    "supercli plugins install ./plugins/argocd --on-conflict replace --json"
  ],
  "note": "Binary available via brew (macOS/Linux), GitHub releases, or Docker. Requires connection to an ArgoCD server for most operations — login with: argocd login <server-url>"
}
