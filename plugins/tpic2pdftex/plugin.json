{
  "name": "tpic2pdftex",
  "version": "0.1.0",
  "description": "CLI tool: tpic2pdftex",
  "source": "https://manpages.debian.org/tpic2pdftex",
  "checks": [
    {
      "type": "binary",
      "name": "tpic2pdftex"
    }
  ],
  "install_guidance": {
    "plugin": "tpic2pdftex",
    "binary": "tpic2pdftex",
    "check": "which tpic2pdftex",
    "install_steps": [
      "apt-get install tpic2pdftex 2>/dev/null || which tpic2pdftex",
      "Verify: tpic2pdftex --version",
      "supercli plugins install ./plugins/tpic2pdftex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tpic2pdftex",
      "resource": "self",
      "action": "version",
      "description": "Print tpic2pdftex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tpic2pdftex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tpic2pdftex: apt-get install tpic2pdftex 2>/dev/null || which tpic2pdftex"
      },
      "args": []
    },
    {
      "namespace": "tpic2pdftex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tpic2pdftex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tpic2pdftex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tpic2pdftex: apt-get install tpic2pdftex 2>/dev/null || which tpic2pdftex"
      },
      "args": []
    }
  ]
}