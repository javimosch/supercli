{
  "plugin": "svg-term",
  "binary": "svg-term",
  "check": "svg-term --version",
  "install_steps": [
    "npm install -g svg-term-cli",
    "# Optional: Install asciinema for recording",
    "brew install asciinema  # macOS",
    "# apt install asciinema  # Ubuntu/Debian"
  ],
  "note": "For recording new sessions, install asciinema separately. Can also convert existing asciinema recordings."
}
