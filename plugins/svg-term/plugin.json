{
  "name": "svg-term",
  "description": "Share terminal sessions as razor-sharp animated SVG everywhere.",
  "version": "1.0.0",
  "binary": "svg-term",
  "check": "svg-term --version",
  "install": {
    "method": "npm",
    "command": "npm install -g svg-term-cli"
  },
  "commands": {
    "convert": {
      "command": "svg-term --in {{input}} --out {{output}}",
      "description": "Convert asciicast JSON to SVG",
      "args": ["input", "output"]
    },
    "from-cast": {
      "command": "svg-term --cast {{castId}} --out {{output}}",
      "description": "Convert asciinema cast to SVG",
      "args": ["castId", "output"]
    },
    "record": {
      "command": "svg-term --command {{command}} --out {{output}}",
      "description": "Record command and output as SVG",
      "args": ["command", "output"]
    }
  }
}
