{
  "name": "svg-term",
  "description": "Share terminal sessions via animated SVG and CSS",
  "version": "1.0.0",
  "binary": "svg-term",
  "check": "svg-term --version",
  "install": {
    "method": "npm",
    "command": "npm install -g svg-term-cli"
  },
  "commands": {
    "cast": {
      "command": "svg-term --cast {cast_id}",
      "description": "Generate SVG from asciinema cast ID",
      "args": ["cast_id"]
    },
    "file": {
      "command": "svg-term --in {file} --out {output}",
      "description": "Generate SVG from local cast file",
      "args": ["file", "output"]
    },
    "record": {
      "command": "asciinema rec demo.cast",
      "description": "Record terminal session (requires asciinema)"
    }
  }
}
