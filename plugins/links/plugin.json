{
  "name": "links",
  "version": "0.1.0",
  "description": "Text/Graphics mode web browser",
  "source": "https://github.com/twaugh/links",
  "checks": [
    {
      "type": "binary",
      "name": "links"
    }
  ],
  "install_guidance": {
    "plugin": "links",
    "binary": "links",
    "check": "which links",
    "install_steps": [
      "brew install links",
      "Verify: links --version",
      "supercli plugins install ./plugins/links --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "links",
      "resource": "self",
      "action": "version",
      "description": "Print links version",
      "adapter": "process",
      "adapterConfig": {
        "command": "links",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install links: brew install links"
      },
      "args": []
    },
    {
      "namespace": "links",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to links CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "links",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install links: brew install links"
      },
      "args": []
    }
  ]
}
