{
  "name": "aws-doctor",
  "version": "1.0.0",
  "description": "Powerful open-source CLI to audit security, costs, and best practices in AWS.",
  "source": "https://github.com/elC0mpa/aws-doctor",
  "checks": [
    {
      "type": "binary",
      "name": "aws-doctor",
      "args": [
        "version"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "aws-doctor",
    "binary": "aws-doctor",
    "check": "aws-doctor version",
    "install_steps": [
      "brew install elC0mpa/homebrew-tap/aws-doctor"
    ],
    "note": "Requires AWS credentials configured via AWS CLI (aws configure)"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "aws-doctor",
      "resource": "scan",
      "action": "run",
      "description": "Scan AWS resources for security, cost, and best practice issues",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-doctor",
        "baseArgs": [
          "scan"
        ],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 300000,
        "missingDependencyHelp": "Install aws-doctor: brew install elC0mpa/homebrew-tap/aws-doctor"
      },
      "args": []
    },
    {
      "namespace": "aws-doctor",
      "resource": "report",
      "action": "run",
      "description": "Generate a detailed report of AWS resource analysis",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-doctor",
        "baseArgs": [
          "report"
        ],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 300000,
        "missingDependencyHelp": "Install aws-doctor: brew install elC0mpa/homebrew-tap/aws-doctor"
      },
      "args": []
    },
    {
      "namespace": "aws-doctor",
      "resource": "audit",
      "action": "run",
      "description": "Perform a comprehensive AWS audit",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-doctor",
        "baseArgs": [
          "audit"
        ],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 300000,
        "missingDependencyHelp": "Install aws-doctor: brew install elC0mpa/homebrew-tap/aws-doctor"
      },
      "args": []
    },
    {
      "namespace": "aws-doctor",
      "resource": "self",
      "action": "version",
      "description": "Print aws-doctor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-doctor",
        "baseArgs": [
          "version"
        ],
        "missingDependencyHelp": "Install aws-doctor: brew install elC0mpa/homebrew-tap/aws-doctor"
      },
      "args": []
    },
    {
      "namespace": "aws-doctor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aws-doctor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-doctor",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install aws-doctor: brew install elC0mpa/homebrew-tap/aws-doctor"
      },
      "args": []
    }
  ]
}
