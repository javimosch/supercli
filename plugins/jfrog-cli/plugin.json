{
  "name": "jfrog-cli",
  "version": "0.1.0",
  "description": "Command-line interface for JFrog products",
  "checks": [
    {
      "type": "binary",
      "name": "jfrog-cli"
    }
  ],
  "install_guidance": {
    "plugin": "jfrog-cli",
    "binary": "jfrog-cli",
    "check": "which jfrog-cli",
    "install_steps": [
      "brew install jfrog-cli",
      "Verify: jfrog-cli --version",
      "supercli plugins install ./plugins/jfrog-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "jfrog-cli",
      "resource": "self",
      "action": "version",
      "description": "Print jfrog-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jfrog-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jfrog-cli: brew install jfrog-cli"
      },
      "args": []
    },
    {
      "namespace": "jfrog-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jfrog-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jfrog-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install jfrog-cli"
      },
      "args": []
    }
  ]
}