{
  "name": "dtsroll",
  "version": "0.1.0",
  "description": "CLI tool for bundling TypeScript declaration files",
  "source": "https://github.com/privatenumber/dtsroll",
  "checks": [
    {
      "type": "binary",
      "name": "dtsroll"
    }
  ],
  "install_guidance": {
    "plugin": "dtsroll",
    "binary": "dtsroll",
    "check": "which dtsroll",
    "install_steps": [
      "brew install dtsroll",
      "Verify: dtsroll --version",
      "supercli plugins install ./plugins/dtsroll --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dtsroll",
      "resource": "self",
      "action": "version",
      "description": "Print dtsroll version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dtsroll",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dtsroll: brew install dtsroll"
      },
      "args": []
    },
    {
      "namespace": "dtsroll",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dtsroll CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dtsroll",
        "passthrough": true,
        "missingDependencyHelp": "Install dtsroll"
      },
      "args": []
    }
  ]
}