{
  "name": "heroku",
  "version": "0.1.0",
  "description": "CLI for Heroku",
  "checks": [
    {
      "type": "binary",
      "name": "heroku"
    }
  ],
  "install_guidance": {
    "plugin": "heroku",
    "binary": "heroku",
    "check": "which heroku",
    "install_steps": [
      "brew install heroku",
      "Verify: heroku --version",
      "supercli plugins install ./plugins/heroku --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "heroku",
      "resource": "self",
      "action": "version",
      "description": "Print heroku version",
      "adapter": "process",
      "adapterConfig": {
        "command": "heroku",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install heroku: brew install heroku"
      },
      "args": []
    },
    {
      "namespace": "heroku",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to heroku CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "heroku",
        "passthrough": true,
        "missingDependencyHelp": "Install heroku"
      },
      "args": []
    }
  ]
}