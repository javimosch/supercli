{
  "name": "distcc",
  "version": "0.1.0",
  "description": "CLI tool: distcc",
  "source": "https://packages.debian.org/distcc",
  "checks": [{ "type": "binary", "name": "distcc" }],
  "install_guidance": {
    "plugin": "distcc", "binary": "distcc", "check": "which distcc",
    "install_steps": ["apt-get install distcc 2>/dev/null || which distcc", "Verify: distcc --version", "supercli plugins install ./plugins/distcc --on-conflict replace --json"]
