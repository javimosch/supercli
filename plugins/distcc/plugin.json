  "commands": [{
    "namespace": "distcc", "resource": "_", "action": "_",
    "description": "Passthrough to distcc CLI",
    "adapter": "process", "adapterConfig": { "command": "distcc", "passthrough": true, "missingDependencyHelp": "Install distcc: apt-get install distcc" }, "args": []
  }]
}
