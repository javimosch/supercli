{
  "name": "metapost",
  "version": "0.1.0",
  "description": "MetaPost — vector graphics language for technical illustrations. Produces high-quality PostScript/EPS/SVG graphics from textual descriptions with precise mathematical typography. Widely used in LaTeX documents for diagrams, graphs, and technical figures.",
  "source": "https://github.com/texlive/metapost",
  "checks": [
    {
      "type": "binary",
      "name": "metapost"
    }
  ],
  "install_guidance": {
    "plugin": "metapost",
    "binary": "metapost",
    "check": "which metapost",
    "install_steps": [
      "brew install metapost",
      "Verify: metapost --version",
      "supercli plugins install ./plugins/metapost --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "metapost",
      "resource": "self",
      "action": "version",
      "description": "Print metapost version",
      "adapter": "process",
      "adapterConfig": {
        "command": "metapost",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install metapost: brew install metapost"
      },
      "args": []
    },
    {
      "namespace": "metapost",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to metapost CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "metapost",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install metapost: brew install metapost"
      },
      "args": []
    }
  ]
}
