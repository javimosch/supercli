{
  "name": "gtk4-query-settings",
  "version": "0.1.0",
  "description": "CLI tool: gtk4-query-settings",
  "source": "https://manpages.debian.org/gtk4-query-settings",
  "checks": [
    {
      "type": "binary",
      "name": "gtk4-query-settings"
    }
  ],
  "install_guidance": {
    "plugin": "gtk4-query-settings",
    "binary": "gtk4-query-settings",
    "check": "which gtk4-query-settings",
    "install_steps": [
      "apt-get install gtk4-query-settings 2>/dev/null || which gtk4-query-settings",
      "Verify: gtk4-query-settings --version",
      "supercli plugins install ./plugins/gtk4-query-settings --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gtk4-query-settings",
      "resource": "self",
      "action": "version",
      "description": "Print gtk4-query-settings version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtk4-query-settings",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gtk4-query-settings: apt-get install gtk4-query-settings 2>/dev/null || which gtk4-query-settings"
      },
      "args": []
    },
    {
      "namespace": "gtk4-query-settings",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gtk4-query-settings CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gtk4-query-settings",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gtk4-query-settings: apt-get install gtk4-query-settings 2>/dev/null || which gtk4-query-settings"
      },
      "args": []
    }
  ]
}