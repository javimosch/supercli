{
  "name": "slimerjim",
  "version": "0.1.0",
  "description": "slimerjim — HTTP benchmarking tool",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "http"
    }
  ],
  "install_guidance": {
    "plugin": "slimerjim",
    "binary": "http",
    "check": "which http",
    "install_steps": [
      "brew install slimerjim"
    ],
    "note": "Utility tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "slimerjim",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to http",
      "adapter": "process",
      "adapterConfig": {
        "command": "http",
        "passthrough": true,
        "missingDependencyHelp": "Install slimerjim: brew install slimerjim"
      },
      "args": []
    }
  ]
}
