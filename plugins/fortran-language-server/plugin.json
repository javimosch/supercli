{
  "name": "fortran-language-server",
  "version": "0.1.0",
  "description": "Language Server for Fortran",
  "source": "https://github.com/hansec/fortran-language-server",
  "checks": [
    {
      "type": "binary",
      "name": "fortran-language-server"
    }
  ],
  "install_guidance": {
    "plugin": "fortran-language-server",
    "binary": "fortran-language-server",
    "check": "which fortran-language-server",
    "install_steps": [
      "brew install fortran-language-server",
      "Verify: fortran-language-server --version",
      "supercli plugins install ./plugins/fortran-language-server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fortran-language-server",
      "resource": "self",
      "action": "version",
      "description": "Print fortran-language-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fortran-language-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fortran-language-server: brew install fortran-language-server"
      },
      "args": []
    },
    {
      "namespace": "fortran-language-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fortran-language-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fortran-language-server",
        "passthrough": true,
        "missingDependencyHelp": "Install fortran-language-server"
      },
      "args": []
    }
  ]
}