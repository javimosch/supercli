{
  "name": "file-rename",
  "version": "0.1.0",
  "description": "Rename multiple files with regex patterns via CLI",
  "source": "https://github.com/ap/rename",
  "checks": [{ "type": "binary", "name": "file-rename" }],
  "install_guidance": {
    "plugin": "file-rename",
    "binary": "file-rename",
    "check": "which file-rename",
    "install_steps": ["apt install rename", "Verify: file-rename --version", "supercli plugins install ./plugins/file-rename --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "file-rename",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to file-rename CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "file-rename",
      "passthrough": true,
      "missingDependencyHelp": "Install file-rename: apt install rename"
    },
    "args": []
  }]
}
