{
  "name": "mdBook",
  "version": "0.1.0",
  "description": "Create books from Markdown files for documentation",
  "source": "https://github.com/rust-lang/mdBook",
  "checks": [{ "type": "binary", "name": "mdbook" }],
  "install_guidance": {
    "plugin": "mdBook",
    "binary": "mdbook",
    "check": "which mdbook",
    "install_steps": ["cargo install mdbook", "Verify: mdbook --version", "supercli plugins install ./plugins/mdBook --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdBook",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdbook CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdbook",
      "passthrough": true,
      "missingDependencyHelp": "Install mdBook: cargo install mdbook"
    },
    "args": []
  }]
}
