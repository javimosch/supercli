{
  "name": "LeaderKey",
  "version": "0.1.0",
  "description": "The *faster than your launcher* launcher",
  "source": "https://github.com/LeaderKey/LeaderKey",
  "checks": [
    {
      "type": "binary",
      "name": "leaderkey"
    }
  ],
  "install_guidance": {
    "plugin": "LeaderKey",
    "binary": "leaderkey",
    "check": "which leaderkey",
    "install_steps": [
      "pip install leaderkey",
      "Verify: leaderkey --version",
      "supercli plugins install ./plugins/LeaderKey --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LeaderKey",
      "resource": "self",
      "action": "version",
      "description": "Print LeaderKey version",
      "adapter": "process",
      "adapterConfig": {
        "command": "leaderkey",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LeaderKey: pip install leaderkey"
      },
      "args": []
    },
    {
      "namespace": "LeaderKey",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to leaderkey CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "leaderkey",
        "passthrough": true,
        "missingDependencyHelp": "Install LeaderKey: pip install leaderkey"
      },
      "args": []
    }
  ]
}