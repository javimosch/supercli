{
  "name": "REALITY",
  "version": "0.1.0",
  "description": "THE NEXT FUTURE",
  "source": "https://github.com/REALITY/REALITY",
  "checks": [
    {
      "type": "binary",
      "name": "reality"
    }
  ],
  "install_guidance": {
    "plugin": "REALITY",
    "binary": "reality",
    "check": "which reality",
    "install_steps": [
      "pip install reality",
      "Verify: reality --version",
      "supercli plugins install ./plugins/REALITY --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "REALITY",
      "resource": "self",
      "action": "version",
      "description": "Print REALITY version",
      "adapter": "process",
      "adapterConfig": {
        "command": "reality",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install REALITY: pip install reality"
      },
      "args": []
    },
    {
      "namespace": "REALITY",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to reality CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "reality",
        "passthrough": true,
        "missingDependencyHelp": "Install REALITY: pip install reality"
      },
      "args": []
    }
  ]
}