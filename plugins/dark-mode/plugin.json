{
  "name": "dark-mode",
  "version": "0.1.0",
  "description": "Toggle macOS dark mode from the command line",
  "source": "https://github.com/sindresorhus/dark-mode",
  "checks": [{ "type": "binary", "name": "dark-mode" }],
  "install_guidance": {
    "plugin": "dark-mode",
    "binary": "dark-mode",
    "check": "which dark-mode",
    "install_steps": ["brew install dark-mode", "Verify: dark-mode --version", "supercli plugins install ./plugins/dark-mode --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dark-mode",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dark-mode CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dark-mode",
      "passthrough": true,
      "missingDependencyHelp": "Install dark-mode: brew install dark-mode", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
