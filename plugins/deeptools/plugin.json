{
  "name": "deeptools",
  "version": "1.0.0",
  "description": "deeptools \u2014 Bioinformatics tools",
  "source": "deeptools.readthedocs.io",
  "checks": [
    {
      "type": "binary",
      "name": "deepTools"
    }
  ],
  "install_guidance": {
    "plugin": "deeptools",
    "binary": "deepTools",
    "check": "which deepTools",
    "install_steps": [
      "# Install deeptools",
      "# See deeptools.readthedocs.io",
      "# apt: sudo apt-get install deeptools",
      "# brew: brew install deeptools",
      "# cargo: cargo install deeptools",
      "# npm: npm install -g deeptools",
      "# pip: pip install deeptools"
    ]
  },
  "commands": [
    {
      "namespace": "deeptools",
      "resource": "deeptools",
      "action": "run",
      "description": "Run deeptools",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepTools",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install deeptools from deeptools.readthedocs.io"
      },
      "args": []
    }
  ]
}