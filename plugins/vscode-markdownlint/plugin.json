{
  "name": "vscode-markdownlint",
  "version": "0.1.0",
  "description": "Markdown linting rules for VS Code via CLI",
  "source": "https://github.com/DavidAnson/markdownlint",
  "checks": [{ "type": "binary", "name": "vscode-markdownlint" }],
  "install_guidance": {
    "plugin": "vscode-markdownlint",
    "binary": "vscode-markdownlint",
    "check": "which vscode-markdownlint",
    "install_steps": ["npm install -g markdownlint-cli", "Verify: vscode-markdownlint --version", "supercli plugins install ./plugins/vscode-markdownlint --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vscode-markdownlint",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vscode-markdownlint CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vscode-markdownlint",
      "passthrough": true,
      "missingDependencyHelp": "Install vscode-markdownlint: npm install -g markdownlint-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
