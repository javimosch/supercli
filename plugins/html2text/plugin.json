{
  "name": "html2text",
  "version": "0.1.0",
  "description": "Convert HTML to clean readable Markdown text",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "html2text" }],
  "install_guidance": {
    "plugin": "html2text",
    "binary": "html2text",
    "check": "which html2text",
    "install_steps": ["pip install html2text", "Verify: html2text --version", "supercli plugins install ./plugins/html2text --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "html2text",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to html2text CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "html2text",
      "passthrough": true,
      "missingDependencyHelp": "Install html2text: pip install html2text"
    },
    "args": []
  }]
}
