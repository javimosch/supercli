{
  "name": "a2dissite",
  "version": "0.1.0",
  "description": "CLI tool: a2dissite",
  "source": "https://manpages.debian.org/a2dissite",
  "checks": [
    {
      "type": "binary",
      "name": "a2dissite"
    }
  ],
  "install_guidance": {
    "plugin": "a2dissite",
    "binary": "a2dissite",
    "check": "which a2dissite",
    "install_steps": [
      "apt-get install a2dissite 2>/dev/null || which a2dissite",
      "Verify: a2dissite --version",
      "supercli plugins install ./plugins/a2dissite --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "a2dissite",
      "resource": "self",
      "action": "version",
      "description": "Print a2dissite version",
      "adapter": "process",
      "adapterConfig": {
        "command": "a2dissite",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install a2dissite: apt-get install a2dissite 2>/dev/null || which a2dissite"
      },
      "args": []
    },
    {
      "namespace": "a2dissite",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to a2dissite CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "a2dissite",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install a2dissite: apt-get install a2dissite 2>/dev/null || which a2dissite"
      },
      "args": []
    }
  ]
}