{
  "name": "bzip3",
  "version": "0.1.0",
  "description": "Better and stronger spiritual successor to BZip2",
  "source": "https://github.com/kspalaiologos/bzip3",
  "checks": [
    {
      "type": "binary",
      "name": "bzip3"
    }
  ],
  "install_guidance": {
    "plugin": "bzip3",
    "binary": "bzip3",
    "check": "which bzip3",
    "install_steps": [
      "brew install bzip3",
      "Verify: bzip3 --version",
      "supercli plugins install ./plugins/bzip3 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bzip3",
      "resource": "self",
      "action": "version",
      "description": "Print bzip3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bzip3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bzip3: brew install bzip3"
      },
      "args": []
    },
    {
      "namespace": "bzip3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bzip3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bzip3",
        "passthrough": true,
        "missingDependencyHelp": "Install bzip3"
      },
      "args": []
    }
  ]
}