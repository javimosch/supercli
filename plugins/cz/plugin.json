{
  "name": "cz",
  "version": "0.1.0",
  "description": "Commitizen CLI — conventional commits with interactive and non-interactive modes, JSON output",
  "source": "https://github.com/commitizen-tools/commitizen",
  "checks": [
    {
      "type": "binary",
      "name": "cz"
    }
  ],
  "install_guidance": {
    "plugin": "cz",
    "binary": "cz",
    "check": "which cz",
    "install_steps": [
      "pipx install commitizen",
      "Verify: cz --version",
      "supercli plugins install ./plugins/cz --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cz",
      "resource": "self",
      "action": "version",
      "description": "Print cz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cz: pipx install commitizen"
      },
      "args": []
    },
    {
      "namespace": "cz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cz",
        "passthrough": true,
        "missingDependencyHelp": "Install cz: pipx install commitizen"
      },
      "args": []
    }
  ]
}
