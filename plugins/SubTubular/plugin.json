{
  "name": "SubTubular",
  "version": "0.1.0",
  "description": "Full-text search for YouTube video subtitles",
  "source": "dotnet",
  "checks": [{ "type": "binary", "name": "SubTubular" }],
  "install_guidance": {
    "plugin": "SubTubular",
    "binary": "SubTubular",
    "check": "which SubTubular",
    "install_steps": ["dotnet tool install -g SubTubular", "Verify: SubTubular --version", "supercli plugins install ./plugins/SubTubular --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "SubTubular",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to SubTubular CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "SubTubular",
      "passthrough": true,
      "missingDependencyHelp": "Install SubTubular: dotnet tool install -g SubTubular"
    },
    "args": []
  }]
}
