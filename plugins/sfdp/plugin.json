{
  "name": "sfdp",
  "version": "0.1.0",
  "description": "CLI tool: sfdp",
  "source": "https://manpages.debian.org/sfdp",
  "checks": [
    {
      "type": "binary",
      "name": "sfdp"
    }
  ],
  "install_guidance": {
    "plugin": "sfdp",
    "binary": "sfdp",
    "check": "which sfdp",
    "install_steps": [
      "apt-get install sfdp 2>/dev/null || which sfdp",
      "Verify: sfdp --version",
      "supercli plugins install ./plugins/sfdp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sfdp",
      "resource": "self",
      "action": "version",
      "description": "Print sfdp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sfdp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sfdp: apt-get install sfdp 2>/dev/null || which sfdp"
      },
      "args": []
    },
    {
      "namespace": "sfdp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sfdp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sfdp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sfdp: apt-get install sfdp 2>/dev/null || which sfdp"
      },
      "args": []
    }
  ]
}