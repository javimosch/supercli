{
  "name": "Thinking-Claude",
  "version": "0.1.0",
  "description": "Let your Claude able to think",
  "source": "https://github.com/Thinking-Claude/Thinking-Claude",
  "checks": [
    {
      "type": "binary",
      "name": "thinking-claude"
    }
  ],
  "install_guidance": {
    "plugin": "Thinking-Claude",
    "binary": "thinking-claude",
    "check": "which thinking-claude",
    "install_steps": [
      "pip install thinking-claude",
      "Verify: thinking-claude --version",
      "supercli plugins install ./plugins/Thinking-Claude --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Thinking-Claude",
      "resource": "self",
      "action": "version",
      "description": "Print Thinking-Claude version",
      "adapter": "process",
      "adapterConfig": {
        "command": "thinking-claude",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Thinking-Claude: pip install thinking-claude"
      },
      "args": []
    },
    {
      "namespace": "Thinking-Claude",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to thinking-claude CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "thinking-claude",
        "passthrough": true,
        "missingDependencyHelp": "Install Thinking-Claude: pip install thinking-claude"
      },
      "args": []
    }
  ]
}