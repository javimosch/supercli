{
  "name": "tunnelmole",
  "version": "0.1.0",
  "description": "Public localhost",
  "source": "https://github.com/robbie-cahill/tunnelmole-client",
  "checks": [
    {
      "type": "binary",
      "name": "tunnelmole"
    }
  ],
  "install_guidance": {
    "plugin": "tunnelmole",
    "binary": "tunnelmole",
    "check": "which tunnelmole",
    "install_steps": [
      "See https://github.com/robbie-cahill/tunnelmole-client",
      "Verify: tunnelmole --version",
      "supercli plugins install ./plugins/tunnelmole --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "tunnelmole",
      "resource": "self",
      "action": "version",
      "description": "Print tunnelmole version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tunnelmole",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tunnelmole: See https://github.com/robbie-cahill/tunnelmole-client"
      },
      "args": []
    },
    {
      "namespace": "tunnelmole",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tunnelmole CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tunnelmole",
        "passthrough": true,
        "missingDependencyHelp": "Install tunnelmole"
      },
      "args": []
    }
  ]
}