{
  "name": "source-controller",
  "version": "0.1.0",
  "description": "Source acquisition controller for Flux CD",
  "source": "https://github.com/fluxcd/source-controller",
  "checks": [{ "type": "binary", "name": "source-controller" }],
  "install_guidance": {
    "plugin": "source-controller",
    "binary": "source-controller",
    "check": "which source-controller",
    "install_steps": ["brew install source-controller", "Verify: source-controller --version", "supercli plugins install ./plugins/source-controller --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "source-controller",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to source-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "source-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install source-controller: brew install source-controller"
    },
    "args": []
  }]
}
