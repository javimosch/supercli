{
  "name": "futurize",
  "version": "0.1.0",
  "description": "CLI tool: futurize",
  "source": "https://manpages.debian.org/futurize",
  "checks": [
    {
      "type": "binary",
      "name": "futurize"
    }
  ],
  "install_guidance": {
    "plugin": "futurize",
    "binary": "futurize",
    "check": "which futurize",
    "install_steps": [
      "apt-get install futurize 2>/dev/null || which futurize",
      "Verify: futurize --version",
      "supercli plugins install ./plugins/futurize --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "futurize",
      "resource": "self",
      "action": "version",
      "description": "Print futurize version",
      "adapter": "process",
      "adapterConfig": {
        "command": "futurize",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install futurize: apt-get install futurize 2>/dev/null || which futurize"
      },
      "args": []
    },
    {
      "namespace": "futurize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to futurize CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "futurize",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install futurize: apt-get install futurize 2>/dev/null || which futurize"
      },
      "args": []
    }
  ]
}