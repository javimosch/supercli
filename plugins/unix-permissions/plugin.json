{
  "name": "unix-permissions",
  "version": "0.1.0",
  "description": "Swiss Army knife for Unix permissions",
  "source": "https://github.com/ehmicky/unix-permissions",
  "checks": [
    {
      "type": "binary",
      "name": "unix-permissions"
    }
  ],
  "install_guidance": {
    "plugin": "unix-permissions",
    "binary": "unix-permissions",
    "check": "which unix-permissions",
    "install_steps": [
      "See https://github.com/ehmicky/unix-permissions",
      "Verify: unix-permissions --version",
      "supercli plugins install ./plugins/unix-permissions --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "unix-permissions",
      "resource": "self",
      "action": "version",
      "description": "Print unix-permissions version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unix-permissions",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unix-permissions: See https://github.com/ehmicky/unix-permissions"
      },
      "args": []
    },
    {
      "namespace": "unix-permissions",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unix-permissions CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unix-permissions",
        "passthrough": true,
        "missingDependencyHelp": "Install unix-permissions"
      },
      "args": []
    }
  ]
}