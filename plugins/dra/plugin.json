{
  "name": "dra",
  "version": "1.0.0",
  "description": "dra \u2014 Docker registry CLI",
  "source": "github.com/devplayer0/dra",
  "checks": [
    {
      "type": "binary",
      "name": "dra"
    }
  ],
  "install_guidance": {
    "plugin": "dra",
    "binary": "dra",
    "check": "which dra",
    "install_steps": [
      "# Install dra",
      "# See github.com/devplayer0/dra",
      "# apt: sudo apt-get install dra",
      "# brew: brew install dra",
      "# cargo: cargo install dra",
      "# npm: npm install -g dra",
      "# pip: pip install dra"
    ]
  },
  "commands": [
    {
      "namespace": "dra",
      "resource": "dra",
      "action": "run",
      "description": "Run dra",
      "adapter": "process",
      "adapterConfig": {
        "command": "dra",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dra from github.com/devplayer0/dra"
      },
      "args": []
    }
  ]
}