{
  "name": "dbeaver",
  "version": "0.1.0",
  "description": "CLI tool: dbeaver",
  "source": "https://packages.debian.org/dbeaver",
  "checks": [{ "type": "binary", "name": "dbeaver" }],
  "install_guidance": {
    "plugin": "dbeaver", "binary": "dbeaver", "check": "which dbeaver",
    "install_steps": ["apt-get install dbeaver 2>/dev/null || which dbeaver", "Verify: dbeaver --version", "supercli plugins install ./plugins/dbeaver --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dbeaver", "resource": "_", "action": "_",
    "description": "Passthrough to dbeaver CLI",
    "adapter": "process", "adapterConfig": { "command": "dbeaver", "passthrough": true, "missingDependencyHelp": "Install dbeaver: apt-get install dbeaver" }, "args": []
  }]
}
