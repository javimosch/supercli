{
  "name": "distrobox-generate-entry",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-generate-entry",
  "source": "https://packages.debian.org/distrobox-generate-entry",
  "checks": [{ "type": "binary", "name": "distrobox-generate-entry" }],
  "install_guidance": {
    "plugin": "distrobox-generate-entry", "binary": "distrobox-generate-entry", "check": "which distrobox-generate-entry",
    "install_steps": ["apt-get install distrobox-generate-entry 2>/dev/null || which distrobox-generate-entry", "Verify: distrobox-generate-entry --version", "supercli plugins install ./plugins/distrobox-generate-entry --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distrobox-generate-entry", "resource": "_", "action": "_",
    "description": "Passthrough to distrobox-generate-entry CLI",
    "adapter": "process", "adapterConfig": { "command": "distrobox-generate-entry", "passthrough": true, "missingDependencyHelp": "Install distrobox-generate-entry: apt-get install distrobox-generate-entry" }, "args": []
  }]
}
