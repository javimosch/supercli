{
  "name": "distrobox",
  "version": "0.1.0",
  "description": "CLI tool: distrobox",
  "source": "https://packages.debian.org/distrobox",
  "checks": [{ "type": "binary", "name": "distrobox" }],
  "install_guidance": {
    "plugin": "distrobox", "binary": "distrobox", "check": "which distrobox",
    "install_steps": ["apt-get install distrobox 2>/dev/null || which distrobox", "Verify: distrobox --version", "supercli plugins install ./plugins/distrobox --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distrobox", "resource": "_", "action": "_",
    "description": "Passthrough to distrobox CLI",
    "adapter": "process", "adapterConfig": { "command": "distrobox", "passthrough": true, "missingDependencyHelp": "Install distrobox: apt-get install distrobox" }, "args": []
  }]
}
