{
  "name": "composite",
  "version": "0.1.0",
  "description": "Overlay images with transparency",
  "source": "https://packages.debian.org/composite",
  "checks": [{ "type": "binary", "name": "composite" }],
  "install_guidance": {
    "plugin": "composite", "binary": "composite", "check": "which composite",
    "install_steps": ["apt-get install imagemagick", "Verify: composite --version", "supercli plugins install ./plugins/composite --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "composite", "resource": "_", "action": "_",
    "description": "Passthrough to composite CLI",
    "adapter": "process", "adapterConfig": { "command": "composite", "passthrough": true, "missingDependencyHelp": "Install composite: apt-get install imagemagick" }, "args": []
  }]
}
