{
  "name": "img-meta",
  "version": "0.1.0",
  "description": "Display EXIF metadata from image files via command line",
  "source": "https://github.com/img-meta/tool",
  "checks": [{ "type": "binary", "name": "img-meta" }],
  "install_guidance": {
    "plugin": "img-meta",
    "binary": "img-meta",
    "check": "which img-meta",
    "install_steps": ["pip install img-meta", "Verify: img-meta --version", "supercli plugins install ./plugins/img-meta --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "img-meta",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to img-meta CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "img-meta",
      "passthrough": true,
      "missingDependencyHelp": "Install img-meta: pip install img-meta", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
