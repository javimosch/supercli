{
  "name": "pydoc3",
  "version": "0.1.0",
  "description": "CLI tool: pydoc3",
  "source": "https://manpages.debian.org/pydoc3",
  "checks": [
    {
      "type": "binary",
      "name": "pydoc3"
    }
  ],
  "install_guidance": {
    "plugin": "pydoc3",
    "binary": "pydoc3",
    "check": "which pydoc3",
    "install_steps": [
      "apt-get install pydoc3 2>/dev/null || which pydoc3",
      "Verify: pydoc3 --version",
      "supercli plugins install ./plugins/pydoc3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pydoc3",
      "resource": "self",
      "action": "version",
      "description": "Print pydoc3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pydoc3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pydoc3: apt-get install pydoc3 2>/dev/null || which pydoc3"
      },
      "args": []
    },
    {
      "namespace": "pydoc3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pydoc3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pydoc3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pydoc3: apt-get install pydoc3 2>/dev/null || which pydoc3"
      },
      "args": []
    }
  ]
}