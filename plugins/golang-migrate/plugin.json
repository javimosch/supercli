{
  "name": "golang-migrate",
  "version": "0.1.0",
  "description": "Database migrations CLI tool",
  "source": "https://github.com/golang-migrate/migrate",
  "checks": [
    {
      "type": "binary",
      "name": "golang-migrate"
    }
  ],
  "install_guidance": {
    "plugin": "golang-migrate",
    "binary": "golang-migrate",
    "check": "which golang-migrate",
    "install_steps": [
      "brew install golang-migrate",
      "Verify: golang-migrate --version",
      "supercli plugins install ./plugins/golang-migrate --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "golang-migrate",
      "resource": "self",
      "action": "version",
      "description": "Print golang-migrate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "golang-migrate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install golang-migrate: brew install golang-migrate"
      },
      "args": []
    },
    {
      "namespace": "golang-migrate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to golang-migrate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "golang-migrate",
        "passthrough": true,
        "missingDependencyHelp": "Install golang-migrate"
      },
      "args": []
    }
  ]
}