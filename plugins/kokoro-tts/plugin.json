{
  "name": "kokoro-tts",
  "version": "0.1.0",
  "description": "Fast local text-to-speech synthesis",
  "source": "https://github.com/nicholasgasior/kokoro-tts",
  "checks": [
    {
      "type": "binary",
      "name": "kokoro-tts"
    }
  ],
  "install_guidance": {
    "plugin": "kokoro-tts",
    "binary": "kokoro-tts",
    "check": "which kokoro-tts",
    "install_steps": [
      "pip install kokoro-tts",
      "Verify: kokoro-tts --version",
      "supercli plugins install ./plugins/kokoro-tts --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kokoro-tts",
      "resource": "self",
      "action": "version",
      "description": "Print kokoro-tts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kokoro-tts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kokoro-tts: pip install kokoro-tts"
      },
      "args": []
    },
    {
      "namespace": "kokoro-tts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kokoro-tts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kokoro-tts",
        "passthrough": true,
        "missingDependencyHelp": "Install kokoro-tts: pip install kokoro-tts"
      },
      "args": []
    }
  ]
}
