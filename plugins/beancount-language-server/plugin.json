{
  "name": "beancount-language-server",
  "version": "0.1.0",
  "description": "Language server for beancount files",
  "source": "https://github.com/polarmutex/beancount-language-server",
  "checks": [
    {
      "type": "binary",
      "name": "beancount-language-server"
    }
  ],
  "install_guidance": {
    "plugin": "beancount-language-server",
    "binary": "beancount-language-server",
    "check": "which beancount-language-server",
    "install_steps": [
      "brew install beancount-language-server",
      "Verify: beancount-language-server --version",
      "supercli plugins install ./plugins/beancount-language-server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "beancount-language-server",
      "resource": "self",
      "action": "version",
      "description": "Print beancount-language-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "beancount-language-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install beancount-language-server: brew install beancount-language-server"
      },
      "args": []
    },
    {
      "namespace": "beancount-language-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to beancount-language-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "beancount-language-server",
        "passthrough": true,
        "missingDependencyHelp": "Install beancount-language-server"
      },
      "args": []
    }
  ]
}