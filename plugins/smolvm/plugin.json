{
  "name": "smolvm",
  "version": "0.1.0",
  "description": "Portable lightweight virtual machine for scripting",
  "source": "https://github.com/nicholasgasior/smolvm",
  "checks": [
    {
      "type": "binary",
      "name": "smolvm"
    }
  ],
  "install_guidance": {
    "plugin": "smolvm",
    "binary": "smolvm",
    "check": "which smolvm",
    "install_steps": [
      "cargo install smolvm",
      "Verify: smolvm --version",
      "supercli plugins install ./plugins/smolvm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "smolvm",
      "resource": "self",
      "action": "version",
      "description": "Print smolvm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "smolvm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install smolvm: cargo install smolvm"
      },
      "args": []
    },
    {
      "namespace": "smolvm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to smolvm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "smolvm",
        "passthrough": true,
        "missingDependencyHelp": "Install smolvm: cargo install smolvm"
      },
      "args": []
    }
  ]
}
