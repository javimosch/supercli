{
  "name": "ucs2any",
  "version": "0.1.0",
  "description": "CLI tool: ucs2any",
  "source": "https://manpages.debian.org/ucs2any",
  "checks": [
    {
      "type": "binary",
      "name": "ucs2any"
    }
  ],
  "install_guidance": {
    "plugin": "ucs2any",
    "binary": "ucs2any",
    "check": "which ucs2any",
    "install_steps": [
      "apt-get install ucs2any 2>/dev/null || which ucs2any",
      "Verify: ucs2any --version",
      "supercli plugins install ./plugins/ucs2any --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ucs2any",
      "resource": "self",
      "action": "version",
      "description": "Print ucs2any version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ucs2any",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ucs2any: apt-get install ucs2any 2>/dev/null || which ucs2any"
      },
      "args": []
    },
    {
      "namespace": "ucs2any",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ucs2any CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ucs2any",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ucs2any: apt-get install ucs2any 2>/dev/null || which ucs2any"
      },
      "args": []
    }
  ]
}