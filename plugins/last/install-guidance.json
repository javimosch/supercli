{
  "plugin": "last",
  "binary": "last",
  "check": "which last",
  "install_steps": [
    "Pre-installed on most Linux systems (part of util-linux package)",
    "apt-get install util-linux",
    "Verify: last --version",
    "supercli plugins install ./plugins/last --on-conflict replace --json"
  ]
}
