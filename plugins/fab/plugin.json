{
  "name": "fab",
  "version": "1.0.0",
  "description": "fab \u2014 Fabric automation",
  "source": "fabfile.org",
  "checks": [
    {
      "type": "binary",
      "name": "fab"
    }
  ],
  "install_guidance": {
    "plugin": "fab",
    "binary": "fab",
    "check": "which fab",
    "install_steps": [
      "# Install fab",
      "# See fabfile.org",
      "# apt: sudo apt-get install fab",
      "# brew: brew install fab",
      "# cargo: cargo install fab",
      "# npm: npm install -g fab",
      "# pip: pip install fab"
    ]
  },
  "commands": [
    {
      "namespace": "fab",
      "resource": "fab",
      "action": "run",
      "description": "Run fab",
      "adapter": "process",
      "adapterConfig": {
        "command": "fab",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fab from fabfile.org"
      },
      "args": []
    }
  ]
}