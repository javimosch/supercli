{
  "name": "zsh-history",
  "version": "0.1.0",
  "description": "Zsh history management CLI — search, deduplicate, and export shell history as JSON",
  "source": "https://github.com/zsh-history/zsh-history",
  "checks": [
    {
      "type": "binary",
      "name": "zsh-history"
    }
  ],
  "install_guidance": {
    "plugin": "zsh-history",
    "binary": "zsh-history",
    "check": "which zsh-history",
    "install_steps": [
      "cargo install zsh-history",
      "Verify: zsh-history --version",
      "supercli plugins install ./plugins/zsh-history --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zsh-history",
      "resource": "self",
      "action": "version",
      "description": "Print zsh-history version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zsh-history",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zsh-history: cargo install zsh-history"
      },
      "args": []
    },
    {
      "namespace": "zsh-history",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zsh-history CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zsh-history",
        "passthrough": true,
        "missingDependencyHelp": "Install zsh-history: cargo install zsh-history"
      },
      "args": []
    }
  ]
}
