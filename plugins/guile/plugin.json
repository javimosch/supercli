{
  "name": "guile",
  "version": "0.1.0",
  "description": "GNU Guile Scheme interpreter",
  "source": "https://packages.debian.org/guile",
  "checks": [{ "type": "binary", "name": "guile" }],
  "install_guidance": {
    "plugin": "guile", "binary": "guile", "check": "which guile",
    "install_steps": ["apt-get install guile", "Verify: guile --version", "supercli plugins install ./plugins/guile --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "guile", "resource": "_", "action": "_",
    "description": "Passthrough to guile CLI",
    "adapter": "process", "adapterConfig": { "command": "guile", "passthrough": true, "missingDependencyHelp": "Install guile: apt-get install guile" }, "args": []
  }]
}
