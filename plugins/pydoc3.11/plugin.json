{
  "name": "pydoc3.11",
  "version": "0.1.0",
  "description": "CLI tool: pydoc3.11",
  "source": "https://manpages.debian.org/pydoc3.11",
  "checks": [
    {
      "type": "binary",
      "name": "pydoc3.11"
    }
  ],
  "install_guidance": {
    "plugin": "pydoc3.11",
    "binary": "pydoc3.11",
    "check": "which pydoc3.11",
    "install_steps": [
      "apt-get install pydoc3.11 2>/dev/null || which pydoc3.11",
      "Verify: pydoc3.11 --version",
      "supercli plugins install ./plugins/pydoc3.11 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pydoc3.11",
      "resource": "self",
      "action": "version",
      "description": "Print pydoc3.11 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pydoc3.11",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pydoc3.11: apt-get install pydoc3.11 2>/dev/null || which pydoc3.11"
      },
      "args": []
    },
    {
      "namespace": "pydoc3.11",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pydoc3.11 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pydoc3.11",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pydoc3.11: apt-get install pydoc3.11 2>/dev/null || which pydoc3.11"
      },
      "args": []
    }
  ]
}