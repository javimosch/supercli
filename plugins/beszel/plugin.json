{
  "name": "beszel",
  "version": "0.1.0",
  "description": "Lightweight server monitoring with historical data, docker stats, and alerts.",
  "source": "https://github.com/beszel/beszel",
  "checks": [
    {
      "type": "binary",
      "name": "beszel"
    }
  ],
  "install_guidance": {
    "plugin": "beszel",
    "binary": "beszel",
    "check": "which beszel",
    "install_steps": [
      "pip install beszel",
      "Verify: beszel --version",
      "supercli plugins install ./plugins/beszel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "beszel",
      "resource": "self",
      "action": "version",
      "description": "Print beszel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "beszel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install beszel: pip install beszel"
      },
      "args": []
    },
    {
      "namespace": "beszel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to beszel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "beszel",
        "passthrough": true,
        "missingDependencyHelp": "Install beszel: pip install beszel"
      },
      "args": []
    }
  ]
}