{
  "name": "dict",
  "version": "0.1.0",
  "description": "Dictionary protocol client",
  "source": "https://github.com/cheusov/dictd",
  "checks": [
    {
      "type": "binary",
      "name": "dict"
    }
  ],
  "install_guidance": {
    "plugin": "dict",
    "binary": "dict",
    "check": "which dict",
    "install_steps": [
      "brew install dict",
      "Verify: dict --version",
      "supercli plugins install ./plugins/dict --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "dict",
      "resource": "self",
      "action": "version",
      "description": "Print dict version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dict",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dict: brew install dict"
      },
      "args": []
    },
    {
      "namespace": "dict",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dict CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dict",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dict: brew install dict"
      },
      "args": []
    }
  ]
}
