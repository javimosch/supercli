{
  "name": "gpgconf",
  "version": "0.1.0",
  "description": "GnuPG configuration tool",
  "source": "https://packages.debian.org/gpgconf",
  "checks": [{ "type": "binary", "name": "gpgconf" }],
  "install_guidance": {
    "plugin": "gpgconf", "binary": "gpgconf", "check": "which gpgconf",
    "install_steps": ["apt-get install gnupg", "Verify: gpgconf --version", "supercli plugins install ./plugins/gpgconf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gpgconf", "resource": "_", "action": "_",
    "description": "Passthrough to gpgconf CLI",
    "adapter": "process", "adapterConfig": { "command": "gpgconf", "passthrough": true, "missingDependencyHelp": "Install gpgconf: apt-get install gnupg" }, "args": []
  }]
}
