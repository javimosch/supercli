{
  "name": "awsesh",
  "version": "0.1.0",
  "description": "AWS session & credential manager",
  "source": "https://github.com/awsesh/awsesh",
  "checks": [
    {
      "type": "binary",
      "name": "awsesh"
    }
  ],
  "install_guidance": {
    "plugin": "awsesh",
    "binary": "awsesh",
    "check": "which awsesh",
    "install_steps": [
      "npm install -g awsesh",
      "Verify: awsesh --version",
      "supercli plugins install ./plugins/awsesh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awsesh",
      "resource": "self",
      "action": "version",
      "description": "Print awsesh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsesh",
        "missingDependencyHelp": "Install awsesh: npm install -g awsesh",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "awsesh",
      "resource": "session",
      "action": "list",
      "description": "List AWS sessions",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsesh",
        "missingDependencyHelp": "Install awsesh: npm install -g awsesh",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "awsesh",
      "resource": "session",
      "action": "create",
      "description": "Create a new AWS session",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsesh",
        "missingDependencyHelp": "Install awsesh: npm install -g awsesh",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "awsesh",
      "resource": "credential",
      "action": "set",
      "description": "Set AWS credentials",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsesh",
        "missingDependencyHelp": "Install awsesh: npm install -g awsesh",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "awsesh",
      "resource": "_",
      "action": "_",
      "description": "_ _ via awsesh",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsesh",
        "missingDependencyHelp": "Install awsesh: npm install -g awsesh",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
