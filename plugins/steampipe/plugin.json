{
  "name": "steampipe",
  "version": "0.1.0",
  "description": "Steampipe CLI plugin — query cloud infrastructure (AWS, GCP, Azure, GitHub, etc.) using standard SQL. Select, join, and analyze cloud resources across services.",
  "source": "https://steampipe.io/docs",
  "checks": [
    { "type": "binary", "name": "steampipe" }
  ],
  "install_guidance": {
    "plugin": "steampipe",
    "binary": "steampipe",
    "check": "which steampipe",
    "install_steps": [
      "brew install turbot/tap/steampipe",
      "Verify: steampipe --version",
      "supercli plugins install ./plugins/steampipe --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "steampipe",
      "resource": "query",
      "action": "run",
      "description": "Run a SQL query against Steampipe data sources, output as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["query", "--output", "json"],
        "positionalArgs": ["sql"],
        "parseJson": true,
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": [
        { "name": "sql", "type": "string", "required": true, "description": "SQL query string, e.g. \"SELECT * FROM aws_s3_bucket\"" },
        { "name": "--separator", "type": "string", "description": "Row separator (default: newline)" },
        { "name": "--header", "type": "boolean", "description": "Include column headers (default: true)" },
        { "name": "--timing", "type": "boolean", "description": "Show query timing info" }
      ]
    },
    {
      "namespace": "steampipe",
      "resource": "plugin",
      "action": "list",
      "description": "List all installed Steampipe plugins",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["plugin", "list"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": []
    },
    {
      "namespace": "steampipe",
      "resource": "plugin",
      "action": "install",
      "description": "Install a Steampipe plugin (e.g. steampipe plugin install aws)",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["plugin", "install"],
        "positionalArgs": ["pluginName"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": [
        { "name": "pluginName", "type": "string", "required": true, "description": "Plugin name, e.g. aws, gcp, azure, github" }
      ]
    },
    {
      "namespace": "steampipe",
      "resource": "plugin",
      "action": "uninstall",
      "description": "Uninstall a Steampipe plugin",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["plugin", "uninstall"],
        "positionalArgs": ["pluginName"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": [
        { "name": "pluginName", "type": "string", "required": true, "description": "Plugin name to remove" }
      ]
    },
    {
      "namespace": "steampipe",
      "resource": "check",
      "action": "run",
      "description": "Run a compliance benchmark or control",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["check"],
        "positionalArgs": ["benchmark"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": [
        { "name": "benchmark", "type": "string", "required": true, "description": "Benchmark or control name, e.g. cis_v130, nist_800_53_rev5" },
        { "name": "--output", "type": "string", "description": "Output format, e.g. json, text, csv" },
        { "name": "--file", "type": "string", "description": "Write output to file instead of stdout" }
      ]
    },
    {
      "namespace": "steampipe",
      "resource": "service",
      "action": "status",
      "description": "Show Steampipe service status",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["service", "status"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": []
    },
    {
      "namespace": "steampipe",
      "resource": "service",
      "action": "start",
      "description": "Start the Steampipe service",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["service", "start"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": []
    },
    {
      "namespace": "steampipe",
      "resource": "service",
      "action": "stop",
      "description": "Stop the Steampipe service",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["service", "stop"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": []
    },
    {
      "namespace": "steampipe",
      "resource": "self",
      "action": "version",
      "description": "Show Steampipe CLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": []
    },
    {
      "namespace": "steampipe",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to steampipe CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "steampipe",
        "passthrough": true,
        "missingDependencyHelp": "Install Steampipe: brew install turbot/tap/steampipe"
      },
      "args": []
    }
  ]
}
