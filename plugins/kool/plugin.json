{
  "name": "kool",
  "version": "0.1.0",
  "description": "Container-based web development environment simplified",
  "source": "https://github.com/kool-dev/kool",
  "checks": [{ "type": "binary", "name": "kool" }],
  "install_guidance": {
    "plugin": "kool",
    "binary": "kool",
    "check": "which kool",
    "install_steps": ["brew install kool", "Verify: kool --version", "supercli plugins install ./plugins/kool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kool",
      "passthrough": true,
      "missingDependencyHelp": "Install kool: brew install kool", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
