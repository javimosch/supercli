{
  "name": "semantic-router",
  "version": "0.1.0",
  "description": "System level intelligent router for Mixture-of-Models at cloud, data center and edge",
  "source": "https://github.com/vllm-project/semantic-router",
  "checks": [
    {
      "type": "binary",
      "name": "semantic-router"
    }
  ],
  "install_guidance": {
    "plugin": "semantic-router",
    "binary": "semantic-router",
    "check": "which semantic-router",
    "install_steps": [
      "go install github.com/vllm-project/semantic-router@latest",
      "Verify: semantic-router --version",
      "supercli plugins install ./plugins/semantic-router --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "semantic-router",
    "resource": "self",
    "action": "version",
    "description": "Print semantic-router version",
    "adapter": "process",
    "adapterConfig": {
      "command": "semantic-router",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install semantic-router: go install github.com/vllm-project/semantic-router@latest"
    },
    "args": []
  },
  {
    "namespace": "semantic-router",
    "resource": "router",
    "action": "start",
    "description": "Start the semantic router",
    "adapter": "process",
    "adapterConfig": {
      "command": "semantic-router",
      "passthrough": true,
      "missingDependencyHelp": "Install semantic-router: go install github.com/vllm-project/semantic-router@latest"
    },
    "args": []
  },
  {
    "namespace": "semantic-router",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to semantic-router CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "semantic-router",
      "passthrough": true,
      "missingDependencyHelp": "Install semantic-router"
    },
    "args": []
  }
]
}