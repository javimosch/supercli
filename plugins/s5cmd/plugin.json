{
  "name": "s5cmd",
  "version": "0.1.0",
  "description": "Very fast S3 and local filesystem command line tool",
  "source": "https://github.com/peak/s5cmd",
  "checks": [{ "type": "binary", "name": "s5cmd" }],
  "install_guidance": {
    "plugin": "s5cmd",
    "binary": "s5cmd",
    "check": "which s5cmd",
    "install_steps": ["brew install s5cmd", "Verify: s5cmd --version", "supercli plugins install ./plugins/s5cmd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "s5cmd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to s5cmd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "s5cmd",
      "passthrough": true,
      "missingDependencyHelp": "Install s5cmd: brew install s5cmd"
    },
    "args": []
  }]
}
