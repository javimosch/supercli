{
  "name": "oh-my-codex",
  "version": "0.1.0",
  "description": "OmX - Oh My codeX: Your codex is not alone. Add hooks, agent teams, HUDs, and so much more.",
  "source": "https://github.com/oh-my-codex/oh-my-codex",
  "checks": [
    {
      "type": "binary",
      "name": "oh-my-codex"
    }
  ],
  "install_guidance": {
    "plugin": "oh-my-codex",
    "binary": "oh-my-codex",
    "check": "which oh-my-codex",
    "install_steps": [
      "pip install oh-my-codex",
      "Verify: oh-my-codex --version",
      "supercli plugins install ./plugins/oh-my-codex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oh-my-codex",
      "resource": "self",
      "action": "version",
      "description": "Print oh-my-codex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oh-my-codex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oh-my-codex: pip install oh-my-codex"
      },
      "args": []
    },
    {
      "namespace": "oh-my-codex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oh-my-codex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oh-my-codex",
        "passthrough": true,
        "missingDependencyHelp": "Install oh-my-codex: pip install oh-my-codex"
      },
      "args": []
    }
  ]
}