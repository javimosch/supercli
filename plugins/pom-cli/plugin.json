{
  "name": "pom-cli",
  "version": "0.1.0",
  "description": "Minimal Pomodoro timer with desktop notifications",
  "source": "https://github.com/kevva/pom-cli",
  "checks": [{ "type": "binary", "name": "pom-cli" }],
  "install_guidance": {
    "plugin": "pom-cli",
    "binary": "pom-cli",
    "check": "which pom-cli",
    "install_steps": ["npm install -g pom-cli", "Verify: pom-cli --version", "supercli plugins install ./plugins/pom-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pom-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pom-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pom-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install pom-cli: npm install -g pom-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
