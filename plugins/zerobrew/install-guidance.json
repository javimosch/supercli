{
  "plugin": "zerobrew",
  "binary": "zb",
  "check": "which zb",
  "install_steps": [
    "curl -fsSL https://zerobrew.rs/install | bash",
    "Verify: zb --version",
    "supercli plugins install ./plugins/zerobrew --on-conflict replace --json"
  ],
  "note": "Also available via: brew install lucasgelfond/zerobrew/zerobrew. Supports Brewfiles for bundle installs."
}