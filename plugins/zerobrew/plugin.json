{
  "name": "zerobrew",
  "version": "0.1.0",
  "description": "A 5-20x faster experimental Homebrew alternative",
  "source": "https://github.com/zerobrew/zerobrew",
  "checks": [
    {
      "type": "binary",
      "name": "zerobrew"
    }
  ],
  "install_guidance": {
    "plugin": "zerobrew",
    "binary": "zerobrew",
    "check": "which zerobrew",
    "install_steps": [
      "pip install zerobrew",
      "Verify: zerobrew --version",
      "supercli plugins install ./plugins/zerobrew --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zerobrew",
      "resource": "self",
      "action": "version",
      "description": "Print zerobrew version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zerobrew",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zerobrew: pip install zerobrew"
      },
      "args": []
    },
    {
      "namespace": "zerobrew",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zerobrew CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zerobrew",
        "passthrough": true,
        "missingDependencyHelp": "Install zerobrew: pip install zerobrew"
      },
      "args": []
    }
  ]
}