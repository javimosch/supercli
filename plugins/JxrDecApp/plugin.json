{
  "name": "JxrDecApp",
  "version": "0.1.0",
  "description": "CLI tool: JxrDecApp",
  "source": "https://manpages.debian.org/JxrDecApp",
  "checks": [
    {
      "type": "binary",
      "name": "JxrDecApp"
    }
  ],
  "install_guidance": {
    "plugin": "JxrDecApp",
    "binary": "JxrDecApp",
    "check": "which JxrDecApp",
    "install_steps": [
      "apt-get install JxrDecApp 2>/dev/null || which JxrDecApp",
      "Verify: JxrDecApp --version",
      "supercli plugins install ./plugins/JxrDecApp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "JxrDecApp",
      "resource": "self",
      "action": "version",
      "description": "Print JxrDecApp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "JxrDecApp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install JxrDecApp: apt-get install JxrDecApp 2>/dev/null || which JxrDecApp"
      },
      "args": []
    },
    {
      "namespace": "JxrDecApp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to JxrDecApp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "JxrDecApp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install JxrDecApp: apt-get install JxrDecApp 2>/dev/null || which JxrDecApp"
      },
      "args": []
    }
  ]
}