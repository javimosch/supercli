{
  "name": "docling",
  "version": "0.1.0",
  "description": "Get your documents ready for gen AI",
  "source": "https://github.com/docling/docling",
  "checks": [
    {
      "type": "binary",
      "name": "docling"
    }
  ],
  "install_guidance": {
    "plugin": "docling",
    "binary": "docling",
    "check": "which docling",
    "install_steps": [
      "pip install docling",
      "Verify: docling --version",
      "supercli plugins install ./plugins/docling --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "docling",
      "resource": "self",
      "action": "version",
      "description": "Print docling version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docling",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docling: pip install docling"
      },
      "args": []
    },
    {
      "namespace": "docling",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docling CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docling",
        "passthrough": true,
        "missingDependencyHelp": "Install docling: pip install docling"
      },
      "args": []
    }
  ]
}