{
  "name": "pf2afm",
  "version": "0.1.0",
  "description": "CLI tool: pf2afm",
  "source": "https://manpages.debian.org/pf2afm",
  "checks": [
    {
      "type": "binary",
      "name": "pf2afm"
    }
  ],
  "install_guidance": {
    "plugin": "pf2afm",
    "binary": "pf2afm",
    "check": "which pf2afm",
    "install_steps": [
      "apt-get install pf2afm 2>/dev/null || which pf2afm",
      "Verify: pf2afm --version",
      "supercli plugins install ./plugins/pf2afm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pf2afm",
      "resource": "self",
      "action": "version",
      "description": "Print pf2afm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pf2afm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pf2afm: apt-get install pf2afm 2>/dev/null || which pf2afm"
      },
      "args": []
    },
    {
      "namespace": "pf2afm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pf2afm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pf2afm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pf2afm: apt-get install pf2afm 2>/dev/null || which pf2afm"
      },
      "args": []
    }
  ]
}