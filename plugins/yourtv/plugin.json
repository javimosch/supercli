{
  "name": "yourtv",
  "version": "0.1.0",
  "description": "\u5b89\u5353\u7535\u89c6\u76f4\u64adAPK\uff1aIPTV/\u7db2\u9801\u8996\u983b\u652f\u6301X5\uff0c\u53ef\u81ea\u5b9a\u7fa9\u6e90(\u652f\u6301webview://\u683c\u5f0f)\uff0cIPTV\u652f\u6301\u756b\u4e2d\u756b\u548c\u7184\u5c4f\u64ad\u653e\u3002 Android TV Live APK: IPTV/web video su",
  "source": "https://github.com/yourtv/yourtv",
  "checks": [
    {
      "type": "binary",
      "name": "yourtv"
    }
  ],
  "install_guidance": {
    "plugin": "yourtv",
    "binary": "yourtv",
    "check": "which yourtv",
    "install_steps": [
      "pip install yourtv",
      "Verify: yourtv --version",
      "supercli plugins install ./plugins/yourtv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yourtv",
      "resource": "self",
      "action": "version",
      "description": "Print yourtv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yourtv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yourtv: pip install yourtv"
      },
      "args": []
    },
    {
      "namespace": "yourtv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yourtv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yourtv",
        "passthrough": true,
        "missingDependencyHelp": "Install yourtv: pip install yourtv"
      },
      "args": []
    }
  ]
}