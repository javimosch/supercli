{
  "name": "RecoverPy",
  "version": "0.1.0",
  "description": "Recover overwritten or deleted files",
  "source": "https://github.com/PabloLec/RecoverPy",
  "checks": [
    {
      "type": "binary",
      "name": "RecoverPy"
    }
  ],
  "install_guidance": {
    "plugin": "RecoverPy",
    "binary": "RecoverPy",
    "check": "which RecoverPy",
    "install_steps": [
      "brew install RecoverPy",
      "Verify: RecoverPy --version",
      "supercli plugins install ./plugins/RecoverPy --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "RecoverPy",
      "resource": "self",
      "action": "version",
      "description": "Print RecoverPy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "RecoverPy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RecoverPy: brew install RecoverPy"
      },
      "args": []
    },
    {
      "namespace": "RecoverPy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to RecoverPy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "RecoverPy",
        "passthrough": true,
        "missingDependencyHelp": "Install RecoverPy"
      },
      "args": []
    }
  ]
}