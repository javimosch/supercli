{
  "name": "last30days-skill",
  "version": "0.1.0",
  "description": "AI agent skill that researches any topic across Reddit, X, YouTube, HN, Polymarket, and the web - th",
  "source": "https://github.com/last30days-skill/last30days-skill",
  "checks": [
    {
      "type": "binary",
      "name": "last30days-skill"
    }
  ],
  "install_guidance": {
    "plugin": "last30days-skill",
    "binary": "last30days-skill",
    "check": "which last30days-skill",
    "install_steps": [
      "pip install last30days-skill",
      "Verify: last30days-skill --version",
      "supercli plugins install ./plugins/last30days-skill --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "last30days-skill",
      "resource": "self",
      "action": "version",
      "description": "Print last30days-skill version",
      "adapter": "process",
      "adapterConfig": {
        "command": "last30days-skill",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install last30days-skill: pip install last30days-skill"
      },
      "args": []
    },
    {
      "namespace": "last30days-skill",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to last30days-skill CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "last30days-skill",
        "passthrough": true,
        "missingDependencyHelp": "Install last30days-skill: pip install last30days-skill"
      },
      "args": []
    }
  ]
}