{
  "name": "yu-ai-code-mother",
  "version": "0.1.0",
  "description": "\u7f16\u7a0b\u5bfc\u822a AI + \u5fae\u670d\u52a1\u5168\u6808\u65b0\u9879\u76ee\uff0c\u57fa\u4e8e Spring Boot 3 + LangChain4j \u7684\u5927\u5382 AI \u5e94\u7528\u751f\u6210\u5e73\u53f0\uff0c\u652f\u6301\u591a\u79cd\u6a21\u5f0f\u7684\u667a\u80fd\u4ee3\u7801\u751f\u6210\u3001\u53ef\u89c6\u5316\u7f16\u8f91\u9884\u89c8\u3001\u4e00\u952e\u90e8\u7f72\u5206\u4eab\u3001\u5e94\u7528\u7ba1\u7406\u3001AI",
  "source": "https://github.com/yu-ai-code-mother/yu-ai-code-mother",
  "checks": [
    {
      "type": "binary",
      "name": "yu-ai-code-mother"
    }
  ],
  "install_guidance": {
    "plugin": "yu-ai-code-mother",
    "binary": "yu-ai-code-mother",
    "check": "which yu-ai-code-mother",
    "install_steps": [
      "pip install yu-ai-code-mother",
      "Verify: yu-ai-code-mother --version",
      "supercli plugins install ./plugins/yu-ai-code-mother --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "yu-ai-code-mother",
      "resource": "self",
      "action": "version",
      "description": "Print yu-ai-code-mother version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yu-ai-code-mother",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yu-ai-code-mother: pip install yu-ai-code-mother"
      },
      "args": []
    },
    {
      "namespace": "yu-ai-code-mother",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yu-ai-code-mother CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yu-ai-code-mother",
        "passthrough": true,
        "missingDependencyHelp": "Install yu-ai-code-mother: pip install yu-ai-code-mother"
      },
      "args": []
    }
  ]
}