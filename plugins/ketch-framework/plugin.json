{
  "name": "ketch-framework",
  "version": "0.1.0",
  "description": "Framework for building Kubernetes-native platforms",
  "source": "https://github.com/search/ketch-framework",
  "checks": [{ "type": "binary", "name": "ketch-framework" }],
  "install_guidance": {
    "plugin": "ketch-framework",
    "binary": "ketch-framework",
    "check": "which ketch-framework",
    "install_steps": ["brew install ketch-framework", "Verify: ketch-framework --version", "supercli plugins install ./plugins/ketch-framework --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ketch-framework",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ketch-framework CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ketch-framework",
      "passthrough": true,
      "missingDependencyHelp": "Install ketch-framework: brew install ketch-framework"
    },
    "args": []
  }]
}
