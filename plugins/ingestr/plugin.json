{
  "name": "ingestr",
  "version": "0.1.0",
  "description": "Copy and sync data between databases and storage systems",
  "source": "https://github.com/nicholasgasior/ingestr",
  "checks": [
    {
      "type": "binary",
      "name": "ingestr"
    }
  ],
  "install_guidance": {
    "plugin": "ingestr",
    "binary": "ingestr",
    "check": "which ingestr",
    "install_steps": [
      "pip install ingestr",
      "Verify: ingestr --version",
      "supercli plugins install ./plugins/ingestr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ingestr",
      "resource": "self",
      "action": "version",
      "description": "Print ingestr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ingestr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ingestr: pip install ingestr"
      },
      "args": []
    },
    {
      "namespace": "ingestr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ingestr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ingestr",
        "passthrough": true,
        "missingDependencyHelp": "Install ingestr: pip install ingestr"
      },
      "args": []
    }
  ]
}
