{
  "name": "clidex",
  "version": "0.1.0",
  "description": "CLI tool discovery for AI agents — search, compare, and install 440+ tools",
  "source": "https://github.com/syshin0116/clidex",
  "checks": [
    {
      "type": "binary",
      "name": "clidex"
    }
  ],
  "install_guidance": {
    "plugin": "clidex",
    "binary": "clidex",
    "check": "which clidex",
    "install_steps": [
      "cargo install clidex",
      "Verify: clidex --version",
      "supercli plugins install ./plugins/clidex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clidex",
      "resource": "self",
      "action": "version",
      "description": "Print clidex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clidex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clidex: cargo install clidex"
      },
      "args": []
    },
    {
      "namespace": "clidex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clidex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clidex",
        "passthrough": true,
        "missingDependencyHelp": "Install clidex: cargo install clidex"
      },
      "args": []
    }
  ]
}
