{
  "name": "biostream",
  "version": "0.1.0",
  "description": "Stream-based bioinformatics data processing pipeline",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "biostream" }],
  "install_guidance": {
    "plugin": "biostream",
    "binary": "biostream",
    "check": "which biostream",
    "install_steps": ["git clone && make", "Verify: biostream --version", "supercli plugins install ./plugins/biostream --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "biostream",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to biostream CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "biostream",
      "passthrough": true,
      "missingDependencyHelp": "Install biostream: git clone && make"
    },
    "args": []
  }]
}
