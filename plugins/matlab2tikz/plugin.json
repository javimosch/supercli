{
  "name": "matlab2tikz",
  "version": "0.1.0",
  "description": "Convert MATLAB(R) figures into TikZ/Pgfplots figures",
  "source": "https://github.com/matlab2tikz/matlab2tikz",
  "checks": [
    {
      "type": "binary",
      "name": "matlab2tikz"
    }
  ],
  "install_guidance": {
    "plugin": "matlab2tikz",
    "binary": "matlab2tikz",
    "check": "which matlab2tikz",
    "install_steps": [
      "brew install matlab2tikz",
      "Verify: matlab2tikz --version",
      "supercli plugins install ./plugins/matlab2tikz --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "matlab2tikz",
      "resource": "self",
      "action": "version",
      "description": "Print matlab2tikz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "matlab2tikz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install matlab2tikz: brew install matlab2tikz"
      },
      "args": []
    },
    {
      "namespace": "matlab2tikz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to matlab2tikz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "matlab2tikz",
        "passthrough": true,
        "missingDependencyHelp": "Install matlab2tikz"
      },
      "args": []
    }
  ]
}