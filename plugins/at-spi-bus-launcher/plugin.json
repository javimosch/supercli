{
  "name": "at-spi-bus-launcher",
  "version": "0.1.0",
  "description": "CLI tool: at-spi-bus-launcher",
  "source": "https://packages.debian.org/at-spi-bus-launcher",
  "checks": [{ "type": "binary", "name": "at-spi-bus-launcher" }],
  "install_guidance": {
    "plugin": "at-spi-bus-launcher", "binary": "at-spi-bus-launcher", "check": "which at-spi-bus-launcher",
    "install_steps": ["apt-get install at-spi-bus-launcher 2>/dev/null || which at-spi-bus-launcher", "Verify: at-spi-bus-launcher --version", "supercli plugins install ./plugins/at-spi-bus-launcher --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-spi-bus-launcher", "resource": "_", "action": "_",
    "description": "Passthrough to at-spi-bus-launcher CLI",
    "adapter": "process", "adapterConfig": { "command": "at-spi-bus-launcher", "passthrough": true, "missingDependencyHelp": "Install at-spi-bus-launcher: apt-get install at-spi-bus-launcher" }, "args": []
  }]
}
