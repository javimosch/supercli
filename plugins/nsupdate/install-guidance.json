{
  "plugin": "nsupdate",
  "binary": "nsupdate",
  "check": "which nsupdate",
  "install_steps": [
    "apt-get install nsupdate 2>/dev/null || which nsupdate",
    "Verify: nsupdate --version",
    "supercli plugins install ./plugins/nsupdate --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}