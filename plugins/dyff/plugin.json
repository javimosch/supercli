    { "namespace": "dyff", "resource": "self", "action": "version", "description": "Print dyff version", "adapter": "process", "adapterConfig": { "command": "dyff", "baseArgs": ["version"], "missingDependencyHelp": "Install dyff: brew install dyff" }, "args": [] },
    { "namespace": "dyff", "resource": "_", "action": "_", "description": "Passthrough to dyff CLI", "adapter": "process", "adapterConfig": { "command": "dyff", "passthrough": true, "missingDependencyHelp": "Install dyff: brew install dyff" }, "args": [] }
  ]
}
