{
  "name": "dyff",
  "version": "0.1.0",
  "description": "A diff tool for YAML and JSON files with color-coded structural difference output. Supports pipeline operations and machine-readable output.",
  "source": "https://github.com/homeport/dyff",
  "checks": [{ "type": "binary", "name": "dyff" }],
  "install_guidance": {
    "plugin": "dyff",
    "binary": "dyff",
    "check": "which dyff",
    "install_steps": ["brew install dyff", "Verify: dyff version", "supercli plugins install ./plugins/dyff --on-conflict replace --json"]
  },
