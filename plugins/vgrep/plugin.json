{
  "name": "vgrep",
  "version": "0.1.0",
  "description": "User-friendly pager for grep.",
  "source": "https://github.com/vrothberg/vgrep",
  "checks": [
    {
      "type": "binary",
      "name": "vgrep"
    }
  ],
  "install_guidance": {
    "plugin": "vgrep",
    "binary": "vgrep",
    "check": "which vgrep",
    "install_steps": [
      "brew install vgrep",
      "Verify: vgrep --version",
      "supercli plugins install ./plugins/vgrep --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "vgrep",
      "resource": "self",
      "action": "version",
      "description": "Print vgrep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgrep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vgrep: brew install vgrep"
      },
      "args": []
    },
    {
      "namespace": "vgrep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vgrep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vgrep",
        "passthrough": true,
        "missingDependencyHelp": "Install vgrep"
      },
      "args": []
    }
  ]
}