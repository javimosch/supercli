{
  "name": "mousetweaks",
  "version": "0.1.0",
  "description": "CLI tool: mousetweaks",
  "source": "https://manpages.debian.org/mousetweaks",
  "checks": [
    {
      "type": "binary",
      "name": "mousetweaks"
    }
  ],
  "install_guidance": {
    "plugin": "mousetweaks",
    "binary": "mousetweaks",
    "check": "which mousetweaks",
    "install_steps": [
      "apt-get install mousetweaks 2>/dev/null || which mousetweaks",
      "Verify: mousetweaks --version",
      "supercli plugins install ./plugins/mousetweaks --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mousetweaks",
      "resource": "self",
      "action": "version",
      "description": "Print mousetweaks version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mousetweaks",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mousetweaks: apt-get install mousetweaks 2>/dev/null || which mousetweaks"
      },
      "args": []
    },
    {
      "namespace": "mousetweaks",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mousetweaks CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mousetweaks",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mousetweaks: apt-get install mousetweaks 2>/dev/null || which mousetweaks"
      },
      "args": []
    }
  ]
}