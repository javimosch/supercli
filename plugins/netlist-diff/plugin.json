{
  "name": "netlist-diff",
  "version": "0.1.0",
  "description": "Compare two electronic circuit netlists and report differences",
  "source": "go",
  "checks": [{ "type": "binary", "name": "netlist-diff" }],
  "install_guidance": {
    "plugin": "netlist-diff",
    "binary": "netlist-diff",
    "check": "which netlist-diff",
    "install_steps": ["go install github.com/netlist-diff@latest", "Verify: netlist-diff --version", "supercli plugins install ./plugins/netlist-diff --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "netlist-diff",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to netlist-diff CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "netlist-diff",
      "passthrough": true,
      "missingDependencyHelp": "Install netlist-diff: go install github.com/netlist-diff@latest"
    },
    "args": []
  }]
}
