{
  "name": "hayagriva",
  "version": "0.1.0",
  "description": "Bibliography management tool",
  "source": "https://github.com/typst/hayagriva",
  "checks": [
    {
      "type": "binary",
      "name": "hayagriva"
    }
  ],
  "install_guidance": {
    "plugin": "hayagriva",
    "binary": "hayagriva",
    "check": "which hayagriva",
    "install_steps": [
      "brew install hayagriva",
      "Verify: hayagriva --version",
      "supercli plugins install ./plugins/hayagriva --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hayagriva",
      "resource": "self",
      "action": "version",
      "description": "Print hayagriva version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hayagriva",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hayagriva: brew install hayagriva"
      },
      "args": []
    },
    {
      "namespace": "hayagriva",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hayagriva CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hayagriva",
        "passthrough": true,
        "missingDependencyHelp": "Install hayagriva"
      },
      "args": []
    }
  ]
}