{
  "name": "TrendRadar",
  "version": "0.1.0",
  "description": "\u2b50AI-driven public opinion & trend monitor with multi-platform aggregation, RSS, and smart alerts.\ud83c\udfaf \u544a",
  "source": "https://github.com/TrendRadar/TrendRadar",
  "checks": [
    {
      "type": "binary",
      "name": "trendradar"
    }
  ],
  "install_guidance": {
    "plugin": "TrendRadar",
    "binary": "trendradar",
    "check": "which trendradar",
    "install_steps": [
      "pip install trendradar",
      "Verify: trendradar --version",
      "supercli plugins install ./plugins/TrendRadar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TrendRadar",
      "resource": "self",
      "action": "version",
      "description": "Print TrendRadar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trendradar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TrendRadar: pip install trendradar"
      },
      "args": []
    },
    {
      "namespace": "TrendRadar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trendradar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trendradar",
        "passthrough": true,
        "missingDependencyHelp": "Install TrendRadar: pip install trendradar"
      },
      "args": []
    }
  ]
}