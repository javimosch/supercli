{
  "name": "kubectl-ai",
  "version": "0.1.0",
  "description": "AI powered Kubernetes Assistant",
  "source": "https://github.com/kubectl-ai/kubectl-ai",
  "checks": [
    {
      "type": "binary",
      "name": "kubectl-ai"
    }
  ],
  "install_guidance": {
    "plugin": "kubectl-ai",
    "binary": "kubectl-ai",
    "check": "which kubectl-ai",
    "install_steps": [
      "pip install kubectl-ai",
      "Verify: kubectl-ai --version",
      "supercli plugins install ./plugins/kubectl-ai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kubectl-ai",
      "resource": "self",
      "action": "version",
      "description": "Print kubectl-ai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubectl-ai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kubectl-ai: pip install kubectl-ai"
      },
      "args": []
    },
    {
      "namespace": "kubectl-ai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kubectl-ai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kubectl-ai",
        "passthrough": true,
        "missingDependencyHelp": "Install kubectl-ai: pip install kubectl-ai"
      },
      "args": []
    }
  ]
}