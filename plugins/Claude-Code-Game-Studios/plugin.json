{
  "name": "Claude-Code-Game-Studios",
  "version": "0.1.0",
  "description": "Turn Claude Code into a full game dev studio \u2014 49 AI agents, 72 workflow skills, and a complete coor",
  "source": "https://github.com/Claude-Code-Game-Studios/Claude-Code-Game-Studios",
  "checks": [
    {
      "type": "binary",
      "name": "claude-code-game-studios"
    }
  ],
  "install_guidance": {
    "plugin": "Claude-Code-Game-Studios",
    "binary": "claude-code-game-studios",
    "check": "which claude-code-game-studios",
    "install_steps": [
      "pip install claude-code-game-studios",
      "Verify: claude-code-game-studios --version",
      "supercli plugins install ./plugins/Claude-Code-Game-Studios --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Claude-Code-Game-Studios",
      "resource": "self",
      "action": "version",
      "description": "Print Claude-Code-Game-Studios version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-game-studios",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Claude-Code-Game-Studios: pip install claude-code-game-studios"
      },
      "args": []
    },
    {
      "namespace": "Claude-Code-Game-Studios",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-code-game-studios CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-code-game-studios",
        "passthrough": true,
        "missingDependencyHelp": "Install Claude-Code-Game-Studios: pip install claude-code-game-studios"
      },
      "args": []
    }
  ]
}