{
  "name": "setxkbmap",
  "version": "0.1.0",
  "description": "CLI tool: setxkbmap",
  "source": "https://manpages.debian.org/setxkbmap",
  "checks": [
    {
      "type": "binary",
      "name": "setxkbmap"
    }
  ],
  "install_guidance": {
    "plugin": "setxkbmap",
    "binary": "setxkbmap",
    "check": "which setxkbmap",
    "install_steps": [
      "apt-get install setxkbmap 2>/dev/null || which setxkbmap",
      "Verify: setxkbmap --version",
      "supercli plugins install ./plugins/setxkbmap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "setxkbmap",
      "resource": "self",
      "action": "version",
      "description": "Print setxkbmap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "setxkbmap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install setxkbmap: apt-get install setxkbmap 2>/dev/null || which setxkbmap"
      },
      "args": []
    },
    {
      "namespace": "setxkbmap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to setxkbmap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "setxkbmap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install setxkbmap: apt-get install setxkbmap 2>/dev/null || which setxkbmap"
      },
      "args": []
    }
  ]
}