{
  "name": "libqt6zig",
  "version": "0.1.0",
  "description": "Qt 6 for Zig",
  "source": "https://github.com/libqt6zig/libqt6zig",
  "checks": [
    {
      "type": "binary",
      "name": "libqt6zig"
    }
  ],
  "install_guidance": {
    "plugin": "libqt6zig",
    "binary": "libqt6zig",
    "check": "which libqt6zig",
    "install_steps": [
      "pip install libqt6zig",
      "Verify: libqt6zig --version",
      "supercli plugins install ./plugins/libqt6zig --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "libqt6zig",
      "resource": "self",
      "action": "version",
      "description": "Print libqt6zig version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libqt6zig",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libqt6zig: pip install libqt6zig"
      },
      "args": []
    },
    {
      "namespace": "libqt6zig",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libqt6zig CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libqt6zig",
        "passthrough": true,
        "missingDependencyHelp": "Install libqt6zig: pip install libqt6zig"
      },
      "args": []
    }
  ]
}