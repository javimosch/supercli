{
  "name": "mako-render",
  "version": "0.1.0",
  "description": "CLI tool: mako-render",
  "source": "https://manpages.debian.org/mako-render",
  "checks": [
    {
      "type": "binary",
      "name": "mako-render"
    }
  ],
  "install_guidance": {
    "plugin": "mako-render",
    "binary": "mako-render",
    "check": "which mako-render",
    "install_steps": [
      "apt-get install mako-render 2>/dev/null || which mako-render",
      "Verify: mako-render --version",
      "supercli plugins install ./plugins/mako-render --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mako-render",
      "resource": "self",
      "action": "version",
      "description": "Print mako-render version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mako-render",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mako-render: apt-get install mako-render 2>/dev/null || which mako-render"
      },
      "args": []
    },
    {
      "namespace": "mako-render",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mako-render CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mako-render",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mako-render: apt-get install mako-render 2>/dev/null || which mako-render"
      },
      "args": []
    }
  ]
}