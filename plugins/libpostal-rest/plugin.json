{
  "name": "libpostal-rest",
  "version": "0.1.0",
  "description": "REST API for libpostal",
  "source": "https://github.com/johnlonganecker/libpostal-rest",
  "checks": [
    {
      "type": "binary",
      "name": "libpostal-rest"
    }
  ],
  "install_guidance": {
    "plugin": "libpostal-rest",
    "binary": "libpostal-rest",
    "check": "which libpostal-rest",
    "install_steps": [
      "brew install libpostal-rest",
      "Verify: libpostal-rest --version",
      "supercli plugins install ./plugins/libpostal-rest --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libpostal-rest",
      "resource": "self",
      "action": "version",
      "description": "Print libpostal-rest version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libpostal-rest",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libpostal-rest: brew install libpostal-rest"
      },
      "args": []
    },
    {
      "namespace": "libpostal-rest",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libpostal-rest CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libpostal-rest",
        "passthrough": true,
        "missingDependencyHelp": "Install libpostal-rest"
      },
      "args": []
    }
  ]
}