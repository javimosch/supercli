{
  "name": "WritingTools",
  "version": "0.1.0",
  "description": "The world's smartest system-wide grammar assistant; a better version of the Apple Intelligence Writi",
  "source": "https://github.com/WritingTools/WritingTools",
  "checks": [
    {
      "type": "binary",
      "name": "writingtools"
    }
  ],
  "install_guidance": {
    "plugin": "WritingTools",
    "binary": "writingtools",
    "check": "which writingtools",
    "install_steps": [
      "pip install writingtools",
      "Verify: writingtools --version",
      "supercli plugins install ./plugins/WritingTools --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "WritingTools",
      "resource": "self",
      "action": "version",
      "description": "Print WritingTools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "writingtools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install WritingTools: pip install writingtools"
      },
      "args": []
    },
    {
      "namespace": "WritingTools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to writingtools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "writingtools",
        "passthrough": true,
        "missingDependencyHelp": "Install WritingTools: pip install writingtools"
      },
      "args": []
    }
  ]
}