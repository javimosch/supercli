{
  "name": "eksctl-io",
  "version": "0.1.0",
  "description": "Official CLI for Amazon EKS cluster creation and management",
  "source": "https://github.com/weaveworks/eksctl",
  "checks": [{ "type": "binary", "name": "eksctl" }],
  "install_guidance": {
    "plugin": "eksctl-io",
    "binary": "eksctl",
    "check": "which eksctl",
    "install_steps": ["brew install eksctl", "Verify: eksctl --version", "supercli plugins install ./plugins/eksctl-io --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "eksctl-io",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to eksctl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "eksctl",
      "passthrough": true,
      "missingDependencyHelp": "Install eksctl-io: brew install eksctl"
    },
    "args": []
  }]
}
