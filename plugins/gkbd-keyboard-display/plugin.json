{
  "name": "gkbd-keyboard-display",
  "version": "0.1.0",
  "description": "CLI tool: gkbd-keyboard-display",
  "source": "https://manpages.debian.org/gkbd-keyboard-display",
  "checks": [
    {
      "type": "binary",
      "name": "gkbd-keyboard-display"
    }
  ],
  "install_guidance": {
    "plugin": "gkbd-keyboard-display",
    "binary": "gkbd-keyboard-display",
    "check": "which gkbd-keyboard-display",
    "install_steps": [
      "apt-get install gkbd-keyboard-display 2>/dev/null || which gkbd-keyboard-display",
      "Verify: gkbd-keyboard-display --version",
      "supercli plugins install ./plugins/gkbd-keyboard-display --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gkbd-keyboard-display",
      "resource": "self",
      "action": "version",
      "description": "Print gkbd-keyboard-display version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gkbd-keyboard-display",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gkbd-keyboard-display: apt-get install gkbd-keyboard-display 2>/dev/null || which gkbd-keyboard-display"
      },
      "args": []
    },
    {
      "namespace": "gkbd-keyboard-display",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gkbd-keyboard-display CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gkbd-keyboard-display",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gkbd-keyboard-display: apt-get install gkbd-keyboard-display 2>/dev/null || which gkbd-keyboard-display"
      },
      "args": []
    }
  ]
}