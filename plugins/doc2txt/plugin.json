{
  "name": "doc2txt",
  "version": "1.0.0",
  "description": "doc2txt \u2014 Doc to text converter",
  "source": "github.com/danpla/doc2txt",
  "checks": [
    {
      "type": "binary",
      "name": "doc2txt"
    }
  ],
  "install_guidance": {
    "plugin": "doc2txt",
    "binary": "doc2txt",
    "check": "which doc2txt",
    "install_steps": [
      "# Install doc2txt",
      "# See github.com/danpla/doc2txt",
      "# apt: sudo apt-get install doc2txt",
      "# brew: brew install doc2txt",
      "# cargo: cargo install doc2txt",
      "# npm: npm install -g doc2txt",
      "# pip: pip install doc2txt"
    ]
  },
  "commands": [
    {
      "namespace": "doc2txt",
      "resource": "doc2txt",
      "action": "run",
      "description": "Run doc2txt",
      "adapter": "process",
      "adapterConfig": {
        "command": "doc2txt",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doc2txt from github.com/danpla/doc2txt"
      },
      "args": []
    }
  ]
}