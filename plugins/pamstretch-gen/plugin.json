{
  "name": "pamstretch-gen",
  "version": "0.1.0",
  "description": "CLI tool: pamstretch-gen",
  "source": "https://manpages.debian.org/pamstretch-gen",
  "checks": [
    {
      "type": "binary",
      "name": "pamstretch-gen"
    }
  ],
  "install_guidance": {
    "plugin": "pamstretch-gen",
    "binary": "pamstretch-gen",
    "check": "which pamstretch-gen",
    "install_steps": [
      "apt-get install pamstretch-gen 2>/dev/null || which pamstretch-gen",
      "Verify: pamstretch-gen --version",
      "supercli plugins install ./plugins/pamstretch-gen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pamstretch-gen",
      "resource": "self",
      "action": "version",
      "description": "Print pamstretch-gen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pamstretch-gen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pamstretch-gen: apt-get install pamstretch-gen 2>/dev/null || which pamstretch-gen"
      },
      "args": []
    },
    {
      "namespace": "pamstretch-gen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pamstretch-gen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pamstretch-gen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pamstretch-gen: apt-get install pamstretch-gen 2>/dev/null || which pamstretch-gen"
      },
      "args": []
    }
  ]
}