{
  "name": "sl",
  "version": "0.1.0",
  "description": "Steam locomotive animation for the terminal",
  "source": "https://packages.debian.org/sl",
  "checks": [
    { "type": "binary", "name": "sl" }
  ],
  "install_guidance": {
    "plugin": "sl",
    "binary": "sl",
    "check": "which sl",
    "install_steps": [
      "apt-get install sl",
      "Verify: sl --version",
      "supercli plugins install ./plugins/sl --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "sl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sl",
        "passthrough": true,
        "missingDependencyHelp": "Install sl: apt-get install sl"
      },
      "args": []
    }
  ]
}
