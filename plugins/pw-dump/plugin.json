{
  "name": "pw-dump",
  "version": "0.1.0",
  "description": "CLI tool: pw-dump",
  "source": "https://manpages.debian.org/pw-dump",
  "checks": [
    {
      "type": "binary",
      "name": "pw-dump"
    }
  ],
  "install_guidance": {
    "plugin": "pw-dump",
    "binary": "pw-dump",
    "check": "which pw-dump",
    "install_steps": [
      "apt-get install pw-dump 2>/dev/null || which pw-dump",
      "Verify: pw-dump --version",
      "supercli plugins install ./plugins/pw-dump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pw-dump",
      "resource": "self",
      "action": "version",
      "description": "Print pw-dump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pw-dump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pw-dump: apt-get install pw-dump 2>/dev/null || which pw-dump"
      },
      "args": []
    },
    {
      "namespace": "pw-dump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pw-dump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pw-dump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pw-dump: apt-get install pw-dump 2>/dev/null || which pw-dump"
      },
      "args": []
    }
  ]
}