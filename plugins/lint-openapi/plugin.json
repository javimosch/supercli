{
  "name": "lint-openapi",
  "version": "0.1.0",
  "description": "lint-openapi — OpenAPI/Swagger specification linter with configurable rulesets. Validates API documentation for consistency, completeness, and adherence to OpenAPI standards. Supports Swagger 2.0, OpenAPI 3.0, and OpenAPI 3.1 specs with JSON/YAML output.",
  "source": "https://github.com/Redocly/redocly-cli",
  "checks": [
    {
      "type": "binary",
      "name": "lint-openapi"
    }
  ],
  "install_guidance": {
    "plugin": "lint-openapi",
    "binary": "lint-openapi",
    "check": "which lint-openapi",
    "install_steps": [
      "npm install -g lint-openapi",
      "Verify: lint-openapi --version",
      "supercli plugins install ./plugins/lint-openapi --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "lint-openapi",
      "resource": "self",
      "action": "version",
      "description": "Print lint-openapi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lint-openapi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lint-openapi: npm install -g lint-openapi"
      },
      "args": []
    },
    {
      "namespace": "lint-openapi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lint-openapi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lint-openapi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lint-openapi: npm install -g lint-openapi"
      },
      "args": []
    }
  ]
}
