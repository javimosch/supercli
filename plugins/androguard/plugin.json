{
  "name": "androguard",
  "version": "0.1.0",
  "description": "Android application analysis tool with --json",
  "source": "https://github.com/androguard/androguard",
  "checks": [
    {
      "type": "binary",
      "name": "androguard"
    }
  ],
  "install_guidance": {
    "plugin": "androguard",
    "binary": "androguard",
    "check": "which androguard",
    "install_steps": [
      "pip install androguard",
      "Verify: androguard --version",
      "supercli plugins install ./plugins/androguard --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "androguard",
      "resource": "self",
      "action": "version",
      "description": "Print androguard version",
      "adapter": "process",
      "adapterConfig": {
        "command": "androguard",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install androguard: pip install androguard"
      },
      "args": []
    },
    {
      "namespace": "androguard",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to androguard CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "androguard",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install androguard: pip install androguard"
      },
      "args": []
    }
  ]
}
