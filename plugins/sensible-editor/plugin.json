{
  "name": "sensible-editor",
  "version": "0.1.0",
  "description": "CLI tool: sensible-editor",
  "source": "https://manpages.debian.org/sensible-editor",
  "checks": [
    {
      "type": "binary",
      "name": "sensible-editor"
    }
  ],
  "install_guidance": {
    "plugin": "sensible-editor",
    "binary": "sensible-editor",
    "check": "which sensible-editor",
    "install_steps": [
      "apt-get install sensible-editor 2>/dev/null || which sensible-editor",
      "Verify: sensible-editor --version",
      "supercli plugins install ./plugins/sensible-editor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sensible-editor",
      "resource": "self",
      "action": "version",
      "description": "Print sensible-editor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sensible-editor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sensible-editor: apt-get install sensible-editor 2>/dev/null || which sensible-editor"
      },
      "args": []
    },
    {
      "namespace": "sensible-editor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sensible-editor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sensible-editor",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sensible-editor: apt-get install sensible-editor 2>/dev/null || which sensible-editor"
      },
      "args": []
    }
  ]
}