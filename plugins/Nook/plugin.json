{
  "name": "Nook",
  "version": "0.1.0",
  "description": "A new browser, not owned by Atlassian.",
  "source": "https://github.com/Nook/Nook",
  "checks": [
    {
      "type": "binary",
      "name": "nook"
    }
  ],
  "install_guidance": {
    "plugin": "Nook",
    "binary": "nook",
    "check": "which nook",
    "install_steps": [
      "pip install nook",
      "Verify: nook --version",
      "supercli plugins install ./plugins/Nook --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Nook",
      "resource": "self",
      "action": "version",
      "description": "Print Nook version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nook",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Nook: pip install nook"
      },
      "args": []
    },
    {
      "namespace": "Nook",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nook CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nook",
        "passthrough": true,
        "missingDependencyHelp": "Install Nook: pip install nook"
      },
      "args": []
    }
  ]
}