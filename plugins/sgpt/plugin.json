{
  "name": "sgpt",
  "version": "0.1.0",
  "description": "ShellGPT — LLM-powered command generation in terminal",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "sgpt" }],
  "install_guidance": {
    "plugin": "sgpt",
    "binary": "sgpt",
    "check": "which sgpt",
    "install_steps": ["pip install shell-gpt", "which sgpt", "Verify: sgpt --version", "supercli plugins install ./plugins/sgpt --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sgpt",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sgpt CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sgpt",
      "passthrough": true,
      "missingDependencyHelp": "Install sgpt: pip install shell-gpt"
    },
    "args": []
  }]
}
