{
  "name": "cli-toolkit",
  "version": "0.1.0",
  "description": "A curated collection of CLI utilities for developers. Provides common command-line operations for file processing, text manipulation, and system tasks.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "cli-toolkit"
    }
  ],
  "install_guidance": {
    "plugin": "cli-toolkit",
    "binary": "cli-toolkit",
    "check": "which cli-toolkit",
    "install_steps": [
      "cargo install cli-toolkit",
      "Verify: cli-toolkit --version",
      "supercli plugins install ./plugins/cli-toolkit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cli-toolkit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli-toolkit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli-toolkit",
        "passthrough": true,
        "missingDependencyHelp": "Install cli-toolkit: cargo install cli-toolkit"
      },
      "args": []
    }
  ]
}
