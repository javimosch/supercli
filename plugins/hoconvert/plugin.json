{
  "name": "hoconvert",
  "version": "0.1.0",
  "description": "HOCON to JSON/YAML/TOML format converter",
  "source": "https://github.com/johnmickle/hoconvert",
  "checks": [
    {
      "type": "binary",
      "name": "hoconvert"
    }
  ],
  "install_guidance": {
    "plugin": "hoconvert",
    "binary": "hoconvert",
    "check": "which hoconvert",
    "install_steps": [
      "cargo install hoconvert",
      "Verify: hoconvert --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hoconvert",
      "resource": "self",
      "action": "version",
      "description": "Print hoconvert version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hoconvert",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install hoconvert: cargo install hoconvert"
      },
      "args": []
    },
    {
      "namespace": "hoconvert",
      "resource": "file",
      "action": "convert",
      "description": "Convert HOCON files to JSON, YAML, or TOML format",
      "adapter": "process",
      "adapterConfig": {
        "command": "hoconvert",
        "baseArgs": ["--cwd", "invoke_cwd"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install hoconvert: cargo install hoconvert"
      },
      "args": []
    },
    {
      "namespace": "hoconvert",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hoconvert CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hoconvert",
        "passthrough": true,
        "missingDependencyHelp": "Install hoconvert: cargo install hoconvert"
      },
      "args": []
    }
  ]
}