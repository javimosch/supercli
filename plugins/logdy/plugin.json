{
  "name": "logdy",
  "version": "0.1.0",
  "description": "Web-based log viewer with filtering and search",
  "source": "https://github.com/logdyhq/logdy-core",
  "checks": [{ "type": "binary", "name": "logdy" }],
  "install_guidance": {
    "plugin": "logdy",
    "binary": "logdy",
    "check": "which logdy",
    "install_steps": ["brew install logdy", "Verify: logdy --version", "supercli plugins install ./plugins/logdy --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "logdy",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to logdy CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "logdy",
      "passthrough": true,
      "missingDependencyHelp": "Install logdy: brew install logdy", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
