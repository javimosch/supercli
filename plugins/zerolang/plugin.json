{
  "name": "zerolang",
  "version": "0.1.0",
  "description": "The programming language for agents",
  "source": "https://github.com/zerolang/zerolang",
  "checks": [
    {
      "type": "binary",
      "name": "zerolang"
    }
  ],
  "install_guidance": {
    "plugin": "zerolang",
    "binary": "zerolang",
    "check": "which zerolang",
    "install_steps": [
      "pip install zerolang",
      "Verify: zerolang --version",
      "supercli plugins install ./plugins/zerolang --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zerolang",
      "resource": "self",
      "action": "version",
      "description": "Print zerolang version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zerolang",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zerolang: pip install zerolang"
      },
      "args": []
    },
    {
      "namespace": "zerolang",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zerolang CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zerolang",
        "passthrough": true,
        "missingDependencyHelp": "Install zerolang: pip install zerolang"
      },
      "args": []
    }
  ]
}