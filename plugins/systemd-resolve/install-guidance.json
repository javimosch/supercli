{
  "plugin": "systemd-resolve",
  "binary": "systemd-resolve",
  "check": "which systemd-resolve",
  "install_steps": [
    "apt-get install systemd-resolve 2>/dev/null || which systemd-resolve",
    "Verify: systemd-resolve --version",
    "supercli plugins install ./plugins/systemd-resolve --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}