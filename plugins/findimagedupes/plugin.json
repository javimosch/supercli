{
  "name": "findimagedupes",
  "version": "1.0.0",
  "description": "findimagedupes \u2014 Duplicate images",
  "source": "github.com/philanc/findimagedupes",
  "checks": [
    {
      "type": "binary",
      "name": "findimagedupes"
    }
  ],
  "install_guidance": {
    "plugin": "findimagedupes",
    "binary": "findimagedupes",
    "check": "which findimagedupes",
    "install_steps": [
      "# Install findimagedupes",
      "# See github.com/philanc/findimagedupes",
      "# apt: sudo apt-get install findimagedupes",
      "# brew: brew install findimagedupes",
      "# cargo: cargo install findimagedupes",
      "# npm: npm install -g findimagedupes",
      "# pip: pip install findimagedupes"
    ]
  },
  "commands": [
    {
      "namespace": "findimagedupes",
      "resource": "findimagedupes",
      "action": "run",
      "description": "Run findimagedupes",
      "adapter": "process",
      "adapterConfig": {
        "command": "findimagedupes",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install findimagedupes from github.com/philanc/findimagedupes"
      },
      "args": []
    }
  ]
}