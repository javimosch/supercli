{
  "name": "gipddecode",
  "version": "0.1.0",
  "description": "CLI tool: gipddecode",
  "source": "https://manpages.debian.org/gipddecode",
  "checks": [
    {
      "type": "binary",
      "name": "gipddecode"
    }
  ],
  "install_guidance": {
    "plugin": "gipddecode",
    "binary": "gipddecode",
    "check": "which gipddecode",
    "install_steps": [
      "apt-get install gipddecode 2>/dev/null || which gipddecode",
      "Verify: gipddecode --version",
      "supercli plugins install ./plugins/gipddecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gipddecode",
      "resource": "self",
      "action": "version",
      "description": "Print gipddecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gipddecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gipddecode: apt-get install gipddecode 2>/dev/null || which gipddecode"
      },
      "args": []
    },
    {
      "namespace": "gipddecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gipddecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gipddecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gipddecode: apt-get install gipddecode 2>/dev/null || which gipddecode"
      },
      "args": []
    }
  ]
}