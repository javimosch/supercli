{
  "name": "isutf8",
  "version": "0.1.0",
  "description": "CLI tool: isutf8",
  "source": "https://manpages.debian.org/isutf8",
  "checks": [
    {
      "type": "binary",
      "name": "isutf8"
    }
  ],
  "install_guidance": {
    "plugin": "isutf8",
    "binary": "isutf8",
    "check": "which isutf8",
    "install_steps": [
      "apt-get install isutf8 2>/dev/null || which isutf8",
      "Verify: isutf8 --version",
      "supercli plugins install ./plugins/isutf8 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "isutf8",
      "resource": "self",
      "action": "version",
      "description": "Print isutf8 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "isutf8",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install isutf8: apt-get install isutf8 2>/dev/null || which isutf8"
      },
      "args": []
    },
    {
      "namespace": "isutf8",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to isutf8 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "isutf8",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install isutf8: apt-get install isutf8 2>/dev/null || which isutf8"
      },
      "args": []
    }
  ]
}