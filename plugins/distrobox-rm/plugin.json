{
  "name": "distrobox-rm",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-rm",
  "source": "https://packages.debian.org/distrobox-rm",
  "checks": [{ "type": "binary", "name": "distrobox-rm" }],
  "install_guidance": {
    "plugin": "distrobox-rm", "binary": "distrobox-rm", "check": "which distrobox-rm",
    "install_steps": ["apt-get install distrobox-rm 2>/dev/null || which distrobox-rm", "Verify: distrobox-rm --version", "supercli plugins install ./plugins/distrobox-rm --on-conflict replace --json"]
