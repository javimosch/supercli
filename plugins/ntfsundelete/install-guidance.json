{
  "plugin": "ntfsundelete",
  "binary": "ntfsundelete",
  "check": "which ntfsundelete",
  "install_steps": [
    "# Install ntfsundelete",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ntfsundelete-linux-amd64 -o /usr/local/bin/ntfsundelete",
    "chmod +x /usr/local/bin/ntfsundelete",
    "# Or via package manager, see /usr/sbin/ntfsundelete"
  ]
}