{
  "name": "LightRAG",
  "version": "0.1.0",
  "description": "[EMNLP2025] \"LightRAG: Simple and Fast Retrieval-Augmented Generation\"",
  "source": "https://github.com/LightRAG/LightRAG",
  "checks": [
    {
      "type": "binary",
      "name": "lightrag"
    }
  ],
  "install_guidance": {
    "plugin": "LightRAG",
    "binary": "lightrag",
    "check": "which lightrag",
    "install_steps": [
      "pip install lightrag",
      "Verify: lightrag --version",
      "supercli plugins install ./plugins/LightRAG --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LightRAG",
      "resource": "self",
      "action": "version",
      "description": "Print LightRAG version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lightrag",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LightRAG: pip install lightrag"
      },
      "args": []
    },
    {
      "namespace": "LightRAG",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lightrag CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lightrag",
        "passthrough": true,
        "missingDependencyHelp": "Install LightRAG: pip install lightrag"
      },
      "args": []
    }
  ]
}