{
  "name": "bottom",
  "version": "0.1.0",
  "description": "A customizable cross-platform graphical process/system monitor with JSON export for system metrics",
  "source": "https://github.com/ClementTsang/bottom",
  "checks": [
    {
      "type": "binary",
      "name": "btm"
    }
  ],
  "install_guidance": {
    "plugin": "bottom",
    "binary": "btm",
    "check": "which btm",
    "install_steps": [
      "cargo install bottom --locked",
      "Or: brew install bottom",
      "Or: sudo pacman -S bottom (Arch Linux)",
      "Or download binary from https://github.com/ClementTsang/bottom/releases",
      "Verify: btm --version",
      "supercli plugins install ./plugins/bottom --on-conflict replace --json"
    ],
    "note": "Available via Cargo, Homebrew, and Linux package managers. Source: https://github.com/ClementTsang/bottom (13k+ stars). Written in Rust."
  },
  "commands": [
    {
      "namespace": "bottom",
      "resource": "self",
      "action": "version",
      "description": "Print bottom version",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "baseArgs": ["--version"]
      },
      "args": []
    },
    {
      "namespace": "bottom",
      "resource": "system",
      "action": "export-cpu",
      "description": "Export CPU metrics as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "baseArgs": ["--export", "cpu"],
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "bottom",
      "resource": "system",
      "action": "export-memory",
      "description": "Export memory metrics as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "baseArgs": ["--export", "mem"],
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "bottom",
      "resource": "system",
      "action": "export-disk",
      "description": "Export disk metrics as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "baseArgs": ["--export", "disk"],
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "bottom",
      "resource": "system",
      "action": "export-network",
      "description": "Export network I/O metrics as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "baseArgs": ["--export", "network"],
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "bottom",
      "resource": "system",
      "action": "export-temperature",
      "description": "Export temperature sensor metrics as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "baseArgs": ["--export", "temperature"],
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "bottom",
      "resource": "system",
      "action": "export-all",
      "description": "Export all system metrics as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "baseArgs": ["--export", "all"],
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "bottom",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to btm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "btm",
        "missingDependencyHelp": "Install bottom: cargo install bottom --locked",
        "cwd": "invoke_cwd",
        "passthrough": true
      },
      "args": []
    }
  ]
}
