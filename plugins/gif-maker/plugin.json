{
  "name": "gif-maker",
  "version": "0.1.0",
  "description": "Create animated GIFs from video files and image sequences",
  "source": "https://github.com/johndoe/gif-maker",
  "checks": [{ "type": "binary", "name": "gif-maker" }],
  "install_guidance": {
    "plugin": "gif-maker",
    "binary": "gif-maker",
    "check": "which gif-maker",
    "install_steps": ["pip install gif-maker", "Verify: gif-maker --version", "supercli plugins install ./plugins/gif-maker --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gif-maker",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gif-maker CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gif-maker",
      "passthrough": true,
      "missingDependencyHelp": "Install gif-maker: pip install gif-maker", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
