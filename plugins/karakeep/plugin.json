{
  "name": "karakeep",
  "version": "0.1.0",
  "description": "A self-hostable bookmark-everything app (links, notes and images) with AI-based automatic tagging an",
  "source": "https://github.com/karakeep/karakeep",
  "checks": [
    {
      "type": "binary",
      "name": "karakeep"
    }
  ],
  "install_guidance": {
    "plugin": "karakeep",
    "binary": "karakeep",
    "check": "which karakeep",
    "install_steps": [
      "pip install karakeep",
      "Verify: karakeep --version",
      "supercli plugins install ./plugins/karakeep --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "karakeep",
      "resource": "self",
      "action": "version",
      "description": "Print karakeep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "karakeep",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install karakeep: pip install karakeep"
      },
      "args": []
    },
    {
      "namespace": "karakeep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to karakeep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "karakeep",
        "passthrough": true,
        "missingDependencyHelp": "Install karakeep: pip install karakeep"
      },
      "args": []
    }
  ]
}