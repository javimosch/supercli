{
  "name": "burrow",
  "version": "0.1.0",
  "description": "Kafka Consumer Lag Checking",
  "source": "https://github.com/linkedin/Burrow",
  "checks": [
    {
      "type": "binary",
      "name": "burrow"
    }
  ],
  "install_guidance": {
    "plugin": "burrow",
    "binary": "burrow",
    "check": "which burrow",
    "install_steps": [
      "brew install burrow",
      "Verify: burrow --version",
      "supercli plugins install ./plugins/burrow --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "burrow",
      "resource": "self",
      "action": "version",
      "description": "Print burrow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "burrow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install burrow: brew install burrow"
      },
      "args": []
    },
    {
      "namespace": "burrow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to burrow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "burrow",
        "passthrough": true,
        "missingDependencyHelp": "Install burrow"
      },
      "args": []
    }
  ]
}