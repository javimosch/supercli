{
  "name": "sleek",
  "version": "0.1.0",
  "description": "CLI tool for formatting SQL using sqlformat engine",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "sleek" }],
  "install_guidance": {
    "plugin": "sleek",
    "binary": "sleek",
    "check": "which sleek",
    "install_steps": ["cargo install sleek", "Verify: sleek --version", "supercli plugins install ./plugins/sleek --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sleek",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sleek CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sleek",
      "passthrough": true,
      "missingDependencyHelp": "Install sleek: cargo install sleek"
    },
    "args": []
  }]
}
