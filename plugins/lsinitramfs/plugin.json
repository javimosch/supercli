{
  "name": "lsinitramfs",
  "version": "0.1.0",
  "description": "CLI tool: lsinitramfs",
  "source": "https://manpages.debian.org/lsinitramfs",
  "checks": [
    {
      "type": "binary",
      "name": "lsinitramfs"
    }
  ],
  "install_guidance": {
    "plugin": "lsinitramfs",
    "binary": "lsinitramfs",
    "check": "which lsinitramfs",
    "install_steps": [
      "apt-get install lsinitramfs 2>/dev/null || which lsinitramfs",
      "Verify: lsinitramfs --version",
      "supercli plugins install ./plugins/lsinitramfs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lsinitramfs",
      "resource": "self",
      "action": "version",
      "description": "Print lsinitramfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lsinitramfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lsinitramfs: apt-get install lsinitramfs 2>/dev/null || which lsinitramfs"
      },
      "args": []
    },
    {
      "namespace": "lsinitramfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lsinitramfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lsinitramfs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lsinitramfs: apt-get install lsinitramfs 2>/dev/null || which lsinitramfs"
      },
      "args": []
    }
  ]
}