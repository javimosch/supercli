{
  "name": "whatweb",
  "version": "0.1.0",
  "description": "Web fingerprinting tool with batch mode",
  "source": "https://github.com/urbanadventurer/WhatWeb",
  "checks": [
    {
      "type": "binary",
      "name": "whatweb"
    }
  ],
  "install_guidance": {
    "plugin": "whatweb",
    "binary": "whatweb",
    "check": "which whatweb",
    "install_steps": [
      "brew install whatweb",
      "Verify: whatweb --version",
      "supercli plugins install ./plugins/whatweb --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "whatweb",
      "resource": "self",
      "action": "version",
      "description": "Print whatweb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatweb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install whatweb: brew install whatweb"
      },
      "args": []
    },
    {
      "namespace": "whatweb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to whatweb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "whatweb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install whatweb: brew install whatweb"
      },
      "args": []
    }
  ]
}
