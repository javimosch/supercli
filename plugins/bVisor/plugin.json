{
  "name": "bVisor",
  "version": "0.1.0",
  "description": "Embedded bash sandbox for agents, inspired by gVisor",
  "source": "https://github.com/bVisor/bVisor",
  "checks": [
    {
      "type": "binary",
      "name": "bvisor"
    }
  ],
  "install_guidance": {
    "plugin": "bVisor",
    "binary": "bvisor",
    "check": "which bvisor",
    "install_steps": [
      "pip install bvisor",
      "Verify: bvisor --version",
      "supercli plugins install ./plugins/bVisor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bVisor",
      "resource": "self",
      "action": "version",
      "description": "Print bVisor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bvisor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bVisor: pip install bvisor"
      },
      "args": []
    },
    {
      "namespace": "bVisor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bvisor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bvisor",
        "passthrough": true,
        "missingDependencyHelp": "Install bVisor: pip install bvisor"
      },
      "args": []
    }
  ]
}