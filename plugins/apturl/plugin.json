{
  "name": "apturl",
  "version": "0.1.0",
  "description": "CLI tool: apturl",
  "source": "https://packages.debian.org/apturl",
  "checks": [{ "type": "binary", "name": "apturl" }],
  "install_guidance": {
    "plugin": "apturl", "binary": "apturl", "check": "which apturl",
    "install_steps": ["apt-get install apturl 2>/dev/null || which apturl", "Verify: apturl --version", "supercli plugins install ./plugins/apturl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apturl", "resource": "_", "action": "_",
    "description": "Passthrough to apturl CLI",
    "adapter": "process", "adapterConfig": { "command": "apturl", "passthrough": true, "missingDependencyHelp": "Install apturl: apt-get install apturl" }, "args": []
  }]
}
