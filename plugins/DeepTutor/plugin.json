{
  "name": "DeepTutor",
  "version": "0.1.0",
  "description": "DeepTutor: Agent-native, Open-sourced Personalized Tutoring. https://deeptutor.info/.",
  "source": "https://github.com/DeepTutor/DeepTutor",
  "checks": [
    {
      "type": "binary",
      "name": "deeptutor"
    }
  ],
  "install_guidance": {
    "plugin": "DeepTutor",
    "binary": "deeptutor",
    "check": "which deeptutor",
    "install_steps": [
      "pip install deeptutor",
      "Verify: deeptutor --version",
      "supercli plugins install ./plugins/DeepTutor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DeepTutor",
      "resource": "self",
      "action": "version",
      "description": "Print DeepTutor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deeptutor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DeepTutor: pip install deeptutor"
      },
      "args": []
    },
    {
      "namespace": "DeepTutor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deeptutor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deeptutor",
        "passthrough": true,
        "missingDependencyHelp": "Install DeepTutor: pip install deeptutor"
      },
      "args": []
    }
  ]
}