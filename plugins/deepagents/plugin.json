{
  "name": "deepagents",
  "version": "0.1.0",
  "description": "The batteries-included agent harness.",
  "source": "https://github.com/deepagents/deepagents",
  "checks": [
    {
      "type": "binary",
      "name": "deepagents"
    }
  ],
  "install_guidance": {
    "plugin": "deepagents",
    "binary": "deepagents",
    "check": "which deepagents",
    "install_steps": [
      "pip install deepagents",
      "Verify: deepagents --version",
      "supercli plugins install ./plugins/deepagents --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "deepagents",
      "resource": "self",
      "action": "version",
      "description": "Print deepagents version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepagents",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install deepagents: pip install deepagents"
      },
      "args": []
    },
    {
      "namespace": "deepagents",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deepagents CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepagents",
        "passthrough": true,
        "missingDependencyHelp": "Install deepagents: pip install deepagents"
      },
      "args": []
    }
  ]
}