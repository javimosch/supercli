{
  "name": "freq-conv",
  "version": "0.1.0",
  "description": "Frequency converter calculator for radio operators",
  "source": "go",
  "checks": [{ "type": "binary", "name": "freq-conv" }],
  "install_guidance": {
    "plugin": "freq-conv",
    "binary": "freq-conv",
    "check": "which freq-conv",
    "install_steps": ["go install github.com/freq-conv@latest", "Verify: freq-conv --version", "supercli plugins install ./plugins/freq-conv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "freq-conv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to freq-conv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "freq-conv",
      "passthrough": true,
      "missingDependencyHelp": "Install freq-conv: go install github.com/freq-conv@latest"
    },
    "args": []
  }]
}
