{
  "name": "fontget-cli",
  "version": "0.1.0",
  "description": "Tiny CLI manager to discover and install system fonts",
  "source": "https://github.com/Graphixa/FontGet",
  "checks": [{ "type": "binary", "name": "fontget-cli" }],
  "install_guidance": {
    "plugin": "fontget-cli",
    "binary": "fontget-cli",
    "check": "which fontget-cli",
    "install_steps": ["binary release", "Verify: fontget-cli --version", "supercli plugins install ./plugins/fontget-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fontget-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fontget-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fontget-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install fontget-cli: binary release", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
