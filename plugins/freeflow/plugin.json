{
  "name": "freeflow",
  "version": "0.1.0",
  "description": "Free & fast alternative to Wispr Flow",
  "source": "https://github.com/freeflow/freeflow",
  "checks": [
    {
      "type": "binary",
      "name": "freeflow"
    }
  ],
  "install_guidance": {
    "plugin": "freeflow",
    "binary": "freeflow",
    "check": "which freeflow",
    "install_steps": [
      "pip install freeflow",
      "Verify: freeflow --version",
      "supercli plugins install ./plugins/freeflow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "freeflow",
      "resource": "self",
      "action": "version",
      "description": "Print freeflow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freeflow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install freeflow: pip install freeflow"
      },
      "args": []
    },
    {
      "namespace": "freeflow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freeflow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freeflow",
        "passthrough": true,
        "missingDependencyHelp": "Install freeflow: pip install freeflow"
      },
      "args": []
    }
  ]
}