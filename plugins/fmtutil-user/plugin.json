{
  "name": "fmtutil-user",
  "version": "0.1.0",
  "description": "CLI tool: fmtutil-user",
  "source": "https://manpages.debian.org/fmtutil-user",
  "checks": [
    {
      "type": "binary",
      "name": "fmtutil-user"
    }
  ],
  "install_guidance": {
    "plugin": "fmtutil-user",
    "binary": "fmtutil-user",
    "check": "which fmtutil-user",
    "install_steps": [
      "apt-get install fmtutil-user 2>/dev/null || which fmtutil-user",
      "Verify: fmtutil-user --version",
      "supercli plugins install ./plugins/fmtutil-user --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fmtutil-user",
      "resource": "self",
      "action": "version",
      "description": "Print fmtutil-user version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fmtutil-user",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fmtutil-user: apt-get install fmtutil-user 2>/dev/null || which fmtutil-user"
      },
      "args": []
    },
    {
      "namespace": "fmtutil-user",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fmtutil-user CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fmtutil-user",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fmtutil-user: apt-get install fmtutil-user 2>/dev/null || which fmtutil-user"
      },
      "args": []
    }
  ]
}