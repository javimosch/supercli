{
  "name": "longhorn",
  "version": "0.1.0",
  "description": "Distributed block storage system for Kubernetes",
  "source": "https://github.com/longhorn/longhorn",
  "checks": [{ "type": "binary", "name": "longhorn" }],
  "install_guidance": {
    "plugin": "longhorn",
    "binary": "longhorn",
    "check": "which longhorn",
    "install_steps": ["brew install longhorn", "Verify: longhorn --version", "supercli plugins install ./plugins/longhorn --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "longhorn",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to longhorn CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "longhorn",
      "passthrough": true,
      "missingDependencyHelp": "Install longhorn: brew install longhorn"
    },
    "args": []
  }]
}
