{
  "name": "Prism-File-Explorer",
  "version": "0.1.0",
  "description": "A modern, feature-rich, and lightweight file manager for Android, built entirely with Kotlin and Jet",
  "source": "https://github.com/Prism-File-Explorer/Prism-File-Explorer",
  "checks": [
    {
      "type": "binary",
      "name": "prism-file-explorer"
    }
  ],
  "install_guidance": {
    "plugin": "Prism-File-Explorer",
    "binary": "prism-file-explorer",
    "check": "which prism-file-explorer",
    "install_steps": [
      "pip install prism-file-explorer",
      "Verify: prism-file-explorer --version",
      "supercli plugins install ./plugins/Prism-File-Explorer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Prism-File-Explorer",
      "resource": "self",
      "action": "version",
      "description": "Print Prism-File-Explorer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "prism-file-explorer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Prism-File-Explorer: pip install prism-file-explorer"
      },
      "args": []
    },
    {
      "namespace": "Prism-File-Explorer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to prism-file-explorer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "prism-file-explorer",
        "passthrough": true,
        "missingDependencyHelp": "Install Prism-File-Explorer: pip install prism-file-explorer"
      },
      "args": []
    }
  ]
}