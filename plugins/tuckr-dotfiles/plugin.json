{
  "name": "tuckr-dotfiles",
  "version": "0.1.0",
  "description": "Organize dotfiles with declarative symlink management",
  "source": "https://github.com/RaphGL/Tuckr",
  "checks": [{ "type": "binary", "name": "tuckr-dotfiles" }],
  "install_guidance": {
    "plugin": "tuckr-dotfiles",
    "binary": "tuckr-dotfiles",
    "check": "which tuckr-dotfiles",
    "install_steps": ["cargo install tuckr", "Verify: tuckr-dotfiles --version", "supercli plugins install ./plugins/tuckr-dotfiles --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tuckr-dotfiles",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tuckr-dotfiles CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tuckr-dotfiles",
      "passthrough": true,
      "missingDependencyHelp": "Install tuckr-dotfiles: cargo install tuckr", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
