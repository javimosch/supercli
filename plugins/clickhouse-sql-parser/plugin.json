{
  "name": "clickhouse-sql-parser",
  "version": "0.1.0",
  "description": "Writing clickhouse sql parser in pure Go",
  "source": "https://github.com/AfterShip/clickhouse-sql-parser",
  "checks": [
    {
      "type": "binary",
      "name": "clickhouse-sql-parser"
    }
  ],
  "install_guidance": {
    "plugin": "clickhouse-sql-parser",
    "binary": "clickhouse-sql-parser",
    "check": "which clickhouse-sql-parser",
    "install_steps": [
      "brew install clickhouse-sql-parser",
      "Verify: clickhouse-sql-parser --version",
      "supercli plugins install ./plugins/clickhouse-sql-parser --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clickhouse-sql-parser",
      "resource": "self",
      "action": "version",
      "description": "Print clickhouse-sql-parser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clickhouse-sql-parser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clickhouse-sql-parser: brew install clickhouse-sql-parser"
      },
      "args": []
    },
    {
      "namespace": "clickhouse-sql-parser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clickhouse-sql-parser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clickhouse-sql-parser",
        "passthrough": true,
        "missingDependencyHelp": "Install clickhouse-sql-parser"
      },
      "args": []
    }
  ]
}