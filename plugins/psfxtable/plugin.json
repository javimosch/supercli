{
  "name": "psfxtable",
  "version": "1.0.0",
  "description": "psfxtable \u2014 psfxtable \u2014 CLI utility",
  "source": "/usr/bin/psfxtable",
  "checks": [
    {
      "type": "binary",
      "name": "psfxtable"
    }
  ],
  "install_guidance": {
    "plugin": "psfxtable",
    "binary": "psfxtable",
    "check": "which psfxtable",
    "install_steps": [
      "# Install psfxtable:",
      "# apt: sudo apt-get install psfxtable",
      "# brew: brew install psfxtable",
      "# cargo: cargo install psfxtable",
      "# npm: npm install -g psfxtable",
      "# pip: pip install psfxtable",
      "# or download from /usr/bin/psfxtable"
    ]
  },
  "commands": [
    {
      "namespace": "psfxtable",
      "resource": "psfxtable",
      "action": "run",
      "description": "Run psfxtable",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfxtable",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install psfxtable from /usr/bin/psfxtable"
      },
      "args": []
    }
  ]
}