{
  "name": "psfxtable",
  "version": "0.1.0",
  "description": "CLI tool: psfxtable",
  "source": "https://manpages.debian.org/psfxtable",
  "checks": [
    {
      "type": "binary",
      "name": "psfxtable"
    }
  ],
  "install_guidance": {
    "plugin": "psfxtable",
    "binary": "psfxtable",
    "check": "which psfxtable",
    "install_steps": [
      "apt-get install psfxtable 2>/dev/null || which psfxtable",
      "Verify: psfxtable --version",
      "supercli plugins install ./plugins/psfxtable --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "psfxtable",
      "resource": "self",
      "action": "version",
      "description": "Print psfxtable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfxtable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install psfxtable: apt-get install psfxtable 2>/dev/null || which psfxtable"
      },
      "args": []
    },
    {
      "namespace": "psfxtable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to psfxtable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfxtable",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install psfxtable: apt-get install psfxtable 2>/dev/null || which psfxtable"
      },
      "args": []
    }
  ]
}