{
  "plugin": "psfxtable",
  "binary": "psfxtable",
  "check": "which psfxtable",
  "install_steps": [
    "# Install psfxtable",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/psfxtable-linux-amd64 -o /usr/local/bin/psfxtable",
    "chmod +x /usr/local/bin/psfxtable",
    "# Or via package manager, see /usr/bin/psfxtable"
  ]
}