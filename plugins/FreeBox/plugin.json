{
  "name": "FreeBox",
  "version": "0.1.0",
  "description": "TVBox\u7535\u8111\u7248/\u59ca\u59b9\u8f6f\u4ef6\uff0c\u81f4\u529b\u4e8eTVBox\u529f\u80fd\u548c\u751f\u6001\u7684\u8de8\u5e73\u53f0\u6269\u5c55",
  "source": "https://github.com/FreeBox/FreeBox",
  "checks": [
    {
      "type": "binary",
      "name": "freebox"
    }
  ],
  "install_guidance": {
    "plugin": "FreeBox",
    "binary": "freebox",
    "check": "which freebox",
    "install_steps": [
      "pip install freebox",
      "Verify: freebox --version",
      "supercli plugins install ./plugins/FreeBox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FreeBox",
      "resource": "self",
      "action": "version",
      "description": "Print FreeBox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "freebox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FreeBox: pip install freebox"
      },
      "args": []
    },
    {
      "namespace": "FreeBox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to freebox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "freebox",
        "passthrough": true,
        "missingDependencyHelp": "Install FreeBox: pip install freebox"
      },
      "args": []
    }
  ]
}