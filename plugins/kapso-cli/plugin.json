{
  "name": "kapso-cli",
  "version": "0.1.0",
  "description": "WhatsApp messaging from the terminal via Kapso. Send and manage WhatsApp messages programmatically.",
  "source": "https://kapso.ai",
  "checks": [
    { "type": "binary", "name": "kapso" }
  ],
  "install_guidance": {
    "plugin": "kapso-cli",
    "binary": "kapso",
    "check": "which kapso",
    "install_steps": [
      "npm i -g @kapso/cli",
      "Verify: kapso --version",
      "supercli plugins install ./plugins/kapso-cli --on-conflict replace --json"
    ],
    "note": "Requires KAPSO_API_KEY env var. Get key at https://kapso.ai"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kapso-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kapso CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kapso",
        "passthrough": true,
        "missingDependencyHelp": "Install kapso: npm i -g @kapso/cli"
      },
      "args": []
    }
  ]
}
