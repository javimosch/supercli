{
  "name": "yuque-dl",
  "version": "0.1.0",
  "description": "Download Yuque knowledge base documents and export to local storage",
  "source": "https://github.com/gxr404/yuque-dl",
  "checks": [
    {
      "type": "binary",
      "name": "yuque-dl"
    }
  ],
  "install_guidance": {
    "plugin": "yuque-dl",
    "binary": "yuque-dl",
    "check": "which yuque-dl",
    "install_steps": [
      "npm install -g yuque-dl",
      "Verify: yuque-dl --version",
      "supercli plugins install ./plugins/yuque-dl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "yuque-dl",
    "resource": "self",
    "action": "version",
    "description": "Print yuque-dl version",
    "adapter": "process",
    "adapterConfig": {
      "command": "yuque-dl",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install yuque-dl: npm install -g yuque-dl"
    },
    "args": []
  },
  {
    "namespace": "yuque-dl",
    "resource": "doc",
    "action": "download",
    "description": "Download Yuque documents",
    "adapter": "process",
    "adapterConfig": {
      "command": "yuque-dl",
      "passthrough": true,
      "missingDependencyHelp": "Install yuque-dl: npm install -g yuque-dl"
    },
    "args": []
  },
  {
    "namespace": "yuque-dl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yuque-dl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yuque-dl",
      "passthrough": true,
      "missingDependencyHelp": "Install yuque-dl"
    },
    "args": []
  }
]
}