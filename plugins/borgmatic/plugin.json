{
  "name": "borgmatic",
  "version": "0.1.0",
  "description": "borgmatic — automated backup tool wrapper around BorgBackup. Configures and runs Borg backups via YAML config files with pre/post backup hooks, health check monitoring, database dump support, and prune/compact policies for efficient retention.",
  "source": "https://github.com/borgmatic-collective/borgmatic",
  "checks": [
    {
      "type": "binary",
      "name": "borgmatic"
    }
  ],
  "install_guidance": {
    "plugin": "borgmatic",
    "binary": "borgmatic",
    "check": "which borgmatic",
    "install_steps": [
      "pip install borgmatic",
      "Verify: borgmatic --version",
      "supercli plugins install ./plugins/borgmatic --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "borgmatic",
      "resource": "self",
      "action": "version",
      "description": "Print borgmatic version",
      "adapter": "process",
      "adapterConfig": {
        "command": "borgmatic",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install borgmatic: pip install borgmatic"
      },
      "args": []
    },
    {
      "namespace": "borgmatic",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to borgmatic CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "borgmatic",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install borgmatic: pip install borgmatic"
      },
      "args": []
    }
  ]
}
