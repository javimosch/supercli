{
  "name": "wbmptopbm",
  "version": "0.1.0",
  "description": "CLI tool: wbmptopbm",
  "source": "https://manpages.debian.org/wbmptopbm",
  "checks": [
    {
      "type": "binary",
      "name": "wbmptopbm"
    }
  ],
  "install_guidance": {
    "plugin": "wbmptopbm",
    "binary": "wbmptopbm",
    "check": "which wbmptopbm",
    "install_steps": [
      "apt-get install wbmptopbm 2>/dev/null || which wbmptopbm",
      "Verify: wbmptopbm --version",
      "supercli plugins install ./plugins/wbmptopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wbmptopbm",
      "resource": "self",
      "action": "version",
      "description": "Print wbmptopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wbmptopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wbmptopbm: apt-get install wbmptopbm 2>/dev/null || which wbmptopbm"
      },
      "args": []
    },
    {
      "namespace": "wbmptopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wbmptopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wbmptopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wbmptopbm: apt-get install wbmptopbm 2>/dev/null || which wbmptopbm"
      },
      "args": []
    }
  ]
}