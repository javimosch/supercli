{
  "name": "pocket-id",
  "version": "0.1.0",
  "description": "A simple and easy-to-use OIDC provider that allows users to authenticate with their passkeys to your",
  "source": "https://github.com/pocket-id/pocket-id",
  "checks": [
    {
      "type": "binary",
      "name": "pocket-id"
    }
  ],
  "install_guidance": {
    "plugin": "pocket-id",
    "binary": "pocket-id",
    "check": "which pocket-id",
    "install_steps": [
      "pip install pocket-id",
      "Verify: pocket-id --version",
      "supercli plugins install ./plugins/pocket-id --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pocket-id",
      "resource": "self",
      "action": "version",
      "description": "Print pocket-id version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pocket-id",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pocket-id: pip install pocket-id"
      },
      "args": []
    },
    {
      "namespace": "pocket-id",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pocket-id CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pocket-id",
        "passthrough": true,
        "missingDependencyHelp": "Install pocket-id: pip install pocket-id"
      },
      "args": []
    }
  ]
}