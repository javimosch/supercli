{
  "name": "sldtoppm",
  "version": "0.1.0",
  "description": "CLI tool: sldtoppm",
  "source": "https://manpages.debian.org/sldtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "sldtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "sldtoppm",
    "binary": "sldtoppm",
    "check": "which sldtoppm",
    "install_steps": [
      "apt-get install sldtoppm 2>/dev/null || which sldtoppm",
      "Verify: sldtoppm --version",
      "supercli plugins install ./plugins/sldtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sldtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print sldtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sldtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sldtoppm: apt-get install sldtoppm 2>/dev/null || which sldtoppm"
      },
      "args": []
    },
    {
      "namespace": "sldtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sldtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sldtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sldtoppm: apt-get install sldtoppm 2>/dev/null || which sldtoppm"
      },
      "args": []
    }
  ]
}