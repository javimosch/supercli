{
  "name": "crypto-cli",
  "version": "0.1.0",
  "description": "Track cryptocurrency prices in the terminal",
  "source": "https://github.com/danielepolencic/crypto-cli",
  "checks": [{ "type": "binary", "name": "crypto-cli" }],
  "install_guidance": {
    "plugin": "crypto-cli",
    "binary": "crypto-cli",
    "check": "which crypto-cli",
    "install_steps": ["npm install -g crypto-cli", "Verify: crypto-cli --version", "supercli plugins install ./plugins/crypto-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "crypto-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to crypto-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "crypto-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install crypto-cli: npm install -g crypto-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
