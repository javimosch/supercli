{
  "name": "habit-cli",
  "version": "0.1.0",
  "description": "Simple personal habit-tracker CLI with daily streaks",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "habit-cli" }],
  "install_guidance": {
    "plugin": "habit-cli",
    "binary": "habit-cli",
    "check": "which habit-cli",
    "install_steps": ["cargo install habit-cli", "Verify: habit-cli --version", "supercli plugins install ./plugins/habit-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "habit-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to habit-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "habit-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install habit-cli: cargo install habit-cli"
    },
    "args": []
  }]
}
