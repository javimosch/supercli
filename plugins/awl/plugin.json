{
  "name": "awl",
  "version": "1.0.0",
  "description": "DNS lookup tool supporting UDP, TCP, TLS, HTTPS, DNSCrypt, and QUIC with JSON output",
  "source": "https://dns.froth.zone/awl",
  "checks": [
    {
      "type": "binary",
      "name": "awl",
      "args": [
        "-v"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "awl",
    "binary": "awl",
    "check": "awl -v",
    "install_steps": [
      "go install dns.froth.zone/awl@latest",
      "Or via package managers: apk add awl-dns, yay -S awl-dns-git, apt install awl-dns",
      "Or via Homebrew: brew install SamTherapy/tap/awl"
    ],
    "note": "awl is designed as a drop-in replacement for dig with modern protocol support"
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awl",
      "resource": "dns",
      "action": "lookup",
      "description": "Perform DNS lookup with JSON output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "awl {{domain}} +json",
        "unsafe": true
      },
      "args": [
        {
          "name": "domain",
          "type": "string",
          "required": true,
          "description": "Domain name to query"
        }
      ]
    },
    {
      "namespace": "awl",
      "resource": "dns",
      "action": "lookup-a",
      "description": "Lookup A records with JSON output",
      "adapter": "shell",
      "adapterConfig": {
        "script": "awl {{domain}} A +json",
        "unsafe": true
      },
      "args": [
        {
          "name": "domain",
          "type": "string",
          "required": true,
          "description": "Domain name to query"
        }
      ]
    },
    {
      "namespace": "awl",
      "resource": "dns",
      "action": "lookup-aaaa",
      "description": "Lookup AAAA records with JSON output",
      "adapter": "shell",
      "adapterConfig": {
