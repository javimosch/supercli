    {
      "namespace": "awl",
      "resource": "self",
      "action": "version",
      "description": "Print awl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awl",
        "baseArgs": [
          "-v"
        ],
        "missingDependencyHelp": "Install awl: go install dns.froth.zone/awl@latest"
      },
      "args": []
    },
    {
      "namespace": "awl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install awl: go install dns.froth.zone/awl@latest"
      },
      "args": []
    }
  ]
}
