{
  "name": "slowql",
  "version": "0.1.0",
  "description": "SQL Analyzer",
  "source": "https://github.com/slowql/slowql",
  "checks": [
    { "type": "binary", "name": "slowql" }
  ],
  "install_guidance": {
    "plugin": "slowql",
    "binary": "slowql",
    "check": "which slowql",
    "install_steps": [
      "pipx install slowql",
      "Verify: slowql --version",
      "supercli plugins install ./plugins/slowql --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "slowql",
      "resource": "self",
      "action": "version",
      "description": "Print slowql version",
      "adapter": "process",
      "adapterConfig": {
        "command": "slowql",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install slowql: pipx install slowql"
      },
      "args": []
    },
    {
      "namespace": "slowql",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to slowql CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "slowql",
        "passthrough": true,
        "missingDependencyHelp": "Install slowql"
      },
      "args": []
    }
  ]
}
