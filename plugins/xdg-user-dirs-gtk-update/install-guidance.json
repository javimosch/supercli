{
  "plugin": "xdg-user-dirs-gtk-update",
  "binary": "xdg-user-dirs-gtk-update",
  "check": "which xdg-user-dirs-gtk-update",
  "install_steps": [
    "apt-get install xdg-user-dirs-gtk-update 2>/dev/null || which xdg-user-dirs-gtk-update",
    "Verify: xdg-user-dirs-gtk-update --version",
    "supercli plugins install ./plugins/xdg-user-dirs-gtk-update --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}