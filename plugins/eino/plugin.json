{
  "name": "eino",
  "version": "0.1.0",
  "description": "The ultimate LLM/AI application development framework in Go.",
  "source": "https://github.com/eino/eino",
  "checks": [
    {
      "type": "binary",
      "name": "eino"
    }
  ],
  "install_guidance": {
    "plugin": "eino",
    "binary": "eino",
    "check": "which eino",
    "install_steps": [
      "pip install eino",
      "Verify: eino --version",
      "supercli plugins install ./plugins/eino --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "eino",
      "resource": "self",
      "action": "version",
      "description": "Print eino version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eino",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eino: pip install eino"
      },
      "args": []
    },
    {
      "namespace": "eino",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eino CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eino",
        "passthrough": true,
        "missingDependencyHelp": "Install eino: pip install eino"
      },
      "args": []
    }
  ]
}