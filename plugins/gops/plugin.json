{
  "name": "gops",
  "version": "0.1.0",
  "description": "Tool to list and diagnose Go processes currently running on your system",
  "source": "https://github.com/google/gops",
  "checks": [
    {
      "type": "binary",
      "name": "gops"
    }
  ],
  "install_guidance": {
    "plugin": "gops",
    "binary": "gops",
    "check": "which gops",
    "install_steps": [
      "brew install gops",
      "Verify: gops --version",
      "supercli plugins install ./plugins/gops --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gops",
      "resource": "self",
      "action": "version",
      "description": "Print gops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gops: brew install gops"
      },
      "args": []
    },
    {
      "namespace": "gops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gops",
        "passthrough": true,
        "missingDependencyHelp": "Install gops"
      },
      "args": []
    }
  ]
}