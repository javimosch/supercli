{
  "name": "dm-cache-status",
  "version": "0.1.0",
  "description": "CLI tool: dm-cache-status",
  "source": "https://packages.debian.org/dm-cache-status",
  "checks": [{ "type": "binary", "name": "dm-cache-status" }],
  "install_guidance": {
    "plugin": "dm-cache-status", "binary": "dm-cache-status", "check": "which dm-cache-status",
    "install_steps": ["apt-get install dm-cache-status 2>/dev/null || which dm-cache-status", "Verify: dm-cache-status --version", "supercli plugins install ./plugins/dm-cache-status --on-conflict replace --json"]
