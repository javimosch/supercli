{
  "name": "conform",
  "version": "0.1.0",
  "description": "Policy-based commit message enforcement",
  "source": "https://github.com/siderolabs/conform",
  "checks": [{ "type": "binary", "name": "conform" }],
  "install_guidance": {
    "plugin": "conform",
    "binary": "conform",
    "check": "which conform",
    "install_steps": ["brew install conform", "Verify: conform --version", "supercli plugins install ./plugins/conform --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "conform",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to conform CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "conform",
      "passthrough": true,
      "missingDependencyHelp": "Install conform: brew install conform", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
