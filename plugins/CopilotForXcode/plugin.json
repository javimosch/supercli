{
  "name": "CopilotForXcode",
  "version": "0.1.0",
  "description": "AI coding assistant for Xcode",
  "source": "https://github.com/CopilotForXcode/CopilotForXcode",
  "checks": [
    {
      "type": "binary",
      "name": "copilotforxcode"
    }
  ],
  "install_guidance": {
    "plugin": "CopilotForXcode",
    "binary": "copilotforxcode",
    "check": "which copilotforxcode",
    "install_steps": [
      "pip install copilotforxcode",
      "Verify: copilotforxcode --version",
      "supercli plugins install ./plugins/CopilotForXcode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CopilotForXcode",
      "resource": "self",
      "action": "version",
      "description": "Print CopilotForXcode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "copilotforxcode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CopilotForXcode: pip install copilotforxcode"
      },
      "args": []
    },
    {
      "namespace": "CopilotForXcode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to copilotforxcode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "copilotforxcode",
        "passthrough": true,
        "missingDependencyHelp": "Install CopilotForXcode: pip install copilotforxcode"
      },
      "args": []
    }
  ]
}