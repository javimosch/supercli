{
  "name": "shortcut",
  "version": "0.1.0",
  "description": "Manage terminal shortcuts and aliases",
  "source": "https://github.com/farskid/shortcut",
  "checks": [{ "type": "binary", "name": "shortcut" }],
  "install_guidance": {
    "plugin": "shortcut",
    "binary": "shortcut",
    "check": "which shortcut",
    "install_steps": ["npm install -g shortcut-cli", "Verify: shortcut --version", "supercli plugins install ./plugins/shortcut --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "shortcut",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to shortcut CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "shortcut",
      "passthrough": true,
      "missingDependencyHelp": "Install shortcut: npm install -g shortcut-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
