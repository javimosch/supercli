{
  "name": "openscreen",
  "version": "0.1.0",
  "description": "Create stunning demos for free. Open-source, no subscriptions, no watermarks, and free for commercia",
  "source": "https://github.com/openscreen/openscreen",
  "checks": [
    {
      "type": "binary",
      "name": "openscreen"
    }
  ],
  "install_guidance": {
    "plugin": "openscreen",
    "binary": "openscreen",
    "check": "which openscreen",
    "install_steps": [
      "pip install openscreen",
      "Verify: openscreen --version",
      "supercli plugins install ./plugins/openscreen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "openscreen",
      "resource": "self",
      "action": "version",
      "description": "Print openscreen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openscreen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install openscreen: pip install openscreen"
      },
      "args": []
    },
    {
      "namespace": "openscreen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openscreen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openscreen",
        "passthrough": true,
        "missingDependencyHelp": "Install openscreen: pip install openscreen"
      },
      "args": []
    }
  ]
}