{
  "name": "ChatTTS",
  "version": "0.1.0",
  "description": "A generative speech model for daily dialogue.",
  "source": "https://github.com/ChatTTS/ChatTTS",
  "checks": [
    {
      "type": "binary",
      "name": "chattts"
    }
  ],
  "install_guidance": {
    "plugin": "ChatTTS",
    "binary": "chattts",
    "check": "which chattts",
    "install_steps": [
      "pip install chattts",
      "Verify: chattts --version",
      "supercli plugins install ./plugins/ChatTTS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ChatTTS",
      "resource": "self",
      "action": "version",
      "description": "Print ChatTTS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chattts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ChatTTS: pip install chattts"
      },
      "args": []
    },
    {
      "namespace": "ChatTTS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chattts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chattts",
        "passthrough": true,
        "missingDependencyHelp": "Install ChatTTS: pip install chattts"
      },
      "args": []
    }
  ]
}