{
  "name": "xkbwatch",
  "version": "0.1.0",
  "description": "CLI tool: xkbwatch",
  "source": "https://manpages.debian.org/xkbwatch",
  "checks": [
    {
      "type": "binary",
      "name": "xkbwatch"
    }
  ],
  "install_guidance": {
    "plugin": "xkbwatch",
    "binary": "xkbwatch",
    "check": "which xkbwatch",
    "install_steps": [
      "apt-get install xkbwatch 2>/dev/null || which xkbwatch",
      "Verify: xkbwatch --version",
      "supercli plugins install ./plugins/xkbwatch --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xkbwatch",
      "resource": "self",
      "action": "version",
      "description": "Print xkbwatch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkbwatch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xkbwatch: apt-get install xkbwatch 2>/dev/null || which xkbwatch"
      },
      "args": []
    },
    {
      "namespace": "xkbwatch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xkbwatch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xkbwatch",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xkbwatch: apt-get install xkbwatch 2>/dev/null || which xkbwatch"
      },
      "args": []
    }
  ]
}