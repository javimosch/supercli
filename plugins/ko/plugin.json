{
  "name": "ko",
  "version": "0.1.0",
  "description": "Build and deploy Go applications as container images",
  "source": "https://github.com/ko-build/ko",
  "checks": [{ "type": "binary", "name": "ko" }],
  "install_guidance": {
    "plugin": "ko",
    "binary": "ko",
    "check": "which ko",
    "install_steps": ["go install github.com/google/ko@latest", "Verify: ko --version", "supercli plugins install ./plugins/ko --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ko",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ko CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ko",
      "passthrough": true,
      "missingDependencyHelp": "Install ko: go install github.com/google/ko@latest"
    },
    "args": []
  }]
}
