{
  "name": "ok-skills",
  "version": "0.1.0",
  "description": "Curated AI coding agent skills and AGENTS.md playbooks for Codex, Claude Code, Cursor, and other SKILL.md-compatible tools",
  "source": "https://github.com/mxyhi/ok-skills",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "ok-skills",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/mxyhi/ok-skills.git",
      "supercli plugins install ./plugins/ok-skills --on-conflict replace --json",
      "sc skills teach ok-skills:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "ok-skills", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["ok-skills v0.1.0 — Use sc skills teach ok-skills:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/mxyhi/ok-skills.git" }, "args": [] },
    { "namespace": "ok-skills", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/mxyhi/ok-skills.git then: sc skills teach ok-skills:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/mxyhi/ok-skills.git" }, "args": [] }
  ]
}
