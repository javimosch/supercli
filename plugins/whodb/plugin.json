{
  "name": "whodb",
  "version": "0.1.0",
  "description": "A lightweight next-gen data explorer - Postgres, MySQL, SQLite, MongoDB, Redis, MariaDB, Elastic Sea",
  "source": "https://github.com/whodb/whodb",
  "checks": [
    {
      "type": "binary",
      "name": "whodb"
    }
  ],
  "install_guidance": {
    "plugin": "whodb",
    "binary": "whodb",
    "check": "which whodb",
    "install_steps": [
      "pip install whodb",
      "Verify: whodb --version",
      "supercli plugins install ./plugins/whodb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "whodb",
      "resource": "self",
      "action": "version",
      "description": "Print whodb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "whodb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install whodb: pip install whodb"
      },
      "args": []
    },
    {
      "namespace": "whodb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to whodb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "whodb",
        "passthrough": true,
        "missingDependencyHelp": "Install whodb: pip install whodb"
      },
      "args": []
    }
  ]
}