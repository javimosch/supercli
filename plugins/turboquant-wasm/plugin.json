{
  "name": "turboquant-wasm",
  "version": "0.1.0",
  "description": "WASM SIMD vector compression",
  "source": "https://github.com/nickelc/turboquant-wasm",
  "checks": [
    {
      "type": "binary",
      "name": "turboquant"
    }
  ],
  "install_guidance": {
    "plugin": "turboquant-wasm",
    "binary": "turboquant",
    "check": "which turboquant",
    "install_steps": [
      "cargo install turboquant-wasm",
      "Verify: turboquant --version",
      "supercli plugins install ./plugins/turboquant-wasm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "turboquant-wasm",
      "resource": "self",
      "action": "version",
      "description": "Print turboquant-wasm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "turboquant",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install turboquant-wasm: cargo install turboquant-wasm"
      },
      "args": []
    },
    {
      "namespace": "turboquant-wasm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to turboquant",
      "adapter": "process",
      "adapterConfig": {
        "command": "turboquant",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install turboquant-wasm: cargo install turboquant-wasm"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
