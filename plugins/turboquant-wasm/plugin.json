{
  "name": "turboquant-wasm",
  "version": "0.1.0",
  "description": "TurboQuant WASM SIMD vector compression \u2014 3 bits/dim with fast dot product. Requires relaxed SIMD (C",
  "source": "https://github.com/turboquant-wasm/turboquant-wasm",
  "checks": [
    {
      "type": "binary",
      "name": "turboquant-wasm"
    }
  ],
  "install_guidance": {
    "plugin": "turboquant-wasm",
    "binary": "turboquant-wasm",
    "check": "which turboquant-wasm",
    "install_steps": [
      "pip install turboquant-wasm",
      "Verify: turboquant-wasm --version",
      "supercli plugins install ./plugins/turboquant-wasm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "turboquant-wasm",
      "resource": "self",
      "action": "version",
      "description": "Print turboquant-wasm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "turboquant-wasm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install turboquant-wasm: pip install turboquant-wasm"
      },
      "args": []
    },
    {
      "namespace": "turboquant-wasm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to turboquant-wasm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "turboquant-wasm",
        "passthrough": true,
        "missingDependencyHelp": "Install turboquant-wasm: pip install turboquant-wasm"
      },
      "args": []
    }
  ]
}