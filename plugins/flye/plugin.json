{
  "name": "flye",
  "version": "0.1.0",
  "description": "De novo assembler for single molecule sequencing reads using repeat graphs",
  "source": "https://github.com/mikolmogorov/Flye",
  "checks": [
    {
      "type": "binary",
      "name": "flye"
    }
  ],
  "install_guidance": {
    "plugin": "flye",
    "binary": "flye",
    "check": "which flye",
    "install_steps": [
      "brew install flye",
      "Verify: flye --version",
      "supercli plugins install ./plugins/flye --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "flye",
      "resource": "self",
      "action": "version",
      "description": "Print flye version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flye",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flye: brew install flye"
      },
      "args": []
    },
    {
      "namespace": "flye",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flye CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flye",
        "passthrough": true,
        "missingDependencyHelp": "Install flye"
      },
      "args": []
    }
  ]
}