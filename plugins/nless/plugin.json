{
  "name": "nless",
  "version": "0.1.0",
  "description": "Interactive pager for exploring tabular data",
  "source": "https://github.com/mpryor/nothing-less",
  "checks": [
    {
      "type": "binary",
      "name": "nless"
    }
  ],
  "install_guidance": {
    "plugin": "nless",
    "binary": "nless",
    "check": "which nless",
    "install_steps": [
      "See https://github.com/mpryor/nothing-less",
      "Verify: nless --version",
      "supercli plugins install ./plugins/nless --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "nless",
      "resource": "self",
      "action": "version",
      "description": "Print nless version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nless",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nless: See https://github.com/mpryor/nothing-less"
      },
      "args": []
    },
    {
      "namespace": "nless",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nless CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nless",
        "passthrough": true,
        "missingDependencyHelp": "Install nless"
      },
      "args": []
    }
  ]
}