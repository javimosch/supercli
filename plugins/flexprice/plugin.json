{
  "name": "flexprice",
  "version": "0.1.0",
  "description": "Usage-based pricing and billing for developers \ud83d\udd13 Cloud or self-hosted \u2699\ufe0f No-code UI \ud83d\udcb0 Realtime usage",
  "source": "https://github.com/flexprice/flexprice",
  "checks": [
    {
      "type": "binary",
      "name": "flexprice"
    }
  ],
  "install_guidance": {
    "plugin": "flexprice",
    "binary": "flexprice",
    "check": "which flexprice",
    "install_steps": [
      "pip install flexprice",
      "Verify: flexprice --version",
      "supercli plugins install ./plugins/flexprice --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "flexprice",
      "resource": "self",
      "action": "version",
      "description": "Print flexprice version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flexprice",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flexprice: pip install flexprice"
      },
      "args": []
    },
    {
      "namespace": "flexprice",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flexprice CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flexprice",
        "passthrough": true,
        "missingDependencyHelp": "Install flexprice: pip install flexprice"
      },
      "args": []
    }
  ]
}