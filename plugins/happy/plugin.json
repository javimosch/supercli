{
  "name": "happy",
  "version": "0.1.0",
  "description": "Mobile and Web client for Codex and Claude Code, with realtime voice, encryption and fully featured",
  "source": "https://github.com/happy/happy",
  "checks": [
    {
      "type": "binary",
      "name": "happy"
    }
  ],
  "install_guidance": {
    "plugin": "happy",
    "binary": "happy",
    "check": "which happy",
    "install_steps": [
      "pip install happy",
      "Verify: happy --version",
      "supercli plugins install ./plugins/happy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "happy",
      "resource": "self",
      "action": "version",
      "description": "Print happy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "happy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install happy: pip install happy"
      },
      "args": []
    },
    {
      "namespace": "happy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to happy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "happy",
        "passthrough": true,
        "missingDependencyHelp": "Install happy: pip install happy"
      },
      "args": []
    }
  ]
}