{
  "name": "spinners-cli",
  "version": "0.1.0",
  "description": "Display various terminal spinners with colors",
  "source": "https://github.com/ManrajGrover/spinners-cli",
  "checks": [{ "type": "binary", "name": "spinners-cli" }],
  "install_guidance": {
    "plugin": "spinners-cli",
    "binary": "spinners-cli",
    "check": "which spinners-cli",
    "install_steps": ["npm install -g spinners-cli", "Verify: spinners-cli --version", "supercli plugins install ./plugins/spinners-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "spinners-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to spinners-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "spinners-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install spinners-cli: npm install -g spinners-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
