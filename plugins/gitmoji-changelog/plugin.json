{
  "name": "gitmoji-changelog",
  "version": "0.1.0",
  "description": "Changelog generator with gitmoji in JavaScript",
  "source": "https://github.com/nicholasgasior/gitmoji-changelog",
  "checks": [{"type": "binary", "name": "gitmoji-changelog"}],
  "install_guidance": {
    "plugin": "gitmoji-changelog",
    "binary": "gitmoji-changelog",
    "check": "which gitmoji-changelog",
    "install_steps": [
      "npm install -g gitmoji-changelog",
      "Verify: gitmoji-changelog --version",
      "supercli plugins install ./gitmoji-changelog --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "gitmoji-changelog",
      "resource": "self",
      "action": "version",
      "description": "Print gitmoji-changelog version",
      "adapter": "process",
      "adapterConfig": {"command": "gitmoji-changelog", "baseArgs": ["--version"], "missingDependencyHelp": "Install gitmoji-changelog: npm install -g gitmoji-changelog"},
      "args": []
    },
    {
      "namespace": "gitmoji-changelog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitmoji-changelog CLI",
      "adapter": "process",
      "adapterConfig": {"command": "gitmoji-changelog", "passthrough": true, "missingDependencyHelp": "Install gitmoji-changelog: npm install -g gitmoji-changelog"},
      "args": []
    }
  ]
}
