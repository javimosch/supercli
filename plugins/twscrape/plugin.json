{
  "name": "twscrape",
  "version": "0.1.0",
  "description": "CLI tool: twscrape",
  "source": "https://manpages.debian.org/twscrape",
  "checks": [
    {
      "type": "binary",
      "name": "twscrape"
    }
  ],
  "install_guidance": {
    "plugin": "twscrape",
    "binary": "twscrape",
    "check": "which twscrape",
    "install_steps": [
      "apt-get install twscrape 2>/dev/null || which twscrape",
      "Verify: twscrape --version",
      "supercli plugins install ./plugins/twscrape --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "twscrape",
      "resource": "self",
      "action": "version",
      "description": "Print twscrape version",
      "adapter": "process",
      "adapterConfig": {
        "command": "twscrape",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install twscrape: apt-get install twscrape 2>/dev/null || which twscrape"
      },
      "args": []
    },
    {
      "namespace": "twscrape",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to twscrape CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "twscrape",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install twscrape: apt-get install twscrape 2>/dev/null || which twscrape"
      },
      "args": []
    }
  ]
}