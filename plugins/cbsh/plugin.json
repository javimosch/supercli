{
  "name": "cbsh",
  "version": "0.1.0",
  "description": "Couchbase Shell for interactive database access",
  "source": "https://github.com/couchbaselabs/cbsh",
  "checks": [{ "type": "binary", "name": "cbsh" }],
  "install_guidance": {
    "plugin": "cbsh",
    "binary": "cbsh",
    "check": "which cbsh",
    "install_steps": ["brew install cbsh", "Verify: cbsh --version", "supercli plugins install ./plugins/cbsh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cbsh",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cbsh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cbsh",
      "passthrough": true,
      "missingDependencyHelp": "Install cbsh: brew install cbsh", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
