{
  "name": "at_build",
  "version": "0.1.0",
  "description": "CLI tool: at_build",
  "source": "https://packages.debian.org/at_build",
  "checks": [{ "type": "binary", "name": "at_build" }],
  "install_guidance": {
    "plugin": "at_build", "binary": "at_build", "check": "which at_build",
    "install_steps": ["apt-get install at_build 2>/dev/null || which at_build", "Verify: at_build --version", "supercli plugins install ./plugins/at_build --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_build", "resource": "_", "action": "_",
    "description": "Passthrough to at_build CLI",
    "adapter": "process", "adapterConfig": { "command": "at_build", "passthrough": true, "missingDependencyHelp": "Install at_build: apt-get install at_build" }, "args": []
  }]
}
