{
  "name": "pingfs",
  "version": "0.1.0",
  "description": "Novelty filesystem that stores data in ICMP ping packets",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "pingfs" }],
  "install_guidance": {
    "plugin": "pingfs",
    "binary": "pingfs",
    "check": "which pingfs",
    "install_steps": ["make && sudo make install", "Verify: pingfs --version", "supercli plugins install ./plugins/pingfs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pingfs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pingfs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pingfs",
      "passthrough": true,
      "missingDependencyHelp": "Install pingfs: make && sudo make install"
    },
    "args": []
  }]
}
