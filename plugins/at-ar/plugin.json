{
  "name": "at-ar",
  "version": "0.1.0",
  "description": "CLI tool: at-ar",
  "source": "https://packages.debian.org/at-ar",
  "checks": [{ "type": "binary", "name": "at-ar" }],
  "install_guidance": {
    "plugin": "at-ar", "binary": "at-ar", "check": "which at-ar",
    "install_steps": ["apt-get install at-ar 2>/dev/null || which at-ar", "Verify: at-ar --version", "supercli plugins install ./plugins/at-ar --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-ar", "resource": "_", "action": "_",
    "description": "Passthrough to at-ar CLI",
    "adapter": "process", "adapterConfig": { "command": "at-ar", "passthrough": true, "missingDependencyHelp": "Install at-ar: apt-get install at-ar" }, "args": []
  }]
}
