{
  "name": "go-music-dl",
  "version": "0.1.0",
  "description": "Search and download music from multiple sources via CLI",
  "source": "https://github.com/nicholasgasior/go-music-dl",
  "checks": [
    {
      "type": "binary",
      "name": "go-music-dl"
    }
  ],
  "install_guidance": {
    "plugin": "go-music-dl",
    "binary": "go-music-dl",
    "check": "which go-music-dl",
    "install_steps": [
      "go install github.com/nicholasgasior/go-music-dl@latest",
      "Verify: go-music-dl --version",
      "supercli plugins install ./plugins/go-music-dl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-music-dl",
      "resource": "self",
      "action": "version",
      "description": "Print go-music-dl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-music-dl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-music-dl: go install github.com/nicholasgasior/go-music-dl@latest"
      },
      "args": []
    },
    {
      "namespace": "go-music-dl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-music-dl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-music-dl",
        "passthrough": true,
        "missingDependencyHelp": "Install go-music-dl: go install github.com/nicholasgasior/go-music-dl@latest"
      },
      "args": []
    }
  ]
}
