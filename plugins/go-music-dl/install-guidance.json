{
  "plugin": "go-music-dl",
  "binary": "go-music-dl",
  "check": "which go-music-dl",
  "install_steps": [
    "go install github.com/nicholasgasior/go-music-dl@latest",
    "Verify: go-music-dl --version",
    "supercli plugins install ./plugins/go-music-dl --on-conflict replace --json"
  ],
  "note": "Search and download music tracks from various online sources."
}
