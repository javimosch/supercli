{
  "name": "lowntfs-3g",
  "version": "0.1.0",
  "description": "CLI tool: lowntfs-3g",
  "source": "https://manpages.debian.org/lowntfs-3g",
  "checks": [
    {
      "type": "binary",
      "name": "lowntfs-3g"
    }
  ],
  "install_guidance": {
    "plugin": "lowntfs-3g",
    "binary": "lowntfs-3g",
    "check": "which lowntfs-3g",
    "install_steps": [
      "apt-get install lowntfs-3g 2>/dev/null || which lowntfs-3g",
      "Verify: lowntfs-3g --version",
      "supercli plugins install ./plugins/lowntfs-3g --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lowntfs-3g",
      "resource": "self",
      "action": "version",
      "description": "Print lowntfs-3g version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lowntfs-3g",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lowntfs-3g: apt-get install lowntfs-3g 2>/dev/null || which lowntfs-3g"
      },
      "args": []
    },
    {
      "namespace": "lowntfs-3g",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lowntfs-3g CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lowntfs-3g",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lowntfs-3g: apt-get install lowntfs-3g 2>/dev/null || which lowntfs-3g"
      },
      "args": []
    }
  ]
}