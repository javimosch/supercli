{
  "name": "pycp",
  "version": "0.1.0",
  "description": "cp and mv with a progress bar.",
  "source": "https://github.com/dmerejkowsky/pycp",
  "checks": [
    {
      "type": "binary",
      "name": "pycp"
    }
  ],
  "install_guidance": {
    "plugin": "pycp",
    "binary": "pycp",
    "check": "which pycp",
    "install_steps": [
      "See https://github.com/dmerejkowsky/pycp",
      "Verify: pycp --version",
      "supercli plugins install ./plugins/pycp --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "pycp",
      "resource": "self",
      "action": "version",
      "description": "Print pycp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pycp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pycp: See https://github.com/dmerejkowsky/pycp"
      },
      "args": []
    },
    {
      "namespace": "pycp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pycp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pycp",
        "passthrough": true,
        "missingDependencyHelp": "Install pycp"
      },
      "args": []
    }
  ]
}