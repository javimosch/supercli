{
  "name": "gcc-9",
  "version": "0.1.0",
  "description": "CLI tool: gcc-9",
  "source": "https://manpages.debian.org/gcc-9",
  "checks": [
    {
      "type": "binary",
      "name": "gcc-9"
    }
  ],
  "install_guidance": {
    "plugin": "gcc-9",
    "binary": "gcc-9",
    "check": "which gcc-9",
    "install_steps": [
      "apt-get install gcc-9 2>/dev/null || which gcc-9",
      "Verify: gcc-9 --version",
      "supercli plugins install ./plugins/gcc-9 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gcc-9",
      "resource": "self",
      "action": "version",
      "description": "Print gcc-9 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcc-9",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcc-9: apt-get install gcc-9 2>/dev/null || which gcc-9"
      },
      "args": []
    },
    {
      "namespace": "gcc-9",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcc-9 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcc-9",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gcc-9: apt-get install gcc-9 2>/dev/null || which gcc-9"
      },
      "args": []
    }
  ]
}