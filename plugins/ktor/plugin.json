{
  "name": "ktor",
  "version": "0.1.0",
  "description": "Generates Ktor projects through the command-line interface",
  "source": "https://github.com/ktorio/ktor-cli",
  "checks": [
    {
      "type": "binary",
      "name": "ktor"
    }
  ],
  "install_guidance": {
    "plugin": "ktor",
    "binary": "ktor",
    "check": "which ktor",
    "install_steps": [
      "brew install ktor",
      "Verify: ktor --version",
      "supercli plugins install ./plugins/ktor --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ktor",
      "resource": "self",
      "action": "version",
      "description": "Print ktor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ktor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ktor: brew install ktor"
      },
      "args": []
    },
    {
      "namespace": "ktor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ktor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ktor",
        "passthrough": true,
        "missingDependencyHelp": "Install ktor"
      },
      "args": []
    }
  ]
}