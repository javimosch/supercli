{
  "name": "icdiff",
  "version": "0.1.0",
  "description": "Improved colored side-by-side diff tool. Better than diff with enhanced readability and color highlighting.",
  "source": "https",
  "checks": [{"type": "binary", "name": "icdiff"}],
  "install_guidance": {
    "plugin": "icdiff",
    "binary": "icdiff",
    "check": "which icdiff",
    "install_steps": [
      "brew install icdiff",
      "Verify: icdiff --version",
      "supercli plugins install ./plugins/icdiff --on-conflict replace --json"
    ],
    "note": "Non-interactive CLI tool."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "icdiff",
      "resource": "self",
      "action": "version",
      "description": "Print icdiff version",
      "adapter": "process",
      "adapterConfig": {"command": "icdiff", "baseArgs": ["--version"], "missingDependencyHelp": "Install icdiff: brew install icdiff"},
      "args": []
    },
    {
      "namespace": "icdiff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to icdiff CLI",
      "adapter": "process",
      "adapterConfig": {"command": "icdiff", "passthrough": true, "missingDependencyHelp": "Install icdiff: brew install icdiff"},
      "args": []
    }
  ]
}
