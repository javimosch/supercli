{
  "name": "easy-subtitle",
  "version": "0.1.0",
  "description": "Full subtitle extraction sync and download tool",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "easy-subtitle" }],
  "install_guidance": {
    "plugin": "easy-subtitle",
    "binary": "easy-subtitle",
    "check": "which easy-subtitle",
    "install_steps": ["brew install akitaonrails/tap/easy-subtitle", "Verify: easy-subtitle --version", "supercli plugins install ./plugins/easy-subtitle --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "easy-subtitle",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to easy-subtitle CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "easy-subtitle",
      "passthrough": true,
      "missingDependencyHelp": "Install easy-subtitle: brew install akitaonrails/tap/easy-subtitle"
    },
    "args": []
  }]
}
