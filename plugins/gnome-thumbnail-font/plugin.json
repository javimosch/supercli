{
  "name": "gnome-thumbnail-font",
  "version": "0.1.0",
  "description": "CLI tool: gnome-thumbnail-font",
  "source": "https://manpages.debian.org/gnome-thumbnail-font",
  "checks": [
    {
      "type": "binary",
      "name": "gnome-thumbnail-font"
    }
  ],
  "install_guidance": {
    "plugin": "gnome-thumbnail-font",
    "binary": "gnome-thumbnail-font",
    "check": "which gnome-thumbnail-font",
    "install_steps": [
      "apt-get install gnome-thumbnail-font 2>/dev/null || which gnome-thumbnail-font",
      "Verify: gnome-thumbnail-font --version",
      "supercli plugins install ./plugins/gnome-thumbnail-font --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gnome-thumbnail-font",
      "resource": "self",
      "action": "version",
      "description": "Print gnome-thumbnail-font version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-thumbnail-font",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gnome-thumbnail-font: apt-get install gnome-thumbnail-font 2>/dev/null || which gnome-thumbnail-font"
      },
      "args": []
    },
    {
      "namespace": "gnome-thumbnail-font",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gnome-thumbnail-font CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnome-thumbnail-font",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gnome-thumbnail-font: apt-get install gnome-thumbnail-font 2>/dev/null || which gnome-thumbnail-font"
      },
      "args": []
    }
  ]
}