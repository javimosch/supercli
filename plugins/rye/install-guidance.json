{
  "plugin": "rye",
  "binary": "rye",
  "check": "which rye",
  "install_steps": [
    "curl -fsSL https://rye.astral.sh/get | bash",
    "Verify: rye --version",
    "supercli plugins install ./plugins/rye --on-conflict replace --json"
  ],
  "note": "Also available via: pip install rye, brew. Requires restarting shell after install."
}
