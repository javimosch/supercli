{
  "name": "newsnow",
  "version": "0.1.0",
  "description": "Elegant reading of real-time and hottest news",
  "source": "https://github.com/newsnow/newsnow",
  "checks": [
    {
      "type": "binary",
      "name": "newsnow"
    }
  ],
  "install_guidance": {
    "plugin": "newsnow",
    "binary": "newsnow",
    "check": "which newsnow",
    "install_steps": [
      "pip install newsnow",
      "Verify: newsnow --version",
      "supercli plugins install ./plugins/newsnow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "newsnow",
      "resource": "self",
      "action": "version",
      "description": "Print newsnow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "newsnow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install newsnow: pip install newsnow"
      },
      "args": []
    },
    {
      "namespace": "newsnow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to newsnow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "newsnow",
        "passthrough": true,
        "missingDependencyHelp": "Install newsnow: pip install newsnow"
      },
      "args": []
    }
  ]
}