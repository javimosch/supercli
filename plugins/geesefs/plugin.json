{
  "name": "geesefs",
  "version": "0.1.0",
  "description": "FUSE FS implementation over S3",
  "source": "https://github.com/yandex-cloud/geesefs",
  "checks": [
    {
      "type": "binary",
      "name": "geesefs"
    }
  ],
  "install_guidance": {
    "plugin": "geesefs",
    "binary": "geesefs",
    "check": "which geesefs",
    "install_steps": [
      "brew install geesefs",
      "Verify: geesefs --version",
      "supercli plugins install ./plugins/geesefs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "geesefs",
      "resource": "self",
      "action": "version",
      "description": "Print geesefs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "geesefs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install geesefs: brew install geesefs"
      },
      "args": []
    },
    {
      "namespace": "geesefs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to geesefs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "geesefs",
        "passthrough": true,
        "missingDependencyHelp": "Install geesefs"
      },
      "args": []
    }
  ]
}