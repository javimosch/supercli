{
  "name": "SemanticVersioningCLI",
  "version": "0.1.0",
  "description": "CLI tools for Semantic Versioning.",
  "source": "https://github.com/SemanticVersioningCLI/SemanticVersioningCLI",
  "checks": [
    {
      "type": "binary",
      "name": "SemanticVersioningCLI"
    }
  ],
  "install_guidance": {
    "plugin": "SemanticVersioningCLI",
    "binary": "SemanticVersioningCLI",
    "check": "which SemanticVersioningCLI",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: SemanticVersioningCLI --version",
      "supercli plugins install ./plugins/SemanticVersioningCLI --on-conflict replace --json"
    ],
    "note": "Swift language CLI tool"
  },
  "commands": [
    {
      "namespace": "SemanticVersioningCLI",
      "resource": "self",
      "action": "version",
      "description": "Print SemanticVersioningCLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "SemanticVersioningCLI",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SemanticVersioningCLI from project repository"
      },
      "args": []
    },
    {
      "namespace": "SemanticVersioningCLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to SemanticVersioningCLI CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "SemanticVersioningCLI",
        "passthrough": true,
        "missingDependencyHelp": "Install SemanticVersioningCLI from project repository"
      },
      "args": []
    }
  ]
}