{
  "name": "xdvipdfmx",
  "version": "0.1.0",
  "description": "CLI tool: xdvipdfmx",
  "source": "https://manpages.debian.org/xdvipdfmx",
  "checks": [
    {
      "type": "binary",
      "name": "xdvipdfmx"
    }
  ],
  "install_guidance": {
    "plugin": "xdvipdfmx",
    "binary": "xdvipdfmx",
    "check": "which xdvipdfmx",
    "install_steps": [
      "apt-get install xdvipdfmx 2>/dev/null || which xdvipdfmx",
      "Verify: xdvipdfmx --version",
      "supercli plugins install ./plugins/xdvipdfmx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xdvipdfmx",
      "resource": "self",
      "action": "version",
      "description": "Print xdvipdfmx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdvipdfmx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xdvipdfmx: apt-get install xdvipdfmx 2>/dev/null || which xdvipdfmx"
      },
      "args": []
    },
    {
      "namespace": "xdvipdfmx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xdvipdfmx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdvipdfmx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xdvipdfmx: apt-get install xdvipdfmx 2>/dev/null || which xdvipdfmx"
      },
      "args": []
    }
  ]
}