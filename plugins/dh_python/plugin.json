{
  "name": "dh_python",
  "version": "0.1.0",
  "description": "CLI tool: dh_python",
  "source": "https://packages.debian.org/dh_python",
  "checks": [{ "type": "binary", "name": "dh_python" }],
  "install_guidance": {
    "plugin": "dh_python", "binary": "dh_python", "check": "which dh_python",
    "install_steps": ["apt-get install dh_python 2>/dev/null || which dh_python", "Verify: dh_python --version", "supercli plugins install ./plugins/dh_python --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_python", "resource": "_", "action": "_",
    "description": "Passthrough to dh_python CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_python", "passthrough": true, "missingDependencyHelp": "Install dh_python: apt-get install dh_python" }, "args": []
  }]
}
