{
  "name": "dufs",
  "version": "0.1.0",
  "description": "Static file server",
  "source": "https://github.com/sigoden/dufs",
  "checks": [
    {
      "type": "binary",
      "name": "dufs"
    }
  ],
  "install_guidance": {
    "plugin": "dufs",
    "binary": "dufs",
    "check": "which dufs",
    "install_steps": [
      "brew install dufs",
      "Verify: dufs --version",
      "supercli plugins install ./plugins/dufs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dufs",
      "resource": "self",
      "action": "version",
      "description": "Print dufs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dufs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dufs: brew install dufs"
      },
      "args": []
    },
    {
      "namespace": "dufs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dufs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dufs",
        "passthrough": true,
        "missingDependencyHelp": "Install dufs"
      },
      "args": []
    }
  ]
}