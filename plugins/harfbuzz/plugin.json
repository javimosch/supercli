{
  "name": "harfbuzz",
  "version": "0.1.0",
  "description": "OpenType text shaping engine",
  "source": "https://github.com/harfbuzz/harfbuzz",
  "checks": [
    {
      "type": "binary",
      "name": "harfbuzz"
    }
  ],
  "install_guidance": {
    "plugin": "harfbuzz",
    "binary": "harfbuzz",
    "check": "which harfbuzz",
    "install_steps": [
      "brew install harfbuzz",
      "Verify: harfbuzz --version",
      "supercli plugins install ./plugins/harfbuzz --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "harfbuzz",
      "resource": "self",
      "action": "version",
      "description": "Print harfbuzz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "harfbuzz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install harfbuzz: brew install harfbuzz"
      },
      "args": []
    },
    {
      "namespace": "harfbuzz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to harfbuzz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "harfbuzz",
        "passthrough": true,
        "missingDependencyHelp": "Install harfbuzz"
      },
      "args": []
    }
  ]
}