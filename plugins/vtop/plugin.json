{
  "name": "vtop",
  "version": "0.1.0",
  "description": "Visual process viewer and system monitor for the terminal",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "vtop" }],
  "install_guidance": {
    "plugin": "vtop",
    "binary": "vtop",
    "check": "which vtop",
    "install_steps": ["npm install -g vtop", "Verify: vtop --version", "supercli plugins install ./plugins/vtop --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vtop",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vtop CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vtop",
      "passthrough": true,
      "missingDependencyHelp": "Install vtop: npm install -g vtop"
    },
    "args": []
  }]
}
