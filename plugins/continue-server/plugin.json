{
  "name": "continue-server",
  "version": "0.1.0",
  "description": "Open-source AI code assistant IDE plugin",
  "source": "https://github.com/continuedev/continue",
  "checks": [{ "type": "binary", "name": "continue" }],
  "install_guidance": {
    "plugin": "continue-server",
    "binary": "continue",
    "check": "which continue",
    "install_steps": ["npm install -g @continuedev/continue", "Verify: continue --version", "supercli plugins install ./plugins/continue-server --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "continue-server",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to continue CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "continue",
      "passthrough": true,
      "missingDependencyHelp": "Install continue-server: npm install -g @continuedev/continue", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
