{
  "name": "cloog",
  "version": "0.1.0",
  "description": "Generate code for scanning Z-polyhedra",
  "source": "https://github.com/periscop/cloog",
  "checks": [
    {
      "type": "binary",
      "name": "cloog"
    }
  ],
  "install_guidance": {
    "plugin": "cloog",
    "binary": "cloog",
    "check": "which cloog",
    "install_steps": [
      "brew install cloog",
      "Verify: cloog --version",
      "supercli plugins install ./plugins/cloog --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cloog",
      "resource": "self",
      "action": "version",
      "description": "Print cloog version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloog",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cloog: brew install cloog"
      },
      "args": []
    },
    {
      "namespace": "cloog",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cloog CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloog",
        "passthrough": true,
        "missingDependencyHelp": "Install cloog"
      },
      "args": []
    }
  ]
}