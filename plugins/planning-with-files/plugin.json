{
  "name": "planning-with-files",
  "version": "0.1.0",
  "description": "Claude Code skill implementing Manus-style persistent markdown planning \u2014 the workflow pattern behin",
  "source": "https://github.com/planning-with-files/planning-with-files",
  "checks": [
    {
      "type": "binary",
      "name": "planning-with-files"
    }
  ],
  "install_guidance": {
    "plugin": "planning-with-files",
    "binary": "planning-with-files",
    "check": "which planning-with-files",
    "install_steps": [
      "pip install planning-with-files",
      "Verify: planning-with-files --version",
      "supercli plugins install ./plugins/planning-with-files --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "planning-with-files",
      "resource": "self",
      "action": "version",
      "description": "Print planning-with-files version",
      "adapter": "process",
      "adapterConfig": {
        "command": "planning-with-files",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install planning-with-files: pip install planning-with-files"
      },
      "args": []
    },
    {
      "namespace": "planning-with-files",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to planning-with-files CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "planning-with-files",
        "passthrough": true,
        "missingDependencyHelp": "Install planning-with-files: pip install planning-with-files"
      },
      "args": []
    }
  ]
}