{
  "plugin": "ordercli",
  "binary": "ordercli",
  "check": "which ordercli",
  "install_steps": [
    "go install github.com/steipete/ordercli/cmd/ordercli@latest",
    "Verify: ordercli --help",
    "supercli plugins install ./plugins/ordercli --on-conflict replace --json"
  ],
  "note": "Currently supports Foodora fully and Deliveroo (WIP). Requires account credentials."
}
