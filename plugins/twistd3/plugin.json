{
  "name": "twistd3",
  "version": "0.1.0",
  "description": "CLI tool: twistd3",
  "source": "https://manpages.debian.org/twistd3",
  "checks": [
    {
      "type": "binary",
      "name": "twistd3"
    }
  ],
  "install_guidance": {
    "plugin": "twistd3",
    "binary": "twistd3",
    "check": "which twistd3",
    "install_steps": [
      "apt-get install twistd3 2>/dev/null || which twistd3",
      "Verify: twistd3 --version",
      "supercli plugins install ./plugins/twistd3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "twistd3",
      "resource": "self",
      "action": "version",
      "description": "Print twistd3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "twistd3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install twistd3: apt-get install twistd3 2>/dev/null || which twistd3"
      },
      "args": []
    },
    {
      "namespace": "twistd3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to twistd3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "twistd3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install twistd3: apt-get install twistd3 2>/dev/null || which twistd3"
      },
      "args": []
    }
  ]
}