{
  "name": "haulable",
  "version": "0.1.0",
  "description": "Create standalone PHP CLI applications with PHP Micro CLI",
  "source": "https://github.com/haulable/haulable",
  "checks": [
    {
      "type": "binary",
      "name": "haulable"
    }
  ],
  "install_guidance": {
    "plugin": "haulable",
    "binary": "haulable",
    "check": "which haulable",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: haulable --version",
      "supercli plugins install ./plugins/haulable --on-conflict replace --json"
    ],
    "note": "PHP language CLI tool"
  },
  "commands": [
    {
      "namespace": "haulable",
      "resource": "self",
      "action": "version",
      "description": "Print haulable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "haulable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install haulable from project repository"
      },
      "args": []
    },
    {
      "namespace": "haulable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to haulable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "haulable",
        "passthrough": true,
        "missingDependencyHelp": "Install haulable from project repository"
      },
      "args": []
    }
  ]
}