{
  "name": "cmatrix",
  "version": "0.1.0",
  "description": "Terminal matrix rain animation",
  "source": "https://packages.debian.org/cmatrix",
  "checks": [
    { "type": "binary", "name": "cmatrix" }
  ],
  "install_guidance": {
    "plugin": "cmatrix",
    "binary": "cmatrix",
    "check": "which cmatrix",
    "install_steps": [
      "apt-get install cmatrix",
      "Verify: cmatrix --version",
      "supercli plugins install ./plugins/cmatrix --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "cmatrix",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmatrix CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmatrix",
        "passthrough": true,
        "missingDependencyHelp": "Install cmatrix: apt-get install cmatrix"
      },
      "args": []
    }
  ]
}
