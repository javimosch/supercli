{
  "name": "ormlite",
  "version": "0.1.0",
  "description": "Rust ORM CLI that auto-generates migrations from structs",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "ormlite" }],
  "install_guidance": {
    "plugin": "ormlite",
    "binary": "ormlite",
    "check": "which ormlite",
    "install_steps": ["cargo install ormlite-cli", "Verify: ormlite --version", "supercli plugins install ./plugins/ormlite --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ormlite",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ormlite CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ormlite",
      "passthrough": true,
      "missingDependencyHelp": "Install ormlite: cargo install ormlite-cli"
    },
    "args": []
  }]
}
