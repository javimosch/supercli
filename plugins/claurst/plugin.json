{
  "name": "claurst",
  "version": "0.1.0",
  "description": "Agentic Coding for Builders who Ship",
  "source": "https://github.com/claurst/claurst",
  "checks": [
    {
      "type": "binary",
      "name": "claurst"
    }
  ],
  "install_guidance": {
    "plugin": "claurst",
    "binary": "claurst",
    "check": "which claurst",
    "install_steps": [
      "pip install claurst",
      "Verify: claurst --version",
      "supercli plugins install ./plugins/claurst --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claurst",
      "resource": "self",
      "action": "version",
      "description": "Print claurst version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claurst",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claurst: pip install claurst"
      },
      "args": []
    },
    {
      "namespace": "claurst",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claurst CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claurst",
        "passthrough": true,
        "missingDependencyHelp": "Install claurst: pip install claurst"
      },
      "args": []
    }
  ]
}