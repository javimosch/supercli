{
  "name": "Alsamixer",
  "version": "0.1.0",
  "description": "ALSA mixer with curses interfaces.",
  "source": "https://github.com/alsa-project/alsa-utils",
  "checks": [
    {
      "type": "binary",
      "name": "Alsamixer"
    }
  ],
  "install_guidance": {
    "plugin": "Alsamixer",
    "binary": "Alsamixer",
    "check": "which Alsamixer",
    "install_steps": [
      "See https://github.com/alsa-project/alsa-utils",
      "Verify: Alsamixer --version",
      "supercli plugins install ./plugins/Alsamixer --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Alsamixer",
      "resource": "self",
      "action": "version",
      "description": "Print Alsamixer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Alsamixer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Alsamixer: See https://github.com/alsa-project/alsa-utils"
      },
      "args": []
    },
    {
      "namespace": "Alsamixer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Alsamixer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Alsamixer",
        "passthrough": true,
        "missingDependencyHelp": "Install Alsamixer"
      },
      "args": []
    }
  ]
}