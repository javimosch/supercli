{
  "name": "ascii-chart",
  "version": "0.1.0",
  "description": "Generate line charts from data in the terminal",
  "source": "https://github.com/kroitor/asciichart",
  "checks": [{ "type": "binary", "name": "ascii-chart" }],
  "install_guidance": {
    "plugin": "ascii-chart",
    "binary": "ascii-chart",
    "check": "which ascii-chart",
    "install_steps": ["npm install -g ascii-chart", "Verify: ascii-chart --version", "supercli plugins install ./plugins/ascii-chart --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ascii-chart",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ascii-chart CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ascii-chart",
      "passthrough": true,
      "missingDependencyHelp": "Install ascii-chart: npm install -g ascii-chart", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
