{
  "name": "e-q-c",
  "version": "0.1.0",
  "description": "Simple CLI calculator for scientific and engineering unit conversions",
  "source": "https://github.com/suntong/e-q-c",
  "checks": [{ "type": "binary", "name": "e-q-c" }],
  "install_guidance": {
    "plugin": "e-q-c",
    "binary": "e-q-c",
    "check": "which e-q-c",
    "install_steps": ["go install github.com/suntong/e-q-c@latest", "Verify: e-q-c --version", "supercli plugins install ./plugins/e-q-c --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "e-q-c",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to e-q-c CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "e-q-c",
      "passthrough": true,
      "missingDependencyHelp": "Install e-q-c: go install github.com/suntong/e-q-c@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
