{
  "name": "OuterTune",
  "version": "0.1.0",
  "description": "A Material 3 Music Player for Android with local file & YouTube Music support. Forked from InnerTune",
  "source": "https://github.com/OuterTune/OuterTune",
  "checks": [
    {
      "type": "binary",
      "name": "outertune"
    }
  ],
  "install_guidance": {
    "plugin": "OuterTune",
    "binary": "outertune",
    "check": "which outertune",
    "install_steps": [
      "pip install outertune",
      "Verify: outertune --version",
      "supercli plugins install ./plugins/OuterTune --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OuterTune",
      "resource": "self",
      "action": "version",
      "description": "Print OuterTune version",
      "adapter": "process",
      "adapterConfig": {
        "command": "outertune",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OuterTune: pip install outertune"
      },
      "args": []
    },
    {
      "namespace": "OuterTune",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to outertune CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "outertune",
        "passthrough": true,
        "missingDependencyHelp": "Install OuterTune: pip install outertune"
      },
      "args": []
    }
  ]
}