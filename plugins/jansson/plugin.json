{
  "name": "jansson",
  "version": "1.0.0",
  "description": "jansson \u2014 JSON library CLI",
  "source": "github.com/akheron/jansson",
  "checks": [
    {
      "type": "binary",
      "name": "jansson"
    }
  ],
  "install_guidance": {
    "plugin": "jansson",
    "binary": "jansson",
    "check": "which jansson",
    "install_steps": [
      "# Install jansson",
      "# See github.com/akheron/jansson",
      "# apt: sudo apt-get install jansson",
      "# brew: brew install jansson",
      "# cargo: cargo install jansson",
      "# npm: npm install -g jansson",
      "# pip: pip install jansson"
    ]
  },
  "commands": [
    {
      "namespace": "jansson",
      "resource": "jansson",
      "action": "run",
      "description": "Run jansson",
      "adapter": "process",
      "adapterConfig": {
        "command": "jansson",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install jansson from github.com/akheron/jansson"
      },
      "args": []
    }
  ]
}