{
  "name": "add-trailing-comma",
  "version": "0.1.0",
  "description": "Add trailing commas to Python calls and literals",
  "source": "https://github.com/asottile/add-trailing-comma",
  "checks": [{ "type": "binary", "name": "add-trailing-comma" }],
  "install_guidance": {
    "plugin": "add-trailing-comma",
    "binary": "add-trailing-comma",
    "check": "which add-trailing-comma",
    "install_steps": ["pip install add-trailing-comma", "Verify: add-trailing-comma --version", "supercli plugins install ./plugins/add-trailing-comma --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "add-trailing-comma",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to add-trailing-comma CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "add-trailing-comma",
      "passthrough": true,
      "missingDependencyHelp": "Install add-trailing-comma: pip install add-trailing-comma", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
