{
  "name": "prompt2dataset-climate",
  "version": "0.1.0",
  "description": "prompt2dataset pipeline — climate mandate",
  "source": "https://github.com/prompt2dataset-climate/prompt2dataset-climate",
  "checks": [
    {
      "type": "binary",
      "name": "prompt2dataset-climate"
    }
  ],
  "install_guidance": {
    "plugin": "prompt2dataset-climate",
    "binary": "prompt2dataset-climate",
    "check": "which prompt2dataset-climate",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: prompt2dataset-climate --version",
      "supercli plugins install ./plugins/prompt2dataset-climate --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "prompt2dataset-climate",
      "resource": "self",
      "action": "version",
      "description": "Print prompt2dataset-climate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "prompt2dataset-climate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install prompt2dataset-climate from project repository"
      },
      "args": []
    },
    {
      "namespace": "prompt2dataset-climate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to prompt2dataset-climate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "prompt2dataset-climate",
        "passthrough": true,
        "missingDependencyHelp": "Install prompt2dataset-climate from project repository"
      },
      "args": []
    }
  ]
}