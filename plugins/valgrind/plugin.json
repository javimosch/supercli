{
  "name": "valgrind",
  "version": "1.0.0",
  "description": "valgrind \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=valgrind+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "valgrind"
    }
  ],
  "install_guidance": {
    "plugin": "valgrind",
    "binary": "valgrind",
    "check": "which valgrind",
    "install_steps": [
      "Install valgrind via package manager: apt install valgrind or brew install valgrind"
    ]
  },
  "commands": [
    {
      "namespace": "valgrind",
      "resource": "run",
      "action": "exec",
      "description": "valgrind \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "valgrind",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install valgrind via your package manager"
      },
      "args": []
    }
  ]
}