{
  "name": "PacketScope",
  "version": "0.1.0",
  "description": "\ud83c\udfaf A general-purpose protocol stack analysis and debugging tool based on eBPF \ud83e\uddf0  ",
  "source": "https://github.com/PacketScope/PacketScope",
  "checks": [
    {
      "type": "binary",
      "name": "packetscope"
    }
  ],
  "install_guidance": {
    "plugin": "PacketScope",
    "binary": "packetscope",
    "check": "which packetscope",
    "install_steps": [
      "pip install packetscope",
      "Verify: packetscope --version",
      "supercli plugins install ./plugins/PacketScope --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PacketScope",
      "resource": "self",
      "action": "version",
      "description": "Print PacketScope version",
      "adapter": "process",
      "adapterConfig": {
        "command": "packetscope",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PacketScope: pip install packetscope"
      },
      "args": []
    },
    {
      "namespace": "PacketScope",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to packetscope CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "packetscope",
        "passthrough": true,
        "missingDependencyHelp": "Install PacketScope: pip install packetscope"
      },
      "args": []
    }
  ]
}