{
  "name": "digger",
  "version": "0.1.0",
  "description": "Digger is an open source IaC orchestration tool. Digger allows you to run IaC in your existing CI pi",
  "source": "https://github.com/digger/digger",
  "checks": [
    {
      "type": "binary",
      "name": "digger"
    }
  ],
  "install_guidance": {
    "plugin": "digger",
    "binary": "digger",
    "check": "which digger",
    "install_steps": [
      "pip install digger",
      "Verify: digger --version",
      "supercli plugins install ./plugins/digger --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "digger",
      "resource": "self",
      "action": "version",
      "description": "Print digger version",
      "adapter": "process",
      "adapterConfig": {
        "command": "digger",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install digger: pip install digger"
      },
      "args": []
    },
    {
      "namespace": "digger",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to digger CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "digger",
        "passthrough": true,
        "missingDependencyHelp": "Install digger: pip install digger"
      },
      "args": []
    }
  ]
}