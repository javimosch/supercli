{
  "name": "pg_isready",
  "version": "0.1.0",
  "description": "CLI tool: pg_isready",
  "source": "https://manpages.debian.org/pg_isready",
  "checks": [
    {
      "type": "binary",
      "name": "pg_isready"
    }
  ],
  "install_guidance": {
    "plugin": "pg_isready",
    "binary": "pg_isready",
    "check": "which pg_isready",
    "install_steps": [
      "apt-get install pg_isready 2>/dev/null || which pg_isready",
      "Verify: pg_isready --version",
      "supercli plugins install ./plugins/pg_isready --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pg_isready",
      "resource": "self",
      "action": "version",
      "description": "Print pg_isready version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg_isready",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pg_isready: apt-get install pg_isready 2>/dev/null || which pg_isready"
      },
      "args": []
    },
    {
      "namespace": "pg_isready",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pg_isready CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pg_isready",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pg_isready: apt-get install pg_isready 2>/dev/null || which pg_isready"
      },
      "args": []
    }
  ]
}