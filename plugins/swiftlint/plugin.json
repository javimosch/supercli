{
  "name": "swiftlint",
  "version": "0.1.0",
  "description": "swiftlint \u2014 tool to enforce Swift style and conventions",
  "source": "https://formulae.brew.sh/formula/swiftlint",
  "checks": [
    {
      "type": "binary",
      "name": "swiftlint"
    }
  ],
  "install_guidance": {
    "plugin": "swiftlint",
    "binary": "swiftlint",
    "check": "which swiftlint",
    "install_steps": [
      "brew install swiftlint"
    ],
    "note": "Dev tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "swiftlint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough",
      "adapter": "process",
      "adapterConfig": {
        "command": "swiftlint",
        "passthrough": true,
        "missingDependencyHelp": "Install swiftlint: brew install swiftlint"
      },
      "args": []
    }
  ]
}
