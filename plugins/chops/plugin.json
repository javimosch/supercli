{
  "name": "chops",
  "version": "0.1.0",
  "description": "Your AI agent skills, finally organized. A macOS app to browse, edit, and manage skills across Claud",
  "source": "https://github.com/chops/chops",
  "checks": [
    {
      "type": "binary",
      "name": "chops"
    }
  ],
  "install_guidance": {
    "plugin": "chops",
    "binary": "chops",
    "check": "which chops",
    "install_steps": [
      "pip install chops",
      "Verify: chops --version",
      "supercli plugins install ./plugins/chops --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "chops",
      "resource": "self",
      "action": "version",
      "description": "Print chops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chops: pip install chops"
      },
      "args": []
    },
    {
      "namespace": "chops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chops",
        "passthrough": true,
        "missingDependencyHelp": "Install chops: pip install chops"
      },
      "args": []
    }
  ]
}