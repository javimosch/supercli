{
  "name": "git-cinnabar",
  "version": "0.1.0",
  "description": "Git remote helper to interact with mercurial repositories",
  "source": "https://github.com/glandium/git-cinnabar",
  "checks": [
    {
      "type": "binary",
      "name": "git-cinnabar"
    }
  ],
  "install_guidance": {
    "plugin": "git-cinnabar",
    "binary": "git-cinnabar",
    "check": "which git-cinnabar",
    "install_steps": [
      "brew install git-cinnabar",
      "Verify: git-cinnabar --version",
      "supercli plugins install ./plugins/git-cinnabar --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-cinnabar",
      "resource": "self",
      "action": "version",
      "description": "Print git-cinnabar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-cinnabar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-cinnabar: brew install git-cinnabar"
      },
      "args": []
    },
    {
      "namespace": "git-cinnabar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-cinnabar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-cinnabar",
        "passthrough": true,
        "missingDependencyHelp": "Install git-cinnabar"
      },
      "args": []
    }
  ]
}