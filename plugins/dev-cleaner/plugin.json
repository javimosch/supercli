{
  "name": "dev-cleaner",
  "version": "0.1.0",
  "description": "Cache Cleaner",
  "source": "https://github.com/jemishavasoya/dev-cleaner",
  "checks": [
    { "type": "binary", "name": "dev-cleaner" }
  ],
  "install_guidance": {
    "plugin": "dev-cleaner",
    "binary": "dev-cleaner",
    "check": "which dev-cleaner",
    "install_steps": [
      "npm install -g dev-cleaner",
      "Verify: dev-cleaner --version",
      "supercli plugins install ./plugins/dev-cleaner --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dev-cleaner",
      "resource": "self",
      "action": "version",
      "description": "Print dev-cleaner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dev-cleaner",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install dev-cleaner: npm install -g dev-cleaner"
      },
      "args": []
    },
    {
      "namespace": "dev-cleaner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dev-cleaner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dev-cleaner",
        "passthrough": true,
        "missingDependencyHelp": "Install dev-cleaner"
      },
      "args": []
    }
  ]
}
