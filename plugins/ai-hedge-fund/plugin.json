{
  "name": "ai-hedge-fund",
  "version": "0.1.0",
  "description": "An AI Hedge Fund Team",
  "source": "https://github.com/ai-hedge-fund/ai-hedge-fund",
  "checks": [
    {
      "type": "binary",
      "name": "ai-hedge-fund"
    }
  ],
  "install_guidance": {
    "plugin": "ai-hedge-fund",
    "binary": "ai-hedge-fund",
    "check": "which ai-hedge-fund",
    "install_steps": [
      "pip install ai-hedge-fund",
      "Verify: ai-hedge-fund --version",
      "supercli plugins install ./plugins/ai-hedge-fund --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ai-hedge-fund",
      "resource": "self",
      "action": "version",
      "description": "Print ai-hedge-fund version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ai-hedge-fund",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ai-hedge-fund: pip install ai-hedge-fund"
      },
      "args": []
    },
    {
      "namespace": "ai-hedge-fund",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ai-hedge-fund CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ai-hedge-fund",
        "passthrough": true,
        "missingDependencyHelp": "Install ai-hedge-fund: pip install ai-hedge-fund"
      },
      "args": []
    }
  ]
}