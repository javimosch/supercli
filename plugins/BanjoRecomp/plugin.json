{
  "name": "BanjoRecomp",
  "version": "0.1.0",
  "description": "PC Port of Banjo-Kazooie made using N64: Recompiled (Windows/Linux/Mac) ",
  "source": "https://github.com/BanjoRecomp/BanjoRecomp",
  "checks": [
    {
      "type": "binary",
      "name": "banjorecomp"
    }
  ],
  "install_guidance": {
    "plugin": "BanjoRecomp",
    "binary": "banjorecomp",
    "check": "which banjorecomp",
    "install_steps": [
      "pip install banjorecomp",
      "Verify: banjorecomp --version",
      "supercli plugins install ./plugins/BanjoRecomp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BanjoRecomp",
      "resource": "self",
      "action": "version",
      "description": "Print BanjoRecomp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "banjorecomp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BanjoRecomp: pip install banjorecomp"
      },
      "args": []
    },
    {
      "namespace": "BanjoRecomp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to banjorecomp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "banjorecomp",
        "passthrough": true,
        "missingDependencyHelp": "Install BanjoRecomp: pip install banjorecomp"
      },
      "args": []
    }
  ]
}