{
  "name": "CnC_Generals_Zero_Hour",
  "version": "0.1.0",
  "description": "Command and Conquer: Generals - Zero Hour",
  "source": "https://github.com/CnC_Generals_Zero_Hour/CnC_Generals_Zero_Hour",
  "checks": [
    {
      "type": "binary",
      "name": "cnc-generals-zero-hour"
    }
  ],
  "install_guidance": {
    "plugin": "CnC_Generals_Zero_Hour",
    "binary": "cnc-generals-zero-hour",
    "check": "which cnc-generals-zero-hour",
    "install_steps": [
      "pip install cnc-generals-zero-hour",
      "Verify: cnc-generals-zero-hour --version",
      "supercli plugins install ./plugins/CnC_Generals_Zero_Hour --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CnC_Generals_Zero_Hour",
      "resource": "self",
      "action": "version",
      "description": "Print CnC_Generals_Zero_Hour version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-generals-zero-hour",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CnC_Generals_Zero_Hour: pip install cnc-generals-zero-hour"
      },
      "args": []
    },
    {
      "namespace": "CnC_Generals_Zero_Hour",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cnc-generals-zero-hour CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-generals-zero-hour",
        "passthrough": true,
        "missingDependencyHelp": "Install CnC_Generals_Zero_Hour: pip install cnc-generals-zero-hour"
      },
      "args": []
    }
  ]
}