{
  "name": "gren",
  "version": "0.1.0",
  "description": "GitHub Release Notes generator from milestones and issues",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "gren" }],
  "install_guidance": {
    "plugin": "gren",
    "binary": "gren",
    "check": "which gren",
    "install_steps": ["npm install -g github-release-notes", "Verify: gren --version", "supercli plugins install ./plugins/gren --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gren",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gren CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gren",
      "passthrough": true,
      "missingDependencyHelp": "Install gren: npm install -g github-release-notes"
    },
    "args": []
  }]
}
