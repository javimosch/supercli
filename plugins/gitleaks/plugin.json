{
  "name": "gitleaks",
  "version": "0.1.0",
  "description": "Detect hardcoded secrets and API keys in git repos",
  "source": "https://github.com/gitleaks/gitleaks",
  "checks": [{ "type": "binary", "name": "gitleaks" }],
  "install_guidance": {
    "plugin": "gitleaks",
    "binary": "gitleaks",
    "check": "which gitleaks",
    "install_steps": ["brew install gitleaks", "Verify: gitleaks --version", "supercli plugins install ./plugins/gitleaks --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gitleaks",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gitleaks CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gitleaks",
      "passthrough": true,
      "missingDependencyHelp": "Install gitleaks: brew install gitleaks"
    },
    "args": []
  }]
}
