{
  "name": "hors",
  "version": "0.1.0",
  "description": "Instant coding answers via the command line.",
  "source": "https://github.com/WindSoilder/hors",
  "checks": [
    {
      "type": "binary",
      "name": "hors"
    }
  ],
  "install_guidance": {
    "plugin": "hors",
    "binary": "hors",
    "check": "which hors",
    "install_steps": [
      "cargo install hors",
      "Verify: hors --version",
      "supercli plugins install ./plugins/hors --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hors",
      "resource": "self",
      "action": "version",
      "description": "Print hors version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hors",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hors: cargo install hors"
      },
      "args": []
    },
    {
      "namespace": "hors",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hors CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hors",
        "passthrough": true,
        "missingDependencyHelp": "Install hors"
      },
      "args": []
    }
  ]
}