{
  "name": "irc-js",
  "version": "0.1.0",
  "description": "Node.js-based IRC library and CLI client",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "irc-js" }],
  "install_guidance": {
    "plugin": "irc-js",
    "binary": "irc-js",
    "check": "which irc-js",
    "install_steps": ["npm install -g irc-js", "Verify: irc-js --version", "supercli plugins install ./plugins/irc-js --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "irc-js",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to irc-js CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "irc-js",
      "passthrough": true,
      "missingDependencyHelp": "Install irc-js: npm install -g irc-js"
    },
    "args": []
  }]
}
