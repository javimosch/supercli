{
  "name": "metro",
  "version": "0.1.0",
  "description": "A multiplatform, compile-time dependency injection framework for Kotlin",
  "source": "https://github.com/metro/metro",
  "checks": [
    {
      "type": "binary",
      "name": "metro"
    }
  ],
  "install_guidance": {
    "plugin": "metro",
    "binary": "metro",
    "check": "which metro",
    "install_steps": [
      "pip install metro",
      "Verify: metro --version",
      "supercli plugins install ./plugins/metro --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "metro",
      "resource": "self",
      "action": "version",
      "description": "Print metro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "metro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install metro: pip install metro"
      },
      "args": []
    },
    {
      "namespace": "metro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to metro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "metro",
        "passthrough": true,
        "missingDependencyHelp": "Install metro: pip install metro"
      },
      "args": []
    }
  ]
}