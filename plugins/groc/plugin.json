{
  "name": "groc",
  "version": "0.1.0",
  "description": "Generate docco-style documentation for source code",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "groc" }],
  "install_guidance": {
    "plugin": "groc",
    "binary": "groc",
    "check": "which groc",
    "install_steps": ["npm install -g groc", "Verify: groc --version", "supercli plugins install ./plugins/groc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "groc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to groc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "groc",
      "passthrough": true,
      "missingDependencyHelp": "Install groc: npm install -g groc"
    },
    "args": []
  }]
}
