{
  "name": "text-cleaner",
  "version": "0.1.0",
  "description": "Strip whitespace and HTML tags from text streams",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "text-cleaner" }],
  "install_guidance": {
    "plugin": "text-cleaner",
    "binary": "text-cleaner",
    "check": "which text-cleaner",
    "install_steps": ["npm install -g text-cleaner", "Verify: text-cleaner --version", "supercli plugins install ./plugins/text-cleaner --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "text-cleaner",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to text-cleaner CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "text-cleaner",
      "passthrough": true,
      "missingDependencyHelp": "Install text-cleaner: npm install -g text-cleaner"
    },
    "args": []
  }]
}
