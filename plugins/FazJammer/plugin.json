{
  "name": "FazJammer",
  "version": "0.1.0",
  "description": "A minimal, simple and effective jammer that jams Wi-Fi, BLE and 2.4 GHz band.",
  "source": "https://github.com/FazJammer/FazJammer",
  "checks": [
    {
      "type": "binary",
      "name": "fazjammer"
    }
  ],
  "install_guidance": {
    "plugin": "FazJammer",
    "binary": "fazjammer",
    "check": "which fazjammer",
    "install_steps": [
      "pip install fazjammer",
      "Verify: fazjammer --version",
      "supercli plugins install ./plugins/FazJammer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FazJammer",
      "resource": "self",
      "action": "version",
      "description": "Print FazJammer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fazjammer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FazJammer: pip install fazjammer"
      },
      "args": []
    },
    {
      "namespace": "FazJammer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fazjammer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fazjammer",
        "passthrough": true,
        "missingDependencyHelp": "Install FazJammer: pip install fazjammer"
      },
      "args": []
    }
  ]
}