{
  "name": "feedgnuplot",
  "version": "1.0.0",
  "description": "feedgnuplot \u2014 Pipe to gnuplot",
  "source": "github.com/dkogan/feedgnuplot",
  "checks": [
    {
      "type": "binary",
      "name": "feedgnuplot"
    }
  ],
  "install_guidance": {
    "plugin": "feedgnuplot",
    "binary": "feedgnuplot",
    "check": "which feedgnuplot",
    "install_steps": [
      "# Install feedgnuplot",
      "# See github.com/dkogan/feedgnuplot",
      "# apt: sudo apt-get install feedgnuplot",
      "# brew: brew install feedgnuplot",
      "# cargo: cargo install feedgnuplot",
      "# npm: npm install -g feedgnuplot",
      "# pip: pip install feedgnuplot"
    ]
  },
  "commands": [
    {
      "namespace": "feedgnuplot",
      "resource": "feedgnuplot",
      "action": "run",
      "description": "Run feedgnuplot",
      "adapter": "process",
      "adapterConfig": {
        "command": "feedgnuplot",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install feedgnuplot from github.com/dkogan/feedgnuplot"
      },
      "args": []
    }
  ]
}