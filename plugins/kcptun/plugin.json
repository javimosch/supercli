{
  "name": "kcptun",
  "version": "0.1.0",
  "description": "Stable & Secure Tunnel based on KCP with N:M multiplexing and FEC",
  "source": "https://github.com/xtaci/kcptun",
  "checks": [
    {
      "type": "binary",
      "name": "kcptun"
    }
  ],
  "install_guidance": {
    "plugin": "kcptun",
    "binary": "kcptun",
    "check": "which kcptun",
    "install_steps": [
      "brew install kcptun",
      "Verify: kcptun --version",
      "supercli plugins install ./plugins/kcptun --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "kcptun",
      "resource": "self",
      "action": "version",
      "description": "Print kcptun version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kcptun",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kcptun: brew install kcptun"
      },
      "args": []
    },
    {
      "namespace": "kcptun",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kcptun CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kcptun",
        "passthrough": true,
        "missingDependencyHelp": "Install kcptun"
      },
      "args": []
    }
  ]
}