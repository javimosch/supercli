{
  "name": "halp",
  "version": "0.1.0",
  "description": "halp \u2014 a CLI tool to get help with CLI tools.",
  "source": "https://github.com/orhun/halp",
  "checks": [
    {
      "type": "binary",
      "name": "halp"
    }
  ],
  "install_guidance": {
    "plugin": "halp",
    "binary": "halp",
    "check": "which halp",
    "install_steps": [
      "cargo install halp",
      "brew install halp",
      "supercli plugins install ./plugins/halp --on-conflict replace --json"
    ],
    "note": "Rust. CLI help tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "halp",
      "resource": "help",
      "action": "find",
      "description": "Find help for a CLI command",
      "adapter": "process",
      "adapterConfig": {
        "command": "halp",
        "missingDependencyHelp": "Install halp",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "halp",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "halp",
        "missingDependencyHelp": "Install halp",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
