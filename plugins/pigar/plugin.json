{
  "name": "pigar",
  "version": "0.1.0",
  "description": "Generate requirements.txt from Python project imports",
  "source": "https://github.com/damnever/pigar",
  "checks": [{ "type": "binary", "name": "pigar" }],
  "install_guidance": {
    "plugin": "pigar",
    "binary": "pigar",
    "check": "which pigar",
    "install_steps": ["pip install pigar", "Verify: pigar --version", "supercli plugins install ./plugins/pigar --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pigar",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pigar CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pigar",
      "passthrough": true,
      "missingDependencyHelp": "Install pigar: pip install pigar", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
