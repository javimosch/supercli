{
  "name": "poof",
  "version": "0.1.0",
  "description": "Ephemeral filesystem isolation via Linux overlayfs (experimental)",
  "source": "https://github.com/poof/poof",
  "checks": [
    {
      "type": "binary",
      "name": "poof"
    }
  ],
  "install_guidance": {
    "plugin": "poof",
    "binary": "poof",
    "check": "which poof",
    "install_steps": [
      "pip install poof",
      "Verify: poof --version",
      "supercli plugins install ./plugins/poof --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "poof",
      "resource": "self",
      "action": "version",
      "description": "Print poof version",
      "adapter": "process",
      "adapterConfig": {
        "command": "poof",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install poof: pip install poof"
      },
      "args": []
    },
    {
      "namespace": "poof",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to poof CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "poof",
        "passthrough": true,
        "missingDependencyHelp": "Install poof: pip install poof"
      },
      "args": []
    }
  ]
}