{
  "name": "afuse",
  "version": "0.1.0",
  "description": "Automounting file system implemented in userspace with FUSE",
  "source": "https://github.com/pcarrier/afuse/",
  "checks": [
    {
      "type": "binary",
      "name": "afuse"
    }
  ],
  "install_guidance": {
    "plugin": "afuse",
    "binary": "afuse",
    "check": "which afuse",
    "install_steps": [
      "brew install afuse",
      "Verify: afuse --version",
      "supercli plugins install ./plugins/afuse --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "afuse",
      "resource": "self",
      "action": "version",
      "description": "Print afuse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "afuse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install afuse: brew install afuse"
      },
      "args": []
    },
    {
      "namespace": "afuse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to afuse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "afuse",
        "passthrough": true,
        "missingDependencyHelp": "Install afuse"
      },
      "args": []
    }
  ]
}