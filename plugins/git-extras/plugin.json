{
  "name": "git-extras",
  "version": "0.1.0",
  "description": "Git utility commands that extend git with changelog, effort, summary, ignore, and more subcommands.",
  "source": "https",
  "checks": [{"type": "binary", "name": "git"}],
  "install_guidance": {
    "plugin": "git-extras",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "brew install git-extras",
      "Verify: git --version",
      "supercli plugins install ./plugins/git-extras --on-conflict replace --json"
    ],
    "note": "Non-interactive CLI tool."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "git",
      "resource": "self",
      "action": "version",
      "description": "Print git-extras version",
      "adapter": "process",
      "adapterConfig": {"command": "git", "baseArgs": ["--version"], "missingDependencyHelp": "Install git-extras: brew install git-extras"},
      "args": []
    },
    {
      "namespace": "git",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git CLI",
      "adapter": "process",
      "adapterConfig": {"command": "git", "passthrough": true, "missingDependencyHelp": "Install git-extras: brew install git-extras"},
      "args": []
    }
  ]
}
