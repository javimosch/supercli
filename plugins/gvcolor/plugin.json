{
  "name": "gvcolor",
  "version": "0.1.0",
  "description": "CLI tool: gvcolor",
  "source": "https://manpages.debian.org/gvcolor",
  "checks": [
    {
      "type": "binary",
      "name": "gvcolor"
    }
  ],
  "install_guidance": {
    "plugin": "gvcolor",
    "binary": "gvcolor",
    "check": "which gvcolor",
    "install_steps": [
      "apt-get install gvcolor 2>/dev/null || which gvcolor",
      "Verify: gvcolor --version",
      "supercli plugins install ./plugins/gvcolor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gvcolor",
      "resource": "self",
      "action": "version",
      "description": "Print gvcolor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvcolor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gvcolor: apt-get install gvcolor 2>/dev/null || which gvcolor"
      },
      "args": []
    },
    {
      "namespace": "gvcolor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gvcolor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gvcolor",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gvcolor: apt-get install gvcolor 2>/dev/null || which gvcolor"
      },
      "args": []
    }
  ]
}