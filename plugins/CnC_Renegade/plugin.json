{
  "name": "CnC_Renegade",
  "version": "0.1.0",
  "description": "Command and Conquer: Renegade",
  "source": "https://github.com/CnC_Renegade/CnC_Renegade",
  "checks": [
    {
      "type": "binary",
      "name": "cnc-renegade"
    }
  ],
  "install_guidance": {
    "plugin": "CnC_Renegade",
    "binary": "cnc-renegade",
    "check": "which cnc-renegade",
    "install_steps": [
      "pip install cnc-renegade",
      "Verify: cnc-renegade --version",
      "supercli plugins install ./plugins/CnC_Renegade --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CnC_Renegade",
      "resource": "self",
      "action": "version",
      "description": "Print CnC_Renegade version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-renegade",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CnC_Renegade: pip install cnc-renegade"
      },
      "args": []
    },
    {
      "namespace": "CnC_Renegade",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cnc-renegade CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cnc-renegade",
        "passthrough": true,
        "missingDependencyHelp": "Install CnC_Renegade: pip install cnc-renegade"
      },
      "args": []
    }
  ]
}