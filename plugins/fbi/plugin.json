{
  "name": "fbi",
  "version": "1.0.0",
  "description": "fbi \u2014 Framebuffer image viewer",
  "source": "github.com/knokko/fbi",
  "checks": [
    {
      "type": "binary",
      "name": "fbi"
    }
  ],
  "install_guidance": {
    "plugin": "fbi",
    "binary": "fbi",
    "check": "which fbi",
    "install_steps": [
      "# Install fbi",
      "# See github.com/knokko/fbi",
      "# apt: sudo apt-get install fbi",
      "# brew: brew install fbi",
      "# cargo: cargo install fbi",
      "# npm: npm install -g fbi",
      "# pip: pip install fbi"
    ]
  },
  "commands": [
    {
      "namespace": "fbi",
      "resource": "fbi",
      "action": "run",
      "description": "Run fbi",
      "adapter": "process",
      "adapterConfig": {
        "command": "fbi",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fbi from github.com/knokko/fbi"
      },
      "args": []
    }
  ]
}