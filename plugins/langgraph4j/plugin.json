{
  "name": "langgraph4j",
  "version": "0.1.0",
  "description": "\ud83d\ude80 LangGraph for Java. A library for develop AI Agentic Architectures in the Java ecosystem. Designed",
  "source": "https://github.com/langgraph4j/langgraph4j",
  "checks": [
    {
      "type": "binary",
      "name": "langgraph4j"
    }
  ],
  "install_guidance": {
    "plugin": "langgraph4j",
    "binary": "langgraph4j",
    "check": "which langgraph4j",
    "install_steps": [
      "pip install langgraph4j",
      "Verify: langgraph4j --version",
      "supercli plugins install ./plugins/langgraph4j --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "langgraph4j",
      "resource": "self",
      "action": "version",
      "description": "Print langgraph4j version",
      "adapter": "process",
      "adapterConfig": {
        "command": "langgraph4j",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install langgraph4j: pip install langgraph4j"
      },
      "args": []
    },
    {
      "namespace": "langgraph4j",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to langgraph4j CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "langgraph4j",
        "passthrough": true,
        "missingDependencyHelp": "Install langgraph4j: pip install langgraph4j"
      },
      "args": []
    }
  ]
}