{
  "name": "csv-diff",
  "version": "0.1.0",
  "description": "Find differences between two CSV files",
  "source": "gem",
  "checks": [{ "type": "binary", "name": "csv-diff" }],
  "install_guidance": {
    "plugin": "csv-diff",
    "binary": "csv-diff",
    "check": "which csv-diff",
    "install_steps": ["gem install csv-diff", "Verify: csv-diff --version", "supercli plugins install ./plugins/csv-diff --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "csv-diff",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to csv-diff CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "csv-diff",
      "passthrough": true,
      "missingDependencyHelp": "Install csv-diff: gem install csv-diff"
    },
    "args": []
  }]
}
