{
  "name": "flux-check",
  "version": "0.1.0",
  "description": "Pre-flight checks for Flux CD compatibility",
  "source": "https://github.com/fluxcd/flux2",
  "checks": [{ "type": "binary", "name": "flux-check" }],
  "install_guidance": {
    "plugin": "flux-check",
    "binary": "flux-check",
    "check": "which flux-check",
    "install_steps": ["brew install flux-check", "Verify: flux-check --version", "supercli plugins install ./plugins/flux-check --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "flux-check",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to flux-check CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "flux-check",
      "passthrough": true,
      "missingDependencyHelp": "Install flux-check: brew install flux-check"
    },
    "args": []
  }]
}
