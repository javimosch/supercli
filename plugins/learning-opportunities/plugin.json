{
  "name": "learning-opportunities",
  "version": "0.1.0",
  "description": "A Claude or Codex skill for deliberate skill development during AI-assisted coding",
  "source": "https://github.com/learning-opportunities/learning-opportunities",
  "checks": [
    {
      "type": "binary",
      "name": "learning-opportunities"
    }
  ],
  "install_guidance": {
    "plugin": "learning-opportunities",
    "binary": "learning-opportunities",
    "check": "which learning-opportunities",
    "install_steps": [
      "pip install learning-opportunities",
      "Verify: learning-opportunities --version",
      "supercli plugins install ./plugins/learning-opportunities --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "learning-opportunities",
      "resource": "self",
      "action": "version",
      "description": "Print learning-opportunities version",
      "adapter": "process",
      "adapterConfig": {
        "command": "learning-opportunities",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install learning-opportunities: pip install learning-opportunities"
      },
      "args": []
    },
    {
      "namespace": "learning-opportunities",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to learning-opportunities CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "learning-opportunities",
        "passthrough": true,
        "missingDependencyHelp": "Install learning-opportunities: pip install learning-opportunities"
      },
      "args": []
    }
  ]
}