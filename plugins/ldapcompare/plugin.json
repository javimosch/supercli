{
  "name": "ldapcompare",
  "version": "0.1.0",
  "description": "CLI tool: ldapcompare",
  "source": "https://manpages.debian.org/ldapcompare",
  "checks": [
    {
      "type": "binary",
      "name": "ldapcompare"
    }
  ],
  "install_guidance": {
    "plugin": "ldapcompare",
    "binary": "ldapcompare",
    "check": "which ldapcompare",
    "install_steps": [
      "apt-get install ldapcompare 2>/dev/null || which ldapcompare",
      "Verify: ldapcompare --version",
      "supercli plugins install ./plugins/ldapcompare --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ldapcompare",
      "resource": "self",
      "action": "version",
      "description": "Print ldapcompare version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapcompare",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ldapcompare: apt-get install ldapcompare 2>/dev/null || which ldapcompare"
      },
      "args": []
    },
    {
      "namespace": "ldapcompare",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ldapcompare CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapcompare",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ldapcompare: apt-get install ldapcompare 2>/dev/null || which ldapcompare"
      },
      "args": []
    }
  ]
}