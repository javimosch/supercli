{
  "name": "farm",
  "version": "0.1.0",
  "description": "Extremely fast web build tool in Rust",
  "source": "https://github.com/farm-fe/farm",
  "checks": [{ "type": "binary", "name": "farm" }],
  "install_guidance": {
    "plugin": "farm",
    "binary": "farm",
    "check": "which farm",
    "install_steps": ["npm install -g @farmfe/cli", "Verify: farm --version", "supercli plugins install ./plugins/farm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "farm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to farm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "farm",
      "passthrough": true,
      "missingDependencyHelp": "Install farm: npm install -g @farmfe/cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
