{
  "name": "mk",
  "version": "0.1.0",
  "description": "Exposes most common actions you can run in unfamiliar repos",
  "source": "https://github.com/pycontribs/mk",
  "checks": [
    {
      "type": "binary",
      "name": "mk"
    }
  ],
  "install_guidance": {
    "plugin": "mk",
    "binary": "mk",
    "check": "which mk",
    "install_steps": [
      "brew install mk",
      "Verify: mk --version",
      "supercli plugins install ./plugins/mk --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "mk",
      "resource": "self",
      "action": "version",
      "description": "Print mk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mk: brew install mk"
      },
      "args": []
    },
    {
      "namespace": "mk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mk",
        "passthrough": true,
        "missingDependencyHelp": "Install mk"
      },
      "args": []
    }
  ]
}