{
  "name": "dee-ssl",
  "version": "0.1.0",
  "description": "Check SSL/TLS certificate information with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-ssl" }],
  "install_guidance": {
    "plugin": "dee-ssl",
    "binary": "dee-ssl",
    "check": "which dee-ssl",
    "install_steps": ["cargo install dee-ssl", "Verify: dee-ssl --version", "supercli plugins install ./plugins/dee-ssl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-ssl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-ssl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-ssl",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-ssl: cargo install dee-ssl"
    },
    "args": []
  }]
}
