{
  "name": "piprot",
  "version": "0.1.0",
  "description": "Check how rotten your pip requirements are",
  "source": "https://github.com/sesh/piprot",
  "checks": [{ "type": "binary", "name": "piprot" }],
  "install_guidance": {
    "plugin": "piprot",
    "binary": "piprot",
    "check": "which piprot",
    "install_steps": ["pip install piprot", "Verify: piprot --version", "supercli plugins install ./plugins/piprot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "piprot",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to piprot CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "piprot",
      "passthrough": true,
      "missingDependencyHelp": "Install piprot: pip install piprot", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
