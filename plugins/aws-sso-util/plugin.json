{
  "name": "aws-sso-util",
  "version": "0.1.0",
  "description": "Smooth out the rough edges of AWS SSO (temporarily, until AWS makes it better)",
  "source": "https://github.com/benkehoe/aws-sso-util",
  "checks": [
    {
      "type": "binary",
      "name": "aws-sso-util"
    }
  ],
  "install_guidance": {
    "plugin": "aws-sso-util",
    "binary": "aws-sso-util",
    "check": "which aws-sso-util",
    "install_steps": [
      "brew install aws-sso-util",
      "Verify: aws-sso-util --version",
      "supercli plugins install ./plugins/aws-sso-util --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "aws-sso-util",
      "resource": "self",
      "action": "version",
      "description": "Print aws-sso-util version",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-sso-util",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install aws-sso-util: brew install aws-sso-util"
      },
      "args": []
    },
    {
      "namespace": "aws-sso-util",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to aws-sso-util CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "aws-sso-util",
        "passthrough": true,
        "missingDependencyHelp": "Install aws-sso-util"
      },
      "args": []
    }
  ]
}