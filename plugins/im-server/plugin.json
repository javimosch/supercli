{
  "name": "im-server",
  "version": "0.1.0",
  "description": "A high-performance IM server.",
  "source": "https://github.com/im-server/im-server",
  "checks": [
    {
      "type": "binary",
      "name": "im-server"
    }
  ],
  "install_guidance": {
    "plugin": "im-server",
    "binary": "im-server",
    "check": "which im-server",
    "install_steps": [
      "pip install im-server",
      "Verify: im-server --version",
      "supercli plugins install ./plugins/im-server --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "im-server",
      "resource": "self",
      "action": "version",
      "description": "Print im-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "im-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install im-server: pip install im-server"
      },
      "args": []
    },
    {
      "namespace": "im-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to im-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "im-server",
        "passthrough": true,
        "missingDependencyHelp": "Install im-server: pip install im-server"
      },
      "args": []
    }
  ]
}