{
  "name": "roll",
  "version": "0.1.0",
  "description": "Lightweight command-line dice roller for tabletop RPGs",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "roll" }],
  "install_guidance": {
    "plugin": "roll",
    "binary": "roll",
    "check": "which roll",
    "install_steps": ["brew install roll", "Verify: roll --version", "supercli plugins install ./plugins/roll --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "roll",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to roll CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "roll",
      "passthrough": true,
      "missingDependencyHelp": "Install roll: brew install roll"
    },
    "args": []
  }]
}
