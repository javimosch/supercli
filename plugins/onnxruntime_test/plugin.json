{
  "name": "onnxruntime_test",
  "version": "0.1.0",
  "description": "CLI tool: onnxruntime_test",
  "source": "https://manpages.debian.org/onnxruntime_test",
  "checks": [
    {
      "type": "binary",
      "name": "onnxruntime_test"
    }
  ],
  "install_guidance": {
    "plugin": "onnxruntime_test",
    "binary": "onnxruntime_test",
    "check": "which onnxruntime_test",
    "install_steps": [
      "apt-get install onnxruntime_test 2>/dev/null || which onnxruntime_test",
      "Verify: onnxruntime_test --version",
      "supercli plugins install ./plugins/onnxruntime_test --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "onnxruntime_test",
      "resource": "self",
      "action": "version",
      "description": "Print onnxruntime_test version",
      "adapter": "process",
      "adapterConfig": {
        "command": "onnxruntime_test",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install onnxruntime_test: apt-get install onnxruntime_test 2>/dev/null || which onnxruntime_test"
      },
      "args": []
    },
    {
      "namespace": "onnxruntime_test",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to onnxruntime_test CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "onnxruntime_test",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install onnxruntime_test: apt-get install onnxruntime_test 2>/dev/null || which onnxruntime_test"
      },
      "args": []
    }
  ]
}