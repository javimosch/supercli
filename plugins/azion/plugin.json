{
  "name": "azion",
  "version": "0.1.0",
  "description": "CLI for the Azion service",
  "source": "https://github.com/aziontech/azion",
  "checks": [
    {
      "type": "binary",
      "name": "azion"
    }
  ],
  "install_guidance": {
    "plugin": "azion",
    "binary": "azion",
    "check": "which azion",
    "install_steps": [
      "brew install azion",
      "Verify: azion --version",
      "supercli plugins install ./plugins/azion --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "azion",
      "resource": "self",
      "action": "version",
      "description": "Print azion version",
      "adapter": "process",
      "adapterConfig": {
        "command": "azion",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install azion: brew install azion"
      },
      "args": []
    },
    {
      "namespace": "azion",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to azion CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "azion",
        "passthrough": true,
        "missingDependencyHelp": "Install azion"
      },
      "args": []
    }
  ]
}