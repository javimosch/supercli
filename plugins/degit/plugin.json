{
  "name": "degit",
  "version": "0.1.0",
  "description": "Straightforward project scaffolding from git repos",
  "source": "https://github.com/Rich-Harris/degit",
  "checks": [
    {
      "type": "binary",
      "name": "degit"
    }
  ],
  "install_guidance": {
    "plugin": "degit",
    "binary": "degit",
    "check": "which degit",
    "install_steps": [
      "npm install -g degit",
      "Verify: degit --version",
      "supercli plugins install ./plugins/degit --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "degit",
      "resource": "self",
      "action": "version",
      "description": "Print degit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "degit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install degit: npm install -g degit"
      },
      "args": []
    },
    {
      "namespace": "degit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to degit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "degit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install degit: npm install -g degit"
      },
      "args": []
    }
  ]
}
