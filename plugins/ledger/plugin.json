{
  "name": "ledger",
  "version": "0.1.0",
  "description": "Ledger — powerful, double-entry accounting system for the command line. Track finances with plain text files. Reports for balance, register, accounts, payees, commodities, and more.",
  "source": "https://ledger-cli.org/doc/ledger.1.html",
  "checks": [
    {
      "type": "binary",
      "name": "ledger"
    }
  ],
  "install_guidance": {
    "plugin": "ledger",
    "binary": "ledger",
    "check": "which ledger",
    "install_steps": [
      "brew install ledger",
      "apt install ledger",
      "Verify: ledger --version",
      "supercli plugins install ./plugins/ledger --on-conflict replace --json"
    ],
    "note": "Available via brew, apt, dnf, pacman, and from source. Requires a journal file (.ledger or .dat) — pass with -f or set $LEDGER_FILE."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
