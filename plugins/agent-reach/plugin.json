{
  "name": "agent-reach",
  "version": "0.1.0",
  "description": "agent-reach — give AI agents internet access: search Twitter, Reddit, YouTube, GitHub, RSS, and more with zero API fees",
  "source": "https://github.com/Panniantong/agent-reach",
  "checks": [
    { "type": "binary", "name": "agent-reach" }
  ],
  "install_guidance": {
    "plugin": "agent-reach",
    "binary": "agent-reach",
    "check": "which agent-reach",
    "install_steps": [
      "pipx install https://github.com/Panniantong/agent-reach/archive/main.zip",
      "agent-reach install --env=auto",
      "Verify: agent-reach doctor",
      "supercli plugins install ./plugins/agent-reach --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agent-reach",
      "resource": "self",
      "action": "version",
      "description": "Print agent-reach version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "setup",
      "action": "install",
      "description": "Install core channels (web, YouTube, GitHub, RSS, Exa search). Use --channels=twitter,weibo,all for optional channels. Use --safe for safe mode, --dry-run to preview.",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "baseArgs": ["install", "--env=auto"],
        "passthrough": true,
        "timeout_ms": 600000,
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "setup",
      "action": "doctor",
      "description": "Run health check on all channels — shows which are working and which need attention",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "baseArgs": ["doctor"],
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "setup",
      "action": "watch",
      "description": "Quick health + update check (for scheduled/cron monitoring)",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "baseArgs": ["watch"],
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "setup",
      "action": "check-update",
      "description": "Check for new versions of agent-reach",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "baseArgs": ["check-update"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "configure",
      "action": "run",
      "description": "Configure a setting: proxy, twitter-cookies, xhs-cookies, groq-key, or --from-browser",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "baseArgs": ["configure"],
        "positionalArgs": ["setting", "value"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": [
        { "name": "setting", "type": "string", "required": true, "description": "Setting name: proxy, twitter-cookies, xhs-cookies, groq-key" },
        { "name": "value", "type": "string", "required": false, "description": "Value for the setting (omit for --from-browser flag)" }
      ]
    },
    {
      "namespace": "agent-reach",
      "resource": "uninstall",
      "action": "run",
      "description": "Uninstall agent-reach. Use --dry-run to preview, --keep-config to preserve settings.",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "baseArgs": ["uninstall"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "twitter",
      "action": "search",
      "description": "Search Twitter/X for tweets matching a query (passthrough: twitter search <query>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "twitter",
        "baseArgs": ["search"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install twitter-cli via agent-reach: sc agent-reach setup install --channels=twitter"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "twitter",
      "action": "read",
      "description": "Read a tweet by URL (passthrough: twitter tweet <url>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "twitter",
        "baseArgs": ["tweet"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install twitter-cli via agent-reach: sc agent-reach setup install --channels=twitter"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "reddit",
      "action": "search",
      "description": "Search Reddit for posts (passthrough: rdt search <query>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "rdt",
        "baseArgs": ["search"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rdt-cli via agent-reach: sc agent-reach setup install --channels=reddit"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "reddit",
      "action": "read",
      "description": "Read a Reddit post by ID (passthrough: rdt read <post_id>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "rdt",
        "baseArgs": ["read"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rdt-cli via agent-reach: sc agent-reach setup install --channels=reddit"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "youtube",
      "action": "info",
      "description": "Get YouTube video metadata (passthrough: yt-dlp --dump-json <url>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "yt-dlp",
        "baseArgs": ["--dump-json"],
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install yt-dlp via agent-reach: sc agent-reach setup install"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "web",
      "action": "read",
      "description": "Fetch a web page (passthrough: curl -sL <url>). Prefix with https://r.jina.ai/ for clean Markdown.",
      "adapter": "process",
      "adapterConfig": {
        "command": "curl",
        "baseArgs": ["-sL"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "curl is pre-installed on most systems"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "bilibili",
      "action": "hot",
      "description": "Show trending Bilibili videos (passthrough: bili hot)",
      "adapter": "process",
      "adapterConfig": {
        "command": "bili",
        "baseArgs": ["hot"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install bili-cli via agent-reach: sc agent-reach setup install --channels=bilibili"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "bilibili",
      "action": "search",
      "description": "Search Bilibili videos (passthrough: bili search <query>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "bili",
        "baseArgs": ["search"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install bili-cli via agent-reach: sc agent-reach setup install --channels=bilibili"
      },
      "args": []
    },
    {
      "namespace": "agent-reach",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agent-reach CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-reach",
        "passthrough": true,
        "timeout_ms": 600000,
        "missingDependencyHelp": "Install agent-reach: pipx install https://github.com/Panniantong/agent-reach/archive/main.zip"
      },
      "args": []
    }
  ]
}
