{
  "name": "rybbit",
  "version": "0.1.0",
  "description": "Open-source and privacy-friendly alternative to Google Analytics, 10x more intuitive",
  "source": "https://github.com/rybbit-io/rybbit",
  "checks": [
    {
      "type": "binary",
      "name": "rybbit"
    }
  ],
  "install_guidance": {
    "plugin": "rybbit",
    "binary": "rybbit",
    "check": "which rybbit",
    "install_steps": [
      "npm install -g rybbit",
      "Verify: rybbit --version",
      "supercli plugins install ./plugins/rybbit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "rybbit",
    "resource": "self",
    "action": "version",
    "description": "Print rybbit version",
    "adapter": "process",
    "adapterConfig": {
      "command": "rybbit",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install rybbit: npm install -g rybbit"
    },
    "args": []
  },
  {
    "namespace": "rybbit",
    "resource": "server",
    "action": "start",
    "description": "Start the Rybbit analytics server",
    "adapter": "process",
    "adapterConfig": {
      "command": "rybbit",
      "passthrough": true,
      "missingDependencyHelp": "Install rybbit: npm install -g rybbit"
    },
    "args": []
  },
  {
    "namespace": "rybbit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rybbit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rybbit",
      "passthrough": true,
      "missingDependencyHelp": "Install rybbit"
    },
    "args": []
  }
]
}