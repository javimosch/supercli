{
  "name": "esac",
  "version": "0.1.0",
  "description": "CLI tool: esac",
  "source": "https://manpages.debian.org/esac",
  "checks": [
    {
      "type": "binary",
      "name": "esac"
    }
  ],
  "install_guidance": {
    "plugin": "esac",
    "binary": "esac",
    "check": "which esac",
    "install_steps": [
      "apt-get install esac 2>/dev/null || which esac",
      "Verify: esac --version",
      "supercli plugins install ./plugins/esac --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "esac",
      "resource": "self",
      "action": "version",
      "description": "Print esac version",
      "adapter": "process",
      "adapterConfig": {
        "command": "esac",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install esac: apt-get install esac 2>/dev/null || which esac"
      },
      "args": []
    },
    {
      "namespace": "esac",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to esac CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "esac",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install esac: apt-get install esac 2>/dev/null || which esac"
      },
      "args": []
    }
  ]
}