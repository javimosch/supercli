{
  "name": "open-r1",
  "version": "0.1.0",
  "description": "Fully open reproduction of DeepSeek-R1",
  "source": "https://github.com/open-r1/open-r1",
  "checks": [
    {
      "type": "binary",
      "name": "open-r1"
    }
  ],
  "install_guidance": {
    "plugin": "open-r1",
    "binary": "open-r1",
    "check": "which open-r1",
    "install_steps": [
      "pip install open-r1",
      "Verify: open-r1 --version",
      "supercli plugins install ./plugins/open-r1 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "open-r1",
      "resource": "self",
      "action": "version",
      "description": "Print open-r1 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-r1",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install open-r1: pip install open-r1"
      },
      "args": []
    },
    {
      "namespace": "open-r1",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to open-r1 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-r1",
        "passthrough": true,
        "missingDependencyHelp": "Install open-r1: pip install open-r1"
      },
      "args": []
    }
  ]
}