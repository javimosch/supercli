{
  "name": "create-react-app",
  "version": "0.1.0",
  "description": "Create React applications from CLI",
  "source": "https://github.com/facebook/create-react-app",
  "checks": [
    {
      "type": "binary",
      "name": "create-react-app"
    }
  ],
  "install_guidance": {
    "plugin": "create-react-app",
    "binary": "create-react-app",
    "check": "which create-react-app",
    "install_steps": [
      "npm install -g create-react-app",
      "Verify: create-react-app --version",
      "supercli plugins install ./plugins/create-react-app --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "create-react-app",
      "resource": "self",
      "action": "version",
      "description": "Print create-react-app version",
      "adapter": "process",
      "adapterConfig": {
        "command": "create-react-app",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install create-react-app: npm install -g create-react-app"
      },
      "args": []
    },
    {
      "namespace": "create-react-app",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to create-react-app CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "create-react-app",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install create-react-app: npm install -g create-react-app"
      },
      "args": []
    }
  ]
}
