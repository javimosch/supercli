{
  "name": "cargo-crev",
  "version": "0.1.0",
  "description": "Distributed code review system for Rust crates",
  "source": "https://github.com/crev-dev/cargo-crev",
  "checks": [{ "type": "binary", "name": "cargo-crev" }],
  "install_guidance": {
    "plugin": "cargo-crev",
    "binary": "cargo-crev",
    "check": "which cargo-crev",
    "install_steps": ["cargo install cargo-crev", "Verify: cargo-crev --version", "supercli plugins install ./plugins/cargo-crev --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-crev",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-crev CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-crev",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-crev: cargo install cargo-crev", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
