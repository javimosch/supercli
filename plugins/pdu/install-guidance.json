{
  "plugin": "pdu",
  "binary": "pdu",
  "check": "which pdu",
  "install_steps": [
    "cargo install parallel-disk-usage",
    "or: cargo binstall parallel-disk-usage",
    "or download binary from https://github.com/KSXGitHub/parallel-disk-usage/releases",
    "Verify: pdu --version",
    "supercli plugins install ./plugins/pdu --on-conflict replace --json"
  ],
  "note": "The crate is named parallel-disk-usage but installs the 'pdu' binary. Also available via Homebrew (brew install pdu) and Nix."
}
