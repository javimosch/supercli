{
  "name": "literate-git",
  "version": "0.1.0",
  "description": "Render hierarchical git repositories into HTML",
  "source": "https://github.com/bennorth/literate-git",
  "checks": [
    {
      "type": "binary",
      "name": "literate-git"
    }
  ],
  "install_guidance": {
    "plugin": "literate-git",
    "binary": "literate-git",
    "check": "which literate-git",
    "install_steps": [
      "brew install literate-git",
      "Verify: literate-git --version",
      "supercli plugins install ./plugins/literate-git --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "literate-git",
      "resource": "self",
      "action": "version",
      "description": "Print literate-git version",
      "adapter": "process",
      "adapterConfig": {
        "command": "literate-git",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install literate-git: brew install literate-git"
      },
      "args": []
    },
    {
      "namespace": "literate-git",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to literate-git CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "literate-git",
        "passthrough": true,
        "missingDependencyHelp": "Install literate-git"
      },
      "args": []
    }
  ]
}