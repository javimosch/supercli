{
  "name": "frozen",
  "version": "0.1.0",
  "description": "Header-only, constexpr alternative to gperf for C++14 users",
  "source": "https://github.com/serge-sans-paille/frozen",
  "checks": [
    {
      "type": "binary",
      "name": "frozen"
    }
  ],
  "install_guidance": {
    "plugin": "frozen",
    "binary": "frozen",
    "check": "which frozen",
    "install_steps": [
      "brew install frozen",
      "Verify: frozen --version",
      "supercli plugins install ./plugins/frozen --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "frozen",
      "resource": "self",
      "action": "version",
      "description": "Print frozen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "frozen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install frozen: brew install frozen"
      },
      "args": []
    },
    {
      "namespace": "frozen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to frozen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "frozen",
        "passthrough": true,
        "missingDependencyHelp": "Install frozen"
      },
      "args": []
    }
  ]
}