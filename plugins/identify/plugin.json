{
  "name": "identify",
  "version": "0.1.0",
  "description": "Image metadata extraction",
  "source": "https://packages.debian.org/identify",
  "checks": [{ "type": "binary", "name": "identify" }],
  "install_guidance": {
    "plugin": "identify", "binary": "identify", "check": "which identify",
    "install_steps": ["apt-get install imagemagick", "Verify: identify --version", "supercli plugins install ./plugins/identify --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "identify", "resource": "_", "action": "_",
    "description": "Passthrough to identify CLI",
    "adapter": "process", "adapterConfig": { "command": "identify", "passthrough": true, "missingDependencyHelp": "Install identify: apt-get install imagemagick" }, "args": []
  }]
}
