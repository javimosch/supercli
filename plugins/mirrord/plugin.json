{
  "name": "mirrord",
  "version": "0.1.0",
  "description": "Connect your local process to your Kubernetes cluster",
  "source": "https://github.com/metalbear-co/mirrord",
  "checks": [{ "type": "binary", "name": "mirrord" }],
  "install_guidance": {
    "plugin": "mirrord",
    "binary": "mirrord",
    "check": "which mirrord",
    "install_steps": ["brew install mirrord", "Verify: mirrord --version", "supercli plugins install ./plugins/mirrord --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mirrord",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mirrord CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mirrord",
      "passthrough": true,
      "missingDependencyHelp": "Install mirrord: brew install mirrord"
    },
    "args": []
  }]
}
