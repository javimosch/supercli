{
  "name": "agibot_x1_infer",
  "version": "0.1.0",
  "description": "The inference module for AgiBot X1.",
  "source": "https://github.com/agibot_x1_infer/agibot_x1_infer",
  "checks": [
    {
      "type": "binary",
      "name": "agibot-x1-infer"
    }
  ],
  "install_guidance": {
    "plugin": "agibot_x1_infer",
    "binary": "agibot-x1-infer",
    "check": "which agibot-x1-infer",
    "install_steps": [
      "pip install agibot-x1-infer",
      "Verify: agibot-x1-infer --version",
      "supercli plugins install ./plugins/agibot_x1_infer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agibot_x1_infer",
      "resource": "self",
      "action": "version",
      "description": "Print agibot_x1_infer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agibot-x1-infer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agibot_x1_infer: pip install agibot-x1-infer"
      },
      "args": []
    },
    {
      "namespace": "agibot_x1_infer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agibot-x1-infer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agibot-x1-infer",
        "passthrough": true,
        "missingDependencyHelp": "Install agibot_x1_infer: pip install agibot-x1-infer"
      },
      "args": []
    }
  ]
}