{
  "name": "ppmtojpeg",
  "version": "0.1.0",
  "description": "CLI tool: ppmtojpeg",
  "source": "https://manpages.debian.org/ppmtojpeg",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtojpeg"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtojpeg",
    "binary": "ppmtojpeg",
    "check": "which ppmtojpeg",
    "install_steps": [
      "apt-get install ppmtojpeg 2>/dev/null || which ppmtojpeg",
      "Verify: ppmtojpeg --version",
      "supercli plugins install ./plugins/ppmtojpeg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtojpeg",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtojpeg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtojpeg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtojpeg: apt-get install ppmtojpeg 2>/dev/null || which ppmtojpeg"
      },
      "args": []
    },
    {
      "namespace": "ppmtojpeg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtojpeg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtojpeg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtojpeg: apt-get install ppmtojpeg 2>/dev/null || which ppmtojpeg"
      },
      "args": []
    }
  ]
}