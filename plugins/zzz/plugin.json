{
  "name": "zzz",
  "version": "0.1.0",
  "description": "A framework for writing performant and reliable networked services.",
  "source": "https://github.com/zzz/zzz",
  "checks": [
    {
      "type": "binary",
      "name": "zzz"
    }
  ],
  "install_guidance": {
    "plugin": "zzz",
    "binary": "zzz",
    "check": "which zzz",
    "install_steps": [
      "pip install zzz",
      "Verify: zzz --version",
      "supercli plugins install ./plugins/zzz --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zzz",
      "resource": "self",
      "action": "version",
      "description": "Print zzz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zzz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zzz: pip install zzz"
      },
      "args": []
    },
    {
      "namespace": "zzz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zzz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zzz",
        "passthrough": true,
        "missingDependencyHelp": "Install zzz: pip install zzz"
      },
      "args": []
    }
  ]
}