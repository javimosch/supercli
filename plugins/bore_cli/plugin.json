{
  "name": "bore-cli",
  "version": "0.1.0",
  "description": "Simple CLI tunnel for exposing local servers",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "bore-cli" }],
  "install_guidance": {
    "plugin": "bore-cli",
    "binary": "bore-cli",
    "check": "which bore-cli",
    "install_steps": ["cargo install bore-cli", "which bore-cli", "Verify: bore-cli --version", "supercli plugins install ./plugins/bore_cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bore-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bore-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bore-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install bore-cli: cargo install bore-cli"
    },
    "args": []
  }]
}
