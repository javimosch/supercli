{
  "name": "HEAD",
  "version": "0.1.0",
  "description": "CLI tool: HEAD",
  "source": "https://manpages.debian.org/HEAD",
  "checks": [
    {
      "type": "binary",
      "name": "HEAD"
    }
  ],
  "install_guidance": {
    "plugin": "HEAD",
    "binary": "HEAD",
    "check": "which HEAD",
    "install_steps": [
      "apt-get install HEAD 2>/dev/null || which HEAD",
      "Verify: HEAD --version",
      "supercli plugins install ./plugins/HEAD --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "HEAD",
      "resource": "self",
      "action": "version",
      "description": "Print HEAD version",
      "adapter": "process",
      "adapterConfig": {
        "command": "HEAD",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install HEAD: apt-get install HEAD 2>/dev/null || which HEAD"
      },
      "args": []
    },
    {
      "namespace": "HEAD",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to HEAD CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "HEAD",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install HEAD: apt-get install HEAD 2>/dev/null || which HEAD"
      },
      "args": []
    }
  ]
}