{
  "name": "go-bindata-assetfs",
  "version": "0.1.0",
  "description": "Serve embedded binary assets via HTTP file system",
  "source": "https://github.com/go-bindata/go-bindata-assetfs",
  "checks": [{ "type": "binary", "name": "go-bindata-assetfs" }],
  "install_guidance": {
    "plugin": "go-bindata-assetfs",
    "binary": "go-bindata-assetfs",
    "check": "which go-bindata-assetfs",
    "install_steps": ["go install github.com/go-bindata/go-bindata-assetfs/...@latest", "Verify: go-bindata-assetfs --version", "supercli plugins install ./plugins/go-bindata-assetfs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "go-bindata-assetfs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to go-bindata-assetfs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-bindata-assetfs",
      "passthrough": true,
      "missingDependencyHelp": "Install go-bindata-assetfs: go install github.com/go-bindata/go-bindata-assetfs/...@latest"
    },
    "args": []
  }]
}
