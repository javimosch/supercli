{
  "plugin": "pkgconf",
  "binary": "pkgconf",
  "check": "which pkgconf",
  "install_steps": [
    "# Install pkgconf",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pkgconf-linux-amd64 -o /usr/local/bin/pkgconf",
    "chmod +x /usr/local/bin/pkgconf",
    "# Or via package manager, see /usr/bin/pkgconf"
  ]
}