{
  "name": "pkgconf",
  "version": "1.0.0",
  "description": "pkgconf \u2014 pkgconf \u2014 CLI utility",
  "source": "/usr/bin/pkgconf",
  "checks": [
    {
      "type": "binary",
      "name": "pkgconf"
    }
  ],
  "install_guidance": {
    "plugin": "pkgconf",
    "binary": "pkgconf",
    "check": "which pkgconf",
    "install_steps": [
      "# Install pkgconf:",
      "# apt: sudo apt-get install pkgconf",
      "# brew: brew install pkgconf",
      "# cargo: cargo install pkgconf",
      "# npm: npm install -g pkgconf",
      "# pip: pip install pkgconf",
      "# or download from /usr/bin/pkgconf"
    ]
  },
  "commands": [
    {
      "namespace": "pkgconf",
      "resource": "pkgconf",
      "action": "run",
      "description": "Run pkgconf",
      "adapter": "process",
      "adapterConfig": {
        "command": "pkgconf",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pkgconf from /usr/bin/pkgconf"
      },
      "args": []
    }
  ]
}