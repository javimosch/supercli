{
  "name": "fiche",
  "version": "1.0.0",
  "description": "fiche \u2014 Pastebin server",
  "source": "github.com/solusipse/fiche",
  "checks": [
    {
      "type": "binary",
      "name": "fiche"
    }
  ],
  "install_guidance": {
    "plugin": "fiche",
    "binary": "fiche",
    "check": "which fiche",
    "install_steps": [
      "# Install fiche",
      "# See github.com/solusipse/fiche",
      "# apt: sudo apt-get install fiche",
      "# brew: brew install fiche",
      "# cargo: cargo install fiche",
      "# npm: npm install -g fiche",
      "# pip: pip install fiche"
    ]
  },
  "commands": [
    {
      "namespace": "fiche",
      "resource": "fiche",
      "action": "run",
      "description": "Run fiche",
      "adapter": "process",
      "adapterConfig": {
        "command": "fiche",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fiche from github.com/solusipse/fiche"
      },
      "args": []
    }
  ]
}