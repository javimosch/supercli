{
  "name": "recipe-ui",
  "version": "0.1.0",
  "description": "CLI tool: recipe-ui",
  "source": "https://manpages.debian.org/recipe-ui",
  "checks": [
    {
      "type": "binary",
      "name": "recipe-ui"
    }
  ],
  "install_guidance": {
    "plugin": "recipe-ui",
    "binary": "recipe-ui",
    "check": "which recipe-ui",
    "install_steps": [
      "apt-get install recipe-ui 2>/dev/null || which recipe-ui",
      "Verify: recipe-ui --version",
      "supercli plugins install ./plugins/recipe-ui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "recipe-ui",
      "resource": "self",
      "action": "version",
      "description": "Print recipe-ui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "recipe-ui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install recipe-ui: apt-get install recipe-ui 2>/dev/null || which recipe-ui"
      },
      "args": []
    },
    {
      "namespace": "recipe-ui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to recipe-ui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "recipe-ui",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install recipe-ui: apt-get install recipe-ui 2>/dev/null || which recipe-ui"
      },
      "args": []
    }
  ]
}