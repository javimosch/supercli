{
  "name": "chaos",
  "version": "0.1.0",
  "description": "Disk cleanup utility — find and remove large/unused files",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "chaos" }],
  "install_guidance": {
    "plugin": "chaos",
    "binary": "chaos",
    "check": "which chaos",
    "install_steps": ["cargo install chaos", "which chaos", "Verify: chaos --version", "supercli plugins install ./plugins/chaos --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "chaos",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to chaos CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "chaos",
      "passthrough": true,
      "missingDependencyHelp": "Install chaos: cargo install chaos"
    },
    "args": []
  }]
}
