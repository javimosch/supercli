{
  "name": "Taskwarrior",
  "version": "0.1.0",
  "description": "Manage your TODO list",
  "checks": [
    {
      "type": "binary",
      "name": "Taskwarrior"
    }
  ],
  "install_guidance": {
    "plugin": "Taskwarrior",
    "binary": "Taskwarrior",
    "check": "which Taskwarrior",
    "install_steps": [
      "See undefined",
      "Verify: Taskwarrior --version",
      "supercli plugins install ./plugins/Taskwarrior --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "Taskwarrior",
      "resource": "self",
      "action": "version",
      "description": "Print Taskwarrior version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Taskwarrior",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Taskwarrior: See undefined"
      },
      "args": []
    },
    {
      "namespace": "Taskwarrior",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Taskwarrior CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Taskwarrior",
        "passthrough": true,
        "missingDependencyHelp": "Install Taskwarrior"
      },
      "args": []
    }
  ]
}