{
  "name": "microsoft-edge-stable",
  "version": "0.1.0",
  "description": "CLI tool: microsoft-edge-stable",
  "source": "https://manpages.debian.org/microsoft-edge-stable",
  "checks": [
    {
      "type": "binary",
      "name": "microsoft-edge-stable"
    }
  ],
  "install_guidance": {
    "plugin": "microsoft-edge-stable",
    "binary": "microsoft-edge-stable",
    "check": "which microsoft-edge-stable",
    "install_steps": [
      "apt-get install microsoft-edge-stable 2>/dev/null || which microsoft-edge-stable",
      "Verify: microsoft-edge-stable --version",
      "supercli plugins install ./plugins/microsoft-edge-stable --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "microsoft-edge-stable",
      "resource": "self",
      "action": "version",
      "description": "Print microsoft-edge-stable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsoft-edge-stable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install microsoft-edge-stable: apt-get install microsoft-edge-stable 2>/dev/null || which microsoft-edge-stable"
      },
      "args": []
    },
    {
      "namespace": "microsoft-edge-stable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to microsoft-edge-stable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "microsoft-edge-stable",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install microsoft-edge-stable: apt-get install microsoft-edge-stable 2>/dev/null || which microsoft-edge-stable"
      },
      "args": []
    }
  ]
}