{
  "name": "slc",
  "version": "0.1.0",
  "description": "Simple line counter with directory and file stats",
  "source": "https://github.com/sstadick/slc",
  "checks": [{ "type": "binary", "name": "slc" }],
  "install_guidance": {
    "plugin": "slc",
    "binary": "slc",
    "check": "which slc",
    "install_steps": ["go install github.com/sstadick/slc@latest", "Verify: slc --version", "supercli plugins install ./plugins/slc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "slc",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to slc CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "slc",
      "passthrough": true,
      "missingDependencyHelp": "Install slc: go install github.com/sstadick/slc@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
