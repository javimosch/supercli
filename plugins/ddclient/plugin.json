{
  "name": "ddclient",
  "version": "1.0.0",
  "description": "ddclient \u2014 Dynamic DNS updater",
  "source": "github.com/ddclient/ddclient",
  "checks": [
    {
      "type": "binary",
      "name": "ddclient"
    }
  ],
  "install_guidance": {
    "plugin": "ddclient",
    "binary": "ddclient",
    "check": "which ddclient",
    "install_steps": [
      "# Install ddclient",
      "# See github.com/ddclient/ddclient",
      "# apt: sudo apt-get install ddclient",
      "# brew: brew install ddclient",
      "# cargo: cargo install ddclient",
      "# npm: npm install -g ddclient",
      "# pip: pip install ddclient"
    ]
  },
  "commands": [
    {
      "namespace": "ddclient",
      "resource": "ddclient",
      "action": "run",
      "description": "Run ddclient",
      "adapter": "process",
      "adapterConfig": {
        "command": "ddclient",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ddclient from github.com/ddclient/ddclient"
      },
      "args": []
    }
  ]
}