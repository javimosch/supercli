{
  "name": "cargo-auditable",
  "version": "0.1.0",
  "description": "Make production Rust binaries auditable",
  "source": "https://github.com/rust-secure-code/cargo-auditable",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-auditable"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-auditable",
    "binary": "cargo-auditable",
    "check": "which cargo-auditable",
    "install_steps": [
      "brew install cargo-auditable",
      "Verify: cargo-auditable --version",
      "supercli plugins install ./plugins/cargo-auditable --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cargo-auditable",
      "resource": "self",
      "action": "version",
      "description": "Print cargo-auditable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-auditable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-auditable: brew install cargo-auditable"
      },
      "args": []
    },
    {
      "namespace": "cargo-auditable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-auditable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-auditable",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-auditable"
      },
      "args": []
    }
  ]
}