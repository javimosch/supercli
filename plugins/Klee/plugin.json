{
  "name": "Klee",
  "version": "0.1.0",
  "description": "A native macOS AI chat app powered by MLX. 100% local inference on Apple Silicon, no cloud required.",
  "source": "https://github.com/Klee/Klee",
  "checks": [
    {
      "type": "binary",
      "name": "klee"
    }
  ],
  "install_guidance": {
    "plugin": "Klee",
    "binary": "klee",
    "check": "which klee",
    "install_steps": [
      "pip install klee",
      "Verify: klee --version",
      "supercli plugins install ./plugins/Klee --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Klee",
      "resource": "self",
      "action": "version",
      "description": "Print Klee version",
      "adapter": "process",
      "adapterConfig": {
        "command": "klee",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Klee: pip install klee"
      },
      "args": []
    },
    {
      "namespace": "Klee",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to klee CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "klee",
        "passthrough": true,
        "missingDependencyHelp": "Install Klee: pip install klee"
      },
      "args": []
    }
  ]
}