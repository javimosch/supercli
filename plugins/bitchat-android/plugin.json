{
  "name": "bitchat-android",
  "version": "0.1.0",
  "description": "bluetooth mesh chat, IRC vibes",
  "source": "https://github.com/bitchat-android/bitchat-android",
  "checks": [
    {
      "type": "binary",
      "name": "bitchat-android"
    }
  ],
  "install_guidance": {
    "plugin": "bitchat-android",
    "binary": "bitchat-android",
    "check": "which bitchat-android",
    "install_steps": [
      "pip install bitchat-android",
      "Verify: bitchat-android --version",
      "supercli plugins install ./plugins/bitchat-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bitchat-android",
      "resource": "self",
      "action": "version",
      "description": "Print bitchat-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitchat-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bitchat-android: pip install bitchat-android"
      },
      "args": []
    },
    {
      "namespace": "bitchat-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bitchat-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bitchat-android",
        "passthrough": true,
        "missingDependencyHelp": "Install bitchat-android: pip install bitchat-android"
      },
      "args": []
    }
  ]
}