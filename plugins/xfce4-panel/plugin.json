{
  "name": "xfce4-panel",
  "version": "0.1.0",
  "description": "CLI tool: xfce4-panel",
  "source": "https://manpages.debian.org/xfce4-panel",
  "checks": [
    {
      "type": "binary",
      "name": "xfce4-panel"
    }
  ],
  "install_guidance": {
    "plugin": "xfce4-panel",
    "binary": "xfce4-panel",
    "check": "which xfce4-panel",
    "install_steps": [
      "apt-get install xfce4-panel 2>/dev/null || which xfce4-panel",
      "Verify: xfce4-panel --version",
      "supercli plugins install ./plugins/xfce4-panel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfce4-panel",
      "resource": "self",
      "action": "version",
      "description": "Print xfce4-panel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfce4-panel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfce4-panel: apt-get install xfce4-panel 2>/dev/null || which xfce4-panel"
      },
      "args": []
    },
    {
      "namespace": "xfce4-panel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfce4-panel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfce4-panel",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfce4-panel: apt-get install xfce4-panel 2>/dev/null || which xfce4-panel"
      },
      "args": []
    }
  ]
}