{
  "name": "LSPosed-Irena",
  "version": "0.1.0",
  "description": "Useless LSPosed Framework Fork",
  "source": "https://github.com/LSPosed-Irena/LSPosed-Irena",
  "checks": [
    {
      "type": "binary",
      "name": "lsposed-irena"
    }
  ],
  "install_guidance": {
    "plugin": "LSPosed-Irena",
    "binary": "lsposed-irena",
    "check": "which lsposed-irena",
    "install_steps": [
      "pip install lsposed-irena",
      "Verify: lsposed-irena --version",
      "supercli plugins install ./plugins/LSPosed-Irena --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "LSPosed-Irena",
      "resource": "self",
      "action": "version",
      "description": "Print LSPosed-Irena version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lsposed-irena",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install LSPosed-Irena: pip install lsposed-irena"
      },
      "args": []
    },
    {
      "namespace": "LSPosed-Irena",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lsposed-irena CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lsposed-irena",
        "passthrough": true,
        "missingDependencyHelp": "Install LSPosed-Irena: pip install lsposed-irena"
      },
      "args": []
    }
  ]
}