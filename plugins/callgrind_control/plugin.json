  "commands": [{
    "namespace": "callgrind_control", "resource": "_", "action": "_",
    "description": "Passthrough to callgrind_control CLI",
    "adapter": "process", "adapterConfig": { "command": "callgrind_control", "passthrough": true, "missingDependencyHelp": "Install callgrind_control: apt-get install callgrind_control" }, "args": []
  }]
}
