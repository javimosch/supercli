{
  "name": "callgrind_control",
  "version": "0.1.0",
  "description": "CLI tool: callgrind_control",
  "source": "https://packages.debian.org/callgrind_control",
  "checks": [{ "type": "binary", "name": "callgrind_control" }],
  "install_guidance": {
    "plugin": "callgrind_control", "binary": "callgrind_control", "check": "which callgrind_control",
    "install_steps": ["apt-get install callgrind_control 2>/dev/null || which callgrind_control", "Verify: callgrind_control --version", "supercli plugins install ./plugins/callgrind_control --on-conflict replace --json"]
