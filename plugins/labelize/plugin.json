{
  "name": "labelize",
  "version": "0.1.0",
  "description": "Parse ZPL/EPL label data and render to PNG in Rust",
  "source": "https://github.com/nicholasgasior/labelize",
  "checks": [{"type": "binary", "name": "labelize"}],
  "install_guidance": {
    "plugin": "labelize",
    "binary": "labelize",
    "check": "which labelize",
    "install_steps": [
      "cargo install labelize",
      "Verify: labelize --version",
      "supercli plugins install ./labelize --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "labelize",
      "resource": "self",
      "action": "version",
      "description": "Print labelize version",
      "adapter": "process",
      "adapterConfig": {"command": "labelize", "baseArgs": ["--version"], "missingDependencyHelp": "Install labelize: cargo install labelize"},
      "args": []
    },
    {
      "namespace": "labelize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to labelize CLI",
      "adapter": "process",
      "adapterConfig": {"command": "labelize", "passthrough": true, "missingDependencyHelp": "Install labelize: cargo install labelize"},
      "args": []
    }
  ]
}
