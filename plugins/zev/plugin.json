{
  "name": "zev",
  "version": "0.1.0",
  "description": "Command Memory CLI",
  "source": "https://github.com/dtnewman/zev",
  "checks": [
    { "type": "binary", "name": "zev" }
  ],
  "install_guidance": {
    "plugin": "zev",
    "binary": "zev",
    "check": "which zev",
    "install_steps": [
      "pipx install zev",
      "Verify: zev --version",
      "supercli plugins install ./plugins/zev --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zev",
      "resource": "self",
      "action": "version",
      "description": "Print zev version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zev",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install zev: pipx install zev"
      },
      "args": []
    },
    {
      "namespace": "zev",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zev CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zev",
        "passthrough": true,
        "missingDependencyHelp": "Install zev"
      },
      "args": []
    }
  ]
}
