{
  "name": "fte",
  "version": "0.1.0",
  "description": "Text editor with syntax highlighting and folding",
  "source": "https://github.com/fte-editor/fte",
  "checks": [{ "type": "binary", "name": "fte" }],
  "install_guidance": {
    "plugin": "fte",
    "binary": "fte",
    "check": "which fte",
    "install_steps": ["brew install fte", "Verify: fte --version", "supercli plugins install ./plugins/fte --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fte",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fte CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fte",
      "passthrough": true,
      "missingDependencyHelp": "Install fte: brew install fte", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
