{
  "name": "gitsome",
  "version": "0.1.0",
  "description": "Enhanced Git/GitHub command line interface",
  "source": "https://github.com/donnemartin/gitsome",
  "checks": [{ "type": "binary", "name": "gitsome" }],
  "install_guidance": {
    "plugin": "gitsome",
    "binary": "gitsome",
    "check": "which gitsome",
    "install_steps": ["pip install gitsome", "Verify: gitsome --version", "supercli plugins install ./plugins/gitsome --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gitsome",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gitsome CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gitsome",
      "passthrough": true,
      "missingDependencyHelp": "Install gitsome: pip install gitsome", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
