{
  "name": "matchmaker",
  "version": "0.1.0",
  "description": "Pattern matching and text processing utility",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "matchmaker"
    }
  ],
  "install_guidance": {
    "plugin": "matchmaker",
    "binary": "matchmaker",
    "check": "which matchmaker",
    "install_steps": [
      "brew install matchmaker",
      "Verify: matchmaker --version",
      "supercli plugins install ./plugins/matchmaker --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "matchmaker",
      "resource": "self",
      "action": "version",
      "description": "Print matchmaker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "matchmaker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install matchmaker: brew install matchmaker"
      },
      "args": []
    },
    {
      "namespace": "matchmaker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to matchmaker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "matchmaker",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install matchmaker: brew install matchmaker"
      },
      "args": []
    }
  ]
}
