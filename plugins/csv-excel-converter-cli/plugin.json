{
  "name": "csv-excel-converter-cli",
  "version": "0.1.0",
  "description": "🔄 A professional-grade Python CLI tool to convert between CSV and Excel files (XLSX). Built with argparse, logging, error handling, and config file support — ready for production or automation pipelines.",
  "source": "https://github.com/csv-excel-converter-cli/csv-excel-converter-cli",
  "checks": [
    {
      "type": "binary",
      "name": "csv-excel-converter-cli"
    }
  ],
  "install_guidance": {
    "plugin": "csv-excel-converter-cli",
    "binary": "csv-excel-converter-cli",
    "check": "which csv-excel-converter-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: csv-excel-converter-cli --version",
      "supercli plugins install ./plugins/csv-excel-converter-cli --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "csv-excel-converter-cli",
      "resource": "self",
      "action": "version",
      "description": "Print csv-excel-converter-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csv-excel-converter-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csv-excel-converter-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "csv-excel-converter-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csv-excel-converter-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csv-excel-converter-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install csv-excel-converter-cli from project repository"
      },
      "args": []
    }
  ]
}