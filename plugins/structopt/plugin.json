{
  "name": "structopt",
  "version": "0.1.0",
  "description": "structopt — derive macros for CLI argument parsing",
  "source": "https://github.com/TeXitoi/structopt",
  "checks": [
    {
      "type": "binary",
      "name": "structopt"
    }
  ],
  "install_guidance": {
    "plugin": "structopt",
    "binary": "structopt",
    "check": "which structopt",
    "install_steps": [
      "cargo add structopt",
      "Verify: structopt --version",
      "supercli plugins install ./plugins/structopt --on-conflict replace --json"
    ],
    "note": "structopt is in maintenance mode — its features merged into clap 3+ derive API."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "structopt",
      "resource": "self",
      "action": "version",
      "description": "Print structopt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "structopt",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install structopt: cargo add structopt"
      },
      "args": []
    }
  ]
}
