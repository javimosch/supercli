{
  "name": "SpacetimeDB",
  "version": "0.1.0",
  "description": "Development at the speed of light",
  "source": "https://github.com/SpacetimeDB/SpacetimeDB",
  "checks": [
    {
      "type": "binary",
      "name": "spacetimedb"
    }
  ],
  "install_guidance": {
    "plugin": "SpacetimeDB",
    "binary": "spacetimedb",
    "check": "which spacetimedb",
    "install_steps": [
      "pip install spacetimedb",
      "Verify: spacetimedb --version",
      "supercli plugins install ./plugins/SpacetimeDB --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SpacetimeDB",
      "resource": "self",
      "action": "version",
      "description": "Print SpacetimeDB version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spacetimedb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SpacetimeDB: pip install spacetimedb"
      },
      "args": []
    },
    {
      "namespace": "SpacetimeDB",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spacetimedb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spacetimedb",
        "passthrough": true,
        "missingDependencyHelp": "Install SpacetimeDB: pip install spacetimedb"
      },
      "args": []
    }
  ]
}