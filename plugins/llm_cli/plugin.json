{
  "name": "llm-cli",
  "version": "0.1.0",
  "description": "CLI for LLMs — run models locally and via API",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "llm-cli" }],
  "install_guidance": {
    "plugin": "llm-cli",
    "binary": "llm-cli",
    "check": "which llm-cli",
    "install_steps": ["pip install llm", "which llm-cli", "Verify: llm-cli --version", "supercli plugins install ./plugins/llm_cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "llm-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to llm-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "llm-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install llm-cli: pip install llm"
    },
    "args": []
  }]
}
