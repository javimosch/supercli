{
  "name": "crosspoint-reader",
  "version": "0.1.0",
  "description": "Firmware for the Xteink X3 and X4 e-paper display readers",
  "source": "https://github.com/crosspoint-reader/crosspoint-reader",
  "checks": [
    {
      "type": "binary",
      "name": "crosspoint-reader"
    }
  ],
  "install_guidance": {
    "plugin": "crosspoint-reader",
    "binary": "crosspoint-reader",
    "check": "which crosspoint-reader",
    "install_steps": [
      "pip install crosspoint-reader",
      "Verify: crosspoint-reader --version",
      "supercli plugins install ./plugins/crosspoint-reader --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "crosspoint-reader",
      "resource": "self",
      "action": "version",
      "description": "Print crosspoint-reader version",
      "adapter": "process",
      "adapterConfig": {
        "command": "crosspoint-reader",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install crosspoint-reader: pip install crosspoint-reader"
      },
      "args": []
    },
    {
      "namespace": "crosspoint-reader",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to crosspoint-reader CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "crosspoint-reader",
        "passthrough": true,
        "missingDependencyHelp": "Install crosspoint-reader: pip install crosspoint-reader"
      },
      "args": []
    }
  ]
}