{
  "name": "react-native-enriched",
  "version": "0.1.0",
  "description": "Rich Text Editor for React Native",
  "source": "https://github.com/react-native-enriched/react-native-enriched",
  "checks": [
    {
      "type": "binary",
      "name": "react-native-enriched"
    }
  ],
  "install_guidance": {
    "plugin": "react-native-enriched",
    "binary": "react-native-enriched",
    "check": "which react-native-enriched",
    "install_steps": [
      "pip install react-native-enriched",
      "Verify: react-native-enriched --version",
      "supercli plugins install ./plugins/react-native-enriched --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "react-native-enriched",
      "resource": "self",
      "action": "version",
      "description": "Print react-native-enriched version",
      "adapter": "process",
      "adapterConfig": {
        "command": "react-native-enriched",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install react-native-enriched: pip install react-native-enriched"
      },
      "args": []
    },
    {
      "namespace": "react-native-enriched",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to react-native-enriched CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "react-native-enriched",
        "passthrough": true,
        "missingDependencyHelp": "Install react-native-enriched: pip install react-native-enriched"
      },
      "args": []
    }
  ]
}