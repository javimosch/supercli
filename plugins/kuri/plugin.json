{
  "name": "kuri",
  "version": "0.1.0",
  "description": "Browser automation, web crawling, and iOS + Android device control for AI agents. Zig-native, token-",
  "source": "https://github.com/kuri/kuri",
  "checks": [
    {
      "type": "binary",
      "name": "kuri"
    }
  ],
  "install_guidance": {
    "plugin": "kuri",
    "binary": "kuri",
    "check": "which kuri",
    "install_steps": [
      "pip install kuri",
      "Verify: kuri --version",
      "supercli plugins install ./plugins/kuri --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kuri",
      "resource": "self",
      "action": "version",
      "description": "Print kuri version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuri",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kuri: pip install kuri"
      },
      "args": []
    },
    {
      "namespace": "kuri",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kuri CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuri",
        "passthrough": true,
        "missingDependencyHelp": "Install kuri: pip install kuri"
      },
      "args": []
    }
  ]
}