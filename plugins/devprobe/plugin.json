{
  "name": "devprobe",
  "version": "0.1.0",
  "description": "CLI tool: devprobe",
  "source": "https://packages.debian.org/devprobe",
  "checks": [{ "type": "binary", "name": "devprobe" }],
  "install_guidance": {
    "plugin": "devprobe", "binary": "devprobe", "check": "which devprobe",
    "install_steps": ["apt-get install devprobe 2>/dev/null || which devprobe", "Verify: devprobe --version", "supercli plugins install ./plugins/devprobe --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "devprobe", "resource": "_", "action": "_",
    "description": "Passthrough to devprobe CLI",
    "adapter": "process", "adapterConfig": { "command": "devprobe", "passthrough": true, "missingDependencyHelp": "Install devprobe: apt-get install devprobe" }, "args": []
  }]
}
