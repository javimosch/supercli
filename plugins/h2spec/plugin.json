{
  "name": "h2spec",
  "version": "0.1.0",
  "description": "Conformance testing tool for HTTP/2 implementation",
  "source": "https://github.com/summerwind/h2spec",
  "checks": [
    {
      "type": "binary",
      "name": "h2spec"
    }
  ],
  "install_guidance": {
    "plugin": "h2spec",
    "binary": "h2spec",
    "check": "which h2spec",
    "install_steps": [
      "brew install h2spec",
      "Verify: h2spec --version",
      "supercli plugins install ./plugins/h2spec --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "h2spec",
      "resource": "self",
      "action": "version",
      "description": "Print h2spec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "h2spec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install h2spec: brew install h2spec"
      },
      "args": []
    },
    {
      "namespace": "h2spec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to h2spec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "h2spec",
        "passthrough": true,
        "missingDependencyHelp": "Install h2spec"
      },
      "args": []
    }
  ]
}