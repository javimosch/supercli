{
  "name": "niri",
  "version": "0.1.0",
  "description": "A scrollable-tiling Wayland compositor.",
  "source": "https://github.com/niri/niri",
  "checks": [
    {
      "type": "binary",
      "name": "niri"
    }
  ],
  "install_guidance": {
    "plugin": "niri",
    "binary": "niri",
    "check": "which niri",
    "install_steps": [
      "pip install niri",
      "Verify: niri --version",
      "supercli plugins install ./plugins/niri --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "niri",
      "resource": "self",
      "action": "version",
      "description": "Print niri version",
      "adapter": "process",
      "adapterConfig": {
        "command": "niri",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install niri: pip install niri"
      },
      "args": []
    },
    {
      "namespace": "niri",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to niri CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "niri",
        "passthrough": true,
        "missingDependencyHelp": "Install niri: pip install niri"
      },
      "args": []
    }
  ]
}