{
  "name": "dcfldd",
  "version": "1.0.0",
  "description": "dcfldd \u2014 Enhanced dd with hashing",
  "source": "github.com/resurrecting-open-source-projects/dcfldd",
  "checks": [
    {
      "type": "binary",
      "name": "dcfldd"
    }
  ],
  "install_guidance": {
    "plugin": "dcfldd",
    "binary": "dcfldd",
    "check": "which dcfldd",
    "install_steps": [
      "# Install dcfldd",
      "# See github.com/resurrecting-open-source-projects/dcfldd",
      "# apt: sudo apt-get install dcfldd",
      "# brew: brew install dcfldd",
      "# cargo: cargo install dcfldd",
      "# npm: npm install -g dcfldd",
      "# pip: pip install dcfldd"
    ]
  },
  "commands": [
    {
      "namespace": "dcfldd",
      "resource": "dcfldd",
      "action": "run",
      "description": "Run dcfldd",
      "adapter": "process",
      "adapterConfig": {
        "command": "dcfldd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dcfldd from github.com/resurrecting-open-source-projects/dcfldd"
      },
      "args": []
    }
  ]
}