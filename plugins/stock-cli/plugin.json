{
  "name": "stock-cli",
  "version": "0.1.0",
  "description": "Simple terminal tool for basic stock price lookups",
  "source": "https://github.com/shane-mc/stock-cli",
  "checks": [{ "type": "binary", "name": "stock-cli" }],
  "install_guidance": {
    "plugin": "stock-cli",
    "binary": "stock-cli",
    "check": "which stock-cli",
    "install_steps": ["pip install stock-cli", "Verify: stock-cli --version", "supercli plugins install ./plugins/stock-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "stock-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to stock-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "stock-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install stock-cli: pip install stock-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
