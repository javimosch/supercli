{
  "name": "zig-time-sharing-kernel",
  "version": "0.1.0",
  "description": "Minimal implementation of a time-sharing kernel on RISC-V, implemented in Zig, on top of OpenSBI",
  "source": "https://github.com/zig-time-sharing-kernel/zig-time-sharing-kernel",
  "checks": [
    {
      "type": "binary",
      "name": "zig-time-sharing-kernel"
    }
  ],
  "install_guidance": {
    "plugin": "zig-time-sharing-kernel",
    "binary": "zig-time-sharing-kernel",
    "check": "which zig-time-sharing-kernel",
    "install_steps": [
      "pip install zig-time-sharing-kernel",
      "Verify: zig-time-sharing-kernel --version",
      "supercli plugins install ./plugins/zig-time-sharing-kernel --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig-time-sharing-kernel",
      "resource": "self",
      "action": "version",
      "description": "Print zig-time-sharing-kernel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-time-sharing-kernel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig-time-sharing-kernel: pip install zig-time-sharing-kernel"
      },
      "args": []
    },
    {
      "namespace": "zig-time-sharing-kernel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig-time-sharing-kernel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-time-sharing-kernel",
        "passthrough": true,
        "missingDependencyHelp": "Install zig-time-sharing-kernel: pip install zig-time-sharing-kernel"
      },
      "args": []
    }
  ]
}