{
  "name": "xfwm4",
  "version": "0.1.0",
  "description": "CLI tool: xfwm4",
  "source": "https://manpages.debian.org/xfwm4",
  "checks": [
    {
      "type": "binary",
      "name": "xfwm4"
    }
  ],
  "install_guidance": {
    "plugin": "xfwm4",
    "binary": "xfwm4",
    "check": "which xfwm4",
    "install_steps": [
      "apt-get install xfwm4 2>/dev/null || which xfwm4",
      "Verify: xfwm4 --version",
      "supercli plugins install ./plugins/xfwm4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfwm4",
      "resource": "self",
      "action": "version",
      "description": "Print xfwm4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfwm4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfwm4: apt-get install xfwm4 2>/dev/null || which xfwm4"
      },
      "args": []
    },
    {
      "namespace": "xfwm4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfwm4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfwm4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfwm4: apt-get install xfwm4 2>/dev/null || which xfwm4"
      },
      "args": []
    }
  ]
}