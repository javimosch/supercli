{
  "plugin": "update-rc.d",
  "binary": "update-rc.d",
  "check": "which update-rc.d",
  "install_steps": [
    "apt-get install update-rc.d 2>/dev/null || which update-rc.d",
    "Verify: update-rc.d --version",
    "supercli plugins install ./plugins/update-rc.d --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}