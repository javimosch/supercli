{
  "name": "fence",
  "version": "0.1.0",
  "description": "Lightweight sandbox for commands with network and filesystem restrictions",
  "source": "https://github.com/Use-Tusk/fence",
  "checks": [
    {
      "type": "binary",
      "name": "fence"
    }
  ],
  "install_guidance": {
    "plugin": "fence",
    "binary": "fence",
    "check": "which fence",
    "install_steps": [
      "brew install fence",
      "Verify: fence --version",
      "supercli plugins install ./plugins/fence --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fence",
      "resource": "self",
      "action": "version",
      "description": "Print fence version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fence",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fence: brew install fence"
      },
      "args": []
    },
    {
      "namespace": "fence",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fence CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fence",
        "passthrough": true,
        "missingDependencyHelp": "Install fence"
      },
      "args": []
    }
  ]
}