{
  "name": "euler-py",
  "version": "0.1.0",
  "description": "Project Euler command-line tool written in Python",
  "source": "https://github.com/iKevinY/EulerPy",
  "checks": [
    {
      "type": "binary",
      "name": "euler-py"
    }
  ],
  "install_guidance": {
    "plugin": "euler-py",
    "binary": "euler-py",
    "check": "which euler-py",
    "install_steps": [
      "brew install euler-py",
      "Verify: euler-py --version",
      "supercli plugins install ./plugins/euler-py --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "euler-py",
      "resource": "self",
      "action": "version",
      "description": "Print euler-py version",
      "adapter": "process",
      "adapterConfig": {
        "command": "euler-py",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install euler-py: brew install euler-py"
      },
      "args": []
    },
    {
      "namespace": "euler-py",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to euler-py CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "euler-py",
        "passthrough": true,
        "missingDependencyHelp": "Install euler-py"
      },
      "args": []
    }
  ]
}