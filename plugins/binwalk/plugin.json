{
  "name": "binwalk",
  "version": "0.1.0",
  "description": "Firmware analysis and file extraction",
  "source": "https",
  "checks": [{"type": "binary", "name": "binwalk"}],
  "install_guidance": {
    "plugin": "binwalk",
    "binary": "binwalk",
    "check": "which binwalk",
    "install_steps": [
      "brew install binwalk",
      "Verify: binwalk --version",
      "supercli plugins install ./plugins/binwalk --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "binwalk",
      "resource": "self",
      "action": "version",
      "description": "Print binwalk version",
      "adapter": "process",
      "adapterConfig": {"command": "binwalk", "baseArgs": ["--version"], "missingDependencyHelp": "Install binwalk: brew install binwalk"},
      "args": []
    },
    {
      "namespace": "binwalk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to binwalk CLI",
      "adapter": "process",
      "adapterConfig": {"command": "binwalk", "passthrough": true, "missingDependencyHelp": "Install binwalk: brew install binwalk"},
      "args": []
    }
  ]
}
