{
  "name": "sane-find-scanner",
  "version": "0.1.0",
  "description": "CLI tool: sane-find-scanner",
  "source": "https://manpages.debian.org/sane-find-scanner",
  "checks": [
    {
      "type": "binary",
      "name": "sane-find-scanner"
    }
  ],
  "install_guidance": {
    "plugin": "sane-find-scanner",
    "binary": "sane-find-scanner",
    "check": "which sane-find-scanner",
    "install_steps": [
      "apt-get install sane-find-scanner 2>/dev/null || which sane-find-scanner",
      "Verify: sane-find-scanner --version",
      "supercli plugins install ./plugins/sane-find-scanner --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sane-find-scanner",
      "resource": "self",
      "action": "version",
      "description": "Print sane-find-scanner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sane-find-scanner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sane-find-scanner: apt-get install sane-find-scanner 2>/dev/null || which sane-find-scanner"
      },
      "args": []
    },
    {
      "namespace": "sane-find-scanner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sane-find-scanner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sane-find-scanner",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install sane-find-scanner: apt-get install sane-find-scanner 2>/dev/null || which sane-find-scanner"
      },
      "args": []
    }
  ]
}