{
  "name": "cpipe",
  "version": "0.1.0",
  "description": "Pipe viewer alternative with detailed throughput statistics",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "cpipe" }],
  "install_guidance": {
    "plugin": "cpipe",
    "binary": "cpipe",
    "check": "which cpipe",
    "install_steps": ["sudo apt install cpipe", "Verify: cpipe --version", "supercli plugins install ./plugins/cpipe --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cpipe",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cpipe CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cpipe",
      "passthrough": true,
      "missingDependencyHelp": "Install cpipe: sudo apt install cpipe"
    },
    "args": []
  }]
}
