{
  "name": "hashsigs-ts",
  "version": "0.1.0",
  "description": "Hash-based signatures (WOTS+) implementation in TypeScript",
  "source": "https://github.com/QuipNetwork/hashsigs-ts",
  "checks": [
    {
      "type": "binary",
      "name": "hashsigs-ts"
    }
  ],
  "install_guidance": {
    "plugin": "hashsigs-ts",
    "binary": "hashsigs-ts",
    "check": "which hashsigs-ts",
    "install_steps": [
      "npm install -g hashsigs-ts",
      "Verify: hashsigs-ts --version",
      "supercli plugins install ./plugins/hashsigs-ts --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "hashsigs-ts",
    "resource": "self",
    "action": "version",
    "description": "Print hashsigs-ts version",
    "adapter": "process",
    "adapterConfig": {
      "command": "hashsigs-ts",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install hashsigs-ts: npm install -g hashsigs-ts"
    },
    "args": []
  },
  {
    "namespace": "hashsigs-ts",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to hashsigs-ts CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "hashsigs-ts",
      "passthrough": true,
      "missingDependencyHelp": "Install hashsigs-ts"
    },
    "args": []
  }
]
}