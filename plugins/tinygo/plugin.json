{
  "name": "tinygo",
  "version": "0.1.0",
  "description": "tinygo — Go compiler for microcontrollers, WebAssembly, and command-line tools with a small footprint",
  "source": "https://github.com/tinygo-org/tinygo",
  "checks": [
    { "type": "binary", "name": "tinygo" }
  ],
  "install_guidance": {
    "plugin": "tinygo",
    "binary": "tinygo",
    "check": "which tinygo",
    "install_steps": ["brew install tinygo", "Verify: tinygo version", "supercli plugins install ./plugins/tinygo --on-conflict replace --json"]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tinygo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tinygo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tinygo",
        "passthrough": true,
        "missingDependencyHelp": "Install tinygo: https://tinygo.org/getting-started/"
      },
      "args": []
    }
  ]
}
