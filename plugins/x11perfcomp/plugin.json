{
  "name": "x11perfcomp",
  "version": "0.1.0",
  "description": "CLI tool: x11perfcomp",
  "source": "https://manpages.debian.org/x11perfcomp",
  "checks": [
    {
      "type": "binary",
      "name": "x11perfcomp"
    }
  ],
  "install_guidance": {
    "plugin": "x11perfcomp",
    "binary": "x11perfcomp",
    "check": "which x11perfcomp",
    "install_steps": [
      "apt-get install x11perfcomp 2>/dev/null || which x11perfcomp",
      "Verify: x11perfcomp --version",
      "supercli plugins install ./plugins/x11perfcomp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "x11perfcomp",
      "resource": "self",
      "action": "version",
      "description": "Print x11perfcomp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "x11perfcomp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install x11perfcomp: apt-get install x11perfcomp 2>/dev/null || which x11perfcomp"
      },
      "args": []
    },
    {
      "namespace": "x11perfcomp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to x11perfcomp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "x11perfcomp",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install x11perfcomp: apt-get install x11perfcomp 2>/dev/null || which x11perfcomp"
      },
      "args": []
    }
  ]
}