{
  "name": "mbw",
  "version": "0.1.0",
  "description": "Memory Bandwidth Benchmark",
  "source": "https://github.com/raas/mbw/",
  "checks": [
    {
      "type": "binary",
      "name": "mbw"
    }
  ],
  "install_guidance": {
    "plugin": "mbw",
    "binary": "mbw",
    "check": "which mbw",
    "install_steps": [
      "brew install mbw",
      "Verify: mbw --version",
      "supercli plugins install ./plugins/mbw --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "mbw",
      "resource": "self",
      "action": "version",
      "description": "Print mbw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mbw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mbw: brew install mbw"
      },
      "args": []
    },
    {
      "namespace": "mbw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mbw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mbw",
        "passthrough": true,
        "missingDependencyHelp": "Install mbw"
      },
      "args": []
    }
  ]
}