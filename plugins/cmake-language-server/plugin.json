{
  "name": "cmake-language-server",
  "version": "0.1.0",
  "description": "Language Server for CMake",
  "source": "https://github.com/regen100/cmake-language-server",
  "checks": [
    {
      "type": "binary",
      "name": "cmake-language-server"
    }
  ],
  "install_guidance": {
    "plugin": "cmake-language-server",
    "binary": "cmake-language-server",
    "check": "which cmake-language-server",
    "install_steps": [
      "brew install cmake-language-server",
      "Verify: cmake-language-server --version",
      "supercli plugins install ./plugins/cmake-language-server --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cmake-language-server",
      "resource": "self",
      "action": "version",
      "description": "Print cmake-language-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmake-language-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmake-language-server: brew install cmake-language-server"
      },
      "args": []
    },
    {
      "namespace": "cmake-language-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmake-language-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmake-language-server",
        "passthrough": true,
        "missingDependencyHelp": "Install cmake-language-server"
      },
      "args": []
    }
  ]
}