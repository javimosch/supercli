{
  "name": "admesh",
  "version": "0.1.0",
  "description": "Processes triangulated solid meshes",
  "source": "https://github.com/admesh/admesh",
  "checks": [
    {
      "type": "binary",
      "name": "admesh"
    }
  ],
  "install_guidance": {
    "plugin": "admesh",
    "binary": "admesh",
    "check": "which admesh",
    "install_steps": [
      "brew install admesh",
      "Verify: admesh --version",
      "supercli plugins install ./plugins/admesh --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "admesh",
      "resource": "self",
      "action": "version",
      "description": "Print admesh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "admesh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install admesh: brew install admesh"
      },
      "args": []
    },
    {
      "namespace": "admesh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to admesh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "admesh",
        "passthrough": true,
        "missingDependencyHelp": "Install admesh"
      },
      "args": []
    }
  ]
}