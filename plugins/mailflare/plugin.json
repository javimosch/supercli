{
  "name": "mailflare",
  "version": "0.1.0",
  "description": "Email client with custom domain support based on Cloudflare",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "mailflare" }],
  "install_guidance": {
    "plugin": "mailflare",
    "binary": "mailflare",
    "check": "which mailflare",
    "install_steps": ["git clone && npm install", "Verify: mailflare --version", "supercli plugins install ./plugins/mailflare --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mailflare",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mailflare CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mailflare",
      "passthrough": true,
      "missingDependencyHelp": "Install mailflare: git clone && npm install"
    },
    "args": []
  }]
}
