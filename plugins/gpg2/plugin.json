{
  "name": "gpg2",
  "version": "0.1.0",
  "description": "CLI tool: gpg2",
  "source": "https://manpages.debian.org/gpg2",
  "checks": [
    {
      "type": "binary",
      "name": "gpg2"
    }
  ],
  "install_guidance": {
    "plugin": "gpg2",
    "binary": "gpg2",
    "check": "which gpg2",
    "install_steps": [
      "apt-get install gpg2 2>/dev/null || which gpg2",
      "Verify: gpg2 --version",
      "supercli plugins install ./plugins/gpg2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gpg2",
      "resource": "self",
      "action": "version",
      "description": "Print gpg2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpg2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gpg2: apt-get install gpg2 2>/dev/null || which gpg2"
      },
      "args": []
    },
    {
      "namespace": "gpg2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpg2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpg2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gpg2: apt-get install gpg2 2>/dev/null || which gpg2"
      },
      "args": []
    }
  ]
}