{
  "name": "clap",
  "version": "0.1.0",
  "description": "Clap — command-line argument parser for Rust with derive support",
  "source": "https://github.com/clap-rs/clap",
  "checks": [
    {
      "type": "binary",
      "name": "clap"
    }
  ],
  "install_guidance": {
    "plugin": "clap",
    "binary": "clap",
    "check": "which clap",
    "install_steps": [
      "cargo add clap",
      "Verify: clap --version",
      "supercli plugins install ./plugins/clap --on-conflict replace --json"
    ],
    "note": "clap is primarily a Rust library — use `cargo add clap` inside a Rust project."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clap",
      "resource": "self",
      "action": "version",
      "description": "Print clap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clap",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install clap: cargo add clap"
      },
      "args": []
    }
  ]
}
