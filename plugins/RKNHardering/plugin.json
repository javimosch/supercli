{
  "name": "RKNHardering",
  "version": "0.1.0",
  "description": "\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u043d\u0438\u0435 VPN \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u043d\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445 \u0441 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439 \u0446\u0435\u043b\u044c\u044e \u0437\u0430\u0449\u0438\u0442\u044b \u043e\u0442 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d",
  "source": "https://github.com/RKNHardering/RKNHardering",
  "checks": [
    {
      "type": "binary",
      "name": "rknhardering"
    }
  ],
  "install_guidance": {
    "plugin": "RKNHardering",
    "binary": "rknhardering",
    "check": "which rknhardering",
    "install_steps": [
      "pip install rknhardering",
      "Verify: rknhardering --version",
      "supercli plugins install ./plugins/RKNHardering --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RKNHardering",
      "resource": "self",
      "action": "version",
      "description": "Print RKNHardering version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rknhardering",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RKNHardering: pip install rknhardering"
      },
      "args": []
    },
    {
      "namespace": "RKNHardering",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rknhardering CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rknhardering",
        "passthrough": true,
        "missingDependencyHelp": "Install RKNHardering: pip install rknhardering"
      },
      "args": []
    }
  ]
}