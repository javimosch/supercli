{
  "name": "fdupes",
  "version": "1.0.0",
  "description": "fdupes \u2014 Duplicate file finder",
  "source": "github.com/adrianlopezroche/fdupes",
  "checks": [
    {
      "type": "binary",
      "name": "fdupes"
    }
  ],
  "install_guidance": {
    "plugin": "fdupes",
    "binary": "fdupes",
    "check": "which fdupes",
    "install_steps": [
      "# Install fdupes:",
      "# apt: sudo apt-get install fdupes",
      "# brew: brew install fdupes",
      "# cargo: cargo install fdupes",
      "# npm: npm install -g fdupes",
      "# pip: pip install fdupes",
      "# or download from github.com/adrianlopezroche/fdupes"
    ]
  },
  "commands": [
    {
      "namespace": "fdupes",
      "resource": "fdupes",
      "action": "run",
      "description": "Run fdupes",
      "adapter": "process",
      "adapterConfig": {
        "command": "fdupes",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install fdupes from github.com/adrianlopezroche/fdupes"
      },
      "args": []
    }
  ]
}