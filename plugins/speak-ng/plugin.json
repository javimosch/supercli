{
  "name": "speak-ng",
  "version": "0.1.0",
  "description": "CLI tool: speak-ng",
  "source": "https://manpages.debian.org/speak-ng",
  "checks": [
    {
      "type": "binary",
      "name": "speak-ng"
    }
  ],
  "install_guidance": {
    "plugin": "speak-ng",
    "binary": "speak-ng",
    "check": "which speak-ng",
    "install_steps": [
      "apt-get install speak-ng 2>/dev/null || which speak-ng",
      "Verify: speak-ng --version",
      "supercli plugins install ./plugins/speak-ng --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "speak-ng",
      "resource": "self",
      "action": "version",
      "description": "Print speak-ng version",
      "adapter": "process",
      "adapterConfig": {
        "command": "speak-ng",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install speak-ng: apt-get install speak-ng 2>/dev/null || which speak-ng"
      },
      "args": []
    },
    {
      "namespace": "speak-ng",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to speak-ng CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "speak-ng",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install speak-ng: apt-get install speak-ng 2>/dev/null || which speak-ng"
      },
      "args": []
    }
  ]
}