{
  "name": "htconvert",
  "version": "0.1.0",
  "description": "Convert .htaccess redirects to nginx.conf redirects",
  "source": "https://github.com/lukechilds/htconvert",
  "checks": [
    {
      "type": "binary",
      "name": "htconvert"
    }
  ],
  "install_guidance": {
    "plugin": "htconvert",
    "binary": "htconvert",
    "check": "which htconvert",
    "install_steps": [
      "See https://github.com/lukechilds/htconvert",
      "Verify: htconvert --version",
      "supercli plugins install ./plugins/htconvert --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "htconvert",
      "resource": "self",
      "action": "version",
      "description": "Print htconvert version",
      "adapter": "process",
      "adapterConfig": {
        "command": "htconvert",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install htconvert: See https://github.com/lukechilds/htconvert"
      },
      "args": []
    },
    {
      "namespace": "htconvert",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to htconvert CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "htconvert",
        "passthrough": true,
        "missingDependencyHelp": "Install htconvert"
      },
      "args": []
    }
  ]
}