{
  "name": "gennorm2",
  "version": "0.1.0",
  "description": "CLI tool: gennorm2",
  "source": "https://manpages.debian.org/gennorm2",
  "checks": [
    {
      "type": "binary",
      "name": "gennorm2"
    }
  ],
  "install_guidance": {
    "plugin": "gennorm2",
    "binary": "gennorm2",
    "check": "which gennorm2",
    "install_steps": [
      "apt-get install gennorm2 2>/dev/null || which gennorm2",
      "Verify: gennorm2 --version",
      "supercli plugins install ./plugins/gennorm2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gennorm2",
      "resource": "self",
      "action": "version",
      "description": "Print gennorm2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gennorm2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gennorm2: apt-get install gennorm2 2>/dev/null || which gennorm2"
      },
      "args": []
    },
    {
      "namespace": "gennorm2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gennorm2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gennorm2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gennorm2: apt-get install gennorm2 2>/dev/null || which gennorm2"
      },
      "args": []
    }
  ]
}