{
  "name": "action-docs",
  "version": "0.1.0",
  "description": "Generate docs for GitHub actions",
  "source": "https://github.com/npalm/action-docs",
  "checks": [
    {
      "type": "binary",
      "name": "action-docs"
    }
  ],
  "install_guidance": {
    "plugin": "action-docs",
    "binary": "action-docs",
    "check": "which action-docs",
    "install_steps": [
      "brew install action-docs",
      "Verify: action-docs --version",
      "supercli plugins install ./plugins/action-docs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "action-docs",
      "resource": "self",
      "action": "version",
      "description": "Print action-docs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "action-docs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install action-docs: brew install action-docs"
      },
      "args": []
    },
    {
      "namespace": "action-docs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to action-docs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "action-docs",
        "passthrough": true,
        "missingDependencyHelp": "Install action-docs"
      },
      "args": []
    }
  ]
}