{
  "name": "indxbib",
  "version": "0.1.0",
  "description": "CLI tool: indxbib",
  "source": "https://manpages.debian.org/indxbib",
  "checks": [
    {
      "type": "binary",
      "name": "indxbib"
    }
  ],
  "install_guidance": {
    "plugin": "indxbib",
    "binary": "indxbib",
    "check": "which indxbib",
    "install_steps": [
      "apt-get install indxbib 2>/dev/null || which indxbib",
      "Verify: indxbib --version",
      "supercli plugins install ./plugins/indxbib --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "indxbib",
      "resource": "self",
      "action": "version",
      "description": "Print indxbib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "indxbib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install indxbib: apt-get install indxbib 2>/dev/null || which indxbib"
      },
      "args": []
    },
    {
      "namespace": "indxbib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to indxbib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "indxbib",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install indxbib: apt-get install indxbib 2>/dev/null || which indxbib"
      },
      "args": []
    }
  ]
}