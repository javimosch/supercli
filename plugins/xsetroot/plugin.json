{
  "name": "xsetroot",
  "version": "0.1.0",
  "description": "CLI tool: xsetroot",
  "source": "https://manpages.debian.org/xsetroot",
  "checks": [
    {
      "type": "binary",
      "name": "xsetroot"
    }
  ],
  "install_guidance": {
    "plugin": "xsetroot",
    "binary": "xsetroot",
    "check": "which xsetroot",
    "install_steps": [
      "apt-get install xsetroot 2>/dev/null || which xsetroot",
      "Verify: xsetroot --version",
      "supercli plugins install ./plugins/xsetroot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xsetroot",
      "resource": "self",
      "action": "version",
      "description": "Print xsetroot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsetroot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xsetroot: apt-get install xsetroot 2>/dev/null || which xsetroot"
      },
      "args": []
    },
    {
      "namespace": "xsetroot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xsetroot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsetroot",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xsetroot: apt-get install xsetroot 2>/dev/null || which xsetroot"
      },
      "args": []
    }
  ]
}