{
  "name": "dhcping",
  "version": "1.0.0",
  "description": "dhcping \u2014 DHCP ping",
  "source": "github.com/amishmm/dhcping",
  "checks": [
    {
      "type": "binary",
      "name": "dhcping"
    }
  ],
  "install_guidance": {
    "plugin": "dhcping",
    "binary": "dhcping",
    "check": "which dhcping",
    "install_steps": [
      "# Install dhcping",
      "# See github.com/amishmm/dhcping",
      "# apt: sudo apt-get install dhcping",
      "# brew: brew install dhcping",
      "# cargo: cargo install dhcping",
      "# npm: npm install -g dhcping",
      "# pip: pip install dhcping"
    ]
  },
  "commands": [
    {
      "namespace": "dhcping",
      "resource": "dhcping",
      "action": "run",
      "description": "Run dhcping",
      "adapter": "process",
      "adapterConfig": {
        "command": "dhcping",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dhcping from github.com/amishmm/dhcping"
      },
      "args": []
    }
  ]
}