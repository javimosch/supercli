{
  "name": "Topit",
  "version": "0.1.0",
  "description": "Pin any window to the top of your screen / \u5728Mac\u4e0a\u5c06\u4f60\u7684\u4efb\u4f55\u7a97\u53e3\u5f3a\u5236\u7f6e\u9876",
  "source": "https://github.com/Topit/Topit",
  "checks": [
    {
      "type": "binary",
      "name": "topit"
    }
  ],
  "install_guidance": {
    "plugin": "Topit",
    "binary": "topit",
    "check": "which topit",
    "install_steps": [
      "pip install topit",
      "Verify: topit --version",
      "supercli plugins install ./plugins/Topit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Topit",
      "resource": "self",
      "action": "version",
      "description": "Print Topit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "topit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Topit: pip install topit"
      },
      "args": []
    },
    {
      "namespace": "Topit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to topit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "topit",
        "passthrough": true,
        "missingDependencyHelp": "Install Topit: pip install topit"
      },
      "args": []
    }
  ]
}