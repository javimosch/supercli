{
  "name": "devpath",
  "version": "0.1.0",
  "description": "CLI tool: devpath",
  "source": "https://packages.debian.org/devpath",
  "checks": [{ "type": "binary", "name": "devpath" }],
  "install_guidance": {
    "plugin": "devpath", "binary": "devpath", "check": "which devpath",
    "install_steps": ["apt-get install devpath 2>/dev/null || which devpath", "Verify: devpath --version", "supercli plugins install ./plugins/devpath --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "devpath", "resource": "_", "action": "_",
    "description": "Passthrough to devpath CLI",
    "adapter": "process", "adapterConfig": { "command": "devpath", "passthrough": true, "missingDependencyHelp": "Install devpath: apt-get install devpath" }, "args": []
  }]
}
