{
  "name": "fixwwps",
  "version": "0.1.0",
  "description": "CLI tool: fixwwps",
  "source": "https://manpages.debian.org/fixwwps",
  "checks": [
    {
      "type": "binary",
      "name": "fixwwps"
    }
  ],
  "install_guidance": {
    "plugin": "fixwwps",
    "binary": "fixwwps",
    "check": "which fixwwps",
    "install_steps": [
      "apt-get install fixwwps 2>/dev/null || which fixwwps",
      "Verify: fixwwps --version",
      "supercli plugins install ./plugins/fixwwps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixwwps",
      "resource": "self",
      "action": "version",
      "description": "Print fixwwps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixwwps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixwwps: apt-get install fixwwps 2>/dev/null || which fixwwps"
      },
      "args": []
    },
    {
      "namespace": "fixwwps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixwwps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixwwps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixwwps: apt-get install fixwwps 2>/dev/null || which fixwwps"
      },
      "args": []
    }
  ]
}