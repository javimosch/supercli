{
  "name": "pyrite64",
  "version": "0.1.0",
  "description": "N64 Game-Engine and Editor using libdragon & tiny3d",
  "source": "https://github.com/pyrite64/pyrite64",
  "checks": [
    {
      "type": "binary",
      "name": "pyrite64"
    }
  ],
  "install_guidance": {
    "plugin": "pyrite64",
    "binary": "pyrite64",
    "check": "which pyrite64",
    "install_steps": [
      "pip install pyrite64",
      "Verify: pyrite64 --version",
      "supercli plugins install ./plugins/pyrite64 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pyrite64",
      "resource": "self",
      "action": "version",
      "description": "Print pyrite64 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrite64",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pyrite64: pip install pyrite64"
      },
      "args": []
    },
    {
      "namespace": "pyrite64",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pyrite64 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pyrite64",
        "passthrough": true,
        "missingDependencyHelp": "Install pyrite64: pip install pyrite64"
      },
      "args": []
    }
  ]
}