{
  "name": "BD-JB-1250",
  "version": "0.1.0",
  "description": "BD-JB for up to PS4 12.50",
  "source": "https://github.com/BD-JB-1250/BD-JB-1250",
  "checks": [
    {
      "type": "binary",
      "name": "bd-jb-1250"
    }
  ],
  "install_guidance": {
    "plugin": "BD-JB-1250",
    "binary": "bd-jb-1250",
    "check": "which bd-jb-1250",
    "install_steps": [
      "pip install bd-jb-1250",
      "Verify: bd-jb-1250 --version",
      "supercli plugins install ./plugins/BD-JB-1250 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "BD-JB-1250",
      "resource": "self",
      "action": "version",
      "description": "Print BD-JB-1250 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bd-jb-1250",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install BD-JB-1250: pip install bd-jb-1250"
      },
      "args": []
    },
    {
      "namespace": "BD-JB-1250",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bd-jb-1250 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bd-jb-1250",
        "passthrough": true,
        "missingDependencyHelp": "Install BD-JB-1250: pip install bd-jb-1250"
      },
      "args": []
    }
  ]
}