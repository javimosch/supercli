{
  "name": "bounceback",
  "version": "0.1.0",
  "description": "Stealth redirector for red team operation security",
  "source": "https://github.com/D00Movenok/BounceBack",
  "checks": [
    {
      "type": "binary",
      "name": "bounceback"
    }
  ],
  "install_guidance": {
    "plugin": "bounceback",
    "binary": "bounceback",
    "check": "which bounceback",
    "install_steps": [
      "brew install bounceback",
      "Verify: bounceback --version",
      "supercli plugins install ./plugins/bounceback --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bounceback",
      "resource": "self",
      "action": "version",
      "description": "Print bounceback version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bounceback",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bounceback: brew install bounceback"
      },
      "args": []
    },
    {
      "namespace": "bounceback",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bounceback CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bounceback",
        "passthrough": true,
        "missingDependencyHelp": "Install bounceback"
      },
      "args": []
    }
  ]
}