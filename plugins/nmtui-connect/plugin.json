{
  "name": "nmtui-connect",
  "version": "0.1.0",
  "description": "CLI tool: nmtui-connect",
  "source": "https://manpages.debian.org/nmtui-connect",
  "checks": [
    {
      "type": "binary",
      "name": "nmtui-connect"
    }
  ],
  "install_guidance": {
    "plugin": "nmtui-connect",
    "binary": "nmtui-connect",
    "check": "which nmtui-connect",
    "install_steps": [
      "apt-get install nmtui-connect 2>/dev/null || which nmtui-connect",
      "Verify: nmtui-connect --version",
      "supercli plugins install ./plugins/nmtui-connect --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nmtui-connect",
      "resource": "self",
      "action": "version",
      "description": "Print nmtui-connect version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nmtui-connect",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nmtui-connect: apt-get install nmtui-connect 2>/dev/null || which nmtui-connect"
      },
      "args": []
    },
    {
      "namespace": "nmtui-connect",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nmtui-connect CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nmtui-connect",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nmtui-connect: apt-get install nmtui-connect 2>/dev/null || which nmtui-connect"
      },
      "args": []
    }
  ]
}