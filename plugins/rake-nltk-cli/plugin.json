{
  "name": "rake-nltk-cli",
  "version": "0.1.0",
  "description": "CLI wrapper for RAKE rapid keyword extraction algorithm",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "rake-nltk-cli" }],
  "install_guidance": {
    "plugin": "rake-nltk-cli",
    "binary": "rake-nltk-cli",
    "check": "which rake-nltk-cli",
    "install_steps": ["pip install rake-nltk", "Verify: rake-nltk-cli --version", "supercli plugins install ./plugins/rake-nltk-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rake-nltk-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rake-nltk-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rake-nltk-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install rake-nltk-cli: pip install rake-nltk"
    },
    "args": []
  }]
}
