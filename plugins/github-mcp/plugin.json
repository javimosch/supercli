{
  "name": "github-mcp",
  "version": "1.0.0",
  "description": "GitHub MCP server — official GitHub API via MCP (29.8k⭐). Issues, PRs, repos, code search, and more.",
  "source": "https://github.com/github/github-mcp-server",
  "checks": [
    { "type": "binary", "name": "github-mcp-server" }
  ],
  "install_guidance": {
    "plugin": "github-mcp",
    "binary": "github-mcp-server",
    "check": "github-mcp-server --help 2>&1 | head -3",
    "install_steps": [
      "curl -LO https://github.com/github/github-mcp-server/releases/latest/download/github-mcp-server_Linux_x86_64.tar.gz",
      "tar xzf github-mcp-server_Linux_x86_64.tar.gz",
      "sudo mv github-mcp-server /usr/local/bin/",
      "Run: sc github-mcp self mcp",
      "Set GITHUB_TOKEN env var for authenticated access"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "github-mcp",
      "resource": "self",
      "action": "mcp",
      "description": "Register github-mcp MCP server for agent use",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "cwd": "plugin_dir",
        "baseArgs": ["../../scripts/register-mcp.js", "github-mcp", "github-mcp-server", "[]", "GitHub MCP server (official)"],
        "timeout_ms": 15000
      },
      "args": []
    },
    {
      "namespace": "github-mcp",
      "resource": "self",
      "action": "start",
      "description": "Start github-mcp MCP server manually",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-mcp-server",
        "timeout_ms": 120000,
        "requiresInteractive": true
      },
      "args": []
    },
    {
      "namespace": "github-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to github-mcp-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-mcp-server",
        "passthrough": true,
        "timeout_ms": 60000
      },
      "args": []
    }
  ]
}
