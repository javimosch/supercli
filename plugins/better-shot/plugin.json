{
  "name": "better-shot",
  "version": "0.1.0",
  "description": "An open-source alternative to CleanShot X for macOS. Capture, edit, and enhance your screenshots wit",
  "source": "https://github.com/better-shot/better-shot",
  "checks": [
    {
      "type": "binary",
      "name": "better-shot"
    }
  ],
  "install_guidance": {
    "plugin": "better-shot",
    "binary": "better-shot",
    "check": "which better-shot",
    "install_steps": [
      "pip install better-shot",
      "Verify: better-shot --version",
      "supercli plugins install ./plugins/better-shot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "better-shot",
      "resource": "self",
      "action": "version",
      "description": "Print better-shot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "better-shot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install better-shot: pip install better-shot"
      },
      "args": []
    },
    {
      "namespace": "better-shot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to better-shot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "better-shot",
        "passthrough": true,
        "missingDependencyHelp": "Install better-shot: pip install better-shot"
      },
      "args": []
    }
  ]
}