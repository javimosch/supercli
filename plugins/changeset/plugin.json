{
  "name": "changeset",
  "version": "0.1.0",
  "description": "Manage versioning and changelogs with changelogs",
  "source": "https://github.com/changesets/changesets",
  "checks": [{ "type": "binary", "name": "changeset" }],
  "install_guidance": {
    "plugin": "changeset",
    "binary": "changeset",
    "check": "which changeset",
    "install_steps": ["npm install -g @changesets/cli", "Verify: changeset --version", "supercli plugins install ./plugins/changeset --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "changeset",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to changeset CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "changeset",
      "passthrough": true,
      "missingDependencyHelp": "Install changeset: npm install -g @changesets/cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
