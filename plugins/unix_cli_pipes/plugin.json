{
  "name": "unix_cli_pipes",
  "version": "0.1.0",
  "description": "An emulated CLI using POSIX threads to handle multiple pipes",
  "source": "https://github.com/unix_cli_pipes/unix_cli_pipes",
  "checks": [
    {
      "type": "binary",
      "name": "unix_cli_pipes"
    }
  ],
  "install_guidance": {
    "plugin": "unix_cli_pipes",
    "binary": "unix_cli_pipes",
    "check": "which unix_cli_pipes",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: unix_cli_pipes --version",
      "supercli plugins install ./plugins/unix_cli_pipes --on-conflict replace --json"
    ],
    "note": "C language CLI tool"
  },
  "commands": [
    {
      "namespace": "unix_cli_pipes",
      "resource": "self",
      "action": "version",
      "description": "Print unix_cli_pipes version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unix_cli_pipes",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unix_cli_pipes from project repository"
      },
      "args": []
    },
    {
      "namespace": "unix_cli_pipes",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unix_cli_pipes CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unix_cli_pipes",
        "passthrough": true,
        "missingDependencyHelp": "Install unix_cli_pipes from project repository"
      },
      "args": []
    }
  ]
}