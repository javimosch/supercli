{
  "name": "dumppdf.py",
  "version": "0.1.0",
  "description": "CLI tool: dumppdf.py",
  "source": "https://manpages.debian.org/dumppdf.py",
  "checks": [
    {
      "type": "binary",
      "name": "dumppdf.py"
    }
  ],
  "install_guidance": {
    "plugin": "dumppdf.py",
    "binary": "dumppdf.py",
    "check": "which dumppdf.py",
    "install_steps": [
      "apt-get install dumppdf.py 2>/dev/null || which dumppdf.py",
      "Verify: dumppdf.py --version",
      "supercli plugins install ./plugins/dumppdf.py --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dumppdf.py",
      "resource": "self",
      "action": "version",
      "description": "Print dumppdf.py version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dumppdf.py",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dumppdf.py: apt-get install dumppdf.py 2>/dev/null || which dumppdf.py"
      },
      "args": []
    },
    {
      "namespace": "dumppdf.py",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dumppdf.py CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dumppdf.py",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dumppdf.py: apt-get install dumppdf.py 2>/dev/null || which dumppdf.py"
      },
      "args": []
    }
  ]
}