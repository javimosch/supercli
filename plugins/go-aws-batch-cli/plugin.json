{
  "name": "go-aws-batch-cli",
  "version": "0.1.0",
  "description": "A (better) command line for AWS Batch",
  "source": "https://github.com/go-aws-batch-cli/go-aws-batch-cli",
  "checks": [
    {
      "type": "binary",
      "name": "go-aws-batch-cli"
    }
  ],
  "install_guidance": {
    "plugin": "go-aws-batch-cli",
    "binary": "go-aws-batch-cli",
    "check": "which go-aws-batch-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: go-aws-batch-cli --version",
      "supercli plugins install ./plugins/go-aws-batch-cli --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "go-aws-batch-cli",
      "resource": "self",
      "action": "version",
      "description": "Print go-aws-batch-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-aws-batch-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-aws-batch-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "go-aws-batch-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-aws-batch-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-aws-batch-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install go-aws-batch-cli from project repository"
      },
      "args": []
    }
  ]
}