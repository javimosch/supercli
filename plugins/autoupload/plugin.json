{
  "name": "autoupload",
  "version": "0.1.0",
  "description": "Auto-upload screenshots to image hosting services",
  "source": "go",
  "checks": [{ "type": "binary", "name": "autoupload" }],
  "install_guidance": {
    "plugin": "autoupload",
    "binary": "autoupload",
    "check": "which autoupload",
    "install_steps": ["go install github.com/autoupload@latest", "Verify: autoupload --version", "supercli plugins install ./plugins/autoupload --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "autoupload",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to autoupload CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "autoupload",
      "passthrough": true,
      "missingDependencyHelp": "Install autoupload: go install github.com/autoupload@latest"
    },
    "args": []
  }]
}
