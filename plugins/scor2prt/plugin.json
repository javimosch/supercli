{
  "name": "scor2prt",
  "version": "0.1.0",
  "description": "CLI tool: scor2prt",
  "source": "https://manpages.debian.org/scor2prt",
  "checks": [
    {
      "type": "binary",
      "name": "scor2prt"
    }
  ],
  "install_guidance": {
    "plugin": "scor2prt",
    "binary": "scor2prt",
    "check": "which scor2prt",
    "install_steps": [
      "apt-get install scor2prt 2>/dev/null || which scor2prt",
      "Verify: scor2prt --version",
      "supercli plugins install ./plugins/scor2prt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "scor2prt",
      "resource": "self",
      "action": "version",
      "description": "Print scor2prt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scor2prt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scor2prt: apt-get install scor2prt 2>/dev/null || which scor2prt"
      },
      "args": []
    },
    {
      "namespace": "scor2prt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scor2prt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scor2prt",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install scor2prt: apt-get install scor2prt 2>/dev/null || which scor2prt"
      },
      "args": []
    }
  ]
}