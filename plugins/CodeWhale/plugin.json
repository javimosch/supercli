{
  "name": "CodeWhale",
  "version": "0.1.0",
  "description": "DeepSeek + MiMo coding agent in terminal",
  "source": "https://github.com/CodeWhale/CodeWhale",
  "checks": [
    {
      "type": "binary",
      "name": "codewhale"
    }
  ],
  "install_guidance": {
    "plugin": "CodeWhale",
    "binary": "codewhale",
    "check": "which codewhale",
    "install_steps": [
      "pip install codewhale",
      "Verify: codewhale --version",
      "supercli plugins install ./plugins/CodeWhale --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CodeWhale",
      "resource": "self",
      "action": "version",
      "description": "Print CodeWhale version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codewhale",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CodeWhale: pip install codewhale"
      },
      "args": []
    },
    {
      "namespace": "CodeWhale",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codewhale CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codewhale",
        "passthrough": true,
        "missingDependencyHelp": "Install CodeWhale: pip install codewhale"
      },
      "args": []
    }
  ]
}