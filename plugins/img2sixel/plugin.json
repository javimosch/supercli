{
  "name": "img2sixel",
  "version": "0.1.0",
  "description": "Convert images to DEC SIXEL graphics format",
  "source": "https://github.com/saitoha/libsixel",
  "checks": [{ "type": "binary", "name": "img2sixel" }],
  "install_guidance": {
    "plugin": "img2sixel",
    "binary": "img2sixel",
    "check": "which img2sixel",
    "install_steps": ["brew install libsixel", "Verify: img2sixel --version", "supercli plugins install ./plugins/img2sixel --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "img2sixel",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to img2sixel CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "img2sixel",
      "passthrough": true,
      "missingDependencyHelp": "Install img2sixel: brew install libsixel", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
