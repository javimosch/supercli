{
  "name": "sequin",
  "version": "0.1.0",
  "description": "Human-readable ANSI formatting for log streams",
  "source": "https://github.com/charmbracelet/sequin",
  "checks": [{ "type": "binary", "name": "sequin" }],
  "install_guidance": {
    "plugin": "sequin",
    "binary": "sequin",
    "check": "which sequin",
    "install_steps": ["brew install sequin", "Verify: sequin --version", "supercli plugins install ./plugins/sequin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sequin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sequin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sequin",
      "passthrough": true,
      "missingDependencyHelp": "Install sequin: brew install sequin"
    },
    "args": []
  }]
}
