{
  "name": "hetzner-cli",
  "version": "0.1.0",
  "description": "Hetzner Cloud CLI for managing cloud resources",
  "source": "https",
  "checks": [{"type": "binary", "name": "hcloud"}],
  "install_guidance": {
    "plugin": "hetzner-cli",
    "binary": "hcloud",
    "check": "which hcloud",
    "install_steps": [
      "brew install hcloud",
      "Verify: hcloud --version",
      "supercli plugins install ./plugins/hetzner-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "hetzner-cli",
      "resource": "self",
      "action": "version",
      "description": "Print hetzner-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "hcloud", "baseArgs": ["--version"], "missingDependencyHelp": "Install hetzner-cli: brew install hcloud"},
      "args": []
    },
    {
      "namespace": "hetzner-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hcloud CLI",
      "adapter": "process",
      "adapterConfig": {"command": "hcloud", "passthrough": true, "missingDependencyHelp": "Install hetzner-cli: brew install hcloud"},
      "args": []
    }
  ]
}
