{
  "name": "iamy",
  "version": "0.1.0",
  "description": "AWS IAM import and export tool",
  "source": "https://github.com/99designs/iamy",
  "checks": [
    {
      "type": "binary",
      "name": "iamy"
    }
  ],
  "install_guidance": {
    "plugin": "iamy",
    "binary": "iamy",
    "check": "which iamy",
    "install_steps": [
      "brew install iamy",
      "Verify: iamy --version",
      "supercli plugins install ./plugins/iamy --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "iamy",
      "resource": "self",
      "action": "version",
      "description": "Print iamy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iamy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iamy: brew install iamy"
      },
      "args": []
    },
    {
      "namespace": "iamy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iamy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iamy",
        "passthrough": true,
        "missingDependencyHelp": "Install iamy"
      },
      "args": []
    }
  ]
}