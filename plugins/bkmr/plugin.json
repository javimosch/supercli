{
  "name": "bkmr",
  "version": "0.1.0",
  "description": "Fast bookmark manager with fuzzy search in Rust",
  "source": "https://github.com/melusina-org/bkmr",
  "checks": [{ "type": "binary", "name": "bkmr" }],
  "install_guidance": {
    "plugin": "bkmr",
    "binary": "bkmr",
    "check": "which bkmr",
    "install_steps": ["cargo install bkmr", "Verify: bkmr --version", "supercli plugins install ./plugins/bkmr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bkmr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bkmr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bkmr",
      "passthrough": true,
      "missingDependencyHelp": "Install bkmr: cargo install bkmr", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
