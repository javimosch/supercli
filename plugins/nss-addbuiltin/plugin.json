{
  "name": "nss-addbuiltin",
  "version": "0.1.0",
  "description": "CLI tool: nss-addbuiltin",
  "source": "https://manpages.debian.org/nss-addbuiltin",
  "checks": [
    {
      "type": "binary",
      "name": "nss-addbuiltin"
    }
  ],
  "install_guidance": {
    "plugin": "nss-addbuiltin",
    "binary": "nss-addbuiltin",
    "check": "which nss-addbuiltin",
    "install_steps": [
      "apt-get install nss-addbuiltin 2>/dev/null || which nss-addbuiltin",
      "Verify: nss-addbuiltin --version",
      "supercli plugins install ./plugins/nss-addbuiltin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nss-addbuiltin",
      "resource": "self",
      "action": "version",
      "description": "Print nss-addbuiltin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nss-addbuiltin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nss-addbuiltin: apt-get install nss-addbuiltin 2>/dev/null || which nss-addbuiltin"
      },
      "args": []
    },
    {
      "namespace": "nss-addbuiltin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nss-addbuiltin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nss-addbuiltin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install nss-addbuiltin: apt-get install nss-addbuiltin 2>/dev/null || which nss-addbuiltin"
      },
      "args": []
    }
  ]
}