{
  "name": "bentoml",
  "version": "0.1.0",
  "description": "CLI for packaging ML models for production deployment",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "bentoml" }],
  "install_guidance": {
    "plugin": "bentoml",
    "binary": "bentoml",
    "check": "which bentoml",
    "install_steps": ["pip install bentoml", "Verify: bentoml --version", "supercli plugins install ./plugins/bentoml --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bentoml",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bentoml CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bentoml",
      "passthrough": true,
      "missingDependencyHelp": "Install bentoml: pip install bentoml"
    },
    "args": []
  }]
}
