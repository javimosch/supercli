{
  "name": "lazyssh",
  "version": "0.1.0",
  "description": "A terminal-based SSH manager inspired by lazydocker and k9s - Written in go",
  "source": "https://github.com/lazyssh/lazyssh",
  "checks": [
    {
      "type": "binary",
      "name": "lazyssh"
    }
  ],
  "install_guidance": {
    "plugin": "lazyssh",
    "binary": "lazyssh",
    "check": "which lazyssh",
    "install_steps": [
      "pip install lazyssh",
      "Verify: lazyssh --version",
      "supercli plugins install ./plugins/lazyssh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lazyssh",
      "resource": "self",
      "action": "version",
      "description": "Print lazyssh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lazyssh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lazyssh: pip install lazyssh"
      },
      "args": []
    },
    {
      "namespace": "lazyssh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lazyssh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lazyssh",
        "passthrough": true,
        "missingDependencyHelp": "Install lazyssh: pip install lazyssh"
      },
      "args": []
    }
  ]
}