{
  "plugin": "apropos",
  "binary": "apropos",
  "check": "which apropos",
  "install_steps": [
    "Pre-installed on most Linux systems (part of man-db package)",
    "apt-get install man-db",
    "Verify: apropos --version",
    "supercli plugins install ./plugins/apropos --on-conflict replace --json"
  ]
}
