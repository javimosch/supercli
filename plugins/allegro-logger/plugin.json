{
  "name": "allegro-logger",
  "version": "0.1.0",
  "description": "CLI tool: allegro-logger",
  "source": "https://packages.debian.org/allegro-logger",
  "checks": [{ "type": "binary", "name": "allegro-logger" }],
  "install_guidance": {
    "plugin": "allegro-logger", "binary": "allegro-logger", "check": "which allegro-logger",
    "install_steps": ["apt-get install allegro-logger 2>/dev/null || which allegro-logger", "Verify: allegro-logger --version", "supercli plugins install ./plugins/allegro-logger --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "allegro-logger", "resource": "_", "action": "_",
    "description": "Passthrough to allegro-logger CLI",
    "adapter": "process", "adapterConfig": { "command": "allegro-logger", "passthrough": true, "missingDependencyHelp": "Install allegro-logger: apt-get install allegro-logger" }, "args": []
  }]
}
