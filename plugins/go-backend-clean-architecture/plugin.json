{
  "name": "go-backend-clean-architecture",
  "version": "0.1.0",
  "description": "A Go (Golang) Backend Clean Architecture project with Gin, MongoDB, JWT Authentication Middleware, T",
  "source": "https://github.com/go-backend-clean-architecture/go-backend-clean-architecture",
  "checks": [
    {
      "type": "binary",
      "name": "go-backend-clean-architecture"
    }
  ],
  "install_guidance": {
    "plugin": "go-backend-clean-architecture",
    "binary": "go-backend-clean-architecture",
    "check": "which go-backend-clean-architecture",
    "install_steps": [
      "pip install go-backend-clean-architecture",
      "Verify: go-backend-clean-architecture --version",
      "supercli plugins install ./plugins/go-backend-clean-architecture --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-backend-clean-architecture",
      "resource": "self",
      "action": "version",
      "description": "Print go-backend-clean-architecture version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-backend-clean-architecture",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-backend-clean-architecture: pip install go-backend-clean-architecture"
      },
      "args": []
    },
    {
      "namespace": "go-backend-clean-architecture",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-backend-clean-architecture CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-backend-clean-architecture",
        "passthrough": true,
        "missingDependencyHelp": "Install go-backend-clean-architecture: pip install go-backend-clean-architecture"
      },
      "args": []
    }
  ]
}