{
  "name": "numi",
  "version": "0.1.0",
  "description": "Beautiful calculator app for macOS/Linux/Windows in JavaScript",
  "source": "https://github.com/nicedoc/numi",
  "checks": [
    {
      "type": "binary",
      "name": "numi"
    }
  ],
  "install_guidance": {
    "plugin": "numi",
    "binary": "numi",
    "check": "which numi",
    "install_steps": [
      "npm install -g numi",
      "Verify: numi --version",
      "supercli plugins install ./plugins/numi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "numi",
      "resource": "self",
      "action": "version",
      "description": "Print numi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "numi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install numi: npm install -g numi"
      },
      "args": []
    },
    {
      "namespace": "numi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to numi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "numi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install numi: npm install -g numi"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
