{
  "name": "git commander",
  "version": "0.1.0",
  "description": "Interactive git tool",
  "source": "https://github.com/golbin/git-commander",
  "checks": [
    {
      "type": "binary",
      "name": "git commander"
    }
  ],
  "install_guidance": {
    "plugin": "git commander",
    "binary": "git commander",
    "check": "which git commander",
    "install_steps": [
      "See https://github.com/golbin/git-commander",
      "Verify: git commander --version",
      "supercli plugins install ./plugins/git commander --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "git commander",
      "resource": "self",
      "action": "version",
      "description": "Print git commander version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git commander",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git commander: See https://github.com/golbin/git-commander"
      },
      "args": []
    },
    {
      "namespace": "git commander",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git commander CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git commander",
        "passthrough": true,
        "missingDependencyHelp": "Install git commander"
      },
      "args": []
    }
  ]
}