{
  "name": "Comic-Encoder",
  "version": "0.1.0",
  "description": "Tool for compiling image chapters into comic book archives",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "Comic-Encoder" }],
  "install_guidance": {
    "plugin": "Comic-Encoder",
    "binary": "Comic-Encoder",
    "check": "which Comic-Encoder",
    "install_steps": ["git clone && cargo build", "Verify: Comic-Encoder --version", "supercli plugins install ./plugins/Comic-Encoder --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "Comic-Encoder",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to Comic-Encoder CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "Comic-Encoder",
      "passthrough": true,
      "missingDependencyHelp": "Install Comic-Encoder: git clone && cargo build"
    },
    "args": []
  }]
}
