{
  "name": "pstree",
  "version": "1.0.0",
  "description": "pstree \u2014 pstree \u2014 CLI utility",
  "source": "/usr/bin/pstree",
  "checks": [
    {
      "type": "binary",
      "name": "pstree"
    }
  ],
  "install_guidance": {
    "plugin": "pstree",
    "binary": "pstree",
    "check": "which pstree",
    "install_steps": [
      "# Install pstree:",
      "# apt: sudo apt-get install pstree",
      "# brew: brew install pstree",
      "# cargo: cargo install pstree",
      "# npm: npm install -g pstree",
      "# pip: pip install pstree",
      "# or download from /usr/bin/pstree"
    ]
  },
  "commands": [
    {
      "namespace": "pstree",
      "resource": "pstree",
      "action": "run",
      "description": "Run pstree",
      "adapter": "process",
      "adapterConfig": {
        "command": "pstree",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pstree from /usr/bin/pstree"
      },
      "args": []
    }
  ]
}