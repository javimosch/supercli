{
  "name": "ncursesFM",
  "version": "0.1.0",
  "description": "File manager written in C, rather complete in terms of features, especially lightweight and responsive.",
  "source": "https://github.com/FedeDP/ncursesFM",
  "checks": [
    {
      "type": "binary",
      "name": "ncursesFM"
    }
  ],
  "install_guidance": {
    "plugin": "ncursesFM",
    "binary": "ncursesFM",
    "check": "which ncursesFM",
    "install_steps": [
      "See https://github.com/FedeDP/ncursesFM",
      "Verify: ncursesFM --version",
      "supercli plugins install ./plugins/ncursesFM --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ncursesFM",
      "resource": "self",
      "action": "version",
      "description": "Print ncursesFM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncursesFM",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ncursesFM: See https://github.com/FedeDP/ncursesFM"
      },
      "args": []
    },
    {
      "namespace": "ncursesFM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ncursesFM CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ncursesFM",
        "passthrough": true,
        "missingDependencyHelp": "Install ncursesFM"
      },
      "args": []
    }
  ]
}