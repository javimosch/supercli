{
  "name": "dev-time",
  "version": "0.1.0",
  "description": "Get the current local time of a GitHub user",
  "source": "https://github.com/samverschueren/dev-time-cli",
  "checks": [
    {
      "type": "binary",
      "name": "dev-time"
    }
  ],
  "install_guidance": {
    "plugin": "dev-time",
    "binary": "dev-time",
    "check": "which dev-time",
    "install_steps": [
      "See https://github.com/samverschueren/dev-time-cli",
      "Verify: dev-time --version",
      "supercli plugins install ./plugins/dev-time --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "dev-time",
      "resource": "self",
      "action": "version",
      "description": "Print dev-time version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dev-time",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dev-time: See https://github.com/samverschueren/dev-time-cli"
      },
      "args": []
    },
    {
      "namespace": "dev-time",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dev-time CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dev-time",
        "passthrough": true,
        "missingDependencyHelp": "Install dev-time"
      },
      "args": []
    }
  ]
}