{
  "name": "container-use",
  "version": "0.1.0",
  "description": "Development environments for coding agents. Enable multiple agents to work safely and independently ",
  "source": "https://github.com/container-use/container-use",
  "checks": [
    {
      "type": "binary",
      "name": "container-use"
    }
  ],
  "install_guidance": {
    "plugin": "container-use",
    "binary": "container-use",
    "check": "which container-use",
    "install_steps": [
      "pip install container-use",
      "Verify: container-use --version",
      "supercli plugins install ./plugins/container-use --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "container-use",
      "resource": "self",
      "action": "version",
      "description": "Print container-use version",
      "adapter": "process",
      "adapterConfig": {
        "command": "container-use",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install container-use: pip install container-use"
      },
      "args": []
    },
    {
      "namespace": "container-use",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to container-use CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "container-use",
        "passthrough": true,
        "missingDependencyHelp": "Install container-use: pip install container-use"
      },
      "args": []
    }
  ]
}