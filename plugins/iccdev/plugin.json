{
  "name": "iccdev",
  "version": "0.1.0",
  "description": "Developer tools for interacting with and manipulating ICC profiles",
  "source": "https://github.com/InternationalColorConsortium/iccDEV",
  "checks": [
    {
      "type": "binary",
      "name": "iccdev"
    }
  ],
  "install_guidance": {
    "plugin": "iccdev",
    "binary": "iccdev",
    "check": "which iccdev",
    "install_steps": [
      "brew install iccdev",
      "Verify: iccdev --version",
      "supercli plugins install ./plugins/iccdev --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "iccdev",
      "resource": "self",
      "action": "version",
      "description": "Print iccdev version",
      "adapter": "process",
      "adapterConfig": {
        "command": "iccdev",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install iccdev: brew install iccdev"
      },
      "args": []
    },
    {
      "namespace": "iccdev",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to iccdev CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "iccdev",
        "passthrough": true,
        "missingDependencyHelp": "Install iccdev"
      },
      "args": []
    }
  ]
}