{
  "name": "nanochat",
  "version": "0.1.0",
  "description": "The best ChatGPT that $100 can buy.",
  "source": "https://github.com/nanochat/nanochat",
  "checks": [
    {
      "type": "binary",
      "name": "nanochat"
    }
  ],
  "install_guidance": {
    "plugin": "nanochat",
    "binary": "nanochat",
    "check": "which nanochat",
    "install_steps": [
      "pip install nanochat",
      "Verify: nanochat --version",
      "supercli plugins install ./plugins/nanochat --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nanochat",
      "resource": "self",
      "action": "version",
      "description": "Print nanochat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanochat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nanochat: pip install nanochat"
      },
      "args": []
    },
    {
      "namespace": "nanochat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nanochat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanochat",
        "passthrough": true,
        "missingDependencyHelp": "Install nanochat: pip install nanochat"
      },
      "args": []
    }
  ]
}