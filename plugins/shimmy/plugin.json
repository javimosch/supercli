{
  "name": "shimmy",
  "version": "0.1.0",
  "description": "\u26a1 Pure-Rust WebGPU inference engine \u2014 OpenAI-API compatible, GGUF native, runs on any GPU. No Python",
  "source": "https://github.com/shimmy/shimmy",
  "checks": [
    {
      "type": "binary",
      "name": "shimmy"
    }
  ],
  "install_guidance": {
    "plugin": "shimmy",
    "binary": "shimmy",
    "check": "which shimmy",
    "install_steps": [
      "pip install shimmy",
      "Verify: shimmy --version",
      "supercli plugins install ./plugins/shimmy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "shimmy",
      "resource": "self",
      "action": "version",
      "description": "Print shimmy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shimmy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shimmy: pip install shimmy"
      },
      "args": []
    },
    {
      "namespace": "shimmy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shimmy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shimmy",
        "passthrough": true,
        "missingDependencyHelp": "Install shimmy: pip install shimmy"
      },
      "args": []
    }
  ]
}