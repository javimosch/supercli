{
  "name": "changeloguru",
  "version": "0.1.0",
  "description": "Generate changelog from conventional commits — JSON output supported",
  "source": "https://github.com/changeloguru/changeloguru",
  "checks": [
    {
      "type": "binary",
      "name": "changeloguru"
    }
  ],
  "install_guidance": {
    "plugin": "changeloguru",
    "binary": "changeloguru",
    "check": "which changeloguru",
    "install_steps": [
      "go install github.com/changeloguru/changeloguru@latest",
      "Verify: changeloguru --version",
      "supercli plugins install ./plugins/changeloguru --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "changeloguru",
      "resource": "self",
      "action": "version",
      "description": "Print changeloguru version",
      "adapter": "process",
      "adapterConfig": {
        "command": "changeloguru",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install changeloguru: go install github.com/changeloguru/changeloguru@latest"
      },
      "args": []
    },
    {
      "namespace": "changeloguru",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to changeloguru CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "changeloguru",
        "passthrough": true,
        "missingDependencyHelp": "Install changeloguru: go install github.com/changeloguru/changeloguru@latest"
      },
      "args": []
    }
  ]
}
