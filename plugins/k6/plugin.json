{
  "name": "k6",
  "version": "0.1.0",
  "description": "Modern load testing tool for developers and DevOps engineers",
  "source": "https://github.com/grafana/k6",
  "checks": [{ "type": "binary", "name": "k6" }],
  "install_guidance": {
    "plugin": "k6",
    "binary": "k6",
    "check": "which k6",
    "install_steps": ["brew install k6", "Verify: k6 --version", "supercli plugins install ./plugins/k6 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "k6",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to k6 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "k6",
      "passthrough": true,
      "missingDependencyHelp": "Install k6: brew install k6"
    },
    "args": []
  }]
}
