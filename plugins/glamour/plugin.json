{
  "name": "glamour",
  "version": "0.1.0",
  "description": "Stylesheet-based markdown rendering for CLI in Go",
  "source": "https://github.com/charmbracelet/glamour",
  "checks": [{"type": "binary", "name": "glamour"}],
  "install_guidance": {
    "plugin": "glamour",
    "binary": "glamour",
    "check": "which glamour",
    "install_steps": [
      "go install github.com/charmbracelet/glamour@latest",
      "Verify: glamour --version",
      "supercli plugins install ./glamour --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "glamour",
      "resource": "self",
      "action": "version",
      "description": "Print glamour version",
      "adapter": "process",
      "adapterConfig": {"command": "glamour", "baseArgs": ["--version"], "missingDependencyHelp": "Install glamour: go install github.com/charmbracelet/glamour@latest"},
      "args": []
    },
    {
      "namespace": "glamour",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glamour CLI",
      "adapter": "process",
      "adapterConfig": {"command": "glamour", "passthrough": true, "missingDependencyHelp": "Install glamour: go install github.com/charmbracelet/glamour@latest"},
      "args": []
    }
  ]
}
