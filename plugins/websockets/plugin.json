{
  "name": "websockets",
  "version": "0.1.0",
  "description": "CLI tool: websockets",
  "source": "https://manpages.debian.org/websockets",
  "checks": [
    {
      "type": "binary",
      "name": "websockets"
    }
  ],
  "install_guidance": {
    "plugin": "websockets",
    "binary": "websockets",
    "check": "which websockets",
    "install_steps": [
      "apt-get install websockets 2>/dev/null || which websockets",
      "Verify: websockets --version",
      "supercli plugins install ./plugins/websockets --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "websockets",
      "resource": "self",
      "action": "version",
      "description": "Print websockets version",
      "adapter": "process",
      "adapterConfig": {
        "command": "websockets",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install websockets: apt-get install websockets 2>/dev/null || which websockets"
      },
      "args": []
    },
    {
      "namespace": "websockets",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to websockets CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "websockets",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install websockets: apt-get install websockets 2>/dev/null || which websockets"
      },
      "args": []
    }
  ]
}