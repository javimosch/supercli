{
  "name": "xml2pmx",
  "version": "0.1.0",
  "description": "CLI tool: xml2pmx",
  "source": "https://manpages.debian.org/xml2pmx",
  "checks": [
    {
      "type": "binary",
      "name": "xml2pmx"
    }
  ],
  "install_guidance": {
    "plugin": "xml2pmx",
    "binary": "xml2pmx",
    "check": "which xml2pmx",
    "install_steps": [
      "apt-get install xml2pmx 2>/dev/null || which xml2pmx",
      "Verify: xml2pmx --version",
      "supercli plugins install ./plugins/xml2pmx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xml2pmx",
      "resource": "self",
      "action": "version",
      "description": "Print xml2pmx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xml2pmx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xml2pmx: apt-get install xml2pmx 2>/dev/null || which xml2pmx"
      },
      "args": []
    },
    {
      "namespace": "xml2pmx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xml2pmx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xml2pmx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xml2pmx: apt-get install xml2pmx 2>/dev/null || which xml2pmx"
      },
      "args": []
    }
  ]
}