{
  "name": "streamlit-CLIP-Unsplash-explorer",
  "version": "0.1.0",
  "description": "Explore the image embeddings of Unsplash using CLIP's image similarity",
  "source": "https://share.streamlit.io/thoppe/streamlit-clip-unsplash-explorer",
  "checks": [
    {
      "type": "binary",
      "name": "streamlit-CLIP-Unsplash-explorer"
    }
  ],
  "install_guidance": {
    "plugin": "streamlit-CLIP-Unsplash-explorer",
    "binary": "streamlit-CLIP-Unsplash-explorer",
    "check": "which streamlit-CLIP-Unsplash-explorer",
    "install_steps": [
      "Check https://share.streamlit.io/thoppe/streamlit-clip-unsplash-explorer for installation instructions",
      "Verify: streamlit-CLIP-Unsplash-explorer --version",
      "supercli plugins install ./plugins/streamlit-CLIP-Unsplash-explorer --on-conflict replace --json"
    ],
    "note": "CSS language CLI tool"
  },
  "commands": [
    {
      "namespace": "streamlit-CLIP-Unsplash-explorer",
      "resource": "self",
      "action": "version",
      "description": "Print streamlit-CLIP-Unsplash-explorer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "streamlit-CLIP-Unsplash-explorer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install streamlit-CLIP-Unsplash-explorer from project repository"
      },
      "args": []
    },
    {
      "namespace": "streamlit-CLIP-Unsplash-explorer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to streamlit-CLIP-Unsplash-explorer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "streamlit-CLIP-Unsplash-explorer",
        "passthrough": true,
        "missingDependencyHelp": "Install streamlit-CLIP-Unsplash-explorer from project repository"
      },
      "args": []
    }
  ]
}