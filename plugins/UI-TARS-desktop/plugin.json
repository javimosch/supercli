{
  "name": "UI-TARS-desktop",
  "version": "0.1.0",
  "description": "The Open-Source Multimodal AI Agent Stack: Connecting Cutting-Edge AI Models and Agent Infra",
  "source": "https://github.com/UI-TARS-desktop/UI-TARS-desktop",
  "checks": [
    {
      "type": "binary",
      "name": "ui-tars-desktop"
    }
  ],
  "install_guidance": {
    "plugin": "UI-TARS-desktop",
    "binary": "ui-tars-desktop",
    "check": "which ui-tars-desktop",
    "install_steps": [
      "pip install ui-tars-desktop",
      "Verify: ui-tars-desktop --version",
      "supercli plugins install ./plugins/UI-TARS-desktop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "UI-TARS-desktop",
      "resource": "self",
      "action": "version",
      "description": "Print UI-TARS-desktop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ui-tars-desktop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install UI-TARS-desktop: pip install ui-tars-desktop"
      },
      "args": []
    },
    {
      "namespace": "UI-TARS-desktop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ui-tars-desktop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ui-tars-desktop",
        "passthrough": true,
        "missingDependencyHelp": "Install UI-TARS-desktop: pip install ui-tars-desktop"
      },
      "args": []
    }
  ]
}