{
  "name": "cloudflare-wrangler",
  "version": "0.1.0",
  "description": "CLI tool for Cloudflare Workers",
  "checks": [
    {
      "type": "binary",
      "name": "cloudflare-wrangler"
    }
  ],
  "install_guidance": {
    "plugin": "cloudflare-wrangler",
    "binary": "cloudflare-wrangler",
    "check": "which cloudflare-wrangler",
    "install_steps": [
      "brew install cloudflare-wrangler",
      "Verify: cloudflare-wrangler --version",
      "supercli plugins install ./plugins/cloudflare-wrangler --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cloudflare-wrangler",
      "resource": "self",
      "action": "version",
      "description": "Print cloudflare-wrangler version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudflare-wrangler",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cloudflare-wrangler: brew install cloudflare-wrangler"
      },
      "args": []
    },
    {
      "namespace": "cloudflare-wrangler",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cloudflare-wrangler CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloudflare-wrangler",
        "passthrough": true,
        "missingDependencyHelp": "Install cloudflare-wrangler"
      },
      "args": []
    }
  ]
}