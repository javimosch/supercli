{
  "name": "alevin-fry",
  "version": "0.1.0",
  "description": "Efficient and flexible tool for processing single-cell sequencing data",
  "source": "https://github.com/COMBINE-lab/alevin-fry",
  "checks": [
    {
      "type": "binary",
      "name": "alevin-fry"
    }
  ],
  "install_guidance": {
    "plugin": "alevin-fry",
    "binary": "alevin-fry",
    "check": "which alevin-fry",
    "install_steps": [
      "cargo install alevin-fry",
      "Verify: alevin-fry --version",
      "supercli plugins install ./plugins/alevin-fry --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "alevin-fry",
      "resource": "self",
      "action": "version",
      "description": "Print alevin-fry version",
      "adapter": "process",
      "adapterConfig": {
        "command": "alevin-fry",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install alevin-fry: cargo install alevin-fry"
      },
      "args": []
    },
    {
      "namespace": "alevin-fry",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to alevin-fry CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "alevin-fry",
        "passthrough": true,
        "missingDependencyHelp": "Install alevin-fry"
      },
      "args": []
    }
  ]
}