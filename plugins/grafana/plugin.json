{
  "name": "grafana",
  "version": "1.0.0",
  "description": "grafana \u2014 Metrics dashboard",
  "source": "grafana.com",
  "checks": [
    {
      "type": "binary",
      "name": "grafana"
    }
  ],
  "install_guidance": {
    "plugin": "grafana",
    "binary": "grafana",
    "check": "which grafana",
    "install_steps": [
      "# Install grafana",
      "# See grafana.com",
      "# apt: sudo apt-get install grafana",
      "# brew: brew install grafana",
      "# cargo: cargo install grafana",
      "# npm: npm install -g grafana",
      "# pip: pip install grafana"
    ]
  },
  "commands": [
    {
      "namespace": "grafana",
      "resource": "grafana",
      "action": "run",
      "description": "Run grafana",
      "adapter": "process",
      "adapterConfig": {
        "command": "grafana",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install grafana from grafana.com"
      },
      "args": []
    }
  ]
}