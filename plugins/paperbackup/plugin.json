{
  "name": "paperbackup",
  "version": "0.1.0",
  "description": "Create a PDF with barcodes to backup text files on paper.",
  "source": "https://github.com/intra2net/paperbackup",
  "checks": [
    {
      "type": "binary",
      "name": "paperbackup"
    }
  ],
  "install_guidance": {
    "plugin": "paperbackup",
    "binary": "paperbackup",
    "check": "which paperbackup",
    "install_steps": [
      "See https://github.com/intra2net/paperbackup",
      "Verify: paperbackup --version",
      "supercli plugins install ./plugins/paperbackup --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "paperbackup",
      "resource": "self",
      "action": "version",
      "description": "Print paperbackup version",
      "adapter": "process",
      "adapterConfig": {
        "command": "paperbackup",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install paperbackup: See https://github.com/intra2net/paperbackup"
      },
      "args": []
    },
    {
      "namespace": "paperbackup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to paperbackup CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "paperbackup",
        "passthrough": true,
        "missingDependencyHelp": "Install paperbackup"
      },
      "args": []
    }
  ]
}