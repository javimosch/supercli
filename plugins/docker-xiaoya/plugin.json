{
  "name": "docker-xiaoya",
  "version": "0.1.0",
  "description": "\ud83d\udca1 Use Docker Compose to deploy Xiaoya services in a more elegant way, supports one-click deployment ",
  "source": "https://github.com/docker-xiaoya/docker-xiaoya",
  "checks": [
    {
      "type": "binary",
      "name": "docker-xiaoya"
    }
  ],
  "install_guidance": {
    "plugin": "docker-xiaoya",
    "binary": "docker-xiaoya",
    "check": "which docker-xiaoya",
    "install_steps": [
      "pip install docker-xiaoya",
      "Verify: docker-xiaoya --version",
      "supercli plugins install ./plugins/docker-xiaoya --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "docker-xiaoya",
      "resource": "self",
      "action": "version",
      "description": "Print docker-xiaoya version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-xiaoya",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-xiaoya: pip install docker-xiaoya"
      },
      "args": []
    },
    {
      "namespace": "docker-xiaoya",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-xiaoya CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-xiaoya",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-xiaoya: pip install docker-xiaoya"
      },
      "args": []
    }
  ]
}