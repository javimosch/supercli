{
  "name": "ximtoppm",
  "version": "0.1.0",
  "description": "CLI tool: ximtoppm",
  "source": "https://manpages.debian.org/ximtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "ximtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "ximtoppm",
    "binary": "ximtoppm",
    "check": "which ximtoppm",
    "install_steps": [
      "apt-get install ximtoppm 2>/dev/null || which ximtoppm",
      "Verify: ximtoppm --version",
      "supercli plugins install ./plugins/ximtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ximtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print ximtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ximtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ximtoppm: apt-get install ximtoppm 2>/dev/null || which ximtoppm"
      },
      "args": []
    },
    {
      "namespace": "ximtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ximtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ximtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ximtoppm: apt-get install ximtoppm 2>/dev/null || which ximtoppm"
      },
      "args": []
    }
  ]
}