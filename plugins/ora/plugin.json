{
  "name": "ora",
  "version": "0.1.0",
  "description": "Elegant terminal spinner with promise support",
  "source": "https://github.com/sindresorhus/ora",
  "checks": [{ "type": "binary", "name": "ora" }],
  "install_guidance": {
    "plugin": "ora",
    "binary": "ora",
    "check": "which ora",
    "install_steps": ["npm install -g ora-cli", "Verify: ora --version", "supercli plugins install ./plugins/ora --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ora",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ora CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ora",
      "passthrough": true,
      "missingDependencyHelp": "Install ora: npm install -g ora-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
