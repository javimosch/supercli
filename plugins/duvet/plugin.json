{
  "name": "duvet",
  "version": "0.1.0",
  "description": "HTTP load testing tool written in Rust with report generation",
  "source": "https://github.com/search/duvet",
  "checks": [{ "type": "binary", "name": "duvet" }],
  "install_guidance": {
    "plugin": "duvet",
    "binary": "duvet",
    "check": "which duvet",
    "install_steps": ["cargo install duvet", "Verify: duvet --version", "supercli plugins install ./plugins/duvet --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "duvet",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to duvet CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "duvet",
      "passthrough": true,
      "missingDependencyHelp": "Install duvet: cargo install duvet"
    },
    "args": []
  }]
}
