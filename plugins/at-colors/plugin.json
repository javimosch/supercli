{
  "name": "at-colors",
  "version": "0.1.0",
  "description": "CLI tool: at-colors",
  "source": "https://packages.debian.org/at-colors",
  "checks": [{ "type": "binary", "name": "at-colors" }],
  "install_guidance": {
    "plugin": "at-colors", "binary": "at-colors", "check": "which at-colors",
    "install_steps": ["apt-get install at-colors 2>/dev/null || which at-colors", "Verify: at-colors --version", "supercli plugins install ./plugins/at-colors --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-colors", "resource": "_", "action": "_",
    "description": "Passthrough to at-colors CLI",
    "adapter": "process", "adapterConfig": { "command": "at-colors", "passthrough": true, "missingDependencyHelp": "Install at-colors: apt-get install at-colors" }, "args": []
  }]
}
