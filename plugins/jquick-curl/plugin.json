{
  "name": "jquick-curl",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/jquick-curl/jquick-curl",
  "checks": [
    {
      "type": "binary",
      "name": "jquick-curl"
    }
  ],
  "install_guidance": {
    "plugin": "jquick-curl",
    "binary": "jquick-curl",
    "check": "which jquick-curl",
    "install_steps": [
      "pip install jquick-curl",
      "Verify: jquick-curl --version",
      "supercli plugins install ./plugins/jquick-curl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jquick-curl",
      "resource": "self",
      "action": "version",
      "description": "Print jquick-curl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jquick-curl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jquick-curl: pip install jquick-curl"
      },
      "args": []
    },
    {
      "namespace": "jquick-curl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jquick-curl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jquick-curl",
        "passthrough": true,
        "missingDependencyHelp": "Install jquick-curl: pip install jquick-curl"
      },
      "args": []
    }
  ]
