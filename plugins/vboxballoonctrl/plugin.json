{
  "name": "vboxballoonctrl",
  "version": "0.1.0",
  "description": "CLI tool: vboxballoonctrl",
  "source": "https://manpages.debian.org/vboxballoonctrl",
  "checks": [
    {
      "type": "binary",
      "name": "vboxballoonctrl"
    }
  ],
  "install_guidance": {
    "plugin": "vboxballoonctrl",
    "binary": "vboxballoonctrl",
    "check": "which vboxballoonctrl",
    "install_steps": [
      "apt-get install vboxballoonctrl 2>/dev/null || which vboxballoonctrl",
      "Verify: vboxballoonctrl --version",
      "supercli plugins install ./plugins/vboxballoonctrl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vboxballoonctrl",
      "resource": "self",
      "action": "version",
      "description": "Print vboxballoonctrl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vboxballoonctrl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vboxballoonctrl: apt-get install vboxballoonctrl 2>/dev/null || which vboxballoonctrl"
      },
      "args": []
    },
    {
      "namespace": "vboxballoonctrl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vboxballoonctrl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vboxballoonctrl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vboxballoonctrl: apt-get install vboxballoonctrl 2>/dev/null || which vboxballoonctrl"
      },
      "args": []
    }
  ]
}