{
  "name": "diffr",
  "version": "1.0.0",
  "description": "diffr \u2014 Diff highlighter",
  "source": "github.com/wezm/diffr",
  "checks": [
    {
      "type": "binary",
      "name": "diffr"
    }
  ],
  "install_guidance": {
    "plugin": "diffr",
    "binary": "diffr",
    "check": "which diffr",
    "install_steps": [
      "# Install diffr",
      "# See github.com/wezm/diffr",
      "# apt: sudo apt-get install diffr",
      "# brew: brew install diffr",
      "# cargo: cargo install diffr",
      "# npm: npm install -g diffr",
      "# pip: pip install diffr"
    ]
  },
  "commands": [
    {
      "namespace": "diffr",
      "resource": "diffr",
      "action": "run",
      "description": "Run diffr",
      "adapter": "process",
      "adapterConfig": {
        "command": "diffr",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install diffr from github.com/wezm/diffr"
      },
      "args": []
    }
  ]
}