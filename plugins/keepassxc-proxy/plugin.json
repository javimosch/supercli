{
  "name": "keepassxc-proxy",
  "version": "0.1.0",
  "description": "CLI tool: keepassxc-proxy",
  "source": "https://manpages.debian.org/keepassxc-proxy",
  "checks": [
    {
      "type": "binary",
      "name": "keepassxc-proxy"
    }
  ],
  "install_guidance": {
    "plugin": "keepassxc-proxy",
    "binary": "keepassxc-proxy",
    "check": "which keepassxc-proxy",
    "install_steps": [
      "apt-get install keepassxc-proxy 2>/dev/null || which keepassxc-proxy",
      "Verify: keepassxc-proxy --version",
      "supercli plugins install ./plugins/keepassxc-proxy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "keepassxc-proxy",
      "resource": "self",
      "action": "version",
      "description": "Print keepassxc-proxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "keepassxc-proxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install keepassxc-proxy: apt-get install keepassxc-proxy 2>/dev/null || which keepassxc-proxy"
      },
      "args": []
    },
    {
      "namespace": "keepassxc-proxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to keepassxc-proxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "keepassxc-proxy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install keepassxc-proxy: apt-get install keepassxc-proxy 2>/dev/null || which keepassxc-proxy"
      },
      "args": []
    }
  ]
}