{
  "name": "lpadmin",
  "version": "0.1.0",
  "description": "CUPS printer administration",
  "source": "https://packages.debian.org/lpadmin",
  "checks": [{ "type": "binary", "name": "lpadmin" }],
  "install_guidance": {
    "plugin": "lpadmin", "binary": "lpadmin", "check": "which lpadmin",
    "install_steps": ["apt-get install cups", "Verify: lpadmin --version", "supercli plugins install ./plugins/lpadmin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lpadmin", "resource": "_", "action": "_",
    "description": "Passthrough to lpadmin CLI",
    "adapter": "process", "adapterConfig": { "command": "lpadmin", "passthrough": true, "missingDependencyHelp": "Install lpadmin: apt-get install cups" }, "args": []
  }]
}
