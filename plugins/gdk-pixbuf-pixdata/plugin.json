{
  "name": "gdk-pixbuf-pixdata",
  "version": "0.1.0",
  "description": "CLI tool: gdk-pixbuf-pixdata",
  "source": "https://manpages.debian.org/gdk-pixbuf-pixdata",
  "checks": [
    {
      "type": "binary",
      "name": "gdk-pixbuf-pixdata"
    }
  ],
  "install_guidance": {
    "plugin": "gdk-pixbuf-pixdata",
    "binary": "gdk-pixbuf-pixdata",
    "check": "which gdk-pixbuf-pixdata",
    "install_steps": [
      "apt-get install gdk-pixbuf-pixdata 2>/dev/null || which gdk-pixbuf-pixdata",
      "Verify: gdk-pixbuf-pixdata --version",
      "supercli plugins install ./plugins/gdk-pixbuf-pixdata --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gdk-pixbuf-pixdata",
      "resource": "self",
      "action": "version",
      "description": "Print gdk-pixbuf-pixdata version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdk-pixbuf-pixdata",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gdk-pixbuf-pixdata: apt-get install gdk-pixbuf-pixdata 2>/dev/null || which gdk-pixbuf-pixdata"
      },
      "args": []
    },
    {
      "namespace": "gdk-pixbuf-pixdata",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gdk-pixbuf-pixdata CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gdk-pixbuf-pixdata",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gdk-pixbuf-pixdata: apt-get install gdk-pixbuf-pixdata 2>/dev/null || which gdk-pixbuf-pixdata"
      },
      "args": []
    }
  ]
}