{
  "plugin": "thin_check",
  "binary": "thin_check",
  "check": "which thin_check",
  "install_steps": [
    "apt-get install thin_check 2>/dev/null || which thin_check",
    "Verify: thin_check --version",
    "supercli plugins install ./plugins/thin_check --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}