{
  "name": "Peekaboo",
  "version": "0.1.0",
  "description": "Peekaboo is a macOS CLI & optional MCP server that enables AI agents to capture screenshots of appli",
  "source": "https://github.com/Peekaboo/Peekaboo",
  "checks": [
    {
      "type": "binary",
      "name": "peekaboo"
    }
  ],
  "install_guidance": {
    "plugin": "Peekaboo",
    "binary": "peekaboo",
    "check": "which peekaboo",
    "install_steps": [
      "pip install peekaboo",
      "Verify: peekaboo --version",
      "supercli plugins install ./plugins/Peekaboo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Peekaboo",
      "resource": "self",
      "action": "version",
      "description": "Print Peekaboo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "peekaboo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Peekaboo: pip install peekaboo"
      },
      "args": []
    },
    {
      "namespace": "Peekaboo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to peekaboo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "peekaboo",
        "passthrough": true,
        "missingDependencyHelp": "Install Peekaboo: pip install peekaboo"
      },
      "args": []
    }
  ]
}