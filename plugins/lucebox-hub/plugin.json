{
  "name": "lucebox-hub",
  "version": "0.1.0",
  "description": "Fast LLM speculative inference server for consumer hardware.",
  "source": "https://github.com/lucebox-hub/lucebox-hub",
  "checks": [
    {
      "type": "binary",
      "name": "lucebox-hub"
    }
  ],
  "install_guidance": {
    "plugin": "lucebox-hub",
    "binary": "lucebox-hub",
    "check": "which lucebox-hub",
    "install_steps": [
      "pip install lucebox-hub",
      "Verify: lucebox-hub --version",
      "supercli plugins install ./plugins/lucebox-hub --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lucebox-hub",
      "resource": "self",
      "action": "version",
      "description": "Print lucebox-hub version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lucebox-hub",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lucebox-hub: pip install lucebox-hub"
      },
      "args": []
    },
    {
      "namespace": "lucebox-hub",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lucebox-hub CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lucebox-hub",
        "passthrough": true,
        "missingDependencyHelp": "Install lucebox-hub: pip install lucebox-hub"
      },
      "args": []
    }
  ]
}