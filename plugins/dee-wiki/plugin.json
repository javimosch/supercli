{
  "name": "dee-wiki",
  "version": "0.1.0",
  "description": "Search Wikipedia from the command line with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-wiki" }],
  "install_guidance": {
    "plugin": "dee-wiki",
    "binary": "dee-wiki",
    "check": "which dee-wiki",
    "install_steps": ["cargo install dee-wiki", "Verify: dee-wiki --version", "supercli plugins install ./plugins/dee-wiki --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-wiki",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-wiki CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-wiki",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-wiki: cargo install dee-wiki"
    },
    "args": []
  }]
}
