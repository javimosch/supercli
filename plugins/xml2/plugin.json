{
  "name": "xml2",
  "version": "0.1.0",
  "description": "Convert XML to line-based flat format",
  "source": "https://github.com/jlibb/xml2",
  "checks": [
    {
      "type": "binary",
      "name": "xml2"
    }
  ],
  "install_guidance": {
    "plugin": "xml2",
    "binary": "xml2",
    "check": "which xml2",
    "install_steps": [
      "brew install xml2",
      "Verify: xml2 --version",
      "supercli plugins install ./plugins/xml2 --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "xml2",
      "resource": "self",
      "action": "version",
      "description": "Print xml2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xml2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xml2: brew install xml2"
      },
      "args": []
    },
    {
      "namespace": "xml2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xml2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xml2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xml2: brew install xml2"
      },
      "args": []
    }
  ]
}
