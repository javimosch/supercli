{
  "name": "rstartd",
  "version": "0.1.0",
  "description": "CLI tool: rstartd",
  "source": "https://manpages.debian.org/rstartd",
  "checks": [
    {
      "type": "binary",
      "name": "rstartd"
    }
  ],
  "install_guidance": {
    "plugin": "rstartd",
    "binary": "rstartd",
    "check": "which rstartd",
    "install_steps": [
      "apt-get install rstartd 2>/dev/null || which rstartd",
      "Verify: rstartd --version",
      "supercli plugins install ./plugins/rstartd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rstartd",
      "resource": "self",
      "action": "version",
      "description": "Print rstartd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rstartd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rstartd: apt-get install rstartd 2>/dev/null || which rstartd"
      },
      "args": []
    },
    {
      "namespace": "rstartd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rstartd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rstartd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rstartd: apt-get install rstartd 2>/dev/null || which rstartd"
      },
      "args": []
    }
  ]
}