{
  "name": "rustnet",
  "version": "0.1.0",
  "description": "Per-process network monitoring for your terminal with deep packet inspection. Cross-platform, sandbo",
  "source": "https://github.com/rustnet/rustnet",
  "checks": [
    {
      "type": "binary",
      "name": "rustnet"
    }
  ],
  "install_guidance": {
    "plugin": "rustnet",
    "binary": "rustnet",
    "check": "which rustnet",
    "install_steps": [
      "pip install rustnet",
      "Verify: rustnet --version",
      "supercli plugins install ./plugins/rustnet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rustnet",
      "resource": "self",
      "action": "version",
      "description": "Print rustnet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rustnet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rustnet: pip install rustnet"
      },
      "args": []
    },
    {
      "namespace": "rustnet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rustnet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rustnet",
        "passthrough": true,
        "missingDependencyHelp": "Install rustnet: pip install rustnet"
      },
      "args": []
    }
  ]
}