{
  "name": "fz",
  "version": "0.1.0",
  "description": "Seamless fuzzy tab completion for z",
  "source": "https://github.com/changyuheng/fz.sh",
  "checks": [
    {
      "type": "binary",
      "name": "fz"
    }
  ],
  "install_guidance": {
    "plugin": "fz",
    "binary": "fz",
    "check": "which fz",
    "install_steps": [
      "See https://github.com/changyuheng/fz.sh",
      "Verify: fz --version",
      "supercli plugins install ./plugins/fz --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "fz",
      "resource": "self",
      "action": "version",
      "description": "Print fz version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fz",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fz: See https://github.com/changyuheng/fz.sh"
      },
      "args": []
    },
    {
      "namespace": "fz",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fz CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fz",
        "passthrough": true,
        "missingDependencyHelp": "Install fz"
      },
      "args": []
    }
  ]
}