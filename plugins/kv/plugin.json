{
  "name": "kv",
  "version": "0.1.0",
  "description": "Simple JSON key-value store with shell hooks for scripting",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "kv" }],
  "install_guidance": {
    "plugin": "kv",
    "binary": "kv",
    "check": "which kv",
    "install_steps": ["git clone && make", "Verify: kv --version", "supercli plugins install ./plugins/kv --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kv",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kv CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kv",
      "passthrough": true,
      "missingDependencyHelp": "Install kv: git clone && make"
    },
    "args": []
  }]
}
