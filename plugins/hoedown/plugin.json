{
  "name": "hoedown",
  "version": "0.1.0",
  "description": "Secure Markdown processing (a revived fork of Sundown)",
  "source": "https://github.com/hoedown/hoedown",
  "checks": [
    {
      "type": "binary",
      "name": "hoedown"
    }
  ],
  "install_guidance": {
    "plugin": "hoedown",
    "binary": "hoedown",
    "check": "which hoedown",
    "install_steps": [
      "brew install hoedown",
      "Verify: hoedown --version",
      "supercli plugins install ./plugins/hoedown --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hoedown",
      "resource": "self",
      "action": "version",
      "description": "Print hoedown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hoedown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hoedown: brew install hoedown"
      },
      "args": []
    },
    {
      "namespace": "hoedown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hoedown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hoedown",
        "passthrough": true,
        "missingDependencyHelp": "Install hoedown"
      },
      "args": []
    }
  ]
}