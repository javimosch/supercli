{
  "plugin": "k8tz",
  "binary": "k8tz",
  "check": "which k8tz",
  "install_steps": [
    "go install github.com/nicholasgasior/k8tz@latest",
    "Verify: k8tz --version",
    "supercli plugins install ./plugins/k8tz --on-conflict replace --json"
  ],
  "note": "Inject timezone configurations into Kubernetes pods."
}
