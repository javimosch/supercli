{
  "name": "mcbe-cli-launcher",
  "version": "0.1.0",
  "description": "CLI injector for Minecraft Bedrock Edition mod development",
  "source": "https://github.com/Aetopia/MCBE.CLI.Launcher",
  "checks": [{ "type": "binary", "name": "mcbe-cli-launcher" }],
  "install_guidance": {
    "plugin": "mcbe-cli-launcher",
    "binary": "mcbe-cli-launcher",
    "check": "which mcbe-cli-launcher",
    "install_steps": ["git clone and build", "Verify: mcbe-cli-launcher --version", "supercli plugins install ./plugins/mcbe-cli-launcher --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mcbe-cli-launcher",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mcbe-cli-launcher CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mcbe-cli-launcher",
      "passthrough": true,
      "missingDependencyHelp": "Install mcbe-cli-launcher: git clone and build", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
