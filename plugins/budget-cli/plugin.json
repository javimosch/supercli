{
  "name": "budget-cli",
  "version": "0.1.0",
  "description": "Import de-dupe and report on financial transactions",
  "source": "go",
  "checks": [{ "type": "binary", "name": "budget-cli" }],
  "install_guidance": {
    "plugin": "budget-cli",
    "binary": "budget-cli",
    "check": "which budget-cli",
    "install_steps": ["go install github.com/budget-cli@latest", "Verify: budget-cli --version", "supercli plugins install ./plugins/budget-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "budget-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to budget-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "budget-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install budget-cli: go install github.com/budget-cli@latest"
    },
    "args": []
  }]
}
