{
  "name": "bumpp",
  "version": "0.1.0",
  "description": "Interactive CLI that bumps your version numbers and more",
  "source": "https://github.com/antfu-collective/bumpp",
  "checks": [
    {
      "type": "binary",
      "name": "bumpp"
    }
  ],
  "install_guidance": {
    "plugin": "bumpp",
    "binary": "bumpp",
    "check": "which bumpp",
    "install_steps": [
      "brew install bumpp",
      "Verify: bumpp --version",
      "supercli plugins install ./plugins/bumpp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bumpp",
      "resource": "self",
      "action": "version",
      "description": "Print bumpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bumpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bumpp: brew install bumpp"
      },
      "args": []
    },
    {
      "namespace": "bumpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bumpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bumpp",
        "passthrough": true,
        "missingDependencyHelp": "Install bumpp"
      },
      "args": []
    }
  ]
}