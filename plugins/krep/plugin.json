{
  "name": "krep",
  "version": "0.1.0",
  "description": "Fast Text Search",
  "source": "https://github.com/davidesantangelo/krep",
  "checks": [
    { "type": "binary", "name": "krep" }
  ],
  "install_guidance": {
    "plugin": "krep",
    "binary": "krep",
    "check": "which krep",
    "install_steps": [
      "brew install krep",
      "Verify: krep --version",
      "supercli plugins install ./plugins/krep --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "krep",
      "resource": "self",
      "action": "version",
      "description": "Print krep version",
      "adapter": "process",
      "adapterConfig": {
        "command": "krep",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install krep: brew install krep"
      },
      "args": []
    },
    {
      "namespace": "krep",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to krep CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "krep",
        "passthrough": true,
        "missingDependencyHelp": "Install krep"
      },
      "args": []
    }
  ]
}
