{
  "name": "shbin",
  "version": "0.1.0",
  "description": "Turn a Github repo into a pastebin",
  "source": "https://github.com/Shiphero/shbin/",
  "checks": [
    {
      "type": "binary",
      "name": "shbin"
    }
  ],
  "install_guidance": {
    "plugin": "shbin",
    "binary": "shbin",
    "check": "which shbin",
    "install_steps": [
      "See https://github.com/Shiphero/shbin/",
      "Verify: shbin --version",
      "supercli plugins install ./plugins/shbin --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "shbin",
      "resource": "self",
      "action": "version",
      "description": "Print shbin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shbin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shbin: See https://github.com/Shiphero/shbin/"
      },
      "args": []
    },
    {
      "namespace": "shbin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shbin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shbin",
        "passthrough": true,
        "missingDependencyHelp": "Install shbin"
      },
      "args": []
    }
  ]
}