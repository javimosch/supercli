{
  "name": "dee-feed",
  "version": "0.1.0",
  "description": "RSS/Atom feed reader for machine consumption with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-feed" }],
  "install_guidance": {
    "plugin": "dee-feed",
    "binary": "dee-feed",
    "check": "which dee-feed",
    "install_steps": ["cargo install dee-feed", "Verify: dee-feed --version", "supercli plugins install ./plugins/dee-feed --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-feed",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-feed CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-feed",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-feed: cargo install dee-feed"
    },
    "args": []
  }]
}
