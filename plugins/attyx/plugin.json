{
  "name": "attyx",
  "version": "0.1.0",
  "description": "Fast programmable GPU-accelerated terminal emulator built with Zig",
  "source": "https://github.com/attyx/attyx",
  "checks": [
    {
      "type": "binary",
      "name": "attyx"
    }
  ],
  "install_guidance": {
    "plugin": "attyx",
    "binary": "attyx",
    "check": "which attyx",
    "install_steps": [
      "pip install attyx",
      "Verify: attyx --version",
      "supercli plugins install ./plugins/attyx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "attyx",
      "resource": "self",
      "action": "version",
      "description": "Print attyx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "attyx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install attyx: pip install attyx"
      },
      "args": []
    },
    {
      "namespace": "attyx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to attyx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "attyx",
        "passthrough": true,
        "missingDependencyHelp": "Install attyx: pip install attyx"
      },
      "args": []
    }
  ]
}