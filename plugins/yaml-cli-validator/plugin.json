{
  "name": "yaml-cli-validator",
  "version": "0.1.0",
  "description": "YAML file structure validator, meant to be used as a part of CI pipelines",
  "source": "https://github.com/yaml-cli-validator/yaml-cli-validator",
  "checks": [
    {
      "type": "binary",
      "name": "yaml-cli-validator"
    }
  ],
  "install_guidance": {
    "plugin": "yaml-cli-validator",
    "binary": "yaml-cli-validator",
    "check": "which yaml-cli-validator",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: yaml-cli-validator --version",
      "supercli plugins install ./plugins/yaml-cli-validator --on-conflict replace --json"
    ],
    "note": "TypeScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "yaml-cli-validator",
      "resource": "self",
      "action": "version",
      "description": "Print yaml-cli-validator version",
      "adapter": "process",
      "adapterConfig": {
        "command": "yaml-cli-validator",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install yaml-cli-validator from project repository"
      },
      "args": []
    },
    {
      "namespace": "yaml-cli-validator",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to yaml-cli-validator CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "yaml-cli-validator",
        "passthrough": true,
        "missingDependencyHelp": "Install yaml-cli-validator from project repository"
      },
      "args": []
    }
  ]
}