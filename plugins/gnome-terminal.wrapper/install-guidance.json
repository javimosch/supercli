{
  "plugin": "gnome-terminal.wrapper",
  "binary": "gnome-terminal.wrapper",
  "check": "which gnome-terminal.wrapper",
  "install_steps": [
    "apt-get install gnome-terminal.wrapper 2>/dev/null || which gnome-terminal.wrapper",
    "Verify: gnome-terminal.wrapper --version",
    "supercli plugins install ./plugins/gnome-terminal.wrapper --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}