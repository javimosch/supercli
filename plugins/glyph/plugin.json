{
  "name": "glyph",
  "version": "0.1.0",
  "description": "convert images, video to ascii!",
  "source": "https://github.com/glyph/glyph",
  "checks": [
    {
      "type": "binary",
      "name": "glyph"
    }
  ],
  "install_guidance": {
    "plugin": "glyph",
    "binary": "glyph",
    "check": "which glyph",
    "install_steps": [
      "pip install glyph",
      "Verify: glyph --version",
      "supercli plugins install ./plugins/glyph --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "glyph",
      "resource": "self",
      "action": "version",
      "description": "Print glyph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glyph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install glyph: pip install glyph"
      },
      "args": []
    },
    {
      "namespace": "glyph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glyph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glyph",
        "passthrough": true,
        "missingDependencyHelp": "Install glyph: pip install glyph"
      },
      "args": []
    }
  ]
}