{
  "name": "recode-sr-latin",
  "version": "0.1.0",
  "description": "CLI tool: recode-sr-latin",
  "source": "https://manpages.debian.org/recode-sr-latin",
  "checks": [
    {
      "type": "binary",
      "name": "recode-sr-latin"
    }
  ],
  "install_guidance": {
    "plugin": "recode-sr-latin",
    "binary": "recode-sr-latin",
    "check": "which recode-sr-latin",
    "install_steps": [
      "apt-get install recode-sr-latin 2>/dev/null || which recode-sr-latin",
      "Verify: recode-sr-latin --version",
      "supercli plugins install ./plugins/recode-sr-latin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "recode-sr-latin",
      "resource": "self",
      "action": "version",
      "description": "Print recode-sr-latin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "recode-sr-latin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install recode-sr-latin: apt-get install recode-sr-latin 2>/dev/null || which recode-sr-latin"
      },
      "args": []
    },
    {
      "namespace": "recode-sr-latin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to recode-sr-latin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "recode-sr-latin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install recode-sr-latin: apt-get install recode-sr-latin 2>/dev/null || which recode-sr-latin"
      },
      "args": []
    }
  ]
}