{
  "name": "cssnano",
  "version": "0.1.0",
  "description": "CSS optimizer using PostCSS",
  "source": "https://github.com/cssnano/cssnano",
  "checks": [
    {
      "type": "binary",
      "name": "cssnano"
    }
  ],
  "install_guidance": {
    "plugin": "cssnano",
    "binary": "cssnano",
    "check": "which cssnano",
    "install_steps": [
      "npm install -g cssnano",
      "Verify: cssnano --version",
      "supercli plugins install ./plugins/cssnano --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "cssnano",
      "resource": "self",
      "action": "version",
      "description": "Print cssnano version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cssnano",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cssnano: npm install -g cssnano"
      },
      "args": []
    },
    {
      "namespace": "cssnano",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cssnano CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cssnano",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install cssnano: npm install -g cssnano"
      },
      "args": []
    }
  ]
}
