{
  "name": "edit",
  "version": "0.1.0",
  "description": "We all edit.",
  "source": "https://github.com/edit/edit",
  "checks": [
    {
      "type": "binary",
      "name": "edit"
    }
  ],
  "install_guidance": {
    "plugin": "edit",
    "binary": "edit",
    "check": "which edit",
    "install_steps": [
      "pip install edit",
      "Verify: edit --version",
      "supercli plugins install ./plugins/edit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
