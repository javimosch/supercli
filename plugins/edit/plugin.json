      "adapter": "process",
      "adapterConfig": {
        "command": "edit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install edit: pip install edit"
      },
      "args": []
    },
    {
      "namespace": "edit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to edit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "edit",
        "passthrough": true,
        "missingDependencyHelp": "Install edit: pip install edit"
      },
      "args": []
    }
  ]
}