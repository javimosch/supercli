{
  "name": "wx_channels_download",
  "version": "0.1.0",
  "description": "\u5fae\u4fe1\u89c6\u9891\u53f7\u4e0b\u8f7d\u5668",
  "source": "https://github.com/wx_channels_download/wx_channels_download",
  "checks": [
    {
      "type": "binary",
      "name": "wx-channels-download"
    }
  ],
  "install_guidance": {
    "plugin": "wx_channels_download",
    "binary": "wx-channels-download",
    "check": "which wx-channels-download",
    "install_steps": [
      "pip install wx-channels-download",
      "Verify: wx-channels-download --version",
      "supercli plugins install ./plugins/wx_channels_download --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wx_channels_download",
      "resource": "self",
      "action": "version",
      "description": "Print wx_channels_download version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wx-channels-download",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wx_channels_download: pip install wx-channels-download"
      },
      "args": []
    },
    {
      "namespace": "wx_channels_download",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wx-channels-download CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wx-channels-download",
        "passthrough": true,
        "missingDependencyHelp": "Install wx_channels_download: pip install wx-channels-download"
      },
      "args": []
    }
  ]
}