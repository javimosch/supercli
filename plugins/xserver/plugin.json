{
  "name": "xserver",
  "version": "0.1.0",
  "description": "XLibre Xserver",
  "source": "https://github.com/xserver/xserver",
  "checks": [
    {
      "type": "binary",
      "name": "xserver"
    }
  ],
  "install_guidance": {
    "plugin": "xserver",
    "binary": "xserver",
    "check": "which xserver",
    "install_steps": [
      "pip install xserver",
      "Verify: xserver --version",
      "supercli plugins install ./plugins/xserver --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xserver",
      "resource": "self",
      "action": "version",
      "description": "Print xserver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xserver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xserver: pip install xserver"
      },
      "args": []
    },
    {
      "namespace": "xserver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xserver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xserver",
        "passthrough": true,
        "missingDependencyHelp": "Install xserver: pip install xserver"
      },
      "args": []
    }
  ]
}