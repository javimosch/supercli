{
  "name": "ps2pdf13",
  "version": "0.1.0",
  "description": "CLI tool: ps2pdf13",
  "source": "https://manpages.debian.org/ps2pdf13",
  "checks": [
    {
      "type": "binary",
      "name": "ps2pdf13"
    }
  ],
  "install_guidance": {
    "plugin": "ps2pdf13",
    "binary": "ps2pdf13",
    "check": "which ps2pdf13",
    "install_steps": [
      "apt-get install ps2pdf13 2>/dev/null || which ps2pdf13",
      "Verify: ps2pdf13 --version",
      "supercli plugins install ./plugins/ps2pdf13 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ps2pdf13",
      "resource": "self",
      "action": "version",
      "description": "Print ps2pdf13 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps2pdf13",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ps2pdf13: apt-get install ps2pdf13 2>/dev/null || which ps2pdf13"
      },
      "args": []
    },
    {
      "namespace": "ps2pdf13",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ps2pdf13 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps2pdf13",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ps2pdf13: apt-get install ps2pdf13 2>/dev/null || which ps2pdf13"
      },
      "args": []
    }
  ]
}