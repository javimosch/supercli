{
  "name": "render-cli",
  "version": "0.1.0",
  "description": "Render CLI for cloud application deployment",
  "source": "https",
  "checks": [{"type": "binary", "name": "render"}],
  "install_guidance": {
    "plugin": "render-cli",
    "binary": "render",
    "check": "which render",
    "install_steps": [
      "brew install render-cli",
      "Verify: render --version",
      "supercli plugins install ./plugins/render-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "render-cli",
      "resource": "self",
      "action": "version",
      "description": "Print render-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "render", "baseArgs": ["--version"], "missingDependencyHelp": "Install render-cli: brew install render-cli"},
      "args": []
    },
    {
      "namespace": "render-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to render CLI",
      "adapter": "process",
      "adapterConfig": {"command": "render", "passthrough": true, "missingDependencyHelp": "Install render-cli: brew install render-cli"},
      "args": []
    }
  ]
}
