{
  "name": "cgsnapshot",
  "version": "0.1.0",
  "description": "generate the configuration file for given controllers (cgroup-tools)",
  "source": "https://packages.debian.org/cgsnapshot",
  "checks": [{ "type": "binary", "name": "cgsnapshot" }],
  "install_guidance": {
    "plugin": "cgsnapshot", "binary": "cgsnapshot", "check": "which cgsnapshot",
    "install_steps": ["apt-get install cgsnapshot 2>/dev/null || which cgsnapshot", "Verify: cgsnapshot --version", "supercli plugins install ./plugins/cgsnapshot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cgsnapshot", "resource": "_", "action": "_",
    "description": "Passthrough to cgsnapshot CLI",
    "adapter": "process", "adapterConfig": { "command": "cgsnapshot", "passthrough": true, "missingDependencyHelp": "Install cgsnapshot: apt-get install cgsnapshot" }, "args": []
  }]
}
