{
  "name": "KuiklyUI",
  "version": "0.1.0",
  "description": "A Kotlin Multiplatform UI framework from Tencent TDS \u2014 high-performance, one codebase for six platfo",
  "source": "https://github.com/KuiklyUI/KuiklyUI",
  "checks": [
    {
      "type": "binary",
      "name": "kuiklyui"
    }
  ],
  "install_guidance": {
    "plugin": "KuiklyUI",
    "binary": "kuiklyui",
    "check": "which kuiklyui",
    "install_steps": [
      "pip install kuiklyui",
      "Verify: kuiklyui --version",
      "supercli plugins install ./plugins/KuiklyUI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "KuiklyUI",
      "resource": "self",
      "action": "version",
      "description": "Print KuiklyUI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuiklyui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install KuiklyUI: pip install kuiklyui"
      },
      "args": []
    },
    {
      "namespace": "KuiklyUI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kuiklyui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kuiklyui",
        "passthrough": true,
        "missingDependencyHelp": "Install KuiklyUI: pip install kuiklyui"
      },
      "args": []
    }
  ]
}