{
  "name": "beachball",
  "version": "0.1.0",
  "description": "Semantic versioning and changelog tool for monorepos",
  "source": "https://github.com/microsoft/beachball",
  "checks": [{ "type": "binary", "name": "beachball" }],
  "install_guidance": {
    "plugin": "beachball",
    "binary": "beachball",
    "check": "which beachball",
    "install_steps": ["npm install -g beachball", "Verify: beachball --version", "supercli plugins install ./plugins/beachball --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "beachball",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to beachball CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "beachball",
      "passthrough": true,
      "missingDependencyHelp": "Install beachball: npm install -g beachball", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
