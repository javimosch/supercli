{
  "name": "ironclaw",
  "version": "0.1.0",
  "description": "IronClaw is an Agent OS focused on privacy, security and extensibility",
  "source": "https://github.com/ironclaw/ironclaw",
  "checks": [
    {
      "type": "binary",
      "name": "ironclaw"
    }
  ],
  "install_guidance": {
    "plugin": "ironclaw",
    "binary": "ironclaw",
    "check": "which ironclaw",
    "install_steps": [
      "pip install ironclaw",
      "Verify: ironclaw --version",
      "supercli plugins install ./plugins/ironclaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ironclaw",
      "resource": "self",
      "action": "version",
      "description": "Print ironclaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ironclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ironclaw: pip install ironclaw"
      },
      "args": []
    },
    {
      "namespace": "ironclaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ironclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ironclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install ironclaw: pip install ironclaw"
      },
      "args": []
    }
  ]
}