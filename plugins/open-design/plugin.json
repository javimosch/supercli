{
  "name": "open-design",
  "version": "0.1.0",
  "description": "\ud83c\udfa8 Local-first, open-source Claude Design alternative. \ud83d\udda5\ufe0f Native desktop app. \u26a1 259+ Skills \u00b7 \u2728 142+ ",
  "source": "https://github.com/open-design/open-design",
  "checks": [
    {
      "type": "binary",
      "name": "open-design"
    }
  ],
  "install_guidance": {
    "plugin": "open-design",
    "binary": "open-design",
    "check": "which open-design",
    "install_steps": [
      "pip install open-design",
      "Verify: open-design --version",
      "supercli plugins install ./plugins/open-design --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "open-design",
      "resource": "self",
      "action": "version",
      "description": "Print open-design version",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-design",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install open-design: pip install open-design"
      },
      "args": []
    },
    {
      "namespace": "open-design",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to open-design CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-design",
        "passthrough": true,
        "missingDependencyHelp": "Install open-design: pip install open-design"
      },
      "args": []
    }
  ]
}