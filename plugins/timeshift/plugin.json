{
  "name": "timeshift",
  "version": "0.1.0",
  "description": "System restore and backup tool",
  "source": "https://packages.debian.org/timeshift",
  "checks": [{ "type": "binary", "name": "timeshift" }],
  "install_guidance": {
    "plugin": "timeshift", "binary": "timeshift", "check": "which timeshift",
    "install_steps": ["apt-get install timeshift", "Verify: timeshift --version", "supercli plugins install ./plugins/timeshift --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "timeshift", "resource": "_", "action": "_",
    "description": "Passthrough to timeshift CLI",
    "adapter": "process", "adapterConfig": { "command": "timeshift", "passthrough": true, "missingDependencyHelp": "Install timeshift: apt-get install timeshift" }, "args": []
  }]
}
