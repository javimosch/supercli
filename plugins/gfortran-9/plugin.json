{
  "name": "gfortran-9",
  "version": "0.1.0",
  "description": "CLI tool: gfortran-9",
  "source": "https://manpages.debian.org/gfortran-9",
  "checks": [
    {
      "type": "binary",
      "name": "gfortran-9"
    }
  ],
  "install_guidance": {
    "plugin": "gfortran-9",
    "binary": "gfortran-9",
    "check": "which gfortran-9",
    "install_steps": [
      "apt-get install gfortran-9 2>/dev/null || which gfortran-9",
      "Verify: gfortran-9 --version",
      "supercli plugins install ./plugins/gfortran-9 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gfortran-9",
      "resource": "self",
      "action": "version",
      "description": "Print gfortran-9 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gfortran-9",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gfortran-9: apt-get install gfortran-9 2>/dev/null || which gfortran-9"
      },
      "args": []
    },
    {
      "namespace": "gfortran-9",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gfortran-9 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gfortran-9",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gfortran-9: apt-get install gfortran-9 2>/dev/null || which gfortran-9"
      },
      "args": []
    }
  ]
}