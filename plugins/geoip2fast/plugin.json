{
  "name": "geoip2fast",
  "version": "0.1.0",
  "description": "GeoIP2 country/ASN lookup tool",
  "source": "https://github.com/rabuchaim/geoip2fast",
  "checks": [
    {
      "type": "binary",
      "name": "geoip2fast"
    }
  ],
  "install_guidance": {
    "plugin": "geoip2fast",
    "binary": "geoip2fast",
    "check": "which geoip2fast",
    "install_steps": [
      "brew install geoip2fast",
      "Verify: geoip2fast --version",
      "supercli plugins install ./plugins/geoip2fast --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "geoip2fast",
      "resource": "self",
      "action": "version",
      "description": "Print geoip2fast version",
      "adapter": "process",
      "adapterConfig": {
        "command": "geoip2fast",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install geoip2fast: brew install geoip2fast"
      },
      "args": []
    },
    {
      "namespace": "geoip2fast",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to geoip2fast CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "geoip2fast",
        "passthrough": true,
        "missingDependencyHelp": "Install geoip2fast"
      },
      "args": []
    }
  ]
}