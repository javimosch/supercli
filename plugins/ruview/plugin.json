{
  "name": "ruview",
  "version": "0.1.0",
  "description": "Turns commodity WiFi signals into real-time spatial intelligence and presence detection",
  "source": "https://github.com/ruvnet/RuView",
  "checks": [
    {
      "type": "binary",
      "name": "ruview"
    }
  ],
  "install_guidance": {
    "plugin": "ruview",
    "binary": "ruview",
    "check": "which ruview",
    "install_steps": [
      "cargo install ruview",
      "Verify: ruview --version",
      "supercli plugins install ./plugins/ruview --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "ruview",
    "resource": "self",
    "action": "version",
    "description": "Print ruview version",
    "adapter": "process",
    "adapterConfig": {
      "command": "ruview",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install ruview: cargo install ruview"
    },
    "args": []
  },
  {
    "namespace": "ruview",
    "resource": "scan",
    "action": "start",
    "description": "Start WiFi spatial scanning",
    "adapter": "process",
    "adapterConfig": {
      "command": "ruview",
      "passthrough": true,
      "missingDependencyHelp": "Install ruview: cargo install ruview"
    },
    "args": []
  },
  {
    "namespace": "ruview",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ruview CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ruview",
      "passthrough": true,
      "missingDependencyHelp": "Install ruview"
    },
    "args": []
  }
]
}