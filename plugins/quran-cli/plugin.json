{
  "name": "quran-cli",
  "version": "0.1.0",
  "description": "Read the Quran directly in your terminal",
  "source": "https://github.com/ahmed-musallam/quran-cli",
  "checks": [{ "type": "binary", "name": "quran-cli" }],
  "install_guidance": {
    "plugin": "quran-cli",
    "binary": "quran-cli",
    "check": "which quran-cli",
    "install_steps": ["npm install -g quran-cli", "Verify: quran-cli --version", "supercli plugins install ./plugins/quran-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "quran-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to quran-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "quran-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install quran-cli: npm install -g quran-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
