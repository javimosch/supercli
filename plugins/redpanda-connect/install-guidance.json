{
  "plugin": "redpanda-connect",
  "binary": "redpanda-connect",
  "check": "which redpanda-connect",
  "install_steps": [
    "brew install redpanda-data/tap/redpanda-connect",
    "# or: go install github.com/redpanda-data/connect/v4/cmd/redpanda-connect@latest",
    "# or: download redpanda-connect-<ver>-linux-amd64.tar.gz from github.com/redpanda-data/connect/releases",
    "Verify: redpanda-connect --version",
    "supercli plugins install ./plugins/redpanda-connect --on-conflict replace --json"
  ],
  "note": "Formerly Benthos — the `benthos` binary was renamed `redpanda-connect` in v4. Docker image: docker.redpanda.com/redpandadata/connect. Also bundled inside the `rpk` CLI as `rpk connect`."
}
