{
  "name": "extensions-source",
  "version": "0.1.0",
  "description": "Source code of extensions in https://github.com/keiyoushi/extensions",
  "source": "https://github.com/extensions-source/extensions-source",
  "checks": [
    {
      "type": "binary",
      "name": "extensions-source"
    }
  ],
  "install_guidance": {
    "plugin": "extensions-source",
    "binary": "extensions-source",
    "check": "which extensions-source",
    "install_steps": [
      "pip install extensions-source",
      "Verify: extensions-source --version",
      "supercli plugins install ./plugins/extensions-source --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "extensions-source",
      "resource": "self",
      "action": "version",
      "description": "Print extensions-source version",
      "adapter": "process",
      "adapterConfig": {
        "command": "extensions-source",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install extensions-source: pip install extensions-source"
      },
      "args": []
    },
    {
      "namespace": "extensions-source",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to extensions-source CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "extensions-source",
        "passthrough": true,
        "missingDependencyHelp": "Install extensions-source: pip install extensions-source"
      },
      "args": []
    }
  ]
}