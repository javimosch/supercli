{
  "name": "ptcpdump",
  "version": "0.1.0",
  "description": "Process-aware, eBPF-based tcpdump",
  "source": "https://github.com/ptcpdump/ptcpdump",
  "checks": [
    {
      "type": "binary",
      "name": "ptcpdump"
    }
  ],
  "install_guidance": {
    "plugin": "ptcpdump",
    "binary": "ptcpdump",
    "check": "which ptcpdump",
    "install_steps": [
      "pip install ptcpdump",
      "Verify: ptcpdump --version",
      "supercli plugins install ./plugins/ptcpdump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ptcpdump",
      "resource": "self",
      "action": "version",
      "description": "Print ptcpdump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ptcpdump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ptcpdump: pip install ptcpdump"
      },
      "args": []
    },
    {
      "namespace": "ptcpdump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ptcpdump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ptcpdump",
        "passthrough": true,
        "missingDependencyHelp": "Install ptcpdump: pip install ptcpdump"
      },
      "args": []
    }
  ]
}