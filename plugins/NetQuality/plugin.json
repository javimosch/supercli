{
  "name": "NetQuality",
  "version": "0.1.0",
  "description": "\u7f51\u7edc\u8d28\u91cf\u68c0\u6d4b\u811a\u672c - Network Quality Check Script",
  "source": "https://github.com/NetQuality/NetQuality",
  "checks": [
    {
      "type": "binary",
      "name": "netquality"
    }
  ],
  "install_guidance": {
    "plugin": "NetQuality",
    "binary": "netquality",
    "check": "which netquality",
    "install_steps": [
      "pip install netquality",
      "Verify: netquality --version",
      "supercli plugins install ./plugins/NetQuality --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NetQuality",
      "resource": "self",
      "action": "version",
      "description": "Print NetQuality version",
      "adapter": "process",
      "adapterConfig": {
        "command": "netquality",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NetQuality: pip install netquality"
      },
      "args": []
    },
    {
      "namespace": "NetQuality",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to netquality CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "netquality",
        "passthrough": true,
        "missingDependencyHelp": "Install NetQuality: pip install netquality"
      },
      "args": []
    }
  ]
}