{
  "name": "nanobot",
  "version": "0.1.0",
  "description": "Lightweight, open-source AI agent for your tools, chats, and workflows.",
  "source": "https://github.com/nanobot/nanobot",
  "checks": [
    {
      "type": "binary",
      "name": "nanobot"
    }
  ],
  "install_guidance": {
    "plugin": "nanobot",
    "binary": "nanobot",
    "check": "which nanobot",
    "install_steps": [
      "pip install nanobot",
      "Verify: nanobot --version",
      "supercli plugins install ./plugins/nanobot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nanobot",
      "resource": "self",
      "action": "version",
      "description": "Print nanobot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanobot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nanobot: pip install nanobot"
      },
      "args": []
    },
    {
      "namespace": "nanobot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nanobot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nanobot",
        "passthrough": true,
        "missingDependencyHelp": "Install nanobot: pip install nanobot"
      },
      "args": []
    }
  ]
}