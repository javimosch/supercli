{
  "name": "telinit",
  "version": "0.1.0",
  "description": "CLI tool: telinit",
  "source": "https://manpages.debian.org/telinit",
  "checks": [
    {
      "type": "binary",
      "name": "telinit"
    }
  ],
  "install_guidance": {
    "plugin": "telinit",
    "binary": "telinit",
    "check": "which telinit",
    "install_steps": [
      "apt-get install telinit 2>/dev/null || which telinit",
      "Verify: telinit --version",
      "supercli plugins install ./plugins/telinit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "telinit",
      "resource": "self",
      "action": "version",
      "description": "Print telinit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "telinit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install telinit: apt-get install telinit 2>/dev/null || which telinit"
      },
      "args": []
    },
    {
      "namespace": "telinit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to telinit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "telinit",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install telinit: apt-get install telinit 2>/dev/null || which telinit"
      },
      "args": []
    }
  ]
}