{
  "name": "SmartCd",
  "version": "0.1.0",
  "description": "A cd command with improved usability features, which can remember your recently visited directory paths and, search and directly traverse to sub-directories and as well as parent directories, all with Fuzzy searching.",
  "source": "https://github.com/CodesOfRishi/smartcd",
  "checks": [
    {
      "type": "binary",
      "name": "SmartCd"
    }
  ],
  "install_guidance": {
    "plugin": "SmartCd",
    "binary": "SmartCd",
    "check": "which SmartCd",
    "install_steps": [
      "See https://github.com/CodesOfRishi/smartcd",
      "Verify: SmartCd --version",
      "supercli plugins install ./plugins/SmartCd --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "SmartCd",
      "resource": "self",
      "action": "version",
      "description": "Print SmartCd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "SmartCd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SmartCd: See https://github.com/CodesOfRishi/smartcd"
      },
      "args": []
    },
    {
      "namespace": "SmartCd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to SmartCd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "SmartCd",
        "passthrough": true,
        "missingDependencyHelp": "Install SmartCd"
      },
      "args": []
    }
  ]
}