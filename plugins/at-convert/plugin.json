{
  "name": "at-convert",
  "version": "0.1.0",
  "description": "CLI tool: at-convert",
  "source": "https://packages.debian.org/at-convert",
  "checks": [{ "type": "binary", "name": "at-convert" }],
  "install_guidance": {
    "plugin": "at-convert", "binary": "at-convert", "check": "which at-convert",
    "install_steps": ["apt-get install at-convert 2>/dev/null || which at-convert", "Verify: at-convert --version", "supercli plugins install ./plugins/at-convert --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-convert", "resource": "_", "action": "_",
    "description": "Passthrough to at-convert CLI",
    "adapter": "process", "adapterConfig": { "command": "at-convert", "passthrough": true, "missingDependencyHelp": "Install at-convert: apt-get install at-convert" }, "args": []
  }]
}
