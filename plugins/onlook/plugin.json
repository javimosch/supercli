{
  "name": "onlook",
  "version": "0.1.0",
  "description": "The Cursor for Designers \u2022 An Open-Source AI-First Design tool \u2022 Visually build, style, and edit you",
  "source": "https://github.com/onlook/onlook",
  "checks": [
    {
      "type": "binary",
      "name": "onlook"
    }
  ],
  "install_guidance": {
    "plugin": "onlook",
    "binary": "onlook",
    "check": "which onlook",
    "install_steps": [
      "pip install onlook",
      "Verify: onlook --version",
      "supercli plugins install ./plugins/onlook --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "onlook",
      "resource": "self",
      "action": "version",
      "description": "Print onlook version",
      "adapter": "process",
      "adapterConfig": {
        "command": "onlook",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install onlook: pip install onlook"
      },
      "args": []
    },
    {
      "namespace": "onlook",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to onlook CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "onlook",
        "passthrough": true,
        "missingDependencyHelp": "Install onlook: pip install onlook"
      },
      "args": []
    }
  ]
}