{
  "name": "qmlplugindump",
  "version": "0.1.0",
  "description": "CLI tool: qmlplugindump",
  "source": "https://manpages.debian.org/qmlplugindump",
  "checks": [
    {
      "type": "binary",
      "name": "qmlplugindump"
    }
  ],
  "install_guidance": {
    "plugin": "qmlplugindump",
    "binary": "qmlplugindump",
    "check": "which qmlplugindump",
    "install_steps": [
      "apt-get install qmlplugindump 2>/dev/null || which qmlplugindump",
      "Verify: qmlplugindump --version",
      "supercli plugins install ./plugins/qmlplugindump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmlplugindump",
      "resource": "self",
      "action": "version",
      "description": "Print qmlplugindump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlplugindump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmlplugindump: apt-get install qmlplugindump 2>/dev/null || which qmlplugindump"
      },
      "args": []
    },
    {
      "namespace": "qmlplugindump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmlplugindump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlplugindump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmlplugindump: apt-get install qmlplugindump 2>/dev/null || which qmlplugindump"
      },
      "args": []
    }
  ]
}