{
  "name": "vicinae",
  "version": "0.1.0",
  "description": "A focused launcher for your desktop - native, fast, extensible",
  "source": "https://github.com/vicinae/vicinae",
  "checks": [
    {
      "type": "binary",
      "name": "vicinae"
    }
  ],
  "install_guidance": {
    "plugin": "vicinae",
    "binary": "vicinae",
    "check": "which vicinae",
    "install_steps": [
      "pip install vicinae",
      "Verify: vicinae --version",
      "supercli plugins install ./plugins/vicinae --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vicinae",
      "resource": "self",
      "action": "version",
      "description": "Print vicinae version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vicinae",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vicinae: pip install vicinae"
      },
      "args": []
    },
    {
      "namespace": "vicinae",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vicinae CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vicinae",
        "passthrough": true,
        "missingDependencyHelp": "Install vicinae: pip install vicinae"
      },
      "args": []
    }
  ]
}