{
  "name": "vdirsyncer",
  "version": "0.1.0",
  "description": "CalDAV and CardDAV synchronization tool for calendars and contacts",
  "source": "https://github.com/pimutils/vdirsyncer",
  "checks": [
    {
      "type": "binary",
      "name": "vdirsyncer"
    }
  ],
  "install_guidance": {
    "plugin": "vdirsyncer",
    "binary": "vdirsyncer",
    "check": "which vdirsyncer",
    "install_steps": [
      "pip install vdirsyncer",
      "brew install vdirsyncer (macOS)",
      "apt-get install vdirsyncer (Debian/Ubuntu)",
      "sudo pacman -S vdirsyncer (Arch Linux)",
      "Verify: vdirsyncer --version"
    ],
    "note": "Requires a config file at ~/.vdirsyncer/config. Supports CalDAV (calendar) and CardDAV (contacts) protocols with bi-directional sync, conflict resolution, and metadata preservation."
  },
  "commands": [
    {
      "namespace": "vdirsyncer",
      "resource": "sync",
      "action": "run",
      "description": "Synchronize all configured pairs of storages",
      "adapter": "process",
      "adapterConfig": {
        "command": "vdirsyncer",
        "missingDependencyHelp": "Install: pip install vdirsyncer",
        "baseArgs": ["sync"]
      },
      "args": [
        {
          "name": "pair",
          "type": "string",
          "required": false,
          "description": "Only sync a specific pair by name"
        }
      ]
    },
    {
      "namespace": "vdirsyncer",
      "resource": "sync",
      "action": "discover",
      "description": "Discover new collections from CalDAV/CardDAV servers and update config",
      "adapter": "process",
      "adapterConfig": {
        "command": "vdirsyncer",
        "missingDependencyHelp": "Install: pip install vdirsyncer",
        "baseArgs": ["discover"]
      },
      "args": [
        {
          "name": "pair",
          "type": "string",
          "required": false,
          "description": "Only discover for a specific pair"
        }
      ]
    },
    {
      "namespace": "vdirsyncer",
      "resource": "sync",
      "action": "repair",
      "description": "Attempt to repair storage URLs that have changed on the server side",
      "adapter": "process",
      "adapterConfig": {
        "command": "vdirsyncer",
        "missingDependencyHelp": "Install: pip install vdirsyncer",
        "baseArgs": ["repair"]
      },
      "args": [
        {
          "name": "pair",
          "type": "string",
          "required": true,
          "description": "Pair name to repair"
        }
      ]
    },
    {
      "namespace": "vdirsyncer",
      "resource": "self",
      "action": "check",
      "description": "Validate the configuration file for errors",
      "adapter": "process",
      "adapterConfig": {
        "command": "vdirsyncer",
        "missingDependencyHelp": "Install: pip install vdirsyncer",
        "baseArgs": ["check"]
      },
      "args": []
    },
    {
      "namespace": "vdirsyncer",
      "resource": "self",
      "action": "version",
      "description": "Print vdirsyncer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vdirsyncer",
        "missingDependencyHelp": "Install: pip install vdirsyncer",
        "baseArgs": ["--version"]
      },
      "args": []
    },
    {
      "namespace": "vdirsyncer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vdirsyncer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vdirsyncer",
        "passthrough": true,
        "missingDependencyHelp": "Install: pip install vdirsyncer"
      },
      "args": []
    }
  ]
}
