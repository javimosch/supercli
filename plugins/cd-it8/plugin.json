{
  "name": "cd-it8",
  "version": "0.1.0",
  "description": "CLI tool: cd-it8",
  "source": "https://packages.debian.org/cd-it8",
  "checks": [{ "type": "binary", "name": "cd-it8" }],
  "install_guidance": {
    "plugin": "cd-it8", "binary": "cd-it8", "check": "which cd-it8",
    "install_steps": ["apt-get install cd-it8 2>/dev/null || which cd-it8", "Verify: cd-it8 --version", "supercli plugins install ./plugins/cd-it8 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cd-it8", "resource": "_", "action": "_",
    "description": "Passthrough to cd-it8 CLI",
    "adapter": "process", "adapterConfig": { "command": "cd-it8", "passthrough": true, "missingDependencyHelp": "Install cd-it8: apt-get install cd-it8" }, "args": []
  }]
}
