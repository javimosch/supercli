{
  "name": "libfyaml",
  "version": "0.1.0",
  "description": "Fully feature complete YAML parser and emitter",
  "source": "https://github.com/pantoniou/libfyaml",
  "checks": [
    {
      "type": "binary",
      "name": "libfyaml"
    }
  ],
  "install_guidance": {
    "plugin": "libfyaml",
    "binary": "libfyaml",
    "check": "which libfyaml",
    "install_steps": [
      "brew install libfyaml",
      "Verify: libfyaml --version",
      "supercli plugins install ./plugins/libfyaml --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libfyaml",
      "resource": "self",
      "action": "version",
      "description": "Print libfyaml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libfyaml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libfyaml: brew install libfyaml"
      },
      "args": []
    },
    {
      "namespace": "libfyaml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libfyaml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libfyaml",
        "passthrough": true,
        "missingDependencyHelp": "Install libfyaml"
      },
      "args": []
    }
  ]
}