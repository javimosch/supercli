{
  "name": "ghostling",
  "version": "0.1.0",
  "description": "A minimum viable terminal emulator built on top of the libghostty C API. Ex minimo, infinita nascunt",
  "source": "https://github.com/ghostling/ghostling",
  "checks": [
    {
      "type": "binary",
      "name": "ghostling"
    }
  ],
  "install_guidance": {
    "plugin": "ghostling",
    "binary": "ghostling",
    "check": "which ghostling",
    "install_steps": [
      "pip install ghostling",
      "Verify: ghostling --version",
      "supercli plugins install ./plugins/ghostling --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ghostling",
      "resource": "self",
      "action": "version",
      "description": "Print ghostling version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghostling",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ghostling: pip install ghostling"
      },
      "args": []
    },
    {
      "namespace": "ghostling",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ghostling CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghostling",
        "passthrough": true,
        "missingDependencyHelp": "Install ghostling: pip install ghostling"
      },
      "args": []
    }
  ]
}