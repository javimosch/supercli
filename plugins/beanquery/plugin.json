{
  "name": "beanquery",
  "version": "0.1.0",
  "description": "Customizable lightweight SQL query tool",
  "source": "https://github.com/beancount/beanquery",
  "checks": [
    {
      "type": "binary",
      "name": "beanquery"
    }
  ],
  "install_guidance": {
    "plugin": "beanquery",
    "binary": "beanquery",
    "check": "which beanquery",
    "install_steps": [
      "brew install beanquery",
      "Verify: beanquery --version",
      "supercli plugins install ./plugins/beanquery --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "beanquery",
      "resource": "self",
      "action": "version",
      "description": "Print beanquery version",
      "adapter": "process",
      "adapterConfig": {
        "command": "beanquery",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install beanquery: brew install beanquery"
      },
      "args": []
    },
    {
      "namespace": "beanquery",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to beanquery CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "beanquery",
        "passthrough": true,
        "missingDependencyHelp": "Install beanquery"
      },
      "args": []
    }
  ]
}