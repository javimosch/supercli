{
  "name": "khaos",
  "version": "0.1.0",
  "description": "Kafka traffic simulator for observability and chaos engineering",
  "source": "https://github.com/aleksandarskrbic/khaos",
  "checks": [
    {
      "type": "binary",
      "name": "khaos"
    }
  ],
  "install_guidance": {
    "plugin": "khaos",
    "binary": "khaos",
    "check": "which khaos",
    "install_steps": [
      "brew install khaos",
      "Verify: khaos --version",
      "supercli plugins install ./plugins/khaos --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "khaos",
      "resource": "self",
      "action": "version",
      "description": "Print khaos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "khaos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install khaos: brew install khaos"
      },
      "args": []
    },
    {
      "namespace": "khaos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to khaos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "khaos",
        "passthrough": true,
        "missingDependencyHelp": "Install khaos"
      },
      "args": []
    }
  ]
}