{
  "name": "terraform-docs",
  "version": "0.1.0",
  "description": "Generate documentation from Terraform modules in various formats",
  "source": "https://github.com/terraform-docs/terraform-docs",
  "checks": [{ "type": "binary", "name": "terraform-docs" }],
  "install_guidance": {
    "plugin": "terraform-docs",
    "binary": "terraform-docs",
    "check": "which terraform-docs",
    "install_steps": ["brew install terraform-docs", "Verify: terraform-docs --version", "supercli plugins install ./plugins/terraform-docs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terraform-docs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terraform-docs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terraform-docs",
      "passthrough": true,
      "missingDependencyHelp": "Install terraform-docs: brew install terraform-docs"
    },
    "args": []
  }]
}
