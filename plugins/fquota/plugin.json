{
  "name": "fquota",
  "version": "0.1.0",
  "description": "Disk usage alert and analysis tool for filesystems",
  "source": "https://github.com/fquota/fquota",
  "checks": [{ "type": "binary", "name": "fquota" }],
  "install_guidance": {
    "plugin": "fquota",
    "binary": "fquota",
    "check": "which fquota",
    "install_steps": ["brew install fquota", "Verify: fquota --version", "supercli plugins install ./plugins/fquota --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "fquota",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to fquota CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "fquota",
      "passthrough": true,
      "missingDependencyHelp": "Install fquota: brew install fquota", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
