{
  "name": "git-gerrit",
  "version": "0.1.0",
  "description": "Git-gerrit integration for code review workflows",
  "source": "https://github.com/rcmdnk/git-gerrit",
  "checks": [{ "type": "binary", "name": "git-gerrit" }],
  "install_guidance": {
    "plugin": "git-gerrit",
    "binary": "git-gerrit",
    "check": "which git-gerrit",
    "install_steps": ["brew install rcmdnk/rcmdnk/git-gerrit", "Verify: git-gerrit --version", "supercli plugins install ./plugins/git-gerrit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-gerrit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-gerrit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-gerrit",
      "passthrough": true,
      "missingDependencyHelp": "Install git-gerrit: brew install rcmdnk/rcmdnk/git-gerrit"
    },
    "args": []
  }]
}
