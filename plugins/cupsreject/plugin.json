{
  "name": "cupsreject",
  "version": "0.1.0",
  "description": "Reject jobs for CUPS destinations",
  "source": "https://packages.debian.org/cupsreject",
  "checks": [{ "type": "binary", "name": "cupsreject" }],
  "install_guidance": {
    "plugin": "cupsreject", "binary": "cupsreject", "check": "which cupsreject",
    "install_steps": ["apt-get install cups", "Verify: cupsreject --version", "supercli plugins install ./plugins/cupsreject --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cupsreject", "resource": "_", "action": "_",
    "description": "Passthrough to cupsreject CLI",
    "adapter": "process", "adapterConfig": { "command": "cupsreject", "passthrough": true, "missingDependencyHelp": "Install cupsreject: apt-get install cups" }, "args": []
  }]
}
