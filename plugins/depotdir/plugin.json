{
  "name": "depotdir",
  "version": "0.1.0",
  "description": "CLI tool: depotdir",
  "source": "https://packages.debian.org/depotdir",
  "checks": [{ "type": "binary", "name": "depotdir" }],
  "install_guidance": {
    "plugin": "depotdir", "binary": "depotdir", "check": "which depotdir",
    "install_steps": ["apt-get install depotdir 2>/dev/null || which depotdir", "Verify: depotdir --version", "supercli plugins install ./plugins/depotdir --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "depotdir", "resource": "_", "action": "_",
    "description": "Passthrough to depotdir CLI",
    "adapter": "process", "adapterConfig": { "command": "depotdir", "passthrough": true, "missingDependencyHelp": "Install depotdir: apt-get install depotdir" }, "args": []
  }]
}
