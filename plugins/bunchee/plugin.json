{
  "name": "bunchee",
  "version": "0.1.0",
  "description": "Zero-config bundler for Bun libraries",
  "source": "https://github.com/huozhi/bunchee",
  "checks": [{ "type": "binary", "name": "bunchee" }],
  "install_guidance": {
    "plugin": "bunchee",
    "binary": "bunchee",
    "check": "which bunchee",
    "install_steps": ["bun add -d bunchee", "Verify: bunchee --version", "supercli plugins install ./plugins/bunchee --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bunchee",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bunchee CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bunchee",
      "passthrough": true,
      "missingDependencyHelp": "Install bunchee: bun add -d bunchee", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
