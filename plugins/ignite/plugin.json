{
  "name": "ignite",
  "version": "0.1.0",
  "description": "Weave Ignite for running Firecracker microVMs with Docker UX",
  "source": "https://github.com/weaveworks/ignite",
  "checks": [{ "type": "binary", "name": "ignite" }],
  "install_guidance": {
    "plugin": "ignite",
    "binary": "ignite",
    "check": "which ignite",
    "install_steps": ["brew install ignite", "Verify: ignite --version", "supercli plugins install ./plugins/ignite --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ignite",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ignite CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ignite",
      "passthrough": true,
      "missingDependencyHelp": "Install ignite: brew install ignite"
    },
    "args": []
  }]
}
