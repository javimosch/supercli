{
  "name": "ppmtouil",
  "version": "0.1.0",
  "description": "CLI tool: ppmtouil",
  "source": "https://manpages.debian.org/ppmtouil",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtouil"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtouil",
    "binary": "ppmtouil",
    "check": "which ppmtouil",
    "install_steps": [
      "apt-get install ppmtouil 2>/dev/null || which ppmtouil",
      "Verify: ppmtouil --version",
      "supercli plugins install ./plugins/ppmtouil --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtouil",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtouil version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtouil",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtouil: apt-get install ppmtouil 2>/dev/null || which ppmtouil"
      },
      "args": []
    },
    {
      "namespace": "ppmtouil",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtouil CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtouil",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtouil: apt-get install ppmtouil 2>/dev/null || which ppmtouil"
      },
      "args": []
    }
  ]
}