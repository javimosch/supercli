{
  "name": "jpegoptim",
  "version": "0.1.0",
  "description": "JPEG optimizer with stripping and size options",
  "source": "https://github.com/tjko/jpegoptim",
  "checks": [
    {
      "type": "binary",
      "name": "jpegoptim"
    }
  ],
  "install_guidance": {
    "plugin": "jpegoptim",
    "binary": "jpegoptim",
    "check": "which jpegoptim",
    "install_steps": [
      "brew install jpegoptim",
      "Verify: jpegoptim --version",
      "supercli plugins install ./plugins/jpegoptim --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "jpegoptim",
      "resource": "self",
      "action": "version",
      "description": "Print jpegoptim version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpegoptim",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jpegoptim: brew install jpegoptim"
      },
      "args": []
    },
    {
      "namespace": "jpegoptim",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jpegoptim CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jpegoptim",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jpegoptim: brew install jpegoptim"
      },
      "args": []
    }
  ]
}
