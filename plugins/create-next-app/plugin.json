{
  "name": "create-next-app",
  "version": "0.1.0",
  "description": "create-next-app — scaffold a new Next.js application with built-in defaults. Sets up TypeScript, ESLint, Tailwind CSS, App Router, and Turbopack out of the box. Supports examples, custom templates, and package manager selection (npm/yarn/pnpm).",
  "source": "https://github.com/vercel/next.js",
  "checks": [
    {
      "type": "binary",
      "name": "create-next-app"
    }
  ],
  "install_guidance": {
    "plugin": "create-next-app",
    "binary": "create-next-app",
    "check": "which create-next-app",
    "install_steps": [
      "npm install -g create-next-app",
      "Verify: create-next-app --version",
      "supercli plugins install ./plugins/create-next-app --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "create-next-app",
      "resource": "self",
      "action": "version",
      "description": "Print create-next-app version",
      "adapter": "process",
      "adapterConfig": {
        "command": "create-next-app",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install create-next-app: npm install -g create-next-app"
      },
      "args": []
    },
    {
      "namespace": "create-next-app",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to create-next-app CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "create-next-app",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install create-next-app: npm install -g create-next-app"
      },
      "args": []
    }
  ]
}
