{
  "name": "dnsperf",
  "version": "1.0.0",
  "description": "dnsperf \u2014 DNS performance test",
  "source": "github.com/dnsperf/dnsperf",
  "checks": [
    {
      "type": "binary",
      "name": "dnsperf"
    }
  ],
  "install_guidance": {
    "plugin": "dnsperf",
    "binary": "dnsperf",
    "check": "which dnsperf",
    "install_steps": [
      "# Install dnsperf",
      "# See github.com/dnsperf/dnsperf",
      "# apt: sudo apt-get install dnsperf",
      "# brew: brew install dnsperf",
      "# cargo: cargo install dnsperf",
      "# npm: npm install -g dnsperf",
      "# pip: pip install dnsperf"
    ]
  },
  "commands": [
    {
      "namespace": "dnsperf",
      "resource": "dnsperf",
      "action": "run",
      "description": "Run dnsperf",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnsperf",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dnsperf from github.com/dnsperf/dnsperf"
      },
      "args": []
    }
  ]
}