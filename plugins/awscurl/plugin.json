{
  "name": "awscurl",
  "version": "0.1.0",
  "description": "Curl like simplicity to access AWS resources",
  "source": "https://github.com/okigan/awscurl",
  "checks": [
    {
      "type": "binary",
      "name": "awscurl"
    }
  ],
  "install_guidance": {
    "plugin": "awscurl",
    "binary": "awscurl",
    "check": "which awscurl",
    "install_steps": [
      "brew install awscurl",
      "Verify: awscurl --version",
      "supercli plugins install ./plugins/awscurl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "awscurl",
      "resource": "self",
      "action": "version",
      "description": "Print awscurl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awscurl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awscurl: brew install awscurl"
      },
      "args": []
    },
    {
      "namespace": "awscurl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awscurl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awscurl",
        "passthrough": true,
        "missingDependencyHelp": "Install awscurl"
      },
      "args": []
    }
  ]
}