{
  "name": "Event-log-monitor",
  "version": "0.1.0",
  "description": "This is the Event log monitor CLI tool",
  "source": "https://github.com/Event-log-monitor/Event-log-monitor",
  "checks": [
    {
      "type": "binary",
      "name": "Event-log-monitor"
    }
  ],
  "install_guidance": {
    "plugin": "Event-log-monitor",
    "binary": "Event-log-monitor",
    "check": "which Event-log-monitor",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Event-log-monitor --version",
      "supercli plugins install ./plugins/Event-log-monitor --on-conflict replace --json"
    ],
    "note": "PowerShell language CLI tool"
  },
  "commands": [
    {
      "namespace": "Event-log-monitor",
      "resource": "self",
      "action": "version",
      "description": "Print Event-log-monitor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Event-log-monitor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Event-log-monitor from project repository"
      },
      "args": []
    },
    {
      "namespace": "Event-log-monitor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Event-log-monitor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Event-log-monitor",
        "passthrough": true,
        "missingDependencyHelp": "Install Event-log-monitor from project repository"
      },
      "args": []
    }
  ]
}