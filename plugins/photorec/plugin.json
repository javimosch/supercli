{
  "name": "photorec",
  "version": "0.1.0",
  "description": "File data recovery tool designed to recover lost files",
  "source": "https://github.com/cgsecurity/testdisk",
  "checks": [{ "type": "binary", "name": "photorec" }],
  "install_guidance": {
    "plugin": "photorec",
    "binary": "photorec",
    "check": "which photorec",
    "install_steps": ["brew install testdisk", "Verify: photorec --version", "supercli plugins install ./plugins/photorec --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "photorec",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to photorec CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "photorec",
      "passthrough": true,
      "missingDependencyHelp": "Install photorec: brew install testdisk"
    },
    "args": []
  }]
}
