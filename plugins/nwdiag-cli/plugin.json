{
  "name": "nwdiag-cli",
  "version": "0.1.0",
  "description": "Network topology diagram generator from text descriptions",
  "source": "https://github.com/blockdiag/nwdiag",
  "checks": [{ "type": "binary", "name": "nwdiag-cli" }],
  "install_guidance": {
    "plugin": "nwdiag-cli",
    "binary": "nwdiag-cli",
    "check": "which nwdiag-cli",
    "install_steps": ["pip install nwdiag", "Verify: nwdiag-cli --version", "supercli plugins install ./plugins/nwdiag-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nwdiag-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nwdiag-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nwdiag-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install nwdiag-cli: pip install nwdiag", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
