{
  "name": "qml",
  "version": "0.1.0",
  "description": "CLI tool: qml",
  "source": "https://manpages.debian.org/qml",
  "checks": [
    {
      "type": "binary",
      "name": "qml"
    }
  ],
  "install_guidance": {
    "plugin": "qml",
    "binary": "qml",
    "check": "which qml",
    "install_steps": [
      "apt-get install qml 2>/dev/null || which qml",
      "Verify: qml --version",
      "supercli plugins install ./plugins/qml --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qml",
      "resource": "self",
      "action": "version",
      "description": "Print qml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qml: apt-get install qml 2>/dev/null || which qml"
      },
      "args": []
    },
    {
      "namespace": "qml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qml: apt-get install qml 2>/dev/null || which qml"
      },
      "args": []
    }
  ]
}