{
  "name": "epub2txt2",
  "version": "0.1.0",
  "description": "Fast dependency-free text extractor from EPUB files",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "epub2txt2" }],
  "install_guidance": {
    "plugin": "epub2txt2",
    "binary": "epub2txt2",
    "check": "which epub2txt2",
    "install_steps": ["make && sudo make install", "Verify: epub2txt2 --version", "supercli plugins install ./plugins/epub2txt2 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epub2txt2",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epub2txt2 CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epub2txt2",
      "passthrough": true,
      "missingDependencyHelp": "Install epub2txt2: make && sudo make install"
    },
    "args": []
  }]
}
