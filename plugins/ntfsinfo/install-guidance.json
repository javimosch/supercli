{
  "plugin": "ntfsinfo",
  "binary": "ntfsinfo",
  "check": "which ntfsinfo",
  "install_steps": [
    "# Install ntfsinfo",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ntfsinfo-linux-amd64 -o /usr/local/bin/ntfsinfo",
    "chmod +x /usr/local/bin/ntfsinfo",
    "# Or via package manager, see /usr/bin/ntfsinfo"
  ]
}