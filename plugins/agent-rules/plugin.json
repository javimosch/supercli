{
  "name": "agent-rules",
  "version": "0.1.0",
  "description": "Rules and Knowledge to work better with agents such as Claude Code or Cursor",
  "source": "https://github.com/agent-rules/agent-rules",
  "checks": [
    {
      "type": "binary",
      "name": "agent-rules"
    }
  ],
  "install_guidance": {
    "plugin": "agent-rules",
    "binary": "agent-rules",
    "check": "which agent-rules",
    "install_steps": [
      "pip install agent-rules",
      "Verify: agent-rules --version",
      "supercli plugins install ./plugins/agent-rules --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "agent-rules",
      "resource": "self",
      "action": "version",
      "description": "Print agent-rules version",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-rules",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install agent-rules: pip install agent-rules"
      },
      "args": []
    },
    {
      "namespace": "agent-rules",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to agent-rules CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "agent-rules",
        "passthrough": true,
        "missingDependencyHelp": "Install agent-rules: pip install agent-rules"
      },
      "args": []
    }
  ]
}