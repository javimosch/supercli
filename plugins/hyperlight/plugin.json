{
  "name": "hyperlight",
  "version": "0.1.0",
  "description": "Hyperlight is a lightweight Virtual Machine Manager (VMM) designed to be embedded within application",
  "source": "https://github.com/hyperlight/hyperlight",
  "checks": [
    {
      "type": "binary",
      "name": "hyperlight"
    }
  ],
  "install_guidance": {
    "plugin": "hyperlight",
    "binary": "hyperlight",
    "check": "which hyperlight",
    "install_steps": [
      "pip install hyperlight",
      "Verify: hyperlight --version",
      "supercli plugins install ./plugins/hyperlight --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hyperlight",
      "resource": "self",
      "action": "version",
      "description": "Print hyperlight version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hyperlight",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hyperlight: pip install hyperlight"
      },
      "args": []
    },
    {
      "namespace": "hyperlight",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hyperlight CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hyperlight",
        "passthrough": true,
        "missingDependencyHelp": "Install hyperlight: pip install hyperlight"
      },
      "args": []
    }
  ]
}