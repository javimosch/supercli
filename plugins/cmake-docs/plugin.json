{
  "name": "cmake-docs",
  "version": "0.1.0",
  "description": "Documentation for CMake",
  "checks": [
    {
      "type": "binary",
      "name": "cmake-docs"
    }
  ],
  "install_guidance": {
    "plugin": "cmake-docs",
    "binary": "cmake-docs",
    "check": "which cmake-docs",
    "install_steps": [
      "brew install cmake-docs",
      "Verify: cmake-docs --version",
      "supercli plugins install ./plugins/cmake-docs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cmake-docs",
      "resource": "self",
      "action": "version",
      "description": "Print cmake-docs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmake-docs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cmake-docs: brew install cmake-docs"
      },
      "args": []
    },
    {
      "namespace": "cmake-docs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cmake-docs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cmake-docs",
        "passthrough": true,
        "missingDependencyHelp": "Install cmake-docs"
      },
      "args": []
    }
  ]
}