{
  "name": "RuVector",
  "version": "0.1.0",
  "description": "RuVector is a High Performance, Real-Time, Self-Learning Ai, Vector GNN, Memory DB built in Rust.",
  "source": "https://github.com/RuVector/RuVector",
  "checks": [
    {
      "type": "binary",
      "name": "ruvector"
    }
  ],
  "install_guidance": {
    "plugin": "RuVector",
    "binary": "ruvector",
    "check": "which ruvector",
    "install_steps": [
      "pip install ruvector",
      "Verify: ruvector --version",
      "supercli plugins install ./plugins/RuVector --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RuVector",
      "resource": "self",
      "action": "version",
      "description": "Print RuVector version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruvector",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RuVector: pip install ruvector"
      },
      "args": []
    },
    {
      "namespace": "RuVector",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ruvector CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ruvector",
        "passthrough": true,
        "missingDependencyHelp": "Install RuVector: pip install ruvector"
      },
      "args": []
    }
  ]
}