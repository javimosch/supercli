{
  "name": "avahi-resolve",
  "version": "0.1.0",
  "description": "Resolve mDNS hostnames",
  "source": "https://packages.debian.org/avahi-resolve",
  "checks": [{ "type": "binary", "name": "avahi-resolve" }],
  "install_guidance": {
    "plugin": "avahi-resolve", "binary": "avahi-resolve", "check": "which avahi-resolve",
    "install_steps": ["apt-get install avahi-utils", "Verify: avahi-resolve --version", "supercli plugins install ./plugins/avahi-resolve --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "avahi-resolve", "resource": "_", "action": "_",
    "description": "Passthrough to avahi-resolve CLI",
    "adapter": "process", "adapterConfig": { "command": "avahi-resolve", "passthrough": true, "missingDependencyHelp": "Install avahi-resolve: apt-get install avahi-utils" }, "args": []
  }]
}
