{
  "name": "Scrapegraph-ai",
  "version": "0.1.0",
  "description": "Python scraper based on AI",
  "source": "https://github.com/Scrapegraph-ai/Scrapegraph-ai",
  "checks": [
    {
      "type": "binary",
      "name": "scrapegraph-ai"
    }
  ],
  "install_guidance": {
    "plugin": "Scrapegraph-ai",
    "binary": "scrapegraph-ai",
    "check": "which scrapegraph-ai",
    "install_steps": [
      "pip install scrapegraph-ai",
      "Verify: scrapegraph-ai --version",
      "supercli plugins install ./plugins/Scrapegraph-ai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Scrapegraph-ai",
      "resource": "self",
      "action": "version",
      "description": "Print Scrapegraph-ai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scrapegraph-ai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Scrapegraph-ai: pip install scrapegraph-ai"
      },
      "args": []
    },
    {
      "namespace": "Scrapegraph-ai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scrapegraph-ai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scrapegraph-ai",
        "passthrough": true,
        "missingDependencyHelp": "Install Scrapegraph-ai: pip install scrapegraph-ai"
      },
      "args": []
    }
  ]
}