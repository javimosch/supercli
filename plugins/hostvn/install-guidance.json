{
  "plugin": "hostvn",
  "binary": "hostvn",
  "check": "which hostvn",
  "install_steps": [
    "curl -sO https://scripts.hostvn.net/install && chmod +x install && ./install",
    "Verify: hostvn --version",
    "supercli plugins install ./plugins/hostvn --on-conflict replace --json"
  ],
  "note": "HOSTVN Script is a shell LEMP stack manager for CentOS/Ubuntu/Debian VPS."
}
