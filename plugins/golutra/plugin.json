{
  "name": "golutra",
  "version": "0.1.0",
  "description": "Multi-agent AI orchestration platform for automation, workflows, and developer tools. Golutra transf",
  "source": "https://github.com/golutra/golutra",
  "checks": [
    {
      "type": "binary",
      "name": "golutra"
    }
  ],
  "install_guidance": {
    "plugin": "golutra",
    "binary": "golutra",
    "check": "which golutra",
    "install_steps": [
      "pip install golutra",
      "Verify: golutra --version",
      "supercli plugins install ./plugins/golutra --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "golutra",
      "resource": "self",
      "action": "version",
      "description": "Print golutra version",
      "adapter": "process",
      "adapterConfig": {
        "command": "golutra",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install golutra: pip install golutra"
      },
      "args": []
    },
    {
      "namespace": "golutra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to golutra CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "golutra",
        "passthrough": true,
        "missingDependencyHelp": "Install golutra: pip install golutra"
      },
      "args": []
    }
  ]
}