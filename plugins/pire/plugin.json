{
  "name": "pire",
  "version": "0.1.0",
  "description": "Python Interactive Regular Expressions.",
  "source": "https://github.com/johannestaas/pire",
  "checks": [
    {
      "type": "binary",
      "name": "pire"
    }
  ],
  "install_guidance": {
    "plugin": "pire",
    "binary": "pire",
    "check": "which pire",
    "install_steps": [
      "See https://github.com/johannestaas/pire",
      "Verify: pire --version",
      "supercli plugins install ./plugins/pire --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "pire",
      "resource": "self",
      "action": "version",
      "description": "Print pire version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pire",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pire: See https://github.com/johannestaas/pire"
      },
      "args": []
    },
    {
      "namespace": "pire",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pire CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pire",
        "passthrough": true,
        "missingDependencyHelp": "Install pire"
      },
      "args": []
    }
  ]
}