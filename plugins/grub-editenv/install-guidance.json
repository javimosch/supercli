{
  "plugin": "grub-editenv",
  "binary": "grub-editenv",
  "check": "which grub-editenv",
  "install_steps": [
    "apt-get install grub-editenv 2>/dev/null || which grub-editenv",
    "Verify: grub-editenv --version",
    "supercli plugins install ./plugins/grub-editenv --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}