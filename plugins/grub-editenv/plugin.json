{
  "name": "grub-editenv",
  "version": "0.1.0",
  "description": "CLI tool: grub-editenv",
  "source": "https://manpages.debian.org/grub-editenv",
  "checks": [
    {
      "type": "binary",
      "name": "grub-editenv"
    }
  ],
  "install_guidance": {
    "plugin": "grub-editenv",
    "binary": "grub-editenv",
    "check": "which grub-editenv",
    "install_steps": [
      "apt-get install grub-editenv 2>/dev/null || which grub-editenv",
      "Verify: grub-editenv --version",
      "supercli plugins install ./plugins/grub-editenv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grub-editenv",
      "resource": "self",
      "action": "version",
      "description": "Print grub-editenv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grub-editenv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grub-editenv: apt-get install grub-editenv 2>/dev/null || which grub-editenv"
      },
      "args": []
    },
    {
      "namespace": "grub-editenv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grub-editenv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grub-editenv",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install grub-editenv: apt-get install grub-editenv 2>/dev/null || which grub-editenv"
      },
      "args": []
    }
  ]
}