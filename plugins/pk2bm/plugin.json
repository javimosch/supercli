{
  "name": "pk2bm",
  "version": "0.1.0",
  "description": "CLI tool: pk2bm",
  "source": "https://manpages.debian.org/pk2bm",
  "checks": [
    {
      "type": "binary",
      "name": "pk2bm"
    }
  ],
  "install_guidance": {
    "plugin": "pk2bm",
    "binary": "pk2bm",
    "check": "which pk2bm",
    "install_steps": [
      "apt-get install pk2bm 2>/dev/null || which pk2bm",
      "Verify: pk2bm --version",
      "supercli plugins install ./plugins/pk2bm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pk2bm",
      "resource": "self",
      "action": "version",
      "description": "Print pk2bm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pk2bm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pk2bm: apt-get install pk2bm 2>/dev/null || which pk2bm"
      },
      "args": []
    },
    {
      "namespace": "pk2bm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pk2bm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pk2bm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pk2bm: apt-get install pk2bm 2>/dev/null || which pk2bm"
      },
      "args": []
    }
  ]
}