{
  "name": "TeleSync",
  "version": "0.1.0",
  "description": "Store files on Telegram (Unlimited Storage)",
  "source": "https://github.com/openclaw/TeleSync",
  "checks": [
    {"type": "binary", "name": "telesync"}
  ],
  "install_guidance": {
    "plugin": "TeleSync",
    "binary": "telesync",
    "check": "which telesync",
    "install_steps": [
      "pip install telesync",
      "Verify: telesync --version",
      "supercli plugins install ./plugins/TeleSync --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "telesync",
      "resource": "self",
      "action": "version",
      "description": "Print telesync version",
      "adapter": "process",
      "adapterConfig": {
        "command": "telesync",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install telesync: pip install telesync"
      },
      "args": []
    },
    {
      "namespace": "telesync",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to telesync CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "telesync",
        "passthrough": true,
        "missingDependencyHelp": "Install telesync: pip install telesync"
      },
      "args": []
    }
  ]
}
