{
  "name": "yesqa",
  "version": "0.1.0",
  "description": "Automatically remove unnecessary noqa comments",
  "source": "https://github.com/asottile/yesqa",
  "checks": [{ "type": "binary", "name": "yesqa" }],
  "install_guidance": {
    "plugin": "yesqa",
    "binary": "yesqa",
    "check": "which yesqa",
    "install_steps": ["pip install yesqa", "Verify: yesqa --version", "supercli plugins install ./plugins/yesqa --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yesqa",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yesqa CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yesqa",
      "passthrough": true,
      "missingDependencyHelp": "Install yesqa: pip install yesqa", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
