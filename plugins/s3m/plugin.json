{
  "name": "s3m",
  "version": "0.1.0",
  "description": "Stream of data into S3 buckets",
  "source": "https://github.com/s3m/s3m",
  "checks": [
    {
      "type": "binary",
      "name": "s3m"
    }
  ],
  "install_guidance": {
    "plugin": "s3m",
    "binary": "s3m",
    "check": "which s3m",
    "install_steps": [
      "cargo install s3m",
      "Verify: s3m --version",
      "supercli plugins install ./plugins/s3m --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "s3m",
      "resource": "self",
      "action": "version",
      "description": "Print s3m version",
      "adapter": "process",
      "adapterConfig": {
        "command": "s3m",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install s3m: cargo install s3m"
      },
      "args": []
    },
    {
      "namespace": "s3m",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to s3m CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "s3m",
        "passthrough": true,
        "missingDependencyHelp": "Install s3m"
      },
      "args": []
    }
  ]
}