{
  "name": "nslookup",
  "version": "0.1.0",
  "description": "DNS lookup tool for querying name servers",
  "source": "https",
  "checks": [{"type": "binary", "name": "nslookup"}],
  "install_guidance": {
    "plugin": "nslookup",
    "binary": "nslookup",
    "check": "which nslookup",
    "install_steps": [
      "brew install bind",
      "Verify: nslookup --version",
      "supercli plugins install ./plugins/nslookup --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "nslookup",
      "resource": "self",
      "action": "version",
      "description": "Print nslookup version",
      "adapter": "process",
      "adapterConfig": {"command": "nslookup", "baseArgs": ["--version"], "missingDependencyHelp": "Install nslookup: brew install bind"},
      "args": []
    },
    {
      "namespace": "nslookup",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nslookup CLI",
      "adapter": "process",
      "adapterConfig": {"command": "nslookup", "passthrough": true, "missingDependencyHelp": "Install nslookup: brew install bind"},
      "args": []
    }
  ]
}
