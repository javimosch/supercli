{
  "name": "conman",
  "version": "0.1.0",
  "description": "Serial console management program supporting a large number of devices",
  "source": "https://github.com/dun/conman",
  "checks": [
    {
      "type": "binary",
      "name": "conman"
    }
  ],
  "install_guidance": {
    "plugin": "conman",
    "binary": "conman",
    "check": "which conman",
    "install_steps": [
      "brew install conman",
      "Verify: conman --version",
      "supercli plugins install ./plugins/conman --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "conman",
      "resource": "self",
      "action": "version",
      "description": "Print conman version",
      "adapter": "process",
      "adapterConfig": {
        "command": "conman",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install conman: brew install conman"
      },
      "args": []
    },
    {
      "namespace": "conman",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to conman CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "conman",
        "passthrough": true,
        "missingDependencyHelp": "Install conman"
      },
      "args": []
    }
  ]
}