{
  "name": "btdu",
  "version": "0.1.0",
  "description": "Sampling disk usage profiler for btrfs",
  "source": "https://github.com/CyberShadow/btdu",
  "checks": [
    {
      "type": "binary",
      "name": "btdu"
    }
  ],
  "install_guidance": {
    "plugin": "btdu",
    "binary": "btdu",
    "check": "which btdu",
    "install_steps": [
      "brew install btdu",
      "Verify: btdu --version",
      "supercli plugins install ./plugins/btdu --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "btdu",
      "resource": "self",
      "action": "version",
      "description": "Print btdu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "btdu",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install btdu: brew install btdu"
      },
      "args": []
    },
    {
      "namespace": "btdu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to btdu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "btdu",
        "passthrough": true,
        "missingDependencyHelp": "Install btdu"
      },
      "args": []
    }
  ]
}