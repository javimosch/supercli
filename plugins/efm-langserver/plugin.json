{
  "name": "efm-langserver",
  "version": "0.1.0",
  "description": "General purpose Language Server",
  "source": "https://github.com/mattn/efm-langserver",
  "checks": [
    {
      "type": "binary",
      "name": "efm-langserver"
    }
  ],
  "install_guidance": {
    "plugin": "efm-langserver",
    "binary": "efm-langserver",
    "check": "which efm-langserver",
    "install_steps": [
      "brew install efm-langserver",
      "Verify: efm-langserver --version",
      "supercli plugins install ./plugins/efm-langserver --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "efm-langserver",
      "resource": "self",
      "action": "version",
      "description": "Print efm-langserver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "efm-langserver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install efm-langserver: brew install efm-langserver"
      },
      "args": []
    },
    {
      "namespace": "efm-langserver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to efm-langserver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "efm-langserver",
        "passthrough": true,
        "missingDependencyHelp": "Install efm-langserver"
      },
      "args": []
    }
  ]
}