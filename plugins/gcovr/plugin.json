{
  "name": "gcovr",
  "version": "0.1.0",
  "description": "Reports from gcov test coverage program",
  "checks": [
    {
      "type": "binary",
      "name": "gcovr"
    }
  ],
  "install_guidance": {
    "plugin": "gcovr",
    "binary": "gcovr",
    "check": "which gcovr",
    "install_steps": [
      "brew install gcovr",
      "Verify: gcovr --version",
      "supercli plugins install ./plugins/gcovr --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gcovr",
      "resource": "self",
      "action": "version",
      "description": "Print gcovr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcovr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcovr: brew install gcovr"
      },
      "args": []
    },
    {
      "namespace": "gcovr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcovr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcovr",
        "passthrough": true,
        "missingDependencyHelp": "Install gcovr"
      },
      "args": []
    }
  ]
}