{
  "name": "Zygisk-Assistant",
  "version": "0.1.0",
  "description": "A Zygisk module to hide root for KernelSU, Magisk and APatch, designed to work on Android 5.0 and ab",
  "source": "https://github.com/Zygisk-Assistant/Zygisk-Assistant",
  "checks": [
    {
      "type": "binary",
      "name": "zygisk-assistant"
    }
  ],
  "install_guidance": {
    "plugin": "Zygisk-Assistant",
    "binary": "zygisk-assistant",
    "check": "which zygisk-assistant",
    "install_steps": [
      "pip install zygisk-assistant",
      "Verify: zygisk-assistant --version",
      "supercli plugins install ./plugins/Zygisk-Assistant --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Zygisk-Assistant",
      "resource": "self",
      "action": "version",
      "description": "Print Zygisk-Assistant version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zygisk-assistant",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Zygisk-Assistant: pip install zygisk-assistant"
      },
      "args": []
    },
    {
      "namespace": "Zygisk-Assistant",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zygisk-assistant CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zygisk-assistant",
        "passthrough": true,
        "missingDependencyHelp": "Install Zygisk-Assistant: pip install zygisk-assistant"
      },
      "args": []
    }
  ]
}