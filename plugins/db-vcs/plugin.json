{
  "name": "db-vcs",
  "version": "0.1.0",
  "description": "Version control for MySQL databases",
  "source": "https://github.com/infostreams/db",
  "checks": [
    {
      "type": "binary",
      "name": "db-vcs"
    }
  ],
  "install_guidance": {
    "plugin": "db-vcs",
    "binary": "db-vcs",
    "check": "which db-vcs",
    "install_steps": [
      "brew install db-vcs",
      "Verify: db-vcs --version",
      "supercli plugins install ./plugins/db-vcs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "db-vcs",
      "resource": "self",
      "action": "version",
      "description": "Print db-vcs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "db-vcs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install db-vcs: brew install db-vcs"
      },
      "args": []
    },
    {
      "namespace": "db-vcs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to db-vcs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "db-vcs",
        "passthrough": true,
        "missingDependencyHelp": "Install db-vcs"
      },
      "args": []
    }
  ]
}