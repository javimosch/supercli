{
  "name": "kubeshark",
  "version": "0.1.0",
  "description": "API traffic analyzer for Kubernetes providing deep protocol inspection",
  "source": "https://github.com/kubeshark/kubeshark",
  "checks": [{ "type": "binary", "name": "kubeshark" }],
  "install_guidance": {
    "plugin": "kubeshark",
    "binary": "kubeshark",
    "check": "which kubeshark",
    "install_steps": ["brew install kubeshark", "Verify: kubeshark --version", "supercli plugins install ./plugins/kubeshark --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubeshark",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubeshark CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubeshark",
      "passthrough": true,
      "missingDependencyHelp": "Install kubeshark: brew install kubeshark"
    },
    "args": []
  }]
}
