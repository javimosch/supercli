{
  "plugin": "gitlab-runner",
  "binary": "gitlab-runner",
  "check": "which gitlab-runner",
  "install_steps": [
    "brew install gitlab-runner",
    "Verify: gitlab-runner --version",
    "supercli plugins install ./plugins/gitlab-runner --on-conflict replace --json"
  ],
  "note": "Install from package manager"
}