{
  "plugin": "gatus-go",
  "binary": "gatus-go",
  "check": "which gatus-go",
  "install_steps": [
    "git clone <repo-url> /tmp/gatus-go-src",
    "cd /tmp/gatus-go-src && go build -o gatus-go .",
    "sudo mv /tmp/gatus-go-src/gatus-go /usr/local/bin/gatus-go"
  ],
  "note": "Requires Go 1.21+. Clean-room reimplementation of https://github.com/TwiN/gatus for supercli."
}
