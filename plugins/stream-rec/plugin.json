{
  "name": "stream-rec",
  "version": "0.1.0",
  "description": "Automatic streaming record tool.  Live stream and bullet comments recorder. \u864e\u7259/\u6296\u97f3/\u6597\u9c7c/Twitch/PandaTV/",
  "source": "https://github.com/stream-rec/stream-rec",
  "checks": [
    {
      "type": "binary",
      "name": "stream-rec"
    }
  ],
  "install_guidance": {
    "plugin": "stream-rec",
    "binary": "stream-rec",
    "check": "which stream-rec",
    "install_steps": [
      "pip install stream-rec",
      "Verify: stream-rec --version",
      "supercli plugins install ./plugins/stream-rec --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "stream-rec",
      "resource": "self",
      "action": "version",
      "description": "Print stream-rec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stream-rec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install stream-rec: pip install stream-rec"
      },
      "args": []
    },
    {
      "namespace": "stream-rec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stream-rec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stream-rec",
        "passthrough": true,
        "missingDependencyHelp": "Install stream-rec: pip install stream-rec"
      },
      "args": []
    }
  ]
}