{
  "name": "pod2usage",
  "version": "1.0.0",
  "description": "pod2usage \u2014 pod2usage \u2014 CLI utility",
  "source": "/usr/bin/pod2usage",
  "checks": [
    {
      "type": "binary",
      "name": "pod2usage"
    }
  ],
  "install_guidance": {
    "plugin": "pod2usage",
    "binary": "pod2usage",
    "check": "which pod2usage",
    "install_steps": [
      "# Install pod2usage:",
      "# apt: sudo apt-get install pod2usage",
      "# brew: brew install pod2usage",
      "# cargo: cargo install pod2usage",
      "# npm: npm install -g pod2usage",
      "# pip: pip install pod2usage",
      "# or download from /usr/bin/pod2usage"
    ]
  },
  "commands": [
    {
      "namespace": "pod2usage",
      "resource": "pod2usage",
      "action": "run",
      "description": "Run pod2usage",
      "adapter": "process",
      "adapterConfig": {
        "command": "pod2usage",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pod2usage from /usr/bin/pod2usage"
      },
      "args": []
    }
  ]
}