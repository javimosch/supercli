{
  "plugin": "pod2usage",
  "binary": "pod2usage",
  "check": "which pod2usage",
  "install_steps": [
    "# Install pod2usage",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pod2usage-linux-amd64 -o /usr/local/bin/pod2usage",
    "chmod +x /usr/local/bin/pod2usage",
    "# Or via package manager, see /usr/bin/pod2usage"
  ]
}