{
  "name": "docker-compose",
  "version": "1.0.0",
  "description": "docker-compose \u2014 Multi-container Docker",
  "source": "docs.docker.com/compose",
  "checks": [
    {
      "type": "binary",
      "name": "docker-compose"
    }
  ],
  "install_guidance": {
    "plugin": "docker-compose",
    "binary": "docker-compose",
    "check": "which docker-compose",
    "install_steps": [
      "# Install docker-compose",
      "# See docs.docker.com/compose",
      "# apt: sudo apt-get install docker-compose",
      "# brew: brew install docker-compose",
      "# cargo: cargo install docker-compose",
      "# npm: npm install -g docker-compose",
      "# pip: pip install docker-compose"
    ]
  },
  "commands": [
    {
      "namespace": "docker",
      "resource": "compose",
      "action": "run",
      "description": "Run docker-compose",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-compose",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install docker-compose from docs.docker.com/compose"
      },
      "args": []
    }
  ]
}