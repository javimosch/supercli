{
  "name": "glomap",
  "version": "0.1.0",
  "description": "[DEPRECATED] GLOMAP - Global Structured-from-Motion Revisited",
  "source": "https://github.com/glomap/glomap",
  "checks": [
    {
      "type": "binary",
      "name": "glomap"
    }
  ],
  "install_guidance": {
    "plugin": "glomap",
    "binary": "glomap",
    "check": "which glomap",
    "install_steps": [
      "pip install glomap",
      "Verify: glomap --version",
      "supercli plugins install ./plugins/glomap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "glomap",
      "resource": "self",
      "action": "version",
      "description": "Print glomap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glomap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install glomap: pip install glomap"
      },
      "args": []
    },
    {
      "namespace": "glomap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glomap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glomap",
        "passthrough": true,
        "missingDependencyHelp": "Install glomap: pip install glomap"
      },
      "args": []
    }
  ]
}