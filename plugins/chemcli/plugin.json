{
  "name": "chemcli",
  "version": "0.1.0",
  "description": "Command-line molecular weight calculator for chemistry",
  "source": "https://github.com/joshuajansen/chemcli",
  "checks": [{ "type": "binary", "name": "chemcli" }],
  "install_guidance": {
    "plugin": "chemcli",
    "binary": "chemcli",
    "check": "which chemcli",
    "install_steps": ["pip install chemcli", "Verify: chemcli --version", "supercli plugins install ./plugins/chemcli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "chemcli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to chemcli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "chemcli",
      "passthrough": true,
      "missingDependencyHelp": "Install chemcli: pip install chemcli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
