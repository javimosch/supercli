{
  "name": "dumpcap",
  "version": "0.1.0",
  "description": "Network packet capture tool",
  "source": "https://packages.debian.org/dumpcap",
  "checks": [{ "type": "binary", "name": "dumpcap" }],
  "install_guidance": {
    "plugin": "dumpcap", "binary": "dumpcap", "check": "which dumpcap",
    "install_steps": ["apt-get install wireshark-common", "Verify: dumpcap --version", "supercli plugins install ./plugins/dumpcap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dumpcap", "resource": "_", "action": "_",
    "description": "Passthrough to dumpcap CLI",
    "adapter": "process", "adapterConfig": { "command": "dumpcap", "passthrough": true, "missingDependencyHelp": "Install dumpcap: apt-get install wireshark-common" }, "args": []
  }]
}
