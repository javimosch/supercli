{
  "name": "CubeSandbox",
  "version": "0.1.0",
  "description": "Instant, Concurrent, Secure & Lightweight Sandbox for AI Agents.",
  "source": "https://github.com/CubeSandbox/CubeSandbox",
  "checks": [
    {
      "type": "binary",
      "name": "cubesandbox"
    }
  ],
  "install_guidance": {
    "plugin": "CubeSandbox",
    "binary": "cubesandbox",
    "check": "which cubesandbox",
    "install_steps": [
      "pip install cubesandbox",
      "Verify: cubesandbox --version",
      "supercli plugins install ./plugins/CubeSandbox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CubeSandbox",
      "resource": "self",
      "action": "version",
      "description": "Print CubeSandbox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cubesandbox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CubeSandbox: pip install cubesandbox"
      },
      "args": []
    },
    {
      "namespace": "CubeSandbox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cubesandbox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cubesandbox",
        "passthrough": true,
        "missingDependencyHelp": "Install CubeSandbox: pip install cubesandbox"
      },
      "args": []
    }
  ]
}