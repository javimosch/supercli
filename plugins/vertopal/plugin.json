{
  "name": "vertopal",
  "version": "0.1.0",
  "description": "CLI tool: vertopal",
  "source": "https://manpages.debian.org/vertopal",
  "checks": [
    {
      "type": "binary",
      "name": "vertopal"
    }
  ],
  "install_guidance": {
    "plugin": "vertopal",
    "binary": "vertopal",
    "check": "which vertopal",
    "install_steps": [
      "apt-get install vertopal 2>/dev/null || which vertopal",
      "Verify: vertopal --version",
      "supercli plugins install ./plugins/vertopal --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vertopal",
      "resource": "self",
      "action": "version",
      "description": "Print vertopal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vertopal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vertopal: apt-get install vertopal 2>/dev/null || which vertopal"
      },
      "args": []
    },
    {
      "namespace": "vertopal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vertopal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vertopal",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vertopal: apt-get install vertopal 2>/dev/null || which vertopal"
      },
      "args": []
    }
  ]
}