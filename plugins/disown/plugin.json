{
  "name": "disown",
  "version": "0.1.0",
  "description": "Remove jobs from shell job tables",
  "source": "https://packages.debian.org/disown",
  "checks": [
    { "type": "binary", "name": "disown" }
  ],
  "install_guidance": {
    "plugin": "disown",
    "binary": "disown",
    "check": "which disown",
    "install_steps": [
      "which disown",
      "Verify: disown --version",
      "supercli plugins install ./plugins/disown --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "disown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to disown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "disown",
        "passthrough": true,
        "missingDependencyHelp": "Install disown: which disown"
      },
      "args": []
    }
  ]
}
