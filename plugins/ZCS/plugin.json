{
  "name": "ZCS",
  "version": "0.1.0",
  "description": "A Zig ECS.",
  "source": "https://github.com/ZCS/ZCS",
  "checks": [
    {
      "type": "binary",
      "name": "zcs"
    }
  ],
  "install_guidance": {
    "plugin": "ZCS",
    "binary": "zcs",
    "check": "which zcs",
    "install_steps": [
      "pip install zcs",
      "Verify: zcs --version",
      "supercli plugins install ./plugins/ZCS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ZCS",
      "resource": "self",
      "action": "version",
      "description": "Print ZCS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zcs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ZCS: pip install zcs"
      },
      "args": []
    },
    {
      "namespace": "ZCS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zcs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zcs",
        "passthrough": true,
        "missingDependencyHelp": "Install ZCS: pip install zcs"
      },
      "args": []
    }
  ]
}