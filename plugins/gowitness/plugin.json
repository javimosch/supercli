{
  "name": "gowitness",
  "version": "0.1.0",
  "description": "Headless website screenshot CLI — captures screenshots and generates reports",
  "source": "https://github.com/sensepost/gowitness",
  "checks": [
    {
      "type": "binary",
      "name": "gowitness"
    }
  ],
  "install_guidance": {
    "plugin": "gowitness",
    "binary": "gowitness",
    "check": "which gowitness",
    "install_steps": [
      "go install github.com/sensepost/gowitness@latest",
      "Verify: gowitness --version",
      "supercli plugins install ./plugins/gowitness --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gowitness",
      "resource": "self",
      "action": "version",
      "description": "Print gowitness version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gowitness",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gowitness: go install github.com/sensepost/gowitness@latest"
      },
      "args": []
    },
    {
      "namespace": "gowitness",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gowitness CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gowitness",
        "passthrough": true,
        "missingDependencyHelp": "Install gowitness: go install github.com/sensepost/gowitness@latest"
      },
      "args": []
    }
  ]
}
