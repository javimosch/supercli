{
  "name": "mado",
  "version": "0.1.0",
  "description": "Fast Markdown linter written in Rust",
  "source": "https://github.com/akiomik/mado",
  "checks": [
    {
      "type": "binary",
      "name": "mado"
    }
  ],
  "install_guidance": {
    "plugin": "mado",
    "binary": "mado",
    "check": "which mado",
    "install_steps": [
      "brew install mado",
      "Verify: mado --version",
      "supercli plugins install ./plugins/mado --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "mado",
      "resource": "self",
      "action": "version",
      "description": "Print mado version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mado",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mado: brew install mado"
      },
      "args": []
    },
    {
      "namespace": "mado",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mado CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mado",
        "passthrough": true,
        "missingDependencyHelp": "Install mado"
      },
      "args": []
    }
  ]
}