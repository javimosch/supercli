{
  "name": "jfrog_cli_pipeline",
  "version": "0.1.0",
  "description": "Test usage of jfrog cli in pipeline",
  "source": "https://github.com/jfrog_cli_pipeline/jfrog_cli_pipeline",
  "checks": [
    {
      "type": "binary",
      "name": "jfrog_cli_pipeline"
    }
  ],
  "install_guidance": {
    "plugin": "jfrog_cli_pipeline",
    "binary": "jfrog_cli_pipeline",
    "check": "which jfrog_cli_pipeline",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: jfrog_cli_pipeline --version",
      "supercli plugins install ./plugins/jfrog_cli_pipeline --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "jfrog_cli_pipeline",
      "resource": "self",
      "action": "version",
      "description": "Print jfrog_cli_pipeline version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jfrog_cli_pipeline",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jfrog_cli_pipeline from project repository"
      },
      "args": []
    },
    {
      "namespace": "jfrog_cli_pipeline",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jfrog_cli_pipeline CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jfrog_cli_pipeline",
        "passthrough": true,
        "missingDependencyHelp": "Install jfrog_cli_pipeline from project repository"
      },
      "args": []
    }
  ]
}