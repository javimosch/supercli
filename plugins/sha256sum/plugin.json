{
  "name": "sha256sum",
  "version": "0.1.0",
  "description": "SHA-256 hash computation and verification",
  "source": "https",
  "checks": [{"type": "binary", "name": "sha256sum"}],
  "install_guidance": {
    "plugin": "sha256sum",
    "binary": "sha256sum",
    "check": "which sha256sum",
    "install_steps": [
      "brew install coreutils",
      "Verify: sha256sum --version",
      "supercli plugins install ./plugins/sha256sum --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "sha256sum",
      "resource": "self",
      "action": "version",
      "description": "Print sha256sum version",
      "adapter": "process",
      "adapterConfig": {"command": "sha256sum", "baseArgs": ["--version"], "missingDependencyHelp": "Install sha256sum: brew install coreutils"},
      "args": []
    },
    {
      "namespace": "sha256sum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sha256sum CLI",
      "adapter": "process",
      "adapterConfig": {"command": "sha256sum", "passthrough": true, "missingDependencyHelp": "Install sha256sum: brew install coreutils"},
      "args": []
    }
  ]
}
