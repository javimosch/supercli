{
  "plugin": "update-locale",
  "binary": "update-locale",
  "check": "which update-locale",
  "install_steps": [
    "apt-get install update-locale 2>/dev/null || which update-locale",
    "Verify: update-locale --version",
    "supercli plugins install ./plugins/update-locale --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}