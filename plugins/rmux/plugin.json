{
  "name": "rmux",
  "version": "0.1.0",
  "description": "Native terminal multiplexer in Rust with programmable SDK",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "rmux" }],
  "install_guidance": {
    "plugin": "rmux",
    "binary": "rmux",
    "check": "which rmux",
    "install_steps": ["cargo install rmux", "Verify: rmux --version", "supercli plugins install ./plugins/rmux --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rmux",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rmux CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rmux",
      "passthrough": true,
      "missingDependencyHelp": "Install rmux: cargo install rmux"
    },
    "args": []
  }]
}
