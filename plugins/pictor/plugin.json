{
  "name": "pictor",
  "version": "0.1.0",
  "description": "Image processing CLI — resize, convert, and optimize images in batch with JSON output",
  "source": "https://github.com/pictor/pictor",
  "checks": [
    {
      "type": "binary",
      "name": "pictor"
    }
  ],
  "install_guidance": {
    "plugin": "pictor",
    "binary": "pictor",
    "check": "which pictor",
    "install_steps": [
      "cargo install pictor",
      "Verify: pictor --version",
      "supercli plugins install ./plugins/pictor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pictor",
      "resource": "self",
      "action": "version",
      "description": "Print pictor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pictor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pictor: cargo install pictor"
      },
      "args": []
    },
    {
      "namespace": "pictor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pictor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pictor",
        "passthrough": true,
        "missingDependencyHelp": "Install pictor: cargo install pictor"
      },
      "args": []
    }
  ]
}
