{
  "plugin": "interactsh",
  "binary": "interactsh",
  "check": "which interactsh",
  "install_steps": [
    "go install github.com/projectdiscovery/interactsh/cmd/interactsh-client@latest",
    "Verify: interactsh --version",
    "supercli plugins install ./plugins/interactsh --on-conflict replace --json"
  ]
}
