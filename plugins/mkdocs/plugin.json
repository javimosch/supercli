{
  "name": "mkdocs",
  "version": "0.1.0",
  "description": "Project documentation generator from Markdown",
  "source": "https",
  "checks": [{"type": "binary", "name": "mkdocs"}],
  "install_guidance": {
    "plugin": "mkdocs",
    "binary": "mkdocs",
    "check": "which mkdocs",
    "install_steps": [
      "pip install mkdocs",
      "Verify: mkdocs --version",
      "supercli plugins install ./plugins/mkdocs --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "mkdocs",
      "resource": "self",
      "action": "version",
      "description": "Print mkdocs version",
      "adapter": "process",
      "adapterConfig": {"command": "mkdocs", "baseArgs": ["--version"], "missingDependencyHelp": "Install mkdocs: pip install mkdocs"},
      "args": []
    },
    {
      "namespace": "mkdocs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mkdocs CLI",
      "adapter": "process",
      "adapterConfig": {"command": "mkdocs", "passthrough": true, "missingDependencyHelp": "Install mkdocs: pip install mkdocs"},
      "args": []
    }
  ]
}
