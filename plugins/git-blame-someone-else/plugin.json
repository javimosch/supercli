{
  "name": "git-blame-someone-else",
  "version": "0.1.0",
  "description": "Blame someone else for your bad code",
  "source": "https://github.com/jayphelps/git-blame-someone-else",
  "checks": [{ "type": "binary", "name": "git-blame-someone-else" }],
  "install_guidance": {
    "plugin": "git-blame-someone-else",
    "binary": "git-blame-someone-else",
    "check": "which git-blame-someone-else",
    "install_steps": ["npm install -g git-blame-someone-else", "Verify: git-blame-someone-else --version", "supercli plugins install ./plugins/git-blame-someone-else --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "git-blame-someone-else",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to git-blame-someone-else CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "git-blame-someone-else",
      "passthrough": true,
      "missingDependencyHelp": "Install git-blame-someone-else: npm install -g git-blame-someone-else"
    },
    "args": []
  }]
}
