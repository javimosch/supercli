{
  "name": "fftw",
  "version": "0.1.0",
  "description": "C routines to compute the Discrete Fourier Transform",
  "checks": [
    {
      "type": "binary",
      "name": "fftw"
    }
  ],
  "install_guidance": {
    "plugin": "fftw",
    "binary": "fftw",
    "check": "which fftw",
    "install_steps": [
      "brew install fftw",
      "Verify: fftw --version",
      "supercli plugins install ./plugins/fftw --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fftw",
      "resource": "self",
      "action": "version",
      "description": "Print fftw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fftw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fftw: brew install fftw"
      },
      "args": []
    },
    {
      "namespace": "fftw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fftw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fftw",
        "passthrough": true,
        "missingDependencyHelp": "Install fftw"
      },
      "args": []
    }
  ]
}