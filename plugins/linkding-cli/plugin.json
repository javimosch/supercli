{
  "name": "linkding-cli",
  "version": "0.1.0",
  "description": "CLI for linkding self-hosted bookmark manager",
  "source": "https://github.com/bachya/linkding-cli",
  "checks": [{ "type": "binary", "name": "linkding-cli" }],
  "install_guidance": {
    "plugin": "linkding-cli",
    "binary": "linkding-cli",
    "check": "which linkding-cli",
    "install_steps": ["pip install linkding-cli", "Verify: linkding-cli --version", "supercli plugins install ./plugins/linkding-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "linkding-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to linkding-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "linkding-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install linkding-cli: pip install linkding-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
