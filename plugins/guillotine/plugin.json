{
  "name": "guillotine",
  "version": "0.1.0",
  "description": "An ultra-high performance and flexible EVM. Written in zig",
  "source": "https://github.com/guillotine/guillotine",
  "checks": [
    {
      "type": "binary",
      "name": "guillotine"
    }
  ],
  "install_guidance": {
    "plugin": "guillotine",
    "binary": "guillotine",
    "check": "which guillotine",
    "install_steps": [
      "pip install guillotine",
      "Verify: guillotine --version",
      "supercli plugins install ./plugins/guillotine --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "guillotine",
      "resource": "self",
      "action": "version",
      "description": "Print guillotine version",
      "adapter": "process",
      "adapterConfig": {
        "command": "guillotine",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install guillotine: pip install guillotine"
      },
      "args": []
    },
    {
      "namespace": "guillotine",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to guillotine CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "guillotine",
        "passthrough": true,
        "missingDependencyHelp": "Install guillotine: pip install guillotine"
      },
      "args": []
    }
  ]
}