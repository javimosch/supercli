{
  "name": "chakra",
  "version": "0.1.0",
  "description": "Core part of the JavaScript engine that powers Microsoft Edge",
  "source": "https://github.com/chakra-core/ChakraCore",
  "checks": [
    {
      "type": "binary",
      "name": "chakra"
    }
  ],
  "install_guidance": {
    "plugin": "chakra",
    "binary": "chakra",
    "check": "which chakra",
    "install_steps": [
      "brew install chakra",
      "Verify: chakra --version",
      "supercli plugins install ./plugins/chakra --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "chakra",
      "resource": "self",
      "action": "version",
      "description": "Print chakra version",
      "adapter": "process",
      "adapterConfig": {
        "command": "chakra",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install chakra: brew install chakra"
      },
      "args": []
    },
    {
      "namespace": "chakra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to chakra CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "chakra",
        "passthrough": true,
        "missingDependencyHelp": "Install chakra"
      },
      "args": []
    }
  ]
}