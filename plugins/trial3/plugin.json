{
  "name": "trial3",
  "version": "0.1.0",
  "description": "CLI tool: trial3",
  "source": "https://manpages.debian.org/trial3",
  "checks": [
    {
      "type": "binary",
      "name": "trial3"
    }
  ],
  "install_guidance": {
    "plugin": "trial3",
    "binary": "trial3",
    "check": "which trial3",
    "install_steps": [
      "apt-get install trial3 2>/dev/null || which trial3",
      "Verify: trial3 --version",
      "supercli plugins install ./plugins/trial3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "trial3",
      "resource": "self",
      "action": "version",
      "description": "Print trial3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "trial3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install trial3: apt-get install trial3 2>/dev/null || which trial3"
      },
      "args": []
    },
    {
      "namespace": "trial3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to trial3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "trial3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install trial3: apt-get install trial3 2>/dev/null || which trial3"
      },
      "args": []
    }
  ]
}