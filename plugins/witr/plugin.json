{
  "name": "witr",
  "version": "0.1.0",
  "description": "CLI tool that answers 'Why is this running?' — traces process ancestry, supervisors, containers, and service managers",
  "source": "https://github.com/pranshuparmar/witr",
  "checks": [
    { "type": "binary", "name": "witr" },
    { "type": "binary", "name": "node" }
  ],
  "install_guidance": {
    "plugin": "witr",
    "binary": "witr",
    "check": "which witr",
    "install_steps": [
      "brew install witr",
      "Verify: witr --version",
      "supercli plugins install ./plugins/witr --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "witr",
      "resource": "self",
      "action": "version",
      "description": "Print witr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "witr",
        "baseArgs": ["--version"],
        "timeout_ms": 5000,
        "missingDependencyHelp": "Install witr: brew install witr"
      },
      "args": []
    },
    {
      "namespace": "witr",
      "resource": "process",
      "action": "explain",
      "description": "Explain why a process is running",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/witr-wrapper.js"],
        "passthrough": true,
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install witr: brew install witr"
      },
      "args": []
    },
    {
      "namespace": "witr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to witr CLI (via wrapper that handles exit codes)",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/witr-wrapper.js"],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install witr: brew install witr"
      },
      "args": []
    }
  ]
}
