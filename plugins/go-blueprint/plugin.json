{
  "name": "go-blueprint",
  "version": "0.1.0",
  "description": "Go-blueprint allows users to spin up a quick Go project using a popular framework",
  "source": "https://github.com/go-blueprint/go-blueprint",
  "checks": [
    {
      "type": "binary",
      "name": "go-blueprint"
    }
  ],
  "install_guidance": {
    "plugin": "go-blueprint",
    "binary": "go-blueprint",
    "check": "which go-blueprint",
    "install_steps": [
      "pip install go-blueprint",
      "Verify: go-blueprint --version",
      "supercli plugins install ./plugins/go-blueprint --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-blueprint",
      "resource": "self",
      "action": "version",
      "description": "Print go-blueprint version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-blueprint",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-blueprint: pip install go-blueprint"
      },
      "args": []
    },
    {
      "namespace": "go-blueprint",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-blueprint CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-blueprint",
        "passthrough": true,
        "missingDependencyHelp": "Install go-blueprint: pip install go-blueprint"
      },
      "args": []
    }
  ]
}