{
  "name": "redcli",
  "version": "0.1.0",
  "description": "Minimalist CLI for interacting with Redis key-value store",
  "source": "go",
  "checks": [{ "type": "binary", "name": "redcli" }],
  "install_guidance": {
    "plugin": "redcli",
    "binary": "redcli",
    "check": "which redcli",
    "install_steps": ["go install github.com/redcli@latest", "Verify: redcli --version", "supercli plugins install ./plugins/redcli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "redcli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to redcli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "redcli",
      "passthrough": true,
      "missingDependencyHelp": "Install redcli: go install github.com/redcli@latest"
    },
    "args": []
  }]
}
