{
  "name": "cbc",
  "version": "0.1.0",
  "description": "Mixed integer linear programming solver",
  "source": "https://github.com/coin-or/Cbc",
  "checks": [
    {
      "type": "binary",
      "name": "cbc"
    }
  ],
  "install_guidance": {
    "plugin": "cbc",
    "binary": "cbc",
    "check": "which cbc",
    "install_steps": [
      "brew install cbc",
      "Verify: cbc --version",
      "supercli plugins install ./plugins/cbc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cbc",
      "resource": "self",
      "action": "version",
      "description": "Print cbc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cbc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cbc: brew install cbc"
      },
      "args": []
    },
    {
      "namespace": "cbc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cbc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cbc",
        "passthrough": true,
        "missingDependencyHelp": "Install cbc"
      },
      "args": []
    }
  ]
}