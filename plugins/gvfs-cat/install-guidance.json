{
  "plugin": "gvfs-cat",
  "binary": "gvfs-cat",
  "check": "which gvfs-cat",
  "install_steps": [
    "apt-get install gvfs-cat 2>/dev/null || which gvfs-cat",
    "Verify: gvfs-cat --version",
    "supercli plugins install ./plugins/gvfs-cat --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}