{
  "name": "readprofile",
  "version": "1.0.0",
  "description": "readprofile \u2014 readprofile \u2014 CLI utility",
  "source": "/usr/sbin/readprofile",
  "checks": [
    {
      "type": "binary",
      "name": "readprofile"
    }
  ],
  "install_guidance": {
    "plugin": "readprofile",
    "binary": "readprofile",
    "check": "which readprofile",
    "install_steps": [
      "# Install readprofile:",
      "# apt: sudo apt-get install readprofile",
      "# brew: brew install readprofile",
      "# cargo: cargo install readprofile",
      "# npm: npm install -g readprofile",
      "# pip: pip install readprofile",
      "# or download from /usr/sbin/readprofile"
    ]
  },
  "commands": [
    {
      "namespace": "readprofile",
      "resource": "readprofile",
      "action": "run",
      "description": "Run readprofile",
      "adapter": "process",
      "adapterConfig": {
        "command": "readprofile",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install readprofile from /usr/sbin/readprofile"
      },
      "args": []
    }
  ]
}