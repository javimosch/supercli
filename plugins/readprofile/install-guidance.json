{
  "plugin": "readprofile",
  "binary": "readprofile",
  "check": "which readprofile",
  "install_steps": [
    "# Install readprofile",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/readprofile-linux-amd64 -o /usr/local/bin/readprofile",
    "chmod +x /usr/local/bin/readprofile",
    "# Or via package manager, see /usr/sbin/readprofile"
  ]
}