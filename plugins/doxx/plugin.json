{
  "name": "doxx",
  "version": "0.1.0",
  "description": "Terminal-native .docx document viewer — view, search, and export Word files without leaving your command line",
  "source": "https://github.com/bgreenwell/doxx",
  "checks": [
    { "type": "binary", "name": "doxx" }
  ],
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "install_guidance": {
    "plugin": "doxx",
    "binary": "doxx",
    "check": "which doxx",
    "install_steps": [
      "brew install doxx",
      "Or: cargo install doxx",
      "Verify: doxx --version",
      "supercli plugins install ./plugins/doxx --on-conflict replace --json"
    ],
    "note": "Source: https://github.com/bgreenwell/doxx (3.7k stars). Written in Rust."
  },
  "commands": [
    {
      "namespace": "doxx",
      "resource": "self",
      "action": "version",
      "description": "Print doxx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doxx",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install doxx: brew install doxx or cargo install doxx"
      },
      "args": []
    },
    {
      "namespace": "doxx",
      "resource": "view",
      "action": "run",
      "description": "View a .docx file in the terminal",
      "adapter": "process",
      "adapterConfig": {
        "command": "doxx",
        "positionalArgs": ["file"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doxx"
      },
      "args": [
        { "name": "file", "type": "string", "required": true, "description": "Path to .docx file" },
        { "name": "search", "type": "string", "required": false, "description": "Search and highlight term" },
        { "name": "outline", "type": "boolean", "required": false, "description": "Start with outline view" },
        { "name": "page", "type": "number", "required": false, "description": "Jump to specific page" },
        { "name": "color", "type": "boolean", "required": false, "description": "Enable color support" }
      ]
    },
    {
      "namespace": "doxx",
      "resource": "export",
      "action": "markdown",
      "description": "Export .docx to Markdown",
      "adapter": "process",
      "adapterConfig": {
        "command": "doxx",
        "baseArgs": ["--export", "markdown"],
        "positionalArgs": ["file"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doxx"
      },
      "args": [
        { "name": "file", "type": "string", "required": true, "description": "Path to .docx file" }
      ]
    },
    {
      "namespace": "doxx",
      "resource": "export",
      "action": "csv",
      "description": "Extract tables from .docx as CSV",
      "adapter": "process",
      "adapterConfig": {
        "command": "doxx",
        "baseArgs": ["--export", "csv"],
        "positionalArgs": ["file"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doxx"
      },
      "args": [
        { "name": "file", "type": "string", "required": true, "description": "Path to .docx file" }
      ]
    },
    {
      "namespace": "doxx",
      "resource": "export",
      "action": "json",
      "description": "Export .docx document metadata as JSON",
      "adapter": "process",
      "adapterConfig": {
        "command": "doxx",
        "baseArgs": ["--export", "json"],
        "positionalArgs": ["file"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doxx"
      },
      "args": [
        { "name": "file", "type": "string", "required": true, "description": "Path to .docx file" }
      ]
    },
    {
      "namespace": "doxx",
      "resource": "export",
      "action": "text",
      "description": "Export .docx as plain text",
      "adapter": "process",
      "adapterConfig": {
        "command": "doxx",
        "baseArgs": ["--export", "text"],
        "positionalArgs": ["file"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install doxx"
      },
      "args": [
        { "name": "file", "type": "string", "required": true, "description": "Path to .docx file" }
      ]
    },
    {
      "namespace": "doxx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to doxx CLI for any command not covered by specific resources",
      "adapter": "process",
      "adapterConfig": {
        "command": "doxx",
        "cwd": "invoke_cwd",
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install doxx: brew install doxx or cargo install doxx"
      },
      "args": []
    }
  ]
}
