{
  "name": "xsetpointer",
  "version": "0.1.0",
  "description": "CLI tool: xsetpointer",
  "source": "https://manpages.debian.org/xsetpointer",
  "checks": [
    {
      "type": "binary",
      "name": "xsetpointer"
    }
  ],
  "install_guidance": {
    "plugin": "xsetpointer",
    "binary": "xsetpointer",
    "check": "which xsetpointer",
    "install_steps": [
      "apt-get install xsetpointer 2>/dev/null || which xsetpointer",
      "Verify: xsetpointer --version",
      "supercli plugins install ./plugins/xsetpointer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xsetpointer",
      "resource": "self",
      "action": "version",
      "description": "Print xsetpointer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsetpointer",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xsetpointer: apt-get install xsetpointer 2>/dev/null || which xsetpointer"
      },
      "args": []
    },
    {
      "namespace": "xsetpointer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xsetpointer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xsetpointer",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xsetpointer: apt-get install xsetpointer 2>/dev/null || which xsetpointer"
      },
      "args": []
    }
  ]
}