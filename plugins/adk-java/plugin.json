{
  "name": "adk-java",
  "version": "0.1.0",
  "description": "An open-source, code-first Java toolkit for building, evaluating, and deploying sophisticated AI age",
  "source": "https://github.com/adk-java/adk-java",
  "checks": [
    {
      "type": "binary",
      "name": "adk-java"
    }
  ],
  "install_guidance": {
    "plugin": "adk-java",
    "binary": "adk-java",
    "check": "which adk-java",
    "install_steps": [
      "pip install adk-java",
      "Verify: adk-java --version",
      "supercli plugins install ./plugins/adk-java --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "adk-java",
      "resource": "self",
      "action": "version",
      "description": "Print adk-java version",
      "adapter": "process",
      "adapterConfig": {
        "command": "adk-java",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install adk-java: pip install adk-java"
      },
      "args": []
    },
    {
      "namespace": "adk-java",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to adk-java CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "adk-java",
        "passthrough": true,
        "missingDependencyHelp": "Install adk-java: pip install adk-java"
      },
      "args": []
    }
  ]
}