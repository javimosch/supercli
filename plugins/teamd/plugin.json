{
  "name": "teamd",
  "version": "0.1.0",
  "description": "Network teaming daemon",
  "source": "https://packages.debian.org/teamd",
  "checks": [{ "type": "binary", "name": "teamd" }],
  "install_guidance": {
    "plugin": "teamd", "binary": "teamd", "check": "which teamd",
    "install_steps": ["apt-get install teamd", "Verify: teamd --version", "supercli plugins install ./plugins/teamd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "teamd", "resource": "_", "action": "_",
    "description": "Passthrough to teamd CLI",
    "adapter": "process", "adapterConfig": { "command": "teamd", "passthrough": true, "missingDependencyHelp": "Install teamd: apt-get install teamd" }, "args": []
  }]
}
