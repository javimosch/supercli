{
  "name": "dumpe2fs",
  "version": "0.1.0",
  "description": "CLI tool: dumpe2fs",
  "source": "https://manpages.debian.org/dumpe2fs",
  "checks": [
    {
      "type": "binary",
      "name": "dumpe2fs"
    }
  ],
  "install_guidance": {
    "plugin": "dumpe2fs",
    "binary": "dumpe2fs",
    "check": "which dumpe2fs",
    "install_steps": [
      "apt-get install dumpe2fs 2>/dev/null || which dumpe2fs",
      "Verify: dumpe2fs --version",
      "supercli plugins install ./plugins/dumpe2fs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dumpe2fs",
      "resource": "self",
      "action": "version",
      "description": "Print dumpe2fs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dumpe2fs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dumpe2fs: apt-get install dumpe2fs 2>/dev/null || which dumpe2fs"
      },
      "args": []
    },
    {
      "namespace": "dumpe2fs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dumpe2fs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dumpe2fs",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dumpe2fs: apt-get install dumpe2fs 2>/dev/null || which dumpe2fs"
      },
      "args": []
    }
  ]
}