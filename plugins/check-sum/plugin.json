{
  "name": "check-sum",
  "version": "0.1.0",
  "description": "Simple integrity verifier for file bundle checksums",
  "source": "https://github.com/wp-cli/checksum-command",
  "checks": [{ "type": "binary", "name": "check-sum" }],
  "install_guidance": {
    "plugin": "check-sum",
    "binary": "check-sum",
    "check": "which check-sum",
    "install_steps": ["pip install check-sum", "Verify: check-sum --version", "supercli plugins install ./plugins/check-sum --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "check-sum",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to check-sum CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "check-sum",
      "passthrough": true,
      "missingDependencyHelp": "Install check-sum: pip install check-sum", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
