{
  "name": "malt",
  "version": "0.1.0",
  "description": "Package Manager",
  "source": "https://github.com/indaco/malt",
  "checks": [
    { "type": "binary", "name": "malt" }
  ],
  "install_guidance": {
    "plugin": "malt",
    "binary": "malt",
    "check": "which malt",
    "install_steps": [
      "curl -fsSL https://raw.githubusercontent.com/indaco/malt/main/scripts/install.sh | bash",
      "Verify: malt --version",
      "supercli plugins install ./plugins/malt --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "malt",
      "resource": "self",
      "action": "version",
      "description": "Print malt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "malt",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install malt: curl -fsSL https://raw.githubusercontent.com/indaco/malt/main/scripts/install.sh | bash"
      },
      "args": []
    },
    {
      "namespace": "malt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to malt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "malt",
        "passthrough": true,
        "missingDependencyHelp": "Install malt"
      },
      "args": []
    }
  ]
}
