{
  "name": "license-eye",
  "version": "0.1.0",
  "description": "Tool to check and fix license headers and resolve dependency licenses",
  "checks": [
    {
      "type": "binary",
      "name": "license-eye"
    }
  ],
  "install_guidance": {
    "plugin": "license-eye",
    "binary": "license-eye",
    "check": "which license-eye",
    "install_steps": [
      "brew install license-eye",
      "Verify: license-eye --version",
      "supercli plugins install ./plugins/license-eye --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "license-eye",
      "resource": "self",
      "action": "version",
      "description": "Print license-eye version",
      "adapter": "process",
      "adapterConfig": {
        "command": "license-eye",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install license-eye: brew install license-eye"
      },
      "args": []
    },
    {
      "namespace": "license-eye",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to license-eye CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "license-eye",
        "passthrough": true,
        "missingDependencyHelp": "Install license-eye"
      },
      "args": []
    }
  ]
}