{
  "name": "ros2-engineering-skills",
  "version": "0.1.0",
  "description": "Production-grade ROS 2 development skill — workspace, nodes, executors, QoS, ros2_control, Nav2, MoveIt 2, real-time",
  "source": "https://github.com/dbwls99706/ros2-engineering-skills",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "ros2-engineering-skills",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/dbwls99706/ros2-engineering-skills.git",
      "supercli plugins install ./plugins/ros2-engineering-skills --on-conflict replace --json",
      "sc skills teach ros2-engineering-skills:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "ros2-engineering-skills", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["ros2-engineering-skills v0.1.0 — Use sc skills teach ros2-engineering-skills:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/dbwls99706/ros2-engineering-skills.git" }, "args": [] },
    { "namespace": "ros2-engineering-skills", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/dbwls99706/ros2-engineering-skills.git then: sc skills teach ros2-engineering-skills:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/dbwls99706/ros2-engineering-skills.git" }, "args": [] }
  ]
}
