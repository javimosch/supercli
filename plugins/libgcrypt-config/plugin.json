{
  "name": "libgcrypt-config",
  "version": "0.1.0",
  "description": "CLI tool: libgcrypt-config",
  "source": "https://manpages.debian.org/libgcrypt-config",
  "checks": [
    {
      "type": "binary",
      "name": "libgcrypt-config"
    }
  ],
  "install_guidance": {
    "plugin": "libgcrypt-config",
    "binary": "libgcrypt-config",
    "check": "which libgcrypt-config",
    "install_steps": [
      "apt-get install libgcrypt-config 2>/dev/null || which libgcrypt-config",
      "Verify: libgcrypt-config --version",
      "supercli plugins install ./plugins/libgcrypt-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "libgcrypt-config",
      "resource": "self",
      "action": "version",
      "description": "Print libgcrypt-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libgcrypt-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libgcrypt-config: apt-get install libgcrypt-config 2>/dev/null || which libgcrypt-config"
      },
      "args": []
    },
    {
      "namespace": "libgcrypt-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libgcrypt-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libgcrypt-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install libgcrypt-config: apt-get install libgcrypt-config 2>/dev/null || which libgcrypt-config"
      },
      "args": []
    }
  ]
}