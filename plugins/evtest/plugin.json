{
  "name": "evtest",
  "version": "1.0.0",
  "description": "evtest \u2014 Input event monitor",
  "source": "github.com/freedesktop/evtest",
  "checks": [
    {
      "type": "binary",
      "name": "evtest"
    }
  ],
  "install_guidance": {
    "plugin": "evtest",
    "binary": "evtest",
    "check": "which evtest",
    "install_steps": [
      "# Install evtest",
      "# See github.com/freedesktop/evtest",
      "# apt: sudo apt-get install evtest",
      "# brew: brew install evtest",
      "# cargo: cargo install evtest",
      "# npm: npm install -g evtest",
      "# pip: pip install evtest"
    ]
  },
  "commands": [
    {
      "namespace": "evtest",
      "resource": "evtest",
      "action": "run",
      "description": "Run evtest",
      "adapter": "process",
      "adapterConfig": {
        "command": "evtest",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install evtest from github.com/freedesktop/evtest"
      },
      "args": []
    }
  ]
}