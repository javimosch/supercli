{
  "name": "zapret2",
  "version": "0.1.0",
  "description": "anti-dpi software",
  "source": "https://github.com/zapret2/zapret2",
  "checks": [
    {
      "type": "binary",
      "name": "zapret2"
    }
  ],
  "install_guidance": {
    "plugin": "zapret2",
    "binary": "zapret2",
    "check": "which zapret2",
    "install_steps": [
      "pip install zapret2",
      "Verify: zapret2 --version",
      "supercli plugins install ./plugins/zapret2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zapret2",
      "resource": "self",
      "action": "version",
      "description": "Print zapret2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zapret2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zapret2: pip install zapret2"
      },
      "args": []
    },
    {
      "namespace": "zapret2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zapret2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zapret2",
        "passthrough": true,
        "missingDependencyHelp": "Install zapret2: pip install zapret2"
      },
      "args": []
    }
  ]
}