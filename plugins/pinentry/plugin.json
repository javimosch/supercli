{
  "name": "pinentry",
  "version": "0.1.0",
  "description": "PIN entry dialog for GPG",
  "source": "https://packages.debian.org/pinentry",
  "checks": [{ "type": "binary", "name": "pinentry" }],
  "install_guidance": {
    "plugin": "pinentry", "binary": "pinentry", "check": "which pinentry",
    "install_steps": ["apt-get install pinentry", "Verify: pinentry --version", "supercli plugins install ./plugins/pinentry --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pinentry", "resource": "_", "action": "_",
    "description": "Passthrough to pinentry CLI",
    "adapter": "process", "adapterConfig": { "command": "pinentry", "passthrough": true, "missingDependencyHelp": "Install pinentry: apt-get install pinentry" }, "args": []
  }]
}
