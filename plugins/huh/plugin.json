{
  "name": "huh",
  "version": "0.1.0",
  "description": "Build terminal forms and prompts \ud83e\udd37\ud83c\udffb\u200d\u2640\ufe0f",
  "source": "https://github.com/huh/huh",
  "checks": [
    {
      "type": "binary",
      "name": "huh"
    }
  ],
  "install_guidance": {
    "plugin": "huh",
    "binary": "huh",
    "check": "which huh",
    "install_steps": [
      "pip install huh",
      "Verify: huh --version",
      "supercli plugins install ./plugins/huh --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "huh",
      "resource": "self",
      "action": "version",
      "description": "Print huh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "huh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install huh: pip install huh"
      },
      "args": []
    },
    {
      "namespace": "huh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to huh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "huh",
        "passthrough": true,
        "missingDependencyHelp": "Install huh: pip install huh"
      },
      "args": []
    }
  ]
}