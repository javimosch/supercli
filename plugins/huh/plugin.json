{
  "name": "huh",
  "version": "0.1.0",
  "description": "Build interactive forms and prompts in the terminal",
  "source": "https://github.com/charmbracelet/huh",
  "checks": [{ "type": "binary", "name": "huh" }],
  "install_guidance": {
    "plugin": "huh",
    "binary": "huh",
    "check": "which huh",
    "install_steps": ["brew install huh", "Verify: huh --version", "supercli plugins install ./plugins/huh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "huh",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to huh CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "huh",
      "passthrough": true,
      "missingDependencyHelp": "Install huh: brew install huh"
    },
    "args": []
  }]
}
