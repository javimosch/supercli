{
  "name": "teachcode",
  "version": "0.1.0",
  "description": "Guide for the earliest lessons of coding",
  "source": "https://github.com/madlabsinc/teachcode",
  "checks": [
    {
      "type": "binary",
      "name": "teachcode"
    }
  ],
  "install_guidance": {
    "plugin": "teachcode",
    "binary": "teachcode",
    "check": "which teachcode",
    "install_steps": [
      "See https://github.com/madlabsinc/teachcode",
      "Verify: teachcode --version",
      "supercli plugins install ./plugins/teachcode --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "teachcode",
      "resource": "self",
      "action": "version",
      "description": "Print teachcode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "teachcode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install teachcode: See https://github.com/madlabsinc/teachcode"
      },
      "args": []
    },
    {
      "namespace": "teachcode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to teachcode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "teachcode",
        "passthrough": true,
        "missingDependencyHelp": "Install teachcode"
      },
      "args": []
    }
  ]
}