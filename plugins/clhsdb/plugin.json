{
  "name": "clhsdb",
  "version": "0.1.0",
  "description": "CLI tool: clhsdb",
  "source": "https://packages.debian.org/clhsdb",
  "checks": [{ "type": "binary", "name": "clhsdb" }],
  "install_guidance": {
    "plugin": "clhsdb", "binary": "clhsdb", "check": "which clhsdb",
    "install_steps": ["apt-get install clhsdb 2>/dev/null || which clhsdb", "Verify: clhsdb --version", "supercli plugins install ./plugins/clhsdb --on-conflict replace --json"]
