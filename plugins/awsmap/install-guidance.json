{
  "plugin": "awsmap",
  "binary": "awsmap",
  "check": "which awsmap",
  "install_steps": [
    "pip install awsmap",
    "Verify: awsmap --version",
    "supercli plugins install ./plugins/awsmap --on-conflict replace --json"
  ],
  "note": "Requires Python, pip, and AWS credentials configured"
}
