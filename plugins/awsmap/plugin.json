{
  "name": "awsmap",
  "version": "0.1.0",
  "description": "awsmap \u2014 a fast, comprehensive tool for mapping and inventorying AWS resources across 150+ services and all regions",
  "source": "https://github.com/awsmap/awsmap",
  "checks": [
    {
      "type": "binary",
      "name": "awsmap"
    }
  ],
  "install_guidance": {
    "plugin": "awsmap",
    "binary": "awsmap",
    "check": "which awsmap",
    "install_steps": [
      "pip install awsmap",
      "Verify: awsmap --version",
      "supercli plugins install ./plugins/awsmap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awsmap",
      "resource": "self",
      "action": "version",
      "description": "Print awsmap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsmap",
        "missingDependencyHelp": "Install awsmap: pip install awsmap",
        "baseArgs": [
          "--version"
        ]
      },
      "args": []
    },
    {
      "namespace": "awsmap",
      "resource": "resource",
      "action": "scan",
      "description": "Scan and map AWS resources",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsmap",
        "missingDependencyHelp": "Install awsmap: pip install awsmap",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "awsmap",
      "resource": "resource",
      "action": "list",
      "description": "List discovered AWS resources",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsmap",
        "missingDependencyHelp": "Install awsmap: pip install awsmap",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    },
    {
      "namespace": "awsmap",
      "resource": "_",
      "action": "_",
      "description": "_ _ via awsmap",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsmap",
        "missingDependencyHelp": "Install awsmap: pip install awsmap",
        "passthrough": true
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
