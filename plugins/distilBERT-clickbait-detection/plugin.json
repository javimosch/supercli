{
  "name": "distilBERT-clickbait-detection",
  "version": "0.1.0",
  "description": "NLP text classifier using fine-tuned DistilBERT to detect clickbait in news headlines. Built with Python, Hugging Face Transformers, and Streamlit.",
  "source": "https://github.com/distilBERT-clickbait-detection/distilBERT-clickbait-detection",
  "checks": [
    {
      "type": "binary",
      "name": "distilBERT-clickbait-detection"
    }
  ],
  "install_guidance": {
    "plugin": "distilBERT-clickbait-detection",
    "binary": "distilBERT-clickbait-detection",
    "check": "which distilBERT-clickbait-detection",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: distilBERT-clickbait-detection --version",
      "supercli plugins install ./plugins/distilBERT-clickbait-detection --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "distilBERT-clickbait-detection",
      "resource": "self",
      "action": "version",
      "description": "Print distilBERT-clickbait-detection version",
      "adapter": "process",
      "adapterConfig": {
        "command": "distilBERT-clickbait-detection",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install distilBERT-clickbait-detection from project repository"
      },
      "args": []
    },
    {
      "namespace": "distilBERT-clickbait-detection",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to distilBERT-clickbait-detection CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "distilBERT-clickbait-detection",
        "passthrough": true,
        "missingDependencyHelp": "Install distilBERT-clickbait-detection from project repository"
      },
      "args": []
    }
  ]
}