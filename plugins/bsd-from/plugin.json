{
  "name": "bsd-from",
  "version": "0.1.0",
  "description": "CLI tool: bsd-from",
  "source": "https://packages.debian.org/bsd-from",
  "checks": [{ "type": "binary", "name": "bsd-from" }],
  "install_guidance": {
    "plugin": "bsd-from", "binary": "bsd-from", "check": "which bsd-from",
    "install_steps": ["apt-get install bsd-from 2>/dev/null || which bsd-from", "Verify: bsd-from --version", "supercli plugins install ./plugins/bsd-from --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bsd-from", "resource": "_", "action": "_",
    "description": "Passthrough to bsd-from CLI",
    "adapter": "process", "adapterConfig": { "command": "bsd-from", "passthrough": true, "missingDependencyHelp": "Install bsd-from: apt-get install bsd-from" }, "args": []
  }]
}
