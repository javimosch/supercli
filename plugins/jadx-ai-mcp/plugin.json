{
  "name": "jadx-ai-mcp",
  "version": "0.1.0",
  "description": "Plugin for JADX to integrate MCP server",
  "source": "https://github.com/jadx-ai-mcp/jadx-ai-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "jadx-ai-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "jadx-ai-mcp",
    "binary": "jadx-ai-mcp",
    "check": "which jadx-ai-mcp",
    "install_steps": [
      "pip install jadx-ai-mcp",
      "Verify: jadx-ai-mcp --version",
      "supercli plugins install ./plugins/jadx-ai-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jadx-ai-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print jadx-ai-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jadx-ai-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jadx-ai-mcp: pip install jadx-ai-mcp"
      },
      "args": []
    },
    {
      "namespace": "jadx-ai-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jadx-ai-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jadx-ai-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install jadx-ai-mcp: pip install jadx-ai-mcp"
      },
      "args": []
    }
  ]
}