{
  "name": "cg_merge",
  "version": "0.1.0",
  "description": "cg_merge \u2014 (deprecated) merges multiple Cachegrind output files into one",
  "source": "https://packages.debian.org/cg_merge",
  "checks": [{ "type": "binary", "name": "cg_merge" }],
  "install_guidance": {
    "plugin": "cg_merge", "binary": "cg_merge", "check": "which cg_merge",
    "install_steps": ["apt-get install cg_merge 2>/dev/null || which cg_merge", "Verify: cg_merge --version", "supercli plugins install ./plugins/cg_merge --on-conflict replace --json"]
