    "namespace": "cg_merge", "resource": "_", "action": "_",
    "description": "Passthrough to cg_merge CLI",
    "adapter": "process", "adapterConfig": { "command": "cg_merge", "passthrough": true, "missingDependencyHelp": "Install cg_merge: apt-get install cg_merge" }, "args": []
  }]
}
