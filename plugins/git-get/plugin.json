{
  "name": "git-get",
  "version": "0.1.0",
  "description": "Better way to clone, organize and manage multiple git repositories",
  "source": "https://github.com/grdl/git-get",
  "checks": [
    {
      "type": "binary",
      "name": "git-get"
    }
  ],
  "install_guidance": {
    "plugin": "git-get",
    "binary": "git-get",
    "check": "which git-get",
    "install_steps": [
      "brew install git-get",
      "Verify: git-get --version",
      "supercli plugins install ./plugins/git-get --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-get",
      "resource": "self",
      "action": "version",
      "description": "Print git-get version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-get",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-get: brew install git-get"
      },
      "args": []
    },
    {
      "namespace": "git-get",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-get CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-get",
        "passthrough": true,
        "missingDependencyHelp": "Install git-get"
      },
      "args": []
    }
  ]
}