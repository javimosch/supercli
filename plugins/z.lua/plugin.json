{
  "name": "z.lua",
  "version": "0.1.0",
  "description": "`cd` command that learns your habits",
  "source": "https://github.com/skywind3000/z.lua",
  "checks": [
    {
      "type": "binary",
      "name": "z.lua"
    }
  ],
  "install_guidance": {
    "plugin": "z.lua",
    "binary": "z.lua",
    "check": "which z.lua",
    "install_steps": [
      "brew install z.lua",
      "Verify: z.lua --version",
      "supercli plugins install ./plugins/z.lua --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "z.lua",
      "resource": "self",
      "action": "version",
      "description": "Print z.lua version",
      "adapter": "process",
      "adapterConfig": {
        "command": "z.lua",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install z.lua: brew install z.lua"
      },
      "args": []
    },
    {
      "namespace": "z.lua",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to z.lua CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "z.lua",
        "passthrough": true,
        "missingDependencyHelp": "Install z.lua"
      },
      "args": []
    }
  ]
}