{
  "name": "hexd",
  "version": "0.1.0",
  "description": "Colourful, human-friendly hexdump tool",
  "source": "https://github.com/FireyFly/hexd",
  "checks": [
    {
      "type": "binary",
      "name": "hexd"
    }
  ],
  "install_guidance": {
    "plugin": "hexd",
    "binary": "hexd",
    "check": "which hexd",
    "install_steps": [
      "brew install hexd",
      "Verify: hexd --version",
      "supercli plugins install ./plugins/hexd --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hexd",
      "resource": "self",
      "action": "version",
      "description": "Print hexd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hexd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hexd: brew install hexd"
      },
      "args": []
    },
    {
      "namespace": "hexd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hexd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hexd",
        "passthrough": true,
        "missingDependencyHelp": "Install hexd"
      },
      "args": []
    }
  ]
}