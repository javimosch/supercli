{
  "name": "react2shell-guard",
  "version": "0.1.0",
  "description": "Specialized scanner for CVE-2025-55182 RCE in React Server Components",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "react2shell-guard" }],
  "install_guidance": {
    "plugin": "react2shell-guard",
    "binary": "react2shell-guard",
    "check": "which react2shell-guard",
    "install_steps": ["npm install -g react2shell-scanner", "Verify: react2shell-guard --version", "supercli plugins install ./plugins/react2shell-guard --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "react2shell-guard",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to react2shell-guard CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "react2shell-guard",
      "passthrough": true,
      "missingDependencyHelp": "Install react2shell-guard: npm install -g react2shell-scanner"
    },
    "args": []
  }]
}
