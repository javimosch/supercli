{
  "name": "circuss",
  "version": "0.1.0",
  "description": "Lightweight process and socket manager for Python applications",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "circuss" }],
  "install_guidance": {
    "plugin": "circuss",
    "binary": "circuss",
    "check": "which circuss",
    "install_steps": ["pip install circuss", "Verify: circuss --version", "supercli plugins install ./plugins/circuss --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "circuss",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to circuss CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "circuss",
      "passthrough": true,
      "missingDependencyHelp": "Install circuss: pip install circuss"
    },
    "args": []
  }]
}
