{
  "name": "yaml-front-matter",
  "version": "0.1.0",
  "description": "Parse YAML front matter from any text file",
  "source": "https://github.com/dworthen/yaml-front-matter",
  "checks": [{ "type": "binary", "name": "yaml-front-matter" }],
  "install_guidance": {
    "plugin": "yaml-front-matter",
    "binary": "yaml-front-matter",
    "check": "which yaml-front-matter",
    "install_steps": ["npm install -g yaml-front-matter", "Verify: yaml-front-matter --version", "supercli plugins install ./plugins/yaml-front-matter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "yaml-front-matter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to yaml-front-matter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "yaml-front-matter",
      "passthrough": true,
      "missingDependencyHelp": "Install yaml-front-matter: npm install -g yaml-front-matter", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
