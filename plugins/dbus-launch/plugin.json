{
  "name": "dbus-launch",
  "version": "0.1.0",
  "description": "CLI tool: dbus-launch",
  "source": "https://packages.debian.org/dbus-launch",
  "checks": [{ "type": "binary", "name": "dbus-launch" }],
  "install_guidance": {
    "plugin": "dbus-launch", "binary": "dbus-launch", "check": "which dbus-launch",
    "install_steps": ["apt-get install dbus-launch 2>/dev/null || which dbus-launch", "Verify: dbus-launch --version", "supercli plugins install ./plugins/dbus-launch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dbus-launch", "resource": "_", "action": "_",
    "description": "Passthrough to dbus-launch CLI",
    "adapter": "process", "adapterConfig": { "command": "dbus-launch", "passthrough": true, "missingDependencyHelp": "Install dbus-launch: apt-get install dbus-launch" }, "args": []
  }]
}
