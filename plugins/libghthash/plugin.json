{
  "name": "libghthash",
  "version": "0.1.0",
  "description": "Generic hash table for C++",
  "source": "https://github.com/SimonKagstrom/libghthash",
  "checks": [
    {
      "type": "binary",
      "name": "libghthash"
    }
  ],
  "install_guidance": {
    "plugin": "libghthash",
    "binary": "libghthash",
    "check": "which libghthash",
    "install_steps": [
      "brew install libghthash",
      "Verify: libghthash --version",
      "supercli plugins install ./plugins/libghthash --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libghthash",
      "resource": "self",
      "action": "version",
      "description": "Print libghthash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libghthash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libghthash: brew install libghthash"
      },
      "args": []
    },
    {
      "namespace": "libghthash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libghthash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libghthash",
        "passthrough": true,
        "missingDependencyHelp": "Install libghthash"
      },
      "args": []
    }
  ]
}