{
  "name": "rsyslogd",
  "version": "1.0.0",
  "description": "rsyslogd \u2014 rsyslogd \u2014 CLI utility",
  "source": "/usr/sbin/rsyslogd",
  "checks": [
    {
      "type": "binary",
      "name": "rsyslogd"
    }
  ],
  "install_guidance": {
    "plugin": "rsyslogd",
    "binary": "rsyslogd",
    "check": "which rsyslogd",
    "install_steps": [
      "# Install rsyslogd:",
      "# apt: sudo apt-get install rsyslogd",
      "# brew: brew install rsyslogd",
      "# cargo: cargo install rsyslogd",
      "# npm: npm install -g rsyslogd",
      "# pip: pip install rsyslogd",
      "# or download from /usr/sbin/rsyslogd"
    ]
  },
  "commands": [
    {
      "namespace": "rsyslogd",
      "resource": "rsyslogd",
      "action": "run",
      "description": "Run rsyslogd",
      "adapter": "process",
      "adapterConfig": {
        "command": "rsyslogd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rsyslogd from /usr/sbin/rsyslogd"
      },
      "args": []
    }
  ]
}