{
  "plugin": "rsyslogd",
  "binary": "rsyslogd",
  "check": "which rsyslogd",
  "install_steps": [
    "# Install rsyslogd",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rsyslogd-linux-amd64 -o /usr/local/bin/rsyslogd",
    "chmod +x /usr/local/bin/rsyslogd",
    "# Or via package manager, see /usr/sbin/rsyslogd"
  ]
}