{
  "name": "gnu-tar",
  "version": "0.1.0",
  "description": "GNU version of the tar archiving utility",
  "checks": [
    {
      "type": "binary",
      "name": "gnu-tar"
    }
  ],
  "install_guidance": {
    "plugin": "gnu-tar",
    "binary": "gnu-tar",
    "check": "which gnu-tar",
    "install_steps": [
      "brew install gnu-tar",
      "Verify: gnu-tar --version",
      "supercli plugins install ./plugins/gnu-tar --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gnu-tar",
      "resource": "self",
      "action": "version",
      "description": "Print gnu-tar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnu-tar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gnu-tar: brew install gnu-tar"
      },
      "args": []
    },
    {
      "namespace": "gnu-tar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gnu-tar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gnu-tar",
        "passthrough": true,
        "missingDependencyHelp": "Install gnu-tar"
      },
      "args": []
    }
  ]
}