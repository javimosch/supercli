{
  "name": "pw",
  "version": "0.1.0",
  "description": "Ultra-minimalist password generator in Go",
  "source": "https://github.com/Southclaws/pw",
  "checks": [{ "type": "binary", "name": "pw" }],
  "install_guidance": {
    "plugin": "pw",
    "binary": "pw",
    "check": "which pw",
    "install_steps": ["go install github.com/Southclaws/pw@latest", "Verify: pw --version", "supercli plugins install ./plugins/pw --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pw",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pw CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pw",
      "passthrough": true,
      "missingDependencyHelp": "Install pw: go install github.com/Southclaws/pw@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
