{
  "name": "ngettext",
  "version": "0.1.0",
  "description": "CLI tool: ngettext",
  "source": "https://manpages.debian.org/ngettext",
  "checks": [
    {
      "type": "binary",
      "name": "ngettext"
    }
  ],
  "install_guidance": {
    "plugin": "ngettext",
    "binary": "ngettext",
    "check": "which ngettext",
    "install_steps": [
      "apt-get install ngettext 2>/dev/null || which ngettext",
      "Verify: ngettext --version",
      "supercli plugins install ./plugins/ngettext --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ngettext",
      "resource": "self",
      "action": "version",
      "description": "Print ngettext version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ngettext",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ngettext: apt-get install ngettext 2>/dev/null || which ngettext"
      },
      "args": []
    },
    {
      "namespace": "ngettext",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ngettext CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ngettext",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ngettext: apt-get install ngettext 2>/dev/null || which ngettext"
      },
      "args": []
    }
  ]
}