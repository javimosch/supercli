{
  "name": "tablefaker",
  "version": "0.1.0",
  "description": "Generate realistic synthetic table data from YAML schema definitions",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "tablefaker" }],
  "install_guidance": {
    "plugin": "tablefaker",
    "binary": "tablefaker",
    "check": "which tablefaker",
    "install_steps": ["pip install tablefaker", "Verify: tablefaker --version", "supercli plugins install ./plugins/tablefaker --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tablefaker",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tablefaker CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tablefaker",
      "passthrough": true,
      "missingDependencyHelp": "Install tablefaker: pip install tablefaker"
    },
    "args": []
  }]
}
