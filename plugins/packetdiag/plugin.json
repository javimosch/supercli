{
  "name": "packetdiag",
  "version": "0.1.0",
  "description": "Generate packet header diagrams from text specifications",
  "source": "https://github.com/blockdiag/packetdiag",
  "checks": [{ "type": "binary", "name": "packetdiag" }],
  "install_guidance": {
    "plugin": "packetdiag",
    "binary": "packetdiag",
    "check": "which packetdiag",
    "install_steps": ["pip install packetdiag", "Verify: packetdiag --version", "supercli plugins install ./plugins/packetdiag --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "packetdiag",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to packetdiag CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "packetdiag",
      "passthrough": true,
      "missingDependencyHelp": "Install packetdiag: pip install packetdiag", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
