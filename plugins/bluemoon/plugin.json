{
  "name": "bluemoon",
  "version": "0.1.0",
  "description": "CLI tool: bluemoon",
  "source": "https://packages.debian.org/bluemoon",
  "checks": [{ "type": "binary", "name": "bluemoon" }],
  "install_guidance": {
    "plugin": "bluemoon", "binary": "bluemoon", "check": "which bluemoon",
    "install_steps": ["apt-get install bluemoon 2>/dev/null || which bluemoon", "Verify: bluemoon --version", "supercli plugins install ./plugins/bluemoon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bluemoon", "resource": "_", "action": "_",
    "description": "Passthrough to bluemoon CLI",
    "adapter": "process", "adapterConfig": { "command": "bluemoon", "passthrough": true, "missingDependencyHelp": "Install bluemoon: apt-get install bluemoon" }, "args": []
  }]
}
