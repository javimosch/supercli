{
  "name": "bossa",
  "version": "0.1.0",
  "description": "Flash utility for Atmel SAM microcontrollers",
  "source": "https://github.com/shumatech/BOSSA",
  "checks": [
    {
      "type": "binary",
      "name": "bossa"
    }
  ],
  "install_guidance": {
    "plugin": "bossa",
    "binary": "bossa",
    "check": "which bossa",
    "install_steps": [
      "brew install bossa",
      "Verify: bossa --version",
      "supercli plugins install ./plugins/bossa --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bossa",
      "resource": "self",
      "action": "version",
      "description": "Print bossa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bossa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bossa: brew install bossa"
      },
      "args": []
    },
    {
      "namespace": "bossa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bossa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bossa",
        "passthrough": true,
        "missingDependencyHelp": "Install bossa"
      },
      "args": []
    }
  ]
}