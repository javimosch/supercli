{
  "name": "Batch-Clickable-Menu",
  "version": "0.1.0",
  "description": "a simple batch clickable menu",
  "source": "https://github.com/Batch-Clickable-Menu/Batch-Clickable-Menu",
  "checks": [
    {
      "type": "binary",
      "name": "Batch-Clickable-Menu"
    }
  ],
  "install_guidance": {
    "plugin": "Batch-Clickable-Menu",
    "binary": "Batch-Clickable-Menu",
    "check": "which Batch-Clickable-Menu",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Batch-Clickable-Menu --version",
      "supercli plugins install ./plugins/Batch-Clickable-Menu --on-conflict replace --json"
    ],
    "note": "Batchfile language CLI tool"
  },
  "commands": [
    {
      "namespace": "Batch-Clickable-Menu",
      "resource": "self",
      "action": "version",
      "description": "Print Batch-Clickable-Menu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Batch-Clickable-Menu",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Batch-Clickable-Menu from project repository"
      },
      "args": []
    },
    {
      "namespace": "Batch-Clickable-Menu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Batch-Clickable-Menu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Batch-Clickable-Menu",
        "passthrough": true,
        "missingDependencyHelp": "Install Batch-Clickable-Menu from project repository"
      },
      "args": []
    }
  ]
}