{
  "name": "DeepSeek-V3",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/DeepSeek-V3/DeepSeek-V3",
  "checks": [
    {
      "type": "binary",
      "name": "deepseek-v3"
    }
  ],
  "install_guidance": {
    "plugin": "DeepSeek-V3",
    "binary": "deepseek-v3",
    "check": "which deepseek-v3",
    "install_steps": [
      "pip install deepseek-v3",
      "Verify: deepseek-v3 --version",
      "supercli plugins install ./plugins/DeepSeek-V3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DeepSeek-V3",
      "resource": "self",
      "action": "version",
      "description": "Print DeepSeek-V3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepseek-v3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DeepSeek-V3: pip install deepseek-v3"
      },
      "args": []
    },
    {
      "namespace": "DeepSeek-V3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to deepseek-v3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "deepseek-v3",
        "passthrough": true,
        "missingDependencyHelp": "Install DeepSeek-V3: pip install deepseek-v3"
      },
      "args": []
    }
  ]
}