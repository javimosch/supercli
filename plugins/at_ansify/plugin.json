{
  "name": "at_ansify",
  "version": "0.1.0",
  "description": "CLI tool: at_ansify",
  "source": "https://packages.debian.org/at_ansify",
  "checks": [{ "type": "binary", "name": "at_ansify" }],
  "install_guidance": {
    "plugin": "at_ansify", "binary": "at_ansify", "check": "which at_ansify",
    "install_steps": ["apt-get install at_ansify 2>/dev/null || which at_ansify", "Verify: at_ansify --version", "supercli plugins install ./plugins/at_ansify --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at_ansify", "resource": "_", "action": "_",
    "description": "Passthrough to at_ansify CLI",
    "adapter": "process", "adapterConfig": { "command": "at_ansify", "passthrough": true, "missingDependencyHelp": "Install at_ansify: apt-get install at_ansify" }, "args": []
  }]
}
