{
  "name": "cargo-hack",
  "version": "0.1.0",
  "description": "Check and test Rust crates with feature combinations",
  "source": "https://github.com/taiki-e/cargo-hack",
  "checks": [{ "type": "binary", "name": "cargo-hack" }],
  "install_guidance": {
    "plugin": "cargo-hack",
    "binary": "cargo-hack",
    "check": "which cargo-hack",
    "install_steps": ["cargo install cargo-hack", "Verify: cargo-hack --version", "supercli plugins install ./plugins/cargo-hack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-hack",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-hack CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-hack",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-hack: cargo install cargo-hack", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
