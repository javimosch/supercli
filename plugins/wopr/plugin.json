{
  "name": "wopr",
  "version": "0.1.0",
  "description": "A simple markup language for creating rich terminal reports, presentations and infographics",
  "source": "https://github.com/yaronn/wopr",
  "checks": [
    {
      "type": "binary",
      "name": "wopr"
    }
  ],
  "install_guidance": {
    "plugin": "wopr",
    "binary": "wopr",
    "check": "which wopr",
    "install_steps": [
      "See https://github.com/yaronn/wopr",
      "Verify: wopr --version",
      "supercli plugins install ./plugins/wopr --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "wopr",
      "resource": "self",
      "action": "version",
      "description": "Print wopr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wopr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wopr: See https://github.com/yaronn/wopr"
      },
      "args": []
    },
    {
      "namespace": "wopr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wopr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wopr",
        "passthrough": true,
        "missingDependencyHelp": "Install wopr"
      },
      "args": []
    }
  ]
}