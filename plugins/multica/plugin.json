{
  "name": "multica",
  "version": "0.1.0",
  "description": "The open-source managed agents platform. Turn coding agents into real teammates \u2014 assign tasks, trac",
  "source": "https://github.com/multica/multica",
  "checks": [
    {
      "type": "binary",
      "name": "multica"
    }
  ],
  "install_guidance": {
    "plugin": "multica",
    "binary": "multica",
    "check": "which multica",
    "install_steps": [
      "pip install multica",
      "Verify: multica --version",
      "supercli plugins install ./plugins/multica --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "multica",
      "resource": "self",
      "action": "version",
      "description": "Print multica version",
      "adapter": "process",
      "adapterConfig": {
        "command": "multica",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install multica: pip install multica"
      },
      "args": []
    },
    {
      "namespace": "multica",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to multica CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "multica",
        "passthrough": true,
        "missingDependencyHelp": "Install multica: pip install multica"
      },
      "args": []
    }
  ]
}