{
  "name": "helium-db",
  "version": "0.1.0",
  "description": "Open-source graph-vector database built from scratch in Rust",
  "source": "https://github.com/HelixDB/helix-db",
  "checks": [
    {
      "type": "binary",
      "name": "helixdb"
    }
  ],
  "install_guidance": {
    "plugin": "helium-db",
    "binary": "helixdb",
    "check": "which helixdb",
    "install_steps": [
      "cargo install helixdb",
      "Verify: helixdb --version",
      "supercli plugins install ./plugins/helium-db --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "helium-db",
    "resource": "self",
    "action": "version",
    "description": "Print helium-db version",
    "adapter": "process",
    "adapterConfig": {
      "command": "helixdb",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install helium-db: cargo install helixdb"
    },
    "args": []
  },
  {
    "namespace": "helium-db",
    "resource": "server",
    "action": "start",
    "description": "Start the HelixDB server",
    "adapter": "process",
    "adapterConfig": {
      "command": "helixdb",
      "passthrough": true,
      "missingDependencyHelp": "Install helium-db: cargo install helixdb"
    },
    "args": []
  },
  {
    "namespace": "helium-db",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to helixdb CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "helixdb",
      "passthrough": true,
      "missingDependencyHelp": "Install helium-db"
    },
    "args": []
  }
]
}