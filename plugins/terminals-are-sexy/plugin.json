{
  "name": "terminals-are-sexy",
  "version": "0.1.0",
  "description": "Terminal frameworks, plugins & resources",
  "source": "https://github.com/k4m4/terminals-are-sexy#readme",
  "checks": [
    {
      "type": "binary",
      "name": "terminals-are-sexy"
    }
  ],
  "install_guidance": {
    "plugin": "terminals-are-sexy",
    "binary": "terminals-are-sexy",
    "check": "which terminals-are-sexy",
    "install_steps": [
      "See https://github.com/k4m4/terminals-are-sexy#readme",
      "Verify: terminals-are-sexy --version",
      "supercli plugins install ./plugins/terminals-are-sexy --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "terminals-are-sexy",
      "resource": "self",
      "action": "version",
      "description": "Print terminals-are-sexy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "terminals-are-sexy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install terminals-are-sexy: See https://github.com/k4m4/terminals-are-sexy#readme"
      },
      "args": []
    },
    {
      "namespace": "terminals-are-sexy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to terminals-are-sexy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "terminals-are-sexy",
        "passthrough": true,
        "missingDependencyHelp": "Install terminals-are-sexy"
      },
      "args": []
    }
  ]
}