{
  "name": "lwp-dump",
  "version": "0.1.0",
  "description": "CLI tool: lwp-dump",
  "source": "https://manpages.debian.org/lwp-dump",
  "checks": [
    {
      "type": "binary",
      "name": "lwp-dump"
    }
  ],
  "install_guidance": {
    "plugin": "lwp-dump",
    "binary": "lwp-dump",
    "check": "which lwp-dump",
    "install_steps": [
      "apt-get install lwp-dump 2>/dev/null || which lwp-dump",
      "Verify: lwp-dump --version",
      "supercli plugins install ./plugins/lwp-dump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lwp-dump",
      "resource": "self",
      "action": "version",
      "description": "Print lwp-dump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lwp-dump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lwp-dump: apt-get install lwp-dump 2>/dev/null || which lwp-dump"
      },
      "args": []
    },
    {
      "namespace": "lwp-dump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lwp-dump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lwp-dump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lwp-dump: apt-get install lwp-dump 2>/dev/null || which lwp-dump"
      },
      "args": []
    }
  ]
}