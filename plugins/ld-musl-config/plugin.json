{
  "name": "ld-musl-config",
  "version": "0.1.0",
  "description": "CLI tool: ld-musl-config",
  "source": "https://manpages.debian.org/ld-musl-config",
  "checks": [
    {
      "type": "binary",
      "name": "ld-musl-config"
    }
  ],
  "install_guidance": {
    "plugin": "ld-musl-config",
    "binary": "ld-musl-config",
    "check": "which ld-musl-config",
    "install_steps": [
      "apt-get install ld-musl-config 2>/dev/null || which ld-musl-config",
      "Verify: ld-musl-config --version",
      "supercli plugins install ./plugins/ld-musl-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ld-musl-config",
      "resource": "self",
      "action": "version",
      "description": "Print ld-musl-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ld-musl-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ld-musl-config: apt-get install ld-musl-config 2>/dev/null || which ld-musl-config"
      },
      "args": []
    },
    {
      "namespace": "ld-musl-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ld-musl-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ld-musl-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ld-musl-config: apt-get install ld-musl-config 2>/dev/null || which ld-musl-config"
      },
      "args": []
    }
  ]
}