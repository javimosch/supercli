{
  "name": "kotlin-lsp",
  "version": "0.1.0",
  "description": "Kotlin Language Server and plugin for Visual Studio Code",
  "source": "https://github.com/kotlin-lsp/kotlin-lsp",
  "checks": [
    {
      "type": "binary",
      "name": "kotlin-lsp"
    }
  ],
  "install_guidance": {
    "plugin": "kotlin-lsp",
    "binary": "kotlin-lsp",
    "check": "which kotlin-lsp",
    "install_steps": [
      "pip install kotlin-lsp",
      "Verify: kotlin-lsp --version",
      "supercli plugins install ./plugins/kotlin-lsp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kotlin-lsp",
      "resource": "self",
      "action": "version",
      "description": "Print kotlin-lsp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kotlin-lsp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kotlin-lsp: pip install kotlin-lsp"
      },
      "args": []
    },
    {
      "namespace": "kotlin-lsp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kotlin-lsp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kotlin-lsp",
        "passthrough": true,
        "missingDependencyHelp": "Install kotlin-lsp: pip install kotlin-lsp"
      },
      "args": []
    }
  ]
}