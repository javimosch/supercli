{
  "name": "cracklib-format",
  "version": "0.1.0",
  "description": "cracklib-format — runtime support for password checker library cracklib2",
  "source": "https://github.com/cracklib/cracklib",
  "checks": [{ "type": "binary", "name": "cracklib-format" }],
  "install_guidance": {
    "plugin": "cracklib-format", "binary": "cracklib-format", "check": "which cracklib-format",
    "install_steps": ["apt-get install cracklib-format 2>/dev/null || which cracklib-format", "Verify: cracklib-format --version", "supercli plugins install ./plugins/cracklib-format --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cracklib-format", "resource": "_", "action": "_",
    "description": "Passthrough to cracklib-format CLI",
    "adapter": "process", "adapterConfig": { "command": "cracklib-format", "passthrough": true, "missingDependencyHelp": "Install cracklib-format: apt-get install cracklib-format" }, "args": []
  }]
}
