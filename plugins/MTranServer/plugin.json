{
  "name": "MTranServer",
  "version": "0.1.0",
  "description": "Offline translation model server with low resource consumption, fast speed, and private deployment c",
  "source": "https://github.com/MTranServer/MTranServer",
  "checks": [
    {
      "type": "binary",
      "name": "mtranserver"
    }
  ],
  "install_guidance": {
    "plugin": "MTranServer",
    "binary": "mtranserver",
    "check": "which mtranserver",
    "install_steps": [
      "pip install mtranserver",
      "Verify: mtranserver --version",
      "supercli plugins install ./plugins/MTranServer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MTranServer",
      "resource": "self",
      "action": "version",
      "description": "Print MTranServer version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtranserver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MTranServer: pip install mtranserver"
      },
      "args": []
    },
    {
      "namespace": "MTranServer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mtranserver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mtranserver",
        "passthrough": true,
        "missingDependencyHelp": "Install MTranServer: pip install mtranserver"
      },
      "args": []
    }
  ]
}