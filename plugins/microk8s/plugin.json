{
  "name": "microk8s",
  "version": "0.1.0",
  "description": "Lightweight Kubernetes for workstations and edge",
  "source": "https",
  "checks": [{"type": "binary", "name": "microk8s"}],
  "install_guidance": {
    "plugin": "microk8s",
    "binary": "microk8s",
    "check": "which microk8s",
    "install_steps": [
      "brew install microk8s",
      "Verify: microk8s --version",
      "supercli plugins install ./plugins/microk8s --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "microk8s",
      "resource": "self",
      "action": "version",
      "description": "Print microk8s version",
      "adapter": "process",
      "adapterConfig": {"command": "microk8s", "baseArgs": ["--version"], "missingDependencyHelp": "Install microk8s: brew install microk8s"},
      "args": []
    },
    {
      "namespace": "microk8s",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to microk8s CLI",
      "adapter": "process",
      "adapterConfig": {"command": "microk8s", "passthrough": true, "missingDependencyHelp": "Install microk8s: brew install microk8s"},
      "args": []
    }
  ]
}
