{
  "name": "sqllineage",
  "version": "0.1.0",
  "description": "sqllineage \u2014 SQL lineage analysis tool. Track column-level dependencies in SQL queries.",
  "source": "https://github.com/reata/sqllineage",
  "checks": [
    {
      "type": "binary",
      "name": "sqllineage"
    }
  ],
  "install_guidance": {
    "plugin": "sqllineage",
    "binary": "sqllineage",
    "check": "which sqllineage",
    "install_steps": [
      "pip install sqllineage",
      "supercli plugins install ./plugins/sqllineage --on-conflict replace --json"
    ],
    "note": "Python. SQL lineage analysis."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sqllineage",
      "resource": "sql",
      "action": "analyze",
      "description": "Analyze SQL query lineage",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqllineage",
        "missingDependencyHelp": "Install sqllineage",
        "baseArgs": [
          "-f"
        ],
        "positionalArgs": [
          "file"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "file",
          "type": "string",
          "required": true,
          "description": "file path"
        }
      ]
    },
    {
      "namespace": "sqllineage",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqllineage",
        "missingDependencyHelp": "Install sqllineage",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
