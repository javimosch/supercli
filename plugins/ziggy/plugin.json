{
  "name": "ziggy",
  "version": "0.1.0",
  "description": "A data serialization language for expressing clear API messages, config files, etc.",
  "source": "https://github.com/ziggy/ziggy",
  "checks": [
    {
      "type": "binary",
      "name": "ziggy"
    }
  ],
  "install_guidance": {
    "plugin": "ziggy",
    "binary": "ziggy",
    "check": "which ziggy",
    "install_steps": [
      "pip install ziggy",
      "Verify: ziggy --version",
      "supercli plugins install ./plugins/ziggy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ziggy",
      "resource": "self",
      "action": "version",
      "description": "Print ziggy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ziggy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ziggy: pip install ziggy"
      },
      "args": []
    },
    {
      "namespace": "ziggy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ziggy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ziggy",
        "passthrough": true,
        "missingDependencyHelp": "Install ziggy: pip install ziggy"
      },
      "args": []
    }
  ]
}