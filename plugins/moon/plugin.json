{
  "name": "moon",
  "version": "0.1.0",
  "description": "Task runner and monorepo management tool",
  "source": "https://github.com/moonrepo/moon",
  "checks": [{ "type": "binary", "name": "moon" }],
  "install_guidance": {
    "plugin": "moon",
    "binary": "moon",
    "check": "which moon",
    "install_steps": ["npm install -g @moonrepo/cli", "Verify: moon --version", "supercli plugins install ./plugins/moon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "moon",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to moon CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "moon",
      "passthrough": true,
      "missingDependencyHelp": "Install moon: npm install -g @moonrepo/cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
