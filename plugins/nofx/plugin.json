{
  "name": "nofx",
  "version": "0.1.0",
  "description": "Your AI trading terminal assistant for US stocks, commodities, forex, and crypto.",
  "source": "https://github.com/nofx/nofx",
  "checks": [
    {
      "type": "binary",
      "name": "nofx"
    }
  ],
  "install_guidance": {
    "plugin": "nofx",
    "binary": "nofx",
    "check": "which nofx",
    "install_steps": [
      "pip install nofx",
      "Verify: nofx --version",
      "supercli plugins install ./plugins/nofx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "nofx",
      "resource": "self",
      "action": "version",
      "description": "Print nofx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nofx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install nofx: pip install nofx"
      },
      "args": []
    },
    {
      "namespace": "nofx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nofx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nofx",
        "passthrough": true,
        "missingDependencyHelp": "Install nofx: pip install nofx"
      },
      "args": []
    }
  ]
}