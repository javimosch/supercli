{
  "name": "komikku",
  "version": "0.1.0",
  "description": "Free and open source manga reader for Android",
  "source": "https://github.com/komikku/komikku",
  "checks": [
    {
      "type": "binary",
      "name": "komikku"
    }
  ],
  "install_guidance": {
    "plugin": "komikku",
    "binary": "komikku",
    "check": "which komikku",
    "install_steps": [
      "pip install komikku",
      "Verify: komikku --version",
      "supercli plugins install ./plugins/komikku --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "komikku",
      "resource": "self",
      "action": "version",
      "description": "Print komikku version",
      "adapter": "process",
      "adapterConfig": {
        "command": "komikku",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install komikku: pip install komikku"
      },
      "args": []
    },
    {
      "namespace": "komikku",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to komikku CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "komikku",
        "passthrough": true,
        "missingDependencyHelp": "Install komikku: pip install komikku"
      },
      "args": []
    }
  ]
}