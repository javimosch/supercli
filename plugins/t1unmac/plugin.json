{
  "name": "t1unmac",
  "version": "0.1.0",
  "description": "CLI tool: t1unmac",
  "source": "https://manpages.debian.org/t1unmac",
  "checks": [
    {
      "type": "binary",
      "name": "t1unmac"
    }
  ],
  "install_guidance": {
    "plugin": "t1unmac",
    "binary": "t1unmac",
    "check": "which t1unmac",
    "install_steps": [
      "apt-get install t1unmac 2>/dev/null || which t1unmac",
      "Verify: t1unmac --version",
      "supercli plugins install ./plugins/t1unmac --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "t1unmac",
      "resource": "self",
      "action": "version",
      "description": "Print t1unmac version",
      "adapter": "process",
      "adapterConfig": {
        "command": "t1unmac",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install t1unmac: apt-get install t1unmac 2>/dev/null || which t1unmac"
      },
      "args": []
    },
    {
      "namespace": "t1unmac",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to t1unmac CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "t1unmac",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install t1unmac: apt-get install t1unmac 2>/dev/null || which t1unmac"
      },
      "args": []
    }
  ]
}