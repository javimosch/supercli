{
  "name": "vrc-get",
  "version": "0.1.0",
  "description": "A VRChat package manager CLI for managing Unity assets and mods. Downloads, updates, and organizes VRChat community content from the command line.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "vrc-get"
    }
  ],
  "install_guidance": {
    "plugin": "vrc-get",
    "binary": "vrc-get",
    "check": "which vrc-get",
    "install_steps": [
      "cargo install vrc-get",
      "Verify: vrc-get --version",
      "supercli plugins install ./plugins/vrc-get --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vrc-get",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vrc-get CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vrc-get",
        "passthrough": true,
        "missingDependencyHelp": "Install vrc-get: cargo install vrc-get"
      },
      "args": []
    }
  ]
}
