{
  "name": "enca",
  "version": "0.1.0",
  "description": "Detect file encoding and convert",
  "source": "https://packages.debian.org/enca",
  "checks": [
    { "type": "binary", "name": "enca" }
  ],
  "install_guidance": {
    "plugin": "enca",
    "binary": "enca",
    "check": "which enca",
    "install_steps": [
      "apt-get install enca",
      "Verify: enca --version",
      "supercli plugins install ./plugins/enca --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "enca",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to enca CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "enca",
        "passthrough": true,
        "missingDependencyHelp": "Install enca: apt-get install enca"
      },
      "args": []
    }
  ]
}
