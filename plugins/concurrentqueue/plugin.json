{
  "name": "concurrentqueue",
  "version": "0.1.0",
  "description": "Fast multi-producer, multi-consumer lock-free concurrent queue for C++11",
  "source": "https://github.com/cameron314/concurrentqueue",
  "checks": [
    {
      "type": "binary",
      "name": "concurrentqueue"
    }
  ],
  "install_guidance": {
    "plugin": "concurrentqueue",
    "binary": "concurrentqueue",
    "check": "which concurrentqueue",
    "install_steps": [
      "brew install concurrentqueue",
      "Verify: concurrentqueue --version",
      "supercli plugins install ./plugins/concurrentqueue --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "concurrentqueue",
      "resource": "self",
      "action": "version",
      "description": "Print concurrentqueue version",
      "adapter": "process",
      "adapterConfig": {
        "command": "concurrentqueue",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install concurrentqueue: brew install concurrentqueue"
      },
      "args": []
    },
    {
      "namespace": "concurrentqueue",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to concurrentqueue CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "concurrentqueue",
        "passthrough": true,
        "missingDependencyHelp": "Install concurrentqueue"
      },
      "args": []
    }
  ]
}