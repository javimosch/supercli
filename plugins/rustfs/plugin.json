{
  "name": "rustfs",
  "version": "0.1.0",
  "description": "\ud83d\ude802.3x faster than MinIO for 4KB object payloads. RustFS is an open-source, S3-compatible high-perfor",
  "source": "https://github.com/rustfs/rustfs",
  "checks": [
    {
      "type": "binary",
      "name": "rustfs"
    }
  ],
  "install_guidance": {
    "plugin": "rustfs",
    "binary": "rustfs",
    "check": "which rustfs",
    "install_steps": [
      "pip install rustfs",
      "Verify: rustfs --version",
      "supercli plugins install ./plugins/rustfs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rustfs",
      "resource": "self",
      "action": "version",
      "description": "Print rustfs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rustfs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rustfs: pip install rustfs"
      },
      "args": []
    },
    {
      "namespace": "rustfs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rustfs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rustfs",
        "passthrough": true,
        "missingDependencyHelp": "Install rustfs: pip install rustfs"
      },
      "args": []
    }
  ]
}