{
  "name": "gffread",
  "version": "0.1.0",
  "description": "GFF/GTF format conversions, region filtering, FASTA sequence extraction",
  "source": "https://github.com/gpertea/gffread",
  "checks": [
    {
      "type": "binary",
      "name": "gffread"
    }
  ],
  "install_guidance": {
    "plugin": "gffread",
    "binary": "gffread",
    "check": "which gffread",
    "install_steps": [
      "brew install gffread",
      "Verify: gffread --version",
      "supercli plugins install ./plugins/gffread --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gffread",
      "resource": "self",
      "action": "version",
      "description": "Print gffread version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gffread",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gffread: brew install gffread"
      },
      "args": []
    },
    {
      "namespace": "gffread",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gffread CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gffread",
        "passthrough": true,
        "missingDependencyHelp": "Install gffread"
      },
      "args": []
    }
  ]
}