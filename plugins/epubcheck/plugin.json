{
  "name": "epubcheck",
  "version": "1.0.0",
  "description": "epubcheck \u2014 EPUB validator",
  "source": "github.com/w3c/epubcheck",
  "checks": [
    {
      "type": "binary",
      "name": "epubcheck"
    }
  ],
  "install_guidance": {
    "plugin": "epubcheck",
    "binary": "epubcheck",
    "check": "which epubcheck",
    "install_steps": [
      "# Install epubcheck",
      "# See github.com/w3c/epubcheck",
      "# apt: sudo apt-get install epubcheck",
      "# brew: brew install epubcheck",
      "# cargo: cargo install epubcheck",
      "# npm: npm install -g epubcheck",
      "# pip: pip install epubcheck"
    ]
  },
  "commands": [
    {
      "namespace": "epubcheck",
      "resource": "epubcheck",
      "action": "run",
      "description": "Run epubcheck",
      "adapter": "process",
      "adapterConfig": {
        "command": "epubcheck",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install epubcheck from github.com/w3c/epubcheck"
      },
      "args": []
    }
  ]
}