{
  "name": "renameutils",
  "version": "0.1.0",
  "description": "Mass renaming in your editor",
  "checks": [
    {
      "type": "binary",
      "name": "renameutils"
    }
  ],
  "install_guidance": {
    "plugin": "renameutils",
    "binary": "renameutils",
    "check": "which renameutils",
    "install_steps": [
      "brew install renameutils",
      "Verify: renameutils --version",
      "supercli plugins install ./plugins/renameutils --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "renameutils",
      "resource": "self",
      "action": "version",
      "description": "Print renameutils version",
      "adapter": "process",
      "adapterConfig": {
        "command": "renameutils",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install renameutils: brew install renameutils"
      },
      "args": []
    },
    {
      "namespace": "renameutils",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to renameutils CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "renameutils",
        "passthrough": true,
        "missingDependencyHelp": "Install renameutils"
      },
      "args": []
    }
  ]
}