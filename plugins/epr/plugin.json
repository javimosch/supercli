{
  "name": "epr",
  "version": "0.1.0",
  "description": "Terminal EPUB reader with clean interface",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "epr" }],
  "install_guidance": {
    "plugin": "epr",
    "binary": "epr",
    "check": "which epr",
    "install_steps": ["pip install epr-reader", "Verify: epr --version", "supercli plugins install ./plugins/epr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "epr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to epr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "epr",
      "passthrough": true,
      "missingDependencyHelp": "Install epr: pip install epr-reader"
    },
    "args": []
  }]
}
