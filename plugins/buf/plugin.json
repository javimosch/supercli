{
  "name": "buf",
  "version": "0.1.0",
  "description": "Protocol Buffers tool with linting, breaking change detection and generation",
  "source": "https://github.com/bufbuild/buf",
  "checks": [{ "type": "binary", "name": "buf" }],
  "install_guidance": {
    "plugin": "buf",
    "binary": "buf",
    "check": "which buf",
    "install_steps": ["brew install bufbuild/buf/buf", "Verify: buf --version", "supercli plugins install ./plugins/buf --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "buf",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to buf CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "buf",
      "passthrough": true,
      "missingDependencyHelp": "Install buf: brew install bufbuild/buf/buf"
    },
    "args": []
  }]
}
