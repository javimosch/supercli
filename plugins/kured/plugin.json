{
  "name": "kured",
  "version": "0.1.0",
  "description": "Kubernetes Reboot Daemon - cordon and drain nodes for reboots",
  "source": "https://github.com/kubereboot/kured",
  "checks": [{ "type": "binary", "name": "kured" }],
  "install_guidance": {
    "plugin": "kured",
    "binary": "kured",
    "check": "which kured",
    "install_steps": ["brew install kured", "Verify: kured --version", "supercli plugins install ./plugins/kured --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kured",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kured CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kured",
      "passthrough": true,
      "missingDependencyHelp": "Install kured: brew install kured"
    },
    "args": []
  }]
}
