{
  "name": "RCLI",
  "version": "0.1.0",
  "description": "Talk to your Mac, query your docs, no cloud required. On-device voice AI + RAG",
  "source": "https://github.com/RCLI/RCLI",
  "checks": [
    {
      "type": "binary",
      "name": "rcli"
    }
  ],
  "install_guidance": {
    "plugin": "RCLI",
    "binary": "rcli",
    "check": "which rcli",
    "install_steps": [
      "pip install rcli",
      "Verify: rcli --version",
      "supercli plugins install ./plugins/RCLI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "RCLI",
      "resource": "self",
      "action": "version",
      "description": "Print RCLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install RCLI: pip install rcli"
      },
      "args": []
    },
    {
      "namespace": "RCLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rcli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rcli",
        "passthrough": true,
        "missingDependencyHelp": "Install RCLI: pip install rcli"
      },
      "args": []
    }
  ]
}