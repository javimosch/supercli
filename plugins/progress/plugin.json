{
  "name": "progress",
  "version": "1.0.0",
  "description": "progress \u2014 Show progress of coreutils",
  "source": "github.com/Xfennec/progress",
  "checks": [
    {
      "type": "binary",
      "name": "progress"
    }
  ],
  "install_guidance": {
    "plugin": "progress",
    "binary": "progress",
    "check": "which progress",
    "install_steps": [
      "# Install progress:",
      "# apt: sudo apt-get install progress",
      "# brew: brew install progress",
      "# cargo: cargo install progress",
      "# npm: npm install -g progress",
      "# pip: pip install progress",
      "# or download from github.com/Xfennec/progress"
    ]
  },
  "commands": [
    {
      "namespace": "progress",
      "resource": "progress",
      "action": "run",
      "description": "Run progress",
      "adapter": "process",
      "adapterConfig": {
        "command": "progress",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install progress from github.com/Xfennec/progress"
      },
      "args": []
    }
  ]
}