{
  "name": "progress",
  "version": "0.1.0",
  "description": "progress \u2014 view progress of running coreutils commands (cp, mv, dd, tar, cat, rsync, grep, find, sort).",
  "source": "https://github.com/Xfennec/progress",
  "checks": [
    {
      "type": "binary",
      "name": "progress"
    }
  ],
  "install_guidance": {
    "plugin": "progress",
    "binary": "progress",
    "check": "which progress",
    "install_steps": [
      "sudo apt-get install progress",
      "brew install progress",
      "supercli plugins install ./plugins/progress --on-conflict replace --json"
    ],
    "note": "Linux / macOS. Shows progress of coreutils commands."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "progress",
      "resource": "process",
      "action": "monitor",
      "description": "Show progress of running coreutils commands",
      "adapter": "process",
      "adapterConfig": {
        "command": "progress",
        "missingDependencyHelp": "Install progress",
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "progress",
      "resource": "process",
      "action": "watch",
      "description": "Watch progress continuously",
      "adapter": "process",
      "adapterConfig": {
        "command": "progress",
        "missingDependencyHelp": "Install progress",
        "baseArgs": [
          "-M"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": []
    },
    {
      "namespace": "progress",
      "resource": "self",
      "action": "version",
      "description": "Print progress version",
      "adapter": "process",
      "adapterConfig": {
        "command": "progress",
        "missingDependencyHelp": "Install progress",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
