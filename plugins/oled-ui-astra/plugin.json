{
  "name": "oled-ui-astra",
  "version": "0.1.0",
  "description": "A smooth, easy-to-deploy, and easy-to-extend OLED UI framework, based on C++.",
  "source": "https://github.com/oled-ui-astra/oled-ui-astra",
  "checks": [
    {
      "type": "binary",
      "name": "oled-ui-astra"
    }
  ],
  "install_guidance": {
    "plugin": "oled-ui-astra",
    "binary": "oled-ui-astra",
    "check": "which oled-ui-astra",
    "install_steps": [
      "pip install oled-ui-astra",
      "Verify: oled-ui-astra --version",
      "supercli plugins install ./plugins/oled-ui-astra --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "oled-ui-astra",
      "resource": "self",
      "action": "version",
      "description": "Print oled-ui-astra version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oled-ui-astra",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oled-ui-astra: pip install oled-ui-astra"
      },
      "args": []
    },
    {
      "namespace": "oled-ui-astra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oled-ui-astra CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oled-ui-astra",
        "passthrough": true,
        "missingDependencyHelp": "Install oled-ui-astra: pip install oled-ui-astra"
      },
      "args": []
    }
  ]
}