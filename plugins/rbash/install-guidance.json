{
  "plugin": "rbash",
  "binary": "rbash",
  "check": "which rbash",
  "install_steps": [
    "# Install rbash",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/rbash-linux-amd64 -o /usr/local/bin/rbash",
    "chmod +x /usr/local/bin/rbash",
    "# Or via package manager, see /usr/bin/rbash"
  ]
}