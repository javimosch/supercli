{
  "name": "rbash",
  "version": "1.0.0",
  "description": "rbash \u2014 rbash \u2014 CLI utility",
  "source": "/usr/bin/rbash",
  "checks": [
    {
      "type": "binary",
      "name": "rbash"
    }
  ],
  "install_guidance": {
    "plugin": "rbash",
    "binary": "rbash",
    "check": "which rbash",
    "install_steps": [
      "# Install rbash:",
      "# apt: sudo apt-get install rbash",
      "# brew: brew install rbash",
      "# cargo: cargo install rbash",
      "# npm: npm install -g rbash",
      "# pip: pip install rbash",
      "# or download from /usr/bin/rbash"
    ]
  },
  "commands": [
    {
      "namespace": "rbash",
      "resource": "rbash",
      "action": "run",
      "description": "Run rbash",
      "adapter": "process",
      "adapterConfig": {
        "command": "rbash",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install rbash from /usr/bin/rbash"
      },
      "args": []
    }
  ]
}