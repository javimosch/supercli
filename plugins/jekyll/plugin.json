{
  "name": "jekyll",
  "version": "0.1.0",
  "description": "Static site generator for blogs and docs",
  "source": "https",
  "checks": [{"type": "binary", "name": "jekyll"}],
  "install_guidance": {
    "plugin": "jekyll",
    "binary": "jekyll",
    "check": "which jekyll",
    "install_steps": [
      "brew install jekyll",
      "Verify: jekyll --version",
      "supercli plugins install ./plugins/jekyll --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "jekyll",
      "resource": "self",
      "action": "version",
      "description": "Print jekyll version",
      "adapter": "process",
      "adapterConfig": {"command": "jekyll", "baseArgs": ["--version"], "missingDependencyHelp": "Install jekyll: brew install jekyll"},
      "args": []
    },
    {
      "namespace": "jekyll",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jekyll CLI",
      "adapter": "process",
      "adapterConfig": {"command": "jekyll", "passthrough": true, "missingDependencyHelp": "Install jekyll: brew install jekyll"},
      "args": []
    }
  ]
}
