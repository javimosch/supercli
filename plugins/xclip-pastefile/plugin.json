{
  "name": "xclip-pastefile",
  "version": "0.1.0",
  "description": "CLI tool: xclip-pastefile",
  "source": "https://manpages.debian.org/xclip-pastefile",
  "checks": [
    {
      "type": "binary",
      "name": "xclip-pastefile"
    }
  ],
  "install_guidance": {
    "plugin": "xclip-pastefile",
    "binary": "xclip-pastefile",
    "check": "which xclip-pastefile",
    "install_steps": [
      "apt-get install xclip-pastefile 2>/dev/null || which xclip-pastefile",
      "Verify: xclip-pastefile --version",
      "supercli plugins install ./plugins/xclip-pastefile --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xclip-pastefile",
      "resource": "self",
      "action": "version",
      "description": "Print xclip-pastefile version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xclip-pastefile",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xclip-pastefile: apt-get install xclip-pastefile 2>/dev/null || which xclip-pastefile"
      },
      "args": []
    },
    {
      "namespace": "xclip-pastefile",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xclip-pastefile CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xclip-pastefile",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xclip-pastefile: apt-get install xclip-pastefile 2>/dev/null || which xclip-pastefile"
      },
      "args": []
    }
  ]
}