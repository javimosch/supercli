{
  "name": "fernflower",
  "version": "0.1.0",
  "description": "Java decompiler headless mode",
  "source": "https://github.com/JetBrains/intellij-community/tree/master/plugins/java-decompiler/engine",
  "checks": [
    {
      "type": "binary",
      "name": "fernflower"
    }
  ],
  "install_guidance": {
    "plugin": "fernflower",
    "binary": "fernflower",
    "check": "which fernflower",
    "install_steps": [
      "brew install fernflower",
      "Verify: fernflower --version",
      "supercli plugins install ./plugins/fernflower --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "fernflower",
      "resource": "self",
      "action": "version",
      "description": "Print fernflower version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fernflower",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fernflower: brew install fernflower"
      },
      "args": []
    },
    {
      "namespace": "fernflower",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fernflower CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fernflower",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fernflower: brew install fernflower"
      },
      "args": []
    }
  ]
}
