{
  "name": "cksum",
  "version": "0.1.0",
  "description": "cksum — CRC checksum computation",
  "source": "https",
  "checks": [
    {
      "type": "binary",
      "name": "cksum"
    }
  ],
  "install_guidance": {
    "plugin": "cksum",
    "binary": "cksum",
    "check": "which cksum",
    "install_steps": [
      "brew install coreutils",
      "supercli plugins install ./plugins/cksum --on-conflict replace --json"
    ],
    "note": "Standard system utility."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cksum",
      "resource": "self",
      "action": "version",
      "description": "Print cksum version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cksum",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cksum: brew install coreutils"
      },
      "args": []
    },
    {
      "namespace": "cksum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cksum CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cksum",
        "passthrough": true,
        "missingDependencyHelp": "Install cksum: brew install coreutils"
      },
      "args": []
    }
  ]
}
