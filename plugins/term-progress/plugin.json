{
  "name": "term-progress",
  "version": "0.1.0",
  "description": "Simple progress bar for shell scripts in Go",
  "source": "https://github.com/isacikgoz/term-progress",
  "checks": [{ "type": "binary", "name": "term-progress" }],
  "install_guidance": {
    "plugin": "term-progress",
    "binary": "term-progress",
    "check": "which term-progress",
    "install_steps": ["go install github.com/isacikgoz/term-progress@latest", "Verify: term-progress --version", "supercli plugins install ./plugins/term-progress --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "term-progress",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to term-progress CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "term-progress",
      "passthrough": true,
      "missingDependencyHelp": "Install term-progress: go install github.com/isacikgoz/term-progress@latest", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
