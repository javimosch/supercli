{
  "name": "2to3",
  "version": "0.1.0",
  "description": "CLI tool: 2to3",
  "source": "https://manpages.debian.org/2to3",
  "checks": [
    {
      "type": "binary",
      "name": "2to3"
    }
  ],
  "install_guidance": {
    "plugin": "2to3",
    "binary": "2to3",
    "check": "which 2to3",
    "install_steps": [
      "apt-get install 2to3 2>/dev/null || which 2to3",
      "Verify: 2to3 --version",
      "supercli plugins install ./plugins/2to3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "2to3",
      "resource": "self",
      "action": "version",
      "description": "Print 2to3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "2to3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install 2to3: apt-get install 2to3 2>/dev/null || which 2to3"
      },
      "args": []
    },
    {
      "namespace": "2to3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to 2to3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "2to3",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install 2to3: apt-get install 2to3 2>/dev/null || which 2to3"
      },
      "args": []
    }
  ]
}