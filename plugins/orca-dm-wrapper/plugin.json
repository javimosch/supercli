{
  "name": "orca-dm-wrapper",
  "version": "0.1.0",
  "description": "CLI tool: orca-dm-wrapper",
  "source": "https://manpages.debian.org/orca-dm-wrapper",
  "checks": [
    {
      "type": "binary",
      "name": "orca-dm-wrapper"
    }
  ],
  "install_guidance": {
    "plugin": "orca-dm-wrapper",
    "binary": "orca-dm-wrapper",
    "check": "which orca-dm-wrapper",
    "install_steps": [
      "apt-get install orca-dm-wrapper 2>/dev/null || which orca-dm-wrapper",
      "Verify: orca-dm-wrapper --version",
      "supercli plugins install ./plugins/orca-dm-wrapper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "orca-dm-wrapper",
      "resource": "self",
      "action": "version",
      "description": "Print orca-dm-wrapper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "orca-dm-wrapper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install orca-dm-wrapper: apt-get install orca-dm-wrapper 2>/dev/null || which orca-dm-wrapper"
      },
      "args": []
    },
    {
      "namespace": "orca-dm-wrapper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to orca-dm-wrapper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "orca-dm-wrapper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install orca-dm-wrapper: apt-get install orca-dm-wrapper 2>/dev/null || which orca-dm-wrapper"
      },
      "args": []
    }
  ]
}