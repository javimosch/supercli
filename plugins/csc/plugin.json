{
  "name": "csc",
  "version": "0.1.0",
  "description": "csc — Practical and portable Scheme system - compiler",
  "source": "http://www.call-cc.org",
  "checks": [{ "type": "binary", "name": "csc" }],
  "install_guidance": {
    "plugin": "csc", "binary": "csc", "check": "which csc",
    "install_steps": ["apt-get install chicken-bin 2>/dev/null || which csc", "Verify: csc --version", "supercli plugins install ./plugins/csc --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "csc", "resource": "_", "action": "_",
    "description": "Passthrough to csc CLI",
    "adapter": "process", "adapterConfig": { "command": "csc", "passthrough": true, "missingDependencyHelp": "Install csc: apt-get install chicken-bin" }, "args": []
  }]
}
