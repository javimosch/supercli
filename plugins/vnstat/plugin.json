{
  "name": "vnstat",
  "version": "0.1.0",
  "description": "Network traffic monitor and bandwidth usage tracker",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "vnstat" }],
  "install_guidance": {
    "plugin": "vnstat",
    "binary": "vnstat",
    "check": "which vnstat",
    "install_steps": ["apt-get install vnstat", "which vnstat", "Verify: vnstat --version", "supercli plugins install ./plugins/vnstat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vnstat",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vnstat CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vnstat",
      "passthrough": true,
      "missingDependencyHelp": "Install vnstat: apt-get install vnstat"
    },
    "args": []
  }]
}
