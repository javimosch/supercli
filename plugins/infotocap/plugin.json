{
  "name": "infotocap",
  "version": "0.1.0",
  "description": "CLI tool: infotocap",
  "source": "https://manpages.debian.org/infotocap",
  "checks": [
    {
      "type": "binary",
      "name": "infotocap"
    }
  ],
  "install_guidance": {
    "plugin": "infotocap",
    "binary": "infotocap",
    "check": "which infotocap",
    "install_steps": [
      "apt-get install infotocap 2>/dev/null || which infotocap",
      "Verify: infotocap --version",
      "supercli plugins install ./plugins/infotocap --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "infotocap",
      "resource": "self",
      "action": "version",
      "description": "Print infotocap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "infotocap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install infotocap: apt-get install infotocap 2>/dev/null || which infotocap"
      },
      "args": []
    },
    {
      "namespace": "infotocap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to infotocap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "infotocap",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install infotocap: apt-get install infotocap 2>/dev/null || which infotocap"
      },
      "args": []
    }
  ]
}