{
  "name": "prezip-bin",
  "version": "0.1.0",
  "description": "CLI tool: prezip-bin",
  "source": "https://manpages.debian.org/prezip-bin",
  "checks": [
    {
      "type": "binary",
      "name": "prezip-bin"
    }
  ],
  "install_guidance": {
    "plugin": "prezip-bin",
    "binary": "prezip-bin",
    "check": "which prezip-bin",
    "install_steps": [
      "apt-get install prezip-bin 2>/dev/null || which prezip-bin",
      "Verify: prezip-bin --version",
      "supercli plugins install ./plugins/prezip-bin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "prezip-bin",
      "resource": "self",
      "action": "version",
      "description": "Print prezip-bin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "prezip-bin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install prezip-bin: apt-get install prezip-bin 2>/dev/null || which prezip-bin"
      },
      "args": []
    },
    {
      "namespace": "prezip-bin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to prezip-bin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "prezip-bin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install prezip-bin: apt-get install prezip-bin 2>/dev/null || which prezip-bin"
      },
      "args": []
    }
  ]
}