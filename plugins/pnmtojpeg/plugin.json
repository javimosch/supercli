{
  "name": "pnmtojpeg",
  "version": "0.1.0",
  "description": "CLI tool: pnmtojpeg",
  "source": "https://manpages.debian.org/pnmtojpeg",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtojpeg"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtojpeg",
    "binary": "pnmtojpeg",
    "check": "which pnmtojpeg",
    "install_steps": [
      "apt-get install pnmtojpeg 2>/dev/null || which pnmtojpeg",
      "Verify: pnmtojpeg --version",
      "supercli plugins install ./plugins/pnmtojpeg --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtojpeg",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtojpeg version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtojpeg",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtojpeg: apt-get install pnmtojpeg 2>/dev/null || which pnmtojpeg"
      },
      "args": []
    },
    {
      "namespace": "pnmtojpeg",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtojpeg CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtojpeg",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtojpeg: apt-get install pnmtojpeg 2>/dev/null || which pnmtojpeg"
      },
      "args": []
    }
  ]
}