{
  "name": "con2toml",
  "version": "0.1.0",
  "description": "INi to TOML configuration file converter",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "con2toml" }],
  "install_guidance": {
    "plugin": "con2toml",
    "binary": "con2toml",
    "check": "which con2toml",
    "install_steps": ["pip install con2toml", "Verify: con2toml --version", "supercli plugins install ./plugins/con2toml --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "con2toml",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to con2toml CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "con2toml",
      "passthrough": true,
      "missingDependencyHelp": "Install con2toml: pip install con2toml"
    },
    "args": []
  }]
}
