{
  "name": "xdg-dbus-proxy",
  "version": "0.1.0",
  "description": "CLI tool: xdg-dbus-proxy",
  "source": "https://manpages.debian.org/xdg-dbus-proxy",
  "checks": [
    {
      "type": "binary",
      "name": "xdg-dbus-proxy"
    }
  ],
  "install_guidance": {
    "plugin": "xdg-dbus-proxy",
    "binary": "xdg-dbus-proxy",
    "check": "which xdg-dbus-proxy",
    "install_steps": [
      "apt-get install xdg-dbus-proxy 2>/dev/null || which xdg-dbus-proxy",
      "Verify: xdg-dbus-proxy --version",
      "supercli plugins install ./plugins/xdg-dbus-proxy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xdg-dbus-proxy",
      "resource": "self",
      "action": "version",
      "description": "Print xdg-dbus-proxy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdg-dbus-proxy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xdg-dbus-proxy: apt-get install xdg-dbus-proxy 2>/dev/null || which xdg-dbus-proxy"
      },
      "args": []
    },
    {
      "namespace": "xdg-dbus-proxy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xdg-dbus-proxy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xdg-dbus-proxy",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xdg-dbus-proxy: apt-get install xdg-dbus-proxy 2>/dev/null || which xdg-dbus-proxy"
      },
      "args": []
    }
  ]
}