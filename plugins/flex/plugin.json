{
  "name": "flex",
  "version": "1.0.0",
  "description": "flex \u2014 Fast lexical analyzer",
  "source": "github.com/westes/flex",
  "checks": [
    {
      "type": "binary",
      "name": "flex"
    }
  ],
  "install_guidance": {
    "plugin": "flex",
    "binary": "flex",
    "check": "which flex",
    "install_steps": [
      "# Install flex",
      "# See github.com/westes/flex",
      "# apt: sudo apt-get install flex",
      "# brew: brew install flex",
      "# cargo: cargo install flex",
      "# npm: npm install -g flex",
      "# pip: pip install flex"
    ]
  },
  "commands": [
    {
      "namespace": "flex",
      "resource": "flex",
      "action": "run",
      "description": "Run flex",
      "adapter": "process",
      "adapterConfig": {
        "command": "flex",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install flex from github.com/westes/flex"
      },
      "args": []
    }
  ]
}