{
  "name": "Duix-Avatar",
  "version": "0.1.0",
  "description": "\ud83d\ude80 Truly open-source AI avatar(digital human) toolkit for offline video generation and digital human ",
  "source": "https://github.com/Duix-Avatar/Duix-Avatar",
  "checks": [
    {
      "type": "binary",
      "name": "duix-avatar"
    }
  ],
  "install_guidance": {
    "plugin": "Duix-Avatar",
    "binary": "duix-avatar",
    "check": "which duix-avatar",
    "install_steps": [
      "pip install duix-avatar",
      "Verify: duix-avatar --version",
      "supercli plugins install ./plugins/Duix-Avatar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Duix-Avatar",
      "resource": "self",
      "action": "version",
      "description": "Print Duix-Avatar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "duix-avatar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Duix-Avatar: pip install duix-avatar"
      },
      "args": []
    },
    {
      "namespace": "Duix-Avatar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to duix-avatar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "duix-avatar",
        "passthrough": true,
        "missingDependencyHelp": "Install Duix-Avatar: pip install duix-avatar"
      },
      "args": []
    }
  ]
}