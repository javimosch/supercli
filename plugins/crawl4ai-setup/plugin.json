{
  "name": "crawl4ai-setup",
  "version": "0.1.0",
  "description": "CLI tool: crawl4ai-setup",
  "source": "https://packages.debian.org/crawl4ai-setup",
  "checks": [{ "type": "binary", "name": "crawl4ai-setup" }],
  "install_guidance": {
    "plugin": "crawl4ai-setup", "binary": "crawl4ai-setup", "check": "which crawl4ai-setup",
    "install_steps": ["apt-get install crawl4ai-setup 2>/dev/null || which crawl4ai-setup", "Verify: crawl4ai-setup --version", "supercli plugins install ./plugins/crawl4ai-setup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "crawl4ai-setup", "resource": "_", "action": "_",
    "description": "Passthrough to crawl4ai-setup CLI",
    "adapter": "process", "adapterConfig": { "command": "crawl4ai-setup", "passthrough": true, "missingDependencyHelp": "Install crawl4ai-setup: apt-get install crawl4ai-setup" }, "args": []
  }]
}
