{
  "plugin": "ptar",
  "binary": "ptar",
  "check": "which ptar",
  "install_steps": [
    "# Install ptar",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ptar-linux-amd64 -o /usr/local/bin/ptar",
    "chmod +x /usr/local/bin/ptar",
    "# Or via package manager, see /usr/bin/ptar"
  ]
}