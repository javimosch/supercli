{
  "name": "adk-go",
  "version": "0.1.0",
  "description": "An open-source, code-first Go toolkit for building, evaluating, and deploying sophisticated AI agent",
  "source": "https://github.com/adk-go/adk-go",
  "checks": [
    {
      "type": "binary",
      "name": "adk-go"
    }
  ],
  "install_guidance": {
    "plugin": "adk-go",
    "binary": "adk-go",
    "check": "which adk-go",
    "install_steps": [
      "pip install adk-go",
      "Verify: adk-go --version",
      "supercli plugins install ./plugins/adk-go --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "adk-go",
      "resource": "self",
      "action": "version",
      "description": "Print adk-go version",
      "adapter": "process",
      "adapterConfig": {
        "command": "adk-go",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install adk-go: pip install adk-go"
      },
      "args": []
    },
    {
      "namespace": "adk-go",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to adk-go CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "adk-go",
        "passthrough": true,
        "missingDependencyHelp": "Install adk-go: pip install adk-go"
      },
      "args": []
    }
  ]
}