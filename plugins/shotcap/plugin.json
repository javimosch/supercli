{
  "name": "shotcap",
  "version": "0.1.0",
  "description": "Feature-rich screenshot tool with C++ implementation",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "shotcap" }],
  "install_guidance": {
    "plugin": "shotcap",
    "binary": "shotcap",
    "check": "which shotcap",
    "install_steps": ["git clone && cmake . && make", "Verify: shotcap --version", "supercli plugins install ./plugins/shotcap --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "shotcap",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to shotcap CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "shotcap",
      "passthrough": true,
      "missingDependencyHelp": "Install shotcap: git clone && cmake . && make"
    },
    "args": []
  }]
}
