{
  "name": "pdd",
  "version": "0.1.0",
  "description": "Tiny date/time diff calculator in Python",
  "source": "https://github.com/nicedoc/pdd",
  "checks": [
    {
      "type": "binary",
      "name": "pdd"
    }
  ],
  "install_guidance": {
    "plugin": "pdd",
    "binary": "pdd",
    "check": "which pdd",
    "install_steps": [
      "pip install pdd",
      "Verify: pdd --version",
      "supercli plugins install ./plugins/pdd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdd",
      "resource": "self",
      "action": "version",
      "description": "Print pdd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdd: pip install pdd"
      },
      "args": []
    },
    {
      "namespace": "pdd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pdd: pip install pdd"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
