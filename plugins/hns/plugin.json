{
  "name": "hns",
  "version": "0.1.0",
  "description": "Speech-to-text tool to transcribe voice from microphone",
  "source": "https://github.com/primaprashant/hns",
  "checks": [
    {
      "type": "binary",
      "name": "hns"
    }
  ],
  "install_guidance": {
    "plugin": "hns",
    "binary": "hns",
    "check": "which hns",
    "install_steps": [
      "See https://github.com/primaprashant/hns",
      "Verify: hns --version",
      "supercli plugins install ./plugins/hns --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "hns",
      "resource": "self",
      "action": "version",
      "description": "Print hns version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hns",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hns: See https://github.com/primaprashant/hns"
      },
      "args": []
    },
    {
      "namespace": "hns",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hns CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hns",
        "passthrough": true,
        "missingDependencyHelp": "Install hns"
      },
      "args": []
    }
  ]
}