{
  "name": "astroterm",
  "version": "0.1.0",
  "description": "Real-time celestial planetarium for the terminal",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "astroterm" }],
  "install_guidance": {
    "plugin": "astroterm",
    "binary": "astroterm",
    "check": "which astroterm",
    "install_steps": ["brew install astroterm", "Verify: astroterm --version", "supercli plugins install ./plugins/astroterm --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "astroterm",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to astroterm CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "astroterm",
      "passthrough": true,
      "missingDependencyHelp": "Install astroterm: brew install astroterm"
    },
    "args": []
  }]
}
