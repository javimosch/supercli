{
  "name": "psql",
  "version": "1.0.0",
  "description": "psql \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=psql+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "psql"
    }
  ],
  "install_guidance": {
    "plugin": "psql",
    "binary": "psql",
    "check": "which psql",
    "install_steps": [
      "Install psql via package manager: apt install psql or brew install psql"
    ]
  },
  "commands": [
    {
      "namespace": "psql",
      "resource": "run",
      "action": "exec",
      "description": "psql \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "psql",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install psql via your package manager"
      },
      "args": []
    }
  ]
}