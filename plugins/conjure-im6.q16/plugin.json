{
  "name": "conjure-im6.q16",
  "version": "0.1.0",
  "description": "CLI tool: conjure-im6.q16",
  "source": "https://manpages.debian.org/conjure-im6.q16",
  "checks": [
    {
      "type": "binary",
      "name": "conjure-im6.q16"
    }
  ],
  "install_guidance": {
    "plugin": "conjure-im6.q16",
    "binary": "conjure-im6.q16",
    "check": "which conjure-im6.q16",
    "install_steps": [
      "apt-get install conjure-im6.q16 2>/dev/null || which conjure-im6.q16",
      "Verify: conjure-im6.q16 --version",
      "supercli plugins install ./plugins/conjure-im6.q16 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "conjure-im6.q16",
      "resource": "self",
      "action": "version",
      "description": "Print conjure-im6.q16 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "conjure-im6.q16",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install conjure-im6.q16: apt-get install conjure-im6.q16 2>/dev/null || which conjure-im6.q16"
      },
      "args": []
    },
    {
      "namespace": "conjure-im6.q16",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to conjure-im6.q16 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "conjure-im6.q16",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install conjure-im6.q16: apt-get install conjure-im6.q16 2>/dev/null || which conjure-im6.q16"
      },
      "args": []
    }
  ]
}