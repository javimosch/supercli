{
  "name": "ldapmodrdn",
  "version": "0.1.0",
  "description": "CLI tool: ldapmodrdn",
  "source": "https://manpages.debian.org/ldapmodrdn",
  "checks": [
    {
      "type": "binary",
      "name": "ldapmodrdn"
    }
  ],
  "install_guidance": {
    "plugin": "ldapmodrdn",
    "binary": "ldapmodrdn",
    "check": "which ldapmodrdn",
    "install_steps": [
      "apt-get install ldapmodrdn 2>/dev/null || which ldapmodrdn",
      "Verify: ldapmodrdn --version",
      "supercli plugins install ./plugins/ldapmodrdn --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ldapmodrdn",
      "resource": "self",
      "action": "version",
      "description": "Print ldapmodrdn version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapmodrdn",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ldapmodrdn: apt-get install ldapmodrdn 2>/dev/null || which ldapmodrdn"
      },
      "args": []
    },
    {
      "namespace": "ldapmodrdn",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ldapmodrdn CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ldapmodrdn",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ldapmodrdn: apt-get install ldapmodrdn 2>/dev/null || which ldapmodrdn"
      },
      "args": []
    }
  ]
}