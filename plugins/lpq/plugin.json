{
  "name": "lpq",
  "version": "0.1.0",
  "description": "Show printer queue status",
  "source": "https://packages.debian.org/lpq",
  "checks": [{ "type": "binary", "name": "lpq" }],
  "install_guidance": {
    "plugin": "lpq", "binary": "lpq", "check": "which lpq",
    "install_steps": ["apt-get install cups-bsd", "Verify: lpq --version", "supercli plugins install ./plugins/lpq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lpq", "resource": "_", "action": "_",
    "description": "Passthrough to lpq CLI",
    "adapter": "process", "adapterConfig": { "command": "lpq", "passthrough": true, "missingDependencyHelp": "Install lpq: apt-get install cups-bsd" }, "args": []
  }]
}
