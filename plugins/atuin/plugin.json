{
  "name": "atuin",
  "version": "0.1.0",
  "description": "Atuin — shell history sync and search tool with encrypted storage",
  "source": "https://github.com/atuinsh/atuin",
  "checks": [
    {
      "type": "binary",
      "name": "atuin"
    }
  ],
  "install_guidance": {
    "plugin": "atuin",
    "binary": "atuin",
    "check": "which atuin",
    "install_steps": [
      "brew install atuin",
      "Verify: atuin --version",
      "supercli plugins install ./plugins/atuin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "atuin",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "atuin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install atuin"
      },
      "args": []
    }
  ]
}
