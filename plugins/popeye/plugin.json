{
  "name": "popeye",
  "version": "0.1.0",
  "description": "Kubernetes cluster sanitizer with --ci mode",
  "source": "https://github.com/derailed/popeye",
  "checks": [
    {
      "type": "binary",
      "name": "popeye"
    }
  ],
  "install_guidance": {
    "plugin": "popeye",
    "binary": "popeye",
    "check": "which popeye",
    "install_steps": [
      "brew install popeye",
      "Verify: popeye --version",
      "supercli plugins install ./plugins/popeye --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "popeye",
      "resource": "self",
      "action": "version",
      "description": "Print popeye version",
      "adapter": "process",
      "adapterConfig": {
        "command": "popeye",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install popeye: brew install popeye"
      },
      "args": []
    },
    {
      "namespace": "popeye",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to popeye CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "popeye",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install popeye: brew install popeye"
      },
      "args": []
    }
  ]
}
