{
  "name": "pl2pm",
  "version": "1.0.0",
  "description": "pl2pm \u2014 pl2pm \u2014 CLI utility",
  "source": "/usr/bin/pl2pm",
  "checks": [
    {
      "type": "binary",
      "name": "pl2pm"
    }
  ],
  "install_guidance": {
    "plugin": "pl2pm",
    "binary": "pl2pm",
    "check": "which pl2pm",
    "install_steps": [
      "# Install pl2pm:",
      "# apt: sudo apt-get install pl2pm",
      "# brew: brew install pl2pm",
      "# cargo: cargo install pl2pm",
      "# npm: npm install -g pl2pm",
      "# pip: pip install pl2pm",
      "# or download from /usr/bin/pl2pm"
    ]
  },
  "commands": [
    {
      "namespace": "pl2pm",
      "resource": "pl2pm",
      "action": "run",
      "description": "Run pl2pm",
      "adapter": "process",
      "adapterConfig": {
        "command": "pl2pm",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pl2pm from /usr/bin/pl2pm"
      },
      "args": []
    }
  ]
}