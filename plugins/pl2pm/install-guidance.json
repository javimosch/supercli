{
  "plugin": "pl2pm",
  "binary": "pl2pm",
  "check": "which pl2pm",
  "install_steps": [
    "# Install pl2pm",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pl2pm-linux-amd64 -o /usr/local/bin/pl2pm",
    "chmod +x /usr/local/bin/pl2pm",
    "# Or via package manager, see /usr/bin/pl2pm"
  ]
}