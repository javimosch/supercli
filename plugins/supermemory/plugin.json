{
  "name": "supermemory",
  "version": "0.1.0",
  "description": "Memory engine and app that is extremely fast, scalable. The Memory API for the AI era.",
  "source": "https://github.com/supermemory/supermemory",
  "checks": [
    {
      "type": "binary",
      "name": "supermemory"
    }
  ],
  "install_guidance": {
    "plugin": "supermemory",
    "binary": "supermemory",
    "check": "which supermemory",
    "install_steps": [
      "pip install supermemory",
      "Verify: supermemory --version",
      "supercli plugins install ./plugins/supermemory --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "supermemory",
      "resource": "self",
      "action": "version",
      "description": "Print supermemory version",
      "adapter": "process",
      "adapterConfig": {
        "command": "supermemory",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install supermemory: pip install supermemory"
      },
      "args": []
    },
    {
      "namespace": "supermemory",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to supermemory CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "supermemory",
        "passthrough": true,
        "missingDependencyHelp": "Install supermemory: pip install supermemory"
      },
      "args": []
    }
  ]
}