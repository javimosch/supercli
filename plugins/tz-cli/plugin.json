{
  "name": "tz-cli",
  "version": "0.1.0",
  "description": "Simple CLI for converting between timezones",
  "source": "https://github.com/skratchdot/tz-cli",
  "checks": [{ "type": "binary", "name": "tz-cli" }],
  "install_guidance": {
    "plugin": "tz-cli",
    "binary": "tz-cli",
    "check": "which tz-cli",
    "install_steps": ["npm install -g tz-cli", "Verify: tz-cli --version", "supercli plugins install ./plugins/tz-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tz-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tz-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tz-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install tz-cli: npm install -g tz-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
