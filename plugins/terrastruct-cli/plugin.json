{
  "name": "terrastruct-cli",
  "version": "0.1.0",
  "description": "Declarative diagram engine for technical documentation",
  "source": "https://github.com/terrastruct/terrastruct",
  "checks": [{ "type": "binary", "name": "terrastruct-cli" }],
  "install_guidance": {
    "plugin": "terrastruct-cli",
    "binary": "terrastruct-cli",
    "check": "which terrastruct-cli",
    "install_steps": ["binary release", "Verify: terrastruct-cli --version", "supercli plugins install ./plugins/terrastruct-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "terrastruct-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to terrastruct-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "terrastruct-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install terrastruct-cli: binary release", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
