{
  "name": "azure-devops-cli-extension-yaml",
  "version": "0.1.0",
  "description": "Azure Pipelines YAML showing how to install and configure the Azure DevOps Extension to the Azure CLI",
  "source": "https://github.com/azure-devops-cli-extension-yaml/azure-devops-cli-extension-yaml",
  "checks": [
    {
      "type": "binary",
      "name": "azure-devops-cli-extension-yaml"
    }
  ],
  "install_guidance": {
    "plugin": "azure-devops-cli-extension-yaml",
    "binary": "azure-devops-cli-extension-yaml",
    "check": "which azure-devops-cli-extension-yaml",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: azure-devops-cli-extension-yaml --version",
      "supercli plugins install ./plugins/azure-devops-cli-extension-yaml --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "azure-devops-cli-extension-yaml",
      "resource": "self",
      "action": "version",
      "description": "Print azure-devops-cli-extension-yaml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "azure-devops-cli-extension-yaml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install azure-devops-cli-extension-yaml from project repository"
      },
      "args": []
    },
    {
      "namespace": "azure-devops-cli-extension-yaml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to azure-devops-cli-extension-yaml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "azure-devops-cli-extension-yaml",
        "passthrough": true,
        "missingDependencyHelp": "Install azure-devops-cli-extension-yaml from project repository"
      },
      "args": []
    }
  ]
}