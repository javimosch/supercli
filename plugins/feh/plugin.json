{
  "name": "feh",
  "version": "1.0.0",
  "description": "feh \u2014 Image viewer",
  "source": "feh.finalrewind.org",
  "checks": [
    {
      "type": "binary",
      "name": "feh"
    }
  ],
  "install_guidance": {
    "plugin": "feh",
    "binary": "feh",
    "check": "which feh",
    "install_steps": [
      "# Install feh",
      "# See feh.finalrewind.org",
      "# apt: sudo apt-get install feh",
      "# brew: brew install feh",
      "# cargo: cargo install feh",
      "# npm: npm install -g feh",
      "# pip: pip install feh"
    ]
  },
  "commands": [
    {
      "namespace": "feh",
      "resource": "feh",
      "action": "run",
      "description": "Run feh",
      "adapter": "process",
      "adapterConfig": {
        "command": "feh",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install feh from feh.finalrewind.org"
      },
      "args": []
    }
  ]
}