{
  "name": "awesome-llm-apps",
  "version": "0.1.0",
  "description": "100+ AI Agent & RAG apps you can actually run \u2014 clone, customize, ship.",
  "source": "https://github.com/awesome-llm-apps/awesome-llm-apps",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-llm-apps"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-llm-apps",
    "binary": "awesome-llm-apps",
    "check": "which awesome-llm-apps",
    "install_steps": [
      "pip install awesome-llm-apps",
      "Verify: awesome-llm-apps --version",
      "supercli plugins install ./plugins/awesome-llm-apps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-llm-apps",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-llm-apps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-llm-apps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-llm-apps: pip install awesome-llm-apps"
      },
      "args": []
    },
    {
      "namespace": "awesome-llm-apps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-llm-apps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-llm-apps",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-llm-apps: pip install awesome-llm-apps"
      },
      "args": []
    }
  ]
}