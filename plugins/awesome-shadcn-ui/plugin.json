{
  "name": "awesome-shadcn-ui",
  "version": "0.1.0",
  "description": "A curated list of awesome things related to shadcn/ui.",
  "source": "https://github.com/awesome-shadcn-ui/awesome-shadcn-ui",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-shadcn-ui"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-shadcn-ui",
    "binary": "awesome-shadcn-ui",
    "check": "which awesome-shadcn-ui",
    "install_steps": [
      "pip install awesome-shadcn-ui",
      "Verify: awesome-shadcn-ui --version",
      "supercli plugins install ./plugins/awesome-shadcn-ui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "awesome-shadcn-ui",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-shadcn-ui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-shadcn-ui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-shadcn-ui: pip install awesome-shadcn-ui"
      },
      "args": []
    },
    {
      "namespace": "awesome-shadcn-ui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-shadcn-ui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-shadcn-ui",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-shadcn-ui: pip install awesome-shadcn-ui"
      },
      "args": []
    }
  ]
}