{
  "name": "fixscribeps",
  "version": "0.1.0",
  "description": "CLI tool: fixscribeps",
  "source": "https://manpages.debian.org/fixscribeps",
  "checks": [
    {
      "type": "binary",
      "name": "fixscribeps"
    }
  ],
  "install_guidance": {
    "plugin": "fixscribeps",
    "binary": "fixscribeps",
    "check": "which fixscribeps",
    "install_steps": [
      "apt-get install fixscribeps 2>/dev/null || which fixscribeps",
      "Verify: fixscribeps --version",
      "supercli plugins install ./plugins/fixscribeps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixscribeps",
      "resource": "self",
      "action": "version",
      "description": "Print fixscribeps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixscribeps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixscribeps: apt-get install fixscribeps 2>/dev/null || which fixscribeps"
      },
      "args": []
    },
    {
      "namespace": "fixscribeps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixscribeps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixscribeps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixscribeps: apt-get install fixscribeps 2>/dev/null || which fixscribeps"
      },
      "args": []
    }
  ]
}