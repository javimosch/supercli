{
  "name": "OpenNJet",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/OpenNJet/OpenNJet",
  "checks": [
    {
      "type": "binary",
      "name": "opennjet"
    }
  ],
  "install_guidance": {
    "plugin": "OpenNJet",
    "binary": "opennjet",
    "check": "which opennjet",
    "install_steps": [
      "pip install opennjet",
      "Verify: opennjet --version",
      "supercli plugins install ./plugins/OpenNJet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenNJet",
      "resource": "self",
      "action": "version",
      "description": "Print OpenNJet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "opennjet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenNJet: pip install opennjet"
      },
      "args": []
    },
    {
      "namespace": "OpenNJet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to opennjet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "opennjet",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenNJet: pip install opennjet"
      },
      "args": []
    }
  ]
}