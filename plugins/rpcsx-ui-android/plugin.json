{
  "name": "rpcsx-ui-android",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/rpcsx-ui-android/rpcsx-ui-android",
  "checks": [
    {
      "type": "binary",
      "name": "rpcsx-ui-android"
    }
  ],
  "install_guidance": {
    "plugin": "rpcsx-ui-android",
    "binary": "rpcsx-ui-android",
    "check": "which rpcsx-ui-android",
    "install_steps": [
      "pip install rpcsx-ui-android",
      "Verify: rpcsx-ui-android --version",
      "supercli plugins install ./plugins/rpcsx-ui-android --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rpcsx-ui-android",
      "resource": "self",
      "action": "version",
      "description": "Print rpcsx-ui-android version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rpcsx-ui-android",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rpcsx-ui-android: pip install rpcsx-ui-android"
      },
      "args": []
    },
    {
      "namespace": "rpcsx-ui-android",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rpcsx-ui-android CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rpcsx-ui-android",
        "passthrough": true,
        "missingDependencyHelp": "Install rpcsx-ui-android: pip install rpcsx-ui-android"
      },
      "args": []
    }
  ]
}