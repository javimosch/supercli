{
  "name": "VxKex",
  "version": "0.1.0",
  "description": "Windows 7 API Extensions",
  "source": "https://github.com/VxKex/VxKex",
  "checks": [
    {
      "type": "binary",
      "name": "vxkex"
    }
  ],
  "install_guidance": {
    "plugin": "VxKex",
    "binary": "vxkex",
    "check": "which vxkex",
    "install_steps": [
      "pip install vxkex",
      "Verify: vxkex --version",
      "supercli plugins install ./plugins/VxKex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VxKex",
      "resource": "self",
      "action": "version",
      "description": "Print VxKex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vxkex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VxKex: pip install vxkex"
      },
      "args": []
    },
    {
      "namespace": "VxKex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vxkex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vxkex",
        "passthrough": true,
        "missingDependencyHelp": "Install VxKex: pip install vxkex"
      },
      "args": []
    }
  ]
}