{
  "name": "idris2",
  "version": "1.0.0",
  "description": "idris2 \u2014 Idris 2 language",
  "source": "idris2.org",
  "checks": [
    {
      "type": "binary",
      "name": "idris2"
    }
  ],
  "install_guidance": {
    "plugin": "idris2",
    "binary": "idris2",
    "check": "which idris2",
    "install_steps": [
      "# Install idris2",
      "# See idris2.org",
      "# apt: sudo apt-get install idris2",
      "# brew: brew install idris2",
      "# cargo: cargo install idris2",
      "# npm: npm install -g idris2",
      "# pip: pip install idris2"
    ]
  },
  "commands": [
    {
      "namespace": "idris2",
      "resource": "idris2",
      "action": "run",
      "description": "Run idris2",
      "adapter": "process",
      "adapterConfig": {
        "command": "idris2",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install idris2 from idris2.org"
      },
      "args": []
    }
  ]
