{
  "name": "mdproof",
  "version": "0.1.0",
  "description": "Standalone Rust-powered Markdown to PDF converter",
  "source": "https://github.com/Geemili/mdproof",
  "checks": [{ "type": "binary", "name": "mdproof" }],
  "install_guidance": {
    "plugin": "mdproof",
    "binary": "mdproof",
    "check": "which mdproof",
    "install_steps": ["cargo install mdproof", "Verify: mdproof --version", "supercli plugins install ./plugins/mdproof --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdproof",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdproof CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdproof",
      "passthrough": true,
      "missingDependencyHelp": "Install mdproof: cargo install mdproof", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
