{
  "name": "agent-skills-md",
  "version": "0.1.0",
  "description": "Awesome list of agent skills for AI coding assistants — find reusable SKILL.md files for any development task",
  "source": "https://github.com/futantan/agent-skills.md",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "agent-skills-md",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/futantan/agent-skills.md.git",
      "supercli plugins install ./plugins/agent-skills-md --on-conflict replace --json",
      "sc skills teach agent-skills-md:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "agent-skills-md", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["agent-skills-md v0.1.0 — Use sc skills teach agent-skills-md:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/futantan/agent-skills.md.git" }, "args": [] },
    { "namespace": "agent-skills-md", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/futantan/agent-skills.md.git then: sc skills teach agent-skills-md:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/futantan/agent-skills.md.git" }, "args": [] }
  ]
}
