{
  "name": "tl-paper",
  "version": "0.1.0",
  "description": "CLI tool: tl-paper",
  "source": "https://manpages.debian.org/tl-paper",
  "checks": [
    {
      "type": "binary",
      "name": "tl-paper"
    }
  ],
  "install_guidance": {
    "plugin": "tl-paper",
    "binary": "tl-paper",
    "check": "which tl-paper",
    "install_steps": [
      "apt-get install tl-paper 2>/dev/null || which tl-paper",
      "Verify: tl-paper --version",
      "supercli plugins install ./plugins/tl-paper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tl-paper",
      "resource": "self",
      "action": "version",
      "description": "Print tl-paper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tl-paper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install tl-paper: apt-get install tl-paper 2>/dev/null || which tl-paper"
      },
      "args": []
    },
    {
      "namespace": "tl-paper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tl-paper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tl-paper",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install tl-paper: apt-get install tl-paper 2>/dev/null || which tl-paper"
      },
      "args": []
    }
  ]
}