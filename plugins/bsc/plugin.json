{
  "name": "bsc",
  "version": "0.1.0",
  "description": "Bluespec Compiler (BSC)",
  "source": "https://github.com/B-Lang-org/bsc",
  "checks": [
    {
      "type": "binary",
      "name": "bsc"
    }
  ],
  "install_guidance": {
    "plugin": "bsc",
    "binary": "bsc",
    "check": "which bsc",
    "install_steps": [
      "brew install bsc",
      "Verify: bsc --version",
      "supercli plugins install ./plugins/bsc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bsc",
      "resource": "self",
      "action": "version",
      "description": "Print bsc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bsc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bsc: brew install bsc"
      },
      "args": []
    },
    {
      "namespace": "bsc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bsc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bsc",
        "passthrough": true,
        "missingDependencyHelp": "Install bsc"
      },
      "args": []
    }
  ]
}