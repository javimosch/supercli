{
  "name": "verso",
  "version": "0.1.0",
  "description": "Mirror of https://gitlab.com/verso-browser/verso",
  "source": "https://github.com/verso/verso",
  "checks": [
    {
      "type": "binary",
      "name": "verso"
    }
  ],
  "install_guidance": {
    "plugin": "verso",
    "binary": "verso",
    "check": "which verso",
    "install_steps": [
      "pip install verso",
      "Verify: verso --version",
      "supercli plugins install ./plugins/verso --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "verso",
      "resource": "self",
      "action": "version",
      "description": "Print verso version",
      "adapter": "process",
      "adapterConfig": {
        "command": "verso",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install verso: pip install verso"
      },
      "args": []
    },
    {
      "namespace": "verso",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to verso CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "verso",
        "passthrough": true,
        "missingDependencyHelp": "Install verso: pip install verso"
      },
      "args": []
    }
  ]
}