{
  "name": "linguist",
  "version": "0.1.0",
  "description": "CLI tool: linguist",
  "source": "https://manpages.debian.org/linguist",
  "checks": [
    {
      "type": "binary",
      "name": "linguist"
    }
  ],
  "install_guidance": {
    "plugin": "linguist",
    "binary": "linguist",
    "check": "which linguist",
    "install_steps": [
      "apt-get install linguist 2>/dev/null || which linguist",
      "Verify: linguist --version",
      "supercli plugins install ./plugins/linguist --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "linguist",
      "resource": "self",
      "action": "version",
      "description": "Print linguist version",
      "adapter": "process",
      "adapterConfig": {
        "command": "linguist",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install linguist: apt-get install linguist 2>/dev/null || which linguist"
      },
      "args": []
    },
    {
      "namespace": "linguist",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to linguist CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "linguist",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install linguist: apt-get install linguist 2>/dev/null || which linguist"
      },
      "args": []
    }
  ]
}