{
  "name": "finch",
  "version": "0.1.0",
  "description": "Open source container development tool",
  "source": "https://github.com/runfinch/finch",
  "checks": [{ "type": "binary", "name": "finch" }],
  "install_guidance": {
    "plugin": "finch",
    "binary": "finch",
    "check": "which finch",
    "install_steps": ["brew install finch", "Verify: finch --version", "supercli plugins install ./plugins/finch --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "finch",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to finch CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "finch",
      "passthrough": true,
      "missingDependencyHelp": "Install finch: brew install finch"
    },
    "args": []
  }]
}
