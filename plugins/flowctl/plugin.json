{
  "name": "flowctl",
  "version": "1.0.0",
  "description": "flowctl \u2014 Flow control CLI",
  "source": "github.com/flow/flowctl",
  "checks": [
    {
      "type": "binary",
      "name": "flowctl"
    }
  ],
  "install_guidance": {
    "plugin": "flowctl",
    "binary": "flowctl",
    "check": "which flowctl",
    "install_steps": [
      "# Install flowctl",
      "# See github.com/flow/flowctl",
      "# apt: sudo apt-get install flowctl",
      "# brew: brew install flowctl",
      "# cargo: cargo install flowctl",
      "# npm: npm install -g flowctl",
      "# pip: pip install flowctl"
    ]
  },
  "commands": [
    {
      "namespace": "flowctl",
      "resource": "flowctl",
      "action": "run",
      "description": "Run flowctl",
      "adapter": "process",
      "adapterConfig": {
        "command": "flowctl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install flowctl from github.com/flow/flowctl"
      },
      "args": []
    }
  ]
}