{
  "name": "dot2gxl",
  "version": "0.1.0",
  "description": "CLI tool: dot2gxl",
  "source": "https://manpages.debian.org/dot2gxl",
  "checks": [
    {
      "type": "binary",
      "name": "dot2gxl"
    }
  ],
  "install_guidance": {
    "plugin": "dot2gxl",
    "binary": "dot2gxl",
    "check": "which dot2gxl",
    "install_steps": [
      "apt-get install dot2gxl 2>/dev/null || which dot2gxl",
      "Verify: dot2gxl --version",
      "supercli plugins install ./plugins/dot2gxl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dot2gxl",
      "resource": "self",
      "action": "version",
      "description": "Print dot2gxl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dot2gxl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dot2gxl: apt-get install dot2gxl 2>/dev/null || which dot2gxl"
      },
      "args": []
    },
    {
      "namespace": "dot2gxl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dot2gxl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dot2gxl",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dot2gxl: apt-get install dot2gxl 2>/dev/null || which dot2gxl"
      },
      "args": []
    }
  ]
}