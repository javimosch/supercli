{
  "name": "velero",
  "version": "0.1.0",
  "description": "Backup and migrate Kubernetes resources and persistent volumes",
  "source": "https://github.com/vmware-tanzu/velero",
  "checks": [{ "type": "binary", "name": "velero" }],
  "install_guidance": {
    "plugin": "velero",
    "binary": "velero",
    "check": "which velero",
    "install_steps": ["brew install velero", "Verify: velero --version", "supercli plugins install ./plugins/velero --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "velero",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to velero CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "velero",
      "passthrough": true,
      "missingDependencyHelp": "Install velero: brew install velero"
    },
    "args": []
  }]
}
