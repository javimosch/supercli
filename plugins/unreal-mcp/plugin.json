{
  "name": "unreal-mcp",
  "version": "0.1.0",
  "description": "Enable AI assistant clients like Cursor, Windsurf and Claude Desktop to control Unreal Engine throug",
  "source": "https://github.com/unreal-mcp/unreal-mcp",
  "checks": [
    {
      "type": "binary",
      "name": "unreal-mcp"
    }
  ],
  "install_guidance": {
    "plugin": "unreal-mcp",
    "binary": "unreal-mcp",
    "check": "which unreal-mcp",
    "install_steps": [
      "pip install unreal-mcp",
      "Verify: unreal-mcp --version",
      "supercli plugins install ./plugins/unreal-mcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unreal-mcp",
      "resource": "self",
      "action": "version",
      "description": "Print unreal-mcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unreal-mcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unreal-mcp: pip install unreal-mcp"
      },
      "args": []
    },
    {
      "namespace": "unreal-mcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unreal-mcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unreal-mcp",
        "passthrough": true,
        "missingDependencyHelp": "Install unreal-mcp: pip install unreal-mcp"
      },
      "args": []
    }
  ]
}