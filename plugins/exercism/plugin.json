{
  "name": "exercism",
  "version": "0.1.0",
  "description": "Command-line tool to interact with exercism.io",
  "checks": [
    {
      "type": "binary",
      "name": "exercism"
    }
  ],
  "install_guidance": {
    "plugin": "exercism",
    "binary": "exercism",
    "check": "which exercism",
    "install_steps": [
      "brew install exercism",
      "Verify: exercism --version",
      "supercli plugins install ./plugins/exercism --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "exercism",
      "resource": "self",
      "action": "version",
      "description": "Print exercism version",
      "adapter": "process",
      "adapterConfig": {
        "command": "exercism",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install exercism: brew install exercism"
      },
      "args": []
    },
    {
      "namespace": "exercism",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to exercism CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "exercism",
        "passthrough": true,
        "missingDependencyHelp": "Install exercism"
      },
      "args": []
    }
  ]
}