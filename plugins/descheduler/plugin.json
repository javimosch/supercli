{
  "name": "descheduler",
  "version": "0.1.0",
  "description": "Kubernetes descheduler for balancing pods across nodes",
  "source": "https://github.com/kubernetes-sigs/descheduler",
  "checks": [{ "type": "binary", "name": "descheduler" }],
  "install_guidance": {
    "plugin": "descheduler",
    "binary": "descheduler",
    "check": "which descheduler",
    "install_steps": ["brew install descheduler", "Verify: descheduler --version", "supercli plugins install ./plugins/descheduler --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "descheduler",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to descheduler CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "descheduler",
      "passthrough": true,
      "missingDependencyHelp": "Install descheduler: brew install descheduler"
    },
    "args": []
  }]
}
