{
  "name": "nbt-dump",
  "version": "0.1.0",
  "description": "Inspect and edit Minecraft NBT data format files",
  "source": "https://github.com/extremeheat/nbt-dump",
  "checks": [{ "type": "binary", "name": "nbt-dump" }],
  "install_guidance": {
    "plugin": "nbt-dump",
    "binary": "nbt-dump",
    "check": "which nbt-dump",
    "install_steps": ["cargo install nbt-dump", "Verify: nbt-dump --version", "supercli plugins install ./plugins/nbt-dump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "nbt-dump",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to nbt-dump CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "nbt-dump",
      "passthrough": true,
      "missingDependencyHelp": "Install nbt-dump: cargo install nbt-dump", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
