{
  "name": "tidy-viewer",
  "version": "0.1.0",
  "description": "A fast CSV viewer with colorized output, like head for CSV files. Displays tabular data with CJK and emoji support for quick terminal inspection.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "tidy-viewer"
    }
  ],
  "install_guidance": {
    "plugin": "tidy-viewer",
    "binary": "tidy-viewer",
    "check": "which tidy-viewer",
    "install_steps": [
      "cargo install tidy-viewer",
      "Verify: tidy-viewer --version",
      "supercli plugins install ./plugins/tidy-viewer --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tidy-viewer",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tidy-viewer CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tidy-viewer",
        "passthrough": true,
        "missingDependencyHelp": "Install tidy-viewer: cargo install tidy-viewer"
      },
      "args": []
    }
  ]
}
