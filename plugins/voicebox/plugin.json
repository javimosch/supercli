{
  "name": "voicebox",
  "version": "0.1.0",
  "description": "The open-source AI voice studio — clone, dictate, create",
  "source": "https://github.com/jamiepine/voicebox",
  "checks": [
    {
      "type": "binary",
      "name": "voicebox"
    }
  ],
  "install_guidance": {
    "plugin": "voicebox",
    "binary": "voicebox",
    "check": "which voicebox",
    "install_steps": [
      "npm install -g voicebox",
      "Verify: voicebox --version",
      "supercli plugins install ./plugins/voicebox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "voicebox",
    "resource": "self",
    "action": "version",
    "description": "Print voicebox version",
    "adapter": "process",
    "adapterConfig": {
      "command": "voicebox",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install voicebox: npm install -g voicebox"
    },
    "args": []
  },
  {
    "namespace": "voicebox",
    "resource": "voice",
    "action": "generate",
    "description": "Generate voice audio",
    "adapter": "process",
    "adapterConfig": {
      "command": "voicebox",
      "passthrough": true,
      "missingDependencyHelp": "Install voicebox: npm install -g voicebox"
    },
    "args": []
  },
  {
    "namespace": "voicebox",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to voicebox CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "voicebox",
      "passthrough": true,
      "missingDependencyHelp": "Install voicebox"
    },
    "args": []
  }
]
}