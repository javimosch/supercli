{
  "name": "voicebox",
  "version": "0.1.0",
  "description": "The open-source AI voice studio. Clone, dictate, create.",
  "source": "https://github.com/voicebox/voicebox",
  "checks": [
    {
      "type": "binary",
      "name": "voicebox"
    }
  ],
  "install_guidance": {
    "plugin": "voicebox",
    "binary": "voicebox",
    "check": "which voicebox",
    "install_steps": [
      "pip install voicebox",
      "Verify: voicebox --version",
      "supercli plugins install ./plugins/voicebox --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "voicebox",
      "resource": "self",
      "action": "version",
      "description": "Print voicebox version",
      "adapter": "process",
      "adapterConfig": {
        "command": "voicebox",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install voicebox: pip install voicebox"
      },
      "args": []
    },
    {
      "namespace": "voicebox",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to voicebox CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "voicebox",
        "passthrough": true,
        "missingDependencyHelp": "Install voicebox: pip install voicebox"
      },
      "args": []
    }
  ]
}