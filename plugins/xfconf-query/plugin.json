{
  "name": "xfconf-query",
  "version": "0.1.0",
  "description": "CLI tool: xfconf-query",
  "source": "https://manpages.debian.org/xfconf-query",
  "checks": [
    {
      "type": "binary",
      "name": "xfconf-query"
    }
  ],
  "install_guidance": {
    "plugin": "xfconf-query",
    "binary": "xfconf-query",
    "check": "which xfconf-query",
    "install_steps": [
      "apt-get install xfconf-query 2>/dev/null || which xfconf-query",
      "Verify: xfconf-query --version",
      "supercli plugins install ./plugins/xfconf-query --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xfconf-query",
      "resource": "self",
      "action": "version",
      "description": "Print xfconf-query version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfconf-query",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xfconf-query: apt-get install xfconf-query 2>/dev/null || which xfconf-query"
      },
      "args": []
    },
    {
      "namespace": "xfconf-query",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xfconf-query CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xfconf-query",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xfconf-query: apt-get install xfconf-query 2>/dev/null || which xfconf-query"
      },
      "args": []
    }
  ]
}