{
  "name": "pbmtonokia",
  "version": "0.1.0",
  "description": "CLI tool: pbmtonokia",
  "source": "https://manpages.debian.org/pbmtonokia",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtonokia"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtonokia",
    "binary": "pbmtonokia",
    "check": "which pbmtonokia",
    "install_steps": [
      "apt-get install pbmtonokia 2>/dev/null || which pbmtonokia",
      "Verify: pbmtonokia --version",
      "supercli plugins install ./plugins/pbmtonokia --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtonokia",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtonokia version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtonokia",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtonokia: apt-get install pbmtonokia 2>/dev/null || which pbmtonokia"
      },
      "args": []
    },
    {
      "namespace": "pbmtonokia",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtonokia CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtonokia",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtonokia: apt-get install pbmtonokia 2>/dev/null || which pbmtonokia"
      },
      "args": []
    }
  ]
}