{
  "name": "grafana-agent",
  "version": "0.1.0",
  "description": "Vendor-neutral telemetry collector for metrics, logs, and traces",
  "source": "https://github.com/grafana/agent",
  "checks": [{ "type": "binary", "name": "grafana-agent" }],
  "install_guidance": {
    "plugin": "grafana-agent",
    "binary": "grafana-agent",
    "check": "which grafana-agent",
    "install_steps": ["brew install grafana-agent", "Verify: grafana-agent --version", "supercli plugins install ./plugins/grafana-agent --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "grafana-agent",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to grafana-agent CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "grafana-agent",
      "passthrough": true,
      "missingDependencyHelp": "Install grafana-agent: brew install grafana-agent"
    },
    "args": []
  }]
}
