{
  "name": "kilocode",
  "version": "0.1.0",
  "description": "Kilo is the all-in-one agentic engineering platform. Build, ship, and iterate faster with the most p",
  "source": "https://github.com/kilocode/kilocode",
  "checks": [
    {
      "type": "binary",
      "name": "kilocode"
    }
  ],
  "install_guidance": {
    "plugin": "kilocode",
    "binary": "kilocode",
    "check": "which kilocode",
    "install_steps": [
      "pip install kilocode",
      "Verify: kilocode --version",
      "supercli plugins install ./plugins/kilocode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kilocode",
      "resource": "self",
      "action": "version",
      "description": "Print kilocode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kilocode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kilocode: pip install kilocode"
      },
      "args": []
    },
    {
      "namespace": "kilocode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kilocode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kilocode",
        "passthrough": true,
        "missingDependencyHelp": "Install kilocode: pip install kilocode"
      },
      "args": []
    }
  ]
}