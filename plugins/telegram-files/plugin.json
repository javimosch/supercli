{
  "name": "telegram-files",
  "version": "0.1.0",
  "description": "A self-hosted Telegram file downloader for continuous, stable, and unattended downloads.",
  "source": "https://github.com/telegram-files/telegram-files",
  "checks": [
    {
      "type": "binary",
      "name": "telegram-files"
    }
  ],
  "install_guidance": {
    "plugin": "telegram-files",
    "binary": "telegram-files",
    "check": "which telegram-files",
    "install_steps": [
      "pip install telegram-files",
      "Verify: telegram-files --version",
      "supercli plugins install ./plugins/telegram-files --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "telegram-files",
      "resource": "self",
      "action": "version",
      "description": "Print telegram-files version",
      "adapter": "process",
      "adapterConfig": {
        "command": "telegram-files",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install telegram-files: pip install telegram-files"
      },
      "args": []
    },
    {
      "namespace": "telegram-files",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to telegram-files CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "telegram-files",
        "passthrough": true,
        "missingDependencyHelp": "Install telegram-files: pip install telegram-files"
      },
      "args": []
    }
  ]
}