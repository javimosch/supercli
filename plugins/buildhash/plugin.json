{
  "name": "buildhash",
  "version": "0.1.0",
  "description": "CLI tool: buildhash",
  "source": "https://packages.debian.org/buildhash",
  "checks": [{ "type": "binary", "name": "buildhash" }],
  "install_guidance": {
    "plugin": "buildhash", "binary": "buildhash", "check": "which buildhash",
    "install_steps": ["apt-get install buildhash 2>/dev/null || which buildhash", "Verify: buildhash --version", "supercli plugins install ./plugins/buildhash --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "buildhash", "resource": "_", "action": "_",
    "description": "Passthrough to buildhash CLI",
    "adapter": "process", "adapterConfig": { "command": "buildhash", "passthrough": true, "missingDependencyHelp": "Install buildhash: apt-get install buildhash" }, "args": []
  }]
}
