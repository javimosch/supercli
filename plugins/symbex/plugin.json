{
  "name": "symbex",
  "version": "0.1.0",
  "description": "Search Python code for functions and classes",
  "source": "https://github.com/simonw/symbex",
  "checks": [{ "type": "binary", "name": "symbex" }],
  "install_guidance": {
    "plugin": "symbex",
    "binary": "symbex",
    "check": "which symbex",
    "install_steps": ["pip install symbex", "Verify: symbex --version", "supercli plugins install ./plugins/symbex --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "symbex",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to symbex CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "symbex",
      "passthrough": true,
      "missingDependencyHelp": "Install symbex: pip install symbex", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
