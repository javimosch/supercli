{
  "name": "pg_restore",
  "version": "0.1.0",
  "description": "PostgreSQL database restore",
  "source": "https://packages.debian.org/pg_restore",
  "checks": [{ "type": "binary", "name": "pg_restore" }],
  "install_guidance": {
    "plugin": "pg_restore", "binary": "pg_restore", "check": "which pg_restore",
    "install_steps": ["apt-get install postgresql-client", "Verify: pg_restore --version", "supercli plugins install ./plugins/pg_restore --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pg_restore", "resource": "_", "action": "_",
    "description": "Passthrough to pg_restore CLI",
    "adapter": "process", "adapterConfig": { "command": "pg_restore", "passthrough": true, "missingDependencyHelp": "Install pg_restore: apt-get install postgresql-client" }, "args": []
  }]
}
