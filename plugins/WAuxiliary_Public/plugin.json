{
  "name": "WAuxiliary_Public",
  "version": "0.1.0",
  "description": "WeChat Auxiliary Public",
  "source": "https://github.com/WAuxiliary_Public/WAuxiliary_Public",
  "checks": [
    {
      "type": "binary",
      "name": "wauxiliary-public"
    }
  ],
  "install_guidance": {
    "plugin": "WAuxiliary_Public",
    "binary": "wauxiliary-public",
    "check": "which wauxiliary-public",
    "install_steps": [
      "pip install wauxiliary-public",
      "Verify: wauxiliary-public --version",
      "supercli plugins install ./plugins/WAuxiliary_Public --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "WAuxiliary_Public",
      "resource": "self",
      "action": "version",
      "description": "Print WAuxiliary_Public version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wauxiliary-public",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install WAuxiliary_Public: pip install wauxiliary-public"
      },
      "args": []
    },
    {
      "namespace": "WAuxiliary_Public",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wauxiliary-public CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wauxiliary-public",
        "passthrough": true,
        "missingDependencyHelp": "Install WAuxiliary_Public: pip install wauxiliary-public"
      },
      "args": []
    }
  ]
}