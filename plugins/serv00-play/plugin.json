{
  "name": "serv00-play",
  "version": "0.1.0",
  "description": "serv00/hostuno \u4e0a\u7684\u4e00\u4e9b\u5e94\u7528\uff0c\u5305\u62ecargo+vmess/vmess+ws/hy2/socks5/mtproto/alist/\u54ea\u5412\u63a2\u9488|\u9762\u677f \u7b49, \u81ea\u52a8\u5316\u90e8\u7f72\u3001\u6279\u91cf\u4fdd\u53f7\u3001\u8fdb\u7a0b\u9632\u6740\u3001\u6d88\u606f\u63a8\u9001",
  "source": "https://github.com/serv00-play/serv00-play",
  "checks": [
    {
      "type": "binary",
      "name": "serv00-play"
    }
  ],
  "install_guidance": {
    "plugin": "serv00-play",
    "binary": "serv00-play",
    "check": "which serv00-play",
    "install_steps": [
      "pip install serv00-play",
      "Verify: serv00-play --version",
      "supercli plugins install ./plugins/serv00-play --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "serv00-play",
      "resource": "self",
      "action": "version",
      "description": "Print serv00-play version",
      "adapter": "process",
      "adapterConfig": {
        "command": "serv00-play",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install serv00-play: pip install serv00-play"
      },
      "args": []
    },
    {
      "namespace": "serv00-play",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to serv00-play CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "serv00-play",
        "passthrough": true,
        "missingDependencyHelp": "Install serv00-play: pip install serv00-play"
      },
      "args": []
    }
  ]
}