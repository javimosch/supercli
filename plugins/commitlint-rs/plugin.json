{
  "name": "commitlint-rs",
  "version": "0.1.0",
  "description": "Commit message linter in Rust with config",
  "source": "https://github.com/KeisukeYamashita/commitlint-rs",
  "checks": [{ "type": "binary", "name": "commitlint-rs" }],
  "install_guidance": {
    "plugin": "commitlint-rs",
    "binary": "commitlint-rs",
    "check": "which commitlint-rs",
    "install_steps": ["cargo install commitlint-rs", "Verify: commitlint-rs --version", "supercli plugins install ./plugins/commitlint-rs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "commitlint-rs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to commitlint-rs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "commitlint-rs",
      "passthrough": true,
      "missingDependencyHelp": "Install commitlint-rs: cargo install commitlint-rs", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
