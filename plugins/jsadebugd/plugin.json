{
  "name": "jsadebugd",
  "version": "0.1.0",
  "description": "jsadebugd \u2014 attaches to a Java process or core file and acts as a debug server. This command is experimental and unsupported",
  "source": "https://manpages.debian.org/jsadebugd",
  "checks": [
    {
      "type": "binary",
      "name": "jsadebugd"
    }
  ],
  "install_guidance": {
    "plugin": "jsadebugd",
    "binary": "jsadebugd",
    "check": "which jsadebugd",
    "install_steps": [
      "apt-get install jsadebugd 2>/dev/null || which jsadebugd",
      "Verify: jsadebugd --version",
      "supercli plugins install ./plugins/jsadebugd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "jsadebugd",
      "resource": "self",
      "action": "version",
      "description": "Print jsadebugd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsadebugd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install jsadebugd: apt-get install jsadebugd 2>/dev/null || which jsadebugd"
      },
      "args": []
    },
    {
      "namespace": "jsadebugd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to jsadebugd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "jsadebugd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install jsadebugd: apt-get install jsadebugd 2>/dev/null || which jsadebugd"
      },
      "args": []
    }
  ]
}