{
  "name": "envcmd",
  "version": "0.1.0",
  "description": "Run commands with environment variables from files",
  "source": "https://github.com/gabrielcsapo/envcmd",
  "checks": [{ "type": "binary", "name": "envcmd" }],
  "install_guidance": {
    "plugin": "envcmd",
    "binary": "envcmd",
    "check": "which envcmd",
    "install_steps": ["npm install -g envcmd", "Verify: envcmd --version", "supercli plugins install ./plugins/envcmd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "envcmd",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to envcmd CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "envcmd",
      "passthrough": true,
      "missingDependencyHelp": "Install envcmd: npm install -g envcmd", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
