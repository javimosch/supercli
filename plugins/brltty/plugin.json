{
  "name": "brltty",
  "version": "0.1.0",
  "description": "Access software for a blind person using a braille display",
  "source": "https://packages.debian.org/brltty",
  "checks": [{ "type": "binary", "name": "brltty" }],
  "install_guidance": {
    "plugin": "brltty", "binary": "brltty", "check": "which brltty",
    "install_steps": ["apt-get install brltty 2>/dev/null || which brltty", "Verify: brltty --version", "supercli plugins install ./plugins/brltty --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "brltty", "resource": "_", "action": "_",
    "description": "Passthrough to brltty CLI",
    "adapter": "process", "adapterConfig": { "command": "brltty", "passthrough": true, "missingDependencyHelp": "Install brltty: apt-get install brltty" }, "args": []
  }]
}
