{
  "name": "vivi-music",
  "version": "0.1.0",
  "description": "Vivi-Music is an expressive Material 3\u2013based YouTube Music client for Android.",
  "source": "https://github.com/vivi-music/vivi-music",
  "checks": [
    {
      "type": "binary",
      "name": "vivi-music"
    }
  ],
  "install_guidance": {
    "plugin": "vivi-music",
    "binary": "vivi-music",
    "check": "which vivi-music",
    "install_steps": [
      "pip install vivi-music",
      "Verify: vivi-music --version",
      "supercli plugins install ./plugins/vivi-music --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vivi-music",
      "resource": "self",
      "action": "version",
      "description": "Print vivi-music version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vivi-music",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vivi-music: pip install vivi-music"
      },
      "args": []
    },
    {
      "namespace": "vivi-music",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vivi-music CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vivi-music",
        "passthrough": true,
        "missingDependencyHelp": "Install vivi-music: pip install vivi-music"
      },
      "args": []
    }
  ]
}