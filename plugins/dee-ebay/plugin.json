{
  "name": "dee-ebay",
  "version": "0.1.0",
  "description": "Search eBay listings from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-ebay" }],
  "install_guidance": {
    "plugin": "dee-ebay",
    "binary": "dee-ebay",
    "check": "which dee-ebay",
    "install_steps": ["cargo install dee-ebay", "Verify: dee-ebay --version", "supercli plugins install ./plugins/dee-ebay --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-ebay",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-ebay CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-ebay",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-ebay: cargo install dee-ebay"
    },
    "args": []
  }]
}
