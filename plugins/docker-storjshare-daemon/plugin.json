{
  "name": "docker-storjshare-daemon",
  "version": "0.1.0",
  "description": "Unofficial Storjshare Daemon + CLI for farming data on the Storj network.",
  "source": "https://github.com/docker-storjshare-daemon/docker-storjshare-daemon",
  "checks": [
    {
      "type": "binary",
      "name": "docker-storjshare-daemon"
    }
  ],
  "install_guidance": {
    "plugin": "docker-storjshare-daemon",
    "binary": "docker-storjshare-daemon",
    "check": "which docker-storjshare-daemon",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: docker-storjshare-daemon --version",
      "supercli plugins install ./plugins/docker-storjshare-daemon --on-conflict replace --json"
    ],
    "note": "Shell language CLI tool"
  },
  "commands": [
    {
      "namespace": "docker-storjshare-daemon",
      "resource": "self",
      "action": "version",
      "description": "Print docker-storjshare-daemon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-storjshare-daemon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-storjshare-daemon from project repository"
      },
      "args": []
    },
    {
      "namespace": "docker-storjshare-daemon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-storjshare-daemon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-storjshare-daemon",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-storjshare-daemon from project repository"
      },
      "args": []
    }
  ]
}