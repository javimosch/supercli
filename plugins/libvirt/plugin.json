{
  "name": "libvirt",
  "version": "0.1.0",
  "description": "C virtualization API",
  "checks": [
    {
      "type": "binary",
      "name": "libvirt"
    }
  ],
  "install_guidance": {
    "plugin": "libvirt",
    "binary": "libvirt",
    "check": "which libvirt",
    "install_steps": [
      "brew install libvirt",
      "Verify: libvirt --version",
      "supercli plugins install ./plugins/libvirt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libvirt",
      "resource": "self",
      "action": "version",
      "description": "Print libvirt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libvirt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libvirt: brew install libvirt"
      },
      "args": []
    },
    {
      "namespace": "libvirt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libvirt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libvirt",
        "passthrough": true,
        "missingDependencyHelp": "Install libvirt"
      },
      "args": []
    }
  ]
}