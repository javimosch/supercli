{
  "name": "viewport-list-cli",
  "version": "0.1.0",
  "description": "Return a list of devices and their viewports",
  "source": "https://github.com/kevva/viewport-list-cli",
  "checks": [
    {
      "type": "binary",
      "name": "viewport-list-cli"
    }
  ],
  "install_guidance": {
    "plugin": "viewport-list-cli",
    "binary": "viewport-list-cli",
    "check": "which viewport-list-cli",
    "install_steps": [
      "See https://github.com/kevva/viewport-list-cli",
      "Verify: viewport-list-cli --version",
      "supercli plugins install ./plugins/viewport-list-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "viewport-list-cli",
      "resource": "self",
      "action": "version",
      "description": "Print viewport-list-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "viewport-list-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install viewport-list-cli: See https://github.com/kevva/viewport-list-cli"
      },
      "args": []
    },
    {
      "namespace": "viewport-list-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to viewport-list-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "viewport-list-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install viewport-list-cli"
      },
      "args": []
    }
  ]
}