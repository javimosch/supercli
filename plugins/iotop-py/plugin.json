{
  "name": "iotop-py",
  "version": "0.1.0",
  "description": "Python implementation of iotop for disk I/O monitoring",
  "source": "https://manpages.debian.org/iotop-py",
  "checks": [{ "type": "binary", "name": "iotop-py" }],
  "install_guidance": {
    "plugin": "iotop-py",
    "binary": "iotop-py",
    "check": "which iotop-py",
    "install_steps": [
      "pip install iotop-py",
      "Verify: iotop-py --version",
      "supercli plugins install ./plugins/iotop-py --on-conflict replace --json"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [{
    "namespace": "iotop-py",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to iotop-py CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "iotop-py",
      "passthrough": true,
      "missingDependencyHelp": "Install iotop-py: pip install iotop-py"
    },
    "args": []
  }]
}
