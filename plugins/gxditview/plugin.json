{
  "name": "gxditview",
  "version": "0.1.0",
  "description": "CLI tool: gxditview",
  "source": "https://manpages.debian.org/gxditview",
  "checks": [
    {
      "type": "binary",
      "name": "gxditview"
    }
  ],
  "install_guidance": {
    "plugin": "gxditview",
    "binary": "gxditview",
    "check": "which gxditview",
    "install_steps": [
      "apt-get install gxditview 2>/dev/null || which gxditview",
      "Verify: gxditview --version",
      "supercli plugins install ./plugins/gxditview --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gxditview",
      "resource": "self",
      "action": "version",
      "description": "Print gxditview version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gxditview",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gxditview: apt-get install gxditview 2>/dev/null || which gxditview"
      },
      "args": []
    },
    {
      "namespace": "gxditview",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gxditview CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gxditview",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gxditview: apt-get install gxditview 2>/dev/null || which gxditview"
      },
      "args": []
    }
  ]
}