{
  "name": "go-andotp",
  "version": "0.1.0",
  "description": "Encrypt and decrypt andOTP backup files",
  "source": "https://github.com/nicm/go-andotp",
  "checks": [
    {
      "type": "binary",
      "name": "go-andotp"
    }
  ],
  "install_guidance": {
    "plugin": "go-andotp",
    "binary": "go-andotp",
    "check": "which go-andotp",
    "install_steps": [
      "go install github.com/nicm/go-andotp@latest",
      "Verify: go-andotp --version"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "go-andotp",
      "resource": "self",
      "action": "version",
      "description": "Print go-andotp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-andotp",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install go-andotp: go install github.com/nicm/go-andotp@latest"
      },
      "args": []
    },
    {
      "namespace": "go-andotp",
      "resource": "backup",
      "action": "decrypt",
      "description": "Decrypt andOTP backup files",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-andotp",
        "baseArgs": [],
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install go-andotp: go install github.com/nicm/go-andotp@latest"
      },
      "args": []
    },
    {
      "namespace": "go-andotp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-andotp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-andotp",
        "passthrough": true,
        "missingDependencyHelp": "Install go-andotp: go install github.com/nicm/go-andotp@latest"
      },
      "args": []
    }
  ]
}