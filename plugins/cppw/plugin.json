{
  "name": "cppw",
  "version": "0.1.0",
  "description": "CLI tool: cppw",
  "source": "https://packages.debian.org/cppw",
  "checks": [{ "type": "binary", "name": "cppw" }],
  "install_guidance": {
    "plugin": "cppw", "binary": "cppw", "check": "which cppw",
    "install_steps": ["apt-get install cppw 2>/dev/null || which cppw", "Verify: cppw --version", "supercli plugins install ./plugins/cppw --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cppw", "resource": "_", "action": "_",
    "description": "Passthrough to cppw CLI",
    "adapter": "process", "adapterConfig": { "command": "cppw", "passthrough": true, "missingDependencyHelp": "Install cppw: apt-get install cppw" }, "args": []
  }]
}
