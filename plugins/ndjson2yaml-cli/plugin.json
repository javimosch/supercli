{
  "name": "ndjson2yaml-cli",
  "version": "0.1.0",
  "description": "Convert NDJSON streams to YAML from the command line.",
  "source": "https://github.com/ndjson2yaml-cli/ndjson2yaml-cli",
  "checks": [
    {
      "type": "binary",
      "name": "ndjson2yaml-cli"
    }
  ],
  "install_guidance": {
    "plugin": "ndjson2yaml-cli",
    "binary": "ndjson2yaml-cli",
    "check": "which ndjson2yaml-cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: ndjson2yaml-cli --version",
      "supercli plugins install ./plugins/ndjson2yaml-cli --on-conflict replace --json"
    ],
    "note": "JavaScript language CLI tool"
  },
  "commands": [
    {
      "namespace": "ndjson2yaml-cli",
      "resource": "self",
      "action": "version",
      "description": "Print ndjson2yaml-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ndjson2yaml-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ndjson2yaml-cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "ndjson2yaml-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ndjson2yaml-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ndjson2yaml-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install ndjson2yaml-cli from project repository"
      },
      "args": []
    }
  ]
}