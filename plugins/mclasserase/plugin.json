{
  "name": "mclasserase",
  "version": "0.1.0",
  "description": "CLI tool: mclasserase",
  "source": "https://manpages.debian.org/mclasserase",
  "checks": [
    {
      "type": "binary",
      "name": "mclasserase"
    }
  ],
  "install_guidance": {
    "plugin": "mclasserase",
    "binary": "mclasserase",
    "check": "which mclasserase",
    "install_steps": [
      "apt-get install mclasserase 2>/dev/null || which mclasserase",
      "Verify: mclasserase --version",
      "supercli plugins install ./plugins/mclasserase --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mclasserase",
      "resource": "self",
      "action": "version",
      "description": "Print mclasserase version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mclasserase",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mclasserase: apt-get install mclasserase 2>/dev/null || which mclasserase"
      },
      "args": []
    },
    {
      "namespace": "mclasserase",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mclasserase CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mclasserase",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mclasserase: apt-get install mclasserase 2>/dev/null || which mclasserase"
      },
      "args": []
    }
  ]
}