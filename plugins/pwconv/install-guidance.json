{
  "plugin": "pwconv",
  "binary": "pwconv",
  "check": "which pwconv",
  "install_steps": [
    "# Install pwconv",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pwconv-linux-amd64 -o /usr/local/bin/pwconv",
    "chmod +x /usr/local/bin/pwconv",
    "# Or via package manager, see /usr/sbin/pwconv"
  ]
}