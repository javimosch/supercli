{
  "name": "postqueue",
  "version": "1.0.0",
  "description": "postqueue \u2014 postqueue \u2014 CLI utility",
  "source": "/usr/sbin/postqueue",
  "checks": [
    {
      "type": "binary",
      "name": "postqueue"
    }
  ],
  "install_guidance": {
    "plugin": "postqueue",
    "binary": "postqueue",
    "check": "which postqueue",
    "install_steps": [
      "# Install postqueue:",
      "# apt: sudo apt-get install postqueue",
      "# brew: brew install postqueue",
      "# cargo: cargo install postqueue",
      "# npm: npm install -g postqueue",
      "# pip: pip install postqueue",
      "# or download from /usr/sbin/postqueue"
    ]
  },
  "commands": [
    {
      "namespace": "postqueue",
      "resource": "postqueue",
      "action": "run",
      "description": "Run postqueue",
      "adapter": "process",
      "adapterConfig": {
        "command": "postqueue",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postqueue from /usr/sbin/postqueue"
      },
      "args": []
    }
  ]
}