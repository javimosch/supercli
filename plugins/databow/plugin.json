{
  "name": "databow",
  "version": "0.1.0",
  "description": "Query CLI",
  "source": "https://github.com/columnar-tech/databow",
  "checks": [
    { "type": "binary", "name": "databow" }
  ],
  "install_guidance": {
    "plugin": "databow",
    "binary": "databow",
    "check": "which databow",
    "install_steps": [
      "cargo install databow",
      "Verify: databow --version",
      "supercli plugins install ./plugins/databow --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "databow",
      "resource": "self",
      "action": "version",
      "description": "Print databow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "databow",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install databow: cargo install databow"
      },
      "args": []
    },
    {
      "namespace": "databow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to databow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "databow",
        "passthrough": true,
        "missingDependencyHelp": "Install databow"
      },
      "args": []
    }
  ]
}
