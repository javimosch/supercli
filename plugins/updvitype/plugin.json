{
  "name": "updvitype",
  "version": "0.1.0",
  "description": "CLI tool: updvitype",
  "source": "https://manpages.debian.org/updvitype",
  "checks": [
    {
      "type": "binary",
      "name": "updvitype"
    }
  ],
  "install_guidance": {
    "plugin": "updvitype",
    "binary": "updvitype",
    "check": "which updvitype",
    "install_steps": [
      "apt-get install updvitype 2>/dev/null || which updvitype",
      "Verify: updvitype --version",
      "supercli plugins install ./plugins/updvitype --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "updvitype",
      "resource": "self",
      "action": "version",
      "description": "Print updvitype version",
      "adapter": "process",
      "adapterConfig": {
        "command": "updvitype",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install updvitype: apt-get install updvitype 2>/dev/null || which updvitype"
      },
      "args": []
    },
    {
      "namespace": "updvitype",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to updvitype CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "updvitype",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install updvitype: apt-get install updvitype 2>/dev/null || which updvitype"
      },
      "args": []
    }
  ]
}