{
  "name": "install-printerdriver",
  "version": "0.1.0",
  "description": "CLI tool: install-printerdriver",
  "source": "https://manpages.debian.org/install-printerdriver",
  "checks": [
    {
      "type": "binary",
      "name": "install-printerdriver"
    }
  ],
  "install_guidance": {
    "plugin": "install-printerdriver",
    "binary": "install-printerdriver",
    "check": "which install-printerdriver",
    "install_steps": [
      "apt-get install install-printerdriver 2>/dev/null || which install-printerdriver",
      "Verify: install-printerdriver --version",
      "supercli plugins install ./plugins/install-printerdriver --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "install-printerdriver",
      "resource": "self",
      "action": "version",
      "description": "Print install-printerdriver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-printerdriver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install install-printerdriver: apt-get install install-printerdriver 2>/dev/null || which install-printerdriver"
      },
      "args": []
    },
    {
      "namespace": "install-printerdriver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to install-printerdriver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-printerdriver",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install install-printerdriver: apt-get install install-printerdriver 2>/dev/null || which install-printerdriver"
      },
      "args": []
    }
  ]
}