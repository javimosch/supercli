{
  "name": "fanyi",
  "version": "0.1.0",
  "description": "Chinese and English translate tool in your command-line",
  "source": "https://github.com/afc163/fanyi",
  "checks": [
    {
      "type": "binary",
      "name": "fanyi"
    }
  ],
  "install_guidance": {
    "plugin": "fanyi",
    "binary": "fanyi",
    "check": "which fanyi",
    "install_steps": [
      "brew install fanyi",
      "Verify: fanyi --version",
      "supercli plugins install ./plugins/fanyi --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fanyi",
      "resource": "self",
      "action": "version",
      "description": "Print fanyi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fanyi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fanyi: brew install fanyi"
      },
      "args": []
    },
    {
      "namespace": "fanyi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fanyi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fanyi",
        "passthrough": true,
        "missingDependencyHelp": "Install fanyi"
      },
      "args": []
    }
  ]
}