{
  "name": "circleci_cli",
  "version": "0.1.0",
  "description": "Ansible Role - circleci-cli (for CentOS7/CentOS8)",
  "source": "https://github.com/circleci_cli/circleci_cli",
  "checks": [
    {
      "type": "binary",
      "name": "circleci_cli"
    }
  ],
  "install_guidance": {
    "plugin": "circleci_cli",
    "binary": "circleci_cli",
    "check": "which circleci_cli",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: circleci_cli --version",
      "supercli plugins install ./plugins/circleci_cli --on-conflict replace --json"
    ],
    "note": "Unknown language CLI tool"
  },
  "commands": [
    {
      "namespace": "circleci_cli",
      "resource": "self",
      "action": "version",
      "description": "Print circleci_cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "circleci_cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install circleci_cli from project repository"
      },
      "args": []
    },
    {
      "namespace": "circleci_cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to circleci_cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "circleci_cli",
        "passthrough": true,
        "missingDependencyHelp": "Install circleci_cli from project repository"
      },
      "args": []
    }
  ]
}