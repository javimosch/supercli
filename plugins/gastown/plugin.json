{
  "name": "gastown",
  "version": "0.1.0",
  "description": "Gas Town - multi-agent workspace manager",
  "source": "https://github.com/gastown/gastown",
  "checks": [
    {
      "type": "binary",
      "name": "gastown"
    }
  ],
  "install_guidance": {
    "plugin": "gastown",
    "binary": "gastown",
    "check": "which gastown",
    "install_steps": [
      "pip install gastown",
      "Verify: gastown --version",
      "supercli plugins install ./plugins/gastown --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gastown",
      "resource": "self",
      "action": "version",
      "description": "Print gastown version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gastown",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gastown: pip install gastown"
      },
      "args": []
    },
    {
      "namespace": "gastown",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gastown CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gastown",
        "passthrough": true,
        "missingDependencyHelp": "Install gastown: pip install gastown"
      },
      "args": []
    }
  ]
}