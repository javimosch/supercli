{
  "name": "awslim",
  "version": "0.1.0",
  "description": "awslim - Simplified AWS CLI alternative",
  "source": "github.com/awslim/awslim",
  "checks": [
    {
      "type": "binary",
      "name": "awslim"
    }
  ],
  "install_guidance": {
    "plugin": "awslim",
    "binary": "awslim",
    "check": "which awslim",
    "install_steps": [
      "go install github.com/awslim/awslim@latest"
    ]
  },
  "commands": [
    {
      "namespace": "awslim",
      "resource": "aws",
      "action": "run",
      "description": "Run simplified AWS CLI alternative",
      "adapter": "process",
      "adapterConfig": {
        "command": "awslim",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install awslim from github.com/awslim/awslim"
      },
      "args": []
    }
  ]
}