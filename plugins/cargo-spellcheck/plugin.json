{
  "name": "cargo-spellcheck",
  "version": "0.1.0",
  "description": "Spellcheck Rust documentation and comments",
  "source": "https://github.com/drahnr/cargo-spellcheck",
  "checks": [{ "type": "binary", "name": "cargo-spellcheck" }],
  "install_guidance": {
    "plugin": "cargo-spellcheck",
    "binary": "cargo-spellcheck",
    "check": "which cargo-spellcheck",
    "install_steps": ["cargo install cargo-spellcheck", "Verify: cargo-spellcheck --version", "supercli plugins install ./plugins/cargo-spellcheck --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cargo-spellcheck",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cargo-spellcheck CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cargo-spellcheck",
      "passthrough": true,
      "missingDependencyHelp": "Install cargo-spellcheck: cargo install cargo-spellcheck", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
