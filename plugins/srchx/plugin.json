{
  "name": "srchx",
  "version": "0.1.0",
  "description": "Search git repositories for code patterns fast",
  "source": "https://github.com/beyondcode/srchx",
  "checks": [{ "type": "binary", "name": "srchx" }],
  "install_guidance": {
    "plugin": "srchx",
    "binary": "srchx",
    "check": "which srchx",
    "install_steps": ["cargo install srchx", "Verify: srchx --version", "supercli plugins install ./plugins/srchx --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "srchx",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to srchx CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "srchx",
      "passthrough": true,
      "missingDependencyHelp": "Install srchx: cargo install srchx", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
