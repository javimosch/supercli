{
  "name": "phpmd",
  "version": "0.1.0",
  "description": "PHPMD is a spin-off project of PHP Depend and aims to be a PHP equivalent of the well known Java tool PMD. PHPMD can be seen as an user friendly frontend application for the raw metrics stream measured by PHP Depend.",
  "source": "https://phpmd.org",
  "checks": [
    {
      "type": "binary",
      "name": "phpmd"
    }
  ],
  "install_guidance": {
    "plugin": "phpmd",
    "binary": "phpmd",
    "check": "which phpmd",
    "install_steps": [
      "Check https://phpmd.org for installation instructions",
      "Verify: phpmd --version",
      "supercli plugins install ./plugins/phpmd --on-conflict replace --json"
    ],
    "note": "PHP language CLI tool"
  },
  "commands": [
    {
      "namespace": "phpmd",
      "resource": "self",
      "action": "version",
      "description": "Print phpmd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "phpmd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install phpmd from project repository"
      },
      "args": []
    },
    {
      "namespace": "phpmd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to phpmd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "phpmd",
        "passthrough": true,
        "missingDependencyHelp": "Install phpmd from project repository"
      },
      "args": []
    }
  ]
}