{
  "name": "ansible-cmdb",
  "version": "0.1.0",
  "description": "Generates static HTML overview page from Ansible facts",
  "source": "https://github.com/fboender/ansible-cmdb",
  "checks": [
    {
      "type": "binary",
      "name": "ansible-cmdb"
    }
  ],
  "install_guidance": {
    "plugin": "ansible-cmdb",
    "binary": "ansible-cmdb",
    "check": "which ansible-cmdb",
    "install_steps": [
      "brew install ansible-cmdb",
      "Verify: ansible-cmdb --version",
      "supercli plugins install ./plugins/ansible-cmdb --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ansible-cmdb",
      "resource": "self",
      "action": "version",
      "description": "Print ansible-cmdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ansible-cmdb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ansible-cmdb: brew install ansible-cmdb"
      },
      "args": []
    },
    {
      "namespace": "ansible-cmdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ansible-cmdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ansible-cmdb",
        "passthrough": true,
        "missingDependencyHelp": "Install ansible-cmdb"
      },
      "args": []
    }
  ]
}