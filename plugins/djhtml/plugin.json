{
  "name": "djhtml",
  "version": "0.1.0",
  "description": "Django/Jinja template indenter",
  "source": "https://github.com/rtts/djhtml",
  "checks": [
    {
      "type": "binary",
      "name": "djhtml"
    }
  ],
  "install_guidance": {
    "plugin": "djhtml",
    "binary": "djhtml",
    "check": "which djhtml",
    "install_steps": [
      "brew install djhtml",
      "Verify: djhtml --version",
      "supercli plugins install ./plugins/djhtml --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "djhtml",
      "resource": "self",
      "action": "version",
      "description": "Print djhtml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "djhtml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install djhtml: brew install djhtml"
      },
      "args": []
    },
    {
      "namespace": "djhtml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to djhtml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "djhtml",
        "passthrough": true,
        "missingDependencyHelp": "Install djhtml"
      },
      "args": []
    }
  ]
}