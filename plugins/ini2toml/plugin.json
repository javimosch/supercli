{
  "name": "ini2toml",
  "version": "0.1.0",
  "description": "Migrate .ini/.cfg files to TOML format with PEP 621 support",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "ini2toml" }],
  "install_guidance": {
    "plugin": "ini2toml",
    "binary": "ini2toml",
    "check": "which ini2toml",
    "install_steps": ["pipx install ini2toml", "Verify: ini2toml --version", "supercli plugins install ./plugins/ini2toml --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ini2toml",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ini2toml CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ini2toml",
      "passthrough": true,
      "missingDependencyHelp": "Install ini2toml: pipx install ini2toml"
    },
    "args": []
  }]
}
