{
  "name": "devdocs",
  "version": "1.0.0",
  "description": "devdocs \u2014 API documentation browser",
  "source": "devdocs.io",
  "checks": [
    {
      "type": "binary",
      "name": "devdocs"
    }
  ],
  "install_guidance": {
    "plugin": "devdocs",
    "binary": "devdocs",
    "check": "which devdocs",
    "install_steps": [
      "# Install devdocs",
      "# See devdocs.io",
      "# apt: sudo apt-get install devdocs",
      "# brew: brew install devdocs",
      "# cargo: cargo install devdocs",
      "# npm: npm install -g devdocs",
      "# pip: pip install devdocs"
    ]
  },
  "commands": [
    {
      "namespace": "devdocs",
      "resource": "devdocs",
      "action": "run",
      "description": "Run devdocs",
      "adapter": "process",
      "adapterConfig": {
        "command": "devdocs",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install devdocs from devdocs.io"
      },
      "args": []
    }
  ]
}