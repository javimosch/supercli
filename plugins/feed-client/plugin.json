{
  "name": "feed-client",
  "version": "0.1.0",
  "description": "Sample program for SYNESIS FeedService",
  "source": "https://www.synesis.tech/",
  "checks": [
    {
      "type": "binary",
      "name": "feed-client"
    }
  ],
  "install_guidance": {
    "plugin": "feed-client",
    "binary": "feed-client",
    "check": "which feed-client",
    "install_steps": [
      "Check https://www.synesis.tech/ for installation instructions",
      "Verify: feed-client --version",
      "supercli plugins install ./plugins/feed-client --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "feed-client",
      "resource": "self",
      "action": "version",
      "description": "Print feed-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "feed-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install feed-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "feed-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to feed-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "feed-client",
        "passthrough": true,
        "missingDependencyHelp": "Install feed-client from project repository"
      },
      "args": []
    }
  ]
}