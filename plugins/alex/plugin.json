{
  "name": "alex",
  "version": "0.1.0",
  "description": "Catch insensitive language in text",
  "source": "https://github.com/get-alex/alex",
  "checks": [
    {
      "type": "binary",
      "name": "alex"
    }
  ],
  "install_guidance": {
    "plugin": "alex",
    "binary": "alex",
    "check": "which alex",
    "install_steps": [
      "npm install -g alex",
      "Verify: alex --version",
      "supercli plugins install ./plugins/alex --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "alex",
      "resource": "self",
      "action": "version",
      "description": "Print alex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "alex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install alex: npm install -g alex"
      },
      "args": []
    },
    {
      "namespace": "alex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to alex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "alex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install alex: npm install -g alex"
      },
      "args": []
    }
  ]
}
