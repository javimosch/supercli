{
  "plugin": "x86_64-pc-linux-gnu-pkg-config",
  "binary": "x86_64-pc-linux-gnu-pkg-config",
  "check": "which x86_64-pc-linux-gnu-pkg-config",
  "install_steps": [
    "apt-get install x86_64-pc-linux-gnu-pkg-config 2>/dev/null || which x86_64-pc-linux-gnu-pkg-config",
    "Verify: x86_64-pc-linux-gnu-pkg-config --version",
    "supercli plugins install ./plugins/x86_64-pc-linux-gnu-pkg-config --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}