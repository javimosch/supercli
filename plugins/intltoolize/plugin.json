{
  "name": "intltoolize",
  "version": "0.1.0",
  "description": "CLI tool: intltoolize",
  "source": "https://manpages.debian.org/intltoolize",
  "checks": [
    {
      "type": "binary",
      "name": "intltoolize"
    }
  ],
  "install_guidance": {
    "plugin": "intltoolize",
    "binary": "intltoolize",
    "check": "which intltoolize",
    "install_steps": [
      "apt-get install intltoolize 2>/dev/null || which intltoolize",
      "Verify: intltoolize --version",
      "supercli plugins install ./plugins/intltoolize --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "intltoolize",
      "resource": "self",
      "action": "version",
      "description": "Print intltoolize version",
      "adapter": "process",
      "adapterConfig": {
        "command": "intltoolize",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install intltoolize: apt-get install intltoolize 2>/dev/null || which intltoolize"
      },
      "args": []
    },
    {
      "namespace": "intltoolize",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to intltoolize CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "intltoolize",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install intltoolize: apt-get install intltoolize 2>/dev/null || which intltoolize"
      },
      "args": []
    }
  ]
}