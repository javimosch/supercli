{
  "name": "savelog",
  "version": "1.0.0",
  "description": "savelog — savelog — CLI utility",
  "source": "https://packages.debian.org/stable/debianutils",
  "checks": [
    {
      "type": "binary",
      "name": "savelog"
    }
  ],
  "install_guidance": {
    "plugin": "savelog",
    "binary": "savelog",
    "check": "which savelog",
    "install_steps": [
      "# Install savelog:",
      "# apt: sudo apt-get install savelog",
      "# brew: brew install savelog",
      "# cargo: cargo install savelog",
      "# npm: npm install -g savelog",
      "# pip: pip install savelog",
      "# or download from /usr/bin/savelog"
    ]
  },
  "commands": [
    {
      "namespace": "savelog",
      "resource": "savelog",
      "action": "run",
      "description": "Run savelog",
      "adapter": "process",
      "adapterConfig": {
        "command": "savelog",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install savelog from /usr/bin/savelog"
      },
      "args": []
    }
  ]
}
