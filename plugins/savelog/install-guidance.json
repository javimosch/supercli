{
  "plugin": "savelog",
  "binary": "savelog",
  "check": "which savelog",
  "install_steps": [
    "# Install savelog",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/savelog-linux-amd64 -o /usr/local/bin/savelog",
    "chmod +x /usr/local/bin/savelog",
    "# Or via package manager, see /usr/bin/savelog"
  ]
}