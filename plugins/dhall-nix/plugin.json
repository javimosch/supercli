{
  "name": "dhall-nix",
  "version": "0.1.0",
  "description": "CLI tool: dhall-nix",
  "source": "https://packages.debian.org/dhall-nix",
  "checks": [{ "type": "binary", "name": "dhall-nix" }],
  "install_guidance": {
    "plugin": "dhall-nix", "binary": "dhall-nix", "check": "which dhall-nix",
    "install_steps": ["apt-get install dhall-nix 2>/dev/null || which dhall-nix", "Verify: dhall-nix --version", "supercli plugins install ./plugins/dhall-nix --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-nix", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-nix CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-nix", "passthrough": true, "missingDependencyHelp": "Install dhall-nix: apt-get install dhall-nix" }, "args": []
  }]
}
