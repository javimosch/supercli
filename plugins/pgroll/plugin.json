{
  "name": "pgroll",
  "version": "0.1.0",
  "description": "PostgreSQL zero-downtime schema migration tool",
  "source": "https://github.com/xataio/pgroll",
  "checks": [{ "type": "binary", "name": "pgroll" }],
  "install_guidance": {
    "plugin": "pgroll",
    "binary": "pgroll",
    "check": "which pgroll",
    "install_steps": ["brew install pgroll", "Verify: pgroll --version", "supercli plugins install ./plugins/pgroll --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pgroll",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pgroll CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pgroll",
      "passthrough": true,
      "missingDependencyHelp": "Install pgroll: brew install pgroll"
    },
    "args": []
  }]
}
