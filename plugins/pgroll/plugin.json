{
  "name": "pgroll",
  "version": "0.1.0",
  "description": "PostgreSQL zero-downtime migrations made easy",
  "source": "https://github.com/pgroll/pgroll",
  "checks": [
    {
      "type": "binary",
      "name": "pgroll"
    }
  ],
  "install_guidance": {
    "plugin": "pgroll",
    "binary": "pgroll",
    "check": "which pgroll",
    "install_steps": [
      "pip install pgroll",
      "Verify: pgroll --version",
      "supercli plugins install ./plugins/pgroll --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pgroll",
      "resource": "self",
      "action": "version",
      "description": "Print pgroll version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgroll",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pgroll: pip install pgroll"
      },
      "args": []
    },
    {
      "namespace": "pgroll",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pgroll CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pgroll",
        "passthrough": true,
        "missingDependencyHelp": "Install pgroll: pip install pgroll"
      },
      "args": []
    }
  ]
}