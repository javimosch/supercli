{
  "name": "downtimed",
  "version": "1.0.0",
  "description": "downtimed \u2014 Track system down time",
  "source": "github.com/ir0nstone/downtimed",
  "checks": [
    {
      "type": "binary",
      "name": "downtimed"
    }
  ],
  "install_guidance": {
    "plugin": "downtimed",
    "binary": "downtimed",
    "check": "which downtimed",
    "install_steps": [
      "# Install downtimed",
      "# See github.com/ir0nstone/downtimed",
      "# apt: sudo apt-get install downtimed",
      "# brew: brew install downtimed",
      "# cargo: cargo install downtimed",
      "# npm: npm install -g downtimed",
      "# pip: pip install downtimed"
    ]
  },
  "commands": [
    {
      "namespace": "downtimed",
      "resource": "downtimed",
      "action": "run",
      "description": "Run downtimed",
      "adapter": "process",
      "adapterConfig": {
        "command": "downtimed",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install downtimed from github.com/ir0nstone/downtimed"
      },
      "args": []
    }
  ]
}