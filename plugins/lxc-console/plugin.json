{
  "name": "lxc-console",
  "version": "0.1.0",
  "description": "CLI tool: lxc-console",
  "source": "https://manpages.debian.org/lxc-console",
  "checks": [
    {
      "type": "binary",
      "name": "lxc-console"
    }
  ],
  "install_guidance": {
    "plugin": "lxc-console",
    "binary": "lxc-console",
    "check": "which lxc-console",
    "install_steps": [
      "apt-get install lxc-console 2>/dev/null || which lxc-console",
      "Verify: lxc-console --version",
      "supercli plugins install ./plugins/lxc-console --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lxc-console",
      "resource": "self",
      "action": "version",
      "description": "Print lxc-console version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lxc-console",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lxc-console: apt-get install lxc-console 2>/dev/null || which lxc-console"
      },
      "args": []
    },
    {
      "namespace": "lxc-console",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lxc-console CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lxc-console",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lxc-console: apt-get install lxc-console 2>/dev/null || which lxc-console"
      },
      "args": []
    }
  ]
}