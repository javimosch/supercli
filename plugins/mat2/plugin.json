{
  "name": "mat2",
  "version": "0.1.0",
  "description": "Metadata anonymization toolkit",
  "source": "https://github.com/whatevery/mat2",
  "checks": [
    {
      "type": "binary",
      "name": "mat2"
    }
  ],
  "install_guidance": {
    "plugin": "mat2",
    "binary": "mat2",
    "check": "which mat2",
    "install_steps": [
      "pip install mat2",
      "Verify: mat2 --version",
      "supercli plugins install ./plugins/mat2 --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "mat2",
      "resource": "self",
      "action": "version",
      "description": "Print mat2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mat2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mat2: pip install mat2"
      },
      "args": []
    },
    {
      "namespace": "mat2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mat2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mat2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mat2: pip install mat2"
      },
      "args": []
    }
  ]
}
