{
  "name": "apt-config",
  "version": "0.1.0",
  "description": "CLI tool: apt-config",
  "source": "https://packages.debian.org/apt-config",
  "checks": [{ "type": "binary", "name": "apt-config" }],
  "install_guidance": {
    "plugin": "apt-config", "binary": "apt-config", "check": "which apt-config",
    "install_steps": ["apt-get install apt-config 2>/dev/null || which apt-config", "Verify: apt-config --version", "supercli plugins install ./plugins/apt-config --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apt-config", "resource": "_", "action": "_",
    "description": "Passthrough to apt-config CLI",
    "adapter": "process", "adapterConfig": { "command": "apt-config", "passthrough": true, "missingDependencyHelp": "Install apt-config: apt-get install apt-config" }, "args": []
  }]
}
