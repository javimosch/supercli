{
  "name": "elm",
  "version": "1.0.0",
  "description": "elm \u2014 Elm language",
  "source": "elm-lang.org",
  "checks": [
    {
      "type": "binary",
      "name": "elm"
    }
  ],
  "install_guidance": {
    "plugin": "elm",
    "binary": "elm",
    "check": "which elm",
    "install_steps": [
      "# Install elm",
      "# See elm-lang.org",
      "# apt: sudo apt-get install elm",
      "# brew: brew install elm",
      "# cargo: cargo install elm",
      "# npm: npm install -g elm",
      "# pip: pip install elm"
    ]
  },
  "commands": [
    {
      "namespace": "elm",
      "resource": "elm",
      "action": "run",
      "description": "Run elm",
      "adapter": "process",
      "adapterConfig": {
        "command": "elm",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install elm from elm-lang.org"
      },
      "args": []
    }
  ]
}