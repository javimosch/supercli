{
  "name": "VibeVoice",
  "version": "0.1.0",
  "description": "Open-Source Frontier Voice AI",
  "source": "https://github.com/VibeVoice/VibeVoice",
  "checks": [
    {
      "type": "binary",
      "name": "vibevoice"
    }
  ],
  "install_guidance": {
    "plugin": "VibeVoice",
    "binary": "vibevoice",
    "check": "which vibevoice",
    "install_steps": [
      "pip install vibevoice",
      "Verify: vibevoice --version",
      "supercli plugins install ./plugins/VibeVoice --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "VibeVoice",
      "resource": "self",
      "action": "version",
      "description": "Print VibeVoice version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibevoice",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install VibeVoice: pip install vibevoice"
      },
      "args": []
    },
    {
      "namespace": "VibeVoice",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vibevoice CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vibevoice",
        "passthrough": true,
        "missingDependencyHelp": "Install VibeVoice: pip install vibevoice"
      },
      "args": []
    }
  ]
}