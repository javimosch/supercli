{
  "name": "ramda-cli",
  "version": "0.1.0",
  "description": "Process data with functional pipelines",
  "source": "https://github.com/raine/ramda-cli",
  "checks": [
    {
      "type": "binary",
      "name": "ramda-cli"
    }
  ],
  "install_guidance": {
    "plugin": "ramda-cli",
    "binary": "ramda-cli",
    "check": "which ramda-cli",
    "install_steps": [
      "See https://github.com/raine/ramda-cli",
      "Verify: ramda-cli --version",
      "supercli plugins install ./plugins/ramda-cli --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ramda-cli",
      "resource": "self",
      "action": "version",
      "description": "Print ramda-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ramda-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ramda-cli: See https://github.com/raine/ramda-cli"
      },
      "args": []
    },
    {
      "namespace": "ramda-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ramda-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ramda-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install ramda-cli"
      },
      "args": []
    }
  ]
}