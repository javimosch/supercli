{
  "name": "libcaption",
  "version": "0.1.0",
  "description": "Free open-source CEA608 / CEA708 closed-caption encoder/decoder",
  "source": "https://github.com/szatmary/libcaption",
  "checks": [
    {
      "type": "binary",
      "name": "libcaption"
    }
  ],
  "install_guidance": {
    "plugin": "libcaption",
    "binary": "libcaption",
    "check": "which libcaption",
    "install_steps": [
      "brew install libcaption",
      "Verify: libcaption --version",
      "supercli plugins install ./plugins/libcaption --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libcaption",
      "resource": "self",
      "action": "version",
      "description": "Print libcaption version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libcaption",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libcaption: brew install libcaption"
      },
      "args": []
    },
    {
      "namespace": "libcaption",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libcaption CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libcaption",
        "passthrough": true,
        "missingDependencyHelp": "Install libcaption"
      },
      "args": []
    }
  ]
}