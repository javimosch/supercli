{
  "name": "harsh",
  "version": "0.1.0",
  "description": "Habit tracking for geeks",
  "source": "https://github.com/wakatara/harsh",
  "checks": [
    {
      "type": "binary",
      "name": "harsh"
    }
  ],
  "install_guidance": {
    "plugin": "harsh",
    "binary": "harsh",
    "check": "which harsh",
    "install_steps": [
      "brew install harsh",
      "Verify: harsh --version",
      "supercli plugins install ./plugins/harsh --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "harsh",
      "resource": "self",
      "action": "version",
      "description": "Print harsh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "harsh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install harsh: brew install harsh"
      },
      "args": []
    },
    {
      "namespace": "harsh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to harsh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "harsh",
        "passthrough": true,
        "missingDependencyHelp": "Install harsh"
      },
      "args": []
    }
  ]
}