{
  "name": "pbmtox10bm",
  "version": "0.1.0",
  "description": "CLI tool: pbmtox10bm",
  "source": "https://manpages.debian.org/pbmtox10bm",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtox10bm"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtox10bm",
    "binary": "pbmtox10bm",
    "check": "which pbmtox10bm",
    "install_steps": [
      "apt-get install pbmtox10bm 2>/dev/null || which pbmtox10bm",
      "Verify: pbmtox10bm --version",
      "supercli plugins install ./plugins/pbmtox10bm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtox10bm",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtox10bm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtox10bm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtox10bm: apt-get install pbmtox10bm 2>/dev/null || which pbmtox10bm"
      },
      "args": []
    },
    {
      "namespace": "pbmtox10bm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtox10bm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtox10bm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtox10bm: apt-get install pbmtox10bm 2>/dev/null || which pbmtox10bm"
      },
      "args": []
    }
  ]
}