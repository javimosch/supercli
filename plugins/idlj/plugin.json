{
  "name": "idlj",
  "version": "0.1.0",
  "description": "CLI tool: idlj",
  "source": "https://manpages.debian.org/idlj",
  "checks": [
    {
      "type": "binary",
      "name": "idlj"
    }
  ],
  "install_guidance": {
    "plugin": "idlj",
    "binary": "idlj",
    "check": "which idlj",
    "install_steps": [
      "apt-get install idlj 2>/dev/null || which idlj",
      "Verify: idlj --version",
      "supercli plugins install ./plugins/idlj --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "idlj",
      "resource": "self",
      "action": "version",
      "description": "Print idlj version",
      "adapter": "process",
      "adapterConfig": {
        "command": "idlj",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install idlj: apt-get install idlj 2>/dev/null || which idlj"
      },
      "args": []
    },
    {
      "namespace": "idlj",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to idlj CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "idlj",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install idlj: apt-get install idlj 2>/dev/null || which idlj"
      },
      "args": []
    }
  ]
}