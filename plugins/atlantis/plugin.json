{
  "name": "atlantis",
  "version": "0.1.0",
  "description": "Terraform pull request automation and collaboration tool",
  "source": "https://github.com/runatlantis/atlantis",
  "checks": [{ "type": "binary", "name": "atlantis" }],
  "install_guidance": {
    "plugin": "atlantis",
    "binary": "atlantis",
    "check": "which atlantis",
    "install_steps": ["brew install atlantis", "Verify: atlantis --version", "supercli plugins install ./plugins/atlantis --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "atlantis",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to atlantis CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "atlantis",
      "passthrough": true,
      "missingDependencyHelp": "Install atlantis: brew install atlantis"
    },
    "args": []
  }]
}
