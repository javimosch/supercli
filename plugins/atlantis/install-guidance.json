{
  "plugin": "atlantis",
  "binary": "atlantis",
  "check": "which atlantis",
  "install_steps": [
    "Download binary from https://github.com/runatlantis/atlantis/releases",
    "brew install runatlantis/atlantis/atlantis (macOS)",
    "docker pull runatlantis/atlantis",
    "go install github.com/runatlantis/atlantis@latest",
    "Verify: atlantis version"
  ],
  "note": "Requires webhook configuration with your Git provider (GitHub/GitLab/Bitbucket). Server mode is the primary use case."
}
