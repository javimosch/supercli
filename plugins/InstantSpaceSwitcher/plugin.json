{
  "name": "InstantSpaceSwitcher",
  "version": "0.1.0",
  "description": "Native space switching on macOS with no animation",
  "source": "https://github.com/InstantSpaceSwitcher/InstantSpaceSwitcher",
  "checks": [
    {
      "type": "binary",
      "name": "instantspaceswitcher"
    }
  ],
  "install_guidance": {
    "plugin": "InstantSpaceSwitcher",
    "binary": "instantspaceswitcher",
    "check": "which instantspaceswitcher",
    "install_steps": [
      "pip install instantspaceswitcher",
      "Verify: instantspaceswitcher --version",
      "supercli plugins install ./plugins/InstantSpaceSwitcher --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "InstantSpaceSwitcher",
      "resource": "self",
      "action": "version",
      "description": "Print InstantSpaceSwitcher version",
      "adapter": "process",
      "adapterConfig": {
        "command": "instantspaceswitcher",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install InstantSpaceSwitcher: pip install instantspaceswitcher"
      },
      "args": []
    },
    {
      "namespace": "InstantSpaceSwitcher",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to instantspaceswitcher CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "instantspaceswitcher",
        "passthrough": true,
        "missingDependencyHelp": "Install InstantSpaceSwitcher: pip install instantspaceswitcher"
      },
      "args": []
    }
  ]
}