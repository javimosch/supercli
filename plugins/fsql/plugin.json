{
  "name": "fsql",
  "version": "0.1.0",
  "description": "Search through your filesystem with SQL-esque queries",
  "source": "https://github.com/kashav/fsql",
  "checks": [
    {
      "type": "binary",
      "name": "fsql"
    }
  ],
  "install_guidance": {
    "plugin": "fsql",
    "binary": "fsql",
    "check": "which fsql",
    "install_steps": [
      "brew install fsql",
      "Verify: fsql --version",
      "supercli plugins install ./plugins/fsql --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fsql",
      "resource": "self",
      "action": "version",
      "description": "Print fsql version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsql",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fsql: brew install fsql"
      },
      "args": []
    },
    {
      "namespace": "fsql",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fsql CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fsql",
        "passthrough": true,
        "missingDependencyHelp": "Install fsql"
      },
      "args": []
    }
  ]
}