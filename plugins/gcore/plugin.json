{
  "name": "gcore",
  "version": "0.1.0",
  "description": "CLI tool: gcore",
  "source": "https://manpages.debian.org/gcore",
  "checks": [
    {
      "type": "binary",
      "name": "gcore"
    }
  ],
  "install_guidance": {
    "plugin": "gcore",
    "binary": "gcore",
    "check": "which gcore",
    "install_steps": [
      "apt-get install gcore 2>/dev/null || which gcore",
      "Verify: gcore --version",
      "supercli plugins install ./plugins/gcore --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gcore",
      "resource": "self",
      "action": "version",
      "description": "Print gcore version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcore",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcore: apt-get install gcore 2>/dev/null || which gcore"
      },
      "args": []
    },
    {
      "namespace": "gcore",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcore CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcore",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gcore: apt-get install gcore 2>/dev/null || which gcore"
      },
      "args": []
    }
  ]
}