{
  "name": "devdump",
  "version": "0.1.0",
  "description": "CLI tool: devdump",
  "source": "https://packages.debian.org/devdump",
  "checks": [{ "type": "binary", "name": "devdump" }],
  "install_guidance": {
    "plugin": "devdump", "binary": "devdump", "check": "which devdump",
    "install_steps": ["apt-get install devdump 2>/dev/null || which devdump", "Verify: devdump --version", "supercli plugins install ./plugins/devdump --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "devdump", "resource": "_", "action": "_",
    "description": "Passthrough to devdump CLI",
    "adapter": "process", "adapterConfig": { "command": "devdump", "passthrough": true, "missingDependencyHelp": "Install devdump: apt-get install devdump" }, "args": []
  }]
}
