{
  "name": "frugal",
  "version": "0.1.0",
  "description": "Cross language code generator for creating scalable microservices",
  "source": "https://github.com/Workiva/frugal",
  "checks": [
    {
      "type": "binary",
      "name": "frugal"
    }
  ],
  "install_guidance": {
    "plugin": "frugal",
    "binary": "frugal",
    "check": "which frugal",
    "install_steps": [
      "brew install frugal",
      "Verify: frugal --version",
      "supercli plugins install ./plugins/frugal --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "frugal",
      "resource": "self",
      "action": "version",
      "description": "Print frugal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "frugal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install frugal: brew install frugal"
      },
      "args": []
    },
    {
      "namespace": "frugal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to frugal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "frugal",
        "passthrough": true,
        "missingDependencyHelp": "Install frugal"
      },
      "args": []
    }
  ]
}