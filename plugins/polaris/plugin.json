{
  "name": "polaris",
  "version": "0.1.0",
  "description": "Kubernetes best practice and policy validation tool",
  "source": "https://github.com/FairwindsOps/polaris",
  "checks": [{ "type": "binary", "name": "polaris" }],
  "install_guidance": {
    "plugin": "polaris",
    "binary": "polaris",
    "check": "which polaris",
    "install_steps": ["brew install polaris", "Verify: polaris --version", "supercli plugins install ./plugins/polaris --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "polaris",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to polaris CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "polaris",
      "passthrough": true,
      "missingDependencyHelp": "Install polaris: brew install polaris"
    },
    "args": []
  }]
}
