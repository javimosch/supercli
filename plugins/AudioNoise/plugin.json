{
  "name": "AudioNoise",
  "version": "0.1.0",
  "description": "Random digital audio effects",
  "source": "https://github.com/AudioNoise/AudioNoise",
  "checks": [
    {
      "type": "binary",
      "name": "audionoise"
    }
  ],
  "install_guidance": {
    "plugin": "AudioNoise",
    "binary": "audionoise",
    "check": "which audionoise",
    "install_steps": [
      "pip install audionoise",
      "Verify: audionoise --version",
      "supercli plugins install ./plugins/AudioNoise --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AudioNoise",
      "resource": "self",
      "action": "version",
      "description": "Print AudioNoise version",
      "adapter": "process",
      "adapterConfig": {
        "command": "audionoise",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AudioNoise: pip install audionoise"
      },
      "args": []
    },
    {
      "namespace": "AudioNoise",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to audionoise CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "audionoise",
        "passthrough": true,
        "missingDependencyHelp": "Install AudioNoise: pip install audionoise"
      },
      "args": []
    }
  ]
}