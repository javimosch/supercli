{
  "plugin": "gsf-vba-dump",
  "binary": "gsf-vba-dump",
  "check": "which gsf-vba-dump",
  "install_steps": [
    "apt-get install gsf-vba-dump 2>/dev/null || which gsf-vba-dump",
    "Verify: gsf-vba-dump --version",
    "supercli plugins install ./plugins/gsf-vba-dump --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}