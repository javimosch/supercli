{
  "name": "gsf-vba-dump",
  "version": "0.1.0",
  "description": "CLI tool: gsf-vba-dump",
  "source": "https://manpages.debian.org/gsf-vba-dump",
  "checks": [
    {
      "type": "binary",
      "name": "gsf-vba-dump"
    }
  ],
  "install_guidance": {
    "plugin": "gsf-vba-dump",
    "binary": "gsf-vba-dump",
    "check": "which gsf-vba-dump",
    "install_steps": [
      "apt-get install gsf-vba-dump 2>/dev/null || which gsf-vba-dump",
      "Verify: gsf-vba-dump --version",
      "supercli plugins install ./plugins/gsf-vba-dump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gsf-vba-dump",
      "resource": "self",
      "action": "version",
      "description": "Print gsf-vba-dump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gsf-vba-dump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gsf-vba-dump: apt-get install gsf-vba-dump 2>/dev/null || which gsf-vba-dump"
      },
      "args": []
    },
    {
      "namespace": "gsf-vba-dump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gsf-vba-dump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gsf-vba-dump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gsf-vba-dump: apt-get install gsf-vba-dump 2>/dev/null || which gsf-vba-dump"
      },
      "args": []
    }
  ]
}