{
  "name": "nc",
  "version": "0.1.0",
  "description": "Netcat — TCP/UDP networking utility for reading/writing network connections",
  "source": "https",
  "checks": [{"type": "binary", "name": "nc"}],
  "install_guidance": {
    "plugin": "nc",
    "binary": "nc",
    "check": "which nc",
    "install_steps": [
      "apt-get install netcat-openbsd",
      "Verify: nc -h",
      "supercli plugins install ./plugins/nc --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "nc",
      "resource": "self",
      "action": "version",
      "description": "Show nc help/version info",
      "adapter": "process",
      "adapterConfig": {"command": "nc", "baseArgs": ["-h"], "missingDependencyHelp": "Install nc: apt-get install netcat-openbsd"},
      "args": []
    },
    {
      "namespace": "nc",
      "resource": "tcp",
      "action": "connect",
      "description": "Connect to TCP port",
      "adapter": "process",
      "adapterConfig": {"command": "nc", "passthrough": true, "missingDependencyHelp": "Install nc: apt-get install netcat-openbsd"},
      "args": [
        {"name": "host", "type": "string", "required": true, "description": "Target hostname/IP"},
        {"name": "port", "type": "string", "required": true, "description": "Target port number"}
      ]
    },
    {
      "namespace": "nc",
      "resource": "tcp",
      "action": "listen",
      "description": "Listen on TCP port",
      "adapter": "process",
      "adapterConfig": {"command": "nc", "baseArgs": ["-l"], "missingDependencyHelp": "Install nc: apt-get install netcat-openbsd"},
      "args": [
        {"name": "port", "type": "string", "required": true, "description": "Port to listen on"},
        {"name": "--keep-open", "type": "boolean", "required": false, "description": "Keep listening after client disconnect (-k)"}
      ]
    },
    {
      "namespace": "nc",
      "resource": "tcp",
      "action": "scan",
      "description": "Scan TCP ports on a host",
      "adapter": "process",
      "adapterConfig": {"command": "nc", "baseArgs": ["-z", "-v"], "missingDependencyHelp": "Install nc: apt-get install netcat-openbsd"},
      "args": [
        {"name": "host", "type": "string", "required": true, "description": "Target hostname/IP"},
        {"name": "port-range", "type": "string", "required": true, "description": "Port range (e.g. 1-1000)"},
        {"name": "--timeout", "type": "string", "required": false, "description": "Connection timeout (-w)"},
        {"name": "--udp", "type": "boolean", "required": false, "description": "Use UDP instead of TCP (-u)"}
      ]
    },
    {
      "namespace": "nc",
      "resource": "file",
      "action": "transfer",
      "description": "Transfer a file over TCP",
      "adapter": "process",
      "adapterConfig": {"command": "nc", "missingDependencyHelp": "Install nc: apt-get install netcat-openbsd"},
      "args": [
        {"name": "--send", "type": "boolean", "required": false, "description": "Send mode (pipe file to listener)"},
        {"name": "--receive", "type": "boolean", "required": false, "description": "Receive mode (listen and save to file)"},
        {"name": "host", "type": "string", "required": false, "description": "Target hostname (send mode)"},
        {"name": "port", "type": "string", "required": true, "description": "Port number"},
        {"name": "file", "type": "string", "required": false, "description": "File to send or save to"}
      ]
    },
    {
      "namespace": "nc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nc CLI",
      "adapter": "process",
      "adapterConfig": {"command": "nc", "passthrough": true, "missingDependencyHelp": "Install nc: apt-get install netcat-openbsd"},
      "args": []
    }
  ]
}
