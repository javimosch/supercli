{
  "name": "api",
  "version": "0.1.0",
  "description": "CLI tool: api",
  "source": "https://packages.debian.org/api",
  "checks": [{ "type": "binary", "name": "api" }],
  "install_guidance": {
    "plugin": "api", "binary": "api", "check": "which api",
    "install_steps": ["apt-get install api 2>/dev/null || which api", "Verify: api --version", "supercli plugins install ./plugins/api --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "api", "resource": "_", "action": "_",
    "description": "Passthrough to api CLI",
    "adapter": "process", "adapterConfig": { "command": "api", "passthrough": true, "missingDependencyHelp": "Install api: apt-get install api" }, "args": []
  }]
}
