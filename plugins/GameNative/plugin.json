{
  "name": "GameNative",
  "version": "0.1.0",
  "description": "Native PC gaming with Steam, Epic, GOG and Amazon integrations on Android",
  "source": "https://github.com/GameNative/GameNative",
  "checks": [
    {
      "type": "binary",
      "name": "gamenative"
    }
  ],
  "install_guidance": {
    "plugin": "GameNative",
    "binary": "gamenative",
    "check": "which gamenative",
    "install_steps": [
      "pip install gamenative",
      "Verify: gamenative --version",
      "supercli plugins install ./plugins/GameNative --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GameNative",
      "resource": "self",
      "action": "version",
      "description": "Print GameNative version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gamenative",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GameNative: pip install gamenative"
      },
      "args": []
    },
    {
      "namespace": "GameNative",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gamenative CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gamenative",
        "passthrough": true,
        "missingDependencyHelp": "Install GameNative: pip install gamenative"
      },
      "args": []
    }
  ]
}