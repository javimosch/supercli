{
  "name": "App-Store-Connect-CLI",
  "version": "0.1.0",
  "description": "Fast, scriptable CLI for the App Store Connect API. Automate TestFlight, builds, submissions, signin",
  "source": "https://github.com/App-Store-Connect-CLI/App-Store-Connect-CLI",
  "checks": [
    {
      "type": "binary",
      "name": "app-store-connect-cli"
    }
  ],
  "install_guidance": {
    "plugin": "App-Store-Connect-CLI",
    "binary": "app-store-connect-cli",
    "check": "which app-store-connect-cli",
    "install_steps": [
      "pip install app-store-connect-cli",
      "Verify: app-store-connect-cli --version",
      "supercli plugins install ./plugins/App-Store-Connect-CLI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "App-Store-Connect-CLI",
      "resource": "self",
      "action": "version",
      "description": "Print App-Store-Connect-CLI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "app-store-connect-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install App-Store-Connect-CLI: pip install app-store-connect-cli"
      },
      "args": []
    },
    {
      "namespace": "App-Store-Connect-CLI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to app-store-connect-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "app-store-connect-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install App-Store-Connect-CLI: pip install app-store-connect-cli"
      },
      "args": []
    }
  ]
}