{
  "name": "getafm",
  "version": "0.1.0",
  "description": "CLI tool: getafm",
  "source": "https://manpages.debian.org/getafm",
  "checks": [
    {
      "type": "binary",
      "name": "getafm"
    }
  ],
  "install_guidance": {
    "plugin": "getafm",
    "binary": "getafm",
    "check": "which getafm",
    "install_steps": [
      "apt-get install getafm 2>/dev/null || which getafm",
      "Verify: getafm --version",
      "supercli plugins install ./plugins/getafm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "getafm",
      "resource": "self",
      "action": "version",
      "description": "Print getafm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "getafm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install getafm: apt-get install getafm 2>/dev/null || which getafm"
      },
      "args": []
    },
    {
      "namespace": "getafm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to getafm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "getafm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install getafm: apt-get install getafm 2>/dev/null || which getafm"
      },
      "args": []
    }
  ]
}