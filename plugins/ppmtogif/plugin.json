{
  "name": "ppmtogif",
  "version": "0.1.0",
  "description": "CLI tool: ppmtogif",
  "source": "https://manpages.debian.org/ppmtogif",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtogif"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtogif",
    "binary": "ppmtogif",
    "check": "which ppmtogif",
    "install_steps": [
      "apt-get install ppmtogif 2>/dev/null || which ppmtogif",
      "Verify: ppmtogif --version",
      "supercli plugins install ./plugins/ppmtogif --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtogif",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtogif version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtogif",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtogif: apt-get install ppmtogif 2>/dev/null || which ppmtogif"
      },
      "args": []
    },
    {
      "namespace": "ppmtogif",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtogif CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtogif",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtogif: apt-get install ppmtogif 2>/dev/null || which ppmtogif"
      },
      "args": []
    }
  ]
}