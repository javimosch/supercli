{
  "name": "cash-cli",
  "version": "0.1.0",
  "description": "Convert Currency Rates",
  "source": "https://github.com/xxczaki/cash-cli",
  "checks": [
    {
      "type": "binary",
      "name": "cash-cli"
    }
  ],
  "install_guidance": {
    "plugin": "cash-cli",
    "binary": "cash-cli",
    "check": "which cash-cli",
    "install_steps": [
      "npm install -g cash-cli",
      "Verify: cash-cli --version",
      "supercli plugins install ./plugins/cash-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cash-cli",
      "resource": "self",
      "action": "version",
      "description": "Print cash-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cash-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cash-cli: npm install -g cash-cli"
      },
      "args": []
    },
    {
      "namespace": "cash-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cash-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cash-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install cash-cli"
      },
      "args": []
    }
  ]
}