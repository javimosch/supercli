{
  "name": "transmission-cli",
  "version": "0.1.0",
  "description": "Torrent client for your command line",
  "checks": [
    {
      "type": "binary",
      "name": "transmission-cli"
    }
  ],
  "install_guidance": {
    "plugin": "transmission-cli",
    "binary": "transmission-cli",
    "check": "which transmission-cli",
    "install_steps": [
      "brew install transmission-cli",
      "Verify: transmission-cli --version",
      "supercli plugins install ./plugins/transmission-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "transmission-cli",
      "resource": "self",
      "action": "version",
      "description": "Print transmission-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "transmission-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install transmission-cli: brew install transmission-cli"
      },
      "args": []
    },
    {
      "namespace": "transmission-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to transmission-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "transmission-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install transmission-cli"
      },
      "args": []
    }
  ]
}