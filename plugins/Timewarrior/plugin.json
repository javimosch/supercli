{
  "name": "Timewarrior",
  "version": "0.1.0",
  "description": "Utility with simple stopwatch, calendar-based backfill and flexible reporting",
  "source": "https://github.com/GothenburgBitFactory/timewarrior",
  "checks": [
    {
      "type": "binary",
      "name": "Timewarrior"
    }
  ],
  "install_guidance": {
    "plugin": "Timewarrior",
    "binary": "Timewarrior",
    "check": "which Timewarrior",
    "install_steps": [
      "brew install Timewarrior",
      "Verify: Timewarrior --version",
      "supercli plugins install ./plugins/Timewarrior --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "Timewarrior",
      "resource": "self",
      "action": "version",
      "description": "Print Timewarrior version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Timewarrior",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Timewarrior: brew install Timewarrior"
      },
      "args": []
    },
    {
      "namespace": "Timewarrior",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Timewarrior CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Timewarrior",
        "passthrough": true,
        "missingDependencyHelp": "Install Timewarrior"
      },
      "args": []
    }
  ]
}