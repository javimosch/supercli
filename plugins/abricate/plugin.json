{
  "name": "abricate",
  "version": "0.1.0",
  "description": "Find antimicrobial resistance and virulence genes in contigs",
  "source": "https://github.com/tseemann/abricate",
  "checks": [
    {
      "type": "binary",
      "name": "abricate"
    }
  ],
  "install_guidance": {
    "plugin": "abricate",
    "binary": "abricate",
    "check": "which abricate",
    "install_steps": [
      "brew install abricate",
      "Verify: abricate --version",
      "supercli plugins install ./plugins/abricate --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "abricate",
      "resource": "self",
      "action": "version",
      "description": "Print abricate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "abricate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install abricate: brew install abricate"
      },
      "args": []
    },
    {
      "namespace": "abricate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to abricate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "abricate",
        "passthrough": true,
        "missingDependencyHelp": "Install abricate"
      },
      "args": []
    }
  ]
}