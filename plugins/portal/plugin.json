{
  "name": "portal",
  "version": "0.1.0",
  "description": "Send files between computers",
  "source": "https://github.com/ZinoKader/portal",
  "checks": [
    {
      "type": "binary",
      "name": "portal"
    }
  ],
  "install_guidance": {
    "plugin": "portal",
    "binary": "portal",
    "check": "which portal",
    "install_steps": [
      "brew install portal",
      "Verify: portal --version",
      "supercli plugins install ./plugins/portal --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "portal",
      "resource": "self",
      "action": "version",
      "description": "Print portal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "portal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install portal: brew install portal"
      },
      "args": []
    },
    {
      "namespace": "portal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to portal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "portal",
        "passthrough": true,
        "missingDependencyHelp": "Install portal"
      },
      "args": []
    }
  ]
}