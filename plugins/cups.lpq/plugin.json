{
  "name": "cups.lpq",
  "version": "0.1.0",
  "description": "CLI tool: cups.lpq",
  "source": "https://manpages.debian.org/cups.lpq",
  "checks": [
    {
      "type": "binary",
      "name": "cups.lpq"
    }
  ],
  "install_guidance": {
    "plugin": "cups.lpq",
    "binary": "cups.lpq",
    "check": "which cups.lpq",
    "install_steps": [
      "apt-get install cups.lpq 2>/dev/null || which cups.lpq",
      "Verify: cups.lpq --version",
      "supercli plugins install ./plugins/cups.lpq --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cups.lpq",
      "resource": "self",
      "action": "version",
      "description": "Print cups.lpq version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cups.lpq",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cups.lpq: apt-get install cups.lpq 2>/dev/null || which cups.lpq"
      },
      "args": []
    },
    {
      "namespace": "cups.lpq",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cups.lpq CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cups.lpq",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install cups.lpq: apt-get install cups.lpq 2>/dev/null || which cups.lpq"
      },
      "args": []
    }
  ]
}