{
  "name": "context7",
  "version": "0.1.0",
  "description": "Context7 Platform -- Up-to-date code documentation for LLMs and AI code editors",
  "source": "https://github.com/context7/context7",
  "checks": [
    {
      "type": "binary",
      "name": "context7"
    }
  ],
  "install_guidance": {
    "plugin": "context7",
    "binary": "context7",
    "check": "which context7",
    "install_steps": [
      "pip install context7",
      "Verify: context7 --version",
      "supercli plugins install ./plugins/context7 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "context7",
      "resource": "self",
      "action": "version",
      "description": "Print context7 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "context7",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install context7: pip install context7"
      },
      "args": []
    },
    {
      "namespace": "context7",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to context7 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "context7",
        "passthrough": true,
        "missingDependencyHelp": "Install context7: pip install context7"
      },
      "args": []
    }
  ]
}