{
  "name": "MicroManipulatorStepper",
  "version": "0.1.0",
  "description": "A sub-micrometer 3D motion control plattform.",
  "source": "https://github.com/MicroManipulatorStepper/MicroManipulatorStepper",
  "checks": [
    {
      "type": "binary",
      "name": "micromanipulatorstepper"
    }
  ],
  "install_guidance": {
    "plugin": "MicroManipulatorStepper",
    "binary": "micromanipulatorstepper",
    "check": "which micromanipulatorstepper",
    "install_steps": [
      "pip install micromanipulatorstepper",
      "Verify: micromanipulatorstepper --version",
      "supercli plugins install ./plugins/MicroManipulatorStepper --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MicroManipulatorStepper",
      "resource": "self",
      "action": "version",
      "description": "Print MicroManipulatorStepper version",
      "adapter": "process",
      "adapterConfig": {
        "command": "micromanipulatorstepper",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MicroManipulatorStepper: pip install micromanipulatorstepper"
      },
      "args": []
    },
    {
      "namespace": "MicroManipulatorStepper",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to micromanipulatorstepper CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "micromanipulatorstepper",
        "passthrough": true,
        "missingDependencyHelp": "Install MicroManipulatorStepper: pip install micromanipulatorstepper"
      },
      "args": []
    }
  ]
}