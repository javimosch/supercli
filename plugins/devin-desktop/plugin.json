  "commands": [{
    "namespace": "devin-desktop", "resource": "_", "action": "_",
    "description": "Passthrough to devin-desktop CLI",
    "adapter": "process", "adapterConfig": { "command": "devin-desktop", "passthrough": true, "missingDependencyHelp": "Install devin-desktop: apt-get install devin-desktop" }, "args": []
  }]
}
