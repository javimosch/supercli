{
  "name": "devin-desktop",
  "version": "0.1.0",
  "description": "CLI tool: devin-desktop",
  "source": "https://packages.debian.org/devin-desktop",
  "checks": [{ "type": "binary", "name": "devin-desktop" }],
  "install_guidance": {
    "plugin": "devin-desktop", "binary": "devin-desktop", "check": "which devin-desktop",
    "install_steps": ["apt-get install devin-desktop 2>/dev/null || which devin-desktop", "Verify: devin-desktop --version", "supercli plugins install ./plugins/devin-desktop --on-conflict replace --json"]
