{
  "name": "install-peerdeps",
  "version": "0.1.0",
  "description": "CLI to automatically install peerDeps",
  "source": "https://github.com/nathanhleung/install-peerdeps",
  "checks": [
    {
      "type": "binary",
      "name": "install-peerdeps"
    }
  ],
  "install_guidance": {
    "plugin": "install-peerdeps",
    "binary": "install-peerdeps",
    "check": "which install-peerdeps",
    "install_steps": [
      "brew install install-peerdeps",
      "Verify: install-peerdeps --version",
      "supercli plugins install ./plugins/install-peerdeps --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "install-peerdeps",
      "resource": "self",
      "action": "version",
      "description": "Print install-peerdeps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-peerdeps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install install-peerdeps: brew install install-peerdeps"
      },
      "args": []
    },
    {
      "namespace": "install-peerdeps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to install-peerdeps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "install-peerdeps",
        "passthrough": true,
        "missingDependencyHelp": "Install install-peerdeps"
      },
      "args": []
    }
  ]
}