{
  "name": "ctwill-twinx",
  "version": "0.1.0",
  "description": "CLI tool: ctwill-twinx",
  "source": "https://packages.debian.org/ctwill-twinx",
  "checks": [{ "type": "binary", "name": "ctwill-twinx" }],
  "install_guidance": {
    "plugin": "ctwill-twinx", "binary": "ctwill-twinx", "check": "which ctwill-twinx",
    "install_steps": ["apt-get install ctwill-twinx 2>/dev/null || which ctwill-twinx", "Verify: ctwill-twinx --version", "supercli plugins install ./plugins/ctwill-twinx --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctwill-twinx", "resource": "_", "action": "_",
    "description": "Passthrough to ctwill-twinx CLI",
    "adapter": "process", "adapterConfig": { "command": "ctwill-twinx", "passthrough": true, "missingDependencyHelp": "Install ctwill-twinx: apt-get install ctwill-twinx" }, "args": []
  }]
}
