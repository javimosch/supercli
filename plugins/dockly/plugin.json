{
  "name": "dockly",
  "version": "0.1.0",
  "description": "Interactive Docker container management from the terminal",
  "source": "https://github.com/valeriansaliou/dockly",
  "checks": [{ "type": "binary", "name": "dockly" }],
  "install_guidance": {
    "plugin": "dockly",
    "binary": "dockly",
    "check": "which dockly",
    "install_steps": ["npm install -g dockly", "Verify: dockly --version", "supercli plugins install ./plugins/dockly --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dockly",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dockly CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dockly",
      "passthrough": true,
      "missingDependencyHelp": "Install dockly: npm install -g dockly", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
