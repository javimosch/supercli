{
  "name": "zxing",
  "version": "0.1.0",
  "description": "Barcode scanner CLI",
  "source": "https://github.com/zxing/zxing",
  "checks": [
    {
      "type": "binary",
      "name": "zxing"
    }
  ],
  "install_guidance": {
    "plugin": "zxing",
    "binary": "zxing",
    "check": "which zxing",
    "install_steps": [
      "brew install zxing",
      "Verify: zxing --version",
      "supercli plugins install ./plugins/zxing --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "zxing",
      "resource": "self",
      "action": "version",
      "description": "Print zxing version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zxing",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zxing: brew install zxing"
      },
      "args": []
    },
    {
      "namespace": "zxing",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zxing CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zxing",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install zxing: brew install zxing"
      },
      "args": []
    }
  ]
}
