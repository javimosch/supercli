{
  "name": "dee-food",
  "version": "0.1.0",
  "description": "Search restaurants and food places via CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-food" }],
  "install_guidance": {
    "plugin": "dee-food",
    "binary": "dee-food",
    "check": "which dee-food",
    "install_steps": ["cargo install dee-food", "Verify: dee-food --version", "supercli plugins install ./plugins/dee-food --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-food",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-food CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-food",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-food: cargo install dee-food"
    },
    "args": []
  }]
}
