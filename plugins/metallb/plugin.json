{
  "name": "metallb",
  "version": "0.1.0",
  "description": "Network load balancer for bare-metal Kubernetes clusters",
  "source": "https://github.com/metallb/metallb",
  "checks": [{ "type": "binary", "name": "metallb" }],
  "install_guidance": {
    "plugin": "metallb",
    "binary": "metallb",
    "check": "which metallb",
    "install_steps": ["brew install metallb", "Verify: metallb --version", "supercli plugins install ./plugins/metallb --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "metallb",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to metallb CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "metallb",
      "passthrough": true,
      "missingDependencyHelp": "Install metallb: brew install metallb"
    },
    "args": []
  }]
}
