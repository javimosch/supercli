{
  "name": "lightning-lm",
  "version": "0.1.0",
  "description": "Lidar Localization and Mapping",
  "source": "https://github.com/lightning-lm/lightning-lm",
  "checks": [
    {
      "type": "binary",
      "name": "lightning-lm"
    }
  ],
  "install_guidance": {
    "plugin": "lightning-lm",
    "binary": "lightning-lm",
    "check": "which lightning-lm",
    "install_steps": [
      "pip install lightning-lm",
      "Verify: lightning-lm --version",
      "supercli plugins install ./plugins/lightning-lm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lightning-lm",
      "resource": "self",
      "action": "version",
      "description": "Print lightning-lm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lightning-lm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lightning-lm: pip install lightning-lm"
      },
      "args": []
    },
    {
      "namespace": "lightning-lm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lightning-lm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lightning-lm",
        "passthrough": true,
        "missingDependencyHelp": "Install lightning-lm: pip install lightning-lm"
      },
      "args": []
    }
  ]
}