{
  "name": "xgettext",
  "version": "0.1.0",
  "description": "CLI tool: xgettext",
  "source": "https://manpages.debian.org/xgettext",
  "checks": [
    {
      "type": "binary",
      "name": "xgettext"
    }
  ],
  "install_guidance": {
    "plugin": "xgettext",
    "binary": "xgettext",
    "check": "which xgettext",
    "install_steps": [
      "apt-get install xgettext 2>/dev/null || which xgettext",
      "Verify: xgettext --version",
      "supercli plugins install ./plugins/xgettext --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xgettext",
      "resource": "self",
      "action": "version",
      "description": "Print xgettext version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xgettext",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xgettext: apt-get install xgettext 2>/dev/null || which xgettext"
      },
      "args": []
    },
    {
      "namespace": "xgettext",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xgettext CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xgettext",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xgettext: apt-get install xgettext 2>/dev/null || which xgettext"
      },
      "args": []
    }
  ]
}