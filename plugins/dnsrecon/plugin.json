{
  "name": "dnsrecon",
  "version": "0.1.0",
  "description": "DNS enumeration tool with --json output",
  "source": "https://github.com/darkoperator/dnsrecon",
  "checks": [
    {
      "type": "binary",
      "name": "dnsrecon"
    }
  ],
  "install_guidance": {
    "plugin": "dnsrecon",
    "binary": "dnsrecon",
    "check": "which dnsrecon",
    "install_steps": [
      "pip install dnsrecon",
      "Verify: dnsrecon --version",
      "supercli plugins install ./plugins/dnsrecon --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "dnsrecon",
      "resource": "self",
      "action": "version",
      "description": "Print dnsrecon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnsrecon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dnsrecon: pip install dnsrecon"
      },
      "args": []
    },
    {
      "namespace": "dnsrecon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dnsrecon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnsrecon",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dnsrecon: pip install dnsrecon"
      },
      "args": []
    }
  ]
}
