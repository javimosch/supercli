{
  "name": "pytest-benchmark",
  "version": "0.1.0",
  "description": "CLI tool: pytest-benchmark",
  "source": "https://manpages.debian.org/pytest-benchmark",
  "checks": [
    {
      "type": "binary",
      "name": "pytest-benchmark"
    }
  ],
  "install_guidance": {
    "plugin": "pytest-benchmark",
    "binary": "pytest-benchmark",
    "check": "which pytest-benchmark",
    "install_steps": [
      "apt-get install pytest-benchmark 2>/dev/null || which pytest-benchmark",
      "Verify: pytest-benchmark --version",
      "supercli plugins install ./plugins/pytest-benchmark --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pytest-benchmark",
      "resource": "self",
      "action": "version",
      "description": "Print pytest-benchmark version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pytest-benchmark",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pytest-benchmark: apt-get install pytest-benchmark 2>/dev/null || which pytest-benchmark"
      },
      "args": []
    },
    {
      "namespace": "pytest-benchmark",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pytest-benchmark CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pytest-benchmark",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pytest-benchmark: apt-get install pytest-benchmark 2>/dev/null || which pytest-benchmark"
      },
      "args": []
    }
  ]
}