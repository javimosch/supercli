{
  "name": "djpeg",
  "version": "0.1.0",
  "description": "decompress a JPEG file to an image file (libjpeg-progs)",
  "source": "https://packages.debian.org/djpeg",
  "checks": [{ "type": "binary", "name": "djpeg" }],
  "install_guidance": {
    "plugin": "djpeg", "binary": "djpeg", "check": "which djpeg",
    "install_steps": ["apt-get install djpeg 2>/dev/null || which djpeg", "Verify: djpeg --version", "supercli plugins install ./plugins/djpeg --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "djpeg", "resource": "_", "action": "_",
    "description": "Passthrough to djpeg CLI",
    "adapter": "process", "adapterConfig": { "command": "djpeg", "passthrough": true, "missingDependencyHelp": "Install djpeg: apt-get install djpeg" }, "args": []
  }]
}
