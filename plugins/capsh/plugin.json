{
  "name": "capsh",
  "version": "0.1.0",
  "description": "CLI tool: capsh",
  "source": "https://packages.debian.org/capsh",
  "checks": [{ "type": "binary", "name": "capsh" }],
  "install_guidance": {
    "plugin": "capsh", "binary": "capsh", "check": "which capsh",
    "install_steps": ["apt-get install capsh 2>/dev/null || which capsh", "Verify: capsh --version", "supercli plugins install ./plugins/capsh --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "capsh", "resource": "_", "action": "_",
    "description": "Passthrough to capsh CLI",
    "adapter": "process", "adapterConfig": { "command": "capsh", "passthrough": true, "missingDependencyHelp": "Install capsh: apt-get install capsh" }, "args": []
  }]
}
