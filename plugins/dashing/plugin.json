{
  "name": "dashing",
  "version": "1.0.0",
  "description": "dashing \u2014 Dashboard generator",
  "source": "github.com/technosophos/dashing",
  "checks": [
    {
      "type": "binary",
      "name": "dashing"
    }
  ],
  "install_guidance": {
    "plugin": "dashing",
    "binary": "dashing",
    "check": "which dashing",
    "install_steps": [
      "# Install dashing",
      "# See github.com/technosophos/dashing",
      "# apt: sudo apt-get install dashing",
      "# brew: brew install dashing",
      "# cargo: cargo install dashing",
      "# npm: npm install -g dashing",
      "# pip: pip install dashing"
    ]
  },
  "commands": [
    {
      "namespace": "dashing",
      "resource": "dashing",
      "action": "run",
      "description": "Run dashing",
      "adapter": "process",
      "adapterConfig": {
        "command": "dashing",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dashing from github.com/technosophos/dashing"
      },
      "args": []
    }
  ]
}