{
  "name": "sqlite-data",
  "version": "0.1.0",
  "description": "A fast, lightweight replacement for SwiftData, powered by SQL and supporting CloudKit synchronizatio",
  "source": "https://github.com/sqlite-data/sqlite-data",
  "checks": [
    {
      "type": "binary",
      "name": "sqlite-data"
    }
  ],
  "install_guidance": {
    "plugin": "sqlite-data",
    "binary": "sqlite-data",
    "check": "which sqlite-data",
    "install_steps": [
      "pip install sqlite-data",
      "Verify: sqlite-data --version",
      "supercli plugins install ./plugins/sqlite-data --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sqlite-data",
      "resource": "self",
      "action": "version",
      "description": "Print sqlite-data version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqlite-data",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sqlite-data: pip install sqlite-data"
      },
      "args": []
    },
    {
      "namespace": "sqlite-data",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sqlite-data CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqlite-data",
        "passthrough": true,
        "missingDependencyHelp": "Install sqlite-data: pip install sqlite-data"
      },
      "args": []
    }
  ]
}