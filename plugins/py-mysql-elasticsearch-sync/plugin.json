{
  "name": "py-mysql-elasticsearch-sync",
  "version": "0.1.0",
  "description": "MySQL to Elasticsearch  sync tool, written in Python.",
  "source": "https://github.com/py-mysql-elasticsearch-sync/py-mysql-elasticsearch-sync",
  "checks": [
    {
      "type": "binary",
      "name": "py-mysql-elasticsearch-sync"
    }
  ],
  "install_guidance": {
    "plugin": "py-mysql-elasticsearch-sync",
    "binary": "py-mysql-elasticsearch-sync",
    "check": "which py-mysql-elasticsearch-sync",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: py-mysql-elasticsearch-sync --version",
      "supercli plugins install ./plugins/py-mysql-elasticsearch-sync --on-conflict replace --json"
    ],
    "note": "Python language CLI tool"
  },
  "commands": [
    {
      "namespace": "py-mysql-elasticsearch-sync",
      "resource": "self",
      "action": "version",
      "description": "Print py-mysql-elasticsearch-sync version",
      "adapter": "process",
      "adapterConfig": {
        "command": "py-mysql-elasticsearch-sync",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install py-mysql-elasticsearch-sync from project repository"
      },
      "args": []
    },
    {
      "namespace": "py-mysql-elasticsearch-sync",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to py-mysql-elasticsearch-sync CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "py-mysql-elasticsearch-sync",
        "passthrough": true,
        "missingDependencyHelp": "Install py-mysql-elasticsearch-sync from project repository"
      },
      "args": []
    }
  ]
}