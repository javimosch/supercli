{
  "name": "espeak-ng",
  "version": "0.1.0",
  "description": "Open-source speech synthesizer command-line tool",
  "source": "https://manpages.debian.org/espeak-ng",
  "checks": [{ "type": "binary", "name": "espeak-ng" }],
  "install_guidance": {
    "plugin": "espeak-ng",
    "binary": "espeak-ng",
    "check": "which espeak-ng",
    "install_steps": [
      "apt-get install espeak-ng",
      "Verify: espeak-ng --version",
      "supercli plugins install ./plugins/espeak-ng --on-conflict replace --json"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [{
    "namespace": "espeak-ng",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to espeak-ng CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "espeak-ng",
      "passthrough": true,
      "missingDependencyHelp": "Install espeak-ng: apt-get install espeak-ng"
    },
    "args": []
  }]
}
