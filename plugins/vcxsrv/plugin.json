{
  "name": "vcxsrv",
  "version": "0.1.0",
  "description": "Windows X-server based on the xorg git sources (like xming or cygwin's xwin), but compiled with Visu",
  "source": "https://github.com/vcxsrv/vcxsrv",
  "checks": [
    {
      "type": "binary",
      "name": "vcxsrv"
    }
  ],
  "install_guidance": {
    "plugin": "vcxsrv",
    "binary": "vcxsrv",
    "check": "which vcxsrv",
    "install_steps": [
      "pip install vcxsrv",
      "Verify: vcxsrv --version",
      "supercli plugins install ./plugins/vcxsrv --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vcxsrv",
      "resource": "self",
      "action": "version",
      "description": "Print vcxsrv version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vcxsrv",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vcxsrv: pip install vcxsrv"
      },
      "args": []
    },
    {
      "namespace": "vcxsrv",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vcxsrv CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vcxsrv",
        "passthrough": true,
        "missingDependencyHelp": "Install vcxsrv: pip install vcxsrv"
      },
      "args": []
    }
  ]
}