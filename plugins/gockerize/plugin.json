{
  "name": "gockerize",
  "version": "0.1.0",
  "description": "Package Go applications into minimal containers without Dockerfiles",
  "source": "go",
  "checks": [{ "type": "binary", "name": "gockerize" }],
  "install_guidance": {
    "plugin": "gockerize",
    "binary": "gockerize",
    "check": "which gockerize",
    "install_steps": ["go install github.com/magiconair/gockerize@latest", "Verify: gockerize --version", "supercli plugins install ./plugins/gockerize --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gockerize",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gockerize CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gockerize",
      "passthrough": true,
      "missingDependencyHelp": "Install gockerize: go install github.com/magiconair/gockerize@latest"
    },
    "args": []
  }]
}
