{
  "name": "git-octopus",
  "version": "0.1.0",
  "description": "Continuous merge workflow",
  "source": "https://github.com/lesfurets/git-octopus",
  "checks": [
    {
      "type": "binary",
      "name": "git-octopus"
    }
  ],
  "install_guidance": {
    "plugin": "git-octopus",
    "binary": "git-octopus",
    "check": "which git-octopus",
    "install_steps": [
      "brew install git-octopus",
      "Verify: git-octopus --version",
      "supercli plugins install ./plugins/git-octopus --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-octopus",
      "resource": "self",
      "action": "version",
      "description": "Print git-octopus version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-octopus",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-octopus: brew install git-octopus"
      },
      "args": []
    },
    {
      "namespace": "git-octopus",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-octopus CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-octopus",
        "passthrough": true,
        "missingDependencyHelp": "Install git-octopus"
      },
      "args": []
    }
  ]
}