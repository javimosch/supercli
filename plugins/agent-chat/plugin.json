{
  "name": "agent-chat",
  "version": "0.1.0",
  "description": "CLI tool: agent-chat",
  "source": "https://packages.debian.org/agent-chat",
  "checks": [{ "type": "binary", "name": "agent-chat" }],
  "install_guidance": {
    "plugin": "agent-chat", "binary": "agent-chat", "check": "which agent-chat",
    "install_steps": ["apt-get install agent-chat 2>/dev/null || which agent-chat", "Verify: agent-chat --version", "supercli plugins install ./plugins/agent-chat --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "agent-chat", "resource": "_", "action": "_",
    "description": "Passthrough to agent-chat CLI",
    "adapter": "process", "adapterConfig": { "command": "agent-chat", "passthrough": true, "missingDependencyHelp": "Install agent-chat: apt-get install agent-chat" }, "args": []
  }]
}
