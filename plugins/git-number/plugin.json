{
  "name": "git-number",
  "version": "0.1.0",
  "description": "Use numbers for dealing with files in git",
  "source": "https://github.com/holygeek/git-number",
  "checks": [
    {
      "type": "binary",
      "name": "git-number"
    }
  ],
  "install_guidance": {
    "plugin": "git-number",
    "binary": "git-number",
    "check": "which git-number",
    "install_steps": [
      "brew install git-number",
      "Verify: git-number --version",
      "supercli plugins install ./plugins/git-number --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-number",
      "resource": "self",
      "action": "version",
      "description": "Print git-number version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-number",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-number: brew install git-number"
      },
      "args": []
    },
    {
      "namespace": "git-number",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-number CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-number",
        "passthrough": true,
        "missingDependencyHelp": "Install git-number"
      },
      "args": []
    }
  ]
}