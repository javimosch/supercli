{
  "name": "gerbview-cli",
  "version": "0.1.0",
  "description": "Simple CLI Gerber file viewer and renderer for the terminal",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "gerbview-cli" }],
  "install_guidance": {
    "plugin": "gerbview-cli",
    "binary": "gerbview-cli",
    "check": "which gerbview-cli",
    "install_steps": ["cargo install gerbview-cli", "Verify: gerbview-cli --version", "supercli plugins install ./plugins/gerbview-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gerbview-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gerbview-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gerbview-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install gerbview-cli: cargo install gerbview-cli"
    },
    "args": []
  }]
}
