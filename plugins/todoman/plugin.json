{
  "name": "todoman",
  "version": "0.1.0",
  "description": "Simple standards-based CLI todo manager (icalendar files) that syncs via vdirsyncer/CalDAV, from pimutils",
  "source": "https://github.com/pimutils/todoman",
  "checks": [
    { "type": "binary", "name": "todo" }
  ],
  "install_guidance": {
    "plugin": "todoman",
    "binary": "todo",
    "check": "which todo",
    "install_steps": [
      "pipx install todoman  # or: sudo apt install todoman",
      "Verify: todo --version",
      "supercli plugins install ./plugins/todoman --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "todoman",
      "resource": "self",
      "action": "version",
      "description": "Print todoman version",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "tasks",
      "action": "list",
      "description": "List pending tasks (todo list; use --porcelain for JSON output)",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["list"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "tasks",
      "action": "new",
      "description": "Create a task (todo new -l <list> -s <summary>; interactive if no summary)",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["new"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "tasks",
      "action": "show",
      "description": "Show details of a task by id",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["show"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "tasks",
      "action": "edit",
      "description": "Edit a task's summary/due date/etc. (todo edit <id>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["edit"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "tasks",
      "action": "done",
      "description": "Mark a task as completed (todo done <id>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["done"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "tasks",
      "action": "delete",
      "description": "Delete a task permanently (todo delete <id>)",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["delete"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "tasks",
      "action": "flush",
      "description": "Delete all completed tasks",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["flush"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "lists",
      "action": "list",
      "description": "List all task lists (todo list --list ? shows -l options)",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "baseArgs": ["list", "--porcelain"],
        "passthrough": true,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    },
    {
      "namespace": "todoman",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to todo CLI (todo copy, todo move, todo repl, etc.)",
      "adapter": "process",
      "adapterConfig": {
        "command": "todo",
        "passthrough": true,
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install todoman: pipx install todoman"
      },
      "args": []
    }
  ]
}
