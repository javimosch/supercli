{
  "name": "gitbatch",
  "version": "0.1.0",
  "description": "Manage your git repositories in one place",
  "source": "https://github.com/isacikgoz/gitbatch",
  "checks": [
    {
      "type": "binary",
      "name": "gitbatch"
    }
  ],
  "install_guidance": {
    "plugin": "gitbatch",
    "binary": "gitbatch",
    "check": "which gitbatch",
    "install_steps": [
      "brew install gitbatch",
      "Verify: gitbatch --version",
      "supercli plugins install ./plugins/gitbatch --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gitbatch",
      "resource": "self",
      "action": "version",
      "description": "Print gitbatch version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitbatch",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gitbatch: brew install gitbatch"
      },
      "args": []
    },
    {
      "namespace": "gitbatch",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitbatch CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitbatch",
        "passthrough": true,
        "missingDependencyHelp": "Install gitbatch"
      },
      "args": []
    }
  ]
}