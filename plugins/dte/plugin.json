{
  "name": "dte",
  "version": "0.1.0",
  "description": "Small configurable text editor for the console",
  "source": "https://github.com/craigbarnes/dte",
  "checks": [{ "type": "binary", "name": "dte" }],
  "install_guidance": {
    "plugin": "dte",
    "binary": "dte",
    "check": "which dte",
    "install_steps": ["brew install dte", "Verify: dte --version", "supercli plugins install ./plugins/dte --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dte",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dte CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dte",
      "passthrough": true,
      "missingDependencyHelp": "Install dte: brew install dte", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
