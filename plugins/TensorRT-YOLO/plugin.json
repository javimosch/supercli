{
  "name": "TensorRT-YOLO",
  "version": "0.1.0",
  "description": "\ud83d\ude80 Easier & Faster YOLO Deployment Toolkit for NVIDIA \ud83d\udee0\ufe0f",
  "source": "https://github.com/TensorRT-YOLO/TensorRT-YOLO",
  "checks": [
    {
      "type": "binary",
      "name": "tensorrt-yolo"
    }
  ],
  "install_guidance": {
    "plugin": "TensorRT-YOLO",
    "binary": "tensorrt-yolo",
    "check": "which tensorrt-yolo",
    "install_steps": [
      "pip install tensorrt-yolo",
      "Verify: tensorrt-yolo --version",
      "supercli plugins install ./plugins/TensorRT-YOLO --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "TensorRT-YOLO",
      "resource": "self",
      "action": "version",
      "description": "Print TensorRT-YOLO version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tensorrt-yolo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install TensorRT-YOLO: pip install tensorrt-yolo"
      },
      "args": []
    },
    {
      "namespace": "TensorRT-YOLO",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tensorrt-yolo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tensorrt-yolo",
        "passthrough": true,
        "missingDependencyHelp": "Install TensorRT-YOLO: pip install tensorrt-yolo"
      },
      "args": []
    }
  ]
}