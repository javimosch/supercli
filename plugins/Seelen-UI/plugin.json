{
  "name": "Seelen-UI",
  "version": "0.1.0",
  "description": "The Fully Customizable Desktop Environment for Windows 10/11.",
  "source": "https://github.com/Seelen-UI/Seelen-UI",
  "checks": [
    {
      "type": "binary",
      "name": "seelen-ui"
    }
  ],
  "install_guidance": {
    "plugin": "Seelen-UI",
    "binary": "seelen-ui",
    "check": "which seelen-ui",
    "install_steps": [
      "pip install seelen-ui",
      "Verify: seelen-ui --version",
      "supercli plugins install ./plugins/Seelen-UI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Seelen-UI",
      "resource": "self",
      "action": "version",
      "description": "Print Seelen-UI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "seelen-ui",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Seelen-UI: pip install seelen-ui"
      },
      "args": []
    },
    {
      "namespace": "Seelen-UI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to seelen-ui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "seelen-ui",
        "passthrough": true,
        "missingDependencyHelp": "Install Seelen-UI: pip install seelen-ui"
      },
      "args": []
    }
  ]
}