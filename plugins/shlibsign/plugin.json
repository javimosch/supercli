{
  "name": "shlibsign",
  "version": "0.1.0",
  "description": "CLI tool: shlibsign",
  "source": "https://manpages.debian.org/shlibsign",
  "checks": [
    {
      "type": "binary",
      "name": "shlibsign"
    }
  ],
  "install_guidance": {
    "plugin": "shlibsign",
    "binary": "shlibsign",
    "check": "which shlibsign",
    "install_steps": [
      "apt-get install shlibsign 2>/dev/null || which shlibsign",
      "Verify: shlibsign --version",
      "supercli plugins install ./plugins/shlibsign --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "shlibsign",
      "resource": "self",
      "action": "version",
      "description": "Print shlibsign version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shlibsign",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install shlibsign: apt-get install shlibsign 2>/dev/null || which shlibsign"
      },
      "args": []
    },
    {
      "namespace": "shlibsign",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shlibsign CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shlibsign",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install shlibsign: apt-get install shlibsign 2>/dev/null || which shlibsign"
      },
      "args": []
    }
  ]
}