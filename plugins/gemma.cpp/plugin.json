{
  "name": "gemma.cpp",
  "version": "0.1.0",
  "description": "lightweight, standalone C++ inference engine for Google's Gemma models.",
  "source": "https://github.com/gemma.cpp/gemma.cpp",
  "checks": [
    {
      "type": "binary",
      "name": "gemma.cpp"
    }
  ],
  "install_guidance": {
    "plugin": "gemma.cpp",
    "binary": "gemma.cpp",
    "check": "which gemma.cpp",
    "install_steps": [
      "pip install gemma.cpp",
      "Verify: gemma.cpp --version",
      "supercli plugins install ./plugins/gemma.cpp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gemma.cpp",
      "resource": "self",
      "action": "version",
      "description": "Print gemma.cpp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemma.cpp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gemma.cpp: pip install gemma.cpp"
      },
      "args": []
    },
    {
      "namespace": "gemma.cpp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gemma.cpp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gemma.cpp",
        "passthrough": true,
        "missingDependencyHelp": "Install gemma.cpp: pip install gemma.cpp"
      },
      "args": []
    }
  ]
}