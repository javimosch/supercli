{
  "name": "gpg-wks-server",
  "version": "0.1.0",
  "description": "CLI tool: gpg-wks-server",
  "source": "https://manpages.debian.org/gpg-wks-server",
  "checks": [
    {
      "type": "binary",
      "name": "gpg-wks-server"
    }
  ],
  "install_guidance": {
    "plugin": "gpg-wks-server",
    "binary": "gpg-wks-server",
    "check": "which gpg-wks-server",
    "install_steps": [
      "apt-get install gpg-wks-server 2>/dev/null || which gpg-wks-server",
      "Verify: gpg-wks-server --version",
      "supercli plugins install ./plugins/gpg-wks-server --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gpg-wks-server",
      "resource": "self",
      "action": "version",
      "description": "Print gpg-wks-server version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpg-wks-server",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gpg-wks-server: apt-get install gpg-wks-server 2>/dev/null || which gpg-wks-server"
      },
      "args": []
    },
    {
      "namespace": "gpg-wks-server",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gpg-wks-server CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gpg-wks-server",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gpg-wks-server: apt-get install gpg-wks-server 2>/dev/null || which gpg-wks-server"
      },
      "args": []
    }
  ]
}