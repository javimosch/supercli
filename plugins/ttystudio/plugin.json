{
  "name": "ttystudio",
  "version": "0.1.0",
  "description": "A terminal-to-gif recorder minus the headaches",
  "source": "https://github.com/chjj/ttystudio",
  "checks": [
    {
      "type": "binary",
      "name": "ttystudio"
    }
  ],
  "install_guidance": {
    "plugin": "ttystudio",
    "binary": "ttystudio",
    "check": "which ttystudio",
    "install_steps": [
      "See https://github.com/chjj/ttystudio",
      "Verify: ttystudio --version",
      "supercli plugins install ./plugins/ttystudio --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "ttystudio",
      "resource": "self",
      "action": "version",
      "description": "Print ttystudio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttystudio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ttystudio: See https://github.com/chjj/ttystudio"
      },
      "args": []
    },
    {
      "namespace": "ttystudio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ttystudio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ttystudio",
        "passthrough": true,
        "missingDependencyHelp": "Install ttystudio"
      },
      "args": []
    }
  ]
}