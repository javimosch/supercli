{
  "name": "zig-book",
  "version": "0.1.0",
  "description": "An open, technical and introductory book for the Zig programming language \ud83d\udcda\ud83d\udcd6",
  "source": "https://github.com/zig-book/zig-book",
  "checks": [
    {
      "type": "binary",
      "name": "zig-book"
    }
  ],
  "install_guidance": {
    "plugin": "zig-book",
    "binary": "zig-book",
    "check": "which zig-book",
    "install_steps": [
      "pip install zig-book",
      "Verify: zig-book --version",
      "supercli plugins install ./plugins/zig-book --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig-book",
      "resource": "self",
      "action": "version",
      "description": "Print zig-book version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-book",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig-book: pip install zig-book"
      },
      "args": []
    },
    {
      "namespace": "zig-book",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig-book CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-book",
        "passthrough": true,
        "missingDependencyHelp": "Install zig-book: pip install zig-book"
      },
      "args": []
    }
  ]
}