{
  "plugin": "ntfsfix",
  "binary": "ntfsfix",
  "check": "which ntfsfix",
  "install_steps": [
    "# Install ntfsfix",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ntfsfix-linux-amd64 -o /usr/local/bin/ntfsfix",
    "chmod +x /usr/local/bin/ntfsfix",
    "# Or via package manager, see /usr/bin/ntfsfix"
  ]
}