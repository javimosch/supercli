{
  "name": "csv-tool",
  "version": "0.1.0",
  "description": "Minimalist command-line utility for CSV data operations",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "csv-tool" }],
  "install_guidance": {
    "plugin": "csv-tool",
    "binary": "csv-tool",
    "check": "which csv-tool",
    "install_steps": ["npm install -g csv-tool", "Verify: csv-tool --version", "supercli plugins install ./plugins/csv-tool --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "csv-tool",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to csv-tool CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "csv-tool",
      "passthrough": true,
      "missingDependencyHelp": "Install csv-tool: npm install -g csv-tool"
    },
    "args": []
  }]
}
