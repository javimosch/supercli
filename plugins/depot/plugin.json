  "commands": [{
    "namespace": "depot", "resource": "_", "action": "_",
    "description": "Passthrough to depot CLI",
    "adapter": "process", "adapterConfig": { "command": "depot", "passthrough": true, "missingDependencyHelp": "Install depot: apt-get install depot" }, "args": []
  }]
}
