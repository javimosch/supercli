{
  "name": "depot",
  "version": "0.1.0",
  "description": "CLI tool: depot",
  "source": "https://packages.debian.org/depot",
  "checks": [{ "type": "binary", "name": "depot" }],
  "install_guidance": {
    "plugin": "depot", "binary": "depot", "check": "which depot",
    "install_steps": ["apt-get install depot 2>/dev/null || which depot", "Verify: depot --version", "supercli plugins install ./plugins/depot --on-conflict replace --json"]
