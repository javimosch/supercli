{
  "name": "dnslookup",
  "version": "1.0.0",
  "description": "dnslookup \u2014 DNS record lookup",
  "source": "github.com/ameshkov/dnslookup",
  "checks": [
    {
      "type": "binary",
      "name": "dnslookup"
    }
  ],
  "install_guidance": {
    "plugin": "dnslookup",
    "binary": "dnslookup",
    "check": "which dnslookup",
    "install_steps": [
      "# Install dnslookup",
      "# See github.com/ameshkov/dnslookup",
      "# apt: sudo apt-get install dnslookup",
      "# brew: brew install dnslookup",
      "# cargo: cargo install dnslookup",
      "# npm: npm install -g dnslookup",
      "# pip: pip install dnslookup"
    ]
  },
  "commands": [
    {
      "namespace": "dnslookup",
      "resource": "dnslookup",
      "action": "run",
      "description": "Run dnslookup",
      "adapter": "process",
      "adapterConfig": {
        "command": "dnslookup",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dnslookup from github.com/ameshkov/dnslookup"
      },
      "args": []
    }
  ]
}