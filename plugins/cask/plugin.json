{
  "name": "cask",
  "version": "0.1.0",
  "description": "Emacs dependency management",
  "checks": [
    {
      "type": "binary",
      "name": "cask"
    }
  ],
  "install_guidance": {
    "plugin": "cask",
    "binary": "cask",
    "check": "which cask",
    "install_steps": [
      "brew install cask",
      "Verify: cask --version",
      "supercli plugins install ./plugins/cask --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cask",
      "resource": "self",
      "action": "version",
      "description": "Print cask version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cask",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cask: brew install cask"
      },
      "args": []
    },
    {
      "namespace": "cask",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cask CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cask",
        "passthrough": true,
        "missingDependencyHelp": "Install cask"
      },
      "args": []
    }
  ]
}