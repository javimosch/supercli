{
  "name": "InstaEclipse",
  "version": "0.1.0",
  "description": "An Instagram Xposed module with features like Developer Options, Ghost Mode, Ad-Free browsing, and D",
  "source": "https://github.com/InstaEclipse/InstaEclipse",
  "checks": [
    {
      "type": "binary",
      "name": "instaeclipse"
    }
  ],
  "install_guidance": {
    "plugin": "InstaEclipse",
    "binary": "instaeclipse",
    "check": "which instaeclipse",
    "install_steps": [
      "pip install instaeclipse",
      "Verify: instaeclipse --version",
      "supercli plugins install ./plugins/InstaEclipse --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "InstaEclipse",
      "resource": "self",
      "action": "version",
      "description": "Print InstaEclipse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "instaeclipse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install InstaEclipse: pip install instaeclipse"
      },
      "args": []
    },
    {
      "namespace": "InstaEclipse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to instaeclipse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "instaeclipse",
        "passthrough": true,
        "missingDependencyHelp": "Install InstaEclipse: pip install instaeclipse"
      },
      "args": []
    }
  ]
}