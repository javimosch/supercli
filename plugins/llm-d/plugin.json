{
  "name": "llm-d",
  "version": "0.1.0",
  "description": "Achieve state of the art inference performance with modern accelerators on Kubernetes",
  "source": "https://github.com/llm-d/llm-d",
  "checks": [
    {
      "type": "binary",
      "name": "llm-d"
    }
  ],
  "install_guidance": {
    "plugin": "llm-d",
    "binary": "llm-d",
    "check": "which llm-d",
    "install_steps": [
      "pip install llm-d",
      "Verify: llm-d --version",
      "supercli plugins install ./plugins/llm-d --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "llm-d",
      "resource": "self",
      "action": "version",
      "description": "Print llm-d version",
      "adapter": "process",
      "adapterConfig": {
        "command": "llm-d",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install llm-d: pip install llm-d"
      },
      "args": []
    },
    {
      "namespace": "llm-d",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to llm-d CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "llm-d",
        "passthrough": true,
        "missingDependencyHelp": "Install llm-d: pip install llm-d"
      },
      "args": []
    }
  ]
}