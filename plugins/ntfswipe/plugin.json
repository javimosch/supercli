{
  "name": "ntfswipe",
  "version": "1.0.0",
  "description": "ntfswipe \u2014 ntfswipe \u2014 CLI utility",
  "source": "/usr/bin/ntfswipe",
  "checks": [
    {
      "type": "binary",
      "name": "ntfswipe"
    }
  ],
  "install_guidance": {
    "plugin": "ntfswipe",
    "binary": "ntfswipe",
    "check": "which ntfswipe",
    "install_steps": [
      "# Install ntfswipe:",
      "# apt: sudo apt-get install ntfswipe",
      "# brew: brew install ntfswipe",
      "# cargo: cargo install ntfswipe",
      "# npm: npm install -g ntfswipe",
      "# pip: pip install ntfswipe",
      "# or download from /usr/bin/ntfswipe"
    ]
  },
  "commands": [
    {
      "namespace": "ntfswipe",
      "resource": "ntfswipe",
      "action": "run",
      "description": "Run ntfswipe",
      "adapter": "process",
      "adapterConfig": {
        "command": "ntfswipe",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ntfswipe from /usr/bin/ntfswipe"
      },
      "args": []
    }
  ]
}