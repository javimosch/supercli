{
  "name": "ZalithLauncher2",
  "version": "0.1.0",
  "description": "A Minecraft: Java Edition Launcher for Android",
  "source": "https://github.com/ZalithLauncher2/ZalithLauncher2",
  "checks": [
    {
      "type": "binary",
      "name": "zalithlauncher2"
    }
  ],
  "install_guidance": {
    "plugin": "ZalithLauncher2",
    "binary": "zalithlauncher2",
    "check": "which zalithlauncher2",
    "install_steps": [
      "pip install zalithlauncher2",
      "Verify: zalithlauncher2 --version",
      "supercli plugins install ./plugins/ZalithLauncher2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ZalithLauncher2",
      "resource": "self",
      "action": "version",
      "description": "Print ZalithLauncher2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zalithlauncher2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ZalithLauncher2: pip install zalithlauncher2"
      },
      "args": []
    },
    {
      "namespace": "ZalithLauncher2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zalithlauncher2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zalithlauncher2",
        "passthrough": true,
        "missingDependencyHelp": "Install ZalithLauncher2: pip install zalithlauncher2"
      },
      "args": []
    }
  ]
}