{
  "name": "graphiti",
  "version": "0.1.0",
  "description": "Build Real-Time Knowledge Graphs for AI Agents",
  "source": "https://github.com/graphiti/graphiti",
  "checks": [
    {
      "type": "binary",
      "name": "graphiti"
    }
  ],
  "install_guidance": {
    "plugin": "graphiti",
    "binary": "graphiti",
    "check": "which graphiti",
    "install_steps": [
      "pip install graphiti",
      "Verify: graphiti --version",
      "supercli plugins install ./plugins/graphiti --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "graphiti",
      "resource": "self",
      "action": "version",
      "description": "Print graphiti version",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphiti",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install graphiti: pip install graphiti"
      },
      "args": []
    },
    {
      "namespace": "graphiti",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to graphiti CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "graphiti",
        "passthrough": true,
        "missingDependencyHelp": "Install graphiti: pip install graphiti"
      },
      "args": []
    }
  ]
}