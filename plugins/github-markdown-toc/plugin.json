{
  "name": "github-markdown-toc",
  "version": "0.1.0",
  "description": "Easy TOC creation for GitHub README.md (in go)",
  "source": "https://github.com/ekalinin/github-markdown-toc.go",
  "checks": [
    {
      "type": "binary",
      "name": "github-markdown-toc"
    }
  ],
  "install_guidance": {
    "plugin": "github-markdown-toc",
    "binary": "github-markdown-toc",
    "check": "which github-markdown-toc",
    "install_steps": [
      "brew install github-markdown-toc",
      "Verify: github-markdown-toc --version",
      "supercli plugins install ./plugins/github-markdown-toc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "github-markdown-toc",
      "resource": "self",
      "action": "version",
      "description": "Print github-markdown-toc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-markdown-toc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install github-markdown-toc: brew install github-markdown-toc"
      },
      "args": []
    },
    {
      "namespace": "github-markdown-toc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to github-markdown-toc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "github-markdown-toc",
        "passthrough": true,
        "missingDependencyHelp": "Install github-markdown-toc"
      },
      "args": []
    }
  ]
}