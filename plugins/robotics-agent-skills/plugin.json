{
  "name": "robotics-agent-skills",
  "version": "0.1.0",
  "description": "Agent skills for production-grade robotics software — ROS1, ROS2, design patterns, SOLID, testing — for Claude Code, Cursor, Copilot",
  "source": "https://github.com/arpitg1304/robotics-agent-skills",
  "checks": [{ "type": "binary", "name": "git" }],
  "install_guidance": {
    "plugin": "robotics-agent-skills",
    "binary": "git",
    "check": "which git",
    "install_steps": [
      "git clone https://github.com/arpitg1304/robotics-agent-skills.git",
      "supercli plugins install ./plugins/robotics-agent-skills --on-conflict replace --json",
      "sc skills teach robotics-agent-skills:quickstart"
    ]
  },
  "learn": { "file": "skills/quickstart/SKILL.md" },
  "commands": [
    { "namespace": "robotics-agent-skills", "resource": "self", "action": "version", "description": "Print info", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["robotics-agent-skills v0.1.0 — Use sc skills teach robotics-agent-skills:quickstart"], "missingDependencyHelp": "Clone: git clone https://github.com/arpitg1304/robotics-agent-skills.git" }, "args": [] },
    { "namespace": "robotics-agent-skills", "resource": "_", "action": "_", "description": "Passthrough", "adapter": "process", "adapterConfig": { "command": "echo", "baseArgs": ["Clone https://github.com/arpitg1304/robotics-agent-skills.git then: sc skills teach robotics-agent-skills:quickstart"], "passthrough": true, "missingDependencyHelp": "Install: git clone https://github.com/arpitg1304/robotics-agent-skills.git" }, "args": [] }
  ]
}
