{
  "name": "mimiclaw",
  "version": "0.1.0",
  "description": "MimiClaw: Run OpenClaw on a $5 chip. No OS(Linux). No Node.js. No Mac mini. No Raspberry Pi. No VPS.",
  "source": "https://github.com/mimiclaw/mimiclaw",
  "checks": [
    {
      "type": "binary",
      "name": "mimiclaw"
    }
  ],
  "install_guidance": {
    "plugin": "mimiclaw",
    "binary": "mimiclaw",
    "check": "which mimiclaw",
    "install_steps": [
      "pip install mimiclaw",
      "Verify: mimiclaw --version",
      "supercli plugins install ./plugins/mimiclaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mimiclaw",
      "resource": "self",
      "action": "version",
      "description": "Print mimiclaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mimiclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mimiclaw: pip install mimiclaw"
      },
      "args": []
    },
    {
      "namespace": "mimiclaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mimiclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mimiclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install mimiclaw: pip install mimiclaw"
      },
      "args": []
    }
  ]
}