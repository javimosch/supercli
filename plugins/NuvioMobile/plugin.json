{
  "name": "NuvioMobile",
  "version": "0.1.0",
  "description": "Official Nuvio Mobile Repository",
  "source": "https://github.com/NuvioMobile/NuvioMobile",
  "checks": [
    {
      "type": "binary",
      "name": "nuviomobile"
    }
  ],
  "install_guidance": {
    "plugin": "NuvioMobile",
    "binary": "nuviomobile",
    "check": "which nuviomobile",
    "install_steps": [
      "pip install nuviomobile",
      "Verify: nuviomobile --version",
      "supercli plugins install ./plugins/NuvioMobile --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NuvioMobile",
      "resource": "self",
      "action": "version",
      "description": "Print NuvioMobile version",
      "adapter": "process",
      "adapterConfig": {
        "command": "nuviomobile",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NuvioMobile: pip install nuviomobile"
      },
      "args": []
    },
    {
      "namespace": "NuvioMobile",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to nuviomobile CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "nuviomobile",
        "passthrough": true,
        "missingDependencyHelp": "Install NuvioMobile: pip install nuviomobile"
      },
      "args": []
    }
  ]
}