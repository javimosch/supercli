{
  "name": "hyperfine",
  "version": "0.1.0",
  "description": "Hyperfine — command benchmarking tool for performance testing",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "hyperfine"
    }
  ],
  "install_guidance": {
    "plugin": "hyperfine",
    "binary": "hyperfine",
    "check": "which hyperfine",
    "install_steps": [
      "cargo install hyperfine",
      "Verify: hyperfine --version",
      "supercli plugins install ./plugins/hyperfine --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hyperfine",
      "resource": "self",
      "action": "version",
      "description": "Version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hyperfine",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hyperfine"
      },
      "args": []
    }
  ]
}
