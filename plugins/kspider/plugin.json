{
  "name": "kspider",
  "version": "0.1.0",
  "description": "Kspider \u662f\u4e00\u4e2a\u722c\u866b\u5e73\u53f0\uff0c\u4ee5\u56fe\u5f62\u5316\u65b9\u5f0f\u5b9a\u4e49\u722c\u866b\u6d41\u7a0b\uff0c\u65e0\u9700\u4ee3\u7801\u5373\u53ef\u5b9e\u73b0\u4e00\u4e2a\u722c\u866b\u6d41\u7a0b\uff0cKspider\u4e0d\u4ec5\u9650\u722c\u866b\uff0c\u4e5f\u53ef\u7528\u4e8eWEB\u81ea\u52a8\u5316\u6d4b\u8bd5\uff0c\u66f4\u591a\u529f\u80fd\u7b49\u4f60\u63a2\u7d22\u3002",
  "source": "https://github.com/kspider/kspider",
  "checks": [
    {
      "type": "binary",
      "name": "kspider"
    }
  ],
  "install_guidance": {
    "plugin": "kspider",
    "binary": "kspider",
    "check": "which kspider",
    "install_steps": [
      "pip install kspider",
      "Verify: kspider --version",
      "supercli plugins install ./plugins/kspider --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kspider",
      "resource": "self",
      "action": "version",
      "description": "Print kspider version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kspider",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kspider: pip install kspider"
      },
      "args": []
    },
    {
      "namespace": "kspider",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kspider CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kspider",
        "passthrough": true,
        "missingDependencyHelp": "Install kspider: pip install kspider"
      },
      "args": []
    }
  ]
}