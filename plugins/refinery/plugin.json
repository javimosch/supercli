{
  "name": "refinery",
  "version": "0.1.0",
  "description": "Powerful SQL migration toolkit for Rust with multiple backends",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "refinery" }],
  "install_guidance": {
    "plugin": "refinery",
    "binary": "refinery",
    "check": "which refinery",
    "install_steps": ["cargo install refinery_cli", "Verify: refinery --version", "supercli plugins install ./plugins/refinery --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "refinery",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to refinery CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "refinery",
      "passthrough": true,
      "missingDependencyHelp": "Install refinery: cargo install refinery_cli"
    },
    "args": []
  }]
}
