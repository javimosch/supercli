{
  "name": "Mooncake",
  "version": "0.1.0",
  "description": "Mooncake is the serving platform for Kimi, a leading LLM service provided by Moonshot AI.",
  "source": "https://github.com/Mooncake/Mooncake",
  "checks": [
    {
      "type": "binary",
      "name": "mooncake"
    }
  ],
  "install_guidance": {
    "plugin": "Mooncake",
    "binary": "mooncake",
    "check": "which mooncake",
    "install_steps": [
      "pip install mooncake",
      "Verify: mooncake --version",
      "supercli plugins install ./plugins/Mooncake --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Mooncake",
      "resource": "self",
      "action": "version",
      "description": "Print Mooncake version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mooncake",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Mooncake: pip install mooncake"
      },
      "args": []
    },
    {
      "namespace": "Mooncake",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mooncake CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mooncake",
        "passthrough": true,
        "missingDependencyHelp": "Install Mooncake: pip install mooncake"
      },
      "args": []
    }
  ]
}