{
  "name": "image-automation",
  "version": "0.1.0",
  "description": "Automated container image updates in Git",
  "source": "https://github.com/fluxcd/image-automation-controller",
  "checks": [{ "type": "binary", "name": "image-automation-controller" }],
  "install_guidance": {
    "plugin": "image-automation",
    "binary": "image-automation-controller",
    "check": "which image-automation-controller",
    "install_steps": ["brew install image-automation", "Verify: image-automation-controller --version", "supercli plugins install ./plugins/image-automation --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "image-automation",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to image-automation-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "image-automation-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install image-automation: brew install image-automation"
    },
    "args": []
  }]
}
