{
  "name": "stew",
  "version": "0.1.0",
  "description": "An independent package manager for compiled binaries.",
  "source": "https://github.com/marwanhawari/stew",
  "checks": [
    {
      "type": "binary",
      "name": "stew"
    }
  ],
  "install_guidance": {
    "plugin": "stew",
    "binary": "stew",
    "check": "which stew",
    "install_steps": [
      "See https://github.com/marwanhawari/stew",
      "Verify: stew --version",
      "supercli plugins install ./plugins/stew --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "stew",
      "resource": "self",
      "action": "version",
      "description": "Print stew version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stew",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install stew: See https://github.com/marwanhawari/stew"
      },
      "args": []
    },
    {
      "namespace": "stew",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stew CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stew",
        "passthrough": true,
        "missingDependencyHelp": "Install stew"
      },
      "args": []
    }
  ]
}