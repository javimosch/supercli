{
  "name": "Runarr",
  "version": "0.1.0",
  "description": "Organize CBZ/CBR comics and fetch metadata",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "Runarr" }],
  "install_guidance": {
    "plugin": "Runarr",
    "binary": "Runarr",
    "check": "which Runarr",
    "install_steps": ["pip install runarr", "Verify: Runarr --version", "supercli plugins install ./plugins/Runarr --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "Runarr",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to Runarr CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "Runarr",
      "passthrough": true,
      "missingDependencyHelp": "Install Runarr: pip install runarr"
    },
    "args": []
  }]
}
