{
  "name": "optimizt",
  "version": "0.1.0",
  "description": "Helps prepare images for the web",
  "source": "https://github.com/343dev/optimizt",
  "checks": [
    {
      "type": "binary",
      "name": "optimizt"
    }
  ],
  "install_guidance": {
    "plugin": "optimizt",
    "binary": "optimizt",
    "check": "which optimizt",
    "install_steps": [
      "See https://github.com/343dev/optimizt",
      "Verify: optimizt --version",
      "supercli plugins install ./plugins/optimizt --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "optimizt",
      "resource": "self",
      "action": "version",
      "description": "Print optimizt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "optimizt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install optimizt: See https://github.com/343dev/optimizt"
      },
      "args": []
    },
    {
      "namespace": "optimizt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to optimizt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "optimizt",
        "passthrough": true,
        "missingDependencyHelp": "Install optimizt"
      },
      "args": []
    }
  ]
}