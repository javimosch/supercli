{
  "name": "mack",
  "version": "0.1.0",
  "description": "CLI tool for cleaning macOS system caches",
  "source": "https://github.com/Tatsh/mack",
  "checks": [{ "type": "binary", "name": "mack" }],
  "install_guidance": {
    "plugin": "mack",
    "binary": "mack",
    "check": "which mack",
    "install_steps": ["gem install mack", "Verify: mack --version", "supercli plugins install ./plugins/mack --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mack",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mack CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mack",
      "passthrough": true,
      "missingDependencyHelp": "Install mack: gem install mack", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
