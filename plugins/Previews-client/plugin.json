{
  "name": "Previews-client",
  "version": "0.1.0",
  "description": "Previews (For TTV) - Live previews when hovering over streams on twitch | A bunch of quality of life improvement features to twitch.",
  "source": "https://github.com/Previews-client/Previews-client",
  "checks": [
    {
      "type": "binary",
      "name": "Previews-client"
    }
  ],
  "install_guidance": {
    "plugin": "Previews-client",
    "binary": "Previews-client",
    "check": "which Previews-client",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: Previews-client --version",
      "supercli plugins install ./plugins/Previews-client --on-conflict replace --json"
    ],
    "note": "CSS language CLI tool"
  },
  "commands": [
    {
      "namespace": "Previews-client",
      "resource": "self",
      "action": "version",
      "description": "Print Previews-client version",
      "adapter": "process",
      "adapterConfig": {
        "command": "Previews-client",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Previews-client from project repository"
      },
      "args": []
    },
    {
      "namespace": "Previews-client",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to Previews-client CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "Previews-client",
        "passthrough": true,
        "missingDependencyHelp": "Install Previews-client from project repository"
      },
      "args": []
    }
  ]
}