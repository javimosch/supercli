{
  "name": "f3",
  "version": "1.0.0",
  "description": "f3 \u2014 Flash tester",
  "source": "github.com/AltraMayor/f3",
  "checks": [
    {
      "type": "binary",
      "name": "f3"
    }
  ],
  "install_guidance": {
    "plugin": "f3",
    "binary": "f3",
    "check": "which f3",
    "install_steps": [
      "# Install f3",
      "# See github.com/AltraMayor/f3",
      "# apt: sudo apt-get install f3",
      "# brew: brew install f3",
      "# cargo: cargo install f3",
      "# npm: npm install -g f3",
      "# pip: pip install f3"
    ]
  },
  "commands": [
    {
      "namespace": "f3",
      "resource": "f3",
      "action": "run",
      "description": "Run f3",
      "adapter": "process",
      "adapterConfig": {
        "command": "f3",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install f3 from github.com/AltraMayor/f3"
      },
      "args": []
    }
  ]
}