{
  "name": "ntfy",
  "version": "1.0.0",
  "description": "ntfy \u2014 Push notifications CLI",
  "source": "ntfy.sh",
  "checks": [
    {
      "type": "binary",
      "name": "ntfy"
    }
  ],
  "install_guidance": {
    "plugin": "ntfy",
    "binary": "ntfy",
    "check": "which ntfy",
    "install_steps": [
      "# Install ntfy:",
      "# apt: sudo apt-get install ntfy",
      "# brew: brew install ntfy",
      "# cargo: cargo install ntfy",
      "# npm: npm install -g ntfy",
      "# pip: pip install ntfy",
      "# or download from ntfy.sh"
    ]
  },
  "commands": [
    {
      "namespace": "ntfy",
      "resource": "ntfy",
      "action": "run",
      "description": "Run ntfy",
      "adapter": "process",
      "adapterConfig": {
        "command": "ntfy",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ntfy from ntfy.sh"
      },
      "args": []
    }
  ]
}