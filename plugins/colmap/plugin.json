{
  "name": "colmap",
  "version": "0.1.0",
  "description": "Structure-from-Motion and Multi-View Stereo",
  "checks": [
    {
      "type": "binary",
      "name": "colmap"
    }
  ],
  "install_guidance": {
    "plugin": "colmap",
    "binary": "colmap",
    "check": "which colmap",
    "install_steps": [
      "brew install colmap",
      "Verify: colmap --version",
      "supercli plugins install ./plugins/colmap --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "colmap",
      "resource": "self",
      "action": "version",
      "description": "Print colmap version",
      "adapter": "process",
      "adapterConfig": {
        "command": "colmap",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install colmap: brew install colmap"
      },
      "args": []
    },
    {
      "namespace": "colmap",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to colmap CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "colmap",
        "passthrough": true,
        "missingDependencyHelp": "Install colmap"
      },
      "args": []
    }
  ]
}