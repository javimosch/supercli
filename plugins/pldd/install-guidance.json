{
  "plugin": "pldd",
  "binary": "pldd",
  "check": "which pldd",
  "install_steps": [
    "# Install pldd",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pldd-linux-amd64 -o /usr/local/bin/pldd",
    "chmod +x /usr/local/bin/pldd",
    "# Or via package manager, see /usr/bin/pldd"
  ]
}