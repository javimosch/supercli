{
  "name": "pldd",
  "version": "1.0.0",
  "description": "pldd \u2014 pldd \u2014 CLI utility",
  "source": "/usr/bin/pldd",
  "checks": [
    {
      "type": "binary",
      "name": "pldd"
    }
  ],
  "install_guidance": {
    "plugin": "pldd",
    "binary": "pldd",
    "check": "which pldd",
    "install_steps": [
      "# Install pldd:",
      "# apt: sudo apt-get install pldd",
      "# brew: brew install pldd",
      "# cargo: cargo install pldd",
      "# npm: npm install -g pldd",
      "# pip: pip install pldd",
      "# or download from /usr/bin/pldd"
    ]
  },
  "commands": [
    {
      "namespace": "pldd",
      "resource": "pldd",
      "action": "run",
      "description": "Run pldd",
      "adapter": "process",
      "adapterConfig": {
        "command": "pldd",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install pldd from /usr/bin/pldd"
      },
      "args": []
    }
  ]
}