{
  "plugin": "podchecker",
  "binary": "podchecker",
  "check": "which podchecker",
  "install_steps": [
    "# Install podchecker",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/podchecker-linux-amd64 -o /usr/local/bin/podchecker",
    "chmod +x /usr/local/bin/podchecker",
    "# Or via package manager, see /usr/bin/podchecker"
  ]
}