{
  "name": "podchecker",
  "version": "1.0.0",
  "description": "podchecker \u2014 podchecker \u2014 CLI utility",
  "source": "/usr/bin/podchecker",
  "checks": [
    {
      "type": "binary",
      "name": "podchecker"
    }
  ],
  "install_guidance": {
    "plugin": "podchecker",
    "binary": "podchecker",
    "check": "which podchecker",
    "install_steps": [
      "# Install podchecker:",
      "# apt: sudo apt-get install podchecker",
      "# brew: brew install podchecker",
      "# cargo: cargo install podchecker",
      "# npm: npm install -g podchecker",
      "# pip: pip install podchecker",
      "# or download from /usr/bin/podchecker"
    ]
  },
  "commands": [
    {
      "namespace": "podchecker",
      "resource": "podchecker",
      "action": "run",
      "description": "Run podchecker",
      "adapter": "process",
      "adapterConfig": {
        "command": "podchecker",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install podchecker from /usr/bin/podchecker"
      },
      "args": []
    }
  ]
}