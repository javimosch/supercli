{
  "name": "AxManager",
  "version": "0.1.0",
  "description": "AxManager is an Android application designed to provide deeper control over apps and the system.",
  "source": "https://github.com/AxManager/AxManager",
  "checks": [
    {
      "type": "binary",
      "name": "axmanager"
    }
  ],
  "install_guidance": {
    "plugin": "AxManager",
    "binary": "axmanager",
    "check": "which axmanager",
    "install_steps": [
      "pip install axmanager",
      "Verify: axmanager --version",
      "supercli plugins install ./plugins/AxManager --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "AxManager",
      "resource": "self",
      "action": "version",
      "description": "Print AxManager version",
      "adapter": "process",
      "adapterConfig": {
        "command": "axmanager",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install AxManager: pip install axmanager"
      },
      "args": []
    },
    {
      "namespace": "AxManager",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to axmanager CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "axmanager",
        "passthrough": true,
        "missingDependencyHelp": "Install AxManager: pip install axmanager"
      },
      "args": []
    }
  ]
}