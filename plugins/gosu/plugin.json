{
  "name": "gosu",
  "version": "1.0.0",
  "description": "gosu \u2014 sudo alternative",
  "source": "github.com/tianon/gosu",
  "checks": [
    {
      "type": "binary",
      "name": "gosu"
    }
  ],
  "install_guidance": {
    "plugin": "gosu",
    "binary": "gosu",
    "check": "which gosu",
    "install_steps": [
      "# Install gosu",
      "# See github.com/tianon/gosu",
      "# apt: sudo apt-get install gosu",
      "# brew: brew install gosu",
      "# cargo: cargo install gosu",
      "# npm: npm install -g gosu",
      "# pip: pip install gosu"
    ]
  },
  "commands": [
    {
      "namespace": "gosu",
      "resource": "gosu",
      "action": "run",
      "description": "Run gosu",
      "adapter": "process",
      "adapterConfig": {
        "command": "gosu",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gosu from github.com/tianon/gosu"
      },
      "args": []
    }
  ]
}