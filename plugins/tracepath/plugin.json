{
  "name": "tracepath",
  "version": "1.0.0",
  "description": "tracepath \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=tracepath+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "tracepath"
    }
  ],
  "install_guidance": {
    "plugin": "tracepath",
    "binary": "tracepath",
    "check": "which tracepath",
    "install_steps": [
      "Install tracepath via package manager: apt install tracepath or brew install tracepath"
    ]
  },
  "commands": [
    {
      "namespace": "tracepath",
      "resource": "run",
      "action": "exec",
      "description": "tracepath \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "tracepath",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tracepath via your package manager"
      },
      "args": []
    }
  ]
}