{
  "name": "MoneyPrinterV2",
  "version": "0.1.0",
  "description": "Automate the process of making money online.",
  "source": "https://github.com/MoneyPrinterV2/MoneyPrinterV2",
  "checks": [
    {
      "type": "binary",
      "name": "moneyprinterv2"
    }
  ],
  "install_guidance": {
    "plugin": "MoneyPrinterV2",
    "binary": "moneyprinterv2",
    "check": "which moneyprinterv2",
    "install_steps": [
      "pip install moneyprinterv2",
      "Verify: moneyprinterv2 --version",
      "supercli plugins install ./plugins/MoneyPrinterV2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "MoneyPrinterV2",
      "resource": "self",
      "action": "version",
      "description": "Print MoneyPrinterV2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "moneyprinterv2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install MoneyPrinterV2: pip install moneyprinterv2"
      },
      "args": []
    },
    {
      "namespace": "MoneyPrinterV2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to moneyprinterv2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "moneyprinterv2",
        "passthrough": true,
        "missingDependencyHelp": "Install MoneyPrinterV2: pip install moneyprinterv2"
      },
      "args": []
    }
  ]
}