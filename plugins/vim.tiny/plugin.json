{
  "name": "vim.tiny",
  "version": "0.1.0",
  "description": "CLI tool: vim.tiny",
  "source": "https://manpages.debian.org/vim.tiny",
  "checks": [
    {
      "type": "binary",
      "name": "vim.tiny"
    }
  ],
  "install_guidance": {
    "plugin": "vim.tiny",
    "binary": "vim.tiny",
    "check": "which vim.tiny",
    "install_steps": [
      "apt-get install vim.tiny 2>/dev/null || which vim.tiny",
      "Verify: vim.tiny --version",
      "supercli plugins install ./plugins/vim.tiny --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "vim.tiny",
      "resource": "self",
      "action": "version",
      "description": "Print vim.tiny version",
      "adapter": "process",
      "adapterConfig": {
        "command": "vim.tiny",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install vim.tiny: apt-get install vim.tiny 2>/dev/null || which vim.tiny"
      },
      "args": []
    },
    {
      "namespace": "vim.tiny",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to vim.tiny CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "vim.tiny",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install vim.tiny: apt-get install vim.tiny 2>/dev/null || which vim.tiny"
      },
      "args": []
    }
  ]
}