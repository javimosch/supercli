{
  "name": "claude-plugins-official",
  "version": "0.1.0",
  "description": "Official, Anthropic-managed directory of high quality Claude Code Plugins.",
  "source": "https://github.com/claude-plugins-official/claude-plugins-official",
  "checks": [
    {
      "type": "binary",
      "name": "claude-plugins-official"
    }
  ],
  "install_guidance": {
    "plugin": "claude-plugins-official",
    "binary": "claude-plugins-official",
    "check": "which claude-plugins-official",
    "install_steps": [
      "pip install claude-plugins-official",
      "Verify: claude-plugins-official --version",
      "supercli plugins install ./plugins/claude-plugins-official --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "claude-plugins-official",
      "resource": "self",
      "action": "version",
      "description": "Print claude-plugins-official version",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-plugins-official",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install claude-plugins-official: pip install claude-plugins-official"
      },
      "args": []
    },
    {
      "namespace": "claude-plugins-official",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to claude-plugins-official CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "claude-plugins-official",
        "passthrough": true,
        "missingDependencyHelp": "Install claude-plugins-official: pip install claude-plugins-official"
      },
      "args": []
    }
  ]
}