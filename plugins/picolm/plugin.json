{
  "name": "picolm",
  "version": "0.1.0",
  "description": "Run a 1-billion parameter LLM on a $10 board with 256MB RAM",
  "source": "https://github.com/picolm/picolm",
  "checks": [
    {
      "type": "binary",
      "name": "picolm"
    }
  ],
  "install_guidance": {
    "plugin": "picolm",
    "binary": "picolm",
    "check": "which picolm",
    "install_steps": [
      "pip install picolm",
      "Verify: picolm --version",
      "supercli plugins install ./plugins/picolm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "picolm",
      "resource": "self",
      "action": "version",
      "description": "Print picolm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "picolm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install picolm: pip install picolm"
      },
      "args": []
    },
    {
      "namespace": "picolm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to picolm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "picolm",
        "passthrough": true,
        "missingDependencyHelp": "Install picolm: pip install picolm"
      },
      "args": []
    }
  ]
}