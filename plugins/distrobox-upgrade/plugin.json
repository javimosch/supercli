{
  "name": "distrobox-upgrade",
  "version": "0.1.0",
  "description": "CLI tool: distrobox-upgrade",
  "source": "https://packages.debian.org/distrobox-upgrade",
  "checks": [{ "type": "binary", "name": "distrobox-upgrade" }],
  "install_guidance": {
    "plugin": "distrobox-upgrade", "binary": "distrobox-upgrade", "check": "which distrobox-upgrade",
    "install_steps": ["apt-get install distrobox-upgrade 2>/dev/null || which distrobox-upgrade", "Verify: distrobox-upgrade --version", "supercli plugins install ./plugins/distrobox-upgrade --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "distrobox-upgrade", "resource": "_", "action": "_",
    "description": "Passthrough to distrobox-upgrade CLI",
    "adapter": "process", "adapterConfig": { "command": "distrobox-upgrade", "passthrough": true, "missingDependencyHelp": "Install distrobox-upgrade: apt-get install distrobox-upgrade" }, "args": []
  }]
}
