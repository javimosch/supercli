{
  "name": "data-warehouse-learning",
  "version": "0.1.0",
  "description": "\u30102026\u6700\u65b0\u7248\u3011 \u5927\u6570\u636e \u6570\u636e\u5206\u6790 \u7535\u5546\u7cfb\u7edf \u5b9e\u65f6\u6570\u4ed3 \u79bb\u7ebf\u6570\u4ed3 \u6570\u636e\u6e56 \u5efa\u8bbe\u65b9\u6848\u53ca\u5b9e\u6218\u4ee3\u7801\uff0c\u6d89\u53ca\u7ec4\u4ef6 #flink #paimon #doris #seatunnel #dolphinschedu",
  "source": "https://github.com/data-warehouse-learning/data-warehouse-learning",
  "checks": [
    {
      "type": "binary",
      "name": "data-warehouse-learning"
    }
  ],
  "install_guidance": {
    "plugin": "data-warehouse-learning",
    "binary": "data-warehouse-learning",
    "check": "which data-warehouse-learning",
    "install_steps": [
      "pip install data-warehouse-learning",
      "Verify: data-warehouse-learning --version",
      "supercli plugins install ./plugins/data-warehouse-learning --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "data-warehouse-learning",
      "resource": "self",
      "action": "version",
      "description": "Print data-warehouse-learning version",
      "adapter": "process",
      "adapterConfig": {
        "command": "data-warehouse-learning",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install data-warehouse-learning: pip install data-warehouse-learning"
      },
      "args": []
    },
    {
      "namespace": "data-warehouse-learning",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to data-warehouse-learning CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "data-warehouse-learning",
        "passthrough": true,
        "missingDependencyHelp": "Install data-warehouse-learning: pip install data-warehouse-learning"
      },
      "args": []
    }
  ]
}