{
  "name": "loft-cli",
  "version": "0.1.0",
  "description": "Platform for Kubernetes multi-tenancy and self-service",
  "source": "https://github.com/loft-sh/loft",
  "checks": [{ "type": "binary", "name": "loft" }],
  "install_guidance": {
    "plugin": "loft-cli",
    "binary": "loft",
    "check": "which loft",
    "install_steps": ["brew install loft", "Verify: loft --version", "supercli plugins install ./plugins/loft-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "loft-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to loft CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "loft",
      "passthrough": true,
      "missingDependencyHelp": "Install loft-cli: brew install loft"
    },
    "args": []
  }]
}
