{
  "name": "gh-scout",
  "version": "0.1.0",
  "description": "Intelligent GitHub code search CLI extension",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "gh-scout" }],
  "install_guidance": {
    "plugin": "gh-scout",
    "binary": "gh-scout",
    "check": "which gh-scout",
    "install_steps": ["gh extension install gh-scout", "Verify: gh-scout --version", "supercli plugins install ./plugins/gh-scout --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gh-scout",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gh-scout CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gh-scout",
      "passthrough": true,
      "missingDependencyHelp": "Install gh-scout: gh extension install gh-scout"
    },
    "args": []
  }]
}
