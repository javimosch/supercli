{
  "name": "cli-emoji",
  "version": "0.1.0",
  "description": "Display large-format emojis directly in the terminal",
  "source": "https://github.com/IonicaBizau/cli-emoji",
  "checks": [{ "type": "binary", "name": "cli-emoji" }],
  "install_guidance": {
    "plugin": "cli-emoji",
    "binary": "cli-emoji",
    "check": "which cli-emoji",
    "install_steps": ["npm install -g cli-emoji", "Verify: cli-emoji --version", "supercli plugins install ./plugins/cli-emoji --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cli-emoji",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cli-emoji CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cli-emoji",
      "passthrough": true,
      "missingDependencyHelp": "Install cli-emoji: npm install -g cli-emoji", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
