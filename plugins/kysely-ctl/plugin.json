{
  "name": "kysely-ctl",
  "version": "0.1.0",
  "description": "Kysely CLI",
  "source": "https://github.com/kysely-org/kysely-ctl",
  "checks": [
    {
      "type": "binary",
      "name": "kysely"
    }
  ],
  "install_guidance": {
    "plugin": "kysely-ctl",
    "binary": "kysely",
    "check": "which kysely-ctl",
    "install_steps": [
      "npm install -g kysely-ctl",
      "Verify: kysely --version",
      "supercli plugins install ./plugins/kysely-ctl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kysely-ctl",
      "resource": "self",
      "action": "version",
      "description": "Print kysely-ctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kysely",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kysely-ctl: npm install -g kysely-ctl"
      },
      "args": []
    },
    {
      "namespace": "kysely-ctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kysely-ctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kysely",
        "passthrough": true,
        "missingDependencyHelp": "Install kysely-ctl"
      },
      "args": []
    }
  ]
}
