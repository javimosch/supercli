{
  "plugin": "termscp",
  "binary": "termscp",
  "check": "which termscp",
  "install_steps": [
    "cargo install termscp",
    "Or: brew install veeso/tap/termscp",
    "Or download from https://github.com/veeso/termscp/releases",
    "Verify: termscp --version",
    "supercli plugins install ./plugins/termscp --on-conflict replace --json"
  ],
  "note": "Available via Cargo and Homebrew. Source: https://github.com/veeso/termscp (2.9k+ stars). Written in Rust."
}
