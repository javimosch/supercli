{
  "name": "haml",
  "version": "0.1.0",
  "description": "HTML abstraction markup language compiler",
  "source": "https://github.com/haml/haml",
  "checks": [
    {
      "type": "binary",
      "name": "haml"
    }
  ],
  "install_guidance": {
    "plugin": "haml",
    "binary": "haml",
    "check": "which haml",
    "install_steps": [
      "gem install haml",
      "Verify: haml --version",
      "supercli plugins install ./plugins/haml --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "haml",
      "resource": "self",
      "action": "version",
      "description": "Print haml version",
      "adapter": "process",
      "adapterConfig": {
        "command": "haml",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install haml: gem install haml"
      },
      "args": []
    },
    {
      "namespace": "haml",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to haml CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "haml",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install haml: gem install haml"
      },
      "args": []
    }
  ]
}
