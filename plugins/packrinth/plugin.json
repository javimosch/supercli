{
  "name": "packrinth",
  "version": "0.1.0",
  "description": "Create and manage Minecraft modpacks using Modrinth",
  "source": "https://crates.io/crates/packrinth",
  "checks": [{ "type": "binary", "name": "packrinth" }],
  "install_guidance": {
    "plugin": "packrinth",
    "binary": "packrinth",
    "check": "which packrinth",
    "install_steps": ["cargo install packrinth", "Verify: packrinth --version", "supercli plugins install ./plugins/packrinth --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "packrinth",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to packrinth CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "packrinth",
      "passthrough": true,
      "missingDependencyHelp": "Install packrinth: cargo install packrinth", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
