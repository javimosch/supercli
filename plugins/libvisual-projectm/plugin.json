{
  "name": "libvisual-projectm",
  "version": "0.1.0",
  "description": "Visualization plug-in for projectM support from Libvisual",
  "source": "https://github.com/projectM-visualizer/frontend-libvisual-plug-in",
  "checks": [
    {
      "type": "binary",
      "name": "libvisual-projectm"
    }
  ],
  "install_guidance": {
    "plugin": "libvisual-projectm",
    "binary": "libvisual-projectm",
    "check": "which libvisual-projectm",
    "install_steps": [
      "brew install libvisual-projectm",
      "Verify: libvisual-projectm --version",
      "supercli plugins install ./plugins/libvisual-projectm --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libvisual-projectm",
      "resource": "self",
      "action": "version",
      "description": "Print libvisual-projectm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libvisual-projectm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libvisual-projectm: brew install libvisual-projectm"
      },
      "args": []
    },
    {
      "namespace": "libvisual-projectm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libvisual-projectm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libvisual-projectm",
        "passthrough": true,
        "missingDependencyHelp": "Install libvisual-projectm"
      },
      "args": []
    }
  ]
}