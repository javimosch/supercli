{
  "name": "cz-conventional-gitmoji",
  "version": "0.1.0",
  "description": "Commitizen adapter for conventional gitmoji",
  "source": "https://github.com/econchick/cz-conventional-gitmoji",
  "checks": [{ "type": "binary", "name": "cz-conventional-gitmoji" }],
  "install_guidance": {
    "plugin": "cz-conventional-gitmoji",
    "binary": "cz-conventional-gitmoji",
    "check": "which cz-conventional-gitmoji",
    "install_steps": ["pip install cz-conventional-gitmoji", "Verify: cz-conventional-gitmoji --version", "supercli plugins install ./plugins/cz-conventional-gitmoji --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cz-conventional-gitmoji",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to cz-conventional-gitmoji CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "cz-conventional-gitmoji",
      "passthrough": true,
      "missingDependencyHelp": "Install cz-conventional-gitmoji: pip install cz-conventional-gitmoji", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
