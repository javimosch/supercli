{
  "name": "cloud-init",
  "version": "1.0.0",
  "description": "cloud-init \u2014 Cloud instance init",
  "source": "cloud-init.io",
  "checks": [
    {
      "type": "binary",
      "name": "cloud-init"
    }
  ],
  "install_guidance": {
    "plugin": "cloud-init",
    "binary": "cloud-init",
    "check": "which cloud-init",
    "install_steps": [
      "# Install cloud-init",
      "# See cloud-init.io",
      "# apt: sudo apt-get install cloud-init",
      "# brew: brew install cloud-init",
      "# cargo: cargo install cloud-init",
      "# npm: npm install -g cloud-init",
      "# pip: pip install cloud-init"
    ]
  },
  "commands": [
    {
      "namespace": "cloud",
      "resource": "init",
      "action": "run",
      "description": "Run cloud-init",
      "adapter": "process",
      "adapterConfig": {
        "command": "cloud-init",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cloud-init from cloud-init.io"
      },
      "args": []
    }
  ]
}