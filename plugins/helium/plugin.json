{
  "name": "helium",
  "version": "0.1.0",
  "description": "Private, fast, and honest web browser",
  "source": "https://github.com/helium/helium",
  "checks": [
    {
      "type": "binary",
      "name": "helium"
    }
  ],
  "install_guidance": {
    "plugin": "helium",
    "binary": "helium",
    "check": "which helium",
    "install_steps": [
      "pip install helium",
      "Verify: helium --version",
      "supercli plugins install ./plugins/helium --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "helium",
      "resource": "self",
      "action": "version",
      "description": "Print helium version",
      "adapter": "process",
      "adapterConfig": {
        "command": "helium",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install helium: pip install helium"
      },
      "args": []
    },
    {
      "namespace": "helium",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to helium CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "helium",
        "passthrough": true,
        "missingDependencyHelp": "Install helium: pip install helium"
      },
      "args": []
    }
  ]
}