{
  "name": "homeassistant-cli",
  "version": "0.1.0",
  "description": "Command-line utility for Home Assistant",
  "source": "https://github.com/home-assistant-ecosystem/home-assistant-cli",
  "checks": [
    {
      "type": "binary",
      "name": "homeassistant-cli"
    }
  ],
  "install_guidance": {
    "plugin": "homeassistant-cli",
    "binary": "homeassistant-cli",
    "check": "which homeassistant-cli",
    "install_steps": [
      "brew install homeassistant-cli",
      "Verify: homeassistant-cli --version",
      "supercli plugins install ./plugins/homeassistant-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "homeassistant-cli",
      "resource": "self",
      "action": "version",
      "description": "Print homeassistant-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "homeassistant-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install homeassistant-cli: brew install homeassistant-cli"
      },
      "args": []
    },
    {
      "namespace": "homeassistant-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to homeassistant-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "homeassistant-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install homeassistant-cli"
      },
      "args": []
    }
  ]
}