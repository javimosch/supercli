{
  "name": "tsdown",
  "version": "0.1.0",
  "description": "Fast TypeScript-to-JavaScript downlevel compiler",
  "source": "https://github.com/tsdown/tsdown",
  "checks": [{ "type": "binary", "name": "tsdown" }],
  "install_guidance": {
    "plugin": "tsdown",
    "binary": "tsdown",
    "check": "which tsdown",
    "install_steps": ["npm install -g tsdown", "Verify: tsdown --version", "supercli plugins install ./plugins/tsdown --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tsdown",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tsdown CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tsdown",
      "passthrough": true,
      "missingDependencyHelp": "Install tsdown: npm install -g tsdown", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
