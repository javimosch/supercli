{
  "plugin": "update-shells",
  "binary": "update-shells",
  "check": "which update-shells",
  "install_steps": [
    "apt-get install update-shells 2>/dev/null || which update-shells",
    "Verify: update-shells --version",
    "supercli plugins install ./plugins/update-shells --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}