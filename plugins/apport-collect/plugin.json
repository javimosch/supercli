{
  "name": "apport-collect",
  "version": "0.1.0",
  "description": "CLI tool: apport-collect",
  "source": "https://packages.debian.org/apport-collect",
  "checks": [{ "type": "binary", "name": "apport-collect" }],
  "install_guidance": {
    "plugin": "apport-collect", "binary": "apport-collect", "check": "which apport-collect",
    "install_steps": ["apt-get install apport-collect 2>/dev/null || which apport-collect", "Verify: apport-collect --version", "supercli plugins install ./plugins/apport-collect --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "apport-collect", "resource": "_", "action": "_",
    "description": "Passthrough to apport-collect CLI",
    "adapter": "process", "adapterConfig": { "command": "apport-collect", "passthrough": true, "missingDependencyHelp": "Install apport-collect: apt-get install apport-collect" }, "args": []
  }]
}
