{
  "name": "delaunay",
  "version": "0.1.0",
  "description": "delaunay — utility binaries for libgts",
  "source": "http://gts.sourceforge.net/",
  "checks": [{ "type": "binary", "name": "delaunay" }],
  "install_guidance": {
    "plugin": "delaunay", "binary": "delaunay", "check": "which delaunay",
    "install_steps": ["apt-get install libgts-bin 2>/dev/null || which delaunay", "Verify: delaunay --version", "supercli plugins install ./plugins/delaunay --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "delaunay", "resource": "_", "action": "_",
    "description": "Passthrough to delaunay CLI",
    "adapter": "process", "adapterConfig": { "command": "delaunay", "passthrough": true, "missingDependencyHelp": "Install delaunay: apt-get install libgts-bin" }, "args": []
  }]
}
