{
  "name": "CodexBar",
  "version": "0.1.0",
  "description": "Show usage stats for OpenAI Codex and Claude Code, without having to login.",
  "source": "https://github.com/CodexBar/CodexBar",
  "checks": [
    {
      "type": "binary",
      "name": "codexbar"
    }
  ],
  "install_guidance": {
    "plugin": "CodexBar",
    "binary": "codexbar",
    "check": "which codexbar",
    "install_steps": [
      "pip install codexbar",
      "Verify: codexbar --version",
      "supercli plugins install ./plugins/CodexBar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "CodexBar",
      "resource": "self",
      "action": "version",
      "description": "Print CodexBar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "codexbar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install CodexBar: pip install codexbar"
      },
      "args": []
    },
    {
      "namespace": "CodexBar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to codexbar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "codexbar",
        "passthrough": true,
        "missingDependencyHelp": "Install CodexBar: pip install codexbar"
      },
      "args": []
    }
  ]
}