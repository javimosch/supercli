{
  "name": "firework-rs",
  "version": "0.1.0",
  "description": "ASCII art firework simulator in Rust",
  "source": "https://github.com/nicholasgasior/firework-rs",
  "checks": [{"type": "binary", "name": "firework"}],
  "install_guidance": {
    "plugin": "firework-rs",
    "binary": "firework",
    "check": "which firework",
    "install_steps": [
      "cargo install firework-rs",
      "Verify: firework --version",
      "supercli plugins install ./firework-rs --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "firework-rs",
      "resource": "self",
      "action": "version",
      "description": "Print firework-rs version",
      "adapter": "process",
      "adapterConfig": {"command": "firework", "baseArgs": ["--version"], "missingDependencyHelp": "Install firework-rs: cargo install firework-rs"},
      "args": []
    },
    {
      "namespace": "firework-rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to firework-rs CLI",
      "adapter": "process",
      "adapterConfig": {"command": "firework", "passthrough": true, "missingDependencyHelp": "Install firework-rs: cargo install firework-rs"},
      "args": []
    }
  ]
}
