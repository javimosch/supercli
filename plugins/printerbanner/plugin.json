{
  "name": "printerbanner",
  "version": "0.1.0",
  "description": "CLI tool: printerbanner",
  "source": "https://manpages.debian.org/printerbanner",
  "checks": [
    {
      "type": "binary",
      "name": "printerbanner"
    }
  ],
  "install_guidance": {
    "plugin": "printerbanner",
    "binary": "printerbanner",
    "check": "which printerbanner",
    "install_steps": [
      "apt-get install printerbanner 2>/dev/null || which printerbanner",
      "Verify: printerbanner --version",
      "supercli plugins install ./plugins/printerbanner --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "printerbanner",
      "resource": "self",
      "action": "version",
      "description": "Print printerbanner version",
      "adapter": "process",
      "adapterConfig": {
        "command": "printerbanner",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install printerbanner: apt-get install printerbanner 2>/dev/null || which printerbanner"
      },
      "args": []
    },
    {
      "namespace": "printerbanner",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to printerbanner CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "printerbanner",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install printerbanner: apt-get install printerbanner 2>/dev/null || which printerbanner"
      },
      "args": []
    }
  ]
}