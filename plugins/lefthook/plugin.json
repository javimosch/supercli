{
  "name": "lefthook",
  "version": "0.1.0",
  "description": "Fast and powerful Git hooks manager for any project",
  "source": "https://github.com/evilmartians/lefthook",
  "checks": [{ "type": "binary", "name": "lefthook" }],
  "install_guidance": {
    "plugin": "lefthook",
    "binary": "lefthook",
    "check": "which lefthook",
    "install_steps": ["cargo install lefthook", "Verify: lefthook --version", "supercli plugins install ./plugins/lefthook --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lefthook",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to lefthook CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "lefthook",
      "passthrough": true,
      "missingDependencyHelp": "Install lefthook: cargo install lefthook"
    },
    "args": []
  }]
}
