{
  "name": "100-exercises-to-learn-rust",
  "version": "0.1.0",
  "description": "A self-paced course to learn Rust, one exercise at a time.",
  "source": "https://github.com/100-exercises-to-learn-rust/100-exercises-to-learn-rust",
  "checks": [
    {
      "type": "binary",
      "name": "100-exercises-to-learn-rust"
    }
  ],
  "install_guidance": {
    "plugin": "100-exercises-to-learn-rust",
    "binary": "100-exercises-to-learn-rust",
    "check": "which 100-exercises-to-learn-rust",
    "install_steps": [
      "pip install 100-exercises-to-learn-rust",
      "Verify: 100-exercises-to-learn-rust --version",
      "supercli plugins install ./plugins/100-exercises-to-learn-rust --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "100-exercises-to-learn-rust",
      "resource": "self",
      "action": "version",
      "description": "Print 100-exercises-to-learn-rust version",
      "adapter": "process",
      "adapterConfig": {
        "command": "100-exercises-to-learn-rust",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install 100-exercises-to-learn-rust: pip install 100-exercises-to-learn-rust"
      },
      "args": []
    },
    {
      "namespace": "100-exercises-to-learn-rust",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to 100-exercises-to-learn-rust CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "100-exercises-to-learn-rust",
        "passthrough": true,
        "missingDependencyHelp": "Install 100-exercises-to-learn-rust: pip install 100-exercises-to-learn-rust"
      },
      "args": []
    }
  ]
}