{
  "name": "goat",
  "version": "0.1.0",
  "description": "General purpose AT Protocol CLI in Go",
  "source": "https://github.com/bluesky-social/goat",
  "checks": [
    {
      "type": "binary",
      "name": "goat"
    }
  ],
  "install_guidance": {
    "plugin": "goat",
    "binary": "goat",
    "check": "which goat",
    "install_steps": [
      "brew install goat",
      "Verify: goat --version",
      "supercli plugins install ./plugins/goat --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "goat",
      "resource": "self",
      "action": "version",
      "description": "Print goat version",
      "adapter": "process",
      "adapterConfig": {
        "command": "goat",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install goat: brew install goat"
      },
      "args": []
    },
    {
      "namespace": "goat",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to goat CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "goat",
        "passthrough": true,
        "missingDependencyHelp": "Install goat"
      },
      "args": []
    }
  ]
}