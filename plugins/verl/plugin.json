{
  "name": "verl",
  "version": "0.1.0",
  "description": "verl/HybridFlow: A Flexible and Efficient RL Post-Training Framework ",
  "source": "https://github.com/verl/verl",
  "checks": [
    {
      "type": "binary",
      "name": "verl"
    }
  ],
  "install_guidance": {
    "plugin": "verl",
    "binary": "verl",
    "check": "which verl",
    "install_steps": [
      "pip install verl",
      "Verify: verl --version",
      "supercli plugins install ./plugins/verl --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "verl",
      "resource": "self",
      "action": "version",
      "description": "Print verl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "verl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install verl: pip install verl"
      },
      "args": []
    },
    {
      "namespace": "verl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to verl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "verl",
        "passthrough": true,
        "missingDependencyHelp": "Install verl: pip install verl"
      },
      "args": []
    }
  ]
}