{
  "name": "xcolor",
  "version": "0.1.0",
  "description": "Lightweight color picker for X11 in Rust",
  "source": "https://github.com/nicholasgasior/xcolor",
  "checks": [{"type": "binary", "name": "xcolor"}],
  "install_guidance": {
    "plugin": "xcolor",
    "binary": "xcolor",
    "check": "which xcolor",
    "install_steps": [
      "cargo install xcolor",
      "Verify: xcolor --version",
      "supercli plugins install ./xcolor --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "xcolor",
      "resource": "self",
      "action": "version",
      "description": "Print xcolor version",
      "adapter": "process",
      "adapterConfig": {"command": "xcolor", "baseArgs": ["--version"], "missingDependencyHelp": "Install xcolor: cargo install xcolor"},
      "args": []
    },
    {
      "namespace": "xcolor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xcolor CLI",
      "adapter": "process",
      "adapterConfig": {"command": "xcolor", "passthrough": true, "missingDependencyHelp": "Install xcolor: cargo install xcolor"},
      "args": []
    }
  ]
}
