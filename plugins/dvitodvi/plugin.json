{
  "name": "dvitodvi",
  "version": "0.1.0",
  "description": "CLI tool: dvitodvi",
  "source": "https://manpages.debian.org/dvitodvi",
  "checks": [
    {
      "type": "binary",
      "name": "dvitodvi"
    }
  ],
  "install_guidance": {
    "plugin": "dvitodvi",
    "binary": "dvitodvi",
    "check": "which dvitodvi",
    "install_steps": [
      "apt-get install dvitodvi 2>/dev/null || which dvitodvi",
      "Verify: dvitodvi --version",
      "supercli plugins install ./plugins/dvitodvi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvitodvi",
      "resource": "self",
      "action": "version",
      "description": "Print dvitodvi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvitodvi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvitodvi: apt-get install dvitodvi 2>/dev/null || which dvitodvi"
      },
      "args": []
    },
    {
      "namespace": "dvitodvi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvitodvi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvitodvi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvitodvi: apt-get install dvitodvi 2>/dev/null || which dvitodvi"
      },
      "args": []
    }
  ]
}