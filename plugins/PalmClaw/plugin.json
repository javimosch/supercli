{
  "name": "PalmClaw",
  "version": "0.1.0",
  "description": "Your private AI assistant on your phone: simple, safe, and ready anytime. \u4f60\u624b\u673a\u91cc\u7684\u79c1\u4eba AI \u52a9\u624b\uff1a\u7b80\u5355\u3001\u5b89\u5168\uff0c\u968f\u65f6\u53ef\u7528\u3002",
  "source": "https://github.com/PalmClaw/PalmClaw",
  "checks": [
    {
      "type": "binary",
      "name": "palmclaw"
    }
  ],
  "install_guidance": {
    "plugin": "PalmClaw",
    "binary": "palmclaw",
    "check": "which palmclaw",
    "install_steps": [
      "pip install palmclaw",
      "Verify: palmclaw --version",
      "supercli plugins install ./plugins/PalmClaw --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PalmClaw",
      "resource": "self",
      "action": "version",
      "description": "Print PalmClaw version",
      "adapter": "process",
      "adapterConfig": {
        "command": "palmclaw",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PalmClaw: pip install palmclaw"
      },
      "args": []
    },
    {
      "namespace": "PalmClaw",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to palmclaw CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "palmclaw",
        "passthrough": true,
        "missingDependencyHelp": "Install PalmClaw: pip install palmclaw"
      },
      "args": []
    }
  ]
}