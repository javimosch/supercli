{
  "name": "mdk",
  "version": "0.1.0",
  "description": "Part of kitty toolset for terminal image previews",
  "source": "https://github.com/kovidgoyal/kitty",
  "checks": [{ "type": "binary", "name": "mdk" }],
  "install_guidance": {
    "plugin": "mdk",
    "binary": "mdk",
    "check": "which mdk",
    "install_steps": ["brew install mdk", "Verify: mdk --version", "supercli plugins install ./plugins/mdk --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mdk",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mdk CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mdk",
      "passthrough": true,
      "missingDependencyHelp": "Install mdk: brew install mdk", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
