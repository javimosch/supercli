{
  "name": "cangw",
  "version": "0.1.0",
  "description": "CLI tool: cangw",
  "source": "https://packages.debian.org/cangw",
  "checks": [{ "type": "binary", "name": "cangw" }],
  "install_guidance": {
    "plugin": "cangw", "binary": "cangw", "check": "which cangw",
    "install_steps": ["apt-get install cangw 2>/dev/null || which cangw", "Verify: cangw --version", "supercli plugins install ./plugins/cangw --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "cangw", "resource": "_", "action": "_",
    "description": "Passthrough to cangw CLI",
    "adapter": "process", "adapterConfig": { "command": "cangw", "passthrough": true, "missingDependencyHelp": "Install cangw: apt-get install cangw" }, "args": []
  }]
}
