{
  "name": "mklicense",
  "version": "0.1.0",
  "description": "Create a custom LICENSE file painlessly with customized info",
  "source": "https://github.com/cezaraugusto/mklicense",
  "checks": [
    {
      "type": "binary",
      "name": "mklicense"
    }
  ],
  "install_guidance": {
    "plugin": "mklicense",
    "binary": "mklicense",
    "check": "which mklicense",
    "install_steps": [
      "npm install -g mklicense",
      "Verify: mklicense --version",
      "supercli plugins install ./plugins/mklicense --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "mklicense",
      "resource": "self",
      "action": "version",
      "description": "Print mklicense version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mklicense",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mklicense: npm install -g mklicense"
      },
      "args": []
    },
    {
      "namespace": "mklicense",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mklicense CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mklicense",
        "passthrough": true,
        "missingDependencyHelp": "Install mklicense"
      },
      "args": []
    }
  ]
}