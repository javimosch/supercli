{
  "name": "gooey",
  "version": "0.1.0",
  "description": "Gooey is a hybrid immediate/retained mode UI framework designed for building fast, GPU-rendered appl",
  "source": "https://github.com/gooey/gooey",
  "checks": [
    {
      "type": "binary",
      "name": "gooey"
    }
  ],
  "install_guidance": {
    "plugin": "gooey",
    "binary": "gooey",
    "check": "which gooey",
    "install_steps": [
      "pip install gooey",
      "Verify: gooey --version",
      "supercli plugins install ./plugins/gooey --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gooey",
      "resource": "self",
      "action": "version",
      "description": "Print gooey version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gooey",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gooey: pip install gooey"
      },
      "args": []
    },
    {
      "namespace": "gooey",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gooey CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gooey",
        "passthrough": true,
        "missingDependencyHelp": "Install gooey: pip install gooey"
      },
      "args": []
    }
  ]
}