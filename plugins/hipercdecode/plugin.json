{
  "name": "hipercdecode",
  "version": "0.1.0",
  "description": "CLI tool: hipercdecode",
  "source": "https://manpages.debian.org/hipercdecode",
  "checks": [
    {
      "type": "binary",
      "name": "hipercdecode"
    }
  ],
  "install_guidance": {
    "plugin": "hipercdecode",
    "binary": "hipercdecode",
    "check": "which hipercdecode",
    "install_steps": [
      "apt-get install hipercdecode 2>/dev/null || which hipercdecode",
      "Verify: hipercdecode --version",
      "supercli plugins install ./plugins/hipercdecode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hipercdecode",
      "resource": "self",
      "action": "version",
      "description": "Print hipercdecode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hipercdecode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hipercdecode: apt-get install hipercdecode 2>/dev/null || which hipercdecode"
      },
      "args": []
    },
    {
      "namespace": "hipercdecode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hipercdecode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hipercdecode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install hipercdecode: apt-get install hipercdecode 2>/dev/null || which hipercdecode"
      },
      "args": []
    }
  ]
}