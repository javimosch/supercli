{
  "name": "react-native-godot",
  "version": "0.1.0",
  "description": "React Native Godot - Embed Godot Engine in React Native apps",
  "source": "https://github.com/react-native-godot/react-native-godot",
  "checks": [
    {
      "type": "binary",
      "name": "react-native-godot"
    }
  ],
  "install_guidance": {
    "plugin": "react-native-godot",
    "binary": "react-native-godot",
    "check": "which react-native-godot",
    "install_steps": [
      "pip install react-native-godot",
      "Verify: react-native-godot --version",
      "supercli plugins install ./plugins/react-native-godot --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "react-native-godot",
      "resource": "self",
      "action": "version",
      "description": "Print react-native-godot version",
      "adapter": "process",
      "adapterConfig": {
        "command": "react-native-godot",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install react-native-godot: pip install react-native-godot"
      },
      "args": []
    },
    {
      "namespace": "react-native-godot",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to react-native-godot CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "react-native-godot",
        "passthrough": true,
        "missingDependencyHelp": "Install react-native-godot: pip install react-native-godot"
      },
      "args": []
    }
  ]
}