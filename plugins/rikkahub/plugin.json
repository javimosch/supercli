{
  "name": "rikkahub",
  "version": "0.1.0",
  "description": "RikkaHub is an Android APP that supports for multiple LLM providers.",
  "source": "https://github.com/rikkahub/rikkahub",
  "checks": [
    {
      "type": "binary",
      "name": "rikkahub"
    }
  ],
  "install_guidance": {
    "plugin": "rikkahub",
    "binary": "rikkahub",
    "check": "which rikkahub",
    "install_steps": [
      "pip install rikkahub",
      "Verify: rikkahub --version",
      "supercli plugins install ./plugins/rikkahub --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rikkahub",
      "resource": "self",
      "action": "version",
      "description": "Print rikkahub version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rikkahub",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rikkahub: pip install rikkahub"
      },
      "args": []
    },
    {
      "namespace": "rikkahub",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rikkahub CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rikkahub",
        "passthrough": true,
        "missingDependencyHelp": "Install rikkahub: pip install rikkahub"
      },
      "args": []
    }
  ]
}