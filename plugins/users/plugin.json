          "--version"
        ],
        "missingDependencyHelp": "Install users: base system"
      },
      "args": []
    },
    {
      "namespace": "users",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to users CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "users",
