{
  "name": "OpenViking",
  "version": "0.1.0",
  "description": "OpenViking is an open-source context database designed specifically for AI Agents(such as openclaw).",
  "source": "https://github.com/OpenViking/OpenViking",
  "checks": [
    {
      "type": "binary",
      "name": "openviking"
    }
  ],
  "install_guidance": {
    "plugin": "OpenViking",
    "binary": "openviking",
    "check": "which openviking",
    "install_steps": [
      "pip install openviking",
      "Verify: openviking --version",
      "supercli plugins install ./plugins/OpenViking --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenViking",
      "resource": "self",
      "action": "version",
      "description": "Print OpenViking version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openviking",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenViking: pip install openviking"
      },
      "args": []
    },
    {
      "namespace": "OpenViking",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openviking CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openviking",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenViking: pip install openviking"
      },
      "args": []
    }
  ]
}