{
  "name": "setkeycodes",
  "version": "0.1.0",
  "description": "CLI tool: setkeycodes",
  "source": "https://manpages.debian.org/setkeycodes",
  "checks": [
    {
      "type": "binary",
      "name": "setkeycodes"
    }
  ],
  "install_guidance": {
    "plugin": "setkeycodes",
    "binary": "setkeycodes",
    "check": "which setkeycodes",
    "install_steps": [
      "apt-get install setkeycodes 2>/dev/null || which setkeycodes",
      "Verify: setkeycodes --version",
      "supercli plugins install ./plugins/setkeycodes --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "setkeycodes",
      "resource": "self",
      "action": "version",
      "description": "Print setkeycodes version",
      "adapter": "process",
      "adapterConfig": {
        "command": "setkeycodes",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install setkeycodes: apt-get install setkeycodes 2>/dev/null || which setkeycodes"
      },
      "args": []
    },
    {
      "namespace": "setkeycodes",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to setkeycodes CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "setkeycodes",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install setkeycodes: apt-get install setkeycodes 2>/dev/null || which setkeycodes"
      },
      "args": []
    }
  ]
}