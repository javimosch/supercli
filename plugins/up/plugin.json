{
  "name": "up",
  "version": "0.1.0",
  "description": "Deploy serverless applications to AWS with minimal configuration",
  "source": "https://github.com/apex/up",
  "checks": [{ "type": "binary", "name": "up" }],
  "install_guidance": {
    "plugin": "up",
    "binary": "up",
    "check": "which up",
    "install_steps": ["curl https://up.apex.sh/install ", "Verify: up --version", "supercli plugins install ./plugins/up --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "up",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to up CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "up",
      "passthrough": true,
      "missingDependencyHelp": "Install up: curl https://up.apex.sh/install "
    },
    "args": []
  }]
}
