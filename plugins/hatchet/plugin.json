{
  "name": "hatchet",
  "version": "0.1.0",
  "description": "\ud83e\ude93 An orchestration engine for background tasks, AI agents, and durable workflows",
  "source": "https://github.com/hatchet/hatchet",
  "checks": [
    {
      "type": "binary",
      "name": "hatchet"
    }
  ],
  "install_guidance": {
    "plugin": "hatchet",
    "binary": "hatchet",
    "check": "which hatchet",
    "install_steps": [
      "pip install hatchet",
      "Verify: hatchet --version",
      "supercli plugins install ./plugins/hatchet --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hatchet",
      "resource": "self",
      "action": "version",
      "description": "Print hatchet version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hatchet",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hatchet: pip install hatchet"
      },
      "args": []
    },
    {
      "namespace": "hatchet",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hatchet CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hatchet",
        "passthrough": true,
        "missingDependencyHelp": "Install hatchet: pip install hatchet"
      },
      "args": []
    }
  ]
}