{
  "name": "alsabat-test",
  "version": "0.1.0",
  "description": "CLI tool: alsabat-test",
  "source": "https://manpages.debian.org/alsabat-test",
  "checks": [
    {
      "type": "binary",
      "name": "alsabat-test"
    }
  ],
  "install_guidance": {
    "plugin": "alsabat-test",
    "binary": "alsabat-test",
    "check": "which alsabat-test",
    "install_steps": [
      "apt-get install alsabat-test 2>/dev/null || which alsabat-test",
      "Verify: alsabat-test --version",
      "supercli plugins install ./plugins/alsabat-test --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "alsabat-test",
      "resource": "self",
      "action": "version",
      "description": "Print alsabat-test version",
      "adapter": "process",
      "adapterConfig": {
        "command": "alsabat-test",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install alsabat-test: apt-get install alsabat-test 2>/dev/null || which alsabat-test"
      },
      "args": []
    },
    {
      "namespace": "alsabat-test",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to alsabat-test CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "alsabat-test",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install alsabat-test: apt-get install alsabat-test 2>/dev/null || which alsabat-test"
      },
      "args": []
    }
  ]
}