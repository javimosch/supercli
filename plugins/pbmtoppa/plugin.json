{
  "name": "pbmtoppa",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoppa",
  "source": "https://manpages.debian.org/pbmtoppa",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoppa"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoppa",
    "binary": "pbmtoppa",
    "check": "which pbmtoppa",
    "install_steps": [
      "apt-get install pbmtoppa 2>/dev/null || which pbmtoppa",
      "Verify: pbmtoppa --version",
      "supercli plugins install ./plugins/pbmtoppa --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoppa",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoppa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoppa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoppa: apt-get install pbmtoppa 2>/dev/null || which pbmtoppa"
      },
      "args": []
    },
    {
      "namespace": "pbmtoppa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoppa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoppa",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoppa: apt-get install pbmtoppa 2>/dev/null || which pbmtoppa"
      },
      "args": []
    }
  ]
}