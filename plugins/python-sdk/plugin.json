{
  "name": "python-sdk",
  "version": "0.1.0",
  "description": "The official Python SDK for Model Context Protocol servers and clients",
  "source": "https://github.com/python-sdk/python-sdk",
  "checks": [
    {
      "type": "binary",
      "name": "python-sdk"
    }
  ],
  "install_guidance": {
    "plugin": "python-sdk",
    "binary": "python-sdk",
    "check": "which python-sdk",
    "install_steps": [
      "pip install python-sdk",
      "Verify: python-sdk --version",
      "supercli plugins install ./plugins/python-sdk --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "python-sdk",
      "resource": "self",
      "action": "version",
      "description": "Print python-sdk version",
      "adapter": "process",
      "adapterConfig": {
        "command": "python-sdk",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install python-sdk: pip install python-sdk"
      },
      "args": []
    },
    {
      "namespace": "python-sdk",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to python-sdk CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "python-sdk",
        "passthrough": true,
        "missingDependencyHelp": "Install python-sdk: pip install python-sdk"
      },
      "args": []
    }
  ]
}