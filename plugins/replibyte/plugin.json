{
  "name": "replibyte",
  "version": "1.0.0",
  "description": "replibyte \u2014 Database seeding tool",
  "source": "crates.io/crates/replibyte",
  "checks": [
    {
      "type": "binary",
      "name": "replibyte"
    }
  ],
  "install_guidance": {
    "plugin": "replibyte",
    "binary": "replibyte",
    "check": "which replibyte",
    "install_steps": [
      "# Install replibyte:",
      "# apt: sudo apt-get install replibyte",
      "# brew: brew install replibyte",
      "# cargo: cargo install replibyte",
      "# npm: npm install -g replibyte",
      "# pip: pip install replibyte",
      "# or download from crates.io/crates/replibyte"
    ]
  },
  "commands": [
    {
      "namespace": "replibyte",
      "resource": "replibyte",
      "action": "run",
      "description": "Run replibyte",
      "adapter": "process",
      "adapterConfig": {
        "command": "replibyte",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install replibyte from crates.io/crates/replibyte"
      },
      "args": []
    }
  ]
}