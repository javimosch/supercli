{
  "name": "lpinfo",
  "version": "0.1.0",
  "description": "CUPS printer/backend info",
  "source": "https://packages.debian.org/lpinfo",
  "checks": [{ "type": "binary", "name": "lpinfo" }],
  "install_guidance": {
    "plugin": "lpinfo", "binary": "lpinfo", "check": "which lpinfo",
    "install_steps": ["apt-get install cups", "Verify: lpinfo --version", "supercli plugins install ./plugins/lpinfo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lpinfo", "resource": "_", "action": "_",
    "description": "Passthrough to lpinfo CLI",
    "adapter": "process", "adapterConfig": { "command": "lpinfo", "passthrough": true, "missingDependencyHelp": "Install lpinfo: apt-get install cups" }, "args": []
  }]
}
