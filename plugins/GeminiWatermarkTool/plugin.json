{
  "name": "GeminiWatermarkTool",
  "version": "0.1.0",
  "description": "VEO / Gemini 3.5 Nano Banana Pro watermark maintenance tool",
  "source": "https://github.com/GeminiWatermarkTool/GeminiWatermarkTool",
  "checks": [
    {
      "type": "binary",
      "name": "geminiwatermarktool"
    }
  ],
  "install_guidance": {
    "plugin": "GeminiWatermarkTool",
    "binary": "geminiwatermarktool",
    "check": "which geminiwatermarktool",
    "install_steps": [
      "pip install geminiwatermarktool",
      "Verify: geminiwatermarktool --version",
      "supercli plugins install ./plugins/GeminiWatermarkTool --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "GeminiWatermarkTool",
      "resource": "self",
      "action": "version",
      "description": "Print GeminiWatermarkTool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "geminiwatermarktool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install GeminiWatermarkTool: pip install geminiwatermarktool"
      },
      "args": []
    },
    {
      "namespace": "GeminiWatermarkTool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to geminiwatermarktool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "geminiwatermarktool",
        "passthrough": true,
        "missingDependencyHelp": "Install GeminiWatermarkTool: pip install geminiwatermarktool"
      },
      "args": []
    }
  ]
}