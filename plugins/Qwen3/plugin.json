{
  "name": "Qwen3",
  "version": "0.1.0",
  "description": "Qwen3 is the large language model series developed by Qwen team, Alibaba Cloud.",
  "source": "https://github.com/Qwen3/Qwen3",
  "checks": [
    {
      "type": "binary",
      "name": "qwen3"
    }
  ],
  "install_guidance": {
    "plugin": "Qwen3",
    "binary": "qwen3",
    "check": "which qwen3",
    "install_steps": [
      "pip install qwen3",
      "Verify: qwen3 --version",
      "supercli plugins install ./plugins/Qwen3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Qwen3",
      "resource": "self",
      "action": "version",
      "description": "Print Qwen3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qwen3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Qwen3: pip install qwen3"
      },
      "args": []
    },
    {
      "namespace": "Qwen3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qwen3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qwen3",
        "passthrough": true,
        "missingDependencyHelp": "Install Qwen3: pip install qwen3"
      },
      "args": []
    }
  ]
}