{
  "name": "bluetoothd",
  "version": "0.1.0",
  "description": "CLI tool: bluetoothd",
  "source": "https://packages.debian.org/bluetoothd",
  "checks": [{ "type": "binary", "name": "bluetoothd" }],
  "install_guidance": {
    "plugin": "bluetoothd", "binary": "bluetoothd", "check": "which bluetoothd",
    "install_steps": ["apt-get install bluetoothd 2>/dev/null || which bluetoothd", "Verify: bluetoothd --version", "supercli plugins install ./plugins/bluetoothd --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bluetoothd", "resource": "_", "action": "_",
    "description": "Passthrough to bluetoothd CLI",
    "adapter": "process", "adapterConfig": { "command": "bluetoothd", "passthrough": true, "missingDependencyHelp": "Install bluetoothd: apt-get install bluetoothd" }, "args": []
  }]
}
