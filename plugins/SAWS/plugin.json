{
  "name": "SAWS",
  "version": "0.1.0",
  "description": "Supercharged AWS CLI",
  "source": "https://github.com/donnemartin/saws",
  "checks": [
    {
      "type": "binary",
      "name": "SAWS"
    }
  ],
  "install_guidance": {
    "plugin": "SAWS",
    "binary": "SAWS",
    "check": "which SAWS",
    "install_steps": [
      "See https://github.com/donnemartin/saws",
      "Verify: SAWS --version",
      "supercli plugins install ./plugins/SAWS --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "SAWS",
      "resource": "self",
      "action": "version",
      "description": "Print SAWS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "SAWS",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SAWS: See https://github.com/donnemartin/saws"
      },
      "args": []
    },
    {
      "namespace": "SAWS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to SAWS CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "SAWS",
        "passthrough": true,
        "missingDependencyHelp": "Install SAWS"
      },
      "args": []
    }
  ]
}