{
  "name": "pydoc2",
  "version": "0.1.0",
  "description": "CLI tool: pydoc2",
  "source": "https://manpages.debian.org/pydoc2",
  "checks": [
    {
      "type": "binary",
      "name": "pydoc2"
    }
  ],
  "install_guidance": {
    "plugin": "pydoc2",
    "binary": "pydoc2",
    "check": "which pydoc2",
    "install_steps": [
      "apt-get install pydoc2 2>/dev/null || which pydoc2",
      "Verify: pydoc2 --version",
      "supercli plugins install ./plugins/pydoc2 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pydoc2",
      "resource": "self",
      "action": "version",
      "description": "Print pydoc2 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pydoc2",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pydoc2: apt-get install pydoc2 2>/dev/null || which pydoc2"
      },
      "args": []
    },
    {
      "namespace": "pydoc2",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pydoc2 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pydoc2",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pydoc2: apt-get install pydoc2 2>/dev/null || which pydoc2"
      },
      "args": []
    }
  ]
}