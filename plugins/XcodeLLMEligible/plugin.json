{
  "name": "XcodeLLMEligible",
  "version": "0.1.0",
  "description": "",
  "source": "https://github.com/XcodeLLMEligible/XcodeLLMEligible",
  "checks": [
    {
      "type": "binary",
      "name": "xcodellmeligible"
    }
  ],
  "install_guidance": {
    "plugin": "XcodeLLMEligible",
    "binary": "xcodellmeligible",
    "check": "which xcodellmeligible",
    "install_steps": [
      "pip install xcodellmeligible",
      "Verify: xcodellmeligible --version",
      "supercli plugins install ./plugins/XcodeLLMEligible --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "XcodeLLMEligible",
      "resource": "self",
      "action": "version",
      "description": "Print XcodeLLMEligible version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xcodellmeligible",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install XcodeLLMEligible: pip install xcodellmeligible"
      },
      "args": []
    },
    {
      "namespace": "XcodeLLMEligible",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xcodellmeligible CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xcodellmeligible",
        "passthrough": true,
        "missingDependencyHelp": "Install XcodeLLMEligible: pip install xcodellmeligible"
      },
      "args": []
    }
  ]
}