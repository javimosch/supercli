{
  "name": "pip-chill",
  "version": "0.1.0",
  "description": "List Python packages not installed via pip. Shows only packages that were manually installed, not dependencies.",
  "source": "https",
  "checks": [{"type": "binary", "name": "pip-chill"}],
  "install_guidance": {
    "plugin": "pip-chill",
    "binary": "pip-chill",
    "check": "which pip-chill",
    "install_steps": [
      "pip install pip-chill",
      "Verify: pip-chill --version",
      "supercli plugins install ./plugins/pip-chill --on-conflict replace --json"
    ],
    "note": "Non-interactive CLI tool."
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "pip",
      "resource": "self",
      "action": "version",
      "description": "Print pip-chill version",
      "adapter": "process",
      "adapterConfig": {"command": "pip-chill", "baseArgs": ["--version"], "missingDependencyHelp": "Install pip-chill: pip install pip-chill"},
      "args": []
    },
    {
      "namespace": "pip",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pip-chill CLI",
      "adapter": "process",
      "adapterConfig": {"command": "pip-chill", "passthrough": true, "missingDependencyHelp": "Install pip-chill: pip install pip-chill"},
      "args": []
    }
  ]
}
