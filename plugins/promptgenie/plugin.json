{
  "name": "promptgenie",
  "version": "0.1.0",
  "description": "A useful, always available CLI assistant",
  "source": "https://github.com/promptgenie/promptgenie",
  "checks": [
    {
      "type": "binary",
      "name": "promptgenie"
    }
  ],
  "install_guidance": {
    "plugin": "promptgenie",
    "binary": "promptgenie",
    "check": "which promptgenie",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: promptgenie --version",
      "supercli plugins install ./plugins/promptgenie --on-conflict replace --json"
    ],
    "note": "Shell language CLI tool"
  },
  "commands": [
    {
      "namespace": "promptgenie",
      "resource": "self",
      "action": "version",
      "description": "Print promptgenie version",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptgenie",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install promptgenie from project repository"
      },
      "args": []
    },
    {
      "namespace": "promptgenie",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to promptgenie CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "promptgenie",
        "passthrough": true,
        "missingDependencyHelp": "Install promptgenie from project repository"
      },
      "args": []
    }
  ]
}