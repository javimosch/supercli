{
  "name": "clang-tidy",
  "version": "1.0.0",
  "description": "clang-tidy \u2014 C/C++ linter",
  "source": "clang.llvm.org",
  "checks": [
    {
      "type": "binary",
      "name": "clang-tidy"
    }
  ],
  "install_guidance": {
    "plugin": "clang-tidy",
    "binary": "clang-tidy",
    "check": "which clang-tidy",
    "install_steps": [
      "# Install clang-tidy",
      "# See clang.llvm.org",
      "# apt: sudo apt-get install clang-tidy",
      "# brew: brew install clang-tidy",
      "# cargo: cargo install clang-tidy",
      "# npm: npm install -g clang-tidy",
      "# pip: pip install clang-tidy"
    ]
  },
  "commands": [
    {
      "namespace": "clang",
      "resource": "tidy",
      "action": "run",
      "description": "Run clang-tidy",
      "adapter": "process",
      "adapterConfig": {
        "command": "clang-tidy",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install clang-tidy from clang.llvm.org"
      },
      "args": []
    }
  ]
}