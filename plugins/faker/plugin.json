{
  "name": "faker",
  "version": "0.1.0",
  "description": "CLI tool: faker",
  "source": "https://manpages.debian.org/faker",
  "checks": [
    {
      "type": "binary",
      "name": "faker"
    }
  ],
  "install_guidance": {
    "plugin": "faker",
    "binary": "faker",
    "check": "which faker",
    "install_steps": [
      "apt-get install faker 2>/dev/null || which faker",
      "Verify: faker --version",
      "supercli plugins install ./plugins/faker --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "faker",
      "resource": "self",
      "action": "version",
      "description": "Print faker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "faker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install faker: apt-get install faker 2>/dev/null || which faker"
      },
      "args": []
    },
    {
      "namespace": "faker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to faker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "faker",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install faker: apt-get install faker 2>/dev/null || which faker"
      },
      "args": []
    }
  ]
}