{
  "name": "clock-cli",
  "version": "0.1.0",
  "description": "Track time and generate timesheets from the CLI",
  "source": "https://github.com/clocklimited/clock-cli",
  "checks": [{ "type": "binary", "name": "clock-cli" }],
  "install_guidance": {
    "plugin": "clock-cli",
    "binary": "clock-cli",
    "check": "which clock-cli",
    "install_steps": ["npm install -g clock-cli", "Verify: clock-cli --version", "supercli plugins install ./plugins/clock-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clock-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to clock-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "clock-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install clock-cli: npm install -g clock-cli"
    },
    "args": []
  }]
}
