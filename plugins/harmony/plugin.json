{
  "name": "harmony",
  "version": "0.1.0",
  "description": "CLI response format renderer for structured output",
  "source": "https://github.com/nicholasgasior/harmony",
  "checks": [
    {
      "type": "binary",
      "name": "harmony"
    }
  ],
  "install_guidance": {
    "plugin": "harmony",
    "binary": "harmony",
    "check": "which harmony",
    "install_steps": [
      "cargo install harmony",
      "Verify: harmony --version",
      "supercli plugins install ./plugins/harmony --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "harmony",
      "resource": "self",
      "action": "version",
      "description": "Print harmony version",
      "adapter": "process",
      "adapterConfig": {
        "command": "harmony",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install harmony: cargo install harmony"
      },
      "args": []
    },
    {
      "namespace": "harmony",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to harmony CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "harmony",
        "passthrough": true,
        "missingDependencyHelp": "Install harmony: cargo install harmony"
      },
      "args": []
    }
  ]
}
