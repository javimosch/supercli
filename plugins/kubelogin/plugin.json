{
  "name": "kubelogin",
  "version": "0.1.0",
  "description": "Kubernetes OpenID Connect authentication helper",
  "source": "https://github.com/int128/kubelogin",
  "checks": [{ "type": "binary", "name": "kubelogin" }],
  "install_guidance": {
    "plugin": "kubelogin",
    "binary": "kubelogin",
    "check": "which kubelogin",
    "install_steps": ["brew install kubelogin", "Verify: kubelogin --version", "supercli plugins install ./plugins/kubelogin --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kubelogin",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kubelogin CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kubelogin",
      "passthrough": true,
      "missingDependencyHelp": "Install kubelogin: brew install kubelogin"
    },
    "args": []
  }]
}
