{
  "name": "dot",
  "version": "1.0.0",
  "description": "dot \u2014 filter for drawing directed graphs neato - filter for drawing undirected graphs twopi - filter for radial layouts of graphs circo - filter",
  "source": "graphviz.org",
  "checks": [
    {
      "type": "binary",
      "name": "dot"
    }
  ],
  "install_guidance": {
    "plugin": "dot",
    "binary": "dot",
    "check": "which dot",
    "install_steps": [
      "# Install dot",
      "# See graphviz.org",
      "# apt: sudo apt-get install dot",
      "# brew: brew install dot",
      "# cargo: cargo install dot",
      "# npm: npm install -g dot",
      "# pip: pip install dot"
    ]
  },
  "commands": [
    {
      "namespace": "dot",
      "resource": "dot",
      "action": "run",
      "description": "Run dot",
      "adapter": "process",
      "adapterConfig": {
        "command": "dot",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install dot from graphviz.org"
      },
      "args": []
    }
  ]
}