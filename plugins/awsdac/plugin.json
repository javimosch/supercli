{
  "name": "awsdac",
  "version": "0.1.0",
  "description": "CLI tool for drawing AWS architecture",
  "source": "https://github.com/awslabs/diagram-as-code",
  "checks": [
    {
      "type": "binary",
      "name": "awsdac"
    }
  ],
  "install_guidance": {
    "plugin": "awsdac",
    "binary": "awsdac",
    "check": "which awsdac",
    "install_steps": [
      "brew install awsdac",
      "Verify: awsdac --version",
      "supercli plugins install ./plugins/awsdac --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "awsdac",
      "resource": "self",
      "action": "version",
      "description": "Print awsdac version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsdac",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awsdac: brew install awsdac"
      },
      "args": []
    },
    {
      "namespace": "awsdac",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awsdac CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awsdac",
        "passthrough": true,
        "missingDependencyHelp": "Install awsdac"
      },
      "args": []
    }
  ]
}