{
  "name": "exo-open",
  "version": "0.1.0",
  "description": "CLI tool: exo-open",
  "source": "https://manpages.debian.org/exo-open",
  "checks": [
    {
      "type": "binary",
      "name": "exo-open"
    }
  ],
  "install_guidance": {
    "plugin": "exo-open",
    "binary": "exo-open",
    "check": "which exo-open",
    "install_steps": [
      "apt-get install exo-open 2>/dev/null || which exo-open",
      "Verify: exo-open --version",
      "supercli plugins install ./plugins/exo-open --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "exo-open",
      "resource": "self",
      "action": "version",
      "description": "Print exo-open version",
      "adapter": "process",
      "adapterConfig": {
        "command": "exo-open",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install exo-open: apt-get install exo-open 2>/dev/null || which exo-open"
      },
      "args": []
    },
    {
      "namespace": "exo-open",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to exo-open CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "exo-open",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install exo-open: apt-get install exo-open 2>/dev/null || which exo-open"
      },
      "args": []
    }
  ]
}