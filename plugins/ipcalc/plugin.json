{
  "name": "ipcalc",
  "version": "0.1.0",
  "description": "IP subnet calculator and address planner",
  "source": "https",
  "checks": [{"type": "binary", "name": "ipcalc"}],
  "install_guidance": {
    "plugin": "ipcalc",
    "binary": "ipcalc",
    "check": "which ipcalc",
    "install_steps": [
      "brew install ipcalc",
      "Verify: ipcalc --version",
      "supercli plugins install ./plugins/ipcalc --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "ipcalc",
      "resource": "self",
      "action": "version",
      "description": "Print ipcalc version",
      "adapter": "process",
      "adapterConfig": {"command": "ipcalc", "baseArgs": ["--version"], "missingDependencyHelp": "Install ipcalc: brew install ipcalc"},
      "args": []
    },
    {
      "namespace": "ipcalc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ipcalc CLI",
      "adapter": "process",
      "adapterConfig": {"command": "ipcalc", "passthrough": true, "missingDependencyHelp": "Install ipcalc: brew install ipcalc"},
      "args": []
    }
  ]
}
