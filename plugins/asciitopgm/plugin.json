{
  "name": "asciitopgm",
  "version": "0.1.0",
  "description": "CLI tool: asciitopgm",
  "source": "https://packages.debian.org/asciitopgm",
  "checks": [{ "type": "binary", "name": "asciitopgm" }],
  "install_guidance": {
    "plugin": "asciitopgm", "binary": "asciitopgm", "check": "which asciitopgm",
    "install_steps": ["apt-get install asciitopgm 2>/dev/null || which asciitopgm", "Verify: asciitopgm --version", "supercli plugins install ./plugins/asciitopgm --on-conflict replace --json"]
