  "commands": [{
    "namespace": "asciitopgm", "resource": "_", "action": "_",
    "description": "Passthrough to asciitopgm CLI",
    "adapter": "process", "adapterConfig": { "command": "asciitopgm", "passthrough": true, "missingDependencyHelp": "Install asciitopgm: apt-get install asciitopgm" }, "args": []
  }]
}
