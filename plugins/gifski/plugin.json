{
  "name": "gifski",
  "version": "0.1.0",
  "description": "High-quality GIF encoder from video frames",
  "source": "https://github.com/ImageOptim/gifski",
  "checks": [
    {
      "type": "binary",
      "name": "gifski"
    }
  ],
  "install_guidance": {
    "plugin": "gifski",
    "binary": "gifski",
    "check": "which gifski",
    "install_steps": [
      "cargo install gifski",
      "Verify: gifski --version",
      "supercli plugins install ./plugins/gifski --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "gifski",
      "resource": "self",
      "action": "version",
      "description": "Print gifski version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gifski",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gifski: cargo install gifski"
      },
      "args": []
    },
    {
      "namespace": "gifski",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gifski CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gifski",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gifski: cargo install gifski"
      },
      "args": []
    }
  ]
}
