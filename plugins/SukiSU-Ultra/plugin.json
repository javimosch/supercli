{
  "name": "SukiSU-Ultra",
  "version": "0.1.0",
  "description": "Kernel-based Android Root Solution & KPM",
  "source": "https://github.com/SukiSU-Ultra/SukiSU-Ultra",
  "checks": [
    {
      "type": "binary",
      "name": "sukisu-ultra"
    }
  ],
  "install_guidance": {
    "plugin": "SukiSU-Ultra",
    "binary": "sukisu-ultra",
    "check": "which sukisu-ultra",
    "install_steps": [
      "pip install sukisu-ultra",
      "Verify: sukisu-ultra --version",
      "supercli plugins install ./plugins/SukiSU-Ultra --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "SukiSU-Ultra",
      "resource": "self",
      "action": "version",
      "description": "Print SukiSU-Ultra version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sukisu-ultra",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install SukiSU-Ultra: pip install sukisu-ultra"
      },
      "args": []
    },
    {
      "namespace": "SukiSU-Ultra",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sukisu-ultra CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sukisu-ultra",
        "passthrough": true,
        "missingDependencyHelp": "Install SukiSU-Ultra: pip install sukisu-ultra"
      },
      "args": []
    }
  ]
}