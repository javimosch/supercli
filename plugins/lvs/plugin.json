{
  "name": "lvs",
  "version": "0.1.0",
  "description": "Display logical volume info",
  "source": "https://packages.debian.org/lvs",
  "checks": [{ "type": "binary", "name": "lvs" }],
  "install_guidance": {
    "plugin": "lvs", "binary": "lvs", "check": "which lvs",
    "install_steps": ["apt-get install lvm2", "Verify: lvs --version", "supercli plugins install ./plugins/lvs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "lvs", "resource": "_", "action": "_",
    "description": "Passthrough to lvs CLI",
    "adapter": "process", "adapterConfig": { "command": "lvs", "passthrough": true, "missingDependencyHelp": "Install lvs: apt-get install lvm2" }, "args": []
  }]
}
