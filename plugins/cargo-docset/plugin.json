{
  "name": "cargo-docset",
  "version": "0.1.0",
  "description": "Cargo subcommand to generate a Dash/Zeal docset for your Rust packages",
  "source": "https://github.com/Robzz/cargo-docset",
  "checks": [
    {
      "type": "binary",
      "name": "cargo-docset"
    }
  ],
  "install_guidance": {
    "plugin": "cargo-docset",
    "binary": "cargo-docset",
    "check": "which cargo-docset",
    "install_steps": [
      "brew install cargo-docset",
      "Verify: cargo-docset --version",
      "supercli plugins install ./plugins/cargo-docset --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cargo-docset",
      "resource": "self",
      "action": "version",
      "description": "Print cargo-docset version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-docset",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cargo-docset: brew install cargo-docset"
      },
      "args": []
    },
    {
      "namespace": "cargo-docset",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cargo-docset CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cargo-docset",
        "passthrough": true,
        "missingDependencyHelp": "Install cargo-docset"
      },
      "args": []
    }
  ]
}