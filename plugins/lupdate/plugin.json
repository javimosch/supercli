{
  "name": "lupdate",
  "version": "0.1.0",
  "description": "CLI tool: lupdate",
  "source": "https://manpages.debian.org/lupdate",
  "checks": [
    {
      "type": "binary",
      "name": "lupdate"
    }
  ],
  "install_guidance": {
    "plugin": "lupdate",
    "binary": "lupdate",
    "check": "which lupdate",
    "install_steps": [
      "apt-get install lupdate 2>/dev/null || which lupdate",
      "Verify: lupdate --version",
      "supercli plugins install ./plugins/lupdate --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lupdate",
      "resource": "self",
      "action": "version",
      "description": "Print lupdate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lupdate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lupdate: apt-get install lupdate 2>/dev/null || which lupdate"
      },
      "args": []
    },
    {
      "namespace": "lupdate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lupdate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lupdate",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lupdate: apt-get install lupdate 2>/dev/null || which lupdate"
      },
      "args": []
    }
  ]
}