{
  "name": "spa-acp-tool",
  "version": "0.1.0",
  "description": "CLI tool: spa-acp-tool",
  "source": "https://manpages.debian.org/spa-acp-tool",
  "checks": [
    {
      "type": "binary",
      "name": "spa-acp-tool"
    }
  ],
  "install_guidance": {
    "plugin": "spa-acp-tool",
    "binary": "spa-acp-tool",
    "check": "which spa-acp-tool",
    "install_steps": [
      "apt-get install spa-acp-tool 2>/dev/null || which spa-acp-tool",
      "Verify: spa-acp-tool --version",
      "supercli plugins install ./plugins/spa-acp-tool --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "spa-acp-tool",
      "resource": "self",
      "action": "version",
      "description": "Print spa-acp-tool version",
      "adapter": "process",
      "adapterConfig": {
        "command": "spa-acp-tool",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install spa-acp-tool: apt-get install spa-acp-tool 2>/dev/null || which spa-acp-tool"
      },
      "args": []
    },
    {
      "namespace": "spa-acp-tool",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to spa-acp-tool CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "spa-acp-tool",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install spa-acp-tool: apt-get install spa-acp-tool 2>/dev/null || which spa-acp-tool"
      },
      "args": []
    }
  ]
}