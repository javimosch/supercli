{
  "name": "rq",
  "version": "0.1.0",
  "description": "Converter for Avro CBOR Protobuf YAML and multiple data formats",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "rq" }],
  "install_guidance": {
    "plugin": "rq",
    "binary": "rq",
    "check": "which rq",
    "install_steps": ["brew install rq", "Verify: rq --version", "supercli plugins install ./plugins/rq --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rq",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to rq CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "rq",
      "passthrough": true,
      "missingDependencyHelp": "Install rq: brew install rq"
    },
    "args": []
  }]
}
