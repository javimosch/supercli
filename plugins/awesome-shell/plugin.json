{
  "name": "awesome-shell",
  "version": "0.1.0",
  "description": "Command-line utilities and frameworks",
  "source": "https://github.com/alebcay/awesome-shell#readme",
  "checks": [
    {
      "type": "binary",
      "name": "awesome-shell"
    }
  ],
  "install_guidance": {
    "plugin": "awesome-shell",
    "binary": "awesome-shell",
    "check": "which awesome-shell",
    "install_steps": [
      "See https://github.com/alebcay/awesome-shell#readme",
      "Verify: awesome-shell --version",
      "supercli plugins install ./plugins/awesome-shell --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "awesome-shell",
      "resource": "self",
      "action": "version",
      "description": "Print awesome-shell version",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-shell",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install awesome-shell: See https://github.com/alebcay/awesome-shell#readme"
      },
      "args": []
    },
    {
      "namespace": "awesome-shell",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to awesome-shell CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "awesome-shell",
        "passthrough": true,
        "missingDependencyHelp": "Install awesome-shell"
      },
      "args": []
    }
  ]
}