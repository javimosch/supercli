{
  "name": "diceware",
  "version": "0.1.0",
  "description": "Passphrases to remember",
  "source": "https://github.com/ulif/diceware",
  "checks": [
    {
      "type": "binary",
      "name": "diceware"
    }
  ],
  "install_guidance": {
    "plugin": "diceware",
    "binary": "diceware",
    "check": "which diceware",
    "install_steps": [
      "brew install diceware",
      "Verify: diceware --version",
      "supercli plugins install ./plugins/diceware --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "diceware",
      "resource": "self",
      "action": "version",
      "description": "Print diceware version",
      "adapter": "process",
      "adapterConfig": {
        "command": "diceware",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install diceware: brew install diceware"
      },
      "args": []
    },
    {
      "namespace": "diceware",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to diceware CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "diceware",
        "passthrough": true,
        "missingDependencyHelp": "Install diceware"
      },
      "args": []
    }
  ]
}