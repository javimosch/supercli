{
  "name": "ssh3",
  "version": "0.1.0",
  "description": "SSH3: faster and rich secure shell using HTTP/3, checkout our article here: https://arxiv.org/abs/23",
  "source": "https://github.com/ssh3/ssh3",
  "checks": [
    {
      "type": "binary",
      "name": "ssh3"
    }
  ],
  "install_guidance": {
    "plugin": "ssh3",
    "binary": "ssh3",
    "check": "which ssh3",
    "install_steps": [
      "pip install ssh3",
      "Verify: ssh3 --version",
      "supercli plugins install ./plugins/ssh3 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ssh3",
      "resource": "self",
      "action": "version",
      "description": "Print ssh3 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ssh3",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ssh3: pip install ssh3"
      },
      "args": []
    },
    {
      "namespace": "ssh3",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ssh3 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ssh3",
        "passthrough": true,
        "missingDependencyHelp": "Install ssh3: pip install ssh3"
      },
      "args": []
    }
  ]
}