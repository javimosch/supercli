{
  "name": "git-delta",
  "version": "0.1.0",
  "description": "Syntax-highlighting pager for git and diff output",
  "checks": [
    {
      "type": "binary",
      "name": "git-delta"
    }
  ],
  "install_guidance": {
    "plugin": "git-delta",
    "binary": "git-delta",
    "check": "which git-delta",
    "install_steps": [
      "brew install git-delta",
      "Verify: git-delta --version",
      "supercli plugins install ./plugins/git-delta --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-delta",
      "resource": "self",
      "action": "version",
      "description": "Print git-delta version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-delta",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-delta: brew install git-delta"
      },
      "args": []
    },
    {
      "namespace": "git-delta",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-delta CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-delta",
        "passthrough": true,
        "missingDependencyHelp": "Install git-delta"
      },
      "args": []
    }
  ]
}