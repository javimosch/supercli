{
  "name": "lzsa",
  "version": "0.1.0",
  "description": "Lossless packer that is optimized for fast decompression on 8-bit micros",
  "source": "https://github.com/emmanuel-marty/lzsa",
  "checks": [
    {
      "type": "binary",
      "name": "lzsa"
    }
  ],
  "install_guidance": {
    "plugin": "lzsa",
    "binary": "lzsa",
    "check": "which lzsa",
    "install_steps": [
      "brew install lzsa",
      "Verify: lzsa --version",
      "supercli plugins install ./plugins/lzsa --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lzsa",
      "resource": "self",
      "action": "version",
      "description": "Print lzsa version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lzsa",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lzsa: brew install lzsa"
      },
      "args": []
    },
    {
      "namespace": "lzsa",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lzsa CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lzsa",
        "passthrough": true,
        "missingDependencyHelp": "Install lzsa"
      },
      "args": []
    }
  ]
}