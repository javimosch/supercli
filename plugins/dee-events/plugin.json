{
  "name": "dee-events",
  "version": "0.1.0",
  "description": "Find local events from the command line with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-events" }],
  "install_guidance": {
    "plugin": "dee-events",
    "binary": "dee-events",
    "check": "which dee-events",
    "install_steps": ["cargo install dee-events", "Verify: dee-events --version", "supercli plugins install ./plugins/dee-events --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-events",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-events CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-events",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-events: cargo install dee-events"
    },
    "args": []
  }]
}
