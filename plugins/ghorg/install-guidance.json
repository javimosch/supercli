{
  "plugin": "ghorg",
  "binary": "ghorg",
  "check": "which ghorg",
  "install_steps": [
    "# Install ghorg",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/ghorg-linux-amd64 -o /usr/local/bin/ghorg",
    "chmod +x /usr/local/bin/ghorg",
    "# Or via package manager, see github.com/gabrie30/ghorg"
  ]
}