{
  "name": "ghorg",
  "version": "1.0.0",
  "description": "ghorg \u2014 Clone all repos from org/user",
  "source": "github.com/gabrie30/ghorg",
  "checks": [
    {
      "type": "binary",
      "name": "ghorg"
    }
  ],
  "install_guidance": {
    "plugin": "ghorg",
    "binary": "ghorg",
    "check": "which ghorg",
    "install_steps": [
      "# Install ghorg:",
      "# apt: sudo apt-get install ghorg",
      "# brew: brew install ghorg",
      "# cargo: cargo install ghorg",
      "# npm: npm install -g ghorg",
      "# pip: pip install ghorg",
      "# or download from github.com/gabrie30/ghorg"
    ]
  },
  "commands": [
    {
      "namespace": "ghorg",
      "resource": "ghorg",
      "action": "run",
      "description": "Run ghorg",
      "adapter": "process",
      "adapterConfig": {
        "command": "ghorg",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ghorg from github.com/gabrie30/ghorg"
      },
      "args": []
    }
  ]
}