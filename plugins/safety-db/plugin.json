{
  "name": "safety-db",
  "version": "0.1.0",
  "description": "Curated database of insecure Python packages",
  "source": "https://github.com/pyupio/safety-db",
  "checks": [{ "type": "binary", "name": "safety-db" }],
  "install_guidance": {
    "plugin": "safety-db",
    "binary": "safety-db",
    "check": "which safety-db",
    "install_steps": ["pip install safety-db", "Verify: safety-db --version", "supercli plugins install ./plugins/safety-db --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "safety-db",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to safety-db CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "safety-db",
      "passthrough": true,
      "missingDependencyHelp": "Install safety-db: pip install safety-db", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
