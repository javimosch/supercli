{
  "name": "ppmtoneo",
  "version": "0.1.0",
  "description": "CLI tool: ppmtoneo",
  "source": "https://manpages.debian.org/ppmtoneo",
  "checks": [
    {
      "type": "binary",
      "name": "ppmtoneo"
    }
  ],
  "install_guidance": {
    "plugin": "ppmtoneo",
    "binary": "ppmtoneo",
    "check": "which ppmtoneo",
    "install_steps": [
      "apt-get install ppmtoneo 2>/dev/null || which ppmtoneo",
      "Verify: ppmtoneo --version",
      "supercli plugins install ./plugins/ppmtoneo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmtoneo",
      "resource": "self",
      "action": "version",
      "description": "Print ppmtoneo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoneo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmtoneo: apt-get install ppmtoneo 2>/dev/null || which ppmtoneo"
      },
      "args": []
    },
    {
      "namespace": "ppmtoneo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmtoneo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmtoneo",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmtoneo: apt-get install ppmtoneo 2>/dev/null || which ppmtoneo"
      },
      "args": []
    }
  ]
}