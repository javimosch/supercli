{
  "name": "go-log",
  "version": "0.1.0",
  "description": "IPFS logging utility for structured log management",
  "source": "go",
  "checks": [{ "type": "binary", "name": "go-log" }],
  "install_guidance": {
    "plugin": "go-log",
    "binary": "go-log",
    "check": "which go-log",
    "install_steps": ["go get github.com/ipfs/go-log", "Verify: go-log --version", "supercli plugins install ./plugins/go-log --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "go-log",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to go-log CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-log",
      "passthrough": true,
      "missingDependencyHelp": "Install go-log: go get github.com/ipfs/go-log"
    },
    "args": []
  }]
}
