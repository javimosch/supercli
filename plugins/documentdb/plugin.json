{
  "name": "documentdb",
  "version": "0.1.0",
  "description": "MongoDB-compatible database engine for cloud-native and open-source workloads. Built for scalability",
  "source": "https://github.com/documentdb/documentdb",
  "checks": [
    {
      "type": "binary",
      "name": "documentdb"
    }
  ],
  "install_guidance": {
    "plugin": "documentdb",
    "binary": "documentdb",
    "check": "which documentdb",
    "install_steps": [
      "pip install documentdb",
      "Verify: documentdb --version",
      "supercli plugins install ./plugins/documentdb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "documentdb",
      "resource": "self",
      "action": "version",
      "description": "Print documentdb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "documentdb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install documentdb: pip install documentdb"
      },
      "args": []
    },
    {
      "namespace": "documentdb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to documentdb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "documentdb",
        "passthrough": true,
        "missingDependencyHelp": "Install documentdb: pip install documentdb"
      },
      "args": []
    }
  ]
}