{
  "name": "PakePlus-iOS",
  "version": "0.1.0",
  "description": "Turn any webpage/HTML/Vue/React and so on into desktop and mobile app under 5M with easy in few minu",
  "source": "https://github.com/PakePlus-iOS/PakePlus-iOS",
  "checks": [
    {
      "type": "binary",
      "name": "pakeplus-ios"
    }
  ],
  "install_guidance": {
    "plugin": "PakePlus-iOS",
    "binary": "pakeplus-ios",
    "check": "which pakeplus-ios",
    "install_steps": [
      "pip install pakeplus-ios",
      "Verify: pakeplus-ios --version",
      "supercli plugins install ./plugins/PakePlus-iOS --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "PakePlus-iOS",
      "resource": "self",
      "action": "version",
      "description": "Print PakePlus-iOS version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pakeplus-ios",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install PakePlus-iOS: pip install pakeplus-ios"
      },
      "args": []
    },
    {
      "namespace": "PakePlus-iOS",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pakeplus-ios CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pakeplus-ios",
        "passthrough": true,
        "missingDependencyHelp": "Install PakePlus-iOS: pip install pakeplus-ios"
      },
      "args": []
    }
  ]
}