{
  "name": "excalidraw-converter",
  "version": "0.1.0",
  "description": "Command-line tool for porting Excalidraw diagrams to Gliffy",
  "source": "https://github.com/sindrel/excalidraw-converter",
  "checks": [
    {
      "type": "binary",
      "name": "excalidraw-converter"
    }
  ],
  "install_guidance": {
    "plugin": "excalidraw-converter",
    "binary": "excalidraw-converter",
    "check": "which excalidraw-converter",
    "install_steps": [
      "brew install excalidraw-converter",
      "Verify: excalidraw-converter --version",
      "supercli plugins install ./plugins/excalidraw-converter --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "excalidraw-converter",
      "resource": "self",
      "action": "version",
      "description": "Print excalidraw-converter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "excalidraw-converter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install excalidraw-converter: brew install excalidraw-converter"
      },
      "args": []
    },
    {
      "namespace": "excalidraw-converter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to excalidraw-converter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "excalidraw-converter",
        "passthrough": true,
        "missingDependencyHelp": "Install excalidraw-converter"
      },
      "args": []
    }
  ]
}