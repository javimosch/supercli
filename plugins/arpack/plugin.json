{
  "name": "arpack",
  "version": "0.1.0",
  "description": "Routines to solve large scale eigenvalue problems",
  "source": "https://github.com/opencollab/arpack-ng",
  "checks": [
    {
      "type": "binary",
      "name": "arpack"
    }
  ],
  "install_guidance": {
    "plugin": "arpack",
    "binary": "arpack",
    "check": "which arpack",
    "install_steps": [
      "brew install arpack",
      "Verify: arpack --version",
      "supercli plugins install ./plugins/arpack --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "arpack",
      "resource": "self",
      "action": "version",
      "description": "Print arpack version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arpack",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arpack: brew install arpack"
      },
      "args": []
    },
    {
      "namespace": "arpack",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arpack CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "arpack",
        "passthrough": true,
        "missingDependencyHelp": "Install arpack"
      },
      "args": []
    }
  ]
}