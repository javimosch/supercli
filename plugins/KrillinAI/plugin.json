{
  "name": "KrillinAI",
  "version": "0.1.0",
  "description": "AI video translation & dubbing tool for humans and AI Agents, powered by LLMs. Full pipeline: downlo",
  "source": "https://github.com/KrillinAI/KrillinAI",
  "checks": [
    {
      "type": "binary",
      "name": "krillinai"
    }
  ],
  "install_guidance": {
    "plugin": "KrillinAI",
    "binary": "krillinai",
    "check": "which krillinai",
    "install_steps": [
      "pip install krillinai",
      "Verify: krillinai --version",
      "supercli plugins install ./plugins/KrillinAI --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "KrillinAI",
      "resource": "self",
      "action": "version",
      "description": "Print KrillinAI version",
      "adapter": "process",
      "adapterConfig": {
        "command": "krillinai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install KrillinAI: pip install krillinai"
      },
      "args": []
    },
    {
      "namespace": "KrillinAI",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to krillinai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "krillinai",
        "passthrough": true,
        "missingDependencyHelp": "Install KrillinAI: pip install krillinai"
      },
      "args": []
    }
  ]
}