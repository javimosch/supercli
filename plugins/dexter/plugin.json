{
  "name": "dexter",
  "version": "0.1.0",
  "description": "An autonomous agent for deep financial research",
  "source": "https://github.com/dexter/dexter",
  "checks": [
    {
      "type": "binary",
      "name": "dexter"
    }
  ],
  "install_guidance": {
    "plugin": "dexter",
    "binary": "dexter",
    "check": "which dexter",
    "install_steps": [
      "pip install dexter",
      "Verify: dexter --version",
      "supercli plugins install ./plugins/dexter --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dexter",
      "resource": "self",
      "action": "version",
      "description": "Print dexter version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dexter",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dexter: pip install dexter"
      },
      "args": []
    },
    {
      "namespace": "dexter",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dexter CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dexter",
        "passthrough": true,
        "missingDependencyHelp": "Install dexter: pip install dexter"
      },
      "args": []
    }
  ]
}