{
  "name": "ssh-audit",
  "version": "0.1.0",
  "description": "SSH server security auditing and configuration review",
  "source": "https://github.com/javimosch/supercli",
  "checks": [{ "type": "binary", "name": "ssh-audit" }],
  "install_guidance": {
    "plugin": "ssh-audit",
    "binary": "ssh-audit",
    "check": "which ssh-audit",
    "install_steps": ["pip install ssh-audit", "which ssh-audit", "Verify: ssh-audit --version", "supercli plugins install ./plugins/ssh_audit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ssh-audit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ssh-audit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ssh-audit",
      "passthrough": true,
      "missingDependencyHelp": "Install ssh-audit: pip install ssh-audit"
    },
    "args": []
  }]
}
