{
  "name": "medium-unlocker",
  "version": "0.1.0",
  "description": "Medium Unlocker is an android app designed to access Medium articles without any paywalls. ",
  "source": "https://github.com/medium-unlocker/medium-unlocker",
  "checks": [
    {
      "type": "binary",
      "name": "medium-unlocker"
    }
  ],
  "install_guidance": {
    "plugin": "medium-unlocker",
    "binary": "medium-unlocker",
    "check": "which medium-unlocker",
    "install_steps": [
      "pip install medium-unlocker",
      "Verify: medium-unlocker --version",
      "supercli plugins install ./plugins/medium-unlocker --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "medium-unlocker",
      "resource": "self",
      "action": "version",
      "description": "Print medium-unlocker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "medium-unlocker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install medium-unlocker: pip install medium-unlocker"
      },
      "args": []
    },
    {
      "namespace": "medium-unlocker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to medium-unlocker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "medium-unlocker",
        "passthrough": true,
        "missingDependencyHelp": "Install medium-unlocker: pip install medium-unlocker"
      },
      "args": []
    }
  ]
}