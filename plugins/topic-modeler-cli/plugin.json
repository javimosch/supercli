{
  "name": "topic-modeler-cli",
  "version": "0.1.0",
  "description": "Simple topic modeling CLI tool using LDA and NMF",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "topic-modeler-cli" }],
  "install_guidance": {
    "plugin": "topic-modeler-cli",
    "binary": "topic-modeler-cli",
    "check": "which topic-modeler-cli",
    "install_steps": ["pip install topic-modeler-cli", "Verify: topic-modeler-cli --version", "supercli plugins install ./plugins/topic-modeler-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "topic-modeler-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to topic-modeler-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "topic-modeler-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install topic-modeler-cli: pip install topic-modeler-cli"
    },
    "args": []
  }]
}
