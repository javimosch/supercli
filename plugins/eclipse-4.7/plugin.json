{
  "name": "eclipse-4.7",
  "version": "0.1.0",
  "description": "CLI tool: eclipse-4.7",
  "source": "https://manpages.debian.org/eclipse-4.7",
  "checks": [
    {
      "type": "binary",
      "name": "eclipse-4.7"
    }
  ],
  "install_guidance": {
    "plugin": "eclipse-4.7",
    "binary": "eclipse-4.7",
    "check": "which eclipse-4.7",
    "install_steps": [
      "apt-get install eclipse-4.7 2>/dev/null || which eclipse-4.7",
      "Verify: eclipse-4.7 --version",
      "supercli plugins install ./plugins/eclipse-4.7 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "eclipse-4.7",
      "resource": "self",
      "action": "version",
      "description": "Print eclipse-4.7 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "eclipse-4.7",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install eclipse-4.7: apt-get install eclipse-4.7 2>/dev/null || which eclipse-4.7"
      },
      "args": []
    },
    {
      "namespace": "eclipse-4.7",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to eclipse-4.7 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "eclipse-4.7",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install eclipse-4.7: apt-get install eclipse-4.7 2>/dev/null || which eclipse-4.7"
      },
      "args": []
    }
  ]
}