{
  "name": "basis_universal",
  "version": "0.1.0",
  "description": "Basis Universal GPU texture codec command-line compression tool",
  "source": "https://github.com/BinomialLLC/basis_universal",
  "checks": [
    {
      "type": "binary",
      "name": "basis_universal"
    }
  ],
  "install_guidance": {
    "plugin": "basis_universal",
    "binary": "basis_universal",
    "check": "which basis_universal",
    "install_steps": [
      "brew install basis_universal",
      "Verify: basis_universal --version",
      "supercli plugins install ./plugins/basis_universal --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "basis_universal",
      "resource": "self",
      "action": "version",
      "description": "Print basis_universal version",
      "adapter": "process",
      "adapterConfig": {
        "command": "basis_universal",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install basis_universal: brew install basis_universal"
      },
      "args": []
    },
    {
      "namespace": "basis_universal",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to basis_universal CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "basis_universal",
        "passthrough": true,
        "missingDependencyHelp": "Install basis_universal"
      },
      "args": []
    }
  ]
}