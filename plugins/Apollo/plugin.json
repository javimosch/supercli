{
  "name": "Apollo",
  "version": "0.1.0",
  "description": "Sunshine fork - The easiest way to stream with the native resolution of your client device",
  "source": "https://github.com/Apollo/Apollo",
  "checks": [
    {
      "type": "binary",
      "name": "apollo"
    }
  ],
  "install_guidance": {
    "plugin": "Apollo",
    "binary": "apollo",
    "check": "which apollo",
    "install_steps": [
      "pip install apollo",
      "Verify: apollo --version",
      "supercli plugins install ./plugins/Apollo --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Apollo",
      "resource": "self",
      "action": "version",
      "description": "Print Apollo version",
      "adapter": "process",
      "adapterConfig": {
        "command": "apollo",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Apollo: pip install apollo"
      },
      "args": []
    },
    {
      "namespace": "Apollo",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to apollo CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "apollo",
        "passthrough": true,
        "missingDependencyHelp": "Install Apollo: pip install apollo"
      },
      "args": []
    }
  ]
}