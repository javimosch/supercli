{
  "name": "kbld",
  "version": "0.1.0",
  "description": "Kubernetes image build and resolution tool",
  "source": "https://github.com/carvel-dev/kbld",
  "checks": [{ "type": "binary", "name": "kbld" }],
  "install_guidance": {
    "plugin": "kbld",
    "binary": "kbld",
    "check": "which kbld",
    "install_steps": ["brew install kbld", "Verify: kbld --version", "supercli plugins install ./plugins/kbld --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kbld",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kbld CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kbld",
      "passthrough": true,
      "missingDependencyHelp": "Install kbld: brew install kbld"
    },
    "args": []
  }]
}
