{
  "name": "oji",
  "version": "0.1.0",
  "description": "oji \u2014 (\u25d5\u203f\u25d5) Text Emoticon Maker",
  "source": "https://github.com/xxczaki/oji",
  "checks": [
    {
      "type": "binary",
      "name": "oji"
    }
  ],
  "install_guidance": {
    "plugin": "oji",
    "binary": "oji",
    "check": "which oji",
    "install_steps": [
      "npm install -g oji",
      "Verify: oji --version",
      "supercli plugins install ./plugins/oji --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "oji",
      "resource": "self",
      "action": "version",
      "description": "Print oji version",
      "adapter": "process",
      "adapterConfig": {
        "command": "oji",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install oji: npm install -g oji"
      },
      "args": []
    },
    {
      "namespace": "oji",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to oji CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "oji",
        "passthrough": true,
        "missingDependencyHelp": "Install oji"
      },
      "args": []
    }
  ]
}