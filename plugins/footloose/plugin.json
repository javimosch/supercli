{
  "name": "footloose",
  "version": "0.1.0",
  "description": "Containers that look like Virtual Machines",
  "source": "https://github.com/weaveworks/footloose",
  "checks": [{ "type": "binary", "name": "footloose" }],
  "install_guidance": {
    "plugin": "footloose",
    "binary": "footloose",
    "check": "which footloose",
    "install_steps": ["brew install footloose", "Verify: footloose --version", "supercli plugins install ./plugins/footloose --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "footloose",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to footloose CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "footloose",
      "passthrough": true,
      "missingDependencyHelp": "Install footloose: brew install footloose"
    },
    "args": []
  }]
}
