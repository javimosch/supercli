{
  "name": "rust-script",
  "version": "0.1.0",
  "description": "rust-script \u2014 run Rust files and expressions as scripts.",
  "source": "https://github.com/fornwall/rust-script",
  "checks": [
    {
      "type": "binary",
      "name": "rust-script"
    }
  ],
  "install_guidance": {
    "plugin": "rust-script",
    "binary": "rust-script",
    "check": "which rust-script",
    "install_steps": [
      "cargo install rust-script",
      "supercli plugins install ./plugins/rust-script --on-conflict replace --json"
    ],
    "note": "Rust. Run Rust scripts."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rust-script",
      "resource": "script",
      "action": "run",
      "description": "Run a Rust script file",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-script",
        "missingDependencyHelp": "Install rust-script",
        "positionalArgs": [
          "file"
        ],
        "passthrough": true,
        "timeout_ms": 30000
      },
      "args": [
        {
          "name": "file",
          "type": "string",
          "required": true,
          "description": "file path"
        }
      ]
    },
    {
      "namespace": "rust-script",
      "resource": "self",
      "action": "version",
      "description": "Print version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rust-script",
        "missingDependencyHelp": "Install rust-script",
        "baseArgs": [
          "--version"
        ],
        "timeout_ms": 30000
      },
      "args": []
    }
  ]
}
