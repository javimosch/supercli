{
  "name": "matugen",
  "version": "0.1.0",
  "description": "A Material You and Base16 color scheme generator for the terminal. Creates harmonized color palettes for theming applications and terminal setups.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "matugen"
    }
  ],
  "install_guidance": {
    "plugin": "matugen",
    "binary": "matugen",
    "check": "which matugen",
    "install_steps": [
      "cargo install matugen",
      "Verify: matugen --version",
      "supercli plugins install ./plugins/matugen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "matugen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to matugen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "matugen",
        "passthrough": true,
        "missingDependencyHelp": "Install matugen: cargo install matugen"
      },
      "args": []
    }
  ]
}
