{
  "name": "gallery",
  "version": "0.1.0",
  "description": "A gallery that showcases on-device ML/GenAI use cases and allows people to try and use models locall",
  "source": "https://github.com/gallery/gallery",
  "checks": [
    {
      "type": "binary",
      "name": "gallery"
    }
  ],
  "install_guidance": {
    "plugin": "gallery",
    "binary": "gallery",
    "check": "which gallery",
    "install_steps": [
      "pip install gallery",
      "Verify: gallery --version",
      "supercli plugins install ./plugins/gallery --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gallery",
      "resource": "self",
      "action": "version",
      "description": "Print gallery version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gallery",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gallery: pip install gallery"
      },
      "args": []
    },
    {
      "namespace": "gallery",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gallery CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gallery",
        "passthrough": true,
        "missingDependencyHelp": "Install gallery: pip install gallery"
      },
      "args": []
    }
  ]
}