{
  "name": "ppmcie",
  "version": "0.1.0",
  "description": "CLI tool: ppmcie",
  "source": "https://manpages.debian.org/ppmcie",
  "checks": [
    {
      "type": "binary",
      "name": "ppmcie"
    }
  ],
  "install_guidance": {
    "plugin": "ppmcie",
    "binary": "ppmcie",
    "check": "which ppmcie",
    "install_steps": [
      "apt-get install ppmcie 2>/dev/null || which ppmcie",
      "Verify: ppmcie --version",
      "supercli plugins install ./plugins/ppmcie --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ppmcie",
      "resource": "self",
      "action": "version",
      "description": "Print ppmcie version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmcie",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ppmcie: apt-get install ppmcie 2>/dev/null || which ppmcie"
      },
      "args": []
    },
    {
      "namespace": "ppmcie",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ppmcie CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ppmcie",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ppmcie: apt-get install ppmcie 2>/dev/null || which ppmcie"
      },
      "args": []
    }
  ]
}