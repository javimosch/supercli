{
  "name": "pomodoro",
  "version": "0.1.0",
  "description": "ESP32-based focus timer with an epaper display and rotary dial",
  "source": "https://github.com/pomodoro/pomodoro",
  "checks": [
    {
      "type": "binary",
      "name": "pomodoro"
    }
  ],
  "install_guidance": {
    "plugin": "pomodoro",
    "binary": "pomodoro",
    "check": "which pomodoro",
    "install_steps": [
      "pip install pomodoro",
      "Verify: pomodoro --version",
      "supercli plugins install ./plugins/pomodoro --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pomodoro",
      "resource": "self",
      "action": "version",
      "description": "Print pomodoro version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pomodoro",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pomodoro: pip install pomodoro"
      },
      "args": []
    },
    {
      "namespace": "pomodoro",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pomodoro CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pomodoro",
        "passthrough": true,
        "missingDependencyHelp": "Install pomodoro: pip install pomodoro"
      },
      "args": []
    }
  ]
}