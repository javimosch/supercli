{
  "name": "patator",
  "version": "0.1.0",
  "description": "A multi-purpose brute-forcer with modular service support (FTP, SSH, HTTP, SMTP, etc.)",
  "source": "https://github.com/lanjelot/patator",
  "checks": [{ "type": "binary", "name": "patator" }],
  "install_guidance": {
    "plugin": "patator",
    "binary": "patator",
    "check": "which patator",
    "install_steps": [
      "pip install patator",
      "Or: pipx install patator",
      "Verify: patator --help",
      "supercli plugins install ./plugins/patator --on-conflict replace --json"
    ],
    "note": "Available via pip/pipx. Source: https://github.com/lanjelot/patator (3.3k+ stars). Written in Python."
  },
  "commands": [
    {
      "namespace": "patator", "resource": "self", "action": "version",
      "description": "Print patator version",
      "adapter": "process",
      "adapterConfig": { "command": "patator", "missingDependencyHelp": "Install patator: pip install patator", "baseArgs": ["--version"] },
      "args": []
    },
    {
      "namespace": "patator", "resource": "_", "action": "_",
      "description": "Passthrough to patator CLI",
      "adapter": "process",
      "adapterConfig": { "command": "patator", "missingDependencyHelp": "Install patator: pip install patator", "cwd": "invoke_cwd", "passthrough": true },
      "args": []
    }
  ]
}
