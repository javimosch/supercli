{
  "name": "era_check",
  "version": "0.1.0",
  "description": "CLI tool: era_check",
  "source": "https://manpages.debian.org/era_check",
  "checks": [
    {
      "type": "binary",
      "name": "era_check"
    }
  ],
  "install_guidance": {
    "plugin": "era_check",
    "binary": "era_check",
    "check": "which era_check",
    "install_steps": [
      "apt-get install era_check 2>/dev/null || which era_check",
      "Verify: era_check --version",
      "supercli plugins install ./plugins/era_check --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "era_check",
      "resource": "self",
      "action": "version",
      "description": "Print era_check version",
      "adapter": "process",
      "adapterConfig": {
        "command": "era_check",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install era_check: apt-get install era_check 2>/dev/null || which era_check"
      },
      "args": []
    },
    {
      "namespace": "era_check",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to era_check CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "era_check",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install era_check: apt-get install era_check 2>/dev/null || which era_check"
      },
      "args": []
    }
  ]
}