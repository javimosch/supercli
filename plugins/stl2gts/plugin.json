{
  "name": "stl2gts",
  "version": "0.1.0",
  "description": "CLI tool: stl2gts",
  "source": "https://manpages.debian.org/stl2gts",
  "checks": [
    {
      "type": "binary",
      "name": "stl2gts"
    }
  ],
  "install_guidance": {
    "plugin": "stl2gts",
    "binary": "stl2gts",
    "check": "which stl2gts",
    "install_steps": [
      "apt-get install stl2gts 2>/dev/null || which stl2gts",
      "Verify: stl2gts --version",
      "supercli plugins install ./plugins/stl2gts --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "stl2gts",
      "resource": "self",
      "action": "version",
      "description": "Print stl2gts version",
      "adapter": "process",
      "adapterConfig": {
        "command": "stl2gts",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install stl2gts: apt-get install stl2gts 2>/dev/null || which stl2gts"
      },
      "args": []
    },
    {
      "namespace": "stl2gts",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to stl2gts CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "stl2gts",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install stl2gts: apt-get install stl2gts 2>/dev/null || which stl2gts"
      },
      "args": []
    }
  ]
}