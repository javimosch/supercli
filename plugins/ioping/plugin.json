{
  "name": "ioping",
  "version": "0.1.0",
  "description": "Tool to monitor I/O latency in real time",
  "source": "https://github.com/koct9i/ioping",
  "checks": [
    {
      "type": "binary",
      "name": "ioping"
    }
  ],
  "install_guidance": {
    "plugin": "ioping",
    "binary": "ioping",
    "check": "which ioping",
    "install_steps": [
      "brew install ioping",
      "Verify: ioping --version",
      "supercli plugins install ./plugins/ioping --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ioping",
      "resource": "self",
      "action": "version",
      "description": "Print ioping version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ioping",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ioping: brew install ioping"
      },
      "args": []
    },
    {
      "namespace": "ioping",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ioping CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ioping",
        "passthrough": true,
        "missingDependencyHelp": "Install ioping"
      },
      "args": []
    }
  ]
}