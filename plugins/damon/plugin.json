{
  "name": "damon",
  "version": "0.1.0",
  "description": "Background process manager for running jobs in daemon mode",
  "source": "https://github.com/hashicorp/damon",
  "checks": [{ "type": "binary", "name": "damon" }],
  "install_guidance": {
    "plugin": "damon",
    "binary": "damon",
    "check": "which damon",
    "install_steps": ["brew install damon", "Verify: damon --version", "supercli plugins install ./plugins/damon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "damon",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to damon CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "damon",
      "passthrough": true,
      "missingDependencyHelp": "Install damon: brew install damon"
    },
    "args": []
  }]
}
