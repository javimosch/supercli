{
  "name": "3mux",
  "version": "0.1.0",
  "description": "Terminal multiplexer inspired by i3 window manager tiling",
  "source": "go",
  "checks": [{ "type": "binary", "name": "3mux" }],
  "install_guidance": {
    "plugin": "3mux",
    "binary": "3mux",
    "check": "which 3mux",
    "install_steps": ["go install github.com/3mux@latest", "Verify: 3mux --version", "supercli plugins install ./plugins/3mux --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "3mux",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to 3mux CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "3mux",
      "passthrough": true,
      "missingDependencyHelp": "Install 3mux: go install github.com/3mux@latest"
    },
    "args": []
  }]
}
