{
  "name": "cog",
  "version": "1.0.0",
  "description": "cog \u2014 Cog CLI config generator",
  "source": "github.com/replicate/cog",
  "checks": [
    {
      "type": "binary",
      "name": "cog"
    }
  ],
  "install_guidance": {
    "plugin": "cog",
    "binary": "cog",
    "check": "which cog",
    "install_steps": [
      "# Install cog",
      "# See github.com/replicate/cog",
      "# apt: sudo apt-get install cog",
      "# brew: brew install cog",
      "# cargo: cargo install cog",
      "# npm: npm install -g cog",
      "# pip: pip install cog"
    ]
  },
  "commands": [
    {
      "namespace": "cog",
      "resource": "cog",
      "action": "run",
      "description": "Run cog",
      "adapter": "process",
      "adapterConfig": {
        "command": "cog",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cog from github.com/replicate/cog"
      },
      "args": []
    }
  ]
}