{
  "name": "interface-design",
  "version": "0.1.0",
  "description": "Design engineering for Claude Code. Craft, memory, and enforcement for consistent UI.",
  "source": "https://github.com/interface-design/interface-design",
  "checks": [
    {
      "type": "binary",
      "name": "interface-design"
    }
  ],
  "install_guidance": {
    "plugin": "interface-design",
    "binary": "interface-design",
    "check": "which interface-design",
    "install_steps": [
      "pip install interface-design",
      "Verify: interface-design --version",
      "supercli plugins install ./plugins/interface-design --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "interface-design",
      "resource": "self",
      "action": "version",
      "description": "Print interface-design version",
      "adapter": "process",
      "adapterConfig": {
        "command": "interface-design",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install interface-design: pip install interface-design"
      },
      "args": []
    },
    {
      "namespace": "interface-design",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to interface-design CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "interface-design",
        "passthrough": true,
        "missingDependencyHelp": "Install interface-design: pip install interface-design"
      },
      "args": []
    }
  ]
}