{
  "name": "dorso",
  "version": "0.1.0",
  "description": "A macOS app that blurs your screen when you slouch.",
  "source": "https://github.com/dorso/dorso",
  "checks": [
    {
      "type": "binary",
      "name": "dorso"
    }
  ],
  "install_guidance": {
    "plugin": "dorso",
    "binary": "dorso",
    "check": "which dorso",
    "install_steps": [
      "pip install dorso",
      "Verify: dorso --version",
      "supercli plugins install ./plugins/dorso --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dorso",
      "resource": "self",
      "action": "version",
      "description": "Print dorso version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dorso",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dorso: pip install dorso"
      },
      "args": []
    },
    {
      "namespace": "dorso",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dorso CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dorso",
        "passthrough": true,
        "missingDependencyHelp": "Install dorso: pip install dorso"
      },
      "args": []
    }
  ]
}