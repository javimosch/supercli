{
  "name": "uuidparse",
  "version": "0.1.0",
  "description": "CLI tool: uuidparse",
  "source": "https://manpages.debian.org/uuidparse",
  "checks": [
    {
      "type": "binary",
      "name": "uuidparse"
    }
  ],
  "install_guidance": {
    "plugin": "uuidparse",
    "binary": "uuidparse",
    "check": "which uuidparse",
    "install_steps": [
      "apt-get install uuidparse 2>/dev/null || which uuidparse",
      "Verify: uuidparse --version",
      "supercli plugins install ./plugins/uuidparse --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "uuidparse",
      "resource": "self",
      "action": "version",
      "description": "Print uuidparse version",
      "adapter": "process",
      "adapterConfig": {
        "command": "uuidparse",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install uuidparse: apt-get install uuidparse 2>/dev/null || which uuidparse"
      },
      "args": []
    },
    {
      "namespace": "uuidparse",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to uuidparse CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "uuidparse",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install uuidparse: apt-get install uuidparse 2>/dev/null || which uuidparse"
      },
      "args": []
    }
  ]
}