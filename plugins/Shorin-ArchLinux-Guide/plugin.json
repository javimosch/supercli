{
  "name": "Shorin-ArchLinux-Guide",
  "version": "0.1.0",
  "description": "\u30102026\u6700\u9002\u5408\u65b0\u624b\u7684Arch Linux\u6559\u7a0b\u3011\u5177\u4f53\u5185\u5bb9\u5305\u62ec\uff1a\u7cfb\u7edf\u5b89\u88c5\u6559\u7a0b\u3001win+linux\u53cc\u7cfb\u7edf\u3001N\u5361\u9a71\u52a8\u3001\u684c\u9762\u73af\u5883\u3001\u4e2d\u6587\u8f93\u5165\u6cd5\u3001Linux\u73a9\u6e38\u620f\u3001\u5e38\u7528\u865a\u62df\u673a\u7a0b\u5e8f\u3001\u663e\u5361\u76f4\u901a\u3001\u5e72\u51c0\u5220\u9664linux\u7b49\u3002",
  "source": "https://github.com/Shorin-ArchLinux-Guide/Shorin-ArchLinux-Guide",
  "checks": [
    {
      "type": "binary",
      "name": "shorin-archlinux-guide"
    }
  ],
  "install_guidance": {
    "plugin": "Shorin-ArchLinux-Guide",
    "binary": "shorin-archlinux-guide",
    "check": "which shorin-archlinux-guide",
    "install_steps": [
      "pip install shorin-archlinux-guide",
      "Verify: shorin-archlinux-guide --version",
      "supercli plugins install ./plugins/Shorin-ArchLinux-Guide --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Shorin-ArchLinux-Guide",
      "resource": "self",
      "action": "version",
      "description": "Print Shorin-ArchLinux-Guide version",
      "adapter": "process",
      "adapterConfig": {
        "command": "shorin-archlinux-guide",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Shorin-ArchLinux-Guide: pip install shorin-archlinux-guide"
      },
      "args": []
    },
    {
      "namespace": "Shorin-ArchLinux-Guide",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to shorin-archlinux-guide CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "shorin-archlinux-guide",
        "passthrough": true,
        "missingDependencyHelp": "Install Shorin-ArchLinux-Guide: pip install shorin-archlinux-guide"
      },
      "args": []
    }
  ]
}