{
  "name": "go-kata",
  "version": "0.1.0",
  "description": "Daily coding challenges to master idiomatic Go through deliberate practice",
  "source": "https://github.com/MedUnes/go-kata",
  "checks": [
    {
      "type": "binary",
      "name": "go-kata"
    }
  ],
  "install_guidance": {
    "plugin": "go-kata",
    "binary": "go-kata",
    "check": "which go-kata",
    "install_steps": [
      "go install github.com/MedUnes/go-kata@latest",
      "Verify: go-kata --version",
      "supercli plugins install ./plugins/go-kata --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "go-kata",
    "resource": "self",
    "action": "version",
    "description": "Print go-kata version",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-kata",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install go-kata: go install github.com/MedUnes/go-kata@latest"
    },
    "args": []
  },
  {
    "namespace": "go-kata",
    "resource": "kata",
    "action": "list",
    "description": "List available Go katas",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-kata",
      "baseArgs": [
        "list"
      ],
      "passthrough": true,
      "missingDependencyHelp": "Install go-kata: go install github.com/MedUnes/go-kata@latest"
    },
    "args": []
  },
  {
    "namespace": "go-kata",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to go-kata CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "go-kata",
      "passthrough": true,
      "missingDependencyHelp": "Install go-kata"
    },
    "args": []
  }
]
}