{
  "name": "roff2text",
  "version": "0.1.0",
  "description": "CLI tool: roff2text",
  "source": "https://manpages.debian.org/roff2text",
  "checks": [
    {
      "type": "binary",
      "name": "roff2text"
    }
  ],
  "install_guidance": {
    "plugin": "roff2text",
    "binary": "roff2text",
    "check": "which roff2text",
    "install_steps": [
      "apt-get install roff2text 2>/dev/null || which roff2text",
      "Verify: roff2text --version",
      "supercli plugins install ./plugins/roff2text --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "roff2text",
      "resource": "self",
      "action": "version",
      "description": "Print roff2text version",
      "adapter": "process",
      "adapterConfig": {
        "command": "roff2text",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install roff2text: apt-get install roff2text 2>/dev/null || which roff2text"
      },
      "args": []
    },
    {
      "namespace": "roff2text",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to roff2text CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "roff2text",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install roff2text: apt-get install roff2text 2>/dev/null || which roff2text"
      },
      "args": []
    }
  ]
}