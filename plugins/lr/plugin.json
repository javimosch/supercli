{
  "name": "lr",
  "version": "0.1.0",
  "description": "File list utility with features from ls(1), find(1), stat(1), and du(1)",
  "source": "https://github.com/leahneukirchen/lr",
  "checks": [
    {
      "type": "binary",
      "name": "lr"
    }
  ],
  "install_guidance": {
    "plugin": "lr",
    "binary": "lr",
    "check": "which lr",
    "install_steps": [
      "brew install lr",
      "Verify: lr --version",
      "supercli plugins install ./plugins/lr --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "lr",
      "resource": "self",
      "action": "version",
      "description": "Print lr version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lr",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lr: brew install lr"
      },
      "args": []
    },
    {
      "namespace": "lr",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lr CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lr",
        "passthrough": true,
        "missingDependencyHelp": "Install lr"
      },
      "args": []
    }
  ]
}