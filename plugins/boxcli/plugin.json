{
  "name": "boxcli",
  "version": "0.1.0",
  "description": "CLI tool: boxcli",
  "source": "https://packages.debian.org/boxcli",
  "checks": [{ "type": "binary", "name": "boxcli" }],
  "install_guidance": {
    "plugin": "boxcli", "binary": "boxcli", "check": "which boxcli",
    "install_steps": ["apt-get install boxcli 2>/dev/null || which boxcli", "Verify: boxcli --version", "supercli plugins install ./plugins/boxcli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "boxcli", "resource": "_", "action": "_",
    "description": "Passthrough to boxcli CLI",
    "adapter": "process", "adapterConfig": { "command": "boxcli", "passthrough": true, "missingDependencyHelp": "Install boxcli: apt-get install boxcli" }, "args": []
  }]
}
