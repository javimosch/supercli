{
  "name": "boot",
  "version": "0.1.0",
  "description": "Clojure build tool",
  "source": "https://packages.debian.org/boot",
  "checks": [{ "type": "binary", "name": "boot" }],
  "install_guidance": {
    "plugin": "boot", "binary": "boot", "check": "which boot",
    "install_steps": ["apt-get install boot", "Verify: boot --version", "supercli plugins install ./plugins/boot --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "boot", "resource": "_", "action": "_",
    "description": "Passthrough to boot CLI",
    "adapter": "process", "adapterConfig": { "command": "boot", "passthrough": true, "missingDependencyHelp": "Install boot: apt-get install boot" }, "args": []
  }]
}
