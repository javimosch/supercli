{
  "name": "vcluster",
  "version": "0.1.0",
  "description": "Create fully functional virtual Kubernetes clusters",
  "source": "https://github.com/loft-sh/vcluster",
  "checks": [{ "type": "binary", "name": "vcluster" }],
  "install_guidance": {
    "plugin": "vcluster",
    "binary": "vcluster",
    "check": "which vcluster",
    "install_steps": ["brew install vcluster", "Verify: vcluster --version", "supercli plugins install ./plugins/vcluster --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "vcluster",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to vcluster CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "vcluster",
      "passthrough": true,
      "missingDependencyHelp": "Install vcluster: brew install vcluster"
    },
    "args": []
  }]
}
