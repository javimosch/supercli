{
  "plugin": "spa-json-dump",
  "binary": "spa-json-dump",
  "check": "which spa-json-dump",
  "install_steps": [
    "apt-get install spa-json-dump 2>/dev/null || which spa-json-dump",
    "Verify: spa-json-dump --version",
    "supercli plugins install ./plugins/spa-json-dump --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}