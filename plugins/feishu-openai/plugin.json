{
  "name": "feishu-openai",
  "version": "0.1.0",
  "description": "\ud83c\udf92 \u98de\u4e66  \u00d7\uff08GPT-4 + GPT-4V + DALL\u00b7E-3 + Whisper\uff09=  \u98de\u4e00\u822c\u7684\u5de5\u4f5c\u4f53\u9a8c  \ud83d\ude80 \u8bed\u97f3\u5bf9\u8bdd\u3001\u89d2\u8272\u626e\u6f14\u3001\u591a\u8bdd\u9898\u8ba8\u8bba\u3001\u56fe\u7247\u521b\u4f5c\u3001\u8868\u683c\u5206\u6790\u3001\u6587\u6863\u5bfc\u51fa \ud83d\ude80",
  "source": "https://github.com/feishu-openai/feishu-openai",
  "checks": [
    {
      "type": "binary",
      "name": "feishu-openai"
    }
  ],
  "install_guidance": {
    "plugin": "feishu-openai",
    "binary": "feishu-openai",
    "check": "which feishu-openai",
    "install_steps": [
      "pip install feishu-openai",
      "Verify: feishu-openai --version",
      "supercli plugins install ./plugins/feishu-openai --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "feishu-openai",
      "resource": "self",
      "action": "version",
      "description": "Print feishu-openai version",
      "adapter": "process",
      "adapterConfig": {
        "command": "feishu-openai",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install feishu-openai: pip install feishu-openai"
      },
      "args": []
    },
    {
      "namespace": "feishu-openai",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to feishu-openai CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "feishu-openai",
        "passthrough": true,
        "missingDependencyHelp": "Install feishu-openai: pip install feishu-openai"
      },
      "args": []
    }
  ]
}