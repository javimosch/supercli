{
  "name": "strix",
  "version": "0.1.0",
  "description": "Open-source AI hackers to find and fix your app\u2019s vulnerabilities.",
  "source": "https://github.com/strix/strix",
  "checks": [
    {
      "type": "binary",
      "name": "strix"
    }
  ],
  "install_guidance": {
    "plugin": "strix",
    "binary": "strix",
    "check": "which strix",
    "install_steps": [
      "pip install strix",
      "Verify: strix --version",
      "supercli plugins install ./plugins/strix --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "strix",
      "resource": "self",
      "action": "version",
      "description": "Print strix version",
      "adapter": "process",
      "adapterConfig": {
        "command": "strix",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install strix: pip install strix"
      },
      "args": []
    },
    {
      "namespace": "strix",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to strix CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "strix",
        "passthrough": true,
        "missingDependencyHelp": "Install strix: pip install strix"
      },
      "args": []
    }
  ]
}