{
  "name": "strix",
  "version": "0.1.0",
  "description": "Open-source AI hackers framework for app security testing",
  "source": "https://github.com/usestrix/strix",
  "checks": [
    {
      "type": "binary",
      "name": "strix"
    }
  ],
  "install_guidance": {
    "plugin": "strix",
    "binary": "strix",
    "check": "which strix",
    "install_steps": [
      "pip install strix",
      "Verify: strix --version",
      "supercli plugins install ./plugins/strix --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "strix",
    "resource": "self",
    "action": "version",
    "description": "Print strix version",
    "adapter": "process",
    "adapterConfig": {
      "command": "strix",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install strix: pip install strix"
    },
    "args": []
  },
  {
    "namespace": "strix",
    "resource": "scan",
    "action": "run",
    "description": "Run a security scan",
    "adapter": "process",
    "adapterConfig": {
      "command": "strix",
      "passthrough": true,
      "missingDependencyHelp": "Install strix: pip install strix"
    },
    "args": []
  },
  {
    "namespace": "strix",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to strix CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "strix",
      "passthrough": true,
      "missingDependencyHelp": "Install strix"
    },
    "args": []
  }
]
}