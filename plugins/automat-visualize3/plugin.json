{
  "name": "automat-visualize3",
  "version": "0.1.0",
  "description": "automat-visualize3 — Self-service finite-state machines for the programmer on the go",
  "source": "https://pypi.python.org/pypi/Automat",
  "checks": [{ "type": "binary", "name": "automat-visualize3" }],
  "install_guidance": {
    "plugin": "automat-visualize3", "binary": "automat-visualize3", "check": "which automat-visualize3",
    "install_steps": ["apt-get install python3-automat 2>/dev/null || which automat-visualize3", "Verify: automat-visualize3 --version", "supercli plugins install ./plugins/automat-visualize3 --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "automat-visualize3", "resource": "_", "action": "_",
    "description": "Passthrough to automat-visualize3 CLI",
    "adapter": "process", "adapterConfig": { "command": "automat-visualize3", "passthrough": true, "missingDependencyHelp": "Install automat-visualize3: apt-get install python3-automat" }, "args": []
  }]
}
