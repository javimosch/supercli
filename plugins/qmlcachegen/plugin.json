{
  "name": "qmlcachegen",
  "version": "0.1.0",
  "description": "CLI tool: qmlcachegen",
  "source": "https://manpages.debian.org/qmlcachegen",
  "checks": [
    {
      "type": "binary",
      "name": "qmlcachegen"
    }
  ],
  "install_guidance": {
    "plugin": "qmlcachegen",
    "binary": "qmlcachegen",
    "check": "which qmlcachegen",
    "install_steps": [
      "apt-get install qmlcachegen 2>/dev/null || which qmlcachegen",
      "Verify: qmlcachegen --version",
      "supercli plugins install ./plugins/qmlcachegen --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "qmlcachegen",
      "resource": "self",
      "action": "version",
      "description": "Print qmlcachegen version",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlcachegen",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install qmlcachegen: apt-get install qmlcachegen 2>/dev/null || which qmlcachegen"
      },
      "args": []
    },
    {
      "namespace": "qmlcachegen",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to qmlcachegen CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "qmlcachegen",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install qmlcachegen: apt-get install qmlcachegen 2>/dev/null || which qmlcachegen"
      },
      "args": []
    }
  ]
}