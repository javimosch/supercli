{
  "name": "zenc",
  "version": "0.1.0",
  "description": "Write like a high-level language, run like C.",
  "source": "https://github.com/zenc/zenc",
  "checks": [
    {
      "type": "binary",
      "name": "zenc"
    }
  ],
  "install_guidance": {
    "plugin": "zenc",
    "binary": "zenc",
    "check": "which zenc",
    "install_steps": [
      "pip install zenc",
      "Verify: zenc --version",
      "supercli plugins install ./plugins/zenc --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zenc",
      "resource": "self",
      "action": "version",
      "description": "Print zenc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zenc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zenc: pip install zenc"
      },
      "args": []
    },
    {
      "namespace": "zenc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zenc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zenc",
        "passthrough": true,
        "missingDependencyHelp": "Install zenc: pip install zenc"
      },
      "args": []
    }
  ]
}