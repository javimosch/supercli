{
  "name": "bwm-ng",
  "version": "1.0.0",
  "description": "bwm-ng \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=bwm-ng+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "bwm-ng"
    }
  ],
  "install_guidance": {
    "plugin": "bwm-ng",
    "binary": "bwm-ng",
    "check": "which bwm-ng",
    "install_steps": [
      "Install bwm-ng via package manager: apt install bwm-ng or brew install bwm-ng"
    ]
  },
  "commands": [
    {
      "namespace": "bwmng",
      "resource": "run",
      "action": "exec",
      "description": "bwm-ng \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "bwm-ng",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install bwm-ng via your package manager"
      },
      "args": []
    }
  ]
}