{
  "name": "dee-timer",
  "version": "0.1.0",
  "description": "Pomodoro and time tracker from the CLI with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-timer" }],
  "install_guidance": {
    "plugin": "dee-timer",
    "binary": "dee-timer",
    "check": "which dee-timer",
    "install_steps": ["cargo install dee-timer", "Verify: dee-timer --version", "supercli plugins install ./plugins/dee-timer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-timer",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-timer CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-timer",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-timer: cargo install dee-timer"
    },
    "args": []
  }]
}
