{
  "plugin": "sick-memory",
  "binary": "sick-memory",
  "check": "sick-memory --version",
  "install_steps": [
    "cd ~/ai/sick-memory",
    "go build -o sick-memory .",
    "sudo cp sick-memory /usr/local/bin/",
    "sudo ln -sf /usr/local/bin/sick-memory /usr/local/bin/sm",
    "Verify: sick-memory --version",
    "Verify: sm --version",
    "supercli plugins install ./plugins/sick-memory --on-conflict replace --json"
  ],
  "note": "The sm command provides a convenient shorthand for sick-memory. Both commands work identically."
}