{
  "name": "ctemplate",
  "version": "0.1.0",
  "description": "Template language for C++",
  "source": "https://github.com/olafvdspek/ctemplate",
  "checks": [
    {
      "type": "binary",
      "name": "ctemplate"
    }
  ],
  "install_guidance": {
    "plugin": "ctemplate",
    "binary": "ctemplate",
    "check": "which ctemplate",
    "install_steps": [
      "brew install ctemplate",
      "Verify: ctemplate --version",
      "supercli plugins install ./plugins/ctemplate --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ctemplate",
      "resource": "self",
      "action": "version",
      "description": "Print ctemplate version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ctemplate",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ctemplate: brew install ctemplate"
      },
      "args": []
    },
    {
      "namespace": "ctemplate",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ctemplate CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ctemplate",
        "passthrough": true,
        "missingDependencyHelp": "Install ctemplate"
      },
      "args": []
    }
  ]
}