{
  "name": "forbidden",
  "version": "0.1.0",
  "description": "Bypass 4xx HTTP response status codes and more",
  "source": "https://github.com/ivan-sincek/forbidden",
  "checks": [
    {
      "type": "binary",
      "name": "forbidden"
    }
  ],
  "install_guidance": {
    "plugin": "forbidden",
    "binary": "forbidden",
    "check": "which forbidden",
    "install_steps": [
      "brew install forbidden",
      "Verify: forbidden --version",
      "supercli plugins install ./plugins/forbidden --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "forbidden",
      "resource": "self",
      "action": "version",
      "description": "Print forbidden version",
      "adapter": "process",
      "adapterConfig": {
        "command": "forbidden",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install forbidden: brew install forbidden"
      },
      "args": []
    },
    {
      "namespace": "forbidden",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to forbidden CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "forbidden",
        "passthrough": true,
        "missingDependencyHelp": "Install forbidden"
      },
      "args": []
    }
  ]
}