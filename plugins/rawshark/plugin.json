{
  "name": "rawshark",
  "version": "0.1.0",
  "description": "Raw packet filtering tool",
  "source": "https://packages.debian.org/rawshark",
  "checks": [{ "type": "binary", "name": "rawshark" }],
  "install_guidance": {
    "plugin": "rawshark", "binary": "rawshark", "check": "which rawshark",
    "install_steps": ["apt-get install wireshark-common", "Verify: rawshark --version", "supercli plugins install ./plugins/rawshark --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "rawshark", "resource": "_", "action": "_",
    "description": "Passthrough to rawshark CLI",
    "adapter": "process", "adapterConfig": { "command": "rawshark", "passthrough": true, "missingDependencyHelp": "Install rawshark: apt-get install wireshark-common" }, "args": []
  }]
}
