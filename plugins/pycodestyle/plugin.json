{
  "name": "pycodestyle",
  "version": "0.1.0",
  "description": "CLI tool: pycodestyle",
  "source": "https://manpages.debian.org/pycodestyle",
  "checks": [
    {
      "type": "binary",
      "name": "pycodestyle"
    }
  ],
  "install_guidance": {
    "plugin": "pycodestyle",
    "binary": "pycodestyle",
    "check": "which pycodestyle",
    "install_steps": [
      "apt-get install pycodestyle 2>/dev/null || which pycodestyle",
      "Verify: pycodestyle --version",
      "supercli plugins install ./plugins/pycodestyle --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pycodestyle",
      "resource": "self",
      "action": "version",
      "description": "Print pycodestyle version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pycodestyle",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pycodestyle: apt-get install pycodestyle 2>/dev/null || which pycodestyle"
      },
      "args": []
    },
    {
      "namespace": "pycodestyle",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pycodestyle CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pycodestyle",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pycodestyle: apt-get install pycodestyle 2>/dev/null || which pycodestyle"
      },
      "args": []
    }
  ]
}