{
  "name": "scour",
  "version": "0.1.0",
  "description": "SVG optimizer and cleaner",
  "source": "https://github.com/scour-project/scour",
  "checks": [
    {
      "type": "binary",
      "name": "scour"
    }
  ],
  "install_guidance": {
    "plugin": "scour",
    "binary": "scour",
    "check": "which scour",
    "install_steps": [
      "pip install scour",
      "Verify: scour --version",
      "supercli plugins install ./plugins/scour --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "scour",
      "resource": "self",
      "action": "version",
      "description": "Print scour version",
      "adapter": "process",
      "adapterConfig": {
        "command": "scour",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install scour: pip install scour"
      },
      "args": []
    },
    {
      "namespace": "scour",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to scour CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "scour",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install scour: pip install scour"
      },
      "args": []
    }
  ]
}
