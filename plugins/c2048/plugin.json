{
  "name": "c2048",
  "version": "0.1.0",
  "description": "Console version of 2048",
  "source": "https://github.com/mevdschee/2048.c",
  "checks": [
    {
      "type": "binary",
      "name": "c2048"
    }
  ],
  "install_guidance": {
    "plugin": "c2048",
    "binary": "c2048",
    "check": "which c2048",
    "install_steps": [
      "brew install c2048",
      "Verify: c2048 --version",
      "supercli plugins install ./plugins/c2048 --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "c2048",
      "resource": "self",
      "action": "version",
      "description": "Print c2048 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "c2048",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install c2048: brew install c2048"
      },
      "args": []
    },
    {
      "namespace": "c2048",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to c2048 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "c2048",
        "passthrough": true,
        "missingDependencyHelp": "Install c2048"
      },
      "args": []
    }
  ]
}