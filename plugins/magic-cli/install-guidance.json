{
  "plugin": "magic-cli",
  "binary": "magic-cli",
  "check": "which magic-cli",
  "install_steps": [
    "curl -LsSf https://github.com/guywaldman/magic-cli/releases/download/0.0.6/magic-cli-installer.sh | sh",
    "Verify: magic-cli --version",
    "supercli plugins install ./plugins/magic-cli --on-conflict replace --json"
  ],
  "note": "No auth required. CLI-only tool."
}
