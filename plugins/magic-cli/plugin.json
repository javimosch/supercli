{
  "name": "magic-cli",
  "version": "0.1.0",
  "description": "Terminal Magic",
  "source": "https://github.com/guywaldman/magic-cli",
  "checks": [
    { "type": "binary", "name": "magic-cli" }
  ],
  "install_guidance": {
    "plugin": "magic-cli",
    "binary": "magic-cli",
    "check": "which magic-cli",
    "install_steps": [
      "curl -LsSf https://github.com/guywaldman/magic-cli/releases/download/0.0.6/magic-cli-installer.sh | sh",
      "Verify: magic-cli --version",
      "supercli plugins install ./plugins/magic-cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "magic-cli",
      "resource": "self",
      "action": "version",
      "description": "Print magic-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "magic-cli",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install magic-cli: curl -LsSf https://github.com/guywaldman/magic-cli/releases/download/0.0.6/magic-cli-installer.sh | sh"
      },
      "args": []
    },
    {
      "namespace": "magic-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to magic-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "magic-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install magic-cli"
      },
      "args": []
    }
  ]
}
