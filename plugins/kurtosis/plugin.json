{
  "name": "kurtosis",
  "version": "0.1.0",
  "description": "Distributed system testing platform on Docker",
  "source": "https://github.com/kurtosis-tech/kurtosis",
  "checks": [{ "type": "binary", "name": "kurtosis" }],
  "install_guidance": {
    "plugin": "kurtosis",
    "binary": "kurtosis",
    "check": "which kurtosis",
    "install_steps": ["brew install kurtosis-tech/tap/kurtosis-cli", "Verify: kurtosis --version", "supercli plugins install ./plugins/kurtosis --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "kurtosis",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to kurtosis CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "kurtosis",
      "passthrough": true,
      "missingDependencyHelp": "Install kurtosis: brew install kurtosis-tech/tap/kurtosis-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
