{
  "name": "homesick",
  "version": "0.1.0",
  "description": "Your home directory is your castle for dotfiles",
  "source": "https://github.com/technicalpickles/homesick",
  "checks": [{ "type": "binary", "name": "homesick" }],
  "install_guidance": {
    "plugin": "homesick",
    "binary": "homesick",
    "check": "which homesick",
    "install_steps": ["gem install homesick", "Verify: homesick --version", "supercli plugins install ./plugins/homesick --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "homesick",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to homesick CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "homesick",
      "passthrough": true,
      "missingDependencyHelp": "Install homesick: gem install homesick", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
