{
  "name": "getcli",
  "version": "0.1.0",
  "description": "CLI package manager and bootstrap layer for AI coding agents",
  "source": "https://github.com/theagentservice/getcli",
  "checks": [
    {
      "type": "binary",
      "name": "getcli"
    }
  ],
  "install_guidance": {
    "plugin": "getcli",
    "binary": "getcli",
    "check": "which getcli",
    "install_steps": [
      "cargo install getcli",
      "Verify: getcli --version",
      "supercli plugins install ./plugins/getcli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "getcli",
      "resource": "self",
      "action": "version",
      "description": "Print getcli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "getcli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install getcli: cargo install getcli"
      },
      "args": []
    },
    {
      "namespace": "getcli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to getcli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "getcli",
        "passthrough": true,
        "missingDependencyHelp": "Install getcli: cargo install getcli"
      },
      "args": []
    }
  ]
}
