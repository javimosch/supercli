{
  "name": "cotila",
  "version": "0.1.0",
  "description": "Compile-time linear algebra system for C++",
  "source": "https://github.com/calebzulawski/cotila",
  "checks": [
    {
      "type": "binary",
      "name": "cotila"
    }
  ],
  "install_guidance": {
    "plugin": "cotila",
    "binary": "cotila",
    "check": "which cotila",
    "install_steps": [
      "brew install cotila",
      "Verify: cotila --version",
      "supercli plugins install ./plugins/cotila --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "cotila",
      "resource": "self",
      "action": "version",
      "description": "Print cotila version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cotila",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cotila: brew install cotila"
      },
      "args": []
    },
    {
      "namespace": "cotila",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cotila CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cotila",
        "passthrough": true,
        "missingDependencyHelp": "Install cotila"
      },
      "args": []
    }
  ]
}