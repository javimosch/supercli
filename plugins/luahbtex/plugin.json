{
  "name": "luahbtex",
  "version": "0.1.0",
  "description": "CLI tool: luahbtex",
  "source": "https://manpages.debian.org/luahbtex",
  "checks": [
    {
      "type": "binary",
      "name": "luahbtex"
    }
  ],
  "install_guidance": {
    "plugin": "luahbtex",
    "binary": "luahbtex",
    "check": "which luahbtex",
    "install_steps": [
      "apt-get install luahbtex 2>/dev/null || which luahbtex",
      "Verify: luahbtex --version",
      "supercli plugins install ./plugins/luahbtex --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "luahbtex",
      "resource": "self",
      "action": "version",
      "description": "Print luahbtex version",
      "adapter": "process",
      "adapterConfig": {
        "command": "luahbtex",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install luahbtex: apt-get install luahbtex 2>/dev/null || which luahbtex"
      },
      "args": []
    },
    {
      "namespace": "luahbtex",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to luahbtex CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "luahbtex",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install luahbtex: apt-get install luahbtex 2>/dev/null || which luahbtex"
      },
      "args": []
    }
  ]
}