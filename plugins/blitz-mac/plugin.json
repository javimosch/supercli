{
  "name": "blitz-mac",
  "version": "0.1.0",
  "description": "Native macOS App Store Connect tool with MCP. Submit iOS apps to App Store with AI agents ",
  "source": "https://github.com/blitz-mac/blitz-mac",
  "checks": [
    {
      "type": "binary",
      "name": "blitz-mac"
    }
  ],
  "install_guidance": {
    "plugin": "blitz-mac",
    "binary": "blitz-mac",
    "check": "which blitz-mac",
    "install_steps": [
      "pip install blitz-mac",
      "Verify: blitz-mac --version",
      "supercli plugins install ./plugins/blitz-mac --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "blitz-mac",
      "resource": "self",
      "action": "version",
      "description": "Print blitz-mac version",
      "adapter": "process",
      "adapterConfig": {
        "command": "blitz-mac",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install blitz-mac: pip install blitz-mac"
      },
      "args": []
    },
    {
      "namespace": "blitz-mac",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to blitz-mac CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "blitz-mac",
        "passthrough": true,
        "missingDependencyHelp": "Install blitz-mac: pip install blitz-mac"
      },
      "args": []
    }
  ]
}