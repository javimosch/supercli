{
  "name": "checkmake",
  "version": "0.1.0",
  "description": "Makefile linter for CI pipelines",
  "source": "https://github.com/mrtnvgr/checkmake",
  "checks": [
    {
      "type": "binary",
      "name": "checkmake"
    }
  ],
  "install_guidance": {
    "plugin": "checkmake",
    "binary": "checkmake",
    "check": "which checkmake",
    "install_steps": [
      "cargo install checkmake",
      "Verify: checkmake --version",
      "supercli plugins install ./plugins/checkmake --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "checkmake",
      "resource": "self",
      "action": "version",
      "description": "Print checkmake version",
      "adapter": "process",
      "adapterConfig": {
        "command": "checkmake",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install checkmake: cargo install checkmake"
      },
      "args": []
    },
    {
      "namespace": "checkmake",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to checkmake CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "checkmake",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install checkmake: cargo install checkmake"
      },
      "args": []
    }
  ]
}
