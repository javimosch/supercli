{
  "name": "ctapi",
  "version": "0.1.0",
  "description": "CLI tool: ctapi",
  "source": "https://packages.debian.org/ctapi",
  "checks": [{ "type": "binary", "name": "ctapi" }],
  "install_guidance": {
    "plugin": "ctapi", "binary": "ctapi", "check": "which ctapi",
    "install_steps": ["apt-get install ctapi 2>/dev/null || which ctapi", "Verify: ctapi --version", "supercli plugins install ./plugins/ctapi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ctapi", "resource": "_", "action": "_",
    "description": "Passthrough to ctapi CLI",
    "adapter": "process", "adapterConfig": { "command": "ctapi", "passthrough": true, "missingDependencyHelp": "Install ctapi: apt-get install ctapi" }, "args": []
  }]
}
