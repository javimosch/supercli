{
  "name": "is-fast",
  "version": "0.1.0",
  "description": "Check the internet as fast as possible",
  "source": "https://github.com/Magic-JD/is-fast",
  "checks": [
    {
      "type": "binary",
      "name": "is-fast"
    }
  ],
  "install_guidance": {
    "plugin": "is-fast",
    "binary": "is-fast",
    "check": "which is-fast",
    "install_steps": [
      "brew install is-fast",
      "Verify: is-fast --version",
      "supercli plugins install ./plugins/is-fast --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "is-fast",
      "resource": "self",
      "action": "version",
      "description": "Print is-fast version",
      "adapter": "process",
      "adapterConfig": {
        "command": "is-fast",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install is-fast: brew install is-fast"
      },
      "args": []
    },
    {
      "namespace": "is-fast",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to is-fast CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "is-fast",
        "passthrough": true,
        "missingDependencyHelp": "Install is-fast"
      },
      "args": []
    }
  ]
}