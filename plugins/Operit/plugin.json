{
  "name": "Operit",
  "version": "0.1.0",
  "description": "The most powerful AI agent and AI chat software on Android/Operit\u662f\u4e00\u6b3eAndroid\u4e0a\u80fd\u529b\u6700\u4e3a\u5f3a\u5927\u3001\u53d1\u5c55\u6700\u4e45\u7684AI Agent",
  "source": "https://github.com/Operit/Operit",
  "checks": [
    {
      "type": "binary",
      "name": "operit"
    }
  ],
  "install_guidance": {
    "plugin": "Operit",
    "binary": "operit",
    "check": "which operit",
    "install_steps": [
      "pip install operit",
      "Verify: operit --version",
      "supercli plugins install ./plugins/Operit --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Operit",
      "resource": "self",
      "action": "version",
      "description": "Print Operit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "operit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Operit: pip install operit"
      },
      "args": []
    },
    {
      "namespace": "Operit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to operit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "operit",
        "passthrough": true,
        "missingDependencyHelp": "Install Operit: pip install operit"
      },
      "args": []
    }
  ]
}