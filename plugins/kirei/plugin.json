{
  "name": "kirei",
  "version": "0.1.0",
  "description": "\ud83c\udf38 The prettiest keyboard software",
  "source": "https://github.com/kirei/kirei",
  "checks": [
    {
      "type": "binary",
      "name": "kirei"
    }
  ],
  "install_guidance": {
    "plugin": "kirei",
    "binary": "kirei",
    "check": "which kirei",
    "install_steps": [
      "pip install kirei",
      "Verify: kirei --version",
      "supercli plugins install ./plugins/kirei --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "kirei",
      "resource": "self",
      "action": "version",
      "description": "Print kirei version",
      "adapter": "process",
      "adapterConfig": {
        "command": "kirei",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install kirei: pip install kirei"
      },
      "args": []
    },
    {
      "namespace": "kirei",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to kirei CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "kirei",
        "passthrough": true,
        "missingDependencyHelp": "Install kirei: pip install kirei"
      },
      "args": []
    }
  ]
}