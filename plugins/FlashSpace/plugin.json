{
  "name": "FlashSpace",
  "version": "0.1.0",
  "description": "FlashSpace is a blazingly fast virtual workspace manager for macOS \u26a1",
  "source": "https://github.com/FlashSpace/FlashSpace",
  "checks": [
    {
      "type": "binary",
      "name": "flashspace"
    }
  ],
  "install_guidance": {
    "plugin": "FlashSpace",
    "binary": "flashspace",
    "check": "which flashspace",
    "install_steps": [
      "pip install flashspace",
      "Verify: flashspace --version",
      "supercli plugins install ./plugins/FlashSpace --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "FlashSpace",
      "resource": "self",
      "action": "version",
      "description": "Print FlashSpace version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flashspace",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install FlashSpace: pip install flashspace"
      },
      "args": []
    },
    {
      "namespace": "FlashSpace",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flashspace CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flashspace",
        "passthrough": true,
        "missingDependencyHelp": "Install FlashSpace: pip install flashspace"
      },
      "args": []
    }
  ]
}