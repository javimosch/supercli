{
  "name": "gau",
  "version": "1.0.0",
  "description": "gau \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=gau+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "gau"
    }
  ],
  "install_guidance": {
    "plugin": "gau",
    "binary": "gau",
    "check": "which gau",
    "install_steps": [
      "Install gau via package manager: apt install gau or brew install gau"
    ]
  },
  "commands": [
    {
      "namespace": "gau",
      "resource": "run",
      "action": "exec",
      "description": "gau \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "gau",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install gau via your package manager"
      },
      "args": []
    }
  ]
}