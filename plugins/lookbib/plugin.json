{
  "name": "lookbib",
  "version": "0.1.0",
  "description": "CLI tool: lookbib",
  "source": "https://manpages.debian.org/lookbib",
  "checks": [
    {
      "type": "binary",
      "name": "lookbib"
    }
  ],
  "install_guidance": {
    "plugin": "lookbib",
    "binary": "lookbib",
    "check": "which lookbib",
    "install_steps": [
      "apt-get install lookbib 2>/dev/null || which lookbib",
      "Verify: lookbib --version",
      "supercli plugins install ./plugins/lookbib --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lookbib",
      "resource": "self",
      "action": "version",
      "description": "Print lookbib version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lookbib",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lookbib: apt-get install lookbib 2>/dev/null || which lookbib"
      },
      "args": []
    },
    {
      "namespace": "lookbib",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lookbib CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lookbib",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lookbib: apt-get install lookbib 2>/dev/null || which lookbib"
      },
      "args": []
    }
  ]
}