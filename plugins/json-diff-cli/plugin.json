{
  "name": "json-diff-cli",
  "version": "0.1.0",
  "description": "Small tool for visual structural diffing of JSON objects",
  "source": "https://github.com/avajs/json-diff",
  "checks": [{ "type": "binary", "name": "json-diff-cli" }],
  "install_guidance": {
    "plugin": "json-diff-cli",
    "binary": "json-diff-cli",
    "check": "which json-diff-cli",
    "install_steps": ["npm install -g json-diff-cli", "Verify: json-diff-cli --version", "supercli plugins install ./plugins/json-diff-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "json-diff-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to json-diff-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "json-diff-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install json-diff-cli: npm install -g json-diff-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
