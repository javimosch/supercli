{
  "name": "gcov-tool-8",
  "version": "0.1.0",
  "description": "CLI tool: gcov-tool-8",
  "source": "https://manpages.debian.org/gcov-tool-8",
  "checks": [
    {
      "type": "binary",
      "name": "gcov-tool-8"
    }
  ],
  "install_guidance": {
    "plugin": "gcov-tool-8",
    "binary": "gcov-tool-8",
    "check": "which gcov-tool-8",
    "install_steps": [
      "apt-get install gcov-tool-8 2>/dev/null || which gcov-tool-8",
      "Verify: gcov-tool-8 --version",
      "supercli plugins install ./plugins/gcov-tool-8 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gcov-tool-8",
      "resource": "self",
      "action": "version",
      "description": "Print gcov-tool-8 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcov-tool-8",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gcov-tool-8: apt-get install gcov-tool-8 2>/dev/null || which gcov-tool-8"
      },
      "args": []
    },
    {
      "namespace": "gcov-tool-8",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gcov-tool-8 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gcov-tool-8",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gcov-tool-8: apt-get install gcov-tool-8 2>/dev/null || which gcov-tool-8"
      },
      "args": []
    }
  ]
}