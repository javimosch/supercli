{
  "name": "fastd",
  "version": "0.1.0",
  "description": "Fast and Secure Tunnelling Daemon",
  "source": "https://github.com/neocturne/fastd",
  "checks": [
    {
      "type": "binary",
      "name": "fastd"
    }
  ],
  "install_guidance": {
    "plugin": "fastd",
    "binary": "fastd",
    "check": "which fastd",
    "install_steps": [
      "brew install fastd",
      "Verify: fastd --version",
      "supercli plugins install ./plugins/fastd --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fastd",
      "resource": "self",
      "action": "version",
      "description": "Print fastd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastd: brew install fastd"
      },
      "args": []
    },
    {
      "namespace": "fastd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastd",
        "passthrough": true,
        "missingDependencyHelp": "Install fastd"
      },
      "args": []
    }
  ]
}