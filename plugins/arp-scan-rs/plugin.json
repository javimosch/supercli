{
  "name": "arp-scan-rs",
  "version": "0.1.0",
  "description": "ARP scan tool written in Rust for fast local network scans",
  "source": "https://github.com/kongbytes/arp-scan-rs",
  "checks": [
    {
      "type": "binary",
      "name": "arp-scan-rs"
    }
  ],
  "install_guidance": {
    "plugin": "arp-scan-rs",
    "binary": "arp-scan-rs",
    "check": "which arp-scan-rs",
    "install_steps": [
      "brew install arp-scan-rs",
      "Verify: arp-scan-rs --version",
      "supercli plugins install ./plugins/arp-scan-rs --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "arp-scan-rs",
      "resource": "self",
      "action": "version",
      "description": "Print arp-scan-rs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "arp-scan-rs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install arp-scan-rs: brew install arp-scan-rs"
      },
      "args": []
    },
    {
      "namespace": "arp-scan-rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to arp-scan-rs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "arp-scan-rs",
        "passthrough": true,
        "missingDependencyHelp": "Install arp-scan-rs"
      },
      "args": []
    }
  ]
}