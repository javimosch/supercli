{
  "name": "lzma",
  "version": "0.1.0",
  "description": "CLI tool: lzma",
  "source": "https://manpages.debian.org/lzma",
  "checks": [
    {
      "type": "binary",
      "name": "lzma"
    }
  ],
  "install_guidance": {
    "plugin": "lzma",
    "binary": "lzma",
    "check": "which lzma",
    "install_steps": [
      "apt-get install lzma 2>/dev/null || which lzma",
      "Verify: lzma --version",
      "supercli plugins install ./plugins/lzma --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "lzma",
      "resource": "self",
      "action": "version",
      "description": "Print lzma version",
      "adapter": "process",
      "adapterConfig": {
        "command": "lzma",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install lzma: apt-get install lzma 2>/dev/null || which lzma"
      },
      "args": []
    },
    {
      "namespace": "lzma",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to lzma CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "lzma",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install lzma: apt-get install lzma 2>/dev/null || which lzma"
      },
      "args": []
    }
  ]
}