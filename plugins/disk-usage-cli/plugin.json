{
  "name": "disk-usage-cli",
  "version": "0.1.0",
  "description": "Quick disk usage statistics from the command line",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "disk-usage-cli" }],
  "install_guidance": {
    "plugin": "disk-usage-cli",
    "binary": "disk-usage-cli",
    "check": "which disk-usage-cli",
    "install_steps": ["npm install -g disk-usage-cli", "Verify: disk-usage-cli --version", "supercli plugins install ./plugins/disk-usage-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "disk-usage-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to disk-usage-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "disk-usage-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install disk-usage-cli: npm install -g disk-usage-cli"
    },
    "args": []
  }]
}
