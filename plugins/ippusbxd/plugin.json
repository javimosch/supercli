{
  "name": "ippusbxd",
  "version": "0.1.0",
  "description": "CLI tool: ippusbxd",
  "source": "https://manpages.debian.org/ippusbxd",
  "checks": [
    {
      "type": "binary",
      "name": "ippusbxd"
    }
  ],
  "install_guidance": {
    "plugin": "ippusbxd",
    "binary": "ippusbxd",
    "check": "which ippusbxd",
    "install_steps": [
      "apt-get install ippusbxd 2>/dev/null || which ippusbxd",
      "Verify: ippusbxd --version",
      "supercli plugins install ./plugins/ippusbxd --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ippusbxd",
      "resource": "self",
      "action": "version",
      "description": "Print ippusbxd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ippusbxd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ippusbxd: apt-get install ippusbxd 2>/dev/null || which ippusbxd"
      },
      "args": []
    },
    {
      "namespace": "ippusbxd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ippusbxd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ippusbxd",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ippusbxd: apt-get install ippusbxd 2>/dev/null || which ippusbxd"
      },
      "args": []
    }
  ]
}