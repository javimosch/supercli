{
  "name": "goto",
  "version": "0.1.0",
  "description": "Directory aliases for the shell with autocomplete",
  "source": "https://github.com/iridakos/goto",
  "checks": [
    {
      "type": "binary",
      "name": "goto"
    }
  ],
  "install_guidance": {
    "plugin": "goto",
    "binary": "goto",
    "check": "which goto",
    "install_steps": [
      "brew install goto",
      "Verify: goto --version",
      "supercli plugins install ./plugins/goto --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "goto",
      "resource": "self",
      "action": "version",
      "description": "Print goto version",
      "adapter": "process",
      "adapterConfig": {
        "command": "goto",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install goto: brew install goto"
      },
      "args": []
    },
    {
      "namespace": "goto",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to goto CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "goto",
        "passthrough": true,
        "missingDependencyHelp": "Install goto"
      },
      "args": []
    }
  ]
}