{
  "name": "glib-compile-schemas",
  "version": "0.1.0",
  "description": "CLI tool: glib-compile-schemas",
  "source": "https://manpages.debian.org/glib-compile-schemas",
  "checks": [
    {
      "type": "binary",
      "name": "glib-compile-schemas"
    }
  ],
  "install_guidance": {
    "plugin": "glib-compile-schemas",
    "binary": "glib-compile-schemas",
    "check": "which glib-compile-schemas",
    "install_steps": [
      "apt-get install glib-compile-schemas 2>/dev/null || which glib-compile-schemas",
      "Verify: glib-compile-schemas --version",
      "supercli plugins install ./plugins/glib-compile-schemas --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "glib-compile-schemas",
      "resource": "self",
      "action": "version",
      "description": "Print glib-compile-schemas version",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-compile-schemas",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install glib-compile-schemas: apt-get install glib-compile-schemas 2>/dev/null || which glib-compile-schemas"
      },
      "args": []
    },
    {
      "namespace": "glib-compile-schemas",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to glib-compile-schemas CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "glib-compile-schemas",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install glib-compile-schemas: apt-get install glib-compile-schemas 2>/dev/null || which glib-compile-schemas"
      },
      "args": []
    }
  ]
}