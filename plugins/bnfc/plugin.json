{
  "name": "bnfc",
  "version": "0.1.0",
  "description": "BNF Converter",
  "source": "https://github.com/BNFC/bnfc",
  "checks": [
    {
      "type": "binary",
      "name": "bnfc"
    }
  ],
  "install_guidance": {
    "plugin": "bnfc",
    "binary": "bnfc",
    "check": "which bnfc",
    "install_steps": [
      "brew install bnfc",
      "Verify: bnfc --version",
      "supercli plugins install ./plugins/bnfc --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "bnfc",
      "resource": "self",
      "action": "version",
      "description": "Print bnfc version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bnfc",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bnfc: brew install bnfc"
      },
      "args": []
    },
    {
      "namespace": "bnfc",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bnfc CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bnfc",
        "passthrough": true,
        "missingDependencyHelp": "Install bnfc"
      },
      "args": []
    }
  ]
}