{
  "name": "psfstriptable",
  "version": "0.1.0",
  "description": "CLI tool: psfstriptable",
  "source": "https://manpages.debian.org/psfstriptable",
  "checks": [
    {
      "type": "binary",
      "name": "psfstriptable"
    }
  ],
  "install_guidance": {
    "plugin": "psfstriptable",
    "binary": "psfstriptable",
    "check": "which psfstriptable",
    "install_steps": [
      "apt-get install psfstriptable 2>/dev/null || which psfstriptable",
      "Verify: psfstriptable --version",
      "supercli plugins install ./plugins/psfstriptable --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "psfstriptable",
      "resource": "self",
      "action": "version",
      "description": "Print psfstriptable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfstriptable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install psfstriptable: apt-get install psfstriptable 2>/dev/null || which psfstriptable"
      },
      "args": []
    },
    {
      "namespace": "psfstriptable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to psfstriptable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfstriptable",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install psfstriptable: apt-get install psfstriptable 2>/dev/null || which psfstriptable"
      },
      "args": []
    }
  ]
}