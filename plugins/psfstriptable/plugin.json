{
  "name": "psfstriptable",
  "version": "1.0.0",
  "description": "psfstriptable \u2014 psfstriptable \u2014 CLI utility",
  "source": "/usr/bin/psfstriptable",
  "checks": [
    {
      "type": "binary",
      "name": "psfstriptable"
    }
  ],
  "install_guidance": {
    "plugin": "psfstriptable",
    "binary": "psfstriptable",
    "check": "which psfstriptable",
    "install_steps": [
      "# Install psfstriptable:",
      "# apt: sudo apt-get install psfstriptable",
      "# brew: brew install psfstriptable",
      "# cargo: cargo install psfstriptable",
      "# npm: npm install -g psfstriptable",
      "# pip: pip install psfstriptable",
      "# or download from /usr/bin/psfstriptable"
    ]
  },
  "commands": [
    {
      "namespace": "psfstriptable",
      "resource": "psfstriptable",
      "action": "run",
      "description": "Run psfstriptable",
      "adapter": "process",
      "adapterConfig": {
        "command": "psfstriptable",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install psfstriptable from /usr/bin/psfstriptable"
      },
      "args": []
    }
  ]
}