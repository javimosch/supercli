{
  "name": "gifgen",
  "version": "0.1.0",
  "description": "Simple CLI tool for generating high-quality GIF animations",
  "source": "go",
  "checks": [{ "type": "binary", "name": "gifgen" }],
  "install_guidance": {
    "plugin": "gifgen",
    "binary": "gifgen",
    "check": "which gifgen",
    "install_steps": ["go install github.com/gifgen@latest", "Verify: gifgen --version", "supercli plugins install ./plugins/gifgen --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gifgen",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gifgen CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gifgen",
      "passthrough": true,
      "missingDependencyHelp": "Install gifgen: go install github.com/gifgen@latest"
    },
    "args": []
  }]
}
