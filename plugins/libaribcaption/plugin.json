{
  "name": "libaribcaption",
  "version": "0.1.0",
  "description": "Portable ARIB STD-B24 Caption Decoder/Renderer",
  "source": "https://github.com/xqq/libaribcaption",
  "checks": [
    {
      "type": "binary",
      "name": "libaribcaption"
    }
  ],
  "install_guidance": {
    "plugin": "libaribcaption",
    "binary": "libaribcaption",
    "check": "which libaribcaption",
    "install_steps": [
      "brew install libaribcaption",
      "Verify: libaribcaption --version",
      "supercli plugins install ./plugins/libaribcaption --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libaribcaption",
      "resource": "self",
      "action": "version",
      "description": "Print libaribcaption version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libaribcaption",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libaribcaption: brew install libaribcaption"
      },
      "args": []
    },
    {
      "namespace": "libaribcaption",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libaribcaption CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libaribcaption",
        "passthrough": true,
        "missingDependencyHelp": "Install libaribcaption"
      },
      "args": []
    }
  ]
}