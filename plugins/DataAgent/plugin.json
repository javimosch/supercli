{
  "name": "DataAgent",
  "version": "0.1.0",
  "description": "Spring AI Alibaba DataAgent",
  "source": "https://github.com/DataAgent/DataAgent",
  "checks": [
    {
      "type": "binary",
      "name": "dataagent"
    }
  ],
  "install_guidance": {
    "plugin": "DataAgent",
    "binary": "dataagent",
    "check": "which dataagent",
    "install_steps": [
      "pip install dataagent",
      "Verify: dataagent --version",
      "supercli plugins install ./plugins/DataAgent --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "DataAgent",
      "resource": "self",
      "action": "version",
      "description": "Print DataAgent version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dataagent",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install DataAgent: pip install dataagent"
      },
      "args": []
    },
    {
      "namespace": "DataAgent",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dataagent CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dataagent",
        "passthrough": true,
        "missingDependencyHelp": "Install DataAgent: pip install dataagent"
      },
      "args": []
    }
  ]
}