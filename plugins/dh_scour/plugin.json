{
  "name": "dh_scour",
  "version": "0.1.0",
  "description": "dh_scour — SVG scrubber and optimizer (CLI and debhelper)",
  "source": "https://github.com/codedread/scour",
  "checks": [{ "type": "binary", "name": "dh_scour" }],
  "install_guidance": {
    "plugin": "dh_scour", "binary": "dh_scour", "check": "which dh_scour",
    "install_steps": ["apt-get install scour 2>/dev/null || which dh_scour", "Verify: dh_scour --version", "supercli plugins install ./plugins/dh_scour --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dh_scour", "resource": "_", "action": "_",
    "description": "Passthrough to dh_scour CLI",
    "adapter": "process", "adapterConfig": { "command": "dh_scour", "passthrough": true, "missingDependencyHelp": "Install dh_scour: apt-get install scour" }, "args": []
  }]
}
