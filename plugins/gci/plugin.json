{
  "name": "gci",
  "version": "0.1.0",
  "description": "Control Golang package import order and make it always deterministic",
  "source": "https://github.com/daixiang0/gci",
  "checks": [
    {
      "type": "binary",
      "name": "gci"
    }
  ],
  "install_guidance": {
    "plugin": "gci",
    "binary": "gci",
    "check": "which gci",
    "install_steps": [
      "brew install gci",
      "Verify: gci --version",
      "supercli plugins install ./plugins/gci --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gci",
      "resource": "self",
      "action": "version",
      "description": "Print gci version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gci",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gci: brew install gci"
      },
      "args": []
    },
    {
      "namespace": "gci",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gci CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gci",
        "passthrough": true,
        "missingDependencyHelp": "Install gci"
      },
      "args": []
    }
  ]
}