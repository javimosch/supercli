{
  "name": "pdfsyntax",
  "version": "0.1.0",
  "description": "Inspect and modify PDF file internals",
  "source": "https://github.com/pdfsyntax/pdfsyntax",
  "checks": [
    {
      "type": "binary",
      "name": "pdfsyntax"
    }
  ],
  "install_guidance": {
    "plugin": "pdfsyntax",
    "binary": "pdfsyntax",
    "check": "which pdfsyntax",
    "install_steps": [
      "pip install pdfsyntax",
      "Verify: pdfsyntax --version",
      "supercli plugins install ./plugins/pdfsyntax --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pdfsyntax",
      "resource": "self",
      "action": "version",
      "description": "Print pdfsyntax version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdfsyntax",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pdfsyntax: pip install pdfsyntax"
      },
      "args": []
    },
    {
      "namespace": "pdfsyntax",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pdfsyntax CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pdfsyntax",
        "passthrough": true,
        "missingDependencyHelp": "Install pdfsyntax: pip install pdfsyntax"
      },
      "args": []
    }
  ]
}
