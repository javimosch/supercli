{
  "plugin": "pkg-config",
  "binary": "pkg-config",
  "check": "which pkg-config",
  "install_steps": [
    "apt-get install pkg-config 2>/dev/null || which pkg-config",
    "Verify: pkg-config --version",
    "supercli plugins install ./plugins/pkg-config --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}