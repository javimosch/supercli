{
  "name": "grpcurl",
  "version": "0.1.0",
  "description": "Like cURL but for gRPC servers, useful for testing and debugging",
  "source": "https://github.com/fullstorydev/grpcurl",
  "checks": [{ "type": "binary", "name": "grpcurl" }],
  "install_guidance": {
    "plugin": "grpcurl",
    "binary": "grpcurl",
    "check": "which grpcurl",
    "install_steps": ["brew install grpcurl", "Verify: grpcurl --version", "supercli plugins install ./plugins/grpcurl --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "grpcurl",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to grpcurl CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "grpcurl",
      "passthrough": true,
      "missingDependencyHelp": "Install grpcurl: brew install grpcurl"
    },
    "args": []
  }]
}
