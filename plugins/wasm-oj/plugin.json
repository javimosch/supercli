{
  "name": "wasm-oj",
  "version": "0.1.0",
  "description": "Online judge platform CLI running student code as WASM",
  "source": "cargo",
  "checks": [{ "type": "binary", "name": "wasm-oj" }],
  "install_guidance": {
    "plugin": "wasm-oj",
    "binary": "wasm-oj",
    "check": "which wasm-oj",
    "install_steps": ["cargo install wasm-oj", "Verify: wasm-oj --version", "supercli plugins install ./plugins/wasm-oj --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "wasm-oj",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to wasm-oj CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "wasm-oj",
      "passthrough": true,
      "missingDependencyHelp": "Install wasm-oj: cargo install wasm-oj"
    },
    "args": []
  }]
}
