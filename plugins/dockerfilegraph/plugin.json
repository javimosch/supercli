{
  "name": "dockerfilegraph",
  "version": "0.1.0",
  "description": "Visualize your multi-stage Dockerfiles",
  "source": "https://github.com/patrickhoefler/dockerfilegraph",
  "checks": [
    {
      "type": "binary",
      "name": "dockerfilegraph"
    }
  ],
  "install_guidance": {
    "plugin": "dockerfilegraph",
    "binary": "dockerfilegraph",
    "check": "which dockerfilegraph",
    "install_steps": [
      "brew install dockerfilegraph",
      "Verify: dockerfilegraph --version",
      "supercli plugins install ./plugins/dockerfilegraph --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "dockerfilegraph",
      "resource": "self",
      "action": "version",
      "description": "Print dockerfilegraph version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockerfilegraph",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dockerfilegraph: brew install dockerfilegraph"
      },
      "args": []
    },
    {
      "namespace": "dockerfilegraph",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dockerfilegraph CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dockerfilegraph",
        "passthrough": true,
        "missingDependencyHelp": "Install dockerfilegraph"
      },
      "args": []
    }
  ]
}