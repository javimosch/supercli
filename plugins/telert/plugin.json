{
  "name": "telert",
  "version": "0.1.0",
  "description": "telert - Alert on command completion",
  "source": "github.com/telert/telert",
  "checks": [
    {
      "type": "binary",
      "name": "telert"
    }
  ],
  "install_guidance": {
    "plugin": "telert",
    "binary": "telert",
    "check": "which telert",
    "install_steps": [
      "pip install telert"
    ]
  },
  "commands": [
    {
      "namespace": "telert",
      "resource": "alert",
      "action": "run",
      "description": "Alert on command completion",
      "adapter": "process",
      "adapterConfig": {
        "command": "telert",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install telert from github.com/telert/telert"
      },
      "args": []
    }
  ]
}