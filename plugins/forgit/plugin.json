{
  "name": "forgit",
  "version": "0.1.0",
  "description": "A utility tool powered by fzf for using git interactively.",
  "source": "https://github.com/wfxr/forgit",
  "checks": [
    {
      "type": "binary",
      "name": "forgit"
    }
  ],
  "install_guidance": {
    "plugin": "forgit",
    "binary": "forgit",
    "check": "which forgit",
    "install_steps": [
      "brew install forgit",
      "Verify: forgit --version",
      "supercli plugins install ./plugins/forgit --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "forgit",
      "resource": "self",
      "action": "version",
      "description": "Print forgit version",
      "adapter": "process",
      "adapterConfig": {
        "command": "forgit",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install forgit: brew install forgit"
      },
      "args": []
    },
    {
      "namespace": "forgit",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to forgit CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "forgit",
        "passthrough": true,
        "missingDependencyHelp": "Install forgit"
      },
      "args": []
    }
  ]
}