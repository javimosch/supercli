{
  "name": "pbmmake",
  "version": "0.1.0",
  "description": "CLI tool: pbmmake",
  "source": "https://manpages.debian.org/pbmmake",
  "checks": [
    {
      "type": "binary",
      "name": "pbmmake"
    }
  ],
  "install_guidance": {
    "plugin": "pbmmake",
    "binary": "pbmmake",
    "check": "which pbmmake",
    "install_steps": [
      "apt-get install pbmmake 2>/dev/null || which pbmmake",
      "Verify: pbmmake --version",
      "supercli plugins install ./plugins/pbmmake --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmmake",
      "resource": "self",
      "action": "version",
      "description": "Print pbmmake version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmmake",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmmake: apt-get install pbmmake 2>/dev/null || which pbmmake"
      },
      "args": []
    },
    {
      "namespace": "pbmmake",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmmake CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmmake",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmmake: apt-get install pbmmake 2>/dev/null || which pbmmake"
      },
      "args": []
    }
  ]
}