{
  "name": "tetro-tui",
  "version": "0.1.0",
  "description": "Modern terminal-based tetromino-stacking game in Rust with guideline mechanics, customization, and a built-in bot",
  "source": "https://github.com/Strophox/tetro-tui",
  "checks": [
    { "type": "binary", "name": "tetro-tui" }
  ],
  "install_guidance": {
    "plugin": "tetro-tui",
    "binary": "tetro-tui",
    "check": "which tetro-tui",
    "install_steps": [
      "cargo install tetro-tui",
      "Or: download a release binary from https://github.com/Strophox/tetro-tui/releases",
      "Or: nix run github:Strophox/tetro-tui",
      "Verify: tetro-tui --version",
      "supercli plugins install ./plugins/tetro-tui --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "tetro-tui",
      "resource": "self",
      "action": "version",
      "description": "Print tetro-tui version",
      "adapter": "process",
      "adapterConfig": {
        "command": "tetro-tui",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install tetro-tui: cargo install tetro-tui"
      },
      "args": []
    },
    {
      "namespace": "tetro-tui",
      "resource": "game",
      "action": "play",
      "description": "Start the game (interactive TUI). Flags: -d descent mode, -c <layout> custom combo start, -e engine bot. Needs a real terminal",
      "adapter": "process",
      "adapterConfig": {
        "command": "tetro-tui",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install tetro-tui: cargo install tetro-tui"
      },
      "args": []
    },
    {
      "namespace": "tetro-tui",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to tetro-tui CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "tetro-tui",
        "passthrough": true,
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install tetro-tui: cargo install tetro-tui"
      },
      "args": []
    }
  ]
}
