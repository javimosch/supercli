{
  "name": "walk",
  "description": "Terminal file manager - Navigate directories and execute files",
  "version": "1.0.0",
  "binary": "walk",
  "check": "walk --version",
  "install": {
    "method": "go",
    "command": "go install github.com/antonmedv/walk@latest"
  },
  "commands": {
    "open": {
      "command": "walk",
      "description": "Open walk file manager in current directory"
    },
    "open-path": {
      "command": "walk {path}",
      "description": "Open walk at specific path",
      "args": ["path"]
    }
  }
}
