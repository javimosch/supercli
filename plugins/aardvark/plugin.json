{
  "name": "aardvark",
  "version": "0.1.0",
  "description": "Lightweight static site documentation tool",
  "source": "npm",
  "checks": [{ "type": "binary", "name": "aardvark" }],
  "install_guidance": {
    "plugin": "aardvark",
    "binary": "aardvark",
    "check": "which aardvark",
    "install_steps": ["npm install -g aardvark", "Verify: aardvark --version", "supercli plugins install ./plugins/aardvark --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aardvark",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to aardvark CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "aardvark",
      "passthrough": true,
      "missingDependencyHelp": "Install aardvark: npm install -g aardvark"
    },
    "args": []
  }]
}
