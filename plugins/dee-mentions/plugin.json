{
  "name": "dee-mentions",
  "version": "0.1.0",
  "description": "Track public mentions across the web with JSON output",
  "source": "https://github.com/deeflect/dee-ink",
  "checks": [{ "type": "binary", "name": "dee-mentions" }],
  "install_guidance": {
    "plugin": "dee-mentions",
    "binary": "dee-mentions",
    "check": "which dee-mentions",
    "install_steps": ["cargo install dee-mentions", "Verify: dee-mentions --version", "supercli plugins install ./plugins/dee-mentions --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dee-mentions",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dee-mentions CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dee-mentions",
      "passthrough": true,
      "missingDependencyHelp": "Install dee-mentions: cargo install dee-mentions"
    },
    "args": []
  }]
}
