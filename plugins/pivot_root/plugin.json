{
  "name": "pivot_root",
  "version": "0.1.0",
  "description": "CLI tool: pivot_root",
  "source": "https://manpages.debian.org/pivot_root",
  "checks": [
    {
      "type": "binary",
      "name": "pivot_root"
    }
  ],
  "install_guidance": {
    "plugin": "pivot_root",
    "binary": "pivot_root",
    "check": "which pivot_root",
    "install_steps": [
      "apt-get install pivot_root 2>/dev/null || which pivot_root",
      "Verify: pivot_root --version",
      "supercli plugins install ./plugins/pivot_root --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pivot_root",
      "resource": "self",
      "action": "version",
      "description": "Print pivot_root version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pivot_root",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pivot_root: apt-get install pivot_root 2>/dev/null || which pivot_root"
      },
      "args": []
    },
    {
      "namespace": "pivot_root",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pivot_root CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pivot_root",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pivot_root: apt-get install pivot_root 2>/dev/null || which pivot_root"
      },
      "args": []
    }
  ]
}