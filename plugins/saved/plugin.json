{
  "name": "saved",
  "version": "0.1.0",
  "description": "CLI personal search engine for bookmarks",
  "source": "https://github.com/karlicoss/saved",
  "checks": [{ "type": "binary", "name": "saved" }],
  "install_guidance": {
    "plugin": "saved",
    "binary": "saved",
    "check": "which saved",
    "install_steps": ["pip install saved-cli", "Verify: saved --version", "supercli plugins install ./plugins/saved --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "saved",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to saved CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "saved",
      "passthrough": true,
      "missingDependencyHelp": "Install saved: pip install saved-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
