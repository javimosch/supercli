{
  "name": "myisam_ftdump",
  "version": "0.1.0",
  "description": "CLI tool: myisam_ftdump",
  "source": "https://manpages.debian.org/myisam_ftdump",
  "checks": [
    {
      "type": "binary",
      "name": "myisam_ftdump"
    }
  ],
  "install_guidance": {
    "plugin": "myisam_ftdump",
    "binary": "myisam_ftdump",
    "check": "which myisam_ftdump",
    "install_steps": [
      "apt-get install myisam_ftdump 2>/dev/null || which myisam_ftdump",
      "Verify: myisam_ftdump --version",
      "supercli plugins install ./plugins/myisam_ftdump --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "myisam_ftdump",
      "resource": "self",
      "action": "version",
      "description": "Print myisam_ftdump version",
      "adapter": "process",
      "adapterConfig": {
        "command": "myisam_ftdump",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install myisam_ftdump: apt-get install myisam_ftdump 2>/dev/null || which myisam_ftdump"
      },
      "args": []
    },
    {
      "namespace": "myisam_ftdump",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to myisam_ftdump CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "myisam_ftdump",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install myisam_ftdump: apt-get install myisam_ftdump 2>/dev/null || which myisam_ftdump"
      },
      "args": []
    }
  ]
}