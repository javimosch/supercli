{
  "name": "tiled-cli",
  "version": "0.1.0",
  "description": "Minimalist CLI to process and convert Tiled .tmx map files",
  "source": "go",
  "checks": [{ "type": "binary", "name": "tiled-cli" }],
  "install_guidance": {
    "plugin": "tiled-cli",
    "binary": "tiled-cli",
    "check": "which tiled-cli",
    "install_steps": ["go install github.com/tiled-cli@latest", "Verify: tiled-cli --version", "supercli plugins install ./plugins/tiled-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tiled-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tiled-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tiled-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install tiled-cli: go install github.com/tiled-cli@latest"
    },
    "args": []
  }]
}
