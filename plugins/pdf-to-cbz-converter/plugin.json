{
  "name": "pdf-to-cbz-converter",
  "version": "0.1.0",
  "description": "CLI for bidirectional conversion between PDF and CBZ formats",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "pdf-to-cbz-converter" }],
  "install_guidance": {
    "plugin": "pdf-to-cbz-converter",
    "binary": "pdf-to-cbz-converter",
    "check": "which pdf-to-cbz-converter",
    "install_steps": ["pip install pdf-to-cbz", "Verify: pdf-to-cbz-converter --version", "supercli plugins install ./plugins/pdf-to-cbz-converter --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pdf-to-cbz-converter",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pdf-to-cbz-converter CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pdf-to-cbz-converter",
      "passthrough": true,
      "missingDependencyHelp": "Install pdf-to-cbz-converter: pip install pdf-to-cbz"
    },
    "args": []
  }]
}
