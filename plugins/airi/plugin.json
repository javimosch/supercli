{
  "name": "airi",
  "version": "0.1.0",
  "description": "\ud83d\udc96\ud83e\uddf8 Self hosted, you-owned Grok Companion, a container of souls of waifu, cyber livings to bring them",
  "source": "https://github.com/airi/airi",
  "checks": [
    {
      "type": "binary",
      "name": "airi"
    }
  ],
  "install_guidance": {
    "plugin": "airi",
    "binary": "airi",
    "check": "which airi",
    "install_steps": [
      "pip install airi",
      "Verify: airi --version",
      "supercli plugins install ./plugins/airi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "airi",
      "resource": "self",
      "action": "version",
      "description": "Print airi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "airi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install airi: pip install airi"
      },
      "args": []
    },
    {
      "namespace": "airi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to airi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "airi",
        "passthrough": true,
        "missingDependencyHelp": "Install airi: pip install airi"
      },
      "args": []
    }
  ]
}