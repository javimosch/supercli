{
  "name": "license-checker-php",
  "version": "0.1.0",
  "description": "CLI for Composer PHP dependency license auditing",
  "source": "composer",
  "checks": [{ "type": "binary", "name": "license-checker-php" }],
  "install_guidance": {
    "plugin": "license-checker-php",
    "binary": "license-checker-php",
    "check": "which license-checker-php",
    "install_steps": ["composer require madewithlove/license-checker-php", "Verify: license-checker-php --version", "supercli plugins install ./plugins/license-checker-php --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "license-checker-php",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to license-checker-php CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "license-checker-php",
      "passthrough": true,
      "missingDependencyHelp": "Install license-checker-php: composer require madewithlove/license-checker-php"
    },
    "args": []
  }]
}
