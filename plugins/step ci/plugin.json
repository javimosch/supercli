{
  "name": "step ci",
  "version": "0.1.0",
  "description": "API testing and QA framework",
  "source": "https://github.com/stepci/stepci",
  "checks": [
    {
      "type": "binary",
      "name": "step ci"
    }
  ],
  "install_guidance": {
    "plugin": "step ci",
    "binary": "step ci",
    "check": "which step ci",
    "install_steps": [
      "See https://github.com/stepci/stepci",
      "Verify: step ci --version",
      "supercli plugins install ./plugins/step ci --on-conflict replace --json"
    ],
    "note": "See project repository"
  },
  "commands": [
    {
      "namespace": "step ci",
      "resource": "self",
      "action": "version",
      "description": "Print step ci version",
      "adapter": "process",
      "adapterConfig": {
        "command": "step ci",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install step ci: See https://github.com/stepci/stepci"
      },
      "args": []
    },
    {
      "namespace": "step ci",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to step ci CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "step ci",
        "passthrough": true,
        "missingDependencyHelp": "Install step ci"
      },
      "args": []
    }
  ]
}