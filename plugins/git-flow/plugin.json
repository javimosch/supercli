{
  "name": "git-flow",
  "version": "0.1.0",
  "description": "Git extensions for Vincent Driessen's branching model",
  "source": "https://github.com/nvie/gitflow",
  "checks": [
    {
      "type": "binary",
      "name": "git-flow"
    }
  ],
  "install_guidance": {
    "plugin": "git-flow",
    "binary": "git-flow",
    "check": "which git-flow",
    "install_steps": [
      "brew install git-flow",
      "Verify: git-flow --version",
      "supercli plugins install ./plugins/git-flow --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "git-flow",
      "resource": "self",
      "action": "version",
      "description": "Print git-flow version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-flow",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-flow: brew install git-flow"
      },
      "args": []
    },
    {
      "namespace": "git-flow",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-flow CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-flow",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install git-flow: brew install git-flow"
      },
      "args": []
    }
  ]
}
