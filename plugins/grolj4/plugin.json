{
  "name": "grolj4",
  "version": "0.1.0",
  "description": "CLI tool: grolj4",
  "source": "https://manpages.debian.org/grolj4",
  "checks": [
    {
      "type": "binary",
      "name": "grolj4"
    }
  ],
  "install_guidance": {
    "plugin": "grolj4",
    "binary": "grolj4",
    "check": "which grolj4",
    "install_steps": [
      "apt-get install grolj4 2>/dev/null || which grolj4",
      "Verify: grolj4 --version",
      "supercli plugins install ./plugins/grolj4 --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "grolj4",
      "resource": "self",
      "action": "version",
      "description": "Print grolj4 version",
      "adapter": "process",
      "adapterConfig": {
        "command": "grolj4",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install grolj4: apt-get install grolj4 2>/dev/null || which grolj4"
      },
      "args": []
    },
    {
      "namespace": "grolj4",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to grolj4 CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "grolj4",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install grolj4: apt-get install grolj4 2>/dev/null || which grolj4"
      },
      "args": []
    }
  ]
}