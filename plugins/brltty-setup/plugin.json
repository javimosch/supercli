{
  "name": "brltty-setup",
  "version": "0.1.0",
  "description": "CLI tool: brltty-setup",
  "source": "https://packages.debian.org/brltty-setup",
  "checks": [{ "type": "binary", "name": "brltty-setup" }],
  "install_guidance": {
    "plugin": "brltty-setup", "binary": "brltty-setup", "check": "which brltty-setup",
    "install_steps": ["apt-get install brltty-setup 2>/dev/null || which brltty-setup", "Verify: brltty-setup --version", "supercli plugins install ./plugins/brltty-setup --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "brltty-setup", "resource": "_", "action": "_",
    "description": "Passthrough to brltty-setup CLI",
    "adapter": "process", "adapterConfig": { "command": "brltty-setup", "passthrough": true, "missingDependencyHelp": "Install brltty-setup: apt-get install brltty-setup" }, "args": []
  }]
}
