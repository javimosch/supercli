{
  "name": "dvipos",
  "version": "0.1.0",
  "description": "CLI tool: dvipos",
  "source": "https://manpages.debian.org/dvipos",
  "checks": [
    {
      "type": "binary",
      "name": "dvipos"
    }
  ],
  "install_guidance": {
    "plugin": "dvipos",
    "binary": "dvipos",
    "check": "which dvipos",
    "install_steps": [
      "apt-get install dvipos 2>/dev/null || which dvipos",
      "Verify: dvipos --version",
      "supercli plugins install ./plugins/dvipos --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "dvipos",
      "resource": "self",
      "action": "version",
      "description": "Print dvipos version",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvipos",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install dvipos: apt-get install dvipos 2>/dev/null || which dvipos"
      },
      "args": []
    },
    {
      "namespace": "dvipos",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to dvipos CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "dvipos",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install dvipos: apt-get install dvipos 2>/dev/null || which dvipos"
      },
      "args": []
    }
  ]
}