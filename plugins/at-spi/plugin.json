{
  "name": "at-spi",
  "version": "0.1.0",
  "description": "CLI tool: at-spi",
  "source": "https://packages.debian.org/at-spi",
  "checks": [{ "type": "binary", "name": "at-spi" }],
  "install_guidance": {
    "plugin": "at-spi", "binary": "at-spi", "check": "which at-spi",
    "install_steps": ["apt-get install at-spi 2>/dev/null || which at-spi", "Verify: at-spi --version", "supercli plugins install ./plugins/at-spi --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "at-spi", "resource": "_", "action": "_",
    "description": "Passthrough to at-spi CLI",
    "adapter": "process", "adapterConfig": { "command": "at-spi", "passthrough": true, "missingDependencyHelp": "Install at-spi: apt-get install at-spi" }, "args": []
  }]
}
