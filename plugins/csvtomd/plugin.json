{
  "name": "csvtomd",
  "version": "0.1.0",
  "description": "CSV to Markdown table converter",
  "source": "https://github.com/mplewis/csvtomd",
  "checks": [
    {
      "type": "binary",
      "name": "csvtomd"
    }
  ],
  "install_guidance": {
    "plugin": "csvtomd",
    "binary": "csvtomd",
    "check": "which csvtomd",
    "install_steps": [
      "brew install csvtomd",
      "Verify: csvtomd --version",
      "supercli plugins install ./plugins/csvtomd --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "csvtomd",
      "resource": "self",
      "action": "version",
      "description": "Print csvtomd version",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvtomd",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install csvtomd: brew install csvtomd"
      },
      "args": []
    },
    {
      "namespace": "csvtomd",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to csvtomd CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "csvtomd",
        "passthrough": true,
        "missingDependencyHelp": "Install csvtomd"
      },
      "args": []
    }
  ]
}