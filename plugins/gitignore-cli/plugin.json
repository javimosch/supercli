{
  "name": "gitignore-cli",
  "version": "0.1.0",
  "description": "Gitignore.io CLI for creating gitignore files",
  "source": "https://github.com/msfeldstein/gitignore-cli",
  "checks": [{ "type": "binary", "name": "gitignore-cli" }],
  "install_guidance": {
    "plugin": "gitignore-cli",
    "binary": "gitignore-cli",
    "check": "which gitignore-cli",
    "install_steps": ["npm install -g gitignore-cli", "Verify: gitignore-cli --version", "supercli plugins install ./plugins/gitignore-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "gitignore-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to gitignore-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "gitignore-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install gitignore-cli: npm install -g gitignore-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
