{
  "name": "zig-interface",
  "version": "0.1.0",
  "description": "Comptime interface generation modeled after vtable design found in the stdlib.",
  "source": "https://github.com/zig-interface/zig-interface",
  "checks": [
    {
      "type": "binary",
      "name": "zig-interface"
    }
  ],
  "install_guidance": {
    "plugin": "zig-interface",
    "binary": "zig-interface",
    "check": "which zig-interface",
    "install_steps": [
      "pip install zig-interface",
      "Verify: zig-interface --version",
      "supercli plugins install ./plugins/zig-interface --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zig-interface",
      "resource": "self",
      "action": "version",
      "description": "Print zig-interface version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-interface",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zig-interface: pip install zig-interface"
      },
      "args": []
    },
    {
      "namespace": "zig-interface",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zig-interface CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zig-interface",
        "passthrough": true,
        "missingDependencyHelp": "Install zig-interface: pip install zig-interface"
      },
      "args": []
    }
  ]
}