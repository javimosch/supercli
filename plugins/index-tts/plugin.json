{
  "name": "index-tts",
  "version": "0.1.0",
  "description": "Industrial-level controllable and efficient zero-shot text-to-speech system",
  "source": "https://github.com/index-tts/index-tts",
  "checks": [
    {
      "type": "binary",
      "name": "index-tts"
    }
  ],
  "install_guidance": {
    "plugin": "index-tts",
    "binary": "index-tts",
    "check": "which index-tts",
    "install_steps": [
      "pip install index-tts",
      "Verify: index-tts --version",
      "supercli plugins install ./plugins/index-tts --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
  {
    "namespace": "index-tts",
    "resource": "self",
    "action": "version",
    "description": "Print index-tts version",
    "adapter": "process",
    "adapterConfig": {
      "command": "index-tts",
      "baseArgs": [
        "--version"
      ],
      "missingDependencyHelp": "Install index-tts: pip install index-tts"
    },
    "args": []
  },
  {
    "namespace": "index-tts",
    "resource": "tts",
    "action": "generate",
    "description": "Generate speech from text",
    "adapter": "process",
    "adapterConfig": {
      "command": "index-tts",
      "passthrough": true,
      "missingDependencyHelp": "Install index-tts: pip install index-tts"
    },
    "args": []
  },
  {
    "namespace": "index-tts",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to index-tts CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "index-tts",
      "passthrough": true,
      "missingDependencyHelp": "Install index-tts"
    },
    "args": []
  }
]
}