{
  "name": "apparmor_status",
  "version": "0.1.0",
  "description": "CLI tool: apparmor_status",
  "source": "https://packages.debian.org/apparmor_status",
  "checks": [{ "type": "binary", "name": "apparmor_status" }],
  "install_guidance": {
    "plugin": "apparmor_status", "binary": "apparmor_status", "check": "which apparmor_status",
    "install_steps": ["apt-get install apparmor_status 2>/dev/null || which apparmor_status", "Verify: apparmor_status --version", "supercli plugins install ./plugins/apparmor_status --on-conflict replace --json"]
