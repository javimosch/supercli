  "commands": [{
    "namespace": "apparmor_status", "resource": "_", "action": "_",
    "description": "Passthrough to apparmor_status CLI",
    "adapter": "process", "adapterConfig": { "command": "apparmor_status", "passthrough": true, "missingDependencyHelp": "Install apparmor_status: apt-get install apparmor_status" }, "args": []
  }]
}
