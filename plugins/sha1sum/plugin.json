{
  "name": "sha1sum",
  "version": "0.1.0",
  "description": "SHA-1 hash computation and verification",
  "source": "https",
  "checks": [{"type": "binary", "name": "sha1sum"}],
  "install_guidance": {
    "plugin": "sha1sum",
    "binary": "sha1sum",
    "check": "which sha1sum",
    "install_steps": [
      "brew install coreutils",
      "Verify: sha1sum --version",
      "supercli plugins install ./plugins/sha1sum --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "sha1sum",
      "resource": "self",
      "action": "version",
      "description": "Print sha1sum version",
      "adapter": "process",
      "adapterConfig": {"command": "sha1sum", "baseArgs": ["--version"], "missingDependencyHelp": "Install sha1sum: brew install coreutils"},
      "args": []
    },
    {
      "namespace": "sha1sum",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sha1sum CLI",
      "adapter": "process",
      "adapterConfig": {"command": "sha1sum", "passthrough": true, "missingDependencyHelp": "Install sha1sum: brew install coreutils"},
      "args": []
    }
  ]
}
