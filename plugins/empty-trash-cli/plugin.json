{
  "name": "empty-trash-cli",
  "version": "0.1.0",
  "description": "Empty the trash",
  "source": "https://github.com/sindresorhus/empty-trash-cli",
  "checks": [
    {
      "type": "binary",
      "name": "empty-trash-cli"
    }
  ],
  "install_guidance": {
    "plugin": "empty-trash-cli",
    "binary": "empty-trash-cli",
    "check": "which empty-trash-cli",
    "install_steps": [
      "npm install -g empty-trash-cli",
      "Verify: empty-trash-cli --version",
      "supercli plugins install ./plugins/empty-trash-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "empty-trash-cli",
      "resource": "self",
      "action": "version",
      "description": "Print empty-trash-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "empty-trash-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install empty-trash-cli: npm install -g empty-trash-cli"
      },
      "args": []
    },
    {
      "namespace": "empty-trash-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to empty-trash-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "empty-trash-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install empty-trash-cli"
      },
      "args": []
    }
  ]
}