{
  "name": "ifstat",
  "version": "1.0.0",
  "description": "ifstat \u2014 Interface stats",
  "source": "github.com/ifstat/ifstat",
  "checks": [
    {
      "type": "binary",
      "name": "ifstat"
    }
  ],
  "install_guidance": {
    "plugin": "ifstat",
    "binary": "ifstat",
    "check": "which ifstat",
    "install_steps": [
      "# Install ifstat",
      "# See github.com/ifstat/ifstat",
      "# apt: sudo apt-get install ifstat",
      "# brew: brew install ifstat",
      "# cargo: cargo install ifstat",
      "# npm: npm install -g ifstat",
      "# pip: pip install ifstat"
    ]
  },
  "commands": [
    {
      "namespace": "ifstat",
      "resource": "ifstat",
      "action": "run",
      "description": "Run ifstat",
      "adapter": "process",
      "adapterConfig": {
        "command": "ifstat",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install ifstat from github.com/ifstat/ifstat"
      },
      "args": []
    }
  ]
}