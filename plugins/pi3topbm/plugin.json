{
  "name": "pi3topbm",
  "version": "0.1.0",
  "description": "CLI tool: pi3topbm",
  "source": "https://manpages.debian.org/pi3topbm",
  "checks": [
    {
      "type": "binary",
      "name": "pi3topbm"
    }
  ],
  "install_guidance": {
    "plugin": "pi3topbm",
    "binary": "pi3topbm",
    "check": "which pi3topbm",
    "install_steps": [
      "apt-get install pi3topbm 2>/dev/null || which pi3topbm",
      "Verify: pi3topbm --version",
      "supercli plugins install ./plugins/pi3topbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pi3topbm",
      "resource": "self",
      "action": "version",
      "description": "Print pi3topbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pi3topbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pi3topbm: apt-get install pi3topbm 2>/dev/null || which pi3topbm"
      },
      "args": []
    },
    {
      "namespace": "pi3topbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pi3topbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pi3topbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pi3topbm: apt-get install pi3topbm 2>/dev/null || which pi3topbm"
      },
      "args": []
    }
  ]
}