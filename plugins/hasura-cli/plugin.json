{
  "name": "hasura-cli",
  "version": "0.1.0",
  "description": "Command-Line Interface for Hasura GraphQL Engine",
  "checks": [
    {
      "type": "binary",
      "name": "hasura-cli"
    }
  ],
  "install_guidance": {
    "plugin": "hasura-cli",
    "binary": "hasura-cli",
    "check": "which hasura-cli",
    "install_steps": [
      "brew install hasura-cli",
      "Verify: hasura-cli --version",
      "supercli plugins install ./plugins/hasura-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hasura-cli",
      "resource": "self",
      "action": "version",
      "description": "Print hasura-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hasura-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hasura-cli: brew install hasura-cli"
      },
      "args": []
    },
    {
      "namespace": "hasura-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hasura-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hasura-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install hasura-cli"
      },
      "args": []
    }
  ]
}