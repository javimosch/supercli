{
  "name": "dhall-nixpkgs",
  "version": "0.1.0",
  "description": "CLI tool: dhall-nixpkgs",
  "source": "https://packages.debian.org/dhall-nixpkgs",
  "checks": [{ "type": "binary", "name": "dhall-nixpkgs" }],
  "install_guidance": {
    "plugin": "dhall-nixpkgs", "binary": "dhall-nixpkgs", "check": "which dhall-nixpkgs",
    "install_steps": ["apt-get install dhall-nixpkgs 2>/dev/null || which dhall-nixpkgs", "Verify: dhall-nixpkgs --version", "supercli plugins install ./plugins/dhall-nixpkgs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dhall-nixpkgs", "resource": "_", "action": "_",
    "description": "Passthrough to dhall-nixpkgs CLI",
    "adapter": "process", "adapterConfig": { "command": "dhall-nixpkgs", "passthrough": true, "missingDependencyHelp": "Install dhall-nixpkgs: apt-get install dhall-nixpkgs" }, "args": []
  }]
}
