{
  "name": "cuVSLAM",
  "version": "0.1.0",
  "description": "cuVSLAM: CUDA-Accelerated Visual Odometry and Mapping",
  "source": "https://github.com/cuVSLAM/cuVSLAM",
  "checks": [
    {
      "type": "binary",
      "name": "cuvslam"
    }
  ],
  "install_guidance": {
    "plugin": "cuVSLAM",
    "binary": "cuvslam",
    "check": "which cuvslam",
    "install_steps": [
      "pip install cuvslam",
      "Verify: cuvslam --version",
      "supercli plugins install ./plugins/cuVSLAM --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cuVSLAM",
      "resource": "self",
      "action": "version",
      "description": "Print cuVSLAM version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuvslam",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cuVSLAM: pip install cuvslam"
      },
      "args": []
    },
    {
      "namespace": "cuVSLAM",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cuvslam CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuvslam",
        "passthrough": true,
        "missingDependencyHelp": "Install cuVSLAM: pip install cuvslam"
      },
      "args": []
    }
  ]
}