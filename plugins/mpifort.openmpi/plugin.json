{
  "name": "mpifort.openmpi",
  "version": "0.1.0",
  "description": "CLI tool: mpifort.openmpi",
  "source": "https://manpages.debian.org/mpifort.openmpi",
  "checks": [
    {
      "type": "binary",
      "name": "mpifort.openmpi"
    }
  ],
  "install_guidance": {
    "plugin": "mpifort.openmpi",
    "binary": "mpifort.openmpi",
    "check": "which mpifort.openmpi",
    "install_steps": [
      "apt-get install mpifort.openmpi 2>/dev/null || which mpifort.openmpi",
      "Verify: mpifort.openmpi --version",
      "supercli plugins install ./plugins/mpifort.openmpi --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mpifort.openmpi",
      "resource": "self",
      "action": "version",
      "description": "Print mpifort.openmpi version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpifort.openmpi",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mpifort.openmpi: apt-get install mpifort.openmpi 2>/dev/null || which mpifort.openmpi"
      },
      "args": []
    },
    {
      "namespace": "mpifort.openmpi",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mpifort.openmpi CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mpifort.openmpi",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mpifort.openmpi: apt-get install mpifort.openmpi 2>/dev/null || which mpifort.openmpi"
      },
      "args": []
    }
  ]
}