{
  "name": "imdb-id",
  "version": "0.1.0",
  "description": "A CLI tool to retrieve IMDb movie and TV show identifiers. Looks up IMDb IDs by title, year, and other metadata for media database operations.",
  "source": "https://github.com",
  "checks": [
    {
      "type": "binary",
      "name": "imdb-id"
    }
  ],
  "install_guidance": {
    "plugin": "imdb-id",
    "binary": "imdb-id",
    "check": "which imdb-id",
    "install_steps": [
      "cargo install imdb-id",
      "Verify: imdb-id --version",
      "supercli plugins install ./plugins/imdb-id --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "imdb-id",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to imdb-id CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "imdb-id",
        "passthrough": true,
        "missingDependencyHelp": "Install imdb-id: cargo install imdb-id"
      },
      "args": []
    }
  ]
}
