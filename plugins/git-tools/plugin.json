{
  "name": "git-tools",
  "version": "0.1.0",
  "description": "Assorted git-related scripts and tools",
  "source": "https://github.com/MestreLion/git-tools",
  "checks": [
    {
      "type": "binary",
      "name": "git-tools"
    }
  ],
  "install_guidance": {
    "plugin": "git-tools",
    "binary": "git-tools",
    "check": "which git-tools",
    "install_steps": [
      "brew install git-tools",
      "Verify: git-tools --version",
      "supercli plugins install ./plugins/git-tools --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "git-tools",
      "resource": "self",
      "action": "version",
      "description": "Print git-tools version",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-tools",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install git-tools: brew install git-tools"
      },
      "args": []
    },
    {
      "namespace": "git-tools",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to git-tools CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "git-tools",
        "passthrough": true,
        "missingDependencyHelp": "Install git-tools"
      },
      "args": []
    }
  ]
}