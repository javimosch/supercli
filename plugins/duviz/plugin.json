{
  "name": "duviz",
  "version": "1.0.0",
  "description": "duviz \u2014 Disk usage viz",
  "source": "github.com/soxley/duviz",
  "checks": [
    {
      "type": "binary",
      "name": "duviz"
    }
  ],
  "install_guidance": {
    "plugin": "duviz",
    "binary": "duviz",
    "check": "which duviz",
    "install_steps": [
      "# Install duviz",
      "# See github.com/soxley/duviz",
      "# apt: sudo apt-get install duviz",
      "# brew: brew install duviz",
      "# cargo: cargo install duviz",
      "# npm: npm install -g duviz",
      "# pip: pip install duviz"
    ]
  },
  "commands": [
    {
      "namespace": "duviz",
      "resource": "duviz",
      "action": "run",
      "description": "Run duviz",
      "adapter": "process",
      "adapterConfig": {
        "command": "duviz",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install duviz from github.com/soxley/duviz"
      },
      "args": []
    }
  ]
}