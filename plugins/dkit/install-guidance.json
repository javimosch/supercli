{
  "plugin": "dkit",
  "binary": "dkit",
  "check": "which dkit",
  "install_steps": [
    "cargo install dkit",
    "Verify: dkit --version",
    "supercli plugins install ./plugins/dkit --on-conflict replace --json"
  ],
  "note": "Requires Rust toolchain. Alternatively, download a prebuilt binary from GitHub releases."
}
