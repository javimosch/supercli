{
  "name": "docker-compose-langserver",
  "version": "0.1.0",
  "description": "Language service for Docker Compose documents",
  "source": "https://github.com/microsoft/compose-language-service",
  "checks": [
    {
      "type": "binary",
      "name": "docker-compose-langserver"
    }
  ],
  "install_guidance": {
    "plugin": "docker-compose-langserver",
    "binary": "docker-compose-langserver",
    "check": "which docker-compose-langserver",
    "install_steps": [
      "brew install docker-compose-langserver",
      "Verify: docker-compose-langserver --version",
      "supercli plugins install ./plugins/docker-compose-langserver --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "docker-compose-langserver",
      "resource": "self",
      "action": "version",
      "description": "Print docker-compose-langserver version",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-compose-langserver",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install docker-compose-langserver: brew install docker-compose-langserver"
      },
      "args": []
    },
    {
      "namespace": "docker-compose-langserver",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to docker-compose-langserver CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "docker-compose-langserver",
        "passthrough": true,
        "missingDependencyHelp": "Install docker-compose-langserver"
      },
      "args": []
    }
  ]
}