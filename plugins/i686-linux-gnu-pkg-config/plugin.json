{
  "name": "i686-linux-gnu-pkg-config",
  "version": "0.1.0",
  "description": "CLI tool: i686-linux-gnu-pkg-config",
  "source": "https://manpages.debian.org/i686-linux-gnu-pkg-config",
  "checks": [
    {
      "type": "binary",
      "name": "i686-linux-gnu-pkg-config"
    }
  ],
  "install_guidance": {
    "plugin": "i686-linux-gnu-pkg-config",
    "binary": "i686-linux-gnu-pkg-config",
    "check": "which i686-linux-gnu-pkg-config",
    "install_steps": [
      "apt-get install i686-linux-gnu-pkg-config 2>/dev/null || which i686-linux-gnu-pkg-config",
      "Verify: i686-linux-gnu-pkg-config --version",
      "supercli plugins install ./plugins/i686-linux-gnu-pkg-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "i686-linux-gnu-pkg-config",
      "resource": "self",
      "action": "version",
      "description": "Print i686-linux-gnu-pkg-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "i686-linux-gnu-pkg-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install i686-linux-gnu-pkg-config: apt-get install i686-linux-gnu-pkg-config 2>/dev/null || which i686-linux-gnu-pkg-config"
      },
      "args": []
    },
    {
      "namespace": "i686-linux-gnu-pkg-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to i686-linux-gnu-pkg-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "i686-linux-gnu-pkg-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install i686-linux-gnu-pkg-config: apt-get install i686-linux-gnu-pkg-config 2>/dev/null || which i686-linux-gnu-pkg-config"
      },
      "args": []
    }
  ]
}