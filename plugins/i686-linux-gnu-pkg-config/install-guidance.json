{
  "plugin": "i686-linux-gnu-pkg-config",
  "binary": "i686-linux-gnu-pkg-config",
  "check": "which i686-linux-gnu-pkg-config",
  "install_steps": [
    "apt-get install i686-linux-gnu-pkg-config 2>/dev/null || which i686-linux-gnu-pkg-config",
