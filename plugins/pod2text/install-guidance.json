{
  "plugin": "pod2text",
  "binary": "pod2text",
  "check": "which pod2text",
  "install_steps": [
    "# Install pod2text",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/pod2text-linux-amd64 -o /usr/local/bin/pod2text",
    "chmod +x /usr/local/bin/pod2text",
    "# Or via package manager, see /usr/bin/pod2text"
  ]
}