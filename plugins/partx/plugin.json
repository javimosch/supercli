{
  "name": "partx",
  "version": "1.0.0",
  "description": "partx \u2014 partx \u2014 CLI utility",
  "source": "/usr/bin/partx",
  "checks": [
    {
      "type": "binary",
      "name": "partx"
    }
  ],
  "install_guidance": {
    "plugin": "partx",
    "binary": "partx",
    "check": "which partx",
    "install_steps": [
      "# Install partx:",
      "# apt: sudo apt-get install partx",
      "# brew: brew install partx",
      "# cargo: cargo install partx",
      "# npm: npm install -g partx",
      "# pip: pip install partx",
      "# or download from /usr/bin/partx"
    ]
  },
  "commands": [
    {
      "namespace": "partx",
      "resource": "partx",
      "action": "run",
      "description": "Run partx",
      "adapter": "process",
      "adapterConfig": {
        "command": "partx",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install partx from /usr/bin/partx"
      },
      "args": []
    }
  ]
