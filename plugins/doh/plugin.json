{
  "name": "doh",
  "version": "0.1.0",
  "description": "Stand-alone DNS-over-HTTPS resolver using libcurl",
  "source": "https://github.com/curl/doh",
  "checks": [
    {
      "type": "binary",
      "name": "doh"
    }
  ],
  "install_guidance": {
    "plugin": "doh",
    "binary": "doh",
    "check": "which doh",
    "install_steps": [
      "brew install doh",
      "Verify: doh --version",
      "supercli plugins install ./plugins/doh --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "doh",
      "resource": "self",
      "action": "version",
      "description": "Print doh version",
      "adapter": "process",
      "adapterConfig": {
        "command": "doh",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install doh: brew install doh"
      },
      "args": []
    },
    {
      "namespace": "doh",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to doh CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "doh",
        "passthrough": true,
        "missingDependencyHelp": "Install doh"
      },
      "args": []
    }
  ]
}