{
  "name": "wipe",
  "version": "0.1.0",
  "description": "wipe — secure file and directory deletion tool using various overwrite algorithms. Erases file contents before unlinking to prevent forensic recovery. Supports recursive directory wiping, filesystem-free space cleaning, and configurable overwrite passes.",
  "source": "https://github.com/berke/wipe",
  "checks": [
    {
      "type": "binary",
      "name": "wipe"
    }
  ],
  "install_guidance": {
    "plugin": "wipe",
    "binary": "wipe",
    "check": "which wipe",
    "install_steps": [
      "brew install wipe",
      "Verify: wipe --version",
      "supercli plugins install ./plugins/wipe --on-conflict replace --json"
    ]
  },
  "commands": [
    {
      "namespace": "wipe",
      "resource": "self",
      "action": "version",
      "description": "Print wipe version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wipe",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wipe: brew install wipe"
      },
      "args": []
    },
    {
      "namespace": "wipe",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wipe CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wipe",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wipe: brew install wipe"
      },
      "args": []
    }
  ]
}
