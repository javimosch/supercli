{
  "name": "OpenCode",
  "version": "0.1.0",
  "description": "CLI tool: OpenCode",
  "source": "https://manpages.debian.org/OpenCode",
  "checks": [
    {
      "type": "binary",
      "name": "OpenCode"
    }
  ],
  "install_guidance": {
    "plugin": "OpenCode",
    "binary": "OpenCode",
    "check": "which OpenCode",
    "install_steps": [
      "apt-get install OpenCode 2>/dev/null || which OpenCode",
      "Verify: OpenCode --version",
      "supercli plugins install ./plugins/OpenCode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenCode",
      "resource": "self",
      "action": "version",
      "description": "Print OpenCode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "OpenCode",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenCode: apt-get install OpenCode 2>/dev/null || which OpenCode"
      },
      "args": []
    },
    {
      "namespace": "OpenCode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to OpenCode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "OpenCode",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install OpenCode: apt-get install OpenCode 2>/dev/null || which OpenCode"
      },
      "args": []
    }
  ]
}