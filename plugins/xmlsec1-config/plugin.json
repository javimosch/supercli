{
  "name": "xmlsec1-config",
  "version": "0.1.0",
  "description": "CLI tool: xmlsec1-config",
  "source": "https://manpages.debian.org/xmlsec1-config",
  "checks": [
    {
      "type": "binary",
      "name": "xmlsec1-config"
    }
  ],
  "install_guidance": {
    "plugin": "xmlsec1-config",
    "binary": "xmlsec1-config",
    "check": "which xmlsec1-config",
    "install_steps": [
      "apt-get install xmlsec1-config 2>/dev/null || which xmlsec1-config",
      "Verify: xmlsec1-config --version",
      "supercli plugins install ./plugins/xmlsec1-config --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "xmlsec1-config",
      "resource": "self",
      "action": "version",
      "description": "Print xmlsec1-config version",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlsec1-config",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install xmlsec1-config: apt-get install xmlsec1-config 2>/dev/null || which xmlsec1-config"
      },
      "args": []
    },
    {
      "namespace": "xmlsec1-config",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to xmlsec1-config CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "xmlsec1-config",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install xmlsec1-config: apt-get install xmlsec1-config 2>/dev/null || which xmlsec1-config"
      },
      "args": []
    }
  ]
}