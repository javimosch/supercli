{
  "name": "sqlfmt",
  "version": "0.1.0",
  "description": "sqlfmt \u2014 SQL formatter with width-aware output",
  "source": "https://formulae.brew.sh/formula/sqlfmt",
  "checks": [
    {
      "type": "binary",
      "name": "sqlfmt"
    }
  ],
  "install_guidance": {
    "plugin": "sqlfmt",
    "binary": "sqlfmt",
    "check": "which sqlfmt",
    "install_steps": [
      "brew install sqlfmt"
    ],
    "note": "Utility tool."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sqlfmt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sqlfmt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqlfmt",
        "passthrough": true,
        "missingDependencyHelp": "Install sqlfmt: brew install sqlfmt"
      },
      "args": []
    }
  ]
}
