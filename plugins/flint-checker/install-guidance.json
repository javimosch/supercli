{
  "plugin": "flint-checker",
  "binary": "flint-checker",
  "check": "which flint-checker",
  "install_steps": [
    "brew install flint-checker",
    "Verify: flint-checker --version",
    "supercli plugins install ./plugins/flint-checker --on-conflict replace --json"
  ],
  "note": "Install from package manager"
}