{
  "name": "flint-checker",
  "version": "0.1.0",
  "description": "Check your project for common sources of contributor friction",
  "source": "https://github.com/pengwynn/flint",
  "checks": [
    {
      "type": "binary",
      "name": "flint-checker"
    }
  ],
  "install_guidance": {
    "plugin": "flint-checker",
    "binary": "flint-checker",
    "check": "which flint-checker",
    "install_steps": [
      "brew install flint-checker",
      "Verify: flint-checker --version",
      "supercli plugins install ./plugins/flint-checker --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "flint-checker",
      "resource": "self",
      "action": "version",
      "description": "Print flint-checker version",
      "adapter": "process",
      "adapterConfig": {
        "command": "flint-checker",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install flint-checker: brew install flint-checker"
      },
      "args": []
    },
    {
      "namespace": "flint-checker",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to flint-checker CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "flint-checker",
        "passthrough": true,
        "missingDependencyHelp": "Install flint-checker"
      },
      "args": []
    }
  ]
}