{
  "name": "ssh-config-edit",
  "version": "0.1.0",
  "description": "CLI tool for managing OpenSSH configuration files",
  "source": "brew",
  "checks": [{ "type": "binary", "name": "ssh-config-edit" }],
  "install_guidance": {
    "plugin": "ssh-config-edit",
    "binary": "ssh-config-edit",
    "check": "which ssh-config-edit",
    "install_steps": ["brew install ssh-config-edit", "Verify: ssh-config-edit --version", "supercli plugins install ./plugins/ssh-config-edit --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "ssh-config-edit",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to ssh-config-edit CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "ssh-config-edit",
      "passthrough": true,
      "missingDependencyHelp": "Install ssh-config-edit: brew install ssh-config-edit"
    },
    "args": []
  }]
}
