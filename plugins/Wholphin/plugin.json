{
  "name": "Wholphin",
  "version": "0.1.0",
  "description": "An OSS Android TV client for Jellyfin",
  "source": "https://github.com/Wholphin/Wholphin",
  "checks": [
    {
      "type": "binary",
      "name": "wholphin"
    }
  ],
  "install_guidance": {
    "plugin": "Wholphin",
    "binary": "wholphin",
    "check": "which wholphin",
    "install_steps": [
      "pip install wholphin",
      "Verify: wholphin --version",
      "supercli plugins install ./plugins/Wholphin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Wholphin",
      "resource": "self",
      "action": "version",
      "description": "Print Wholphin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wholphin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Wholphin: pip install wholphin"
      },
      "args": []
    },
    {
      "namespace": "Wholphin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wholphin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wholphin",
        "passthrough": true,
        "missingDependencyHelp": "Install Wholphin: pip install wholphin"
      },
      "args": []
    }
  ]
}