{
  "name": "circo",
  "version": "0.1.0",
  "description": "CLI tool: circo",
  "source": "https://packages.debian.org/circo",
  "checks": [{ "type": "binary", "name": "circo" }],
  "install_guidance": {
    "plugin": "circo", "binary": "circo", "check": "which circo",
    "install_steps": ["apt-get install circo 2>/dev/null || which circo", "Verify: circo --version", "supercli plugins install ./plugins/circo --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "circo", "resource": "_", "action": "_",
    "description": "Passthrough to circo CLI",
    "adapter": "process", "adapterConfig": { "command": "circo", "passthrough": true, "missingDependencyHelp": "Install circo: apt-get install circo" }, "args": []
  }]
}
