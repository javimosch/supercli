{
  "name": "home-assistant-floor-plan",
  "version": "0.1.0",
  "description": "Home Assistant Floor Plan Generator Plugin For Sweet Home 3D",
  "source": "https://github.com/home-assistant-floor-plan/home-assistant-floor-plan",
  "checks": [
    {
      "type": "binary",
      "name": "home-assistant-floor-plan"
    }
  ],
  "install_guidance": {
    "plugin": "home-assistant-floor-plan",
    "binary": "home-assistant-floor-plan",
    "check": "which home-assistant-floor-plan",
    "install_steps": [
      "pip install home-assistant-floor-plan",
      "Verify: home-assistant-floor-plan --version",
      "supercli plugins install ./plugins/home-assistant-floor-plan --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "home-assistant-floor-plan",
      "resource": "self",
      "action": "version",
      "description": "Print home-assistant-floor-plan version",
      "adapter": "process",
      "adapterConfig": {
        "command": "home-assistant-floor-plan",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install home-assistant-floor-plan: pip install home-assistant-floor-plan"
      },
      "args": []
    },
    {
      "namespace": "home-assistant-floor-plan",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to home-assistant-floor-plan CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "home-assistant-floor-plan",
        "passthrough": true,
        "missingDependencyHelp": "Install home-assistant-floor-plan: pip install home-assistant-floor-plan"
      },
      "args": []
    }
  ]
}