{
  "name": "scrumboy",
  "version": "0.1.0",
  "description": "Self-hosted kanban & project management — Docker, MCP, agent-ready boards",
  "source": "https://github.com/markrai/scrumboy",
  "checks": [
    { "type": "binary", "name": "docker" },
    { "type": "binary", "name": "curl" }
  ],
  "install_guidance": {
    "plugin": "scrumboy",
    "binary": "docker",
    "check": "docker --version && curl --version",
    "install_steps": [
      "Run: sc scrumboy self start  (pulls Docker image, starts on :8080)",
      "Then: sc scrumboy self mcp   (register MCP server for agent use)",
      "Open http://localhost:8080 in browser for the UI"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "scrumboy",
      "resource": "self",
      "action": "start",
      "description": "Start scrumboy Docker container",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/start.sh"],
        "timeout_ms": 120000,
        "missingDependencyHelp": "Install Docker: https://docs.docker.com/engine/install/"
      },
      "args": []
    },
    {
      "namespace": "scrumboy",
      "resource": "self",
      "action": "stop",
      "description": "Stop scrumboy Docker container",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/stop.sh"],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install Docker: https://docs.docker.com/engine/install/"
      },
      "args": []
    },
    {
      "namespace": "scrumboy",
      "resource": "self",
      "action": "status",
      "description": "Check scrumboy container status",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "baseArgs": ["-c", "OUT=$(docker ps --filter name=scrumboy --format '{{.Names}} {{.Status}}' 2>/dev/null); if [ -z \"$OUT\" ]; then echo 'not running'; else echo \"$OUT\"; fi"],
        "timeout_ms": 10000,
        "missingDependencyHelp": "Install Docker: https://docs.docker.com/engine/install/"
      },
      "args": []
    },
    {
      "namespace": "scrumboy",
      "resource": "self",
      "action": "mcp",
      "description": "Register scrumboy MCP server for agent interaction",
      "adapter": "process",
      "adapterConfig": {
        "command": "node",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/register-mcp.js"],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install scrumboy first: sc scrumboy self start"
      },
      "args": []
    },
    {
      "namespace": "scrumboy",
      "resource": "board",
      "action": "list",
      "description": "List all boards/projects",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/boards.sh"],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Start scrumboy first: sc scrumboy self start"
      },
      "args": []
    },
    {
      "namespace": "scrumboy",
      "resource": "todo",
      "action": "list",
      "description": "List todos for a project",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "cwd": "plugin_dir",
        "baseArgs": ["scripts/todos.sh"],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Start scrumboy first: sc scrumboy self start"
      },
      "args": [
        {"name": "project", "type": "string", "required": true, "description": "Project slug"}
      ]
    },
    {
      "namespace": "scrumboy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough for advanced MCP operations via curl",
      "adapter": "process",
      "adapterConfig": {
        "command": "bash",
        "cwd": "plugin_dir",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Start scrumboy first: sc scrumboy self start"
      },
      "args": []
    }
  ]
}
