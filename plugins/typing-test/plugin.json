{
  "name": "typing-test",
  "version": "0.1.0",
  "description": "Measure your words per minute in the terminal",
  "source": "https://github.com/suyash/typing-test",
  "checks": [{ "type": "binary", "name": "typing-test" }],
  "install_guidance": {
    "plugin": "typing-test",
    "binary": "typing-test",
    "check": "which typing-test",
    "install_steps": ["pip install typing-test", "Verify: typing-test --version", "supercli plugins install ./plugins/typing-test --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "typing-test",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to typing-test CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "typing-test",
      "passthrough": true,
      "missingDependencyHelp": "Install typing-test: pip install typing-test", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
