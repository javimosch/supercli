{
  "name": "docstring-gen",
  "version": "0.1.0",
  "description": "CLI for NLP-based docstring generation from source code",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "docstring-gen" }],
  "install_guidance": {
    "plugin": "docstring-gen",
    "binary": "docstring-gen",
    "check": "which docstring-gen",
    "install_steps": ["pip install docstring-gen", "Verify: docstring-gen --version", "supercli plugins install ./plugins/docstring-gen --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "docstring-gen",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to docstring-gen CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "docstring-gen",
      "passthrough": true,
      "missingDependencyHelp": "Install docstring-gen: pip install docstring-gen"
    },
    "args": []
  }]
}
