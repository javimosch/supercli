{
  "name": "gitlab-activity",
  "version": "1.0.0",
  "description": "Retrieve GitLab user activity for agents",
  "author": "javimosch",
  "binary": "gitlab-activity-cli",
  "check": "gitlab-activity-cli version",
  "commands": [
    {
      "name": "me",
      "description": "Get current user's GitLab activity",
      "usage": "gitlab-activity-cli me [options]",
      "examples": [
        "gitlab-activity-cli me",
        "gitlab-activity-cli me --days 7",
        "gitlab-activity-cli me --instance https://git.geored.fr --json"
      ]
    },
    {
      "name": "user",
      "description": "Get specific user's GitLab activity",
      "usage": "gitlab-activity-cli user <username> [options]",
      "examples": [
        "gitlab-activity-cli user jarancibia",
        "gitlab-activity-cli user jarancibia --days 3 --project georedv3"
      ]
    }
  ],
  "tags": ["gitlab", "activity", "devops", "api"],
  "category": "development"
}