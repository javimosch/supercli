{
  "name": "gitlab-activity",
  "version": "1.0.0",
  "author": "javimosch",
  "description": "Retrieve GitLab user activity for agents",
  "checks": [
    {
      "type": "binary",
      "name": "gitlab-activity-cli",
      "args": [
        "version"
      ]
    }
  ],
  "install_guidance": {
    "plugin": "gitlab-activity",
    "binary": "gitlab-activity-cli",
    "check": "gitlab-activity-cli version",
    "install_steps": [
      "cd ~/ai/supercli-clis/gitlab-activity-cli",
      "go build -ldflags \"-s -w\" -o gitlab-activity-cli main.go",
      "sudo cp gitlab-activity-cli /usr/local/bin/",
      "gitlab-activity-cli version"
    ],
    "note": "Requires Go 1.21+ to build from source. Auto-detects GitLab tokens from ~/.gitlab/ directory."
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "gitlab-activity",
      "resource": "activity",
      "action": "me",
      "description": "Get current user's GitLab activity",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitlab-activity-cli",
        "baseArgs": [
          "me"
        ],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gitlab-activity-cli: cd ~/ai/supercli-clis/gitlab-activity-cli"
      },
      "args": []
    },
    {
      "namespace": "gitlab-activity",
      "resource": "activity",
      "action": "user",
      "description": "Get specific user's GitLab activity",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitlab-activity-cli",
        "baseArgs": [
          "user"
        ],
        "positionalArgs": [
          "username"
        ],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gitlab-activity-cli: cd ~/ai/supercli-clis/gitlab-activity-cli"
      },
      "args": [
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "GitLab username",
          "positional": true
        }
      ]
    },
    {
      "namespace": "gitlab-activity",
      "resource": "self",
      "action": "version",
      "description": "Print gitlab-activity-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitlab-activity-cli",
        "baseArgs": [
          "version"
        ],
        "missingDependencyHelp": "Install gitlab-activity-cli: cd ~/ai/supercli-clis/gitlab-activity-cli"
      },
      "args": []
    },
    {
      "namespace": "gitlab-activity",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gitlab-activity-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gitlab-activity-cli",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install gitlab-activity-cli: cd ~/ai/supercli-clis/gitlab-activity-cli"
      },
      "args": []
    }
  ]
}
