{
  "name": "hdt",
  "version": "0.1.0",
  "description": "Header Dictionary Triples (HDT) is a compression format for RDF data",
  "source": "https://github.com/rdfhdt/hdt-cpp",
  "checks": [
    {
      "type": "binary",
      "name": "hdt"
    }
  ],
  "install_guidance": {
    "plugin": "hdt",
    "binary": "hdt",
    "check": "which hdt",
    "install_steps": [
      "brew install hdt",
      "Verify: hdt --version",
      "supercli plugins install ./plugins/hdt --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hdt",
      "resource": "self",
      "action": "version",
      "description": "Print hdt version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdt",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hdt: brew install hdt"
      },
      "args": []
    },
    {
      "namespace": "hdt",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hdt CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hdt",
        "passthrough": true,
        "missingDependencyHelp": "Install hdt"
      },
      "args": []
    }
  ]
}