{
  "name": "pax11publish",
  "version": "0.1.0",
  "description": "CLI tool: pax11publish",
  "source": "https://manpages.debian.org/pax11publish",
  "checks": [
    {
      "type": "binary",
      "name": "pax11publish"
    }
  ],
  "install_guidance": {
    "plugin": "pax11publish",
    "binary": "pax11publish",
    "check": "which pax11publish",
    "install_steps": [
      "apt-get install pax11publish 2>/dev/null || which pax11publish",
      "Verify: pax11publish --version",
      "supercli plugins install ./plugins/pax11publish --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pax11publish",
      "resource": "self",
      "action": "version",
      "description": "Print pax11publish version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pax11publish",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pax11publish: apt-get install pax11publish 2>/dev/null || which pax11publish"
      },
      "args": []
    },
    {
      "namespace": "pax11publish",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pax11publish CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pax11publish",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pax11publish: apt-get install pax11publish 2>/dev/null || which pax11publish"
      },
      "args": []
    }
  ]
}