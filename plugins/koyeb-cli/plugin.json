{
  "name": "koyeb-cli",
  "version": "0.1.0",
  "description": "Koyeb serverless platform CLI",
  "source": "https",
  "checks": [{"type": "binary", "name": "koyeb"}],
  "install_guidance": {
    "plugin": "koyeb-cli",
    "binary": "koyeb",
    "check": "which koyeb",
    "install_steps": [
      "brew install koyeb-cli",
      "Verify: koyeb --version",
      "supercli plugins install ./plugins/koyeb-cli --on-conflict replace --json"
    ]
  },
  "learn": {"file": "skills/quickstart/SKILL.md"},
  "commands": [
    {
      "namespace": "koyeb-cli",
      "resource": "self",
      "action": "version",
      "description": "Print koyeb-cli version",
      "adapter": "process",
      "adapterConfig": {"command": "koyeb", "baseArgs": ["--version"], "missingDependencyHelp": "Install koyeb-cli: brew install koyeb-cli"},
      "args": []
    },
    {
      "namespace": "koyeb-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to koyeb CLI",
      "adapter": "process",
      "adapterConfig": {"command": "koyeb", "passthrough": true, "missingDependencyHelp": "Install koyeb-cli: brew install koyeb-cli"},
      "args": []
    }
  ]
}
