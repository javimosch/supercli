{
  "name": "tt-cli",
  "version": "0.1.0",
  "description": "Lightweight CLI for logging time to project-based files",
  "source": "go",
  "checks": [{ "type": "binary", "name": "tt-cli" }],
  "install_guidance": {
    "plugin": "tt-cli",
    "binary": "tt-cli",
    "check": "which tt-cli",
    "install_steps": ["go install github.com/tt-cli@latest", "Verify: tt-cli --version", "supercli plugins install ./plugins/tt-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "tt-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to tt-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "tt-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install tt-cli: go install github.com/tt-cli@latest"
    },
    "args": []
  }]
}
