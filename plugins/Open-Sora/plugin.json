{
  "name": "Open-Sora",
  "version": "0.1.0",
  "description": "Open-Sora: Democratizing Efficient Video Production for All",
  "source": "https://github.com/Open-Sora/Open-Sora",
  "checks": [
    {
      "type": "binary",
      "name": "open-sora"
    }
  ],
  "install_guidance": {
    "plugin": "Open-Sora",
    "binary": "open-sora",
    "check": "which open-sora",
    "install_steps": [
      "pip install open-sora",
      "Verify: open-sora --version",
      "supercli plugins install ./plugins/Open-Sora --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "Open-Sora",
      "resource": "self",
      "action": "version",
      "description": "Print Open-Sora version",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-sora",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install Open-Sora: pip install open-sora"
      },
      "args": []
    },
    {
      "namespace": "Open-Sora",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to open-sora CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-sora",
        "passthrough": true,
        "missingDependencyHelp": "Install Open-Sora: pip install open-sora"
      },
      "args": []
    }
  ]
}