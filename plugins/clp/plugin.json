{
  "name": "clp",
  "version": "0.1.0",
  "description": "Linear programming solver",
  "source": "https://github.com/coin-or/Clp",
  "checks": [
    {
      "type": "binary",
      "name": "clp"
    }
  ],
  "install_guidance": {
    "plugin": "clp",
    "binary": "clp",
    "check": "which clp",
    "install_steps": [
      "brew install clp",
      "Verify: clp --version",
      "supercli plugins install ./plugins/clp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "clp",
      "resource": "self",
      "action": "version",
      "description": "Print clp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clp: brew install clp"
      },
      "args": []
    },
    {
      "namespace": "clp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clp",
        "passthrough": true,
        "missingDependencyHelp": "Install clp"
      },
      "args": []
    }
  ]
}