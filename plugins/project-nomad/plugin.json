{
  "name": "project-nomad",
  "version": "0.1.0",
  "description": "Project N.O.M.A.D, is a self-contained, offline survival computer packed with critical tools, knowle",
  "source": "https://github.com/project-nomad/project-nomad",
  "checks": [
    {
      "type": "binary",
      "name": "project-nomad"
    }
  ],
  "install_guidance": {
    "plugin": "project-nomad",
    "binary": "project-nomad",
    "check": "which project-nomad",
    "install_steps": [
      "pip install project-nomad",
      "Verify: project-nomad --version",
      "supercli plugins install ./plugins/project-nomad --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "project-nomad",
      "resource": "self",
      "action": "version",
      "description": "Print project-nomad version",
      "adapter": "process",
      "adapterConfig": {
        "command": "project-nomad",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install project-nomad: pip install project-nomad"
      },
      "args": []
    },
    {
      "namespace": "project-nomad",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to project-nomad CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "project-nomad",
        "passthrough": true,
        "missingDependencyHelp": "Install project-nomad: pip install project-nomad"
      },
      "args": []
    }
  ]
}