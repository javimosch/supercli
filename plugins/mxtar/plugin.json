{
  "name": "mxtar",
  "version": "0.1.0",
  "description": "CLI tool: mxtar",
  "source": "https://manpages.debian.org/mxtar",
  "checks": [
    {
      "type": "binary",
      "name": "mxtar"
    }
  ],
  "install_guidance": {
    "plugin": "mxtar",
    "binary": "mxtar",
    "check": "which mxtar",
    "install_steps": [
      "apt-get install mxtar 2>/dev/null || which mxtar",
      "Verify: mxtar --version",
      "supercli plugins install ./plugins/mxtar --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mxtar",
      "resource": "self",
      "action": "version",
      "description": "Print mxtar version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mxtar",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mxtar: apt-get install mxtar 2>/dev/null || which mxtar"
      },
      "args": []
    },
    {
      "namespace": "mxtar",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mxtar CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mxtar",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mxtar: apt-get install mxtar 2>/dev/null || which mxtar"
      },
      "args": []
    }
  ]
}