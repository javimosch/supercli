{
  "name": "cfn-diagram",
  "version": "0.1.0",
  "description": "Visualize CloudFormation/SAM/CDK stacks in JavaScript",
  "source": "https://github.com/nicedoc/cfn-diagram",
  "checks": [
    {
      "type": "binary",
      "name": "cfn-diagram"
    }
  ],
  "install_guidance": {
    "plugin": "cfn-diagram",
    "binary": "cfn-diagram",
    "check": "which cfn-diagram",
    "install_steps": [
      "npm install -g cfn-diagram",
      "Verify: cfn-diagram --version",
      "supercli plugins install ./plugins/cfn-diagram --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cfn-diagram",
      "resource": "self",
      "action": "version",
      "description": "Print cfn-diagram version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cfn-diagram",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cfn-diagram: npm install -g cfn-diagram"
      },
      "args": []
    },
    {
      "namespace": "cfn-diagram",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cfn-diagram CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cfn-diagram",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install cfn-diagram: npm install -g cfn-diagram"
      },
      "args": [
        {
          "name": "args",
          "type": "string",
          "required": false,
          "description": "Additional arguments"
        }
      ]
    }
  ]
}
