{
  "name": "quip-protocol-rs",
  "version": "0.1.0",
  "description": "A rust implementation of the Quip Protocol forked from Substrate",
  "source": "https://github.com/quip-protocol-rs/quip-protocol-rs",
  "checks": [
    {
      "type": "binary",
      "name": "quip-protocol-rs"
    }
  ],
  "install_guidance": {
    "plugin": "quip-protocol-rs",
    "binary": "quip-protocol-rs",
    "check": "which quip-protocol-rs",
    "install_steps": [
      "pip install quip-protocol-rs",
      "Verify: quip-protocol-rs --version",
      "supercli plugins install ./plugins/quip-protocol-rs --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "quip-protocol-rs",
      "resource": "self",
      "action": "version",
      "description": "Print quip-protocol-rs version",
      "adapter": "process",
      "adapterConfig": {
        "command": "quip-protocol-rs",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install quip-protocol-rs: pip install quip-protocol-rs"
      },
      "args": []
    },
    {
      "namespace": "quip-protocol-rs",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to quip-protocol-rs CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "quip-protocol-rs",
        "passthrough": true,
        "missingDependencyHelp": "Install quip-protocol-rs: pip install quip-protocol-rs"
      },
      "args": []
    }
  ]
}