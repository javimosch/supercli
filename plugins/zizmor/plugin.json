{
  "name": "zizmor",
  "version": "0.1.0",
  "description": "Static analysis for GitHub Actions",
  "source": "https://github.com/zizmor/zizmor",
  "checks": [
    {
      "type": "binary",
      "name": "zizmor"
    }
  ],
  "install_guidance": {
    "plugin": "zizmor",
    "binary": "zizmor",
    "check": "which zizmor",
    "install_steps": [
      "pip install zizmor",
      "Verify: zizmor --version",
      "supercli plugins install ./plugins/zizmor --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "zizmor",
      "resource": "self",
      "action": "version",
      "description": "Print zizmor version",
      "adapter": "process",
      "adapterConfig": {
        "command": "zizmor",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install zizmor: pip install zizmor"
      },
      "args": []
    },
    {
      "namespace": "zizmor",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to zizmor CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "zizmor",
        "passthrough": true,
        "missingDependencyHelp": "Install zizmor: pip install zizmor"
      },
      "args": []
    }
  ]
}