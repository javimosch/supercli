{
  "name": "cherry-studio",
  "version": "0.1.0",
  "description": "AI productivity studio with smart chat, autonomous agents, and 300+ assistants. Unified access to fr",
  "source": "https://github.com/cherry-studio/cherry-studio",
  "checks": [
    {
      "type": "binary",
      "name": "cherry-studio"
    }
  ],
  "install_guidance": {
    "plugin": "cherry-studio",
    "binary": "cherry-studio",
    "check": "which cherry-studio",
    "install_steps": [
      "pip install cherry-studio",
      "Verify: cherry-studio --version",
      "supercli plugins install ./plugins/cherry-studio --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cherry-studio",
      "resource": "self",
      "action": "version",
      "description": "Print cherry-studio version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cherry-studio",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cherry-studio: pip install cherry-studio"
      },
      "args": []
    },
    {
      "namespace": "cherry-studio",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cherry-studio CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cherry-studio",
        "passthrough": true,
        "missingDependencyHelp": "Install cherry-studio: pip install cherry-studio"
      },
      "args": []
    }
  ]
}