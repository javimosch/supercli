{
  "name": "pbmtoybm",
  "version": "0.1.0",
  "description": "CLI tool: pbmtoybm",
  "source": "https://manpages.debian.org/pbmtoybm",
  "checks": [
    {
      "type": "binary",
      "name": "pbmtoybm"
    }
  ],
  "install_guidance": {
    "plugin": "pbmtoybm",
    "binary": "pbmtoybm",
    "check": "which pbmtoybm",
    "install_steps": [
      "apt-get install pbmtoybm 2>/dev/null || which pbmtoybm",
      "Verify: pbmtoybm --version",
      "supercli plugins install ./plugins/pbmtoybm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pbmtoybm",
      "resource": "self",
      "action": "version",
      "description": "Print pbmtoybm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoybm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pbmtoybm: apt-get install pbmtoybm 2>/dev/null || which pbmtoybm"
      },
      "args": []
    },
    {
      "namespace": "pbmtoybm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pbmtoybm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pbmtoybm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pbmtoybm: apt-get install pbmtoybm 2>/dev/null || which pbmtoybm"
      },
      "args": []
    }
  ]
}