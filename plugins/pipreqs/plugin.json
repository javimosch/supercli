{
  "name": "pipreqs",
  "version": "0.1.0",
  "description": "Generate requirements.txt based on imports",
  "source": "https://github.com/bndr/pipreqs",
  "checks": [{ "type": "binary", "name": "pipreqs" }],
  "install_guidance": {
    "plugin": "pipreqs",
    "binary": "pipreqs",
    "check": "which pipreqs",
    "install_steps": ["pip install pipreqs", "Verify: pipreqs --version", "supercli plugins install ./plugins/pipreqs --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "pipreqs",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to pipreqs CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "pipreqs",
      "passthrough": true,
      "missingDependencyHelp": "Install pipreqs: pip install pipreqs", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
