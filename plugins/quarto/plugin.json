{
  "name": "quarto",
  "description": "Open-source scientific and technical publishing system built on Pandoc",
  "version": "1.9.37",
  "binary": "quarto",
  "check": "quarto --version",
  "install": {
    "method": "custom",
    "command": "Download .deb/.rpm/.tar.gz from https://github.com/quarto-dev/quarto-cli/releases/latest"
  },
  "commands": {
    "render": {
      "command": "quarto render {file}",
      "description": "Render a document to various formats",
      "args": ["file"]
    },
    "preview": {
      "command": "quarto preview {file}",
      "description": "Preview a document with live reload",
      "args": ["file"]
    },
    "create": {
      "command": "quarto create {type}",
      "description": "Create a new project (project, document, extension)",
      "args": ["type"]
    },
    "convert": {
      "command": "quarto convert {file}",
      "description": "Convert between .qmd and .ipynb formats",
      "args": ["file"]
    },
    "check": {
      "command": "quarto check",
      "description": "Verify Quarto installation and dependencies"
    }
  }
}
