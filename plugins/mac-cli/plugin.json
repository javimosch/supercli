{
  "name": "mac-cli",
  "version": "0.1.0",
  "description": "Automation suite for common macOS system tasks",
  "source": "https://github.com/guarinogabriel/mac-cli",
  "checks": [{ "type": "binary", "name": "mac-cli" }],
  "install_guidance": {
    "plugin": "mac-cli",
    "binary": "mac-cli",
    "check": "which mac-cli",
    "install_steps": ["sh -c curl installer", "Verify: mac-cli --version", "supercli plugins install ./plugins/mac-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "mac-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to mac-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "mac-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install mac-cli: sh -c curl installer", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
