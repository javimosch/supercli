{
  "name": "fff",
  "version": "0.1.0",
  "description": "The fastest and the most accurate file search toolkit for AI agents, Neovim, Rust, C, and NodeJS",
  "source": "https://github.com/fff/fff",
  "checks": [
    {
      "type": "binary",
      "name": "fff"
    }
  ],
  "install_guidance": {
    "plugin": "fff",
    "binary": "fff",
    "check": "which fff",
    "install_steps": [
      "pip install fff",
      "Verify: fff --version",
      "supercli plugins install ./plugins/fff --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fff",
      "resource": "self",
      "action": "version",
      "description": "Print fff version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fff",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fff: pip install fff"
      },
      "args": []
    },
    {
      "namespace": "fff",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fff CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fff",
        "passthrough": true,
        "missingDependencyHelp": "Install fff: pip install fff"
      },
      "args": []
    }
  ]
}