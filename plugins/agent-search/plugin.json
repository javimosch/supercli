{
  "name": "agent-search",
  "version": "0.1.0",
  "description": "Multi-provider web search CLI for AI agents. Aggregates Brave, Serper, Exa, Jina, Firecrawl, Tavily, SerpApi, Perplexity, xAI, and more into one unified search interface with structured JSON output, semantic exit codes, and parallel fan-out.",
  "source": "https://github.com/paperfoot/search-cli",
  "checks": [
    { "type": "binary", "name": "search" }
  ],
  "install_guidance": {
    "plugin": "agent-search",
    "binary": "search",
    "check": "search --version",
    "install_steps": [
      "cargo install agent-search",
      "Verify: search --version",
      "supercli plugins install ./plugins/agent-search --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "search",
      "resource": "self",
      "action": "version",
      "description": "Print search version",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": []
    },
    {
      "namespace": "search",
      "resource": "query",
      "action": "auto",
      "description": "Search with automatic mode detection",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": [],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search query" }
      ]
    },
    {
      "namespace": "search",
      "resource": "query",
      "action": "mode",
      "description": "Search with specific mode",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": [],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search query" },
        { "name": "mode", "type": "string", "required": false, "description": "Search mode: auto, general, news, academic, people, deep, scholar, patents, images, places, extract, scrape, similar, social" }
      ]
    },
    {
      "namespace": "search",
      "resource": "query",
      "action": "provider",
      "description": "Search with specific provider(s)",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": [],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search query" },
        { "name": "provider", "type": "string", "required": false, "description": "Provider(s): brave, serper, exa, jina, firecrawl, tavily, serpapi, perplexity, xai (comma-separated)" }
      ]
    },
    {
      "namespace": "search",
      "resource": "query",
      "action": "json",
      "description": "Search with JSON output",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": ["--json"],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": [
        { "name": "query", "type": "string", "required": true, "description": "Search query" }
      ]
    },
    {
      "namespace": "search",
      "resource": "url",
      "action": "extract",
      "description": "Extract full text from URL",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": [],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 60000,
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": [
        { "name": "url", "type": "string", "required": true, "description": "URL to extract" },
        { "name": "mode", "type": "string", "required": false, "description": "Mode: extract (default)" }
      ]
    },
    {
      "namespace": "search",
      "resource": "config",
      "action": "set",
      "description": "Set API key",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": ["config", "set"],
        "passthrough": true,
        "cwd": "invoke_cwd",
        "timeout_ms": 10000,
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": [
        { "name": "key", "type": "string", "required": true, "description": "Key to set (e.g., keys.brave, keys.serper)" },
        { "name": "value", "type": "string", "required": true, "description": "API key value" }
      ]
    },
    {
      "namespace": "search",
      "resource": "config",
      "action": "show",
      "description": "Show current configuration",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "baseArgs": ["config", "show"],
        "passthrough": false,
        "cwd": "invoke_cwd",
        "timeout_ms": 10000,
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": []
    },
    {
      "namespace": "search",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to search CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "search",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install agent-search: cargo install agent-search"
      },
      "args": []
    }
  ]
}