{
  "name": "strip-json-comments-cli",
  "version": "0.1.0",
  "description": "Strip comments from JSON",
  "source": "https://github.com/sindresorhus/strip-json-comments-cli",
  "checks": [
    {
      "type": "binary",
      "name": "strip-json-comments-cli"
    }
  ],
  "install_guidance": {
    "plugin": "strip-json-comments-cli",
    "binary": "strip-json-comments-cli",
    "check": "which strip-json-comments-cli",
    "install_steps": [
      "npm install -g strip-json-comments-cli",
      "Verify: strip-json-comments-cli --version",
      "supercli plugins install ./plugins/strip-json-comments-cli --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "strip-json-comments-cli",
      "resource": "self",
      "action": "version",
      "description": "Print strip-json-comments-cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "strip-json-comments-cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install strip-json-comments-cli: npm install -g strip-json-comments-cli"
      },
      "args": []
    },
    {
      "namespace": "strip-json-comments-cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to strip-json-comments-cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "strip-json-comments-cli",
        "passthrough": true,
        "missingDependencyHelp": "Install strip-json-comments-cli"
      },
      "args": []
    }
  ]
}