{
  "name": "extractbb",
  "version": "0.1.0",
  "description": "CLI tool: extractbb",
  "source": "https://manpages.debian.org/extractbb",
  "checks": [
    {
      "type": "binary",
      "name": "extractbb"
    }
  ],
  "install_guidance": {
    "plugin": "extractbb",
    "binary": "extractbb",
    "check": "which extractbb",
    "install_steps": [
      "apt-get install extractbb 2>/dev/null || which extractbb",
      "Verify: extractbb --version",
      "supercli plugins install ./plugins/extractbb --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "extractbb",
      "resource": "self",
      "action": "version",
      "description": "Print extractbb version",
      "adapter": "process",
      "adapterConfig": {
        "command": "extractbb",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install extractbb: apt-get install extractbb 2>/dev/null || which extractbb"
      },
      "args": []
    },
    {
      "namespace": "extractbb",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to extractbb CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "extractbb",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install extractbb: apt-get install extractbb 2>/dev/null || which extractbb"
      },
      "args": []
    }
  ]
}