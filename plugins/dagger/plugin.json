{
  "name": "dagger",
  "version": "0.1.0",
  "description": "CI/CD pipeline engine that runs in containers",
  "source": "https://github.com/dagger/dagger",
  "checks": [{ "type": "binary", "name": "dagger" }],
  "install_guidance": {
    "plugin": "dagger",
    "binary": "dagger",
    "check": "which dagger",
    "install_steps": ["brew install dagger", "Verify: dagger --version", "supercli plugins install ./plugins/dagger --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dagger",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dagger CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dagger",
      "passthrough": true,
      "missingDependencyHelp": "Install dagger: brew install dagger"
    },
    "args": []
  }]
}
