{
  "name": "rawtopgm",
  "version": "0.1.0",
  "description": "CLI tool: rawtopgm",
  "source": "https://manpages.debian.org/rawtopgm",
  "checks": [
    {
      "type": "binary",
      "name": "rawtopgm"
    }
  ],
  "install_guidance": {
    "plugin": "rawtopgm",
    "binary": "rawtopgm",
    "check": "which rawtopgm",
    "install_steps": [
      "apt-get install rawtopgm 2>/dev/null || which rawtopgm",
      "Verify: rawtopgm --version",
      "supercli plugins install ./plugins/rawtopgm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "rawtopgm",
      "resource": "self",
      "action": "version",
      "description": "Print rawtopgm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "rawtopgm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install rawtopgm: apt-get install rawtopgm 2>/dev/null || which rawtopgm"
      },
      "args": []
    },
    {
      "namespace": "rawtopgm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to rawtopgm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "rawtopgm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install rawtopgm: apt-get install rawtopgm 2>/dev/null || which rawtopgm"
      },
      "args": []
    }
  ]
}