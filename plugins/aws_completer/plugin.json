{
  "name": "aws_completer",
  "version": "0.1.0",
  "description": "CLI tool: aws_completer",
  "source": "https://packages.debian.org/aws_completer",
  "checks": [{ "type": "binary", "name": "aws_completer" }],
  "install_guidance": {
    "plugin": "aws_completer", "binary": "aws_completer", "check": "which aws_completer",
    "install_steps": ["apt-get install aws_completer 2>/dev/null || which aws_completer", "Verify: aws_completer --version", "supercli plugins install ./plugins/aws_completer --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aws_completer", "resource": "_", "action": "_",
    "description": "Passthrough to aws_completer CLI",
    "adapter": "process", "adapterConfig": { "command": "aws_completer", "passthrough": true, "missingDependencyHelp": "Install aws_completer: apt-get install aws_completer" }, "args": []
  }]
}
