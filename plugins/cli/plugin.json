{
  "name": "cli",
  "version": "0.1.0",
  "description": "Google Workspace CLI \u2014 one command-line tool for Drive, Gmail, Calendar, Sheets, Docs, Chat, Admin, and more. Dynamically built from Google Discovery Service. Includes AI agent skills.",
  "source": "https://github.com/cli/cli",
  "checks": [
    {
      "type": "binary",
      "name": "cli"
    }
  ],
  "install_guidance": {
    "plugin": "cli",
    "binary": "cli",
    "check": "which cli",
    "install_steps": [
      "pip install cli",
      "Verify: cli --version",
      "supercli plugins install ./plugins/cli --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cli",
      "resource": "self",
      "action": "version",
      "description": "Print cli version",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install cli: pip install cli"
      },
      "args": []
    },
    {
      "namespace": "cli",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to cli CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "cli",
        "passthrough": true,
        "missingDependencyHelp": "Install cli: pip install cli"
      },
      "args": []
    }
  ]
}