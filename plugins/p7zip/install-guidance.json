{
  "plugin": "p7zip",
  "binary": "p7zip",
  "check": "which p7zip",
  "install_steps": [
    "# Install p7zip",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/p7zip-linux-amd64 -o /usr/local/bin/p7zip",
    "chmod +x /usr/local/bin/p7zip",
    "# Or via package manager, see p7zip.sourceforge.net"
  ]
}