{
  "name": "p7zip",
  "version": "1.0.0",
  "description": "p7zip \u2014 7-zip archive utility",
  "source": "p7zip.sourceforge.net",
  "checks": [
    {
      "type": "binary",
      "name": "p7zip"
    }
  ],
  "install_guidance": {
    "plugin": "p7zip",
    "binary": "p7zip",
    "check": "which p7zip",
    "install_steps": [
      "# Install p7zip:",
      "# apt: sudo apt-get install p7zip",
      "# brew: brew install p7zip",
      "# cargo: cargo install p7zip",
      "# npm: npm install -g p7zip",
      "# pip: pip install p7zip",
      "# or download from p7zip.sourceforge.net"
    ]
  },
  "commands": [
    {
      "namespace": "p7zip",
      "resource": "p7zip",
      "action": "run",
      "description": "Run p7zip",
      "adapter": "process",
      "adapterConfig": {
        "command": "p7zip",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install p7zip from p7zip.sourceforge.net"
      },
      "args": []
    }
  ]
}