{
  "name": "slowql-analyze",
  "version": "0.1.0",
  "description": "CLI tool: slowql-analyze",
  "source": "https://manpages.debian.org/slowql-analyze",
  "checks": [
    {
      "type": "binary",
      "name": "slowql-analyze"
    }
  ],
  "install_guidance": {
    "plugin": "slowql-analyze",
    "binary": "slowql-analyze",
    "check": "which slowql-analyze",
    "install_steps": [
      "apt-get install slowql-analyze 2>/dev/null || which slowql-analyze",
      "Verify: slowql-analyze --version",
      "supercli plugins install ./plugins/slowql-analyze --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "slowql-analyze",
      "resource": "self",
      "action": "version",
      "description": "Print slowql-analyze version",
      "adapter": "process",
      "adapterConfig": {
        "command": "slowql-analyze",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install slowql-analyze: apt-get install slowql-analyze 2>/dev/null || which slowql-analyze"
      },
      "args": []
    },
    {
      "namespace": "slowql-analyze",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to slowql-analyze CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "slowql-analyze",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install slowql-analyze: apt-get install slowql-analyze 2>/dev/null || which slowql-analyze"
      },
      "args": []
    }
  ]
}