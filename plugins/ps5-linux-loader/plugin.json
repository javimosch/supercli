{
  "name": "ps5-linux-loader",
  "version": "0.1.0",
  "description": "Linux payload implementing HV exploits to run a custom bootloader",
  "source": "https://github.com/ps5-linux-loader/ps5-linux-loader",
  "checks": [
    {
      "type": "binary",
      "name": "ps5-linux-loader"
    }
  ],
  "install_guidance": {
    "plugin": "ps5-linux-loader",
    "binary": "ps5-linux-loader",
    "check": "which ps5-linux-loader",
    "install_steps": [
      "pip install ps5-linux-loader",
      "Verify: ps5-linux-loader --version",
      "supercli plugins install ./plugins/ps5-linux-loader --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ps5-linux-loader",
      "resource": "self",
      "action": "version",
      "description": "Print ps5-linux-loader version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps5-linux-loader",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ps5-linux-loader: pip install ps5-linux-loader"
      },
      "args": []
    },
    {
      "namespace": "ps5-linux-loader",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ps5-linux-loader CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ps5-linux-loader",
        "passthrough": true,
        "missingDependencyHelp": "Install ps5-linux-loader: pip install ps5-linux-loader"
      },
      "args": []
    }
  ]
}