{
  "name": "cansniffer",
  "version": "0.1.0",
  "description": "CLI tool: cansniffer",
  "source": "https://packages.debian.org/cansniffer",
  "checks": [{ "type": "binary", "name": "cansniffer" }],
  "install_guidance": {
    "plugin": "cansniffer", "binary": "cansniffer", "check": "which cansniffer",
    "install_steps": ["apt-get install cansniffer 2>/dev/null || which cansniffer", "Verify: cansniffer --version", "supercli plugins install ./plugins/cansniffer --on-conflict replace --json"]
