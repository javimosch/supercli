{
  "name": "mlx-swift-examples",
  "version": "0.1.0",
  "description": "Examples using MLX Swift",
  "source": "https://github.com/mlx-swift-examples/mlx-swift-examples",
  "checks": [
    {
      "type": "binary",
      "name": "mlx-swift-examples"
    }
  ],
  "install_guidance": {
    "plugin": "mlx-swift-examples",
    "binary": "mlx-swift-examples",
    "check": "which mlx-swift-examples",
    "install_steps": [
      "pip install mlx-swift-examples",
      "Verify: mlx-swift-examples --version",
      "supercli plugins install ./plugins/mlx-swift-examples --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mlx-swift-examples",
      "resource": "self",
      "action": "version",
      "description": "Print mlx-swift-examples version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mlx-swift-examples",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mlx-swift-examples: pip install mlx-swift-examples"
      },
      "args": []
    },
    {
      "namespace": "mlx-swift-examples",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mlx-swift-examples CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mlx-swift-examples",
        "passthrough": true,
        "missingDependencyHelp": "Install mlx-swift-examples: pip install mlx-swift-examples"
      },
      "args": []
    }
  ]
}