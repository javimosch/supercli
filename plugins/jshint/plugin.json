{
  "name": "jshint",
  "version": "1.0.0",
  "description": "jshint \u2014 JS linter",
  "source": "jshint.com",
  "checks": [
    {
      "type": "binary",
      "name": "jshint"
    }
  ],
  "install_guidance": {
    "plugin": "jshint",
    "binary": "jshint",
    "check": "which jshint",
    "install_steps": [
      "# Install jshint",
      "# See jshint.com",
      "# apt: sudo apt-get install jshint",
      "# brew: brew install jshint",
      "# cargo: cargo install jshint",
      "# npm: npm install -g jshint",
      "# pip: pip install jshint"
    ]
  },
  "commands": [
    {
      "namespace": "jshint",
      "resource": "jshint",
      "action": "run",
      "description": "Run jshint",
      "adapter": "process",
      "adapterConfig": {
        "command": "jshint",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install jshint from jshint.com"
      },
      "args": []
    }
  ]
}