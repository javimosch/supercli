{
  "name": "fixtpps",
  "version": "0.1.0",
  "description": "CLI tool: fixtpps",
  "source": "https://manpages.debian.org/fixtpps",
  "checks": [
    {
      "type": "binary",
      "name": "fixtpps"
    }
  ],
  "install_guidance": {
    "plugin": "fixtpps",
    "binary": "fixtpps",
    "check": "which fixtpps",
    "install_steps": [
      "apt-get install fixtpps 2>/dev/null || which fixtpps",
      "Verify: fixtpps --version",
      "supercli plugins install ./plugins/fixtpps --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fixtpps",
      "resource": "self",
      "action": "version",
      "description": "Print fixtpps version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixtpps",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fixtpps: apt-get install fixtpps 2>/dev/null || which fixtpps"
      },
      "args": []
    },
    {
      "namespace": "fixtpps",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fixtpps CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fixtpps",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install fixtpps: apt-get install fixtpps 2>/dev/null || which fixtpps"
      },
      "args": []
    }
  ]
}