{
  "name": "go-cliview",
  "version": "0.1.0",
  "description": "Print Go objects in different CLI views",
  "source": "https://github.com/go-cliview/go-cliview",
  "checks": [
    {
      "type": "binary",
      "name": "go-cliview"
    }
  ],
  "install_guidance": {
    "plugin": "go-cliview",
    "binary": "go-cliview",
    "check": "which go-cliview",
    "install_steps": [
      "Check GitHub repository for installation instructions",
      "Verify: go-cliview --version",
      "supercli plugins install ./plugins/go-cliview --on-conflict replace --json"
    ],
    "note": "Go language CLI tool"
  },
  "commands": [
    {
      "namespace": "go-cliview",
      "resource": "self",
      "action": "version",
      "description": "Print go-cliview version",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-cliview",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install go-cliview from project repository"
      },
      "args": []
    },
    {
      "namespace": "go-cliview",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to go-cliview CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "go-cliview",
        "passthrough": true,
        "missingDependencyHelp": "Install go-cliview from project repository"
      },
      "args": []
    }
  ]
}