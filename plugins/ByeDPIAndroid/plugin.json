{
  "name": "ByeDPIAndroid",
  "version": "0.1.0",
  "description": "App to bypass censorship on Android",
  "source": "https://github.com/ByeDPIAndroid/ByeDPIAndroid",
  "checks": [
    {
      "type": "binary",
      "name": "byedpiandroid"
    }
  ],
  "install_guidance": {
    "plugin": "ByeDPIAndroid",
    "binary": "byedpiandroid",
    "check": "which byedpiandroid",
    "install_steps": [
      "pip install byedpiandroid",
      "Verify: byedpiandroid --version",
      "supercli plugins install ./plugins/ByeDPIAndroid --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ByeDPIAndroid",
      "resource": "self",
      "action": "version",
      "description": "Print ByeDPIAndroid version",
      "adapter": "process",
      "adapterConfig": {
        "command": "byedpiandroid",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ByeDPIAndroid: pip install byedpiandroid"
      },
      "args": []
    },
    {
      "namespace": "ByeDPIAndroid",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to byedpiandroid CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "byedpiandroid",
        "passthrough": true,
        "missingDependencyHelp": "Install ByeDPIAndroid: pip install byedpiandroid"
      },
      "args": []
    }
  ]
}