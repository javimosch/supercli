{
  "name": "ilbmtoppm",
  "version": "0.1.0",
  "description": "CLI tool: ilbmtoppm",
  "source": "https://manpages.debian.org/ilbmtoppm",
  "checks": [
    {
      "type": "binary",
      "name": "ilbmtoppm"
    }
  ],
  "install_guidance": {
    "plugin": "ilbmtoppm",
    "binary": "ilbmtoppm",
    "check": "which ilbmtoppm",
    "install_steps": [
      "apt-get install ilbmtoppm 2>/dev/null || which ilbmtoppm",
      "Verify: ilbmtoppm --version",
      "supercli plugins install ./plugins/ilbmtoppm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ilbmtoppm",
      "resource": "self",
      "action": "version",
      "description": "Print ilbmtoppm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ilbmtoppm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ilbmtoppm: apt-get install ilbmtoppm 2>/dev/null || which ilbmtoppm"
      },
      "args": []
    },
    {
      "namespace": "ilbmtoppm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ilbmtoppm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ilbmtoppm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ilbmtoppm: apt-get install ilbmtoppm 2>/dev/null || which ilbmtoppm"
      },
      "args": []
    }
  ]
}