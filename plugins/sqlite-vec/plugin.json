{
  "name": "sqlite-vec",
  "version": "0.1.0",
  "description": "A vector search SQLite extension that runs anywhere!",
  "source": "https://github.com/sqlite-vec/sqlite-vec",
  "checks": [
    {
      "type": "binary",
      "name": "sqlite-vec"
    }
  ],
  "install_guidance": {
    "plugin": "sqlite-vec",
    "binary": "sqlite-vec",
    "check": "which sqlite-vec",
    "install_steps": [
      "pip install sqlite-vec",
      "Verify: sqlite-vec --version",
      "supercli plugins install ./plugins/sqlite-vec --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "sqlite-vec",
      "resource": "self",
      "action": "version",
      "description": "Print sqlite-vec version",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqlite-vec",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install sqlite-vec: pip install sqlite-vec"
      },
      "args": []
    },
    {
      "namespace": "sqlite-vec",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to sqlite-vec CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "sqlite-vec",
        "passthrough": true,
        "missingDependencyHelp": "Install sqlite-vec: pip install sqlite-vec"
      },
      "args": []
    }
  ]
}