{
  "name": "clibrowser",
  "version": "0.1.0",
  "description": "Zero-dependency CLI browser for AI agents — single Rust binary, 23 commands, JSON output",
  "source": "https://github.com/allthingssecurity/clibrowser",
  "checks": [
    {
      "type": "binary",
      "name": "clibrowser"
    }
  ],
  "install_guidance": {
    "plugin": "clibrowser",
    "binary": "clibrowser",
    "check": "which clibrowser",
    "install_steps": [
      "cargo install clibrowser",
      "Verify: clibrowser --version",
      "supercli plugins install ./plugins/clibrowser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "clibrowser",
      "resource": "self",
      "action": "version",
      "description": "Print clibrowser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "clibrowser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install clibrowser: cargo install clibrowser"
      },
      "args": []
    },
    {
      "namespace": "clibrowser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to clibrowser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "clibrowser",
        "passthrough": true,
        "missingDependencyHelp": "Install clibrowser: cargo install clibrowser"
      },
      "args": []
    }
  ]
}
