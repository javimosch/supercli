{
  "name": "hermes-desktop",
  "version": "0.1.0",
  "description": "The safest, simplest way to manage Hermes from your Mac. Pure SSH. No gateways, no exposed ports, no",
  "source": "https://github.com/hermes-desktop/hermes-desktop",
  "checks": [
    {
      "type": "binary",
      "name": "hermes-desktop"
    }
  ],
  "install_guidance": {
    "plugin": "hermes-desktop",
    "binary": "hermes-desktop",
    "check": "which hermes-desktop",
    "install_steps": [
      "pip install hermes-desktop",
      "Verify: hermes-desktop --version",
      "supercli plugins install ./plugins/hermes-desktop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "hermes-desktop",
      "resource": "self",
      "action": "version",
      "description": "Print hermes-desktop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hermes-desktop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hermes-desktop: pip install hermes-desktop"
      },
      "args": []
    },
    {
      "namespace": "hermes-desktop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hermes-desktop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hermes-desktop",
        "passthrough": true,
        "missingDependencyHelp": "Install hermes-desktop: pip install hermes-desktop"
      },
      "args": []
    }
  ]
}