{
  "name": "octocode",
  "version": "0.1.0",
  "description": "Code Search",
  "source": "https://github.com/Muvon/octocode",
  "checks": [
    { "type": "binary", "name": "octocode" }
  ],
  "install_guidance": {
    "plugin": "octocode",
    "binary": "octocode",
    "check": "which octocode",
    "install_steps": [
      "cargo install octocode",
      "Verify: octocode --version",
      "supercli plugins install ./plugins/octocode --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "octocode",
      "resource": "self",
      "action": "version",
      "description": "Print octocode version",
      "adapter": "process",
      "adapterConfig": {
        "command": "octocode",
        "baseArgs": ["--version"],
        "missingDependencyHelp": "Install octocode: cargo install octocode"
      },
      "args": []
    },
    {
      "namespace": "octocode",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to octocode CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "octocode",
        "passthrough": true,
        "missingDependencyHelp": "Install octocode"
      },
      "args": []
    }
  ]
}
