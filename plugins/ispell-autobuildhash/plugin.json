{
  "name": "ispell-autobuildhash",
  "version": "0.1.0",
  "description": "CLI tool: ispell-autobuildhash",
  "source": "https://manpages.debian.org/ispell-autobuildhash",
  "checks": [
    {
      "type": "binary",
      "name": "ispell-autobuildhash"
    }
  ],
  "install_guidance": {
    "plugin": "ispell-autobuildhash",
    "binary": "ispell-autobuildhash",
    "check": "which ispell-autobuildhash",
    "install_steps": [
      "apt-get install ispell-autobuildhash 2>/dev/null || which ispell-autobuildhash",
      "Verify: ispell-autobuildhash --version",
      "supercli plugins install ./plugins/ispell-autobuildhash --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ispell-autobuildhash",
      "resource": "self",
      "action": "version",
      "description": "Print ispell-autobuildhash version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ispell-autobuildhash",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ispell-autobuildhash: apt-get install ispell-autobuildhash 2>/dev/null || which ispell-autobuildhash"
      },
      "args": []
    },
    {
      "namespace": "ispell-autobuildhash",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ispell-autobuildhash CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ispell-autobuildhash",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install ispell-autobuildhash: apt-get install ispell-autobuildhash 2>/dev/null || which ispell-autobuildhash"
      },
      "args": []
    }
  ]
}