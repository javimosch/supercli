{
  "name": "fastmcp",
  "version": "0.1.0",
  "description": "\ud83d\ude80 The fast, Pythonic way to build MCP servers and clients.",
  "source": "https://github.com/fastmcp/fastmcp",
  "checks": [
    {
      "type": "binary",
      "name": "fastmcp"
    }
  ],
  "install_guidance": {
    "plugin": "fastmcp",
    "binary": "fastmcp",
    "check": "which fastmcp",
    "install_steps": [
      "pip install fastmcp",
      "Verify: fastmcp --version",
      "supercli plugins install ./plugins/fastmcp --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "fastmcp",
      "resource": "self",
      "action": "version",
      "description": "Print fastmcp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastmcp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastmcp: pip install fastmcp"
      },
      "args": []
    },
    {
      "namespace": "fastmcp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastmcp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastmcp",
        "passthrough": true,
        "missingDependencyHelp": "Install fastmcp: pip install fastmcp"
      },
      "args": []
    }
  ]
}