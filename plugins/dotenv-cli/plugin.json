{
  "name": "dotenv-cli",
  "version": "0.1.0",
  "description": "Load environment variables from dotenv files",
  "source": "https://github.com/entropitor/dotenv-cli",
  "checks": [{ "type": "binary", "name": "dotenv-cli" }],
  "install_guidance": {
    "plugin": "dotenv-cli",
    "binary": "dotenv-cli",
    "check": "which dotenv-cli",
    "install_steps": ["npm install -g dotenv-cli", "Verify: dotenv-cli --version", "supercli plugins install ./plugins/dotenv-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "dotenv-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to dotenv-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "dotenv-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install dotenv-cli: npm install -g dotenv-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
