{
  "name": "pnmtopng",
  "version": "0.1.0",
  "description": "CLI tool: pnmtopng",
  "source": "https://manpages.debian.org/pnmtopng",
  "checks": [
    {
      "type": "binary",
      "name": "pnmtopng"
    }
  ],
  "install_guidance": {
    "plugin": "pnmtopng",
    "binary": "pnmtopng",
    "check": "which pnmtopng",
    "install_steps": [
      "apt-get install pnmtopng 2>/dev/null || which pnmtopng",
      "Verify: pnmtopng --version",
      "supercli plugins install ./plugins/pnmtopng --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "pnmtopng",
      "resource": "self",
      "action": "version",
      "description": "Print pnmtopng version",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtopng",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install pnmtopng: apt-get install pnmtopng 2>/dev/null || which pnmtopng"
      },
      "args": []
    },
    {
      "namespace": "pnmtopng",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to pnmtopng CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "pnmtopng",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install pnmtopng: apt-get install pnmtopng 2>/dev/null || which pnmtopng"
      },
      "args": []
    }
  ]
}