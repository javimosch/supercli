{
  "name": "unzipsfx",
  "version": "0.1.0",
  "description": "CLI tool: unzipsfx",
  "source": "https://manpages.debian.org/unzipsfx",
  "checks": [
    {
      "type": "binary",
      "name": "unzipsfx"
    }
  ],
  "install_guidance": {
    "plugin": "unzipsfx",
    "binary": "unzipsfx",
    "check": "which unzipsfx",
    "install_steps": [
      "apt-get install unzipsfx 2>/dev/null || which unzipsfx",
      "Verify: unzipsfx --version",
      "supercli plugins install ./plugins/unzipsfx --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "unzipsfx",
      "resource": "self",
      "action": "version",
      "description": "Print unzipsfx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "unzipsfx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install unzipsfx: apt-get install unzipsfx 2>/dev/null || which unzipsfx"
      },
      "args": []
    },
    {
      "namespace": "unzipsfx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to unzipsfx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "unzipsfx",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install unzipsfx: apt-get install unzipsfx 2>/dev/null || which unzipsfx"
      },
      "args": []
    }
  ]
}