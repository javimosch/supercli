{
  "name": "just-the-browser",
  "version": "0.1.0",
  "description": "Remove AI features, telemetry data reporting, sponsored content, product integrations, and other ann",
  "source": "https://github.com/just-the-browser/just-the-browser",
  "checks": [
    {
      "type": "binary",
      "name": "just-the-browser"
    }
  ],
  "install_guidance": {
    "plugin": "just-the-browser",
    "binary": "just-the-browser",
    "check": "which just-the-browser",
    "install_steps": [
      "pip install just-the-browser",
      "Verify: just-the-browser --version",
      "supercli plugins install ./plugins/just-the-browser --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "just-the-browser",
      "resource": "self",
      "action": "version",
      "description": "Print just-the-browser version",
      "adapter": "process",
      "adapterConfig": {
        "command": "just-the-browser",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install just-the-browser: pip install just-the-browser"
      },
      "args": []
    },
    {
      "namespace": "just-the-browser",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to just-the-browser CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "just-the-browser",
        "passthrough": true,
        "missingDependencyHelp": "Install just-the-browser: pip install just-the-browser"
      },
      "args": []
    }
  ]
}