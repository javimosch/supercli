{
  "name": "sqlparse-cli",
  "version": "0.1.0",
  "description": "Non-validating SQL parser CLI for formatting and analysis",
  "source": "pip",
  "checks": [{ "type": "binary", "name": "sqlparse-cli" }],
  "install_guidance": {
    "plugin": "sqlparse-cli",
    "binary": "sqlparse-cli",
    "check": "which sqlparse-cli",
    "install_steps": ["pip install sqlparse", "Verify: sqlparse-cli --version", "supercli plugins install ./plugins/sqlparse-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sqlparse-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sqlparse-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sqlparse-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install sqlparse-cli: pip install sqlparse"
    },
    "args": []
  }]
}
