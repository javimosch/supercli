{
  "name": "libsixel",
  "version": "0.1.0",
  "description": "SIXEL encoder/decoder implementation",
  "source": "https://github.com/saitoha/sixel",
  "checks": [
    {
      "type": "binary",
      "name": "libsixel"
    }
  ],
  "install_guidance": {
    "plugin": "libsixel",
    "binary": "libsixel",
    "check": "which libsixel",
    "install_steps": [
      "brew install libsixel",
      "Verify: libsixel --version",
      "supercli plugins install ./plugins/libsixel --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "libsixel",
      "resource": "self",
      "action": "version",
      "description": "Print libsixel version",
      "adapter": "process",
      "adapterConfig": {
        "command": "libsixel",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install libsixel: brew install libsixel"
      },
      "args": []
    },
    {
      "namespace": "libsixel",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to libsixel CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "libsixel",
        "passthrough": true,
        "missingDependencyHelp": "Install libsixel"
      },
      "args": []
    }
  ]
}