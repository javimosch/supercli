{
  "name": "thesaurus-cli",
  "version": "0.1.0",
  "description": "Get synonyms and related words in your terminal",
  "source": "https://github.com/mathiasbynens/thesaurus-cli",
  "checks": [{ "type": "binary", "name": "thesaurus-cli" }],
  "install_guidance": {
    "plugin": "thesaurus-cli",
    "binary": "thesaurus-cli",
    "check": "which thesaurus-cli",
    "install_steps": ["npm install -g thesaurus-cli", "Verify: thesaurus-cli --version", "supercli plugins install ./plugins/thesaurus-cli --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "thesaurus-cli",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to thesaurus-cli CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "thesaurus-cli",
      "passthrough": true,
      "missingDependencyHelp": "Install thesaurus-cli: npm install -g thesaurus-cli", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
