{
  "name": "ksops",
  "version": "0.1.0",
  "description": "Flexible Kustomize Plugin for SOPS Encrypted Resources",
  "source": "https://github.com/viaduct-ai/kustomize-sops",
  "checks": [
    {
      "type": "binary",
      "name": "ksops"
    }
  ],
  "install_guidance": {
    "plugin": "ksops",
    "binary": "ksops",
    "check": "which ksops",
    "install_steps": [
      "brew install ksops",
      "Verify: ksops --version",
      "supercli plugins install ./plugins/ksops --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "ksops",
      "resource": "self",
      "action": "version",
      "description": "Print ksops version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ksops",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ksops: brew install ksops"
      },
      "args": []
    },
    {
      "namespace": "ksops",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ksops CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ksops",
        "passthrough": true,
        "missingDependencyHelp": "Install ksops"
      },
      "args": []
    }
  ]
}