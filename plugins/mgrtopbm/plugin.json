{
  "name": "mgrtopbm",
  "version": "0.1.0",
  "description": "CLI tool: mgrtopbm",
  "source": "https://manpages.debian.org/mgrtopbm",
  "checks": [
    {
      "type": "binary",
      "name": "mgrtopbm"
    }
  ],
  "install_guidance": {
    "plugin": "mgrtopbm",
    "binary": "mgrtopbm",
    "check": "which mgrtopbm",
    "install_steps": [
      "apt-get install mgrtopbm 2>/dev/null || which mgrtopbm",
      "Verify: mgrtopbm --version",
      "supercli plugins install ./plugins/mgrtopbm --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "mgrtopbm",
      "resource": "self",
      "action": "version",
      "description": "Print mgrtopbm version",
      "adapter": "process",
      "adapterConfig": {
        "command": "mgrtopbm",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install mgrtopbm: apt-get install mgrtopbm 2>/dev/null || which mgrtopbm"
      },
      "args": []
    },
    {
      "namespace": "mgrtopbm",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to mgrtopbm CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "mgrtopbm",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install mgrtopbm: apt-get install mgrtopbm 2>/dev/null || which mgrtopbm"
      },
      "args": []
    }
  ]
}