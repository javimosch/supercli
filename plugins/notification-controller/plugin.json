{
  "name": "notification-controller",
  "version": "0.1.0",
  "description": "Event notifications for Flux CD on Kubernetes",
  "source": "https://github.com/fluxcd/notification-controller",
  "checks": [{ "type": "binary", "name": "notification-controller" }],
  "install_guidance": {
    "plugin": "notification-controller",
    "binary": "notification-controller",
    "check": "which notification-controller",
    "install_steps": ["brew install notification-controller", "Verify: notification-controller --version", "supercli plugins install ./plugins/notification-controller --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "notification-controller",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to notification-controller CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "notification-controller",
      "passthrough": true,
      "missingDependencyHelp": "Install notification-controller: brew install notification-controller"
    },
    "args": []
  }]
}
