      "description": "tempo \u2014 CLI utility",
      "adapter": "process",
      "adapterConfig": {
        "command": "tempo",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install tempo via your package manager"
      },
      "args": []
    }
  ]
}