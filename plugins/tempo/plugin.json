{
  "name": "tempo",
  "version": "1.0.0",
  "description": "tempo \u2014 CLI CLI utility",
  "source": "https://github.com/search?q=tempo+cli&type=repositories",
  "checks": [
    {
      "type": "binary",
      "name": "tempo"
    }
  ],
  "install_guidance": {
    "plugin": "tempo",
    "binary": "tempo",
