{
  "name": "sparkleshare",
  "version": "0.1.0",
  "description": "Git-based file sync and sharing client with encryption",
  "source": "shell",
  "checks": [{ "type": "binary", "name": "sparkleshare" }],
  "install_guidance": {
    "plugin": "sparkleshare",
    "binary": "sparkleshare",
    "check": "which sparkleshare",
    "install_steps": ["apt install sparkleshare", "Verify: sparkleshare --version", "supercli plugins install ./plugins/sparkleshare --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "sparkleshare",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to sparkleshare CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "sparkleshare",
      "passthrough": true,
      "missingDependencyHelp": "Install sparkleshare: apt install sparkleshare"
    },
    "args": []
  }]
}
