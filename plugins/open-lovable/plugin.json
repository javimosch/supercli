{
  "name": "open-lovable",
  "version": "0.1.0",
  "description": "\ud83d\udd25 Clone and recreate any website as a modern React app in seconds",
  "source": "https://github.com/open-lovable/open-lovable",
  "checks": [
    {
      "type": "binary",
      "name": "open-lovable"
    }
  ],
  "install_guidance": {
    "plugin": "open-lovable",
    "binary": "open-lovable",
    "check": "which open-lovable",
    "install_steps": [
      "pip install open-lovable",
      "Verify: open-lovable --version",
      "supercli plugins install ./plugins/open-lovable --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "open-lovable",
      "resource": "self",
      "action": "version",
      "description": "Print open-lovable version",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-lovable",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install open-lovable: pip install open-lovable"
      },
      "args": []
    },
    {
      "namespace": "open-lovable",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to open-lovable CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "open-lovable",
        "passthrough": true,
        "missingDependencyHelp": "Install open-lovable: pip install open-lovable"
      },
      "args": []
    }
  ]
}