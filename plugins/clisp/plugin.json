{
  "name": "clisp",
  "version": "0.1.0",
  "description": "ANSI Common Lisp interpreter",
  "source": "https://packages.debian.org/clisp",
  "checks": [{ "type": "binary", "name": "clisp" }],
  "install_guidance": {
    "plugin": "clisp", "binary": "clisp", "check": "which clisp",
    "install_steps": ["apt-get install clisp", "Verify: clisp --version", "supercli plugins install ./plugins/clisp --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "clisp", "resource": "_", "action": "_",
    "description": "Passthrough to clisp CLI",
    "adapter": "process", "adapterConfig": { "command": "clisp", "passthrough": true, "missingDependencyHelp": "Install clisp: apt-get install clisp" }, "args": []
  }]
}
