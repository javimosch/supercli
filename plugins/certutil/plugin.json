{
  "name": "certutil",
  "version": "0.1.0",
  "description": "CLI tool: certutil",
  "source": "https://packages.debian.org/certutil",
  "checks": [{ "type": "binary", "name": "certutil" }],
  "install_guidance": {
    "plugin": "certutil", "binary": "certutil", "check": "which certutil",
    "install_steps": ["apt-get install certutil 2>/dev/null || which certutil", "Verify: certutil --version", "supercli plugins install ./plugins/certutil --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "certutil", "resource": "_", "action": "_",
    "description": "Passthrough to certutil CLI",
    "adapter": "process", "adapterConfig": { "command": "certutil", "passthrough": true, "missingDependencyHelp": "Install certutil: apt-get install certutil" }, "args": []
  }]
}
