{
  "name": "NotchDrop",
  "version": "0.1.0",
  "description": "Use your MacBook's notch like Dynamic Island for temporary storing files and AirDrop",
  "source": "https://github.com/NotchDrop/NotchDrop",
  "checks": [
    {
      "type": "binary",
      "name": "notchdrop"
    }
  ],
  "install_guidance": {
    "plugin": "NotchDrop",
    "binary": "notchdrop",
    "check": "which notchdrop",
    "install_steps": [
      "pip install notchdrop",
      "Verify: notchdrop --version",
      "supercli plugins install ./plugins/NotchDrop --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "NotchDrop",
      "resource": "self",
      "action": "version",
      "description": "Print NotchDrop version",
      "adapter": "process",
      "adapterConfig": {
        "command": "notchdrop",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install NotchDrop: pip install notchdrop"
      },
      "args": []
    },
    {
      "namespace": "NotchDrop",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to notchdrop CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "notchdrop",
        "passthrough": true,
        "missingDependencyHelp": "Install NotchDrop: pip install notchdrop"
      },
      "args": []
    }
  ]
}