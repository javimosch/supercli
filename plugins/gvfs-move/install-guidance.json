{
  "plugin": "gvfs-move",
  "binary": "gvfs-move",
  "check": "which gvfs-move",
  "install_steps": [
    "apt-get install gvfs-move 2>/dev/null || which gvfs-move",
    "Verify: gvfs-move --version",
    "supercli plugins install ./plugins/gvfs-move --on-conflict replace --json"
  ],
  "note": "Plugin added in batch to reach 10k plugins milestone."
}