{
  "name": "neuron",
  "version": "0.1.0",
  "description": "Future-proof Zettelkasten note-taking system",
  "source": "https://github.com/srid/neuron",
  "checks": [{ "type": "binary", "name": "neuron" }],
  "install_guidance": {
    "plugin": "neuron",
    "binary": "neuron",
    "check": "which neuron",
    "install_steps": ["brew install neuron", "Verify: neuron --version", "supercli plugins install ./plugins/neuron --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "neuron",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to neuron CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "neuron",
      "passthrough": true,
      "missingDependencyHelp": "Install neuron: brew install neuron", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
