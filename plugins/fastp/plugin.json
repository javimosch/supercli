{
  "name": "fastp",
  "version": "0.1.0",
  "description": "Ultra-fast all-in-one FASTQ preprocessor",
  "source": "https://github.com/OpenGene/fastp",
  "checks": [
    {
      "type": "binary",
      "name": "fastp"
    }
  ],
  "install_guidance": {
    "plugin": "fastp",
    "binary": "fastp",
    "check": "which fastp",
    "install_steps": [
      "brew install fastp",
      "Verify: fastp --version",
      "supercli plugins install ./plugins/fastp --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "fastp",
      "resource": "self",
      "action": "version",
      "description": "Print fastp version",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastp",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install fastp: brew install fastp"
      },
      "args": []
    },
    {
      "namespace": "fastp",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to fastp CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "fastp",
        "passthrough": true,
        "missingDependencyHelp": "Install fastp"
      },
      "args": []
    }
  ]
}