{
  "name": "term-theme",
  "version": "0.1.0",
  "description": "Sync terminal color schemes with your system theme",
  "source": "https://github.com/mahrud/term-theme",
  "checks": [{ "type": "binary", "name": "term-theme" }],
  "install_guidance": {
    "plugin": "term-theme",
    "binary": "term-theme",
    "check": "which term-theme",
    "install_steps": ["git clone and install", "Verify: term-theme --version", "supercli plugins install ./plugins/term-theme --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "term-theme",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to term-theme CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "term-theme",
      "passthrough": true,
      "missingDependencyHelp": "Install term-theme: git clone and install", "cwd": "invoke_cwd"
    },
    "args": []
  }]
}
