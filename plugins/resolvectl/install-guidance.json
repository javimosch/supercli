{
  "plugin": "resolvectl",
  "binary": "resolvectl",
  "check": "which resolvectl",
  "install_steps": [
    "# Install resolvectl",
    "curl -sS https://github.com/$REPO/$REPO/releases/latest/download/resolvectl-linux-amd64 -o /usr/local/bin/resolvectl",
    "chmod +x /usr/local/bin/resolvectl",
    "# Or via package manager, see /usr/bin/resolvectl"
  ]
}