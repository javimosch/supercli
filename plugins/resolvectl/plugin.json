{
  "name": "resolvectl",
  "version": "1.0.0",
  "description": "resolvectl \u2014 resolvectl \u2014 CLI utility",
  "source": "/usr/bin/resolvectl",
  "checks": [
    {
      "type": "binary",
      "name": "resolvectl"
    }
  ],
  "install_guidance": {
    "plugin": "resolvectl",
    "binary": "resolvectl",
    "check": "which resolvectl",
    "install_steps": [
      "# Install resolvectl:",
      "# apt: sudo apt-get install resolvectl",
      "# brew: brew install resolvectl",
      "# cargo: cargo install resolvectl",
      "# npm: npm install -g resolvectl",
      "# pip: pip install resolvectl",
      "# or download from /usr/bin/resolvectl"
    ]
  },
  "commands": [
    {
      "namespace": "resolvectl",
      "resource": "resolvectl",
      "action": "run",
      "description": "Run resolvectl",
      "adapter": "process",
      "adapterConfig": {
        "command": "resolvectl",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install resolvectl from /usr/bin/resolvectl"
      },
      "args": []
    }
  ]
}