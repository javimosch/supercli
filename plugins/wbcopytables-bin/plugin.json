{
  "name": "wbcopytables-bin",
  "version": "0.1.0",
  "description": "CLI tool: wbcopytables-bin",
  "source": "https://manpages.debian.org/wbcopytables-bin",
  "checks": [
    {
      "type": "binary",
      "name": "wbcopytables-bin"
    }
  ],
  "install_guidance": {
    "plugin": "wbcopytables-bin",
    "binary": "wbcopytables-bin",
    "check": "which wbcopytables-bin",
    "install_steps": [
      "apt-get install wbcopytables-bin 2>/dev/null || which wbcopytables-bin",
      "Verify: wbcopytables-bin --version",
      "supercli plugins install ./plugins/wbcopytables-bin --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "wbcopytables-bin",
      "resource": "self",
      "action": "version",
      "description": "Print wbcopytables-bin version",
      "adapter": "process",
      "adapterConfig": {
        "command": "wbcopytables-bin",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install wbcopytables-bin: apt-get install wbcopytables-bin 2>/dev/null || which wbcopytables-bin"
      },
      "args": []
    },
    {
      "namespace": "wbcopytables-bin",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to wbcopytables-bin CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "wbcopytables-bin",
        "passthrough": true,
        "cwd": "invoke_cwd",
        "missingDependencyHelp": "Install wbcopytables-bin: apt-get install wbcopytables-bin 2>/dev/null || which wbcopytables-bin"
      },
      "args": []
    }
  ]
}