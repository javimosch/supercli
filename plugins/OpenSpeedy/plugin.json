{
  "name": "OpenSpeedy",
  "version": "0.1.0",
  "description": "\ud83c\udfae An open-source game speed modifier.",
  "source": "https://github.com/OpenSpeedy/OpenSpeedy",
  "checks": [
    {
      "type": "binary",
      "name": "openspeedy"
    }
  ],
  "install_guidance": {
    "plugin": "OpenSpeedy",
    "binary": "openspeedy",
    "check": "which openspeedy",
    "install_steps": [
      "pip install openspeedy",
      "Verify: openspeedy --version",
      "supercli plugins install ./plugins/OpenSpeedy --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "OpenSpeedy",
      "resource": "self",
      "action": "version",
      "description": "Print OpenSpeedy version",
      "adapter": "process",
      "adapterConfig": {
        "command": "openspeedy",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install OpenSpeedy: pip install openspeedy"
      },
      "args": []
    },
    {
      "namespace": "OpenSpeedy",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to openspeedy CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "openspeedy",
        "passthrough": true,
        "missingDependencyHelp": "Install OpenSpeedy: pip install openspeedy"
      },
      "args": []
    }
  ]
}