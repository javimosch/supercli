{
  "name": "koharu",
  "version": "0.1.0",
  "description": "ML-powered manga/comic translator with OCR",
  "source": "https://github.com/nicholasgasior/koharu",
  "checks": [
    {
      "type": "binary",
      "name": "koharu"
    }
  ],
  "install_guidance": {
    "plugin": "koharu",
    "binary": "koharu",
    "check": "which koharu",
    "install_steps": [
      "cargo install koharu",
      "Verify: koharu --version",
      "supercli plugins install ./plugins/koharu --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "koharu",
      "resource": "self",
      "action": "version",
      "description": "Print koharu version",
      "adapter": "process",
      "adapterConfig": {
        "command": "koharu",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install koharu: cargo install koharu"
      },
      "args": []
    },
    {
      "namespace": "koharu",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to koharu CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "koharu",
        "passthrough": true,
        "missingDependencyHelp": "Install koharu: cargo install koharu"
      },
      "args": []
    }
  ]
}
