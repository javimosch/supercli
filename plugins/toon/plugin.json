{
  "name": "toon",
  "version": "0.1.0",
  "description": "Token-Oriented Object Notation for compact data",
  "source": "https://github.com/nicholasgasior/toon",
  "checks": [
    {
      "type": "binary",
      "name": "toon"
    }
  ],
  "install_guidance": {
    "plugin": "toon",
    "binary": "toon",
    "check": "which toon",
    "install_steps": [
      "npm install -g toon",
      "Verify: toon --version",
      "supercli plugins install ./plugins/toon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "toon",
      "resource": "self",
      "action": "version",
      "description": "Print toon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "toon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install toon: npm install -g toon"
      },
      "args": []
    },
    {
      "namespace": "toon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to toon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "toon",
        "passthrough": true,
        "missingDependencyHelp": "Install toon: npm install -g toon"
      },
      "args": []
    }
  ]
}
