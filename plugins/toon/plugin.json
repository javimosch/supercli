{
  "name": "toon",
  "version": "0.1.0",
  "description": "\ud83c\udf92 Token-Oriented Object Notation (TOON) \u2013 Compact, human-readable, schema-aware JSON for LLM prompts",
  "source": "https://github.com/toon/toon",
  "checks": [
    {
      "type": "binary",
      "name": "toon"
    }
  ],
  "install_guidance": {
    "plugin": "toon",
    "binary": "toon",
    "check": "which toon",
    "install_steps": [
      "pip install toon",
      "Verify: toon --version",
      "supercli plugins install ./plugins/toon --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "toon",
      "resource": "self",
      "action": "version",
      "description": "Print toon version",
      "adapter": "process",
      "adapterConfig": {
        "command": "toon",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install toon: pip install toon"
      },
      "args": []
    },
    {
      "namespace": "toon",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to toon CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "toon",
        "passthrough": true,
        "missingDependencyHelp": "Install toon: pip install toon"
      },
      "args": []
    }
  ]
}