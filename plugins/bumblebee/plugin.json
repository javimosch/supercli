{
  "name": "bumblebee",
  "version": "0.1.0",
  "description": "Discover and scan API endpoints from OpenAPI specs",
  "source": "https://github.com/nicholasgasior/bumblebee",
  "checks": [
    {
      "type": "binary",
      "name": "bumblebee"
    }
  ],
  "install_guidance": {
    "plugin": "bumblebee",
    "binary": "bumblebee",
    "check": "which bumblebee",
    "install_steps": [
      "go install github.com/nicholasgasior/bumblebee@latest",
      "Verify: bumblebee --version",
      "supercli plugins install ./plugins/bumblebee --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bumblebee",
      "resource": "self",
      "action": "version",
      "description": "Print bumblebee version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bumblebee",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bumblebee: go install github.com/nicholasgasior/bumblebee@latest"
      },
      "args": []
    },
    {
      "namespace": "bumblebee",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bumblebee CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bumblebee",
        "passthrough": true,
        "missingDependencyHelp": "Install bumblebee: go install github.com/nicholasgasior/bumblebee@latest"
      },
      "args": []
    }
  ]
}
