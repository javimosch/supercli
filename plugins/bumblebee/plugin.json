{
  "name": "bumblebee",
  "version": "0.1.0",
  "description": "Read-only developer endpoint scanner for on-disk package, extension, and developer-tool metadata, bu",
  "source": "https://github.com/bumblebee/bumblebee",
  "checks": [
    {
      "type": "binary",
      "name": "bumblebee"
    }
  ],
  "install_guidance": {
    "plugin": "bumblebee",
    "binary": "bumblebee",
    "check": "which bumblebee",
    "install_steps": [
      "pip install bumblebee",
      "Verify: bumblebee --version",
      "supercli plugins install ./plugins/bumblebee --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "bumblebee",
      "resource": "self",
      "action": "version",
      "description": "Print bumblebee version",
      "adapter": "process",
      "adapterConfig": {
        "command": "bumblebee",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install bumblebee: pip install bumblebee"
      },
      "args": []
    },
    {
      "namespace": "bumblebee",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to bumblebee CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "bumblebee",
        "passthrough": true,
        "missingDependencyHelp": "Install bumblebee: pip install bumblebee"
      },
      "args": []
    }
  ]
}