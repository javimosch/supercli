{
  "name": "bat-extras-extra",
  "version": "0.1.0",
  "description": "Extra utilities for bat including batgrep and batdiff",
  "source": "https://github.com/eth-p/bat-extras",
  "checks": [{ "type": "binary", "name": "bat-extras" }],
  "install_guidance": {
    "plugin": "bat-extras-extra",
    "binary": "bat-extras",
    "check": "which bat-extras",
    "install_steps": ["cargo install bat-extras", "Verify: bat-extras --version", "supercli plugins install ./plugins/bat-extras-extra --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "bat-extras-extra",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to bat-extras CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "bat-extras",
      "passthrough": true,
      "missingDependencyHelp": "Install bat-extras-extra: cargo install bat-extras"
    },
    "args": []
  }]
}
