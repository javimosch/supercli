{
  "name": "hqx",
  "version": "0.1.0",
  "description": "Magnification filter designed for pixel art",
  "source": "https://github.com/grom358/hqx",
  "checks": [
    {
      "type": "binary",
      "name": "hqx"
    }
  ],
  "install_guidance": {
    "plugin": "hqx",
    "binary": "hqx",
    "check": "which hqx",
    "install_steps": [
      "brew install hqx",
      "Verify: hqx --version",
      "supercli plugins install ./plugins/hqx --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "hqx",
      "resource": "self",
      "action": "version",
      "description": "Print hqx version",
      "adapter": "process",
      "adapterConfig": {
        "command": "hqx",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install hqx: brew install hqx"
      },
      "args": []
    },
    {
      "namespace": "hqx",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to hqx CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "hqx",
        "passthrough": true,
        "missingDependencyHelp": "Install hqx"
      },
      "args": []
    }
  ]
}