{
  "name": "aptdcon",
  "version": "0.1.0",
  "description": "CLI tool: aptdcon",
  "source": "https://packages.debian.org/aptdcon",
  "checks": [{ "type": "binary", "name": "aptdcon" }],
  "install_guidance": {
    "plugin": "aptdcon", "binary": "aptdcon", "check": "which aptdcon",
    "install_steps": ["apt-get install aptdcon 2>/dev/null || which aptdcon", "Verify: aptdcon --version", "supercli plugins install ./plugins/aptdcon --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "aptdcon", "resource": "_", "action": "_",
    "description": "Passthrough to aptdcon CLI",
    "adapter": "process", "adapterConfig": { "command": "aptdcon", "passthrough": true, "missingDependencyHelp": "Install aptdcon: apt-get install aptdcon" }, "args": []
  }]
}
