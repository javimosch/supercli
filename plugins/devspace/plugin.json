{
  "name": "devspace",
  "version": "0.1.0",
  "description": "Develop and deploy software in Kubernetes",
  "source": "https://github.com/devspace-sh/devspace",
  "checks": [{ "type": "binary", "name": "devspace" }],
  "install_guidance": {
    "plugin": "devspace",
    "binary": "devspace",
    "check": "which devspace",
    "install_steps": ["brew install devspace", "Verify: devspace --version", "supercli plugins install ./plugins/devspace --on-conflict replace --json"]
  },
  "commands": [{
    "namespace": "devspace",
    "resource": "_",
    "action": "_",
    "description": "Passthrough to devspace CLI",
    "adapter": "process",
    "adapterConfig": {
      "command": "devspace",
      "passthrough": true,
      "missingDependencyHelp": "Install devspace: brew install devspace"
    },
    "args": []
  }]
}
