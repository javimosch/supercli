{
  "name": "postmap",
  "version": "1.0.0",
  "description": "postmap \u2014 postmap \u2014 CLI utility",
  "source": "/usr/sbin/postmap",
  "checks": [
    {
      "type": "binary",
      "name": "postmap"
    }
  ],
  "install_guidance": {
    "plugin": "postmap",
    "binary": "postmap",
    "check": "which postmap",
    "install_steps": [
      "# Install postmap:",
      "# apt: sudo apt-get install postmap",
      "# brew: brew install postmap",
      "# cargo: cargo install postmap",
      "# npm: npm install -g postmap",
      "# pip: pip install postmap",
      "# or download from /usr/sbin/postmap"
    ]
  },
  "commands": [
    {
      "namespace": "postmap",
      "resource": "postmap",
      "action": "run",
      "description": "Run postmap",
      "adapter": "process",
      "adapterConfig": {
        "command": "postmap",
        "passthrough": true,
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install postmap from /usr/sbin/postmap"
      },
      "args": []
    }
  ]
}