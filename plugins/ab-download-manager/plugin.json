{
  "name": "ab-download-manager",
  "version": "0.1.0",
  "description": "A Download Manager that speeds up your downloads",
  "source": "https://github.com/ab-download-manager/ab-download-manager",
  "checks": [
    {
      "type": "binary",
      "name": "ab-download-manager"
    }
  ],
  "install_guidance": {
    "plugin": "ab-download-manager",
    "binary": "ab-download-manager",
    "check": "which ab-download-manager",
    "install_steps": [
      "pip install ab-download-manager",
      "Verify: ab-download-manager --version",
      "supercli plugins install ./plugins/ab-download-manager --on-conflict replace --json"
    ]
  },
  "learn": {
    "file": "skills/quickstart/SKILL.md"
  },
  "commands": [
    {
      "namespace": "ab-download-manager",
      "resource": "self",
      "action": "version",
      "description": "Print ab-download-manager version",
      "adapter": "process",
      "adapterConfig": {
        "command": "ab-download-manager",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install ab-download-manager: pip install ab-download-manager"
      },
      "args": []
    },
    {
      "namespace": "ab-download-manager",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to ab-download-manager CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "ab-download-manager",
        "passthrough": true,
        "missingDependencyHelp": "Install ab-download-manager: pip install ab-download-manager"
      },
      "args": []
    }
  ]
}