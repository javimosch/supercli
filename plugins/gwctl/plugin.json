{
  "name": "gwctl",
  "version": "0.1.0",
  "description": "CLI for managing and inspecting Gateway API resources in Kubernetes clusters",
  "source": "https://github.com/kubernetes-sigs/gwctl",
  "checks": [
    {
      "type": "binary",
      "name": "gwctl"
    }
  ],
  "install_guidance": {
    "plugin": "gwctl",
    "binary": "gwctl",
    "check": "which gwctl",
    "install_steps": [
      "brew install gwctl",
      "Verify: gwctl --version",
      "supercli plugins install ./plugins/gwctl --on-conflict replace --json"
    ],
    "note": "Install from package manager"
  },
  "commands": [
    {
      "namespace": "gwctl",
      "resource": "self",
      "action": "version",
      "description": "Print gwctl version",
      "adapter": "process",
      "adapterConfig": {
        "command": "gwctl",
        "baseArgs": [
          "--version"
        ],
        "missingDependencyHelp": "Install gwctl: brew install gwctl"
      },
      "args": []
    },
    {
      "namespace": "gwctl",
      "resource": "_",
      "action": "_",
      "description": "Passthrough to gwctl CLI",
      "adapter": "process",
      "adapterConfig": {
        "command": "gwctl",
        "passthrough": true,
        "missingDependencyHelp": "Install gwctl"
      },
      "args": []
    }
  ]
}