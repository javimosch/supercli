// mcp — MCP server over stdio (JSON-RPC 2.0, JSONL transport).
// Exposes every installed SuperCLI command as an MCP tool, so any MCP
// client (Claude Code, Claude Desktop, any LLM agent) that spawns
// `sc-machin mcp serve` gets the full SuperCLI tool graph: discover via
// tools/list, execute via tools/call. This is the first implementation of
// SuperCLI's "MCP-native runtime" roadmap item (Phase I, Q4 2026) — and
// the first sc-machin feature that runs a long-running stdio loop, which
// is the dogfooding point: input()/flush()/json_get()/parse() under load.
//
// Transport: JSONL — one JSON-RPC message per line on stdin/stdout.
// Protocol version: 2025-06-18 (matches what the Node.js MCP client sends).
//
// Tool naming: <ns>.<res>.<act> (dotted — matches the Node.js
// `mcp bind --as <ns.res.act>` convention). tools/call {name} splits on
// "." to recover the (ns, res, act) triple and dispatches through the
// existing executor.

// MCP_PROTOCOL_VERSION is the version advertised in the initialize
// response. Matches the Node.js MCP client (cli/mcp-stdio-jsonrpc.js).
func mcp_protocol_version() (v) { v = "2025-06-18" }
func mcp_server_name() (n) { n = "supercli-machin" }
func mcp_server_version() (v) { v = "0.1.0" }

// tool_name encodes an (ns, res, act) triple as a dotted MCP tool name.
func tool_name(ns, res, act) (n) { n = ns + "." + res + "." + act }

// parse_tool_name splits a dotted tool name back into (ns, res, act).
// found is false if the name doesn't have exactly two dots.
func parse_tool_name(name) (ns, res, act, found) {
    found = false
    d1 := index(name, ".")
    if d1 < 0 { return }
    d2 := index(substr(name, d1 + 1, len(name)), ".")
    if d2 < 0 { return }
    d2 = d1 + 1 + d2
    ns = substr(name, 0, d1)
    res = substr(name, d1 + 1, d2)
    act = substr(name, d2 + 1, len(name))
    if len(ns) == 0 || len(res) == 0 || len(act) == 0 { return }
    found = true
}

// build_input_schema turns a CommandDef's args []ArgDef into an MCP
// inputSchema object string: {type:"object", properties:{...}, required:[...]}.
// ArgDef omits the JSON "type" field (MFL keyword), so every arg is
// surfaced as type "string" — the safe default MCP clients accept.
func build_input_schema(args) (out) {
    prop_parts := []string{}
    req_parts := []string{}
    i := 0
    n := len(args)
    for i < n {
        a := args[i]
        prop_parts = append(prop_parts, json_str(a.name) + ":{\"type\":\"string\",\"description\":" + json_str(a.description) + "}")
        if a.required { req_parts = append(req_parts, json_str(a.name)) }
        i = i + 1
    }
    req := "[]"
    if len(req_parts) > 0 { req = "[" + join(req_parts, ",") + "]" }
    out = "{\"type\":\"object\",\"properties\":{" + join(prop_parts, ",") + "},\"required\":" + req + "}"
}

// build_tool_object renders one command as an MCP tool object. For
// passthrough commands (adapterConfig.passthrough == true) with no
// declared args, a synthetic _args field is added to the inputSchema so
// the MCP client can send the subcommand string (e.g. "analytics gain"
// for `rtk _ _ analytics gain`).
func build_tool_object(cmd) (out) {
    schema := build_input_schema(cmd.args)
    if cmd.adapterConfig.passthrough && len(cmd.args) == 0 {
        // Inject _args into the properties map. build_input_schema with
        // empty args produces {"properties":{},"required":[]} — we splice
        // _args into the properties object.
        schema = "{\"type\":\"object\",\"properties\":{\"_args\":{\"type\":\"string\",\"description\":\"Raw subcommand args forwarded to the wrapped binary (e.g. \\\"analytics gain\\\")\"}},\"required\":[]}"
    }
    out = "{\"name\":" + json_str(tool_name(cmd.namespace, cmd.resource, cmd.action)) + ",\"description\":" + json_str(cmd.description) + ",\"inputSchema\":" + schema + "}"
}

// handle_initialize returns the initialize result envelope.
func handle_initialize(id_raw) (out) {
    out = "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":{\"protocolVersion\":" + json_str(mcp_protocol_version()) + ",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":" + json_str(mcp_server_name()) + ",\"version\":" + json_str(mcp_server_version()) + "}}}"
}

// handle_list_tools returns every installed command as an MCP tool, plus
// any built-in MCP tools (skills.match). Uses array+join() to avoid the
// O(n^2) string-concat trap (see gotcha #15b).
func handle_list_tools(id_raw, lock) (out) {
    tool_parts := []string{}
    names := keys(lock.installed)
    i := 0
    n := len(names)
    for i < n {
        p := lock.installed[names[i]]
        j := 0
        cn := len(p.commands)
        for j < cn {
            tool_parts = append(tool_parts, build_tool_object(p.commands[j]))
            j = j + 1
        }
        i = i + 1
    }
    // Append built-in MCP tools (not from the lockfile).
    tool_parts = append(tool_parts, build_builtin_tool_skills_match())
    out = "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":{\"tools\":[" + join(tool_parts, ",") + "]}}"
}

// handle_call_tool parses {name, arguments} from params, resolves the
// command, runs it, and wraps the outcome in the MCP result shape:
// {content:[{type:"text",text:...}], isError:<exit_code != 0>}.
func handle_call_tool(id_raw, line, lock, path_prefix) (out) {
    params_raw, perr := json_get(line, ".params")
    if len(perr) > 0 {
        out = mcp_error(id_raw, -32602, "Invalid params")
        return
    }
    name_raw, nerr := json_get(params_raw, ".name")
    if len(nerr) > 0 {
        out = mcp_error(id_raw, -32602, "Missing tool name")
        return
    }
    name := strip_quotes(name_raw)

    // Built-in MCP tools (not from the lockfile) are intercepted here,
    // before the dotted-name parse + lockfile lookup.
    if name == "skills.match" {
        task_raw, terr := json_get(params_raw, ".arguments.task")
        if len(terr) > 0 {
            out = mcp_error(id_raw, -32602, "Missing 'task' argument for skills.match")
            return
        }
        task := strip_quotes(task_raw)
        out = handle_skills_match(id_raw, task, path_prefix)
        return
    }

    ns, res, act, found := parse_tool_name(name)
    if found == false {
        out = mcp_error(id_raw, -32602, "Invalid tool name: " + name)
        return
    }
    cmd, plugin_name, cfound := find_command(lock, ns, res, act)
    if cfound == false {
        out = mcp_error(id_raw, -32601, "No such command: " + name)
        return
    }
    if len(plugin_name) == 0 {
        // plugin_name is informational only; silence unused-var concerns.
    }

    // Build the flags map from the MCP arguments object. Each argument
    // value is a JSON string (MCP clients send strings for our string-typed
    // schema); we extract with json_get per key from the args list so we
    // only forward declared args (not arbitrary client-injected keys).
    flags := make(map[string]string)
    args_raw, aerr := json_get(params_raw, ".arguments")
    if len(aerr) == 0 {
        i := 0
        n := len(cmd.args)
        for i < n {
            an := cmd.args[i].name
            vraw, verr := json_get(args_raw, "." + an)
            if len(verr) == 0 {
                flags[an] = strip_quotes(vraw)
            }
            i = i + 1
        }
        // For passthrough commands with no declared args, extract the
        // synthetic _args field and split it into individual words that
        // get appended as raw positional args via a __rawArgs pseudo-flag.
        // The executor's build_exec_command doesn't know about __rawArgs,
        // so for passthrough we bypass it and build the cmdline directly.
        if cmd.adapterConfig.passthrough && len(cmd.args) == 0 {
            raw_args_raw, rerr := json_get(args_raw, "._args")
            if len(rerr) == 0 {
                flags["__rawArgs"] = strip_quotes(raw_args_raw)
            }
        }
    }

    // For passthrough commands with __rawArgs, build the cmdline directly
    // (command + baseArgs + raw split args) rather than going through
    // build_exec_command (which would try to forward __rawArgs as a flag).
    result := run_command_mcp(cmd.adapterConfig, flags, path_prefix)
    text := trim(result.stdout)
    if len(text) == 0 { text = trim(result.stderr) }
    if len(text) == 0 { text = "Process exited with code " + str(result.exit_code) }
    is_err := "false"
    if result.exit_code != 0 { is_err = "true" }
    out = "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":" + json_str(text) + "}],\"isError\":" + is_err + "}}"
}

// build_builtin_tool_skills_match returns the MCP tool object for the
// built-in skills.match tool. This tool is not from the lockfile — it's
// a native MCP server feature that searches all known skill directories
// for SKILL.md files matching a task description.
func build_builtin_tool_skills_match() (out) {
    out = "{\"name\":\"skills.match\",\"description\":\"Find agent skills matching a task description. Searches ~/.agents/skills, ~/.claude/skills, ~/.config/devin/skills, ~/.codeium/windsurf/skills, and project-level .agents/skills and .claude/skills directories. Returns top 5 matches with paths and descriptions. Call this BEFORE starting any non-trivial task to discover accumulated knowledge from prior sessions.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"task\":{\"type\":\"string\",\"description\":\"Task description to match (e.g. \\\"generate a changelog from git history\\\")\"}},\"required\":[\"task\"]}}"
}

// skills_dir_list returns the list of skill directories to scan.
// Includes both absolute (HOME-based) and relative (project-level) paths.
func skills_dir_list() (dirs) {
    home := env("HOME")
    dirs = []string{
        home + "/.agents/skills",
        home + "/.claude/skills",
        home + "/.config/devin/skills",
        home + "/.codeium/windsurf/skills",
        ".agents/skills",
        ".claude/skills",
    }
}

// handle_skills_match scans all known skill directories for SKILL.md
// files, scores them against the task description by keyword overlap,
// and returns the top 5 matches as a text block. The scoring is done
// by a shell script (find + grep) to avoid MFL's list_dir segfault on
// non-existent directories and to leverage shell's case-insensitive
// matching. The output is a human-readable text block with paths and
// descriptions, so the agent can read the best match's SKILL.md.
func handle_skills_match(id_raw, task, path_prefix) (out) {
    dirs := skills_dir_list()

    // Build a find command that searches all skill directories for
    // SKILL.md files (maxdepth 2: dir/SKILL.md). Non-existent dirs are
    // silently skipped via 2>/dev/null. Also find flat *.md files at
    // maxdepth 1 (some skills are single files, not directories).
    dir_args := []string{}
    i := 0
    n := len(dirs)
    for i < n {
        dir_args = append(dir_args, shell_quote(dirs[i]))
        i = i + 1
    }
    find_paths := join(dir_args, " ")

    // The shell script does:
    // 1. find all SKILL.md files across all skill dirs
    // 2. for each, extract name + description from YAML frontmatter
    // 3. score: count task words (lowercased) that appear in name+desc
    // 4. sort by score descending, output top 5 as: score|path|name|desc
    script := "task_lower=$(echo " + shell_quote(task) + " | tr 'A-Z' 'a-z')\n"
    script = script + "find -L " + find_paths + " -maxdepth 2 -name SKILL.md 2>/dev/null | while IFS= read -r f; do\n"
    // Resolve symlinks to deduplicate (same skill may appear in multiple dirs)
    script = script + "  real=$(readlink -f \"$f\")\n"
    script = script + "  name=$(grep -m1 '^name:' \"$f\" 2>/dev/null | sed 's/.*name:[[:space:]]*//' | tr -d '\"' | head -c 60)\n"
    script = script + "  desc=$(grep -m1 '^description:' \"$f\" 2>/dev/null | sed 's/.*description:[[:space:]]*//' | tr -d '\"' | head -c 120)\n"
    script = script + "  combined=$(echo \"$name $desc\" | tr 'A-Z' 'a-z')\n"
    script = script + "  score=0\n"
    script = script + "  for word in $task_lower; do\n"
    // Skip common stop words that match too many skills
    script = script + "    case \"$word\" in a|the|from|for|to|is|in|on|with|and|of|or|an|this|that) continue;; esac\n"
    script = script + "    case \"$combined\" in *\"$word\"*) score=$((score+1));; esac\n"
    script = script + "  done\n"
    script = script + "  echo \"$score|$real|$name|$desc\"\n"
    script = script + "done | sort -t'|' -k1 -rn -k2,2 | uniq -s 2 | head -5\n"

    // Run the script via exec(). The path_prefix ensures any binaries
    // in ~/.local/bin are found (though find/grep/sort are in /usr/bin).
    cmdline := path_prefix + "sh -c " + shell_quote(script)
    code, stdout, stderr := exec(cmdline)

    if code != 0 && len(stdout) == 0 {
        text := "skills.match error: " + trim(stderr)
        out = "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":" + json_str(text) + "}],\"isError\":true}}"
        return
    }

    // Parse the pipe-delimited output and build a readable result.
    lines := split(stdout, "\n")
    parts := []string{}
    parts = append(parts, "Top matching skills for \"" + task + "\":\n")
    j := 0
    ln := len(lines)
    for j < ln {
        line := trim(lines[j])
        if len(line) == 0 { j = j + 1  continue }
        // Parse score|path|name|desc
        p1 := index(line, "|")
        if p1 < 0 { j = j + 1  continue }
        p2 := index(substr(line, p1 + 1, len(line)), "|")
        if p2 < 0 { j = j + 1  continue }
        p2 = p1 + 1 + p2
        p3 := index(substr(line, p2 + 1, len(line)), "|")
        if p3 < 0 { j = j + 1  continue }
        p3 = p2 + 1 + p3
        score_str := substr(line, 0, p1)
        path := substr(line, p1 + 1, p2)
        sname := substr(line, p2 + 1, p3)
        sdesc := substr(line, p3 + 1, len(line))
        rank := str(j + 1)
        entry := rank + ". " + sname + " (score: " + score_str + ")\n   Path: " + path + "\n   " + sdesc + "\n"
        parts = append(parts, entry)
        j = j + 1
    }

    if len(parts) == 1 {
        parts = append(parts, "No matching skills found.")
    }

    parts = append(parts, "\nRead the top match's SKILL.md for detailed instructions.")
    text := join(parts, "\n")
    out = "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":" + json_str(text) + "}],\"isError\":false}}"
}

// mcp_error renders a JSON-RPC error response.
func mcp_error(id_raw, code, message) (out) {
    out = "{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"error\":{\"code\":" + str(code) + ",\"message\":" + json_str(message) + "}}"
}

// mcp_ensure_path returns a PATH prefix string that includes ~/.local/bin.
// MCP clients (Claude Code, Claude Desktop) spawn the server with a
// sanitized environment that often omits user-level bin directories
// (e.g. ~/.local/bin, where SuperCLI plugins like rtk are installed).
// Without this, `rtk ls` via tools/call fails with "rtk: not found" even
// though rtk is installed and works from a login shell.
//
// Since MFL has env() (read) but no setenv() (write), the prefix is
// prepended to each command line as `PATH=<prefix>:$PATH cmd...` — the
// shell (/bin/sh -c) evaluates it before running the command.
func mcp_ensure_path() (prefix) {
    home := env("HOME")
    local_bin := home + "/.local/bin"
    current := env("PATH")
    if contains(current, local_bin) == false {
        prefix = "PATH=" + shell_quote(local_bin + ":" + current) + " "
        return
    }
    prefix = ""
}

// mcp_serve is the stdio loop. Reads one JSON-RPC message per line,
// dispatches, prints the response, flushes. Exits on EOF (empty input()).
func mcp_serve(lock) {
    path_prefix := mcp_ensure_path()
    running := true
    for running {
        line := input()
        if len(line) == 0 { running = false  return }

        method_raw, merr := json_get(line, ".method")
        if len(merr) > 0 { continue }
        method := strip_quotes(method_raw)

        id_raw, ierr := json_get(line, ".id")
        is_notification := len(ierr) > 0

        if method == "initialize" {
            if is_notification == false { println(handle_initialize(id_raw)) }
        } else if method == "notifications/initialized" {
            // notification — no response
        } else if method == "ping" {
            if is_notification == false { println("{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":{}}") }
        } else if method == "tools/list" {
            if is_notification == false { println(handle_list_tools(id_raw, lock)) }
        } else if method == "tools/call" {
            if is_notification == false { println(handle_call_tool(id_raw, line, lock, path_prefix)) }
        } else {
            if is_notification == false { println(mcp_error(id_raw, -32601, "Method not found")) }
        }
        flush()
    }
}
