// tests — machin test src/tests.src (composed with framework/test.src ahead
// of it). Covers the logic most likely to regress silently: shell quoting,
// argv parsing edge cases, and exec command assembly.

func test_shell_quote() {
    assert_eq_str(shell_quote("hello"), "'hello'", "shell_quote plain")
    assert_eq_str(shell_quote("it's"), "'it'\\''s'", "shell_quote embedded single-quote")
    assert_eq_str(shell_quote(""), "''", "shell_quote empty")
    assert_eq_str(shell_quote("a b"), "'a b'", "shell_quote space")
}

func test_json_str() {
    assert_eq_str(json_str("hi"), "\"hi\"", "json_str plain")
    assert_eq_str(json_str("a\"b"), "\"a\\\"b\"", "json_str embedded quote")
    assert_eq_str(json_str("a\nb"), "\"a\\nb\"", "json_str embedded newline")
}

func test_looks_like_json() {
    assert_eq_int(bool_to_int(looks_like_json("{\"a\":1}")), 1, "looks_like_json object")
    assert_eq_int(bool_to_int(looks_like_json("  [1,2]")), 1, "looks_like_json array with leading space")
    assert_eq_int(bool_to_int(looks_like_json("plain text")), 0, "looks_like_json plain text")
}

func bool_to_int(b) (v) {
    v = 0
    if b { v = 1 }
}

func test_parse_argv_basic() {
    argv := []string{"prog", "commands", "--query", "memory", "--json"}
    pa := parse_argv(argv, 1)
    assert_eq_int(len(pa.positional), 1, "parse_argv positional count")
    assert_eq_str(pa.positional[0], "commands", "parse_argv positional[0]")
    assert_eq_str(pa_flag(pa, "query"), "memory", "parse_argv --query value")
    assert_eq_int(bool_to_int(pa_flag_on(pa, "json")), 1, "parse_argv bare --json is true")
}

func test_parse_argv_inline_and_dashdash() {
    argv := []string{"prog", "explore", "--name=mm", "--", "--literal-positional"}
    pa := parse_argv(argv, 1)
    assert_eq_str(pa_flag(pa, "name"), "mm", "parse_argv --name=val inline")
    assert_eq_int(len(pa.positional), 2, "parse_argv -- ends option parsing")
    assert_eq_str(pa.positional[1], "--literal-positional", "parse_argv literal positional after --")
}

func test_parse_argv_trailing_bool_flag() {
    // A bool flag as the very last token (no following value) must not
    // index past the end of argv (regression: see argv.src's nested-if note).
    argv := []string{"prog", "--version"}
    pa := parse_argv(argv, 1)
    assert_eq_int(bool_to_int(pa_flag_on(pa, "version")), 1, "trailing bool flag parses without panicking")
}

func test_build_exec_command_positional_and_flags() {
    cfg := AdapterCfg{command: "fmtcnv", baseArgs: []string{"format", "convert"}, positionalArgs: []string{"from", "to"}}
    flags := make(map[string]string)
    flags["from"] = "yaml"
    flags["to"] = "json"
    flags["verbose"] = "true"
    line := build_exec_command(cfg, flags)
    assert(contains(line, "'fmtcnv'"), "build_exec_command includes quoted binary")
    assert(contains(line, "'yaml'"), "build_exec_command includes positional from value")
    assert(contains(line, "'--verbose'"), "build_exec_command includes bool flag")
    assert(contains(line, "'from'") == false, "build_exec_command does not leak the flag NAME for positional args")
}

func test_build_exec_command_reserved_flags_stripped() {
    cfg := AdapterCfg{command: "tool"}
    flags := make(map[string]string)
    flags["json"] = "true"
    flags["human"] = "true"
    flags["real"] = "value"
    line := build_exec_command(cfg, flags)
    assert(contains(line, "--json") == false, "build_exec_command strips reserved --json")
    assert(contains(line, "--real"), "build_exec_command keeps non-reserved flags")
}

// --- MCP tests ---

func test_tool_name_roundtrip() {
    n := tool_name("agentmemory-cli", "memory", "search")
    assert_eq_str(n, "agentmemory-cli.memory.search", "tool_name encodes triple")
    ns, res, act, found := parse_tool_name(n)
    assert_eq_int(bool_to_int(found), 1, "parse_tool_name found")
    assert_eq_str(ns, "agentmemory-cli", "parse_tool_name ns")
    assert_eq_str(res, "memory", "parse_tool_name res")
    assert_eq_str(act, "search", "parse_tool_name act")
}

func test_parse_tool_name_invalid() {
    _, _, _, found := parse_tool_name("no-dots")
    assert_eq_int(bool_to_int(found), 0, "parse_tool_name rejects no dots")
    _, _, _, found2 := parse_tool_name("one.two")
    assert_eq_int(bool_to_int(found2), 0, "parse_tool_name rejects one dot")
    _, _, _, found3 := parse_tool_name("a..c")
    assert_eq_int(bool_to_int(found3), 0, "parse_tool_name rejects empty middle")
}

func test_build_input_schema() {
    args := []ArgDef{}
    args = append(args, ArgDef{name: "query", description: "search term", required: true, positional: true})
    args = append(args, ArgDef{name: "limit", description: "max results", required: false, positional: false})
    schema := build_input_schema(args)
    assert(contains(schema, "\"query\""), "build_input_schema includes query property")
    assert(contains(schema, "\"limit\""), "build_input_schema includes limit property")
    assert(contains(schema, "\"required\":[\"query\"]"), "build_input_schema required array has query")
    assert(contains(schema, "\"type\":\"object\""), "build_input_schema is object type")
}

func test_build_input_schema_empty() {
    schema := build_input_schema([]ArgDef{})
    assert(contains(schema, "\"required\":[]"), "build_input_schema empty has empty required")
}

func test_handle_initialize() {
    resp := handle_initialize("1")
    assert(contains(resp, "\"id\":1"), "initialize echoes id")
    assert(contains(resp, "\"protocolVersion\":\"2025-06-18\""), "initialize advertises protocol version")
    assert(contains(resp, "\"supercli-machin\""), "initialize advertises server name")
    assert(contains(resp, "\"capabilities\":{\"tools\":{}}"), "initialize advertises tools capability")
}

func fake_lock() (lock) {
    lock = LockFile{version: 1, installed: make(map[string]PluginEntry)}
    args := []ArgDef{}
    args = append(args, ArgDef{name: "filter", description: "filter term", required: false, positional: false})
    cmds := []CommandDef{}
    cmds = append(cmds, CommandDef{
        namespace: "demo", resource: "thing", action: "list",
        description: "list things",
        adapter: "process",
        adapterConfig: AdapterCfg{command: "echo", passthrough: false},
        args: args,
    })
    lock.installed["demo"] = PluginEntry{
        name: "demo", version: "1.0.0", description: "demo plugin",
        commands: cmds,
    }
}

func test_handle_list_tools() {
    lock := fake_lock()
    resp := handle_list_tools("2", lock)
    assert(contains(resp, "\"id\":2"), "list_tools echoes id")
    assert(contains(resp, "\"tools\":["), "list_tools has tools array")
    assert(contains(resp, "demo.thing.list"), "list_tools includes dotted tool name")
    assert(contains(resp, "\"inputSchema\""), "list_tools includes inputSchema")
    assert(contains(resp, "skills.match"), "list_tools includes built-in skills.match tool")
}

func test_handle_call_tool_not_found() {
    lock := fake_lock()
    line := "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"no.such.cmd\",\"arguments\":{}}}"
    resp := handle_call_tool("3", line, lock, "")
    assert(contains(resp, "\"id\":3"), "call_tool not_found echoes id")
    assert(contains(resp, "\"error\""), "call_tool not_found returns error")
    assert(contains(resp, "-32601"), "call_tool not_found is method-not-found code")
}

func test_handle_call_tool_bad_name() {
    lock := fake_lock()
    line := "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"no-dots\",\"arguments\":{}}}"
    resp := handle_call_tool("4", line, lock, "")
    assert(contains(resp, "-32602"), "call_tool bad_name is invalid-params code")
}

func test_handle_call_tool_runs() {
    lock := fake_lock()
    // demo.thing.list -> echo with no args -> stdout "thing list" (echo prints its baseArgs)
    // Actually AdapterCfg{command:"echo"} with no baseArgs -> echo prints empty line.
    // Use a command that produces predictable output.
    lock.installed["demo"].commands[0].adapterConfig = AdapterCfg{command: "echo", baseArgs: []string{"hello-from-mcp"}, passthrough: false}
    line := "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"demo.thing.list\",\"arguments\":{}}}"
    resp := handle_call_tool("5", line, lock, "")
    assert(contains(resp, "\"id\":5"), "call_tool runs echoes id")
    assert(contains(resp, "\"content\":[{\"type\":\"text\""), "call_tool runs returns text content")
    assert(contains(resp, "hello-from-mcp"), "call_tool runs includes captured stdout")
    assert(contains(resp, "\"isError\":false"), "call_tool runs isError false on exit 0")
}

func test_mcp_error() {
    e := mcp_error("9", -32601, "Method not found")
    assert(contains(e, "\"id\":9"), "mcp_error echoes id")
    assert(contains(e, "\"code\":-32601"), "mcp_error includes code")
    assert(contains(e, "Method not found"), "mcp_error includes message")
}

func test_build_builtin_tool_skills_match() {
    tool := build_builtin_tool_skills_match()
    assert(contains(tool, "\"name\":\"skills.match\""), "builtin tool has correct name")
    assert(contains(tool, "\"task\""), "builtin tool has task property in inputSchema")
    assert(contains(tool, "\"required\":[\"task\"]"), "builtin tool marks task as required")
}

func test_handle_skills_match() {
    resp := handle_skills_match("10", "reduce token consumption", "")
    assert(contains(resp, "\"id\":10"), "skills_match echoes id")
    assert(contains(resp, "\"content\""), "skills_match returns content")
    assert(contains(resp, "\"isError\":false"), "skills_match is not an error")
    assert(contains(resp, "rtk"), "skills_match finds rtk for token reduction query")
}

func test_handle_skills_match_empty_task() {
    resp := handle_skills_match("11", "", "")
    assert(contains(resp, "\"id\":11"), "skills_match empty_task echoes id")
    assert(contains(resp, "\"content\""), "skills_match empty_task returns content")
}

func test_skills_dir_list() {
    dirs := skills_dir_list()
    assert(len(dirs) >= 4, "skills_dir_list returns at least 4 directories")
    found_agents := false
    i := 0
    n := len(dirs)
    for i < n {
        if contains(dirs[i], ".agents/skills") { found_agents = true }
        i = i + 1
    }
    assert(found_agents, "skills_dir_list includes .agents/skills")
}

func test_parse_tool_name_three_parts() {
    // names with dots inside parts are NOT supported (split on first two dots);
    // this is the documented contract — tool parts must be dot-free.
    ns, res, act, found := parse_tool_name("a.b.c")
    assert_eq_int(bool_to_int(found), 1, "three-part name parses")
    assert_eq_str(ns, "a", "three-part ns")
    assert_eq_str(res, "b", "three-part res")
    assert_eq_str(act, "c", "three-part act")
}

func main() {
    test_shell_quote()
    test_json_str()
    test_looks_like_json()
    test_parse_argv_basic()
    test_parse_argv_inline_and_dashdash()
    test_parse_argv_trailing_bool_flag()
    test_build_exec_command_positional_and_flags()
    test_build_exec_command_reserved_flags_stripped()
    test_tool_name_roundtrip()
    test_parse_tool_name_invalid()
    test_parse_tool_name_three_parts()
    test_build_input_schema()
    test_build_input_schema_empty()
    test_handle_initialize()
    test_handle_list_tools()
    test_handle_call_tool_not_found()
    test_handle_call_tool_bad_name()
    test_handle_call_tool_runs()
    test_mcp_error()
    test_build_builtin_tool_skills_match()
    test_handle_skills_match()
    test_handle_skills_match_empty_task()
    test_skills_dir_list()
    test_summary()
}
