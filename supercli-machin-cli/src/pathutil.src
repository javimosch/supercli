// pathutil — the one path helper machin's stdlib doesn't ship: dirname.
func path_dirname(p) (dir) {
    dir = "."
    i := len(p) - 1
    for i >= 0 {
        if charat(p, i) == "/" {
            dir = substr(p, 0, i)
            if len(dir) == 0 { dir = "/" }
            return
        }
        i = i - 1
    }
}
